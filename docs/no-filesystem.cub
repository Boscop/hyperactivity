-- docs/no-filesystem.cub — No file paths in the code: decomposed by `hyperactive decompose` (lib/selection.cub).
-- Each part is a definition: a selection of the source's lines, or their re-expression where they do not stand alone.
import "../lib/selection.cub"
no-filesystem-source : List Word
no-filesystem-source = lines-of (cons "# No file paths in the code" (cons "" (cons "Avik, 2026-11-15:" (cons "" (cons "> There should be zero file paths anywhere in our code. System does not rely on filesystem ontology system explicitly rejects filesystem ontology for computing systems we consider file system to be an institutionalized abstraction on par with false churches in how deeply it is realized in a mass-psychotic population of SWE & computer scientist" (cons "" (cons "Avik, 2026-11-15, minutes later:" (cons "" (cons "> To bootstrap from filesystem - only one thing reads by filesystem - computes hash of all files in file system. That's it. Hash is reference" (cons "" (cons "> Unison certainly solved this already" (cons "" (cons "> The language wont be based on .cub files when store is proper. Literally no .cub file exists" (cons ">" (cons "> No file" (cons ">" (cons "> Code doesn't live in files." nil)))))))))))))))))
no-filesystem-1 : List Word
no-filesystem-1 = mask-select no-filesystem-source (ranges-mask (cons (toNat #0 , toNat #29) nil))
no-filesystem-2 : List Word
no-filesystem-2 = mask-select no-filesystem-source (ranges-mask (cons (toNat #29 , toNat #395) nil))
no-filesystem-3 : List Word
no-filesystem-3 = unlines (cons "Avik, 2026-11-15, minutes after saying there should be zero file paths anywhere in the code, on how the system starts from a file system all the same:" (cons "" (cons "> To bootstrap from filesystem - only one thing reads by filesystem - computes hash of all files in file system. That's it. Hash is reference" nil)))
no-filesystem-4 : List Word
no-filesystem-4 = unlines (cons "Avik, 2026-11-15, on bootstrapping from the file system by one reader that computes the hash of every file, the hash being the reference (code identified by the hash of its content):" (cons "" (cons "> Unison certainly solved this already" nil)))
no-filesystem-5 : List Word
no-filesystem-5 = unlines (cons "Avik, 2026-11-15, on the language of hyperactivity once its content-addressed store is proper:" (cons "" (cons "> The language wont be based on .cub files when store is proper. Literally no .cub file exists" (cons ">" (cons "> No file" (cons ">" (cons "> Code doesn't live in files." nil)))))))
