-- docs/part-i.cub — what Part I carries (Avik, 2026-11-16: "there must be semantic equivalence to some
-- decomposed piece of [Part I] with any other node for it to be considered included already. This is
-- the intelligent design. Anything not mapped with semantic equivalence to [Part I] content is
-- obviously not included"). Part I is the value hyperactivity (docs/hyperactivity.cub). Each
-- declaration in part-i-carries names a unit of the book and the blocks of Part I equivalent to it
-- (lib/knowledge.cub, Equivalent); a unit is in Part I exactly when it is named here. The units in
-- scope (every Pull of the files imported here) that no declaration names are not-in-part-i,
-- computed; nothing else lists them.
import "to-be-incorporated-into-paper.cub"
import "the-firm-as-one-program.cub"
import "hyperactivity-is-the-theory-of-knowledge-graphs.cub"
import "hyperactive-interaction-in-the-words-of-the-human-superorganism.cub"
import "eye-contact-co-processing-at-the-speed-of-light.cub"
import "training-agents-into-weights.cub"
import "the-history-of-the-work.cub"
import "information-acts-and-common-ground.cub"
import "knowledge-is-a-lack-of-ignorance.cub"
import "controversy-and-consensus.cub"
import "no-filesystem.cub"
import "language-derived-from-the-record.cub"
import "hyperactivity.cub"
part-i-carries : List Equivalent
part-i-carries = nil
not-in-part-i : List (List Word × Pull)
not-in-part-i = uncarried part-i-carries (definitions Pull)
