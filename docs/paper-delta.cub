-- To check against the paper (the value hyperactivity, docs/hyperactivity.cub; its Part I is v31's text): what it already contains leaves the delta.
-- geodesic
-- docs/paper-delta.cub — the paper delta (Avik, 2026-11-15): the set of pointers to the pieces of work
-- not yet incorporated into the paper, each written at a different time; when the paper absorbs a
-- piece, its pointer leaves.
import "../lib/document.cub"
import "hyperactivity-is-the-theory-of-knowledge-graphs.cub"
import "hyperactive-interaction-in-the-words-of-the-human-superorganism.cub"
import "eye-contact-co-processing-at-the-speed-of-light.cub"
import "training-agents-into-weights.cub"
import "the-history-of-the-work.cub"
import "information-acts-and-common-ground.cub"
import "knowledge-is-a-lack-of-ignorance.cub"
import "controversy-and-consensus.cub"
import "no-filesystem.cub"
paper-delta : List Document
paper-delta =
  cons (document "to-be-incorporated-into-paper.md")
  (cons (projection "Hyperactive Interaction, in the words of the human superorganism (docs/hyperactive-interaction-in-the-words-of-the-human-superorganism.cub)" (bare hyperactive-interaction-in-the-words-of-the-human-superorganism))
  (cons (projection "Knowledge is a lack of ignorance (docs/knowledge-is-a-lack-of-ignorance.cub)" (bare knowledge-is-a-lack-of-ignorance))
  (cons (projection "Controversy and consensus (docs/controversy-and-consensus.cub)" (bare controversy-and-consensus))
  (cons (projection "No file paths in the code (docs/no-filesystem.cub)" (bare no-filesystem))
  (cons (projection "Eye Contact: Co-Processing at the Speed of Light (docs/eye-contact-co-processing-at-the-speed-of-light.cub)" (bare eye-contact-co-processing-at-the-speed-of-light))
  (cons (projection "Information acts; real time, not turns; common ground (docs/information-acts-and-common-ground.cub)" (bare information-acts-and-common-ground))
  (cons (document "the-firm-as-one-program.md")
  (cons (projection "Training agents into weights (docs/training-agents-into-weights.cub)" (bare training-agents-into-weights))
  (cons (projection "The history of the work (docs/the-history-of-the-work.cub)" (bare the-history-of-the-work))
  (cons (projection "Hyperactivity as a theory of knowledge graphs (docs/hyperactivity-is-the-theory-of-knowledge-graphs.cub)" (bare hyperactivity-is-the-theory-of-knowledge-graphs))
  nil))))))))))
