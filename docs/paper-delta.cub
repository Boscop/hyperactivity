-- To check against the paper (the value hyperactivity, docs/hyperactivity.cub; its Part I is v31's text): what it already contains leaves the delta.
-- geodesic
-- docs/paper-delta.cub — the paper delta (Avik, 2026-11-15): the set of pointers to the pieces of work
-- not yet incorporated into the paper, each written at a different time; when the paper absorbs a
-- piece, its pointer leaves. A piece is a decomposed Essay (lib/knowledge.cub), served as its bare
-- value, or any document: a piece is decomposed only once it is known what its contents feed (Avik).
import "to-be-incorporated-into-paper.cub"
import "the-firm-as-one-program.cub"
import "hyperactivity-is-the-theory-of-knowledge-graphs.cub"
import "hyperactive-interaction-in-the-words-of-the-human-superorganism.cub"
import "eye-contact-co-processing-at-the-speed-of-light.cub"
import "training-agents-into-weights.cub"
import "the-history-of-the-work.cub"
import "information-acts-and-common-ground.cub"
import "knowledge-is-a-lack-of-ignorance.cub"
import "controversy-and-consensus.cub"
import "no-filesystem.cub"
import "language-derived-from-the-record.cub"
paper-delta : List Document
paper-delta =
  cons (essay-document to-be-incorporated-into-paper)
  (cons (essay-document hyperactive-interaction-in-the-words-of-the-human-superorganism)
  (cons (essay-document knowledge-is-a-lack-of-ignorance)
  (cons (essay-document controversy-and-consensus)
  (cons (essay-document no-filesystem)
  (cons (essay-document eye-contact-co-processing-at-the-speed-of-light)
  (cons (essay-document information-acts-and-common-ground)
  (cons (essay-document the-firm-as-one-program)
  (cons (essay-document training-agents-into-weights)
  (cons (essay-document the-history-of-the-work)
  (cons (essay-document hyperactivity-is-the-theory-of-knowledge-graphs)
  (cons (essay-document language-derived-from-the-record) nil)))))))))))
