controversy-and-consensus = essay "Controversy and consensus" (cons controversy-and-consensus-1 (cons controversy-and-consensus-2 (cons controversy-and-consensus-3 (cons controversy-and-consensus-4 (cons controversy-and-consensus-5 (cons controversy-and-consensus-6 (cons controversy-and-consensus-7 (cons controversy-and-consensus-8 (cons controversy-and-consensus-9 (cons controversy-and-consensus-10 (cons controversy-and-consensus-11 nil))))))))))) (decomposed-by "Claude (Opus 5.5, session 01WfrbRupoT2Pynku5z2V9kH)" "2026-11-16")
