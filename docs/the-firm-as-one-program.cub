the-firm-as-one-program-44 = pull the-firm-as-one-program-source (whole the-firm-as-one-program-source) (cons (span #20382 #20856) nil) (restated (unlines (cons "  - **PE2** One protocol definition; every artifact is a projection of it. [P5: Specialization (the Futamura projections) that keeps its proofs (hyperactivity v31 §6)]" (cons "    - **PE2.1** A generic protocol interpreter specialized on the definition is a parser (first Futamura projection)." (cons "    - **PE2.2** The specializer specialized on the interpreter is a parser generator (second projection)." (cons "    - **PE2.3** Builders, validators, book builders, replay tools, test generators and FPGA logic are all specializations of the one definition, so they cannot disagree." nil)))))) as-written
