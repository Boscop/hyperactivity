the-firm-as-one-program-61 = part (cons "## 3. Value to the firm" (cons "" nil))
the-firm-as-one-program-62 : Part
the-firm-as-one-program-62 = referring (cons "- **V1** Alpha survives deployment ([C2])." (cons "  Alpha that decays between backtest and deployment survives, because the backtest and the production strategy are one definition." nil)) (cons "- **V1** (value to a trading firm built as one program in hyperactivity) Alpha survives deployment ([C2: Research and production are one definition run in two worlds ([P6], [P7])])." (cons "  Alpha that decays between backtest and deployment survives, because the backtest and the production strategy are one definition." nil))
