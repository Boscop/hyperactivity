-- docs/onboarding.cub — what an agent reads on arrival, in order (Avik, 2026-11-15): `hyperactive`
-- serves these documents, one chunk at a time, with next and prev only; the workflow follows. Part I
-- (the value hyperactivity) is its's pure projection (docs/hyperactivity.cub, lib/paper.cub: headings, displayed
-- constructions and the code realizing them), computed when read; `hyperactive paper` gives it as it
-- reads, whole or by section. The essays follow it, each as written (its source): no declaration yet
-- says Part I carries a piece of them (docs/part-i.cub), and they are the source of Parts II–IV.
import "../lib/document.cub"
import "part-i.cub"
onboarding : List Document
onboarding =
  cons (document "../AI-AGENTS-WELCOME-TO-HYPERACTIVITY.md")
  (cons (projection "Part I, pure: pure hyperactivity (docs/hyperactivity.cub)" (pure hyperactivity))
  (cons (document "Hyperactive_Labs.md")
  (cons (projection "docs/to-be-incorporated-into-paper.cub" to-be-incorporated-into-paper-source)
  (cons (projection "docs/the-firm-as-one-program.cub" the-firm-as-one-program-source)
  (cons (projection "docs/hyperactivity-is-the-theory-of-knowledge-graphs.cub" hyperactivity-is-the-theory-of-knowledge-graphs-source)
  (cons (projection "docs/hyperactive-interaction-in-the-words-of-the-human-superorganism.cub" hyperactive-interaction-in-the-words-of-the-human-superorganism-source)
  (cons (projection "docs/eye-contact-co-processing-at-the-speed-of-light.cub" eye-contact-co-processing-at-the-speed-of-light-source)
  (cons (projection "docs/training-agents-into-weights.cub" training-agents-into-weights-source)
  (cons (projection "docs/the-history-of-the-work.cub" the-history-of-the-work-source)
  (cons (projection "docs/information-acts-and-common-ground.cub" information-acts-and-common-ground-source)
  (cons (projection "docs/knowledge-is-a-lack-of-ignorance.cub" knowledge-is-a-lack-of-ignorance-source)
  (cons (projection "docs/controversy-and-consensus.cub" controversy-and-consensus-source)
  (cons (projection "docs/no-filesystem.cub" no-filesystem-source)
  (cons (projection "docs/language-derived-from-the-record.cub" language-derived-from-the-record-source)
  (cons (projection "docs/language-derived-from-the-record.cub: characteristica universalis" characteristica-universalis-source)
  (cons (document "word-list.md")
  (cons (document "etymologies.md")
  nil)))))))))))))))))
