hyperactivity-is-the-theory-of-knowledge-graphs-47 = mask-select hyperactivity-is-the-theory-of-knowledge-graphs-source (ranges-mask (cons (toNat #17981 , toNat #18590) nil))
hyperactivity-is-the-theory-of-knowledge-graphs-48 : List Word
hyperactivity-is-the-theory-of-knowledge-graphs-48 = mask-select hyperactivity-is-the-theory-of-knowledge-graphs-source (ranges-mask (cons (toNat #18590 , toNat #18966) nil))
hyperactivity-is-the-theory-of-knowledge-graphs-49 : List Word
hyperactivity-is-the-theory-of-knowledge-graphs-49 = mask-select hyperactivity-is-the-theory-of-knowledge-graphs-source (ranges-mask (cons (toNat #18966 , toNat #19406) nil))
hyperactivity-is-the-theory-of-knowledge-graphs-50 : List Word
hyperactivity-is-the-theory-of-knowledge-graphs-50 = mask-select hyperactivity-is-the-theory-of-knowledge-graphs-source (ranges-mask (cons (toNat #19406 , toNat #19427) nil))
hyperactivity-is-the-theory-of-knowledge-graphs-51 : List Word
hyperactivity-is-the-theory-of-knowledge-graphs-51 = unlines (cons "**Science.** As a consequence of hyperactivity as the theory of knowledge graphs: A field's knowledge becomes a graph of constructions over its observations. Two schools that disagree" (cons "are two families of constructions, and the fiber compatible with both observations shows what is actually" (cons "unsettled. Replication is reuse under a valid certificate. A retracted result invalidates exactly what depended on" (cons "it." nil))))
hyperactivity-is-the-theory-of-knowledge-graphs-52 : List Word
hyperactivity-is-the-theory-of-knowledge-graphs-52 = unlines (cons "**Organizations.** As a consequence of hyperactivity as the theory of knowledge graphs: The whole of an institution (its systems, its records, its reasoning and its decisions) becomes" (cons "one program with end-to-end verifiability of any provable property. The knowledge graph of the organization and the" (cons "organization's computation are the same object." nil)))
hyperactivity-is-the-theory-of-knowledge-graphs-53 : List Word
hyperactivity-is-the-theory-of-knowledge-graphs-53 = unlines (cons "**Machine intelligence.** As a consequence of hyperactivity as the theory of knowledge graphs: A language model's weights hold the usage history of the human record without identity," (cons "justification or currency. A knowledge graph of constructions gives what the model lacks: claims tied to their" (cons "warrants, identities with witnesses, and conclusions that know their dependencies. A model working inside it is an" (cons "executor of code over that graph, and its outputs become objects whose correctness is relative to what they serve." nil))))
hyperactivity-is-the-theory-of-knowledge-graphs-54 : List Word
hyperactivity-is-the-theory-of-knowledge-graphs-54 = unlines (cons "**Communication.** As a consequence of hyperactivity as the theory of knowledge graphs: Two people who disagree hold two constructions. The system can show the shared premises and" (cons "where inference over them diverges, so disagreement becomes navigable." nil))
hyperactivity-is-the-theory-of-knowledge-graphs-55 : List Word
hyperactivity-is-the-theory-of-knowledge-graphs-55 = mask-select hyperactivity-is-the-theory-of-knowledge-graphs-source (ranges-mask (cons (toNat #20687 , toNat #20754) nil))
hyperactivity-is-the-theory-of-knowledge-graphs-56 : List Word
hyperactivity-is-the-theory-of-knowledge-graphs-56 = unlines (cons "Arthur Brock and Eric Harris-Braun, through Ceptr and the MetaCurrency Project and later Holochain, worked on the" (cons "question hyperactivity's theory of knowledge graphs answers: how to make meaning travel with data, between agents, with no central authority deciding what" (cons "anything means. Avik credits this work as setting him on the path; hyperactivity is a continuation of it." nil)))
hyperactivity-is-the-theory-of-knowledge-graphs-57 : List Word
hyperactivity-is-the-theory-of-knowledge-graphs-57 = mask-select hyperactivity-is-the-theory-of-knowledge-graphs-source (ranges-mask (cons (toNat #21092 , toNat #21730) nil))
hyperactivity-is-the-theory-of-knowledge-graphs-58 : List Word
hyperactivity-is-the-theory-of-knowledge-graphs-58 = mask-select hyperactivity-is-the-theory-of-knowledge-graphs-source (ranges-mask (cons (toNat #21730 , toNat #22251) nil))
hyperactivity-is-the-theory-of-knowledge-graphs-59 : List Word
hyperactivity-is-the-theory-of-knowledge-graphs-59 = mask-select hyperactivity-is-the-theory-of-knowledge-graphs-source (ranges-mask (cons (toNat #22251 , toNat #22779) nil))
hyperactivity-is-the-theory-of-knowledge-graphs-60 : List Word
hyperactivity-is-the-theory-of-knowledge-graphs-60 = mask-select hyperactivity-is-the-theory-of-knowledge-graphs-source (ranges-mask (cons (toNat #22779 , toNat #23203) nil))
hyperactivity-is-the-theory-of-knowledge-graphs-61 : List Word
hyperactivity-is-the-theory-of-knowledge-graphs-61 = unlines (cons "**What the line of Ceptr, the MetaCurrency Project and Holochain was building toward.** Ceptr aimed at distributed sense-making: a substrate where meaning, agreement" (cons "and value could be computed among people without silos. A knowledge graph whose objects carry their meaning, whose" (cons "edges carry their rationale, whose identities carry what they preserve, and whose validity is local and provable is" (cons "the completion of that program of distributed sense-making, with the mathematics it pointed at: univalence for meaning across representations," (cons "warrants for knowledge under partial observation, and maintained views for currency over time." nil)))))
hyperactivity-is-the-theory-of-knowledge-graphs-62 : List Word
hyperactivity-is-the-theory-of-knowledge-graphs-62 = mask-select hyperactivity-is-the-theory-of-knowledge-graphs-source (ranges-mask (cons (toNat #23762 , toNat #23781) nil))
hyperactivity-is-the-theory-of-knowledge-graphs-63 : List Word
hyperactivity-is-the-theory-of-knowledge-graphs-63 = unlines (cons "Knowledge-graph technology has spent twenty-five years adding layers to an assertion: provenance, identity links," (cons "rules, constraints, confidences, versions and retrieval. Hyperactivity replaces the assertion with a construction." (cons "An object is code with a type, addressed by content. An edge is a relation together with its rationale. Identity is" (cons "a path that determines what it transports. Evidence warrants exactly what holds over every compatible history." (cons "Derived knowledge is a maintained view whose certificate knows when it stops being current. The schema, the queries" (cons "and the language are values of the graph they govern. The work that produces and uses knowledge is part of the same" (cons "graph. Each of the five promises of a knowledge graph (identity, justification, composition, inference and currency) is a property of this object, and every existing format embeds in it." nil)))))))
