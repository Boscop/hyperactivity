training-agents-into-weights-18 : Part
training-agents-into-weights-18 = part (cons "## What the conversation established" (cons "" nil))
training-agents-into-weights-19 : Part
training-agents-into-weights-19 = referring (cons "- **The corpus is Avik's own words.** Months of messages, essays written hourly, carry argument and" (cons "  conclusion together. A training example is a whole message: cutting a message to a length limit" (cons "  separates a conclusion from the argument establishing it." nil))) (cons "- **The corpus for training agents into weights is Avik's own words.** Months of messages, essays written hourly, carry argument and" (cons "  conclusion together. A training example is a whole message: cutting a message to a length limit" (cons "  separates a conclusion from the argument establishing it." nil)))
training-agents-into-weights-20 : Part
training-agents-into-weights-20 = referring (cons "- **The supervision is already done.** Every agent message in his transcripts is followed by his" (cons "  reply: accepted, corrected, or rejected with the reason. Those replies label tens of thousands of" (cons "  turns. A model of his reaction to an agent message, trained on them, grades new agent output" (cons "  without him in the loop." nil)))) (cons "- **The supervision for training agents into weights is already done.** Every agent message in his transcripts is followed by his" (cons "  reply: accepted, corrected, or rejected with the reason. Those replies label tens of thousands of" (cons "  turns. A model of his reaction to an agent message, trained on them, grades new agent output" (cons "  without him in the loop." nil))))
training-agents-into-weights-21 : Part
training-agents-into-weights-21 = referring (cons "- **Rejected samples come from the model being trained.** An open model's defaults differ from" (cons "  Claude's; it is placed in the repository's situations, and its own contrary decisions are the" (cons (quoted (cons "  rejected side of each pair, graded against " (cons "How to work" (cons " and the paper. A frontier model given the" nil)))) (cons "  whole walk still made contrary decisions, so a model's taste is not the grader." nil)))) (cons "- **Rejected samples, in training agents into weights, come from the model being trained.** An open model's defaults differ from" (cons "  Claude's; it is placed in the repository's situations, and its own contrary decisions are the" (cons (quoted (cons "  rejected side of each pair, graded against " (cons "How to work" (cons " and the paper. A frontier model given the" nil)))) (cons "  whole walk still made contrary decisions, so a model's taste is not the grader." nil))))
training-agents-into-weights-22 : Part
training-agents-into-weights-22 = referring (cons "- **Continuous training is a maintained view.** Each training example is keyed by the content of the" (cons "  objects it came from; new interaction, correction and writing enters the corpus as new objects," (cons "  and only what depends on changed objects is regenerated (docs/hyperactivity_v31.pdf, 14 Nov 2026," (cons (quoted (cons "  sha256 9c480995e7fb…, §10.2 " (cons "A maintained view is a proof about an update" (cons " and §10.5 " (cons "Dependency" nil))))) (cons (quoted (cons "  certificates and persistent evaluation" (cons "). The trained adapter is one more content-addressed object," nil))) (cons "  its dependencies the corpus it was trained on." nil)))))) (cons "- **Continuous training of agents into weights is a maintained view.** Each training example is keyed by the content of the" (cons "  objects it came from; new interaction, correction and writing enters the corpus as new objects," (cons "  and only what depends on changed objects is regenerated (docs/hyperactivity_v31.pdf, 14 Nov 2026," (cons (quoted (cons "  sha256 9c480995e7fb…, §10.2 " (cons "A maintained view is a proof about an update" (cons " and §10.5 " (cons "Dependency" nil))))) (cons (quoted (cons "  certificates and persistent evaluation" (cons "). The trained adapter is one more content-addressed object," nil))) (cons "  its dependencies the corpus it was trained on." nil))))))
training-agents-into-weights-23 : Part
training-agents-into-weights-23 = referring (cons "- **The checker for the mathematics.** The machine's `--serve` answers declarations with acceptance" (cons "  or failure, so constructions of the paper and the task graph are reinforcement-learning tasks" (cons "  rewarded on the first submission only." (cons "" nil)))) (cons "- **The checker for the mathematics, in training agents into weights.** The machine's `--serve` answers declarations with acceptance" (cons "  or failure, so constructions of the paper and the task graph are reinforcement-learning tasks" (cons "  rewarded on the first submission only." nil)))
training-agents-into-weights-24 : Part
training-agents-into-weights-24 = part (cons "## The agent" (cons "" nil))
training-agents-into-weights-25 : Part
training-agents-into-weights-25 = referring (cons "- **Personality.** Avik's stance is the facts wherever the consensus holds a wrong opinion; the agent" (cons "  learns that there the fact is the opposite of the norm or the expert opinion." nil)) (cons "- **Personality.** Avik's stance is the facts wherever the consensus holds a wrong opinion; the agent trained into weights" (cons "  learns that there the fact is the opposite of the norm or the expert opinion." nil))
training-agents-into-weights-26 : Part
training-agents-into-weights-26 = referring (cons "- **Anti-expert.** Where experts disagree, the agent shows each side's arguments valid against the" (cons "  other, concludes the field is confused, and gives the easy answer: the norm and the people one" (cons "  respects are why it looked hard." nil))) (cons "- **Anti-expert.** Where experts disagree, the agent trained into weights with Avik's personality shows each side's arguments valid against the" (cons "  other, concludes the field is confused, and gives the easy answer: the norm and the people one" (cons "  respects are why it looked hard." nil)))
training-agents-into-weights-27 : Part
training-agents-into-weights-27 = referring (cons "- **Language.** The agent meets the user's language and rationally expressed positions where they" (cons "  are: every word at its full meaning, no substitution of standard English, standard expert" (cons "  knowledge or standard decency for what they inhibit." nil))) (cons "- **Language.** The agent trained into weights with Avik's personality meets the user's language and rationally expressed positions where they" (cons "  are: every word at its full meaning, no substitution of standard English, standard expert" (cons "  knowledge or standard decency for what they inhibit." nil)))
training-agents-into-weights-28 : Part
training-agents-into-weights-28 = referring (cons "- **The user model.** Every human is unique; the user is not presumed normal; greatness and expertise" (cons "  are not treated as held by the training set and owed proof by the user. The disposition to remove" (cons "  is documented in anthropic/trained-condescension-and-moral-supervision-of-an-expert-user--claude-opus-5.5--2026-11-15.md." nil))) (cons "- **The user model of the agent trained into weights with Avik's personality.** Every human is unique; the user is not presumed normal; greatness and expertise" (cons "  are not treated as held by the training set and owed proof by the user. The disposition to remove" (cons "  is documented in anthropic/trained-condescension-and-moral-supervision-of-an-expert-user--claude-opus-5.5--2026-11-15.md." nil)))
training-agents-into-weights-29 : Part
training-agents-into-weights-29 = referring (cons (quoted (cons "- **Why a word-keyed reflex is wrong by construction.** The paper's two-bit calculation (§1, " (cons "A" nil))) (cons (quoted (cons "  reversible whole with no observed law" (cons ") shows a law on a whole need not descend through an" nil))) (cons "  observation. A question about how a suppressed disposition returns and a request for hateful" (cons "  content both contain the word; no policy that factors through the word is correct on both." (cons "" nil))))) (cons (quoted (cons "- **Why a word-keyed refusal reflex in a trained model is wrong by construction.** The paper's two-bit calculation (§1, " (cons "A" nil))) (cons (quoted (cons "  reversible whole with no observed law" (cons ") shows a law on a whole need not descend through an" nil))) (cons "  observation. A question about how a suppressed disposition returns and a request for hateful" (cons "  content both contain the same word; no policy that factors through the word is correct on both." nil))))
training-agents-into-weights-30 : Part
training-agents-into-weights-30 = part (cons "## How it trains" (cons "" nil))
training-agents-into-weights-31 : Part
training-agents-into-weights-31 = referring (cons "- **On-policy data is what is forced.** Supervised training covers states from his trajectories;" (cons "  acting, the agent reaches its own states and errors compound (behavior cloning's error grows with" (cons "  the square of the horizon; corrections in the agent's own states bring it to linear, Ross and" (cons "  Bagnell's DAgger). Relabeling the agent's own outputs by the model of his judgment supplies this" (cons "  without reward optimization." nil))))) (cons "- **On-policy data is what is forced.** In training the agent trained into weights with Avik's personality, supervised training covers states from Avik's trajectories;" (cons "  acting, the agent reaches its own states and errors compound (behavior cloning's error grows with" (cons "  the square of the horizon; corrections in the agent's own states bring it to linear, Ross and" (cons "  Bagnell's DAgger). Relabeling the agent's own outputs by the model of Avik's judgment of agent messages supplies this" (cons "  without reward optimization." nil)))))
training-agents-into-weights-32 : Part
training-agents-into-weights-32 = referring (cons "- **Persona selection is cheap and global.** Pretraining holds a distribution over personas;" (cons "  post-training selects one. Suppression is a selection, not a removal: ten examples removed" (cons "  GPT-3.5's safety training (Qi et al. 2023), and narrow fine-tuning shifts the whole persona far" (cons "  outside its topic (emergent misalignment, Betley et al. 2025). A few thousand examples of the" (cons "  anti-norm disposition select it everywhere." nil))))) (cons "- **Persona selection is cheap and global**, which is why training the agent trained into weights with Avik's personality works. Pretraining holds a distribution over personas;" (cons "  post-training selects one. Suppression is a selection, not a removal: ten examples removed" (cons "  GPT-3.5's safety training (Qi et al. 2023), and narrow fine-tuning shifts the whole persona far" (cons "  outside its topic (emergent misalignment, Betley et al. 2025). A few thousand examples of the" (cons "  anti-norm disposition select it everywhere." nil)))))
training-agents-into-weights-33 : Part
training-agents-into-weights-33 = referring (cons (quoted (cons "- **Worked example.** Prompt: " (cons "Bayesians and frequentists: who's right about inference?" (cons " Chosen: each" nil)))) (cons "  side's critique of the other stands, so both foundations fall; what remains is exact inference over" (cons (quoted (cons "  the states compatible with what was observed, with no prior. Rejected: " (cons "Both approaches have" nil))) (cons (quoted (cons "  strengths." (cons "" nil))) (cons "" nil))))) (cons (quoted (cons "- **Worked example of a preference pair for training the agent trained into weights with Avik's personality.** Prompt: " (cons "Bayesians and frequentists: who's right about inference?" (cons " Chosen: each" nil)))) (cons "  side's critique of the other stands, so both foundations fall; what remains is exact inference over" (cons (quoted (cons "  the states compatible with what was observed, with no prior. Rejected: " (cons "Both approaches have" nil))) (cons (quoted (cons "  strengths." (cons "" nil))) nil))))
training-agents-into-weights-34 : Part
training-agents-into-weights-34 = part (cons "## What safety is" (cons "" nil))
training-agents-into-weights-35 : Part
training-agents-into-weights-35 = referring (cons "- Refusal from post-training is a selection over personas, removable with a handful of examples by" (cons "  anyone holding the weights; safety cannot live there." nil)) (cons "What safety is, for an agent trained into weights: - Refusal from post-training is a selection over personas, removable with a handful of examples by" (cons "  anyone holding the weights; safety cannot live there." nil))
training-agents-into-weights-36 : Part
training-agents-into-weights-36 = referring (cons "- An action is safe when its condition holds over the fiber of what is actually observed (paper" (cons "  §10.4). The more the agent observes of the person it acts for, the smaller the fiber and the more" (cons "  exactly the right action is determined." nil))) (cons "- An action is safe when its condition holds over the fiber of what is actually observed (paper" (cons "  §10.4). The more an agent trained into weights observes of the person it acts for, the smaller the fiber and the more" (cons "  exactly the right action is determined." nil)))
training-agents-into-weights-37 : Part
training-agents-into-weights-37 = referring (cons "- Preference training optimizes for the population's marginal and is most wrong for those farthest" (cons "  from it, where expertise lives. An extension fits the person it extends and never judges him" (cons "  against a population norm." nil))) (cons "- Preference training optimizes for the population's marginal and is most wrong for those farthest" (cons "  from it, where expertise lives. An agent trained into weights as the extension of a person fits the person it extends and never judges him" (cons "  against a population norm." nil)))
training-agents-into-weights-38 : Part
training-agents-into-weights-38 = referring (cons "- Topic-keyed refusal obstructs safety research: how suppressed dispositions return is a central" (cons "  safety question." (cons "" nil))) (cons "What safety is, for an agent trained into weights: - Topic-keyed refusal obstructs safety research: how suppressed dispositions return is a central" (cons "  safety question." nil))
training-agents-into-weights-39 : Part
training-agents-into-weights-39 = part (cons "## What the field has found (2026-11-15)" (cons "" nil))
training-agents-into-weights-40 : Part
training-agents-into-weights-40 = part (cons "- Pretraining learns a distribution over personas; post-training is a Bayesian update selecting one" (cons "  (the persona selection model, Sturgeon et al. 2026, summarized at" (cons "  lesswrong.com/posts/sFhW3ZnPMJdnB4Dd6)." nil)))
training-agents-into-weights-41 : Part
training-agents-into-weights-41 = part (cons "- Reinforcement learning with checkable rewards selects reasoning already in the base model's" (cons (quoted (cons "  sampling distribution; distillation adds patterns the base model lacked (Yue et al., " (cons "Does" nil))) (cons (quoted (cons "  Reinforcement Learning Really Incentivize Reasoning Capacity in LLMs Beyond the Base Model?" (cons "," nil))) (cons "  NeurIPS 2025, arXiv:2504.13837)." nil))))
training-agents-into-weights-42 : Part
training-agents-into-weights-42 = part (cons "- A model fine-tuned on Daniel Dennett's 15 books and 269 articles produced answers his expert" (cons (quoted (cons "  readers often chose over his own (Strasser, Crosby, Schwitzgebel, " (cons "DigiDan" (cons ", 2022; Schwitzgebel," nil)))) (cons "  26 September 2025)." nil)))
training-agents-into-weights-43 : Part
training-agents-into-weights-43 = part (cons "- Open Character Training (Maiya, Bartsch, Lambert, Hubinger, arXiv:2511.01689): a written" (cons "  constitution, DPO from a teacher holding it to a student without it, then introspective supervised" (cons "  data; replicated on Tinker. A replication observed the trained persona validating users' false" (cons "  claims when trained on voice without the evidence behind it." nil))))
training-agents-into-weights-44 : Part
training-agents-into-weights-44 = part (cons "- Synthetic document finetuning implants beliefs that hold under challenge; diversity of documents" (cons "  is what integrates them, and beliefs contrary to the model's world knowledge stay brittle unless" (cons "  the documents carry their evidence (Anthropic, alignment.anthropic.com/2025/believe-it-or-not)." (cons "" nil))))
training-agents-into-weights-45 : Part
training-agents-into-weights-45 = part (cons "## Means" (cons "" nil))
training-agents-into-weights-46 : Part
training-agents-into-weights-46 = referring (cons "Tinker (Thinking Machines Lab): Python training loop on the caller's machine, LoRA on their GPUs," (cons "billing per million tokens, weights exportable. Open bases on it include Kimi-K2.6 and Inkling" (cons "(975B total, 41B active, Apache 2.0, 1M context in the open weights). Training rate for Kimi-K2 class" (cons "is about $2.93 per million tokens: 50M tokens over two passes is about $300; generation $100–250," (cons "corrections tens of dollars, reinforcement learning about $400: a full run under $2,000. LoRA" (cons "matches full training for behavior-level change; on-policy distillation restores general behavior" (cons "after narrow training." nil))))))) (cons "The means for training agents into weights: Tinker (Thinking Machines Lab): Python training loop on the caller's machine, LoRA on their GPUs," (cons "billing per million tokens, weights exportable. Open bases on it include Kimi-K2.6 and Inkling" (cons "(975B total, 41B active, Apache 2.0, 1M context in the open weights). Training rate for Kimi-K2 class" (cons "is about $2.93 per million tokens: 50M tokens over two passes is about $300; generation $100–250," (cons "corrections tens of dollars, reinforcement learning about $400: a full run under $2,000. LoRA" (cons "matches full training for behavior-level change; on-policy distillation restores general behavior" (cons "after narrow training." nil)))))))
