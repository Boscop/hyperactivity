-- the truncation cases, which the number never reaches: g10 on squash₂ (isSetℤ, Hedberg, checked in
-- std) and surfc on squash₄ (fill4OverSets, checked in brunerie.cub)
z1 = t2inc (pos (suc zero))
sq2 = λ (i : I) (j : I) → g10 (squash2 z1 z1 (λ (m : I) → z1) (λ (m : I) → z1) i j)
#same sq2 = λ (i : I) (j : I) → pos (suc zero)
-- a squash₄ cube whose 2-cells are the surface: surfc on it at generic dimensions, read at the corner
-- of Ω², is the cube's point (the corners of Ω²(K₂, y) are y)
rr = λ (m : I) (n : I) → tinc (surf m n)
tt = λ (m : I) (n : I) (o : I) → tinc (surf n o)
sq4 x = surfc x
#same (λ (i : I) (j : I) (k : I) (l : I) → sq4 (squash4 X0 X0 (λ (m : I) → X0) (λ (m : I) → X0) rr rr tt tt i j k l) @ 0 @ 0)
    = λ (i : I) (j : I) (k : I) (l : I) → squash4 X0 X0 (λ (m : I) → X0) (λ (m : I) → X0) rr rr tt tt i j k l
