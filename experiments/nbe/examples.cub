-- experiments/nbe/examples.cub — lib/nbe.cub's normalizer over cubes run on derivations (rewritten
-- 2026-11-14 over the families that replaced P1's): P1's examples, a path λ, variables of function and
-- path type η-expanded, case on a variable and on a constant; interval expressions in normal form; path
-- application on cubes; substitution on checked syntax; the checker.
import "../../lib/nbe.cub"
-- ---------------------------------------------------------------- the empty context, Bool → Bool
emp2 : CCtx
emp2 = (lnil , one)
bb-fam : Fam s-bool s-bool
bb-fam = (one , λ x → one)
-- λ x. x : Bool → Bool, its meaning in the empty context
id-X : Mean emp2 (TV (s-pi s-bool s-bool))
id-X = λ ρ → (bb-fam , λ x → x)
id-d : Der (j-tm , emp2 , s-pi s-bool s-bool , clam (cvar #0) , id-X)
id-d = dlam emp2 s-bool s-bool id-X c-bool (cvar #0) (dty-bool emp2 (λ ρ → one))
  (dvar (lam-ctx emp2 s-bool s-bool id-X) none)
#same fst (normalize-nf emp2 tc-nil (s-pi s-bool s-bool) (clam (cvar #0) , id-X , id-d)) = clam (cvar #0)
-- (λ x. x) true : Bool, a β-redex, normalizes to true
app-R : Mean emp2 (AppV s-bool s-bool)
app-R = λ ρ → (bb-fam , (λ x → x) , true)
app-d : Der (j-tm , emp2 , s-bool , capp (clam (cvar #0)) c-true , fmapM emp2 (AppV s-bool s-bool) (TV s-bool) (app-r s-bool s-bool) app-R)
app-d = dapp emp2 s-bool s-bool app-R (clam (cvar #0)) c-true id-d (dtrue emp2 (λ ρ → one))
#same fst (normalize-nf emp2 tc-nil s-bool (capp (clam (cvar #0)) c-true , fmapM emp2 (AppV s-bool s-bool) (TV s-bool) (app-r s-bool s-bool) app-R , app-d)) = c-true
-- ---------------------------------------------------------------- a path λ
-- ⟨i⟩ true : PathP (λ i → Bool) true true
pt-X : Mean emp2 (TV (s-path s-bool))
pt-X = λ ρ → (((one , one , λ i → one) , true , true) , λ i → true)
pt-d : Der (j-tm , emp2 , s-path s-bool , cplam c-true , pt-X)
pt-d = dplam emp2 s-bool pt-X c-true (dtrue (dext emp2) ((λ ρ → one) , (λ ρ → one) , λ i ρ → one))
#same fst (normalize-nf emp2 tc-nil (s-path s-bool) (cplam c-true , pt-X , pt-d)) = cplam c-true
-- ---------------------------------------------------------------- a variable of function type
-- f : Bool → Bool in context; f normalizes to its η-expansion λ x. f x
bb-T : Mean emp2 (Fam s-bool s-bool)
bb-T = λ ρ → bb-fam
bb-dT : Der (j-ty , emp2 , s-pi s-bool s-bool , cpi #2 c-bool c-bool , bb-T)
bb-dT = dty-pi emp2 s-bool s-bool bb-T c-bool c-bool (dty-bool emp2 (λ ρ → one))
  (dty-bool (ext-h emp2 s-bool (Fam s-bool s-bool) (fam-dom s-bool s-bool) bb-T) (λ ρ → one))
Γf2 : CCtx
Γf2 = ext-h emp2 (s-pi s-bool s-bool) (Sem (s-pi s-bool s-bool)) (λ A → A) bb-T
tΓf2 : TCtx Γf2
tΓf2 = tc-ty emp2 tc-nil (s-pi s-bool s-bool) bb-T (cpi #2 c-bool c-bool) bb-dT
f-d : Der (j-tm , Γf2 , s-pi s-bool s-bool , cvar #0 , varCube Γf2 none)
f-d = dvar Γf2 none
#same fst (normalize-nf Γf2 tΓf2 (s-pi s-bool s-bool) (cvar #0 , varCube Γf2 none , f-d)) = clam (capp (cvar #1) (cvar #0))
-- ---------------------------------------------------------------- case on a variable
-- b : Bool in context; not b = case b of true → false; false → true is neutral, and stays
Γb2 : CCtx
Γb2 = ext-h emp2 s-bool (Sem s-bool) (λ A → A) (λ ρ → one)
tΓb2 : TCtx Γb2
tΓb2 = tc-ty emp2 tc-nil s-bool (λ ρ → one) c-bool (dty-bool emp2 (λ ρ → one))
not-R : Mean Γb2 (CaseV s-bool)
not-R = λ ρ → (one , (λ b → one) , snd ρ , false , true)
not-d : Der (j-tm , Γb2 , s-bool , c-case c-bool c-false c-true (cvar #0) , fmapM Γb2 (CaseV s-bool) (TV s-bool) (case-r s-bool) not-R)
not-d = dcase Γb2 s-bool not-R c-bool (cvar #0) c-false c-true
  (dty-bool (ext-h Γb2 s-bool (CaseV s-bool) (case-b s-bool) not-R) (λ ρ → one))
  (dvar Γb2 none) (dfalse Γb2 (λ ρ → one)) (dtrue Γb2 (λ ρ → one))
#same fst (normalize-nf Γb2 tΓb2 s-bool (c-case c-bool c-false c-true (cvar #0) , fmapM Γb2 (CaseV s-bool) (TV s-bool) (case-r s-bool) not-R , not-d)) = c-case c-bool c-false c-true (cvar #0)
-- not true normalizes to false (the case on a constant: its branch)
nt-R : Mean emp2 (CaseV s-bool)
nt-R = λ ρ → (one , (λ b → one) , true , false , true)
nt-d : Der (j-tm , emp2 , s-bool , c-case c-bool c-false c-true c-true , fmapM emp2 (CaseV s-bool) (TV s-bool) (case-r s-bool) nt-R)
nt-d = dcase emp2 s-bool nt-R c-bool c-true c-false c-true
  (dty-bool (ext-h emp2 s-bool (CaseV s-bool) (case-b s-bool) nt-R) (λ ρ → one))
  (dtrue emp2 (λ ρ → one)) (dfalse emp2 (λ ρ → one)) (dtrue emp2 (λ ρ → one))
#same fst (normalize-nf emp2 tc-nil s-bool (c-case c-bool c-false c-true c-true , fmapM emp2 (CaseV s-bool) (TV s-bool) (case-r s-bool) nt-R , nt-d)) = c-false
-- ---------------------------------------------------------------- a variable of path type
-- p : PathP (λ i → Bool) true true in context; p normalizes to its η-expansion ⟨i⟩ p @ i (the path
-- applied at the new dimension, a canonical non-constant form)
pp-T : Mean emp2 (Sem (s-path s-bool))
pp-T = λ ρ → ((one , one , λ i → one) , true , true)
pp-dT : Der (j-ty , emp2 , s-path s-bool , cpathp (cplam c-bool) c-true c-true , pp-T)
pp-dT = dty-path emp2 s-bool pp-T c-bool c-true c-true (dty-bool (dext emp2) ((λ ρ → one) , (λ ρ → one) , λ i ρ → one))
  (dtrue emp2 (λ ρ → one)) (dtrue emp2 (λ ρ → one))
Γp2 : CCtx
Γp2 = ext-h emp2 (s-path s-bool) (Sem (s-path s-bool)) (λ A → A) pp-T
tΓp2 : TCtx Γp2
tΓp2 = tc-ty emp2 tc-nil (s-path s-bool) pp-T (cpathp (cplam c-bool) c-true c-true) pp-dT
#same fst (normalize-nf Γp2 tΓp2 (s-path s-bool) (cvar #0 , varCube Γp2 none , dvar Γp2 none)) = cplam (cpapp (cvar #1) (dnf-code dnf-v0))

-- ---------------------------------------------------------------- P2: interval expressions in normal form
-- (i ∧ ~j) ∨ (~j ∧ i) ∨ i is i; ~(i ∨ j) is ~i ∧ ~j; i ∧ ~i stays (the algebra is not Boolean); i ∨ 1 is 1
#same dnf-code (case dnf-of (cjoin (cmeet (cvar #0) (cneg (cvar #1))) (cjoin (cmeet (cneg (cvar #1)) (cvar #0)) (cvar #0))) of none → ci0; some f → f) = cvar #0
#same dnf-code (case dnf-of (cneg (cjoin (cvar #0) (cvar #1))) of none → ci0; some f → f) = cmeet (cneg (cvar #0)) (cneg (cvar #1))
#same dnf-code (case dnf-of (cmeet (cvar #0) (cneg (cvar #0))) of none → ci0; some f → f) = cmeet (cneg (cvar #0)) (cvar #0)
#same dnf-code (case dnf-of (cjoin (cvar #2) ci1) of none → ci0; some f → f) = ci1
#same dnf-canon (lcons (lcons (#0 , true) lnil) (lcons (lcons (#0 , true) (lcons (#1 , true) lnil)) lnil)) = false
-- ---------------------------------------------------------------- P2: path application on cubes
-- in a context with one dimension i: a line L applied at i is L itself (diagonal of i with the line's
-- direction, the line degenerate in i); at ~i its reversal; at i ∧ ~i the diagonal of the connection
pa-i : (X : Type 1) (L : Line X) →
  PathP (λ k → Line X) (papp-cube (lcons e-dim lnil) X (lcons (lcons (#0 , true) lnil) lnil) (degen-l (Line X) L)) L
pa-i X L = λ k → L
pa-ni : (X : Type 1) (L : Line X) →
  PathP (λ k → Line X) (papp-cube (lcons e-dim lnil) X (lcons (lcons (#0 , false) lnil) lnil) (degen-l (Line X) L)) (rev-l X L)
pa-ni X L = λ k → rev-l X L
-- in the empty context, at 0 and at 1: the endpoints
pa-0 : (X : Type 1) (L : Line X) → PathP (λ k → X) (papp-cube lnil X dnf-zero L) (fst L)
pa-0 X L = λ k → fst L
pa-1 : (X : Type 1) (L : Line X) → PathP (λ k → X) (papp-cube lnil X dnf-one L) (fst (snd L))
pa-1 X L = λ k → fst (snd L)
-- in a context i, j (j newest, index #0; i index #1): a line L degenerate in both, at i is λ i j → L i,
-- at j is λ i j → L j, at i ∧ j is λ i j → L (i ∧ j)
pa-2 : Lst Entry
pa-2 = lcons e-dim (lcons e-dim lnil)
pa-c : (X : Type 1) → Line X → Cube (suc (dims pa-2)) X
pa-c X L = degen-l (Line (Line X)) (degen-l (Line X) L)
pa-at-i : (X : Type 1) (L : Line X) →
  PathP (λ k → Line (Line X)) (papp-cube pa-2 X (lcons (lcons (#1 , true) lnil) lnil) (pa-c X L)) (line-map X (Line X) (degen-l X) L)
pa-at-i X L = λ k → line-map X (Line X) (degen-l X) L
pa-at-j : (X : Type 1) (L : Line X) →
  PathP (λ k → Line (Line X)) (papp-cube pa-2 X (lcons (lcons (#0 , true) lnil) lnil) (pa-c X L)) (degen-l (Line X) L)
pa-at-j X L = λ k → degen-l (Line X) L
pa-at-ij : (X : Type 1) (L : Line X) →
  PathP (λ k → Line (Line X)) (papp-cube pa-2 X (lcons (lcons (#0 , true) (lcons (#1 , true) lnil)) lnil) (pa-c X L)) (meet-l X L)
pa-at-ij X L = λ k → meet-l X L
-- ---------------------------------------------------------------- substitution on checked syntax
-- x := true in not x (x : Bool): the substitution emp2 → Γb2 (ext-at at true's meaning), its checked
-- term (true's derivation carried to σ's action on x by ext-new and via-snd), and the substituted
-- term read back: false
one-u : Mean emp2 One1
one-u = λ ρ → one
sx-A : Mean emp2 (TV s-bool)
sx-A = fmapM emp2 One1 (TV s-bool) (bool-v true) one-u
sx-p : PathM emp2 (Sem s-bool) (fmapM emp2 (TV s-bool) (Sem s-bool) (λ z → fst z) sx-A) (fmapM emp2 (Sem s-bool) (Sem s-bool) (λ y → y) (subM emp2 emp2 (Sem s-bool) (sub-id emp2) one-u))
sx-p = pcat (Mean emp2 One1) (fmapM emp2 (TV s-bool) (Sem s-bool) (λ z → fst z) sx-A) (fmapM emp2 One1 One1 (λ y → y) one-u) (fmapM emp2 (Sem s-bool) (Sem s-bool) (λ y → y) (subM emp2 emp2 (Sem s-bool) (sub-id emp2) one-u))
  (fmapM-fmapM emp2 One1 (TV s-bool) One1 (bool-v true) (λ z → fst z) one-u)
  (cong1 (Mean emp2 One1) (Mean emp2 One1) (λ N → fmapM emp2 One1 One1 (λ y → y) N) one-u (subM emp2 emp2 One1 (sub-id emp2) one-u)
     (psym (Mean emp2 One1) (subM emp2 emp2 One1 (sub-id emp2) one-u) one-u (subM-id emp2 One1 one-u)))
σx : Sub emp2 Γb2
σx = ext-at emp2 emp2 s-bool (Sem s-bool) (Sem s-bool) (λ y → y) (λ y → y) one-u (sub-id emp2) sx-A sx-p
sx-zpt : Mean emp2 ((yz : Sem s-bool) × El s-bool yz)
sx-zpt = zpt emp2 emp2 s-bool (Sem s-bool) (Sem s-bool) (λ y → y) (λ y → y) one-u (sub-id emp2) sx-A sx-p
sx-var : PathM emp2 (TV s-bool) sx-A (subM emp2 Γb2 (TV s-bool) σx (varCube Γb2 none))
sx-var = pcat (Mean emp2 (TV s-bool)) sx-A (fmapM emp2 (TV s-bool) (TV s-bool) (λ q → q) sx-A) (subM emp2 Γb2 (TV s-bool) σx (varCube Γb2 none))
  (psym (Mean emp2 (TV s-bool)) (fmapM emp2 (TV s-bool) (TV s-bool) (λ q → q) sx-A) sx-A (fmap-id (dims (fst emp2)) (CtxV (fst emp2)) (FbE (fst emp2) (TV s-bool)) (snd emp2) sx-A))
  (pcat (Mean emp2 (TV s-bool)) (fmapM emp2 (TV s-bool) (TV s-bool) (λ q → q) sx-A) (fmapM emp2 ((yz : Sem s-bool) × El s-bool yz) (TV s-bool) (λ z → (fst z , snd z)) sx-zpt) (subM emp2 Γb2 (TV s-bool) σx (varCube Γb2 none))
     (via-snd emp2 emp2 s-bool (Sem s-bool) (Sem s-bool) (λ y → y) (λ y → y) one-u (sub-id emp2) sx-A sx-p (TV s-bool) (λ q → q))
     (psym (Mean emp2 (TV s-bool)) (subM emp2 Γb2 (TV s-bool) σx (varCube Γb2 none)) (fmapM emp2 ((yz : Sem s-bool) × El s-bool yz) (TV s-bool) (λ z → (fst z , snd z)) sx-zpt)
        (ext-new emp2 emp2 s-bool (Sem s-bool) (Sem s-bool) (λ y → y) (λ y → y) one-u (sub-id emp2) sx-A sx-p)))
sx-v : (v : VarP (fst Γb2)) → (dc : Code) × Der (j-tm , emp2 , var-shape (fst Γb2) v , dc , subM emp2 Γb2 (TV (var-shape (fst Γb2) v)) σx (varCube Γb2 v))
sx-v none = (c-true , d-tr t-any j-tm emp2 s-bool c-true sx-A (subM emp2 Γb2 (TV s-bool) σx (varCube Γb2 none)) sx-var (dtrue emp2 one-u))
sx-v (some w) = case w of Empty
dsx : DSubst Γb2 emp2 σx
dsx = (unit , sx-v)
#same fst (subst-tm Γb2 emp2 tc-nil σx dsx s-bool (c-case c-bool c-false c-true (cvar #0) , fmapM Γb2 (CaseV s-bool) (TV s-bool) (case-r s-bool) not-R , not-d)) = c-false

-- ---------------------------------------------------------------- the checker: raw codes to derivations
-- types; f true, f f refused; λ x. x and λ x. true against Bool → Bool; a variable against a Π type
-- (conversion by contraction); (true, false); not b by case; PathP (λ i. Bool) true true
shape-of : (Γ : CCtx) (c : Code) → Dec1 (Out Γ c m-ty) → Opt TyShape
shape-of Γ c c-refused = none
shape-of Γ c (c-derived r) = some (fst r)
nil-vs : Vals (lnil , one)
nil-vs v = case v of Empty
#same shape-of (lnil , one) (cpi #2 c-bool (csigma c-bool c-bool)) (check-code (lnil , one) nil-vs (cpi #2 c-bool (csigma c-bool c-bool)) m-ty) = some (s-pi s-bool (s-sig s-bool s-bool))
#same shape-of (lnil , one) (cpi #3 c-bool c-bool) (check-code (lnil , one) nil-vs (cpi #3 c-bool c-bool) m-ty) = none
okc : (Γ : CCtx) (c : Code) (m : Mode Γ) → Dec1 (Out Γ c m) → Bool
okc Γ c m c-refused = false
okc Γ c m (c-derived r) = true
emp : CCtx
emp = (lnil , one)
#same okc emp c-true (m-chk s-bool (one-mean emp) one) (check-code emp nil-vs c-true (m-chk s-bool (one-mean emp) one)) = true
#same okc emp (cfst c-true) m-inf (check-code emp nil-vs (cfst c-true) m-inf) = false
-- f : Bool → Bool in context; f true inferred at Bool
bbT1 : Mean emp (Fam s-bool s-bool)
bbT1 = λ ρ → (one , λ x → one)
ΓF : CCtx
ΓF = ext-h emp (s-pi s-bool s-bool) (Sem (s-pi s-bool s-bool)) (λ A → A) bbT1
vsF : Vals ΓF
vsF = id-vals (tc-ty emp tc-nil (s-pi s-bool s-bool) bbT1 (cpi #2 c-bool c-bool) (dty-pi emp s-bool s-bool bbT1 c-bool c-bool (dty-bool emp (λ ρ → one)) (dty-bool (ext-h emp s-bool (Fam s-bool s-bool) (fam-dom s-bool s-bool) bbT1) (λ ρ → one))))
#same okc ΓF (capp (cvar #0) c-true) m-inf (check-code ΓF vsF (capp (cvar #0) c-true) m-inf) = true
#same okc ΓF (capp (cvar #0) (cvar #0)) m-inf (check-code ΓF vsF (capp (cvar #0) (cvar #0)) m-inf) = false
-- λ x. x and λ x. f x checked against Bool → Bool
bbT0 : Mean emp (Sem (s-pi s-bool s-bool))
bbT0 = λ ρ → (one , λ x → one)
#same okc emp (clam (cvar #0)) (m-chk (s-pi s-bool s-bool) bbT0 (one , λ Δ' w Y p c → one)) (check-code emp nil-vs (clam (cvar #0)) (m-chk (s-pi s-bool s-bool) bbT0 (one , λ Δ' w Y p c → one))) = true
#same okc emp (clam c-true) (m-chk (s-pi s-bool s-bool) bbT0 (one , λ Δ' w Y p c → one)) (check-code emp nil-vs (clam c-true) (m-chk (s-pi s-bool s-bool) bbT0 (one , λ Δ' w Y p c → one))) = true
-- (true , false) against Bool × Bool
#same okc emp (cpair c-true c-false) (m-chk (s-sig s-bool s-bool) bbT0 (one , λ Δ' w Y p c → one)) (check-code emp nil-vs (cpair c-true c-false) (m-chk (s-sig s-bool s-bool) bbT0 (one , λ Δ' w Y p c → one))) = true
-- not b = case b of true → false; false → true, b : Bool, inferred at Bool
bT1 : Mean emp (Sem s-bool)
bT1 = λ ρ → one
Γb : CCtx
Γb = ext-h emp s-bool (Sem s-bool) (λ A → A) bT1
vsb : Vals Γb
vsb = id-vals (tc-ty emp tc-nil s-bool bT1 c-bool (dty-bool emp bT1))
#same okc Γb (c-case c-bool c-false c-true (cvar #0)) m-inf (check-code Γb vsb (c-case c-bool c-false c-true (cvar #0)) m-inf) = true
-- PathP (λ i. Bool) true true
#same shape-of emp (cpathp (cplam c-bool) c-true c-true) (check-code emp nil-vs (cpathp (cplam c-bool) c-true c-true) m-ty) = some (s-path s-bool)
-- with f : Bool → Bool in context, f checked against Bool → Bool (a switch at a Π type: conversion by contraction)
#same okc ΓF (cvar #0) (m-chk (s-pi s-bool s-bool) (λ ρ → (one , λ x → one)) (one , λ Δ' w Y p c → one)) (check-code ΓF vsF (cvar #0) (m-chk (s-pi s-bool s-bool) (λ ρ → (one , λ x → one)) (one , λ Δ' w Y p c → one))) = true

