dnf-drop-sup-sound : (sk : Lst Entry) (c : Conj) (f : DNF) → IEq sk (ixjoin (conj-ix c) (dnf-ix (dnf-drop-sup c f))) (ixjoin (conj-ix c) (dnf-ix f))
