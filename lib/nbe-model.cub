lineo-lift : (X X' : Type 1) (Y : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') →
  ((x : X) (y : Y x) → F' (f x y)) → (L : Line X) (D : LineO X Y L) → LineO X' F' (lineo-map X Y X' f L D)
lineo-lift X X' Y F' f g L D = (g (fst L) (fst D) , g (fst (snd L)) (fst (snd D)) , λ i → g (snd (snd L) i) (snd (snd D) i))
map-lift : (n : Nat) (X X' : Type 1) (Y : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y))
  (Z : Type 1) (k : (x' : X') → F' x' → Z) (c : Cube n X) (d : DCube n X Y c) →
  PathP (λ i → Cube n Z) (dcube-map n X' F' Z k (dcube-map n X Y X' f c d) (dcube-lift n X X' Y F' f g c d)) (dcube-map n X Y Z (λ x y → k (f x y) (g x y)) c d)
map-lift zero X X' Y F' f g Z k c d = λ i → k (f c d) (g c d)
map-lift (suc n) X X' Y F' f g Z k c d =
  map-lift n (Line X) (Line X') (LineO X Y) (LineO X' F') (lineo-map X Y X' f) (lineo-lift X X' Y F' f g) (Line Z) (lineo-map X' F' Z k) c d
fmap-lift : (n : Nat) (X X' : Type 1) (Y : X → Type 1) (F' F2 : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y))
  (h : (x' : X') → F' x' → F2 x') (c : Cube n X) (d : DCube n X Y c) →
  PathP (λ i → DCube n X' F2 (dcube-map n X Y X' f c d))
    (dcube-fmap n X' F' F2 h (dcube-map n X Y X' f c d) (dcube-lift n X X' Y F' f g c d)) (dcube-lift n X X' Y F2 f (λ x y → h (f x y) (g x y)) c d)
fmap-lift zero X X' Y F' F2 f g h c d = λ i → h (f c d) (g c d)
fmap-lift (suc n) X X' Y F' F2 f g h c d =
  fmap-lift n (Line X) (Line X') (LineO X Y) (LineO X' F') (LineO X' F2) (lineo-map X Y X' f) (lineo-lift X X' Y F' f g) (lineo-fmap X' F' F2 h) c d
of-lift : (n : Nat) (X X' : Type 1) (Y : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x' : X') → F' x') (c : Cube n X) (d : DCube n X Y c) →
  PathP (λ i → DCube n X' F' (dcube-map n X Y X' f c d)) (dcube-of n X' F' g (dcube-map n X Y X' f c d)) (dcube-lift n X X' Y F' f (λ x y → g (f x y)) c d)
of-lift zero X X' Y F' f g c d = λ i → g (f c d)
of-lift (suc n) X X' Y F' f g c d = of-lift n (Line X) (Line X') (LineO X Y) (LineO X' F') (lineo-map X Y X' f) (lineo-of X' F' g) c d
dmap-fmap : (n : Nat) (X : Type 1) (F F' : X → Type 1) (Z : Type 1) (h : (x : X) → F x → F' x) (k : (x : X) → F' x → Z) (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → Cube n Z) (dcube-map n X F' Z k c (dcube-fmap n X F F' h c d)) (dcube-map n X F Z (λ x y → k x (h x y)) c d)
dmap-fmap zero X F F' Z h k c d = λ i → k c (h c d)
dmap-fmap (suc n) X F F' Z h k c d = dmap-fmap n (Line X) (LineO X F) (LineO X F') (Line Z) (lineo-fmap X F F' h) (lineo-map X F' Z k) c d
