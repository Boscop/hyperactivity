-- lib/nbe-model.cub — the model for lib/nbe.cub: semantic types, contexts and meanings over the cubes of
-- lib/cube.cub, derivations (Der, NN), substitution and renaming of meanings (Sub, World), and path application's
-- commutation with them; continued by lib/nbe-cmap.cub, nbe-subst.cub and nbe-interval.cub.
import "cube.cub"
import "linproof.cub"
TyU : Type 2
TyU = (uM : Type 1) × (uM → Type)
TyE : TyShape → TyU
TyE s-bool = (One1 , λ D̂ → Bool)
TyE (s-pi a b) =
  ((Â : fst (TyE a)) × (snd (TyE a) Â → fst (TyE b)) ,
   λ D̂ → (x̂ : snd (TyE a) (fst D̂)) → snd (TyE b) (snd D̂ x̂))
TyE (s-sig a b) =
  ((Â : fst (TyE a)) × (snd (TyE a) Â → fst (TyE b)) ,
   λ D̂ → (x̂ : snd (TyE a) (fst D̂)) × snd (TyE b) (snd D̂ x̂))
TyE (s-path a) =
  ((pL̂ : (Â0 : fst (TyE a)) × (Â1 : fst (TyE a)) × PathP (λ i → fst (TyE a)) Â0 Â1) × snd (TyE a) (fst pL̂) × snd (TyE a) (fst (snd pL̂)) ,
   λ D̂ → PathP (λ i → snd (TyE a) (snd (snd (fst D̂)) i)) (fst (snd D̂)) (snd (snd D̂)))
Sem : TyShape → Type 1
Sem s = fst (TyE s)
El : (s : TyShape) → Sem s → Type
El s = snd (TyE s)
Fam : TyShape → TyShape → Type 1
Fam a b = (A : Sem a) × (El a A → Sem b)
CtxU : Type 2
CtxU = (uM : Type 1) × (uM → Type 1)
CtxE : Lst Entry → CtxU
CtxE lnil = (One1 , λ γ → One1)
CtxE (lcons e-dim sk) = CtxE sk
CtxE (lcons (e-ty s) sk) =
  ((γ : fst (CtxE sk)) × (snd (CtxE sk) γ → Sem s) ,
   λ p → (ρ : snd (CtxE sk) (fst p)) × El s (snd p ρ))
bool-elim : (P : Bool → Type) → P true → P false → (b : Bool) → P b
bool-elim P t f true = t
bool-elim P t f false = f
data NK = k-ne | k-nf
c-true : Code
c-true = ccon #0 #0 lnil lnil
c-false : Code
c-false = ccon #0 #1 lnil lnil
c-case : Code → Code → Code → Code → Code
c-case cP t f x = celim #0 (clam cP) (lcons t (lcons f lnil)) x
CtxV : Lst Entry → Type 1
CtxV sk = fst (CtxE sk)
EnvV : (sk : Lst Entry) → CtxV sk → Type 1
EnvV sk γ = snd (CtxE sk) γ
FbE : (sk : Lst Entry) (Z : Type 1) → CtxV sk → Type 1
FbE sk Z γ = EnvV sk γ → Z
CCtx : Type 1
CCtx = (ccsk : Lst Entry) × Cube (dims ccsk) (CtxV ccsk)
Mean : CCtx → Type 1 → Type 1
Mean Γ Z = DCube (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ)
fmapM : (Γ : CCtx) (Z Z' : Type 1) → (Z → Z') → Mean Γ Z → Mean Γ Z'
fmapM Γ Z Z' h M = dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → h (e ρ)) (snd Γ) M
TV : TyShape → Type 1
TV s = (tvA : Sem s) × El s tvA
extM : (Γ : CCtx) (a : TyShape) (Y : Type 1) (f : (γ : CtxV (fst Γ)) → (EnvV (fst Γ) γ → Y) → EnvV (fst Γ) γ → Sem a) → Mean Γ Y → CCtx
extM Γ a Y f M =
  (lcons (e-ty a) (fst Γ) ,
   dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (CtxV (lcons (e-ty a) (fst Γ))) (λ γ e → (γ , f γ e)) (snd Γ) M)
dext : CCtx → CCtx
dext Γ = (lcons e-dim (fst Γ) , cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (snd Γ))
wkM : (Γ : CCtx) (a : TyShape) (Y : Type 1) (f : (γ : CtxV (fst Γ)) → (EnvV (fst Γ) γ → Y) → EnvV (fst Γ) γ → Sem a) (M : Mean Γ Y)
  (Z : Type 1) → Mean Γ Z → Mean (extM Γ a Y f M) Z
wkM Γ a Y f M Z N =
  dcube-push (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y) (FbE (fst Γ) Z) (FbE (lcons (e-ty a) (fst Γ)) Z)
    (λ γ e → (γ , f γ e)) (λ γ e N' ρ → N' (fst ρ)) (snd Γ) M N
dwkM : (Γ : CCtx) (Z : Type 1) → Mean Γ Z → Mean (dext Γ) Z
dwkM Γ Z N =
  dcube-reidx (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (FbE (fst Γ) Z) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z))
    (degen-l (CtxV (fst Γ))) (degen-o (CtxV (fst Γ)) (FbE (fst Γ) Z)) (snd Γ) N
ext-h : (Δ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) → CCtx
ext-h Δ a Y h M = extM Δ a Y (λ γ e ρ → h (e ρ)) M
ext-lift : (Γ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (Z : Type 1) (G0 : (q : Y) → El a (h q) → Z) (M : Mean Γ Y) →
  Mean (ext-h Γ a Y h M) Z
ext-lift Γ a Y h Z G0 M =
  dcube-lift (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y) (FbE (lcons (e-ty a) (fst Γ)) Z)
    (λ γ e → (γ , λ ρ → h (e ρ))) (λ γ e ρ → G0 (e (fst ρ)) (snd ρ)) (snd Γ) M
VarP : Lst Entry → Type
VarP lnil = Empty
VarP (lcons e-dim sk) = VarP sk
VarP (lcons (e-ty a) sk) = Opt (VarP sk)
var-shape : (sk : Lst Entry) → VarP sk → TyShape
var-shape lnil v = Empty-rec v
var-shape (lcons e-dim sk) v = var-shape sk v
var-shape (lcons (e-ty a) sk) none = a
var-shape (lcons (e-ty a) sk) (some v) = var-shape sk v
var-word : (sk : Lst Entry) → VarP sk → Word
var-word lnil v = Empty-rec v
var-word (lcons e-dim sk) v = %wsucc (var-word sk v)
var-word (lcons (e-ty a) sk) none = #0
var-word (lcons (e-ty a) sk) (some v) = %wsucc (var-word sk v)
varM : (sk : Lst Entry) (v : VarP sk) (γ : CtxV sk) → EnvV sk γ → TV (var-shape sk v)
varM lnil v γ ρ = Empty-rec v
varM (lcons e-dim sk) v γ ρ = varM sk v γ ρ
varM (lcons (e-ty a) sk) none γ ρ = (snd γ (fst ρ) , snd ρ)
varM (lcons (e-ty a) sk) (some v) γ ρ = varM sk v (fst γ) (fst ρ)
varCube : (Γ : CCtx) (v : VarP (fst Γ)) → Mean Γ (TV (var-shape (fst Γ) v))
varCube Γ v = dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (TV (var-shape (fst Γ) v))) (varM (fst Γ) v) (snd Γ)
-- the old names, as the instances of the generic folds
diag-dd : (sk : Lst Entry) (k : Word) (X : Type 1) (F : X → Type 1) (G : Cube (dims sk) X) → DCube (dims sk) X (DL X F) G → DCube (dims sk) X F G
diag-dd sk k X F G d = gdiag DgI (λ sq p → (fst p , DL (fst p) (fst (snd p)) , snd (snd p))) (λ sq p → DCube (dims sq) (fst p) (fst (snd p)) (snd (snd p))) (λ sq p → (Line (fst p) , LineO (fst p) (fst (snd p)) , snd (snd p))) (λ s sq p → p) dg-dl sk k (X , F , G) d
papp-cube : (sk : Lst Entry) (X : Type 1) (f : DNF) → Cube (suc (dims sk)) X → Cube (dims sk) X
papp-cube sk X f c = pfold (Type 1) Line (Cube (dims sk)) (ac sk) (dnf-ix f) X c
papp-cube-d : (sk : Lst Entry) (X : Type 1) (F : X → Type 1) (f : DNF) (c : Cube (suc (dims sk)) X) → DCube (suc (dims sk)) X F c → DCube (dims sk) X F (papp-cube sk X f c)
papp-cube-d sk X F f c d = dfold (Type 1) Line (Cube (dims sk)) (ac sk) (λ X → X → Type 1) (λ X F → LineO X F) (λ X F c → DCube (dims sk) X F c) (adc sk) (dnf-ix f) X F c d
papp-ex : (sk : Lst Entry) (X : Type 1) (F : X → Type 1) (e : IEx) (G : Cube (dims sk) X) → DCube (dims sk) X (DL X F) G → DCube (dims sk) X F G
papp-ex sk X F e G d = pfold (X → Type 1) (DL X) (λ F → DCube (dims sk) X F G) (alg-dl sk X G) e F d
papp-dd : (sk : Lst Entry) (X : Type 1) (F : X → Type 1) (f : DNF) (G : Cube (dims sk) X) → DCube (dims sk) X (DL X F) G → DCube (dims sk) X F G
papp-dd sk X F f G d = papp-ex sk X F (dnf-ix f) G d
cmap-cube : (sk' sk : Lst Entry) → CMap sk' sk → (X : Type 1) → Cube (dims sk) X → Cube (dims sk') X
cmap-cube sk' sk σ X c = cmap2 sk' sk σ X c
cmap-d : (sk' sk : Lst Entry) (σ : CMap sk' sk) (X : Type 1) (F : X → Type 1) (c : Cube (dims sk) X) → DCube (dims sk) X F c → DCube (dims sk') X F (cmap-cube sk' sk σ X c)
cmap-d sk' sk σ X F c d = dcmap2 sk' sk σ X F c d
data JK = j-tm | j-ty
JZ : JK → TyShape → Type 1
JZ j-tm s = TV s
JZ j-ty s = Sem s
Jdg : Type 1
Jdg = (jk : JK) × (jΓ : CCtx) × (js : TyShape) × Code × Mean jΓ (JZ jk js)
c-bool : Code
c-bool = cdata #0 lnil
AppV : TyShape → TyShape → Type 1
AppV a b = (avT : Fam a b) × El (s-pi a b) avT × El a (fst avT)
app-f : (a b : TyShape) → AppV a b → TV (s-pi a b)
app-f a b q = (fst q , fst (snd q))
app-a : (a b : TyShape) → AppV a b → TV a
app-a a b q = (fst (fst q) , snd (snd q))
app-r : (a b : TyShape) → AppV a b → TV b
app-r a b q = (snd (fst q) (snd (snd q)) , fst (snd q) (snd (snd q)))
sig-1 : (a b : TyShape) → TV (s-sig a b) → TV a
sig-1 a b q = (fst (fst q) , fst (snd q))
sig-2 : (a b : TyShape) → TV (s-sig a b) → TV b
sig-2 a b q = (snd (fst q) (fst (snd q)) , snd (snd q))
CaseV : TyShape → Type 1
CaseV sP = (cvB : One1) × (cvP : Bool → Sem sP) × (cvx : Bool) × El sP (cvP true) × El sP (cvP false)
case-x : (sP : TyShape) → CaseV sP → TV s-bool
case-x sP q = (fst q , fst (snd (snd q)))
case-t : (sP : TyShape) → CaseV sP → TV sP
case-t sP q = (fst (snd q) true , fst (snd (snd (snd q))))
case-f : (sP : TyShape) → CaseV sP → TV sP
case-f sP q = (fst (snd q) false , snd (snd (snd (snd q))))
case-r : (sP : TyShape) → CaseV sP → TV sP
case-r sP q =
  (fst (snd q) (fst (snd (snd q))) ,
   bool-elim (λ b → El sP (fst (snd q) b)) (fst (snd (snd (snd q)))) (snd (snd (snd (snd q)))) (fst (snd (snd q))))
bool-v : Bool → One1 → TV s-bool
bool-v b u = (u , b)
lam-dom : (sk : Lst Entry) (a b : TyShape) (γ : CtxV sk) → (EnvV sk γ → TV (s-pi a b)) → EnvV sk γ → Sem a
lam-dom sk a b γ e ρ = fst (fst (e ρ))
lam-ctx : (Γ : CCtx) (a b : TyShape) → Mean Γ (TV (s-pi a b)) → CCtx
lam-ctx Γ a b X = extM Γ a (TV (s-pi a b)) (lam-dom (fst Γ) a b) X
lam-body : (Γ : CCtx) (a b : TyShape) (X : Mean Γ (TV (s-pi a b))) → Mean (lam-ctx Γ a b X) (TV b)
lam-body Γ a b X =
  dcube-push (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) (TV (s-pi a b))) (FbE (fst Γ) (TV (s-pi a b)))
    (FbE (lcons (e-ty a) (fst Γ)) (TV b)) (λ γ e → (γ , lam-dom (fst Γ) a b γ e))
    (λ γ e e2 ρ → (snd (fst (e (fst ρ))) (snd ρ) , snd (e (fst ρ)) (snd ρ))) (snd Γ) X X
fline : (sk : Lst Entry) (Y Z : Type 1) (ℓ : Y → Line Z) (γ : CtxV sk) (e : EnvV sk γ → Y) → LineO (CtxV sk) (FbE sk Z) (degen-l (CtxV sk) γ)
fline sk Y Z ℓ γ e = ((λ ρ → fst (ℓ (e ρ))) , (λ ρ → fst (snd (ℓ (e ρ)))) , λ i ρ → snd (snd (ℓ (e ρ))) i)
dline-body : (Γ : CCtx) (Y Z : Type 1) (ℓ : Y → Line Z) → Mean Γ Y → Mean (dext Γ) Z
dline-body Γ Y Z ℓ X =
  dcube-reidx (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (FbE (fst Γ) Y) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z))
    (degen-l (CtxV (fst Γ))) (fline (fst Γ) Y Z ℓ) (snd Γ) X
path-pt : (a : TyShape) → TV (s-path a) → Line (TV a)
path-pt a q = ((fst (fst (fst q)) , fst (snd (fst q))) , (fst (snd (fst (fst q))) , snd (snd (fst q))) , λ i → (snd (snd (fst (fst q))) i , snd q i))
plam-line : (sk : Lst Entry) (a : TyShape) (γ : CtxV sk) (e : EnvV sk γ → TV (s-path a)) →
  LineO (CtxV sk) (FbE sk (TV a)) (degen-l (CtxV sk) γ)
plam-line sk a γ e = fline sk (TV (s-path a)) (TV a) (path-pt a) γ e
plam-body : (Γ : CCtx) (a : TyShape) → Mean Γ (TV (s-path a)) → Mean (dext Γ) (TV a)
plam-body Γ a X = dline-body Γ (TV (s-path a)) (TV a) (path-pt a) X
ty-line : (a : TyShape) → Sem (s-path a) → Line (Sem a)
ty-line a D = fst D
tend-0 : (a : TyShape) → Sem (s-path a) → TV a
tend-0 a D = (fst (fst D) , fst (snd D))
tend-1 : (a : TyShape) → Sem (s-path a) → TV a
tend-1 a D = (fst (snd (fst D)) , snd (snd D))
carry : (n : Nat) (X : Type 1) (F : X → Type 1) (c0 c1 : Cube n X) → PathP (λ i → Cube n X) c0 c1 → DCube n X F c0 → DCube n X F c1
carry n X F c0 c1 p d = comp (λ i → DCube n X F (p i)) (λ i → []) d
papp-line : (Γ : CCtx) (Y Z : Type 1) (ℓ : Y → Line Z) (f : DNF) → Mean Γ Y → Mean Γ Z
papp-line Γ Y Z ℓ f X =
  papp-dd (fst Γ) (CtxV (fst Γ)) (FbE (fst Γ) Z) f (snd Γ)
    (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (fline (fst Γ) Y Z ℓ) (snd Γ) X)
papp-mean : (Γ : CCtx) (a : TyShape) (f : DNF) → Mean Γ (TV (s-path a)) → Mean Γ (TV a)
papp-mean Γ a f P = papp-line Γ (TV (s-path a)) (TV a) (path-pt a) f P
PathM : (Γ : CCtx) (Z : Type 1) → Mean Γ Z → Mean Γ Z → Type 1
PathM Γ Z M N = PathP (λ i → Mean Γ Z) M N
fam-dom : (a b : TyShape) → Fam a b → Sem a
fam-dom a b F = fst F
fam-body : (Γ : CCtx) (a b : TyShape) (T : Mean Γ (Fam a b)) → Mean (ext-h Γ a (Fam a b) (fam-dom a b) T) (Sem b)
fam-body Γ a b T = ext-lift Γ a (Fam a b) (fam-dom a b) (Sem b) (λ F x → snd F x) T
pair-cod : (Γ : CCtx) (a b : TyShape) (R : Mean Γ (TV (s-sig a b))) → Mean (ext-h Γ a (TV (s-sig a b)) (λ q → fam-dom a b (fst q)) R) (Sem b)
pair-cod Γ a b R = ext-lift Γ a (TV (s-sig a b)) (λ q → fam-dom a b (fst q)) (Sem b) (λ q x → snd (fst q) x) R
case-b : (s : TyShape) → CaseV s → One1
case-b s q = fst q
case-mot : (Γ : CCtx) (s : TyShape) (R : Mean Γ (CaseV s)) → Mean (ext-h Γ s-bool (CaseV s) (case-b s) R) (Sem s)
case-mot Γ s R = ext-lift Γ s-bool (CaseV s) (case-b s) (Sem s) (λ q b → fst (snd q) b) R
path-line-ty : (Γ : CCtx) (a : TyShape) (T : Mean Γ (Sem (s-path a))) → Mean (dext Γ) (Sem a)
path-line-ty Γ a T = dline-body Γ (Sem (s-path a)) (Sem a) (ty-line a) T
pend-0 : (a : TyShape) → TV (s-path a) → TV a
pend-0 a q = tend-0 a (fst q)
pend-1 : (a : TyShape) → TV (s-path a) → TV a
pend-1 a q = tend-1 a (fst q)
data NN : (KJ : NK × Jdg) → Type 1 where
  nvar : (Γ₀ : CCtx) (v₀ : VarP (fst Γ₀)) →
    NN (k-ne , (j-tm , Γ₀ , var-shape (fst Γ₀) v₀ , cvar (var-word (fst Γ₀) v₀) , varCube Γ₀ v₀))
  napp : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (R₀ : Mean Γ₀ (AppV a₀ b₀)) (f₀ c₀ : Code) →
    NN (k-ne , (j-tm , Γ₀ , s-pi a₀ b₀ , f₀ , fmapM Γ₀ (AppV a₀ b₀) (TV (s-pi a₀ b₀)) (app-f a₀ b₀) R₀)) →
    NN (k-nf , (j-tm , Γ₀ , a₀ , c₀ , fmapM Γ₀ (AppV a₀ b₀) (TV a₀) (app-a a₀ b₀) R₀)) →
    NN (k-ne , (j-tm , Γ₀ , b₀ , capp f₀ c₀ , fmapM Γ₀ (AppV a₀ b₀) (TV b₀) (app-r a₀ b₀) R₀))
  nfst : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (R₀ : Mean Γ₀ (TV (s-sig a₀ b₀))) (p₀ : Code) →
    NN (k-ne , (j-tm , Γ₀ , s-sig a₀ b₀ , p₀ , R₀)) →
    NN (k-ne , (j-tm , Γ₀ , a₀ , cfst p₀ , fmapM Γ₀ (TV (s-sig a₀ b₀)) (TV a₀) (sig-1 a₀ b₀) R₀))
  nsnd : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (R₀ : Mean Γ₀ (TV (s-sig a₀ b₀))) (p₀ : Code) →
    NN (k-ne , (j-tm , Γ₀ , s-sig a₀ b₀ , p₀ , R₀)) →
    NN (k-ne , (j-tm , Γ₀ , b₀ , csnd p₀ , fmapM Γ₀ (TV (s-sig a₀ b₀)) (TV b₀) (sig-2 a₀ b₀) R₀))
  ncase : (Γ₀ : CCtx) (s₀ : TyShape) (R₀ : Mean Γ₀ (CaseV s₀)) (cP₀ x₀ t₀ f₀ : Code) →
    NN (k-nf , (j-ty , ext-h Γ₀ s-bool (CaseV s₀) (case-b s₀) R₀ , s₀ , cP₀ , case-mot Γ₀ s₀ R₀)) →
    NN (k-ne , (j-tm , Γ₀ , s-bool , x₀ , fmapM Γ₀ (CaseV s₀) (TV s-bool) (case-x s₀) R₀)) →
    NN (k-nf , (j-tm , Γ₀ , s₀ , t₀ , fmapM Γ₀ (CaseV s₀) (TV s₀) (case-t s₀) R₀)) →
    NN (k-nf , (j-tm , Γ₀ , s₀ , f₀ , fmapM Γ₀ (CaseV s₀) (TV s₀) (case-f s₀) R₀)) →
    NN (k-ne , (j-tm , Γ₀ , s₀ , c-case cP₀ t₀ f₀ x₀ , fmapM Γ₀ (CaseV s₀) (TV s₀) (case-r s₀) R₀))
  nne : (Γ₀ : CCtx) (R₀ : Mean Γ₀ (TV s-bool)) (x₀ : Code) →
    NN (k-ne , (j-tm , Γ₀ , s-bool , x₀ , R₀)) → NN (k-nf , (j-tm , Γ₀ , s-bool , x₀ , R₀))
  ntrue : (Γ₀ : CCtx) (B₀ : Mean Γ₀ One1) → NN (k-nf , (j-tm , Γ₀ , s-bool , c-true , fmapM Γ₀ One1 (TV s-bool) (bool-v true) B₀))
  nfalse : (Γ₀ : CCtx) (B₀ : Mean Γ₀ One1) → NN (k-nf , (j-tm , Γ₀ , s-bool , c-false , fmapM Γ₀ One1 (TV s-bool) (bool-v false) B₀))
  nlam : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (X₀ : Mean Γ₀ (TV (s-pi a₀ b₀))) (cA₀ c₀ : Code) →
    NN (k-nf , (j-ty , Γ₀ , a₀ , cA₀ , fmapM Γ₀ (TV (s-pi a₀ b₀)) (Sem a₀) (λ q → fam-dom a₀ b₀ (fst q)) X₀)) →
    NN (k-nf , (j-tm , lam-ctx Γ₀ a₀ b₀ X₀ , b₀ , c₀ , lam-body Γ₀ a₀ b₀ X₀)) → NN (k-nf , (j-tm , Γ₀ , s-pi a₀ b₀ , clam c₀ , X₀))
  npair : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (R₀ : Mean Γ₀ (TV (s-sig a₀ b₀))) (cB₀ c1₀ c2₀ : Code) →
    NN (k-nf , (j-ty , ext-h Γ₀ a₀ (TV (s-sig a₀ b₀)) (λ q → fam-dom a₀ b₀ (fst q)) R₀ , b₀ , cB₀ , pair-cod Γ₀ a₀ b₀ R₀)) →
    NN (k-nf , (j-tm , Γ₀ , a₀ , c1₀ , fmapM Γ₀ (TV (s-sig a₀ b₀)) (TV a₀) (sig-1 a₀ b₀) R₀)) →
    NN (k-nf , (j-tm , Γ₀ , b₀ , c2₀ , fmapM Γ₀ (TV (s-sig a₀ b₀)) (TV b₀) (sig-2 a₀ b₀) R₀)) →
    NN (k-nf , (j-tm , Γ₀ , s-sig a₀ b₀ , cpair c1₀ c2₀ , R₀))
  nplam : (Γ₀ : CCtx) (a₀ : TyShape) (X₀ : Mean Γ₀ (TV (s-path a₀))) (c₀ : Code) →
    NN (k-nf , (j-tm , dext Γ₀ , a₀ , c₀ , plam-body Γ₀ a₀ X₀)) → NN (k-nf , (j-tm , Γ₀ , s-path a₀ , cplam c₀ , X₀))
  npapp : (Γ₀ : CCtx) (a₀ : TyShape) (P₀ : Mean Γ₀ (TV (s-path a₀))) (p₀ : Code) (f₀ : DNF) →
    isTrue (dnf-canon f₀) → isTrue (dnf-nonconst f₀) →
    (Y₀ : Mean Γ₀ (TV a₀)) → PathM Γ₀ (TV a₀) (papp-mean Γ₀ a₀ f₀ P₀) Y₀ →
    NN (k-ne , (j-tm , Γ₀ , s-path a₀ , p₀ , P₀)) → NN (k-ne , (j-tm , Γ₀ , a₀ , cpapp p₀ (dnf-code f₀) , Y₀))
  nty-bool : (Γ₀ : CCtx) (B₀ : Mean Γ₀ One1) → NN (k-nf , (j-ty , Γ₀ , s-bool , c-bool , B₀))
  nty-pi : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (T₀ : Mean Γ₀ (Fam a₀ b₀)) (cA₀ cB₀ : Code) →
    NN (k-nf , (j-ty , Γ₀ , a₀ , cA₀ , fmapM Γ₀ (Fam a₀ b₀) (Sem a₀) (fam-dom a₀ b₀) T₀)) →
    NN (k-nf , (j-ty , ext-h Γ₀ a₀ (Fam a₀ b₀) (fam-dom a₀ b₀) T₀ , b₀ , cB₀ , fam-body Γ₀ a₀ b₀ T₀)) →
    NN (k-nf , (j-ty , Γ₀ , s-pi a₀ b₀ , cpi #2 cA₀ cB₀ , T₀))
  nty-sig : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (T₀ : Mean Γ₀ (Fam a₀ b₀)) (cA₀ cB₀ : Code) →
    NN (k-nf , (j-ty , Γ₀ , a₀ , cA₀ , fmapM Γ₀ (Fam a₀ b₀) (Sem a₀) (fam-dom a₀ b₀) T₀)) →
    NN (k-nf , (j-ty , ext-h Γ₀ a₀ (Fam a₀ b₀) (fam-dom a₀ b₀) T₀ , b₀ , cB₀ , fam-body Γ₀ a₀ b₀ T₀)) →
    NN (k-nf , (j-ty , Γ₀ , s-sig a₀ b₀ , csigma cA₀ cB₀ , T₀))
  nty-path : (Γ₀ : CCtx) (a₀ : TyShape) (T₀ : Mean Γ₀ (Sem (s-path a₀))) (cL₀ c0₀ c1₀ : Code) →
    NN (k-nf , (j-ty , dext Γ₀ , a₀ , cL₀ , path-line-ty Γ₀ a₀ T₀)) →
    NN (k-nf , (j-tm , Γ₀ , a₀ , c0₀ , fmapM Γ₀ (Sem (s-path a₀)) (TV a₀) (tend-0 a₀) T₀)) →
    NN (k-nf , (j-tm , Γ₀ , a₀ , c1₀ , fmapM Γ₀ (Sem (s-path a₀)) (TV a₀) (tend-1 a₀) T₀)) →
    NN (k-nf , (j-ty , Γ₀ , s-path a₀ , cpathp (cplam cL₀) c0₀ c1₀ , T₀))
data Der : (J : Jdg) → Type 1 where
  dvar : (Γ₀ : CCtx) (v₀ : VarP (fst Γ₀)) →
    Der (j-tm , Γ₀ , var-shape (fst Γ₀) v₀ , cvar (var-word (fst Γ₀) v₀) , varCube Γ₀ v₀)
  dapp : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (R₀ : Mean Γ₀ (AppV a₀ b₀)) (f₀ c₀ : Code) →
    Der (j-tm , Γ₀ , s-pi a₀ b₀ , f₀ , fmapM Γ₀ (AppV a₀ b₀) (TV (s-pi a₀ b₀)) (app-f a₀ b₀) R₀) →
    Der (j-tm , Γ₀ , a₀ , c₀ , fmapM Γ₀ (AppV a₀ b₀) (TV a₀) (app-a a₀ b₀) R₀) →
    Der (j-tm , Γ₀ , b₀ , capp f₀ c₀ , fmapM Γ₀ (AppV a₀ b₀) (TV b₀) (app-r a₀ b₀) R₀)
  dfst : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (R₀ : Mean Γ₀ (TV (s-sig a₀ b₀))) (p₀ : Code) →
    Der (j-tm , Γ₀ , s-sig a₀ b₀ , p₀ , R₀) → Der (j-tm , Γ₀ , a₀ , cfst p₀ , fmapM Γ₀ (TV (s-sig a₀ b₀)) (TV a₀) (sig-1 a₀ b₀) R₀)
  dsnd : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (R₀ : Mean Γ₀ (TV (s-sig a₀ b₀))) (p₀ : Code) →
    Der (j-tm , Γ₀ , s-sig a₀ b₀ , p₀ , R₀) → Der (j-tm , Γ₀ , b₀ , csnd p₀ , fmapM Γ₀ (TV (s-sig a₀ b₀)) (TV b₀) (sig-2 a₀ b₀) R₀)
  dcase : (Γ₀ : CCtx) (s₀ : TyShape) (R₀ : Mean Γ₀ (CaseV s₀)) (cP₀ x₀ t₀ f₀ : Code) →
    Der (j-ty , ext-h Γ₀ s-bool (CaseV s₀) (case-b s₀) R₀ , s₀ , cP₀ , case-mot Γ₀ s₀ R₀) →
    Der (j-tm , Γ₀ , s-bool , x₀ , fmapM Γ₀ (CaseV s₀) (TV s-bool) (case-x s₀) R₀) →
    Der (j-tm , Γ₀ , s₀ , t₀ , fmapM Γ₀ (CaseV s₀) (TV s₀) (case-t s₀) R₀) →
    Der (j-tm , Γ₀ , s₀ , f₀ , fmapM Γ₀ (CaseV s₀) (TV s₀) (case-f s₀) R₀) →
    Der (j-tm , Γ₀ , s₀ , c-case cP₀ t₀ f₀ x₀ , fmapM Γ₀ (CaseV s₀) (TV s₀) (case-r s₀) R₀)
  dtrue : (Γ₀ : CCtx) (B₀ : Mean Γ₀ One1) → Der (j-tm , Γ₀ , s-bool , c-true , fmapM Γ₀ One1 (TV s-bool) (bool-v true) B₀)
  dfalse : (Γ₀ : CCtx) (B₀ : Mean Γ₀ One1) → Der (j-tm , Γ₀ , s-bool , c-false , fmapM Γ₀ One1 (TV s-bool) (bool-v false) B₀)
  dlam : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (X₀ : Mean Γ₀ (TV (s-pi a₀ b₀))) (cA₀ c₀ : Code) →
    Der (j-ty , Γ₀ , a₀ , cA₀ , fmapM Γ₀ (TV (s-pi a₀ b₀)) (Sem a₀) (λ q → fam-dom a₀ b₀ (fst q)) X₀) →
    Der (j-tm , lam-ctx Γ₀ a₀ b₀ X₀ , b₀ , c₀ , lam-body Γ₀ a₀ b₀ X₀) → Der (j-tm , Γ₀ , s-pi a₀ b₀ , clam c₀ , X₀)
  dpair : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (R₀ : Mean Γ₀ (TV (s-sig a₀ b₀))) (cB₀ c1₀ c2₀ : Code) →
    Der (j-ty , ext-h Γ₀ a₀ (TV (s-sig a₀ b₀)) (λ q → fam-dom a₀ b₀ (fst q)) R₀ , b₀ , cB₀ , pair-cod Γ₀ a₀ b₀ R₀) →
    Der (j-tm , Γ₀ , a₀ , c1₀ , fmapM Γ₀ (TV (s-sig a₀ b₀)) (TV a₀) (sig-1 a₀ b₀) R₀) →
    Der (j-tm , Γ₀ , b₀ , c2₀ , fmapM Γ₀ (TV (s-sig a₀ b₀)) (TV b₀) (sig-2 a₀ b₀) R₀) →
    Der (j-tm , Γ₀ , s-sig a₀ b₀ , cpair c1₀ c2₀ , R₀)
  dplam : (Γ₀ : CCtx) (a₀ : TyShape) (X₀ : Mean Γ₀ (TV (s-path a₀))) (c₀ : Code) →
    Der (j-tm , dext Γ₀ , a₀ , c₀ , plam-body Γ₀ a₀ X₀) → Der (j-tm , Γ₀ , s-path a₀ , cplam c₀ , X₀)
  dpapp : (Γ₀ : CCtx) (a₀ : TyShape) (P₀ : Mean Γ₀ (TV (s-path a₀))) (p₀ : Code) (f₀ : DNF) →
    isTrue (dnf-canon f₀) → isTrue (dnf-nonconst f₀) →
    (Y₀ : Mean Γ₀ (TV a₀)) → PathM Γ₀ (TV a₀) (papp-mean Γ₀ a₀ f₀ P₀) Y₀ →
    Der (j-tm , Γ₀ , s-path a₀ , p₀ , P₀) → Der (j-tm , Γ₀ , a₀ , cpapp p₀ (dnf-code f₀) , Y₀)
  dpapp0 : (Γ₀ : CCtx) (a₀ : TyShape) (P₀ : Mean Γ₀ (TV (s-path a₀))) (p₀ : Code) →
    Der (j-tm , Γ₀ , s-path a₀ , p₀ , P₀) → Der (j-tm , Γ₀ , a₀ , cpapp p₀ ci0 , fmapM Γ₀ (TV (s-path a₀)) (TV a₀) (pend-0 a₀) P₀)
  dpapp1 : (Γ₀ : CCtx) (a₀ : TyShape) (P₀ : Mean Γ₀ (TV (s-path a₀))) (p₀ : Code) →
    Der (j-tm , Γ₀ , s-path a₀ , p₀ , P₀) → Der (j-tm , Γ₀ , a₀ , cpapp p₀ ci1 , fmapM Γ₀ (TV (s-path a₀)) (TV a₀) (pend-1 a₀) P₀)
  dty-bool : (Γ₀ : CCtx) (B₀ : Mean Γ₀ One1) → Der (j-ty , Γ₀ , s-bool , c-bool , B₀)
  dty-pi : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (T₀ : Mean Γ₀ (Fam a₀ b₀)) (cA₀ cB₀ : Code) →
    Der (j-ty , Γ₀ , a₀ , cA₀ , fmapM Γ₀ (Fam a₀ b₀) (Sem a₀) (fam-dom a₀ b₀) T₀) →
    Der (j-ty , ext-h Γ₀ a₀ (Fam a₀ b₀) (fam-dom a₀ b₀) T₀ , b₀ , cB₀ , fam-body Γ₀ a₀ b₀ T₀) →
    Der (j-ty , Γ₀ , s-pi a₀ b₀ , cpi #2 cA₀ cB₀ , T₀)
  dty-sig : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (T₀ : Mean Γ₀ (Fam a₀ b₀)) (cA₀ cB₀ : Code) →
    Der (j-ty , Γ₀ , a₀ , cA₀ , fmapM Γ₀ (Fam a₀ b₀) (Sem a₀) (fam-dom a₀ b₀) T₀) →
    Der (j-ty , ext-h Γ₀ a₀ (Fam a₀ b₀) (fam-dom a₀ b₀) T₀ , b₀ , cB₀ , fam-body Γ₀ a₀ b₀ T₀) →
    Der (j-ty , Γ₀ , s-sig a₀ b₀ , csigma cA₀ cB₀ , T₀)
  dty-path : (Γ₀ : CCtx) (a₀ : TyShape) (T₀ : Mean Γ₀ (Sem (s-path a₀))) (cL₀ c0₀ c1₀ : Code) →
    Der (j-ty , dext Γ₀ , a₀ , cL₀ , path-line-ty Γ₀ a₀ T₀) →
    Der (j-tm , Γ₀ , a₀ , c0₀ , fmapM Γ₀ (Sem (s-path a₀)) (TV a₀) (tend-0 a₀) T₀) →
    Der (j-tm , Γ₀ , a₀ , c1₀ , fmapM Γ₀ (Sem (s-path a₀)) (TV a₀) (tend-1 a₀) T₀) →
    Der (j-ty , Γ₀ , s-path a₀ , cpathp (cplam cL₀) c0₀ c1₀ , T₀)
TCode : CCtx → TyShape → Type 1
TCode Γ s = (c : Code) × (v : Mean Γ (TV s)) × Der (j-tm , Γ , s , c , v)
teval : (Γ : CCtx) (s : TyShape) → TCode Γ s → Mean Γ (TV s)
teval Γ s t = fst (snd t)
embed : {KJ : NK × Jdg} → NN KJ → Der (snd KJ)
embed (nvar Γ v) = dvar Γ v
embed (napp Γ a b R f c nf na) = dapp Γ a b R f c (embed nf) (embed na)
embed (nfst Γ a b R p np) = dfst Γ a b R p (embed np)
embed (nsnd Γ a b R p np) = dsnd Γ a b R p (embed np)
embed (ncase Γ s R cP x t f nP nx nt nf) = dcase Γ s R cP x t f (embed nP) (embed nx) (embed nt) (embed nf)
embed (nne Γ R x nx) = embed nx
embed (ntrue Γ B) = dtrue Γ B
embed (nfalse Γ B) = dfalse Γ B
embed (nlam Γ a b X cA c nA nb) = dlam Γ a b X cA c (embed nA) (embed nb)
embed (npair Γ a b R cB c1 c2 nB n1 n2) = dpair Γ a b R cB c1 c2 (embed nB) (embed n1) (embed n2)
embed (nplam Γ a X c nb) = dplam Γ a X c (embed nb)
embed (npapp Γ a P p f cf nc Y q np) = dpapp Γ a P p f cf nc Y q (embed np)
embed (nty-bool Γ B) = dty-bool Γ B
embed (nty-pi Γ a b T cA cB nA nB) = dty-pi Γ a b T cA cB (embed nA) (embed nB)
embed (nty-sig Γ a b T cA cB nA nB) = dty-sig Γ a b T cA cB (embed nA) (embed nB)
embed (nty-path Γ a T cL c0 c1 nL n0 n1) = dty-path Γ a T cL c0 c1 (embed nL) (embed n0) (embed n1)
SubF : (sk' sk : Lst Entry) → CtxV sk' → Type 1
SubF sk' sk γ' = (sfγ : CtxV sk) × (EnvV sk' γ' → EnvV sk sfγ)
sub-base : (Δ Γ : CCtx) → DCube (dims (fst Δ)) (CtxV (fst Δ)) (SubF (fst Δ) (fst Γ)) (snd Δ) → Cube (dims (fst Δ)) (CtxV (fst Γ))
sub-base Δ Γ S = dcube-map (dims (fst Δ)) (CtxV (fst Δ)) (SubF (fst Δ) (fst Γ)) (CtxV (fst Γ)) (λ γ' p → fst p) (snd Δ) S
Sub : CCtx → CCtx → Type 1
Sub Δ Γ = (sbd : CMap (fst Δ) (fst Γ)) × (sbS : DCube (dims (fst Δ)) (CtxV (fst Δ)) (SubF (fst Δ) (fst Γ)) (snd Δ)) ×
  PathP (λ i → Cube (dims (fst Δ)) (CtxV (fst Γ))) (cmap-cube (fst Δ) (fst Γ) sbd (CtxV (fst Γ)) (snd Γ)) (sub-base Δ Γ sbS)
sub-carried : (Δ Γ : CCtx) (Z : Type 1) (σ : Sub Δ Γ) → Mean Γ Z → DCube (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (sub-base Δ Γ (fst (snd σ)))
sub-carried Δ Γ Z σ M =
  carry (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ)) (sub-base Δ Γ (fst (snd σ)))
    (snd (snd σ)) (cmap-d (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) M)
sub-pull : (Δ Γ : CCtx) (Z : Type 1) (S : DCube (dims (fst Δ)) (CtxV (fst Δ)) (SubF (fst Δ) (fst Γ)) (snd Δ)) →
  DCube (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (sub-base Δ Γ S) → Mean Δ Z
sub-pull Δ Γ Z S E =
  dcube-pull (dims (fst Δ)) (CtxV (fst Δ)) (CtxV (fst Γ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z) (FbE (fst Γ) Z)
    (λ γ' p → fst p) (λ γ' p e ρ → e (snd p ρ)) (snd Δ) S E
subM : (Δ Γ : CCtx) (Z : Type 1) → Sub Δ Γ → Mean Γ Z → Mean Δ Z
subM Δ Γ Z σ M = sub-pull Δ Γ Z (fst (snd σ)) (sub-carried Δ Γ Z σ M)
fmap-fmap : (n : Nat) (X : Type 1) (F F' F2 : X → Type 1) (h : (x : X) → F x → F' x) (h' : (x : X) → F' x → F2 x) (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → DCube n X F2 c) (dcube-fmap n X F' F2 h' c (dcube-fmap n X F F' h c d)) (dcube-fmap n X F F2 (λ x y → h' x (h x y)) c d)
fmap-fmap zero X F F' F2 h h' c d = λ i → h' c (h c d)
fmap-fmap (suc n) X F F' F2 h h' c d =
  fmap-fmap n (Line X) (LineO X F) (LineO X F') (LineO X F2) (lineo-fmap X F F' h) (lineo-fmap X F' F2 h') c d
fmap-push : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' F2 : X' → Type 1) (f : (x : X) → Y x → X')
  (g : (x : X) (y : Y x) → F x → F' (f x y)) (h : (x : X') → F' x → F2 x) (c : Cube n X) (d : DCube n X Y c) (e : DCube n X F c) →
  PathP (λ i → DCube n X' F2 (dcube-map n X Y X' f c d))
    (dcube-fmap n X' F' F2 h (dcube-map n X Y X' f c d) (dcube-push n X X' Y F F' f g c d e))
    (dcube-push n X X' Y F F2 f (λ x y z → h (f x y) (g x y z)) c d e)
fmap-push zero X X' Y F F' F2 f g h c d e = λ i → h (f c d) (g c d e)
fmap-push (suc n) X X' Y F F' F2 f g h c d e =
  fmap-push n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (LineO X' F2) (lineo-map X Y X' f) (lineo-push X X' Y F F' f g)
    (lineo-fmap X' F' F2 h) c d e
fmap-pull : (n : Nat) (X X' : Type 1) (Y F F2 : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X')
  (g : (x : X) (y : Y x) → F' (f x y) → F x) (h : (x : X) → F x → F2 x) (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' F' (dcube-map n X Y X' f c d)) →
  PathP (λ i → DCube n X F2 c)
    (dcube-fmap n X F F2 h c (dcube-pull n X X' Y F F' f g c d e)) (dcube-pull n X X' Y F2 F' f (λ x y z → h x (g x y z)) c d e)
fmap-pull zero X X' Y F F2 F' f g h c d e = λ i → h c (g c d e)
fmap-pull (suc n) X X' Y F F2 F' f g h c d e =
  fmap-pull n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X F2) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g)
    (lineo-fmap X F F2 h) c d e
fmap-transp : (n : Nat) (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x) (c0 c1 : Cube n X) (p : PathP (λ i → Cube n X) c0 c1)
  (d : DCube n X F c0) →
  PathP (λ j → DCube n X F' c1)
    (dcube-fmap n X F F' h c1 (comp (λ i → DCube n X F (p i)) (λ i → []) d))
    (comp (λ i → DCube n X F' (p i)) (λ i → []) (dcube-fmap n X F F' h c0 d))
fmap-transp n X F F' h c0 c1 p d =
  λ j → comp (λ i → DCube n X F' (p i))
    (λ i → [ j = 0 ↦ dcube-fmap n X F F' h (p i) (comp (λ k → DCube n X F (p (i ∧ k))) (λ k → [ i = 0 ↦ d ]) d) ])
    (dcube-fmap n X F F' h c0 d)
fmap-gen : (n : Nat) (X X' : Type 1) (F F' : X → Type 1) (G G' : X' → Type 1) (f : X → X')
  (g : (x : X) → F x → G (f x)) (g' : (x : X) → F' x → G' (f x)) (h : (x : X) → F x → F' x) (h2 : (x : X') → G x → G' x)
  (q : PathP (λ i → (x : X) → F x → G' (f x)) (λ x y → h2 (f x) (g x y)) (λ x y → g' x (h x y))) (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → DCube n X' G' (cube-map n X X' f c))
    (dcube-fmap n X' G G' h2 (cube-map n X X' f c) (dcube-reidx n X X' F G f g c d))
    (dcube-reidx n X X' F' G' f g' c (dcube-fmap n X F F' h c d))
fmap-gen n X X' F F' G G' f g g' h h2 q c d =
  pcat (DCube n X' G' (cube-map n X X' f c))
    (dcube-fmap n X' G G' h2 (cube-map n X X' f c) (dcube-reidx n X X' F G f g c d))
    (dcube-reidx n X X' F G' f (λ x y → h2 (f x) (g x y)) c d)
    (dcube-reidx n X X' F' G' f g' c (dcube-fmap n X F F' h c d))
    (fmap-reidx n X X' F G G' f g h2 c d)
    (pcat (DCube n X' G' (cube-map n X X' f c))
       (dcube-reidx n X X' F G' f (λ x y → h2 (f x) (g x y)) c d)
       (dcube-reidx n X X' F G' f (λ x y → g' x (h x y)) c d)
       (dcube-reidx n X X' F' G' f g' c (dcube-fmap n X F F' h c d))
       (λ i → dcube-reidx n X X' F G' f (q i) c d)
       (psym (DCube n X' G' (cube-map n X X' f c))
          (dcube-reidx n X X' F' G' f g' c (dcube-fmap n X F F' h c d)) (dcube-reidx n X X' F G' f (λ x y → g' x (h x y)) c d)
          (reidx-fmap n X X' F F' G' h f g' c d)))
pull-fmap : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' F2 : X' → Type 1) (f : (x : X) → Y x → X') (h : (x : X') → F' x → F2 x)
  (g : (x : X) (y : Y x) → F2 (f x y) → F x) (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' F' (dcube-map n X Y X' f c d)) →
  PathP (λ i → DCube n X F c)
    (dcube-pull n X X' Y F F2 f g c d (dcube-fmap n X' F' F2 h (dcube-map n X Y X' f c d) e))
    (dcube-pull n X X' Y F F' f (λ x y z → g x y (h (f x y) z)) c d e)
pull-fmap zero X X' Y F F' F2 f h g c d e = λ i → g c d (h (f c d) e)
pull-fmap (suc n) X X' Y F F' F2 f h g c d e =
  pull-fmap n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (LineO X' F2) (lineo-map X Y X' f) (lineo-fmap X' F' F2 h)
    (lineo-pull X X' Y F F2 f g) c d e
fmap-cmap : (sk' sk : Lst Entry) (σ : CMap sk' sk) (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x)
  (c : Cube (dims sk) X) (d : DCube (dims sk) X F c) →
  PathP (λ i → DCube (dims sk') X F' (cmap-cube sk' sk σ X c))
    (dcube-fmap (dims sk') X F F' h (cmap-cube sk' sk σ X c) (cmap-d sk' sk σ X F c d))
    (cmap-d sk' sk σ X F' c (dcube-fmap (dims sk) X F F' h c d))
fmap-cmap sk' sk σ X F F' h c d = λ i → fmap-cmap2 sk' sk σ X F F' h c d (~ i)
subM-fmap : (Δ Γ : CCtx) (Z Z' : Type 1) (h : Z → Z') (σ : Sub Δ Γ) (M : Mean Γ Z) →
  PathM Δ Z' (fmapM Δ Z Z' h (subM Δ Γ Z σ M)) (subM Δ Γ Z' σ (fmapM Γ Z Z' h M))
subM-fmap Δ Γ Z Z' h σ M =
  pcat (Mean Δ Z') (fmapM Δ Z Z' h (subM Δ Γ Z σ M))
    (dcube-pull (dims (fst Δ)) (CtxV (fst Δ)) (CtxV (fst Γ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z') (FbE (fst Γ) Z)
       (λ γ' p → fst p) (λ γ' p e ρ → h (e (snd p ρ))) (snd Δ) (fst (snd σ)) (sub-carried Δ Γ Z σ M))
    (subM Δ Γ Z' σ (fmapM Γ Z Z' h M))
    (fmap-pull (dims (fst Δ)) (CtxV (fst Δ)) (CtxV (fst Γ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z) (FbE (fst Δ) Z') (FbE (fst Γ) Z)
       (λ γ' p → fst p) (λ γ' p e ρ → e (snd p ρ)) (λ γ e ρ → h (e ρ)) (snd Δ) (fst (snd σ)) (sub-carried Δ Γ Z σ M))
    (pcat (Mean Δ Z')
       (dcube-pull (dims (fst Δ)) (CtxV (fst Δ)) (CtxV (fst Γ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z') (FbE (fst Γ) Z)
          (λ γ' p → fst p) (λ γ' p e ρ → h (e (snd p ρ))) (snd Δ) (fst (snd σ)) (sub-carried Δ Γ Z σ M))
       (sub-pull Δ Γ Z' (fst (snd σ))
          (dcube-fmap (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → h (e ρ)) (sub-base Δ Γ (fst (snd σ))) (sub-carried Δ Γ Z σ M)))
       (subM Δ Γ Z' σ (fmapM Γ Z Z' h M))
       (psym (Mean Δ Z')
          (sub-pull Δ Γ Z' (fst (snd σ))
             (dcube-fmap (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → h (e ρ)) (sub-base Δ Γ (fst (snd σ))) (sub-carried Δ Γ Z σ M)))
          (dcube-pull (dims (fst Δ)) (CtxV (fst Δ)) (CtxV (fst Γ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z') (FbE (fst Γ) Z)
             (λ γ' p → fst p) (λ γ' p e ρ → h (e (snd p ρ))) (snd Δ) (fst (snd σ)) (sub-carried Δ Γ Z σ M))
          (pull-fmap (dims (fst Δ)) (CtxV (fst Δ)) (CtxV (fst Γ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z') (FbE (fst Γ) Z) (FbE (fst Γ) Z')
             (λ γ' p → fst p) (λ γ e ρ → h (e ρ)) (λ γ' p e ρ → e (snd p ρ)) (snd Δ) (fst (snd σ)) (sub-carried Δ Γ Z σ M)))
       (λ i → sub-pull Δ Γ Z' (fst (snd σ))
          (pcat (DCube (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z') (sub-base Δ Γ (fst (snd σ))))
             (dcube-fmap (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → h (e ρ)) (sub-base Δ Γ (fst (snd σ))) (sub-carried Δ Γ Z σ M))
             (carry (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z') (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ)) (sub-base Δ Γ (fst (snd σ)))
                (snd (snd σ))
                (dcube-fmap (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → h (e ρ)) (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ))
                   (cmap-d (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) M)))
             (sub-carried Δ Γ Z' σ (fmapM Γ Z Z' h M))
             (fmap-transp (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → h (e ρ))
                (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ)) (sub-base Δ Γ (fst (snd σ))) (snd (snd σ))
                (cmap-d (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) M))
             (λ j → carry (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z') (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ)) (sub-base Δ Γ (fst (snd σ)))
                (snd (snd σ))
                (fmap-cmap (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → h (e ρ)) (snd Γ) M j)) i)))
cube-comp : (n : Nat) (X Y Z : Type 1) (f : Y → Z) (g : X → Y) (c : Cube n X) →
  PathP (λ i → Cube n Z) (cube-map n Y Z f (cube-map n X Y g c)) (cube-map n X Z (λ x → f (g x)) c)
cube-comp zero X Y Z f g c = λ i → f (g c)
cube-comp (suc n) X Y Z f g c = cube-comp n (Line X) (Line Y) (Line Z) (line-map Y Z f) (line-map X Y g) c
cube-id : (n : Nat) (X : Type 1) (c : Cube n X) → PathP (λ i → Cube n X) (cube-map n X X (λ x → x) c) c
cube-id zero X c = λ i → c
cube-id (suc n) X c = cube-id n (Line X) c
cube-comp2 : (n : Nat) (X Y Y' Z : Type 1) (f : Y → Z) (g : X → Y) (f' : Y' → Z) (g' : X → Y') (c : Cube n X) →
  PathP (λ i → Cube n Z) (cube-map n X Z (λ x → f (g x)) c) (cube-map n X Z (λ x → f' (g' x)) c) →
  PathP (λ i → Cube n Z) (cube-map n Y Z f (cube-map n X Y g c)) (cube-map n Y' Z f' (cube-map n X Y' g' c))
cube-comp2 n X Y Y' Z f g f' g' c p =
  pcat (Cube n Z) (cube-map n Y Z f (cube-map n X Y g c)) (cube-map n X Z (λ x → f' (g' x)) c) (cube-map n Y' Z f' (cube-map n X Y' g' c))
    (pcat (Cube n Z) (cube-map n Y Z f (cube-map n X Y g c)) (cube-map n X Z (λ x → f (g x)) c) (cube-map n X Z (λ x → f' (g' x)) c)
       (cube-comp n X Y Z f g c) p)
    (psym (Cube n Z) (cube-map n Y' Z f' (cube-map n X Y' g' c)) (cube-map n X Z (λ x → f' (g' x)) c) (cube-comp n X Y' Z f' g' c))
reidx-comp : (n : Nat) (X Y Z : Type 1) (F : X → Type 1) (G : Y → Type 1) (H : Z → Type 1) (f : Y → Z) (fd : (y : Y) → G y → H (f y))
  (g : X → Y) (gd : (x : X) → F x → G (g x)) (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → DCube n Z H (cube-comp n X Y Z f g c i))
    (dcube-reidx n Y Z G H f fd (cube-map n X Y g c) (dcube-reidx n X Y F G g gd c d)) (dcube-reidx n X Z F H (λ x → f (g x)) (λ x y → fd (g x) (gd x y)) c d)
reidx-comp zero X Y Z F G H f fd g gd c d = λ i → fd (g c) (gd c d)
reidx-comp (suc n) X Y Z F G H f fd g gd c d =
  reidx-comp n (Line X) (Line Y) (Line Z) (LineO X F) (LineO Y G) (LineO Z H) (line-map Y Z f) (lineo-reidx Y Z G H f fd)
    (line-map X Y g) (lineo-reidx X Y F G g gd) c d
reidx-id : (n : Nat) (X : Type 1) (F : X → Type 1) (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → DCube n X F (cube-id n X c i)) (dcube-reidx n X X F F (λ x → x) (λ x y → y) c d) d
reidx-id zero X F c d = λ i → d
reidx-id (suc n) X F c d = reidx-id n (Line X) (LineO X F) c d
cube-comp2-d : (n : Nat) (X Y Y' Z : Type 1) (F : X → Type 1) (G : Y → Type 1) (G' : Y' → Type 1) (H : Z → Type 1)
  (f : Y → Z) (fd : (y : Y) → G y → H (f y)) (g : X → Y) (gd : (x : X) → F x → G (g x))
  (f' : Y' → Z) (fd' : (y : Y') → G' y → H (f' y)) (g' : X → Y') (gd' : (x : X) → F x → G' (g' x)) (c : Cube n X) (d : DCube n X F c)
  (p : PathP (λ i → Cube n Z) (cube-map n X Z (λ x → f (g x)) c) (cube-map n X Z (λ x → f' (g' x)) c)) →
  PathP (λ i → DCube n Z H (p i)) (dcube-reidx n X Z F H (λ x → f (g x)) (λ x y → fd (g x) (gd x y)) c d)
    (dcube-reidx n X Z F H (λ x → f' (g' x)) (λ x y → fd' (g' x) (gd' x y)) c d) →
  PathP (λ i → DCube n Z H (cube-comp2 n X Y Y' Z f g f' g' c p i))
    (dcube-reidx n Y Z G H f fd (cube-map n X Y g c) (dcube-reidx n X Y F G g gd c d))
    (dcube-reidx n Y' Z G' H f' fd' (cube-map n X Y' g' c) (dcube-reidx n X Y' F G' g' gd' c d))
cube-comp2-d n X Y Y' Z F G G' H f fd g gd f' fd' g' gd' c d p pd =
  pcat-d (Cube n Z) (DCube n Z H) (cube-map n Y Z f (cube-map n X Y g c)) (cube-map n X Z (λ x → f' (g' x)) c) (cube-map n Y' Z f' (cube-map n X Y' g' c))
    (pcat (Cube n Z) (cube-map n Y Z f (cube-map n X Y g c)) (cube-map n X Z (λ x → f (g x)) c) (cube-map n X Z (λ x → f' (g' x)) c)
       (cube-comp n X Y Z f g c) p)
    (psym (Cube n Z) (cube-map n Y' Z f' (cube-map n X Y' g' c)) (cube-map n X Z (λ x → f' (g' x)) c) (cube-comp n X Y' Z f' g' c))
    (dcube-reidx n Y Z G H f fd (cube-map n X Y g c) (dcube-reidx n X Y F G g gd c d))
    (dcube-reidx n X Z F H (λ x → f' (g' x)) (λ x y → fd' (g' x) (gd' x y)) c d)
    (dcube-reidx n Y' Z G' H f' fd' (cube-map n X Y' g' c) (dcube-reidx n X Y' F G' g' gd' c d))
    (pcat-d (Cube n Z) (DCube n Z H) (cube-map n Y Z f (cube-map n X Y g c)) (cube-map n X Z (λ x → f (g x)) c) (cube-map n X Z (λ x → f' (g' x)) c)
       (cube-comp n X Y Z f g c) p
       (dcube-reidx n Y Z G H f fd (cube-map n X Y g c) (dcube-reidx n X Y F G g gd c d))
       (dcube-reidx n X Z F H (λ x → f (g x)) (λ x y → fd (g x) (gd x y)) c d)
       (dcube-reidx n X Z F H (λ x → f' (g' x)) (λ x y → fd' (g' x) (gd' x y)) c d)
       (reidx-comp n X Y Z F G H f fd g gd c d) pd)
    (psym-d (Cube n Z) (DCube n Z H) (cube-map n Y' Z f' (cube-map n X Y' g' c)) (cube-map n X Z (λ x → f' (g' x)) c) (cube-comp n X Y' Z f' g' c)
       (dcube-reidx n Y' Z G' H f' fd' (cube-map n X Y' g' c) (dcube-reidx n X Y' F G' g' gd' c d))
       (dcube-reidx n X Z F H (λ x → f' (g' x)) (λ x y → fd' (g' x) (gd' x y)) c d)
       (reidx-comp n X Y' Z F G' H f' fd' g' gd' c d))
exc : (n : Nat) (X : Type 1) → Cube n (Line (Line X)) → Cube n (Line (Line X))
exc n X c = cube-map n (Line (Line X)) (Line (Line X)) (exch-l X) c
exd : (n : Nat) (X : Type 1) (F : X → Type 1) (c : Cube n (Line (Line X))) → DCube n (Line (Line X)) (LineO (Line X) (LineO X F)) c → DCube n (Line (Line X)) (LineO (Line X) (LineO X F)) (cube-map n (Line (Line X)) (Line (Line X)) (exch-l X) c)
exd n X F c d = dcube-reidx n (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (exch-l X) (exch-o X F) c d
dgc : (n : Nat) (X : Type 1) → Cube n (Line (Line X)) → Cube n (Line X)
dgc n X c = cube-map n (Line (Line X)) (Line X) (diag-l X) c
dgd : (n : Nat) (X : Type 1) (F : X → Type 1) (c : Cube n (Line (Line X))) → DCube n (Line (Line X)) (LineO (Line X) (LineO X F)) c → DCube n (Line X) (LineO X F) (cube-map n (Line (Line X)) (Line X) (diag-l X) c)
dgd n X F c d = dcube-reidx n (Line (Line X)) (Line X) (LineO (Line X) (LineO X F)) (LineO X F) (diag-l X) (diag-o X F) c d
f0c : (n : Nat) (X : Type 1) → Cube n (Line X) → Cube n X
f0c n X c = cube-map n (Line X) X (face0-l X) c
f0d : (n : Nat) (X : Type 1) (F : X → Type 1) (c : Cube n (Line X)) → DCube n (Line X) (LineO X F) c → DCube n X F (cube-map n (Line X) X (face0-l X) c)
f0d n X F c d = dcube-reidx n (Line X) X (LineO X F) F (face0-l X) (face0-o X F) c d
diag-deg : (sk : Lst Entry) (k : Word) (X : Type 1) (G : Cube (dims sk) X) →
  PathP (λ i → Cube (dims sk) X) (diag-sk sk k X (cube-map (dims sk) X (Line X) (degen-l X) G)) G
diag-deg lnil k X G = λ i → G
diag-deg (lcons (e-ty s) sk) k X G =
  bool-elim1 (λ b → PathP (λ i → Cube (dims sk) X)
                 (if b then cube-map (dims sk) (Line X) X (face0-l X) (cube-map (dims sk) X (Line X) (degen-l X) G)
                  else diag-sk sk (%wsub k #1) X (cube-map (dims sk) X (Line X) (degen-l X) G)) G)
    (pcat (Cube (dims sk) X) (cube-map (dims sk) (Line X) X (face0-l X) (cube-map (dims sk) X (Line X) (degen-l X) G))
          (cube-map (dims sk) X X (λ x → x) G) G
          (cube-comp (dims sk) X (Line X) X (face0-l X) (degen-l X) G) (cube-id (dims sk) X G))
    (diag-deg sk (%wsub k #1) X G) (weq k #0)
diag-deg (lcons e-dim sk) k X G =
  bool-elim1 (λ b → PathP (λ i → Cube (suc (dims sk)) X)
                 (if b then cube-map (dims sk) (Line (Line X)) (Line X) (diag-l X) (cube-map (dims sk) (Line X) (Line (Line X)) (line-map X (Line X) (degen-l X)) G)
                  else diag-sk sk (%wsub k #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X)
                         (cube-map (dims sk) (Line X) (Line (Line X)) (line-map X (Line X) (degen-l X)) G))) G)
    (pcat (Cube (dims sk) (Line X)) (cube-map (dims sk) (Line (Line X)) (Line X) (diag-l X) (cube-map (dims sk) (Line X) (Line (Line X)) (line-map X (Line X) (degen-l X)) G))
          (cube-map (dims sk) (Line X) (Line X) (λ x → x) G) G
          (cube-comp (dims sk) (Line X) (Line (Line X)) (Line X) (diag-l X) (line-map X (Line X) (degen-l X)) G) (cube-id (dims sk) (Line X) G))
    (pcat (Cube (dims sk) (Line X))
          (diag-sk sk (%wsub k #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X)
             (cube-map (dims sk) (Line X) (Line (Line X)) (line-map X (Line X) (degen-l X)) G)))
          (diag-sk sk (%wsub k #1) (Line X) (cube-map (dims sk) (Line X) (Line (Line X)) (degen-l (Line X)) G)) G
          (λ i → diag-sk sk (%wsub k #1) (Line X)
                   (cube-comp (dims sk) (Line X) (Line (Line X)) (Line (Line X)) (exch-l X) (line-map X (Line X) (degen-l X)) G i))
          (diag-deg sk (%wsub k #1) (Line X) G))
    (weq k #0)
diag-deg-d : (sk : Lst Entry) (k : Word) (X : Type 1) (F : X → Type 1) (G : Cube (dims sk) X) (g : DCube (dims sk) X F G) →
  PathP (λ i → DCube (dims sk) X F (diag-deg sk k X G i)) (diag-sk-d sk k X F (cube-map (dims sk) X (Line X) (degen-l X) G) (dcube-reidx (dims sk) X (Line X) F (LineO X F) (degen-l X) (degen-o X F) G g)) g
diag-deg-d lnil k X F G g = λ i → g
diag-deg-d (lcons (e-ty s) sk) k X F G g =
  bool-elim1 (λ b → PathP (λ i → DCube (dims sk) X F
        (bool-elim1 (λ b → PathP (λ i → Cube (dims sk) X) (if b then f0c (dims sk) X (cube-map (dims sk) X (Line X) (degen-l X) G) else diag-sk sk (%wsub k #1) X (cube-map (dims sk) X (Line X) (degen-l X) G)) G)
           (pcat (Cube (dims sk) X) (f0c (dims sk) X (cube-map (dims sk) X (Line X) (degen-l X) G)) (cube-map (dims sk) X X (λ x → x) G) G (cube-comp (dims sk) X (Line X) X (face0-l X) (degen-l X) G) (cube-id (dims sk) X G))
           (diag-deg sk (%wsub k #1) X G) b i))
      (bool-elim1 (λ b → DCube (dims sk) X F (if b then f0c (dims sk) X (cube-map (dims sk) X (Line X) (degen-l X) G) else diag-sk sk (%wsub k #1) X (cube-map (dims sk) X (Line X) (degen-l X) G))) (f0d (dims sk) X F (cube-map (dims sk) X (Line X) (degen-l X) G) (dcube-reidx (dims sk) X (Line X) F (LineO X F) (degen-l X) (degen-o X F) G g)) (diag-sk-d sk (%wsub k #1) X F (cube-map (dims sk) X (Line X) (degen-l X) G) (dcube-reidx (dims sk) X (Line X) F (LineO X F) (degen-l X) (degen-o X F) G g)) b) g)
    (pcat-d (Cube (dims sk) X) (DCube (dims sk) X F) (f0c (dims sk) X (cube-map (dims sk) X (Line X) (degen-l X) G)) (cube-map (dims sk) X X (λ x → x) G) G (cube-comp (dims sk) X (Line X) X (face0-l X) (degen-l X) G) (cube-id (dims sk) X G)
       (f0d (dims sk) X F (cube-map (dims sk) X (Line X) (degen-l X) G) (dcube-reidx (dims sk) X (Line X) F (LineO X F) (degen-l X) (degen-o X F) G g)) (dcube-reidx (dims sk) X X F F (λ x → x) (λ x y → y) G g) g
       (reidx-comp (dims sk) X (Line X) X F (LineO X F) F (face0-l X) (face0-o X F) (degen-l X) (degen-o X F) G g) (reidx-id (dims sk) X F G g))
