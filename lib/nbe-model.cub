  PathM Δ Z (subM Δ Γ Z σ (dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) g (snd Γ))) (dcube-fmap (dims (fst Δ)) (CtxV (fst Δ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z) (λ γ' p ρ' → g (fst p) (snd p ρ')) (snd Δ) (fst (snd σ)))
subM-of Δ Γ Z σ g =
  pcat (Mean Δ Z) (subM Δ Γ Z σ (dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) g (snd Γ))) (sub-pull Δ Γ Z (fst (snd σ)) (dcube-of (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) g (sub-base Δ Γ (fst (snd σ))))) (dcube-fmap (dims (fst Δ)) (CtxV (fst Δ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z) (λ γ' p ρ' → g (fst p) (snd p ρ')) (snd Δ) (fst (snd σ)))
    (λ i → sub-pull Δ Γ Z (fst (snd σ))
