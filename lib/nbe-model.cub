law-unit-m-r : (sk : Lst Entry) (r : IEx) → IEq sk (ixmeet r ix1) r
law-unit-m-r sk r X F G d = law-unit-r-cn sk dmeet (λ Z H z q → fst (snd q)) r X F G d (λ i x y → y)
law-unit-j-r : (sk : Lst Entry) (r : IEx) → IEq sk (ixjoin r ix0) r
law-unit-j-r sk r X F G d = law-unit-r-cn sk djoin (λ Z H z q → fst q) r X F G d (λ i x y → y)
