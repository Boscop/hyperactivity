      (λ e → (ieq-trans sk (conj-ix (lcons m (conj-ins l ms))) (ixmeet (lit-ix m) (conj-ix (conj-ins l ms))) (ixmeet (lit-ix l) (conj-ix (lcons m ms)))
    (conj-ix-cons sk m (conj-ins l ms))
    (ieq-trans sk (ixmeet (lit-ix m) (conj-ix (conj-ins l ms))) (ixmeet (lit-ix m) (ixmeet (lit-ix l) (conj-ix ms))) (ixmeet (lit-ix l) (conj-ix (lcons m ms)))
    (ieq-meet sk (lit-ix m) (lit-ix m) (conj-ix (conj-ins l ms)) (ixmeet (lit-ix l) (conj-ix ms)) (ieq-refl sk (lit-ix m)) (conj-ins-sound sk l ms))
    (ieq-trans sk (ixmeet (lit-ix m) (ixmeet (lit-ix l) (conj-ix ms))) (ixmeet (lit-ix l) (ixmeet (lit-ix m) (conj-ix ms))) (ixmeet (lit-ix l) (conj-ix (lcons m ms)))
