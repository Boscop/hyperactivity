    (psym (Cube (dims (fst Δ)) (CtxV (lcons (e-ty a) (fst Γ)))) (dcube-map (dims (fst Δ)) (CtxV (fst Δ)) (SubT (fst Δ) (fst Γ) Y) (CtxV (lcons (e-ty a) (fst Γ))) (λ γ' t → (fst (fst t) , f (fst (fst t)) (snd t))) (snd Δ) (sub-tot Δ Γ Y σ M)) (dcube-map (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (CtxV (lcons (e-ty a) (fst Γ))) (λ γ e → (γ , f γ e)) (sub-base Δ Γ (fst (snd σ))) (sub-carried Δ Γ Y σ M))
