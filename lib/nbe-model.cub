conj-meet-sound : (sk : Lst Entry) (c d : Conj) → IEq sk (conj-ix (conj-meet c d)) (ixmeet (conj-ix c) (conj-ix d))
conj-meet-sound sk lnil d = ieq-sym sk (ixmeet ix1 (conj-ix d)) (conj-ix d) (law-unit-m-l sk (conj-ix d))
conj-meet-sound sk (lcons l ls) d =
