  comp (λ j → DCube n X F (p j)) (λ j → [ k = 0 ↦ carry-fill n X F c0 c1 p (dcube-of n X F g c0) j , k = 1 ↦ dcube-of n X F g (p j) ]) (dcube-of n X F g c0)
