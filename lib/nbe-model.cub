pcat-i A {x} {y} {z} p q = pcat A x y z p q
push-diag : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F x → F' (f x y))
  (h : (x : X) → Y x → F x) (c : Cube n X) (d : DCube n X Y c) →
  PathP (λ i → DCube n X' F' (dcube-map n X Y X' f c d)) (dcube-push n X X' Y F F' f g c d (dcube-fmap n X Y F h c d)) (dcube-lift n X X' Y F' f (λ x y → g x y (h x y)) c d)
push-diag zero X X' Y F F' f g h c d = λ i → g c d (h c d)
push-diag (suc n) X X' Y F F' f g h c d =
  push-diag n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-push X X' Y F F' f g) (lineo-fmap X Y F h) c d
