-- lib/host.cub — what a hyperactive program run by the machine uses of the host (2026-11-15, Avik:
-- "HYPERACTIVE MUST BE ENTIRELY BOOTSTRAPPED ENTIRELY LEVERAGE HYPERACTIVE LITERALLY NOTHING BUT THE
-- CORE C IMPLEMENTATION"): text as a list of byte words, compared and taken apart; memory read and
-- written; a file read whole; text written to a descriptor; the program's command line and
-- environment. Programs: lib/guard.cub (the pre-commit hook), lib/hyperactive.cub (the command).
import "core.cub"
import "prim.cub"
import "proc.cub"
import "world.cub"

-- text compared: equality, prefix, suffix, by one step that compares a head and hands the tail on
h-step : Word → (List Word → Bool) → List Word → Bool
h-step x k nil = false
h-step x k (cons y s) = andB (weq x y) (k s)
h-null : List Word → Bool
h-null nil = true
h-null (cons y s) = false
h-eq : List Word → List Word → Bool
h-eq nil = h-null
h-eq (cons x r) = h-step x (h-eq r)
h-yes : List Word → Bool
h-yes s = true
h-prefix : List Word → List Word → Bool
h-prefix nil = h-yes
h-prefix (cons x r) = h-step x (h-prefix r)
h-rev : List Word → List Word → List Word
h-rev nil acc = acc
h-rev (cons x r) acc = h-rev r (cons x acc)
h-ends : List Word → List Word → Bool
h-ends suf s = h-prefix (h-rev suf nil) (h-rev s nil)
-- text without the first as many bytes as p has
h-drop : List Word → List Word → List Word
h-drop nil e = e
h-drop (cons k r) nil = nil
h-drop (cons k r) (cons x s) = h-drop r s
-- text cut at every byte b: the pieces, in order (the last piece after the last b)
h-split-onto : Word → List Word → List Word → List (List Word)
h-split-onto b cur nil = cons (h-rev cur nil) nil
h-split-onto b cur (cons x r) = if weq x b then cons (h-rev cur nil) (h-split-onto b nil r) else h-split-onto b (cons x cur) r
h-split : Word → List Word → List (List Word)
h-split b t = h-split-onto b nil t
-- the first n bytes
h-take : Nat → List Word → List Word
h-take zero t = nil
h-take (suc n) nil = nil
h-take (suc n) (cons x r) = cons x (h-take n r)
h-line : List Word → List Word
h-line t = list-append t (cons #10 nil)

-- bytes as hex digits, and back
h-hexd : Word → Word
h-hexd d = if wlt d #10 then wadd d #48 else wadd d #87
h-hex : List Word → List Word
h-hex nil = nil
h-hex (cons b r) = cons (h-hexd (wshr b #4)) (cons (h-hexd (wand b #15)) (h-hex r))

-- a number as decimal digits
h-digits-onto : Nat → Word → List Word → List Word
h-digits-onto zero w acc = acc
h-digits-onto (suc k) w acc = if wlt w #10 then cons (wadd w #48) acc else h-digits-onto k (wquot w #10) (cons (wadd (wsub w (wmul (wquot w #10) #10)) #48) acc)
h-decimal : Word → List Word
h-decimal w = h-digits-onto (toNat #20) w nil

-- memory: bytes read from an address, bytes written to one, a big-endian number
h-peek : Word → Nat → Proc W (List Word)
h-peek a zero = ret nil
h-peek a (suc n) = bind (load8-at a) (λ b → bind (h-peek (wadd a #1) n) (λ r → ret (cons b r)))
h-poke : Word → List Word → Proc W Unit
h-poke a nil = ret unit
h-poke a (cons b r) = bind (store8-at a b) (λ u → h-poke (wadd a #1) r)
h-be-onto : Word → List Word → Word
h-be-onto acc nil = acc
h-be-onto acc (cons b r) = h-be-onto (wadd (wshl acc #8) b) r
h-be : List Word → Word
h-be bs = h-be-onto #0 bs

-- text written to a descriptor: 1 standard output, 2 standard error
h-put : Word → List Word → Proc W Unit
h-put fd t = bind (alloc-bytes (wadd (fromNat (list-length t)) #1)) (λ a → bind (h-poke a t) (λ u →
  bind (sys-call #1 fd a (fromNat (list-length t)) #0 #0 #0) (λ w → ret unit)))
h-out : List Word → Proc W Unit
h-out t = h-put #1 t
h-say : List Word → Proc W Unit
h-say t = h-put #2 t
-- a refusal: the reason on standard error, then exit 1
h-fail : List Word → Proc W Unit
h-fail why = bind (h-say (h-line why)) (λ u → exit #1)

-- a file whole: its address and length, or nothing when it cannot be opened or read whole
h-max : Word
h-max = #67108864
h-none : Sum Unit (Word × Word)
h-none = inl unit
h-some : Word → Word → Sum Unit (Word × Word)
h-some b n = inr (b , n)
h-file : List Word → Proc W (Sum Unit (Word × Word))
h-file path =
  bind (alloc-bytes (wadd (fromNat (list-length path)) #1)) (λ p → bind (h-poke p path) (λ u →
  bind (sys-call #257 #18446744073709551516 p #0 #0 #0 #0) (λ fd →
  if wlt fd #9223372036854775808 then
    bind (alloc-bytes h-max) (λ buf → bind (sys-call #0 fd buf h-max #0 #0 #0) (λ n →
    bind (alloc-bytes #1) (λ one → bind (sys-call #0 fd one #1 #0 #0 #0) (λ more →
    bind (sys-call #3 fd #0 #0 #0 #0 #0) (λ c →
    if andB (wlt n h-max) (weq more #0) then ret {lzero} {W} (h-some buf n) else ret {lzero} {W} h-none)))))
  else ret {lzero} {W} h-none)))
-- a file whole as text, or nothing
h-text-of : Sum Unit (Word × Word) → Proc W (Sum Unit (List Word))
h-text-of (inl u) = ret (inl unit)
h-text-of (inr bl) = bind (h-peek (fst bl) (toNat (snd bl))) (λ t → ret (inr t))
-- text in fresh memory with a NUL after it: its address
h-cstr : List Word → Proc W Word
h-cstr t = bind (alloc-bytes (wadd (fromNat (list-length t)) #1)) (λ a → bind (h-poke a t) (λ u → ret a))
h-read-of : Word × List Word → Sum Unit (List Word)
h-read-of r = if weq (fst r) #0 then inr (snd r) else inl unit
h-read : List Word → Proc W (Sum Unit (List Word))
h-read path = bind (h-cstr path) (λ p → bind (file-read-at p) (λ r → ret (h-read-of r)))

-- the value of a variable in an environment block (NUL-separated NAME=VALUE), or nothing
h-env-in : List Word → List (List Word) → Sum Unit (List Word)
h-env-in key nil = inl unit
h-env-in key (cons e r) = if h-prefix key e then inr (h-drop key e) else h-env-in key r
h-env-of : List Word → Sum Unit (List Word) → Sum Unit (List Word)
h-env-of key (inl u) = inl unit
h-env-of key (inr env) = h-env-in (list-append key "=") (h-split #0 env)
h-env : List Word → Proc W (Sum Unit (List Word))
h-env key = bind (h-read "/proc/self/environ") (λ env → ret (h-env-of key env))

-- text without its last byte (a command line ends with a NUL)
h-tail : List Word → List Word
h-tail nil = nil
h-tail (cons x r) = r
h-but-last : List Word → List Word
h-but-last t = h-rev (h-tail (h-rev t nil)) nil

-- the program's command line, the machine's own words included: build/cubical, the program, then
-- the words given to it (the machine loads the program and the program exits before the machine
-- reads further)
h-args-of : Sum Unit (List Word) → List (List Word)
h-args-of (inl u) = nil
h-args-of (inr t) = h-split #0 (h-but-last t)
h-args : Proc W (List (List Word))
h-args = bind (h-read "/proc/self/cmdline") (λ t → ret (h-args-of t))

-- lines of text: the pieces between newlines, empty ones left out
h-nonempty : List (List Word) → List (List Word)
h-nonempty nil = nil
h-nonempty (cons l r) = if h-null l then h-nonempty r else cons l (h-nonempty r)
h-lines : List Word → List (List Word)
h-lines t = h-nonempty (h-split #10 t)
-- a text among texts
h-has : List Word → List (List Word) → Bool
h-has x nil = false
h-has x (cons y r) = if h-eq x y then true else h-has x r
-- texts with each kept once, in the order first seen
h-dedupe-onto : List (List Word) → List (List Word) → List (List Word)
h-dedupe-onto seen nil = nil
h-dedupe-onto seen (cons x r) = if h-has x seen then h-dedupe-onto seen r else cons x (h-dedupe-onto (cons x seen) r)
h-dedupe : List (List Word) → List (List Word)
h-dedupe xs = h-dedupe-onto nil xs
-- text order, byte by byte
h-lt-step : Word → (List Word → Bool) → List Word → Bool
h-lt-step x k nil = false
h-lt-step x k (cons y s) = if wlt x y then true else if weq x y then k s else false
h-not : Bool → Bool
h-not b = if b then false else true
h-lt : List Word → List Word → Bool
h-lt nil = λ t → h-not (h-null t)
h-lt (cons x r) = h-lt-step x (h-lt r)
-- texts in order
h-insert : List Word → List (List Word) → List (List Word)
h-insert x nil = cons x nil
h-insert x (cons y r) = if h-lt x y then cons x (cons y r) else cons y (h-insert x r)
h-sort : List (List Word) → List (List Word)
h-sort nil = nil
h-sort (cons x r) = h-insert x (h-sort r)
-- texts joined, each followed by a newline and preceded by an indent
h-indented : List Word → List (List Word) → List Word
h-indented ind nil = nil
h-indented ind (cons l r) = list-append ind (list-append l (cons #10 (h-indented ind r)))
-- texts run together
h-concat : List (List Word) → List Word
h-concat nil = nil
h-concat (cons x r) = list-append x (h-concat r)
-- a list without its first n
h-drop-n : {A : Type} → Nat → List A → List A
h-drop-n zero xs = xs
h-drop-n (suc n) nil = nil
h-drop-n (suc n) (cons x r) = h-drop-n n r
-- text without spaces at its start
h-trim : List Word → List Word
h-trim nil = nil
h-trim (cons x r) = if weq x #32 then h-trim r else cons x r

-- texts as a NULL-ended array of addresses (an argv or envp)
h-ptrs-at : Word → List (List Word) → Proc W Unit
h-ptrs-at a nil = ret unit
h-ptrs-at a (cons t r) = bind (h-cstr t) (λ p → bind (store-at a p) (λ u → h-ptrs-at (wadd a #8) r))
h-ptrs : List (List Word) → Proc W Word
h-ptrs ts = bind (alloc-bytes (wmul (wadd (fromNat (list-length ts)) #1) #8)) (λ a → bind (h-ptrs-at a ts) (λ u → ret a))

-- a file written whole (created, or emptied first): whether it was
h-write : List Word → List Word → Proc W Bool
h-write path t = bind (h-cstr path) (λ p → bind (file-write-at p t) (λ w → ret (wlt w #9223372036854775808)))
-- a directory made (an existing one is fine)
h-mkdir : List Word → Proc W Unit
h-mkdir path = bind (h-cstr path) (λ p → bind (sys-call #83 p #493 #0 #0 #0 #0) (λ r → ret unit))

-- another program run to its end, its output this program's: its exit status (0 when it succeeded)
-- the environment a child is given: this one's, but for the machine's note that its stack was raised (a
-- child machine raises its own)
h-without : List Word → List (List Word) → List (List Word)
h-without p nil = nil
h-without p (cons e r) = if h-prefix p e then h-without p r else cons e (h-without p r)
h-env-block : Sum Unit (List Word) → List (List Word)
h-env-block (inl u) = nil
h-env-block (inr t) = h-without "CUBICAL_STACKED=" (h-nonempty (h-split #0 t))
-- a child waited for: its exit status, or 128 and the signal's number when a signal ended it (as a
-- shell reports it), so a killed child never reads as one that succeeded
h-wait : Word → Proc W Word
h-wait pid = bind (alloc-bytes #8) (λ st → bind (sys-call #61 pid st #0 #0 #0 #0) (λ r →
  bind (load-at st) (λ s → ret (if weq (wand s #127) #0 then wand (wshr s #8) #255 else wadd #128 (wand s #127)))))
h-run : List (List Word) → Proc W Word
h-run args =
  bind (h-read "/proc/self/environ") (λ env →
  bind (h-ptrs args) (λ argv → bind (h-ptrs (h-env-block env)) (λ envp →
  bind (spawn-at argv envp #18446744073709551615) (λ pid →
  if wlt pid #9223372036854775808 then h-wait pid else ret {lzero} {W} #127))))

-- the latest time anything under a directory was changed (nanoseconds since 1970): every regular
-- file's modification time, through every directory but .git, build and .cubical-store, to depth
-- `depth`. A program keeping something computed from the files stamps it with this and computes it
-- again when the stamp has moved.
h-skip : List Word → Bool
h-skip n = if h-eq n "." then true else if h-eq n ".." then true else if h-eq n ".git" then true else
  if h-eq n "build" then true else h-eq n ".cubical-store"
h-wmax : Word → Word → Word
h-wmax a b = if wlt a b then b else a
h-name-at : Word → Nat → Proc W (List Word)
h-name-at a zero = ret nil
h-name-at a (suc k) = bind (load8-at a) (λ b → if weq b #0 then ret {lzero} {W} nil else bind (h-name-at (wadd a #1) k) (λ r → ret {lzero} {W} (cons b r)))
h-file-time : List Word → Proc W Word
h-file-time path = bind (h-cstr path) (λ p → bind (alloc-bytes #256) (λ st →
  bind (sys-call #262 #18446744073709551516 p st #0 #0 #0) (λ r →
  if weq r #0 then bind (load-at (wadd st #88)) (λ s → bind (load-at (wadd st #96)) (λ ns → ret {lzero} {W} (wadd (wmul s #1000000000) ns)))
  else ret {lzero} {W} #0)))
h-entry-time : (List Word → Proc W Word) → List Word → Word → List Word → Proc W Word
h-entry-time rec child ty name =
  if h-skip name then ret {lzero} {W} #0 else
  if weq ty #4 then rec child else
  if weq ty #8 then h-file-time child else ret {lzero} {W} #0
h-entries-time : (List Word → Proc W Word) → List Word → Word → Word → Word → Nat → Proc W Word
h-entries-time rec path buf off n zero = ret #0
h-entries-time rec path buf off n (suc k) =
  if wlt off n then
    bind (load8-at (wadd buf (wadd off #16))) (λ lo → bind (load8-at (wadd buf (wadd off #17))) (λ hi →
    bind (load8-at (wadd buf (wadd off #18))) (λ ty →
    bind (h-name-at (wadd buf (wadd off #19)) (toNat #256)) (λ name →
    bind (h-entry-time rec (list-append path (cons #47 name)) ty name) (λ t →
    bind (h-entries-time rec path buf (wadd off (wadd lo (wshl hi #8))) n k) (λ t2 → ret {lzero} {W} (h-wmax t t2)))))))
  else ret {lzero} {W} #0
h-dir-chunks : (List Word → Proc W Word) → List Word → Word → Word → Word → Nat → Proc W Word
h-dir-chunks rec path fd buf acc zero = ret acc
h-dir-chunks rec path fd buf acc (suc k) =
  bind (sys-call #217 fd buf #65536 #0 #0 #0) (λ n →
  if andB (wlt #0 n) (wlt n #9223372036854775808)
  then bind (h-entries-time rec path buf #0 n (toNat (wquot n #20))) (λ t → h-dir-chunks rec path fd buf (h-wmax acc t) k)
  else ret {lzero} {W} acc)
h-dir-time : Nat → List Word → Proc W Word
h-dir-time zero path = ret #0
h-dir-time (suc d) path =
  bind (h-cstr path) (λ p → bind (sys-call #257 #18446744073709551516 p #65536 #0 #0 #0) (λ fd →
  if wlt fd #9223372036854775808 then
    bind (alloc-bytes #65536) (λ buf → bind (h-dir-chunks (h-dir-time d) path fd buf #0 (toNat #4096)) (λ t →
    bind (sys-call #3 fd #0 #0 #0 #0 #0) (λ c → ret {lzero} {W} t)))
  else ret {lzero} {W} #0))
-- the store's directory: CUBICAL_STORE when set, else .cubical-store
h-store-of : Sum Unit (List Word) → List Word
h-store-of (inl u) = ".cubical-store"
h-store-of (inr d) = d
-- decimal digits read as a number (anything else in them ends it)
h-number-onto : Word → List Word → Word
h-number-onto acc nil = acc
h-number-onto acc (cons d r) = if andB (wlt #47 d) (wlt d #58) then h-number-onto (wadd (wmul acc #10) (wsub d #48)) r else acc
h-number : List Word → Word
h-number t = h-number-onto #0 t

-- a descriptor read to its end
h-read-fd : Word → Nat → Proc W (List Word)
h-read-fd fd zero = ret nil
h-read-fd fd (suc k) = bind (alloc-bytes #65536) (λ buf → bind (sys-call #0 fd buf #65536 #0 #0 #0) (λ n →
  if andB (wlt #0 n) (wlt n #9223372036854775808)
  then bind (h-peek buf (toNat n)) (λ t → bind (h-read-fd fd k) (λ r → ret {lzero} {W} (list-append t r)))
  else ret {lzero} {W} nil))
h-stdin : Proc W (List Word)
h-stdin = h-read-fd #0 (toNat #1024)
-- another program run to its end, its output (standard output and standard error) taken: its exit
-- status and that output
-- (with: settings added to the environment it is given, NAME=VALUE each)
h-capture-with : List (List Word) → List (List Word) → Proc W (Word × List Word)
h-capture-with extra args =
  bind (h-read "/proc/self/environ") (λ env →
  bind (h-ptrs args) (λ argv → bind (h-ptrs (list-append extra (h-env-block env))) (λ envp →
  bind (alloc-bytes #8) (λ fds → bind (sys-call #293 fds #524288 #0 #0 #0 #0) (λ pr →
  bind (load-at fds) (λ both →
  bind (spawn-at argv envp (wshr both #32)) (λ pid →
  bind (sys-call #3 (wshr both #32) #0 #0 #0 #0 #0) (λ c →
  bind (h-read-fd (wand both #4294967295) (toNat #4096)) (λ out →
  bind (sys-call #3 (wand both #4294967295) #0 #0 #0 #0 #0) (λ c2 →
  if wlt pid #9223372036854775808 then bind (h-wait pid) (λ s → ret {lzero} {W} (s , out)) else ret {lzero} {W} (#127 , out)))))))))))
h-capture : List (List Word) → Proc W (Word × List Word)
h-capture args = h-capture-with nil args
-- the names in a directory (not . and ..)
h-dir-entries : Word → Word → Word → Nat → Proc W (List (List Word))
h-dir-entries buf off n zero = ret nil
h-dir-entries buf off n (suc k) =
  if wlt off n then
    bind (load8-at (wadd buf (wadd off #16))) (λ lo → bind (load8-at (wadd buf (wadd off #17))) (λ hi →
    bind (h-name-at (wadd buf (wadd off #19)) (toNat #256)) (λ name →
    bind (h-dir-entries buf (wadd off (wadd lo (wshl hi #8))) n k) (λ rest →
    ret {lzero} {W} (if orB (h-eq name ".") (h-eq name "..") then rest else cons name rest)))))
  else ret {lzero} {W} nil
h-dir-reads : Word → Word → Nat → Proc W (List (List Word))
h-dir-reads fd buf zero = ret nil
h-dir-reads fd buf (suc k) = bind (sys-call #217 fd buf #65536 #0 #0 #0) (λ n →
  if andB (wlt #0 n) (wlt n #9223372036854775808)
  then bind (h-dir-entries buf #0 n (toNat (wquot n #20))) (λ es → bind (h-dir-reads fd buf k) (λ rest → ret {lzero} {W} (list-append es rest)))
  else ret {lzero} {W} nil)
h-list : List Word → Proc W (List (List Word))
h-list path = bind (h-cstr path) (λ p → bind (sys-call #257 #18446744073709551516 p #65536 #0 #0 #0) (λ fd →
  if wlt fd #9223372036854775808 then
    bind (alloc-bytes #65536) (λ buf → bind (h-dir-reads fd buf (toNat #4096)) (λ ns →
    bind (sys-call #3 fd #0 #0 #0 #0 #0) (λ c → ret {lzero} {W} ns)))
  else ret {lzero} {W} nil))
-- hex digits read back as bytes
h-unhexd : Word → Word
h-unhexd c = if wlt c #58 then wsub c #48 else wsub c #87
h-unhex : List Word → List Word
h-unhex nil = nil
h-unhex (cons a nil) = nil
h-unhex (cons a (cons b r)) = cons (wadd (wshl (h-unhexd a) #4) (h-unhexd b)) (h-unhex r)
-- whether a text holds another inside it
h-infix : List Word → List Word → Bool
h-infix p nil = h-null p
h-infix p (cons x r) = if h-prefix p (cons x r) then true else h-infix p r
-- text up to the first place another text begins in it
h-before : List Word → List Word → List Word
h-before p nil = nil
h-before p (cons x r) = if h-prefix p (cons x r) then nil else cons x (h-before p r)
-- a file removed
h-unlink : List Word → Proc W Unit
h-unlink path = bind (h-cstr path) (λ p → bind (sys-call #87 p #0 #0 #0 #0 #0) (λ r → ret unit))
-- the first n of a list
h-take-n : {A : Type} → Nat → List A → List A
h-take-n zero xs = nil
h-take-n (suc n) nil = nil
h-take-n (suc n) (cons x r) = cons x (h-take-n n r)
-- text between quotation marks
h-quote : List Word → List Word
h-quote s = cons #34 (list-append s (cons #34 nil))

-- texts sorted (merge sort) with each kept once, and the operations of sorted sets
h-merge : Nat → List (List Word) → List (List Word) → List (List Word)
h-merge zero a b = list-append a b
h-merge (suc f) nil b = b
h-merge (suc f) (cons x xs) nil = cons x xs
h-merge (suc f) (cons x xs) (cons y ys) = if h-lt y x then cons y (h-merge f (cons x xs) ys) else if h-eq x y then cons x (h-merge f xs ys) else cons x (h-merge f xs (cons y ys))
h-split2-onto : List (List Word) → List (List Word) → List (List Word) → (List (List Word)) × (List (List Word))
h-split2-onto a b nil = (a , b)
h-split2-onto a b (cons x r) = h-split2-onto b (cons x a) r
h-msort-f : Nat → List (List Word) → List (List Word)
h-msort-f zero xs = xs
h-msort-f (suc f) nil = nil
h-msort-f (suc f) (cons x nil) = cons x nil
h-msort-f (suc f) (cons x (cons y r)) = h-merge (plus (list-length (cons x (cons y r))) (list-length (cons x (cons y r))))
  (h-msort-f f (fst (h-split2-onto nil nil (cons x (cons y r))))) (h-msort-f f (snd (h-split2-onto nil nil (cons x (cons y r)))))
h-msort : List (List Word) → List (List Word)
h-msort xs = h-msort-f (list-length xs) xs
-- a without b, both sorted
h-minus-f : Nat → List (List Word) → List (List Word) → List (List Word)
h-minus-f zero a b = a
h-minus-f (suc f) nil b = nil
h-minus-f (suc f) (cons x xs) nil = cons x xs
h-minus-f (suc f) (cons x xs) (cons y ys) = if h-eq x y then h-minus-f f xs ys else if h-lt x y then cons x (h-minus-f f xs (cons y ys)) else h-minus-f f (cons x xs) ys
h-minus : List (List Word) → List (List Word) → List (List Word)
h-minus a b = h-minus-f (plus (list-length a) (list-length b)) a b
-- a and b both, both sorted
h-inter : List (List Word) → List (List Word) → List (List Word)
h-inter a b = h-minus a (h-minus a b)
h-union : List (List Word) → List (List Word) → List (List Word)
h-union a b = h-merge (plus (list-length a) (list-length b)) a b
-- a list of texts without its first
h-tail-lists : List (List Word) → List (List Word)
h-tail-lists nil = nil
h-tail-lists (cons x r) = r
-- the names in a directory with their kinds (4 a directory, 8 a regular file)
h-typed-entries : Word → Word → Word → Nat → Proc W (List (List Word × Word))
h-typed-entries buf off n zero = ret nil
h-typed-entries buf off n (suc k) =
  if wlt off n then
    bind (load8-at (wadd buf (wadd off #16))) (λ lo → bind (load8-at (wadd buf (wadd off #17))) (λ hi →
    bind (load8-at (wadd buf (wadd off #18))) (λ ty →
    bind (h-name-at (wadd buf (wadd off #19)) (toNat #256)) (λ name →
    bind (h-typed-entries buf (wadd off (wadd lo (wshl hi #8))) n k) (λ rest →
    ret {lzero} {W} (if orB (h-eq name ".") (h-eq name "..") then rest else cons (name , ty) rest))))))
  else ret {lzero} {W} nil
h-typed-reads : Word → Word → Nat → Proc W (List (List Word × Word))
h-typed-reads fd buf zero = ret nil
h-typed-reads fd buf (suc k) = bind (sys-call #217 fd buf #65536 #0 #0 #0) (λ n →
  if andB (wlt #0 n) (wlt n #9223372036854775808)
  then bind (h-typed-entries buf #0 n (toNat (wquot n #20))) (λ es → bind (h-typed-reads fd buf k) (λ rest → ret {lzero} {W} (list-append es rest)))
  else ret {lzero} {W} nil)
h-typed-list : List Word → Proc W (List (List Word × Word))
h-typed-list path = bind (h-cstr path) (λ p → bind (sys-call #257 #18446744073709551516 p #65536 #0 #0 #0) (λ fd →
  if wlt fd #9223372036854775808 then
    bind (alloc-bytes #65536) (λ buf → bind (h-typed-reads fd buf (toNat #4096)) (λ ns →
    bind (sys-call #3 fd #0 #0 #0 #0 #0) (λ c → ret {lzero} {W} ns)))
  else ret {lzero} {W} nil))
-- every file under a directory whose name ends in suffix, to depth `depth`, paths from where it is
h-files-at : (List Word → Proc W (List (List Word))) → List Word → List Word → List (List Word × Word) → Proc W (List (List Word))
h-files-at rec suf path nil = ret nil
h-files-at rec suf path (cons e r) =
  bind (if andB (weq (snd e) #4) (h-not (h-skip (fst e))) then rec (list-append path (cons #47 (fst e)))
        else ret {lzero} {W} (if andB (weq (snd e) #8) (h-ends suf (fst e)) then cons (list-append path (cons #47 (fst e))) nil else nil)) (λ here →
  bind (h-files-at rec suf path r) (λ rest → ret (list-append here rest)))
h-files : Nat → List Word → List Word → Proc W (List (List Word))
h-files zero suf path = ret nil
h-files (suc d) suf path = bind (h-typed-list path) (λ es → h-files-at (h-files d suf) suf path es)
-- the working directory
h-cwd : Proc W (List Word)
h-cwd = bind (alloc-bytes #4097) (λ buf → bind (sys-call #79 buf #4096 #0 #0 #0 #0) (λ r → h-name-at buf (toNat #4096)))
-- lists of texts run together
h-concat-lists : List (List (List Word)) → List (List Word)
h-concat-lists nil = nil
h-concat-lists (cons x r) = list-append x (h-concat-lists r)
-- the files the machine reports a file imports, and reads as bytes (`--imports`: `imports:` and `reads:`
-- lines, paths from the repository root)
h-imported : List (List Word) → List (List Word)
h-imported nil = nil
h-imported (cons l r) = if h-prefix "imports: " l then list-append (h-tail-lists (h-split #32 (h-drop "imports: " l))) (h-imported r) else h-imported r
h-reads : List (List Word) → List (List Word)
h-reads nil = nil
h-reads (cons l r) = if h-prefix "reads: " l then list-append (h-tail-lists (h-split #32 (h-drop "reads: " l))) (h-reads r) else h-reads r
-- the files a program depends on: the code files it imports, followed until no new one appears
-- (code), and with them every file any of them reads as bytes, text or documents (all)
h-imports-closure : Nat → List Word → List (List Word) → List (List Word) → List (List Word) → Proc W (List (List Word))
h-imports-closure zero m code all front = ret all
h-imports-closure (suc f) m code all front = if h-null (h-concat front) then ret {lzero} {W} all
  else bind (h-capture (cons m (cons "--imports" front))) (λ im →
    h-imports-closure f m (h-union code (h-minus (h-msort (h-imported (h-lines (snd im)))) code))
      (h-union all (h-union (h-msort (h-imported (h-lines (snd im)))) (h-msort (h-reads (h-lines (snd im))))))
      (h-minus (h-msort (h-imported (h-lines (snd im)))) code))
h-latest : List (List Word) → Proc W Word
h-latest nil = ret #0
h-latest (cons f r) = bind (h-file-time f) (λ t → bind (h-latest r) (λ u → ret (if wlt t u then u else t)))
-- the latest change among the files a result of the machine m on the program at path depends on: the
-- machine itself and every file the program depends on
h-code-time : List Word → List Word → Proc W Word
h-code-time m path = bind (h-imports-closure (toNat #64) m (cons path nil) (cons path nil) (cons path nil)) (λ fs → h-latest (cons m fs))
