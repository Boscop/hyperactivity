lift-gen : (n : Nat) (X X' : Type 1) (F : X → Type 1) (F' : X' → Type 1) (Z Z' : Type 1) (φ : X → X') (φo : (x : X) → F x → F' (φ x))
  (h : Z → Z') (gm : (x : X) → F x → Z) (gm' : (x' : X') → F' x' → Z')
  (q : PathP (λ i → (xq : X) (yq : F xq) → Z') (λ xq yq → h (gm xq yq)) (λ xq yq → gm' (φ xq) (φo xq yq)))
  (H : Z → Type 1) (H' : Z' → Type 1) (hH : (z : Z) → H z → H' (h z)) (l : (x : X) (y : F x) → H (gm x y)) (l' : (x' : X') (y' : F' x') → H' (gm' x' y'))
  (ql : PathP (λ i → (xq : X) (yq : F xq) → H' (q i xq yq)) (λ xq yq → hH (gm xq yq) (l xq yq)) (λ xq yq → l' (φ xq) (φo xq yq)))
  (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → DCube n Z' H' (dmap-gen n X X' F F' Z Z' φ φo h gm gm' q c d i))
    (dcube-reidx n Z Z' H H' h hH (dcube-map n X F Z gm c d) (dcube-lift n X Z F H gm l c d))
    (dcube-lift n X' Z' F' H' gm' l' (cube-map n X X' φ c) (dcube-reidx n X X' F F' φ φo c d))
lift-gen zero X X' F F' Z Z' φ φo h gm gm' q H H' hH l l' ql c d = λ i → ql i c d
lift-gen (suc n) X X' F F' Z Z' φ φo h gm gm' q H H' hH l l' ql c d =
  lift-gen n (Line X) (Line X') (LineO X F) (LineO X' F') (Line Z) (Line Z') (line-map X X' φ) (lineo-reidx X X' F F' φ φo) (line-map Z Z' h)
    (lineo-map X F Z gm) (lineo-map X' F' Z' gm')
    (λ i L D → (q i (fst L) (fst D) , q i (fst (snd L)) (fst (snd D)) , λ j → q i (snd (snd L) j) (snd (snd D) j)))
    (LineO Z H) (LineO Z' H') (lineo-reidx Z Z' H H' h hH) (lineo-lift X Z F H gm l) (lineo-lift X' Z' F' H' gm' l')
    (λ i L D → (ql i (fst L) (fst D) , ql i (fst (snd L)) (fst (snd D)) , λ j → ql i (snd (snd L) j) (snd (snd D) j))) c d
DLift : (sk : Lst Entry) (k : Word) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y)) (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X Y c) → Type 1
DLift sk k X Y Z H f g c d =
  PathP (λ i → DCube (dims sk) Z H (diag-dmap sk k X Y Z f c d i))
    (diag-sk-d sk k Z H (dcube-map (suc (dims sk)) X Y Z f c d) (dcube-lift (suc (dims sk)) X Z Y H f g c d))
    (dcube-lift (dims sk) X Z Y H f g (diag-sk sk k X c) (diag-sk-d sk k X Y c d))
DLTy : (sk : Lst Entry) (k : Word) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y)) (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X Y c) → Bool → Type 1
DLTy sk k X Y Z H f g c d b =
  PathP (λ i → DCube (dims sk) Z H (ddm-ty sk k X Y Z f c d b i))
    (dsd-ty sk k Z H (dcube-map (suc (dims sk)) X Y Z f c d) (dcube-lift (suc (dims sk)) X Z Y H f g c d) b)
    (dcube-lift (dims sk) X Z Y H f g (dsk-ty sk k X c b) (dsd-ty sk k X Y c d b))
DLDim : (sk : Lst Entry) (k : Word) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y)) (c : Cube (suc (suc (dims sk))) X) (d : DCube (suc (suc (dims sk))) X Y c) → Bool → Type 1
DLDim sk k X Y Z H f g c d b =
  PathP (λ i → DCube (suc (dims sk)) Z H (ddm-dim sk k X Y Z f c d b i))
    (dsd-dim sk k Z H (dm2 (dims sk) X Y Z f c d) (dcube-lift (suc (suc (dims sk))) X Z Y H f g c d) b)
    (dcube-lift (suc (dims sk)) X Z Y H f g (dsk-dim sk k X c b) (dsd-dim sk k X Y c d b))
dl-dim-f : (sk : Lst Entry) (k : Word) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y)) (c : Cube (suc (suc (dims sk))) X) (d : DCube (suc (suc (dims sk))) X Y c) →
  DLift sk (%wsub k #1) (Line X) (LineO X Y) (Line Z) (LineO Z H) (lineo-map X Y Z f) (lineo-lift X Z Y H f g) (exc (dims sk) X c) (exd (dims sk) X Y c d) →
  DLDim sk k X Y Z H f g c d false
