  (pcat-d (Cube (suc (dims sk)) Z) (λ u → DCube (suc (dims sk)) Z H u) (diag-sk sk (%wsub k #1) (Line Z) (exc (dims sk) Z (dm2 (dims sk) X Y Z f c d))) (diag-sk sk (%wsub k #1) (Line Z) (dm2 (dims sk) X Y Z f (exc (dims sk) X c) (exd (dims sk) X Y c d))) (dcube-map (suc (dims sk)) X Y Z f (diag-sk sk (%wsub k #1) (Line X) (exc (dims sk) X c)) (diag-sk-d sk (%wsub k #1) (Line X) (LineO X Y) (exc (dims sk) X c) (exd (dims sk) X Y c d))) (ddp1 sk k X Y Z f c d) (ddp2 sk k X Y Z f c d) (diag-sk-d sk (%wsub k #1) (Line Z) (LineO Z H) (exc (dims sk) Z (dm2 (dims sk) X Y Z f c d)) (exd (dims sk) Z H (dm2 (dims sk) X Y Z f c d) (dcube-lift (suc (suc (dims sk))) X Z Y H f g c d))) (diag-sk-d sk (%wsub k #1) (Line Z) (LineO Z H) (dm2 (dims sk) X Y Z f (exc (dims sk) X c) (exd (dims sk) X Y c d)) (dcube-lift (dims sk) (Line (Line X)) (Line (Line Z)) (LineO (Line X) (LineO X Y)) (LineO (Line Z) (LineO Z H)) (mf2 X Y Z f) (lineo-lift (Line X) (Line Z) (LineO X Y) (LineO Z H) (lineo-map X Y Z f) (lineo-lift X Z Y H f g)) (exc (dims sk) X c) (exd (dims sk) X Y c d))) (dcube-lift (suc (dims sk)) X Z Y H f g (diag-sk sk (%wsub k #1) (Line X) (exc (dims sk) X c)) (diag-sk-d sk (%wsub k #1) (Line X) (LineO X Y) (exc (dims sk) X c) (exd (dims sk) X Y c d))) (λ i → diag-sk-d sk (%wsub k #1) (Line Z) (LineO Z H) (dpg sk X Z Y f c d i) (lift-gen (dims sk) (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X Y)) (LineO (Line X) (LineO X Y)) (Line (Line Z)) (Line (Line Z)) (exch-l X) (exch-o X Y) (exch-l Z) (mf2 X Y Z f) (mf2 X Y Z f) (λ j Q D → exch-l Z (mf2 X Y Z f Q D)) (LineO (Line Z) (LineO Z H)) (LineO (Line Z) (LineO Z H)) (exch-o Z H) (lineo-lift (Line X) (Line Z) (LineO X Y) (LineO Z H) (lineo-map X Y Z f) (lineo-lift X Z Y H f g)) (lineo-lift (Line X) (Line Z) (LineO X Y) (LineO Z H) (lineo-map X Y Z f) (lineo-lift X Z Y H f g)) (λ j Q D → exch-o Z H (mf2 X Y Z f Q D) (lineo-lift (Line X) (Line Z) (LineO X Y) (LineO Z H) (lineo-map X Y Z f) (lineo-lift X Z Y H f g) Q D)) c d i)) IH)
diag-lift : (sk : Lst Entry) (k : Word) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y)) (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X Y c) → DLift sk k X Y Z H f g c d
diag-lift lnil k X Y Z H f g c d = λ i → g (fst c) (fst d)
diag-lift (lcons (e-ty s) sk) k X Y Z H f g c d =
  bool-elim1 (DLTy sk k X Y Z H f g c d)
    (lift-gen (dims sk) (Line X) X (LineO X Y) Y (Line Z) Z (face0-l X) (face0-o X Y) (face0-l Z) (lineo-map X Y Z f) f (λ i L D → f (fst L) (fst D)) (LineO Z H) H (face0-o Z H) (lineo-lift X Z Y H f g) g (λ i L D → g (fst L) (fst D)) c d)
    (diag-lift sk (%wsub k #1) X Y Z H f g c d) (weq k #0)
diag-lift (lcons e-dim sk) k X Y Z H f g c d =
  bool-elim1 (DLDim sk k X Y Z H f g c d)
    (lift-gen (dims sk) (Line (Line X)) (Line X) (LineO (Line X) (LineO X Y)) (LineO X Y) (Line (Line Z)) (Line Z) (diag-l X) (diag-o X Y) (diag-l Z) (mf2 X Y Z f) (lineo-map X Y Z f) (λ i Q D → diag-l Z (mf2 X Y Z f Q D)) (LineO (Line Z) (LineO Z H)) (LineO Z H) (diag-o Z H) (lineo-lift (Line X) (Line Z) (LineO X Y) (LineO Z H) (lineo-map X Y Z f) (lineo-lift X Z Y H f g)) (lineo-lift X Z Y H f g) (λ i Q D → diag-o Z H (mf2 X Y Z f Q D) (lineo-lift (Line X) (Line Z) (LineO X Y) (LineO Z H) (lineo-map X Y Z f) (lineo-lift X Z Y H f g) Q D)) c d)
    (dl-dim-f sk k X Y Z H f g c d (diag-lift sk (%wsub k #1) (Line X) (LineO X Y) (Line Z) (LineO Z H) (lineo-map X Y Z f) (lineo-lift X Z Y H f g) (exc (dims sk) X c) (exd (dims sk) X Y c d)))
    (weq k #0)
LiftT : (n : Nat) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y))
  (oc : (W : Type 1) → Cube (suc n) W → Cube n W) (od : (W : Type 1) (G : W → Type 1) (c : Cube (suc n) W) → DCube (suc n) W G c → DCube n W G (oc W c))
  (c : Cube (suc n) X) (d : DCube (suc n) X Y c) (om : PathP (λ i → Cube n Z) (oc Z (dcube-map (suc n) X Y Z f c d)) (dcube-map n X Y Z f (oc X c) (od X Y c d))) → Type 1
LiftT n X Y Z H f g oc od c d om =
  PathP (λ i → DCube n Z H (om i)) (od Z H (dcube-map (suc n) X Y Z f c d) (dcube-lift (suc n) X Z Y H f g c d)) (dcube-lift n X Z Y H f g (oc X c) (od X Y c d))
const-lift : (n : Nat) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y)) (x : X) (y : Y x) →
