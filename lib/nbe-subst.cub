papp-pull : (sk : Lst Entry) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x) (fm : DNF)
  (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X Y c) (e : DCube (suc (dims sk)) X' F' (dcube-map (suc (dims sk)) X Y X' f c d)) →
  PullT (dims sk) X X' Y F F' f g (λ Z c' → papp-cube sk Z fm c') (λ Z G c' d' → papp-cube-d sk Z G fm c' d') c d (papp-dmap sk X Y X' f fm c d) e
papp-pull sk X X' Y F F' f g fm c d e = pex-pull sk (dnf-ix fm) X X' Y F F' f g c d e

cmap-d-pull : (sk' sk : Lst Entry) (σ : CMap sk' sk) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (c : Cube (dims sk) X) (d : DCube (dims sk) X Y c) (e : DCube (dims sk) X' F' (dcube-map (dims sk) X Y X' f c d)) →
  PathP (λ i → DCube (dims sk') X F (cmap-cube sk' sk σ X c)) (cmap-d sk' sk σ X F c (dcube-pull (dims sk) X X' Y F F' f g c d e))
    (dcube-pull (dims sk') X X' Y F F' f g (cmap-cube sk' sk σ X c) (cmap-d sk' sk σ X Y c d)
       (carry (dims sk') X' F' (cmap-cube sk' sk σ X' (dcube-map (dims sk) X Y X' f c d)) (dcube-map (dims sk') X Y X' f (cmap-cube sk' sk σ X c) (cmap-d sk' sk σ X Y c d))
          (cmap-dmap sk' sk σ X Y X' f c d) (cmap-d sk' sk σ X' F' (dcube-map (dims sk) X Y X' f c d) e)))
cmap-d-pull sk' lnil σ X X' Y F F' f g c d e = const-pull (dims sk') X X' Y F F' f g c d e
cmap-d-pull sk' (lcons (e-ty a) sk) σ X X' Y F F' f g c d e = cmap-d-pull sk' sk σ X X' Y F F' f g c d e
cmap-d-pull sk' (lcons e-dim sk) σ X X' Y F F' f g c d e =
  pull-chain (suc (dims sk')) (dims sk') X' X' F' F' (λ c' → papp-cube sk' X' (snd σ) c') (λ c' a' → papp-cube-d sk' X' F' (snd σ) c' a')
    (cmap-cube sk' sk (fst σ) (Line X') (dcube-map (suc (dims sk)) X Y X' f c d))
    (dcube-map (suc (dims sk')) X Y X' f (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X Y) c d))
    (cmap-dmap sk' sk (fst σ) (Line X) (LineO X Y) (Line X') (lineo-map X Y X' f) c d)
    (cmap-d sk' sk (fst σ) (Line X') (LineO X' F') (dcube-map (suc (dims sk)) X Y X' f c d) e)
    (dcube-map (dims sk') X Y X' f (cmap-cube sk' (lcons e-dim sk) σ X c) (cmap-d sk' (lcons e-dim sk) σ X Y c d))
    (papp-dmap sk' X Y X' f (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X Y) c d))
    (DCube (suc (dims sk')) X F (cmap-cube sk' sk (fst σ) (Line X) c)) (DCube (dims sk') X F (papp-cube sk' X (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c)))
    (λ u → papp-cube-d sk' X F (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c) u)
    (cmap-d sk' sk (fst σ) (Line X) (LineO X F) c (dcube-pull (suc (dims sk)) X X' Y F F' f g c d e))
    (dcube-pull (suc (dims sk')) X X' Y F F' f g (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X Y) c d)
       (carry (suc (dims sk')) X' F' (cmap-cube sk' sk (fst σ) (Line X') (dcube-map (suc (dims sk)) X Y X' f c d))
          (dcube-map (suc (dims sk')) X Y X' f (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X Y) c d))
          (cmap-dmap sk' sk (fst σ) (Line X) (LineO X Y) (Line X') (lineo-map X Y X' f) c d)
          (cmap-d sk' sk (fst σ) (Line X') (LineO X' F') (dcube-map (suc (dims sk)) X Y X' f c d) e)))
    (λ z → dcube-pull (dims sk') X X' Y F F' f g (papp-cube sk' X (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c))
       (papp-cube-d sk' X Y (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X Y) c d)) z)
    (cmap-d-pull sk' sk (fst σ) (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g) c d e)
    (papp-pull sk' X X' Y F F' f g (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X Y) c d)
       (carry (suc (dims sk')) X' F' (cmap-cube sk' sk (fst σ) (Line X') (dcube-map (suc (dims sk)) X Y X' f c d))
          (dcube-map (suc (dims sk')) X Y X' f (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X Y) c d))
