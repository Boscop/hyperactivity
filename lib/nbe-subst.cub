    (papp-ex-fmap sk x X F F' h c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c d)))
    (pcat (DCube (dims sk) X F' c) (papp-ex sk X F' x c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c d)))) (papp-ex sk X F' x c (papp-ex sk X (DL X F') y c (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F')) (dlf X (DL X F) (DL X F') (dlf X F F' h)) c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c d)))) (papp-ex sk X F' x c (papp-ex sk X (DL X F') y c (dcube-fmap (dims sk) X (DL X F') (DL X (DL X F')) (λ x q → meet-o X F' (degen-l X x) q) c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c d))))
       (cong1 (DCube (dims sk) X (DL X F') c) (DCube (dims sk) X F' c) (λ w → papp-ex sk X F' x c w) (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c d))) (papp-ex sk X (DL X F') y c (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F')) (dlf X (DL X F) (DL X F') (dlf X F F' h)) c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c d))) (papp-ex-fmap sk y X (DL X F) (DL X F') (dlf X F F' h) c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c d)))
       (cong1 (DCube (dims sk) X (DL X (DL X F')) c) (DCube (dims sk) X F' c) (λ w → papp-ex sk X F' x c (papp-ex sk X (DL X F') y c w)) (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F')) (dlf X (DL X F) (DL X F') (dlf X F F' h)) c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c d)) (dcube-fmap (dims sk) X (DL X F') (DL X (DL X F')) (λ x q → meet-o X F' (degen-l X x) q) c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c d)) (fmap-sw (dims sk) X (DL X F) (DL X (DL X F)) (DL X F') (DL X (DL X F')) (λ x q → meet-o X F (degen-l X x) q) (dlf X (DL X F) (DL X F') (dlf X F F' h)) (dlf X F F' h) (λ x q → meet-o X F' (degen-l X x) q) (λ t x q → meet-o X F' (degen-l X x) (dlf X F F' h x q)) c d)))
papp-ex-fmap sk (ixjoin x y) X F F' h c d =
  pcat (DCube (dims sk) X F' c) (dcube-fmap (dims sk) X F F' h c (papp-ex sk X F x c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d)))) (papp-ex sk X F' x c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d)))) (papp-ex sk X F' x c (papp-ex sk X (DL X F') y c (dcube-fmap (dims sk) X (DL X F') (DL X (DL X F')) (λ x q → join-o X F' (degen-l X x) q) c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c d))))
    (papp-ex-fmap sk x X F F' h c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d)))
    (pcat (DCube (dims sk) X F' c) (papp-ex sk X F' x c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d)))) (papp-ex sk X F' x c (papp-ex sk X (DL X F') y c (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F')) (dlf X (DL X F) (DL X F') (dlf X F F' h)) c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d)))) (papp-ex sk X F' x c (papp-ex sk X (DL X F') y c (dcube-fmap (dims sk) X (DL X F') (DL X (DL X F')) (λ x q → join-o X F' (degen-l X x) q) c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c d))))
       (cong1 (DCube (dims sk) X (DL X F') c) (DCube (dims sk) X F' c) (λ w → papp-ex sk X F' x c w) (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d))) (papp-ex sk X (DL X F') y c (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F')) (dlf X (DL X F) (DL X F') (dlf X F F' h)) c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d))) (papp-ex-fmap sk y X (DL X F) (DL X F') (dlf X F F' h) c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d)))
       (cong1 (DCube (dims sk) X (DL X (DL X F')) c) (DCube (dims sk) X F' c) (λ w → papp-ex sk X F' x c (papp-ex sk X (DL X F') y c w)) (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F')) (dlf X (DL X F) (DL X F') (dlf X F F' h)) c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d)) (dcube-fmap (dims sk) X (DL X F') (DL X (DL X F')) (λ x q → join-o X F' (degen-l X x) q) c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c d)) (fmap-sw (dims sk) X (DL X F) (DL X (DL X F)) (DL X F') (DL X (DL X F')) (λ x q → join-o X F (degen-l X x) q) (dlf X (DL X F) (DL X F') (dlf X F F' h)) (dlf X F F' h) (λ x q → join-o X F' (degen-l X x) q) (λ t x q → join-o X F' (degen-l X x) (dlf X F F' h x q)) c d)))
papp-ex-fmap sk cd X F F' h c d = fmap-sw (dims sk) X (DL X F) F (DL X F') F' (λ x q → fst q) h (dlf X F F' h) (λ x q → fst q) (λ i x q → h x (fst q)) c d
papp-dd-fmap : (sk : Lst Entry) (fm : DNF) (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x) (c : Cube (dims sk) X) (d : DCube (dims sk) X (DL X F) c) →
  DDFmap (dims sk) (λ Z H G q → papp-dd sk Z H fm G q) X F F' h c d
papp-dd-fmap sk fm X F F' h c d = papp-ex-fmap sk (dnf-ix fm) X F F' h c d
papp-line-fmap : (Γ : CCtx) (Y Z Z' : Type 1) (ℓ : Y → Line Z) (k : Z → Z') (f : DNF) (X : Mean Γ Y) →
  PathM Γ Z' (fmapM Γ Z Z' k (papp-line Γ Y Z ℓ f X)) (papp-line Γ Y Z' (λ y → line-map Z Z' k (ℓ y)) f X)
papp-line-fmap Γ Y Z Z' ℓ k f X =
  pcat (Mean Γ Z') (fmapM Γ Z Z' k (papp-line Γ Y Z ℓ f X))
    (papp-dd (fst Γ) (CtxV (fst Γ)) (FbE (fst Γ) Z') f (snd Γ)
       (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z')) (dlf (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → k (e ρ))) (snd Γ)
          (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (fline (fst Γ) Y Z ℓ) (snd Γ) X)))
    (papp-line Γ Y Z' (λ y → line-map Z Z' k (ℓ y)) f X)
    (papp-dd-fmap (fst Γ) f (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → k (e ρ)) (snd Γ)
       (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (fline (fst Γ) Y Z ℓ) (snd Γ) X))
    (λ i → papp-dd (fst Γ) (CtxV (fst Γ)) (FbE (fst Γ) Z') f (snd Γ)
       (fmap-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z'))
          (fline (fst Γ) Y Z ℓ) (dlf (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → k (e ρ))) (snd Γ) X i))
dexch : (X : Type 1) (F : X → Type 1) (x : X) → DL X (DL X F) x → DL X (DL X F) x
dexch X F x q = exch-o X F (degen-l (Line X) (degen-l X x)) q
ddiag : (X : Type 1) (F : X → Type 1) (x : X) → DL X (DL X F) x → DL X F x
ddiag X F x q = diag-o X F (degen-l (Line X) (degen-l X x)) q
dxo : (X : Type 1) (F : X → Type 1) (L : Line X) → LineO X (DL X F) L → DL (Line X) (LineO X F) L
dxo X F L q = exch-o X F (line-map X (Line X) (degen-l X) L) q
dgo : (X : Type 1) (F : X → Type 1) (L : Line X) → LineO X (DL X F) L → LineO X F L
dgo X F L q = diag-o X F (line-map X (Line X) (degen-l X) L) q
fmap-sw21 : (n : Nat) (X : Type 1) (F0 F1 F2 : X → Type 1) (h0 : (x : X) → F0 x → F1 x) (h1 : (x : X) → F1 x → F2 x) (k : (x : X) → F0 x → F2 x)
  (q : PathP (λ i → (x : X) → F0 x → F2 x) (λ x y → h1 x (h0 x y)) k) (c : Cube n X) (d : DCube n X F0 c) →
  PathP (λ i → DCube n X F2 c) (dcube-fmap n X F1 F2 h1 c (dcube-fmap n X F0 F1 h0 c d)) (dcube-fmap n X F0 F2 k c d)
fmap-sw21 zero X F0 F1 F2 h0 h1 k q c d = λ i → q i c d
fmap-sw21 (suc n) X F0 F1 F2 h0 h1 k q c d =
  fmap-sw21 n (Line X) (LineO X F0) (LineO X F1) (LineO X F2) (lineo-fmap X F0 F1 h0) (lineo-fmap X F1 F2 h1) (lineo-fmap X F0 F2 k)
    (λ i L y → lineo-fmap X F0 F2 (q i) L y) c d
fmap-sw2i : (n : Nat) (X : Type 1) (F0 F1 : X → Type 1) (h0 : (x : X) → F0 x → F1 x) (h1 : (x : X) → F1 x → F0 x)
  (q : PathP (λ i → (x : X) → F0 x → F0 x) (λ x y → h1 x (h0 x y)) (λ x y → y)) (c : Cube n X) (d : DCube n X F0 c) →
  PathP (λ i → DCube n X F0 c) (dcube-fmap n X F1 F0 h1 c (dcube-fmap n X F0 F1 h0 c d)) d
fmap-sw2i zero X F0 F1 h0 h1 q c d = λ i → q i c d
fmap-sw2i (suc n) X F0 F1 h0 h1 q c d =
  fmap-sw2i n (Line X) (LineO X F0) (LineO X F1) (lineo-fmap X F0 F1 h0) (lineo-fmap X F1 F0 h1) (λ i L y → lineo-fmap X F0 F0 (q i) L y) c d
fmap-sw23 : (n : Nat) (X : Type 1) (F0 F1 F2 G1 G2 : X → Type 1) (h0 : (x : X) → F0 x → F1 x) (h1 : (x : X) → F1 x → F2 x)
  (k0 : (x : X) → F0 x → G1 x) (k1 : (x : X) → G1 x → G2 x) (k2 : (x : X) → G2 x → F2 x)
  (q : PathP (λ i → (x : X) → F0 x → F2 x) (λ x y → h1 x (h0 x y)) (λ x y → k2 x (k1 x (k0 x y)))) (c : Cube n X) (d : DCube n X F0 c) →
  PathP (λ i → DCube n X F2 c) (dcube-fmap n X F1 F2 h1 c (dcube-fmap n X F0 F1 h0 c d))
    (dcube-fmap n X G2 F2 k2 c (dcube-fmap n X G1 G2 k1 c (dcube-fmap n X F0 G1 k0 c d)))
fmap-sw23 zero X F0 F1 F2 G1 G2 h0 h1 k0 k1 k2 q c d = λ i → q i c d
fmap-sw23 (suc n) X F0 F1 F2 G1 G2 h0 h1 k0 k1 k2 q c d =
  fmap-sw23 n (Line X) (LineO X F0) (LineO X F1) (LineO X F2) (LineO X G1) (LineO X G2) (lineo-fmap X F0 F1 h0) (lineo-fmap X F1 F2 h1)
    (lineo-fmap X F0 G1 k0) (lineo-fmap X G1 G2 k1) (lineo-fmap X G2 F2 k2) (λ i L y → lineo-fmap X F0 F2 (q i) L y) c d
fmap-sw32 : (n : Nat) (X : Type 1) (F0 F1 F2 F3 G1 : X → Type 1) (h0 : (x : X) → F0 x → F1 x) (h1 : (x : X) → F1 x → F2 x) (h2 : (x : X) → F2 x → F3 x)
  (k0 : (x : X) → F0 x → G1 x) (k1 : (x : X) → G1 x → F3 x)
  (q : PathP (λ i → (x : X) → F0 x → F3 x) (λ x y → h2 x (h1 x (h0 x y))) (λ x y → k1 x (k0 x y))) (c : Cube n X) (d : DCube n X F0 c) →
  PathP (λ i → DCube n X F3 c) (dcube-fmap n X F2 F3 h2 c (dcube-fmap n X F1 F2 h1 c (dcube-fmap n X F0 F1 h0 c d)))
    (dcube-fmap n X G1 F3 k1 c (dcube-fmap n X F0 G1 k0 c d))
fmap-sw32 zero X F0 F1 F2 F3 G1 h0 h1 h2 k0 k1 q c d = λ i → q i c d
fmap-sw32 (suc n) X F0 F1 F2 F3 G1 h0 h1 h2 k0 k1 q c d =
  fmap-sw32 n (Line X) (LineO X F0) (LineO X F1) (LineO X F2) (LineO X F3) (LineO X G1) (lineo-fmap X F0 F1 h0) (lineo-fmap X F1 F2 h1)
    (lineo-fmap X F2 F3 h2) (lineo-fmap X F0 G1 k0) (lineo-fmap X G1 F3 k1) (λ i L y → lineo-fmap X F0 F3 (q i) L y) c d
fmap-sw33 : (n : Nat) (X : Type 1) (F0 F1 F2 F3 G1 G2 : X → Type 1) (h0 : (x : X) → F0 x → F1 x) (h1 : (x : X) → F1 x → F2 x) (h2 : (x : X) → F2 x → F3 x)
  (k0 : (x : X) → F0 x → G1 x) (k1 : (x : X) → G1 x → G2 x) (k2 : (x : X) → G2 x → F3 x)
  (q : PathP (λ i → (x : X) → F0 x → F3 x) (λ x y → h2 x (h1 x (h0 x y))) (λ x y → k2 x (k1 x (k0 x y)))) (c : Cube n X) (d : DCube n X F0 c) →
  PathP (λ i → DCube n X F3 c) (dcube-fmap n X F2 F3 h2 c (dcube-fmap n X F1 F2 h1 c (dcube-fmap n X F0 F1 h0 c d)))
    (dcube-fmap n X G2 F3 k2 c (dcube-fmap n X G1 G2 k1 c (dcube-fmap n X F0 G1 k0 c d)))
fmap-sw33 zero X F0 F1 F2 F3 G1 G2 h0 h1 h2 k0 k1 k2 q c d = λ i → q i c d
fmap-sw33 (suc n) X F0 F1 F2 F3 G1 G2 h0 h1 h2 k0 k1 k2 q c d =
  fmap-sw33 n (Line X) (LineO X F0) (LineO X F1) (LineO X F2) (LineO X F3) (LineO X G1) (LineO X G2) (lineo-fmap X F0 F1 h0) (lineo-fmap X F1 F2 h1)
    (lineo-fmap X F2 F3 h2) (lineo-fmap X F0 G1 k0) (lineo-fmap X G1 G2 k1) (lineo-fmap X G2 F3 k2) (λ i L y → lineo-fmap X F0 F3 (q i) L y) c d
bool-elim1-2 : (P : Bool → Bool → Type 1) → P true true → P true false → P false true → P false false → (a b : Bool) → P a b
bool-elim1-2 P tt tf ft ff true true = tt
bool-elim1-2 P tt tf ft ff true false = tf
bool-elim1-2 P tt tf ft ff false true = ft
bool-elim1-2 P tt tf ft ff false false = ff
dd-ty-op : (sk : Lst Entry) (k : Word) (b : Bool) (Z : Type 1) (H : Z → Type 1) (G : Cube (dims sk) Z) → DCube (dims sk) Z (DL Z H) G → DCube (dims sk) Z H G
dd-ty-op sk k b Z H G q = bool-elim1 (λ b' → DCube (dims sk) Z H G) (dcube-fmap (dims sk) Z (DL Z H) H (λ x q' → fst q') G q) (diag-dd sk (%wsub k #1) Z H G q) b
dd-dim-op : (sk : Lst Entry) (k : Word) (b : Bool) (Z : Type 1) (H : Z → Type 1) (G : Cube (suc (dims sk)) Z) → DCube (suc (dims sk)) Z (DL Z H) G → DCube (suc (dims sk)) Z H G
dd-dim-op sk k b Z H G q =
  bool-elim1 (λ b' → DCube (dims sk) (Line Z) (LineO Z H) G)
    (dcube-fmap (dims sk) (Line Z) (LineO Z (DL Z H)) (LineO Z H) (λ L q' → diag-o Z H (line-map Z (Line Z) (degen-l Z) L) q') G q)
    (diag-dd sk (%wsub k #1) (Line Z) (LineO Z H) G
       (dcube-fmap (dims sk) (Line Z) (LineO Z (DL Z H)) (DL (Line Z) (LineO Z H)) (λ L q' → exch-o Z H (line-map Z (Line Z) (degen-l Z) L) q') G q)) b
DDExch : (n : Nat) (op1 op2 : (Z : Type 1) (H : Z → Type 1) (G : Cube n Z) → DCube n Z (DL Z H) G → DCube n Z H G)
  (X : Type 1) (F : X → Type 1) (G : Cube n X) (d : DCube n X (DL X (DL X F)) G) → Type 1
DDExch n op1 op2 X F G d =
  PathP (λ i → DCube n X F G) (op1 X F G (op2 X (DL X F) G d))
    (op2 X F G (op1 X (DL X F) G (dcube-fmap n X (DL X (DL X F)) (DL X (DL X F)) (dexch X F) G d)))
DDDiag : (n : Nat) (op : (Z : Type 1) (H : Z → Type 1) (G : Cube n Z) → DCube n Z (DL Z H) G → DCube n Z H G)
  (X : Type 1) (F : X → Type 1) (G : Cube n X) (d : DCube n X (DL X (DL X F)) G) → Type 1
DDDiag n op X F G d =
  PathP (λ i → DCube n X F G) (op X F G (op X (DL X F) G d)) (op X F G (dcube-fmap n X (DL X (DL X F)) (DL X F) (ddiag X F) G d))
DDDeg : (n : Nat) (op : (Z : Type 1) (H : Z → Type 1) (G : Cube n Z) → DCube n Z (DL Z H) G → DCube n Z H G)
  (X : Type 1) (F : X → Type 1) (G : Cube n X) (d : DCube n X F G) → Type 1
DDDeg n op X F G d = PathP (λ i → DCube n X F G) (op X F G (dcube-fmap n X F (DL X F) (degen-o X F) G d)) d
ddv-exch-dim-tf : (sk : Lst Entry) (k j : Word) (X : Type 1) (F : X → Type 1) (G : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X (DL X (DL X F)) G) →
  DDExch (suc (dims sk)) (dd-dim-op sk k true) (dd-dim-op sk j false) X F G d
ddv-exch-dim-tf sk k j X F G d =
  pcat (DCube (dims sk) (Line X) (LineO X F) G)
    (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (LineO X F) (dgo X F) G
       (diag-dd sk (%wsub j #1) (Line X) (LineO X (DL X F)) G (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (dxo X (DL X F)) G d)))
    (diag-dd sk (%wsub j #1) (Line X) (LineO X F) G
       (dcube-fmap (dims sk) (Line X) (DL (Line X) (LineO X (DL X F))) (DL (Line X) (LineO X F)) (dlf (Line X) (LineO X (DL X F)) (LineO X F) (dgo X F)) G
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (dxo X (DL X F)) G d)))
    (diag-dd sk (%wsub j #1) (Line X) (LineO X F) G
       (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F) G
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (LineO X (DL X F)) (dgo X (DL X F)) G
             (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (LineO X (DL X (DL X F))) (lineo-fmap X (DL X (DL X F)) (DL X (DL X F)) (dexch X F)) G d))))
    (diag-dd-fmap sk (%wsub j #1) (Line X) (LineO X (DL X F)) (LineO X F) (dgo X F) G
       (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (dxo X (DL X F)) G d))
    (cong1 (DCube (dims sk) (Line X) (DL (Line X) (LineO X F)) G) (DCube (dims sk) (Line X) (LineO X F) G) (λ w → diag-dd sk (%wsub j #1) (Line X) (LineO X F) G w)
       (dcube-fmap (dims sk) (Line X) (DL (Line X) (LineO X (DL X F))) (DL (Line X) (LineO X F)) (dlf (Line X) (LineO X (DL X F)) (LineO X F) (dgo X F)) G
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (dxo X (DL X F)) G d))
       (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F) G
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (LineO X (DL X F)) (dgo X (DL X F)) G
             (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (LineO X (DL X (DL X F))) (lineo-fmap X (DL X (DL X F)) (DL X (DL X F)) (dexch X F)) G d)))
       (fmap-sw23 (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (DL (Line X) (LineO X F)) (LineO X (DL X (DL X F))) (LineO X (DL X F))
          (dxo X (DL X F)) (dlf (Line X) (LineO X (DL X F)) (LineO X F) (dgo X F))
          (lineo-fmap X (DL X (DL X F)) (DL X (DL X F)) (dexch X F)) (dgo X (DL X F)) (dxo X F)
          (λ i L y → dlf (Line X) (LineO X (DL X F)) (LineO X F) (dgo X F) L (dxo X (DL X F) L y)) G d))
