  (pcat-d (Cube (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ')))) (λ u → DCube (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (FbE (lcons (e-ty a) (fst Δ')) Z) u) (kp-c0 Δ' Δ a Y h M w) (dcube-map (dims (fst Δ')) (CtxV (fst Δ')) (FbE (fst Δ') Y) (CtxV (lcons (e-ty a) (fst Δ'))) (λ γ e → (γ , λ ρ → h (e ρ))) (snd Δ') (dcube-fmap (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') Y) (λ γ' t ρ' → snd t (snd (fst t) ρ')) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M))) (snd (kp-ctx Δ' Δ a Y h M w)) (psym (Cube (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ')))) (dcube-map (dims (fst Δ')) (CtxV (fst Δ')) (FbE (fst Δ') Y) (CtxV (lcons (e-ty a) (fst Δ'))) (λ γ e → (γ , λ ρ → h (e ρ))) (snd Δ') (dcube-fmap (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') Y) (λ γ' t ρ' → snd t (snd (fst t) ρ')) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M))) (dcube-map (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (CtxV (lcons (e-ty a) (fst Δ'))) (λ γ' t → (γ' , λ ρ' → h (snd t (snd (fst t) ρ')))) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M)) (dmap-fmap (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') Y) (CtxV (lcons (e-ty a) (fst Δ'))) (λ γ' t ρ' → snd t (snd (fst t) ρ')) (λ γ e → (γ , λ ρ → h (e ρ))) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M))) (λ i → dcube-map (dims (fst Δ')) (CtxV (fst Δ')) (FbE (fst Δ') Y) (CtxV (lcons (e-ty a) (fst Δ'))) (λ γ e → (γ , λ ρ → h (e ρ))) (snd Δ') ((fmap-pull (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (fst Δ)) (SubF (fst Δ') (fst Δ)) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') Y) (FbE (fst Δ) Y) (λ γ' p → fst p) (λ γ' p e → (p , e)) (λ γ' t ρ' → snd t (snd (fst t) ρ')) (snd Δ') (fst (snd (world-sub Δ' Δ w))) (sub-carried Δ' Δ Y (world-sub Δ' Δ w) M)) i)) (kl-ER0 Δ' Δ a Y h M w Z G0) (dcube-lift (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (FbE (fst Δ') Y) (FbE (lcons (e-ty a) (fst Δ')) Z) (λ γ e → (γ , λ ρ → h (e ρ))) (λ γ e ρ → G0 (e (fst ρ)) (snd ρ)) (snd Δ') (dcube-fmap (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') Y) (λ γ' t ρ' → snd t (snd (fst t) ρ')) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M))) (ext-lift Δ' a Y h Z G0 (subM Δ' Δ Y (world-sub Δ' Δ w) M)) (psym-d (Cube (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ')))) (λ u → DCube (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (FbE (lcons (e-ty a) (fst Δ')) Z) u) (dcube-map (dims (fst Δ')) (CtxV (fst Δ')) (FbE (fst Δ') Y) (CtxV (lcons (e-ty a) (fst Δ'))) (λ γ e → (γ , λ ρ → h (e ρ))) (snd Δ') (dcube-fmap (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') Y) (λ γ' t ρ' → snd t (snd (fst t) ρ')) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M))) (kp-c0 Δ' Δ a Y h M w) (dmap-fmap (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') Y) (CtxV (lcons (e-ty a) (fst Δ'))) (λ γ' t ρ' → snd t (snd (fst t) ρ')) (λ γ e → (γ , λ ρ → h (e ρ))) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M)) (dcube-lift (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (FbE (fst Δ') Y) (FbE (lcons (e-ty a) (fst Δ')) Z) (λ γ e → (γ , λ ρ → h (e ρ))) (λ γ e ρ → G0 (e (fst ρ)) (snd ρ)) (snd Δ') (dcube-fmap (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') Y) (λ γ' t ρ' → snd t (snd (fst t) ρ')) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M))) (kl-ER0 Δ' Δ a Y h M w Z G0) (lift-fmap (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') Y) (CtxV (lcons (e-ty a) (fst Δ'))) (FbE (lcons (e-ty a) (fst Δ')) Z) (λ γ' t ρ' → snd t (snd (fst t) ρ')) (λ γ e → (γ , λ ρ → h (e ρ))) (λ γ e ρ → G0 (e (fst ρ)) (snd ρ)) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M))) (λ i → dcube-lift (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (FbE (fst Δ') Y) (FbE (lcons (e-ty a) (fst Δ')) Z) (λ γ e → (γ , λ ρ → h (e ρ))) (λ γ e ρ → G0 (e (fst ρ)) (snd ρ)) (snd Δ') ((fmap-pull (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (fst Δ)) (SubF (fst Δ') (fst Δ)) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') Y) (FbE (fst Δ) Y) (λ γ' p → fst p) (λ γ' p e → (p , e)) (λ γ' t ρ' → snd t (snd (fst t) ρ')) (snd Δ') (fst (snd (world-sub Δ' Δ w))) (sub-carried Δ' Δ Y (world-sub Δ' Δ w) M)) i)))
kl-s4 : (Δ' Δ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) (w : World Δ' Δ) (Z : Type 1) (G0 : (q : Y) → El a (h q) → Z) → PathP (λ i → (Mean (kp-ctx Δ' Δ a Y h M w) Z)) (carry (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (FbE (lcons (e-ty a) (fst Δ')) Z) (kp-c0 Δ' Δ a Y h M w) (snd (kp-ctx Δ' Δ a Y h M w)) (keep-base Δ' Δ a Y h M w) (kl-ER0 Δ' Δ a Y h M w Z G0)) (ext-lift Δ' a Y h Z G0 (subM Δ' Δ Y (world-sub Δ' Δ w) M))
kl-s4 Δ' Δ a Y h M w Z G0 =
  carry-uniq (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (FbE (lcons (e-ty a) (fst Δ')) Z) (kp-c0 Δ' Δ a Y h M w) (snd (kp-ctx Δ' Δ a Y h M w)) (keep-base Δ' Δ a Y h M w) (kl-ER0 Δ' Δ a Y h M w Z G0) (ext-lift Δ' a Y h Z G0 (subM Δ' Δ Y (world-sub Δ' Δ w) M)) (kl-DR Δ' Δ a Y h M w Z G0)
keep-lift : (Δ' Δ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) (w : World Δ' Δ) (Z : Type 1) (G0 : (q : Y) → El a (h q) → Z) →
  PathM (kp-ctx Δ' Δ a Y h M w) Z (subM (kp-ctx Δ' Δ a Y h M w) (ext-h Δ a Y h M) Z (keep-sub Δ' Δ a Y h M w) (ext-lift Δ a Y h Z G0 M)) (ext-lift Δ' a Y h Z G0 (subM Δ' Δ Y (world-sub Δ' Δ w) M))
keep-lift Δ' Δ a Y h M w Z G0 =
  pcat-i (Mean (kp-ctx Δ' Δ a Y h M w) Z) (kl-s1 Δ' Δ a Y h M w Z G0) (pcat-i (Mean (kp-ctx Δ' Δ a Y h M w) Z) (kl-s2 Δ' Δ a Y h M w Z G0) (pcat-i (Mean (kp-ctx Δ' Δ a Y h M w) Z) (kl-s3 Δ' Δ a Y h M w Z G0) (kl-s4 Δ' Δ a Y h M w Z G0)))
subM-lam-body : (Δ' Δ : CCtx) (w : World Δ' Δ) (a b : TyShape) (X : Mean Δ (TV (s-pi a b))) →
  PathM (lam-ctx Δ' a b (subM Δ' Δ (TV (s-pi a b)) (world-sub Δ' Δ w) X)) (TV b)
    (subM (lam-ctx Δ' a b (subM Δ' Δ (TV (s-pi a b)) (world-sub Δ' Δ w) X)) (lam-ctx Δ a b X) (TV b)
       (world-sub (lam-ctx Δ' a b (subM Δ' Δ (TV (s-pi a b)) (world-sub Δ' Δ w) X)) (lam-ctx Δ a b X) (world-keep Δ' Δ a (TV (s-pi a b)) (λ q → fst (fst q)) X w))
       (lam-body Δ a b X))
    (lam-body Δ' a b (subM Δ' Δ (TV (s-pi a b)) (world-sub Δ' Δ w) X))
subM-lam-body Δ' Δ w a b X = keep-lift Δ' Δ a (TV (s-pi a b)) (λ q → fst (fst q)) X w (TV b) (λ q x → (snd (fst q) x , snd q x))
wact : (Δ' Δ : CCtx) (w : World Δ' Δ) (Z : Type 1) → Mean Δ Z → Mean Δ' Z
wact Δ' Δ w Z M = subM Δ' Δ Z (world-sub Δ' Δ w) M
nn-tr : (k : NK) (jk : JK) (Γ : CCtx) (s : TyShape) (c : Code) (M N : Mean Γ (JZ jk s)) → PathM Γ (JZ jk s) M N → NN (k , (jk , Γ , s , c , M)) → NN (k , (jk , Γ , s , c , N))
nn-tr k jk Γ s c M N p x = comp (λ i → NN (k , (jk , Γ , s , c , p i))) (λ i → []) x
RenR : (k : NK) (jk : JK) (Δ' : CCtx) (s : TyShape) → Mean Δ' (JZ jk s) → Type 1
RenR k jk Δ' s M = (rc : Code) × NN (k , (jk , Δ' , s , rc , M))
nn-fm-in : (k : NK) (jk : JK) (Δ' Δ : CCtx) (w : World Δ' Δ) (Z : Type 1) (s : TyShape) (h : Z → JZ jk s) (M : Mean Δ Z) (c : Code) →
  NN (k , (jk , Δ' , s , c , wact Δ' Δ w (JZ jk s) (fmapM Δ Z (JZ jk s) h M))) → NN (k , (jk , Δ' , s , c , fmapM Δ' Z (JZ jk s) h (wact Δ' Δ w Z M)))
nn-fm-in k jk Δ' Δ w Z s h M c x =
  nn-tr k jk Δ' s c (wact Δ' Δ w (JZ jk s) (fmapM Δ Z (JZ jk s) h M)) (fmapM Δ' Z (JZ jk s) h (wact Δ' Δ w Z M))
    (psym (Mean Δ' (JZ jk s)) (fmapM Δ' Z (JZ jk s) h (wact Δ' Δ w Z M)) (wact Δ' Δ w (JZ jk s) (fmapM Δ Z (JZ jk s) h M)) (subM-fmap Δ' Δ Z (JZ jk s) h (world-sub Δ' Δ w) M)) x
nn-fm-out : (k : NK) (jk : JK) (Δ' Δ : CCtx) (w : World Δ' Δ) (Z : Type 1) (s : TyShape) (h : Z → JZ jk s) (M : Mean Δ Z) (c : Code) →
  NN (k , (jk , Δ' , s , c , fmapM Δ' Z (JZ jk s) h (wact Δ' Δ w Z M))) → NN (k , (jk , Δ' , s , c , wact Δ' Δ w (JZ jk s) (fmapM Δ Z (JZ jk s) h M)))
nn-fm-out k jk Δ' Δ w Z s h M c x =
  nn-tr k jk Δ' s c (fmapM Δ' Z (JZ jk s) h (wact Δ' Δ w Z M)) (wact Δ' Δ w (JZ jk s) (fmapM Δ Z (JZ jk s) h M)) (subM-fmap Δ' Δ Z (JZ jk s) h (world-sub Δ' Δ w) M) x
rn-ext : (Δ' Δ : CCtx) (w : World Δ' Δ) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) (s : TyShape) (G0 : (q : Y) → El a (h q) → Sem s) →
  RenR k-nf j-ty (ext-h Δ' a Y h (wact Δ' Δ w Y M)) s
    (subM (ext-h Δ' a Y h (wact Δ' Δ w Y M)) (ext-h Δ a Y h M) (Sem s) (world-sub (ext-h Δ' a Y h (wact Δ' Δ w Y M)) (ext-h Δ a Y h M) (world-keep Δ' Δ a Y h M w)) (ext-lift Δ a Y h (Sem s) G0 M)) →
  RenR k-nf j-ty (ext-h Δ' a Y h (wact Δ' Δ w Y M)) s (ext-lift Δ' a Y h (Sem s) G0 (wact Δ' Δ w Y M))
rn-ext Δ' Δ w a Y h M s G0 Bn =
  (fst Bn ,
   nn-tr k-nf j-ty (ext-h Δ' a Y h (wact Δ' Δ w Y M)) s (fst Bn)
     (subM (ext-h Δ' a Y h (wact Δ' Δ w Y M)) (ext-h Δ a Y h M) (Sem s) (world-sub (ext-h Δ' a Y h (wact Δ' Δ w Y M)) (ext-h Δ a Y h M) (world-keep Δ' Δ a Y h M w)) (ext-lift Δ a Y h (Sem s) G0 M))
     (ext-lift Δ' a Y h (Sem s) G0 (wact Δ' Δ w Y M)) (keep-lift Δ' Δ a Y h M w (Sem s) G0) (snd Bn))
nn-ty-pi : (Δ : CCtx) (a b : TyShape) (T : Mean Δ (Fam a b)) → RenR k-nf j-ty Δ a (fmapM Δ (Fam a b) (Sem a) (fam-dom a b) T) →
  RenR k-nf j-ty (ext-h Δ a (Fam a b) (fam-dom a b) T) b (fam-body Δ a b T) → RenR k-nf j-ty Δ (s-pi a b) T
nn-ty-pi Δ a b T A B = (cpi #2 (fst A) (fst B) , nty-pi Δ a b T (fst A) (fst B) (snd A) (snd B))
nn-ty-sig : (Δ : CCtx) (a b : TyShape) (T : Mean Δ (Fam a b)) → RenR k-nf j-ty Δ a (fmapM Δ (Fam a b) (Sem a) (fam-dom a b) T) →
  RenR k-nf j-ty (ext-h Δ a (Fam a b) (fam-dom a b) T) b (fam-body Δ a b T) → RenR k-nf j-ty Δ (s-sig a b) T
nn-ty-sig Δ a b T A B = (csigma (fst A) (fst B) , nty-sig Δ a b T (fst A) (fst B) (snd A) (snd B))
nn-ty-path : (Δ : CCtx) (a : TyShape) (T : Mean Δ (Sem (s-path a))) → RenR k-nf j-ty (dext Δ) a (path-line-ty Δ a T) →
  RenR k-nf j-tm Δ a (fmapM Δ (Sem (s-path a)) (TV a) (tend-0 a) T) → RenR k-nf j-tm Δ a (fmapM Δ (Sem (s-path a)) (TV a) (tend-1 a) T) → RenR k-nf j-ty Δ (s-path a) T
nn-ty-path Δ a T L N0 N1 = (cpathp (cplam (fst L)) (fst N0) (fst N1) , nty-path Δ a T (fst L) (fst N0) (fst N1) (snd L) (snd N0) (snd N1))
nn-lam : (Δ : CCtx) (a b : TyShape) (X : Mean Δ (TV (s-pi a b))) → RenR k-nf j-ty Δ a (fmapM Δ (TV (s-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) X) →
  RenR k-nf j-tm (lam-ctx Δ a b X) b (lam-body Δ a b X) → RenR k-nf j-tm Δ (s-pi a b) X
nn-lam Δ a b X A B = (clam (fst B) , nlam Δ a b X (fst A) (fst B) (snd A) (snd B))
nn-pair : (Δ : CCtx) (a b : TyShape) (R : Mean Δ (TV (s-sig a b))) → RenR k-nf j-ty (ext-h Δ a (TV (s-sig a b)) (λ q → fam-dom a b (fst q)) R) b (pair-cod Δ a b R) →
  RenR k-nf j-tm Δ a (fmapM Δ (TV (s-sig a b)) (TV a) (sig-1 a b) R) → RenR k-nf j-tm Δ b (fmapM Δ (TV (s-sig a b)) (TV b) (sig-2 a b) R) → RenR k-nf j-tm Δ (s-sig a b) R
nn-pair Δ a b R B N1 N2 = (cpair (fst N1) (fst N2) , npair Δ a b R (fst B) (fst N1) (fst N2) (snd B) (snd N1) (snd N2))
nn-plam : (Δ : CCtx) (a : TyShape) (X : Mean Δ (TV (s-path a))) → RenR k-nf j-tm (dext Δ) a (plam-body Δ a X) → RenR k-nf j-tm Δ (s-path a) X
nn-plam Δ a X B = (cplam (fst B) , nplam Δ a X (fst B) (snd B))
rn-var : (Δ' Δ : CCtx) (w : World Δ' Δ) (v : VarP (fst Δ)) → RenR k-ne j-tm Δ' (var-shape (fst Δ) v) (wact Δ' Δ w (TV (var-shape (fst Δ) v)) (varCube Δ v))
rn-var Δ' Δ w v =
  (cvar (var-word (fst Δ') (fst (snd (snd (snd (snd w))) v))) ,
   comp (λ i → NN (k-ne , (j-tm , Δ' , fst (snd (snd (snd (snd (snd (snd w))) v)) i) , cvar (var-word (fst Δ') (fst (snd (snd (snd (snd w))) v))) ,
                           snd (snd (snd (snd (snd (snd (snd w))) v)) i))))
     (λ i → []) (nvar Δ' (fst (snd (snd (snd (snd w))) v))))
rn-app : (Δ' Δ : CCtx) (w : World Δ' Δ) (a b : TyShape) (R : Mean Δ (AppV a b)) →
  RenR k-ne j-tm Δ' (s-pi a b) (wact Δ' Δ w (TV (s-pi a b)) (fmapM Δ (AppV a b) (TV (s-pi a b)) (app-f a b) R)) →
  RenR k-nf j-tm Δ' a (wact Δ' Δ w (TV a) (fmapM Δ (AppV a b) (TV a) (app-a a b) R)) →
  RenR k-ne j-tm Δ' b (wact Δ' Δ w (TV b) (fmapM Δ (AppV a b) (TV b) (app-r a b) R))
rn-app Δ' Δ w a b R Fn An =
  (capp (fst Fn) (fst An) ,
   nn-fm-out k-ne j-tm Δ' Δ w (AppV a b) b (app-r a b) R (capp (fst Fn) (fst An))
     (napp Δ' a b (wact Δ' Δ w (AppV a b) R) (fst Fn) (fst An)
        (nn-fm-in k-ne j-tm Δ' Δ w (AppV a b) (s-pi a b) (app-f a b) R (fst Fn) (snd Fn)) (nn-fm-in k-nf j-tm Δ' Δ w (AppV a b) a (app-a a b) R (fst An) (snd An))))
rn-fst : (Δ' Δ : CCtx) (w : World Δ' Δ) (a b : TyShape) (R : Mean Δ (TV (s-sig a b))) →
  RenR k-ne j-tm Δ' (s-sig a b) (wact Δ' Δ w (TV (s-sig a b)) R) → RenR k-ne j-tm Δ' a (wact Δ' Δ w (TV a) (fmapM Δ (TV (s-sig a b)) (TV a) (sig-1 a b) R))
rn-fst Δ' Δ w a b R Pn =
  (cfst (fst Pn) , nn-fm-out k-ne j-tm Δ' Δ w (TV (s-sig a b)) a (sig-1 a b) R (cfst (fst Pn)) (nfst Δ' a b (wact Δ' Δ w (TV (s-sig a b)) R) (fst Pn) (snd Pn)))
rn-snd : (Δ' Δ : CCtx) (w : World Δ' Δ) (a b : TyShape) (R : Mean Δ (TV (s-sig a b))) →
  RenR k-ne j-tm Δ' (s-sig a b) (wact Δ' Δ w (TV (s-sig a b)) R) → RenR k-ne j-tm Δ' b (wact Δ' Δ w (TV b) (fmapM Δ (TV (s-sig a b)) (TV b) (sig-2 a b) R))
rn-snd Δ' Δ w a b R Pn =
  (csnd (fst Pn) , nn-fm-out k-ne j-tm Δ' Δ w (TV (s-sig a b)) b (sig-2 a b) R (csnd (fst Pn)) (nsnd Δ' a b (wact Δ' Δ w (TV (s-sig a b)) R) (fst Pn) (snd Pn)))
rn-case : (Δ' Δ : CCtx) (w : World Δ' Δ) (s : TyShape) (R : Mean Δ (CaseV s)) →
  RenR k-nf j-ty (ext-h Δ' s-bool (CaseV s) (case-b s) (wact Δ' Δ w (CaseV s) R)) s (case-mot Δ' s (wact Δ' Δ w (CaseV s) R)) →
  RenR k-ne j-tm Δ' s-bool (wact Δ' Δ w (TV s-bool) (fmapM Δ (CaseV s) (TV s-bool) (case-x s) R)) →
  RenR k-nf j-tm Δ' s (wact Δ' Δ w (TV s) (fmapM Δ (CaseV s) (TV s) (case-t s) R)) →
  RenR k-nf j-tm Δ' s (wact Δ' Δ w (TV s) (fmapM Δ (CaseV s) (TV s) (case-f s) R)) →
  RenR k-ne j-tm Δ' s (wact Δ' Δ w (TV s) (fmapM Δ (CaseV s) (TV s) (case-r s) R))
rn-case Δ' Δ w s R Pn Xn Tn Fn =
  (c-case (fst Pn) (fst Tn) (fst Fn) (fst Xn) ,
   nn-fm-out k-ne j-tm Δ' Δ w (CaseV s) s (case-r s) R (c-case (fst Pn) (fst Tn) (fst Fn) (fst Xn))
     (ncase Δ' s (wact Δ' Δ w (CaseV s) R) (fst Pn) (fst Xn) (fst Tn) (fst Fn) (snd Pn)
        (nn-fm-in k-ne j-tm Δ' Δ w (CaseV s) s-bool (case-x s) R (fst Xn) (snd Xn))
        (nn-fm-in k-nf j-tm Δ' Δ w (CaseV s) s (case-t s) R (fst Tn) (snd Tn))
        (nn-fm-in k-nf j-tm Δ' Δ w (CaseV s) s (case-f s) R (fst Fn) (snd Fn))))
rn-ne : (Δ' Δ : CCtx) (w : World Δ' Δ) (R : Mean Δ (TV s-bool)) → RenR k-ne j-tm Δ' s-bool (wact Δ' Δ w (TV s-bool) R) → RenR k-nf j-tm Δ' s-bool (wact Δ' Δ w (TV s-bool) R)
rn-ne Δ' Δ w R Xn = (fst Xn , nne Δ' (wact Δ' Δ w (TV s-bool) R) (fst Xn) (snd Xn))
rn-lam : (Δ' Δ : CCtx) (w : World Δ' Δ) (a b : TyShape) (X : Mean Δ (TV (s-pi a b))) →
  RenR k-nf j-ty Δ' a (wact Δ' Δ w (Sem a) (fmapM Δ (TV (s-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) X)) →
  RenR k-nf j-tm (lam-ctx Δ' a b (wact Δ' Δ w (TV (s-pi a b)) X)) b
    (subM (lam-ctx Δ' a b (wact Δ' Δ w (TV (s-pi a b)) X)) (lam-ctx Δ a b X) (TV b)
       (world-sub (lam-ctx Δ' a b (wact Δ' Δ w (TV (s-pi a b)) X)) (lam-ctx Δ a b X) (world-keep Δ' Δ a (TV (s-pi a b)) (λ q → fst (fst q)) X w)) (lam-body Δ a b X)) →
  RenR k-nf j-tm Δ' (s-pi a b) (wact Δ' Δ w (TV (s-pi a b)) X)
rn-lam Δ' Δ w a b X An Bn =
  nn-lam Δ' a b (wact Δ' Δ w (TV (s-pi a b)) X) (fst An , nn-fm-in k-nf j-ty Δ' Δ w (TV (s-pi a b)) a (λ q → fam-dom a b (fst q)) X (fst An) (snd An))
    (fst Bn ,
     nn-tr k-nf j-tm (lam-ctx Δ' a b (wact Δ' Δ w (TV (s-pi a b)) X)) b (fst Bn)
       (subM (lam-ctx Δ' a b (wact Δ' Δ w (TV (s-pi a b)) X)) (lam-ctx Δ a b X) (TV b)
          (world-sub (lam-ctx Δ' a b (wact Δ' Δ w (TV (s-pi a b)) X)) (lam-ctx Δ a b X) (world-keep Δ' Δ a (TV (s-pi a b)) (λ q → fst (fst q)) X w)) (lam-body Δ a b X))
       (lam-body Δ' a b (wact Δ' Δ w (TV (s-pi a b)) X)) (subM-lam-body Δ' Δ w a b X) (snd Bn))
rn-pair : (Δ' Δ : CCtx) (w : World Δ' Δ) (a b : TyShape) (R : Mean Δ (TV (s-sig a b))) →
  RenR k-nf j-ty (ext-h Δ' a (TV (s-sig a b)) (λ q → fam-dom a b (fst q)) (wact Δ' Δ w (TV (s-sig a b)) R)) b (pair-cod Δ' a b (wact Δ' Δ w (TV (s-sig a b)) R)) →
  RenR k-nf j-tm Δ' a (wact Δ' Δ w (TV a) (fmapM Δ (TV (s-sig a b)) (TV a) (sig-1 a b) R)) →
  RenR k-nf j-tm Δ' b (wact Δ' Δ w (TV b) (fmapM Δ (TV (s-sig a b)) (TV b) (sig-2 a b) R)) →
  RenR k-nf j-tm Δ' (s-sig a b) (wact Δ' Δ w (TV (s-sig a b)) R)
rn-pair Δ' Δ w a b R Bn N1 N2 =
  nn-pair Δ' a b (wact Δ' Δ w (TV (s-sig a b)) R) Bn
    (fst N1 , nn-fm-in k-nf j-tm Δ' Δ w (TV (s-sig a b)) a (sig-1 a b) R (fst N1) (snd N1)) (fst N2 , nn-fm-in k-nf j-tm Δ' Δ w (TV (s-sig a b)) b (sig-2 a b) R (fst N2) (snd N2))
rn-plam : (Δ' Δ : CCtx) (w : World Δ' Δ) (a : TyShape) (X : Mean Δ (TV (s-path a))) →
  RenR k-nf j-tm (dext Δ') a (subM (dext Δ') (dext Δ) (TV a) (world-sub (dext Δ') (dext Δ) (world-dkeep Δ' Δ w)) (plam-body Δ a X)) →
  RenR k-nf j-tm Δ' (s-path a) (wact Δ' Δ w (TV (s-path a)) X)
rn-plam Δ' Δ w a X Bn =
  nn-plam Δ' a (wact Δ' Δ w (TV (s-path a)) X)
    (fst Bn , nn-tr k-nf j-tm (dext Δ') a (fst Bn) (subM (dext Δ') (dext Δ) (TV a) (world-sub (dext Δ') (dext Δ) (world-dkeep Δ' Δ w)) (plam-body Δ a X))
       (plam-body Δ' a (wact Δ' Δ w (TV (s-path a)) X)) (subM-plam-body Δ' Δ w a X) (snd Bn))
rn-papp : (Δ' Δ : CCtx) (w : World Δ' Δ) (a : TyShape) (P : Mean Δ (TV (s-path a))) (f : DNF) → isTrue (dnf-canon f) → isTrue (dnf-nonconst f) →
  (Y : Mean Δ (TV a)) → PathM Δ (TV a) (papp-mean Δ a f P) Y →
  RenR k-ne j-tm Δ' (s-path a) (wact Δ' Δ w (TV (s-path a)) P) → RenR k-ne j-tm Δ' a (wact Δ' Δ w (TV a) Y)
rn-papp Δ' Δ w a P f cf nc Y q Pn =
  (cpapp (fst Pn) (dnf-code (dnf-r (fst w) f)) ,
   npapp Δ' a (wact Δ' Δ w (TV (s-path a)) P) (fst Pn) (dnf-r (fst w) f) (canon-r (fst w) (fst (snd w)) f cf) (nonconst-r (fst w) f nc)
     (wact Δ' Δ w (TV a) Y)
     (pcat (Mean Δ' (TV a)) (papp-mean Δ' a (dnf-r (fst w) f) (wact Δ' Δ w (TV (s-path a)) P)) (wact Δ' Δ w (TV a) (papp-mean Δ a f P)) (wact Δ' Δ w (TV a) Y)
        (subM-papp Δ' Δ w a f P) (λ i → wact Δ' Δ w (TV a) (q i)))
     (snd Pn))
rn-ty-pi : (Δ' Δ : CCtx) (w : World Δ' Δ) (a b : TyShape) (T : Mean Δ (Fam a b)) →
  RenR k-nf j-ty Δ' a (wact Δ' Δ w (Sem a) (fmapM Δ (Fam a b) (Sem a) (fam-dom a b) T)) →
  RenR k-nf j-ty (ext-h Δ' a (Fam a b) (fam-dom a b) (wact Δ' Δ w (Fam a b) T)) b (fam-body Δ' a b (wact Δ' Δ w (Fam a b) T)) →
  RenR k-nf j-ty Δ' (s-pi a b) (wact Δ' Δ w (Fam a b) T)
rn-ty-pi Δ' Δ w a b T An Bn = nn-ty-pi Δ' a b (wact Δ' Δ w (Fam a b) T) (fst An , nn-fm-in k-nf j-ty Δ' Δ w (Fam a b) a (fam-dom a b) T (fst An) (snd An)) Bn
rn-ty-sig : (Δ' Δ : CCtx) (w : World Δ' Δ) (a b : TyShape) (T : Mean Δ (Fam a b)) →
  RenR k-nf j-ty Δ' a (wact Δ' Δ w (Sem a) (fmapM Δ (Fam a b) (Sem a) (fam-dom a b) T)) →
  RenR k-nf j-ty (ext-h Δ' a (Fam a b) (fam-dom a b) (wact Δ' Δ w (Fam a b) T)) b (fam-body Δ' a b (wact Δ' Δ w (Fam a b) T)) →
  RenR k-nf j-ty Δ' (s-sig a b) (wact Δ' Δ w (Fam a b) T)
rn-ty-sig Δ' Δ w a b T An Bn = nn-ty-sig Δ' a b (wact Δ' Δ w (Fam a b) T) (fst An , nn-fm-in k-nf j-ty Δ' Δ w (Fam a b) a (fam-dom a b) T (fst An) (snd An)) Bn
rn-ty-path : (Δ' Δ : CCtx) (w : World Δ' Δ) (a : TyShape) (T : Mean Δ (Sem (s-path a))) →
  RenR k-nf j-ty (dext Δ') a (subM (dext Δ') (dext Δ) (Sem a) (world-sub (dext Δ') (dext Δ) (world-dkeep Δ' Δ w)) (path-line-ty Δ a T)) →
  RenR k-nf j-tm Δ' a (wact Δ' Δ w (TV a) (fmapM Δ (Sem (s-path a)) (TV a) (tend-0 a) T)) →
  RenR k-nf j-tm Δ' a (wact Δ' Δ w (TV a) (fmapM Δ (Sem (s-path a)) (TV a) (tend-1 a) T)) →
  RenR k-nf j-ty Δ' (s-path a) (wact Δ' Δ w (Sem (s-path a)) T)
rn-ty-path Δ' Δ w a T Ln N0 N1 =
  nn-ty-path Δ' a (wact Δ' Δ w (Sem (s-path a)) T)
    (fst Ln , nn-tr k-nf j-ty (dext Δ') a (fst Ln) (subM (dext Δ') (dext Δ) (Sem a) (world-sub (dext Δ') (dext Δ) (world-dkeep Δ' Δ w)) (path-line-ty Δ a T))
       (path-line-ty Δ' a (wact Δ' Δ w (Sem (s-path a)) T)) (dkeep-line Δ' Δ w (Sem (s-path a)) (Sem a) (ty-line a) T) (snd Ln))
    (fst N0 , nn-fm-in k-nf j-tm Δ' Δ w (Sem (s-path a)) a (tend-0 a) T (fst N0) (snd N0))
    (fst N1 , nn-fm-in k-nf j-tm Δ' Δ w (Sem (s-path a)) a (tend-1 a) T (fst N1) (snd N1))
ren-nn : {KJ : NK × Jdg} → NN KJ → (Δ' : CCtx) (w : World Δ' (fst (snd (snd KJ)))) →
  RenR (fst KJ) (fst (snd KJ)) Δ' (fst (snd (snd (snd KJ))))
    (wact Δ' (fst (snd (snd KJ))) w (JZ (fst (snd KJ)) (fst (snd (snd (snd KJ))))) (snd (snd (snd (snd (snd KJ))))))
ren-nn (nvar Γ v) Δ' w = rn-var Δ' Γ w v
ren-nn (napp Γ a b R f c nf na) Δ' w = rn-app Δ' Γ w a b R (ren-nn nf Δ' w) (ren-nn na Δ' w)
ren-nn (nfst Γ a b R p np) Δ' w = rn-fst Δ' Γ w a b R (ren-nn np Δ' w)
ren-nn (nsnd Γ a b R p np) Δ' w = rn-snd Δ' Γ w a b R (ren-nn np Δ' w)
ren-nn (ncase Γ s R cP x t f nP nx nt nf) Δ' w =
  rn-case Δ' Γ w s R
    (rn-ext Δ' Γ w s-bool (CaseV s) (case-b s) R s (λ q b → fst (snd q) b)
       (ren-nn nP (ext-h Δ' s-bool (CaseV s) (case-b s) (wact Δ' Γ w (CaseV s) R)) (world-keep Δ' Γ s-bool (CaseV s) (case-b s) R w)))
    (ren-nn nx Δ' w) (ren-nn nt Δ' w) (ren-nn nf Δ' w)
ren-nn (nne Γ R x nx) Δ' w = rn-ne Δ' Γ w R (ren-nn nx Δ' w)
ren-nn (ntrue Γ B) Δ' w = (c-true , nn-fm-out k-nf j-tm Δ' Γ w One1 s-bool (bool-v true) B c-true (ntrue Δ' (wact Δ' Γ w One1 B)))
ren-nn (nfalse Γ B) Δ' w = (c-false , nn-fm-out k-nf j-tm Δ' Γ w One1 s-bool (bool-v false) B c-false (nfalse Δ' (wact Δ' Γ w One1 B)))
ren-nn (nlam Γ a b X cA c nA nb) Δ' w =
  rn-lam Δ' Γ w a b X (ren-nn nA Δ' w) (ren-nn nb (lam-ctx Δ' a b (wact Δ' Γ w (TV (s-pi a b)) X)) (world-keep Δ' Γ a (TV (s-pi a b)) (λ q → fst (fst q)) X w))
ren-nn (npair Γ a b R cB c1 c2 nB n1 n2) Δ' w =
  rn-pair Δ' Γ w a b R
    (rn-ext Δ' Γ w a (TV (s-sig a b)) (λ q → fam-dom a b (fst q)) R b (λ q x → snd (fst q) x)
       (ren-nn nB (ext-h Δ' a (TV (s-sig a b)) (λ q → fam-dom a b (fst q)) (wact Δ' Γ w (TV (s-sig a b)) R)) (world-keep Δ' Γ a (TV (s-sig a b)) (λ q → fam-dom a b (fst q)) R w)))
    (ren-nn n1 Δ' w) (ren-nn n2 Δ' w)
ren-nn (nplam Γ a X c nb) Δ' w = rn-plam Δ' Γ w a X (ren-nn nb (dext Δ') (world-dkeep Δ' Γ w))
ren-nn (npapp Γ a P p f cf nc Y q np) Δ' w = rn-papp Δ' Γ w a P f cf nc Y q (ren-nn np Δ' w)
ren-nn (nty-bool Γ B) Δ' w = (c-bool , nty-bool Δ' (wact Δ' Γ w One1 B))
ren-nn (nty-pi Γ a b T cA cB nA nB) Δ' w =
  rn-ty-pi Δ' Γ w a b T (ren-nn nA Δ' w)
    (rn-ext Δ' Γ w a (Fam a b) (fam-dom a b) T b (λ F x → snd F x)
       (ren-nn nB (ext-h Δ' a (Fam a b) (fam-dom a b) (wact Δ' Γ w (Fam a b) T)) (world-keep Δ' Γ a (Fam a b) (fam-dom a b) T w)))
ren-nn (nty-sig Γ a b T cA cB nA nB) Δ' w =
  rn-ty-sig Δ' Γ w a b T (ren-nn nA Δ' w)
    (rn-ext Δ' Γ w a (Fam a b) (fam-dom a b) T b (λ F x → snd F x)
       (ren-nn nB (ext-h Δ' a (Fam a b) (fam-dom a b) (wact Δ' Γ w (Fam a b) T)) (world-keep Δ' Γ a (Fam a b) (fam-dom a b) T w)))
ren-nn (nty-path Γ a T cL c0 c1 nL n0 n1) Δ' w =
  rn-ty-path Δ' Γ w a T (ren-nn nL (dext Δ') (world-dkeep Δ' Γ w)) (ren-nn n0 Δ' w) (ren-nn n1 Δ' w)
der-tr : (jk : JK) (Γ : CCtx) (s : TyShape) (c : Code) (M N : Mean Γ (JZ jk s)) → PathM Γ (JZ jk s) M N → Der (jk , Γ , s , c , M) → Der (jk , Γ , s , c , N)
der-tr jk Γ s c M N p x = comp (λ i → Der (jk , Γ , s , c , p i)) (λ i → []) x
FamV : TyShape → TyShape → Type 1
FamV a b = (fvT : Fam a b) × El a (fst fvT)
fam-arg : (a b : TyShape) → FamV a b → TV a
fam-arg a b q = (fst (fst q) , snd q)
fam-cod : (a b : TyShape) → FamV a b → Sem b
fam-cod a b q = snd (fst q) (snd q)
CompU : TyShape → Type 2
CompU s = ((cuΔ : CCtx) → Mean cuΔ (Sem s) → Type 1) × ((cuΔ : CCtx) → Mean cuΔ (TV s) → Type 1)
CSof : (s : TyShape) → CompU s → (Δ : CCtx) → Mean Δ (TV s) → Type 1
CSof s U Δ X = fst U Δ (fmapM Δ (TV s) (Sem s) (λ q → fst q) X) × snd U Δ X
CompE : (s : TyShape) → CompU s
CompE s-bool =
  ((λ Δ T → One1) ,
   λ Δ X → Sum1 ((B : Mean Δ One1) × PathM Δ (TV s-bool) X (fmapM Δ One1 (TV s-bool) (bool-v true) B))
             (Sum1 ((B : Mean Δ One1) × PathM Δ (TV s-bool) X (fmapM Δ One1 (TV s-bool) (bool-v false) B))
                ((c : Code) × NN (k-ne , (j-tm , Δ , s-bool , c , X)))))
CompE (s-pi a b) =
  ((λ Δ T → fst (CompE a) Δ (fmapM Δ (Fam a b) (Sem a) (λ F → fst F) T) ×
            ((Δ' : CCtx) (w : World Δ' Δ) (Y : Mean Δ' (FamV a b)) →
             PathM Δ' (Fam a b) (fmapM Δ' (FamV a b) (Fam a b) (λ q → fst q) Y) (wact Δ' Δ w (Fam a b) T) →
             CSof a (CompE a) Δ' (fmapM Δ' (FamV a b) (TV a) (fam-arg a b) Y) → fst (CompE b) Δ' (fmapM Δ' (FamV a b) (Sem b) (fam-cod a b) Y))) ,
   λ Δ X → (Δ' : CCtx) (w : World Δ' Δ) (Y : Mean Δ' (AppV a b)) →
     PathM Δ' (TV (s-pi a b)) (fmapM Δ' (AppV a b) (TV (s-pi a b)) (app-f a b) Y) (wact Δ' Δ w (TV (s-pi a b)) X) →
     CSof a (CompE a) Δ' (fmapM Δ' (AppV a b) (TV a) (app-a a b) Y) → CSof b (CompE b) Δ' (fmapM Δ' (AppV a b) (TV b) (app-r a b) Y))
CompE (s-sig a b) =
  ((λ Δ T → fst (CompE a) Δ (fmapM Δ (Fam a b) (Sem a) (λ F → fst F) T) ×
            ((Δ' : CCtx) (w : World Δ' Δ) (Y : Mean Δ' (FamV a b)) →
             PathM Δ' (Fam a b) (fmapM Δ' (FamV a b) (Fam a b) (λ q → fst q) Y) (wact Δ' Δ w (Fam a b) T) →
             CSof a (CompE a) Δ' (fmapM Δ' (FamV a b) (TV a) (fam-arg a b) Y) → fst (CompE b) Δ' (fmapM Δ' (FamV a b) (Sem b) (fam-cod a b) Y))) ,
   λ Δ X → CSof a (CompE a) Δ (fmapM Δ (TV (s-sig a b)) (TV a) (sig-1 a b) X) × CSof b (CompE b) Δ (fmapM Δ (TV (s-sig a b)) (TV b) (sig-2 a b) X))
CompE (s-path a) =
  ((λ Δ T → ((Δ' : CCtx) (w : World Δ' Δ) (f : DNF) → isTrue (dnf-canon f) → isTrue (dnf-nonconst f) →
             fst (CompE a) Δ' (papp-line Δ' (Sem (s-path a)) (Sem a) (ty-line a) f (wact Δ' Δ w (Sem (s-path a)) T))) ×
            CSof a (CompE a) Δ (fmapM Δ (Sem (s-path a)) (TV a) (tend-0 a) T) × CSof a (CompE a) Δ (fmapM Δ (Sem (s-path a)) (TV a) (tend-1 a) T)) ,
   λ Δ X → (Δ' : CCtx) (w : World Δ' Δ) (f : DNF) → isTrue (dnf-canon f) → isTrue (dnf-nonconst f) →
     CSof a (CompE a) Δ' (papp-mean Δ' a f (wact Δ' Δ w (TV (s-path a)) X)))
CompTy : (s : TyShape) (Δ : CCtx) → Mean Δ (Sem s) → Type 1
CompTy s = fst (CompE s)
CompS : (s : TyShape) (Δ : CCtx) → Mean Δ (TV s) → Type 1
CompS s = CSof s (CompE s)
ty-tr : (s : TyShape) (Δ : CCtx) (M N : Mean Δ (Sem s)) → PathM Δ (Sem s) M N → CompTy s Δ M → CompTy s Δ N
ty-tr s Δ M N p c = comp (λ i → CompTy s Δ (p i)) (λ i → []) c
comp-tr : (s : TyShape) (Δ : CCtx) (M N : Mean Δ (TV s)) → PathM Δ (TV s) M N → CompS s Δ M → CompS s Δ N
comp-tr s Δ M N p c = comp (λ i → CompS s Δ (p i)) (λ i → []) c
comp-fm : (s : TyShape) (Δ' Δ : CCtx) (w : World Δ' Δ) (Z : Type 1) (h : Z → TV s) (M : Mean Δ Z) →
  CompS s Δ' (wact Δ' Δ w (TV s) (fmapM Δ Z (TV s) h M)) → CompS s Δ' (fmapM Δ' Z (TV s) h (wact Δ' Δ w Z M))
comp-fm s Δ' Δ w Z h M c =
  comp-tr s Δ' (wact Δ' Δ w (TV s) (fmapM Δ Z (TV s) h M)) (fmapM Δ' Z (TV s) h (wact Δ' Δ w Z M))
    (psym (Mean Δ' (TV s)) (fmapM Δ' Z (TV s) h (wact Δ' Δ w Z M)) (wact Δ' Δ w (TV s) (fmapM Δ Z (TV s) h M)) (subM-fmap Δ' Δ Z (TV s) h (world-sub Δ' Δ w) M)) c
ty-fm : (s : TyShape) (Δ' Δ : CCtx) (w : World Δ' Δ) (Z : Type 1) (h : Z → Sem s) (M : Mean Δ Z) →
  CompTy s Δ' (wact Δ' Δ w (Sem s) (fmapM Δ Z (Sem s) h M)) → CompTy s Δ' (fmapM Δ' Z (Sem s) h (wact Δ' Δ w Z M))
ty-fm s Δ' Δ w Z h M c =
  ty-tr s Δ' (wact Δ' Δ w (Sem s) (fmapM Δ Z (Sem s) h M)) (fmapM Δ' Z (Sem s) h (wact Δ' Δ w Z M))
    (psym (Mean Δ' (Sem s)) (fmapM Δ' Z (Sem s) h (wact Δ' Δ w Z M)) (wact Δ' Δ w (Sem s) (fmapM Δ Z (Sem s) h M)) (subM-fmap Δ' Δ Z (Sem s) h (world-sub Δ' Δ w) M)) c
wc-tr : (Δ2 Δ' Δ : CCtx) (w2 : World Δ2 Δ') (w : World Δ' Δ) (Z : Type 1) (M : Mean Δ Z) (Y : Mean Δ2 Z) →
  PathM Δ2 Z Y (wact Δ2 Δ' w2 Z (wact Δ' Δ w Z M)) → PathM Δ2 Z Y (wact Δ2 Δ (world-comp Δ2 Δ' Δ w2 w) Z M)
wc-tr Δ2 Δ' Δ w2 w Z M Y q =
  pcat (Mean Δ2 Z) Y (wact Δ2 Δ' w2 Z (wact Δ' Δ w Z M)) (wact Δ2 Δ (world-comp Δ2 Δ' Δ w2 w) Z M) q
    (psym (Mean Δ2 Z) (wact Δ2 Δ (world-comp Δ2 Δ' Δ w2 w) Z M) (wact Δ2 Δ' w2 Z (wact Δ' Δ w Z M)) (subM-comp Δ2 Δ' Δ w2 w Z M))
CRenT : TyShape → Type 1
CRenT s = ((Δ : CCtx) (T : Mean Δ (Sem s)) → CompTy s Δ T → (Δ' : CCtx) (w : World Δ' Δ) → CompTy s Δ' (wact Δ' Δ w (Sem s) T)) ×
  ((Δ : CCtx) (X : Mean Δ (TV s)) → snd (CompE s) Δ X → (Δ' : CCtx) (w : World Δ' Δ) → snd (CompE s) Δ' (wact Δ' Δ w (TV s) X))
csof-ren : (s : TyShape) → CRenT s → (Δ : CCtx) (X : Mean Δ (TV s)) → CompS s Δ X → (Δ' : CCtx) (w : World Δ' Δ) → CompS s Δ' (wact Δ' Δ w (TV s) X)
csof-ren s R Δ X c Δ' w =
  (ty-fm s Δ' Δ w (TV s) (λ q → fst q) X (fst R Δ (fmapM Δ (TV s) (Sem s) (λ q → fst q) X) (fst c) Δ' w) , snd R Δ X (snd c) Δ' w)
fam-ren : (a b : TyShape) → CRenT a → (Δ : CCtx) (T : Mean Δ (Fam a b)) → fst (CompE (s-pi a b)) Δ T → (Δ' : CCtx) (w : World Δ' Δ) →
  fst (CompE (s-pi a b)) Δ' (wact Δ' Δ w (Fam a b) T)
fam-ren a b Ra Δ T ct Δ' w =
  (ty-fm a Δ' Δ w (Fam a b) (λ F → fst F) T (fst Ra Δ (fmapM Δ (Fam a b) (Sem a) (λ F → fst F) T) (fst ct) Δ' w) ,
   λ Δ2 w2 Y q ca → snd ct Δ2 (world-comp Δ2 Δ' Δ w2 w) Y (wc-tr Δ2 Δ' Δ w2 w (Fam a b) T (fmapM Δ2 (FamV a b) (Fam a b) (λ q → fst q) Y) q) ca)
bool-ren : (Δ : CCtx) (X : Mean Δ (TV s-bool)) → snd (CompE s-bool) Δ X → (Δ' : CCtx) (w : World Δ' Δ) → snd (CompE s-bool) Δ' (wact Δ' Δ w (TV s-bool) X)
bool-ren Δ X (inl1 p) Δ' w =
  inl1 (wact Δ' Δ w One1 (fst p) ,
        pcat (Mean Δ' (TV s-bool)) (wact Δ' Δ w (TV s-bool) X) (wact Δ' Δ w (TV s-bool) (fmapM Δ One1 (TV s-bool) (bool-v true) (fst p)))
          (fmapM Δ' One1 (TV s-bool) (bool-v true) (wact Δ' Δ w One1 (fst p)))
          (λ i → wact Δ' Δ w (TV s-bool) (snd p i))
          (psym (Mean Δ' (TV s-bool)) (fmapM Δ' One1 (TV s-bool) (bool-v true) (wact Δ' Δ w One1 (fst p))) (wact Δ' Δ w (TV s-bool) (fmapM Δ One1 (TV s-bool) (bool-v true) (fst p)))
             (subM-fmap Δ' Δ One1 (TV s-bool) (bool-v true) (world-sub Δ' Δ w) (fst p))))
bool-ren Δ X (inr1 (inl1 p)) Δ' w =
  inr1 (inl1 (wact Δ' Δ w One1 (fst p) ,
        pcat (Mean Δ' (TV s-bool)) (wact Δ' Δ w (TV s-bool) X) (wact Δ' Δ w (TV s-bool) (fmapM Δ One1 (TV s-bool) (bool-v false) (fst p)))
          (fmapM Δ' One1 (TV s-bool) (bool-v false) (wact Δ' Δ w One1 (fst p)))
          (λ i → wact Δ' Δ w (TV s-bool) (snd p i))
          (psym (Mean Δ' (TV s-bool)) (fmapM Δ' One1 (TV s-bool) (bool-v false) (wact Δ' Δ w One1 (fst p))) (wact Δ' Δ w (TV s-bool) (fmapM Δ One1 (TV s-bool) (bool-v false) (fst p)))
             (subM-fmap Δ' Δ One1 (TV s-bool) (bool-v false) (world-sub Δ' Δ w) (fst p)))))
bool-ren Δ X (inr1 (inr1 n)) Δ' w = inr1 (inr1 (ren-nn (snd n) Δ' w))
path-ty-ren : (a : TyShape) → CRenT a → (Δ : CCtx) (T : Mean Δ (Sem (s-path a))) → CompTy (s-path a) Δ T → (Δ' : CCtx) (w : World Δ' Δ) →
  CompTy (s-path a) Δ' (wact Δ' Δ w (Sem (s-path a)) T)
path-ty-ren a Ra Δ T ct Δ' w =
  ((λ Δ2 w2 f cf nc →
      ty-tr a Δ2 (papp-line Δ2 (Sem (s-path a)) (Sem a) (ty-line a) f (wact Δ2 Δ (world-comp Δ2 Δ' Δ w2 w) (Sem (s-path a)) T))
        (papp-line Δ2 (Sem (s-path a)) (Sem a) (ty-line a) f (wact Δ2 Δ' w2 (Sem (s-path a)) (wact Δ' Δ w (Sem (s-path a)) T)))
        (λ i → papp-line Δ2 (Sem (s-path a)) (Sem a) (ty-line a) f (subM-comp Δ2 Δ' Δ w2 w (Sem (s-path a)) T i))
        (fst ct Δ2 (world-comp Δ2 Δ' Δ w2 w) f cf nc)) ,
   comp-fm a Δ' Δ w (Sem (s-path a)) (tend-0 a) T (csof-ren a Ra Δ (fmapM Δ (Sem (s-path a)) (TV a) (tend-0 a) T) (fst (snd ct)) Δ' w) ,
   comp-fm a Δ' Δ w (Sem (s-path a)) (tend-1 a) T (csof-ren a Ra Δ (fmapM Δ (Sem (s-path a)) (TV a) (tend-1 a) T) (snd (snd ct)) Δ' w))
comp-ren-e : (s : TyShape) → CRenT s
comp-ren-e s-bool = ((λ Δ T ct Δ' w → one) , bool-ren)
comp-ren-e (s-pi a b) =
  (fam-ren a b (comp-ren-e a) ,
   λ Δ X cx Δ' w Δ2 w2 Y q ca → cx Δ2 (world-comp Δ2 Δ' Δ w2 w) Y (wc-tr Δ2 Δ' Δ w2 w (TV (s-pi a b)) X (fmapM Δ2 (AppV a b) (TV (s-pi a b)) (app-f a b) Y) q) ca)
comp-ren-e (s-sig a b) =
  (fam-ren a b (comp-ren-e a) ,
   λ Δ X cx Δ' w →
     (comp-fm a Δ' Δ w (TV (s-sig a b)) (sig-1 a b) X (csof-ren a (comp-ren-e a) Δ (fmapM Δ (TV (s-sig a b)) (TV a) (sig-1 a b) X) (fst cx) Δ' w) ,
      comp-fm b Δ' Δ w (TV (s-sig a b)) (sig-2 a b) X (csof-ren b (comp-ren-e b) Δ (fmapM Δ (TV (s-sig a b)) (TV b) (sig-2 a b) X) (snd cx) Δ' w)))
comp-ren-e (s-path a) =
  (path-ty-ren a (comp-ren-e a) ,
   λ Δ X cx Δ' w Δ2 w2 f cf nc →
     comp-tr a Δ2 (papp-mean Δ2 a f (wact Δ2 Δ (world-comp Δ2 Δ' Δ w2 w) (TV (s-path a)) X)) (papp-mean Δ2 a f (wact Δ2 Δ' w2 (TV (s-path a)) (wact Δ' Δ w (TV (s-path a)) X)))
       (λ i → papp-mean Δ2 a f (subM-comp Δ2 Δ' Δ w2 w (TV (s-path a)) X i))
       (cx Δ2 (world-comp Δ2 Δ' Δ w2 w) f cf nc))
comp-ren : (s : TyShape) (Δ : CCtx) (X : Mean Δ (TV s)) → CompS s Δ X → (Δ' : CCtx) (w : World Δ' Δ) → CompS s Δ' (wact Δ' Δ w (TV s) X)
comp-ren s = csof-ren s (comp-ren-e s)
