       (λ e → sub-pull Γ Γ Z (fst (snd (sub-id Γ))) e) (sub-carried Γ Γ Z (sub-id Γ) N)
       (idc-car (dims (fst Γ)) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd Γ) N)
       (carry-uniq (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z)
          (cmap-cube (fst Γ) (fst Γ) (cmap-of (fst Γ) (fst Γ) (λ k → k)) (CtxV (fst Γ)) (snd Γ))
          (sub-base Γ Γ (fst (snd (sub-id Γ)))) (snd (snd (sub-id Γ)))
          (cmap-d (fst Γ) (fst Γ) (cmap-of (fst Γ) (fst Γ) (λ k → k)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) N)
          (idc-car (dims (fst Γ)) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd Γ) N)
          (pcat-d (Cube (dims (fst Γ)) (CtxV (fst Γ))) (DCube (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z))
             (cmap-cube (fst Γ) (fst Γ) (cmap-of (fst Γ) (fst Γ) (λ k → k)) (CtxV (fst Γ)) (snd Γ)) (snd Γ) (sub-base Γ Γ (fst (snd (sub-id Γ))))
             (cmap-id (fst Γ) (CtxV (fst Γ)) (snd Γ))
             (psym (Cube (dims (fst Γ)) (CtxV (fst Γ))) (sub-base Γ Γ (fst (snd (sub-id Γ)))) (snd Γ)
                (pcat (Cube (dims (fst Γ)) (CtxV (fst Γ))) (sub-base Γ Γ (fst (snd (sub-id Γ)))) (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (fst Γ)) (λ x → x) (snd Γ)) (snd Γ)
                   (dcube-map-of (dims (fst Γ)) (CtxV (fst Γ)) (SubF (fst Γ) (fst Γ)) (CtxV (fst Γ)) (λ γ' p → fst p) (λ γ → (γ , λ ρ → ρ)) (snd Γ))
                   (cube-id (dims (fst Γ)) (CtxV (fst Γ)) (snd Γ))))
             (cmap-d (fst Γ) (fst Γ) (cmap-of (fst Γ) (fst Γ) (λ k → k)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) N) N
             (idc-car (dims (fst Γ)) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd Γ) N)
             (cmap-id-d (fst Γ) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) N)
             (idc-D (dims (fst Γ)) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd Γ) N))))
    (idc-pull (dims (fst Γ)) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd Γ) N)
world-id : (Γ : CCtx) → World Γ Γ
world-id Γ =
  (λ k → k , mono-id , (λ k i → isdim (fst Γ) k) , snd (sub-id Γ) ,
   λ v → (v , (λ i → var-word (fst Γ) v) ,
          λ i → (var-shape (fst Γ) v ,
                 psym (Mean Γ (TV (var-shape (fst Γ) v)))
                   (subM Γ Γ (TV (var-shape (fst Γ) v)) (sub-id Γ) (varCube Γ v)) (varCube Γ v)
                   (pcat (Mean Γ (TV (var-shape (fst Γ) v)))
                      (subM Γ Γ (TV (var-shape (fst Γ) v)) (sub-id Γ) (varCube Γ v))
                      (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (SubF (fst Γ) (fst Γ)) (FbE (fst Γ) (TV (var-shape (fst Γ) v)))
                         (λ γ' p ρ' → varM (fst Γ) v (fst p) (snd p ρ')) (snd Γ) (fst (snd (sub-id Γ))))
                      (varCube Γ v)
                      (subM-of Γ Γ (TV (var-shape (fst Γ) v)) (sub-id Γ) (varM (fst Γ) v))
                      (fmap-of (dims (fst Γ)) (CtxV (fst Γ)) (SubF (fst Γ) (fst Γ)) (FbE (fst Γ) (TV (var-shape (fst Γ) v)))
                         (λ γ → (γ , λ ρ → ρ)) (λ γ' p ρ' → varM (fst Γ) v (fst p) (snd p ρ')) (snd Γ)))
                   i)))
dnf-v0 : DNF
dnf-v0 = lcons (lcons (#0 , true) lnil) lnil
papp-dwk : (Γ : CCtx) (Y Z : Type 1) (ℓ : Y → Line Z) (X : Mean Γ Y) →
  PathM (dext Γ) Z (papp-line (dext Γ) Y Z ℓ dnf-v0 (dwkM Γ Y X)) (dline-body Γ Y Z ℓ X)
papp-dwk Γ Y Z ℓ X =
  pcat (Mean (dext Γ) Z) (papp-line (dext Γ) Y Z ℓ dnf-v0 (dwkM Γ Y X))
    (dcube-fmap (dims (fst Γ)) (Line (CtxV (fst Γ))) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Y)) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z))
       (λ L y → diag-o (CtxV (fst Γ)) (FbE (fst Γ) Z) (line-map (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) L)
          (lineo-fmap (CtxV (fst Γ)) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (fline (fst Γ) Y Z ℓ) L y))
       (snd (dext Γ)) (dwkM Γ Y X))
    (dline-body Γ Y Z ℓ X)
    (fmap-fmap (dims (fst Γ)) (Line (CtxV (fst Γ))) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Y)) (LineO (CtxV (fst Γ)) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z))) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z))
       (lineo-fmap (CtxV (fst Γ)) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (fline (fst Γ) Y Z ℓ))
       (λ L q → diag-o (CtxV (fst Γ)) (FbE (fst Γ) Z) (line-map (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) L) q) (snd (dext Γ)) (dwkM Γ Y X))
    (fmap-reidx (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (FbE (fst Γ) Y) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Y)) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z))
       (degen-l (CtxV (fst Γ))) (degen-o (CtxV (fst Γ)) (FbE (fst Γ) Y))
       (λ L y → diag-o (CtxV (fst Γ)) (FbE (fst Γ) Z) (line-map (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) L)
          (lineo-fmap (CtxV (fst Γ)) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (fline (fst Γ) Y Z ℓ) L y))
       (snd Γ) X)
dlf : (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x) (x : X) → DL X F x → DL X F' x
dlf X F F' h x q = lineo-fmap X F F' h (degen-l X x) q
fmap-sw : (n : Nat) (X : Type 1) (F1 G1 F2 G2 : X → Type 1) (k1 : (x : X) → F1 x → G1 x) (h : (x : X) → G1 x → G2 x)
  (h' : (x : X) → F1 x → F2 x) (k2 : (x : X) → F2 x → G2 x)
  (q : PathP (λ i → (xq : X) → F1 xq → G2 xq) (λ xq zq → h xq (k1 xq zq)) (λ xq zq → k2 xq (h' xq zq))) (c : Cube n X) (d : DCube n X F1 c) →
  PathP (λ i → DCube n X G2 c) (dcube-fmap n X G1 G2 h c (dcube-fmap n X F1 G1 k1 c d)) (dcube-fmap n X F2 G2 k2 c (dcube-fmap n X F1 F2 h' c d))
fmap-sw n X F1 G1 F2 G2 k1 h h' k2 q c d =
  pcat (DCube n X G2 c) (dcube-fmap n X G1 G2 h c (dcube-fmap n X F1 G1 k1 c d)) (dcube-fmap n X F1 G2 (λ x z → h x (k1 x z)) c d)
    (dcube-fmap n X F2 G2 k2 c (dcube-fmap n X F1 F2 h' c d))
    (fmap-fmap n X F1 G1 G2 k1 h c d)
    (pcat (DCube n X G2 c) (dcube-fmap n X F1 G2 (λ x z → h x (k1 x z)) c d) (dcube-fmap n X F1 G2 (λ x z → k2 x (h' x z)) c d)
       (dcube-fmap n X F2 G2 k2 c (dcube-fmap n X F1 F2 h' c d))
       (λ i → dcube-fmap n X F1 G2 (q i) c d)
       (psym (DCube n X G2 c) (dcube-fmap n X F2 G2 k2 c (dcube-fmap n X F1 F2 h' c d)) (dcube-fmap n X F1 G2 (λ x z → k2 x (h' x z)) c d) (fmap-fmap n X F1 F2 G2 h' k2 c d)))
DDFmap : (n : Nat) (op : (Z : Type 1) (H : Z → Type 1) (G : Cube n Z) → DCube n Z (DL Z H) G → DCube n Z H G)
  (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x) (c : Cube n X) (d : DCube n X (DL X F) c) → Type 1
DDFmap n op X F F' h c d =
  PathP (λ i → DCube n X F' c) (dcube-fmap n X F F' h c (op X F c d)) (op X F' c (dcube-fmap n X (DL X F) (DL X F') (dlf X F F' h) c d))
diag-dd-fmap : (sk : Lst Entry) (k : Word) (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x) (c : Cube (dims sk) X) (d : DCube (dims sk) X (DL X F) c) →
  DDFmap (dims sk) (λ Z H G q → diag-dd sk k Z H G q) X F F' h c d
diag-dd-fmap lnil k X F F' h c d = λ i → h c (fst d)
diag-dd-fmap (lcons (e-ty s) sk) k X F F' h c d =
  bool-elim1 (λ b → DDFmap (dims sk) (λ Z H G q → bool-elim1 (λ b' → DCube (dims sk) Z H G) (dcube-fmap (dims sk) Z (DL Z H) H (λ x q' → fst q') G q) (diag-dd sk (%wsub k #1) Z H G q) b) X F F' h c d)
    (fmap-sw (dims sk) X (DL X F) F (DL X F') F' (λ x q → fst q) h (dlf X F F' h) (λ x q → fst q) (λ i x q → h x (fst q)) c d)
    (diag-dd-fmap sk (%wsub k #1) X F F' h c d) (weq k #0)
diag-dd-fmap (lcons e-dim sk) k X F F' h c d =
  bool-elim1 (λ b → DDFmap (suc (dims sk)) (λ Z H G q → bool-elim1 (λ b' → DCube (dims sk) (Line Z) (LineO Z H) G)
                     (dcube-fmap (dims sk) (Line Z) (LineO Z (DL Z H)) (LineO Z H) (λ L q' → diag-o Z H (line-map Z (Line Z) (degen-l Z) L) q') G q)
                     (diag-dd sk (%wsub k #1) (Line Z) (LineO Z H) G
                        (dcube-fmap (dims sk) (Line Z) (LineO Z (DL Z H)) (DL (Line Z) (LineO Z H)) (λ L q' → exch-o Z H (line-map Z (Line Z) (degen-l Z) L) q') G q)) b)
                   X F F' h c d)
    (fmap-sw (dims sk) (Line X) (LineO X (DL X F)) (LineO X F) (LineO X (DL X F')) (LineO X F')
       (λ L q → diag-o X F (line-map X (Line X) (degen-l X) L) q) (lineo-fmap X F F' h) (lineo-fmap X (DL X F) (DL X F') (dlf X F F' h))
       (λ L q → diag-o X F' (line-map X (Line X) (degen-l X) L) q)
       (λ i L q → diag-o X F' (line-map X (Line X) (degen-l X) L) (lineo-fmap X (DL X F) (DL X F') (dlf X F F' h) L q)) c d)
    (pcat (DCube (dims sk) (Line X) (LineO X F') c)
       (dcube-fmap (dims sk) (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h) c
          (diag-dd sk (%wsub k #1) (Line X) (LineO X F) c
             (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) c d)))
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F') c
          (dcube-fmap (dims sk) (Line X) (DL (Line X) (LineO X F)) (DL (Line X) (LineO X F')) (dlf (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h)) c
             (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) c d)))
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F') c
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X F')) (DL (Line X) (LineO X F')) (λ L q → exch-o X F' (line-map X (Line X) (degen-l X) L) q) c
             (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (LineO X (DL X F')) (lineo-fmap X (DL X F) (DL X F') (dlf X F F' h)) c d)))
       (diag-dd-fmap sk (%wsub k #1) (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h) c
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) c d))
       (λ i → diag-dd sk (%wsub k #1) (Line X) (LineO X F') c
          (fmap-sw (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (LineO X (DL X F')) (DL (Line X) (LineO X F'))
             (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) (dlf (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h))
             (lineo-fmap X (DL X F) (DL X F') (dlf X F F' h)) (λ L q → exch-o X F' (line-map X (Line X) (degen-l X) L) q)
             (λ t L q → exch-o X F' (line-map X (Line X) (degen-l X) L) (lineo-fmap X (DL X F) (DL X F') (dlf X F F' h) L q)) c d i)))
    (weq k #0)
papp-ex-fmap : (sk : Lst Entry) (cd : IEx) (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x) (c : Cube (dims sk) X) (d : DCube (dims sk) X (DL X F) c) →
  DDFmap (dims sk) (λ Z H G q → papp-ex sk Z H cd G q) X F F' h c d
papp-ex-fmap sk ix1 X F F' h c d = fmap-sw (dims sk) X (DL X F) F (DL X F') F' (λ x q → fst (snd q)) h (dlf X F F' h) (λ x q → fst (snd q)) (λ i x q → h x (fst (snd q))) c d
