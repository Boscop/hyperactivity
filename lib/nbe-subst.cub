    (papp-ex sk X F' x c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c (dcube-fmap (dims sk) X (DL X F) (DL X F) (λ x q → rev-o X F (degen-l X x) q) c d)))
    (papp-ex sk X F' x c (dcube-fmap (dims sk) X (DL X F') (DL X F') (λ x q → rev-o X F' (degen-l X x) q) c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c d)))
