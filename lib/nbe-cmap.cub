    (papp-ex sk X F r c (dcube-pull (dims sk) X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g) c d (dcube-fmap (dims sk) X' (DL X' F') (DL X' F') (λ x q → rev-o X' F' (degen-l X' x) q) (dcube-map (dims sk) X Y X' f c d) e)))
    (dcube-pull (dims sk) X X' Y F F' f g c d (papp-ex sk X' F' r (dcube-map (dims sk) X Y X' f c d) (dcube-fmap (dims sk) X' (DL X' F') (DL X' F') (λ x q → rev-o X' F' (degen-l X' x) q) (dcube-map (dims sk) X Y X' f c d) e)))
    (cong1 (DCube (dims sk) X (DL X F) c) (DCube (dims sk) X F c) (λ w → papp-ex sk X F r c w) (dcube-fmap (dims sk) X (DL X F) (DL X F) (λ x q → rev-o X F (degen-l X x) q) c (dcube-pull (dims sk) X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g) c d e)) (dcube-pull (dims sk) X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g) c d (dcube-fmap (dims sk) X' (DL X' F') (DL X' F') (λ x q → rev-o X' F' (degen-l X' x) q) (dcube-map (dims sk) X Y X' f c d) e)) (pull-sw (dims sk) X X' Y (DL X F) (DL X F) (DL X' F') (DL X' F') f (pdl X X' Y F F' f g) (pdl X X' Y F F' f g) (λ x q → rev-o X F (degen-l X x) q) (λ x q → rev-o X' F' (degen-l X' x) q) (λ t x y z → rev-o X F (degen-l X x) (pdl X X' Y F F' f g x y z)) c d e))
    (papp-ex-pull sk r X X' Y F F' f g c d (dcube-fmap (dims sk) X' (DL X' F') (DL X' F') (λ x q → rev-o X' F' (degen-l X' x) q) (dcube-map (dims sk) X Y X' f c d) e))
papp-ex-pull sk (ixmeet r s) X X' Y F F' f g c d e =
  pcat (DCube (dims sk) X F c) (papp-ex sk X F r c (papp-ex sk X (DL X F) s c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c (dcube-pull (dims sk) X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g) c d e)))) (papp-ex sk X F r c (papp-ex sk X (DL X F) s c (dcube-pull (dims sk) X X' Y (DL X (DL X F)) (DL X' (DL X' F')) f (pdl X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g)) c d (dcube-fmap (dims sk) X' (DL X' F') (DL X' (DL X' F')) (λ x q → meet-o X' F' (degen-l X' x) q) (dcube-map (dims sk) X Y X' f c d) e)))) (dcube-pull (dims sk) X X' Y F F' f g c d (papp-ex sk X' F' r (dcube-map (dims sk) X Y X' f c d) (papp-ex sk X' (DL X' F') s (dcube-map (dims sk) X Y X' f c d) (dcube-fmap (dims sk) X' (DL X' F') (DL X' (DL X' F')) (λ x q → meet-o X' F' (degen-l X' x) q) (dcube-map (dims sk) X Y X' f c d) e))))
    (cong1 (DCube (dims sk) X (DL X (DL X F)) c) (DCube (dims sk) X F c) (λ w → papp-ex sk X F r c (papp-ex sk X (DL X F) s c w)) (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c (dcube-pull (dims sk) X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g) c d e)) (dcube-pull (dims sk) X X' Y (DL X (DL X F)) (DL X' (DL X' F')) f (pdl X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g)) c d (dcube-fmap (dims sk) X' (DL X' F') (DL X' (DL X' F')) (λ x q → meet-o X' F' (degen-l X' x) q) (dcube-map (dims sk) X Y X' f c d) e)) (pull-sw (dims sk) X X' Y (DL X F) (DL X (DL X F)) (DL X' F') (DL X' (DL X' F')) f (pdl X X' Y F F' f g) (pdl X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g)) (λ x q → meet-o X F (degen-l X x) q) (λ x q → meet-o X' F' (degen-l X' x) q) (λ t x y z → meet-o X F (degen-l X x) (pdl X X' Y F F' f g x y z)) c d e))
    (pcat (DCube (dims sk) X F c) (papp-ex sk X F r c (papp-ex sk X (DL X F) s c (dcube-pull (dims sk) X X' Y (DL X (DL X F)) (DL X' (DL X' F')) f (pdl X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g)) c d (dcube-fmap (dims sk) X' (DL X' F') (DL X' (DL X' F')) (λ x q → meet-o X' F' (degen-l X' x) q) (dcube-map (dims sk) X Y X' f c d) e)))) (papp-ex sk X F r c (dcube-pull (dims sk) X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g) c d (papp-ex sk X' (DL X' F') s (dcube-map (dims sk) X Y X' f c d) (dcube-fmap (dims sk) X' (DL X' F') (DL X' (DL X' F')) (λ x q → meet-o X' F' (degen-l X' x) q) (dcube-map (dims sk) X Y X' f c d) e)))) (dcube-pull (dims sk) X X' Y F F' f g c d (papp-ex sk X' F' r (dcube-map (dims sk) X Y X' f c d) (papp-ex sk X' (DL X' F') s (dcube-map (dims sk) X Y X' f c d) (dcube-fmap (dims sk) X' (DL X' F') (DL X' (DL X' F')) (λ x q → meet-o X' F' (degen-l X' x) q) (dcube-map (dims sk) X Y X' f c d) e))))
       (cong1 (DCube (dims sk) X (DL X F) c) (DCube (dims sk) X F c) (λ w → papp-ex sk X F r c w) (papp-ex sk X (DL X F) s c (dcube-pull (dims sk) X X' Y (DL X (DL X F)) (DL X' (DL X' F')) f (pdl X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g)) c d (dcube-fmap (dims sk) X' (DL X' F') (DL X' (DL X' F')) (λ x q → meet-o X' F' (degen-l X' x) q) (dcube-map (dims sk) X Y X' f c d) e))) (dcube-pull (dims sk) X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g) c d (papp-ex sk X' (DL X' F') s (dcube-map (dims sk) X Y X' f c d) (dcube-fmap (dims sk) X' (DL X' F') (DL X' (DL X' F')) (λ x q → meet-o X' F' (degen-l X' x) q) (dcube-map (dims sk) X Y X' f c d) e))) (papp-ex-pull sk s X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g) c d (dcube-fmap (dims sk) X' (DL X' F') (DL X' (DL X' F')) (λ x q → meet-o X' F' (degen-l X' x) q) (dcube-map (dims sk) X Y X' f c d) e)))
       (papp-ex-pull sk r X X' Y F F' f g c d (papp-ex sk X' (DL X' F') s (dcube-map (dims sk) X Y X' f c d) (dcube-fmap (dims sk) X' (DL X' F') (DL X' (DL X' F')) (λ x q → meet-o X' F' (degen-l X' x) q) (dcube-map (dims sk) X Y X' f c d) e)))
