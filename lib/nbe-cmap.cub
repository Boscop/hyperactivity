carry-uniq : (n : Nat) (X : Type 1) (F : X → Type 1) (c0 c1 : Cube n X) (p : PathP (λ i → Cube n X) c0 c1) (d : DCube n X F c0) (e : DCube n X F c1) →
  PathP (λ i → DCube n X F (p i)) d e → PathP (λ i → DCube n X F c1) (carry n X F c0 c1 p d) e
carry-uniq n X F c0 c1 p d e q = λ k → comp (λ i → DCube n X F (p i)) (λ i → [ k = 1 ↦ q i ]) d
pull-gen : (n : Nat) (X X' X1 X1' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (Y1 F1 : X1 → Type 1) (F1' : X1' → Type 1)
  (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x) (f1 : (x : X1) → Y1 x → X1') (g1 : (x : X1) (y : Y1 x) → F1' (f1 x y) → F1 x)
  (φ : X → X1) (φY : (x : X) → Y x → Y1 (φ x)) (φF : (x : X) → F x → F1 (φ x)) (φ' : X' → X1') (φF' : (x : X') → F' x → F1' (φ' x))
  (q : PathP (λ i → (xq : X) (yq : Y xq) → X1') (λ xq yq → φ' (f xq yq)) (λ xq yq → f1 (φ xq) (φY xq yq)))
  (qF : (x : X) (y : Y x) (e : F' (f x y)) (e1 : F1' (f1 (φ x) (φY x y))) → PathP (λ i → F1' (q i x y)) (φF' (f x y) e) e1 →
     PathP (λ i → F1 (φ x)) (φF x (g x y e)) (g1 (φ x) (φY x y) e1))
  (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' F' (dcube-map n X Y X' f c d))
  (E1 : DCube n X1' F1' (dcube-map n X1 Y1 X1' f1 (cube-map n X X1 φ c) (dcube-reidx n X X1 Y Y1 φ φY c d))) →
  PathP (λ i → DCube n X1' F1' (dmap-gen n X X1 Y Y1 X' X1' φ φY φ' f f1 q c d i)) (dcube-reidx n X' X1' F' F1' φ' φF' (dcube-map n X Y X' f c d) e) E1 →
  PathP (λ i → DCube n X1 F1 (cube-map n X X1 φ c)) (dcube-reidx n X X1 F F1 φ φF c (dcube-pull n X X' Y F F' f g c d e))
    (dcube-pull n X1 X1' Y1 F1 F1' f1 g1 (cube-map n X X1 φ c) (dcube-reidx n X X1 Y Y1 φ φY c d) E1)
pull-gen zero X X' X1 X1' Y F F' Y1 F1 F1' f g f1 g1 φ φY φF φ' φF' q qF c d e E1 P = qF c d e E1 P
pull-gen (suc n) X X' X1 X1' Y F F' Y1 F1 F1' f g f1 g1 φ φY φF φ' φF' q qF c d e E1 P =
  pull-gen n (Line X) (Line X') (Line X1) (Line X1') (LineO X Y) (LineO X F) (LineO X' F') (LineO X1 Y1) (LineO X1 F1) (LineO X1' F1')
    (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g) (lineo-map X1 Y1 X1' f1) (lineo-pull X1 X1' Y1 F1 F1' f1 g1)
    (line-map X X1 φ) (lineo-reidx X X1 Y Y1 φ φY) (lineo-reidx X X1 F F1 φ φF) (line-map X' X1' φ') (lineo-reidx X' X1' F' F1' φ' φF')
    (λ i L D → (q i (fst L) (fst D) , q i (fst (snd L)) (fst (snd D)) , λ j → q i (snd (snd L) j) (snd (snd D) j)))
    (λ L D E Ea Pa i →
       (qF (fst L) (fst D) (fst E) (fst Ea) (λ k → fst (Pa k)) i ,
        qF (fst (snd L)) (fst (snd D)) (fst (snd E)) (fst (snd Ea)) (λ k → fst (snd (Pa k))) i ,
        λ j → qF (snd (snd L) j) (snd (snd D) j) (snd (snd E) j) (snd (snd Ea) j) (λ k → snd (snd (Pa k)) j) i))
    c d e E1 P
pull-genc : (n : Nat) (X X' X1 X1' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (Y1 F1 : X1 → Type 1) (F1' : X1' → Type 1)
  (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x) (f1 : (x : X1) → Y1 x → X1') (g1 : (x : X1) (y : Y1 x) → F1' (f1 x y) → F1 x)
  (φ : X → X1) (φY : (x : X) → Y x → Y1 (φ x)) (φF : (x : X) → F x → F1 (φ x)) (φ' : X' → X1') (φF' : (x : X') → F' x → F1' (φ' x))
  (q : PathP (λ i → (xq : X) (yq : Y xq) → X1') (λ xq yq → φ' (f xq yq)) (λ xq yq → f1 (φ xq) (φY xq yq)))
  (qF : (x : X) (y : Y x) (e : F' (f x y)) (e1 : F1' (f1 (φ x) (φY x y))) → PathP (λ i → F1' (q i x y)) (φF' (f x y) e) e1 →
     PathP (λ i → F1 (φ x)) (φF x (g x y e)) (g1 (φ x) (φY x y) e1))
  (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' F' (dcube-map n X Y X' f c d)) →
  PathP (λ i → DCube n X1 F1 (cube-map n X X1 φ c)) (dcube-reidx n X X1 F F1 φ φF c (dcube-pull n X X' Y F F' f g c d e))
    (dcube-pull n X1 X1' Y1 F1 F1' f1 g1 (cube-map n X X1 φ c) (dcube-reidx n X X1 Y Y1 φ φY c d)
       (carry n X1' F1' (cube-map n X' X1' φ' (dcube-map n X Y X' f c d)) (dcube-map n X1 Y1 X1' f1 (cube-map n X X1 φ c) (dcube-reidx n X X1 Y Y1 φ φY c d))
          (dmap-gen n X X1 Y Y1 X' X1' φ φY φ' f f1 q c d) (dcube-reidx n X' X1' F' F1' φ' φF' (dcube-map n X Y X' f c d) e)))
pull-genc n X X' X1 X1' Y F F' Y1 F1 F1' f g f1 g1 φ φY φF φ' φF' q qF c d e =
  pull-gen n X X' X1 X1' Y F F' Y1 F1 F1' f g f1 g1 φ φY φF φ' φF' q qF c d e
    (carry n X1' F1' (cube-map n X' X1' φ' (dcube-map n X Y X' f c d)) (dcube-map n X1 Y1 X1' f1 (cube-map n X X1 φ c) (dcube-reidx n X X1 Y Y1 φ φY c d))
       (dmap-gen n X X1 Y Y1 X' X1' φ φY φ' f f1 q c d) (dcube-reidx n X' X1' F' F1' φ' φF' (dcube-map n X Y X' f c d) e))
    (carry-fill n X1' F1' (cube-map n X' X1' φ' (dcube-map n X Y X' f c d)) (dcube-map n X1 Y1 X1' f1 (cube-map n X X1 φ c) (dcube-reidx n X X1 Y Y1 φ φY c d))
       (dmap-gen n X X1 Y Y1 X' X1' φ φY φ' f f1 q c d) (dcube-reidx n X' X1' F' F1' φ' φF' (dcube-map n X Y X' f c d) e))
carry-pcat : (n : Nat) (X : Type 1) (F : X → Type 1) (c0 c1 c2 : Cube n X) (p : PathP (λ i → Cube n X) c0 c1) (q : PathP (λ i → Cube n X) c1 c2) (a : DCube n X F c0) →
  PathP (λ i → DCube n X F c2) (carry n X F c0 c2 (pcat (Cube n X) c0 c1 c2 p q) a) (carry n X F c1 c2 q (carry n X F c0 c1 p a))
carry-pcat n X F c0 c1 c2 p q a =
  carry-uniq n X F c0 c2 (pcat (Cube n X) c0 c1 c2 p q) a (carry n X F c1 c2 q (carry n X F c0 c1 p a))
    (pcat-d (Cube n X) (DCube n X F) c0 c1 c2 p q a (carry n X F c0 c1 p a) (carry n X F c1 c2 q (carry n X F c0 c1 p a))
       (carry-fill n X F c0 c1 p a) (carry-fill n X F c1 c2 q (carry n X F c0 c1 p a)))
carry-nat : (m n : Nat) (X X' : Type 1) (F : X → Type 1) (F' : X' → Type 1) (h : Cube m X → Cube n X') (hd : (c : Cube m X) → DCube m X F c → DCube n X' F' (h c))
  (c0 c1 : Cube m X) (p : PathP (λ i → Cube m X) c0 c1) (a : DCube m X F c0) →
  PathP (λ i → DCube n X' F' (h c1)) (carry n X' F' (h c0) (h c1) (λ i → h (p i)) (hd c0 a)) (hd c1 (carry m X F c0 c1 p a))
carry-nat m n X X' F F' h hd c0 c1 p a =
  carry-uniq n X' F' (h c0) (h c1) (λ i → h (p i)) (hd c0 a) (hd c1 (carry m X F c0 c1 p a)) (λ i → hd (p i) (carry-fill m X F c0 c1 p a i))
pdl : (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x) →
  (x : X) (y : Y x) → DL X' F' (f x y) → DL X F x
pdl X X' Y F F' f g x y = lineo-pull X X' Y F F' f g (degen-l X x) (degen-o X Y x y)
pull-sw : (n : Nat) (X X' : Type 1) (Y F1 F2 : X → Type 1) (F1' F2' : X' → Type 1) (f : (x : X) → Y x → X')
  (g1 : (x : X) (y : Y x) → F1' (f x y) → F1 x) (g2 : (x : X) (y : Y x) → F2' (f x y) → F2 x) (h : (x : X) → F1 x → F2 x) (h' : (x : X') → F1' x → F2' x)
  (q : PathP (λ i → (xq : X) (yq : Y xq) → F1' (f xq yq) → F2 xq) (λ xq yq zq → h xq (g1 xq yq zq)) (λ xq yq zq → g2 xq yq (h' (f xq yq) zq)))
  (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' F1' (dcube-map n X Y X' f c d)) →
  PathP (λ i → DCube n X F2 c) (dcube-fmap n X F1 F2 h c (dcube-pull n X X' Y F1 F1' f g1 c d e))
    (dcube-pull n X X' Y F2 F2' f g2 c d (dcube-fmap n X' F1' F2' h' (dcube-map n X Y X' f c d) e))
pull-sw n X X' Y F1 F2 F1' F2' f g1 g2 h h' q c d e =
  pcat (DCube n X F2 c) (dcube-fmap n X F1 F2 h c (dcube-pull n X X' Y F1 F1' f g1 c d e))
    (dcube-pull n X X' Y F2 F1' f (λ x y z → h x (g1 x y z)) c d e)
    (dcube-pull n X X' Y F2 F2' f g2 c d (dcube-fmap n X' F1' F2' h' (dcube-map n X Y X' f c d) e))
    (fmap-pull n X X' Y F1 F2 F1' f g1 h c d e)
    (pcat (DCube n X F2 c) (dcube-pull n X X' Y F2 F1' f (λ x y z → h x (g1 x y z)) c d e)
       (dcube-pull n X X' Y F2 F1' f (λ x y z → g2 x y (h' (f x y) z)) c d e)
       (dcube-pull n X X' Y F2 F2' f g2 c d (dcube-fmap n X' F1' F2' h' (dcube-map n X Y X' f c d) e))
       (λ i → dcube-pull n X X' Y F2 F1' f (q i) c d e)
       (psym (DCube n X F2 c) (dcube-pull n X X' Y F2 F2' f g2 c d (dcube-fmap n X' F1' F2' h' (dcube-map n X Y X' f c d) e))
          (dcube-pull n X X' Y F2 F1' f (λ x y z → g2 x y (h' (f x y) z)) c d e)
          (pull-fmap n X X' Y F2 F1' F2' f h' g2 c d e)))
DDPull : (n : Nat) (op : (Z : Type 1) (H : Z → Type 1) (G : Cube n Z) → DCube n Z (DL Z H) G → DCube n Z H G)
  (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' (DL X' F') (dcube-map n X Y X' f c d)) → Type 1
DDPull n op X X' Y F F' f g c d e =
  PathP (λ i → DCube n X F c) (op X F c (dcube-pull n X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g) c d e))
    (dcube-pull n X X' Y F F' f g c d (op X' F' (dcube-map n X Y X' f c d) e))
diag-dd-pull : (sk : Lst Entry) (k : Word) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (c : Cube (dims sk) X) (d : DCube (dims sk) X Y c) (e : DCube (dims sk) X' (DL X' F') (dcube-map (dims sk) X Y X' f c d)) →
  DDPull (dims sk) (λ Z H G q → diag-dd sk k Z H G q) X X' Y F F' f g c d e
diag-dd-pull lnil k X X' Y F F' f g c d e = λ i → g c d (fst e)
diag-dd-pull (lcons (e-ty s) sk) k X X' Y F F' f g c d e =
  bool-elim1 (λ b → DDPull (dims sk) (λ Z H G q → bool-elim1 (λ b' → DCube (dims sk) Z H G) (dcube-fmap (dims sk) Z (DL Z H) H (λ x q' → fst q') G q) (diag-dd sk (%wsub k #1) Z H G q) b) X X' Y F F' f g c d e)
    (pull-sw (dims sk) X X' Y (DL X F) F (DL X' F') F' f (pdl X X' Y F F' f g) g (λ x q → fst q) (λ x q → fst q) (λ t x y z → g x y (fst z)) c d e)
    (diag-dd-pull sk (%wsub k #1) X X' Y F F' f g c d e) (weq k #0)
diag-dd-pull (lcons e-dim sk) k X X' Y F F' f g c d e =
  bool-elim1 (λ b → DDPull (suc (dims sk)) (λ Z H G q → bool-elim1 (λ b' → DCube (dims sk) (Line Z) (LineO Z H) G)
                     (dcube-fmap (dims sk) (Line Z) (LineO Z (DL Z H)) (LineO Z H) (λ L q' → diag-o Z H (line-map Z (Line Z) (degen-l Z) L) q') G q)
                     (diag-dd sk (%wsub k #1) (Line Z) (LineO Z H) G
                        (dcube-fmap (dims sk) (Line Z) (LineO Z (DL Z H)) (DL (Line Z) (LineO Z H)) (λ L q' → exch-o Z H (line-map Z (Line Z) (degen-l Z) L) q') G q)) b)
                   X X' Y F F' f g c d e)
    (pull-sw (dims sk) (Line X) (Line X') (LineO X Y) (LineO X (DL X F)) (LineO X F) (LineO X' (DL X' F')) (LineO X' F') (lineo-map X Y X' f)
       (lineo-pull X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g)) (lineo-pull X X' Y F F' f g)
       (λ L q → diag-o X F (line-map X (Line X) (degen-l X) L) q) (λ L q → diag-o X' F' (line-map X' (Line X') (degen-l X') L) q)
       (λ t L D z → lineo-pull X X' Y F F' f g L D (diag-o X' F' (line-map X' (Line X') (degen-l X') (lineo-map X Y X' f L D)) z)) c d e)
    (pcat (DCube (dims sk) (Line X) (LineO X F) c)
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F) c
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) c
             (dcube-pull (dims sk) (Line X) (Line X') (LineO X Y) (LineO X (DL X F)) (LineO X' (DL X' F')) (lineo-map X Y X' f) (lineo-pull X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g)) c d e)))
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F) c
          (dcube-pull (dims sk) (Line X) (Line X') (LineO X Y) (DL (Line X) (LineO X F)) (DL (Line X') (LineO X' F')) (lineo-map X Y X' f)
             (pdl (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g)) c d
             (dcube-fmap (dims sk) (Line X') (LineO X' (DL X' F')) (DL (Line X') (LineO X' F')) (λ L q → exch-o X' F' (line-map X' (Line X') (degen-l X') L) q) (dcube-map (dims sk) (Line X) (LineO X Y) (Line X') (lineo-map X Y X' f) c d) e)))
       (dcube-pull (dims sk) (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g) c d
          (diag-dd sk (%wsub k #1) (Line X') (LineO X' F') (dcube-map (dims sk) (Line X) (LineO X Y) (Line X') (lineo-map X Y X' f) c d)
             (dcube-fmap (dims sk) (Line X') (LineO X' (DL X' F')) (DL (Line X') (LineO X' F')) (λ L q → exch-o X' F' (line-map X' (Line X') (degen-l X') L) q) (dcube-map (dims sk) (Line X) (LineO X Y) (Line X') (lineo-map X Y X' f) c d) e)))
       (λ i → diag-dd sk (%wsub k #1) (Line X) (LineO X F) c
          (pull-sw (dims sk) (Line X) (Line X') (LineO X Y) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (LineO X' (DL X' F')) (DL (Line X') (LineO X' F')) (lineo-map X Y X' f)
             (lineo-pull X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g)) (pdl (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g))
             (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) (λ L q → exch-o X' F' (line-map X' (Line X') (degen-l X') L) q)
             (λ t L D z → pdl (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g) L D (exch-o X' F' (line-map X' (Line X') (degen-l X') (lineo-map X Y X' f L D)) z)) c d e i))
       (diag-dd-pull sk (%wsub k #1) (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g) c d
          (dcube-fmap (dims sk) (Line X') (LineO X' (DL X' F')) (DL (Line X') (LineO X' F')) (λ L q → exch-o X' F' (line-map X' (Line X') (degen-l X') L) q) (dcube-map (dims sk) (Line X) (LineO X Y) (Line X') (lineo-map X Y X' f) c d) e)))
    (weq k #0)
pc5 : (A : Type 1) (x0 x1 x2 x3 x4 x5 : A) → PathP (λ i → A) x0 x1 → PathP (λ i → A) x1 x2 → PathP (λ i → A) x2 x3 →
  PathP (λ i → A) x3 x4 → PathP (λ i → A) x4 x5 → PathP (λ i → A) x0 x5
pc5 A x0 x1 x2 x3 x4 x5 p1 p2 p3 p4 p5 = pcat A x0 x1 x5 p1 (pcat A x1 x2 x5 p2 (pcat A x2 x3 x5 p3 (pcat A x3 x4 x5 p4 p5)))
papp-ex-pull : (sk : Lst Entry) (cd : IEx) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (c : Cube (dims sk) X) (d : DCube (dims sk) X Y c) (e : DCube (dims sk) X' (DL X' F') (dcube-map (dims sk) X Y X' f c d)) →
  DDPull (dims sk) (λ Z H G q → papp-ex sk Z H cd G q) X X' Y F F' f g c d e
papp-ex-pull sk ix1 X X' Y F F' f g c d e =
  pull-sw (dims sk) X X' Y (DL X F) F (DL X' F') F' f (pdl X X' Y F F' f g) g (λ x q → fst (snd q)) (λ x q → fst (snd q)) (λ t x y z → g x y (fst (snd z))) c d e
papp-ex-pull sk (ixv k) X X' Y F F' f g c d e = diag-dd-pull sk k X X' Y F F' f g c d e
papp-ex-pull sk (ixneg r) X X' Y F F' f g c d e =
