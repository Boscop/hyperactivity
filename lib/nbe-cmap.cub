cco : (sk' sk : Lst Entry) (r : Word → Word) (Y : Type 1) → Cube (dims sk) Y → Cube (dims sk') Y
cco sk' sk r Y c = cmap-cube sk' sk (cmap-of sk' sk r) Y c
ccd : (sk' sk : Lst Entry) (r : Word → Word) (Y : Type 1) (G : Y → Type 1) (c : Cube (dims sk) Y) → DCube (dims sk) Y G c → DCube (dims sk') Y G (cco sk' sk r Y c)
ccd sk' sk r Y G c d = cmap-d sk' sk (cmap-of sk' sk r) Y G c d
pc4 : (A : Type 1) (x0 x1 x2 x3 x4 : A) → PathP (λ i → A) x0 x1 → PathP (λ i → A) x1 x2 → PathP (λ i → A) x2 x3 → PathP (λ i → A) x3 x4 → PathP (λ i → A) x0 x4
pc4 A x0 x1 x2 x3 x4 p1 p2 p3 p4 = pcat A x0 x1 x4 p1 (pcat A x1 x2 x4 p2 (pcat A x2 x3 x4 p3 p4))
cmap-r : (sk2 sk1 sk : Lst Entry) → (Word → Word) → CMap sk1 sk → CMap sk2 sk
cmap-r sk2 sk1 lnil r σ = unit
cmap-r sk2 sk1 (lcons (e-ty a) sk) r σ = cmap-r sk2 sk1 sk r σ
cmap-r sk2 sk1 (lcons e-dim sk) r σ = (cmap-r sk2 sk1 sk r (fst σ) , dnf-r r (snd σ))
ixr : (Word → Word) → IEx → IEx
ixr r ix0 = ix0
ixr r ix1 = ix1
ixr r (ixv k) = ixv (r k)
ixr r (ixneg x) = ixneg (ixr r x)
ixr r (ixmeet x y) = ixmeet (ixr r x) (ixr r y)
ixr r (ixjoin x y) = ixjoin (ixr r x) (ixr r y)
lit-ix-r : (r : Word → Word) (l : Lit) → Path IEx (lit-ix (lit-r r l)) (ixr r (lit-ix l))
lit-ix-r r l = bool-elim (λ b → Path IEx (lit-ix (lit-r r (fst l , b))) (ixr r (lit-ix (fst l , b)))) refl refl (snd l)
conj-ix-from-r : (r : Word → Word) (l : Lit) (ms : Conj) → Path IEx (conj-ix-from (lit-r r l) (conj-r r ms)) (ixr r (conj-ix-from l ms))
conj-ix-from-r r l lnil = lit-ix-r r l
conj-ix-from-r r l (lcons m ms) = λ i → ixmeet (lit-ix-r r l i) (conj-ix-from-r r m ms i)
conj-ix-r : (r : Word → Word) (c : Conj) → Path IEx (conj-ix (conj-r r c)) (ixr r (conj-ix c))
conj-ix-r r lnil = refl
conj-ix-r r (lcons l ls) = conj-ix-from-r r l ls
dnf-ix-from-r : (r : Word → Word) (c : Conj) (ds : DNF) → Path IEx (dnf-ix-from (conj-r r c) (dnf-r r ds)) (ixr r (dnf-ix-from c ds))
dnf-ix-from-r r c lnil = conj-ix-r r c
dnf-ix-from-r r c (lcons d ds) = λ i → ixjoin (conj-ix-r r c i) (dnf-ix-from-r r d ds i)
dnf-ix-r : (r : Word → Word) (f : DNF) → Path IEx (dnf-ix (dnf-r r f)) (ixr r (dnf-ix f))
dnf-ix-r r lnil = refl
dnf-ix-r r (lcons c cs) = dnf-ix-from-r r c cs
ixr-isub : (r : Word → Word) (e : IEx) → PathP (λ i → IEx) (ixr r e) (isub (λ k → ixv (r k)) e)
ixr-isub r ix0 = λ i → ix0
ixr-isub r ix1 = λ i → ix1
ixr-isub r (ixv k) = λ i → ixv (r k)
ixr-isub r (ixneg x) = λ i → ixneg (ixr-isub r x i)
ixr-isub r (ixmeet x y) = λ i → ixmeet (ixr-isub r x i) (ixr-isub r y i)
ixr-isub r (ixjoin x y) = λ i → ixjoin (ixr-isub r x i) (ixr-isub r y i)
pcat-ix : (x y z : IEx) → PathP (λ i → IEx) x y → PathP (λ i → IEx) y z → PathP (λ i → IEx) x z
pcat-ix x y z p q = λ i → comp (λ j → IEx) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)
