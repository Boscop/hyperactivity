cmap-d-wcomp : (sk2 sk1 sk : Lst Entry) (r : Word → Word) (dp : DimPres sk2 sk1 r) (σ : CMap sk1 sk) (X : Type 1) (F : X → Type 1)
  (c : Cube (dims sk) X) (d : DCube (dims sk) X F c) →
  PathP (λ i → DCube (dims sk2) X F (cmap-wcomp sk2 sk1 sk r dp σ X c i))
    (ccd sk2 sk1 r X F (cmap-cube sk1 sk σ X c) (cmap-d sk1 sk σ X F c d)) (cmap-d sk2 sk (cmap-r sk2 sk1 sk r σ) X F c d)
