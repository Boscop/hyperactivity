cmap-d-wcomp sk2 sk1 (lcons (e-ty a) sk) r dp σ X F c d = cmap-d-wcomp sk2 sk1 sk r dp σ X F c d
cmap-d-wcomp sk2 sk1 (lcons e-dim sk) r dp σ X F c d =
  pcat-d (Cube (dims sk2) X) (DCube (dims sk2) X F)
    (cco sk2 sk1 r X (papp-cube sk1 X (snd σ) (cmap-cube sk1 sk (fst σ) (Line X) c)))
    (papp-cube sk2 X (dnf-r r (snd σ)) (cco sk2 sk1 r (Line X) (cmap-cube sk1 sk (fst σ) (Line X) c)))
    (papp-cube sk2 X (dnf-r r (snd σ)) (cmap-cube sk2 sk (cmap-r sk2 sk1 sk r (fst σ)) (Line X) c))
    (psym (Cube (dims sk2) X) (papp-cube sk2 X (dnf-r r (snd σ)) (cco sk2 sk1 r (Line X) (cmap-cube sk1 sk (fst σ) (Line X) c)))
       (cco sk2 sk1 r X (papp-cube sk1 X (snd σ) (cmap-cube sk1 sk (fst σ) (Line X) c)))
       (cmap-papp sk2 sk1 r dp (snd σ) X (cmap-cube sk1 sk (fst σ) (Line X) c)))
    (λ i → papp-cube sk2 X (dnf-r r (snd σ)) (cmap-wcomp sk2 sk1 sk r dp (fst σ) (Line X) c i))
    (ccd sk2 sk1 r X F (papp-cube sk1 X (snd σ) (cmap-cube sk1 sk (fst σ) (Line X) c))
       (papp-cube-d sk1 X F (snd σ) (cmap-cube sk1 sk (fst σ) (Line X) c) (cmap-d sk1 sk (fst σ) (Line X) (LineO X F) c d)))
    (papp-cube-d sk2 X F (dnf-r r (snd σ)) (cco sk2 sk1 r (Line X) (cmap-cube sk1 sk (fst σ) (Line X) c))
       (ccd sk2 sk1 r (Line X) (LineO X F) (cmap-cube sk1 sk (fst σ) (Line X) c) (cmap-d sk1 sk (fst σ) (Line X) (LineO X F) c d)))
    (papp-cube-d sk2 X F (dnf-r r (snd σ)) (cmap-cube sk2 sk (cmap-r sk2 sk1 sk r (fst σ)) (Line X) c)
       (cmap-d sk2 sk (cmap-r sk2 sk1 sk r (fst σ)) (Line X) (LineO X F) c d))
    (psym-d (Cube (dims sk2) X) (DCube (dims sk2) X F)
       (papp-cube sk2 X (dnf-r r (snd σ)) (cco sk2 sk1 r (Line X) (cmap-cube sk1 sk (fst σ) (Line X) c)))
       (cco sk2 sk1 r X (papp-cube sk1 X (snd σ) (cmap-cube sk1 sk (fst σ) (Line X) c)))
       (cmap-papp sk2 sk1 r dp (snd σ) X (cmap-cube sk1 sk (fst σ) (Line X) c))
       (papp-cube-d sk2 X F (dnf-r r (snd σ)) (cco sk2 sk1 r (Line X) (cmap-cube sk1 sk (fst σ) (Line X) c))
          (ccd sk2 sk1 r (Line X) (LineO X F) (cmap-cube sk1 sk (fst σ) (Line X) c) (cmap-d sk1 sk (fst σ) (Line X) (LineO X F) c d)))
       (ccd sk2 sk1 r X F (papp-cube sk1 X (snd σ) (cmap-cube sk1 sk (fst σ) (Line X) c))
          (papp-cube-d sk1 X F (snd σ) (cmap-cube sk1 sk (fst σ) (Line X) c) (cmap-d sk1 sk (fst σ) (Line X) (LineO X F) c d)))
       (cmap-papp-d sk2 sk1 r dp (snd σ) X F (cmap-cube sk1 sk (fst σ) (Line X) c) (cmap-d sk1 sk (fst σ) (Line X) (LineO X F) c d)))
