#!build/cubical
-- lib/paper-view.cub — the paper as it reads (`human hyperactivity`, docs/hyperactivity.cub), kept in
-- the store (paper/text), stamped with the latest change under the repository (paper/stamp) as the
-- walk is; lib/hyperactive.cub runs this when the stamp has moved and serves the paper from the store.
import "host.cub"
import "../docs/hyperactivity.cub"

-- the names the paper's realized constructions give as their code: each must name a definition a file
-- the machine has read declares (the store points the name at its written piece, written/), or the
-- paper names code that is not there
p-names : List Block → List (List Word)
p-names nil = nil
p-names (cons (heading d t) r) = p-names r
p-names (cons (prose l) r) = p-names r
p-names (cons (construction l) r) = p-names r
p-names (cons (note l) r) = p-names r
p-names (cons (realized b ns) r) = list-append ns (p-names r)
p-names-of : Paper → List (List Word)
p-names-of (paper t s d a v bs) = p-names bs
-- the paper as it reads (paper/text) and the names its realized constructions give as code
-- (paper/names), which hyperactive check resolves against the store
p-build : List Word → Proc W Unit
p-build st =
  bind (h-mkdir st) (λ u → bind (h-mkdir (list-append st "/paper")) (λ u2 →
  bind (h-write (list-append st "/paper/text") (human hyperactivity)) (λ b →
  bind (h-write (list-append st "/paper/names") (h-concat (list-map h-line (p-names-of hyperactivity)))) (λ b1 → exit #0))))
p-main : Proc W Unit
p-main = bind (h-env "CUBICAL_STORE") (λ e → p-build (h-store-of e))
-- p-run: keeps the paper's text in the store (part of product-implementation)
p-run : Step W Unit
p-run = to-step p-main
#run p-run
