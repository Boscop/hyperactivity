#!build/cubical
-- lib/paper-view.cub — the paper as it reads (`human hyperactivity`, docs/hyperactivity.cub), kept in
-- the store (paper/text), stamped with the latest change under the repository (paper/stamp) as the
-- walk is; lib/hyperactive.cub runs this when the stamp has moved and serves the paper from the store.
import "host.cub"
import "../docs/hyperactivity.cub"

p-build : List Word → Proc W Unit
p-build st =
  bind (h-dir-time (toNat #12) ".") (λ stamp →
  bind (h-mkdir st) (λ u → bind (h-mkdir (list-append st "/paper")) (λ u2 →
  bind (h-write (list-append st "/paper/text") (human hyperactivity)) (λ b →
  bind (h-write (list-append st "/paper/stamp") (h-decimal stamp)) (λ b2 → exit #0)))))
p-main : Proc W Unit
p-main = bind (h-env "CUBICAL_STORE") (λ e → p-build (h-store-of e))
p-run : Step W Unit
p-run = to-step p-main
#run p-run
