-- ---------------------------------------------------------------- types: W = #0, P = #1, pairs 2..5
-- a pair of two components, each W or P (a pair component that is itself a pair is boxed), is a C
-- struct by value: Pr0 (W, W), Pr1 (W, P), Pr2 (P, W), Pr3 (P, P); its type is 2 + 2·fst + snd
tW = #0
tP = #1
is-pr t = %wlt #1 t
pr-ty a b = %wadd #2 (%wadd (%wadd (flat a) (flat a)) (flat b))
flat t = if is-pr t then tP else t
pr-fst t = if %wlt (%wsub t #2) #2 then tW else tP
pr-snd t = if %weq (%wsub t #2) #0 then tW else if %weq (%wsub t #2) #2 then tW else tP
pr-k t k = if %weq k #0 then pr-fst t else pr-snd t
ty-decl t = if %weq t tW then u-w else if %weq t tP then u-p else cat3 u-pr (dec (%wsub t #2)) u-sp
-- signatures: (g , (params , ret)), params a Lst of types; a def not in the table has P everywhere
sig-of sigs g = case sigs of lnil → none; lcons s r → if %weq (fst s) g then some (snd s) else sig-of r g
param-ty sigs g j = case sig-of sigs g of some s → (case lnth-ty (fst s) j of some t → t; none → tP); none → tP
ret-ty sigs g = case sig-of sigs g of some s → snd s; none → tP
lnth-ty l j = case l of lnil → none; lcons x xs → if %weq j #0 then some x else lnth-ty xs (%wsub j #1)
env-ty env n = case env of lnil → tP; lcons t r → if %weq n #0 then t else env-ty r (%wsub n #1)
push-n t n env = if %weq n #0 then env else push-n t (%wsub n #1) (lcons t env)
-- the natural type of a term in an environment of types (innermost first)
infer-u sigs env t =
  case t of
    fvar n → env-ty env n
    flit w → tW
    fcon d c fs → if %weq d #0 then (if %weq c #0 then (case fs of lcons a r → (case r of lcons b r2 → (case r2 of lnil → pr-ty (infer-u sigs env a) (infer-u sigs env b); _ → tP); _ → tP); _ → tP) else tP) else tP
    fswitch x alts → alts-ty sigs env alts
    frec d x alts → tP
    fproj d c k x → (let tx = infer-u sigs env x in if is-pr tx then pr-k tx k else tP)
    fcall g args → ret-ty sigs g
    fprim p args → if %weq p P-store64 then tP else if %weq p P-store32 then tP else if %weq p P-bytes then tP else tW
    flet a b → infer-u sigs (lcons (infer-u sigs env a) env) b
    fif c a b → join-ty (infer-u sigs env a) (infer-u sigs env b)
    floop init body → loop-ty sigs env init body
    fassume f b → infer-u sigs env b
    fforce x → infer-u sigs env x
    _ → tP
join-ty a b = if %weq a b then a else tP
alts-ty sigs env alts =
  case alts of
    lnil → tP
    lcons a r → (case r of lnil → infer-u sigs (push-n tP (fst (snd a)) env) (snd (snd a)); _ → join-ty (infer-u sigs (push-n tP (fst (snd a)) env) (snd (snd a))) (alts-ty sigs env r))
-- a loop's result: the break's payload when the body has the shape, else P
loop-ty sigs env init body =
  let env2 = push-types sigs env init
  in case body of
       fif c a b → (case b of fcon d k fs → (case fs of lcons r rest → infer-u sigs env2 r; _ → tP); _ → tP)
       _ → tP
push-types sigs env l = case l of lnil → env; lcons x xs → push-types sigs (lcons (infer-u sigs env x) env) xs
-- ---------------------------------------------------------------- parameter types by use
-- use-ty sigs env d n body: the type a variable at depth n (from the body's top, d binders deep)
-- is used at: W when an operand of arithmetic or a fact, P when a scrutinee, a projected value, a
-- buffer, an applied function; an argument of a call takes the callee's parameter type; the first
-- use found decides, P when none
use-ty sigs d n t =
  case t of
    fvar m → none
    flit w → none
    fcon dd c fs → use-list sigs d n fs
    fswitch x alts → first-some (if is-var d n x then some tP else use-ty sigs d n x) (use-alts sigs d n alts)
    frec dd x alts → first-some (if is-var d n x then some tP else use-ty sigs d n x) (use-ralts sigs d n alts)
    fproj dd c k x → if is-var d n x then some tP else use-ty sigs d n x
    fcall g args → use-args sigs d n g #0 args
    fprim p args → if %wlt #7 p then use-bytes sigs d n p args else use-arith sigs d n args
    flet a b → first-some (use-ty sigs d n a) (use-ty sigs (%wsucc d) n b)
    fif c a b → first-some (if is-var d n c then some tW else use-ty sigs d n c) (first-some (use-ty sigs d n a) (use-ty sigs d n b))
    floop init body → first-some (use-init sigs d n (lst-len init) init #0 body) (use-ty sigs (%wadd d (lst-len init)) n body)
    fclos g env → use-list sigs d n env
    fapply f args → first-some (if is-var d n f then some tP else use-ty sigs d n f) (use-list sigs d n args)
    fassume f b → use-ty sigs d n b
    fforce x → use-ty sigs d n x
    _ → none
is-var d n t = case t of fvar m → %weq m (%wadd d n); _ → false
-- a variable that initializes loop state i is used as that state is used in the body (state i is
-- the body's variable k − 1 − i)
use-init sigs d n k init i body =
  case init of
    lnil → none
    lcons x xs → first-some (if is-var d n x then use-ty sigs #0 (%wsub (%wsub k #1) i) body else use-ty sigs d n x) (use-init sigs d n k xs (%wsucc i) body)
first-some a b = case a of some x → a; none → b
use-list sigs d n l = case l of lnil → none; lcons x xs → first-some (use-ty sigs d n x) (use-list sigs d n xs)
use-alts sigs d n alts = case alts of lnil → none; lcons a r → first-some (use-ty sigs (%wadd d (fst (snd a))) n (snd (snd a))) (use-alts sigs d n r)
use-ralts sigs d n alts = case alts of lnil → none; lcons a r → first-some (use-ty sigs (%wadd d (%wadd (fst (snd a)) (lst-len (fst (snd (snd a)))))) n (snd (snd (snd a)))) (use-ralts sigs d n r)
use-args sigs d n g j args = case args of lnil → none; lcons a r → first-some (if is-var d n a then some (param-ty sigs g j) else use-ty sigs d n a) (use-args sigs d n g (%wsucc j) r)
use-arith sigs d n args = case args of lnil → none; lcons a r → first-some (if is-var d n a then some tW else use-ty sigs d n a) (use-arith sigs d n r)
-- the byte primitives: the buffer P, the offset and the stored value W
use-bytes sigs d n p args =
  case args of
    lnil → none
    lcons a r → first-some (if is-var d n a then some (if %weq p P-bytes then tW else tP) else use-ty sigs d n a) (use-arith sigs d n r)
-- the signature of a definition (arity n): parameter i is the variable n − 1 − i at the top
def-sig sigs n body = (param-tys sigs n #0 body , infer-u sigs (param-env sigs n #0 body) body)
param-tys sigs n i body = if %weq i n then lnil else lcons (case use-ty sigs #0 (%wsub (%wsub n #1) i) body of some t → t; none → tP) (param-tys sigs n (%wsucc i) body)
-- the environment of the body: parameters innermost-last (variable 0 is the last parameter)
param-env sigs n i body = if %weq i n then lnil else lapp (param-env sigs n (%wsucc i) body) (lcons (case use-ty sigs #0 (%wsub (%wsub n #1) i) body of some t → t; none → tP) lnil)
-- all signatures, iterated so that calls see their callees' types
sigs-of defs = let ct = clos-targets defs in sigs-round ct (sigs-round ct (sigs-round ct lnil defs) defs) defs
sigs-round ct sigs defs =
  case defs of
    lnil → lnil
    lcons d r → lcons (fst d , (if lmem-w (fst d) ct then (push-n tP (fst (snd d)) lnil , tP) else def-sig sigs (fst (snd d)) (snd (snd d)))) (sigs-round ct sigs r)
-- the targets of closures are called through the dispatcher with boxed arguments: P throughout
lmem-w g l = case l of lnil → false; lcons x xs → if %weq x g then true else lmem-w g xs
clos-targets defs = case defs of lnil → lnil; lcons d r → clos-in (snd (snd d)) (clos-targets r)
clos-in t acc =
  case t of
    fclos g env → clos-list env (lcons g acc)
    fcon d c fs → clos-list fs acc
    fswitch x alts → clos-alts alts (clos-in x acc)
    frec d x alts → clos-ralts alts (clos-in x acc)
    fproj d c k x → clos-in x acc
    fcall g args → clos-list args acc
    fprim p args → clos-list args acc
    flet a b → clos-in b (clos-in a acc)
    fif c a b → clos-in b (clos-in a (clos-in c acc))
    floop init body → clos-in body (clos-list init acc)
    fapply f args → clos-list args (clos-in f acc)
    fassume f b → clos-in b acc
    fforce x → clos-in x acc
    _ → acc
clos-list l acc = case l of lnil → acc; lcons x xs → clos-list xs (clos-in x acc)
clos-alts alts acc = case alts of lnil → acc; lcons a r → clos-alts r (clos-in (snd (snd a)) acc)
clos-ralts alts acc = case alts of lnil → acc; lcons a r → clos-ralts r (clos-in (snd (snd (snd a))) acc)
-- ---------------------------------------------------------------- printing
-- emit-at sigs env d want t: the C expression of t at the wanted type; env the types of the
-- variables (innermost first); d the depth for naming (as lib/emitc.cub: v_(d-1-n))
emit-at sigs env d want t =
  let nat = infer-u sigs env t
  in if %weq nat want then emit-u sigs env d t
     else if is-pr want then pair-at sigs env d want t
     else if %weq want tW then cat3 (emit-u sigs env d t) u-n lnil
     else if is-pr nat then box-pr nat (emit-u sigs env d t)
     else cat3 u-mkw (emit-u sigs env d t) u-rp
-- a pair wanted: built from its components at their types, or unboxed from a V
pair-at sigs env d want t =
  case t of
    fcon dd c fs → (case fs of lcons a r → (case r of lcons b r2 → cat7 u-cast u-pr (dec (%wsub want #2)) u-brace (emit-at sigs env d (pr-fst want) a) u-comma (cat3 (emit-at sigs env d (pr-snd want) b) u-bend u-rp); _ → s-unsup); _ → s-unsup)
    _ → (let nat = infer-u sigs env t
         in if is-pr nat then box-pr nat (emit-u sigs env d t) else
            cat7 u-box (emit-at sigs env d tP t) u-semi (cat4 u-cast u-pr (dec (%wsub want #2)) u-brace) (comp-of (pr-fst want) u-q0) u-comma (cat4 (comp-of (pr-snd want) u-q1) u-bend u-rp u-boxend))
comp-of t q = if %weq t tW then lapp q u-n else q
-- a pair boxed: mkc(0, 2, box f0, box f1)
box-pr nat e = cat7 u-box e u-semi u-mkc2 (box-comp (pr-fst nat) (lcons #113 u-f0)) u-comma (cat3 (box-comp (pr-snd nat) (lcons #113 u-f1)) u-rp u-boxend)
box-comp t e = if %weq t tW then cat3 u-mkw e u-rp else e
emit-u sigs env d t =
  case t of
    fvar n → var d n
    flit w → dec w
    fcon dd c fs → (let nat = infer-u sigs env t in if is-pr nat then pair-at sigs env d nat t else cat7 u-mkc (dec c) u-comma (dec (lst-len fs)) (args-rest-u sigs env d fs) u-rp lnil)
    fswitch x alts →
      let rt = infer-u sigs env t
      in cat6 u-bsx (cat3 (ty-decl rt) (lcons #114 lnil) u-semi) (cat3 u-xbind (emit-at sigs env d tP x) u-switch) (alts-u sigs env d rt alts) (if %weq rt tW then u-default-w else (if is-pr rt then cat3 (lcons #100 (lcons #101 (lcons #102 (lcons #97 (lcons #117 (lcons #108 (lcons #116 (lcons #58 (lcons #32 lnil))))))))) (lcons #125 (lcons #32 lnil)) lnil else u-default-p)) (lapp (lcons #114 lnil) u-bsend)
    fproj dd c k x → (let tx = infer-u sigs env x in if is-pr tx then cat3 u-lp (emit-u sigs env d x) (if %weq k #0 then u-f0 else u-f1) else cat4 (emit-at sigs env d tP x) u-arrow (dec k) u-rb)
    fcall g args → cat4 u-f (dec g) u-lp (lapp (args-u sigs env d g #0 args) u-rp)
    fprim p args → prim-u sigs env d p args
    flet a b →
      let ta = infer-u sigs env a
      in cat7 u-bsx (ty-decl ta) (var (%wsucc d) #0) u-assign (emit-u sigs env d a) u-semi (lapp (emit-u sigs (lcons ta env) (%wsucc d) b) u-bsend)
    fif c a b →
      let rt = infer-u sigs env t
      in cat6 u-if (emit-at sigs env d tW c) u-ifm (emit-at sigs env d rt a) u-ifs (lapp (emit-at sigs env d rt b) u-ifend)
    floop init body → loop-u sigs env d init body
    fclos g cenv → cat7 u-clo (dec g) u-comma (dec (lst-len cenv)) (args-rest-u sigs env d cenv) u-rp lnil
    fapply f args → apply-u sigs env d (emit-at sigs env d tP f) args
    fassume fact b → cat5 u-assume (fact-u sigs env d fact) u-asmend (emit-u sigs env d b) u-bsend
    fforce x → emit-u sigs env d x
    _ → s-unsup
-- an assumed fact over typed variables
fact-u sigs env d c =
  case c of
    cwlit n → dec n
    cvar n → emit-at sigs env d tW (fvar n)
    cwsucc a → cat3 s-lp (fact-u sigs env d a) s-one
    cwop k a b → if %weq k #3 then cat6 s-maxa (fact-u sigs env d a) s-maxb (fact-u sigs env d b) s-maxc (cat4 (fact-u sigs env d a) s-maxd (fact-u sigs env d b) s-maxe) else cat5 s-lp (fact-u sigs env d a) (fop-c k) (fact-u sigs env d b) s-rp
    cann a T → fact-u sigs env d a
    _ → dec #1
apply-u sigs env d f args = case args of lnil → f; lcons a r → apply-u sigs env d (cat5 u-apply f u-comma (emit-at sigs env d tP a) u-rp) r
args-rest-u sigs env d fs = case fs of lnil → lnil; lcons x xs → cat3 u-comma (emit-at sigs env d tP x) (args-rest-u sigs env d xs)
args-u sigs env d g j l = case l of lnil → lnil; lcons x xs → (case xs of lnil → emit-at sigs env d (param-ty sigs g j) x; _ → cat3 (emit-at sigs env d (param-ty sigs g j) x) u-comma (args-u sigs env d g (%wsucc j) xs))
-- alternatives: fields bound as boxed locals, the body at the switch's type
alts-u sigs env d rt alts =
  case alts of
    lnil → lnil
    lcons a r → lapp (alt-u sigs env d rt (fst a) (fst (snd a)) (snd (snd a))) (alts-u sigs env d rt r)
alt-u sigs env d rt c n body = cat6 u-case (dec c) u-colon (fields-u d n #0) (cat3 u-rr (emit-at sigs (push-n tP n env) (%wadd d n) rt body) u-semi) u-break
fields-u d n i = if %weq i n then lnil else cat7 u-p (var (%wsucc (%wadd d i)) #0) u-assign u-x u-arrow (dec i) (lapp u-rb (lapp u-semi (fields-u d n (%wsucc i))))
-- primitives: arithmetic on words; the byte layer
prim-u sigs env d p args =
  if %wlt #7 p then bytes-u sigs env d p args else
  (case args of
     lcons a r →
       (case r of
          lcons b r2 → cat5 u-lp (emit-at sigs env d tW a) (op-u p) (emit-at sigs env d tW b) u-rp
          lnil → cat4 u-lp u-not (emit-at sigs env d tW a) u-rp)
     lnil → dec #0)
op-u p = if %weq p #0 then u-plus else if %weq p #1 then u-minus else if %weq p #2 then u-times else if %weq p #3 then u-eq else if %weq p #4 then u-lt else if %weq p #5 then u-and else u-or
bytes-u sigs env d p args =
  case args of
    lcons a r →
      (case r of
         lnil → (if %weq p P-bytes then cat3 u-mkb (emit-at sigs env d tW a) u-rp else cat3 u-blen (emit-at sigs env d tP a) (lapp u-n u-rp))
         lcons b r2 →
           (case r2 of
              lnil → cat5 (if %weq p P-load64 then u-ld64 else u-ld32) (emit-at sigs env d tP a) u-comma (emit-at sigs env d tW b) u-rp
              lcons c r3 → cat7 (if %weq p P-store64 then u-st64 else u-st32) (emit-at sigs env d tP a) u-comma (emit-at sigs env d tW b) u-comma (emit-at sigs env d tW c) u-rp))
    lnil → s-unsup
-- a loop: typed state locals; the body's shape if c then continue (state) else break r prints as
-- a for with reassignments; any other body falls back to the boxed protocol of lib/emitc.cub
loop-u sigs env d init body =
  let k = lst-len init
      tys = init-types sigs env init
      env2 = push-types sigs env init
      rt = loop-ty sigs env init body
  in case body of
       fif c a b →
         (case a of
            fcon dd kk st →
              (case b of
                 fcon dd2 kk2 fs →
                   (case fs of
                      lcons r rest →
                        cat6 u-bsx (cat3 (ty-decl rt) (lcons #114 lnil) u-semi) (inits-u sigs env d tys init #0)
                          (cat4 u-for (emit-at sigs env2 (%wadd d k) tW c) u-forthen (reassign-u sigs env2 (%wadd d k) tys k st #0))
                          (cat3 u-cont (emit-at sigs env2 (%wadd d k) rt r) u-forend)
                          (lapp (lcons #114 lnil) u-bsend)
                      _ → emit d (floop init body))
                 _ → emit d (floop init body))
            _ → emit d (floop init body))
       _ → emit d (floop init body)
init-types sigs env l = case l of lnil → lnil; lcons x xs → lcons (infer-u sigs env x) (init-types sigs (lcons (infer-u sigs env x) env) xs)
-- state variable i is v_(d+1+i); typed by tys
inits-u sigs env d tys l i =
  case l of
    lnil → lnil
    lcons x xs → cat7 (ty-decl (ty-at tys i)) (var (%wsucc (%wadd d i)) #0) u-assign (emit-at sigs env d (ty-at tys i) x) u-semi (inits-u sigs (lcons (infer-u sigs env x) env) d tys xs (%wsucc i)) lnil
ty-at tys i = case tys of lnil → tP; lcons t r → if %weq i #0 then t else ty-at r (%wsub i #1)
-- the new state: computed into temporaries first (each reads the old state), then assigned
reassign-u sigs env d tys k st i =
  case st of
    lnil → assign-back d k #0
    lcons x xs → cat6 (ty-decl (ty-at tys i)) (lapp (lcons #116 lnil) (dec i)) u-assign (emit-at sigs env d (ty-at tys i) x) u-semi (reassign-u sigs env d tys k xs (%wsucc i))
assign-back d k i = if %weq i k then lnil else cat5 (var (%wsub d (%wsub (%wsub k #1) i)) #0) u-assign (lapp (lcons #116 lnil) (dec i)) u-semi (assign-back d k (%wsucc i))
-- definitions and programs
params-u tys i n = if %weq i n then lnil else (case %weq (%wsucc i) n of true → cat3 (ty-decl (ty-at tys i)) (var (%wsucc i) #0) lnil; false → cat4 (ty-decl (ty-at tys i)) (var (%wsucc i) #0) u-comma (params-u tys (%wsucc i) n))
head-u sigs g n = case sig-of sigs g of
  some s → cat7 u-fn (ty-decl (snd s)) u-f (dec g) u-lp (if %weq n #0 then u-void else params-u (fst s) #0 n) lnil
  none → cat7 u-fn u-p u-f (dec g) u-lp (if %weq n #0 then u-void else params-u lnil #0 n) lnil
emit-def-u sigs g n body =
  case sig-of sigs g of
    some s → cat3 (head-u sigs g n) u-body (lapp (emit-at sigs (fst s) n (snd s) body) u-end)
    none → cat3 (head-u sigs g n) u-body (lapp (emit-at sigs lnil n tP body) u-end)
proto-u sigs g n = lapp (head-u sigs g n) u-proto-end
protos-u sigs defs = case defs of lnil → lnil; lcons d r → lapp (proto-u sigs (fst d) (fst (snd d))) (protos-u sigs r)
defs-u sigs defs = case defs of lnil → lnil; lcons d r → lapp (emit-def-u sigs (fst d) (fst (snd d)) (snd (snd d))) (defs-u sigs r)
emit-prog-u defs =
  let sigs = sigs-of defs
  in cat5 s-runtime u-prdecl (protos-u sigs defs) (dispatch defs) (lapp (defs-u sigs defs) (if %weq (ret-ty sigs #0) tW then u-main-w else if is-pr (ret-ty sigs #0) then u-main-pr else u-main-p))
