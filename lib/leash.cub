#!build/cubical
-- lib/leash.cub — the guard an agent's harness runs before each tool call (.claude/settings.json,
-- PreToolUse; Avik, 2026-11-15: "do you write/read code using files and text commands? that is
-- unacceptable"). The call arrives as JSON on standard input; a call that opens, searches or edits
-- code as files is refused (exit 2, the reason on standard error): code is read and written only
-- through `hyperactive`.
import "host.cub"

-- a string field of the call: the text after "key": "…", escapes kept as written, or nothing
l-after-colon : List Word → List Word
l-after-colon nil = nil
l-after-colon (cons x r) = if orB (weq x #32) (weq x #58) then l-after-colon r else cons x r
l-string-st : Bool → List Word → List Word
l-string-st b nil = nil
l-string-st b (cons x r) = if b then cons x (l-string-st false r) else if weq x #92 then cons x (l-string-st true r) else if weq x #34 then nil else cons x (l-string-st false r)
l-string : List Word → List Word
l-string t = l-string-st false t
l-value-at : List Word → List Word
l-value-at nil = nil
l-value-at (cons x r) = if weq x #34 then l-string r else nil
l-value : List Word → List Word
l-value t = l-value-at (l-after-colon t)
l-quoted : List Word → List Word
l-quoted key = cons #34 (list-append key (cons #34 nil))
l-field : List Word → List Word → List Word
l-field key nil = nil
l-field key (cons x r) = if h-prefix (l-quoted key) (cons x r)
  then l-value (h-drop (l-quoted key) (cons x r)) else l-field key r

-- where code is kept: a path naming one of these reaches code
l-homes : List (List Word)
l-homes = cons "lib" (cons "docs" (cons "experiments" (cons "workflow" nil)))
l-home-in : List Word → List (List Word) → Bool
l-home-in t nil = false
l-home-in t (cons h r) = orB (orB (h-prefix (list-append h "/") t) (h-eq h t)) (l-home-in t r)
l-home-at : List Word → Bool
l-home-at t = l-home-in t l-homes
-- a word of a command reaches code: it names a .cub file, or begins at a place where code is kept
l-home-in-path : List Word → Bool
l-home-in-path w = orB (h-infix "/lib/" w) (orB (h-infix "/docs/" w) (orB (h-infix "/experiments/" w) (h-infix "/workflow/" w)))
l-word-reaches : List Word → Bool
l-word-reaches w = orB (h-infix ".cub" w) (orB (l-home-at w) (orB (l-home-at (h-drop "./" w)) (l-home-in-path w)))
l-any : (List Word → Bool) → List (List Word) → Bool
l-any p nil = false
l-any p (cons x r) = orB (p x) (l-any p r)
l-words : List Word → List (List Word)
l-words s = h-nonempty (h-split #32 s)
-- a segment of a shell command: a search of the repository, or a word reaching code outside hyperactive
l-first : List (List Word) → List Word
l-first nil = nil
l-first (cons x r) = x
l-search : List (List Word) → Bool
l-search nil = false
l-search (cons c r) =
  orB (h-has c (cons "rg" (cons "ag" (cons "ack" (cons "find" (cons "fd" (cons "tree" nil)))))))
  (orB (andB (h-eq c "git") (h-eq (l-first r) "grep"))
  (andB (orB (h-eq c "grep") (h-eq c "egrep")) (l-any (λ w → andB (h-prefix "-" w) (orB (h-infix "r" w) (h-infix "R" w))) r)))
l-ours : List (List Word) → Bool
l-ours ws = orB (h-ends "hyperactive" (l-first ws)) (h-eq (l-first ws) "git")
l-segment-bad : List Word → Bool
l-segment-bad s = orB (l-search (l-words s)) (andB (l-any l-word-reaches (l-words s)) (h-not (l-ours (l-words s))))
-- the command cut at ; & | newlines, $( and backquotes
l-cut : Word → Bool
l-cut x = orB (weq x #59) (orB (weq x #38) (orB (weq x #124) (orB (weq x #10) (orB (weq x #96) (weq x #40)))))
l-segments-onto : List Word → List Word → List (List Word)
l-segments-onto cur nil = cons (h-rev cur nil) nil
l-segments-onto cur (cons x r) = if l-cut x then cons (h-rev cur nil) (l-segments-onto nil r) else l-segments-onto (cons x cur) r

l-why : List Word
l-why = "code is read and written only through hyperactive (hyperactive def NAME; hyperactive write NAME [after OTHER]; hyperactive show, tree, order, open): never open, search or edit a .cub file"
l-refuse : List Word → Proc W Unit
l-refuse why = bind (h-say (h-line why)) (λ u → exit #2)
l-file-tools : List (List Word)
l-file-tools = cons "Read" (cons "Write" (cons "Edit" (cons "MultiEdit" (cons "NotebookEdit" nil))))
-- a search with no path searches where the call is made; a relative path is under it
l-grep-in-repo : List Word → Bool
l-grep-in-repo call = orB (h-null (l-field "path" call)) (orB (h-not (h-prefix "/" (l-field "path" call))) (orB (h-infix "hyperactivity" (l-field "path" call)) (l-home-in-path (l-field "path" call))))
l-judge-tool : List Word → List Word → Proc W Unit
l-judge-tool call tool =
  if h-has tool l-file-tools then
    (if orB (h-infix ".cub" (l-field "file_path" call)) (h-infix ".cub" (l-field "notebook_path" call)) then l-refuse l-why else exit #0)
  else if orB (h-eq tool "Grep") (h-eq tool "Glob") then
    (if orB (l-any (λ k → h-infix ".cub" (l-field k call)) (cons "path" (cons "pattern" (cons "glob" nil))))
          (orB (h-eq (l-field "type" call) "cub")
               (andB (h-eq tool "Grep") (andB (h-null (l-field "glob" call)) (andB (h-null (l-field "type" call)) (l-grep-in-repo call)))))
     then l-refuse (list-append l-why " (a search of the repository reaches .cub files: name a non-.cub glob or type)") else exit #0)
  else if h-eq tool "Bash" then
    (if l-any l-segment-bad (l-segments-onto nil (l-field "command" call)) then l-refuse (list-append l-why " (this command reaches where code is kept)") else exit #0)
  else exit #0
l-judge : List Word → Proc W Unit
l-judge call = l-judge-tool call (l-field "tool_name" call)
l-main : Proc W Unit
l-main = bind h-stdin l-judge
-- l-run: the leash: an agent reads and changes the work only through hyperactive (part of product-implementation)
l-run : Step W Unit
l-run = to-step l-main
#run l-run
