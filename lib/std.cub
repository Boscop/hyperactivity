-- std.cub — the checked library: data types, paths, equivalences, univalence, natural-number
-- arithmetic. Every definition here is checked by lib/check.cub. Loaded after prelude.cub,
-- code.cub and check.cub.

-- ---------------------------------------------------------------- paths as equality
infix 4 ≡
infixr 5 ∙

-- a path in a type, its type left to be found
_≡_ : {l : Level} {A : Type l} → A → A → Type l
x ≡ y = PathP (λ i → A) x y

-- a path in a type given
Path : {l : Level} (A : Type l) → A → A → Type l
Path A x y = PathP (λ i → A) x y

-- std.ctt — the checked library: data types, paths, equivalences, univalence,
-- natural-number arithmetic. Every definition here is checked by lib/check.ctt.
-- Loaded after prelude.ctt, code.ctt and check.ctt.
-- ---------------------------------------------------------------- data
#check-data Bool
#check-data Nat
#check-data List
data Empty
data Unit = unit
data Sum (A : Type) (B : Type) = inl (a : A) | inr (b : B)
data Int = pos (n : Nat) | negsuc (n : Nat)
Neg : Type → Type
Neg A = A → Empty
Empty-rec : {l : Level} {A : Type l} → Empty → A
Empty-rec e = case e of Empty
-- ---------------------------------------------------------------- paths
refl : {l : Level} {A : Type l} {x : A} → x ≡ x
refl = λ i → x
sym : {l : Level} {A : Type l} {x y : A} → x ≡ y → y ≡ x
sym p = λ i → p (~ i)
cong : {l m : Level} {A : Type l} {B : Type m} → (f : A → B) → {x y : A} → x ≡ y → f x ≡ f y
cong f p = λ i → f (p i)
funExt : {l m : Level} {A : Type l} {B : Type m} {f g : A → B} → ((x : A) → f x ≡ g x) → f ≡ g
funExt h = λ i x → h x i
happly : {l m : Level} {A : Type l} {B : Type m} {f g : A → B} → f ≡ g → {x : A} → f x ≡ g x
happly p = λ i → p i x
-- composition of paths, by hcomp
concat : {l : Level} {A : Type l} {x y z : A} → x ≡ y → y ≡ z → x ≡ z
concat p q = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)
transport : {l : Level} {A B : Type l} → A ≡ B → A → B
transport p a = comp (λ i → p i) (λ i → []) a
-- transport along refl is the identity, up to a path (there is no regularity)
transportRefl : {l : Level} {A : Type l} {a : A} → transport (λ i → A) a ≡ a
transportRefl = λ i → comp (λ j → A) (λ j → [ i = 1 ↦ a ]) a
subst : {l m : Level} {A : Type l} {B : A → Type m} {x y : A} → x ≡ y → B x → B y
subst p b = comp (λ i → B (p i)) (λ i → []) b
-- a path over a line of types from transport: toPathP
toPathP : {l : Level} {A0 A1 : Type l} {A : A0 ≡ A1} {x : A0} {y : A1} →
                                                              transport A x ≡ y → PathP A x y
toPathP p =
  λ i →
    comp (λ j → A i) (λ j → [ i = 0 ↦ x , i = 1 ↦ p j ])
      (comp (λ j → A (i /\ j)) (λ j → [ i = 0 ↦ x ]) x)
-- ---------------------------------------------------------------- contractibility, equivalences
isContr : {l : Level} → Type l → Type l
isContr A = (c : A) × ((x : A) → c ≡ x)
isProp : {l : Level} → Type l → Type l
isProp A = (a b : A) → a ≡ b
fiber : {l m : Level} {A : Type l} {B : Type m} → (A → B) → B → Type (lmax l m)
fiber f y = (x : A) × f x ≡ y
isEquiv : {l m : Level} {A : Type l} {B : Type m} → (A → B) → Type (lmax l m)
isEquiv f = (y : B) → isContr (fiber f y)
Equiv : {l m : Level} → Type l → Type m → Type (lmax l m)
Equiv A B = (f : A → B) × isEquiv f
idIsEquiv : {l : Level} {A : Type l} → isEquiv {l} {l} {A} {A} (λ x → x)
idIsEquiv = λ y → ((y , λ i → y) , λ z i → (snd z (~ i) , λ j → snd z (~ i \/ j)))
idEquiv : {l : Level} {A : Type l} → Equiv A A
idEquiv = (λ x → x , idIsEquiv {l} {A})
-- an isomorphism is an equivalence (the fibre's contraction, lemIso)
lemIso : {l : Level} {A B : Type l} (f : A → B) (g : B → A) →
                                                ((b : B) → f (g b) ≡ b) →
                                                ((a : A) → g (f a) ≡ a) →
                                                {y : B} {x0 x1 : A} →
                                                        (p0 : f x0 ≡ y) →
                                                        (p1 : f x1 ≡ y) →
                                                        Path (fiber f y) (x0 , p0) (x1 , p1)
lemIso f g s t p0 p1 =
  let fill0 = λ i j →
                comp (λ k → A)
                  (λ k → [ j = 0 ↦ g (p0 (~ i)) , i = 1 ↦ t x0 (j /\ k) , i = 0 ↦ g y ])
                  (g (p0 (~ i)))
      fill1 = λ i j →
                comp (λ k → A)
                  (λ k → [ j = 0 ↦ g (p1 (~ i)) , i = 1 ↦ t x1 (j /\ k) , i = 0 ↦ g y ])
                  (g (p1 (~ i)))
      fill2 = λ i j →
                comp (λ k → A)
                  (λ k → [ j = 0 ↦ g y , i = 1 ↦ fill1 (j /\ k) i1 , i = 0 ↦ fill0 (j /\ k) i1 ])
                  (g y)
      p = λ i → fill2 i i1
      sq = λ i j →
             comp (λ k → A)
               (λ k →
                  [ i = 1 ↦ fill1 j (~ k)
                  , i = 0 ↦ fill0 j (~ k)
                  , j = 1 ↦ t (p i) (~ k)
                  , j = 0 ↦ g y ]) (fill2 i j)
      sq1 = λ i j →
              comp (λ k → B)
                (λ k →
                   [ i = 1 ↦ s (p1 (~ j)) k
                   , i = 0 ↦ s (p0 (~ j)) k
                   , j = 1 ↦ s (f (p i)) k
                   , j = 0 ↦ s y k ]) (f (sq i j))
  in λ i → (p i , λ j → sq1 i (~ j))
isoToEquiv : {l : Level} {A B : Type l} (f : A → B) (g : B → A) →
                                                    ((b : B) → f (g b) ≡ b) →
                                                    ((a : A) → g (f a) ≡ a) → Equiv A B
isoToEquiv f g s t = (f , λ y → ((g y , s y) , λ z → lemIso f g s t (s y) (snd z)))
-- ---------------------------------------------------------------- univalence
ua : {l : Level} {A B : Type l} → Equiv A B → A ≡ B
ua e = λ i → Glue B [ i = 0 ↦ (A , e) , i = 1 ↦ (B , idEquiv {l} {B}) ]
-- transport along ua e is e's map: unglue of the transport filler is a path from e a to it
uaβ : {l : Level} {A B : Type l} → (e : Equiv A B) → {a : A} → transport (ua e) a ≡ fst e a
uaβ e =
  λ k →
    unglue [ (~ k) = 0 ↦ (A , e) , (~ k) = 1 ↦ (B , idEquiv {l} {B}) ]
      (comp (λ j → ua e (~ k /\ j)) (λ j → [ (~ k) = 0 ↦ a ]) a)
-- a path of types gives an equivalence: transport, an equivalence by transport of the identity's.
-- (η-expanded: its value is a closure over its code, which conversion compares without applying)
transportIsEquiv : {l : Level} {A B : Type l} → (p : A ≡ B) → isEquiv (transport p)
transportIsEquiv p =
  λ y →
    comp (λ i → isEquiv {l} {l} {A} {p i} (λ x → comp (λ j → p (i /\ j)) (λ j → [ i = 0 ↦ x ]) x))
      (λ i → []) (idIsEquiv {l} {A}) y
pathToEquiv : {l : Level} {A B : Type l} → A ≡ B → Equiv A B
pathToEquiv p = (transport p , transportIsEquiv p)
-- ---------------------------------------------------------------- propositions
isPropIsContr : {l : Level} {A : Type l} → isProp (isContr A)
isPropIsContr =
  λ z w j →
    (snd z (fst w) j
    , λ y i →
        comp (λ k → A)
          (λ k →
             [ i = 0 ↦ snd z (snd z (fst w) j) k
             , i = 1 ↦ snd z y k
             , j = 0 ↦ snd z (snd z y i) k
             , j = 1 ↦ snd z (snd w y i) k ]) (fst z))
isPropIsEquiv : {l m : Level} {A : Type l} {B : Type m} → (f : A → B) → isProp (isEquiv f)
isPropIsEquiv f = λ u v i y → isPropIsContr (u y) (v y) i
-- over a line of types whose end is a proposition, any two ends are joined
isProp→PathP : {l : Level} {B0 B1 : Type l} (B : B0 ≡ B1) → isProp B1 → (b0 : B0) (b1 : B1) → PathP B b0 b1
isProp→PathP B h b0 b1 = toPathP (h (transport B b0) b1)
-- a path in a Σ-type whose second components are propositions is a path of the first
-- components (Σ≡Prop, at the family isEquiv; the propositionality is an argument)
equivEq : {l : Level} {A B : Type l} →
                      ((f : A → B) → isProp (isEquiv f)) →
                      {e1 e2 : Equiv A B} → fst e1 ≡ fst e2 → e1 ≡ e2
equivEq hp p = λ i → (p i , isProp→PathP (λ j → isEquiv (p j)) (hp (fst e2)) (snd e1) (snd e2) i)
-- ua is a section of pathToEquiv
pathToEquiv-ua : {l : Level} {A B : Type l} → (e : Equiv A B) → pathToEquiv (ua e) ≡ e
pathToEquiv-ua e =
  equivEq (isPropIsEquiv {l} {l} {A} {B})
    (funExt {l} {l} {A} {B} {transport (ua e)} {fst e} (λ a → uaβ e))
-- ---------------------------------------------------------------- natural numbers
plus : Nat → Nat → Nat
plus m n = case m of zero → n; suc k → suc (rec k)
times : Nat → Nat → Nat
times m n = case m of zero → zero; suc k → plus n (rec k)
pow : Nat → Nat → Nat
pow m n = case n of zero → suc zero; suc k → times m (rec k)
fact : Nat → Nat
fact n = case n of zero → suc zero; suc k → times (suc k) (rec k)
predN : Nat → Nat
predN n = case n of zero → zero; suc k → k
congN : (f : Nat → Nat) → {a b : Nat} → a ≡ b → f a ≡ f b
congN f p = λ i → f (p i)
symN : {a b : Nat} → a ≡ b → b ≡ a
symN p = λ i → p (~ i)
transN : {a b c : Nat} → a ≡ b → b ≡ c → a ≡ c
transN p q = λ i → comp (λ j → Nat) (λ j → [ i = 0 ↦ a , i = 1 ↦ q j ]) (p i)
-- suc n is not zero: a predicate true at zero and empty at suc
isZero : Nat → Type
isZero n = case n of zero → Unit; suc k → Empty
snotz : {n : Nat} → Path Nat (suc n) zero → Empty
snotz p = comp (λ i → isZero (p (~ i))) (λ i → []) unit
-- the semiring laws, by induction
plus-zero : (n : Nat) → plus n zero ≡ n
plus-zero n = case n return λ y → plus y zero ≡ y of zero → λ i → zero; suc k → λ i → suc (rec k i)
plus-suc : (m n : Nat) → plus m (suc n) ≡ suc (plus m n)
plus-suc m n =
  case m return λ y → plus y (suc n) ≡ suc (plus y n) of
    zero → λ i → suc n
    suc k → λ i → suc (rec k i)
plus-comm : (m n : Nat) → plus m n ≡ plus n m
plus-comm m n =
  case m return λ y → plus y n ≡ plus n y of
    zero → symN (plus-zero n)
    suc k → transN (λ i → suc (rec k i)) (symN (plus-suc n k))
plus-assoc : (a b c : Nat) → plus (plus a b) c ≡ plus a (plus b c)
plus-assoc a b c =
  case a return λ y → plus (plus y b) c ≡ plus y (plus b c) of
    zero → λ i → plus b c
    suc k → λ i → suc (rec k i)
plus-comm-mid : (a b c : Nat) → plus a (plus b c) ≡ plus b (plus a c)
plus-comm-mid a b c =
  transN (symN (plus-assoc a b c))
    (transN (congN (λ z → plus z c) (plus-comm a b)) (plus-assoc b a c))
times-zero : (n : Nat) → times n zero ≡ zero
times-zero n = case n return λ y → times y zero ≡ zero of zero → λ i → zero; suc k → rec k
times-suc : (m n : Nat) → times m (suc n) ≡ plus m (times m n)
times-suc m n =
  case m return λ y → times y (suc n) ≡ plus y (times y n) of
    zero → λ i → zero
    suc k → 
      λ i →
        suc
          (transN (congN (plus n) (rec k))
             (transN (symN (plus-assoc n k (times k n)))
                (transN (congN (λ x → plus x (times k n)) (plus-comm n k))
                   (plus-assoc k n (times k n)))) i)
times-comm : (m n : Nat) → times m n ≡ times n m
times-comm m n =
  case m return λ y → times y n ≡ times n y of
    zero → symN (times-zero n)
    suc k → transN (congN (plus n) (rec k)) (symN (times-suc n k))
times-distr : (a b c : Nat) → times (plus a b) c ≡ plus (times a c) (times b c)
times-distr a b c =
  case a return λ y → times (plus y b) c ≡ plus (times y c) (times b c) of
    zero → λ i → times b c
    suc k → transN (congN (plus c) (rec k)) (symN (plus-assoc c (times k c) (times b c)))
times-assoc : (a b c : Nat) → times (times a b) c ≡ times a (times b c)
times-assoc a b c =
  case a return λ y → times (times y b) c ≡ times y (times b c) of
    zero → λ i → zero
    suc k → transN (times-distr b (times k b) c) (congN (plus (times b c)) (rec k))
times-one : (n : Nat) → times n (suc zero) ≡ n
times-one n =
  case n return λ y → times y (suc zero) ≡ y of zero → λ i → zero; suc k → λ i → suc (rec k i)
-- the order: m ≤ n is a k with k + m = n
cong2N : (f : Nat → Nat → Nat) → {a a2 b b2 : Nat} → a ≡ a2 → b ≡ b2 → f a b ≡ f a2 b2
cong2N f p q = λ i → f (p i) (q i)
le : Nat → Nat → Type
le m n = (k : Nat) × plus k m ≡ n
le-refl : (n : Nat) → le n n
le-refl n = (zero , λ i → n)
-- ---------------------------------------------------------------- the order that computes, and recursion along it
-- m < n is Unit or Empty on numerals: a proof of it on numerals is unit
-- (by recursion on the bound: m < zero is Empty whatever m is)
above : Nat → Nat → Type
above zero m = Empty
above (suc n) zero = Unit
above (suc n) (suc m) = above n m
infix 4 <
_<_ : Nat → Nat → Type
m < n = above n m
<-suc-self : (n : Nat) → n < suc n
<-suc-self zero = unit
<-suc-self (suc n) = <-suc-self n
<-step : (a b c : Nat) → a < b → b < suc c → a < c
<-step a zero c h k = Empty-rec h
<-step zero (suc b) zero h k = Empty-rec k
<-step zero (suc b) (suc c) h k = unit
<-step (suc a) (suc b) zero h k = Empty-rec k
<-step (suc a) (suc b) (suc c) h k = <-step a b c h k
-- a definition whose calls decrease a measure (decreasing by m): recursion on a bound of the measure
wf-go : {A : Type} {P : A → Type} → (m : A → Nat) → ((x : A) → ((y : A) → m y < m x → P y) → P x) →
        (n : Nat) → (x : A) → m x < n → P x
wf-go m s zero x h = Empty-rec h
wf-go m s (suc n) x h = s x (λ y hy → wf-go m s n y (<-step (m y) (m x) n hy h))
wfrec : {A : Type} {P : A → Type} → (m : A → Nat) → ((x : A) → ((y : A) → m y < m x → P y) → P x) → (x : A) → P x
wfrec m s x = wf-go m s (suc (m x)) x (<-suc-self (m x))
-- ---------------------------------------------------------------- booleans, integers
not : Bool → Bool
not b = if b then false else true
isTrue : Bool → Type
isTrue b = if b then Unit else Empty
true≢false : Path Bool true false → Empty
true≢false p = comp (λ i → isTrue (p i)) (λ i → []) unit
negZ : Int → Int
negZ z = case z of pos n → (case n of zero → pos zero; suc k → negsuc k); negsuc n → pos (suc n)
-- a boolean as a proposition: isTrue b is a proposition, inhabited exactly when b = true
isProp-isTrue : (b : Bool) → isProp (isTrue b)
isProp-isTrue b =
  case b return λ y → isProp (isTrue y) of
    true → 
      λ u v → case u return λ w → w ≡ v of unit → case v return λ w → unit ≡ w of unit → λ i → unit
    false → λ u v → Empty-rec u
isTrue→eq : {b : Bool} → isTrue b → b ≡ true
isTrue→eq h =
  (case b return λ y → isTrue y → y ≡ true of true → λ h i → true; false → λ h → Empty-rec h) h
eq→isTrue : {b : Bool} → b ≡ true → isTrue b
eq→isTrue e = subst {_} {_} {_} {isTrue} (sym e) unit
-- case on a boolean, each branch given the equation that selected it
ifP : {P : Bool → Type} {b : Bool} → (b ≡ true → P true) → (b ≡ false → P false) → P b
ifP t f = (case b return λ bb → b ≡ bb → P bb of true → t; false → f) (λ i → b)
andB : Bool → Bool → Bool
andB a b = if a then b else false
and-fst : {a b : Bool} → isTrue (andB a b) → isTrue a
and-fst h =
  (case a return λ y → isTrue (andB y b) → isTrue y of
     true → λ h → unit
     false → λ h → Empty-rec h) h
and-snd : {a b : Bool} → isTrue (andB a b) → isTrue b
and-snd h =
  (case a return λ y → isTrue (andB y b) → isTrue b of true → λ h → h; false → λ h → Empty-rec h) h
and-intro : {a b : Bool} → isTrue a → isTrue b → isTrue (andB a b)
and-intro p q =
  (case a return λ y → isTrue y → isTrue b → isTrue (andB y b) of
     true → λ p q → q
     false → λ p q → Empty-rec p) p q
-- propositions are closed under × and Π
isProp× : {A B : Type} → isProp A → isProp B → isProp (A × B)
isProp× pa pb = λ u v i → (pa (fst u) (fst v) i , pb (snd u) (snd v) i)
isPropPi : {A : Type} {B : A → Type} → ((a : A) → isProp (B a)) → isProp ((a : A) → B a)
isPropPi h = λ f g i a → h a (f a) (g a) i
-- decidable equality on Nat, and cancellation
eqb : Nat → Nat → Bool
eqb m n =
  (case m return λ y → Nat → Bool of
     zero → λ n → case n of zero → true; suc k → false
     suc m1 → λ n → case n of zero → false; suc n1 → rec m1 n1) n
eqb-sound : {m n : Nat} → isTrue (eqb m n) → m ≡ n
eqb-sound e =
  (case m return λ y → (n : Nat) → isTrue (eqb y n) → y ≡ n of
     zero → 
       λ n →
         case n return λ z → isTrue (eqb zero z) → zero ≡ z of
           zero → λ e i → zero
           suc k → λ e → Empty-rec e
     suc m1 → 
       λ n →
         case n return λ z → isTrue (eqb (suc m1) z) → suc m1 ≡ z of
           zero → λ e → Empty-rec e
           suc n1 → λ e i → suc (rec m1 n1 e i)) n e
eqb-refl : (n : Nat) → isTrue (eqb n n)
eqb-refl n = case n return λ y → isTrue (eqb y y) of zero → unit; suc k → rec k
eqb-complete : {m n : Nat} → m ≡ n → isTrue (eqb m n)
eqb-complete p = subst {_} {_} {_} {λ k → isTrue (eqb m k)} p (eqb-refl m)
suc-inj : {m n : Nat} → Path Nat (suc m) (suc n) → m ≡ n
suc-inj p = congN predN p
plus-cancel : {k m n : Nat} → plus k m ≡ plus k n → m ≡ n
plus-cancel p =
  (case k return λ w → (m n : Nat) → plus w m ≡ plus w n → m ≡ n of
     zero → λ m n p → p
     suc k1 → λ m n p → rec k1 m n (suc-inj p)) m n p
-- ---------------------------------------------------------------- words
-- A word is a natural number held in one cell: #n, the successor (%wsucc w), and the elimination
-- (%welimP P w z s): z : P #0, s : Π n. P n → P (n+1). Word ≃ Nat is proved here. Each of the
-- machine's operations on words (%wadd %weq %wlt %wmax %wsub) is a definition (wadd weq wlt wmax
-- wsub), the one code calls; beside it are the operation's definition by induction (plusw eqw ltw
-- maxw subw) and a proof that the two are equal (plusw≡wadd ...). Words are exact: a number that
-- does not fit in 64 bits is held as its limbs.
toNat : Word → Nat
toNat w = %welimP (λ v → Nat) w zero (λ n h → suc h)
fromNat : Nat → Word
fromNat n = case n of zero → #0; suc k → %wsucc (rec k)
toNat-fromNat : (n : Nat) → toNat (fromNat n) ≡ n
toNat-fromNat n =
  case n return λ y → toNat (fromNat y) ≡ y of zero → λ i → zero; suc k → λ i → suc (rec k i)
fromNat-toNat : (w : Word) → fromNat (toNat w) ≡ w
fromNat-toNat w = %welimP (λ v → fromNat (toNat v) ≡ v) w (λ i → #0) (λ n h i → %wsucc (h i))
Word≃Nat : Equiv Word Nat
Word≃Nat = isoToEquiv toNat fromNat toNat-fromNat fromNat-toNat
Word≡Nat : Word ≡ Nat
Word≡Nat = ua Word≃Nat
-- addition, by recursion on the second argument
plusw : Word → Word → Word
plusw a b = %welimP (λ v → Word) b a (λ n h → %wsucc h)
wadd : Word → Word → Word
wadd a b = %wadd a b
plusw≡wadd : (a b : Word) → plusw a b ≡ wadd a b
plusw≡wadd a b = %welimP (λ v → plusw a v ≡ wadd a v) b (λ i → a) (λ n h i → %wsucc (h i))
#same plusw #3 #4 = #7
-- equality, order, max and truncated subtraction, by recursion on both arguments
eqw : Word → Word → Bool
eqw a b =
  %welimP (λ v → Word → Bool) a (λ b → %welimP (λ v → Bool) b true (λ m g → false))
    (λ n h b → %welimP (λ v → Bool) b false (λ m g → h m)) b
weq : Word → Word → Bool
weq a b = %weq a b
eqw≡weq : (a b : Word) → eqw a b ≡ weq a b
eqw≡weq a b =
  %welimP (λ v → (b : Word) → eqw v b ≡ weq v b) a
    (λ b → %welimP (λ v → eqw #0 v ≡ weq #0 v) b (λ i → true) (λ m g i → false))
    (λ n h b → %welimP (λ v → eqw (%wsucc n) v ≡ weq (%wsucc n) v) b (λ i → false) (λ m g → h m)) b
ltw : Word → Word → Bool
ltw a b =
  %welimP (λ v → Word → Bool) a (λ b → %welimP (λ v → Bool) b false (λ m g → true))
    (λ n h b → %welimP (λ v → Bool) b false (λ m g → h m)) b
wlt : Word → Word → Bool
wlt a b = %wlt a b
ltw≡wlt : (a b : Word) → ltw a b ≡ wlt a b
ltw≡wlt a b =
  %welimP (λ v → (b : Word) → ltw v b ≡ wlt v b) a
    (λ b → %welimP (λ v → ltw #0 v ≡ wlt #0 v) b (λ i → false) (λ m g i → true))
    (λ n h b → %welimP (λ v → ltw (%wsucc n) v ≡ wlt (%wsucc n) v) b (λ i → false) (λ m g → h m)) b
maxw : Word → Word → Word
maxw a b =
  %welimP (λ v → Word → Word) a (λ b → b)
    (λ n h b → %welimP (λ v → Word) b (%wsucc n) (λ m g → %wsucc (h m))) b
wmax : Word → Word → Word
wmax a b = %wmax a b
maxw≡wmax : (a b : Word) → maxw a b ≡ wmax a b
maxw≡wmax a b =
  %welimP (λ v → (b : Word) → maxw v b ≡ wmax v b) a (λ b i → b)
    (λ n h b →
       %welimP (λ v → maxw (%wsucc n) v ≡ wmax (%wsucc n) v) b (λ i → %wsucc n)
         (λ m g i → %wsucc (h m i))) b
subw : Word → Word → Word
subw a b =
  %welimP (λ v → Word → Word) a (λ b → #0)
    (λ n h b → %welimP (λ v → Word) b (%wsucc n) (λ m g → h m)) b
wsub : Word → Word → Word
wsub a b = %wsub a b
subw≡wsub : (a b : Word) → subw a b ≡ wsub a b
subw≡wsub a b =
  %welimP (λ v → (b : Word) → subw v b ≡ wsub v b) a (λ b i → #0)
    (λ n h b →
       %welimP (λ v → subw (%wsucc n) v ≡ wsub (%wsucc n) v) b (λ i → %wsucc n) (λ m g → h m)) b
#same eqw #5 #5 = true
#same ltw #2 #9 = true
#same maxw #4 #9 = #9
#same subw #4 #9 = #0
-- an equation that does not hold is rejected: neither eqw≡weq nor a constant line proves eqw = wlt
#fail
#check eqw≡weq : (a b : Word) → eqw a b ≡ wlt a b
#fail
#check λ a b i → eqw a b : (a b : Word) → eqw a b ≡ wlt a b
-- words are exact: past 2^64 a word cell holds its digits
#same wadd (wadd #9223372036854775807 #9223372036854775807) #2 = #18446744073709551616
#same weq (wadd #18446744073709551615 #1) #0 = false
#same wsub #340282366920938463463374607431768211456 #1 = #340282366920938463463374607431768211455
