skfold : (I : Type 2) (Ln : I → I) (S : Lst Entry → I → Type 1) (T : I → Type 1) (Dat : Lst Entry → Type)
  (dfst : (sq : Lst Entry) → Dat (lcons e-dim sq) → Dat sq) (dsnd : (sq : Lst Entry) → Dat (lcons e-dim sq) → DNF)
  (dty : (s : TyShape) (sq : Lst Entry) → Dat (lcons (e-ty s) sq) → Dat sq)
  (cty : (s : TyShape) (sq : Lst Entry) (iq : I) → S (lcons (e-ty s) sq) iq → S sq iq) (cdm : (sq : Lst Entry) (iq : I) → S (lcons e-dim sq) iq → S sq (Ln iq))
  (base : (iq : I) → S lnil iq → T iq) (step : DNF → (iq : I) → T (Ln iq) → T iq) →
  (sk : Lst Entry) → Dat sk → (i : I) → S sk i → T i
skfold I Ln S T Dat dfst dsnd dty cty cdm base step lnil σ i x = base i x
skfold I Ln S T Dat dfst dsnd dty cty cdm base step (lcons (e-ty s) sk) σ i x =
  skfold I Ln S T Dat dfst dsnd dty cty cdm base step sk (dty s sk σ) i (cty s sk i x)
skfold I Ln S T Dat dfst dsnd dty cty cdm base step (lcons e-dim sk) σ i x =
  step (dsnd sk σ) i (skfold I Ln S T Dat dfst dsnd dty cty cdm base step sk (dfst sk σ) (Ln i) (cdm sk i x))
