-- lib/cube.cub — cubes, the interval in disjunctive normal form, and path application, for lib/nbe.cub.
-- Lines are lines over a path of types (LnF), so each line operation is written once and the base and
-- fibre versions are its two uses. Path application is one fold over interval expressions (pfold) with
-- its displayed fold (dfold); the diagonal at a name is one fold over the skeleton (gdiag, dgdiag); the
-- action of a cube map is one fold over the skeleton (skfold, dskfold). Each fold has one commutation
-- lemma for maps over a fixed base (…-nat) and one for maps that move the base (…-sub, …-tot), plus the
-- fold on a section (pfold-sec, dfold-sec); every old per-form lemma is an instance of these.
import "core.cub"
data FamF = f-pi | f-sig
data TyShape = s-bool | s-fam (fq : FamF) (a : TyShape) (b : TyShape) | s-path (a : TyShape)
One1 : Type 1
One1 = (X : Type) × PathP (λ i → Type) X Bool
one : One1
one = (Bool , λ i → Bool)
one-contr : (u : One1) → PathP (λ i → One1) u one
one-contr u = λ i → (snd u i , λ j → snd u (i \/ j))
data Entry = e-ty (s : TyShape) | e-dim
dims : Lst Entry → Nat
dims lnil = zero
dims (lcons (e-ty s) sk) = dims sk
dims (lcons e-dim sk) = suc (dims sk)
bool-elim1 : (P : Bool → Type 1) → P true → P false → (b : Bool) → P b
bool-elim1 P t f true = t
bool-elim1 P t f false = f
pcat : (A : Type 1) (x y z : A) → PathP (λ i → A) x y → PathP (λ i → A) y z → PathP (λ i → A) x z
pcat A x y z p q = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)
psym : (A : Type 1) (x y : A) → PathP (λ i → A) x y → PathP (λ i → A) y x
psym A x y p = λ i → p (~ i)
cong1 : (A B : Type 1) (f : A → B) (x y : A) → PathP (λ i → A) x y → PathP (λ i → B) (f x) (f y)
cong1 A B f x y p = λ i → f (p i)
pcat-d : (A : Type 1) (B : A → Type 1) (x y z : A) (p : PathP (λ i → A) x y) (q : PathP (λ i → A) y z)
  (bx : B x) (b1 : B y) (bz : B z) → PathP (λ i → B (p i)) bx b1 → PathP (λ i → B (q i)) b1 bz →
  PathP (λ i → B (pcat A x y z p q i)) bx bz
pcat-d A B x y z p q bx b1 bz P Q = λ i →
  comp (λ j → B (comp (λ k → A) (λ k → [ i = 0 ↦ x , i = 1 ↦ q (j ∧ k) , j = 0 ↦ p i ]) (p i)))
    (λ j → [ i = 0 ↦ bx , i = 1 ↦ Q j ]) (P i)
psym-d : (A : Type 1) (B : A → Type 1) (x y : A) (p : PathP (λ i → A) x y) (bx : B x) (b1 : B y) →
  PathP (λ i → B (p i)) bx b1 → PathP (λ i → B (psym A x y p i)) b1 bx
psym-d A B x y p bx b1 P = λ i → P (~ i)
LnF : (A0 A1 : Type 1) → PathP (λ i → Type 1) A0 A1 → Type 1
LnF A0 A1 A = (a0 : A0) × (a1 : A1) × PathP (λ i → A i) a0 a1
Line : Type 1 → Type 1
Line X = LnF X X (λ i → X)
LineO : (X : Type 1) (Y : X → Type 1) → Line X → Type 1
LineO X Y L = LnF (Y (fst L)) (Y (fst (snd L))) (λ i → Y (snd (snd L) i))
Cube : Nat → Type 1 → Type 1
Cube zero X = X
Cube (suc n) X = Cube n (Line X)
DCube : (n : Nat) (X : Type 1) (Y : X → Type 1) → Cube n X → Type 1
DCube zero X Y c = Y c
DCube (suc n) X Y c = DCube n (Line X) (LineO X Y) c
ln-rev : (A0 A1 : Type 1) (A : PathP (λ i → Type 1) A0 A1) → LnF A0 A1 A → LnF A1 A0 (λ i → A (~ i))
ln-rev A0 A1 A L = (fst (snd L) , fst L , λ i → snd (snd L) (~ i))
ln-meet : (A0 A1 : Type 1) (A : PathP (λ i → Type 1) A0 A1) (L : LnF A0 A1 A) →
  LnF (LnF A0 A0 (λ j → A0)) (LnF A0 A1 A) (λ i → LnF A0 (A i) (λ j → A (i ∧ j)))
ln-meet A0 A1 A L = ((fst L , fst L , λ j → fst L) , L , λ i → (fst L , snd (snd L) i , λ j → snd (snd L) (i ∧ j)))
ln-join : (A0 A1 : Type 1) (A : PathP (λ i → Type 1) A0 A1) (L : LnF A0 A1 A) →
  LnF (LnF A0 A1 A) (LnF A1 A1 (λ j → A1)) (λ i → LnF (A i) A1 (λ j → A (i ∨ j)))
ln-join A0 A1 A L = (L , (fst (snd L) , fst (snd L) , λ j → fst (snd L)) , λ i → (snd (snd L) i , fst (snd L) , λ j → snd (snd L) (i ∨ j)))
line-map : (X Y : Type 1) → (X → Y) → Line X → Line Y
line-map X Y f L = (f (fst L) , f (fst (snd L)) , λ i → f (snd (snd L) i))
cube-map : (n : Nat) (X Y : Type 1) → (X → Y) → Cube n X → Cube n Y
cube-map zero X Y f c = f c
cube-map (suc n) X Y f c = cube-map n (Line X) (Line Y) (line-map X Y f) c
face0-l : (X : Type 1) → Line X → X
face0-l X L = fst L
face1-l : (X : Type 1) → Line X → X
face1-l X L = fst (snd L)
degen-l : (X : Type 1) → X → Line X
degen-l X x = (x , x , λ i → x)
rev-l : (X : Type 1) → Line X → Line X
rev-l X L = ln-rev X X (λ i → X) L
meet-l : (X : Type 1) → Line X → Line (Line X)
meet-l X L = ln-meet X X (λ i → X) L
join-l : (X : Type 1) → Line X → Line (Line X)
join-l X L = (L , (fst (snd L) , fst (snd L) , λ j → fst (snd L)) , λ i → (snd (snd L) i , fst (snd L) , λ j → snd (snd L) (i ∨ j)))
exch-l : (X : Type 1) → Line (Line X) → Line (Line X)
exch-l X Q =
  ((fst (fst Q) , fst (fst (snd Q)) , λ i → fst (snd (snd Q) i)) ,
   (fst (snd (fst Q)) , fst (snd (fst (snd Q))) , λ i → fst (snd (snd (snd Q) i))) ,
   λ j → (snd (snd (fst Q)) j , snd (snd (fst (snd Q))) j , λ i → snd (snd (snd (snd Q) i)) j))
diag-l : (X : Type 1) → Line (Line X) → Line X
diag-l X Q = (fst (fst Q) , fst (snd (fst (snd Q))) , λ i → snd (snd (snd (snd Q) i)) i)
lineo-map : (X : Type 1) (Y : X → Type 1) (Z : Type 1) → ((x : X) → Y x → Z) → (L : Line X) → LineO X Y L → Line Z
lineo-map X Y Z f L D = (f (fst L) (fst D) , f (fst (snd L)) (fst (snd D)) , λ i → f (snd (snd L) i) (snd (snd D) i))
dcube-map : (n : Nat) (X : Type 1) (Y : X → Type 1) (Z : Type 1) → ((x : X) → Y x → Z) → (c : Cube n X) → DCube n X Y c → Cube n Z
dcube-map zero X Y Z f c d = f c d
dcube-map (suc n) X Y Z f c d = dcube-map n (Line X) (LineO X Y) (Line Z) (lineo-map X Y Z f) c d
lineo-of : (X : Type 1) (Y : X → Type 1) → ((x : X) → Y x) → (L : Line X) → LineO X Y L
lineo-of X Y f L = (f (fst L) , f (fst (snd L)) , λ i → f (snd (snd L) i))
dcube-of : (n : Nat) (X : Type 1) (Y : X → Type 1) → ((x : X) → Y x) → (c : Cube n X) → DCube n X Y c
dcube-of zero X Y f c = f c
dcube-of (suc n) X Y f c = dcube-of n (Line X) (LineO X Y) (lineo-of X Y f) c
lineo-fmap : (X : Type 1) (F F' : X → Type 1) → ((x : X) → F x → F' x) → (L : Line X) → LineO X F L → LineO X F' L
lineo-fmap X F F' h L D = (h (fst L) (fst D) , h (fst (snd L)) (fst (snd D)) , λ i → h (snd (snd L) i) (snd (snd D) i))
dcube-fmap : (n : Nat) (X : Type 1) (F F' : X → Type 1) → ((x : X) → F x → F' x) → (c : Cube n X) → DCube n X F c → DCube n X F' c
dcube-fmap zero X F F' h c d = h c d
dcube-fmap (suc n) X F F' h c d = dcube-fmap n (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h) c d
lineo-zip : (X : Type 1) (F F' F2 : X → Type 1) → ((x : X) → F x → F' x → F2 x) → (L : Line X) → LineO X F L → LineO X F' L → LineO X F2 L
lineo-zip X F F' F2 h L D E =
  (h (fst L) (fst D) (fst E) , h (fst (snd L)) (fst (snd D)) (fst (snd E)) , λ i → h (snd (snd L) i) (snd (snd D) i) (snd (snd E) i))
dcube-zip : (n : Nat) (X : Type 1) (F F' F2 : X → Type 1) → ((x : X) → F x → F' x → F2 x) → (c : Cube n X) →
  DCube n X F c → DCube n X F' c → DCube n X F2 c
dcube-zip zero X F F' F2 h c d e = h c d e
dcube-zip (suc n) X F F' F2 h c d e = dcube-zip n (Line X) (LineO X F) (LineO X F') (LineO X F2) (lineo-zip X F F' F2 h) c d e
lineo-reidx : (X X' : Type 1) (F : X → Type 1) (F' : X' → Type 1) (f : X → X') → ((x : X) → F x → F' (f x)) →
  (L : Line X) → LineO X F L → LineO X' F' (line-map X X' f L)
lineo-reidx X X' F F' f g L D = (g (fst L) (fst D) , g (fst (snd L)) (fst (snd D)) , λ i → g (snd (snd L) i) (snd (snd D) i))
dcube-reidx : (n : Nat) (X X' : Type 1) (F : X → Type 1) (F' : X' → Type 1) (f : X → X') → ((x : X) → F x → F' (f x)) →
  (c : Cube n X) → DCube n X F c → DCube n X' F' (cube-map n X X' f c)
dcube-reidx zero X X' F F' f g c d = g c d
dcube-reidx (suc n) X X' F F' f g c d =
  dcube-reidx n (Line X) (Line X') (LineO X F) (LineO X' F') (line-map X X' f) (lineo-reidx X X' F F' f g) c d
lineo-push : (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') →
  ((x : X) (y : Y x) → F x → F' (f x y)) → (L : Line X) (D : LineO X Y L) → LineO X F L → LineO X' F' (lineo-map X Y X' f L D)
lineo-push X X' Y F F' f g L D E =
  (g (fst L) (fst D) (fst E) , g (fst (snd L)) (fst (snd D)) (fst (snd E)) , λ i → g (snd (snd L) i) (snd (snd D) i) (snd (snd E) i))
dcube-push : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') →
  ((x : X) (y : Y x) → F x → F' (f x y)) → (c : Cube n X) (d : DCube n X Y c) → DCube n X F c → DCube n X' F' (dcube-map n X Y X' f c d)
dcube-push zero X X' Y F F' f g c d e = g c d e
dcube-push (suc n) X X' Y F F' f g c d e =
  dcube-push n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-push X X' Y F F' f g) c d e
dcube-lift : (n : Nat) (X X' : Type 1) (Y : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') →
  ((x : X) (y : Y x) → F' (f x y)) → (c : Cube n X) (d : DCube n X Y c) → DCube n X' F' (dcube-map n X Y X' f c d)
dcube-lift n X X' Y F' f g c d = dcube-push n X X' Y Y F' f (λ x y z → g x y) c d d
lineo-pull : (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') →
  ((x : X) (y : Y x) → F' (f x y) → F x) → (L : Line X) (D : LineO X Y L) → LineO X' F' (lineo-map X Y X' f L D) → LineO X F L
lineo-pull X X' Y F F' f g L D E =
  (g (fst L) (fst D) (fst E) , g (fst (snd L)) (fst (snd D)) (fst (snd E)) , λ i → g (snd (snd L) i) (snd (snd D) i) (snd (snd E) i))
dcube-pull : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') →
  ((x : X) (y : Y x) → F' (f x y) → F x) → (c : Cube n X) (d : DCube n X Y c) → DCube n X' F' (dcube-map n X Y X' f c d) → DCube n X F c
dcube-pull zero X X' Y F F' f g c d e = g c d e
dcube-pull (suc n) X X' Y F F' f g c d e =
  dcube-pull n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g) c d e
face0-o : (X : Type 1) (F : X → Type 1) (L : Line X) → LineO X F L → F (face0-l X L)
face0-o X F L D = fst D
face1-o : (X : Type 1) (F : X → Type 1) (L : Line X) → LineO X F L → F (face1-l X L)
face1-o X F L D = fst (snd D)
degen-o : (X : Type 1) (F : X → Type 1) (x : X) → F x → LineO X F (degen-l X x)
degen-o X F x y = (y , y , λ i → y)
rev-o : (X : Type 1) (F : X → Type 1) (L : Line X) → LineO X F L → LineO X F (rev-l X L)
rev-o X F L D = ln-rev (F (fst L)) (F (fst (snd L))) (λ i → F (snd (snd L) i)) D
meet-o : (X : Type 1) (F : X → Type 1) (L : Line X) → LineO X F L → LineO (Line X) (LineO X F) (meet-l X L)
meet-o X F L D = ln-meet (F (fst L)) (F (fst (snd L))) (λ i → F (snd (snd L) i)) D
join-o : (X : Type 1) (F : X → Type 1) (L : Line X) → LineO X F L → LineO (Line X) (LineO X F) (join-l X L)
join-o X F L D = ln-join (F (fst L)) (F (fst (snd L))) (λ i → F (snd (snd L) i)) D
exch-o : (X : Type 1) (F : X → Type 1) (Q : Line (Line X)) → LineO (Line X) (LineO X F) Q → LineO (Line X) (LineO X F) (exch-l X Q)
exch-o X F Q D =
  ((fst (fst D) , fst (fst (snd D)) , λ i → fst (snd (snd D) i)) ,
   (fst (snd (fst D)) , fst (snd (fst (snd D))) , λ i → fst (snd (snd (snd D) i))) ,
   λ j → (snd (snd (fst D)) j , snd (snd (fst (snd D))) j , λ i → snd (snd (snd (snd D) i)) j))
diag-o : (X : Type 1) (F : X → Type 1) (Q : Line (Line X)) → LineO (Line X) (LineO X F) Q → LineO X F (diag-l X Q)
diag-o X F Q D = (fst (fst D) , fst (snd (fst (snd D))) , λ i → snd (snd (snd (snd D) i)) i)
cube-const : (n : Nat) (X : Type 1) → X → Cube n X
cube-const zero X x = x
cube-const (suc n) X x = cube-const n (Line X) (degen-l X x)
dcube-const : (n : Nat) (X : Type 1) (F : X → Type 1) (x : X) → F x → DCube n X F (cube-const n X x)
dcube-const zero X F x y = y
dcube-const (suc n) X F x y = dcube-const n (Line X) (LineO X F) (degen-l X x) (degen-o X F x y)
DL : (X : Type 1) (F : X → Type 1) → X → Type 1
DL X F x = LineO X F (degen-l X x)
Lit : Type
Lit = Word × Bool
bool-eq : Bool → Bool → Bool
bool-eq true b = b
bool-eq false b = not b
lit-eq : Lit → Lit → Bool
lit-eq a b = andB (weq (fst a) (fst b)) (bool-eq (snd a) (snd b))
lit-lt : Lit → Lit → Bool
lit-lt a b = if wlt (fst a) (fst b) then true else (if weq (fst a) (fst b) then andB (not (snd a)) (snd b) else false)
Conj : Type
Conj = Lst Lit
DNF : Type
DNF = Lst Conj
conj-ins : Lit → Conj → Conj
conj-ins l lnil = lcons l lnil
conj-ins l (lcons m ms) = if lit-eq l m then lcons m ms else (if lit-lt l m then lcons l (lcons m ms) else lcons m (conj-ins l ms))
conj-meet : Conj → Conj → Conj
conj-meet lnil d = d
conj-meet (lcons l ls) d = conj-ins l (conj-meet ls d)
conj-has : Lit → Conj → Bool
conj-has l lnil = false
conj-has l (lcons m ms) = if lit-eq l m then true else conj-has l ms
conj-sub : Conj → Conj → Bool
conj-sub lnil d = true
conj-sub (lcons l ls) d = andB (conj-has l d) (conj-sub ls d)
conj-eq : Conj → Conj → Bool
conj-eq lnil lnil = true
conj-eq lnil (lcons m ms) = false
conj-eq (lcons l ls) lnil = false
conj-eq (lcons l ls) (lcons m ms) = andB (lit-eq l m) (conj-eq ls ms)
conj-lt : Conj → Conj → Bool
conj-lt lnil lnil = false
conj-lt lnil (lcons m ms) = true
conj-lt (lcons l ls) lnil = false
conj-lt (lcons l ls) (lcons m ms) = if lit-lt l m then true else (if lit-eq l m then conj-lt ls ms else false)
dnf-any-sub : Conj → DNF → Bool
dnf-any-sub c lnil = false
dnf-any-sub c (lcons d ds) = if conj-sub d c then true else dnf-any-sub c ds
dnf-drop-sup : Conj → DNF → DNF
dnf-drop-sup c lnil = lnil
dnf-drop-sup c (lcons d ds) = if conj-sub c d then dnf-drop-sup c ds else lcons d (dnf-drop-sup c ds)
dnf-insert : Conj → DNF → DNF
dnf-insert c lnil = lcons c lnil
dnf-insert c (lcons d ds) = if conj-lt c d then lcons c (lcons d ds) else lcons d (dnf-insert c ds)
dnf-add : Conj → DNF → DNF
dnf-add c f = if dnf-any-sub c f then f else dnf-insert c (dnf-drop-sup c f)
dnf-join : DNF → DNF → DNF
dnf-join lnil g = g
dnf-join (lcons c cs) g = dnf-add c (dnf-join cs g)
dnf-meet-c : Conj → DNF → DNF
dnf-meet-c c lnil = lnil
dnf-meet-c c (lcons d ds) = dnf-add (conj-meet c d) (dnf-meet-c c ds)
dnf-meet : DNF → DNF → DNF
dnf-meet lnil g = lnil
dnf-meet (lcons c cs) g = dnf-join (dnf-meet-c c g) (dnf-meet cs g)
dnf-zero : DNF
dnf-zero = lnil
dnf-one : DNF
dnf-one = lcons lnil lnil
neg-conj : Conj → DNF
neg-conj lnil = dnf-zero
neg-conj (lcons l ls) = dnf-add (lcons (fst l , not (snd l)) lnil) (neg-conj ls)
dnf-neg : DNF → DNF
dnf-neg lnil = dnf-one
dnf-neg (lcons c cs) = dnf-meet (neg-conj c) (dnf-neg cs)
dnf-of : Code → Opt DNF
dnf-of ci0 = some dnf-zero
dnf-of ci1 = some dnf-one
dnf-of (cvar k) = some (lcons (lcons (k , true) lnil) lnil)
dnf-of (cneg r) = case dnf-of r of none → none; some f → some (dnf-neg f)
dnf-of (cmeet r s) = case dnf-of r of none → none; some f → (case dnf-of s of none → none; some g → some (dnf-meet f g))
dnf-of (cjoin r s) = case dnf-of r of none → none; some f → (case dnf-of s of none → none; some g → some (dnf-join f g))
dnf-of c = none
data IEx = ix0 | ix1 | ixv (k : Word) | ixneg (r : IEx) | ixmeet (r : IEx) (s : IEx) | ixjoin (r : IEx) (s : IEx)
iex-code : IEx → Code
iex-code ix0 = ci0
iex-code ix1 = ci1
iex-code (ixv k) = cvar k
iex-code (ixneg r) = cneg (iex-code r)
iex-code (ixmeet r s) = cmeet (iex-code r) (iex-code s)
iex-code (ixjoin r s) = cjoin (iex-code r) (iex-code s)
lit-ix : Lit → IEx
lit-ix l = if snd l then ixv (fst l) else ixneg (ixv (fst l))
conj-ix-from : Lit → Conj → IEx
conj-ix-from l lnil = lit-ix l
conj-ix-from l (lcons m ms) = ixmeet (lit-ix l) (conj-ix-from m ms)
conj-ix : Conj → IEx
conj-ix lnil = ix1
conj-ix (lcons l ls) = conj-ix-from l ls
dnf-ix-from : Conj → DNF → IEx
dnf-ix-from c lnil = conj-ix c
dnf-ix-from c (lcons d ds) = ixjoin (conj-ix c) (dnf-ix-from d ds)
dnf-ix : DNF → IEx
dnf-ix lnil = ix0
dnf-ix (lcons c cs) = dnf-ix-from c cs
dnf-code : DNF → Code
dnf-code f = iex-code (dnf-ix f)
dnf-eq : DNF → DNF → Bool
dnf-eq lnil lnil = true
dnf-eq lnil (lcons d ds) = false
dnf-eq (lcons c cs) lnil = false
dnf-eq (lcons c cs) (lcons d ds) = andB (conj-eq c d) (dnf-eq cs ds)
dnf-norm : DNF → DNF
dnf-norm lnil = lnil
dnf-norm (lcons c cs) = dnf-add (conj-meet c lnil) (dnf-norm cs)
dnf-canon : DNF → Bool
dnf-canon f = dnf-eq (dnf-norm f) f
dnf-nonconst : DNF → Bool
dnf-nonconst lnil = false
dnf-nonconst (lcons lnil cs) = false
dnf-nonconst (lcons (lcons l ls) cs) = true
isub : (Word → IEx) → IEx → IEx
isub τ ix0 = ix0
isub τ ix1 = ix1
isub τ (ixv k) = τ k
isub τ (ixneg r) = ixneg (isub τ r)
isub τ (ixmeet r s) = ixmeet (isub τ r) (isub τ s)
isub τ (ixjoin r s) = ixjoin (isub τ r) (isub τ s)
PAlg : (I : Type 2) (Ln : I → I) (K : I → Type 1) → Type 2
PAlg I Ln K = (pa0 : (iq : I) → K (Ln iq) → K iq) × (pa1 : (iq : I) → K (Ln iq) → K iq) × (parv : (iq : I) → K (Ln iq) → K (Ln iq)) ×
  (pamt : (iq : I) → K (Ln iq) → K (Ln (Ln iq))) × (pajn : (iq : I) → K (Ln iq) → K (Ln (Ln iq))) × ((kq : Word) (iq : I) → K (Ln iq) → K iq)
pfold : (I : Type 2) (Ln : I → I) (K : I → Type 1) → PAlg I Ln K → IEx → (i : I) → K (Ln i) → K i
pfold I Ln K A ix0 i x = fst A i x
pfold I Ln K A ix1 i x = fst (snd A) i x
pfold I Ln K A (ixv k) i x = snd (snd (snd (snd (snd A)))) k i x
pfold I Ln K A (ixneg r) i x = pfold I Ln K A r i (fst (snd (snd A)) i x)
pfold I Ln K A (ixmeet r s) i x = pfold I Ln K A r i (pfold I Ln K A s (Ln i) (fst (snd (snd (snd A))) i x))
pfold I Ln K A (ixjoin r s) i x = pfold I Ln K A r i (pfold I Ln K A s (Ln i) (fst (snd (snd (snd (snd A)))) i x))
pfold-sub : (I : Type 2) (Ln : I → I) (K K' : I → Type 1) (M : I → I → Type 2) (LnM : (iq iq' : I) → M iq iq' → M (Ln iq) (Ln iq'))
  (h : (iq iq' : I) → M iq iq' → K iq → K' iq') (A : PAlg I Ln K) (A' : PAlg I Ln K') (τ : Word → IEx) →
  (s0 : (iq iq' : I) (mq : M iq iq') (x : K (Ln iq)) → PathP (λ t → K' iq') (fst A' iq' (h (Ln iq) (Ln iq') (LnM iq iq' mq) x)) (h iq iq' mq (fst A iq x))) →
  (s1 : (iq iq' : I) (mq : M iq iq') (x : K (Ln iq)) → PathP (λ t → K' iq') (fst (snd A') iq' (h (Ln iq) (Ln iq') (LnM iq iq' mq) x)) (h iq iq' mq (fst (snd A) iq x))) →
  (sr : (iq iq' : I) (mq : M iq iq') (x : K (Ln iq)) → PathP (λ t → K' (Ln iq')) (fst (snd (snd A')) iq' (h (Ln iq) (Ln iq') (LnM iq iq' mq) x)) (h (Ln iq) (Ln iq') (LnM iq iq' mq) (fst (snd (snd A)) iq x))) →
  (sm : (iq iq' : I) (mq : M iq iq') (x : K (Ln iq)) → PathP (λ t → K' (Ln (Ln iq'))) (fst (snd (snd (snd A'))) iq' (h (Ln iq) (Ln iq') (LnM iq iq' mq) x)) (h (Ln (Ln iq)) (Ln (Ln iq')) (LnM (Ln iq) (Ln iq') (LnM iq iq' mq)) (fst (snd (snd (snd A))) iq x))) →
  (sj : (iq iq' : I) (mq : M iq iq') (x : K (Ln iq)) → PathP (λ t → K' (Ln (Ln iq'))) (fst (snd (snd (snd (snd A')))) iq' (h (Ln iq) (Ln iq') (LnM iq iq' mq) x)) (h (Ln (Ln iq)) (Ln (Ln iq')) (LnM (Ln iq) (Ln iq') (LnM iq iq' mq)) (fst (snd (snd (snd (snd A)))) iq x))) →
  (sv : (kq : Word) (iq iq' : I) (mq : M iq iq') (x : K (Ln iq)) → PathP (λ t → K' iq') (pfold I Ln K' A' (τ kq) iq' (h (Ln iq) (Ln iq') (LnM iq iq' mq) x)) (h iq iq' mq (snd (snd (snd (snd (snd A)))) kq iq x))) →
  (r : IEx) (i i' : I) (m : M i i') (x : K (Ln i)) →
  PathP (λ t → K' i') (pfold I Ln K' A' (isub τ r) i' (h (Ln i) (Ln i') (LnM i i' m) x)) (h i i' m (pfold I Ln K A r i x))
pfold-sub I Ln K K' M LnM h A A' τ s0 s1 sr sm sj sv ix0 i i' m x = s0 i i' m x
pfold-sub I Ln K K' M LnM h A A' τ s0 s1 sr sm sj sv ix1 i i' m x = s1 i i' m x
pfold-sub I Ln K K' M LnM h A A' τ s0 s1 sr sm sj sv (ixv k) i i' m x = sv k i i' m x
pfold-sub I Ln K K' M LnM h A A' τ s0 s1 sr sm sj sv (ixneg r) i i' m x =
  pcat (K' i') (pfold I Ln K' A' (isub τ r) i' (fst (snd (snd A')) i' (h (Ln i) (Ln i') (LnM i i' m) x)))
    (pfold I Ln K' A' (isub τ r) i' (h (Ln i) (Ln i') (LnM i i' m) (fst (snd (snd A)) i x))) (h i i' m (pfold I Ln K A r i (fst (snd (snd A)) i x)))
    (λ t → pfold I Ln K' A' (isub τ r) i' (sr i i' m x t))
    (pfold-sub I Ln K K' M LnM h A A' τ s0 s1 sr sm sj sv r i i' m (fst (snd (snd A)) i x))
pfold-sub I Ln K K' M LnM h A A' τ s0 s1 sr sm sj sv (ixmeet r s) i i' m x =
  pcat (K' i') (pfold I Ln K' A' (isub τ r) i' (pfold I Ln K' A' (isub τ s) (Ln i') (fst (snd (snd (snd A'))) i' (h (Ln i) (Ln i') (LnM i i' m) x))))
    (pfold I Ln K' A' (isub τ r) i' (h (Ln i) (Ln i') (LnM i i' m) (pfold I Ln K A s (Ln i) (fst (snd (snd (snd A))) i x))))
    (h i i' m (pfold I Ln K A r i (pfold I Ln K A s (Ln i) (fst (snd (snd (snd A))) i x))))
    (λ t → pfold I Ln K' A' (isub τ r) i'
       (pcat (K' (Ln i')) (pfold I Ln K' A' (isub τ s) (Ln i') (fst (snd (snd (snd A'))) i' (h (Ln i) (Ln i') (LnM i i' m) x)))
          (pfold I Ln K' A' (isub τ s) (Ln i') (h (Ln (Ln i)) (Ln (Ln i')) (LnM (Ln i) (Ln i') (LnM i i' m)) (fst (snd (snd (snd A))) i x)))
          (h (Ln i) (Ln i') (LnM i i' m) (pfold I Ln K A s (Ln i) (fst (snd (snd (snd A))) i x)))
          (λ u → pfold I Ln K' A' (isub τ s) (Ln i') (sm i i' m x u))
          (pfold-sub I Ln K K' M LnM h A A' τ s0 s1 sr sm sj sv s (Ln i) (Ln i') (LnM i i' m) (fst (snd (snd (snd A))) i x)) t))
    (pfold-sub I Ln K K' M LnM h A A' τ s0 s1 sr sm sj sv r i i' m (pfold I Ln K A s (Ln i) (fst (snd (snd (snd A))) i x)))
pfold-sub I Ln K K' M LnM h A A' τ s0 s1 sr sm sj sv (ixjoin r s) i i' m x =
  pcat (K' i') (pfold I Ln K' A' (isub τ r) i' (pfold I Ln K' A' (isub τ s) (Ln i') (fst (snd (snd (snd (snd A')))) i' (h (Ln i) (Ln i') (LnM i i' m) x))))
    (pfold I Ln K' A' (isub τ r) i' (h (Ln i) (Ln i') (LnM i i' m) (pfold I Ln K A s (Ln i) (fst (snd (snd (snd (snd A)))) i x))))
    (h i i' m (pfold I Ln K A r i (pfold I Ln K A s (Ln i) (fst (snd (snd (snd (snd A)))) i x))))
    (λ t → pfold I Ln K' A' (isub τ r) i'
       (pcat (K' (Ln i')) (pfold I Ln K' A' (isub τ s) (Ln i') (fst (snd (snd (snd (snd A')))) i' (h (Ln i) (Ln i') (LnM i i' m) x)))
          (pfold I Ln K' A' (isub τ s) (Ln i') (h (Ln (Ln i)) (Ln (Ln i')) (LnM (Ln i) (Ln i') (LnM i i' m)) (fst (snd (snd (snd (snd A)))) i x)))
          (h (Ln i) (Ln i') (LnM i i' m) (pfold I Ln K A s (Ln i) (fst (snd (snd (snd (snd A)))) i x)))
          (λ u → pfold I Ln K' A' (isub τ s) (Ln i') (sj i i' m x u))
          (pfold-sub I Ln K K' M LnM h A A' τ s0 s1 sr sm sj sv s (Ln i) (Ln i') (LnM i i' m) (fst (snd (snd (snd (snd A)))) i x)) t))
    (pfold-sub I Ln K K' M LnM h A A' τ s0 s1 sr sm sj sv r i i' m (pfold I Ln K A s (Ln i) (fst (snd (snd (snd (snd A)))) i x)))
DAlg : (I : Type 2) (Ln : I → I) (K : I → Type 1) (A : PAlg I Ln K) (J : I → Type 2) (LnJ : (iq : I) → J iq → J (Ln iq))
  (D : (iq : I) → J iq → K iq → Type 1) → Type 2
DAlg I Ln K A J LnJ D =
  (da0 : (iq : I) (jq : J iq) (xq : K (Ln iq)) → D (Ln iq) (LnJ iq jq) xq → D iq jq (fst A iq xq)) ×
  (da1 : (iq : I) (jq : J iq) (xq : K (Ln iq)) → D (Ln iq) (LnJ iq jq) xq → D iq jq (fst (snd A) iq xq)) ×
  (darv : (iq : I) (jq : J iq) (xq : K (Ln iq)) → D (Ln iq) (LnJ iq jq) xq → D (Ln iq) (LnJ iq jq) (fst (snd (snd A)) iq xq)) ×
  (damt : (iq : I) (jq : J iq) (xq : K (Ln iq)) → D (Ln iq) (LnJ iq jq) xq → D (Ln (Ln iq)) (LnJ (Ln iq) (LnJ iq jq)) (fst (snd (snd (snd A))) iq xq)) ×
  (dajn : (iq : I) (jq : J iq) (xq : K (Ln iq)) → D (Ln iq) (LnJ iq jq) xq → D (Ln (Ln iq)) (LnJ (Ln iq) (LnJ iq jq)) (fst (snd (snd (snd (snd A)))) iq xq)) ×
  ((kq : Word) (iq : I) (jq : J iq) (xq : K (Ln iq)) → D (Ln iq) (LnJ iq jq) xq → D iq jq (snd (snd (snd (snd (snd A)))) kq iq xq))
dfold : (I : Type 2) (Ln : I → I) (K : I → Type 1) (A : PAlg I Ln K) (J : I → Type 2) (LnJ : (iq : I) → J iq → J (Ln iq))
  (D : (iq : I) → J iq → K iq → Type 1) → DAlg I Ln K A J LnJ D → (r : IEx) (i : I) (j : J i) (x : K (Ln i)) → D (Ln i) (LnJ i j) x → D i j (pfold I Ln K A r i x)
dfold I Ln K A J LnJ D B ix0 i j x y = fst B i j x y
dfold I Ln K A J LnJ D B ix1 i j x y = fst (snd B) i j x y
dfold I Ln K A J LnJ D B (ixv k) i j x y = snd (snd (snd (snd (snd B)))) k i j x y
dfold I Ln K A J LnJ D B (ixneg r) i j x y = dfold I Ln K A J LnJ D B r i j (fst (snd (snd A)) i x) (fst (snd (snd B)) i j x y)
dfold I Ln K A J LnJ D B (ixmeet r s) i j x y =
  dfold I Ln K A J LnJ D B r i j (pfold I Ln K A s (Ln i) (fst (snd (snd (snd A))) i x))
    (dfold I Ln K A J LnJ D B s (Ln i) (LnJ i j) (fst (snd (snd (snd A))) i x) (fst (snd (snd (snd B))) i j x y))
dfold I Ln K A J LnJ D B (ixjoin r s) i j x y =
  dfold I Ln K A J LnJ D B r i j (pfold I Ln K A s (Ln i) (fst (snd (snd (snd (snd A)))) i x))
    (dfold I Ln K A J LnJ D B s (Ln i) (LnJ i j) (fst (snd (snd (snd (snd A)))) i x) (fst (snd (snd (snd (snd B)))) i j x y))
dfold-nat : (I : Type 2) (Ln : I → I) (K : I → Type 1) (A : PAlg I Ln K) (J : I → Type 2) (LnJ : (iq : I) → J iq → J (Ln iq)) (D D' : (iq : I) → J iq → K iq → Type 1) (B : DAlg I Ln K A J LnJ D) (B' : DAlg I Ln K A J LnJ D')
  (MJ : (iq : I) → J iq → J iq → Type 2) (LnMJ : (iq : I) (jq jq' : J iq) → MJ iq jq jq' → MJ (Ln iq) (LnJ iq jq) (LnJ iq jq'))
  (g : (iq : I) (jq jq' : J iq) → MJ iq jq jq' → (xq : K iq) → D iq jq xq → D' iq jq' xq) →
  (e0 : (iq : I) (jq jq' : J iq) (mq : MJ iq jq jq') (xq : K (Ln iq)) (yq : D (Ln iq) (LnJ iq jq) xq) → PathP (λ t → D' iq jq' ((fst A) iq xq)) ((fst B') iq jq' xq (g (Ln iq) (LnJ iq jq) (LnJ iq jq') (LnMJ iq jq jq' mq) xq yq)) (g iq jq jq' mq ((fst A) iq xq) ((fst B) iq jq xq yq))) →
  (e1 : (iq : I) (jq jq' : J iq) (mq : MJ iq jq jq') (xq : K (Ln iq)) (yq : D (Ln iq) (LnJ iq jq) xq) → PathP (λ t → D' iq jq' ((fst (snd A)) iq xq)) ((fst (snd B')) iq jq' xq (g (Ln iq) (LnJ iq jq) (LnJ iq jq') (LnMJ iq jq jq' mq) xq yq)) (g iq jq jq' mq ((fst (snd A)) iq xq) ((fst (snd B)) iq jq xq yq))) →
  (er : (iq : I) (jq jq' : J iq) (mq : MJ iq jq jq') (xq : K (Ln iq)) (yq : D (Ln iq) (LnJ iq jq) xq) → PathP (λ t → D' (Ln iq) (LnJ iq jq') ((fst (snd (snd A))) iq xq)) ((fst (snd (snd B'))) iq jq' xq (g (Ln iq) (LnJ iq jq) (LnJ iq jq') (LnMJ iq jq jq' mq) xq yq)) (g (Ln iq) (LnJ iq jq) (LnJ iq jq') (LnMJ iq jq jq' mq) ((fst (snd (snd A))) iq xq) ((fst (snd (snd B))) iq jq xq yq))) →
  (em : (iq : I) (jq jq' : J iq) (mq : MJ iq jq jq') (xq : K (Ln iq)) (yq : D (Ln iq) (LnJ iq jq) xq) → PathP (λ t → D' (Ln (Ln iq)) (LnJ (Ln iq) (LnJ iq jq')) ((fst (snd (snd (snd A)))) iq xq)) ((fst (snd (snd (snd B')))) iq jq' xq (g (Ln iq) (LnJ iq jq) (LnJ iq jq') (LnMJ iq jq jq' mq) xq yq)) (g (Ln (Ln iq)) (LnJ (Ln iq) (LnJ iq jq)) (LnJ (Ln iq) (LnJ iq jq')) (LnMJ (Ln iq) (LnJ iq jq) (LnJ iq jq') (LnMJ iq jq jq' mq)) ((fst (snd (snd (snd A)))) iq xq) ((fst (snd (snd (snd B)))) iq jq xq yq))) →
  (ej : (iq : I) (jq jq' : J iq) (mq : MJ iq jq jq') (xq : K (Ln iq)) (yq : D (Ln iq) (LnJ iq jq) xq) → PathP (λ t → D' (Ln (Ln iq)) (LnJ (Ln iq) (LnJ iq jq')) ((fst (snd (snd (snd (snd A))))) iq xq)) ((fst (snd (snd (snd (snd B'))))) iq jq' xq (g (Ln iq) (LnJ iq jq) (LnJ iq jq') (LnMJ iq jq jq' mq) xq yq)) (g (Ln (Ln iq)) (LnJ (Ln iq) (LnJ iq jq)) (LnJ (Ln iq) (LnJ iq jq')) (LnMJ (Ln iq) (LnJ iq jq) (LnJ iq jq') (LnMJ iq jq jq' mq)) ((fst (snd (snd (snd (snd A))))) iq xq) ((fst (snd (snd (snd (snd B))))) iq jq xq yq))) →
  (ev : (kq : Word) (iq : I) (jq jq' : J iq) (mq : MJ iq jq jq') (xq : K (Ln iq)) (yq : D (Ln iq) (LnJ iq jq) xq) → PathP (λ t → D' iq jq' ((snd (snd (snd (snd (snd A))))) kq iq xq)) ((snd (snd (snd (snd (snd B'))))) kq iq jq' xq (g (Ln iq) (LnJ iq jq) (LnJ iq jq') (LnMJ iq jq jq' mq) xq yq)) (g iq jq jq' mq ((snd (snd (snd (snd (snd A))))) kq iq xq) ((snd (snd (snd (snd (snd B))))) kq iq jq xq yq))) →
  (r : IEx) (i : I) (j j' : J i) (m : MJ i j j') (x : K (Ln i)) (y : D (Ln i) (LnJ i j) x) →
  PathP (λ t → D' i j' (pfold I Ln K A r i x)) (dfold I Ln K A J LnJ D' B' r i j' x (g (Ln i) (LnJ i j) (LnJ i j') (LnMJ i j j' m) x y)) (g i j j' m (pfold I Ln K A r i x) (dfold I Ln K A J LnJ D B r i j x y))
dfold-nat I Ln K A J LnJ D D' B B' MJ LnMJ g e0 e1 er em ej ev ix0 i j j' m x y = e0 i j j' m x y
dfold-nat I Ln K A J LnJ D D' B B' MJ LnMJ g e0 e1 er em ej ev ix1 i j j' m x y = e1 i j j' m x y
dfold-nat I Ln K A J LnJ D D' B B' MJ LnMJ g e0 e1 er em ej ev (ixv k) i j j' m x y = ev k i j j' m x y
dfold-nat I Ln K A J LnJ D D' B B' MJ LnMJ g e0 e1 er em ej ev (ixneg r) i j j' m x y =
  pcat (D' i j' (pfold I Ln K A r i ((fst (snd (snd A))) i x))) (dfold I Ln K A J LnJ D' B' r i j' ((fst (snd (snd A))) i x) ((fst (snd (snd B'))) i j' x (g (Ln i) (LnJ i j) (LnJ i j') (LnMJ i j j' m) x y))) (dfold I Ln K A J LnJ D' B' r i j' ((fst (snd (snd A))) i x) (g (Ln i) (LnJ i j) (LnJ i j') (LnMJ i j j' m) ((fst (snd (snd A))) i x) ((fst (snd (snd B))) i j x y))) (g i j j' m (pfold I Ln K A r i ((fst (snd (snd A))) i x)) (dfold I Ln K A J LnJ D B r i j ((fst (snd (snd A))) i x) ((fst (snd (snd B))) i j x y)))
    (λ t → dfold I Ln K A J LnJ D' B' r i j' ((fst (snd (snd A))) i x) (er i j j' m x y t))
    (dfold-nat I Ln K A J LnJ D D' B B' MJ LnMJ g e0 e1 er em ej ev r i j j' m ((fst (snd (snd A))) i x) ((fst (snd (snd B))) i j x y))
dfold-nat I Ln K A J LnJ D D' B B' MJ LnMJ g e0 e1 er em ej ev (ixmeet r s) i j j' m x y =
