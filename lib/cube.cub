  (dnil0 : (iq : I lnil) (jq : J lnil iq) (xq : K lnil (Ln lnil iq)) → D lnil (Ln lnil iq) (LnJ lnil iq jq) xq → D lnil iq jq (fst O iq xq)) ×
  (dty0 : (s : TyShape) (sq : Lst Entry) (iq : I (lcons (e-ty s) sq)) (jq : J (lcons (e-ty s) sq) iq) (xq : K (lcons (e-ty s) sq) (Ln (lcons (e-ty s) sq) iq)) →
