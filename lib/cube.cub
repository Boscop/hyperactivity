Up : Type 1 → Type 2
Up A = (upT : Type 1) × A
dg-cube : DgOps (λ sq → Type 1) (λ sq X → Line X) (λ sq X → Cube (dims sq) X) (λ sq X → Line X) (λ s sq X → X)
dg-cube =
  (λ X c → fst c ,
   λ s sq X c → cube-map (dims sq) (Line X) X (λ L → fst L) c ,
   λ s sq X c → c ,
   λ s sq X c → c ,
   λ sq X c → cube-map (dims sq) (Line (Line X)) (Line X) (diag-l X) c ,
   λ sq X c → cube-map (dims sq) (Line (Line X)) (Line (Line X)) (exch-l X) c ,
   λ sq X c → c)
ddg-dcube : DDgOps (λ sq → Type 1) (λ sq X → Line X) (λ sq X → Cube (dims sq) X) (λ sq X → Line X) (λ s sq X → X) dg-cube
  (λ sq X → X → Type 1) (λ sq X F → LineO X F) (λ sq X F → LineO X F) (λ s sq X F → F) (λ sq X F c → DCube (dims sq) X F c)
ddg-dcube =
  (λ X F c d → fst d ,
   λ s sq X F c d → dcube-reidx (dims sq) (Line X) X (LineO X F) F (λ L → fst L) (λ L D → fst D) c d ,
   λ s sq X F c d → d ,
   λ s sq X F c d → d ,
   λ sq X F c d → dcube-reidx (dims sq) (Line (Line X)) (Line X) (LineO (Line X) (LineO X F)) (LineO X F) (diag-l X) (diag-o X F) c d ,
   λ sq X F c d → dcube-reidx (dims sq) (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (exch-l X) (exch-o X F) c d ,
   λ sq X F c d → d)
DgI : Lst Entry → Type 2
DgI sq = (Xq : Type 1) × (Fq : Xq → Type 1) × Cube (dims sq) Xq
dg-dl : DgOps DgI (λ sq p → (fst p , DL (fst p) (fst (snd p)) , snd (snd p))) (λ sq p → DCube (dims sq) (fst p) (fst (snd p)) (snd (snd p)))
  (λ sq p → (Line (fst p) , LineO (fst p) (fst (snd p)) , snd (snd p))) (λ s sq p → p)
dg-dl =
  (λ p d → fst d ,
   λ s sq p d → dcube-fmap (dims sq) (fst p) (DL (fst p) (fst (snd p))) (fst (snd p)) (λ x q → fst q) (snd (snd p)) d ,
   λ s sq p d → d ,
   λ s sq p d → d ,
   λ sq p d → dcube-fmap (dims sq) (Line (fst p)) (LineO (fst p) (DL (fst p) (fst (snd p)))) (LineO (fst p) (fst (snd p)))
                (λ L q → diag-o (fst p) (fst (snd p)) (line-map (fst p) (Line (fst p)) (degen-l (fst p)) L) q) (snd (snd p)) d ,
   λ sq p d → dcube-fmap (dims sq) (Line (fst p)) (LineO (fst p) (DL (fst p) (fst (snd p)))) (DL (Line (fst p)) (LineO (fst p) (fst (snd p))))
                (λ L q → exch-o (fst p) (fst (snd p)) (line-map (fst p) (Line (fst p)) (degen-l (fst p)) L) q) (snd (snd p)) d ,
   λ sq p d → d)
diag-sk : (sk : Lst Entry) (k : Word) (X : Type 1) → Cube (dims sk) (Line X) → Cube (dims sk) X
diag-sk sk k X c = gdiag (λ sq → Type 1) (λ sq X → Line X) (λ sq X → Cube (dims sq) X) (λ sq X → Line X) (λ s sq X → X) dg-cube sk k X c
diag-sk-d : (sk : Lst Entry) (k : Word) (X : Type 1) (F : X → Type 1) (c : Cube (dims sk) (Line X)) → DCube (dims sk) (Line X) (LineO X F) c → DCube (dims sk) X F (diag-sk sk k X c)
diag-sk-d sk k X F c d = dgdiag (λ sq → Type 1) (λ sq X → Line X) (λ sq X → Cube (dims sq) X) (λ sq X → Line X) (λ s sq X → X) dg-cube (λ sq X → X → Type 1) (λ sq X F → LineO X F) (λ sq X F → LineO X F) (λ s sq X F → F) (λ sq X F c → DCube (dims sq) X F c) ddg-dcube sk k X F c d
ac : (sk : Lst Entry) → PAlg (Type 1) Line (Cube (dims sk))
ac sk =
  (λ X c → cube-map (dims sk) (Line X) X (λ L → fst L) c ,
   λ X c → cube-map (dims sk) (Line X) X (λ L → fst (snd L)) c ,
   λ X c → cube-map (dims sk) (Line X) (Line X) (rev-l X) c ,
   λ X c → cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c ,
   λ X c → cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c ,
   λ k X c → diag-sk sk k X c)
adc : (sk : Lst Entry) → DAlg (Type 1) Line (Cube (dims sk)) (ac sk) (λ X → X → Type 1) (λ X F → LineO X F) (λ X F c → DCube (dims sk) X F c)
adc sk =
  (λ X F c d → dcube-reidx (dims sk) (Line X) X (LineO X F) F (λ L → fst L) (λ L D → fst D) c d ,
   λ X F c d → dcube-reidx (dims sk) (Line X) X (LineO X F) F (λ L → fst (snd L)) (λ L D → fst (snd D)) c d ,
   λ X F c d → dcube-reidx (dims sk) (Line X) (Line X) (LineO X F) (LineO X F) (rev-l X) (rev-o X F) c d ,
   λ X F c d → dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (meet-l X) (meet-o X F) c d ,
   λ X F c d → dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (join-l X) (join-o X F) c d ,
   λ k X F c d → diag-sk-d sk k X F c d)
alg-dl : (sk : Lst Entry) (X : Type 1) (G : Cube (dims sk) X) → PAlg (X → Type 1) (DL X) (λ F → DCube (dims sk) X F G)
alg-dl sk X G =
  (λ F d → dcube-fmap (dims sk) X (DL X F) F (λ x q → fst q) G d ,
   λ F d → dcube-fmap (dims sk) X (DL X F) F (λ x q → fst (snd q)) G d ,
   λ F d → dcube-fmap (dims sk) X (DL X F) (DL X F) (λ x q → rev-o X F (degen-l X x) q) G d ,
   λ F d → dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) G d ,
   λ F d → dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) G d ,
   λ k F d → gdiag DgI (λ sq p → (fst p , DL (fst p) (fst (snd p)) , snd (snd p))) (λ sq p → DCube (dims sq) (fst p) (fst (snd p)) (snd (snd p))) (λ sq p → (Line (fst p) , LineO (fst p) (fst (snd p)) , snd (snd p))) (λ s sq p → p) dg-dl sk k (X , F , G) d)
CMap : Lst Entry → Lst Entry → Type
CMap sk' lnil = Unit
CMap sk' (lcons (e-ty a) sk) = CMap sk' sk
CMap sk' (lcons e-dim sk) = CMap sk' sk × DNF
cmap2 : (sk' sk : Lst Entry) → CMap sk' sk → (X : Type 1) → Cube (dims sk) X → Cube (dims sk') X
cmap2 sk' sk σ X c = skfold (Type 1) Line (λ sq X → Cube (dims sq) X) (Cube (dims sk')) (CMap sk') (λ sq σ → fst σ) (λ sq σ → snd σ) (λ s sq σ → σ) (λ s sq X c → c) (λ sq X c → c) (cube-const (dims sk')) (λ f X c → pfold (Type 1) Line (Cube (dims sk')) (ac sk') (dnf-ix f) X c) sk σ X c
dcmap2 : (sk' sk : Lst Entry) (σ : CMap sk' sk) (X : Type 1) (F : X → Type 1) (c : Cube (dims sk) X) → DCube (dims sk) X F c → DCube (dims sk') X F (cmap2 sk' sk σ X c)
dcmap2 sk' sk σ X F c d = dskfold (Type 1) Line (λ sq X → Cube (dims sq) X) (Cube (dims sk')) (CMap sk') (λ sq σ → fst σ) (λ sq σ → snd σ) (λ s sq σ → σ) (λ s sq X c → c) (λ sq X c → c) (cube-const (dims sk')) (λ f X c → pfold (Type 1) Line (Cube (dims sk')) (ac sk') (dnf-ix f) X c) (λ X → X → Type 1) (λ X F → LineO X F) (λ sq X F c → DCube (dims sq) X F c) (λ X F t → DCube (dims sk') X F t) (λ s sq X F c d → d) (λ sq X F c d → d) (λ X F x y → dcube-const (dims sk') X F x y) (λ f X F t e → dfold (Type 1) Line (Cube (dims sk')) (ac sk') (λ X → X → Type 1) (λ X F → LineO X F) (λ X F c → DCube (dims sk') X F c) (adc sk') (dnf-ix f) X F t e) sk σ X F c d
fmap-reidx : (n : Nat) (X X' : Type 1) (F : X → Type 1) (F' F2 : X' → Type 1) (f : X → X') (g : (x : X) → F x → F' (f x))
  (h : (x : X') → F' x → F2 x) (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → DCube n X' F2 (cube-map n X X' f c))
    (dcube-fmap n X' F' F2 h (cube-map n X X' f c) (dcube-reidx n X X' F F' f g c d)) (dcube-reidx n X X' F F2 f (λ x y → h (f x) (g x y)) c d)
fmap-reidx zero X X' F F' F2 f g h c d = λ i → h (f c) (g c d)
fmap-reidx (suc n) X X' F F' F2 f g h c d =
  fmap-reidx n (Line X) (Line X') (LineO X F) (LineO X' F') (LineO X' F2) (line-map X X' f) (lineo-reidx X X' F F' f g) (lineo-fmap X' F' F2 h) c d
reidx-fmap : (n : Nat) (X X' : Type 1) (F F2 : X → Type 1) (F' : X' → Type 1) (h : (x : X) → F x → F2 x) (f : X → X')
  (g : (x : X) → F2 x → F' (f x)) (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → DCube n X' F' (cube-map n X X' f c))
    (dcube-reidx n X X' F2 F' f g c (dcube-fmap n X F F2 h c d)) (dcube-reidx n X X' F F' f (λ x y → g x (h x y)) c d)
reidx-fmap zero X X' F F2 F' h f g c d = λ i → g c (h c d)
reidx-fmap (suc n) X X' F F2 F' h f g c d =
  reidx-fmap n (Line X) (Line X') (LineO X F) (LineO X F2) (LineO X' F') (lineo-fmap X F F2 h) (line-map X X' f) (lineo-reidx X X' F2 F' f g) c d
fmap-const : (n : Nat) (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x) (x : X) (y : F x) →
  PathP (λ i → DCube n X F' (cube-const n X x)) (dcube-fmap n X F F' h (cube-const n X x) (dcube-const n X F x y)) (dcube-const n X F' x (h x y))
