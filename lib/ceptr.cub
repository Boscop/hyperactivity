-- lib/ceptr.cub — Hyperactive Receptivity (docs/hyperactive-receptivity.md, §6 "Protocols"): Ceptr's protocols
-- (github.com/zippy/ceptr, src/base_defs and src/protocol.c) as choreographies over roles, from which each
-- role's behaviour is the endpoint projection (lib/proc.cub: Chor, project, Projectable). A protocol is a
-- function of its semantic references: its ROLEs are role words and its USAGEs are the symbols carried, so a
-- RESOLUTION is application and a LINKAGE is a renaming; an INCLUSION is the included protocol with its
-- references renamed and resolved (Ceptr's _o_unwrap); expressing a role (Ceptr's _o_express_role) is the
-- projection, defined on projectable protocols. Ceptr's own base protocols are instances: REQUESTING,
-- RECOGNIZE (REQUESTING included with linkages and resolutions), ALIVE, and the group protocol's two
-- interactions. Each is projectable by computation, and RECOGNIZE as an inclusion of REQUESTING equals
-- REQUESTING applied to its resolved references, by computation.
import "core.cub"
import "proc.cub"
-- ---------------------------------------------------------------- semantic references (words)
-- roles of REQUESTING and its uses (src/base_defs: REQUESTER, RESPONDER; RECOGNIZER, RECOGNIZEE;
-- SERVER, CLIENT; GROUP, MEMBER)
cp-requester : Word
cp-requester = #1
cp-responder : Word
cp-responder = #2
cp-recognizer : Word
cp-recognizer = #3
cp-recognizee : Word
cp-recognizee = #4
cp-server : Word
cp-server = #5
cp-client : Word
cp-client = #6
cp-group : Word
cp-group = #7
cp-member : Word
cp-member = #8
-- usages: the symbols a protocol carries (REQUEST_TYPE, RESPONSE_TYPE abstract; are_you, i_am, PING, YUP,
-- MESSAGE_TEXT concrete)
cp-request-type : Word
cp-request-type = #101
cp-response-type : Word
cp-response-type = #102
cp-are-you : Word
cp-are-you = #103
cp-i-am : Word
cp-i-am = #104
cp-ping : Word
cp-ping = #105
cp-yup : Word
cp-yup = #106
cp-message-text : Word
cp-message-text = #107
-- ---------------------------------------------------------------- inclusion: linkage and resolution
-- a LINKAGE renames roles, a RESOLUTION maps usages to symbols; including a protocol applies both to it
cp-include : (Word → Word) → (Word → Word) → Chor → Chor
cp-include link res g = case g of
  cend → cend
  xfer a b v k → xfer (link a) (link b) (res v) (rec k)
  choice a l r → choice (link a) (rec l) (rec r)
-- ---------------------------------------------------------------- REQUESTING
-- (PROTOCOL_SEMANTICS (ROLE:REQUESTER) (ROLE:RESPONDER) … (USAGE:REQUEST_TYPE) (USAGE:RESPONSE_TYPE) …)
-- (backnforth (INITIATE (ROLE:REQUESTER) (DESTINATION (ROLE:RESPONDER)) (ACTION:send_request))
--             (EXPECT (ROLE:RESPONDER) (SOURCE (ROLE:REQUESTER)) (PATTERN … REQUEST_TYPE) (ACTION:send_response)))
-- the request goes from requester to responder, the response back: the protocol as a function of its
-- semantics
cp-requesting : Word → Word → Word → Word → Chor
cp-requesting rq rs req resp = xfer rq rs req (xfer rs rq resp cend)
cp-requesting-abstract : Chor
cp-requesting-abstract = cp-requesting cp-requester cp-responder cp-request-type cp-response-type
-- ---------------------------------------------------------------- RECOGNIZE
-- (INCLUSION (PNAME:REQUESTING) (LINKAGE (WHICH_ROLE (ROLE:REQUESTER) (ROLE:RECOGNIZER)))
--   (LINKAGE (WHICH_ROLE (ROLE:RESPONDER) (ROLE:RECOGNIZEE)))
--   (RESOLUTION (WHICH_SYMBOL (USAGE:REQUEST_TYPE) (ACTUAL_SYMBOL:are_you)))
--   (RESOLUTION (WHICH_SYMBOL (USAGE:RESPONSE_TYPE) (ACTUAL_SYMBOL:i_am))) …)
cp-recognize-link : Word → Word
cp-recognize-link w = if weq w cp-requester then cp-recognizer else (if weq w cp-responder then cp-recognizee else w)
cp-recognize-res : Word → Word
cp-recognize-res w = if weq w cp-request-type then cp-are-you else (if weq w cp-response-type then cp-i-am else w)
cp-recognize : Chor
cp-recognize = cp-include cp-recognize-link cp-recognize-res cp-requesting-abstract
-- the inclusion is REQUESTING applied to the resolved references: unwrapping is evaluation
cp-recognize-unwraps : cp-recognize ≡ cp-requesting cp-recognizer cp-recognizee cp-are-you cp-i-am
cp-recognize-unwraps = refl
-- ---------------------------------------------------------------- ALIVE
-- (alive (EXPECT (ROLE:SERVER) (SOURCE (ROLE:CLIENT)) (PATTERN … PING) (ACTION:respond_with_yup))
--        (EXPECT (ROLE:CLIENT) (SOURCE (ROLE:SERVER)) (PATTERN … YUP) (SLOT (GOAL:HANDLER) …)))
cp-alive : Chor
cp-alive = cp-requesting cp-client cp-server cp-ping cp-yup
-- ---------------------------------------------------------------- the group protocol (group1)
-- (enrollment (EXPECT (ROLE:GROUP) (ROLE:MEMBER) (PATTERN any) (ACTION:enroll))
--             (INITIATE (ROLE:MEMBER) (ROLE:GROUP) (ACTION:request_membership)))
-- (converse (EXPECT (ROLE:GROUP) (ROLE:MEMBER) (PATTERN … MESSAGE_TEXT) (ACTION:group_listen)) … )
cp-enrollment : Chor
cp-enrollment = xfer cp-member cp-group cp-yup cend
cp-converse : Chor
cp-converse = xfer cp-member cp-group cp-message-text (xfer cp-group cp-member cp-message-text cend)
-- ---------------------------------------------------------------- expression is projection
-- each base protocol is projectable, decided by computation
cp-requesting-projectable : Projectable cp-requesting-abstract
cp-requesting-projectable = unit
cp-recognize-projectable : Projectable cp-recognize
cp-recognize-projectable = unit
cp-alive-projectable : Projectable cp-alive
cp-alive-projectable = unit
cp-enrollment-projectable : Projectable cp-enrollment
cp-enrollment-projectable = unit
cp-converse-projectable : Projectable cp-converse
cp-converse-projectable = unit
-- Ceptr's _o_express_role: a role's behaviour in a protocol, defined exactly on projectable protocols
cp-express : Word → (g : Chor) → Projectable g → Proc {lzero} LocS Unit
cp-express me g pf = project me g pf
-- the recognizer's and the recognizee's behaviours in RECOGNIZE
cp-recognizer-behaviour : Proc {lzero} LocS Unit
cp-recognizer-behaviour = cp-express cp-recognizer cp-recognize cp-recognize-projectable
cp-recognizee-behaviour : Proc {lzero} LocS Unit
cp-recognizee-behaviour = cp-express cp-recognizee cp-recognize cp-recognize-projectable
-- expressing a role of RECOGNIZE is expressing the linked role of REQUESTING applied to its resolution
cp-recognizer-is-requester : cp-recognizer-behaviour ≡ project-raw cp-recognizer (cp-requesting cp-recognizer cp-recognizee cp-are-you cp-i-am)
cp-recognizer-is-requester = refl
