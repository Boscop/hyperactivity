#!build/cubical
-- lib/walk.cub — the onboarding cut into the chunks an agent reads one at a time (Avik, 2026-11-15:
-- every agent reads the same material, whole, in the same order). The documents are the value
-- `onboarding` (docs/onboarding.cub) as the machine evaluates it: a file named by a document is read
-- whole; a projection is the text its value computes. Each document is cut at its paragraphs into
-- chunks of at most w-chunk bytes, a heading opening a chunk once the one before it is half full; a
-- paragraph longer than a chunk is cut at its lines. The chunks are kept in the store (walk/1 …,
-- walk/count), stamped with the time of the latest change under the repository (walk/stamp), and
-- lib/hyperactive.cub serves them; this program runs when the stamp has moved.
import "host.cub"
import "../docs/onboarding.cub"

w-chunk : Word
w-chunk = #8000

-- paragraphs: runs of lines that are not blank
w-blank : List Word → Bool
w-blank l = h-null (h-trim l)
w-join : List (List Word) → List Word
w-join nil = nil
w-join (cons l nil) = l
w-join (cons l (cons m r)) = list-append l (cons #10 (w-join (cons m r)))
h-rev-lists : List (List Word) → List (List Word) → List (List Word)
h-rev-lists nil acc = acc
h-rev-lists (cons x r) acc = h-rev-lists r (cons x acc)
w-paras-onto : List (List Word) → List (List Word) → List (List Word)
w-paras-onto cur nil = if h-null (h-concat cur) then nil else cons (w-join (h-rev-lists cur nil)) nil
w-paras-onto cur (cons l r) = if w-blank l
  then (if h-null (h-concat cur) then w-paras-onto nil r else cons (w-join (h-rev-lists cur nil)) (w-paras-onto nil r))
  else w-paras-onto (cons l cur) r
w-len : List Word → Word
w-len t = fromNat (list-length t)
-- a paragraph longer than a chunk: its lines, packed up to a chunk each
w-pack-lines : List Word → List (List Word) → List (List Word)
w-pack-lines cur nil = if h-null cur then nil else cons cur nil
w-pack-lines cur (cons l r) =
  if h-null cur then w-pack-lines l r else
  if wlt w-chunk (wadd (w-len cur) (wadd #1 (w-len l))) then cons cur (w-pack-lines l r)
  else w-pack-lines (list-append cur (cons #10 l)) r
w-units : List (List Word) → List (List Word)
w-units nil = nil
w-units (cons p r) = if wlt w-chunk (w-len p) then list-append (w-pack-lines nil (h-split #10 p)) (w-units r) else cons p (w-units r)
-- units packed into chunks
w-heading : List Word → Bool
w-heading u = h-prefix "#" u
w-pack : List Word → List (List Word) → List (List Word)
w-pack cur nil = if h-null cur then nil else cons cur nil
w-pack cur (cons u r) =
  if h-null cur then w-pack u r else
  if wlt w-chunk (wadd (w-len cur) (wadd #2 (w-len u))) then cons cur (w-pack u r) else
  if andB (w-heading u) (wlt (wquot w-chunk #2) (w-len cur)) then cons cur (w-pack u r)
  else w-pack (list-append cur (cons #10 (cons #10 u))) r
w-chunks : List Word → List (List Word)
w-chunks t = w-pack nil (w-units (w-paras-onto nil (h-split #10 t)))

-- a document's label and text
w-label : Document → List Word
w-label (document-at p h) = p
w-label (projection n t) = n
w-or : Sum Unit (List Word) → List Word
w-or (inl u) = "(this document could not be read)"
w-or (inr t) = t
w-text : Document → Proc W (List Word)
w-text (document-at p h) = bind (h-read p) (λ t → ret (w-or t))
w-text (projection n t) = ret t
-- every chunk with its title
w-titled : List Word → Nat → Nat → List (List Word) → List (List Word × List Word)
w-titled label j n nil = nil
w-titled label j n (cons c r) =
  cons ((if h-eq (h-decimal (fromNat n)) "1" then label else list-append label (list-append ", part " (list-append (h-decimal (fromNat (suc j))) (list-append " of " (h-decimal (fromNat n)))))) , c)
    (w-titled label (suc j) n r)
w-doc-chunks : Document → Proc W (List (List Word × List Word))
w-doc-chunks d = bind (w-text d) (λ t → ret (w-titled (w-label d) zero (list-length (w-chunks t)) (w-chunks t)))
w-all : List Document → Proc W (List (List Word × List Word))
w-all nil = ret nil
w-all (cons d r) = bind (w-doc-chunks d) (λ cs → bind (w-all r) (λ rest → ret (list-append cs rest)))

-- the chunks kept: walk/<k> is the k-th, its title on its first line
w-keep : List Word → Nat → List (List Word × List Word) → Proc W Unit
w-keep dir k nil = ret unit
w-keep dir k (cons c r) = bind (h-write (list-append dir (h-decimal (fromNat (suc k)))) (list-append (h-line (fst c)) (snd c))) (λ b → w-keep dir (suc k) r)
w-build : List Word → Proc W Unit
w-build st =
  bind (h-dir-time (toNat #12) ".") (λ stamp →
  bind (w-all onboarding) (λ cs →
  bind (h-mkdir st) (λ u → bind (h-mkdir (list-append st "/walk")) (λ u2 →
  bind (w-keep (list-append st "/walk/") zero cs) (λ u3 →
  bind (h-write (list-append st "/walk/count") (h-decimal (fromNat (list-length cs)))) (λ b →
  bind (h-write (list-append st "/walk/stamp") (h-decimal stamp)) (λ b2 → exit #0)))))))
w-main : Proc W Unit
w-main = bind (h-env "CUBICAL_STORE") (λ e → w-build (h-store-of e))
w-run : Step W Unit
w-run = to-step w-main
#run w-run
