#!build/cubical
-- lib/guard.cub — the guard on what a commit may hold (Avik, 2026-11-15: "structurally ban python
-- as well no such script shall ever make it into this repo. beyond what exists today ... no code in
-- any language but hyperactive will ever be written"; "HYPERACTIVE MUST BE ENTIRELY BOOTSTRAPPED
-- ... LITERALLY NOTHING BUT THE CORE C IMPLEMENTATION"). Git runs it as the pre-commit hook
-- (.githooks/pre-commit is a link to this file; the first line has the machine run it). It reads the
-- index git is about to commit (GIT_INDEX_FILE, else .git/index) and refuses the commit when any
-- entry is neither hyperactive code (.cub) nor prose (.md) and is not one of the files the
-- repository held when the ban was made, byte for byte (g-frozen: its path and git's object id). A
-- file of g-frozen may be removed; none may be added to it except by a written decision here.
import "host.cub"

-- every file that is neither .cub nor .md, as the repository held it (path, git object id)
g-frozen : List (List Word × List Word)
g-frozen =
  cons (".claude/settings.json" , "2e08a61167f17620bd8fe6c65f93a96e37678e62") (
