  cons ("tools/asm/driver.s" , "8b7d92adee4af9b9914795ab854c4e4d67b35b5f") (
  cons ("tools/asm/gen.py" , "2e55987ec3618b2c8fa6ba715d58a2b0b537a7f7") (
  cons ("tools/asm/start.s" , "a5699cd9b1d08ca164d522772b8a44dcef8b9a73") (
