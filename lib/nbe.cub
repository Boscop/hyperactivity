              (case-R-pr Γ s P X Mt pt Mf pf (TV s-bool) (λ w → (fst w , fst (snd (snd w)))))
              (pcat (Mean Γ (TV s-bool)) (fmapM Γ (case-W1T s) (TV s-bool) (λ w → (fst w , fst (snd (snd w)))) (case-W1 Γ s P X Mt pt)) (fmapM Γ (case-W0T s) (TV s-bool) (λ w → (fst w , snd (snd w))) (case-W0 Γ s P X)) X
                (case-W1-pr Γ s P X Mt pt (TV s-bool) (λ w → (fst w , snd (snd w))))
