    p1 (psym (Mean Γ (Sem a)) (fmapM Γ (LnE a) (Sem a) (λ q → fst (snd (fst q))) (pt-W Γ a L M0 p0)) (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst (snd l)) (ul Γ (Sem a) L)) (pt-W-pr Γ a L M0 p0 (Sem a) (λ l → fst (snd l))))
pt-T : (Γ : CCtx) (a : TyShape) (L : Mean (dext Γ) (Sem a)) (M0 : Mean Γ (TV a)) (p0 : PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) M0) (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst l) (ul Γ (Sem a) L))) (M1 : Mean Γ (TV a)) → PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) M1) (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst (snd l)) (ul Γ (Sem a) L)) → Mean Γ (Sem (s-path a))
pt-T Γ a L M0 p0 M1 p1 = retype Γ a (LnE a) (Sem (s-path a)) (λ q → fst (snd (fst q))) (λ q v → (fst q , snd q , v)) (pt-W Γ a L M0 p0) M1 (pt-p1 Γ a L M0 p0 M1 p1)
pt-line : (Γ : CCtx) (a : TyShape) (L : Mean (dext Γ) (Sem a)) (M0 : Mean Γ (TV a)) (p0 : PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) M0) (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst l) (ul Γ (Sem a) L))) (M1 : Mean Γ (TV a)) (p1 : PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) M1) (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst (snd l)) (ul Γ (Sem a) L))) →
  PathM (dext Γ) (Sem a) L (path-line-ty Γ a (pt-T Γ a L M0 p0 M1 p1))
