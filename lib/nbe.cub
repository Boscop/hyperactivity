          (psym (Mean Γ (TV s)) (fmapM Γ (CaseV s) (TV s) (case-f s) (case-R Γ s P X Mt pt Mf pf)) Mf
            (retype-val Γ s (case-W1T s) (CaseV s) (λ u → fst (snd u) false) (λ u v → (fst u , fst (snd u) , fst (snd (snd u)) , snd (snd (snd u)) , v)) (case-W1 Γ s P X Mt pt) Mf (case-pf1 Γ s P X Mt pt Mf pf)
              (case-f s) (λ i u v → (fst (snd u) false , v))))
          df)))
case-4 : Rec → (Γ : CCtx) → Vals Γ → (s : TyShape) (cP x t f : Code) (d : Word) → d ≡ #0 → (P : Mean (ext-h Γ s-bool (Sem s-bool) (λ y → y) (one-mean Γ)) (Sem s)) → Der (j-ty , (ext-h Γ s-bool (Sem s-bool) (λ y → y) (one-mean Γ)) , s , cP , P) →
  CompTy (s-fam f-pi s-bool s) Γ (fam-of Γ s-bool s (one-mean Γ) P) → (X : Mean Γ (TV s-bool)) → Der (j-tm , Γ , s-bool , x , X) → (Mt : Mean Γ (TV s)) (pt : PathM Γ (Sem s) (fmapM Γ (TV s) (Sem s) (λ q → fst q) Mt) (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F true) (fam-of Γ s-bool s (one-mean Γ) P))) → Der (j-tm , Γ , s , t , Mt) →
  Dec1 (Out Γ (celim d (clam cP) (lcons t (lcons f lnil)) x) m-inf)
case-4 rec Γ vs s cP x t f d pd P dP ct X dX Mt pt dt =
  d-bind (Out Γ f (m-chk s (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F false) (fam-of Γ s-bool s (one-mean Γ) P)) (cs-ct Γ s (fam-of Γ s-bool s (one-mean Γ) P) ct false))) (Out Γ (celim d (clam cP) (lcons t (lcons f lnil)) x) m-inf)
    (rec Γ vs f (m-chk s (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F false) (fam-of Γ s-bool s (one-mean Γ) P)) (cs-ct Γ s (fam-of Γ s-bool s (one-mean Γ) P) ct false)))
    (λ rf → case-fin Γ s cP x t f d pd P dP X dX Mt pt dt (fst rf) (fst (snd rf)) (snd (snd rf)))
case-3 : Rec → (Γ : CCtx) → Vals Γ → (s : TyShape) (cP x t f : Code) (d : Word) → d ≡ #0 → (P : Mean (ext-h Γ s-bool (Sem s-bool) (λ y → y) (one-mean Γ)) (Sem s)) → Der (j-ty , (ext-h Γ s-bool (Sem s-bool) (λ y → y) (one-mean Γ)) , s , cP , P) →
  CompTy (s-fam f-pi s-bool s) Γ (fam-of Γ s-bool s (one-mean Γ) P) → (X : Mean Γ (TV s-bool)) → Der (j-tm , Γ , s-bool , x , X) → Dec1 (Out Γ (celim d (clam cP) (lcons t (lcons f lnil)) x) m-inf)
case-3 rec Γ vs s cP x t f d pd P dP ct X dX =
  d-bind (Out Γ t (m-chk s (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F true) (fam-of Γ s-bool s (one-mean Γ) P)) (cs-ct Γ s (fam-of Γ s-bool s (one-mean Γ) P) ct true))) (Out Γ (celim d (clam cP) (lcons t (lcons f lnil)) x) m-inf)
    (rec Γ vs t (m-chk s (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F true) (fam-of Γ s-bool s (one-mean Γ) P)) (cs-ct Γ s (fam-of Γ s-bool s (one-mean Γ) P) ct true)))
    (λ rt → case-4 rec Γ vs s cP x t f d pd P dP ct X dX (fst rt) (fst (snd rt)) (snd (snd rt)))
case-2 : Rec → (Γ : CCtx) → Vals Γ → (s : TyShape) (cP x t f : Code) (d : Word) → d ≡ #0 → (P : Mean (ext-h Γ s-bool (Sem s-bool) (λ y → y) (one-mean Γ)) (Sem s)) → Der (j-ty , (ext-h Γ s-bool (Sem s-bool) (λ y → y) (one-mean Γ)) , s , cP , P) →
  Dec1 (Out Γ (celim d (clam cP) (lcons t (lcons f lnil)) x) m-inf)
case-2 rec Γ vs s cP x t f d pd P dP =
  d-bind (Out Γ x (m-chk s-bool (one-mean Γ) one)) (Out Γ (celim d (clam cP) (lcons t (lcons f lnil)) x) m-inf) (rec Γ vs x (m-chk s-bool (one-mean Γ) one))
    (λ rx → case-3 rec Γ vs s cP x t f d pd P dP
      (comp-j j-ty Γ vs (s-fam f-pi s-bool s) (cpi #2 c-bool cP) (fam-of Γ s-bool s (one-mean Γ) P)
        (dty-fam f-pi Γ s-bool s (fam-of Γ s-bool s (one-mean Γ) P) c-bool cP (fam-dA Γ s-bool s (one-mean Γ) P c-bool (dty-bool Γ (one-mean Γ))) (fam-dB Γ s-bool s (one-mean Γ) P cP dP)))
      (fst rx) (snd (snd rx)))
case-1 : Rec → (Γ : CCtx) → Vals Γ → (cP x t f : Code) (d : Word) → d ≡ #0 → Dec1 (Out Γ (celim d (clam cP) (lcons t (lcons f lnil)) x) m-inf)
case-1 rec Γ vs cP x t f d pd =
  d-bind (Out (ext-h Γ s-bool (Sem s-bool) (λ y → y) (one-mean Γ)) cP m-ty) (Out Γ (celim d (clam cP) (lcons t (lcons f lnil)) x) m-inf) (rec (ext-h Γ s-bool (Sem s-bool) (λ y → y) (one-mean Γ)) (ext-vals Γ s-bool (Sem s-bool) (λ y → y) (one-mean Γ) one vs) cP m-ty)
    (λ rP → case-2 rec Γ vs (fst rP) cP x t f d pd (fst (snd rP)) (snd (snd rP)))
nat-dbl : Nat → Nat
nat-dbl zero = zero
nat-dbl (suc n) = suc (suc (nat-dbl n))
elab-fuel : Nat
elab-fuel = nat-dbl (nat-dbl (nat-dbl (nat-dbl (nat-dbl (nat-dbl (nat-dbl (nat-dbl (nat-dbl (nat-dbl (nat-dbl (nat-dbl (suc zero))))))))))))
is-true : (b : Bool) → Opt (isTrue b)
is-true true = some unit
is-true false = none
papp-f : (Γ : CCtx) (a : TyShape) (P : Mean Γ (TV (s-path a))) (p : Code) → Der (j-tm , Γ , s-path a , p , P) → (r : Code) (f : DNF) →
  Opt (isTrue (dnf-canon f)) → Opt (isTrue (dnf-nonconst f)) → Opt (dnf-code f ≡ r) → Dec1 (Out Γ (cpapp p r) m-inf)
papp-f Γ a P p dp r f (some cf) (some nf) (some q) =
  c-derived (a , papp-mean Γ a f P , der-code j-tm Γ a (cpapp p (dnf-code f)) (cpapp p r) (papp-mean Γ a f P) (λ i → cpapp p (q i))
    (dpapp Γ a P p f cf nf (papp-mean Γ a f P) (λ i → papp-mean Γ a f P) dp))
papp-f Γ a P p dp r f cf nf q = c-refused
papp-r : (Γ : CCtx) (a : TyShape) (P : Mean Γ (TV (s-path a))) (p : Code) → Der (j-tm , Γ , s-path a , p , P) → (r : Code) →
  Opt (r ≡ ci0) → Opt (r ≡ ci1) → Dec1 (Out Γ (cpapp p r) m-inf)
papp-r Γ a P p dp r (some q) o1 =
  c-derived (a , fmapM Γ (TV (s-path a)) (TV a) (pend-0 a) P ,
    der-code j-tm Γ a (cpapp p ci0) (cpapp p r) (fmapM Γ (TV (s-path a)) (TV a) (pend-0 a) P) (λ i → cpapp p (q (~ i))) (dpapp0 Γ a P p dp))
papp-r Γ a P p dp r none (some q) =
  c-derived (a , fmapM Γ (TV (s-path a)) (TV a) (pend-1 a) P ,
    der-code j-tm Γ a (cpapp p ci1) (cpapp p r) (fmapM Γ (TV (s-path a)) (TV a) (pend-1 a) P) (λ i → cpapp p (q (~ i))) (dpapp1 Γ a P p dp))
papp-r Γ a P p dp r none none =
  o-bind DNF (Out Γ (cpapp p r) m-inf) (dnf-of r)
    (λ f0 → papp-f Γ a P p dp r (dnf-norm f0) (is-true (dnf-canon (dnf-norm f0))) (is-true (dnf-nonconst (dnf-norm f0))) (code-dec elab-fuel (dnf-code (dnf-norm f0)) r))
papp-1 : (Γ : CCtx) (p r : Code) (s : TyShape) (P : Mean Γ (TV s)) → Der (j-tm , Γ , s , p , P) → Dec1 (Out Γ (cpapp p r) m-inf)
papp-1 Γ p r (s-path a) P dp = papp-r Γ a P p dp r (code-dec elab-fuel r ci0) (code-dec elab-fuel r ci1)
papp-1 Γ p r s P dp = c-refused
rxui : (n : Nat) (X X' : Type 1) (F' : X' → Type 1) (f : X → X') (c : Cube n X) (d : DCube n X' F' (cube-map n X X' f c)) →
  PathP (λ i → DCube n X' F' (cube-map n X X' f c)) (dcube-reidx n X X' (λ x → F' (f x)) F' f (λ x q → q) c (dcube-unreidx n X X' F' f c d)) d
rxui zero X X' F' f c d = λ i → d
rxui (suc n) X X' F' f c d = rxui n (Line X) (Line X') (LineO X' F') (line-map X X' f) c d
ul : (Γ : CCtx) (Z : Type 1) → Mean (dext Γ) Z → Mean Γ (Line Z)
ul Γ Z L =
  dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (λ xq → LineO (CtxV (fst Γ)) (FbE (fst Γ) Z) (degen-l (CtxV (fst Γ)) xq)) (FbE (fst Γ) (Line Z))
    (λ γq Dq ρq → (fst Dq ρq , fst (snd Dq) ρq , λ iq → snd (snd Dq) iq ρq)) (snd Γ)
    (dcube-unreidx (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z)) (degen-l (CtxV (fst Γ))) (snd Γ) L)
ul-dl : (Γ : CCtx) (Z : Type 1) (L : Mean (dext Γ) Z) → PathM (dext Γ) Z L (dline-body Γ (Line Z) Z (λ l → l) (ul Γ Z L))
ul-dl Γ Z L =
  psym (Mean (dext Γ) Z) (dline-body Γ (Line Z) Z (λ l → l) (ul Γ Z L)) L
    (pcat (Mean (dext Γ) Z) (dline-body Γ (Line Z) Z (λ l → l) (ul Γ Z L))
      (dcube-reidx (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (λ xq → LineO (CtxV (fst Γ)) (FbE (fst Γ) Z) (degen-l (CtxV (fst Γ)) xq)) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z)) (degen-l (CtxV (fst Γ)))
        (λ xq q → q) (snd Γ) (dcube-unreidx (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z)) (degen-l (CtxV (fst Γ))) (snd Γ) L))
      L
      (reidx-fmap (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (λ xq → LineO (CtxV (fst Γ)) (FbE (fst Γ) Z) (degen-l (CtxV (fst Γ)) xq)) (FbE (fst Γ) (Line Z)) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z))
        (λ γq Dq ρq → (fst Dq ρq , fst (snd Dq) ρq , λ iq → snd (snd Dq) iq ρq)) (degen-l (CtxV (fst Γ))) (fline (fst Γ) (Line Z) Z (λ l → l)) (snd Γ)
        (dcube-unreidx (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z)) (degen-l (CtxV (fst Γ))) (snd Γ) L))
      (rxui (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z)) (degen-l (CtxV (fst Γ))) (snd Γ) L))
papp-line-end0 : (Γ : CCtx) (Y Z : Type 1) (ℓ : Y → Line Z) (X : Mean Γ Y) → PathM Γ Z (fmapM Γ Y Z (λ q → fst (ℓ q)) X) (papp-line Γ Y Z ℓ lnil X)
papp-line-end0 Γ Y Z ℓ X = psym (Mean Γ Z) (papp-line Γ Y Z ℓ lnil X) (fmapM Γ Y Z (λ q → fst (ℓ q)) X)
  (fmap-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (FbE (fst Γ) Z) (fline (fst Γ) Y Z ℓ) (λ x q → fst q) (snd Γ) X)
face-pth : (Γ : CCtx) (Z : Type 1) (L : Mean (dext Γ) Z) (g : DNF) (cg : isTrue (dnf-canon g)) →
