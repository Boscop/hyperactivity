              (case-R-pr Γ s P X Mt pt Mf pf (TV s) (λ w → (fst (snd w) true , snd (snd (snd w)))))
              (retype-val Γ s (case-W0T s) (case-W1T s) (λ u → fst (snd u) true) (λ u v → (fst u , fst (snd u) , snd (snd u) , v)) (case-W0 Γ s P X) Mt (pcat (Mean Γ (Sem s)) (fmapM Γ (TV s) (Sem s) (λ q → fst q) Mt) (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F true) (fam-of Γ s-bool s (one-mean Γ) P)) (fmapM Γ (case-W0T s) (Sem s) (λ u → fst (snd u) true) (case-W0 Γ s P X)) pt (psym (Mean Γ (Sem s)) (fmapM Γ (case-W0T s) (Sem s) (λ u → fst (snd u) true) (case-W0 Γ s P X)) (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F true) (fam-of Γ s-bool s (one-mean Γ) P)) (case-W0-pr Γ s P X (Sem s) (λ F → snd F true))))
                (λ w → (fst (snd w) true , snd (snd (snd w)))) (λ i u v → (fst (snd u) true , v)))))
          dt)
