-- lib/nbe.cub — typed codes and normalization by evaluation for the object language Π, Σ, PathP and
-- Bool (docs/Hyperactive_Final_Paper.pdf, §6.1 “Typed quotation, semantic readback, and
-- self-application” and “Substitution on checked syntax”).
--
-- A typed code is Code(Γ, A) = Σ c. Der(Γ, c, A): raw syntax (lib/code.cub's Code) and a derivation
-- indexed by the code's meaning, so eval is the meaning's projection (teval). The model is the
-- cubical-set model with stages as host cubes: an object dimension is a direction of a host cube
-- (Cube, DCube), a context over a skeleton of type and dimension entries is a cube of environments,
-- and a meaning over it is a cube over that cube (Mean). Dimensions are names because CCHM forces
-- it: reifying a path is pathLam(i. reify(pathApp(p, i))), and neither a code nor an environment can
-- hold a host interval point, so the object interval is the free De Morgan algebra on the context's
-- dimension names, in disjunctive normal form (DNF), acting on cubes through cube maps (CMap).
--
-- In order: shapes and their semantic types (TyE, Sem, El); contexts, variables and lines; the
-- interval in DNF and its action on cubes (papp-dd), natural in renamings and substitutions; Der and
-- the normal and neutral forms NN, with embed; renaming and substitution of meanings (worlds, Sub);
-- reify and reflect at Bool, Π, Σ and PathP (rr; at PathP a neutral at a non-constant form, the
-- type's endpoint at 0 or 1); the fundamental lemma over substitutions sending dimensions to
-- interval expressions (fund); normalize with normalize-sound (eq. (6.5), by refl); substitution on
-- checked syntax, ⟦t[σ]⟧ρ = ⟦t⟧⟦σ⟧ρ (subst-tm, subst-sound, by refl); the typed specializer and
-- its law (spec, spec-sound), the first Futamura projection (compiled, compiled-sound, eq. (6.6)) and
-- the second (compiler-code, compiler-code-sound, eq. (6.7)).
-- The checker (check-code in lib/nbe-det.cub, by elab-n): raw codes to derivations, for every rule of the object language
-- (case carrying its motive), inferring types and neutral terms and checking λ, pairs, path λ and the
-- Bool constants against a type's meaning; conversion is a contraction at every shape without PathP
-- (their semantic types are contractible) and refused at PathP shapes until determinacy of normal
-- forms supplies it.
--
-- Composition, Glue and universes are not in this object language. Loaded with core.cub and
-- linproof.cub.

import "nbe-interval.cub"
RTyT : TyShape → Type 1
RTyT s = (Δ : CCtx) (T : Mean Δ (Sem s)) → CompTy s Δ T → RenR k-nf j-ty Δ s T
RfyT : TyShape → Type 1
RfyT s = (Δ : CCtx) (X : Mean Δ (TV s)) → CompS s Δ X → RenR k-nf j-tm Δ s X
RflT : TyShape → Type 1
RflT s = (Δ : CCtx) (X : Mean Δ (TV s)) → CompTy s Δ (fmapM Δ (TV s) (Sem s) (λ q → fst q) X) → (c : Code) → NN (k-ne , (j-tm , Δ , s , c , X)) → CompS s Δ X
RRT : TyShape → Type 1
RRT s = RTyT s × RfyT s × RflT s
var-comp : (a : TyShape) → RflT a → (Γ : CCtx) (Y : Type 1) (h : Y → Sem a) (M : Mean Γ Y) → CompTy a Γ (fmapM Γ Y (Sem a) h M) →
  CompS a (ext-h Γ a Y h M) (ext-lift Γ a Y h (TV a) (λ q x → (h q , x)) M)
var-comp a rfl Γ Y h M ca =
  jc-tr j-tm a (ext-h Γ a Y h M) (varCube (ext-h Γ a Y h M) none) (ext-lift Γ a Y h (TV a) (λ q x → (h q , x)) M) (var-lift Γ a Y h M)
    (rfl (ext-h Γ a Y h M) (varCube (ext-h Γ a Y h M) none)
       (jc-tr j-ty a (ext-h Γ a Y h M) (wact (ext-h Γ a Y h M) Γ (world-wk Γ a Y (λ γ e ρ → h (e ρ)) M) (Sem a) (fmapM Γ Y (Sem a) h M))
          (fmapM (ext-h Γ a Y h M) (TV a) (Sem a) (λ q → fst q) (varCube (ext-h Γ a Y h M) none))
          (pcat (Mean (ext-h Γ a Y h M) (Sem a)) (wact (ext-h Γ a Y h M) Γ (world-wk Γ a Y (λ γ e ρ → h (e ρ)) M) (Sem a) (fmapM Γ Y (Sem a) h M))
             (ext-lift Γ a Y h (Sem a) (λ q x → h q) M) (fmapM (ext-h Γ a Y h M) (TV a) (Sem a) (λ q → fst q) (varCube (ext-h Γ a Y h M) none))
             (wk-fm Γ a Y h M (Sem a) h)
             (psym (Mean (ext-h Γ a Y h M) (Sem a)) (fmapM (ext-h Γ a Y h M) (TV a) (Sem a) (λ q → fst q) (varCube (ext-h Γ a Y h M) none)) (ext-lift Γ a Y h (Sem a) (λ q x → h q) M)
                (pcat (Mean (ext-h Γ a Y h M) (Sem a)) (fmapM (ext-h Γ a Y h M) (TV a) (Sem a) (λ q → fst q) (varCube (ext-h Γ a Y h M) none))
                   (fmapM (ext-h Γ a Y h M) (TV a) (Sem a) (λ q → fst q) (ext-lift Γ a Y h (TV a) (λ q x → (h q , x)) M)) (ext-lift Γ a Y h (Sem a) (λ q x → h q) M)
                   (λ i → fmapM (ext-h Γ a Y h M) (TV a) (Sem a) (λ q → fst q) (var-lift Γ a Y h M i))
                   (lift-fm Γ a Y h M (TV a) (Sem a) (λ q x → (h q , x)) (λ q → fst q)))))
          (fst (comp-ren-e a) Γ (fmapM Γ Y (Sem a) h M) ca (ext-h Γ a Y h M) (world-wk Γ a Y (λ γ e ρ → h (e ρ)) M)))
       (cvar #0) (nvar (ext-h Γ a Y h M) none))
cod-rty : (a b : TyShape) → RflT a → RTyT b → (Δ : CCtx) (Y : Type 1) (k : Y → Fam a b) (M : Mean Δ Y) → CompTy (s-fam f-pi a b) Δ (fmapM Δ Y (Fam a b) k M) →
  RenR k-nf j-ty (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) b (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (Sem b) (λ q x → snd (k q) x) M)
cod-rty a b rfl rty Δ Y k M ct =
  rty (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (Sem b) (λ q x → snd (k q) x) M)
    (jc-tr j-ty b (ext-h Δ a Y (λ q → fam-dom a b (k q)) M)
       (fmapM (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (FamV a b) (Sem b) (fam-cod a b) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (FamV a b) (λ q x → (k q , x)) M))
       (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (Sem b) (λ q x → snd (k q) x) M)
       (lift-fm Δ a Y (λ q → fam-dom a b (k q)) M (FamV a b) (Sem b) (λ q x → (k q , x)) (fam-cod a b))
       (snd ct (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (world-wk Δ a Y (λ γ e ρ → fam-dom a b (k (e ρ))) M)
          (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (FamV a b) (λ q x → (k q , x)) M)
          (pcat (Mean (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (Fam a b))
             (fmapM (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (FamV a b) (Fam a b) (λ q → fst q) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (FamV a b) (λ q x → (k q , x)) M))
             (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (Fam a b) (λ q x → k q) M)
             (wact (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) Δ (world-wk Δ a Y (λ γ e ρ → fam-dom a b (k (e ρ))) M) (Fam a b) (fmapM Δ Y (Fam a b) k M))
             (lift-fm Δ a Y (λ q → fam-dom a b (k q)) M (FamV a b) (Fam a b) (λ q x → (k q , x)) (λ q → fst q))
             (psym (Mean (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (Fam a b))
                (wact (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) Δ (world-wk Δ a Y (λ γ e ρ → fam-dom a b (k (e ρ))) M) (Fam a b) (fmapM Δ Y (Fam a b) k M))
                (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (Fam a b) (λ q x → k q) M)
                (wk-fm Δ a Y (λ q → fam-dom a b (k q)) M (Fam a b) k)))
          (jc-tr j-tm a (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (TV a) (λ q x → (fam-dom a b (k q) , x)) M)
             (fmapM (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (FamV a b) (TV a) (fam-arg a b) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (FamV a b) (λ q x → (k q , x)) M))
             (psym (Mean (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (TV a))
                (fmapM (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (FamV a b) (TV a) (fam-arg a b) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (FamV a b) (λ q x → (k q , x)) M))
                (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (TV a) (λ q x → (fam-dom a b (k q) , x)) M)
                (lift-fm Δ a Y (λ q → fam-dom a b (k q)) M (FamV a b) (TV a) (λ q x → (k q , x)) (fam-arg a b)))
             (var-comp a rfl Δ Y (λ q → fam-dom a b (k q)) M
                (jc-tr j-ty a Δ (fmapM Δ (Fam a b) (Sem a) (fam-dom a b) (fmapM Δ Y (Fam a b) k M)) (fmapM Δ Y (Sem a) (λ q → fam-dom a b (k q)) M)
                   (fmapM-fmapM Δ Y (Fam a b) (Sem a) k (fam-dom a b) M) (fst ct))))))
cod-ct : (a b : TyShape) → RflT a → (Δ : CCtx) (Y : Type 1) (k : Y → Fam a b) (M : Mean Δ Y) → CompTy (s-fam f-pi a b) Δ (fmapM Δ Y (Fam a b) k M) →
  CompTy b (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (Sem b) (λ q x → snd (k q) x) M)
cod-ct a b rfl Δ Y k M ct =
    (jc-tr j-ty b (ext-h Δ a Y (λ q → fam-dom a b (k q)) M)
       (fmapM (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (FamV a b) (Sem b) (fam-cod a b) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (FamV a b) (λ q x → (k q , x)) M))
       (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (Sem b) (λ q x → snd (k q) x) M)
       (lift-fm Δ a Y (λ q → fam-dom a b (k q)) M (FamV a b) (Sem b) (λ q x → (k q , x)) (fam-cod a b))
       (snd ct (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (world-wk Δ a Y (λ γ e ρ → fam-dom a b (k (e ρ))) M)
          (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (FamV a b) (λ q x → (k q , x)) M)
          (pcat (Mean (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (Fam a b))
             (fmapM (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (FamV a b) (Fam a b) (λ q → fst q) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (FamV a b) (λ q x → (k q , x)) M))
             (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (Fam a b) (λ q x → k q) M)
             (wact (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) Δ (world-wk Δ a Y (λ γ e ρ → fam-dom a b (k (e ρ))) M) (Fam a b) (fmapM Δ Y (Fam a b) k M))
             (lift-fm Δ a Y (λ q → fam-dom a b (k q)) M (FamV a b) (Fam a b) (λ q x → (k q , x)) (λ q → fst q))
             (psym (Mean (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (Fam a b))
                (wact (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) Δ (world-wk Δ a Y (λ γ e ρ → fam-dom a b (k (e ρ))) M) (Fam a b) (fmapM Δ Y (Fam a b) k M))
                (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (Fam a b) (λ q x → k q) M)
                (wk-fm Δ a Y (λ q → fam-dom a b (k q)) M (Fam a b) k)))
          (jc-tr j-tm a (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (TV a) (λ q x → (fam-dom a b (k q) , x)) M)
             (fmapM (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (FamV a b) (TV a) (fam-arg a b) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (FamV a b) (λ q x → (k q , x)) M))
             (psym (Mean (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (TV a))
                (fmapM (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (FamV a b) (TV a) (fam-arg a b) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (FamV a b) (λ q x → (k q , x)) M))
                (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (TV a) (λ q x → (fam-dom a b (k q) , x)) M)
                (lift-fm Δ a Y (λ q → fam-dom a b (k q)) M (FamV a b) (TV a) (λ q x → (k q , x)) (fam-arg a b)))
             (var-comp a rfl Δ Y (λ q → fam-dom a b (k q)) M
                (jc-tr j-ty a Δ (fmapM Δ (Fam a b) (Sem a) (fam-dom a b) (fmapM Δ Y (Fam a b) k M)) (fmapM Δ Y (Sem a) (λ q → fam-dom a b (k q)) M)
                   (fmapM-fmapM Δ Y (Fam a b) (Sem a) k (fam-dom a b) M) (fst ct))))))
rty-bool : RTyT s-bool
rty-bool Δ T ct = (c-bool , nty-bool Δ T)
rfy-bool-c : (Δ : CCtx) (X : Mean Δ (TV s-bool)) → snd (CompE s-bool) Δ X → RenR k-nf j-tm Δ s-bool X
rfy-bool-c Δ X (inl1 p) = (c-true , d-tr t-nf j-tm Δ s-bool c-true (fmapM Δ One1 (TV s-bool) (bool-v true) (fst p)) X (psym (Mean Δ (TV s-bool)) X (fmapM Δ One1 (TV s-bool) (bool-v true) (fst p)) (snd p)) (ntrue Δ (fst p)))
rfy-bool-c Δ X (inr1 (inl1 p)) = (c-false , d-tr t-nf j-tm Δ s-bool c-false (fmapM Δ One1 (TV s-bool) (bool-v false) (fst p)) X (psym (Mean Δ (TV s-bool)) X (fmapM Δ One1 (TV s-bool) (bool-v false) (fst p)) (snd p)) (nfalse Δ (fst p)))
rfy-bool-c Δ X (inr1 (inr1 n)) = (fst n , nne Δ X (fst n) (snd n))
rfy-bool : RfyT s-bool
rfy-bool Δ X cx = rfy-bool-c Δ X (snd cx)
rfl-bool : RflT s-bool
rfl-bool Δ X ct c n = (ct , inr1 (inr1 (c , n)))
rty-fam-cod : (a b : TyShape) → RflT a → RTyT b → (Δ : CCtx) (T : Mean Δ (Fam a b)) → CompTy (s-fam f-pi a b) Δ T →
  RenR k-nf j-ty (ext-h Δ a (Fam a b) (fam-dom a b) T) b (fam-body Δ a b T)
rty-fam-cod a b rfl rty Δ T ct =
  cod-rty a b rfl rty Δ (Fam a b) (λ F → F) T
    (jc-tr j-ty (s-fam f-pi a b) Δ T (fmapM Δ (Fam a b) (Fam a b) (λ F → F) T)
       (psym (Mean Δ (Fam a b)) (fmapM Δ (Fam a b) (Fam a b) (λ F → F) T) T (fmap-id (dims (fst Δ)) (CtxV (fst Δ)) (FbE (fst Δ) (Fam a b)) (snd Δ) T)) ct)
rty-fam : (fm : FamF) (a b : TyShape) → RRT a → RRT b → RTyT (s-fam fm a b)
rty-fam fm a b Ra Rb Δ T ct = nn-ty-fam fm Δ a b T (fst Ra Δ (fmapM Δ (Fam a b) (Sem a) (fam-dom a b) T) (fst ct)) (rty-fam-cod a b (snd (snd Ra)) (fst Rb) Δ T ct)
rfy-pi-dom : (a b : TyShape) (Δ : CCtx) (X : Mean Δ (TV (s-fam f-pi a b))) → CompTy (s-fam f-pi a b) Δ (fmapM Δ (TV (s-fam f-pi a b)) (Fam a b) (λ q → fst q) X) →
  CompTy a Δ (fmapM Δ (TV (s-fam f-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) X)
rfy-pi-dom a b Δ X ct =
  jc-tr j-ty a Δ (fmapM Δ (Fam a b) (Sem a) (fam-dom a b) (fmapM Δ (TV (s-fam f-pi a b)) (Fam a b) (λ q → fst q) X)) (fmapM Δ (TV (s-fam f-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) X)
    (fmapM-fmapM Δ (TV (s-fam f-pi a b)) (Fam a b) (Sem a) (λ q → fst q) (fam-dom a b) X) (fst ct)
rfy-pi-body : (a b : TyShape) → RRT a → (Δ : CCtx) (X : Mean Δ (TV (s-fam f-pi a b))) → CompS (s-fam f-pi a b) Δ X → CompS b (lam-ctx Δ a b X) (lam-body Δ a b X)
rfy-pi-body a b Ra Δ X cx =
  jc-tr j-tm b (lam-ctx Δ a b X)
    (fmapM (lam-ctx Δ a b X) (AppV a b) (TV b) (app-r a b) (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (AppV a b) (λ q x → (fst q , snd q , x)) X))
    (lam-body Δ a b X)
    (lift-fm Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) X (AppV a b) (TV b) (λ q x → (fst q , snd q , x)) (app-r a b))
    (snd cx (lam-ctx Δ a b X) (world-wk Δ a (TV (s-fam f-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X)
       (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (AppV a b) (λ q x → (fst q , snd q , x)) X)
       (pcat (Mean (lam-ctx Δ a b X) (TV (s-fam f-pi a b)))
          (fmapM (lam-ctx Δ a b X) (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (AppV a b) (λ q x → (fst q , snd q , x)) X))
          (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (TV (s-fam f-pi a b)) (λ q x → q) X)
          (wact (lam-ctx Δ a b X) Δ (world-wk Δ a (TV (s-fam f-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X) (TV (s-fam f-pi a b)) X)
          (lift-fm Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) X (AppV a b) (TV (s-fam f-pi a b)) (λ q x → (fst q , snd q , x)) (app-f a b))
          (psym (Mean (lam-ctx Δ a b X) (TV (s-fam f-pi a b)))
             (wact (lam-ctx Δ a b X) Δ (world-wk Δ a (TV (s-fam f-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X) (TV (s-fam f-pi a b)) X)
             (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (TV (s-fam f-pi a b)) (λ q x → q) X)
             (pcat (Mean (lam-ctx Δ a b X) (TV (s-fam f-pi a b)))
                (wact (lam-ctx Δ a b X) Δ (world-wk Δ a (TV (s-fam f-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X) (TV (s-fam f-pi a b)) X)
                (wact (lam-ctx Δ a b X) Δ (world-wk Δ a (TV (s-fam f-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X) (TV (s-fam f-pi a b)) (fmapM Δ (TV (s-fam f-pi a b)) (TV (s-fam f-pi a b)) (λ q → q) X))
                (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (TV (s-fam f-pi a b)) (λ q x → q) X)
                (λ i → wact (lam-ctx Δ a b X) Δ (world-wk Δ a (TV (s-fam f-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X) (TV (s-fam f-pi a b))
                   (fmap-id (dims (fst Δ)) (CtxV (fst Δ)) (FbE (fst Δ) (TV (s-fam f-pi a b))) (snd Δ) X (~ i)))
                (wk-fm Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) X (TV (s-fam f-pi a b)) (λ q → q)))))
       (jc-tr j-tm a (lam-ctx Δ a b X) (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (TV a) (λ q x → (fam-dom a b (fst q) , x)) X)
          (fmapM (lam-ctx Δ a b X) (AppV a b) (TV a) (app-a a b) (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (AppV a b) (λ q x → (fst q , snd q , x)) X))
          (psym (Mean (lam-ctx Δ a b X) (TV a))
             (fmapM (lam-ctx Δ a b X) (AppV a b) (TV a) (app-a a b) (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (AppV a b) (λ q x → (fst q , snd q , x)) X))
             (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (TV a) (λ q x → (fam-dom a b (fst q) , x)) X)
             (lift-fm Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) X (AppV a b) (TV a) (λ q x → (fst q , snd q , x)) (app-a a b)))
          (var-comp a (snd (snd Ra)) Δ (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) X (rfy-pi-dom a b Δ X (fst cx)))))
rfy-pi : (a b : TyShape) → RRT a → RRT b → RfyT (s-fam f-pi a b)
rfy-pi a b Ra Rb Δ X cx =
  nn-lam Δ a b X (fst Ra Δ (fmapM Δ (TV (s-fam f-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) X) (rfy-pi-dom a b Δ X (fst cx)))
    (fst (snd Rb) (lam-ctx Δ a b X) (lam-body Δ a b X) (rfy-pi-body a b Ra Δ X cx))
rfy-sig : (a b : TyShape) → RRT a → RRT b → RfyT (s-fam f-sig a b)
rfy-sig a b Ra Rb Δ X cx =
  nn-pair Δ a b X (cod-rty a b (snd (snd Ra)) (fst Rb) Δ (TV (s-fam f-sig a b)) (λ q → fst q) X (fst cx))
    (fst (snd Ra) Δ (fmapM Δ (TV (s-fam f-sig a b)) (TV a) (sig-1 a b) X) (fst (snd cx))) (fst (snd Rb) Δ (fmapM Δ (TV (s-fam f-sig a b)) (TV b) (sig-2 a b) X) (snd (snd cx)))
rty-path-line : (a : TyShape) (Δ : CCtx) (T : Mean Δ (Sem (s-path a))) → CompTy (s-path a) Δ T → CompTy a (dext Δ) (path-line-ty Δ a T)
rty-path-line a Δ T ct =
  jc-tr j-ty a (dext Δ) (papp-line (dext Δ) (Sem (s-path a)) (Sem a) (ty-line a) dnf-v0 (wact (dext Δ) Δ (world-dwk Δ) (Sem (s-path a)) T)) (path-line-ty Δ a T)
    (pcat (Mean (dext Δ) (Sem a)) (papp-line (dext Δ) (Sem (s-path a)) (Sem a) (ty-line a) dnf-v0 (wact (dext Δ) Δ (world-dwk Δ) (Sem (s-path a)) T))
       (papp-line (dext Δ) (Sem (s-path a)) (Sem a) (ty-line a) dnf-v0 (dwkM Δ (Sem (s-path a)) T)) (path-line-ty Δ a T)
       (λ i → papp-line (dext Δ) (Sem (s-path a)) (Sem a) (ty-line a) dnf-v0 (subM-dwk Δ (Sem (s-path a)) T i))
       (papp-dwk Δ (Sem (s-path a)) (Sem a) (ty-line a) T))
    (fst ct (dext Δ) (world-dwk Δ) dnf-v0 unit unit)
rty-path : (a : TyShape) → RRT a → RTyT (s-path a)
rty-path a Ra Δ T ct =
  nn-ty-path Δ a T (fst Ra (dext Δ) (path-line-ty Δ a T) (rty-path-line a Δ T ct))
    (fst (snd Ra) Δ (fmapM Δ (Sem (s-path a)) (TV a) (tend-0 a) T) (fst (snd ct))) (fst (snd Ra) Δ (fmapM Δ (Sem (s-path a)) (TV a) (tend-1 a) T) (snd (snd ct)))
rfy-path-body : (a : TyShape) (Δ : CCtx) (X : Mean Δ (TV (s-path a))) → CompS (s-path a) Δ X → CompS a (dext Δ) (plam-body Δ a X)
rfy-path-body a Δ X cx =
  jc-tr j-tm a (dext Δ) (papp-mean (dext Δ) a dnf-v0 (wact (dext Δ) Δ (world-dwk Δ) (TV (s-path a)) X)) (plam-body Δ a X)
    (pcat (Mean (dext Δ) (TV a)) (papp-mean (dext Δ) a dnf-v0 (wact (dext Δ) Δ (world-dwk Δ) (TV (s-path a)) X))
       (papp-mean (dext Δ) a dnf-v0 (dwkM Δ (TV (s-path a)) X)) (plam-body Δ a X)
       (λ i → papp-mean (dext Δ) a dnf-v0 (subM-dwk Δ (TV (s-path a)) X i))
       (papp-dwk Δ (TV (s-path a)) (TV a) (path-pt a) X))
    (snd cx (dext Δ) (world-dwk Δ) dnf-v0 unit unit)
rfy-path : (a : TyShape) → RRT a → RfyT (s-path a)
rfy-path a Ra Δ X cx = nn-plam Δ a X (fst (snd Ra) (dext Δ) (plam-body Δ a X) (rfy-path-body a Δ X cx))
rfl-pi-cod : (a b : TyShape) (Δ : CCtx) (X : Mean Δ (TV (s-fam f-pi a b))) → CompTy (s-fam f-pi a b) Δ (fmapM Δ (TV (s-fam f-pi a b)) (Fam a b) (λ q → fst q) X) →
  (Δ' : CCtx) (w : World Δ' Δ) (Y : Mean Δ' (AppV a b)) →
  PathM Δ' (TV (s-fam f-pi a b)) (fmapM Δ' (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) Y) (wact Δ' Δ w (TV (s-fam f-pi a b)) X) →
  CompS a Δ' (fmapM Δ' (AppV a b) (TV a) (app-a a b) Y) → CompTy b Δ' (fmapM Δ' (TV b) (Sem b) (λ q → fst q) (fmapM Δ' (AppV a b) (TV b) (app-r a b) Y))
rfl-pi-cod a b Δ X ct Δ' w Y q ca =
  jc-tr j-ty b Δ' (fmapM Δ' (FamV a b) (Sem b) (fam-cod a b) (fmapM Δ' (AppV a b) (FamV a b) (λ r → (fst r , snd (snd r))) Y))
    (fmapM Δ' (TV b) (Sem b) (λ q → fst q) (fmapM Δ' (AppV a b) (TV b) (app-r a b) Y))
    (pcat (Mean Δ' (Sem b)) (fmapM Δ' (FamV a b) (Sem b) (fam-cod a b) (fmapM Δ' (AppV a b) (FamV a b) (λ r → (fst r , snd (snd r))) Y))
       (fmapM Δ' (AppV a b) (Sem b) (λ r → snd (fst r) (snd (snd r))) Y) (fmapM Δ' (TV b) (Sem b) (λ q → fst q) (fmapM Δ' (AppV a b) (TV b) (app-r a b) Y))
       (fmapM-fmapM Δ' (AppV a b) (FamV a b) (Sem b) (λ r → (fst r , snd (snd r))) (fam-cod a b) Y)
       (psym (Mean Δ' (Sem b)) (fmapM Δ' (TV b) (Sem b) (λ q → fst q) (fmapM Δ' (AppV a b) (TV b) (app-r a b) Y)) (fmapM Δ' (AppV a b) (Sem b) (λ r → snd (fst r) (snd (snd r))) Y)
          (fmapM-fmapM Δ' (AppV a b) (TV b) (Sem b) (app-r a b) (λ q → fst q) Y)))
    (snd ct Δ' w (fmapM Δ' (AppV a b) (FamV a b) (λ r → (fst r , snd (snd r))) Y)
       (pcat (Mean Δ' (Fam a b)) (fmapM Δ' (FamV a b) (Fam a b) (λ q → fst q) (fmapM Δ' (AppV a b) (FamV a b) (λ r → (fst r , snd (snd r))) Y))
          (fmapM Δ' (AppV a b) (Fam a b) (λ r → fst r) Y) (wact Δ' Δ w (Fam a b) (fmapM Δ (TV (s-fam f-pi a b)) (Fam a b) (λ q → fst q) X))
          (fmapM-fmapM Δ' (AppV a b) (FamV a b) (Fam a b) (λ r → (fst r , snd (snd r))) (λ q → fst q) Y)
          (pcat (Mean Δ' (Fam a b)) (fmapM Δ' (AppV a b) (Fam a b) (λ r → fst r) Y)
             (fmapM Δ' (TV (s-fam f-pi a b)) (Fam a b) (λ q → fst q) (fmapM Δ' (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) Y))
             (wact Δ' Δ w (Fam a b) (fmapM Δ (TV (s-fam f-pi a b)) (Fam a b) (λ q → fst q) X))
             (psym (Mean Δ' (Fam a b)) (fmapM Δ' (TV (s-fam f-pi a b)) (Fam a b) (λ q → fst q) (fmapM Δ' (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) Y)) (fmapM Δ' (AppV a b) (Fam a b) (λ r → fst r) Y)
                (fmapM-fmapM Δ' (AppV a b) (TV (s-fam f-pi a b)) (Fam a b) (app-f a b) (λ q → fst q) Y))
             (pcat (Mean Δ' (Fam a b)) (fmapM Δ' (TV (s-fam f-pi a b)) (Fam a b) (λ q → fst q) (fmapM Δ' (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) Y))
                (fmapM Δ' (TV (s-fam f-pi a b)) (Fam a b) (λ q → fst q) (wact Δ' Δ w (TV (s-fam f-pi a b)) X))
                (wact Δ' Δ w (Fam a b) (fmapM Δ (TV (s-fam f-pi a b)) (Fam a b) (λ q → fst q) X))
                (λ i → fmapM Δ' (TV (s-fam f-pi a b)) (Fam a b) (λ q → fst q) (q i))
                (subM-fmap Δ' Δ (TV (s-fam f-pi a b)) (Fam a b) (λ q → fst q) (world-sub Δ' Δ w) X))))
       (jc-tr j-tm a Δ' (fmapM Δ' (AppV a b) (TV a) (app-a a b) Y) (fmapM Δ' (FamV a b) (TV a) (fam-arg a b) (fmapM Δ' (AppV a b) (FamV a b) (λ r → (fst r , snd (snd r))) Y))
          (psym (Mean Δ' (TV a)) (fmapM Δ' (FamV a b) (TV a) (fam-arg a b) (fmapM Δ' (AppV a b) (FamV a b) (λ r → (fst r , snd (snd r))) Y)) (fmapM Δ' (AppV a b) (TV a) (app-a a b) Y)
             (fmapM-fmapM Δ' (AppV a b) (FamV a b) (TV a) (λ r → (fst r , snd (snd r))) (fam-arg a b) Y))
          ca))
rfl-pi : (a b : TyShape) → RRT a → RRT b → RflT (s-fam f-pi a b)
rfl-pi a b Ra Rb Δ X ct c n =
  (ct , λ Δ' w Y q ca →
     snd (snd Rb) Δ' (fmapM Δ' (AppV a b) (TV b) (app-r a b) Y) (rfl-pi-cod a b Δ X ct Δ' w Y q ca)
       (capp (fst (ren-ne {(j-tm , Δ , s-fam f-pi a b , c , X)} n Δ' w)) (fst (fst (snd Ra) Δ' (fmapM Δ' (AppV a b) (TV a) (app-a a b) Y) ca)))
       (napp Δ' a b Y (fst (ren-ne {(j-tm , Δ , s-fam f-pi a b , c , X)} n Δ' w)) (fst (fst (snd Ra) Δ' (fmapM Δ' (AppV a b) (TV a) (app-a a b) Y) ca))
          (d-tr t-ne j-tm Δ' (s-fam f-pi a b) (fst (ren-ne {(j-tm , Δ , s-fam f-pi a b , c , X)} n Δ' w)) (wact Δ' Δ w (TV (s-fam f-pi a b)) X) (fmapM Δ' (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) Y)
             (psym (Mean Δ' (TV (s-fam f-pi a b))) (fmapM Δ' (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) Y) (wact Δ' Δ w (TV (s-fam f-pi a b)) X) q) (snd (ren-ne {(j-tm , Δ , s-fam f-pi a b , c , X)} n Δ' w)))
          (snd (fst (snd Ra) Δ' (fmapM Δ' (AppV a b) (TV a) (app-a a b) Y) ca))))
rfl-sig-1 : (a b : TyShape) → RRT a → (Δ : CCtx) (X : Mean Δ (TV (s-fam f-sig a b))) → CompTy (s-fam f-sig a b) Δ (fmapM Δ (TV (s-fam f-sig a b)) (Fam a b) (λ q → fst q) X) →
  (c : Code) → NN (k-ne , (j-tm , Δ , s-fam f-sig a b , c , X)) → CompS a Δ (fmapM Δ (TV (s-fam f-sig a b)) (TV a) (sig-1 a b) X)
rfl-sig-1 a b Ra Δ X ct c n =
  snd (snd Ra) Δ (fmapM Δ (TV (s-fam f-sig a b)) (TV a) (sig-1 a b) X)
    (jc-tr j-ty a Δ (fmapM Δ (Fam a b) (Sem a) (fam-dom a b) (fmapM Δ (TV (s-fam f-sig a b)) (Fam a b) (λ q → fst q) X)) (fmapM Δ (TV a) (Sem a) (λ q → fst q) (fmapM Δ (TV (s-fam f-sig a b)) (TV a) (sig-1 a b) X))
       (pcat (Mean Δ (Sem a)) (fmapM Δ (Fam a b) (Sem a) (fam-dom a b) (fmapM Δ (TV (s-fam f-sig a b)) (Fam a b) (λ q → fst q) X)) (fmapM Δ (TV (s-fam f-sig a b)) (Sem a) (λ q → fst (fst q)) X)
          (fmapM Δ (TV a) (Sem a) (λ q → fst q) (fmapM Δ (TV (s-fam f-sig a b)) (TV a) (sig-1 a b) X))
          (fmapM-fmapM Δ (TV (s-fam f-sig a b)) (Fam a b) (Sem a) (λ q → fst q) (fam-dom a b) X)
          (psym (Mean Δ (Sem a)) (fmapM Δ (TV a) (Sem a) (λ q → fst q) (fmapM Δ (TV (s-fam f-sig a b)) (TV a) (sig-1 a b) X)) (fmapM Δ (TV (s-fam f-sig a b)) (Sem a) (λ q → fst (fst q)) X)
             (fmapM-fmapM Δ (TV (s-fam f-sig a b)) (TV a) (Sem a) (sig-1 a b) (λ q → fst q) X)))
       (fst ct))
    (cfst c) (nfst Δ a b X c n)
rfl-sig-cod : (a b : TyShape) (Δ : CCtx) (X : Mean Δ (TV (s-fam f-sig a b))) → CompTy (s-fam f-sig a b) Δ (fmapM Δ (TV (s-fam f-sig a b)) (Fam a b) (λ q → fst q) X) →
  CompS a Δ (fmapM Δ (TV (s-fam f-sig a b)) (TV a) (sig-1 a b) X) → CompTy b Δ (fmapM Δ (TV b) (Sem b) (λ q → fst q) (fmapM Δ (TV (s-fam f-sig a b)) (TV b) (sig-2 a b) X))
rfl-sig-cod a b Δ X ct c1 =
  jc-tr j-ty b Δ (fmapM Δ (FamV a b) (Sem b) (fam-cod a b) (fmapM Δ (TV (s-fam f-sig a b)) (FamV a b) (λ q → (fst q , fst (snd q))) X))
    (fmapM Δ (TV b) (Sem b) (λ q → fst q) (fmapM Δ (TV (s-fam f-sig a b)) (TV b) (sig-2 a b) X))
    (pcat (Mean Δ (Sem b)) (fmapM Δ (FamV a b) (Sem b) (fam-cod a b) (fmapM Δ (TV (s-fam f-sig a b)) (FamV a b) (λ q → (fst q , fst (snd q))) X))
       (fmapM Δ (TV (s-fam f-sig a b)) (Sem b) (λ q → snd (fst q) (fst (snd q))) X) (fmapM Δ (TV b) (Sem b) (λ q → fst q) (fmapM Δ (TV (s-fam f-sig a b)) (TV b) (sig-2 a b) X))
       (fmapM-fmapM Δ (TV (s-fam f-sig a b)) (FamV a b) (Sem b) (λ q → (fst q , fst (snd q))) (fam-cod a b) X)
       (psym (Mean Δ (Sem b)) (fmapM Δ (TV b) (Sem b) (λ q → fst q) (fmapM Δ (TV (s-fam f-sig a b)) (TV b) (sig-2 a b) X)) (fmapM Δ (TV (s-fam f-sig a b)) (Sem b) (λ q → snd (fst q) (fst (snd q))) X)
          (fmapM-fmapM Δ (TV (s-fam f-sig a b)) (TV b) (Sem b) (sig-2 a b) (λ q → fst q) X)))
    (snd ct Δ (world-id Δ) (fmapM Δ (TV (s-fam f-sig a b)) (FamV a b) (λ q → (fst q , fst (snd q))) X)
       (pcat (Mean Δ (Fam a b)) (fmapM Δ (FamV a b) (Fam a b) (λ q → fst q) (fmapM Δ (TV (s-fam f-sig a b)) (FamV a b) (λ q → (fst q , fst (snd q))) X))
          (fmapM Δ (TV (s-fam f-sig a b)) (Fam a b) (λ q → fst q) X) (wact Δ Δ (world-id Δ) (Fam a b) (fmapM Δ (TV (s-fam f-sig a b)) (Fam a b) (λ q → fst q) X))
          (fmapM-fmapM Δ (TV (s-fam f-sig a b)) (FamV a b) (Fam a b) (λ q → (fst q , fst (snd q))) (λ q → fst q) X)
          (psym (Mean Δ (Fam a b)) (wact Δ Δ (world-id Δ) (Fam a b) (fmapM Δ (TV (s-fam f-sig a b)) (Fam a b) (λ q → fst q) X)) (fmapM Δ (TV (s-fam f-sig a b)) (Fam a b) (λ q → fst q) X)
             (subM-id Δ (Fam a b) (fmapM Δ (TV (s-fam f-sig a b)) (Fam a b) (λ q → fst q) X))))
       (jc-tr j-tm a Δ (fmapM Δ (TV (s-fam f-sig a b)) (TV a) (sig-1 a b) X) (fmapM Δ (FamV a b) (TV a) (fam-arg a b) (fmapM Δ (TV (s-fam f-sig a b)) (FamV a b) (λ q → (fst q , fst (snd q))) X))
          (psym (Mean Δ (TV a)) (fmapM Δ (FamV a b) (TV a) (fam-arg a b) (fmapM Δ (TV (s-fam f-sig a b)) (FamV a b) (λ q → (fst q , fst (snd q))) X)) (fmapM Δ (TV (s-fam f-sig a b)) (TV a) (sig-1 a b) X)
             (fmapM-fmapM Δ (TV (s-fam f-sig a b)) (FamV a b) (TV a) (λ q → (fst q , fst (snd q))) (fam-arg a b) X))
          c1))
rfl-sig : (a b : TyShape) → RRT a → RRT b → RflT (s-fam f-sig a b)
rfl-sig a b Ra Rb Δ X ct c n =
  (ct , rfl-sig-1 a b Ra Δ X ct c n ,
   snd (snd Rb) Δ (fmapM Δ (TV (s-fam f-sig a b)) (TV b) (sig-2 a b) X) (rfl-sig-cod a b Δ X ct (rfl-sig-1 a b Ra Δ X ct c n)) (csnd c) (nsnd Δ a b X c n))
rfl-path-ty : (a : TyShape) (Δ' : CCtx) (f : DNF) (X' : Mean Δ' (TV (s-path a))) (T' : Mean Δ' (Sem (s-path a))) →
  PathM Δ' (Sem (s-path a)) (fmapM Δ' (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) X') T' →
  PathM Δ' (Sem a) (papp-line Δ' (Sem (s-path a)) (Sem a) (ty-line a) f T') (fmapM Δ' (TV a) (Sem a) (λ q → fst q) (papp-mean Δ' a f X'))
rfl-path-ty a Δ' f X' T' p =
  pcat (Mean Δ' (Sem a)) (papp-line Δ' (Sem (s-path a)) (Sem a) (ty-line a) f T')
    (papp-line Δ' (Sem (s-path a)) (Sem a) (ty-line a) f (fmapM Δ' (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) X'))
    (fmapM Δ' (TV a) (Sem a) (λ q → fst q) (papp-mean Δ' a f X'))
    (λ i → papp-line Δ' (Sem (s-path a)) (Sem a) (ty-line a) f (p (~ i)))
    (pcat (Mean Δ' (Sem a)) (papp-line Δ' (Sem (s-path a)) (Sem a) (ty-line a) f (fmapM Δ' (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) X'))
       (papp-line Δ' (TV (s-path a)) (Sem a) (λ y → line-map (TV a) (Sem a) (λ q → fst q) (path-pt a y)) f X')
       (fmapM Δ' (TV a) (Sem a) (λ q → fst q) (papp-mean Δ' a f X'))
       (papp-line-pre Δ' (TV (s-path a)) (Sem (s-path a)) (Sem a) (λ q → fst q) (ty-line a) f X')
       (psym (Mean Δ' (Sem a)) (fmapM Δ' (TV a) (Sem a) (λ q → fst q) (papp-mean Δ' a f X')) (papp-line Δ' (TV (s-path a)) (Sem a) (λ y → line-map (TV a) (Sem a) (λ q → fst q) (path-pt a y)) f X')
          (papp-line-fmap Δ' (TV (s-path a)) (TV a) (Sem a) (path-pt a) (λ q → fst q) f X')))
rfl-path : (a : TyShape) → RRT a → RflT (s-path a)
rfl-path a Ra Δ X ct c n =
  (ct , λ Δ' w f cf nc →
     snd (snd Ra) Δ' (papp-mean Δ' a f (wact Δ' Δ w (TV (s-path a)) X))
       (jc-tr j-ty a Δ' (papp-line Δ' (Sem (s-path a)) (Sem a) (ty-line a) f (wact Δ' Δ w (Sem (s-path a)) (fmapM Δ (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) X)))
          (fmapM Δ' (TV a) (Sem a) (λ q → fst q) (papp-mean Δ' a f (wact Δ' Δ w (TV (s-path a)) X)))
          (rfl-path-ty a Δ' f (wact Δ' Δ w (TV (s-path a)) X) (wact Δ' Δ w (Sem (s-path a)) (fmapM Δ (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) X))
             (subM-fmap Δ' Δ (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) (world-sub Δ' Δ w) X))
          (fst ct Δ' w f cf nc))
       (cpapp (fst (ren-ne {(j-tm , Δ , s-path a , c , X)} n Δ' w)) (dnf-code f))
       (npapp Δ' a (wact Δ' Δ w (TV (s-path a)) X) (fst (ren-ne {(j-tm , Δ , s-path a , c , X)} n Δ' w)) f cf nc (papp-mean Δ' a f (wact Δ' Δ w (TV (s-path a)) X))
          (λ i → papp-mean Δ' a f (wact Δ' Δ w (TV (s-path a)) X)) (snd (ren-ne {(j-tm , Δ , s-path a , c , X)} n Δ' w))))
rr : (s : TyShape) → RRT s
rr s-bool = (rty-bool , rfy-bool , rfl-bool)
rr (s-fam f-pi a b) = (rty-fam f-pi a b (rr a) (rr b) , rfy-pi a b (rr a) (rr b) , rfl-pi a b (rr a) (rr b))
rr (s-fam f-sig a b) = (rty-fam f-sig a b (rr a) (rr b) , rfy-sig a b (rr a) (rr b) , rfl-sig a b (rr a) (rr b))
rr (s-path a) = (rty-path a (rr a) , rfy-path a (rr a) , rfl-path a (rr a))
lineo-dzip : (X R : Type 1) (S F G : X → Type 1) (W : R → Type 1) (f : (x : X) → S x → R) (k : (x : X) → S x → G x) (π : (x : X) → F x → G x)
  (tr : (x : X) (t : S x) (φ : F x) → PathP (λ i → G x) (π x φ) (k x t) → W (f x t))
  (L : Line X) (T : LineO X S L) (A : LineO X F L) → PathP (λ i → LineO X G L) (lineo-fmap X F G π L A) (lineo-fmap X S G k L T) →
  LineO R W (lineo-map X S R f L T)
lineo-dzip X R S F G W f k π tr L T A P =
  (tr (fst L) (fst T) (fst A) (λ i → fst (P i)) , tr (fst (snd L)) (fst (snd T)) (fst (snd A)) (λ i → fst (snd (P i))) ,
   λ j → tr (snd (snd L) j) (snd (snd T) j) (snd (snd A) j) (λ i → snd (snd (P i)) j))
dcube-dzip : (n : Nat) (X R : Type 1) (S F G : X → Type 1) (W : R → Type 1) (f : (x : X) → S x → R) (k : (x : X) → S x → G x) (π : (x : X) → F x → G x)
  (tr : (x : X) (t : S x) (φ : F x) → PathP (λ i → G x) (π x φ) (k x t) → W (f x t))
  (c : Cube n X) (T : DCube n X S c) (A : DCube n X F c) → PathP (λ i → DCube n X G c) (dcube-fmap n X F G π c A) (dcube-fmap n X S G k c T) →
  DCube n R W (dcube-map n X S R f c T)
dcube-dzip zero X R S F G W f k π tr c T A P = tr c T A P
dcube-dzip (suc n) X R S F G W f k π tr c T A P =
