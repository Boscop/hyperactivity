-- the two booleans and the two path endpoints, each one clause generic in the bit
bool-in : (b : Bool) (A : Bool → Type 1) (N : Type 1) → A b → Sum1 (A true) (Sum1 (A false) N)
bool-in true A N x = inl1 x
bool-in false A N x = inr1 (inl1 x)
end-pick : (b : Bool) (A : Bool → Type 1) → A false × A true → A b
end-pick false A p = fst p
end-pick true A p = snd p
