    (pcat (Mean Γ (Sem a)) (subM Γ (dext Γ) (Sem a) (sub-form Γ Γ (sub-id Γ) dnf-one) L) (papp-line Γ (Line (Sem a)) (Sem a) (λ l → l) dnf-one (ul Γ (Sem a) L))
      (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst (snd l)) (ul Γ (Sem a) L))
