pt-W-pr : (Γ : CCtx) (a : TyShape) (L : Mean (dext Γ) (Sem a)) (M0 : Mean Γ (TV a)) (p0 : PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) M0) (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst l) (ul Γ (Sem a) L))) (Z2 : Type 1) (pr : Line (Sem a) → Z2) →
  PathM Γ Z2 (fmapM Γ (LnE a) Z2 (λ q → pr (fst q)) (pt-W Γ a L M0 p0)) (fmapM Γ (Line (Sem a)) Z2 pr (ul Γ (Sem a) L))
