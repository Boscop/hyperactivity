    (fund dL Γ (sub-form Γ Γ (sub-id Γ) dnf-one) (form-env Γ Γ (sub-id Γ) dnf-one unit (id-envOf Γ vs)))
LnE : TyShape → Type 1
LnE a = (lnl : Line (Sem a)) × El a (fst lnl)
pt-W : (Γ : CCtx) (a : TyShape) (L : Mean (dext Γ) (Sem a)) (M0 : Mean Γ (TV a)) → PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) M0) (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst l) (ul Γ (Sem a) L)) → Mean Γ (LnE a)
