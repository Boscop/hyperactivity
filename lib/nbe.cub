          (pcat (Mean Γ (Line (Sem a))) (fmapM Γ (Sem (s-path a)) (Line (Sem a)) (ty-line a) (pt-T Γ a L M0 p0 M1 p1)) (fmapM Γ (LnE a) (Line (Sem a)) (λ q → fst q) (pt-W Γ a L M0 p0)) (ul Γ (Sem a) L)
            (retype-fst Γ a (LnE a) (Sem (s-path a)) (λ q → fst (snd (fst q))) (λ q v → (fst q , snd q , v)) (pt-W Γ a L M0 p0) M1 (pt-p1 Γ a L M0 p0 M1 p1) (Line (Sem a)) (ty-line a) (λ q → fst q) (λ i q v → fst q))
            (pcat (Mean Γ (Line (Sem a))) (fmapM Γ (LnE a) (Line (Sem a)) (λ q → fst q) (pt-W Γ a L M0 p0)) (fmapM Γ (Line (Sem a)) (Line (Sem a)) (λ l → l) (ul Γ (Sem a) L)) (ul Γ (Sem a) L)
              (pt-W-pr Γ a L M0 p0 (Line (Sem a)) (λ l → l)) (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (Line (Sem a))) (snd Γ) (ul Γ (Sem a) L)))) i))
      (reidx-fmap (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (FbE (fst Γ) (Sem (s-path a))) (FbE (fst Γ) (Line (Sem a))) (LineO (CtxV (fst Γ)) (FbE (fst Γ) (Sem a)))
        (λ γq eq ρq → ty-line a (eq ρq)) (degen-l (CtxV (fst Γ))) (fline (fst Γ) (Line (Sem a)) (Sem a) (λ l → l)) (snd Γ) (pt-T Γ a L M0 p0 M1 p1)))
pty-fin : (Γ : CCtx) (a : TyShape) (cL c0 c1 : Code) (L : Mean (dext Γ) (Sem a)) → Der (j-ty , dext Γ , a , cL , L) →
  (M0 : Mean Γ (TV a)) (p0 : PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) M0) (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst l) (ul Γ (Sem a) L))) → Der (j-tm , Γ , a , c0 , M0) → (M1 : Mean Γ (TV a)) (p1 : PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) M1) (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst (snd l)) (ul Γ (Sem a) L))) → Der (j-tm , Γ , a , c1 , M1) →
  Dec1 (Out Γ (cpathp (cplam cL) c0 c1) m-ty)
pty-fin Γ a cL c0 c1 L dL M0 p0 d0 M1 p1 d1 =
  c-derived (s-path a , (pt-T Γ a L M0 p0 M1 p1) ,
    dty-path Γ a (pt-T Γ a L M0 p0 M1 p1) cL c0 c1
      (d-tr t-any j-ty (dext Γ) a cL L (path-line-ty Γ a (pt-T Γ a L M0 p0 M1 p1)) (pt-line Γ a L M0 p0 M1 p1) dL)
      (d-tr t-any j-tm Γ a c0 M0 (fmapM Γ (Sem (s-path a)) (TV a) (tend-0 a) (pt-T Γ a L M0 p0 M1 p1))
        (psym (Mean Γ (TV a)) (fmapM Γ (Sem (s-path a)) (TV a) (tend-0 a) (pt-T Γ a L M0 p0 M1 p1)) M0
          (pcat (Mean Γ (TV a)) (fmapM Γ (Sem (s-path a)) (TV a) (tend-0 a) (pt-T Γ a L M0 p0 M1 p1)) (fmapM Γ (LnE a) (TV a) (λ q → (fst (fst q) , snd q)) (pt-W Γ a L M0 p0)) M0
            (retype-fst Γ a (LnE a) (Sem (s-path a)) (λ q → fst (snd (fst q))) (λ q v → (fst q , snd q , v)) (pt-W Γ a L M0 p0) M1 (pt-p1 Γ a L M0 p0 M1 p1) (TV a) (tend-0 a) (λ q → (fst (fst q) , snd q)) (λ i q v → (fst (fst q) , snd q)))
            (retype-val Γ a (Line (Sem a)) (LnE a) (λ l → fst l) (λ l v → (l , v)) (ul Γ (Sem a) L) M0 p0 (λ q → (fst (fst q) , snd q)) (λ i l v → (fst l , v)))))
        d0)
      (d-tr t-any j-tm Γ a c1 M1 (fmapM Γ (Sem (s-path a)) (TV a) (tend-1 a) (pt-T Γ a L M0 p0 M1 p1))
        (psym (Mean Γ (TV a)) (fmapM Γ (Sem (s-path a)) (TV a) (tend-1 a) (pt-T Γ a L M0 p0 M1 p1)) M1
          (retype-val Γ a (LnE a) (Sem (s-path a)) (λ q → fst (snd (fst q))) (λ q v → (fst q , snd q , v)) (pt-W Γ a L M0 p0) M1 (pt-p1 Γ a L M0 p0 M1 p1) (tend-1 a) (λ i q v → (fst (snd (fst q)) , v))))
        d1))
pty-3 : Rec → (Γ : CCtx) → Vals Γ → (a : TyShape) (cL c0 c1 : Code) (L : Mean (dext Γ) (Sem a)) → Der (j-ty , dext Γ , a , cL , L) →
  (M0 : Mean Γ (TV a)) (p0 : PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) M0) (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst l) (ul Γ (Sem a) L))) → Der (j-tm , Γ , a , c0 , M0) → Dec1 (Out Γ (cpathp (cplam cL) c0 c1) m-ty)
pty-3 rec Γ vs a cL c0 c1 L dL M0 p0 d0 =
  d-bind (Out Γ c1 (m-chk a (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst (snd l)) (ul Γ (Sem a) L)) (face1-ct Γ vs a cL L dL))) (Out Γ (cpathp (cplam cL) c0 c1) m-ty)
    (rec Γ vs c1 (m-chk a (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst (snd l)) (ul Γ (Sem a) L)) (face1-ct Γ vs a cL L dL)))
    (λ r1 → pty-fin Γ a cL c0 c1 L dL M0 p0 d0 (fst r1) (fst (snd r1)) (snd (snd r1)))
pty-2 : Rec → (Γ : CCtx) → Vals Γ → (cL c0 c1 : Code) (a : TyShape) (L : Mean (dext Γ) (Sem a)) → Der (j-ty , dext Γ , a , cL , L) →
  Dec1 (Out Γ (cpathp (cplam cL) c0 c1) m-ty)
pty-2 rec Γ vs cL c0 c1 a L dL =
  d-bind (Out Γ c0 (m-chk a (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst l) (ul Γ (Sem a) L)) (face0-ct Γ vs a cL L dL))) (Out Γ (cpathp (cplam cL) c0 c1) m-ty)
    (rec Γ vs c0 (m-chk a (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst l) (ul Γ (Sem a) L)) (face0-ct Γ vs a cL L dL)))
    (λ r0 → pty-3 rec Γ vs a cL c0 c1 L dL (fst r0) (fst (snd r0)) (snd (snd r0)))
line-pt : (a : TyShape) → Line (TV a) → TV (s-path a)
line-pt a l = (((fst (fst l) , fst (fst (snd l)) , λ iq → fst (snd (snd l) iq)) , snd (fst l) , snd (fst (snd l))) , λ iq → snd (snd (snd l) iq))
plx : (Γ : CCtx) (a : TyShape) → Mean (dext Γ) (TV a) → Mean Γ (TV (s-path a))
plx Γ a B = fmapM Γ (Line (TV a)) (TV (s-path a)) (line-pt a) (ul Γ (TV a) B)
plam-body-pth : (Γ : CCtx) (a : TyShape) (B : Mean (dext Γ) (TV a)) → PathM (dext Γ) (TV a) B (plam-body Γ a (plx Γ a B))
plam-body-pth Γ a B =
  pcat (Mean (dext Γ) (TV a)) B (dline-body Γ (Line (TV a)) (TV a) (λ l → l) (ul Γ (TV a) B)) (plam-body Γ a (plx Γ a B))
    (ul-dl Γ (TV a) B)
    (psym (Mean (dext Γ) (TV a)) (plam-body Γ a (plx Γ a B)) (dline-body Γ (Line (TV a)) (TV a) (λ l → l) (ul Γ (TV a) B))
      (reidx-fmap (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (FbE (fst Γ) (Line (TV a))) (FbE (fst Γ) (TV (s-path a))) (LineO (CtxV (fst Γ)) (FbE (fst Γ) (TV a)))
        (λ γq eq ρq → line-pt a (eq ρq)) (degen-l (CtxV (fst Γ))) (fline (fst Γ) (TV (s-path a)) (TV a) (path-pt a)) (snd Γ) (ul Γ (TV a) B)))
line-ct : (Γ : CCtx) (a : TyShape) (T : Mean Γ (Sem (s-path a))) → CompTy (s-path a) Γ T → CompTy a (dext Γ) (path-line-ty Γ a T)
line-ct Γ a T ct =
  jc-tr j-ty a (dext Γ) (papp-line (dext Γ) (Sem (s-path a)) (Sem a) (ty-line a) dnf-v0 (wact (dext Γ) Γ (world-dwk Γ) (Sem (s-path a)) T)) (path-line-ty Γ a T)
    (pcat (Mean (dext Γ) (Sem a)) (papp-line (dext Γ) (Sem (s-path a)) (Sem a) (ty-line a) dnf-v0 (wact (dext Γ) Γ (world-dwk Γ) (Sem (s-path a)) T))
      (papp-line (dext Γ) (Sem (s-path a)) (Sem a) (ty-line a) dnf-v0 (dwkM Γ (Sem (s-path a)) T)) (path-line-ty Γ a T)
      (λ i → papp-line (dext Γ) (Sem (s-path a)) (Sem a) (ty-line a) dnf-v0 (subM-dwk Γ (Sem (s-path a)) T i))
      (papp-dwk Γ (Sem (s-path a)) (Sem a) (ty-line a) T))
    (fst ct (dext Γ) (world-dwk Γ) dnf-v0 unit unit)
pl-fin : Cv → (Γ : CCtx) → Vals Γ → (a : TyShape) (T : Mean Γ (Sem (s-path a))) (ct : CompTy (s-path a) Γ T) (c₀ : Code) (B : Mean (dext Γ) (TV a)) →
  Der (j-tm , dext Γ , a , c₀ , B) → Dec1 (Out Γ (cplam c₀) (m-chk (s-path a) T ct))
pl-fin cv Γ vs a T ct c₀ B dB =
  d-bind (PathM Γ (Sem (s-path a)) (fmapM Γ (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) (plx Γ a B)) T) (Out Γ (cplam c₀) (m-chk (s-path a) T ct))
    (conv-at cv Γ (s-path a) (fmapM Γ (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) (plx Γ a B)) T
      (fst (comp-j j-tm Γ vs (s-path a) (cplam c₀) (plx Γ a B) (dplam Γ a (plx Γ a B) c₀ (d-tr t-any j-tm (dext Γ) a c₀ B (plam-body Γ a (plx Γ a B)) (plam-body-pth Γ a B) dB)))) ct)
    (λ p → c-derived (plx Γ a B , p , dplam Γ a (plx Γ a B) c₀ (d-tr t-any j-tm (dext Γ) a c₀ B (plam-body Γ a (plx Γ a B)) (plam-body-pth Γ a B) dB)))
plam-chk : Cv → Rec → (Γ : CCtx) → Vals Γ → (c₀ : Code) (s : TyShape) (T : Mean Γ (Sem s)) (ct : CompTy s Γ T) → Dec1 (Out Γ (cplam c₀) (m-chk s T ct))
plam-chk cv rec Γ vs c₀ (s-path a) T ct =
  d-bind (Out (dext Γ) c₀ (m-chk a (path-line-ty Γ a T) (line-ct Γ a T ct))) (Out Γ (cplam c₀) (m-chk (s-path a) T ct))
    (rec (dext Γ) (dext-vals Γ vs) c₀ (m-chk a (path-line-ty Γ a T) (line-ct Γ a T ct)))
    (λ rB → pl-fin cv Γ vs a T ct c₀ (fst rB) (snd (snd rB)))
plam-chk cv rec Γ vs c₀ s T ct = c-refused
elab-step : Cv → Rec → Rec
elab-step cv rec Γ vs (cdata d lnil) m-ty =
  o-bind (d ≡ #0) (Out Γ (cdata d lnil) m-ty) (w-dec d #0)
    (λ p → c-derived (s-bool , one-mean Γ , der-code j-ty Γ s-bool c-bool (cdata d lnil) (one-mean Γ) (λ i → cdata (p (~ i)) lnil) (dty-bool Γ (one-mean Γ))))
elab-step cv rec Γ vs (cpi m cA cB) m-ty =
  o-bind (m ≡ #2) (Out Γ (cpi m cA cB) m-ty) (w-dec m #2)
    (λ pm → d-bind (Out Γ cA m-ty) (Out Γ (cpi m cA cB) m-ty) (rec Γ vs cA m-ty)
       (λ rA → ty-pi-1 rec Γ vs m cA cB pm (fst rA) (fst (snd rA)) (snd (snd rA))))
elab-step cv rec Γ vs (csigma cA cB) m-ty =
  d-bind (Out Γ cA m-ty) (Out Γ (csigma cA cB) m-ty) (rec Γ vs cA m-ty) (λ rA → ty-sig-1 rec Γ vs cA cB (fst rA) (fst (snd rA)) (snd (snd rA)))
elab-step cv rec Γ vs (cvar k) m-inf =
  o-bind ((v : VarP (fst Γ)) × var-word (fst Γ) v ≡ k) (Out Γ (cvar k) m-inf) (var-find (fst Γ) (var-word (fst Γ)) k)
    (λ r → c-derived (var-shape (fst Γ) (fst r) , varCube Γ (fst r) ,
       der-code j-tm Γ (var-shape (fst Γ) (fst r)) (cvar (var-word (fst Γ) (fst r))) (cvar k) (varCube Γ (fst r)) (λ i → cvar (snd r i)) (dvar Γ (fst r))))
elab-step cv rec Γ vs (capp f c) m-inf = d-bind (Out Γ f m-inf) (Out Γ (capp f c) m-inf) (rec Γ vs f m-inf) (λ r → app-1 rec Γ vs f c (fst r) (fst (snd r)) (snd (snd r)))
elab-step cv rec Γ vs (celim d (clam cP) (lcons t (lcons f lnil)) x) m-inf =
  o-bind (d ≡ #0) (Out Γ (celim d (clam cP) (lcons t (lcons f lnil)) x) m-inf) (w-dec d #0) (case-1 rec Γ vs cP x t f d)
elab-step cv rec Γ vs (cpapp p r) m-inf = d-bind (Out Γ p m-inf) (Out Γ (cpapp p r) m-inf) (rec Γ vs p m-inf) (λ rp → papp-1 Γ p r (fst rp) (fst (snd rp)) (snd (snd rp)))
elab-step cv rec Γ vs (cfst p) m-inf = d-bind (Out Γ p m-inf) (Out Γ (cfst p) m-inf) (rec Γ vs p m-inf) (λ r → inf-fst Γ p (fst r) (fst (snd r)) (snd (snd r)))
elab-step cv rec Γ vs (csnd p) m-inf = d-bind (Out Γ p m-inf) (Out Γ (csnd p) m-inf) (rec Γ vs p m-inf) (λ r → inf-snd Γ p (fst r) (fst (snd r)) (snd (snd r)))
elab-step cv rec Γ vs (ccon d k lnil lnil) (m-chk s T ct) =
  o-bind (d ≡ #0) (Out Γ (ccon d k lnil lnil) (m-chk s T ct)) (w-dec d #0) (λ pd → chk-con-at Γ d k s T ct pd)
elab-step cv rec Γ vs (clam c₀) (m-chk s T ct) = lam-at rec Γ vs c₀ s T ct
elab-step cv rec Γ vs (cpair c1 c2) (m-chk s T ct) = pair-at rec Γ vs c1 c2 s T ct
elab-step cv rec Γ vs (cplam c₀) (m-chk s T ct) = plam-chk cv rec Γ vs c₀ s T ct
elab-step cv rec Γ vs c (m-chk s T ct) = d-bind (Out Γ c m-inf) (Out Γ c (m-chk s T ct)) (rec Γ vs c m-inf) (switch cv Γ vs c s T ct)
elab-step cv rec Γ vs (cpathp (cplam cL) c0 c1) m-ty =
  d-bind (Out (dext Γ) cL m-ty) (Out Γ (cpathp (cplam cL) c0 c1) m-ty) (rec (dext Γ) (dext-vals Γ vs) cL m-ty)
    (λ rL → pty-2 rec Γ vs cL c0 c1 (fst rL) (fst (snd rL)) (snd (snd rL)))
elab-step cv rec Γ vs c m = c-refused
elab-n : Cv → Nat → Rec
elab-n cv zero Γ vs c m = c-refused
elab-n cv (suc u) Γ vs c m = elab-step cv (elab-n cv u) Γ vs c m
