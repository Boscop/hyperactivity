    (papp-line Γ (Line Z) Z (λ l → l) g (ul Γ Z L))
    (λ i → subM Γ (dext Γ) Z (sub-form Γ Γ (sub-id Γ) g) (ul-dl Γ Z L i))
    (pcat (Mean Γ Z) (subM Γ (dext Γ) Z (sub-form Γ Γ (sub-id Γ) g) (dline-body Γ (Line Z) Z (λ l → l) (ul Γ Z L)))
      (papp-line Γ (Line Z) Z (λ l → l) g (subM Γ Γ (Line Z) (sub-id Γ) (ul Γ Z L))) (papp-line Γ (Line Z) Z (λ l → l) g (ul Γ Z L))
