  (v : VarP (lcons (e-ty a) (fst Δ))) → CompS (var-shape (lcons (e-ty a) (fst Δ)) v) Δ' (subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV (var-shape (lcons (e-ty a) (fst Δ)) v)) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (varCube (ext-h Δ a Y (λ y → h' (j y)) M) v))
ext-env-v Δ' Δ a Y Y' j h' M σ A' p e cn none = jc-tr j-tm a Δ' (fmapM Δ' ((yz : Y) × El a (h' (j yz))) (TV a) (λ z → (h' (j (fst z)) , snd z)) (zpt Δ' Δ a Y Y' j h' M σ A' p)) (subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV a) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (varCube (ext-h Δ a Y (λ y → h' (j y)) M) none)) (psym (Mean Δ' (TV a)) (subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV a) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (varCube (ext-h Δ a Y (λ y → h' (j y)) M) none)) (fmapM Δ' ((yz : Y) × El a (h' (j yz))) (TV a) (λ z → (h' (j (fst z)) , snd z)) (zpt Δ' Δ a Y Y' j h' M σ A' p)) (ext-new Δ' Δ a Y Y' j h' M σ A' p)) cn
