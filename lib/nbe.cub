case-cl Γ s R Δ σ e motive cx ct cf (inr1 (inr1 n)) = (snd (snd (rr s)) Δ (fmapM Δ (CaseV s) (TV s) (case-r s) (subM Δ Γ (CaseV s) σ R)) (cm-scr Γ s R Δ σ e motive cx) (c-case (fst (fst (rr s) (ext-h Δ s-bool (CaseV s) (case-b s) (subM Δ Γ (CaseV s) σ R)) (case-mot Δ s (subM Δ Γ (CaseV s) σ R)) (cm-gen Γ s R Δ σ e motive))) (fst (fst (snd (rr s)) Δ (fmapM Δ (CaseV s) (TV s) (case-t s) (subM Δ Γ (CaseV s) σ R)) ct)) (fst (fst (snd (rr s)) Δ (fmapM Δ (CaseV s) (TV s) (case-f s) (subM Δ Γ (CaseV s) σ R)) cf)) (fst n)) (ncase Δ s (subM Δ Γ (CaseV s) σ R) (fst (fst (rr s) (ext-h Δ s-bool (CaseV s) (case-b s) (subM Δ Γ (CaseV s) σ R)) (case-mot Δ s (subM Δ Γ (CaseV s) σ R)) (cm-gen Γ s R Δ σ e motive))) (fst n) (fst (fst (snd (rr s)) Δ (fmapM Δ (CaseV s) (TV s) (case-t s) (subM Δ Γ (CaseV s) σ R)) ct)) (fst (fst (snd (rr s)) Δ (fmapM Δ (CaseV s) (TV s) (case-f s) (subM Δ Γ (CaseV s) σ R)) cf)) (snd (fst (rr s) (ext-h Δ s-bool (CaseV s) (case-b s) (subM Δ Γ (CaseV s) σ R)) (case-mot Δ s (subM Δ Γ (CaseV s) σ R)) (cm-gen Γ s R Δ σ e motive))) (snd n) (snd (fst (snd (rr s)) Δ (fmapM Δ (CaseV s) (TV s) (case-t s) (subM Δ Γ (CaseV s) σ R)) ct)) (snd (fst (snd (rr s)) Δ (fmapM Δ (CaseV s) (TV s) (case-f s) (subM Δ Γ (CaseV s) σ R)) cf))))
fund-case : (Γ : CCtx) (s : TyShape) (R : Mean Γ (CaseV s)) (Δ : CCtx) (σ : Sub Δ Γ) (e : CompEnv Γ Δ σ) → CompS s-bool Δ (subM Δ Γ (TV s-bool) σ (fmapM Γ (CaseV s) (TV s-bool) (case-x s) R)) → CompS s Δ (subM Δ Γ (TV s) σ (fmapM Γ (CaseV s) (TV s) (case-t s) R)) → CompS s Δ (subM Δ Γ (TV s) σ (fmapM Γ (CaseV s) (TV s) (case-f s) R)) → ((Δ' : CCtx) (τ : Sub Δ' (ext-h Γ s-bool (CaseV s) (case-b s) R)) → CompEnv (ext-h Γ s-bool (CaseV s) (case-b s) R) Δ' τ → CompTy s Δ' (subM Δ' (ext-h Γ s-bool (CaseV s) (case-b s) R) (Sem s) τ (case-mot Γ s R))) → CompS s Δ (subM Δ Γ (TV s) σ (fmapM Γ (CaseV s) (TV s) (case-r s) R))
fund-case Γ s R Δ σ e cx ct cf motive =
  jc-tr j-tm s Δ (fmapM Δ (CaseV s) (TV s) (case-r s) (subM Δ Γ (CaseV s) σ R)) (subM Δ Γ (TV s) σ (fmapM Γ (CaseV s) (TV s) (case-r s) R)) (subM-fmap Δ Γ (CaseV s) (TV s) (case-r s) σ R)
    (case-cl Γ s R Δ σ e motive (jc-tr j-tm s-bool Δ (subM Δ Γ (TV s-bool) σ (fmapM Γ (CaseV s) (TV s-bool) (case-x s) R)) (fmapM Δ (CaseV s) (TV s-bool) (case-x s) (subM Δ Γ (CaseV s) σ R)) (psym (Mean Δ (TV s-bool)) (fmapM Δ (CaseV s) (TV s-bool) (case-x s) (subM Δ Γ (CaseV s) σ R)) (subM Δ Γ (TV s-bool) σ (fmapM Γ (CaseV s) (TV s-bool) (case-x s) R)) (subM-fmap Δ Γ (CaseV s) (TV s-bool) (case-x s) σ R)) cx) (jc-tr j-tm s Δ (subM Δ Γ (TV s) σ (fmapM Γ (CaseV s) (TV s) (case-t s) R)) (fmapM Δ (CaseV s) (TV s) (case-t s) (subM Δ Γ (CaseV s) σ R)) (psym (Mean Δ (TV s)) (fmapM Δ (CaseV s) (TV s) (case-t s) (subM Δ Γ (CaseV s) σ R)) (subM Δ Γ (TV s) σ (fmapM Γ (CaseV s) (TV s) (case-t s) R)) (subM-fmap Δ Γ (CaseV s) (TV s) (case-t s) σ R)) ct) (jc-tr j-tm s Δ (subM Δ Γ (TV s) σ (fmapM Γ (CaseV s) (TV s) (case-f s) R)) (fmapM Δ (CaseV s) (TV s) (case-f s) (subM Δ Γ (CaseV s) σ R)) (psym (Mean Δ (TV s)) (fmapM Δ (CaseV s) (TV s) (case-f s) (subM Δ Γ (CaseV s) σ R)) (subM Δ Γ (TV s) σ (fmapM Γ (CaseV s) (TV s) (case-f s) R)) (subM-fmap Δ Γ (CaseV s) (TV s) (case-f s) σ R)) cf) (snd (jc-tr j-tm s-bool Δ (subM Δ Γ (TV s-bool) σ (fmapM Γ (CaseV s) (TV s-bool) (case-x s) R)) (fmapM Δ (CaseV s) (TV s-bool) (case-x s) (subM Δ Γ (CaseV s) σ R)) (psym (Mean Δ (TV s-bool)) (fmapM Δ (CaseV s) (TV s-bool) (case-x s) (subM Δ Γ (CaseV s) σ R)) (subM Δ Γ (TV s-bool) σ (fmapM Γ (CaseV s) (TV s-bool) (case-x s) R)) (subM-fmap Δ Γ (CaseV s) (TV s-bool) (case-x s) σ R)) cx)))
fmap-zip : (n : Nat) (X : Type 1) (F G F2 F3 : X → Type 1) (H : (x : X) → F x → G x → F2 x) (h : (x : X) → F2 x → F3 x) (c : Cube n X) (d : DCube n X F c) (e : DCube n X G c) →
  PathP (λ i → DCube n X F3 c) (dcube-fmap n X F2 F3 h c (dcube-zip n X F G F2 H c d e)) (dcube-zip n X F G F3 (λ x y z → h x (H x y z)) c d e)
fmap-zip zero X F G F2 F3 H h c d e = λ i → h c (H c d e)
fmap-zip (suc n) X F G F2 F3 H h c d e =
  fmap-zip n (Line X) (LineO X F) (LineO X G) (LineO X F2) (LineO X F3) (lineo-zip X F G F2 H) (lineo-fmap X F2 F3 h) c d e
zip-fmap-l : (n : Nat) (X : Type 1) (F F' G F2 : X → Type 1) (H : (x : X) → F' x → G x → F2 x) (k : (x : X) → F x → F' x) (c : Cube n X) (d : DCube n X F c) (e : DCube n X G c) →
  PathP (λ i → DCube n X F2 c) (dcube-zip n X F' G F2 H c (dcube-fmap n X F F' k c d) e) (dcube-zip n X F G F2 (λ x y z → H x (k x y) z) c d e)
zip-fmap-l zero X F F' G F2 H k c d e = λ i → H c (k c d) e
zip-fmap-l (suc n) X F F' G F2 H k c d e =
  zip-fmap-l n (Line X) (LineO X F) (LineO X F') (LineO X G) (LineO X F2) (lineo-zip X F' G F2 H) (lineo-fmap X F F' k) c d e
zip-dup : (n : Nat) (X : Type 1) (F F2 : X → Type 1) (H : (x : X) → F x → F x → F2 x) (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → DCube n X F2 c) (dcube-zip n X F F F2 H c d d) (dcube-fmap n X F F2 (λ x y → H x y y) c d)
zip-dup zero X F F2 H c d = λ i → H c d d
zip-dup (suc n) X F F2 H c d = zip-dup n (Line X) (LineO X F) (LineO X F2) (lineo-zip X F F F2 H) c d
zip-swap : (n : Nat) (X : Type 1) (F G F2 : X → Type 1) (H : (x : X) → F x → G x → F2 x) (c : Cube n X) (d : DCube n X F c) (e : DCube n X G c) →
  PathP (λ i → DCube n X F2 c) (dcube-zip n X F G F2 H c d e) (dcube-zip n X G F F2 (λ x b a → H x a b) c e d)
zip-swap zero X F G F2 H c d e = λ i → H c d e
zip-swap (suc n) X F G F2 H c d e = zip-swap n (Line X) (LineO X F) (LineO X G) (LineO X F2) (lineo-zip X F G F2 H) c d e
ln-rev-dom : (a b : TyShape) → Line (Fam a b) → Line (Sem a)
ln-rev-dom a b L = (fst (fst (snd L)) , fst (fst L) , λ i → fst (snd (snd L) (~ i)))
kp-A : (a b : TyShape) (Δ' : CCtx) (Y : Mean Δ' (AppV a b)) → Mean Δ' ((yq : (TV (s-fam f-pi a b))) × El a (fst (fst yq)))
kp-A a b Δ' Y = (fmapM Δ' (AppV a b) ((yq : (TV (s-fam f-pi a b))) × El a (fst (fst yq))) (λ y → ((fst y , fst (snd y)) , snd (snd y))) Y)
papp-line-end1 : (Γ : CCtx) (Y Z : Type 1) (ℓ : Y → Line Z) (X : Mean Γ Y) → PathM Γ Z (fmapM Γ Y Z (λ q → fst (snd (ℓ q))) X) (papp-line Γ Y Z ℓ dnf-one X)
papp-line-end1 Γ Y Z ℓ X = psym (Mean Γ Z) (papp-line Γ Y Z ℓ dnf-one X) (fmapM Γ Y Z (λ q → fst (snd (ℓ q))) X)
  (fmap-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (FbE (fst Γ) Z) (fline (fst Γ) Y Z ℓ) (λ x q → fst (snd q)) (snd Γ) X)
-- the fundamental lemma: one algebra over the rule table at tag any; the ne and nf derivations carry nothing
FundAt : Jdg → Type 1
FundAt J = (Δ : CCtx) (σ : Sub Δ (fst (snd J))) → CompEnv (fst (snd J)) Δ σ →
  JC (fst J) (fst (snd (snd J))) Δ (subM Δ (fst (snd J)) (JZ (fst J) (fst (snd (snd J)))) σ (snd (snd (snd (snd J)))))
Pfund : Tag → Jdg → Type 1
Pfund t-any J = FundAt J
Pfund t J = One1
fund-alg : (r : DRule) (t : Tag) (x : RData r) → isTrue (kallows (rkind r) t) → AllP Pfund (tagged t (premJ r x)) → Pfund t (concl r x)
fund-alg r t-ne x k p = one
fund-alg r t-nf x k p = one
fund-alg r-var t-any (x-var Γ v) k p = λ Δ σ e → snd e v
fund-alg r-app t-any (x-app Γ a b R f c) k p = λ Δ σ e → fund-app Γ a b R Δ σ (fst p Δ σ e) (fst (snd p) Δ σ e)
fund-alg r-fst t-any (x-proj Γ a b R c) k p = λ Δ σ e → fund-fst Γ a b R Δ σ (fst p Δ σ e)
fund-alg r-snd t-any (x-proj Γ a b R c) k p = λ Δ σ e → fund-snd Γ a b R Δ σ (fst p Δ σ e)
fund-alg r-case t-any (x-case Γ s R cP cx ct cf) k p = λ Δ σ e →
  fund-case Γ s R Δ σ e (fst (snd p) Δ σ e) (fst (snd (snd p)) Δ σ e) (fst (snd (snd (snd p))) Δ σ e) (fst p)
fund-alg (r-con b) t-any (x-unit Γ B) k p = λ Δ σ e → fund-con b Γ B Δ σ
fund-alg r-lam t-any (x-lam Γ a b X cA c) k p = λ Δ σ e → fund-lam Γ a b X Δ σ e (fst p Δ σ e) (fst (snd p))
fund-alg r-pair t-any (x-pair Γ a b R cB c1 c2) k p = λ Δ σ e → fund-pair Γ a b R Δ σ e (fst (snd p) Δ σ e) (fst (snd (snd p)) Δ σ e) (fst p)
fund-alg r-plam t-any (x-pc Γ a X c) k p = λ Δ σ e → fund-plam Γ a X Δ σ e (fst p)
fund-alg r-papp t-any (x-papp Γ a P c f cf nc Y y) k p = λ Δ σ e → fund-papp Γ a P f Y y Δ σ e (fst p Δ σ e)
fund-alg (r-pend b) t-any (x-pc Γ a P c) k p = λ Δ σ e → fund-pend b Γ a P Δ σ (fst p Δ σ e)
fund-alg r-ty-bool t-any (x-unit Γ B) k p = λ Δ σ e → one
fund-alg (r-ty-fam fm) t-any (x-fam Γ a b T cA cB) k p = λ Δ σ e → fund-tfam Γ a b T Δ σ e (fst p Δ σ e) (fst (snd p))
fund-alg r-ty-path t-any (x-tp Γ a T cL c0 c1) k p = λ Δ σ e → fund-tpath Γ a T Δ σ e (fst p) (fst (snd p) Δ σ e) (fst (snd (snd p)) Δ σ e)
fund-alg r t x k p = Empty-rec k
fund : {J : Jdg} → Der J → FundAt J
fund d = d-fold Pfund fund-alg d
data TCtx : (Γc : CCtx) → Type 1 where
  tc-nil : TCtx (lnil , one)
  tc-ty : (Γ₀ : CCtx) → TCtx Γ₀ → (a₀ : TyShape) (T₀ : Mean Γ₀ (Sem a₀)) (cA₀ : Code) → Der (j-ty , Γ₀ , a₀ , cA₀ , T₀) →
    TCtx (ext-h Γ₀ a₀ (Sem a₀) (λ A → A) T₀)
  tc-dim : (Γ₀ : CCtx) → TCtx Γ₀ → TCtx (dext Γ₀)
canon-of : (sk' sk : Lst Entry) (r : Word → Word) → CanonCM sk' sk (cmap-of sk' sk r)
canon-of sk' lnil r = unit
canon-of sk' (lcons (e-ty a) sk) r = canon-of sk' sk (λ k → r (%wsucc k))
canon-of sk' (lcons e-dim sk) r =
  (canon-of sk' sk (λ k → r (%wsucc k)) ,
   eq→isTrue {dnf-canon (lcons (lcons (r #0 , true) lnil) lnil)} (dnf-eq-refl (lcons (lcons (r #0 , true) lnil) lnil)))
var-new : (Γ : CCtx) (a : TyShape) (T : Mean Γ (Sem a)) → CompTy a Γ T →
  CompS a (ext-h Γ a (Sem a) (λ A → A) T) (varCube (ext-h Γ a (Sem a) (λ A → A) T) none)
var-new Γ a T cT =
  jc-tr j-tm a (ext-h Γ a (Sem a) (λ A → A) T) (ext-lift Γ a (Sem a) (λ A → A) (TV a) (λ q x → (q , x)) T) (varCube (ext-h Γ a (Sem a) (λ A → A) T) none)
    (psym (Mean (ext-h Γ a (Sem a) (λ A → A) T) (TV a)) (varCube (ext-h Γ a (Sem a) (λ A → A) T) none) (ext-lift Γ a (Sem a) (λ A → A) (TV a) (λ q x → (q , x)) T)
       (var-lift Γ a (Sem a) (λ A → A) T))
    (var-comp a (snd (snd (rr a))) Γ (Sem a) (λ A → A) T
       (jc-tr j-ty a Γ T (fmapM Γ (Sem a) (Sem a) (λ A → A) T)
          (psym (Mean Γ (Sem a)) (fmapM Γ (Sem a) (Sem a) (λ A → A) T) T (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (Sem a)) (snd Γ) T)) cT))
var-old : (Γ' Γ : CCtx) (w : World Γ' Γ) (v : VarP (fst Γ)) → CompS (var-shape (fst Γ) v) Γ (varCube Γ v) →
  CompS (var-shape (fst Γ') (fst (snd (snd (snd (snd w))) v))) Γ' (varCube Γ' (fst (snd (snd (snd (snd w))) v)))
var-old Γ' Γ w v c =
  comp (λ i → CompS (fst (snd (snd (snd (snd (snd (snd w))) v)) (~ i))) Γ' (snd (snd (snd (snd (snd (snd (snd w))) v)) (~ i))))
    (λ i → []) (comp-ren (var-shape (fst Γ) v) Γ (varCube Γ v) c Γ' w)
id-ty-vals : (Γ : CCtx) (a : TyShape) (T : Mean Γ (Sem a)) → CompTy a Γ T → ((v : VarP (fst Γ)) → CompS (var-shape (fst Γ) v) Γ (varCube Γ v)) →
  (v : VarP (lcons (e-ty a) (fst Γ))) → CompS (var-shape (lcons (e-ty a) (fst Γ)) v) (ext-h Γ a (Sem a) (λ A → A) T) (varCube (ext-h Γ a (Sem a) (λ A → A) T) v)
id-ty-vals Γ a T cT ih none = var-new Γ a T cT
id-ty-vals Γ a T cT ih (some v) = var-old (ext-h Γ a (Sem a) (λ A → A) T) Γ (world-wk Γ a (Sem a) (λ γ e ρ → e ρ) T) v (ih v)
id-envOf : (Γ : CCtx) → ((v : VarP (fst Γ)) → CompS (var-shape (fst Γ) v) Γ (varCube Γ v)) → CompEnv Γ Γ (sub-id Γ)
id-envOf Γ vs =
  (canon-of (fst Γ) (fst Γ) (λ k → k) ,
   λ v → jc-tr j-tm (var-shape (fst Γ) v) Γ (varCube Γ v) (subM Γ Γ (TV (var-shape (fst Γ) v)) (sub-id Γ) (varCube Γ v))
           (psym (Mean Γ (TV (var-shape (fst Γ) v))) (subM Γ Γ (TV (var-shape (fst Γ) v)) (sub-id Γ) (varCube Γ v)) (varCube Γ v) (subM-id Γ (TV (var-shape (fst Γ) v)) (varCube Γ v)))
           (vs v))
id-ty-env : (Γ : CCtx) (a : TyShape) (T : Mean Γ (Sem a)) (cA : Code) (dT : Der (j-ty , Γ , a , cA , T)) (ih : (v : VarP (fst Γ)) → CompS (var-shape (fst Γ) v) Γ (varCube Γ v)) →
  (v : VarP (lcons (e-ty a) (fst Γ))) → CompS (var-shape (lcons (e-ty a) (fst Γ)) v) (ext-h Γ a (Sem a) (λ A → A) T) (varCube (ext-h Γ a (Sem a) (λ A → A) T) v)
id-ty-env Γ a T cA dT ih v = id-ty-vals Γ a T (jc-tr j-ty a Γ (subM Γ Γ (Sem a) (sub-id Γ) T) T (subM-id Γ (Sem a) T) (fund dT Γ (sub-id Γ) (id-envOf Γ ih))) ih v
id-dim-env : (Γ : CCtx) (ih : (v : VarP (fst Γ)) → CompS (var-shape (fst Γ) v) Γ (varCube Γ v)) (v : VarP (fst (dext Γ))) → CompS (var-shape (fst (dext Γ)) v) (dext Γ) (varCube (dext Γ) v)
id-dim-env Γ ih v = var-old (dext Γ) Γ (world-dwk Γ) v (ih v)
nil-vals : (v : VarP lnil) → CompS (var-shape lnil v) (lnil , one) (varCube (lnil , one) v)
nil-vals v = case v of Empty
id-vals : {Γ : CCtx} → TCtx Γ → (v : VarP (fst Γ)) → CompS (var-shape (fst Γ) v) Γ (varCube Γ v)
id-vals tc-nil v = nil-vals v
id-vals (tc-ty Γ₁ tΓ a T cA dT) v = id-ty-env Γ₁ a T cA dT (id-vals tΓ) v
id-vals (tc-dim Γ₁ tΓ) v = id-dim-env Γ₁ (id-vals tΓ) v
id-env : (Γ : CCtx) → TCtx Γ → CompEnv Γ Γ (sub-id Γ)
id-env Γ tΓ = id-envOf Γ (id-vals tΓ)
normalize-nf : (Γ : CCtx) → TCtx Γ → (s : TyShape) (t : TCode Γ s) → RenR k-nf j-tm Γ s (teval Γ s t)
normalize-nf Γ tΓ s t =
  fst (snd (rr s)) Γ (teval Γ s t)
    (jc-tr j-tm s Γ (subM Γ Γ (TV s) (sub-id Γ) (fst (snd t))) (fst (snd t)) (subM-id Γ (TV s) (fst (snd t))) (fund (snd (snd t)) Γ (sub-id Γ) (id-env Γ tΓ)))
normalize : (Γ : CCtx) → TCtx Γ → (s : TyShape) → TCode Γ s → TCode Γ s
normalize Γ tΓ s t =
  (fst (normalize-nf Γ tΓ s t) , teval Γ s t , embed {(k-nf , (j-tm , Γ , s , fst (normalize-nf Γ tΓ s t) , teval Γ s t))} (snd (normalize-nf Γ tΓ s t)))
normalize-sound : (Γ : CCtx) (tΓ : TCtx Γ) (s : TyShape) (t : TCode Γ s) → PathM Γ (TV s) (teval Γ s (normalize Γ tΓ s t)) (teval Γ s t)
normalize-sound Γ tΓ s t = λ i → teval Γ s t
TyCode : CCtx → TyShape → Type 1
TyCode Γ s = (c : Code) × (T : Mean Γ (Sem s)) × Der (j-ty , Γ , s , c , T)
normalize-ty-nf : (Γ : CCtx) → TCtx Γ → (s : TyShape) (A : TyCode Γ s) → RenR k-nf j-ty Γ s (fst (snd A))
normalize-ty-nf Γ tΓ s A =
  fst (rr s) Γ (fst (snd A))
    (jc-tr j-ty s Γ (subM Γ Γ (Sem s) (sub-id Γ) (fst (snd A))) (fst (snd A)) (subM-id Γ (Sem s) (fst (snd A))) (fund (snd (snd A)) Γ (sub-id Γ) (id-env Γ tΓ)))
normalize-ty : (Γ : CCtx) → TCtx Γ → (s : TyShape) → TyCode Γ s → TyCode Γ s
normalize-ty Γ tΓ s A =
  (fst (normalize-ty-nf Γ tΓ s A) , fst (snd A) , embed {(k-nf , (j-ty , Γ , s , fst (normalize-ty-nf Γ tΓ s A) , fst (snd A)))} (snd (normalize-ty-nf Γ tΓ s A)))
DSubst : (Γ Δ : CCtx) → Sub Δ Γ → Type 1
DSubst Γ Δ σ = (dsF : CanonCM (fst Δ) (fst Γ) (fst σ)) ×
  ((v : VarP (fst Γ)) → (dc : Code) × Der (j-tm , Δ , var-shape (fst Γ) v , dc , subM Δ Γ (TV (var-shape (fst Γ) v)) σ (varCube Γ v)))
dsub-v : (Δ : CCtx) → TCtx Δ → (sv : TyShape) (M : Mean Δ (TV sv)) (dc : Code) → Der (j-tm , Δ , sv , dc , M) → CompS sv Δ M
dsub-v Δ tΔ sv M dc d = jc-tr j-tm sv Δ (subM Δ Δ (TV sv) (sub-id Δ) M) M (subM-id Δ (TV sv) M) (fund d Δ (sub-id Δ) (id-env Δ tΔ))
dsub-env : (Γ Δ : CCtx) → TCtx Δ → (σ : Sub Δ Γ) → DSubst Γ Δ σ → CompEnv Γ Δ σ
dsub-env Γ Δ tΔ σ ds =
  (fst ds , λ v → dsub-v Δ tΔ (var-shape (fst Γ) v) (subM Δ Γ (TV (var-shape (fst Γ) v)) σ (varCube Γ v)) (fst (snd ds v)) (snd (snd ds v)))
subst-tm : (Γ Δ : CCtx) → TCtx Δ → (σ : Sub Δ Γ) → DSubst Γ Δ σ → (s : TyShape) → TCode Γ s → TCode Δ s
subst-tm Γ Δ tΔ σ ds s t =
  (fst (fst (snd (rr s)) Δ (subM Δ Γ (TV s) σ (teval Γ s t)) (fund (snd (snd t)) Δ σ (dsub-env Γ Δ tΔ σ ds))) ,
   subM Δ Γ (TV s) σ (teval Γ s t) ,
   embed {(k-nf , (j-tm , Δ , s , fst (fst (snd (rr s)) Δ (subM Δ Γ (TV s) σ (teval Γ s t)) (fund (snd (snd t)) Δ σ (dsub-env Γ Δ tΔ σ ds))) , subM Δ Γ (TV s) σ (teval Γ s t)))}
     (snd (fst (snd (rr s)) Δ (subM Δ Γ (TV s) σ (teval Γ s t)) (fund (snd (snd t)) Δ σ (dsub-env Γ Δ tΔ σ ds)))))
subst-sound : (Γ Δ : CCtx) (tΔ : TCtx Δ) (σ : Sub Δ Γ) (ds : DSubst Γ Δ σ) (s : TyShape) (t : TCode Γ s) →
  PathM Δ (TV s) (teval Δ s (subst-tm Γ Δ tΔ σ ds s t)) (subM Δ Γ (TV s) σ (teval Γ s t))
subst-sound Γ Δ tΔ σ ds s t = λ i → subM Δ Γ (TV s) σ (teval Γ s t)
subst-ty : (Γ Δ : CCtx) → TCtx Δ → (σ : Sub Δ Γ) → DSubst Γ Δ σ → (s : TyShape) → TyCode Γ s → TyCode Δ s
subst-ty Γ Δ tΔ σ ds s A =
  (fst (fst (rr s) Δ (subM Δ Γ (Sem s) σ (fst (snd A))) (fund (snd (snd A)) Δ σ (dsub-env Γ Δ tΔ σ ds))) ,
   subM Δ Γ (Sem s) σ (fst (snd A)) ,
   embed {(k-nf , (j-ty , Δ , s , fst (fst (rr s) Δ (subM Δ Γ (Sem s) σ (fst (snd A))) (fund (snd (snd A)) Δ σ (dsub-env Γ Δ tΔ σ ds))) , subM Δ Γ (Sem s) σ (fst (snd A))))}
     (snd (fst (rr s) Δ (subM Δ Γ (Sem s) σ (fst (snd A))) (fund (snd (snd A)) Δ σ (dsub-env Γ Δ tΔ σ ds)))))
subst-ty-sound : (Γ Δ : CCtx) (tΔ : TCtx Δ) (σ : Sub Δ Γ) (ds : DSubst Γ Δ σ) (s : TyShape) (A : TyCode Γ s) →
  PathM Δ (Sem s) (fst (snd (subst-ty Γ Δ tΔ σ ds s A))) (subM Δ Γ (Sem s) σ (fst (snd A)))
subst-ty-sound Γ Δ tΔ σ ds s A = λ i → subM Δ Γ (Sem s) σ (fst (snd A))
spec : (Γ : CCtx) → TCtx Γ → (a b : TyShape) (R : Mean Γ (AppV a b)) (cq cr : Code) →
  Der (j-tm , Γ , s-fam f-pi a b , cq , fmapM Γ (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) R) →
  Der (j-tm , Γ , a , cr , fmapM Γ (AppV a b) (TV a) (app-a a b) R) → TCode Γ b
spec Γ tΓ a b R cq cr dq dr =
  normalize Γ tΓ b (capp cq cr , fmapM Γ (AppV a b) (TV b) (app-r a b) R , dapp Γ a b R cq cr dq dr)
spec-sound : (Γ : CCtx) (tΓ : TCtx Γ) (a b : TyShape) (R : Mean Γ (AppV a b)) (cq cr : Code)
  (dq : Der (j-tm , Γ , s-fam f-pi a b , cq , fmapM Γ (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) R))
  (dr : Der (j-tm , Γ , a , cr , fmapM Γ (AppV a b) (TV a) (app-a a b) R)) →
  PathM Γ (TV b) (teval Γ b (spec Γ tΓ a b R cq cr dq dr)) (fmapM Γ (AppV a b) (TV b) (app-r a b) R)
spec-sound Γ tΓ a b R cq cr dq dr = λ i → fmapM Γ (AppV a b) (TV b) (app-r a b) R
compiled : (p d o : TyShape) (R : Mean (lnil , one) (AppV p (s-fam f-pi d o))) (ce cq : Code) →
  Der (j-tm , (lnil , one) , s-fam f-pi p (s-fam f-pi d o) , ce , fmapM (lnil , one) (AppV p (s-fam f-pi d o)) (TV (s-fam f-pi p (s-fam f-pi d o))) (app-f p (s-fam f-pi d o)) R) →
  Der (j-tm , (lnil , one) , p , cq , fmapM (lnil , one) (AppV p (s-fam f-pi d o)) (TV p) (app-a p (s-fam f-pi d o)) R) → TCode (lnil , one) (s-fam f-pi d o)
compiled p d o R ce cq de dq = spec (lnil , one) tc-nil p (s-fam f-pi d o) R ce cq de dq
compiled-sound : (p d o : TyShape) (R : Mean (lnil , one) (AppV p (s-fam f-pi d o))) (ce cq : Code)
  (de : Der (j-tm , (lnil , one) , s-fam f-pi p (s-fam f-pi d o) , ce , fmapM (lnil , one) (AppV p (s-fam f-pi d o)) (TV (s-fam f-pi p (s-fam f-pi d o))) (app-f p (s-fam f-pi d o)) R))
  (dq : Der (j-tm , (lnil , one) , p , cq , fmapM (lnil , one) (AppV p (s-fam f-pi d o)) (TV p) (app-a p (s-fam f-pi d o)) R))
  (ρ : One1) (x : El d (fst (fst (app-r p (s-fam f-pi d o) (R ρ))))) →
  PathP (λ i → El o (snd (fst (app-r p (s-fam f-pi d o) (R ρ))) x)) (snd (teval (lnil , one) (s-fam f-pi d o) (compiled p d o R ce cq de dq) ρ) x)
    (fst (snd (R ρ)) (snd (snd (R ρ))) x)
compiled-sound p d o R ce cq de dq ρ x = λ i → fst (snd (R ρ)) (snd (snd (R ρ))) x
CodeAt : (s : TyShape) → Mean (lnil , one) (Sem s) → Type 1
CodeAt s T = (c : Code) × (x : (ρ : One1) → El s (T ρ)) × Der (j-tm , (lnil , one) , s , c , λ ρ → (T ρ , x ρ))
compile : (p d o : TyShape) (T : Mean (lnil , one) (Fam p (s-fam f-pi d o))) →
  CodeAt (s-fam f-pi p (s-fam f-pi d o)) T → CodeAt p (λ ρ → fst (T ρ)) → TCode (lnil , one) (s-fam f-pi d o)
compile p d o T e q = compiled p d o (λ ρ → (T ρ , fst (snd e) ρ , fst (snd q) ρ)) (fst e) (fst q) (snd (snd e)) (snd (snd q))
compiler-code : (A B CA CB CAB : Type 1) → (CAB → CA → CB) → (A → CA) → CAB → A → CB
compiler-code A B CA CB CAB S lift qG e = S qG (lift e)
compiler-code-sound : (A B CA CB CAB : Type 1) (evA : CA → A) (evB : CB → B) (evAB : CAB → A → B)
  (S : CAB → CA → CB) (S-law : (q : CAB) (r : CA) → PathP (λ i → B) (evB (S q r)) (evAB q (evA r)))
  (lift : A → CA) (lift-law : (e : A) → PathP (λ i → A) (evA (lift e)) e)
  (G : A → B) (qG : CAB) (qG-law : PathP (λ i → A → B) (evAB qG) G) (e : A) →
  PathP (λ i → B) (evB (compiler-code A B CA CB CAB S lift qG e)) (G e)
compiler-code-sound A B CA CB CAB evA evB evAB S S-law lift lift-law G qG qG-law e =
  pcat B (evB (S qG (lift e))) (evAB qG (evA (lift e))) (G e) (S-law qG (lift e)) (λ i → qG-law i (lift-law e i))
opt-1 : {A C : Type} → (A → C) → Opt A → Opt C
opt-1 k none = none
opt-1 k (some x) = some (k x)
opt-2 : {A B C : Type} → Opt A → Opt B → (A → B → C) → Opt C
opt-2 none y k = none
opt-2 (some x) none k = none
opt-2 (some x) (some y) k = some (k x y)
opt-3 : {A B C D : Type} → Opt A → Opt B → Opt C → (A → B → C → D) → Opt D
opt-3 (some a) (some b) (some c) k = some (k a b c)
opt-3 a b c k = none
opt-5 : {A B C D E F : Type} → Opt A → Opt B → Opt C → Opt D → Opt E → (A → B → C → D → E → F) → Opt F
opt-5 (some a) (some b) (some c) (some d) (some e) k = some (k a b c d e)
opt-5 a b c d e k = none
w-dec-at : (a b : Word) (v : Bool) → weq a b ≡ v → Opt (a ≡ b)
w-dec-at a b true p = some (weq-sound a b p)
w-dec-at a b false p = none
w-dec : (a b : Word) → Opt (a ≡ b)
w-dec a b = w-dec-at a b (weq a b) (λ i → weq a b)
code-dec : Nat → (a b : Code) → Opt (a ≡ b)
code-dec zero a b = none
code-dec (suc u) (cvar n) (cvar m) = opt-1 (λ p i → cvar (p i)) (w-dec n m)
code-dec (suc u) (clam b) (clam b') = opt-1 (λ p i → clam (p i)) (code-dec u b b')
code-dec (suc u) (capp f a) (capp f' a') = opt-2 (code-dec u f f') (code-dec u a a') (λ p q i → capp (p i) (q i))
code-dec (suc u) (cpair a b) (cpair a' b') = opt-2 (code-dec u a a') (code-dec u b b') (λ p q i → cpair (p i) (q i))
code-dec (suc u) (cfst p) (cfst p') = opt-1 (λ q i → cfst (q i)) (code-dec u p p')
code-dec (suc u) (csnd p) (csnd p') = opt-1 (λ q i → csnd (q i)) (code-dec u p p')
code-dec (suc u) (cpi m A B) (cpi m' A' B') = opt-3 (w-dec m m') (code-dec u A A') (code-dec u B B') (λ p q r i → cpi (p i) (q i) (r i))
code-dec (suc u) (csigma A B) (csigma A' B') = opt-2 (code-dec u A A') (code-dec u B B') (λ p q i → csigma (p i) (q i))
code-dec (suc u) (cpathp A a b) (cpathp A' a' b') = opt-3 (code-dec u A A') (code-dec u a a') (code-dec u b b') (λ p q r i → cpathp (p i) (q i) (r i))
code-dec (suc u) (cplam b) (cplam b') = opt-1 (λ p i → cplam (p i)) (code-dec u b b')
code-dec (suc u) (cpapp p r) (cpapp p' r') = opt-2 (code-dec u p p') (code-dec u r r') (λ q u i → cpapp (q i) (u i))
code-dec (suc u) ci0 ci0 = some (λ i → ci0)
code-dec (suc u) ci1 ci1 = some (λ i → ci1)
code-dec (suc u) (cneg r) (cneg r') = opt-1 (λ p i → cneg (p i)) (code-dec u r r')
code-dec (suc u) (cmeet r s) (cmeet r' s') = opt-2 (code-dec u r r') (code-dec u s s') (λ p q i → cmeet (p i) (q i))
code-dec (suc u) (cjoin r s) (cjoin r' s') = opt-2 (code-dec u r r') (code-dec u s s') (λ p q i → cjoin (p i) (q i))
code-dec (suc u) (cdata d lnil) (cdata d' lnil) = opt-1 (λ p i → cdata (p i) lnil) (w-dec d d')
code-dec (suc u) (ccon d k lnil lnil) (ccon d' k' lnil lnil) = opt-2 (w-dec d d') (w-dec k k') (λ p q i → ccon (p i) (q i) lnil lnil)
code-dec (suc u) (celim d P (lcons t (lcons f lnil)) x) (celim d' P' (lcons t' (lcons f' lnil)) x') =
  opt-5 (w-dec d d') (code-dec u P P') (code-dec u t t') (code-dec u f f') (code-dec u x x')
    (λ p q r v w i → celim (p i) (q i) (lcons (r i) (lcons (v i) lnil)) (w i))
code-dec (suc u) a b = none
abs-mean : (Γ : CCtx) (a : TyShape) (Y₁ Y₂ Z : Type 1) (h₁ : Y₁ → Sem a) (mk : (y : Y₁) → (El a (h₁ y) → Z) → Y₂)
  (M₁ : Mean Γ Y₁) → Mean (ext-h Γ a Y₁ h₁ M₁) Z → Mean Γ Y₂
abs-mean Γ a Y₁ Y₂ Z h₁ mk M₁ B =
  dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y₁) (FbE (fst Γ) Y₂) (FbE (lcons (e-ty a) (fst Γ)) Z)
    (λ γ e → (γ , λ ρ → h₁ (e ρ))) (λ γ e E ρ → mk (e ρ) (λ x → E (ρ , x))) (snd Γ) M₁ B
lift-fst-d : (n : Nat) (X : Type 1) (Y : X → Type 1) (c : Cube n X) (d : DCube n X Y c) →
  PathP (λ i → DCube n X Y (dmap-fst n X Y c d i)) (dcube-lift n X X Y Y (λ x y → x) (λ x y → y) c d) d
lift-fst-d zero X Y c d = λ i → d
lift-fst-d (suc n) X Y c d = lift-fst-d n (Line X) (LineO X Y) c d
der-ext : (jk : JK) (Γ : CCtx) (a s : TyShape) (Y₁ Y₂ : Type 1) (h₁ : Y₁ → Sem a) (h₂ : Y₂ → Sem a)
  (mk : (y : Y₁) → (El a (h₁ y) → JZ jk s) → Y₂)
  (hq : PathP (λ i → (y : Y₁) (k : El a (h₁ y) → JZ jk s) → Sem a) (λ y k → h₂ (mk y k)) (λ y k → h₁ y))
  (G0 : (q : Y₂) → El a (h₂ q) → JZ jk s)
  (Gq : PathP (λ i → (y : Y₁) (k : El a (h₁ y) → JZ jk s) → El a (hq i y k) → JZ jk s) (λ y k → G0 (mk y k)) (λ y k → k))
  (M₁ : Mean Γ Y₁) (B : Mean (ext-h Γ a Y₁ h₁ M₁) (JZ jk s)) (c : Code) →
  Der (jk , ext-h Γ a Y₁ h₁ M₁ , s , c , B) →
  Der (jk , ext-h Γ a Y₂ h₂ (abs-mean Γ a Y₁ Y₂ (JZ jk s) h₁ mk M₁ B) , s , c ,
    ext-lift Γ a Y₂ h₂ (JZ jk s) G0 (abs-mean Γ a Y₁ Y₂ (JZ jk s) h₁ mk M₁ B))
der-ext jk Γ a s Y₁ Y₂ h₁ h₂ mk hq G0 Gq M₁ B c d =
  comp (λ i → Der (jk , (lcons (e-ty a) (fst Γ) ,
      map-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y₁) (FbE (fst Γ) Y₂) (FbE (lcons (e-ty a) (fst Γ)) (JZ jk s))
        (λ γ e → (γ , λ ρ → h₁ (e ρ))) (λ γ e E ρ → mk (e ρ) (λ x → E (ρ , x))) (CtxV (lcons (e-ty a) (fst Γ))) (λ γ e → (γ , λ ρ → h₂ (e ρ))) (λ x' y' → x')
        (λ j γ e E → (γ , λ ρ → hq j (e ρ) (λ x → E (ρ , x)))) (snd Γ) M₁ B (~ i)) , s , c ,
      lift-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y₁) (FbE (fst Γ) Y₂) (FbE (lcons (e-ty a) (fst Γ)) (JZ jk s))
        (λ γ e → (γ , λ ρ → h₁ (e ρ))) (λ γ e E ρ → mk (e ρ) (λ x → E (ρ , x))) (CtxV (lcons (e-ty a) (fst Γ))) (λ γ e → (γ , λ ρ → h₂ (e ρ))) (λ x' y' → x')
        (λ j γ e E → (γ , λ ρ → hq j (e ρ) (λ x → E (ρ , x)))) (FbE (lcons (e-ty a) (fst Γ)) (JZ jk s))
        (λ γ e ρ → G0 (e (fst ρ)) (snd ρ)) (λ x' y' → y') (λ j γ e E ρ → Gq j (e (fst ρ)) (λ x → E (fst ρ , x)) (snd ρ)) (snd Γ) M₁ B (~ i)))
    (λ i → [])
    (comp (λ i → Der (jk , (lcons (e-ty a) (fst Γ) ,
        dmap-fst (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (lcons (e-ty a) (fst Γ)) (JZ jk s)) (snd (ext-h Γ a Y₁ h₁ M₁)) B (~ i)) , s , c ,
        lift-fst-d (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (lcons (e-ty a) (fst Γ)) (JZ jk s)) (snd (ext-h Γ a Y₁ h₁ M₁)) B (~ i)))
      (λ i → []) d)
dcube-contr : (n : Nat) (X : Type 1) (F : X → Type 1) (ctr : (x : X) → F x) (cn : (x : X) (y : F x) → PathP (λ i → F x) y (ctr x))
  (c : Cube n X) (d : DCube n X F c) → PathP (λ i → DCube n X F c) d (dcube-of n X F ctr c)
dcube-contr zero X F ctr cn c d = cn c d
dcube-contr (suc n) X F ctr cn c d =
  dcube-contr n (Line X) (LineO X F) (lineo-of X F ctr)
    (λ L D k → (cn (fst L) (fst D) k , cn (fst (snd L)) (fst (snd D)) k , λ i → cn (snd (snd L) i) (snd (snd D) i) k)) c d
mean1-path : (Γ : CCtx) (B B' : Mean Γ One1) → PathM Γ One1 B B'
mean1-path Γ B B' =
  pcat (Mean Γ One1) B (dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) One1) (λ γ ρ → one) (snd Γ)) B'
    (dcube-contr (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) One1) (λ γ ρ → one) (λ γ y k ρ → one-contr (y ρ) k) (snd Γ) B)
    (psym (Mean Γ One1) B' (dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) One1) (λ γ ρ → one) (snd Γ))
      (dcube-contr (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) One1) (λ γ ρ → one) (λ γ y k ρ → one-contr (y ρ) k) (snd Γ) B'))
dcube-pmap : (n : Nat) (X : Type 1) (F G F2 : X → Type 1) (g0 g1 : (x : X) → F x → G x)
  (k : (x : X) (y : F x) → PathP (λ i → G x) (g0 x y) (g1 x y) → F2 x) (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → DCube n X G c) (dcube-fmap n X F G g0 c d) (dcube-fmap n X F G g1 c d) → DCube n X F2 c
dcube-pmap zero X F G F2 g0 g1 k c d P = k c d P
dcube-pmap (suc n) X F G F2 g0 g1 k c d P =
  dcube-pmap n (Line X) (LineO X F) (LineO X G) (LineO X F2) (lineo-fmap X F G g0) (lineo-fmap X F G g1)
    (λ L D Q → (k (fst L) (fst D) (λ i → fst (Q i)) , k (fst (snd L)) (fst (snd D)) (λ i → fst (snd (Q i))) ,
       λ j → k (snd (snd L) j) (snd (snd D) j) (λ i → snd (snd (Q i)) j))) c d P
pmap-fmap : (n : Nat) (X : Type 1) (F G F2 F3 : X → Type 1) (g0 g1 : (x : X) → F x → G x)
  (k : (x : X) (y : F x) → PathP (λ i → G x) (g0 x y) (g1 x y) → F2 x) (h : (x : X) → F2 x → F3 x) (c : Cube n X) (d : DCube n X F c)
  (P : PathP (λ i → DCube n X G c) (dcube-fmap n X F G g0 c d) (dcube-fmap n X F G g1 c d)) →
  PathP (λ i → DCube n X F3 c) (dcube-fmap n X F2 F3 h c (dcube-pmap n X F G F2 g0 g1 k c d P)) (dcube-pmap n X F G F3 g0 g1 (λ x y Q → h x (k x y Q)) c d P)
pmap-fmap zero X F G F2 F3 g0 g1 k h c d P = λ i → h c (k c d P)
pmap-fmap (suc n) X F G F2 F3 g0 g1 k h c d P =
  pmap-fmap n (Line X) (LineO X F) (LineO X G) (LineO X F2) (LineO X F3) (lineo-fmap X F G g0) (lineo-fmap X F G g1)
    (λ L D Q → (k (fst L) (fst D) (λ i → fst (Q i)) , k (fst (snd L)) (fst (snd D)) (λ i → fst (snd (Q i))) ,
       λ j → k (snd (snd L) j) (snd (snd D) j) (λ i → snd (snd (Q i)) j))) (lineo-fmap X F2 F3 h) c d P
pmap-ign : (n : Nat) (X : Type 1) (F G F2 : X → Type 1) (g0 g1 : (x : X) → F x → G x) (k0 : (x : X) → F x → F2 x) (c : Cube n X) (d : DCube n X F c)
  (P : PathP (λ i → DCube n X G c) (dcube-fmap n X F G g0 c d) (dcube-fmap n X F G g1 c d)) →
  PathP (λ i → DCube n X F2 c) (dcube-pmap n X F G F2 g0 g1 (λ x y Q → k0 x y) c d P) (dcube-fmap n X F F2 k0 c d)
pmap-ign zero X F G F2 g0 g1 k0 c d P = λ i → k0 c d
pmap-ign (suc n) X F G F2 g0 g1 k0 c d P =
  pmap-ign n (Line X) (LineO X F) (LineO X G) (LineO X F2) (lineo-fmap X F G g0) (lineo-fmap X F G g1) (lineo-fmap X F F2 k0) c d P
zip-ign-l : (n : Nat) (X : Type 1) (F G F2 : X → Type 1) (h : (x : X) → G x → F2 x) (c : Cube n X) (d : DCube n X F c) (e : DCube n X G c) →
  PathP (λ i → DCube n X F2 c) (dcube-zip n X F G F2 (λ x y z → h x z) c d e) (dcube-fmap n X G F2 h c e)
zip-ign-l zero X F G F2 h c d e = λ i → h c e
zip-ign-l (suc n) X F G F2 h c d e = zip-ign-l n (Line X) (LineO X F) (LineO X G) (LineO X F2) (lineo-fmap X G F2 h) c d e
rt-Z : (Γ : CCtx) (a : TyShape) (U1 : Type 1) → Mean Γ U1 → Mean Γ (TV a) → Mean Γ (U1 × TV a)
rt-Z Γ a U1 Um A = dcube-zip (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) U1) (FbE (fst Γ) (TV a)) (FbE (fst Γ) (U1 × TV a)) (λ xq euq eaq ρq → (euq ρq , eaq ρq)) (snd Γ) Um A
rt-P : (Γ : CCtx) (a : TyShape) (U1 : Type 1) (ty : U1 → Sem a) (Um : Mean Γ U1) (A : Mean Γ (TV a)) →
  PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) A) (fmapM Γ U1 (Sem a) ty Um) →
  PathM Γ (Sem a) (fmapM Γ (U1 × TV a) (Sem a) (λ zq → fst (snd zq)) (rt-Z Γ a U1 Um A)) (fmapM Γ (U1 × TV a) (Sem a) (λ zq → ty (fst zq)) (rt-Z Γ a U1 Um A))
rt-P Γ a U1 ty Um A p =
  pcat (Mean Γ (Sem a)) (fmapM Γ (U1 × TV a) (Sem a) (λ zq → fst (snd zq)) (rt-Z Γ a U1 Um A)) (fmapM Γ (TV a) (Sem a) (λ q → fst q) A) (fmapM Γ (U1 × TV a) (Sem a) (λ zq → ty (fst zq)) (rt-Z Γ a U1 Um A))
    (pcat (Mean Γ (Sem a)) (fmapM Γ (U1 × TV a) (Sem a) (λ zq → fst (snd zq)) (rt-Z Γ a U1 Um A))
       (dcube-zip (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) U1) (FbE (fst Γ) (TV a)) (FbE (fst Γ) (Sem a)) (λ xq euq eaq ρq → fst (eaq ρq)) (snd Γ) Um A)
       (fmapM Γ (TV a) (Sem a) (λ q → fst q) A)
       (fmap-zip (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) U1) (FbE (fst Γ) (TV a)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (Sem a)) (λ xq euq eaq ρq → (euq ρq , eaq ρq)) (λ xq eq ρq → fst (snd (eq ρq))) (snd Γ) Um A)
       (zip-ign-l (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) U1) (FbE (fst Γ) (TV a)) (FbE (fst Γ) (Sem a)) (λ xq eaq ρq → fst (eaq ρq)) (snd Γ) Um A))
    (pcat (Mean Γ (Sem a)) (fmapM Γ (TV a) (Sem a) (λ q → fst q) A) (fmapM Γ U1 (Sem a) ty Um) (fmapM Γ (U1 × TV a) (Sem a) (λ zq → ty (fst zq)) (rt-Z Γ a U1 Um A)) p
       (psym (Mean Γ (Sem a)) (fmapM Γ (U1 × TV a) (Sem a) (λ zq → ty (fst zq)) (rt-Z Γ a U1 Um A)) (fmapM Γ U1 (Sem a) ty Um)
          (pcat (Mean Γ (Sem a)) (fmapM Γ (U1 × TV a) (Sem a) (λ zq → ty (fst zq)) (rt-Z Γ a U1 Um A))
             (dcube-zip (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) U1) (FbE (fst Γ) (TV a)) (FbE (fst Γ) (Sem a)) (λ xq euq eaq ρq → ty (euq ρq)) (snd Γ) Um A)
             (fmapM Γ U1 (Sem a) ty Um)
             (fmap-zip (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) U1) (FbE (fst Γ) (TV a)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (Sem a)) (λ xq euq eaq ρq → (euq ρq , eaq ρq)) (λ xq eq ρq → ty (fst (eq ρq))) (snd Γ) Um A)
             (zip-ign (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) U1) (FbE (fst Γ) (TV a)) (FbE (fst Γ) (Sem a)) (λ xq euq ρq → ty (euq ρq)) (snd Γ) Um A))))
retype : (Γ : CCtx) (a : TyShape) (U1 W : Type 1) (ty : U1 → Sem a) (w : (u : U1) → El a (ty u) → W) (Um : Mean Γ U1) (A : Mean Γ (TV a)) →
  PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) A) (fmapM Γ U1 (Sem a) ty Um) → Mean Γ W
retype Γ a U1 W ty w Um A p =
  dcube-pmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (Sem a)) (FbE (fst Γ) W) (λ xq zq ρq → fst (snd (zq ρq))) (λ xq zq ρq → ty (fst (zq ρq)))
    (λ xq zq Qq ρq → w (fst (zq ρq)) (el-tr a (Sem a) (λ yq → yq) (fst (snd (zq ρq))) (ty (fst (zq ρq))) (λ jq → Qq jq ρq) (snd (snd (zq ρq))))) (snd Γ) (rt-Z Γ a U1 Um A) (rt-P Γ a U1 ty Um A p)
retype-fst : (Γ : CCtx) (a : TyShape) (U1 W : Type 1) (ty : U1 → Sem a) (w : (u : U1) → El a (ty u) → W) (Um : Mean Γ U1) (A : Mean Γ (TV a))
  (p : PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) A) (fmapM Γ U1 (Sem a) ty Um))
  (Z2 : Type 1) (pr : W → Z2) (pr' : U1 → Z2) (pw : PathP (λ i → (u : U1) → El a (ty u) → Z2) (λ u v → pr (w u v)) (λ u v → pr' u)) →
  PathM Γ Z2 (fmapM Γ W Z2 pr (retype Γ a U1 W ty w Um A p)) (fmapM Γ U1 Z2 pr' Um)
retype-fst Γ a U1 W ty w Um A p Z2 pr pr' pw =
  pcat (Mean Γ Z2) (fmapM Γ W Z2 pr (retype Γ a U1 W ty w Um A p))
    (dcube-pmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (Sem a)) (FbE (fst Γ) Z2) (λ xq zq ρq → fst (snd (zq ρq))) (λ xq zq ρq → ty (fst (zq ρq)))
      (λ xq zq Qq ρq → pr (w (fst (zq ρq)) (el-tr a (Sem a) (λ yq → yq) (fst (snd (zq ρq))) (ty (fst (zq ρq))) (λ jq → Qq jq ρq) (snd (snd (zq ρq)))))) (snd Γ) (rt-Z Γ a U1 Um A) (rt-P Γ a U1 ty Um A p))
    (fmapM Γ U1 Z2 pr' Um)
    (pmap-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (Sem a)) (FbE (fst Γ) W) (FbE (fst Γ) Z2) (λ xq zq ρq → fst (snd (zq ρq))) (λ xq zq ρq → ty (fst (zq ρq)))
      (λ xq zq Qq ρq → w (fst (zq ρq)) (el-tr a (Sem a) (λ yq → yq) (fst (snd (zq ρq))) (ty (fst (zq ρq))) (λ jq → Qq jq ρq) (snd (snd (zq ρq))))) (λ xq eq ρq → pr (eq ρq)) (snd Γ) (rt-Z Γ a U1 Um A) (rt-P Γ a U1 ty Um A p))
    (pcat (Mean Γ Z2)
      (dcube-pmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (Sem a)) (FbE (fst Γ) Z2) (λ xq zq ρq → fst (snd (zq ρq))) (λ xq zq ρq → ty (fst (zq ρq)))
        (λ xq zq Qq ρq → pr (w (fst (zq ρq)) (el-tr a (Sem a) (λ yq → yq) (fst (snd (zq ρq))) (ty (fst (zq ρq))) (λ jq → Qq jq ρq) (snd (snd (zq ρq)))))) (snd Γ) (rt-Z Γ a U1 Um A) (rt-P Γ a U1 ty Um A p))
      (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) Z2) (λ xq zq ρq → pr' (fst (zq ρq))) (snd Γ) (rt-Z Γ a U1 Um A))
      (fmapM Γ U1 Z2 pr' Um)
      (pcat (Mean Γ Z2)
        (dcube-pmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (Sem a)) (FbE (fst Γ) Z2) (λ xq zq ρq → fst (snd (zq ρq))) (λ xq zq ρq → ty (fst (zq ρq)))
          (λ xq zq Qq ρq → pr (w (fst (zq ρq)) (el-tr a (Sem a) (λ yq → yq) (fst (snd (zq ρq))) (ty (fst (zq ρq))) (λ jq → Qq jq ρq) (snd (snd (zq ρq)))))) (snd Γ) (rt-Z Γ a U1 Um A) (rt-P Γ a U1 ty Um A p))
        (dcube-pmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (Sem a)) (FbE (fst Γ) Z2) (λ xq zq ρq → fst (snd (zq ρq))) (λ xq zq ρq → ty (fst (zq ρq)))
          (λ xq zq Qq ρq → pr' (fst (zq ρq))) (snd Γ) (rt-Z Γ a U1 Um A) (rt-P Γ a U1 ty Um A p))
        (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) Z2) (λ xq zq ρq → pr' (fst (zq ρq))) (snd Γ) (rt-Z Γ a U1 Um A))
        (λ i → dcube-pmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (Sem a)) (FbE (fst Γ) Z2) (λ xq zq ρq → fst (snd (zq ρq))) (λ xq zq ρq → ty (fst (zq ρq)))
          (λ xq zq Qq ρq → pw i (fst (zq ρq)) (el-tr a (Sem a) (λ yq → yq) (fst (snd (zq ρq))) (ty (fst (zq ρq))) (λ jq → Qq jq ρq) (snd (snd (zq ρq))))) (snd Γ) (rt-Z Γ a U1 Um A) (rt-P Γ a U1 ty Um A p))
        (pmap-ign (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (Sem a)) (FbE (fst Γ) Z2) (λ xq zq ρq → fst (snd (zq ρq))) (λ xq zq ρq → ty (fst (zq ρq)))
          (λ xq zq ρq → pr' (fst (zq ρq))) (snd Γ) (rt-Z Γ a U1 Um A) (rt-P Γ a U1 ty Um A p)))
      (pcat (Mean Γ Z2)
        (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) Z2) (λ xq zq ρq → pr' (fst (zq ρq))) (snd Γ) (rt-Z Γ a U1 Um A))
        (dcube-zip (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) U1) (FbE (fst Γ) (TV a)) (FbE (fst Γ) Z2) (λ xq euq eaq ρq → pr' (euq ρq)) (snd Γ) Um A)
        (fmapM Γ U1 Z2 pr' Um)
        (fmap-zip (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) U1) (FbE (fst Γ) (TV a)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) Z2) (λ xq euq eaq ρq → (euq ρq , eaq ρq)) (λ xq zq ρq → pr' (fst (zq ρq))) (snd Γ) Um A)
        (zip-ign (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) U1) (FbE (fst Γ) (TV a)) (FbE (fst Γ) Z2) (λ xq euq ρq → pr' (euq ρq)) (snd Γ) Um A)))
pmap-path : (n : Nat) (X : Type 1) (F G F2 : X → Type 1) (g0 g1 : (x : X) → F x → G x)
  (k : (x : X) (y : F x) → PathP (λ i → G x) (g0 x y) (g1 x y) → F2 x) (k' : (x : X) → F x → F2 x)
  (kk : (x : X) (y : F x) (Q : PathP (λ i → G x) (g0 x y) (g1 x y)) → PathP (λ i → F2 x) (k x y Q) (k' x y))
  (c : Cube n X) (d : DCube n X F c) (P : PathP (λ i → DCube n X G c) (dcube-fmap n X F G g0 c d) (dcube-fmap n X F G g1 c d)) →
  PathP (λ i → DCube n X F2 c) (dcube-pmap n X F G F2 g0 g1 k c d P) (dcube-fmap n X F F2 k' c d)
pmap-path zero X F G F2 g0 g1 k k' kk c d P = kk c d P
pmap-path (suc n) X F G F2 g0 g1 k k' kk c d P =
  pmap-path n (Line X) (LineO X F) (LineO X G) (LineO X F2) (lineo-fmap X F G g0) (lineo-fmap X F G g1)
    (λ L D Q → (k (fst L) (fst D) (λ i → fst (Q i)) , k (fst (snd L)) (fst (snd D)) (λ i → fst (snd (Q i))) ,
       λ j → k (snd (snd L) j) (snd (snd D) j) (λ i → snd (snd (Q i)) j))) (lineo-fmap X F F2 k')
    (λ L D Q i → (kk (fst L) (fst D) (λ i' → fst (Q i')) i , kk (fst (snd L)) (fst (snd D)) (λ i' → fst (snd (Q i'))) i ,
       λ j → kk (snd (snd L) j) (snd (snd D) j) (λ i' → snd (snd (Q i')) j) i)) c d P
rv-pt : (a : TyShape) (U1 W : Type 1) (ty : U1 → Sem a) (w : (u : U1) → El a (ty u) → W) (vl : W → TV a)
  (pv : PathP (λ i → (u : U1) → El a (ty u) → TV a) (λ u v → vl (w u v)) (λ u v → (ty u , v)))
  (u : U1) (q : TV a) (Q : PathP (λ i → Sem a) (fst q) (ty u)) →
  PathP (λ i → TV a) (vl (w u (el-tr a (Sem a) (λ yq → yq) (fst q) (ty u) Q (snd q)))) q
rv-pt a U1 W ty w vl pv u q Q =
  pcat (TV a) (vl (w u (el-tr a (Sem a) (λ yq → yq) (fst q) (ty u) Q (snd q)))) (ty u , el-tr a (Sem a) (λ yq → yq) (fst q) (ty u) Q (snd q)) q
    (λ i → pv i u (el-tr a (Sem a) (λ yq → yq) (fst q) (ty u) Q (snd q)))
    (λ i → (Q (~ i) , el-fill a (Sem a) (λ yq → yq) (fst q) (ty u) Q (snd q) (~ i)))
retype-val : (Γ : CCtx) (a : TyShape) (U1 W : Type 1) (ty : U1 → Sem a) (w : (u : U1) → El a (ty u) → W) (Um : Mean Γ U1) (A : Mean Γ (TV a))
  (p : PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) A) (fmapM Γ U1 (Sem a) ty Um))
  (vl : W → TV a) (pv : PathP (λ i → (u : U1) → El a (ty u) → TV a) (λ u v → vl (w u v)) (λ u v → (ty u , v))) →
  PathM Γ (TV a) (fmapM Γ W (TV a) vl (retype Γ a U1 W ty w Um A p)) A
retype-val Γ a U1 W ty w Um A p vl pv =
  pcat (Mean Γ (TV a)) (fmapM Γ W (TV a) vl (retype Γ a U1 W ty w Um A p))
    (dcube-pmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (Sem a)) (FbE (fst Γ) (TV a)) (λ xq zq ρq → fst (snd (zq ρq))) (λ xq zq ρq → ty (fst (zq ρq)))
      (λ xq zq Qq ρq → vl (w (fst (zq ρq)) (el-tr a (Sem a) (λ yq → yq) (fst (snd (zq ρq))) (ty (fst (zq ρq))) (λ jq → Qq jq ρq) (snd (snd (zq ρq)))))) (snd Γ) (rt-Z Γ a U1 Um A) (rt-P Γ a U1 ty Um A p))
    A
    (pmap-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (Sem a)) (FbE (fst Γ) W) (FbE (fst Γ) (TV a)) (λ xq zq ρq → fst (snd (zq ρq))) (λ xq zq ρq → ty (fst (zq ρq)))
      (λ xq zq Qq ρq → w (fst (zq ρq)) (el-tr a (Sem a) (λ yq → yq) (fst (snd (zq ρq))) (ty (fst (zq ρq))) (λ jq → Qq jq ρq) (snd (snd (zq ρq))))) (λ xq eq ρq → vl (eq ρq)) (snd Γ) (rt-Z Γ a U1 Um A) (rt-P Γ a U1 ty Um A p))
    (pcat (Mean Γ (TV a))
      (dcube-pmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (Sem a)) (FbE (fst Γ) (TV a)) (λ xq zq ρq → fst (snd (zq ρq))) (λ xq zq ρq → ty (fst (zq ρq)))
        (λ xq zq Qq ρq → vl (w (fst (zq ρq)) (el-tr a (Sem a) (λ yq → yq) (fst (snd (zq ρq))) (ty (fst (zq ρq))) (λ jq → Qq jq ρq) (snd (snd (zq ρq)))))) (snd Γ) (rt-Z Γ a U1 Um A) (rt-P Γ a U1 ty Um A p))
      (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (TV a)) (λ xq zq ρq → snd (zq ρq)) (snd Γ) (rt-Z Γ a U1 Um A))
      A
      (pmap-path (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (Sem a)) (FbE (fst Γ) (TV a)) (λ xq zq ρq → fst (snd (zq ρq))) (λ xq zq ρq → ty (fst (zq ρq)))
        (λ xq zq Qq ρq → vl (w (fst (zq ρq)) (el-tr a (Sem a) (λ yq → yq) (fst (snd (zq ρq))) (ty (fst (zq ρq))) (λ jq → Qq jq ρq) (snd (snd (zq ρq))))))
        (λ xq zq ρq → snd (zq ρq))
        (λ xq zq Qq i ρq → rv-pt a U1 W ty w vl pv (fst (zq ρq)) (snd (zq ρq)) (λ jq → Qq jq ρq) i)
        (snd Γ) (rt-Z Γ a U1 Um A) (rt-P Γ a U1 ty Um A p))
      (pcat (Mean Γ (TV a))
        (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (TV a)) (λ xq zq ρq → snd (zq ρq)) (snd Γ) (rt-Z Γ a U1 Um A))
        (dcube-zip (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) U1) (FbE (fst Γ) (TV a)) (FbE (fst Γ) (TV a)) (λ xq euq eaq → eaq) (snd Γ) Um A)
        A
        (fmap-zip (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) U1) (FbE (fst Γ) (TV a)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (TV a)) (λ xq euq eaq ρq → (euq ρq , eaq ρq)) (λ xq zq ρq → snd (zq ρq)) (snd Γ) Um A)
        (pcat (Mean Γ (TV a))
          (dcube-zip (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) U1) (FbE (fst Γ) (TV a)) (FbE (fst Γ) (TV a)) (λ xq euq eaq → eaq) (snd Γ) Um A)
          (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (TV a)) (FbE (fst Γ) (TV a)) (λ xq eaq → eaq) (snd Γ) A) A
          (zip-ign-l (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) U1) (FbE (fst Γ) (TV a)) (FbE (fst Γ) (TV a)) (λ xq eaq → eaq) (snd Γ) Um A)
          (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (TV a)) (snd Γ) A))))
data Dec1 (A : Type 1) = c-refused | c-derived (a : A)
d-bind : (A B : Type 1) → Dec1 A → (A → Dec1 B) → Dec1 B
d-bind A B c-refused k = c-refused
d-bind A B (c-derived x) k = k x
o-bind : (A : Type) (B : Type 1) → Opt A → (A → Dec1 B) → Dec1 B
o-bind A B none k = c-refused
o-bind A B (some x) k = k x
Vals : CCtx → Type 1
Vals Γ = (v : VarP (fst Γ)) → CompS (var-shape (fst Γ) v) Γ (varCube Γ v)
ext-vals : (Γ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Γ Y) → CompTy a Γ (fmapM Γ Y (Sem a) h M) → Vals Γ →
  Vals (ext-h Γ a Y h M)
ext-vals Γ a Y h M cT vs none =
  jc-tr j-tm a (ext-h Γ a Y h M) (ext-lift Γ a Y h (TV a) (λ q x → (h q , x)) M) (varCube (ext-h Γ a Y h M) none)
    (psym (Mean (ext-h Γ a Y h M) (TV a)) (varCube (ext-h Γ a Y h M) none) (ext-lift Γ a Y h (TV a) (λ q x → (h q , x)) M) (var-lift Γ a Y h M))
    (var-comp a (snd (snd (rr a))) Γ Y h M cT)
ext-vals Γ a Y h M cT vs (some v) = var-old (ext-h Γ a Y h M) Γ (world-wk Γ a Y (λ γ e ρ → h (e ρ)) M) v (vs v)
dext-vals : (Γ : CCtx) → Vals Γ → Vals (dext Γ)
dext-vals Γ vs v = var-old (dext Γ) Γ (world-dwk Γ) v (vs v)
comp-j : (jk : JK) (Γ : CCtx) → Vals Γ → (s : TyShape) (c : Code) (M : Mean Γ (JZ jk s)) → Der (jk , Γ , s , c , M) → JC jk s Γ M
comp-j jk Γ vs s c M d = jc-tr jk s Γ (subM Γ Γ (JZ jk s) (sub-id Γ) M) M (subM-id Γ (JZ jk s) M) (fund d Γ (sub-id Γ) (id-envOf Γ vs))
der-code : (jk : JK) (Γ : CCtx) (s : TyShape) (c c' : Code) (M : Mean Γ (JZ jk s)) → c ≡ c' → Der (jk , Γ , s , c , M) → Der (jk , Γ , s , c' , M)
der-code jk Γ s c c' M p d = comp (λ i → Der (jk , Γ , s , p i , M)) (λ i → []) d
abs-fst : (Γ : CCtx) (a : TyShape) (Y₁ Y₂ Z : Type 1) (h₁ : Y₁ → Sem a) (mk : (y : Y₁) → (El a (h₁ y) → Z) → Y₂)
  (M₁ : Mean Γ Y₁) (B : Mean (ext-h Γ a Y₁ h₁ M₁) Z) (W : Type 1) (pr : Y₂ → W) (pr' : Y₁ → W)
  (pp : PathP (λ i → (y : Y₁) (k : El a (h₁ y) → Z) → W) (λ y k → pr (mk y k)) (λ y k → pr' y)) →
  PathM Γ W (fmapM Γ Y₂ W pr (abs-mean Γ a Y₁ Y₂ Z h₁ mk M₁ B)) (fmapM Γ Y₁ W pr' M₁)
abs-fst Γ a Y₁ Y₂ Z h₁ mk M₁ B W pr pr' pp =
  pcat (Mean Γ W) (fmapM Γ Y₂ W pr (abs-mean Γ a Y₁ Y₂ Z h₁ mk M₁ B))
    (dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y₁) (FbE (fst Γ) W) (FbE (lcons (e-ty a) (fst Γ)) Z)
      (λ γq eq → (γq , λ ρq → h₁ (eq ρq))) (λ γq eq Eq ρq → pr (mk (eq ρq) (λ xq → Eq (ρq , xq)))) (snd Γ) M₁ B)
    (fmapM Γ Y₁ W pr' M₁)
    (fmap-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y₁) (FbE (fst Γ) Y₂) (FbE (fst Γ) W) (FbE (lcons (e-ty a) (fst Γ)) Z)
      (λ γq eq → (γq , λ ρq → h₁ (eq ρq))) (λ γq eq Eq ρq → mk (eq ρq) (λ xq → Eq (ρq , xq))) (λ γq eq ρq → pr (eq ρq)) (snd Γ) M₁ B)
    (pcat (Mean Γ W)
      (dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y₁) (FbE (fst Γ) W) (FbE (lcons (e-ty a) (fst Γ)) Z)
        (λ γq eq → (γq , λ ρq → h₁ (eq ρq))) (λ γq eq Eq ρq → pr (mk (eq ρq) (λ xq → Eq (ρq , xq)))) (snd Γ) M₁ B)
      (dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y₁) (FbE (fst Γ) W) (FbE (lcons (e-ty a) (fst Γ)) Z)
        (λ γq eq → (γq , λ ρq → h₁ (eq ρq))) (λ γq eq Eq → (λ γr er ρr → pr' (er ρr)) γq eq) (snd Γ) M₁ B)
      (fmapM Γ Y₁ W pr' M₁)
      (λ i → dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y₁) (FbE (fst Γ) W) (FbE (lcons (e-ty a) (fst Γ)) Z)
        (λ γq eq → (γq , λ ρq → h₁ (eq ρq))) (λ γq eq Eq ρq → pp i (eq ρq) (λ xq → Eq (ρq , xq))) (snd Γ) M₁ B)
      (pull-ignore (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y₁) (FbE (fst Γ) W) (FbE (lcons (e-ty a) (fst Γ)) Z)
        (λ γq eq → (γq , λ ρq → h₁ (eq ρq))) (λ γr er ρr → pr' (er ρr)) (snd Γ) M₁ B))
data Mode (Γ : CCtx) = m-ty | m-inf | m-chk (s : TyShape) (T : Mean Γ (Sem s)) (ct : CompTy s Γ T)
Out : (Γ : CCtx) → Code → Mode Γ → Type 1
Out Γ c m-ty = (s : TyShape) × (T : Mean Γ (Sem s)) × Der (j-ty , Γ , s , c , T)
Out Γ c m-inf = (s : TyShape) × (M : Mean Γ (TV s)) × Der (j-tm , Γ , s , c , M)
Out Γ c (m-chk s T ct) = (M : Mean Γ (TV s)) × PathM Γ (Sem s) (fmapM Γ (TV s) (Sem s) (λ q → fst q) M) T × Der (j-tm , Γ , s , c , M)
Rec : Type 1
Rec = (Γ : CCtx) → Vals Γ → (c : Code) → (m : Mode Γ) → Dec1 (Out Γ c m)
Cv : Type 1
Cv = (Γ : CCtx) (s : TyShape) (T T' : Mean Γ (Sem s)) → CompTy s Γ T → CompTy s Γ T' → Dec1 (PathM Γ (Sem s) T T')
one-mean : (Γ : CCtx) → Mean Γ One1
one-mean Γ = dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) One1) (λ γq ρq → one) (snd Γ)
fam-of : (Γ : CCtx) (a b : TyShape) (TA : Mean Γ (Sem a)) → Mean (ext-h Γ a (Sem a) (λ y → y) TA) (Sem b) → Mean Γ (Fam a b)
fam-of Γ a b TA TB = abs-mean Γ a (Sem a) (Fam a b) (Sem b) (λ y → y) (λ y k → (y , k)) TA TB
fam-dA : (Γ : CCtx) (a b : TyShape) (TA : Mean Γ (Sem a)) (TB : Mean (ext-h Γ a (Sem a) (λ y → y) TA) (Sem b)) (cA : Code) →
  Der (j-ty , Γ , a , cA , TA) → Der (j-ty , Γ , a , cA , fmapM Γ (Fam a b) (Sem a) (fam-dom a b) (fam-of Γ a b TA TB))
fam-dA Γ a b TA TB cA dA =
  d-tr t-any j-ty Γ a cA TA (fmapM Γ (Fam a b) (Sem a) (fam-dom a b) (fam-of Γ a b TA TB))
    (psym (Mean Γ (Sem a)) (fmapM Γ (Fam a b) (Sem a) (fam-dom a b) (fam-of Γ a b TA TB)) TA
      (pcat (Mean Γ (Sem a)) (fmapM Γ (Fam a b) (Sem a) (fam-dom a b) (fam-of Γ a b TA TB)) (fmapM Γ (Sem a) (Sem a) (λ y → y) TA) TA
        (abs-fst Γ a (Sem a) (Fam a b) (Sem b) (λ y → y) (λ y k → (y , k)) TA TB (Sem a) (fam-dom a b) (λ y → y) (λ i y k → y))
        (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (Sem a)) (snd Γ) TA)))
    dA
fam-dB : (Γ : CCtx) (a b : TyShape) (TA : Mean Γ (Sem a)) (TB : Mean (ext-h Γ a (Sem a) (λ y → y) TA) (Sem b)) (cB : Code) →
  Der (j-ty , ext-h Γ a (Sem a) (λ y → y) TA , b , cB , TB) →
  Der (j-ty , ext-h Γ a (Fam a b) (fam-dom a b) (fam-of Γ a b TA TB) , b , cB , fam-body Γ a b (fam-of Γ a b TA TB))
fam-dB Γ a b TA TB cB dB =
  der-ext j-ty Γ a b (Sem a) (Fam a b) (λ y → y) (fam-dom a b) (λ y k → (y , k)) (λ i y k → y) (λ F x → snd F x) (λ i y k → k) TA TB cB dB
ct-id : (Γ : CCtx) → Vals Γ → (a : TyShape) (cA : Code) (TA : Mean Γ (Sem a)) → Der (j-ty , Γ , a , cA , TA) → CompTy a Γ (fmapM Γ (Sem a) (Sem a) (λ y → y) TA)
ct-id Γ vs a cA TA dA =
  jc-tr j-ty a Γ TA (fmapM Γ (Sem a) (Sem a) (λ y → y) TA)
    (psym (Mean Γ (Sem a)) (fmapM Γ (Sem a) (Sem a) (λ y → y) TA) TA (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (Sem a)) (snd Γ) TA))
    (comp-j j-ty Γ vs a cA TA dA)
ty-pi-2 : (Γ : CCtx) (m : Word) (cA cB : Code) → m ≡ #2 → (a : TyShape) (TA : Mean Γ (Sem a)) → Der (j-ty , Γ , a , cA , TA) →
  (b : TyShape) (TB : Mean (ext-h Γ a (Sem a) (λ y → y) TA) (Sem b)) → Der (j-ty , ext-h Γ a (Sem a) (λ y → y) TA , b , cB , TB) →
  Dec1 (Out Γ (cpi m cA cB) m-ty)
ty-pi-2 Γ m cA cB pm a TA dA b TB dB =
  c-derived (s-fam f-pi a b , fam-of Γ a b TA TB ,
    der-code j-ty Γ (s-fam f-pi a b) (cpi #2 cA cB) (cpi m cA cB) (fam-of Γ a b TA TB) (λ i → cpi (pm (~ i)) cA cB)
      (dty-fam f-pi Γ a b (fam-of Γ a b TA TB) cA cB (fam-dA Γ a b TA TB cA dA) (fam-dB Γ a b TA TB cB dB)))
ty-pi-1 : Rec → (Γ : CCtx) → Vals Γ → (m : Word) (cA cB : Code) → m ≡ #2 → (a : TyShape) (TA : Mean Γ (Sem a)) → Der (j-ty , Γ , a , cA , TA) →
  Dec1 (Out Γ (cpi m cA cB) m-ty)
ty-pi-1 rec Γ vs m cA cB pm a TA dA =
  d-bind (Out (ext-h Γ a (Sem a) (λ y → y) TA) cB m-ty) (Out Γ (cpi m cA cB) m-ty)
    (rec (ext-h Γ a (Sem a) (λ y → y) TA) (ext-vals Γ a (Sem a) (λ y → y) TA (ct-id Γ vs a cA TA dA) vs) cB m-ty)
    (λ rB → ty-pi-2 Γ m cA cB pm a TA dA (fst rB) (fst (snd rB)) (snd (snd rB)))
ty-sig-2 : (Γ : CCtx) (cA cB : Code) (a : TyShape) (TA : Mean Γ (Sem a)) → Der (j-ty , Γ , a , cA , TA) →
  (b : TyShape) (TB : Mean (ext-h Γ a (Sem a) (λ y → y) TA) (Sem b)) → Der (j-ty , ext-h Γ a (Sem a) (λ y → y) TA , b , cB , TB) →
  Dec1 (Out Γ (csigma cA cB) m-ty)
ty-sig-2 Γ cA cB a TA dA b TB dB =
  c-derived (s-fam f-sig a b , fam-of Γ a b TA TB , dty-fam f-sig Γ a b (fam-of Γ a b TA TB) cA cB (fam-dA Γ a b TA TB cA dA) (fam-dB Γ a b TA TB cB dB))
ty-sig-1 : Rec → (Γ : CCtx) → Vals Γ → (cA cB : Code) → (a : TyShape) (TA : Mean Γ (Sem a)) → Der (j-ty , Γ , a , cA , TA) →
  Dec1 (Out Γ (csigma cA cB) m-ty)
ty-sig-1 rec Γ vs cA cB a TA dA =
  d-bind (Out (ext-h Γ a (Sem a) (λ y → y) TA) cB m-ty) (Out Γ (csigma cA cB) m-ty)
    (rec (ext-h Γ a (Sem a) (λ y → y) TA) (ext-vals Γ a (Sem a) (λ y → y) TA (ct-id Γ vs a cA TA dA) vs) cB m-ty)
    (λ rB → ty-sig-2 Γ cA cB a TA dA (fst rB) (fst (snd rB)) (snd (snd rB)))
vf-at : (sk : Lst Entry) (a : TyShape) (f : VarP (lcons (e-ty a) sk) → Word) (k : Word) → Opt (f none ≡ k) →
  Opt ((v : VarP sk) × f (some v) ≡ k) → Opt ((v : VarP (lcons (e-ty a) sk)) × f v ≡ k)
vf-at sk a f k (some p) r = some (none , p)
vf-at sk a f k none r = opt-1 (λ q → (some (fst q) , snd q)) r
var-find : (sk : Lst Entry) (f : VarP sk → Word) (k : Word) → Opt ((v : VarP sk) × f v ≡ k)
var-find lnil f k = none
var-find (lcons e-dim sk) f k = var-find sk f k
var-find (lcons (e-ty a) sk) f k = vf-at sk a f k (w-dec (f none) k) (var-find sk (λ v → f (some v)) k)
fam-cast : (f f' : FamF) (P : FamF → Type 1) → P f' → Dec1 (P f)
fam-cast f-pi f-pi P x = c-derived x
fam-cast f-sig f-sig P x = c-derived x
fam-cast f f' P x = c-refused
shape-cast : (s s' : TyShape) (P : TyShape → Type 1) → P s' → Dec1 (P s)
shape-cast s-bool s-bool P x = c-derived x
shape-cast (s-fam fm a b) (s-fam fm' a' b') P x =
  d-bind (P (s-fam fm a' b')) (P (s-fam fm a b)) (fam-cast fm fm' (λ f → P (s-fam f a' b')) x)
    (λ y → d-bind (P (s-fam fm a' b)) (P (s-fam fm a b)) (shape-cast b b' (λ b0 → P (s-fam fm a' b0)) y) (λ z → shape-cast a a' (λ a0 → P (s-fam fm a0 b)) z))
shape-cast (s-path a) (s-path a') P x = shape-cast a a' (λ a0 → P (s-path a0)) x
shape-cast s s' P x = c-refused
Contr1 : Type 1 → Type 1
Contr1 A = (ctr : A) × ((x : A) → PathP (λ i → A) x ctr)
fam-contr : (a b : TyShape) → Contr1 (Sem a) → Contr1 (Sem b) → Contr1 (Fam a b)
fam-contr a b Ca Cb =
  ((fst Ca , λ xq → fst Cb) ,
   λ F i → (snd Ca (fst F) i ,
     λ xq → snd Cb (snd F (comp (λ j → El a (snd Ca (fst F) (i ∧ (~ j)))) (λ j → [ i = 0 ↦ xq ]) xq)) i))
sem-contr : (s : TyShape) → Dec1 (Contr1 (Sem s))
sem-contr s-bool = c-derived (one , one-contr)
sem-contr (s-fam fm a b) = d-bind (Contr1 (Sem a)) (Contr1 (Sem (s-fam fm a b))) (sem-contr a) (λ Ca → d-bind (Contr1 (Sem b)) (Contr1 (Sem (s-fam fm a b))) (sem-contr b) (λ Cb → c-derived (fam-contr a b Ca Cb)))
sem-contr (s-path a) = c-refused
mean-contr : (Γ : CCtx) (Z : Type 1) → Contr1 Z → (T T' : Mean Γ Z) → PathM Γ Z T T'
mean-contr Γ Z C T T' =
  pcat (Mean Γ Z) T (dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (λ γq ρq → fst C) (snd Γ)) T'
    (dcube-contr (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (λ γq ρq → fst C) (λ γq y k ρq → snd C (y ρq) k) (snd Γ) T)
    (psym (Mean Γ Z) T' (dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (λ γq ρq → fst C) (snd Γ))
      (dcube-contr (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (λ γq ρq → fst C) (λ γq y k ρq → snd C (y ρq) k) (snd Γ) T'))
conv-by : Cv → (Γ : CCtx) (s : TyShape) (T T' : Mean Γ (Sem s)) → CompTy s Γ T → CompTy s Γ T' → Dec1 (Contr1 (Sem s)) → Dec1 (PathM Γ (Sem s) T T')
conv-by cv Γ s T T' cT cT' (c-derived C) = c-derived (mean-contr Γ (Sem s) C T T')
conv-by cv Γ s T T' cT cT' c-refused = cv Γ s T T' cT cT'
conv-at : Cv → Cv
conv-at cv Γ s T T' cT cT' = conv-by cv Γ s T T' cT cT' (sem-contr s)
switch-2 : Cv → (Γ : CCtx) → Vals Γ → (c : Code) (s : TyShape) (T : Mean Γ (Sem s)) (ct : CompTy s Γ T) →
  (M : Mean Γ (TV s)) → Der (j-tm , Γ , s , c , M) → Dec1 (Out Γ c (m-chk s T ct))
switch-2 cv Γ vs c s T ct M d =
  d-bind (PathM Γ (Sem s) (fmapM Γ (TV s) (Sem s) (λ q → fst q) M) T) (Out Γ c (m-chk s T ct))
    (conv-at cv Γ s (fmapM Γ (TV s) (Sem s) (λ q → fst q) M) T (fst (comp-j j-tm Γ vs s c M d)) ct)
    (λ p → c-derived (M , p , d))
switch : Cv → (Γ : CCtx) → Vals Γ → (c : Code) (s : TyShape) (T : Mean Γ (Sem s)) (ct : CompTy s Γ T) →
  Out Γ c m-inf → Dec1 (Out Γ c (m-chk s T ct))
switch cv Γ vs c s T ct r =
  d-bind ((M : Mean Γ (TV s)) × Der (j-tm , Γ , s , c , M)) (Out Γ c (m-chk s T ct))
    (shape-cast s (fst r) (λ s0 → (M : Mean Γ (TV s0)) × Der (j-tm , Γ , s0 , c , M)) (snd r))
    (λ q → switch-2 cv Γ vs c s T ct (fst q) (snd q))
inf-fst : (Γ : CCtx) (p : Code) (s : TyShape) (P : Mean Γ (TV s)) → Der (j-tm , Γ , s , p , P) → Dec1 (Out Γ (cfst p) m-inf)
inf-fst Γ p (s-fam f-sig a b) P dp = c-derived (a , fmapM Γ (TV (s-fam f-sig a b)) (TV a) (sig-1 a b) P , dfst Γ a b P p dp)
inf-fst Γ p s P dp = c-refused
inf-snd : (Γ : CCtx) (p : Code) (s : TyShape) (P : Mean Γ (TV s)) → Der (j-tm , Γ , s , p , P) → Dec1 (Out Γ (csnd p) m-inf)
inf-snd Γ p (s-fam f-sig a b) P dp = c-derived (b , fmapM Γ (TV (s-fam f-sig a b)) (TV b) (sig-2 a b) P , dsnd Γ a b P p dp)
inf-snd Γ p s P dp = c-refused
bool-path : (Γ : CCtx) (b : Bool) (T : Mean Γ One1) →
  PathM Γ One1 (fmapM Γ (TV s-bool) (Sem s-bool) (λ q → fst q) (fmapM Γ One1 (TV s-bool) (bool-v b) T)) T
bool-path Γ b T =
  pcat (Mean Γ One1) (fmapM Γ (TV s-bool) (Sem s-bool) (λ q → fst q) (fmapM Γ One1 (TV s-bool) (bool-v b) T)) (fmapM Γ One1 One1 (λ u → u) T) T
    (fmapM-fmapM Γ One1 (TV s-bool) One1 (bool-v b) (λ q → fst q) T) (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) One1) (snd Γ) T)
chk-con : (Γ : CCtx) (d k : Word) (T : Mean Γ (Sem s-bool)) (ct : CompTy s-bool Γ T) → d ≡ #0 → Opt (k ≡ #0) → Opt (k ≡ #1) →
  Dec1 (Out Γ (ccon d k lnil lnil) (m-chk s-bool T ct))
chk-con Γ d k T ct pd (some p) o1 =
  c-derived (fmapM Γ One1 (TV s-bool) (bool-v true) T , bool-path Γ true T ,
    der-code j-tm Γ s-bool c-true (ccon d k lnil lnil) (fmapM Γ One1 (TV s-bool) (bool-v true) T) (λ i → ccon (pd (~ i)) (p (~ i)) lnil lnil) (dtrue Γ T))
chk-con Γ d k T ct pd none (some p) =
  c-derived (fmapM Γ One1 (TV s-bool) (bool-v false) T , bool-path Γ false T ,
    der-code j-tm Γ s-bool c-false (ccon d k lnil lnil) (fmapM Γ One1 (TV s-bool) (bool-v false) T) (λ i → ccon (pd (~ i)) (p (~ i)) lnil lnil) (dfalse Γ T))
chk-con Γ d k T ct pd none none = c-refused
chk-con-at : (Γ : CCtx) (d k : Word) (s : TyShape) (T : Mean Γ (Sem s)) (ct : CompTy s Γ T) → d ≡ #0 → Dec1 (Out Γ (ccon d k lnil lnil) (m-chk s T ct))
chk-con-at Γ d k s-bool T ct pd = chk-con Γ d k T ct pd (w-dec k #0) (w-dec k #1)
chk-con-at Γ d k s T ct pd = c-refused
app-mean : (Γ : CCtx) (a b : TyShape) (F : Mean Γ (TV (s-fam f-pi a b))) (A : Mean Γ (TV a)) →
  PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) A) (fmapM Γ (TV (s-fam f-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) F) → Mean Γ (AppV a b)
app-mean Γ a b F A pA = retype Γ a (TV (s-fam f-pi a b)) (AppV a b) (λ q → fam-dom a b (fst q)) (λ q v → (fst q , snd q , v)) F A pA
app-2 : (Γ : CCtx) (a b : TyShape) (f c : Code) (F : Mean Γ (TV (s-fam f-pi a b))) → Der (j-tm , Γ , s-fam f-pi a b , f , F) →
  (A : Mean Γ (TV a)) (pA : PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) A) (fmapM Γ (TV (s-fam f-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) F)) →
  Der (j-tm , Γ , a , c , A) → Dec1 (Out Γ (capp f c) m-inf)
app-2 Γ a b f c F df A pA dA =
  c-derived (b , fmapM Γ (AppV a b) (TV b) (app-r a b) (app-mean Γ a b F A pA) ,
    dapp Γ a b (app-mean Γ a b F A pA) f c
      (d-tr t-any j-tm Γ (s-fam f-pi a b) f F (fmapM Γ (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) (app-mean Γ a b F A pA))
        (psym (Mean Γ (TV (s-fam f-pi a b))) (fmapM Γ (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) (app-mean Γ a b F A pA)) F
          (pcat (Mean Γ (TV (s-fam f-pi a b))) (fmapM Γ (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) (app-mean Γ a b F A pA)) (fmapM Γ (TV (s-fam f-pi a b)) (TV (s-fam f-pi a b)) (λ q → q) F) F
            (retype-fst Γ a (TV (s-fam f-pi a b)) (AppV a b) (λ q → fam-dom a b (fst q)) (λ q v → (fst q , snd q , v)) F A pA (TV (s-fam f-pi a b)) (app-f a b) (λ q → q) (λ i u v → u))
            (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (TV (s-fam f-pi a b))) (snd Γ) F)))
        df)
      (d-tr t-any j-tm Γ a c A (fmapM Γ (AppV a b) (TV a) (app-a a b) (app-mean Γ a b F A pA))
        (psym (Mean Γ (TV a)) (fmapM Γ (AppV a b) (TV a) (app-a a b) (app-mean Γ a b F A pA)) A
          (retype-val Γ a (TV (s-fam f-pi a b)) (AppV a b) (λ q → fam-dom a b (fst q)) (λ q v → (fst q , snd q , v)) F A pA (app-a a b) (λ i u v → (fam-dom a b (fst u) , v))))
        dA))
app-1 : Rec → (Γ : CCtx) → Vals Γ → (f c : Code) (s : TyShape) (F : Mean Γ (TV s)) → Der (j-tm , Γ , s , f , F) → Dec1 (Out Γ (capp f c) m-inf)
app-1 rec Γ vs f c (s-fam f-pi a b) F df =
  d-bind (Out Γ c (m-chk a (fmapM Γ (TV (s-fam f-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) F)
            (jc-tr j-ty a Γ (fmapM Γ (Fam a b) (Sem a) (λ G → fst G) (fmapM Γ (TV (s-fam f-pi a b)) (Fam a b) (λ q → fst q) F)) (fmapM Γ (TV (s-fam f-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) F)
              (fmapM-fmapM Γ (TV (s-fam f-pi a b)) (Fam a b) (Sem a) (λ q → fst q) (λ G → fst G) F) (fst (fst (comp-j j-tm Γ vs (s-fam f-pi a b) f F df))))))
    (Out Γ (capp f c) m-inf)
    (rec Γ vs c (m-chk a (fmapM Γ (TV (s-fam f-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) F)
            (jc-tr j-ty a Γ (fmapM Γ (Fam a b) (Sem a) (λ G → fst G) (fmapM Γ (TV (s-fam f-pi a b)) (Fam a b) (λ q → fst q) F)) (fmapM Γ (TV (s-fam f-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) F)
              (fmapM-fmapM Γ (TV (s-fam f-pi a b)) (Fam a b) (Sem a) (λ q → fst q) (λ G → fst G) F) (fst (fst (comp-j j-tm Γ vs (s-fam f-pi a b) f F df))))))
    (λ rA → app-2 Γ a b f c F df (fst rA) (fst (snd rA)) (snd (snd rA)))
app-1 rec Γ vs f c s F df = c-refused
pull-lift-id : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (l : (x : X) (y : Y x) → F' (f x y)) (c : Cube n X) (d : DCube n X Y c) →
  PathP (λ i → DCube n X F c) (dcube-pull n X X' Y F F' f g c d (dcube-lift n X X' Y F' f l c d)) (dcube-fmap n X Y F (λ x y → g x y (l x y)) c d)
pull-lift-id zero X X' Y F F' f g l c d = λ i → g c d (l c d)
pull-lift-id (suc n) X X' Y F F' f g l c d =
  pull-lift-id n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g) (lineo-lift X X' Y F' f l) c d
lam-mk : (a b : TyShape) → (F : Fam a b) → (El a (fam-dom a b F) → TV b) → TV (s-fam f-pi a b)
lam-mk a b F k = ((fst F , λ x → fst (k x)) , λ x → snd (k x))
lam-X : (Γ : CCtx) (a b : TyShape) (T : Mean Γ (Fam a b)) → Mean (ext-h Γ a (Fam a b) (fam-dom a b) T) (TV b) → Mean Γ (TV (s-fam f-pi a b))
lam-X Γ a b T B = abs-mean Γ a (Fam a b) (TV (s-fam f-pi a b)) (TV b) (fam-dom a b) (lam-mk a b) T B
lam-ty : (Γ : CCtx) (a b : TyShape) (T : Mean Γ (Fam a b)) (B : Mean (ext-h Γ a (Fam a b) (fam-dom a b) T) (TV b)) →
  PathM (ext-h Γ a (Fam a b) (fam-dom a b) T) (Sem b) (fmapM (ext-h Γ a (Fam a b) (fam-dom a b) T) (TV b) (Sem b) (λ q → fst q) B) (fam-body Γ a b T) →
  PathM Γ (Fam a b) (fmapM Γ (TV (s-fam f-pi a b)) (Fam a b) (λ q → fst q) (lam-X Γ a b T B)) T
lam-ty Γ a b T B pB =
  pcat (Mean Γ (Fam a b)) (fmapM Γ (TV (s-fam f-pi a b)) (Fam a b) (λ q → fst q) (lam-X Γ a b T B))
    (dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) (Fam a b)) (FbE (fst Γ) (Fam a b)) (FbE (lcons (e-ty a) (fst Γ)) (TV b))
      (λ γq eq → (γq , λ ρq → fam-dom a b (eq ρq))) (λ γq eq Eq ρq → (fst (eq ρq) , λ xq → fst (Eq (ρq , xq)))) (snd Γ) T B)
    T
    (fmap-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) (Fam a b)) (FbE (fst Γ) (TV (s-fam f-pi a b))) (FbE (fst Γ) (Fam a b)) (FbE (lcons (e-ty a) (fst Γ)) (TV b))
      (λ γq eq → (γq , λ ρq → fam-dom a b (eq ρq))) (λ γq eq Eq ρq → lam-mk a b (eq ρq) (λ xq → Eq (ρq , xq))) (λ γq eq ρq → fst (eq ρq)) (snd Γ) T B)
    (pcat (Mean Γ (Fam a b))
      (dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) (Fam a b)) (FbE (fst Γ) (Fam a b)) (FbE (lcons (e-ty a) (fst Γ)) (TV b))
        (λ γq eq → (γq , λ ρq → fam-dom a b (eq ρq))) (λ γq eq Eq ρq → (fst (eq ρq) , λ xq → fst (Eq (ρq , xq)))) (snd Γ) T B)
      (dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) (Fam a b)) (FbE (fst Γ) (Fam a b)) (FbE (lcons (e-ty a) (fst Γ)) (Sem b))
        (λ γq eq → (γq , λ ρq → fam-dom a b (eq ρq))) (λ γq eq Eq ρq → (fst (eq ρq) , λ xq → Eq (ρq , xq))) (snd Γ) T
        (fmapM (ext-h Γ a (Fam a b) (fam-dom a b) T) (TV b) (Sem b) (λ q → fst q) B))
      T
      (psym (Mean Γ (Fam a b))
        (dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) (Fam a b)) (FbE (fst Γ) (Fam a b)) (FbE (lcons (e-ty a) (fst Γ)) (Sem b))
          (λ γq eq → (γq , λ ρq → fam-dom a b (eq ρq))) (λ γq eq Eq ρq → (fst (eq ρq) , λ xq → Eq (ρq , xq))) (snd Γ) T
          (fmapM (ext-h Γ a (Fam a b) (fam-dom a b) T) (TV b) (Sem b) (λ q → fst q) B))
        (dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) (Fam a b)) (FbE (fst Γ) (Fam a b)) (FbE (lcons (e-ty a) (fst Γ)) (TV b))
          (λ γq eq → (γq , λ ρq → fam-dom a b (eq ρq))) (λ γq eq Eq ρq → (fst (eq ρq) , λ xq → fst (Eq (ρq , xq)))) (snd Γ) T B)
        (pull-fmap (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) (Fam a b)) (FbE (fst Γ) (Fam a b)) (FbE (lcons (e-ty a) (fst Γ)) (TV b)) (FbE (lcons (e-ty a) (fst Γ)) (Sem b))
          (λ γq eq → (γq , λ ρq → fam-dom a b (eq ρq))) (λ xq eq ρq → fst (eq ρq)) (λ γq eq Eq ρq → (fst (eq ρq) , λ xq → Eq (ρq , xq))) (snd Γ) T B))
      (pcat (Mean Γ (Fam a b))
        (dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) (Fam a b)) (FbE (fst Γ) (Fam a b)) (FbE (lcons (e-ty a) (fst Γ)) (Sem b))
          (λ γq eq → (γq , λ ρq → fam-dom a b (eq ρq))) (λ γq eq Eq ρq → (fst (eq ρq) , λ xq → Eq (ρq , xq))) (snd Γ) T
          (fmapM (ext-h Γ a (Fam a b) (fam-dom a b) T) (TV b) (Sem b) (λ q → fst q) B))
        (dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) (Fam a b)) (FbE (fst Γ) (Fam a b)) (FbE (lcons (e-ty a) (fst Γ)) (Sem b))
          (λ γq eq → (γq , λ ρq → fam-dom a b (eq ρq))) (λ γq eq Eq ρq → (fst (eq ρq) , λ xq → Eq (ρq , xq))) (snd Γ) T (fam-body Γ a b T))
        T
        (λ i → dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) (Fam a b)) (FbE (fst Γ) (Fam a b)) (FbE (lcons (e-ty a) (fst Γ)) (Sem b))
          (λ γq eq → (γq , λ ρq → fam-dom a b (eq ρq))) (λ γq eq Eq ρq → (fst (eq ρq) , λ xq → Eq (ρq , xq))) (snd Γ) T (pB i))
        (pcat (Mean Γ (Fam a b))
          (dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) (Fam a b)) (FbE (fst Γ) (Fam a b)) (FbE (lcons (e-ty a) (fst Γ)) (Sem b))
            (λ γq eq → (γq , λ ρq → fam-dom a b (eq ρq))) (λ γq eq Eq ρq → (fst (eq ρq) , λ xq → Eq (ρq , xq))) (snd Γ) T (fam-body Γ a b T))
          (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (Fam a b)) (FbE (fst Γ) (Fam a b)) (λ γq eq → eq) (snd Γ) T)
          T
          (pull-lift-id (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) (Fam a b)) (FbE (fst Γ) (Fam a b)) (FbE (lcons (e-ty a) (fst Γ)) (Sem b))
            (λ γq eq → (γq , λ ρq → fam-dom a b (eq ρq))) (λ γq eq Eq ρq → (fst (eq ρq) , λ xq → Eq (ρq , xq))) (λ γq eq ρq → snd (eq (fst ρq)) (snd ρq)) (snd Γ) T)
          (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (Fam a b)) (snd Γ) T))))
lam-4 : (Γ : CCtx) (a b : TyShape) (T : Mean Γ (Fam a b)) (ct : CompTy (s-fam f-pi a b) Γ T) (c₀ : Code)
  (B : Mean (ext-h Γ a (Fam a b) (fam-dom a b) T) (TV b)) →
  PathM (ext-h Γ a (Fam a b) (fam-dom a b) T) (Sem b) (fmapM (ext-h Γ a (Fam a b) (fam-dom a b) T) (TV b) (Sem b) (λ q → fst q) B) (fam-body Γ a b T) →
  Der (j-tm , ext-h Γ a (Fam a b) (fam-dom a b) T , b , c₀ , B) →
  (cA : Code) → Der (j-ty , Γ , a , cA , fmapM Γ (Fam a b) (Sem a) (fam-dom a b) T) → Dec1 (Out Γ (clam c₀) (m-chk (s-fam f-pi a b) T ct))
lam-4 Γ a b T ct c₀ B pB dB cA dA =
  c-derived (lam-X Γ a b T B , lam-ty Γ a b T B pB ,
    dlam Γ a b (lam-X Γ a b T B) cA c₀
      (d-tr t-any j-ty Γ a cA (fmapM Γ (Fam a b) (Sem a) (fam-dom a b) T) (fmapM Γ (TV (s-fam f-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) (lam-X Γ a b T B))
        (psym (Mean Γ (Sem a)) (fmapM Γ (TV (s-fam f-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) (lam-X Γ a b T B)) (fmapM Γ (Fam a b) (Sem a) (fam-dom a b) T)
          (abs-fst Γ a (Fam a b) (TV (s-fam f-pi a b)) (TV b) (fam-dom a b) (lam-mk a b) T B (Sem a) (λ q → fam-dom a b (fst q)) (fam-dom a b) (λ i F k → fam-dom a b F)))
        dA)
      (der-ext j-tm Γ a b (Fam a b) (TV (s-fam f-pi a b)) (fam-dom a b) (λ q → fam-dom a b (fst q)) (lam-mk a b) (λ i F k → fam-dom a b F)
        (λ q x → (snd (fst q) x , snd q x)) (λ i F k → k) T B c₀ dB))
lam-3 : (Γ : CCtx) (a b : TyShape) (T : Mean Γ (Fam a b)) (ct : CompTy (s-fam f-pi a b) Γ T) (c₀ : Code)
  (B : Mean (ext-h Γ a (Fam a b) (fam-dom a b) T) (TV b)) →
  PathM (ext-h Γ a (Fam a b) (fam-dom a b) T) (Sem b) (fmapM (ext-h Γ a (Fam a b) (fam-dom a b) T) (TV b) (Sem b) (λ q → fst q) B) (fam-body Γ a b T) →
  Der (j-tm , ext-h Γ a (Fam a b) (fam-dom a b) T , b , c₀ , B) → RenR k-nf j-ty Γ a (fmapM Γ (Fam a b) (Sem a) (fam-dom a b) T) →
  Dec1 (Out Γ (clam c₀) (m-chk (s-fam f-pi a b) T ct))
lam-3 Γ a b T ct c₀ B pB dB r =
  lam-4 Γ a b T ct c₀ B pB dB (fst r) (embed {(k-nf , (j-ty , Γ , a , fst r , fmapM Γ (Fam a b) (Sem a) (fam-dom a b) T))} (snd r))
lam-at : Rec → (Γ : CCtx) → Vals Γ → (c₀ : Code) (s : TyShape) (T : Mean Γ (Sem s)) (ct : CompTy s Γ T) → Dec1 (Out Γ (clam c₀) (m-chk s T ct))
lam-at rec Γ vs c₀ (s-fam f-pi a b) T ct =
  d-bind (Out (ext-h Γ a (Fam a b) (fam-dom a b) T) c₀ (m-chk b (fam-body Γ a b T) (cod-ct a b (snd (snd (rr a))) Γ (Fam a b) (λ F → F) T
            (jc-tr j-ty (s-fam f-pi a b) Γ T (fmapM Γ (Fam a b) (Fam a b) (λ F → F) T)
              (psym (Mean Γ (Fam a b)) (fmapM Γ (Fam a b) (Fam a b) (λ F → F) T) T (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (Fam a b)) (snd Γ) T)) ct))))
    (Out Γ (clam c₀) (m-chk (s-fam f-pi a b) T ct))
    (rec (ext-h Γ a (Fam a b) (fam-dom a b) T) (ext-vals Γ a (Fam a b) (fam-dom a b) T (fst ct) vs) c₀
      (m-chk b (fam-body Γ a b T) (cod-ct a b (snd (snd (rr a))) Γ (Fam a b) (λ F → F) T
            (jc-tr j-ty (s-fam f-pi a b) Γ T (fmapM Γ (Fam a b) (Fam a b) (λ F → F) T)
              (psym (Mean Γ (Fam a b)) (fmapM Γ (Fam a b) (Fam a b) (λ F → F) T) T (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (Fam a b)) (snd Γ) T)) ct))))
    (λ rB → lam-3 Γ a b T ct c₀ (fst rB) (fst (snd rB)) (snd (snd rB)) (fst (rr a) Γ (fmapM Γ (Fam a b) (Sem a) (fam-dom a b) T) (fst ct)))
lam-at rec Γ vs c₀ s T ct = c-refused
pr-W1 : (Γ : CCtx) (a b : TyShape) (T : Mean Γ (Fam a b)) (M1 : Mean Γ (TV a)) →
  PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) M1) (fmapM Γ (Fam a b) (Sem a) (fam-dom a b) T) → Mean Γ (FamV a b)
pr-W1 Γ a b T M1 p1 = retype Γ a (Fam a b) (FamV a b) (fam-dom a b) (λ F v → (F , v)) T M1 p1
pr-R : (Γ : CCtx) (a b : TyShape) (W1 : Mean Γ (FamV a b)) (M2 : Mean Γ (TV b)) →
  PathM Γ (Sem b) (fmapM Γ (TV b) (Sem b) (λ q → fst q) M2) (fmapM Γ (FamV a b) (Sem b) (fam-cod a b) W1) → Mean Γ (TV (s-fam f-sig a b))
pr-R Γ a b W1 M2 p2 = retype Γ b (FamV a b) (TV (s-fam f-sig a b)) (fam-cod a b) (λ q v → (fst q , snd q , v)) W1 M2 p2
pr-W1-fst : (Γ : CCtx) (a b : TyShape) (T : Mean Γ (Fam a b)) (M1 : Mean Γ (TV a))
  (p1 : PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) M1) (fmapM Γ (Fam a b) (Sem a) (fam-dom a b) T)) →
  PathM Γ (Fam a b) (fmapM Γ (FamV a b) (Fam a b) (λ q → fst q) (pr-W1 Γ a b T M1 p1)) T
pr-W1-fst Γ a b T M1 p1 =
  pcat (Mean Γ (Fam a b)) (fmapM Γ (FamV a b) (Fam a b) (λ q → fst q) (pr-W1 Γ a b T M1 p1)) (fmapM Γ (Fam a b) (Fam a b) (λ F → F) T) T
    (retype-fst Γ a (Fam a b) (FamV a b) (fam-dom a b) (λ F v → (F , v)) T M1 p1 (Fam a b) (λ q → fst q) (λ F → F) (λ i F v → F))
    (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (Fam a b)) (snd Γ) T)
pr-W1-arg : (Γ : CCtx) (a b : TyShape) (T : Mean Γ (Fam a b)) (M1 : Mean Γ (TV a))
  (p1 : PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) M1) (fmapM Γ (Fam a b) (Sem a) (fam-dom a b) T)) →
  PathM Γ (TV a) (fmapM Γ (FamV a b) (TV a) (fam-arg a b) (pr-W1 Γ a b T M1 p1)) M1
pr-W1-arg Γ a b T M1 p1 = retype-val Γ a (Fam a b) (FamV a b) (fam-dom a b) (λ F v → (F , v)) T M1 p1 (fam-arg a b) (λ i F v → (fam-dom a b F , v))
pr-ctb : (Γ : CCtx) → Vals Γ → (a b : TyShape) (T : Mean Γ (Fam a b)) → CompTy (s-fam f-sig a b) Γ T → (c1 : Code) (M1 : Mean Γ (TV a))
  (p1 : PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) M1) (fmapM Γ (Fam a b) (Sem a) (fam-dom a b) T)) → Der (j-tm , Γ , a , c1 , M1) →
  CompTy b Γ (fmapM Γ (FamV a b) (Sem b) (fam-cod a b) (pr-W1 Γ a b T M1 p1))
pr-ctb Γ vs a b T ct c1 M1 p1 d1 =
  snd ct Γ (world-id Γ) (pr-W1 Γ a b T M1 p1)
    (pcat (Mean Γ (Fam a b)) (fmapM Γ (FamV a b) (Fam a b) (λ q → fst q) (pr-W1 Γ a b T M1 p1)) T (wact Γ Γ (world-id Γ) (Fam a b) T)
      (pr-W1-fst Γ a b T M1 p1) (psym (Mean Γ (Fam a b)) (wact Γ Γ (world-id Γ) (Fam a b) T) T (subM-id Γ (Fam a b) T)))
    (jc-tr j-tm a Γ M1 (fmapM Γ (FamV a b) (TV a) (fam-arg a b) (pr-W1 Γ a b T M1 p1))
      (psym (Mean Γ (TV a)) (fmapM Γ (FamV a b) (TV a) (fam-arg a b) (pr-W1 Γ a b T M1 p1)) M1 (pr-W1-arg Γ a b T M1 p1))
      (comp-j j-tm Γ vs a c1 M1 d1))
pr-ty : (Γ : CCtx) (a b : TyShape) (T : Mean Γ (Fam a b)) (W1 : Mean Γ (FamV a b)) → PathM Γ (Fam a b) (fmapM Γ (FamV a b) (Fam a b) (λ q → fst q) W1) T →
  (M2 : Mean Γ (TV b)) (p2 : PathM Γ (Sem b) (fmapM Γ (TV b) (Sem b) (λ q → fst q) M2) (fmapM Γ (FamV a b) (Sem b) (fam-cod a b) W1)) →
  PathM Γ (Fam a b) (fmapM Γ (TV (s-fam f-sig a b)) (Fam a b) (λ q → fst q) (pr-R Γ a b W1 M2 p2)) T
pr-ty Γ a b T W1 pW M2 p2 =
  pcat (Mean Γ (Fam a b)) (fmapM Γ (TV (s-fam f-sig a b)) (Fam a b) (λ q → fst q) (pr-R Γ a b W1 M2 p2)) (fmapM Γ (FamV a b) (Fam a b) (λ q → fst q) W1) T
    (retype-fst Γ b (FamV a b) (TV (s-fam f-sig a b)) (fam-cod a b) (λ q v → (fst q , snd q , v)) W1 M2 p2 (Fam a b) (λ q → fst q) (λ q → fst q) (λ i q v → fst q)) pW
pr-4 : (Γ : CCtx) (a b : TyShape) (T : Mean Γ (Fam a b)) (ct : CompTy (s-fam f-sig a b) Γ T) (c1 c2 : Code)
  (W1 : Mean Γ (FamV a b)) → PathM Γ (Fam a b) (fmapM Γ (FamV a b) (Fam a b) (λ q → fst q) W1) T →
  (M1 : Mean Γ (TV a)) → PathM Γ (TV a) (fmapM Γ (FamV a b) (TV a) (fam-arg a b) W1) M1 → Der (j-tm , Γ , a , c1 , M1) →
  (M2 : Mean Γ (TV b)) (p2 : PathM Γ (Sem b) (fmapM Γ (TV b) (Sem b) (λ q → fst q) M2) (fmapM Γ (FamV a b) (Sem b) (fam-cod a b) W1)) → Der (j-tm , Γ , b , c2 , M2) →
  RenR k-nf j-ty (ext-h Γ a (TV (s-fam f-sig a b)) (λ q → fam-dom a b (fst q)) (pr-R Γ a b W1 M2 p2)) b (pair-cod Γ a b (pr-R Γ a b W1 M2 p2)) →
  Dec1 (Out Γ (cpair c1 c2) (m-chk (s-fam f-sig a b) T ct))
pr-4 Γ a b T ct c1 c2 W1 pW M1 pM1 d1 M2 p2 d2 rB =
  c-derived (pr-R Γ a b W1 M2 p2 , pr-ty Γ a b T W1 pW M2 p2 ,
    dpair Γ a b (pr-R Γ a b W1 M2 p2) (fst rB) c1 c2
      (embed {(k-nf , (j-ty , ext-h Γ a (TV (s-fam f-sig a b)) (λ q → fam-dom a b (fst q)) (pr-R Γ a b W1 M2 p2) , b , fst rB , pair-cod Γ a b (pr-R Γ a b W1 M2 p2)))} (snd rB))
      (d-tr t-any j-tm Γ a c1 M1 (fmapM Γ (TV (s-fam f-sig a b)) (TV a) (sig-1 a b) (pr-R Γ a b W1 M2 p2))
        (psym (Mean Γ (TV a)) (fmapM Γ (TV (s-fam f-sig a b)) (TV a) (sig-1 a b) (pr-R Γ a b W1 M2 p2)) M1
          (pcat (Mean Γ (TV a)) (fmapM Γ (TV (s-fam f-sig a b)) (TV a) (sig-1 a b) (pr-R Γ a b W1 M2 p2)) (fmapM Γ (FamV a b) (TV a) (fam-arg a b) W1) M1
            (retype-fst Γ b (FamV a b) (TV (s-fam f-sig a b)) (fam-cod a b) (λ q v → (fst q , snd q , v)) W1 M2 p2 (TV a) (sig-1 a b) (fam-arg a b) (λ i q v → fam-arg a b q))
            pM1))
        d1)
      (d-tr t-any j-tm Γ b c2 M2 (fmapM Γ (TV (s-fam f-sig a b)) (TV b) (sig-2 a b) (pr-R Γ a b W1 M2 p2))
        (psym (Mean Γ (TV b)) (fmapM Γ (TV (s-fam f-sig a b)) (TV b) (sig-2 a b) (pr-R Γ a b W1 M2 p2)) M2
          (retype-val Γ b (FamV a b) (TV (s-fam f-sig a b)) (fam-cod a b) (λ q v → (fst q , snd q , v)) W1 M2 p2 (sig-2 a b) (λ i q v → (fam-cod a b q , v))))
        d2))
pr-3 : (Γ : CCtx) (a b : TyShape) (T : Mean Γ (Fam a b)) (ct : CompTy (s-fam f-sig a b) Γ T) (c1 c2 : Code)
  (W1 : Mean Γ (FamV a b)) → PathM Γ (Fam a b) (fmapM Γ (FamV a b) (Fam a b) (λ q → fst q) W1) T →
  (M1 : Mean Γ (TV a)) → PathM Γ (TV a) (fmapM Γ (FamV a b) (TV a) (fam-arg a b) W1) M1 → Der (j-tm , Γ , a , c1 , M1) →
  (M2 : Mean Γ (TV b)) (p2 : PathM Γ (Sem b) (fmapM Γ (TV b) (Sem b) (λ q → fst q) M2) (fmapM Γ (FamV a b) (Sem b) (fam-cod a b) W1)) → Der (j-tm , Γ , b , c2 , M2) →
  Dec1 (Out Γ (cpair c1 c2) (m-chk (s-fam f-sig a b) T ct))
pr-3 Γ a b T ct c1 c2 W1 pW M1 pM1 d1 M2 p2 d2 =
  pr-4 Γ a b T ct c1 c2 W1 pW M1 pM1 d1 M2 p2 d2
    (cod-rty a b (snd (snd (rr a))) (fst (rr b)) Γ (TV (s-fam f-sig a b)) (λ q → fst q) (pr-R Γ a b W1 M2 p2)
      (jc-tr j-ty (s-fam f-sig a b) Γ T (fmapM Γ (TV (s-fam f-sig a b)) (Fam a b) (λ q → fst q) (pr-R Γ a b W1 M2 p2))
        (psym (Mean Γ (Fam a b)) (fmapM Γ (TV (s-fam f-sig a b)) (Fam a b) (λ q → fst q) (pr-R Γ a b W1 M2 p2)) T (pr-ty Γ a b T W1 pW M2 p2)) ct))
pr-2 : Rec → (Γ : CCtx) → Vals Γ → (a b : TyShape) (T : Mean Γ (Fam a b)) (ct : CompTy (s-fam f-sig a b) Γ T) (c1 c2 : Code) (M1 : Mean Γ (TV a))
  (p1 : PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) M1) (fmapM Γ (Fam a b) (Sem a) (fam-dom a b) T)) → Der (j-tm , Γ , a , c1 , M1) →
  Dec1 (Out Γ (cpair c1 c2) (m-chk (s-fam f-sig a b) T ct))
pr-2 rec Γ vs a b T ct c1 c2 M1 p1 d1 =
  d-bind (Out Γ c2 (m-chk b (fmapM Γ (FamV a b) (Sem b) (fam-cod a b) (pr-W1 Γ a b T M1 p1)) (pr-ctb Γ vs a b T ct c1 M1 p1 d1))) (Out Γ (cpair c1 c2) (m-chk (s-fam f-sig a b) T ct))
    (rec Γ vs c2 (m-chk b (fmapM Γ (FamV a b) (Sem b) (fam-cod a b) (pr-W1 Γ a b T M1 p1)) (pr-ctb Γ vs a b T ct c1 M1 p1 d1)))
    (λ r2 → pr-3 Γ a b T ct c1 c2 (pr-W1 Γ a b T M1 p1) (pr-W1-fst Γ a b T M1 p1) M1 (pr-W1-arg Γ a b T M1 p1) d1 (fst r2) (fst (snd r2)) (snd (snd r2)))
pair-at : Rec → (Γ : CCtx) → Vals Γ → (c1 c2 : Code) (s : TyShape) (T : Mean Γ (Sem s)) (ct : CompTy s Γ T) → Dec1 (Out Γ (cpair c1 c2) (m-chk s T ct))
pair-at rec Γ vs c1 c2 (s-fam f-sig a b) T ct =
  d-bind (Out Γ c1 (m-chk a (fmapM Γ (Fam a b) (Sem a) (fam-dom a b) T) (fst ct))) (Out Γ (cpair c1 c2) (m-chk (s-fam f-sig a b) T ct))
    (rec Γ vs c1 (m-chk a (fmapM Γ (Fam a b) (Sem a) (fam-dom a b) T) (fst ct)))
    (λ r1 → pr-2 rec Γ vs a b T ct c1 c2 (fst r1) (fst (snd r1)) (snd (snd r1)))
pair-at rec Γ vs c1 c2 s T ct = c-refused
der-ctx-tr : (jk : JK) (Γ : CCtx) (a s : TyShape) (Y : Type 1) (h : Y → Sem a) (G0 : (q : Y) → El a (h q) → JZ jk s) (M1 M2 : Mean Γ Y) →
  PathM Γ Y M1 M2 → (c : Code) → Der (jk , ext-h Γ a Y h M1 , s , c , ext-lift Γ a Y h (JZ jk s) G0 M1) → Der (jk , ext-h Γ a Y h M2 , s , c , ext-lift Γ a Y h (JZ jk s) G0 M2)
der-ctx-tr jk Γ a s Y h G0 M1 M2 p c d = comp (λ i → Der (jk , ext-h Γ a Y h (p i) , s , c , ext-lift Γ a Y h (JZ jk s) G0 (p i))) (λ i → []) d
der-fmap-ext : (jk : JK) (Γ : CCtx) (a s : TyShape) (Y Y' : Type 1) (g : Y → Y') (h' : Y' → Sem a) (G0' : (q : Y') → El a (h' q) → JZ jk s) (M : Mean Γ Y) (c : Code) →
  Der (jk , ext-h Γ a Y' h' (fmapM Γ Y Y' g M) , s , c , ext-lift Γ a Y' h' (JZ jk s) G0' (fmapM Γ Y Y' g M)) →
  Der (jk , ext-h Γ a Y (λ q → h' (g q)) M , s , c , ext-lift Γ a Y (λ q → h' (g q)) (JZ jk s) (λ q x → G0' (g q) x) M)
der-fmap-ext jk Γ a s Y Y' g h' G0' M c d =
  comp (λ i → Der (jk , (lcons (e-ty a) (fst Γ) ,
      dmap-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (FbE (fst Γ) Y') (CtxV (lcons (e-ty a) (fst Γ))) (λ γq eq ρq → g (eq ρq)) (λ γq eq → (γq , λ ρq → h' (eq ρq))) (snd Γ) M i) , s , c ,
      lift-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (FbE (fst Γ) Y') (CtxV (lcons (e-ty a) (fst Γ))) (FbE (lcons (e-ty a) (fst Γ)) (JZ jk s))
        (λ γq eq ρq → g (eq ρq)) (λ γq eq → (γq , λ ρq → h' (eq ρq))) (λ γq eq ρq → G0' (eq (fst ρq)) (snd ρq)) (snd Γ) M i))
    (λ i → []) d
case-W0T : TyShape → Type 1
case-W0T s = (cwB : One1) × (cwP : Bool → Sem s) × Bool
case-W1T : TyShape → Type 1
case-W1T s = (cwB : One1) × (cwP : Bool → Sem s) × (cwx : Bool) × El s (cwP true)
cs-cs : (Γ : CCtx) (s : TyShape) (Pm : Mean Γ (Fam s-bool s)) (b : Bool) →
  CompS s-bool Γ (fmapM Γ (FamV s-bool s) (TV s-bool) (fam-arg s-bool s) (fmapM Γ (Fam s-bool s) (FamV s-bool s) (λ F → (F , b)) Pm))
cs-cs Γ s Pm true =
  (one , inl1 (fmapM Γ (Fam s-bool s) One1 (λ F → fst F) Pm ,
    pcat (Mean Γ (TV s-bool)) (fmapM Γ (FamV s-bool s) (TV s-bool) (fam-arg s-bool s) (fmapM Γ (Fam s-bool s) (FamV s-bool s) (λ F → (F , true)) Pm))
      (fmapM Γ (Fam s-bool s) (TV s-bool) (λ F → (fst F , true)) Pm) (fmapM Γ One1 (TV s-bool) (bool-v true) (fmapM Γ (Fam s-bool s) One1 (λ F → fst F) Pm))
      (fmapM-fmapM Γ (Fam s-bool s) (FamV s-bool s) (TV s-bool) (λ F → (F , true)) (fam-arg s-bool s) Pm)
      (psym (Mean Γ (TV s-bool)) (fmapM Γ One1 (TV s-bool) (bool-v true) (fmapM Γ (Fam s-bool s) One1 (λ F → fst F) Pm)) (fmapM Γ (Fam s-bool s) (TV s-bool) (λ F → (fst F , true)) Pm)
        (fmapM-fmapM Γ (Fam s-bool s) One1 (TV s-bool) (λ F → fst F) (bool-v true) Pm))))
cs-cs Γ s Pm false =
  (one , inr1 (inl1 (fmapM Γ (Fam s-bool s) One1 (λ F → fst F) Pm ,
    pcat (Mean Γ (TV s-bool)) (fmapM Γ (FamV s-bool s) (TV s-bool) (fam-arg s-bool s) (fmapM Γ (Fam s-bool s) (FamV s-bool s) (λ F → (F , false)) Pm))
      (fmapM Γ (Fam s-bool s) (TV s-bool) (λ F → (fst F , false)) Pm) (fmapM Γ One1 (TV s-bool) (bool-v false) (fmapM Γ (Fam s-bool s) One1 (λ F → fst F) Pm))
      (fmapM-fmapM Γ (Fam s-bool s) (FamV s-bool s) (TV s-bool) (λ F → (F , false)) (fam-arg s-bool s) Pm)
      (psym (Mean Γ (TV s-bool)) (fmapM Γ One1 (TV s-bool) (bool-v false) (fmapM Γ (Fam s-bool s) One1 (λ F → fst F) Pm)) (fmapM Γ (Fam s-bool s) (TV s-bool) (λ F → (fst F , false)) Pm)
        (fmapM-fmapM Γ (Fam s-bool s) One1 (TV s-bool) (λ F → fst F) (bool-v false) Pm)))))
cs-ct : (Γ : CCtx) (s : TyShape) (Pm : Mean Γ (Fam s-bool s)) → CompTy (s-fam f-pi s-bool s) Γ Pm → (b : Bool) →
  CompTy s Γ (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F b) Pm)
cs-ct Γ s Pm ct b =
  jc-tr j-ty s Γ (fmapM Γ (FamV s-bool s) (Sem s) (fam-cod s-bool s) (fmapM Γ (Fam s-bool s) (FamV s-bool s) (λ F → (F , b)) Pm)) (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F b) Pm)
    (fmapM-fmapM Γ (Fam s-bool s) (FamV s-bool s) (Sem s) (λ F → (F , b)) (fam-cod s-bool s) Pm)
    (snd ct Γ (world-id Γ) (fmapM Γ (Fam s-bool s) (FamV s-bool s) (λ F → (F , b)) Pm)
      (pcat (Mean Γ (Fam s-bool s)) (fmapM Γ (FamV s-bool s) (Fam s-bool s) (λ q → fst q) (fmapM Γ (Fam s-bool s) (FamV s-bool s) (λ F → (F , b)) Pm))
        (fmapM Γ (Fam s-bool s) (Fam s-bool s) (λ F → F) Pm) (wact Γ Γ (world-id Γ) (Fam s-bool s) Pm)
        (fmapM-fmapM Γ (Fam s-bool s) (FamV s-bool s) (Fam s-bool s) (λ F → (F , b)) (λ q → fst q) Pm)
        (pcat (Mean Γ (Fam s-bool s)) (fmapM Γ (Fam s-bool s) (Fam s-bool s) (λ F → F) Pm) Pm (wact Γ Γ (world-id Γ) (Fam s-bool s) Pm)
          (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (Fam s-bool s)) (snd Γ) Pm)
          (psym (Mean Γ (Fam s-bool s)) (wact Γ Γ (world-id Γ) (Fam s-bool s) Pm) Pm (subM-id Γ (Fam s-bool s) Pm))))
      (cs-cs Γ s Pm b))
case-W0 : (Γ : CCtx) (s : TyShape) (P : Mean (ext-h Γ s-bool (Sem s-bool) (λ y → y) (one-mean Γ)) (Sem s)) (X : Mean Γ (TV s-bool)) → Mean Γ (case-W0T s)
case-W0 Γ s P X =
  retype Γ s-bool (Fam s-bool s) (case-W0T s) (λ u → fst u) (λ u v → (fst u , snd u , v)) (fam-of Γ s-bool s (one-mean Γ) P) X
    (mean1-path Γ (fmapM Γ (TV s-bool) (Sem s-bool) (λ q → fst q) X) (fmapM Γ (Fam s-bool s) (Sem s-bool) (λ u → fst u) (fam-of Γ s-bool s (one-mean Γ) P)))
case-W0-pr : (Γ : CCtx) (s : TyShape) (P : Mean (ext-h Γ s-bool (Sem s-bool) (λ y → y) (one-mean Γ)) (Sem s)) (X : Mean Γ (TV s-bool)) (Z2 : Type 1) (pr : Fam s-bool s → Z2) →
  PathM Γ Z2 (fmapM Γ (case-W0T s) Z2 (λ u → pr (fst u , fst (snd u))) (case-W0 Γ s P X)) (fmapM Γ (Fam s-bool s) Z2 pr (fam-of Γ s-bool s (one-mean Γ) P))
case-W0-pr Γ s P X Z2 pr =
  retype-fst Γ s-bool (Fam s-bool s) (case-W0T s) (λ u → fst u) (λ u v → (fst u , snd u , v)) (fam-of Γ s-bool s (one-mean Γ) P) X
    (mean1-path Γ (fmapM Γ (TV s-bool) (Sem s-bool) (λ q → fst q) X) (fmapM Γ (Fam s-bool s) (Sem s-bool) (λ u → fst u) (fam-of Γ s-bool s (one-mean Γ) P))) Z2 (λ u → pr (fst u , fst (snd u))) pr (λ i u v → pr u)
case-W1 : (Γ : CCtx) (s : TyShape) (P : Mean (ext-h Γ s-bool (Sem s-bool) (λ y → y) (one-mean Γ)) (Sem s)) (X : Mean Γ (TV s-bool)) (Mt : Mean Γ (TV s)) →
  PathM Γ (Sem s) (fmapM Γ (TV s) (Sem s) (λ q → fst q) Mt) (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F true) (fam-of Γ s-bool s (one-mean Γ) P)) → Mean Γ (case-W1T s)
case-W1 Γ s P X Mt pt =
  retype Γ s (case-W0T s) (case-W1T s) (λ u → fst (snd u) true) (λ u v → (fst u , fst (snd u) , snd (snd u) , v)) (case-W0 Γ s P X) Mt
    (pcat (Mean Γ (Sem s)) (fmapM Γ (TV s) (Sem s) (λ q → fst q) Mt) (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F true) (fam-of Γ s-bool s (one-mean Γ) P)) (fmapM Γ (case-W0T s) (Sem s) (λ u → fst (snd u) true) (case-W0 Γ s P X))
      pt (psym (Mean Γ (Sem s)) (fmapM Γ (case-W0T s) (Sem s) (λ u → fst (snd u) true) (case-W0 Γ s P X)) (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F true) (fam-of Γ s-bool s (one-mean Γ) P)) (case-W0-pr Γ s P X (Sem s) (λ F → snd F true))))
case-W1-pr : (Γ : CCtx) (s : TyShape) (P : Mean (ext-h Γ s-bool (Sem s-bool) (λ y → y) (one-mean Γ)) (Sem s)) (X : Mean Γ (TV s-bool)) (Mt : Mean Γ (TV s))
  (pt : PathM Γ (Sem s) (fmapM Γ (TV s) (Sem s) (λ q → fst q) Mt) (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F true) (fam-of Γ s-bool s (one-mean Γ) P))) (Z2 : Type 1) (pr : case-W0T s → Z2) →
  PathM Γ Z2 (fmapM Γ (case-W1T s) Z2 (λ u → pr (fst u , fst (snd u) , fst (snd (snd u)))) (case-W1 Γ s P X Mt pt)) (fmapM Γ (case-W0T s) Z2 pr (case-W0 Γ s P X))
case-W1-pr Γ s P X Mt pt Z2 pr =
  retype-fst Γ s (case-W0T s) (case-W1T s) (λ u → fst (snd u) true) (λ u v → (fst u , fst (snd u) , snd (snd u) , v)) (case-W0 Γ s P X) Mt
    (pcat (Mean Γ (Sem s)) (fmapM Γ (TV s) (Sem s) (λ q → fst q) Mt) (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F true) (fam-of Γ s-bool s (one-mean Γ) P)) (fmapM Γ (case-W0T s) (Sem s) (λ u → fst (snd u) true) (case-W0 Γ s P X))
      pt (psym (Mean Γ (Sem s)) (fmapM Γ (case-W0T s) (Sem s) (λ u → fst (snd u) true) (case-W0 Γ s P X)) (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F true) (fam-of Γ s-bool s (one-mean Γ) P)) (case-W0-pr Γ s P X (Sem s) (λ F → snd F true))))
    Z2 (λ u → pr (fst u , fst (snd u) , fst (snd (snd u)))) pr (λ i u v → pr u)
case-pf1 : (Γ : CCtx) (s : TyShape) (P : Mean (ext-h Γ s-bool (Sem s-bool) (λ y → y) (one-mean Γ)) (Sem s)) (X : Mean Γ (TV s-bool)) (Mt : Mean Γ (TV s))
  (pt : PathM Γ (Sem s) (fmapM Γ (TV s) (Sem s) (λ q → fst q) Mt) (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F true) (fam-of Γ s-bool s (one-mean Γ) P))) (Mf : Mean Γ (TV s)) →
  PathM Γ (Sem s) (fmapM Γ (TV s) (Sem s) (λ q → fst q) Mf) (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F false) (fam-of Γ s-bool s (one-mean Γ) P)) →
  PathM Γ (Sem s) (fmapM Γ (TV s) (Sem s) (λ q → fst q) Mf) (fmapM Γ (case-W1T s) (Sem s) (λ u → fst (snd u) false) (case-W1 Γ s P X Mt pt))
case-pf1 Γ s P X Mt pt Mf pf =
  pcat (Mean Γ (Sem s)) (fmapM Γ (TV s) (Sem s) (λ q → fst q) Mf) (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F false) (fam-of Γ s-bool s (one-mean Γ) P)) (fmapM Γ (case-W1T s) (Sem s) (λ u → fst (snd u) false) (case-W1 Γ s P X Mt pt))
    pf (psym (Mean Γ (Sem s)) (fmapM Γ (case-W1T s) (Sem s) (λ u → fst (snd u) false) (case-W1 Γ s P X Mt pt)) (fmapM Γ (Fam s-bool s) (Sem s) (λ F → snd F false) (fam-of Γ s-bool s (one-mean Γ) P))
