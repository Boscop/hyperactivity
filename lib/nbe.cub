  pcat (Mean (dext Γ) (Sem a)) L (dline-body Γ (Line (Sem a)) (Sem a) (λ l → l) (ul Γ (Sem a) L)) (path-line-ty Γ a (pt-T Γ a L M0 p0 M1 p1))
    (ul-dl Γ (Sem a) L)
    (pcat (Mean (dext Γ) (Sem a)) (dline-body Γ (Line (Sem a)) (Sem a) (λ l → l) (ul Γ (Sem a) L)) (dline-body Γ (Line (Sem a)) (Sem a) (λ l → l) (fmapM Γ (Sem (s-path a)) (Line (Sem a)) (ty-line a) (pt-T Γ a L M0 p0 M1 p1)))
      (path-line-ty Γ a (pt-T Γ a L M0 p0 M1 p1))
      (λ i → dline-body Γ (Line (Sem a)) (Sem a) (λ l → l)
