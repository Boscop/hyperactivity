-- lib/decode.cub — a byte decoder whose access proofs are certificates checked by evaluation
-- (plan B12 §3 with F32). Loaded after lib/prim.cub and lib/linproof.cub. load32 n b off needs
-- le (plus off 4) n; a decoder reading a 4-byte field and an 8-byte field at i, given that
-- plus i 8 ≤ n, owes le (plus i 4) n. The obligation is linear arithmetic: it is stated as codes
-- over words (lib/linproof.cub's fragment), the certificate is the multiplier list (1), and
-- cert-sound turns the check's `true` — one evaluation — into the proof, carried across Word ≃ Nat.
-- ---------------------------------------------------------------- Nat ↔ Word order
congw2 : (f : Nat → Word) → {a b : Nat} → a ≡ b → f a ≡ f b
congw2 f p = λ i → f (p i)
fromNat-plus : (a b : Nat) → fromNat (plus a b) ≡ plusw (fromNat a) (fromNat b)
fromNat-plus a b =
  concat (congw2 fromNat (symN (toNat-plusw a b)))
    (fromNat-toNat (plusw (fromNat a) (fromNat b)))
congn2 : (f : Word → Nat) → {a b : Word} → a ≡ b → f a ≡ f b
congn2 f p = λ i → f (p i)
-- a word inequality between numerals is the Nat inequality, and back
lew-to-le-path : (a b : Nat) (d : Word) → plusw (fromNat a) d ≡ fromNat b → plus (toNat d) a ≡ b
lew-to-le-path a b d p =
  transN (plus-comm (toNat d) a)
    (transN (symN (toNat-plusw a (toNat d)))
      (transN (congn2 toNat (congw (λ z → plusw (fromNat a) z) (fromNat-toNat d)))
        (transN (congn2 toNat p) (toNat-fromNat b))))
lew-to-le : (a b : Nat) → Lew (fromNat a) (fromNat b) → le a b
lew-to-le a b h = (toNat (fst h) , lew-to-le-path a b (fst h) (snd h))
le-to-lew-path : (a b k : Nat) → plus k a ≡ b → plusw (fromNat a) (fromNat k) ≡ fromNat b
le-to-lew-path a b k q = catw (symw (fromNat-plus a k)) (congw2 fromNat (transN (plus-comm a k) q))
le-to-lew : (a b : Nat) → le a b → Lew (fromNat a) (fromNat b)
le-to-lew a b h = (fromNat (fst h) , le-to-lew-path a b (fst h) (snd h))
-- ---------------------------------------------------------------- the obligation as codes
-- variables: 0 the offset i, 1 the length n; the hypothesis i + 8 ≤ n; the goal i + 4 ≤ n
hyp-i8 : Hyps
hyp-i8 = hcons (lc-add (lc-var #0) (lc-lit #8)) (lc-var #1) hnil
goal-l : LinCode
goal-l = lc-add (lc-var #0) (lc-lit #4)
goal-r : LinCode
goal-r = lc-var #1
cert1 : Mults
cert1 = mucons #1 munil
#same cert-check hyp-i8 cert1 goal-l goal-r = true
-- the environment: the words of i and n
env2 : Nat → Nat → Env
env2 i n = λ v → %welimP (λ w → Word) v (fromNat i) (λ j h → fromNat n)
-- the hypothesis holds at it (from the Nat hypothesis), so the goal holds: the proof of the
-- access bound, with the certificate's check evaluated by the checker
holds-i8 : (i n : Nat) → le (plus i 8) n → Holds (env2 i n) hyp-i8
holds-i8 i n h =
  (le-transport (plusw (fromNat i) #8) (fromNat n) (fromNat (plus i 8)) (fromNat n)
     (fromNat-plus i 8) (λ j → fromNat n) (le-to-lew (plus i 8) n h) , unit)
bound-i4 : (i n : Nat) → le (plus i 8) n → le (plus i 4) n
bound-i4 i n h =
  lew-to-le (plus i 4) n
    (le-transport (fromNat (plus i 4)) (fromNat n) (plusw (fromNat i) #4) (fromNat n)
       (symw (fromNat-plus i 4)) (λ j → fromNat n)
       (cert-sound (env2 i n) hyp-i8 cert1 goal-l goal-r (holds-i8 i n h) (λ j → true)))
-- ---------------------------------------------------------------- the decoder
-- a 4-byte field at i and an 8-byte field at i, from a message of n bytes with i + 8 ≤ n
decode : (n : Nat) → Bytes n → (i : Nat) → le (plus i 8) n → UInt32 × Int64
decode n b i h = (load32 n b i (bound-i4 i n h) , load64 n b i h)
-- readings: a 16-byte message with 258 stored at 4 (32 bits) and 7 at 4 (64 bits, overwriting), read
-- back at 4 with the bound 4 + 8 ≤ 16 given as (4 , refl)
msg : Bytes 16
msg = store64 16 (store32 16 (bytes 16) 4 (8 , λ i → 16) (u32 #258)) 4 (4 , λ i → 16) (i64 #7)
#same snd (decode 16 msg 4 (4 , λ i → 16)) = i64 #7
#same u32toWord (fst (decode 16 msg 4 (4 , λ i → 16))) = #7
