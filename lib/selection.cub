-- lib/selection.cub — a selection from a sequence is a mask: one Bool per position, a position past
-- the mask's end not selected (Avik, 2026-11-16 11:06 UTC: subsequence pulls; 11:10 UTC: code comes
-- with its proof). What a mask selects is a subsequence; what it does not select is the rest; the two
-- merged back along the mask are the sequence (mask-partition). A pull is read in the positions of the
-- one source it is taken from: its piece and its residual are the same text read there as read in
-- the positions of the document it was pulled from (mask-piece, mask-residual), so a residual is
-- pulled from like any document. Ranges of positions are masks (range-mask, mask-or); the loop's
-- ranges of lines become ranges of bytes of the lines' text, and the bytes those select are exactly
-- the lines (lines-pulled). Positions are Nat.
import "core.cub"
import "prim.cub"
-- the lines, each followed by a newline
lines-of : List (List Word) → List Word
lines-of nil = nil
lines-of (cons l ls) = list-append l (cons #10 (lines-of ls))
-- ---------------------------------------------------------------- masks
-- what the mask selects of a sequence, and what it does not
mask-select : {A : Type} → List A → List Bool → List A
mask-select nil m = nil
mask-select (cons x xs) nil = nil
mask-select (cons x xs) (cons true m) = cons x (mask-select xs m)
mask-select (cons x xs) (cons false m) = mask-select xs m
mask-reject : {A : Type} → List A → List Bool → List A
mask-reject nil m = nil
mask-reject (cons x xs) nil = cons x xs
mask-reject (cons x xs) (cons true m) = mask-reject xs m
mask-reject (cons x xs) (cons false m) = cons x (mask-reject xs m)
mask-select-nil : {A : Type} → (s : List A) → Path (List A) (mask-select s nil) nil
mask-select-nil nil = λ i → nil
mask-select-nil (cons x s) = λ i → nil
mask-reject-nil : {A : Type} → (s : List A) → Path (List A) (mask-reject s nil) s
mask-reject-nil nil = λ i → nil
mask-reject-nil (cons x s) = λ i → cons x s
-- the selected positions from the first sequence, the rest from the second
mask-merge : {A : Type} → List Bool → List A → List A → List A
mask-merge nil ys zs = zs
mask-merge (cons true m) nil zs = nil
mask-merge (cons true m) (cons y ys) zs = cons y (mask-merge m ys zs)
mask-merge (cons false m) ys nil = nil
mask-merge (cons false m) ys (cons z zs) = cons z (mask-merge m ys zs)
-- a selection loses nothing
mask-partition : {A : Type} → (m : List Bool) → (xs : List A) → mask-merge m (mask-select xs m) (mask-reject xs m) ≡ xs
mask-partition nil nil = λ i → nil
mask-partition nil (cons x xs) = λ i → cons x xs
mask-partition (cons true m) nil = λ i → nil
mask-partition (cons false m) nil = λ i → nil
mask-partition (cons true m) (cons x xs) = λ i → cons x (mask-partition m xs i)
mask-partition (cons false m) (cons x xs) = λ i → cons x (mask-partition m xs i)
-- ---------------------------------------------------------------- a pull, in the source's positions
-- every position p selects, f selects
mask-within : List Bool → List Bool → Bool
mask-within nil f = true
mask-within (cons true p) nil = false
mask-within (cons false p) nil = mask-within p nil
mask-within (cons true p) (cons true f) = mask-within p f
mask-within (cons true p) (cons false f) = false
mask-within (cons false p) (cons c f) = mask-within p f
-- what f selects and p does not: the residual of the piece p pulled from f
mask-minus : List Bool → List Bool → List Bool
mask-minus nil p = nil
mask-minus (cons c f) nil = cons c f
mask-minus (cons c f) (cons true p) = cons false (mask-minus f p)
mask-minus (cons c f) (cons false p) = cons c (mask-minus f p)
mask-within-none : {A : Type} → (p : List Bool) → isTrue (mask-within p nil) → (s : List A) → Path (List A) (mask-select s p) nil
mask-within-none nil h nil = λ i → nil
mask-within-none nil h (cons x s) = λ i → nil
mask-within-none (cons true p) h s = Empty-rec h
mask-within-none (cons false p) h nil = λ i → nil
mask-within-none (cons false p) h (cons x s) = mask-within-none p h s
-- the piece read in the source is the piece read in the document it was pulled from (f's selection,
-- the piece's positions there being p's bits at f's positions)
mask-piece : {A : Type} → (f p : List Bool) → isTrue (mask-within p f) → (s : List A) →
             mask-select s p ≡ mask-select (mask-select s f) (mask-select p f)
mask-piece nil p h nil = λ i → nil
mask-piece nil p h (cons x s) = mask-within-none p h (cons x s)
mask-piece (cons c f) nil h nil = λ i → nil
mask-piece (cons c f) nil h (cons x s) = sym (mask-select-nil (mask-select (cons x s) (cons c f)))
mask-piece (cons c f) (cons b p) h nil = λ i → nil
mask-piece (cons true f) (cons true p) h (cons x s) = λ i → cons x (mask-piece f p h s i)
mask-piece (cons false f) (cons true p) h (cons x s) = Empty-rec h
mask-piece (cons true f) (cons false p) h (cons x s) = mask-piece f p h s
mask-piece (cons false f) (cons false p) h (cons x s) = mask-piece f p h s
-- the residual read in the source is the residual read in the document it was pulled from
mask-residual : {A : Type} → (f p : List Bool) → (s : List A) →
                mask-select s (mask-minus f p) ≡ mask-reject (mask-select s f) (mask-select p f)
mask-residual nil p nil = λ i → nil
mask-residual nil p (cons x s) = λ i → nil
mask-residual (cons c f) nil s = sym (mask-reject-nil (mask-select s (cons c f)))
mask-residual (cons c f) (cons b p) nil = λ i → nil
mask-residual (cons true f) (cons true p) (cons x s) = mask-residual f p s
mask-residual (cons true f) (cons false p) (cons x s) = λ i → cons x (mask-residual f p s i)
mask-residual (cons false f) (cons true p) (cons x s) = mask-residual f p s
mask-residual (cons false f) (cons false p) (cons x s) = mask-residual f p s
-- ---------------------------------------------------------------- ranges
-- the positions i with a ≤ i < b
range-mask : Nat → Nat → List Bool
range-mask zero zero = nil
range-mask zero (suc b) = cons true (range-mask zero b)
range-mask (suc a) zero = nil
range-mask (suc a) (suc b) = cons false (range-mask a b)
range-mask-zero : (a : Nat) → Path (List Bool) (range-mask a zero) nil
range-mask-zero zero = λ i → nil
range-mask-zero (suc a) = λ i → nil
mask-or : List Bool → List Bool → List Bool
mask-or nil n = n
mask-or (cons b m) nil = cons b m
mask-or (cons b m) (cons c n) = cons (bit-or b c) (mask-or m n)
mask-or-nil : (m : List Bool) → Path (List Bool) (mask-or m nil) m
mask-or-nil nil = λ i → nil
mask-or-nil (cons b m) = λ i → cons b m
-- ranges, each a pair (a , b) of positions a ≤ i < b, as one mask
ranges-mask : List (Nat × Nat) → List Bool
ranges-mask nil = nil
ranges-mask (cons r rs) = mask-or (range-mask (fst r) (snd r)) (ranges-mask rs)
-- ---------------------------------------------------------------- lines and their bytes
-- a line's bit at each of its bytes, before r
paint-onto : Bool → List Word → List Bool → List Bool
paint-onto b nil r = r
paint-onto b (cons x l) r = cons b (paint-onto b l r)
-- a mask of lines as the mask of the bytes of lines-of: each line's bit at its bytes and its newline
mask-lift : List Bool → List (List Word) → List Bool
mask-lift nil ls = nil
mask-lift (cons b m) nil = nil
mask-lift (cons b m) (cons l ls) = paint-onto b l (cons b (mask-lift m ls))
-- the bytes of lines-of before line k (counting from zero)
line-skip : List Word → Nat → Nat
line-skip nil n = n
line-skip (cons x l) n = suc (line-skip l n)
bytes-before : Nat → List (List Word) → Nat
bytes-before zero ls = zero
bytes-before (suc k) nil = zero
bytes-before (suc k) (cons l ls) = line-skip l (suc (bytes-before k ls))
-- ranges of lines as the ranges of their bytes
byte-ranges : List (List Word) → List (Nat × Nat) → List (Nat × Nat)
byte-ranges ls nil = nil
byte-ranges ls (cons r rs) = cons (bytes-before (fst r) ls , bytes-before (snd r) ls) (byte-ranges ls rs)
mask-select-paint-true : (l : List Word) → (r : List Bool) → (s : List Word) →
                         mask-select (list-append l s) (paint-onto true l r) ≡ list-append l (mask-select s r)
mask-select-paint-true nil r s = λ i → mask-select s r
mask-select-paint-true (cons x l) r s = λ i → cons x (mask-select-paint-true l r s i)
mask-select-paint-false : (l : List Word) → (r : List Bool) → (s : List Word) →
                          mask-select (list-append l s) (paint-onto false l r) ≡ mask-select s r
mask-select-paint-false nil r s = λ i → mask-select s r
mask-select-paint-false (cons x l) r s = mask-select-paint-false l r s
mask-select-lift : (m : List Bool) → (ls : List (List Word)) → mask-select (lines-of ls) (mask-lift m ls) ≡ lines-of (mask-select ls m)
mask-select-lift nil nil = λ i → nil
mask-select-lift nil (cons l ls) = mask-select-nil (lines-of (cons l ls))
mask-select-lift (cons b m) nil = λ i → nil
mask-select-lift (cons true m) (cons l ls) =
  mask-select-paint-true l (cons true (mask-lift m ls)) (cons #10 (lines-of ls)) ∙ (λ i → list-append l (cons #10 (mask-select-lift m ls i)))
mask-select-lift (cons false m) (cons l ls) =
  mask-select-paint-false l (cons false (mask-lift m ls)) (cons #10 (lines-of ls)) ∙ mask-select-lift m ls
range-mask-skip : (l : List Word) → (x y : Nat) → range-mask (line-skip l x) (line-skip l y) ≡ paint-onto false l (range-mask x y)
range-mask-skip nil x y = λ i → range-mask x y
range-mask-skip (cons z l) x y = λ i → cons false (range-mask-skip l x y i)
range-mask-zero-skip : (l : List Word) → (y : Nat) → range-mask zero (line-skip l y) ≡ paint-onto true l (range-mask zero y)
range-mask-zero-skip nil y = λ i → range-mask zero y
range-mask-zero-skip (cons z l) y = λ i → cons true (range-mask-zero-skip l y i)
-- a range of lines, as the range of its bytes, is the lines' mask lifted to their bytes
mask-lift-range : (a b : Nat) → (ls : List (List Word)) → range-mask (bytes-before a ls) (bytes-before b ls) ≡ mask-lift (range-mask a b) ls
mask-lift-range zero zero ls = λ i → nil
mask-lift-range (suc a) zero ls = range-mask-zero (bytes-before (suc a) ls)
mask-lift-range zero (suc b) nil = λ i → nil
mask-lift-range (suc a) (suc b) nil = λ i → nil
mask-lift-range zero (suc b) (cons l ls) =
  range-mask-zero-skip l (suc (bytes-before b ls)) ∙ (λ i → paint-onto true l (cons true (mask-lift-range zero b ls i)))
mask-lift-range (suc a) (suc b) (cons l ls) =
  range-mask-skip l (suc (bytes-before a ls)) (suc (bytes-before b ls)) ∙ (λ i → paint-onto false l (cons false (mask-lift-range a b ls i)))
mask-or-paint : (b c : Bool) → (l : List Word) → (r s : List Bool) →
                mask-or (paint-onto b l r) (paint-onto c l s) ≡ paint-onto (bit-or b c) l (mask-or r s)
mask-or-paint b c nil r s = λ i → mask-or r s
mask-or-paint b c (cons x l) r s = λ i → cons (bit-or b c) (mask-or-paint b c l r s i)
mask-lift-or : (m n : List Bool) → (ls : List (List Word)) → mask-lift (mask-or m n) ls ≡ mask-or (mask-lift m ls) (mask-lift n ls)
mask-lift-or nil n ls = λ i → mask-lift n ls
mask-lift-or (cons b m) nil ls = sym (mask-or-nil (mask-lift (cons b m) ls))
mask-lift-or (cons b m) (cons c n) nil = λ i → nil
mask-lift-or (cons b m) (cons c n) (cons l ls) =
  (λ i → paint-onto (bit-or b c) l (cons (bit-or b c) (mask-lift-or m n ls i)))
    ∙ sym (mask-or-paint b c l (cons b (mask-lift m ls)) (cons c (mask-lift n ls)))
mask-lift-ranges : (ls : List (List Word)) → (rs : List (Nat × Nat)) → ranges-mask (byte-ranges ls rs) ≡ mask-lift (ranges-mask rs) ls
mask-lift-ranges ls nil = λ i → nil
mask-lift-ranges ls (cons r rs) =
  (λ i → mask-or (mask-lift-range (fst r) (snd r) ls i) (mask-lift-ranges ls rs i))
    ∙ sym (mask-lift-or (range-mask (fst r) (snd r)) (ranges-mask rs) ls)
-- the bytes the byte ranges of ranges of lines select are exactly those lines
lines-pulled : (ls : List (List Word)) → (rs : List (Nat × Nat)) →
               mask-select (lines-of ls) (ranges-mask (byte-ranges ls rs)) ≡ lines-of (mask-select ls (ranges-mask rs))
lines-pulled ls rs = (λ i → mask-select (lines-of ls) (mask-lift-ranges ls rs i)) ∙ mask-select-lift (ranges-mask rs) ls
