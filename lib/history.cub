-- lib/history.cub — the history of the work, as a value (2026-11-15; Avik: "hyperactivity history
-- should enter history explorer in the product"; docs/the-history-of-the-work.cub). A definition's key
-- is its content, so the store's names log, every binding of a name to a key over time, is the
-- history: `history "name"` (src/syntax.c) reads it as a List Binding, and a view of it is a term
-- over that list, evaluated by the machine (`hyperactive history`).
import "core.cub"
-- a name bound to a key at a time (seconds since 1970, as the store wrote it); the key "-" unbinds
data Binding = binding (name : List Word) (key : List Word) (time : List Word)
-- a binding as the line the store logged
binding-line : Binding → List Word
binding-line (binding n k t) = list-append n (cons #32 (list-append k (cons #32 t)))
-- every binding of a history as its line, in the order bound
history-lines : List Binding → List (List Word)
history-lines bs = list-map binding-line bs
