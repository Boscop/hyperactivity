        (psym (DCube (dims sk) X F G) (diag-dd (lcons (e-ty a) sk) (%wsucc m) X F G Q) (diag-dd sk m X F G Q) (diag-dd-ty-s sk a m X F G Q)))))
cmap-diag-ddS sk' (lcons e-dim sk) σ m0 m1 k X F G Q =
