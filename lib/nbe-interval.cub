-- lib/nbe-interval.cub — path application respects the De Morgan laws and the normal form of interval
-- expressions, the interchange of path applications (M0, M1), and path application under substitution
-- (papp-subst); continues lib/nbe-subst.cub.
import "nbe-subst.cub"
drev : (X : Type 1) (F : X → Type 1) (x : X) → DL X F x → DL X F x
drev X F x q = rev-o X F (degen-l X x) q
dmeet : (X : Type 1) (F : X → Type 1) (x : X) → DL X F x → DL X (DL X F) x
dmeet X F x q = meet-o X F (degen-l X x) q
djoin : (X : Type 1) (F : X → Type 1) (x : X) → DL X F x → DL X (DL X F) x
djoin X F x q = join-o X F (degen-l X x) q
