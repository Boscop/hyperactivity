  PathM (ext-h Γ a Y h M) Z (wact (ext-h Γ a Y h M) Γ (world-wk Γ a Y (λ γ e ρ → h (e ρ)) M) Z (fmapM Γ Y Z k M)) (ext-lift Γ a Y h Z (λ q x → k q) M)
wk-fm Γ a Y h M Z k =
  pcat (Mean (ext-h Γ a Y h M) Z) (wact (ext-h Γ a Y h M) Γ (world-wk Γ a Y (λ γ e ρ → h (e ρ)) M) Z (fmapM Γ Y Z k M))
    (wkM Γ a Y (λ γ e ρ → h (e ρ)) M Z (fmapM Γ Y Z k M)) (ext-lift Γ a Y h Z (λ q x → k q) M)
    (subM-wk Γ a Y (λ γ e ρ → h (e ρ)) M Z (fmapM Γ Y Z k M))
    (push-diag (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y) (FbE (fst Γ) Z) (FbE (lcons (e-ty a) (fst Γ)) Z)
       (λ γ e → (γ , λ ρ → h (e ρ))) (λ γ e N' ρ → N' (fst ρ)) (λ γ e ρ → k (e ρ)) (snd Γ) M)
lift-fm : (Γ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Γ Y) (Z Z' : Type 1) (G0 : (q : Y) → El a (h q) → Z) (k : Z → Z') →
  PathM (ext-h Γ a Y h M) Z' (fmapM (ext-h Γ a Y h M) Z Z' k (ext-lift Γ a Y h Z G0 M)) (ext-lift Γ a Y h Z' (λ q x → k (G0 q x)) M)
lift-fm Γ a Y h M Z Z' G0 k =
  fmap-lift (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y) (FbE (lcons (e-ty a) (fst Γ)) Z) (FbE (lcons (e-ty a) (fst Γ)) Z')
    (λ γ e → (γ , λ ρ → h (e ρ))) (λ γ e ρ → G0 (e (fst ρ)) (snd ρ)) (λ x' e ρ → k (e ρ)) (snd Γ) M
var-lift : (Γ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Γ Y) →
  PathM (ext-h Γ a Y h M) (TV a) (varCube (ext-h Γ a Y h M) none) (ext-lift Γ a Y h (TV a) (λ q x → (h q , x)) M)
var-lift Γ a Y h M =
  of-lift (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y) (FbE (lcons (e-ty a) (fst Γ)) (TV a))
    (λ γ e → (γ , λ ρ → h (e ρ))) (varM (lcons (e-ty a) (fst Γ)) none) (snd Γ) M
