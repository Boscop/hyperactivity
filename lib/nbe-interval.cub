  (ieq-trans sk (dnf-ix (dnf-join (dnf-meet-c c h) (dnf-meet cs h))) (ixjoin (dnf-ix (dnf-meet-c c h)) (dnf-ix (dnf-meet cs h))) (ixmeet (dnf-ix (lcons c cs)) (dnf-ix h))
    (dnf-join-sound sk (dnf-meet-c c h) (dnf-meet cs h))
    (ieq-trans sk (ixjoin (dnf-ix (dnf-meet-c c h)) (dnf-ix (dnf-meet cs h))) (ixjoin (ixmeet (conj-ix c) (dnf-ix h)) (ixmeet (dnf-ix cs) (dnf-ix h))) (ixmeet (dnf-ix (lcons c cs)) (dnf-ix h))
    (ieq-join sk (dnf-ix (dnf-meet-c c h)) (ixmeet (conj-ix c) (dnf-ix h)) (dnf-ix (dnf-meet cs h)) (ixmeet (dnf-ix cs) (dnf-ix h)) (dnf-meet-c-sound sk c h) (dnf-meet-sound sk cs h))
    (ieq-trans sk (ixjoin (ixmeet (conj-ix c) (dnf-ix h)) (ixmeet (dnf-ix cs) (dnf-ix h))) (ixjoin (ixmeet (dnf-ix h) (conj-ix c)) (ixmeet (dnf-ix h) (dnf-ix cs))) (ixmeet (dnf-ix (lcons c cs)) (dnf-ix h))
    (ieq-join sk (ixmeet (conj-ix c) (dnf-ix h)) (ixmeet (dnf-ix h) (conj-ix c)) (ixmeet (dnf-ix cs) (dnf-ix h)) (ixmeet (dnf-ix h) (dnf-ix cs)) (law-comm-m sk (conj-ix c) (dnf-ix h)) (law-comm-m sk (dnf-ix cs) (dnf-ix h)))
    (ieq-trans sk (ixjoin (ixmeet (dnf-ix h) (conj-ix c)) (ixmeet (dnf-ix h) (dnf-ix cs))) (ixmeet (dnf-ix h) (ixjoin (conj-ix c) (dnf-ix cs))) (ixmeet (dnf-ix (lcons c cs)) (dnf-ix h))
    (law-dist-m sk (dnf-ix h) (conj-ix c) (dnf-ix cs))
    (ieq-trans sk (ixmeet (dnf-ix h) (ixjoin (conj-ix c) (dnf-ix cs))) (ixmeet (ixjoin (conj-ix c) (dnf-ix cs)) (dnf-ix h)) (ixmeet (dnf-ix (lcons c cs)) (dnf-ix h))
    (law-comm-m sk (dnf-ix h) (ixjoin (conj-ix c) (dnf-ix cs)))
    (ieq-meet sk (ixjoin (conj-ix c) (dnf-ix cs)) (dnf-ix (lcons c cs)) (dnf-ix h) (dnf-ix h) (ieq-sym sk (dnf-ix (lcons c cs)) (ixjoin (conj-ix c) (dnf-ix cs)) (dnf-ix-cons sk c cs)) (ieq-refl sk (dnf-ix h))))))))
neg-lit : (sk : Lst Entry) (l : Lit) → IEq sk (conj-ix (lcons (fst l , not (snd l)) lnil)) (ixneg (lit-ix l))
neg-lit sk l =
  bool-case2 (λ b → IEq sk (lit-of (fst l) (not b)) (ixneg (lit-of (fst l) b))) (snd l)
    (λ e → ieq-refl sk (ixneg (ixv (fst l))))
    (λ e → ieq-sym sk (ixneg (ixneg (ixv (fst l)))) (ixv (fst l)) (law-negneg sk (ixv (fst l))))
neg-conj-sound : (sk : Lst Entry) (c : Conj) → IEq sk (dnf-ix (neg-conj c)) (ixneg (conj-ix c))
neg-conj-sound sk lnil = ieq-sym sk (ixneg ix1) ix0 (law-neg-1 sk)
neg-conj-sound sk (lcons l ls) =
  (ieq-trans sk (dnf-ix (dnf-add (lcons (fst l , not (snd l)) lnil) (neg-conj ls))) (ixjoin (conj-ix (lcons (fst l , not (snd l)) lnil)) (dnf-ix (neg-conj ls))) (ixneg (conj-ix (lcons l ls)))
    (dnf-add-sound sk (lcons (fst l , not (snd l)) lnil) (neg-conj ls))
    (ieq-trans sk (ixjoin (conj-ix (lcons (fst l , not (snd l)) lnil)) (dnf-ix (neg-conj ls))) (ixjoin (ixneg (lit-ix l)) (ixneg (conj-ix ls))) (ixneg (conj-ix (lcons l ls)))
    (ieq-join sk (conj-ix (lcons (fst l , not (snd l)) lnil)) (ixneg (lit-ix l)) (dnf-ix (neg-conj ls)) (ixneg (conj-ix ls)) (neg-lit sk l) (neg-conj-sound sk ls))
    (ieq-trans sk (ixjoin (ixneg (lit-ix l)) (ixneg (conj-ix ls))) (ixneg (ixmeet (lit-ix l) (conj-ix ls))) (ixneg (conj-ix (lcons l ls)))
    (law-dm-m sk (lit-ix l) (conj-ix ls))
    (ieq-neg sk (ixmeet (lit-ix l) (conj-ix ls)) (conj-ix (lcons l ls)) (ieq-sym sk (conj-ix (lcons l ls)) (ixmeet (lit-ix l) (conj-ix ls)) (conj-ix-cons sk l ls))))))
dnf-neg-sound : (sk : Lst Entry) (g : DNF) → IEq sk (dnf-ix (dnf-neg g)) (ixneg (dnf-ix g))
dnf-neg-sound sk lnil = ieq-sym sk (ixneg ix0) ix1 (law-neg-0 sk)
dnf-neg-sound sk (lcons c cs) =
  (ieq-trans sk (dnf-ix (dnf-meet (neg-conj c) (dnf-neg cs))) (ixmeet (dnf-ix (neg-conj c)) (dnf-ix (dnf-neg cs))) (ixneg (dnf-ix (lcons c cs)))
    (dnf-meet-sound sk (neg-conj c) (dnf-neg cs))
    (ieq-trans sk (ixmeet (dnf-ix (neg-conj c)) (dnf-ix (dnf-neg cs))) (ixmeet (ixneg (conj-ix c)) (ixneg (dnf-ix cs))) (ixneg (dnf-ix (lcons c cs)))
    (ieq-meet sk (dnf-ix (neg-conj c)) (ixneg (conj-ix c)) (dnf-ix (dnf-neg cs)) (ixneg (dnf-ix cs)) (neg-conj-sound sk c) (dnf-neg-sound sk cs))
    (ieq-trans sk (ixmeet (ixneg (conj-ix c)) (ixneg (dnf-ix cs))) (ixneg (ixjoin (conj-ix c) (dnf-ix cs))) (ixneg (dnf-ix (lcons c cs)))
    (law-dm-j sk (conj-ix c) (dnf-ix cs))
    (ieq-neg sk (ixjoin (conj-ix c) (dnf-ix cs)) (dnf-ix (lcons c cs)) (ieq-sym sk (dnf-ix (lcons c cs)) (ixjoin (conj-ix c) (dnf-ix cs)) (dnf-ix-cons sk c cs))))))
bool-absurd : (A : Type) (x : Bool) → x ≡ true → x ≡ false → A
bool-absurd A x p q = false-true A (pcat0 Bool false x true (sym q) p)
weq-refl : (a : Word) → weq a a ≡ true
weq-refl a = %welimP (λ v → weq v v ≡ true) a (λ i → true) (λ n h → pcat0 Bool (weq (%wsucc n) (%wsucc n)) (weq n n) true (weq-ss n n) h)
wlt-irr : (a : Word) → wlt a a ≡ false
wlt-irr a = %welimP (λ v → wlt v v ≡ false) a (λ i → false) (λ n h → pcat0 Bool (wlt (%wsucc n) (%wsucc n)) (wlt n n) false (wlt-ss n n) h)
wlt-x0 : (b : Word) → wlt b #0 ≡ false
wlt-x0 b = %welimP (λ v → wlt v #0 ≡ false) b (λ i → false) (λ n h → wlt-s0 n)
wlt-trans : (a b c : Word) → wlt a b ≡ true → wlt b c ≡ true → wlt a c ≡ true
wlt-trans a =
  %welimP (λ v → (b c : Word) → wlt v b ≡ true → wlt b c ≡ true → wlt v c ≡ true) a
    (λ b c p q → %welimP (λ w → wlt b w ≡ true → wlt #0 w ≡ true) c
       (λ q' → bool-absurd (wlt #0 #0 ≡ true) (wlt b #0) q' (wlt-x0 b))
       (λ k g q' → wlt-0s k) q)
    (λ n h b c p q → w-cases2 (λ b' c' → wlt (%wsucc n) b' ≡ true → wlt b' c' ≡ true → wlt (%wsucc n) c' ≡ true)
       (λ p' q' → bool-absurd (wlt (%wsucc n) #0 ≡ true) (wlt (%wsucc n) #0) p' (wlt-s0 n))
       (λ k p' q' → bool-absurd (wlt (%wsucc n) (%wsucc k) ≡ true) (wlt (%wsucc n) #0) p' (wlt-s0 n))
       (λ m p' q' → bool-absurd (wlt (%wsucc n) #0 ≡ true) (wlt (%wsucc m) #0) q' (wlt-s0 m))
       (λ m k p' q' → pcat0 Bool (wlt (%wsucc n) (%wsucc k)) (wlt n k) true (wlt-ss n k)
          (h m k (pcat0 Bool (wlt n m) (wlt (%wsucc n) (%wsucc m)) true (sym (wlt-ss n m)) p')
                 (pcat0 Bool (wlt m k) (wlt (%wsucc m) (%wsucc k)) true (sym (wlt-ss m k)) q')))
       b c p q)
wlt-tri : (a b : Word) → weq a b ≡ false → wlt a b ≡ false → wlt b a ≡ true
wlt-tri a =
  %welimP (λ v → (b : Word) → weq v b ≡ false → wlt v b ≡ false → wlt b v ≡ true) a
    (λ b → %welimP (λ w → weq #0 w ≡ false → wlt #0 w ≡ false → wlt w #0 ≡ true) b
       (λ e l → bool-absurd (wlt #0 #0 ≡ true) (weq #0 #0) (weq-refl #0) e)
       (λ m g e l → bool-absurd (wlt (%wsucc m) #0 ≡ true) (wlt #0 (%wsucc m)) (wlt-0s m) l))
    (λ n h b → %welimP (λ w → weq (%wsucc n) w ≡ false → wlt (%wsucc n) w ≡ false → wlt w (%wsucc n) ≡ true) b
       (λ e l → wlt-0s n)
       (λ m g e l → pcat0 Bool (wlt (%wsucc m) (%wsucc n)) (wlt m n) true (wlt-ss m n)
          (h m (pcat0 Bool (weq n m) (weq (%wsucc n) (%wsucc m)) false (sym (weq-ss n m)) e)
               (pcat0 Bool (wlt n m) (wlt (%wsucc n) (%wsucc m)) false (sym (wlt-ss n m)) l))))
wlt-neq : (a b : Word) → wlt a b ≡ true → weq a b ≡ false
wlt-neq a =
  %welimP (λ v → (b : Word) → wlt v b ≡ true → weq v b ≡ false) a
    (λ b → %welimP (λ w → wlt #0 w ≡ true → weq #0 w ≡ false) b
       (λ p → bool-absurd (weq #0 #0 ≡ false) (wlt #0 #0) p (wlt-irr #0))
       (λ m g p → weq-0s m))
    (λ n h b → %welimP (λ w → wlt (%wsucc n) w ≡ true → weq (%wsucc n) w ≡ false) b
       (λ p → weq-s0 n)
       (λ m g p → pcat0 Bool (weq (%wsucc n) (%wsucc m)) (weq n m) false (weq-ss n m)
          (h m (pcat0 Bool (wlt n m) (wlt (%wsucc n) (%wsucc m)) true (sym (wlt-ss n m)) p))))
bool-case0 : (P : Bool → Type) (b : Bool) → (b ≡ true → P true) → (b ≡ false → P false) → P b
bool-case0 P b t f = bool-elim (λ c → b ≡ c → P c) t f b (λ i → b)
bool-eq-refl : (b : Bool) → bool-eq b b ≡ true
bool-eq-refl true = λ i → true
bool-eq-refl false = λ i → true
not-true : (b : Bool) → not b ≡ true → b ≡ false
not-true true e = false-true (true ≡ false) e
not-true false e = λ i → false
wlt-path : (k j : Word) → k ≡ j → wlt k j ≡ false
wlt-path k j p = pcat0 Bool (wlt k j) (wlt j j) false (λ i → wlt (p i) j) (wlt-irr j)
weq-path' : (k j : Word) → k ≡ j → weq k j ≡ true
weq-path' k j p = pcat0 Bool (weq k j) (weq j j) true (λ i → weq (p i) j) (weq-refl j)
lit-eq-refl : (l : Lit) → lit-eq l l ≡ true
lit-eq-refl l = pcat0 Bool (andB (weq (fst l) (fst l)) (bool-eq (snd l) (snd l))) (bool-eq (snd l) (snd l)) true
  (λ i → andB (weq-refl (fst l) i) (bool-eq (snd l) (snd l))) (bool-eq-refl (snd l))
lit-lt-of-wlt : (l m : Lit) → wlt (fst l) (fst m) ≡ true → lit-lt l m ≡ true
lit-lt-of-wlt l m e = λ i → if e i then true else (if weq (fst l) (fst m) then andB (not (snd l)) (snd m) else false)
lit-lt-same : (l m : Lit) → fst l ≡ fst m → lit-lt l m ≡ andB (not (snd l)) (snd m)
lit-lt-same l m p =
  pcat0 Bool (lit-lt l m) (if weq (fst l) (fst m) then andB (not (snd l)) (snd m) else false) (andB (not (snd l)) (snd m))
    (λ i → if wlt-path (fst l) (fst m) p i then true else (if weq (fst l) (fst m) then andB (not (snd l)) (snd m) else false))
    (λ i → if weq-path' (fst l) (fst m) p i then andB (not (snd l)) (snd m) else false)
lit-lt-of-eq : (l m : Lit) → fst l ≡ fst m → snd l ≡ false → snd m ≡ true → lit-lt l m ≡ true
lit-lt-of-eq l m p s t = pcat0 Bool (lit-lt l m) (andB (not (snd l)) (snd m)) true (lit-lt-same l m p) (λ i → andB (not (s i)) (t i))
lit-lt-cases : (P : Type) (l m : Lit) → (wlt (fst l) (fst m) ≡ true → P) → (fst l ≡ fst m → snd l ≡ false → snd m ≡ true → P) → lit-lt l m ≡ true → P
lit-lt-cases P l m kw ke =
  bool-case0 (λ b → (if b then true else (if weq (fst l) (fst m) then andB (not (snd l)) (snd m) else false)) ≡ true → P) (wlt (fst l) (fst m))
    (λ e h → kw e)
    (λ e → bool-case0 (λ b → (if b then andB (not (snd l)) (snd m) else false) ≡ true → P) (weq (fst l) (fst m))
       (λ e2 h → ke (weq-sound (fst l) (fst m) e2) (not-true (snd l) (andB-l (not (snd l)) (snd m) h)) (andB-r (not (snd l)) (snd m) h))
       (λ e2 h → false-true P h))
lit-lt-irr : (l : Lit) → lit-lt l l ≡ false
lit-lt-irr l =
  bool-case0 (λ b → lit-lt l l ≡ b → lit-lt l l ≡ false) (lit-lt l l)
    (λ e h → lit-lt-cases (lit-lt l l ≡ false) l l
       (λ w → bool-absurd (lit-lt l l ≡ false) (wlt (fst l) (fst l)) w (wlt-irr (fst l)))
       (λ p s t → bool-absurd (lit-lt l l ≡ false) (snd l) t s) h)
    (λ e h → h) (λ i → lit-lt l l)
lit-lt-neq : (l m : Lit) → lit-lt l m ≡ true → lit-eq l m ≡ false
lit-lt-neq l m =
  lit-lt-cases (lit-eq l m ≡ false) l m
    (λ w i → andB (wlt-neq (fst l) (fst m) w i) (bool-eq (snd l) (snd m)))
    (λ p s t → pcat0 Bool (lit-eq l m) (bool-eq false true) false
       (λ i → andB (weq-path' (fst l) (fst m) p i) (bool-eq (s i) (t i))) (λ i → false))
lit-lt-trans : (a b c : Lit) → lit-lt a b ≡ true → lit-lt b c ≡ true → lit-lt a c ≡ true
lit-lt-trans a b c p q =
  lit-lt-cases (lit-lt a c ≡ true) a b
    (λ w1 → lit-lt-cases (lit-lt a c ≡ true) b c
       (λ w2 → lit-lt-of-wlt a c (wlt-trans (fst a) (fst b) (fst c) w1 w2))
       (λ p2 s2 t2 → lit-lt-of-wlt a c (pcat0 Bool (wlt (fst a) (fst c)) (wlt (fst a) (fst b)) true (λ i → wlt (fst a) (p2 (~ i))) w1)) q)
    (λ p1 s1 t1 → lit-lt-cases (lit-lt a c ≡ true) b c
       (λ w2 → lit-lt-of-wlt a c (pcat0 Bool (wlt (fst a) (fst c)) (wlt (fst b) (fst c)) true (λ i → wlt (p1 i) (fst c)) w2))
       (λ p2 s2 t2 → bool-absurd (lit-lt a c ≡ true) (snd b) t1 s2) q) p
tri-bools : (s t : Bool) → bool-eq s t ≡ false → andB (not s) t ≡ false → (s ≡ true) × (t ≡ false)
tri-bools true true e a = false-true ((true ≡ true) × (true ≡ false)) (sym e)
tri-bools true false e a = ((λ i → true) , (λ i → false))
tri-bools false true e a = false-true ((false ≡ true) × (true ≡ false)) (sym a)
tri-bools false false e a = false-true ((false ≡ true) × (false ≡ false)) (sym e)
lit-tri-eq : (l m : Lit) → fst l ≡ fst m → lit-eq l m ≡ false → lit-lt l m ≡ false → lit-lt m l ≡ true
lit-tri-eq l m p ne nl =
  lit-lt-of-eq m l (λ i → p (~ i))
    (snd (tri-bools (snd l) (snd m)
      (pcat0 Bool (bool-eq (snd l) (snd m)) (lit-eq l m) false (λ i → andB (weq-path' (fst l) (fst m) p (~ i)) (bool-eq (snd l) (snd m))) ne)
      (pcat0 Bool (andB (not (snd l)) (snd m)) (lit-lt l m) false (sym (lit-lt-same l m p)) nl)))
    (fst (tri-bools (snd l) (snd m)
      (pcat0 Bool (bool-eq (snd l) (snd m)) (lit-eq l m) false (λ i → andB (weq-path' (fst l) (fst m) p (~ i)) (bool-eq (snd l) (snd m))) ne)
      (pcat0 Bool (andB (not (snd l)) (snd m)) (lit-lt l m) false (sym (lit-lt-same l m p)) nl)))
lit-tri : (l m : Lit) → lit-eq l m ≡ false → lit-lt l m ≡ false → lit-lt m l ≡ true
lit-tri l m ne nl =
  bool-case0 (λ b → wlt (fst l) (fst m) ≡ b → lit-lt m l ≡ true) (wlt (fst l) (fst m))
    (λ w x → bool-absurd (lit-lt m l ≡ true) (lit-lt l m) (lit-lt-of-wlt l m w) nl)
    (λ w x → bool-case0 (λ b → weq (fst l) (fst m) ≡ b → lit-lt m l ≡ true) (weq (fst l) (fst m))
       (λ e y → lit-tri-eq l m (weq-sound (fst l) (fst m) e) ne nl)
       (λ e y → lit-lt-of-wlt m l (wlt-tri (fst l) (fst m) e w)) (λ i → weq (fst l) (fst m)))
    (λ i → wlt (fst l) (fst m))
andB-intro : (a b : Bool) → a ≡ true → b ≡ true → andB a b ≡ true
andB-intro a b p q = λ i → andB (p i) (q i)
lit-eq-sound : (l m : Lit) → lit-eq l m ≡ true → l ≡ m
lit-eq-sound l m e =
  λ i → (weq-sound (fst l) (fst m) (andB-l (weq (fst l) (fst m)) (bool-eq (snd l) (snd m)) e) i ,
         bool-eq-sound (snd l) (snd m) (andB-r (weq (fst l) (fst m)) (bool-eq (snd l) (snd m)) e) i)
lit-lt-path-r : (l m : Lit) → l ≡ m → lit-lt l m ≡ false
lit-lt-path-r l m p = pcat0 Bool (lit-lt l m) (lit-lt l l) false (λ i → lit-lt l (p (~ i))) (lit-lt-irr l)
lit-eq-path-r : (l m : Lit) → l ≡ m → lit-eq l m ≡ true
lit-eq-path-r l m p = pcat0 Bool (lit-eq l m) (lit-eq l l) true (λ i → lit-eq l (p (~ i))) (lit-eq-refl l)
conj-lt-of-lt : (l m : Lit) (ls ms : Conj) → lit-lt l m ≡ true → conj-lt (lcons l ls) (lcons m ms) ≡ true
conj-lt-of-lt l m ls ms p = λ i → if p i then true else (if lit-eq l m then conj-lt ls ms else false)
conj-lt-of-eq : (l m : Lit) (ls ms : Conj) → l ≡ m → conj-lt (lcons l ls) (lcons m ms) ≡ conj-lt ls ms
conj-lt-of-eq l m ls ms p =
  pcat0 Bool (conj-lt (lcons l ls) (lcons m ms)) (if lit-eq l m then conj-lt ls ms else false) (conj-lt ls ms)
    (λ i → if lit-lt-path-r l m p i then true else (if lit-eq l m then conj-lt ls ms else false))
    (λ i → if lit-eq-path-r l m p i then conj-lt ls ms else false)
conj-lt-cases : (P : Type) (l m : Lit) (ls ms : Conj) → (lit-lt l m ≡ true → P) → (l ≡ m → conj-lt ls ms ≡ true → P) →
  conj-lt (lcons l ls) (lcons m ms) ≡ true → P
conj-lt-cases P l m ls ms kl ke =
  bool-case0 (λ b → (if b then true else (if lit-eq l m then conj-lt ls ms else false)) ≡ true → P) (lit-lt l m)
    (λ e h → kl e)
    (λ e → bool-case0 (λ b → (if b then conj-lt ls ms else false) ≡ true → P) (lit-eq l m)
       (λ e2 h → ke (lit-eq-sound l m e2) h)
       (λ e2 h → false-true P h))
conj-eq-refl : (c : Conj) → conj-eq c c ≡ true
conj-eq-refl lnil = λ i → true
conj-eq-refl (lcons l ls) = andB-intro (lit-eq l l) (conj-eq ls ls) (lit-eq-refl l) (conj-eq-refl ls)
conj-lt-x0 : (c : Conj) → conj-lt c lnil ≡ false
conj-lt-x0 lnil = λ i → false
conj-lt-x0 (lcons l ls) = λ i → false
conj-lt-trans : (a b c : Conj) → conj-lt a b ≡ true → conj-lt b c ≡ true → conj-lt a c ≡ true
conj-lt-trans lnil b lnil p q = pcat0 Bool false (conj-lt b lnil) true (λ i → conj-lt-x0 b (~ i)) q
conj-lt-trans lnil b (lcons n ns) p q = λ i → true
conj-lt-trans (lcons l ls) lnil c p q = false-true (conj-lt (lcons l ls) c ≡ true) p
conj-lt-trans (lcons l ls) (lcons m ms) lnil p q = false-true (conj-lt (lcons l ls) lnil ≡ true) q
conj-lt-trans (lcons l ls) (lcons m ms) (lcons n ns) p q =
  conj-lt-cases (conj-lt (lcons l ls) (lcons n ns) ≡ true) l m ls ms
    (λ lm → conj-lt-cases (conj-lt (lcons l ls) (lcons n ns) ≡ true) m n ms ns
       (λ mn → conj-lt-of-lt l n ls ns (lit-lt-trans l m n lm mn))
       (λ mn q2 → conj-lt-of-lt l n ls ns (pcat0 Bool (lit-lt l n) (lit-lt l m) true (λ i → lit-lt l (mn (~ i))) lm)) q)
    (λ lm p2 → conj-lt-cases (conj-lt (lcons l ls) (lcons n ns) ≡ true) m n ms ns
       (λ mn → conj-lt-of-lt l n ls ns (pcat0 Bool (lit-lt l n) (lit-lt m n) true (λ i → lit-lt (lm i) n) mn))
       (λ mn q2 → pcat0 Bool (conj-lt (lcons l ls) (lcons n ns)) (conj-lt ls ns) true
          (conj-lt-of-eq l n ls ns (pcat0 Lit l m n lm mn)) (conj-lt-trans ls ms ns p2 q2)) q) p
conj-tri : (c d : Conj) → conj-eq c d ≡ false → conj-lt c d ≡ false → conj-lt d c ≡ true
conj-tri lnil lnil ne nl = false-true (false ≡ true) (λ i → ne (~ i))
conj-tri lnil (lcons m ms) ne nl = false-true (conj-lt (lcons m ms) lnil ≡ true) (λ i → nl (~ i))
conj-tri (lcons l ls) lnil ne nl = λ i → true
conj-tri (lcons l ls) (lcons m ms) ne nl =
  bool-case0 (λ b → lit-lt l m ≡ b → conj-lt (lcons m ms) (lcons l ls) ≡ true) (lit-lt l m)
    (λ lt x → bool-absurd (conj-lt (lcons m ms) (lcons l ls) ≡ true) (conj-lt (lcons l ls) (lcons m ms)) (conj-lt-of-lt l m ls ms lt) nl)
    (λ nlt x → bool-case0 (λ b → lit-eq l m ≡ b → conj-lt (lcons m ms) (lcons l ls) ≡ true) (lit-eq l m)
       (λ eq y → pcat0 Bool (conj-lt (lcons m ms) (lcons l ls)) (conj-lt ms ls) true
          (conj-lt-of-eq m l ms ls (sym (lit-eq-sound l m eq)))
          (conj-tri ls ms
             (pcat0 Bool (conj-eq ls ms) (conj-eq (lcons l ls) (lcons m ms)) false (λ i → andB (eq (~ i)) (conj-eq ls ms)) ne)
             (pcat0 Bool (conj-lt ls ms) (conj-lt (lcons l ls) (lcons m ms)) false (sym (conj-lt-of-eq l m ls ms (lit-eq-sound l m eq))) nl)))
       (λ neq y → conj-lt-of-lt m l ms ls (lit-tri l m neq nlt)) (λ i → lit-eq l m))
    (λ i → lit-lt l m)
lit-lb : Lit → Conj → Bool
lit-lb l lnil = true
lit-lb l (lcons m ms) = andB (lit-lt l m) (lit-lb l ms)
conj-sorted : Conj → Bool
conj-sorted lnil = true
conj-sorted (lcons l ls) = andB (lit-lb l ls) (conj-sorted ls)
lb-trans : (a b : Lit) (c : Conj) → lit-lt a b ≡ true → lit-lb b c ≡ true → lit-lb a c ≡ true
lb-trans a b lnil p h = λ i → true
lb-trans a b (lcons m ms) p h =
  andB-intro (lit-lt a m) (lit-lb a ms) (lit-lt-trans a b m p (andB-l (lit-lt b m) (lit-lb b ms) h)) (lb-trans a b ms p (andB-r (lit-lt b m) (lit-lb b ms) h))
lb-ins : (k l : Lit) (c : Conj) → lit-lt k l ≡ true → lit-lb k c ≡ true → lit-lb k (conj-ins l c) ≡ true
lb-ins k l lnil p h = λ i → andB (p i) true
lb-ins k l (lcons m ms) p h =
  bool-case0 (λ b → lit-lb k (if b then lcons m ms else (if lit-lt l m then lcons l (lcons m ms) else lcons m (conj-ins l ms))) ≡ true) (lit-eq l m)
    (λ e → h)
    (λ e → bool-case0 (λ b → lit-lb k (if b then lcons l (lcons m ms) else lcons m (conj-ins l ms)) ≡ true) (lit-lt l m)
       (λ lt → andB-intro (lit-lt k l) (lit-lb k (lcons m ms)) p h)
       (λ nlt → andB-intro (lit-lt k m) (lit-lb k (conj-ins l ms)) (andB-l (lit-lt k m) (lit-lb k ms) h) (lb-ins k l ms p (andB-r (lit-lt k m) (lit-lb k ms) h))))
ins-sorted : (l : Lit) (c : Conj) → conj-sorted c ≡ true → conj-sorted (conj-ins l c) ≡ true
ins-sorted l lnil h = λ i → true
ins-sorted l (lcons m ms) h =
  bool-case0 (λ b → lit-eq l m ≡ b → conj-sorted (if b then lcons m ms else (if lit-lt l m then lcons l (lcons m ms) else lcons m (conj-ins l ms))) ≡ true) (lit-eq l m)
    (λ e x → h)
    (λ ne x → bool-case0 (λ b → lit-lt l m ≡ b → conj-sorted (if b then lcons l (lcons m ms) else lcons m (conj-ins l ms)) ≡ true) (lit-lt l m)
       (λ lt y → andB-intro (lit-lb l (lcons m ms)) (conj-sorted (lcons m ms))
          (andB-intro (lit-lt l m) (lit-lb l ms) lt (lb-trans l m ms lt (andB-l (lit-lb m ms) (conj-sorted ms) h))) h)
       (λ nlt y → andB-intro (lit-lb m (conj-ins l ms)) (conj-sorted (conj-ins l ms))
          (lb-ins m l ms (lit-tri l m ne nlt) (andB-l (lit-lb m ms) (conj-sorted ms) h))
          (ins-sorted l ms (andB-r (lit-lb m ms) (conj-sorted ms) h)))
       (λ i → lit-lt l m))
    (λ i → lit-eq l m)
meet-sorted : (c d : Conj) → conj-sorted d ≡ true → conj-sorted (conj-meet c d) ≡ true
meet-sorted lnil d h = h
meet-sorted (lcons l ls) d h = ins-sorted l (conj-meet ls d) (meet-sorted ls d h)
ins-head : (l : Lit) (c : Conj) → lit-lb l c ≡ true → conj-ins l c ≡ lcons l c
ins-head l lnil h = λ i → lcons l lnil
ins-head l (lcons m ms) h =
  λ i → if lit-lt-neq l m (andB-l (lit-lt l m) (lit-lb l ms) h) i then lcons m ms
        else (if andB-l (lit-lt l m) (lit-lb l ms) h i then lcons l (lcons m ms) else lcons m (conj-ins l ms))
meet-nil : (c : Conj) → conj-sorted c ≡ true → conj-meet c lnil ≡ c
meet-nil lnil h = λ i → lnil
meet-nil (lcons l ls) h =
  pcat0 Conj (conj-ins l (conj-meet ls lnil)) (conj-ins l ls) (lcons l ls)
    (λ i → conj-ins l (meet-nil ls (andB-r (lit-lb l ls) (conj-sorted ls) h) i))
    (ins-head l ls (andB-l (lit-lb l ls) (conj-sorted ls) h))
conj-has-head : (l : Lit) (ls : Conj) → conj-has l (lcons l ls) ≡ true
conj-has-head l ls = λ i → if lit-eq-refl l i then true else conj-has l ls
conj-has-weak : (l m : Lit) (c : Conj) → conj-has l c ≡ true → conj-has l (lcons m c) ≡ true
conj-has-weak l m c h =
  bool-case0 (λ b → (if b then true else conj-has l c) ≡ true) (lit-eq l m) (λ e i → true) (λ e → h)
conj-sub-weak : (m : Lit) (c d : Conj) → conj-sub c d ≡ true → conj-sub c (lcons m d) ≡ true
conj-sub-weak m lnil d h = λ i → true
conj-sub-weak m (lcons l ls) d h =
  andB-intro (conj-has l (lcons m d)) (conj-sub ls (lcons m d))
    (conj-has-weak l m d (andB-l (conj-has l d) (conj-sub ls d) h))
    (conj-sub-weak m ls d (andB-r (conj-has l d) (conj-sub ls d) h))
conj-sub-refl : (c : Conj) → conj-sub c c ≡ true
conj-sub-refl lnil = λ i → true
conj-sub-refl (lcons l ls) = andB-intro (conj-has l (lcons l ls)) (conj-sub ls (lcons l ls)) (conj-has-head l ls) (conj-sub-weak l ls ls (conj-sub-refl ls))
conj-eq-sound : (c d : Conj) → conj-eq c d ≡ true → c ≡ d
conj-eq-sound lnil lnil e = λ i → lnil
conj-eq-sound lnil (lcons m ms) e = false-true (Path Conj lnil (lcons m ms)) e
conj-eq-sound (lcons l ls) lnil e = false-true (Path Conj (lcons l ls) lnil) e
conj-eq-sound (lcons l ls) (lcons m ms) e =
  λ i → lcons (lit-eq-sound l m (andB-l (lit-eq l m) (conj-eq ls ms) e) i) (conj-eq-sound ls ms (andB-r (lit-eq l m) (conj-eq ls ms) e) i)
eq-sub : (c d : Conj) → conj-eq c d ≡ true → conj-sub c d ≡ true
eq-sub c d e = pcat0 Bool (conj-sub c d) (conj-sub c c) true (λ i → conj-sub c (conj-eq-sound c d e (~ i))) (conj-sub-refl c)
every-c : (Conj → Bool) → DNF → Bool
every-c P lnil = true
every-c P (lcons d ds) = andB (P d) (every-c P ds)
inc : Conj → Conj → Bool
inc c d = andB (not (conj-sub c d)) (not (conj-sub d c))
dnf-ok : DNF → Bool
dnf-ok lnil = true
dnf-ok (lcons c cs) = andB (conj-sorted c) (andB (every-c (conj-lt c) cs) (andB (every-c (inc c) cs) (dnf-ok cs)))
ok-sorted : (c : Conj) (cs : DNF) → dnf-ok (lcons c cs) ≡ true → conj-sorted c ≡ true
ok-sorted c cs h = andB-l (conj-sorted c) (andB (every-c (conj-lt c) cs) (andB (every-c (inc c) cs) (dnf-ok cs))) h
ok-lb : (c : Conj) (cs : DNF) → dnf-ok (lcons c cs) ≡ true → every-c (conj-lt c) cs ≡ true
ok-lb c cs h = andB-l (every-c (conj-lt c) cs) (andB (every-c (inc c) cs) (dnf-ok cs)) (andB-r (conj-sorted c) (andB (every-c (conj-lt c) cs) (andB (every-c (inc c) cs) (dnf-ok cs))) h)
ok-inc : (c : Conj) (cs : DNF) → dnf-ok (lcons c cs) ≡ true → every-c (inc c) cs ≡ true
ok-inc c cs h = andB-l (every-c (inc c) cs) (dnf-ok cs) (andB-r (every-c (conj-lt c) cs) (andB (every-c (inc c) cs) (dnf-ok cs)) (andB-r (conj-sorted c) (andB (every-c (conj-lt c) cs) (andB (every-c (inc c) cs) (dnf-ok cs))) h))
ok-tail : (c : Conj) (cs : DNF) → dnf-ok (lcons c cs) ≡ true → dnf-ok cs ≡ true
ok-tail c cs h = andB-r (every-c (inc c) cs) (dnf-ok cs) (andB-r (every-c (conj-lt c) cs) (andB (every-c (inc c) cs) (dnf-ok cs)) (andB-r (conj-sorted c) (andB (every-c (conj-lt c) cs) (andB (every-c (inc c) cs) (dnf-ok cs))) h))
ok-cons : (c : Conj) (cs : DNF) → conj-sorted c ≡ true → every-c (conj-lt c) cs ≡ true → every-c (inc c) cs ≡ true → dnf-ok cs ≡ true → dnf-ok (lcons c cs) ≡ true
ok-cons c cs a b d e = λ i → andB (a i) (andB (b i) (andB (d i) (e i)))
every-insert : (P : Conj → Bool) (c : Conj) (f : DNF) → P c ≡ true → every-c P f ≡ true → every-c P (dnf-insert c f) ≡ true
every-insert P c lnil p h = λ i → andB (p i) true
every-insert P c (lcons d ds) p h =
  bool-case0 (λ b → every-c P (if b then lcons c (lcons d ds) else lcons d (dnf-insert c ds)) ≡ true) (conj-lt c d)
    (λ e → andB-intro (P c) (every-c P (lcons d ds)) p h)
    (λ e → andB-intro (P d) (every-c P (dnf-insert c ds)) (andB-l (P d) (every-c P ds) h) (every-insert P c ds p (andB-r (P d) (every-c P ds) h)))
every-drop : (P : Conj → Bool) (c : Conj) (f : DNF) → every-c P f ≡ true → every-c P (dnf-drop-sup c f) ≡ true
every-drop P c lnil h = λ i → true
every-drop P c (lcons d ds) h =
  bool-case0 (λ b → every-c P (if b then dnf-drop-sup c ds else lcons d (dnf-drop-sup c ds)) ≡ true) (conj-sub c d)
    (λ e → every-drop P c ds (andB-r (P d) (every-c P ds) h))
    (λ e → andB-intro (P d) (every-c P (dnf-drop-sup c ds)) (andB-l (P d) (every-c P ds) h) (every-drop P c ds (andB-r (P d) (every-c P ds) h)))
every-and : (P Q : Conj → Bool) (f : DNF) → every-c P f ≡ true → every-c Q f ≡ true → every-c (λ e → andB (P e) (Q e)) f ≡ true
every-and P Q lnil p q = λ i → true
every-and P Q (lcons d ds) p q =
  andB-intro (andB (P d) (Q d)) (every-c (λ e → andB (P e) (Q e)) ds)
    (andB-intro (P d) (Q d) (andB-l (P d) (every-c P ds) p) (andB-l (Q d) (every-c Q ds) q))
    (every-and P Q ds (andB-r (P d) (every-c P ds) p) (andB-r (Q d) (every-c Q ds) q))
every-and-l : (P Q : Conj → Bool) (f : DNF) → every-c (λ e → andB (P e) (Q e)) f ≡ true → every-c P f ≡ true
every-and-l P Q lnil h = λ i → true
every-and-l P Q (lcons d ds) h =
  andB-intro (P d) (every-c P ds) (andB-l (P d) (Q d) (andB-l (andB (P d) (Q d)) (every-c (λ e → andB (P e) (Q e)) ds) h))
    (every-and-l P Q ds (andB-r (andB (P d) (Q d)) (every-c (λ e → andB (P e) (Q e)) ds) h))
every-and-r : (P Q : Conj → Bool) (f : DNF) → every-c (λ e → andB (P e) (Q e)) f ≡ true → every-c Q f ≡ true
every-and-r P Q lnil h = λ i → true
every-and-r P Q (lcons d ds) h =
  andB-intro (Q d) (every-c Q ds) (andB-r (P d) (Q d) (andB-l (andB (P d) (Q d)) (every-c (λ e → andB (P e) (Q e)) ds) h))
    (every-and-r P Q ds (andB-r (andB (P d) (Q d)) (every-c (λ e → andB (P e) (Q e)) ds) h))
drop-nsup : (c : Conj) (f : DNF) → every-c (λ e → not (conj-sub c e)) (dnf-drop-sup c f) ≡ true
drop-nsup c lnil = λ i → true
drop-nsup c (lcons d ds) =
  bool-case0 (λ b → conj-sub c d ≡ b → every-c (λ e → not (conj-sub c e)) (if b then dnf-drop-sup c ds else lcons d (dnf-drop-sup c ds)) ≡ true) (conj-sub c d)
    (λ e x → drop-nsup c ds)
    (λ e x → andB-intro (not (conj-sub c d)) (every-c (λ e → not (conj-sub c e)) (dnf-drop-sup c ds)) (λ i → not (e i)) (drop-nsup c ds))
    (λ i → conj-sub c d)
anysub-nsub : (c : Conj) (f : DNF) → dnf-any-sub c f ≡ false → every-c (λ e → not (conj-sub e c)) f ≡ true
anysub-nsub c lnil h = λ i → true
anysub-nsub c (lcons d ds) hm =
  bool-case0 (λ b → conj-sub d c ≡ b → (if b then true else dnf-any-sub c ds) ≡ false → every-c (λ e → not (conj-sub e c)) (lcons d ds) ≡ true) (conj-sub d c)
    (λ e x h → false-true (every-c (λ e → not (conj-sub e c)) (lcons d ds) ≡ true) (λ i → h (~ i)))
    (λ e x h → andB-intro (not (conj-sub d c)) (every-c (λ e → not (conj-sub e c)) ds) (λ i → not (e i)) (anysub-nsub c ds h))
    (λ i → conj-sub d c) hm
lb-trans-c : (a b : Conj) (f : DNF) → conj-lt a b ≡ true → every-c (conj-lt b) f ≡ true → every-c (conj-lt a) f ≡ true
lb-trans-c a b lnil p h = λ i → true
lb-trans-c a b (lcons d ds) p h =
  andB-intro (conj-lt a d) (every-c (conj-lt a) ds) (conj-lt-trans a b d p (andB-l (conj-lt b d) (every-c (conj-lt b) ds) h)) (lb-trans-c a b ds p (andB-r (conj-lt b d) (every-c (conj-lt b) ds) h))
inc-sym : (c d : Conj) → inc c d ≡ true → inc d c ≡ true
inc-sym c d h = andB-intro (not (conj-sub d c)) (not (conj-sub c d)) (andB-r (not (conj-sub c d)) (not (conj-sub d c)) h) (andB-l (not (conj-sub c d)) (not (conj-sub d c)) h)
inc-neq : (c d : Conj) → inc c d ≡ true → conj-eq c d ≡ false
inc-neq c d h =
  bool-case0 (λ b → conj-eq c d ≡ b → conj-eq c d ≡ false) (conj-eq c d)
    (λ e x → bool-absurd (conj-eq c d ≡ false) (conj-sub c d) (eq-sub c d e) (not-true (conj-sub c d) (andB-l (not (conj-sub c d)) (not (conj-sub d c)) h)))
    (λ e x → e) (λ i → conj-eq c d)
insert-ok : (c : Conj) (f : DNF) → conj-sorted c ≡ true → every-c (inc c) f ≡ true → dnf-ok f ≡ true → dnf-ok (dnf-insert c f) ≡ true
insert-ok c lnil s ic h = ok-cons c lnil s (λ i → true) (λ i → true) (λ i → true)
insert-ok c (lcons d ds) s ic h =
  bool-case0 (λ b → conj-lt c d ≡ b → dnf-ok (if b then lcons c (lcons d ds) else lcons d (dnf-insert c ds)) ≡ true) (conj-lt c d)
    (λ lt x → ok-cons c (lcons d ds) s
       (andB-intro (conj-lt c d) (every-c (conj-lt c) ds) lt (lb-trans-c c d ds lt (ok-lb d ds h))) ic h)
    (λ nlt x → ok-cons d (dnf-insert c ds) (ok-sorted d ds h)
       (every-insert (conj-lt d) c ds
          (conj-tri c d (inc-neq c d (andB-l (inc c d) (every-c (inc c) ds) ic)) nlt) (ok-lb d ds h))
       (every-insert (inc d) c ds (inc-sym c d (andB-l (inc c d) (every-c (inc c) ds) ic)) (ok-inc d ds h))
       (insert-ok c ds s (andB-r (inc c d) (every-c (inc c) ds) ic) (ok-tail d ds h)))
    (λ i → conj-lt c d)
drop-ok : (c : Conj) (f : DNF) → dnf-ok f ≡ true → dnf-ok (dnf-drop-sup c f) ≡ true
drop-ok c lnil h = λ i → true
drop-ok c (lcons d ds) h =
  bool-case0 (λ b → dnf-ok (if b then dnf-drop-sup c ds else lcons d (dnf-drop-sup c ds)) ≡ true) (conj-sub c d)
    (λ e → drop-ok c ds (ok-tail d ds h))
    (λ e → ok-cons d (dnf-drop-sup c ds) (ok-sorted d ds h) (every-drop (conj-lt d) c ds (ok-lb d ds h)) (every-drop (inc d) c ds (ok-inc d ds h)) (drop-ok c ds (ok-tail d ds h)))
add-ok : (c : Conj) (f : DNF) → conj-sorted c ≡ true → dnf-ok f ≡ true → dnf-ok (dnf-add c f) ≡ true
add-ok c f s h =
  bool-case0 (λ b → dnf-any-sub c f ≡ b → dnf-ok (if b then f else dnf-insert c (dnf-drop-sup c f)) ≡ true) (dnf-any-sub c f)
    (λ e x → h)
    (λ e x → insert-ok c (dnf-drop-sup c f) s
       (every-and (λ g → not (conj-sub c g)) (λ g → not (conj-sub g c)) (dnf-drop-sup c f) (drop-nsup c f)
          (every-drop (λ g → not (conj-sub g c)) c f (anysub-nsub c f e)))
       (drop-ok c f h))
    (λ i → dnf-any-sub c f)
join-ok : (g h : DNF) → dnf-ok g ≡ true → dnf-ok h ≡ true → dnf-ok (dnf-join g h) ≡ true
join-ok lnil h og oh = oh
join-ok (lcons c cs) h og oh = add-ok c (dnf-join cs h) (ok-sorted c cs og) (join-ok cs h (ok-tail c cs og) oh)
meet-c-ok : (c : Conj) (g : DNF) → dnf-ok g ≡ true → dnf-ok (dnf-meet-c c g) ≡ true
meet-c-ok c lnil og = λ i → true
meet-c-ok c (lcons d ds) og = add-ok (conj-meet c d) (dnf-meet-c c ds) (meet-sorted c d (ok-sorted d ds og)) (meet-c-ok c ds (ok-tail d ds og))
meet-ok : (g h : DNF) → dnf-ok g ≡ true → dnf-ok h ≡ true → dnf-ok (dnf-meet g h) ≡ true
meet-ok lnil h og oh = λ i → true
meet-ok (lcons c cs) h og oh = join-ok (dnf-meet-c c h) (dnf-meet cs h) (meet-c-ok c h oh) (meet-ok cs h (ok-tail c cs og) oh)
neg-conj-ok : (c : Conj) → dnf-ok (neg-conj c) ≡ true
neg-conj-ok lnil = λ i → true
neg-conj-ok (lcons l ls) = add-ok (lcons (fst l , not (snd l)) lnil) (neg-conj ls) (λ i → true) (neg-conj-ok ls)
neg-ok : (g : DNF) → dnf-ok (dnf-neg g) ≡ true
neg-ok lnil = λ i → true
neg-ok (lcons c cs) = meet-ok (neg-conj c) (dnf-neg cs) (neg-conj-ok c) (neg-ok cs)
norm-ok : (f : DNF) → dnf-ok (dnf-norm f) ≡ true
norm-ok lnil = λ i → true
norm-ok (lcons c cs) = add-ok (conj-meet c lnil) (dnf-norm cs) (meet-sorted c lnil (λ i → true)) (norm-ok cs)
nsub-anysub : (c : Conj) (f : DNF) → every-c (λ e → not (conj-sub e c)) f ≡ true → dnf-any-sub c f ≡ false
nsub-anysub c lnil h = λ i → false
nsub-anysub c (lcons d ds) h =
  pcat0 Bool (dnf-any-sub c (lcons d ds)) (dnf-any-sub c ds) false
    (λ i → if not-true (conj-sub d c) (andB-l (not (conj-sub d c)) (every-c (λ e → not (conj-sub e c)) ds) h) i then true else dnf-any-sub c ds)
    (nsub-anysub c ds (andB-r (not (conj-sub d c)) (every-c (λ e → not (conj-sub e c)) ds) h))
nsup-drop : (c : Conj) (f : DNF) → every-c (λ e → not (conj-sub c e)) f ≡ true → dnf-drop-sup c f ≡ f
nsup-drop c lnil h = λ i → lnil
nsup-drop c (lcons d ds) h =
  pcat0 DNF (dnf-drop-sup c (lcons d ds)) (lcons d (dnf-drop-sup c ds)) (lcons d ds)
    (λ i → if not-true (conj-sub c d) (andB-l (not (conj-sub c d)) (every-c (λ e → not (conj-sub c e)) ds) h) i then dnf-drop-sup c ds else lcons d (dnf-drop-sup c ds))
    (λ i → lcons d (nsup-drop c ds (andB-r (not (conj-sub c d)) (every-c (λ e → not (conj-sub c e)) ds) h) i))
lb-insert-head : (c : Conj) (f : DNF) → every-c (conj-lt c) f ≡ true → dnf-insert c f ≡ lcons c f
lb-insert-head c lnil h = λ i → lcons c lnil
lb-insert-head c (lcons d ds) h =
  λ i → if andB-l (conj-lt c d) (every-c (conj-lt c) ds) h i then lcons c (lcons d ds) else lcons d (dnf-insert c ds)
add-head : (c : Conj) (cs : DNF) → dnf-ok (lcons c cs) ≡ true → dnf-add c cs ≡ lcons c cs
add-head c cs h =
  pcat0 DNF (dnf-add c cs) (dnf-insert c (dnf-drop-sup c cs)) (lcons c cs)
    (λ i → if nsub-anysub c cs (every-and-r (λ e → not (conj-sub c e)) (λ e → not (conj-sub e c)) cs (ok-inc c cs h)) i then cs else dnf-insert c (dnf-drop-sup c cs))
    (pcat0 DNF (dnf-insert c (dnf-drop-sup c cs)) (dnf-insert c cs) (lcons c cs)
       (λ i → dnf-insert c (nsup-drop c cs (every-and-l (λ e → not (conj-sub c e)) (λ e → not (conj-sub e c)) cs (ok-inc c cs h)) i))
       (lb-insert-head c cs (ok-lb c cs h)))
norm-id : (f : DNF) → dnf-ok f ≡ true → dnf-norm f ≡ f
norm-id lnil h = λ i → lnil
norm-id (lcons c cs) h =
  pcat0 DNF (dnf-norm (lcons c cs)) (dnf-add c cs) (lcons c cs)
    (λ i → dnf-add (meet-nil c (ok-sorted c cs h) i) (norm-id cs (ok-tail c cs h) i))
    (add-head c cs h)
dnf-eq-refl : (f : DNF) → dnf-eq f f ≡ true
dnf-eq-refl lnil = λ i → true
dnf-eq-refl (lcons c cs) = andB-intro (conj-eq c c) (dnf-eq cs cs) (conj-eq-refl c) (dnf-eq-refl cs)
dnf-eq-sound : (f g : DNF) → dnf-eq f g ≡ true → f ≡ g
dnf-eq-sound lnil lnil e = λ i → lnil
dnf-eq-sound lnil (lcons d ds) e = false-true (Path DNF lnil (lcons d ds)) e
dnf-eq-sound (lcons c cs) lnil e = false-true (Path DNF (lcons c cs) lnil) e
dnf-eq-sound (lcons c cs) (lcons d ds) e =
  λ i → lcons (conj-eq-sound c d (andB-l (conj-eq c d) (dnf-eq cs ds) e) i) (dnf-eq-sound cs ds (andB-r (conj-eq c d) (dnf-eq cs ds) e) i)
ok-canon : (f : DNF) → dnf-ok f ≡ true → dnf-canon f ≡ true
ok-canon f h = pcat0 Bool (dnf-eq (dnf-norm f) f) (dnf-eq f f) true (λ i → dnf-eq (norm-id f h i) f) (dnf-eq-refl f)
canon-ok : (f : DNF) → dnf-canon f ≡ true → dnf-ok f ≡ true
canon-ok f h = pcat0 Bool (dnf-ok f) (dnf-ok (dnf-norm f)) true (λ i → dnf-ok (dnf-eq-sound (dnf-norm f) f h (~ i))) (norm-ok f)
canon-join : (g h : DNF) → isTrue (dnf-canon g) → isTrue (dnf-canon h) → isTrue (dnf-canon (dnf-join g h))
canon-join g h cg ch = eq→isTrue (ok-canon (dnf-join g h) (join-ok g h (canon-ok g (isTrue→eq cg)) (canon-ok h (isTrue→eq ch))))
canon-meet : (g h : DNF) → isTrue (dnf-canon g) → isTrue (dnf-canon h) → isTrue (dnf-canon (dnf-meet g h))
canon-meet g h cg ch = eq→isTrue (ok-canon (dnf-meet g h) (meet-ok g h (canon-ok g (isTrue→eq cg)) (canon-ok h (isTrue→eq ch))))
canon-neg : (g : DNF) → isTrue (dnf-canon (dnf-neg g))
canon-neg g = eq→isTrue (ok-canon (dnf-neg g) (neg-ok g))
subst-var : (sk' sk : Lst Entry) → CMap sk' sk → Word → IEx
subst-var sk' lnil σ k = ix0
subst-var sk' (lcons (e-ty a) sk) σ k = if weq k #0 then ix0 else subst-var sk' sk σ (%wsub k #1)
subst-var sk' (lcons e-dim sk) σ k = if weq k #0 then dnf-ix (snd σ) else subst-var sk' sk (fst σ) (%wsub k #1)
ixs : (sk' sk : Lst Entry) → CMap sk' sk → IEx → IEx
ixs sk' sk σ ix0 = ix0
ixs sk' sk σ ix1 = ix1
ixs sk' sk σ (ixv k) = subst-var sk' sk σ k
ixs sk' sk σ (ixneg x) = ixneg (ixs sk' sk σ x)
ixs sk' sk σ (ixmeet x y) = ixmeet (ixs sk' sk σ x) (ixs sk' sk σ y)
ixs sk' sk σ (ixjoin x y) = ixjoin (ixs sk' sk σ x) (ixs sk' sk σ y)
