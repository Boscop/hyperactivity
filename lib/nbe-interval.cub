sv-ty-s : (sk' sk : Lst Entry) (a : TyShape) (σ : CMap sk' sk) (m : Word) → Path IEx (subst-var sk' (lcons (e-ty a) sk) σ (%wsucc m)) (subst-var sk' sk σ m)
sv-ty-s sk' sk a σ m = λ i → if weq-s0 m i then ix0 else subst-var sk' sk σ (wsub-s1 m i)
sv-dim-s : (sk' sk : Lst Entry) (σ : CMap sk' (lcons e-dim sk)) (m : Word) → Path IEx (subst-var sk' (lcons e-dim sk) σ (%wsucc m)) (subst-var sk' sk (fst σ) m)
sv-dim-s sk' sk σ m = λ i → if weq-s0 m i then dnf-ix (snd σ) else subst-var sk' sk (fst σ) (wsub-s1 m i)
M1T : (sk' : Lst Entry) → IEx → DNF → Type 2
M1T sk' e φ = (X : Type 1) (F : X → Type 1) (C : Cube (dims sk') (Line X)) (E : DCube (dims sk') (Line X) (LineO X (DL X F)) C) →
  PathP (λ i → DCube (dims sk') X F (papp-cube sk' X φ C))
