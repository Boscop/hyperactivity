  (h3 : (x : X) → F3 x → F4 x) (h4 : (x : X) → F4 x → F5 x) (k0 : (x : X) → F0 x → G1 x) (k1 : (x : X) → G1 x → F5 x)
  (q : PathP (λ i → (x : X) → F0 x → F5 x) (λ x y → h4 x (h3 x (h2 x (h1 x (h0 x y))))) (λ x y → k1 x (k0 x y))) (c : Cube n X) (d : DCube n X F0 c) →
  PathP (λ i → DCube n X F5 c) (dcube-fmap n X F4 F5 h4 c (dcube-fmap n X F3 F4 h3 c (dcube-fmap n X F2 F3 h2 c (dcube-fmap n X F1 F2 h1 c (dcube-fmap n X F0 F1 h0 c d)))))
    (dcube-fmap n X G1 F5 k1 c (dcube-fmap n X F0 G1 k0 c d))
fmap-sw52 zero X F0 F1 F2 F3 F4 F5 G1 h0 h1 h2 h3 h4 k0 k1 q c d = λ i → q i c d
fmap-sw52 (suc n) X F0 F1 F2 F3 F4 F5 G1 h0 h1 h2 h3 h4 k0 k1 q c d =
  fmap-sw52 n (Line X) (LineO X F0) (LineO X F1) (LineO X F2) (LineO X F3) (LineO X F4) (LineO X F5) (LineO X G1) (lineo-fmap X F0 F1 h0) (lineo-fmap X F1 F2 h1)
    (lineo-fmap X F2 F3 h2) (lineo-fmap X F3 F4 h3) (lineo-fmap X F4 F5 h4) (lineo-fmap X F0 G1 k0) (lineo-fmap X G1 F5 k1) (λ i L y → lineo-fmap X F0 F5 (q i) L y) c d
