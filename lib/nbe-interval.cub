    (papp-cube-d sk' X F φ C (papp-ex sk' (Line X) (LineO X F) e C (dcube-fmap (dims sk') (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) C E)))
M0T : (sk' : Lst Entry) → DNF → Type 2
M0T sk' φ = (X : Type 1) (F : X → Type 1) (C : Cube (dims sk') (Line X)) (E : DCube (dims sk') (Line X) (LineO X (DL X F)) C) →
  PathP (λ i → DCube (dims sk') X F (papp-cube sk' X φ C))
