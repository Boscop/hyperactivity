bool-elim2 : (P : Bool → Type 2) → P true → P false → (b : Bool) → P b
bool-elim2 P t f true = t
bool-elim2 P t f false = f
bool-case2 : (P : Bool → Type 2) (b : Bool) → (b ≡ true → P true) → (b ≡ false → P false) → P b
bool-case2 P b t f = bool-elim2 (λ c → b ≡ c → P c) t f b (λ i → b)
ft-fam : (A : Type) → Bool → Type
ft-fam A true = A
ft-fam A false = A → A
false-true : (A : Type) → false ≡ true → A
false-true A e = comp (λ i → ft-fam A (e i)) (λ i → []) (λ a → a)
ft-fam2 : (A : Type 2) → Bool → Type 2
ft-fam2 A true = A
ft-fam2 A false = A → A
false-true2 : (A : Type 2) → false ≡ true → A
false-true2 A e = comp (λ i → ft-fam2 A (e i)) (λ i → []) (λ a → a)
andB-l : (a b : Bool) → andB a b ≡ true → a ≡ true
andB-l true b e = λ i → true
andB-l false b e = e
andB-r : (a b : Bool) → andB a b ≡ true → b ≡ true
andB-r true b e = e
andB-r false b e = false-true (b ≡ true) e
bool-eq-sound : (b c : Bool) → bool-eq b c ≡ true → b ≡ c
bool-eq-sound true c e = λ i → e (~ i)
bool-eq-sound false true e = e
bool-eq-sound false false e = λ i → false
lit-of : Word → Bool → IEx
lit-of k b = if b then ixv k else ixneg (ixv k)
ieq-lit : (sk : Lst Entry) (l m : Lit) → lit-eq l m ≡ true → IEq sk (lit-ix l) (lit-ix m)
ieq-lit sk l m e =
  comp (λ i → IEq sk (lit-ix l) (lit-of (weq-sound (fst l) (fst m) (andB-l (weq (fst l) (fst m)) (bool-eq (snd l) (snd m)) e) i) (snd m)))
    (λ i → []) (comp (λ i → IEq sk (lit-ix l) (lit-of (fst l) (bool-eq-sound (snd l) (snd m) (andB-r (weq (fst l) (fst m)) (bool-eq (snd l) (snd m)) e) i))) (λ i → [])
      (ieq-refl sk (lit-ix l)))
conj-ix-cons : (sk : Lst Entry) (l : Lit) (ls : Conj) → IEq sk (conj-ix (lcons l ls)) (ixmeet (lit-ix l) (conj-ix ls))
conj-ix-cons sk l lnil = ieq-sym sk (ixmeet (lit-ix l) ix1) (lit-ix l) (law-unit-m-r sk (lit-ix l))
conj-ix-cons sk l (lcons m ms) = ieq-refl sk (ixmeet (lit-ix l) (conj-ix-from m ms))
dnf-ix-cons : (sk : Lst Entry) (c : Conj) (cs : DNF) → IEq sk (dnf-ix (lcons c cs)) (ixjoin (conj-ix c) (dnf-ix cs))
dnf-ix-cons sk c lnil = ieq-sym sk (ixjoin (conj-ix c) ix0) (conj-ix c) (law-unit-j-r sk (conj-ix c))
dnf-ix-cons sk c (lcons d ds) = ieq-refl sk (ixjoin (conj-ix c) (dnf-ix-from d ds))
meet-rot : (sk : Lst Entry) (a b y : IEx) → IEq sk (ixmeet a (ixmeet b y)) (ixmeet b (ixmeet a y))
meet-rot sk a b y =
  ieq-trans sk (ixmeet a (ixmeet b y)) (ixmeet (ixmeet a b) y) (ixmeet b (ixmeet a y))
    (ieq-sym sk (ixmeet (ixmeet a b) y) (ixmeet a (ixmeet b y)) (law-assoc-m sk a b y))
    (ieq-trans sk (ixmeet (ixmeet a b) y) (ixmeet (ixmeet b a) y) (ixmeet b (ixmeet a y))
      (ieq-meet sk (ixmeet a b) (ixmeet b a) y y (law-comm-m sk a b) (ieq-refl sk y))
      (law-assoc-m sk b a y))
join-rot : (sk : Lst Entry) (a b y : IEx) → IEq sk (ixjoin a (ixjoin b y)) (ixjoin b (ixjoin a y))
join-rot sk a b y =
  ieq-trans sk (ixjoin a (ixjoin b y)) (ixjoin (ixjoin a b) y) (ixjoin b (ixjoin a y))
    (ieq-sym sk (ixjoin (ixjoin a b) y) (ixjoin a (ixjoin b y)) (law-assoc-j sk a b y))
    (ieq-trans sk (ixjoin (ixjoin a b) y) (ixjoin (ixjoin b a) y) (ixjoin b (ixjoin a y))
      (ieq-join sk (ixjoin a b) (ixjoin b a) y y (law-comm-j sk a b) (ieq-refl sk y))
      (law-assoc-j sk b a y))
absorb-lit : (sk : Lst Entry) (l m : Lit) (ms : Conj) → lit-eq l m ≡ true → IEq sk (conj-ix (lcons m ms)) (ixmeet (lit-ix l) (conj-ix (lcons m ms)))
absorb-lit sk l m ms e =
  (ieq-trans sk (conj-ix (lcons m ms)) (ixmeet (lit-ix m) (conj-ix ms)) (ixmeet (lit-ix l) (conj-ix (lcons m ms)))
    (conj-ix-cons sk m ms)
    (ieq-trans sk (ixmeet (lit-ix m) (conj-ix ms)) (ixmeet (ixmeet (lit-ix m) (lit-ix m)) (conj-ix ms)) (ixmeet (lit-ix l) (conj-ix (lcons m ms)))
    (ieq-meet sk (lit-ix m) (ixmeet (lit-ix m) (lit-ix m)) (conj-ix ms) (conj-ix ms) (ieq-sym sk (ixmeet (lit-ix m) (lit-ix m)) (lit-ix m) (law-idem-m sk (lit-ix m))) (ieq-refl sk (conj-ix ms)))
    (ieq-trans sk (ixmeet (ixmeet (lit-ix m) (lit-ix m)) (conj-ix ms)) (ixmeet (lit-ix m) (ixmeet (lit-ix m) (conj-ix ms))) (ixmeet (lit-ix l) (conj-ix (lcons m ms)))
    (law-assoc-m sk (lit-ix m) (lit-ix m) (conj-ix ms))
    (ieq-trans sk (ixmeet (lit-ix m) (ixmeet (lit-ix m) (conj-ix ms))) (ixmeet (lit-ix l) (ixmeet (lit-ix m) (conj-ix ms))) (ixmeet (lit-ix l) (conj-ix (lcons m ms)))
    (ieq-meet sk (lit-ix m) (lit-ix l) (ixmeet (lit-ix m) (conj-ix ms)) (ixmeet (lit-ix m) (conj-ix ms)) (ieq-sym sk (lit-ix l) (lit-ix m) (ieq-lit sk l m e)) (ieq-refl sk (ixmeet (lit-ix m) (conj-ix ms))))
    (ieq-meet sk (lit-ix l) (lit-ix l) (ixmeet (lit-ix m) (conj-ix ms)) (conj-ix (lcons m ms)) (ieq-refl sk (lit-ix l)) (ieq-sym sk (conj-ix (lcons m ms)) (ixmeet (lit-ix m) (conj-ix ms)) (conj-ix-cons sk m ms)))))))
conj-ins-sound : (sk : Lst Entry) (l : Lit) (c : Conj) → IEq sk (conj-ix (conj-ins l c)) (ixmeet (lit-ix l) (conj-ix c))
conj-ins-sound sk l lnil = ieq-sym sk (ixmeet (lit-ix l) ix1) (lit-ix l) (law-unit-m-r sk (lit-ix l))
conj-ins-sound sk l (lcons m ms) =
  bool-case2 (λ b → IEq sk (conj-ix (if b then lcons m ms else (if lit-lt l m then lcons l (lcons m ms) else lcons m (conj-ins l ms)))) (ixmeet (lit-ix l) (conj-ix (lcons m ms)))) (lit-eq l m)
    (λ e → absorb-lit sk l m ms e)
    (λ e0 → bool-case2 (λ b → IEq sk (conj-ix (if b then lcons l (lcons m ms) else lcons m (conj-ins l ms))) (ixmeet (lit-ix l) (conj-ix (lcons m ms)))) (lit-lt l m)
      (λ e → ieq-refl sk (ixmeet (lit-ix l) (conj-ix (lcons m ms))))
      (λ e → (ieq-trans sk (conj-ix (lcons m (conj-ins l ms))) (ixmeet (lit-ix m) (conj-ix (conj-ins l ms))) (ixmeet (lit-ix l) (conj-ix (lcons m ms)))
    (conj-ix-cons sk m (conj-ins l ms))
