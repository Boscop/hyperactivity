M0 : (sk : Lst Entry) (f : DNF) → M0T sk f
M0 sk f X F C E = M0-ex sk (dnf-ix f) X F C E

cmap-papp-ex : (sk' sk : Lst Entry) (σ : CMap sk' sk) (e : IEx) (X : Type 1) (F : X → Type 1) (G : Cube (dims sk) X) (Q : DCube (dims sk) X (DL X F) G) →
  PathP (λ i → DCube (dims sk') X F (cmap-cube sk' sk σ X G)) (papp-ex sk' X F (ixs sk' sk σ e) (cmap-cube sk' sk σ X G) (cmap-d sk' sk σ X (DL X F) G Q)) (cmap-d sk' sk σ X F G (papp-ex sk X F e G Q))
