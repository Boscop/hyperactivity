pex-exch-meet : (sk : Lst Entry) (r s e' : IEx) → PExchT sk r e' → PExchT sk s e' → PExchT sk (ixmeet r s) e'
pex-exch-meet sk r s e' hr hs X F G d = pex-exch-cn sk dmeet r s e' hr hs X F G d (λ i x y → dmeet X (DL X F) x (dexch X F x y))
pex-exch-join : (sk : Lst Entry) (r s e' : IEx) → PExchT sk r e' → PExchT sk s e' → PExchT sk (ixjoin r s) e'
pex-exch-join sk r s e' hr hs X F G d = pex-exch-cn sk djoin r s e' hr hs X F G d (λ i x y → djoin X (DL X F) x (dexch X F x y))
pex-exch-v : (sk : Lst Entry) (k : Word) (e' : IEx) → PExchT sk (ixv k) e'
pex-exch-v sk k ix0 = pex-exch-sym sk ix0 (ixv k) (pex-exch-0 sk (ixv k))
pex-exch-v sk k ix1 = pex-exch-sym sk ix1 (ixv k) (pex-exch-1 sk (ixv k))
pex-exch-v sk k (ixv j) = λ X F G d → ddv-exch sk k j X F G d
pex-exch-v sk k (ixneg r) = pex-exch-sym sk (ixneg r) (ixv k) (pex-exch-neg sk r (ixv k) (pex-exch-sym sk (ixv k) r (pex-exch-v sk k r)))
pex-exch-v sk k (ixmeet r s) =
  pex-exch-sym sk (ixmeet r s) (ixv k) (pex-exch-meet sk r s (ixv k) (pex-exch-sym sk (ixv k) r (pex-exch-v sk k r)) (pex-exch-sym sk (ixv k) s (pex-exch-v sk k s)))
pex-exch-v sk k (ixjoin r s) =
  pex-exch-sym sk (ixjoin r s) (ixv k) (pex-exch-join sk r s (ixv k) (pex-exch-sym sk (ixv k) r (pex-exch-v sk k r)) (pex-exch-sym sk (ixv k) s (pex-exch-v sk k s)))
pex-exch : (sk : Lst Entry) (e e' : IEx) → PExchT sk e e'
pex-exch sk ix0 e' = pex-exch-0 sk e'
pex-exch sk ix1 e' = pex-exch-1 sk e'
pex-exch sk (ixv k) e' = pex-exch-v sk k e'
pex-exch sk (ixneg r) e' = pex-exch-neg sk r e' (pex-exch sk r e')
pex-exch sk (ixmeet r s) e' = pex-exch-meet sk r s e' (pex-exch sk r e') (pex-exch sk s e')
pex-exch sk (ixjoin r s) e' = pex-exch-join sk r s e' (pex-exch sk r e') (pex-exch sk s e')
