      (ieq-neg sk' (dnf-ix (subst-form sk' sk σ (fst l))) (subst-var sk' sk σ (fst l)) (ieq-path sk' (dnf-ix (subst-form sk' sk σ (fst l))) (subst-var sk' sk σ (fst l)) (sform-ix sk' sk σ (fst l)))))
    (snd l)
conj-subst-sound : (sk' sk : Lst Entry) (σ : CMap sk' sk) (c : Conj) → IEq sk' (dnf-ix (conj-subst sk' sk σ c)) (ixs sk' sk σ (conj-ix c))
conj-subst-sound sk' sk σ lnil = ieq-refl sk' ix1
conj-subst-sound sk' sk σ (lcons l ls) =
