subst-form : (sk' sk : Lst Entry) → CMap sk' sk → Word → DNF
subst-form sk' lnil σ k = dnf-zero
subst-form sk' (lcons (e-ty a) sk) σ k = if weq k #0 then dnf-zero else subst-form sk' sk σ (%wsub k #1)
subst-form sk' (lcons e-dim sk) σ k = if weq k #0 then snd σ else subst-form sk' sk (fst σ) (%wsub k #1)
sform-ix : (sk' sk : Lst Entry) (σ : CMap sk' sk) (k : Word) → Path IEx (dnf-ix (subst-form sk' sk σ k)) (subst-var sk' sk σ k)
sform-ix sk' lnil σ k = λ i → ix0
sform-ix sk' (lcons (e-ty a) sk) σ k =
  bool-elim (λ b → Path IEx (dnf-ix (if b then dnf-zero else subst-form sk' sk σ (%wsub k #1))) (if b then ix0 else subst-var sk' sk σ (%wsub k #1)))
    (λ i → ix0) (sform-ix sk' sk σ (%wsub k #1)) (weq k #0)
sform-ix sk' (lcons e-dim sk) σ k =
  bool-elim (λ b → Path IEx (dnf-ix (if b then snd σ else subst-form sk' sk (fst σ) (%wsub k #1))) (if b then dnf-ix (snd σ) else subst-var sk' sk (fst σ) (%wsub k #1)))
    (λ i → dnf-ix (snd σ)) (sform-ix sk' sk (fst σ) (%wsub k #1)) (weq k #0)
lit-subst : (sk' sk : Lst Entry) → CMap sk' sk → Lit → DNF
lit-subst sk' sk σ l = if snd l then subst-form sk' sk σ (fst l) else dnf-neg (subst-form sk' sk σ (fst l))
conj-subst : (sk' sk : Lst Entry) → CMap sk' sk → Conj → DNF
conj-subst sk' sk σ lnil = dnf-one
conj-subst sk' sk σ (lcons l ls) = dnf-meet (lit-subst sk' sk σ l) (conj-subst sk' sk σ ls)
dnf-subst : (sk' sk : Lst Entry) → CMap sk' sk → DNF → DNF
dnf-subst sk' sk σ lnil = dnf-zero
dnf-subst sk' sk σ (lcons c cs) = dnf-join (conj-subst sk' sk σ c) (dnf-subst sk' sk σ cs)
ieq-path : (sk : Lst Entry) (e e' : IEx) → Path IEx e e' → IEq sk e e'
ieq-path sk e e' p X F G d = λ i → papp-ex sk X F (p i) G d
ixs-conj-cons : (sk' sk : Lst Entry) (σ : CMap sk' sk) (l : Lit) (ls : Conj) → IEq sk' (ixs sk' sk σ (conj-ix (lcons l ls))) (ixmeet (ixs sk' sk σ (lit-ix l)) (ixs sk' sk σ (conj-ix ls)))
ixs-conj-cons sk' sk σ l lnil = ieq-sym sk' (ixmeet (ixs sk' sk σ (lit-ix l)) ix1) (ixs sk' sk σ (lit-ix l)) (law-unit-m-r sk' (ixs sk' sk σ (lit-ix l)))
ixs-conj-cons sk' sk σ l (lcons m ms) = ieq-refl sk' (ixmeet (ixs sk' sk σ (lit-ix l)) (ixs sk' sk σ (conj-ix-from m ms)))
ixs-dnf-cons : (sk' sk : Lst Entry) (σ : CMap sk' sk) (c : Conj) (cs : DNF) → IEq sk' (ixs sk' sk σ (dnf-ix (lcons c cs))) (ixjoin (ixs sk' sk σ (conj-ix c)) (ixs sk' sk σ (dnf-ix cs)))
ixs-dnf-cons sk' sk σ c lnil = ieq-sym sk' (ixjoin (ixs sk' sk σ (conj-ix c)) ix0) (ixs sk' sk σ (conj-ix c)) (law-unit-j-r sk' (ixs sk' sk σ (conj-ix c)))
ixs-dnf-cons sk' sk σ c (lcons d ds) = ieq-refl sk' (ixjoin (ixs sk' sk σ (conj-ix c)) (ixs sk' sk σ (dnf-ix-from d ds)))
lit-subst-sound : (sk' sk : Lst Entry) (σ : CMap sk' sk) (l : Lit) → IEq sk' (dnf-ix (lit-subst sk' sk σ l)) (ixs sk' sk σ (lit-ix l))
lit-subst-sound sk' sk σ l =
  bool-elim2 (λ b → IEq sk' (dnf-ix (if b then subst-form sk' sk σ (fst l) else dnf-neg (subst-form sk' sk σ (fst l)))) (ixs sk' sk σ (if b then ixv (fst l) else ixneg (ixv (fst l)))))
    (ieq-path sk' (dnf-ix (subst-form sk' sk σ (fst l))) (subst-var sk' sk σ (fst l)) (sform-ix sk' sk σ (fst l)))
    (ieq-trans sk' (dnf-ix (dnf-neg (subst-form sk' sk σ (fst l)))) (ixneg (dnf-ix (subst-form sk' sk σ (fst l)))) (ixneg (subst-var sk' sk σ (fst l)))
