ixo : Word → IEx → IEx
ixo o e = ixr (λ k → %wadd k o) e
ixo-s : (o : Word) (e : IEx) → Path IEx (ixr (λ k → %wsucc k) (ixo o e)) (ixo (%wsucc o) e)
ixo-s o ix0 = λ i → ix0
ixo-s o ix1 = λ i → ix1
ixo-s o (ixv k) = λ i → ixv (wadd-s k o (~ i))
ixo-s o (ixneg x) = λ i → ixneg (ixo-s o x i)
ixo-s o (ixmeet x y) = λ i → ixmeet (ixo-s o x i) (ixo-s o y i)
ixo-s o (ixjoin x y) = λ i → ixjoin (ixo-s o x i) (ixo-s o y i)
ixo-0 : (e : IEx) → Path IEx (ixo #0 e) e
ixo-0 ix0 = λ i → ix0
ixo-0 ix1 = λ i → ix1
ixo-0 (ixv k) = λ i → ixv (wadd-0 k i)
ixo-0 (ixneg x) = λ i → ixneg (ixo-0 x i)
ixo-0 (ixmeet x y) = λ i → ixmeet (ixo-0 x i) (ixo-0 y i)
ixo-0 (ixjoin x y) = λ i → ixjoin (ixo-0 x i) (ixo-0 y i)
