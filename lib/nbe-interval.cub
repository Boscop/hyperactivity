    (dnf-meet-sound sk' (lit-subst sk' sk σ l) (conj-subst sk' sk σ ls))
    (ieq-trans sk' (ixmeet (dnf-ix (lit-subst sk' sk σ l)) (dnf-ix (conj-subst sk' sk σ ls))) (ixmeet (ixs sk' sk σ (lit-ix l)) (ixs sk' sk σ (conj-ix ls))) (ixs sk' sk σ (conj-ix (lcons l ls)))
      (ieq-meet sk' (dnf-ix (lit-subst sk' sk σ l)) (ixs sk' sk σ (lit-ix l)) (dnf-ix (conj-subst sk' sk σ ls)) (ixs sk' sk σ (conj-ix ls)) (lit-subst-sound sk' sk σ l) (conj-subst-sound sk' sk σ ls))
      (ieq-sym sk' (ixs sk' sk σ (conj-ix (lcons l ls))) (ixmeet (ixs sk' sk σ (lit-ix l)) (ixs sk' sk σ (conj-ix ls))) (ixs-conj-cons sk' sk σ l ls)))
dnf-subst-sound : (sk' sk : Lst Entry) (σ : CMap sk' sk) (f : DNF) → IEq sk' (dnf-ix (dnf-subst sk' sk σ f)) (ixs sk' sk σ (dnf-ix f))
dnf-subst-sound sk' sk σ lnil = ieq-refl sk' ix0
dnf-subst-sound sk' sk σ (lcons c cs) =
