law-unit-m-l : (sk : Lst Entry) (r : IEx) → IEq sk (ixmeet ix1 r) r
law-unit-m-l sk r X F G d = law-unit-l-cn sk dmeet (λ Z H z q → fst (snd q)) r X F G d (λ i x y → y)
law-unit-j-l : (sk : Lst Entry) (r : IEx) → IEq sk (ixjoin ix0 r) r
law-unit-j-l sk r X F G d = law-unit-l-cn sk djoin (λ Z H z q → fst q) r X F G d (λ i x y → y)
law-zero-m-r : (sk : Lst Entry) (r : IEx) → IEq sk (ixmeet r ix0) ix0
