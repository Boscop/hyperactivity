#!build/cubical
-- lib/views.cub — the workflow's views (show, tree, order, open), computed from the graph's value
-- (workflow/hyperactivity.cub over lib/workflow.cub) and the store: its nodes are the language's
-- own namespace (`definitions Node`), a node's statement is the comment its written piece begins
-- with. `hyperactive` runs this program for those commands (lib/hyperactive.cub).
import "host.cub"
import "../workflow/hyperactivity.cub"

-- the nodes, each with the name it is defined by
v-all : List (List Word × Node)
v-all = definitions Node

-- a node's name; a name's node
v-id-in : Node → List (List Word × Node) → List Word
v-id-in n nil = nil
v-id-in n (cons e r) = if text-eq (name (snd e)) (name n) then fst e else v-id-in n r
v-id : Node → List Word
v-id n = v-id-in n v-all
v-ids : List Node → List (List Word)
v-ids ns = list-map v-id ns
v-sentence-in : List Word → List (List Word × Node) → List Word
v-sentence-in i nil = nil
v-sentence-in i (cons e r) = if h-eq i (fst e) then name (snd e) else v-sentence-in i r
v-sentence : List Word → List Word
v-sentence i = v-sentence-in i v-all
-- each node with the names of its parts, and with the names of the nodes it is a part of: computed once
v-table : List (List Word × List (List Word))
v-table = list-map (λ e → (fst e , v-ids (parts (snd e)))) v-all
v-look : List Word → List (List Word × List (List Word)) → List (List Word)
v-look i nil = nil
v-look i (cons e r) = if h-eq i (fst e) then snd e else v-look i r
v-parts : List Word → List (List Word)
v-parts i = v-look i v-table
v-known : List Word → Bool
v-known i = h-has i (list-map (λ e → fst e) v-all)
-- the nodes a node serves directly as a part, in the order defined
v-kids-of : List Word → List (List Word × List (List Word)) → List (List Word)
v-kids-of i nil = nil
v-kids-of i (cons e r) = if h-has i (snd e) then cons (fst e) (v-kids-of i r) else v-kids-of i r
v-kid-table : List (List Word × List (List Word))
v-kid-table = list-map (λ e → (fst e , v-kids-of (fst e) v-table)) v-table
v-kids : List Word → List (List Word)
v-kids i = v-look i v-kid-table

v-in-progress : List (List Word)
v-in-progress = v-ids in-progress
v-resolved : List (List Word)
v-resolved = v-ids (list-map (λ e → fst e) resolved)
v-leaf : List Word → Bool
v-leaf i = h-null (h-concat (v-kids i))

-- sets of names, closed under a step, within as many rounds as there are nodes
v-union : List (List Word) → List (List Word) → List (List Word)
v-union a b = h-dedupe (list-append a b)
v-step-all : (List Word → List (List Word)) → List (List Word) → List (List Word)
v-step-all f nil = nil
v-step-all f (cons x r) = list-append (f x) (v-step-all f r)
v-close-if : List (List Word) → List (List Word) → (List (List Word) → List (List Word)) → List (List Word)
v-close-if s t next = if weq (fromNat (list-length s)) (fromNat (list-length t)) then s else next t
v-close : Nat → (List Word → List (List Word)) → List (List Word) → List (List Word)
v-close zero f s = s
v-close (suc k) f s = v-close-if s (v-union s (v-step-all f s)) (v-close k f)
v-rounds : Nat
v-rounds = list-length v-all
-- every node under a node (not itself); the node and every node above it
v-under : List Word → List (List Word)
v-under i = v-close v-rounds v-kids (v-kids i)
v-ancestors : List Word → List (List Word)
v-ancestors i = v-close v-rounds v-parts (cons i nil)
v-filter : (List Word → Bool) → List (List Word) → List (List Word)
v-filter p nil = nil
v-filter p (cons x r) = if p x then cons x (v-filter p r) else v-filter p r
v-subset : List (List Word) → List (List Word) → Bool
v-subset nil b = true
v-subset (cons x r) b = andB (h-has x b) (v-subset r b)
-- the nodes, by name; the roots: the nodes part of nothing
v-names : List (List Word)
v-names = list-map (λ e → fst e) v-all
v-roots : List (List Word)
v-roots = v-filter (λ i → h-null (h-concat (v-parts i))) v-names
-- resolution (lib/workflow.cub): a node is resolved when witnessed, or when every one of its children
-- is; the resolved nodes are the least set closed under that rule, starting from the witnessed ones
v-holds : List (List Word) → List Word → Bool
v-holds s i = andB (h-not (v-leaf i)) (v-subset (v-kids i) s)
v-resolve : Nat → List (List Word) → List (List Word)
v-resolve zero s = s
v-resolve (suc k) s = v-close-if s (v-union s (v-filter (v-holds s) v-names)) (v-resolve k)
v-complete : List (List Word)
v-complete = v-resolve v-rounds v-resolved
v-done : List Word → Bool
v-done i = h-has i v-complete
-- the nodes still needed: an unresolved root, and every unresolved node serving a needed one; a leaf
-- is open work exactly when it is needed
v-needed : List (List Word)
v-needed = v-close v-rounds (λ i → v-filter (λ c → h-not (v-done c)) (v-kids i)) (v-filter (λ r → h-not (v-done r)) v-roots)
v-open-leaf : List Word → Bool
v-open-leaf x = andB (v-leaf x) (h-has x v-needed)

-- what waits on what: a node's after, and every leaf under (or at) what it names
v-after-of : List Word → List (Node × List Node) → List (List Word)
v-after-of i nil = nil
v-after-of i (cons e r) = if h-eq i (v-id (fst e)) then list-append (v-ids (snd e)) (v-after-of i r) else v-after-of i r
v-leaves-at : List Word → List (List Word)
v-leaves-at d = if v-done d then nil else v-filter v-open-leaf (cons d (v-under d))
v-waits-of : List Word → List (List Word)
v-waits-of x = h-dedupe (v-step-all v-leaves-at (v-step-all (λ m → v-after-of m after) (v-ancestors x)))
v-before-of : List Word → List (List Word)
v-before-of i = v-filter (λ m → h-has i (v-after-of m after)) (list-map (λ e → fst e) v-all)

-- a document as the reader knows it: its path, or a projection's name
v-doc : Document → List Word
v-doc (document-at p h) = p
v-doc (projection n t) = n
v-context-of : List Word → List (Node × List Document) → List (List Word)
v-context-of i nil = nil
v-context-of i (cons e r) = if h-eq i (v-id (fst e)) then list-append (list-map v-doc (snd e)) (v-context-of i r) else v-context-of i r

-- a node's statement: the comment its written piece begins with, its first line naming it
v-comment : List (List Word) → List (List Word)
v-comment nil = nil
v-comment (cons l r) = if h-prefix "--" l then cons (h-trim (h-drop "--" l)) (v-comment r) else nil
v-named : List Word → List (List Word) → List (List Word)
v-named i nil = nil
v-named i (cons l r) = if h-prefix (list-append i " (") l then cons l r else v-named i r
v-statement-of : List Word → Sum Unit (List Word) → List (List Word)
v-statement-of i (inl u) = nil
v-statement-of i (inr t) = v-named i (v-comment (h-split #10 t))
v-statement-read : List Word → List Word → Sum Unit (List Word) → Proc W (List (List Word))
v-statement-read st i (inl u) = ret nil
v-statement-read st i (inr h) = bind (h-read (list-append st (cons #47 (list-append h "/text")))) (λ t → ret (v-statement-of i t))
v-statement : List Word → List Word → Proc W (List (List Word))
v-statement st i =
  bind (h-read (list-append st (list-append "/written/" (h-hex i)))) (λ w → v-statement-read st i w)

-- words laid out in lines of at most 96 bytes, each indented by four spaces
v-words : List (List Word) → List (List Word)
v-words ls = h-nonempty (v-step-all (λ l → h-split #32 l) ls)
v-wrap : List Word → List (List Word) → List Word
v-wrap cur nil = if h-null cur then nil else list-append "    " (h-line cur)
v-wrap cur (cons w r) =
  if h-null cur then v-wrap w r else
  if wlt #96 (fromNat (plus (list-length cur) (suc (list-length w)))) then list-append "    " (list-append (h-line cur) (v-wrap w r))
  else v-wrap (list-append cur (cons #32 w)) r

-- show NODE
v-joined : List Word → List (List Word) → List Word
v-joined sep nil = nil
v-joined sep (cons x nil) = x
v-joined sep (cons x (cons y r)) = list-append x (list-append sep (v-joined sep (cons y r)))
v-rels : List Word → List Word
v-rels i = if h-null (h-concat (v-parts i)) then (if h-has i v-roots then "a root" else "-")
  else v-joined ", " (list-map (λ p → list-append "part of " p) (v-parts i))
v-state : List Word → List Word
v-state i = if h-has i v-in-progress then "in progress" else if v-done i then "resolved" else if v-open-leaf i then "pending" else "not needed: what it serves is resolved"
-- what witnesses a resolved node: its evidence, or (for a node with children) all of them resolved
v-witness-in : List Word → List (Node × List Word) → List Word
v-witness-in i nil = nil
v-witness-in i (cons e r) = if h-eq i (v-id (fst e)) then snd e else v-witness-in i r
v-witness : List Word → List Word
v-witness i = if h-has i v-resolved then list-append "  witness: " (v-witness-in i resolved) else "  witness: every one of its children resolved"
v-context-lines : List Word → List (List Word) → List Word
v-context-lines a nil = nil
v-context-lines a (cons m r) = list-append (h-concat (list-map (λ d → h-line (list-append "  essential context: " (list-append d (if h-eq m a then nil else list-append "  (from " (list-append m ")"))))) (v-context-of m essential-context))) (v-context-lines a r)
v-show-text : List Word → List (List Word) → List Word
v-show-text i stmt =
  list-append (h-line (list-append i (list-append "  " (v-rels i))))
  (list-append (h-line (list-append "  " (v-sentence i)))
  (list-append (if v-leaf i then h-line (list-append "  state: " (v-state i)) else list-append (h-line (list-append "  served by: " (v-joined " " (v-kids i)))) (if v-done i then h-line "  state: resolved" else nil))
  (list-append (if v-done i then h-line (v-witness i) else nil)
  (list-append (v-context-lines i (v-ancestors i))
  (list-append (if h-null (h-concat (v-after-of i after)) then nil else h-line (list-append "  after: " (v-joined " " (v-after-of i after))))
  (list-append (if h-null (h-concat (v-before-of i)) then nil else h-line (list-append "  before: " (v-joined " " (v-before-of i))))
  (list-append (if h-null (h-concat stmt) then h-line "  (no statement)" else v-wrap nil (v-words stmt)) (cons #10 nil))))))))
v-show : List Word → List Word → Proc W Unit
v-show st i = if v-known i then bind (v-statement st i) (λ s → h-out (v-show-text i s))
  else h-out (h-line (list-append i ": no such node"))
v-show-all : List Word → List (List Word) → Proc W Unit
v-show-all st nil = ret unit
v-show-all st (cons i r) = bind (v-show st i) (λ u → v-show-all st r)

-- tree: each node under the one it names first as its part, from the roots
v-indent : Nat → List Word
v-indent zero = nil
v-indent (suc k) = list-append "  " (v-indent k)
v-also : List Word → List Word → List (List Word)
v-also n via = v-filter (λ p → h-not (h-eq p via)) (v-parts n)
v-tree-line : Nat → List Word → List Word → List Word
v-tree-line d via n =
  list-append (v-indent d) (list-append (v-sentence n) (list-append "  [" (list-append n
  (list-append (if v-leaf n then (if h-has n v-in-progress then ", in progress]" else if v-done n then ", resolved]" else if v-open-leaf n then "]" else ", not needed]")
               else if v-done n then ", resolved]" else list-append "; " (list-append (h-decimal (fromNat (list-length (v-filter v-open-leaf (v-under n))))) " open tasks under it]"))
  (h-line (if andB (h-not (h-null via)) (h-not (h-null (h-concat (v-also n via))))
           then list-append "  (also " (list-append (v-joined ", " (v-also n via)) ")") else nil))))))
v-head : List (List Word) → List Word
v-head nil = nil
v-head (cons x r) = x
v-first-part : List Word → List Word
v-first-part n = v-head (v-parts n)
v-tree-from : Nat → Nat → List Word → List Word → List Word
v-tree-from zero d via n = nil
v-tree-from (suc k) d via n = list-append (v-tree-line d via n)
  (h-concat (list-map (λ c → v-tree-from k (suc d) n c) (v-filter (λ c → h-eq (v-first-part c) n) (v-kids n))))
v-tree : List Word
v-tree = h-concat (list-map (λ r → v-tree-from v-rounds zero nil r) v-roots)

-- order: the leaves that can start now in layers (a leaf supersedes those below it), then the waiting
v-leaves : List (List Word)
v-leaves = v-filter v-open-leaf (list-map (λ e → fst e) v-all)
v-waits-table : List (List Word × List (List Word))
v-waits-table = list-map (λ x → (x , v-waits-of x)) v-leaves
v-waits : List Word → List (List Word)
v-waits x = v-look x v-waits-table
v-ready : List (List Word)
v-ready = v-filter (λ x → h-null (h-concat (v-waits x))) v-leaves
v-gain-of : List Word → List (List Word)
v-gain-of x = v-filter (λ y → h-has x (v-waits y)) v-leaves
v-gain-table : List (List Word × List (List Word))
v-gain-table = list-map (λ x → (x , v-gain-of x)) v-ready
v-gain : List Word → List (List Word)
v-gain x = v-look x v-gain-table
v-strictly-in : List (List Word) → List (List Word) → Bool
v-strictly-in a b = andB (v-subset a b) (h-not (v-subset b a))
v-top : List (List Word) → List (List Word)
v-top rem = v-filter (λ x → h-null (h-concat (v-filter (λ y → v-strictly-in (v-gain x) (v-gain y)) rem))) rem
v-line : List Word → List Word
v-line n = h-line (list-append "  " (list-append (v-sentence n) (list-append "  [" (list-append n "]"))))
v-gain-line : List Word → List Word
v-gain-line x = if h-null (h-concat (v-gain x)) then nil else h-line (list-append "        a prerequisite of: " (v-joined " " (h-sort (v-gain x))))
v-layers : Nat → Nat → List (List Word) → List Word
v-layers zero k rem = nil
v-layers (suc f) k rem = if h-null (h-concat rem) then nil else
  list-append (h-line (list-append " layer " (list-append (h-decimal (fromNat (suc k))) (if h-null (h-concat (v-step-all v-gain (v-top rem))) then " (a prerequisite of nothing that waits)" else nil))))
  (list-append (h-concat (list-map (λ x → list-append (v-line x) (v-gain-line x)) (v-top rem)))
  (v-layers f (suc k) (v-filter (λ x → h-not (h-has x (v-top rem))) rem)))
v-waiting : List Word
v-waiting = if h-null (h-concat (v-filter (λ x → h-not (h-null (h-concat (v-waits x)))) v-leaves)) then nil else
  list-append (h-line "waiting:") (h-concat (list-map (λ x → list-append (v-line x) (h-line (list-append "        waits on: " (v-joined " " (h-sort (v-waits x))))))
    (v-filter (λ x → h-not (h-null (h-concat (v-waits x)))) v-leaves)))
v-order : List Word
v-order = list-append (h-line "can start now, in layers (a leaf supersedes the layers below it):") (list-append (v-layers v-rounds zero v-ready) v-waiting)
-- open: what is in progress, then the first layer
v-open : List Word → Proc W Unit
v-open st = bind (if h-null (h-concat v-in-progress) then ret {lzero} {W} unit else bind (h-out (h-line (h-line "In progress:"))) (λ u → v-show-all st v-in-progress)) (λ u →
  h-out (list-append (h-line "Can start now and unblocks the most:") (h-concat (list-map (λ x → list-append (v-line x) (v-gain-line x)) (v-top v-ready)))))

-- check: the graph's rules (“The Hyperactive Workflow”): every node's name is a sentence; every node
-- has a statement; what is in progress is a leaf, and not also resolved; an unresolved node is
-- expanded exactly when something under it is in progress or resolved
v-rule : Bool → List Word → List Word → List (List Word)
v-rule bad i why = if bad then cons (list-append i (list-append ": " why)) nil else nil
v-node-problems : List Word → List (List Word)
v-node-problems i =
  list-append (v-rule (orB (h-not (h-infix " " (v-sentence i))) (h-eq (v-sentence i) i)) i "its name must be an English sentence saying what it is, not an identifier")
  (list-append (v-rule (andB (h-has i v-in-progress) (h-not (v-leaf i))) i "in progress but has children (work in progress is a leaf; a node is expanded when a child begins)")
  (list-append (v-rule (andB (h-has i v-in-progress) (h-has i v-resolved)) i "both in progress and resolved")
  (v-rule (andB (andB (andB (h-not (v-leaf i)) (h-not (h-has i v-roots))) (h-not (v-done i))) (h-null (h-concat (v-filter (λ x → orB (h-has x v-in-progress) (h-has x v-resolved)) (v-under i))))) i
    "expanded, but nothing under it is in progress or resolved (a node is expanded exactly when a child begins)")))
v-graph-problems : List (List Word)
v-graph-problems = v-step-all v-node-problems v-names
v-statement-problems : List Word → List (List Word) → Proc W (List (List Word))
v-statement-problems st nil = ret nil
v-statement-problems st (cons i r) = bind (v-statement st i) (λ s → bind (v-statement-problems st r) (λ rest →
  ret (list-append (v-rule (h-null (h-concat s)) i "no statement") rest)))
v-lines : List (List Word) → List Word
v-lines ps = h-concat (list-map h-line ps)
v-summary : List (List Word) → List Word
v-summary ps = h-line (list-append (h-decimal (fromNat v-rounds)) (if h-null (h-concat ps) then " nodes; consistent" else list-append " nodes; " (list-append (h-decimal (fromNat (list-length ps))) " problem(s)")))
-- the graph's problems kept: views/problems, each problem a line (none when the graph keeps every
-- rule), and views/check, the problems and the summary
v-keep-check : List Word → List (List Word) → Proc W Bool
v-keep-check st ps = bind (h-write (list-append st "/views/problems") (v-lines ps)) (λ b →
  h-write (list-append st "/views/check") (list-append (v-lines ps) (v-summary ps)))
-- the graph as JSON, for the page that draws it (lib/server.cub, tools/workflow-view.html): each
-- node with its sentence, its parents, its statement and the findings it records (Known …), the
-- questions it puts to Avik, its state in the order of work (first, ready, last, waiting, goal,
-- resolved), its layer, what it unblocks and waits on, its essential context, and its open tasks
j-hex : Word → Word
j-hex d = if wlt d #10 then wadd d #48 else wadd d #87
j-esc : List Word → List Word
j-esc nil = nil
j-esc (cons x r) =
  if weq x #34 then cons #92 (cons #34 (j-esc r)) else
  if weq x #92 then cons #92 (cons #92 (j-esc r)) else
  if wlt x #32 then list-append "\u00" (cons (j-hex (wshr x #4)) (cons (j-hex (wand x #15)) (j-esc r))) else cons x (j-esc r)
j-str : List Word → List Word
j-str s = cons #34 (list-append (j-esc s) (cons #34 nil))
j-arr : List (List Word) → List Word
j-arr xs = list-append "[" (list-append (v-joined "," xs) "]")
j-strs : List (List Word) → List Word
j-strs xs = j-arr (list-map j-str xs)
j-field : List Word → List Word → List Word
j-field k v = list-append (j-str k) (list-append ":" v)
j-obj : List (List Word) → List Word
j-obj fs = list-append "{" (list-append (v-joined "," fs) "}")
-- the statement as one line, without its opening name (…): and split at each Known (date…
v-stmt-line : List (List Word) → List Word
v-stmt-line ls = v-joined " " (list-map (λ l → h-rev (h-trim (h-rev l nil)) nil) ls)
v-after-paren : List Word → List Word
v-after-paren nil = nil
v-after-paren (cons x r) = if weq x #41 then h-trim (h-drop ":" r) else v-after-paren r
v-unprefixed : List Word → List Word → List Word
v-unprefixed i s = if andB (h-prefix (list-append i " (") s) (h-infix "):" s) then v-after-paren s else s
v-digits : List Word → Bool
v-digits nil = true
v-digits (cons x r) = andB (andB (wlt #47 x) (wlt x #58)) (v-digits r)
v-known-at : List Word → Bool
v-known-at s = andB (h-prefix " Known (" s) (andB (v-digits (h-take (toNat #4) (h-drop " Known (" s))) (orB (h-prefix "," (h-drop-n (toNat #18) s)) (h-prefix ")" (h-drop-n (toNat #18) s))))
v-split-known : List Word → List Word → List (List Word)
v-split-known cur nil = cons (h-rev cur nil) nil
v-split-known cur (cons x r) = if v-known-at (cons x r) then cons (h-rev cur nil) (v-split-known nil r) else v-split-known (cons x cur) r
-- Question for Avik (date): …?
h-drop-to-paren : List Word → List Word
h-drop-to-paren nil = nil
h-drop-to-paren (cons x r) = if weq x #41 then cons x r else h-drop-to-paren r
v-to-question : List Word → List Word
v-to-question nil = nil
v-to-question (cons x r) = if weq x #63 then cons x nil else cons x (v-to-question r)
v-questions : List Word → List (List Word)
v-questions nil = nil
v-questions (cons x r) = if andB (h-prefix "Question for Avik (" (cons x r)) (h-infix "):" (h-take (toNat #34) (cons x r)))
  then cons (v-to-question (h-trim (h-drop "):" (h-drop-to-paren (cons x r))))) (v-questions r) else v-questions r
-- the layers of the order of work, as lists of names
v-layer-list : Nat → List (List Word) → List (List (List Word))
v-layer-list zero rem = nil
v-layer-list (suc f) rem = if h-null (h-concat rem) then nil else cons (v-top rem) (v-layer-list f (v-filter (λ x → h-not (h-has x (v-top rem))) rem))
v-layers-all : List (List (List Word))
v-layers-all = v-layer-list v-rounds v-ready
v-layer-of : List Word → Nat → List (List (List Word)) → Sum Unit Nat
v-layer-of x k nil = inl unit
v-layer-of x k (cons l r) = if h-has x l then inr (suc k) else v-layer-of x (suc k) r
v-state-of : List Word → Sum Unit Nat → List Word
v-state-of n (inr k) = if andB (weq (fromNat k) #1) (h-not (h-null (h-concat (v-gain n)))) then "first" else if h-null (h-concat (v-gain n)) then "last" else "ready"
v-state-of n (inl u) = if andB (v-open-leaf n) (h-not (h-null (h-concat (v-waits n)))) then "waiting" else "goal"
v-json-layer : Sum Unit Nat → List Word
v-json-layer (inl u) = "null"
v-json-layer (inr k) = h-decimal (fromNat k)
v-progress : List Word → List Word
v-progress n = if h-has n v-in-progress then j-str "in progress" else if v-done n then j-str "resolved" else if v-leaf n then j-str "pending" else "null"
v-ancestor-count : List Word → Nat
v-ancestor-count m = list-length (v-ancestors m)
v-insert-depth : List Word → List (List Word) → List (List Word)
v-insert-depth x nil = cons x nil
v-insert-depth x (cons y r) = if wlt (fromNat (v-ancestor-count y)) (fromNat (v-ancestor-count x)) then cons y (v-insert-depth x r) else cons x (cons y r)
v-by-depth : List (List Word) → List (List Word)
v-by-depth nil = nil
v-by-depth (cons x r) = v-insert-depth x (v-by-depth r)
v-json-context : List Word → List Word
v-json-context n = j-arr (h-concat-lists (list-map (λ m → list-map (λ d → j-obj (cons (j-field "path" (j-str d)) (cons (j-field "via" (if h-eq m n then "null" else j-str m)) nil))) (v-context-of m essential-context)) (v-by-depth (v-ancestors n))))
v-json-node : List Word → List (List Word) → List Word
v-json-node n stmt = j-obj
  (cons (j-field "id" (j-str n)) (cons (j-field "name" (j-str (v-sentence n)))
  (cons (j-field "questions" (j-strs (v-questions (v-unprefixed n (v-stmt-line stmt)))))
  (cons (j-field "parents" (j-strs (v-parts n)))
  (cons (j-field "statement" (j-str (h-trim (v-head (v-split-known nil (v-unprefixed n (v-stmt-line stmt)))))))
  (cons (j-field "findings" (j-strs (list-map h-trim (h-tail-lists (v-split-known nil (v-unprefixed n (v-stmt-line stmt)))))))
  (cons (j-field "parts" "[]")
  (cons (j-field "state" (j-str (if v-done n then "resolved" else v-state-of n (v-layer-of n zero v-layers-all))))
  (cons (j-field "progress" (v-progress n))
  (cons (j-field "layer" (v-json-layer (v-layer-of n zero v-layers-all)))
  (cons (j-field "unblocks" (j-strs (if h-has n v-ready then h-sort (v-gain n) else nil)))
  (cons (j-field "waits" (j-strs (if v-open-leaf n then h-sort (v-waits n) else nil)))
  (cons (j-field "after" (j-strs (v-after-of n after)))
  (cons (j-field "context" (v-json-context n))
  (cons (j-field "open" (h-decimal (fromNat (list-length (v-filter v-open-leaf (v-under n)))))) nil)))))))))))))))
v-json-nodes : List Word → List (List Word) → Proc W (List (List Word))
v-json-nodes st nil = ret nil
v-json-nodes st (cons i r) = bind (v-statement st i) (λ s → bind (v-json-nodes st r) (λ rest → ret (cons (v-json-node i s) rest)))
v-json : List Word → Proc W (List Word)
v-json st = bind (v-json-nodes st (list-map (λ e → fst e) v-all)) (λ ns → ret (j-obj (cons (j-field "nodes" (j-arr ns)) (cons (j-field "roots" (j-strs v-roots)) nil))))

-- the views kept: computed once from the graph's value and kept in the store (views/), stamped with
-- (views/nodes: each node's name and the names of what it is a part of; views/roots: the roots)
-- the latest change under the repository (views/stamp); lib/hyperactive.cub serves them from there and
-- runs this program when the stamp has moved
v-show-texts : List Word → List (List Word) → Proc W (List (List Word × List Word))
v-show-texts st nil = ret nil
v-show-texts st (cons i r) = bind (v-statement st i) (λ s → bind (v-show-texts st r) (λ rest → ret (cons (i , v-show-text i s) rest)))
v-show-of : List Word → List (List Word × List Word) → List Word
v-show-of i nil = nil
v-show-of i (cons e r) = if h-eq i (fst e) then snd e else v-show-of i r
v-open-text : List (List Word × List Word) → List Word
v-open-text shows =
  list-append (if h-null (h-concat v-in-progress) then nil else list-append (h-line (h-line "In progress:")) (h-concat (list-map (λ i → v-show-of i shows) v-in-progress)))
  (list-append (h-line "Can start now and unblocks the most:") (h-concat (list-map (λ x → list-append (v-line x) (v-gain-line x)) (v-top v-ready))))
v-keep-shows : List Word → List (List Word × List Word) → Proc W Unit
v-keep-shows dir nil = ret unit
v-keep-shows dir (cons e r) = bind (h-write (list-append dir (list-append "show-" (h-hex (fst e)))) (snd e)) (λ b → v-keep-shows dir r)
v-keep : List Word → Proc W Unit
v-keep st =
  bind (h-mkdir st) (λ u → bind (h-mkdir (list-append st "/views")) (λ u2 →
  bind (v-show-texts st (list-map (λ e → fst e) v-all)) (λ shows →
  bind (v-keep-shows (list-append st "/views/") shows) (λ u3 →
  bind (v-statement-problems st (list-map (λ e → fst e) v-all)) (λ sp →
  bind (v-keep-check st (list-append v-graph-problems sp)) (λ b1 →
  bind (h-write (list-append st "/views/nodes") (h-concat (list-map (λ e → h-line (v-joined " " (cons (fst e) (v-parts (fst e))))) v-all))) (λ b6 →
  bind (h-write (list-append st "/views/roots") (h-concat (list-map h-line v-roots))) (λ b7 →
  bind (v-json st) (λ js → bind (h-write (list-append st "/views/graph.json") js) (λ b8 →
  bind (h-write (list-append st "/views/tree") v-tree) (λ b2 →
  bind (h-write (list-append st "/views/order") v-order) (λ b3 →
  bind (h-write (list-append st "/views/open") (v-open-text shows)) (λ b4 →
  exit #0)))))))))))))
v-main : Proc W Unit
v-main = bind (h-env "CUBICAL_STORE") (λ e → v-keep (h-store-of e))
-- v-run: keeps the views of the workflow in the store (part of product-implementation)
v-run : Step W Unit
v-run = to-step v-main
#run v-run
