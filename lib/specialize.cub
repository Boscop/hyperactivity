-- lib/specialize.cub — the specializer's pipeline on codes (plan 18.6), the steps that exist today.
-- Loaded after lib/check.cub, lib/match.cub, lib/fo.cub and lib/lower.cub.
-- specialize T rules c: the code c (closed, at type T) is normalized by the machine (eval, then
-- quote at T: step 2), rewritten along the rules until none applies (step 3, bounded), and
-- lowered to the first-order form (step 6). Steps 4 (usage), 5 (the criterion) and 7 (the
-- proof) follow B11, B13 and the proof lemmas of 18.5; today the result is checked by
-- evaluating the first-order form and comparing with the normal form (the readings below).
-- The rewrite bound is the terminating discipline's crude form (a count); the ordered form
-- (18.6) replaces it.
normalize T c = fromopt (quote-top T (eval-g lnil c)) c
rewrite-all n rules c =
  if %weq n #0 then c
  else (case first-applicable rules c of
          none → c
          some c2 → rewrite-all (%wsub n #1) rules c2)
first-applicable rules c =
  case rules of
    lnil → none
    lcons r rest → (case rewrite-first r c of some c2 → some c2; none → first-applicable rest c)
specialize T rules c = lower (rewrite-all #64 rules (normalize T c))
-- the specialized form evaluated, as a word (for readings over word-valued programs)
run-fo f = wof (eval-fo (λ g → flit #0) lnil f)
-- ---------------------------------------------------------------- readings
-- a closed word computation: normalization does the whole job; the form is a literal
c1 = cwop #2 (cwlit #3) (cwlit #4)
#same specialize Word lnil c1 = flit #7
-- a function applied to a known argument, specialized to the result
c2 = capp (clam (cwop #2 (cvar #0) (cwlit #10))) (cwlit #5)
#same specialize Word lnil c2 = flit #15
-- an open function: its body survives as a λ over a primitive; the environment supplies the
-- argument at run time (stage "run")
c3 = clam (cwop #2 (cvar #0) (cwlit #1))
#same specialize (Word → Word) lnil c3 = flam (fprim P-add (lcons (fvar #0) (lcons (flit #1) lnil)))
#same run-fo (fapply (specialize (Word → Word) lnil c3) (lcons (flit #41) lnil)) = #42
-- word elimination with a known bound normalizes away entirely: 2^5 is a literal
c4 = cwelim (cwlit #5) (cwlit #1) (clam (clam (cwop #2 (cvar #0) (cvar #0))))
#same specialize Word lnil c4 = flit #32
-- with an unknown bound it stays a loop, and the loop computes
c5 = clam (cwelim (cvar #0) (cwlit #1) (clam (clam (cwop #2 (cvar #0) (cvar #0)))))
#same run-fo (fapply (specialize (Word → Word) lnil c5) (lcons (flit #6) lnil)) = #64
