#!build/cubical
-- lib/hyperactive.cub — the command `hyperactive` (./hyperactive is a link to this file; its first
-- line has the machine run it). Avik, 2026-11-15: "HYPERACTIVE MUST BE ENTIRELY BOOTSTRAPPED
-- ENTIRELY LEVERAGE HYPERACTIVE LITERALLY NOTHING BUT THE CORE C IMPLEMENTATION". Code is reached
-- by name through the store, never by file: a name points to its written piece (the declaration
-- with its statement) and to its checked key; what uses a name is what the checker found mentions it.
import "host.cub"

hy-get : List Word → List Word → Proc W (Sum Unit (List Word))
hy-get st rel = h-read (list-append st (cons #47 rel))
hy-or : List Word → Sum Unit (List Word) → List Word
hy-or d (inl u) = d
hy-or d (inr t) = t
hy-same-nat : Nat → Nat → Bool
hy-same-nat a b = weq (fromNat a) (fromNat b)
hy-head : List (List Word) → List Word
hy-head nil = nil
hy-head (cons x r) = x
hy-sep : List Word → List (List Word) → List Word
hy-sep s nil = nil
hy-sep s (cons x nil) = x
hy-sep s (cons x (cons y r)) = list-append x (list-append s (hy-sep s (cons y r)))

-- def NAME …: each definition's written piece, its key, and the definitions that use it
hy-key-label : Sum Unit (List Word) → List Word
hy-key-label (inl u) = "not yet checked"
hy-key-label (inr k) = list-append "key " (h-take (toNat #12) k)
hy-cons-if : Bool → List Word → List (List Word) → List (List Word)
hy-cons-if b x r = if b then cons x r else r
hy-still-uses : List Word → List Word → List (List Word) → Proc W (List (List Word))
hy-still-uses st name nil = ret nil
hy-still-uses st name (cons u r) =
  bind (hy-get st (list-append "deps/" (h-hex u))) (λ d → bind (hy-still-uses st name r) (λ rest →
  ret (hy-cons-if (h-has name (h-lines (hy-or nil d))) u rest)))
hy-used-by : List (List Word) → List Word
hy-used-by nil = h-line "used by no definition"
hy-used-by (cons u r) = list-append (h-line "used by:") (h-indented "  " (cons u r))
hy-def-users : List Word → List Word → Proc W Unit
hy-def-users st name =
  bind (hy-get st (list-append "users/" (h-hex name))) (λ us →
  bind (hy-still-uses st name (h-dedupe (h-lines (hy-or nil us)))) (λ live →
  h-out (list-append (hy-used-by (h-sort live)) (cons #10 nil))))
hy-def-piece : List Word → List Word → Sum Unit (List Word) → Proc W Unit
hy-def-piece st name (inl u) = h-fail (list-append "hyperactive: the store has lost the written piece of " name)
hy-def-piece st name (inr text) =
  bind (hy-get st (list-append "bound/" (h-hex name))) (λ k →
  bind (h-out (list-append name (list-append "   (" (list-append (hy-key-label k) (list-append (h-line (h-line ")")) (h-line text)))))) (λ u →
  hy-def-users st name))
hy-def-written : List Word → List Word → Sum Unit (List Word) → Proc W Unit
hy-def-written st name (inl u) = h-fail (list-append "hyperactive: no definition named " name)
hy-def-written st name (inr h) = bind (hy-get st (list-append h "/text")) (hy-def-piece st name)
hy-def : List Word → List (List Word) → Proc W Unit
hy-def st nil = ret unit
hy-def st (cons name r) = bind (hy-get st (list-append "written/" (h-hex name))) (λ w →
  bind (hy-def-written st name w) (λ u → hy-def st r))


-- write NAME [after OTHER], the declaration (its statement and its code) on standard input: it takes
-- the place of NAME's written piece, or, NAME being new, follows OTHER's. Every file the change
-- touches is checked by the machine as it was last loaded (roots/ in the store: the file given to the
-- machine that loads it), the file holding NAME and the files holding what uses NAME; the change is
-- kept only if no definition fails that did not fail before and the machine reads the text given,
-- exactly, as NAME's piece. Otherwise the file is put back. remove NAME takes a piece away the same way,
-- when nothing uses it.
hy-module-of-in : List Word → List Word → List (List Word) → Proc W (Sum Unit (List Word × List (List Word)))
hy-module-of-in st h nil = ret (inl unit)
hy-module-of-in st h (cons hx r) = bind (hy-get st (list-append "modules/" hx)) (λ mh →
  bind (hy-get st (list-append (hy-or nil mh) "/module")) (λ m →
  if h-has h (h-lines (hy-or nil m)) then ret {lzero} {W} (inr (hx , h-lines (hy-or nil m))) else hy-module-of-in st h r))
hy-module-of : List Word → List Word → Proc W (Sum Unit (List Word × List (List Word)))
hy-module-of st h = bind (h-list (list-append st "/modules")) (hy-module-of-in st h)
-- a file as its pieces render it: with the piece h replaced by t, or followed by t
hy-render : List Word → List (List Word) → List Word → List Word → Bool → Proc W (List Word)
hy-render st nil h t after = ret nil
hy-render st (cons p r) h t after = bind (hy-get st (list-append p "/text")) (λ x → bind (hy-render st r h t after) (λ rest →
  ret (list-append (if h-eq p h then (if after then list-append (hy-or nil x) t else t) else hy-or nil x) rest)))
-- the machine's verdict on a file it is given: whether it read to the end, and the names that fail
hy-fail-name : List Word → List Word
hy-fail-name l = h-before "   " (h-drop "FAIL: checks " l)
hy-fails : List (List Word) → List (List Word)
hy-fails nil = nil
hy-fails (cons l r) = if h-prefix "FAIL: " l then cons (hy-fail-name l) (hy-fails r) else hy-fails r
hy-complete : List (List Word) → Bool
hy-complete nil = false
hy-complete (cons l r) = if h-infix " passed, " l then true else hy-complete r
-- the verdict on a file, kept in the store (verdicts/<file>: the stamp of the latest change under
-- the repository when it was given, whether the machine read to the end, the names that failed), so
-- a file nothing has changed since is not given to the machine again
hy-verdict-run : List Word → List Word → List Word → Word → Proc W (Bool × List (List Word))
hy-verdict-run st m root stamp = bind (h-capture (cons m (cons "--read" (cons root nil)))) (λ r →
  bind (h-mkdir (list-append st "/verdicts")) (λ u →
  bind (h-write (list-append st (list-append "/verdicts/" (h-hex root))) (h-concat (list-map h-line (cons (h-decimal stamp) (cons (if hy-complete (h-lines (snd r)) then "1" else "0") (hy-fails (h-lines (snd r)))))))) (λ b →
  ret (hy-complete (h-lines (snd r)) , hy-fails (h-lines (snd r))))))
hy-verdict-kept : List Word → List Word → List Word → Word → List (List Word) → Proc W (Bool × List (List Word))
hy-verdict-kept st m root stamp (cons s (cons c fs)) = if h-eq s (h-decimal stamp) then ret {lzero} {W} (h-eq c "1" , fs) else hy-verdict-run st m root stamp
hy-verdict-kept st m root stamp ls = hy-verdict-run st m root stamp
hy-verdict : List Word → List Word → List Word → Proc W (Bool × List (List Word))
hy-verdict st m root = bind (h-dir-time (toNat #12) ".") (λ stamp →
  bind (hy-get st (list-append "verdicts/" (h-hex root))) (λ k → hy-verdict-kept st m root stamp (h-split #10 (hy-or nil k))))
hy-verdicts : List Word → List Word → List (List Word) → Proc W (List (Bool × List (List Word)))
hy-verdicts st m nil = ret nil
hy-verdicts st m (cons r rs) = bind (hy-verdict st m r) (λ v → bind (hy-verdicts st m rs) (λ vs → ret (cons v vs)))
-- what is wrong after a change, against before it: runs that did not end, and new failures
hy-subset : List (List Word) → List (List Word) → List (List Word)
hy-subset nil b = nil
hy-subset (cons x r) b = if h-has x b then hy-subset r b else cons x (hy-subset r b)
hy-wrong : List (Bool × List (List Word)) → List (Bool × List (List Word)) → List (List Word)
hy-wrong nil a = nil
hy-wrong (cons b bs) nil = nil
hy-wrong (cons b bs) (cons a as) = list-append (if fst a then hy-subset (snd a) (snd b) else cons "(the machine did not read to the end)" nil) (hy-wrong bs as)
-- the files to give the machine: the one loading the file changed, and those loading what uses the name
hy-root-of : List Word → List Word → Proc W (List Word)
hy-root-of st hx = bind (hy-get st (list-append "roots/" hx)) (λ r → ret (hy-or (h-unhex hx) r))
hy-user-root : List Word → Sum Unit (List Word × List (List Word)) → Proc W (List (List Word))
hy-user-root st (inl u) = ret nil
hy-user-root st (inr m) = bind (hy-root-of st (fst m)) (λ r → ret (cons r nil))
hy-user-roots : List Word → List (List Word) → Proc W (List (List Word))
hy-user-roots st nil = ret nil
hy-user-roots st (cons u r) = bind (hy-get st (list-append "written/" (h-hex u))) (λ w →
  bind (hy-module-of st (hy-or nil w)) (λ mo → bind (hy-user-root st mo) (λ ur → bind (hy-user-roots st r) (λ rest → ret (list-append ur rest)))))
hy-live-users : List Word → List Word → Proc W (List (List Word))
hy-live-users st name = bind (hy-get st (list-append "users/" (h-hex name))) (λ us → hy-still-uses st name (h-dedupe (h-lines (hy-or nil us))))
-- text ending in a newline
hy-nl : List Word → List Word
hy-nl t = if h-ends (cons #10 nil) t then t else h-line t
hy-piece-of : List Word → List Word → Proc W (List Word)
hy-piece-of st name = bind (hy-get st (list-append "written/" (h-hex name))) (λ w →
  bind (hy-get st (list-append (hy-or nil w) "/text")) (λ t → ret (hy-or nil t)))
hy-read-back : Bool → List Word → List Word → List Word → List (List Word)
hy-read-back removing name piece expect = if removing then nil else if h-eq piece expect then nil
  else cons (list-append "the machine does not read the text given as the piece of " (list-append name ": it is not one whole declaration of that name, with its statement")) nil
-- the change made, checked, and kept or put back
hy-keep : List Word → List Word → List Word → List Word → List Word → List (List Word) → Bool → List (List Word) → Proc W Unit
hy-keep st m name path old roots removing nil =
  if removing then bind (h-unlink (list-append st (list-append "/written/" (h-hex name)))) (λ u →
    bind (h-unlink (list-append st (list-append "/bound/" (h-hex name)))) (λ u2 → h-out (h-line (list-append "removed " name))))
  else bind (hy-get st (list-append "bound/" (h-hex name))) (λ k → h-out (h-line (list-append name (list-append "   (" (list-append (hy-key-label k) ")")))))
hy-keep st m name path old roots removing (cons p ps) =
  bind (h-write path old) (λ w → bind (hy-verdicts st m roots) (λ v →
  bind (h-say (list-append (h-line "nothing written: it does not check") (h-indented "  " (cons p ps)))) (λ u → exit #1)))
hy-change : List Word → List Word → List Word → List Word → List Word → List Word → List Word → List (List Word) → Bool → Proc W Unit
hy-change st m name expect path old new roots removing =
  bind (hy-verdicts st m roots) (λ before →
  bind (h-write path new) (λ w1 →
  bind (hy-verdicts st m roots) (λ after →
  bind (hy-piece-of st name) (λ piece →
  hy-keep st m name path old roots removing (list-append (hy-wrong before after) (hy-read-back removing name piece expect))))))
-- write: the piece found, its file rendered with the change, the change checked
hy-write-at : List Word → List Word → List Word → List Word → Bool → List Word → Sum Unit (List Word × List (List Word)) → Proc W Unit
hy-write-at st m name h after t (inl u) = h-fail (list-append "hyperactive: no file holds the piece of " name)
hy-write-at st m name h after t (inr mo) =
  bind (h-read (h-unhex (fst mo))) (λ cur →
  bind (hy-render st (snd mo) nil nil false) (λ was →
  if h-eq (hy-or nil cur) was then
    bind (hy-render st (snd mo) h t after) (λ new →
    bind (hy-root-of st (fst mo)) (λ root →
    bind (hy-live-users st name) (λ us → bind (hy-user-roots st us) (λ urs →
    hy-change st m name t (h-unhex (fst mo)) was new (h-dedupe (cons root urs)) false))))
  else h-fail (list-append (h-unhex (fst mo)) " has changed since the machine last read it; give it to the machine (hyperactive check) first")))
hy-write-new : List Word → List Word → List Word → List Word → List Word → Sum Unit (List Word) → Proc W Unit
hy-write-new st m name other t (inl u) = h-fail (list-append "hyperactive: no definition named " other)
hy-write-new st m name other t (inr h) = bind (hy-module-of st h) (hy-write-at st m name h true t)
hy-write-to : List Word → List Word → List Word → List (List Word) → List Word → Sum Unit (List Word) → Proc W Unit
hy-write-to st m name rest t (inr h) = bind (hy-module-of st h) (hy-write-at st m name h false t)
hy-write-to st m name (cons a (cons other r)) t (inl u) =
  if h-eq a "after" then bind (hy-get st (list-append "written/" (h-hex other))) (λ w → hy-write-new st m name other t w)
  else h-fail (list-append name " is new: hyperactive write NAME after OTHER places it after OTHER")
hy-write-to st m name rest t (inl u) = h-fail (list-append name " is new: hyperactive write NAME after OTHER places it after OTHER")
hy-write : List Word → List Word → List (List Word) → List Word → Proc W Unit
hy-write st m nil t = h-fail "hyperactive write NAME [after OTHER], the declaration on standard input"
hy-write st m (cons name rest) t = bind (hy-get st (list-append "written/" (h-hex name))) (λ w → hy-write-to st m name rest (hy-nl t) w)
-- remove: refused while anything uses the name
hy-remove-in : List Word → List Word → List Word → List Word → Sum Unit (List Word × List (List Word)) → Proc W Unit
hy-remove-in st m name h (inl u) = h-fail (list-append "hyperactive: no file holds the piece of " name)
hy-remove-in st m name h (inr mo) =
  bind (h-read (h-unhex (fst mo))) (λ cur →
  bind (hy-render st (snd mo) nil nil false) (λ was →
  if h-eq (hy-or nil cur) was then
    bind (hy-render st (snd mo) h nil false) (λ new → bind (hy-root-of st (fst mo)) (λ root →
    hy-change st m name nil (h-unhex (fst mo)) was new (cons root nil) true))
  else h-fail (list-append (h-unhex (fst mo)) " has changed since the machine last read it; give it to the machine (hyperactive check) first")))
hy-remove-at : List Word → List Word → List Word → Sum Unit (List Word) → Proc W Unit
hy-remove-at st m name (inl u) = h-fail (list-append "hyperactive: no definition named " name)
hy-remove-at st m name (inr h) = bind (hy-module-of st h) (hy-remove-in st m name h)

hy-remove : List Word → List Word → List (List Word) → Proc W Unit
hy-remove st m nil = h-fail "hyperactive remove NAME"
hy-remove st m (cons name r) = bind (hy-live-users st name) (λ us →
  if h-null (h-concat us) then bind (hy-get st (list-append "written/" (h-hex name))) (λ w → hy-remove-at st m name w)
  else h-fail (list-append name (list-append " is used by " (hy-sep " " us))))
-- history [NAME]: every binding of the name to a key, in the order bound, from the store's names log
-- (`name key time`, a key `-` an unbinding), each with its time in UTC
hy-two : Word → List Word
hy-two w = if wlt w #10 then cons #48 (h-decimal w) else h-decimal w
hy-civil-ymd : Word → Word → Word → List Word
hy-civil-ymd y d m = list-append (h-decimal (if wlt m #3 then wadd y #1 else y)) (list-append "-" (list-append (hy-two m) (list-append "-" (hy-two d))))
hy-civil-mp : Word → Word → Word → List Word
hy-civil-mp y doy mp = hy-civil-ymd y (wadd (wsub doy (wquot (wadd (wmul #153 mp) #2) #5)) #1) (if wlt mp #10 then wadd mp #3 else wsub mp #9)
hy-civil-doy : Word → Word → List Word
hy-civil-doy y doy = hy-civil-mp y doy (wquot (wadd (wmul #5 doy) #2) #153)
hy-civil-yoe : Word → Word → Word → List Word
hy-civil-yoe era doe yoe = hy-civil-doy (wadd yoe (wmul era #400)) (wsub doe (wsub (wadd (wmul #365 yoe) (wquot yoe #4)) (wquot yoe #100)))
hy-civil-era : Word → Word → List Word
hy-civil-era era doe = hy-civil-yoe era doe (wquot (wsub (wadd (wsub doe (wquot doe #1460)) (wquot doe #36524)) (wquot doe #146096)) #365)
hy-civil-at : Word → List Word
hy-civil-at z = hy-civil-era (wquot z #146097) (wsub z (wmul (wquot z #146097) #146097))
wrem-of : Word → Word → Word
wrem-of a b = wsub a (wmul (wquot a b) b)
hy-civil : Word → List Word
hy-civil days =
  hy-civil-at (wadd days #719468)
hy-utc : Word → List Word
hy-utc t = list-append (hy-civil (wquot t #86400)) (list-append " " (list-append (hy-two (wquot (wrem-of t #86400) #3600))
  (list-append ":" (list-append (hy-two (wquot (wrem-of t #3600) #60)) (list-append ":" (list-append (hy-two (wrem-of t #60)) " UTC"))))))
hy-binding : List (List Word) → List Word
hy-binding (cons n (cons k (cons t r))) = h-line (list-append (hy-utc (h-number t)) (list-append " " (list-append n (list-append " " (if h-eq k "-" then "unbound" else k)))))
hy-binding ws = nil
hy-history-of : List Word → List (List Word) → List Word
hy-history-of name nil = nil
hy-history-of name (cons l r) = if orB (h-null name) (h-eq name (hy-head (h-split #32 l))) then list-append (hy-binding (h-split #32 l)) (hy-history-of name r) else hy-history-of name r
hy-history : List Word → List (List Word) → Proc W Unit
hy-history st a = bind (hy-get st "names") (λ log →
  if h-null (hy-history-of (hy-sep " " a) (h-lines (hy-or nil log)))
  then h-out (h-line (if h-null (hy-sep " " a) then "the history is empty" else list-append "no history for " (hy-sep " " a)))
  else h-out (hy-history-of (hy-sep " " a) (h-lines (hy-or nil log))))

-- paper [SECTION]: the paper as it reads, whole or one section (4.4, A.1, Part II), from the store,
-- where lib/paper-view.cub keeps it, made again when anything under the repository has changed
hy-hashes : List Word → Nat
hy-hashes nil = zero
hy-hashes (cons x r) = if weq x #35 then suc (hy-hashes r) else zero
hy-depth-at : Nat → List Word → Nat
hy-depth-at zero l = zero
hy-depth-at (suc k) l = if andB (wlt (fromNat (suc k)) #5) (h-prefix (cons #32 nil) (h-drop-n (suc k) l)) then suc k else zero
hy-depth : List Word → Nat
hy-depth l = hy-depth-at (hy-hashes l) l
hy-ends-there : List Word → Bool
hy-ends-there nil = false
hy-ends-there (cons x r) = orB (weq x #32) (weq x #46)
hy-names-section : List Word → List Word → Bool
hy-names-section s rest = andB (h-prefix s rest) (hy-ends-there (h-drop s rest))
hy-section-rest : List Word → List Word → Bool
hy-section-rest s r = orB (hy-names-section s r) (orB (andB (h-prefix "Part " r) (hy-names-section s (h-drop "Part " r))) (andB (h-prefix "Appendix " r) (hy-names-section s (h-drop "Appendix " r))))
hy-section-at : List Word → Nat → List Word → Bool
hy-section-at s zero l = false
hy-section-at s (suc d) l = hy-section-rest s (h-drop-n (suc (suc d)) l)
hy-section-head : List Word → List Word → Bool
hy-section-head s l = hy-section-at s (hy-depth l) l
hy-nat-le : Nat → Nat → Bool
hy-nat-le a b = h-not (wlt (fromNat b) (fromNat a))
hy-section-body : Nat → List (List Word) → List (List Word)
hy-section-body d nil = nil
hy-section-body d (cons l r) = if andB (h-not (hy-same-nat (hy-depth l) zero)) (hy-nat-le (hy-depth l) d) then nil else cons l (hy-section-body d r)
hy-section : List Word → List (List Word) → List (List Word)
hy-section s nil = nil
hy-section s (cons l r) = if hy-section-head s l then cons l (hy-section-body (hy-depth l) r) else hy-section s r
hy-paper-show : List (List Word) → List Word → Proc W Unit
hy-paper-show nil t = h-out t
hy-paper-show (cons s r) t = if h-null (h-concat (hy-section s (h-split #10 t))) then h-fail (list-append "the paper has no section " s)
  else h-out (h-concat (list-map h-line (hy-section s (h-split #10 t))))
hy-paper : List Word → List Word → List (List Word) → Proc W Unit
hy-paper st m a =
  bind (hy-get st "paper/stamp") (λ s → bind (h-dir-time (toNat #12) ".") (λ now →
  bind (if h-eq (hy-or nil s) (h-decimal now) then ret {lzero} {W} #0 else h-run (cons m (cons "lib/paper-view.cub" nil))) (λ r →
  bind (hy-get st "paper/text") (λ t → hy-paper-show a (hy-or nil t)))))

-- check [FILE ...]: the machine's verdict on the task graph (or on each file given, each loading what
-- it imports), then the graph's rules (lib/views.cub check)
hy-last : List (List Word) → List Word
hy-last nil = nil
hy-last (cons x nil) = x
hy-last (cons x (cons y r)) = hy-last (cons y r)
hy-fail-lines : List (List Word) → List Word
hy-fail-lines nil = nil
hy-fail-lines (cons l r) = if orB (h-prefix "FAIL" l) (orB (h-prefix "   reason" l) (h-prefix "   in:" l)) then list-append (h-line (list-append "  " l)) (hy-fail-lines r) else hy-fail-lines r
hy-machine-on : List Word → List Word → Proc W Unit
hy-machine-on m f = bind (h-capture (cons m (cons "--read" (cons f nil)))) (λ r →
  h-out (list-append (h-line (list-append f (list-append ": " (hy-last (h-lines (snd r)))))) (hy-fail-lines (h-lines (snd r)))))
hy-machine-all : List Word → List (List Word) → Proc W Unit
hy-machine-all m nil = ret unit
hy-machine-all m (cons f r) = bind (hy-machine-on m f) (λ u → hy-machine-all m r)

-- brunerie: Brunerie's number (Ljungström's brunerie', the typed port experiments/brunerie/typed.cub)
-- computed with no store, with one worker and with four: it must be -2 (negsuc (suc zero)) each time
hy-brunerie-in : List (List Word) → Bool
hy-brunerie-in nil = false
hy-brunerie-in (cons l r) = if andB (h-eq l "brunerie") (h-infix "= negsuc (suc zero)" (hy-head r)) then true else hy-brunerie-in r
hy-brunerie-with : List Word → List Word → Proc W Bool
hy-brunerie-with m w = bind (h-capture-with (cons "CUBICAL_NOCACHE=1" (cons (list-append "CUBICAL_WORKERS=" w) nil))
  (cons m (cons "lib/core.cub" (cons "experiments/brunerie/typed.cub" (cons "experiments/brunerie/run-typed.cub" nil))))) (λ r → ret (hy-brunerie-in (h-lines (snd r))))
hy-brunerie : List Word → Proc W Unit
hy-brunerie m = bind (hy-brunerie-with m "0") (λ a → bind (hy-brunerie-with m "4") (λ b →
  if andB a b then h-out (h-line "brunerie = negsuc (suc zero), with one worker and with four")
  else h-fail (list-append "brunerie: not -2 with " (if a then "four workers" else "one worker"))))


-- view [in FILE] [type T] TERM: a term's value, the term read in FILE (the task graph by default). Its
-- type is the machine's (#type) unless given; text (List Word) is shown as text, a list of texts one
-- per line with their count, anything else as the machine shows its normal form
hy-view-args : List Word → List Word → List (List Word) → (List Word × List Word) × List Word
hy-view-args f t (cons k (cons v r)) = if h-eq k "in" then hy-view-args v t r else if h-eq k "type" then hy-view-args f v r else ((f , t) , hy-sep " " (cons k (cons v r)))
hy-view-args f t a = ((f , t) , hy-sep " " a)
hy-probe-head : List Word → List Word
hy-probe-head f = list-append (h-line (list-append "import " (h-quote "../lib/host.cub"))) (h-line (list-append "import " (h-quote (list-append "../" f))))
hy-after-last-colon : List Word → List Word
hy-after-last-colon l = h-rev (h-before (h-rev " : " nil) (h-rev l nil)) nil
hy-type-of : List (List Word) → List Word
hy-type-of nil = nil
hy-type-of (cons l r) = if andB (h-prefix "type: " l) (h-infix " : " l) then hy-after-last-colon l else hy-type-of r
-- the machine's report without its count of checks
hy-shown : List (List Word) → List Word
hy-shown nil = nil
hy-shown (cons l r) = if h-infix " passed, " l then hy-shown r else list-append (h-line l) (hy-shown r)
-- a probe written beside the build and given to the machine: its report
hy-probe : List Word → List Word → Proc W (Word × List Word)
hy-probe m text = bind (h-mkdir "build") (λ u → bind (h-write "build/view-probe.cub" text) (λ b → h-capture (cons m (cons "build/view-probe.cub" nil))))
hy-program : List Word → List Word
hy-program body = h-concat (list-map h-line (cons "view-probe : Proc W Unit" (cons (list-append "view-probe = bind (" (list-append body ") (λ u → exit #0)")) (cons "view-run : Step W Unit" (cons "view-run = to-step view-probe" (cons "#run view-run" nil))))))
hy-list-body : List Word → List Word → List Word
hy-list-body term t = h-concat (cons "h-out (list-append (h-concat (list-map h-line (" (cons term (cons "))) (h-line (list-append " (cons (h-quote "(") (cons " (list-append (h-decimal (fromNat (list-length (" (cons term (cons ")))) (list-append " (cons (h-quote ", ") (cons " " (cons (h-quote (list-append t ")")) (cons ")))))" nil)))))))))))
hy-text-body : List Word → List Word
hy-text-body term = list-append "h-out (list-append (" (list-append term ") (cons #10 nil))")
hy-is-text : List Word → Bool
hy-is-text t = orB (h-eq t "List Word") (h-eq t "(List Word)")
hy-is-texts : List Word → Bool
hy-is-texts t = orB (h-eq t "List (List Word)") (h-eq t "(List (List Word))")
hy-view-source : List Word → List Word → List Word → List Word
hy-view-source f t term = list-append (hy-probe-head f)
  (if hy-is-text t then hy-program (hy-text-body term) else if hy-is-texts t then hy-program (hy-list-body term t) else h-line (list-append "#show " term))
hy-view-show : Word × List Word → Proc W Unit
hy-view-show r = h-out (hy-shown (h-lines (snd r)))
hy-view-run : List Word → List Word → List Word → List Word → Proc W Unit
hy-view-run m f t term = bind (hy-probe m (hy-view-source f t term)) hy-view-show
hy-view-typed-of : List Word → List Word → List Word → Word × List Word → Proc W Unit
hy-view-typed-of m f term r = if h-null (hy-type-of (h-lines (snd r))) then h-fail (hy-shown (h-lines (snd r))) else hy-view-run m f (hy-type-of (h-lines (snd r))) term
hy-view-typed : List Word → List Word → List Word → List Word → Proc W Unit
hy-view-typed m f t term = if h-null t then bind (hy-probe m (list-append (hy-probe-head f) (h-line (list-append "#type (" (list-append term ")"))))) (hy-view-typed-of m f term)
  else hy-view-run m f t term
hy-view-term : List Word → List (List Word) → Proc W Unit
hy-view-term m a = hy-view-typed m (fst (fst (hy-view-args "task-graph/hyperactivity.cub" nil a))) (snd (fst (hy-view-args "task-graph/hyperactivity.cub" nil a))) (snd (hy-view-args "task-graph/hyperactivity.cub" nil a))

-- the graph's views, kept in the store by lib/views.cub (views/), made again when anything under the
-- repository has changed since
hy-views-ready : List Word → List Word → Proc W Unit
hy-views-ready st m = bind (hy-get st "views/stamp") (λ s → bind (h-dir-time (toNat #12) ".") (λ now →
  if h-eq (hy-or nil s) (h-decimal now) then ret {lzero} {W} unit else bind (h-run (cons m (cons "lib/views.cub" nil))) (λ r → ret {lzero} {W} unit)))
hy-view : List Word → List Word → List Word → Proc W Unit
hy-view st m v = bind (hy-views-ready st m) (λ u → bind (hy-get st (list-append "views/" v)) (λ t → h-out (hy-or nil t)))
hy-show-nodes : List Word → List (List Word) → Proc W Unit
hy-show-nodes st nil = ret unit
hy-show-nodes st (cons i r) = bind (hy-get st (list-append "views/show-" (h-hex i))) (λ t →
  bind (h-out (hy-or (h-line (h-line (list-append i ": no such node"))) t)) (λ u → hy-show-nodes st r))
hy-views : List Word → List Word → List (List Word) → Proc W Unit
hy-views st m nil = hy-view st m "tree"
hy-views st m (cons c rest) = if h-eq c "show" then bind (hy-views-ready st m) (λ u → hy-show-nodes st rest) else hy-view st m c
-- check: the machine's verdict on the task graph (kept like a write's) and the graph's rules
hy-verdict-text : List Word → Bool × List (List Word) → List Word
hy-verdict-text f v = list-append (h-line (list-append f (if fst v then (if h-null (h-concat (snd v)) then ": the machine reads it to the end; nothing fails" else ": these fail:") else ": the machine does not read it to the end")))
  (h-indented "  " (snd v))
hy-check : List Word → List Word → List (List Word) → Proc W Unit
hy-check st m nil = bind (hy-verdict st m "task-graph/hyperactivity.cub") (λ v → bind (h-out (hy-verdict-text "task-graph/hyperactivity.cub" v)) (λ u → hy-view st m "check"))
hy-check st m (cons f r) = hy-machine-all m (cons f r)
-- why NAME, unexplained [FILE ...] (“The Hyperactive Workflow”: every declaration is there for a
-- reason, a chain to a root of the task graph): a node of the graph is a part of a node with a reason,
-- or a root; a declaration whose statement says (part of NODE) or (prerequisite to NODE) has NODE's
-- reason; a name the machine itself names (a string of src/) has the machine as its reason; and what
-- a declaration with a reason uses has that reason too. The nodes come from the views kept in the
-- store, the uses from the checker's record (deps/, users/), the statements from the written pieces.
hy-node-table : List (List Word) → List (List Word × List (List Word))
hy-node-table nil = nil
hy-node-table (cons l r) = cons (hy-head (h-split #32 l) , h-tail-lists (h-split #32 l)) (hy-node-table r)
hy-node-parts : List Word → List (List Word × List (List Word)) → Sum Unit (List (List Word))
hy-node-parts i nil = inl unit
hy-node-parts i (cons e r) = if h-eq i (fst e) then inr (snd e) else hy-node-parts i r
-- a node's chain to a root: part of …, then a root
hy-up-with : (List Word → List (List Word)) → Sum Unit (List (List Word)) → List (List Word)
hy-up-with k (inl u) = cons "no reason" nil
hy-up-with k (inr ps) = cons (list-append "part of " (hy-head ps)) (k (hy-head ps))
hy-node-chain : Nat → List (List Word) → List (List Word × List (List Word)) → List Word → List (List Word)
hy-node-chain zero roots t i = cons "(the chain is longer than the graph)" nil
hy-node-chain (suc f) roots t i = if h-has i roots then cons "a root" nil else hy-up-with (hy-node-chain f roots t) (hy-node-parts i t)
-- the names the machine names: each run of non-space, non-quote bytes between quotation marks in src/
-- (a run with a space is no name; the search goes on at the next byte), and a name %%f is f
hy-space : Word → Bool
hy-space b = orB (weq b #32) (andB (wlt #8 b) (wlt b #14))
hy-quoted-run : List Word → List Word → Sum Unit (List Word × List Word)
hy-quoted-run cur nil = inl unit
hy-quoted-run cur (cons x r) = if weq x #34 then (if h-null cur then inl unit else inr (h-rev cur nil , r)) else if hy-space x then inl unit else hy-quoted-run (cons x cur) r
hy-unprefixed : List Word → List Word
hy-unprefixed n = if h-prefix "%%" n then h-drop "%%" n else n
hy-c-names-at : (List Word → List (List Word)) → List Word → Sum Unit (List Word × List Word) → List (List Word)
hy-c-names-at k r (inl u) = k r
hy-c-names-at k r (inr m) = cons (hy-unprefixed (fst m)) (k (snd m))
hy-c-names : Nat → List Word → List (List Word)
hy-c-names zero t = nil
hy-c-names (suc f) nil = nil
hy-c-names (suc f) (cons x r) = if weq x #34 then hy-c-names-at (hy-c-names f) r (hy-quoted-run nil r) else hy-c-names f r
hy-c-files : List (List Word) → List (List Word)
hy-c-files nil = nil
hy-c-files (cons f r) = if orB (h-ends ".c" f) (h-ends ".h" f) then cons (list-append "src/" f) (hy-c-files r) else hy-c-files r
hy-read-all : List (List Word) → Proc W (List (List Word))
hy-read-all nil = ret nil
hy-read-all (cons f r) = bind (h-read f) (λ t → bind (hy-read-all r) (λ rest → ret (cons (hy-or nil t) rest)))
hy-machine-names : Proc W (List (List Word))
hy-machine-names = bind (h-list "src") (λ fs → bind (hy-read-all (hy-c-files fs)) (λ ts →
  ret (h-msort (h-concat-lists (list-map (λ t → hy-c-names (list-length t) t) ts)))))
-- a statement's stated reason: the last (part of NODE) or (prerequisite to NODE) in its comment lines
hy-word-byte : Word → Bool
hy-word-byte b = orB (orB (andB (wlt #47 b) (wlt b #58)) (andB (wlt #64 b) (wlt b #91))) (orB (andB (wlt #96 b) (wlt b #123)) (orB (weq b #95) (weq b #45)))
hy-word-run : List Word → List Word
hy-word-run nil = nil
hy-word-run (cons x r) = if hy-word-byte x then cons x (hy-word-run r) else nil
hy-stated-in : List Word → Sum Unit (List Word × List Word)
hy-stated-in nil = inl unit
hy-stated-in (cons x r) =
  if andB (h-prefix "(part of " (cons x r)) (h-prefix ")" (h-drop (hy-word-run (h-drop "(part of " (cons x r))) (h-drop "(part of " (cons x r))))
    then (if h-null (hy-word-run (h-drop "(part of " (cons x r))) then hy-stated-in r else inr ("part of" , hy-word-run (h-drop "(part of " (cons x r)))) else
  if andB (h-prefix "(prerequisite to " (cons x r)) (h-prefix ")" (h-drop (hy-word-run (h-drop "(prerequisite to " (cons x r))) (h-drop "(prerequisite to " (cons x r))))
    then (if h-null (hy-word-run (h-drop "(prerequisite to " (cons x r))) then hy-stated-in r else inr ("prerequisite to" , hy-word-run (h-drop "(prerequisite to " (cons x r)))) else
  hy-stated-in r
hy-comment-lines : List (List Word) → List (List Word)
hy-comment-lines nil = nil
hy-comment-lines (cons l r) = if h-prefix "--" (h-trim l) then cons l (hy-comment-lines r) else nil
hy-or-stated : Sum Unit (List Word × List Word) → Sum Unit (List Word × List Word) → Sum Unit (List Word × List Word)
hy-or-stated (inr a) b = inr a
hy-or-stated (inl u) b = b
hy-stated-last : List (List Word) → Sum Unit (List Word × List Word)
hy-stated-last nil = inl unit
hy-stated-last (cons l r) = hy-or-stated (hy-stated-last r) (hy-stated-in l)
hy-stated : List Word → List Word → Proc W (Sum Unit (List Word × List Word))
hy-stated st name = bind (hy-piece-of st name) (λ p → ret (hy-stated-last (hy-comment-lines (h-split #10 p))))
-- what the reasons are read from: the nodes and roots (the views kept), and the machine's names
hy-reason-data : List Word → List Word → Proc W ((List (List Word × List (List Word)) × List (List Word)) × List (List Word))
hy-reason-data st m = bind (hy-views-ready st m) (λ u →
  bind (hy-get st "views/nodes") (λ ns → bind (hy-get st "views/roots") (λ rs → bind hy-machine-names (λ mn →
  ret ((hy-node-table (h-lines (hy-or nil ns)) , h-lines (hy-or nil rs)) , mn)))))
hy-is-some-parts : Sum Unit (List (List Word)) → Bool
hy-is-some-parts (inl u) = false
hy-is-some-parts (inr p) = true
hy-is-node : List Word → List (List Word × List (List Word)) → Bool
hy-is-node i t = hy-is-some-parts (hy-node-parts i t)
-- a declaration's own reason, as the lines of its chain, or none
hy-direct-machine : List (List Word) → List Word → Sum Unit (List (List Word))
hy-direct-machine mn name = if h-has name mn then inr (cons "named by the machine (src/)" nil) else inl unit
hy-direct-stated : List (List Word × List (List Word)) → List (List Word) → List (List Word) → List Word → Sum Unit (List Word × List Word) → Sum Unit (List (List Word))
hy-direct-stated t roots mn name (inr s) = if hy-is-node (snd s) t then inr (cons (list-append (fst s) (list-append " " (snd s))) (hy-node-chain (list-length t) roots t (snd s))) else hy-direct-machine mn name
hy-direct-stated t roots mn name (inl u) = hy-direct-machine mn name
hy-direct-of : List (List Word × List (List Word)) → List (List Word) → List (List Word) → List Word → Sum Unit (List Word × List Word) → Sum Unit (List (List Word))
hy-direct-of t roots mn name s =
  if hy-is-node name t then inr (hy-node-chain (list-length t) roots t name) else hy-direct-stated t roots mn name s
hy-direct : List Word → List (List Word × List (List Word)) → List (List Word) → List (List Word) → List Word → Proc W (Sum Unit (List (List Word)))
hy-direct st t roots mn name = bind (hy-stated st name) (λ s → ret (hy-direct-of t roots mn name s))
-- why: from the name, through what uses it, breadth first, to the first with a reason of its own
h-minus-unsorted : List (List Word) → List (List Word) → List (List Word)
h-minus-unsorted nil b = nil
h-minus-unsorted (cons x r) b = if h-has x b then h-minus-unsorted r b else cons x (h-minus-unsorted r b)
hy-why-found : List Word → List (List Word × List (List Word)) → List (List Word) → List (List Word) → (List (List Word) → List (List Word × List (List Word)) → Proc W (Sum Unit (List (List Word)))) → List (List Word) → List Word × List (List Word) → List (List Word × List (List Word)) → Sum Unit (List (List Word)) → Proc W (Sum Unit (List (List Word)))
hy-why-found st t roots mn k seen e r (inr chain) = ret (inr (list-append (snd e) chain))
hy-why-found st t roots mn k seen e r (inl u) = bind (hy-live-users st (fst e)) (λ us →
  k (list-append seen (h-minus-unsorted us seen)) (list-append r (list-map (λ x → (x , list-append (snd e) (cons (list-append "used by " x) nil))) (h-minus-unsorted us seen))))
hy-why-step : List Word → List (List Word × List (List Word)) → List (List Word) → List (List Word) → (List (List Word) → List (List Word × List (List Word)) → Proc W (Sum Unit (List (List Word)))) → List (List Word) → List (List Word × List (List Word)) → Proc W (Sum Unit (List (List Word)))
hy-why-step st t roots mn k seen nil = ret (inl unit)
hy-why-step st t roots mn k seen (cons e r) = bind (hy-direct st t roots mn (fst e)) (λ d → hy-why-found st t roots mn k seen e r d)
hy-why-bfs : Nat → List Word → List (List Word × List (List Word)) → List (List Word) → List (List Word) → List (List Word) → List (List Word × List (List Word)) → Proc W (Sum Unit (List (List Word)))
hy-why-bfs zero st t roots mn seen q = ret (inl unit)
hy-why-bfs (suc f) st t roots mn seen q = hy-why-step st t roots mn (hy-why-bfs f st t roots mn) seen q
hy-or-lines : List (List Word) → Sum Unit (List (List Word)) → List (List Word)
hy-or-lines d (inl u) = d
hy-or-lines d (inr x) = x
hy-why-one : List Word → List (List Word × List (List Word)) → List (List Word) → List (List Word) → List Word → Proc W Unit
hy-why-one st t roots mn name = bind (hy-why-bfs (toNat #4096) st t roots mn (cons name nil) (cons (name , nil) nil)) (λ r →
  h-out (list-append (h-line name) (list-append (h-indented "  " (hy-or-lines (cons "no reason" nil) r)) (cons #10 nil))))
hy-why-all : List Word → List (List Word × List (List Word)) → List (List Word) → List (List Word) → List (List Word) → Proc W Unit
hy-why-all st t roots mn nil = ret unit
hy-why-all st t roots mn (cons n r) = bind (hy-why-one st t roots mn n) (λ u → hy-why-all st t roots mn r)
hy-why : List Word → List Word → List (List Word) → Proc W Unit
hy-why st m names = bind (hy-reason-data st m) (λ d → hy-why-all st (fst (fst d)) (snd (fst d)) (snd d) names)

-- unexplained [FILE ...]: every declaration with no reason, by file, among the files the machine has
-- read (names-of/ in the store); with files given, those files and those under the paths given.
-- The declarations with a reason of their own come first; then everything they use, round by round
hy-files-names : List Word → List (List Word) → Proc W (List (List Word × List (List Word)))
hy-files-names st nil = ret nil
hy-files-names st (cons h r) = bind (hy-get st (list-append "names-of/" h)) (λ ns → bind (hy-files-names st r) (λ rest →
  ret (cons (h-unhex h , h-lines (hy-or nil ns)) rest)))
hy-files-read : List Word → Proc W (List (List Word × List (List Word)))
hy-files-read st = bind (h-list (list-append st "/names-of")) (λ hs → hy-files-names st (h-msort hs))
hy-in-scope-of : List (List Word) → List Word → Bool
hy-in-scope-of nil f = false
hy-in-scope-of (cons a r) f = orB (h-prefix a f) (hy-in-scope-of r f)
hy-in-scope : List (List Word) → List Word → Bool
hy-in-scope nil f = true
hy-in-scope (cons a r) f = hy-in-scope-of (cons a r) f
-- the names with a reason of their own, and the statements naming something not a node
hy-own-add : List (List Word × List (List Word)) → List (List Word) → List Word → Sum Unit (List Word × List Word) → (List (List Word)) × (List (List Word)) → (List (List Word)) × (List (List Word))
hy-own-add t mn n (inr s) acc = if hy-is-node (snd s) t then (cons n (fst acc) , snd acc)
  else (if h-has n mn then cons n (fst acc) else fst acc , cons (list-append n (list-append ": states a reason, " (list-append (snd s) ", which is not a node of task-graph/hyperactivity.cub"))) (snd acc))
hy-own-add t mn n (inl u) acc = (if orB (hy-is-node n t) (h-has n mn) then cons n (fst acc) else fst acc , snd acc)
hy-own : List Word → List (List Word × List (List Word)) → List (List Word) → List (List Word) → Proc W ((List (List Word)) × (List (List Word)))
hy-own st t mn nil = ret (nil , nil)
hy-own st t mn (cons n r) = bind (hy-stated st n) (λ s → bind (hy-own st t mn r) (λ rest → ret (hy-own-add t mn n s rest)))
-- what a set of names uses, sorted
hy-deps-of : List Word → List (List Word) → Proc W (List (List Word))
hy-deps-of st nil = ret nil
hy-deps-of st (cons n r) = bind (hy-get st (list-append "deps/" (h-hex n))) (λ d → bind (hy-deps-of st r) (λ rest → ret (h-union (h-msort (h-lines (hy-or nil d))) rest)))
hy-closure : Nat → List Word → List (List Word) → List (List Word) → Proc W (List (List Word))
hy-closure zero st have frontier = ret have
hy-closure (suc f) st have frontier = bind (hy-deps-of st frontier) (λ d →
  if h-null (h-concat (h-minus d have)) then ret {lzero} {W} have else hy-closure f st (h-union have (h-minus d have)) (h-minus d have))
hy-not-in : List (List Word) → List (List Word) → List (List Word)
hy-not-in have nil = nil
hy-not-in have (cons n r) = if h-has n have then hy-not-in have r else cons n (hy-not-in have r)
hy-unexplained-file : List (List Word) → List Word × List (List Word) → List Word
hy-unexplained-file have e = if h-null (h-concat (hy-not-in have (snd e))) then nil
  else list-append (h-line (list-append (fst e) (list-append "  (" (list-append (h-decimal (fromNat (list-length (hy-not-in have (snd e))))) ")")))) (h-indented "  " (hy-not-in have (snd e)))
hy-scoped : List (List Word) → List (List Word × List (List Word)) → List (List Word × List (List Word))
hy-scoped args nil = nil
hy-scoped args (cons e r) = if hy-in-scope args (fst e) then cons e (hy-scoped args r) else hy-scoped args r
hy-count-names : List (List Word × List (List Word)) → Nat
hy-count-names fs = list-length (h-concat-lists (list-map (λ e → snd e) fs))
hy-count-missing : List (List Word) → List (List Word × List (List Word)) → Nat
hy-count-missing have fs = list-length (h-concat-lists (list-map (λ e → hy-not-in have (snd e)) fs))
hy-unexplained-report : List (List Word) → List (List Word) → List (List Word × List (List Word)) → List Word
hy-unexplained-report warn have fs = list-append (h-concat (list-map h-line warn)) (list-append (h-concat (list-map (hy-unexplained-file have) fs))
  (h-line (list-append (h-decimal (fromNat (hy-count-missing have fs))) (list-append " of " (list-append (h-decimal (fromNat (hy-count-names fs))) " declarations read have no reason")))))
hy-unexplained : List Word → List Word → List (List Word) → Proc W Unit
hy-unexplained st m args = bind (hy-reason-data st m) (λ d → bind (hy-files-read st) (λ fs →
  bind (hy-own st (fst (fst d)) (snd d) (h-concat-lists (list-map (λ e → snd e) fs))) (λ own →
  bind (hy-closure (toNat #256) st (h-msort (fst own)) (h-msort (fst own))) (λ have →
  h-out (hy-unexplained-report (snd own) have (hy-scoped args fs))))))

-- every: every file checked, by giving the machine each file no file imports (lib/, experiments/,
-- task-graph/), loaded alone with its imports and without performing what acts on the world (--read);
-- a file another imports is checked in that file's run. A failure is a file's own when its position
-- is in that file. The imports are the reader's own (the machine's --imports).
hy-every-files : Proc W (List (List Word))
hy-every-files = bind (h-files (toNat #16) ".cub" "lib") (λ a → bind (h-files (toNat #16) ".cub" "experiments") (λ b →
  bind (h-files (toNat #16) ".cub" "task-graph") (λ c → ret (h-msort (list-append a (list-append b c))))))
hy-imported : List (List Word) → List (List Word)
hy-imported nil = nil
hy-imported (cons l r) = if h-prefix "imports: " l then list-append (h-tail-lists (h-split #32 (h-drop "imports: " l))) (hy-imported r) else hy-imported r
hy-own-fails : List Word → List (List Word) → List (List Word)
hy-own-fails cwd nil = nil
hy-own-fails cwd (cons l r) = if h-prefix "   in: " l then cons (h-drop (list-append cwd "/") (h-drop "   in: " l)) (hy-own-fails cwd r) else hy-own-fails cwd r
h-tail-colon : List Word → List Word
h-tail-colon nil = nil
h-tail-colon (cons x r) = if weq x #58 then r else h-tail-colon r
hy-file-of : List Word → List Word
hy-file-of pos = h-rev (h-tail-colon (h-rev pos nil)) nil
hy-fatal : List Word → List (List Word) → List Word
hy-fatal abs nil = nil
hy-fatal abs (cons l r) = if orB (h-prefix abs l) (h-prefix "error" l) then l else hy-fatal abs r
hy-fatal-note : List Word → List Word
hy-fatal-note t = if h-null t then nil else list-append "  (" (list-append (h-take (toNat #100) t) ")")
hy-every-line : List Word → List Word → List (List Word) → List Word
hy-every-line cwd f out = h-line (list-append f (list-append ": " (list-append (h-take (toNat #60) (hy-last (h-nonempty out)))
  (hy-fatal-note (hy-fatal (list-append cwd (cons #47 f)) out)))))
hy-every-run : List Word → List Word → List (List Word) → Proc W (List (List Word))
hy-every-run m cwd nil = ret nil
hy-every-run m cwd (cons f r) = bind (h-capture (cons m (cons "--read" (cons f nil)))) (λ c →
  bind (h-out (hy-every-line cwd f (h-lines (snd c)))) (λ u →
  bind (hy-every-run m cwd r) (λ rest → ret (list-append (hy-own-fails cwd (h-lines (snd c))) rest))))
v-filter-pos : List Word → List (List Word) → List (List Word)
v-filter-pos g nil = nil
v-filter-pos g (cons p r) = if h-eq g (hy-file-of p) then cons p (v-filter-pos g r) else v-filter-pos g r
hy-count-line : List Word → List (List Word) → List Word
hy-count-line g ps = if h-null (h-concat ps) then nil else h-line (list-append g (list-append ": " (list-append (h-decimal (fromNat (list-length ps))) " failing")))
hy-count-by : List (List Word) → List (List Word) → List Word
hy-count-by files pos = h-concat (list-map (λ g → hy-count-line g (h-dedupe (v-filter-pos g pos))) files)
hy-every : List Word → Proc W Unit
hy-every m = bind hy-every-files (λ fs → bind (h-capture (cons m (cons "--imports" fs))) (λ im → bind h-cwd (λ cwd →
  bind (hy-every-run m cwd (h-minus fs (h-msort (hy-imported (h-lines (snd im)))))) (λ pos →
  h-out (list-append (cons #10 nil) (list-append (hy-count-by fs pos)
    (h-line (list-append (h-decimal (fromNat (list-length (h-minus fs (h-msort (hy-imported (h-lines (snd im)))))))) (list-append " files no file imports, checked; "
      (list-append (h-decimal (fromNat (list-length (h-nonempty (list-map (λ g → hy-count-line g (h-dedupe (v-filter-pos g pos))) fs))))) " files with failures of their own"))))))))))

-- the further actions of the work: why, unexplained, view, every, server and brunerie (above), the
-- machine itself (repl, library), and etym, the one action that still runs an earlier program
-- (tools/etym.py, Avik, 2026-11-15: "beyond what exists today (and even that we will be critical of)"):
-- its dictionary is fetched over HTTPS, which the machine's world does not yet speak
hy-runs : List (List Word) → Proc W Unit
hy-runs a = bind (h-run a) (λ r → ret unit)
hy-bridge : List Word → List Word → List Word → List (List Word) → Proc W Unit
hy-bridge st m c rest =
  if h-eq c "etym" then hy-runs (cons "/usr/bin/env" (cons "python3" (cons "tools/etym.py" rest))) else
  if h-eq c "view" then hy-view-term m rest else
  if h-eq c "why" then hy-why st m rest else
  if h-eq c "unexplained" then hy-unexplained st m rest else
  if h-eq c "every" then hy-every m else
  if h-eq c "server" then hy-runs (cons m (cons "lib/server.cub" rest)) else
  if h-eq c "brunerie" then hy-brunerie m else
  if h-eq c "repl" then hy-runs (cons m (cons "lib/core.cub" (list-append rest (cons "--serve" nil)))) else
  if h-eq c "library" then hy-runs (cons m (cons "lib/library.cub" nil)) else ret unit
hy-bridge-words : List (List Word)
hy-bridge-words = cons "etym" (cons "why" (cons "unexplained" (cons "view" (cons "every" (cons "server" (cons "brunerie" (cons "repl" (cons "library" nil))))))))

-- The session (2026-11-15, Avik: "the interactive loop of understanding/contributing"; "the cli may
-- simply deliver exactly the onboarding contents in a sequence of turns"): one loop whose state is a
-- value, the actions taken so far (session/log in the store, one per line) folded from the first
-- state. Each call of `hyperactive ACTION` takes one action, if it is valid where the session is,
-- and shows the state it reaches with the actions valid there; `hyperactive` alone shows where the
-- session is. A session begins with the walk of the onboarding, where next and prev are the only
-- actions; then the work: the graph's views, reading code by name, and the rest; `done` declares
-- the work done and ends the session. A session not ended by `done` stays where it was.
-- Decomposing a document by pulls (Avik, 2026-11-16, “Avik's words, verbatim”; 10:06–10:36 UTC; lib/knowledge.cub):
-- `decompose FILE` shows the document (a file, or the source of a decomposed one); `pull FROM TO`
-- names the lines of one piece; the piece is shown with its surroundings and asserted
-- `self-contained` or given `re-expressed` (on standard input); then the residual, the document
-- without the piece, is judged the same way; `finish` writes the pulls made. Pulls are independent:
-- none claims the lines it takes, and any may overlap another.
data HyState = hy-walking (k : Nat) | hy-working | hy-reading (file : List Word)
             | hy-decomposing (file : List Word) (lines : List Word) (stage : Nat)

hy-pred : Nat → Nat
hy-pred zero = suc zero
hy-pred (suc zero) = suc zero
hy-pred (suc (suc k)) = suc k
hy-work-words : List (List Word)
hy-work-words = cons "show" (cons "tree" (cons "order" (cons "open" (cons "def" (cons "write" (cons "remove" (cons "history" (cons "paper" (cons "check" (cons "done" nil))))))))))
hy-rest : List (List Word) → List (List Word)
hy-rest nil = nil
hy-rest (cons w r) = r
hy-second : List (List Word) → List Word
hy-second a = hy-head (hy-rest a)
-- a range of lines: from the first line on, not ending before it begins
-- the lines of a pull: ranges FROM TO, in order, each beginning after the last ended (a subsequence of
-- the document's lines)
hy-ranges-ok-after : Word → List Word → Bool
hy-ranges-ok-after prev nil = true
hy-ranges-ok-after prev (cons x nil) = false
hy-ranges-ok-after prev (cons x (cons y r)) = if wlt prev x then (if wlt y x then false else hy-ranges-ok-after y r) else false
hy-ranges-ok : List Word → Bool
hy-ranges-ok nil = false
hy-ranges-ok ws = hy-ranges-ok-after #0 ws

-- an action applied: the state it reaches, or none when it is not valid there
hy-step : Nat → HyState → List (List Word) → Sum Unit HyState
hy-step count (hy-walking k) a =
  if h-eq (hy-head a) "next" then inr (if hy-same-nat k count then hy-working else hy-walking (suc k)) else
  if h-eq (hy-head a) "prev" then inr (hy-walking (hy-pred k)) else inl unit
hy-step count hy-working a =
  if h-eq (hy-head a) "decompose" then (if h-null (hy-second a) then inl unit else inr (hy-reading (hy-second a))) else
  if orB (h-has (hy-head a) hy-work-words) (h-has (hy-head a) hy-bridge-words) then inr hy-working else inl unit
hy-step count (hy-reading f) a =
  if h-eq (hy-head a) "pull"
  then (if hy-ranges-ok (list-map h-number (hy-rest a)) then inr (hy-decomposing f (list-map h-number (hy-rest a)) zero) else inl unit) else
  if h-eq (hy-head a) "finish" then inr hy-working else
  if h-eq (hy-head a) "part" then inr (hy-reading f) else inl unit
hy-step count (hy-decomposing f xy k) a =
  if h-has (hy-head a) (cons "self-contained" (cons "re-expressed" nil))
  then inr (if hy-same-nat k zero then hy-decomposing f xy (suc zero) else hy-reading f) else
  if h-eq (hy-head a) "part" then inr (hy-decomposing f xy k) else inl unit
hy-or-state : HyState → Sum Unit HyState → HyState
hy-or-state s (inl u) = s
hy-or-state s (inr t) = t
-- the state the log reaches
hy-fold : Nat → HyState → List (List Word) → HyState
hy-fold count s nil = s
hy-fold count s (cons l r) = hy-fold count (hy-or-state s (hy-step count s (h-split #32 l))) r

-- the walk's chunks, kept in the store by lib/walk.cub; made again when anything has changed since
hy-machine : List (List Word) → List Word
hy-machine nil = "build/cubical"
hy-machine (cons m r) = m
hy-walk-fresh : List Word → List Word → Proc W Unit
hy-walk-fresh st m =
  bind (hy-get st "walk/stamp") (λ s → bind (h-dir-time (toNat #12) ".") (λ now →
  if h-eq (hy-or nil s) (h-decimal now) then ret {lzero} {W} unit
  else bind (h-out (h-line "(the onboarding has changed since it was last cut into chunks: cutting it again)")) (λ u →
    bind (h-run (cons m (cons "lib/walk.cub" nil))) (λ r → ret {lzero} {W} unit))))
hy-count : List Word → Proc W Nat
hy-count st = bind (hy-get st "walk/count") (λ c → ret (toNat (h-number (hy-or "0" c))))

-- what a state shows
hy-arrival : List Word
hy-arrival = h-line (h-line "You are entering hyperactivity. This walk is how an agent comes to hold Avik's complete insight: every agent reads the same material, whole, in the same order, one chunk at a time. Read every word of a chunk before `hyperactive next`; nothing else can be done until the walk is done.")
hy-rule : List Word
hy-rule = "────────"
hy-first-line : List Word → List Word
hy-first-line nil = nil
hy-first-line (cons x r) = if weq x #10 then nil else cons x (hy-first-line r)
hy-after-first-line : List Word → List Word
hy-after-first-line nil = nil
hy-after-first-line (cons x r) = if weq x #10 then r else hy-after-first-line r
hy-of : Nat → Nat → List Word
hy-of k n = list-append (h-decimal (fromNat k)) (list-append " of " (h-decimal (fromNat n)))
hy-show-chunk : Nat → Nat → Sum Unit (List Word) → Proc W Unit
hy-show-chunk k n (inl u) = h-fail "hyperactive: the walk's chunk is missing from the store"
hy-show-chunk k n (inr t) =
  h-out (list-append (if hy-same-nat k (suc zero) then hy-arrival else nil)
    (list-append (h-line (h-line (list-append "── " (list-append (hy-of k n) (list-append ": " (list-append (hy-first-line t) (list-append " " hy-rule)))))))
    (list-append (h-line (hy-after-first-line t))
    (h-line (list-append hy-rule (list-append " end of " (list-append (hy-of k n)
      (if hy-same-nat k n then ". The walk is done: hyperactive next begins the work." else ". Next: hyperactive next   (back: hyperactive prev)"))))))))
hy-work-usage : List Word
hy-work-usage = list-append (h-line "Actions:")
  (list-append (h-line "  hyperactive show NODE ...   a node of the task graph: its statement, what it serves, what serves it")
  (list-append (h-line "  hyperactive tree            the task graph from its roots")
  (list-append (h-line "  hyperactive order           the whole order of work")
  (list-append (h-line "  hyperactive open            what is in progress and what can start now")
  (list-append (h-line "  hyperactive def NAME ...    a definition: its statement, its text, its key, and what uses it")
  (list-append (h-line "  hyperactive write NAME [after OTHER] < DECLARATION   the declaration takes the place of NAME's (or, new, follows OTHER's); kept only if all it touches checks")
  (list-append (h-line "  hyperactive remove NAME      a definition nothing uses taken away, checked the same way")
  (list-append (h-line "  hyperactive history [NAME]  every binding of the name to a key, in the order bound")
  (list-append (h-line "  hyperactive paper [SECTION]  the paper as it reads, whole or one section (4.4, A.1, Part II)")
  (list-append (h-line "  hyperactive check [FILE ...] the machine's verdict on the task graph and the graph's rules, or on each file given")
  (list-append (h-line "  hyperactive decompose FILE   a document decomposed by pulls: a piece and its residual at a time (lib/knowledge.cub)")
  (list-append (h-line "  hyperactive why NAME ... | unexplained [FILE ...] | view [in FILE] [type T] TERM | every | server [PORT] | brunerie | repl | library | etym TEXT")
  (h-line "  hyperactive done            the work is done: the session ends")))))))))))))
-- lines without the empty ones at their end
hy-dt-at : List Word → List (List Word) → List (List Word)
hy-dt-at l nil = if h-null l then nil else cons l nil
hy-dt-at l (cons k r) = cons l (cons k r)
hy-dt : List (List Word) → List (List Word)
hy-dt nil = nil
hy-dt (cons l r) = hy-dt-at l (hy-dt r)
hy-prev : Nat → Nat
hy-prev zero = zero
hy-prev (suc k) = k
-- decomposition: the document's lines (its last newline closes the last line), a part's lines
hy-init : List (List Word) → List (List Word)
hy-init nil = nil
hy-init (cons l nil) = nil
hy-init (cons l (cons k r)) = cons l (hy-init (cons k r))
hy-doc-lines : Sum Unit (List Word) → List (List Word)
hy-doc-lines (inl u) = nil
hy-doc-lines (inr t) = hy-init (h-split #10 t)
hy-take-lines : Nat → List (List Word) → List (List Word)
hy-take-lines zero ls = nil
hy-take-lines (suc k) nil = nil
hy-take-lines (suc k) (cons l r) = cons l (hy-take-lines k r)
-- lines a to b, counted from 1, b included
hy-lines-in : Word → Word → List (List Word) → List (List Word)
hy-lines-in a b ls = hy-take-lines (toNat (wsub (wadd b #1) a)) (h-drop-n (toNat (wsub a #1)) ls)
hy-lines-from : Word → List (List Word) → List (List Word)
hy-lines-from a ls = h-drop-n (toNat (wsub a #1)) ls
hy-marked : List Word → List (List Word) → List Word
hy-marked mk ls = h-concat (list-map (λ l → h-line (list-append mk l)) ls)
hy-numbered : Word → List (List Word) → List Word
hy-numbered k nil = nil
hy-numbered k (cons l r) = list-append (h-line (list-append (h-decimal k) (list-append " " l))) (hy-numbered (wadd k #1) r)
-- the pulls made in this decomposition: one line each, "FROM TO P R", P and R w (as written) or r (re-expressed)
hy-pulls-path : List Word → List Word
hy-pulls-path st = list-append st "/session/decompose-pulls"
hy-self-path : List Word → Nat → List Word → List Word
hy-self-path st i part = list-append st (list-append "/session/decompose-" (list-append (h-decimal (fromNat i)) (list-append "-" part)))
hy-pulls : Sum Unit (List Word) → List (List (List Word))
hy-pulls (inl u) = nil
hy-pulls (inr t) = list-map (h-split #32) (h-lines t)
hy-judge : List Word → List Word
hy-judge what = list-append (h-line (list-append "Read the " (list-append what " alone, as a reader who has seen nothing else of the document. Ensure it is self-contained with any relevant context included: every reference to another part of the document (this, above, these, a label, a section number) resolved to what it refers to, and any context it leans on stated. Add nothing else and drop nothing. Avik's words stay verbatim: give their context around a quotation, never inside it.")))
  (list-append (h-line "  It is self-contained and makes sense:   hyperactive self-contained")
  (h-line (list-append "  It is not; this is its re-expression:   hyperactive re-expressed < THE " (list-append what " RE-EXPRESSED"))))
hy-show-reading : List Word → List (List Word) → Nat → Proc W Unit
hy-show-reading f ls n = h-out (list-append (h-line (list-append "── " (list-append f (list-append ", to decompose " hy-rule))))
  (list-append (hy-numbered #1 ls)
  (list-append (h-line (list-append (h-decimal (fromNat n)) " pulls made in this decomposition."))
  (list-append (h-line "Read all of it. A pull takes one piece, where the meaning makes a unit, one assertion with its evidence, and leaves its residual, the document without it. Pulls are independent: none claims the lines it takes, and a piece may overlap any other.")
  (list-append (h-line "  hyperactive pull FROM TO [FROM TO …]   the lines of the piece: one range, or a subsequence of ranges in order")
  (h-line "  hyperactive finish            the pulls made written beside the document"))))))
hy-nth-w : Nat → List Word → Word
hy-nth-w k nil = #0
hy-nth-w zero (cons x r) = x
hy-nth-w (suc k) (cons x r) = hy-nth-w k r
h-write-flag : List Word → List Word → Proc W Unit
h-write-flag st v = bind (h-write (list-append st "/session/decompose-flag") v) (λ b → ret unit)
-- a judgement recorded: the piece's (stage 0) or the residual's (stage 1) re-expression kept; at the
-- residual, the pull is added to the pulls made
hy-judged : List Word → List (List Word) → List Word → Nat → Proc W Unit
hy-judged st a xy k = bind (h-read (hy-pulls-path st)) (λ pt →
  bind (if h-eq (hy-head a) "re-expressed"
    then bind h-stdin (λ e → bind (h-write (hy-self-path st (list-length (hy-pulls pt)) (if hy-same-nat k zero then "piece" else "residual")) e) (λ b → ret unit))
    else h-unlink (hy-self-path st (list-length (hy-pulls pt)) (if hy-same-nat k zero then "piece" else "residual"))) (λ u →
  if hy-same-nat k zero
  then h-write-flag st (if h-eq (hy-head a) "re-expressed" then "r" else "w")
  else bind (h-read (list-append st "/session/decompose-flag")) (λ pf →
    bind (h-write (hy-pulls-path st) (list-append (hy-or nil pt) (h-line (list-append (hy-sep " " (list-map h-decimal xy))
      (list-append " " (list-append (hy-or "w" pf) (list-append " " (if h-eq (hy-head a) "re-expressed" then "r" else "w")))))))) (λ b → ret unit))))
-- whether line k lies in the ranges of a pull
hy-in : Word → List Word → Bool
hy-in k nil = false
hy-in k (cons x nil) = false
hy-in k (cons x (cons y r)) = if (if wlt k x then false else h-not (wlt y k)) then true else hy-in k r
hy-last-w : List Word → Word
hy-last-w nil = #0
hy-last-w (cons x nil) = x
hy-last-w (cons x (cons y r)) = hy-last-w (cons y r)
-- the lines from the pull's first to its last, those of the piece marked >, those between them ·
hy-piece-lines : Word → Word → List Word → List (List Word) → List Word
hy-piece-lines k e xy nil = nil
hy-piece-lines k e xy (cons l r) = if wlt e k then nil else
  list-append (h-line (list-append (if hy-in k xy then "  > " else "  · ") l)) (hy-piece-lines (wadd k #1) e xy r)
-- the residual: every line not in the piece, a mark where a run of the piece's lines was
hy-residual-lines : Word → Bool → List Word → List (List Word) → List Word
hy-residual-lines k was xy nil = nil
hy-residual-lines k was xy (cons l r) = if hy-in k xy
  then list-append (if was then nil else h-line "  > [the piece's lines were here]") (hy-residual-lines (wadd k #1) true xy r)
  else list-append (h-line (list-append "  > " l)) (hy-residual-lines (wadd k #1) false xy r)
hy-ranges-text : List Word → List Word
hy-ranges-text nil = nil
hy-ranges-text (cons x nil) = nil
hy-ranges-text (cons x (cons y r)) = list-append (h-decimal x) (list-append "–" (list-append (h-decimal y) (if h-null (hy-ranges-text r) then nil else list-append ", " (hy-ranges-text r))))
hy-show-pull : List Word → List Word → Nat → List (List Word) → Proc W Unit
hy-show-pull f xy k ls = if hy-same-nat k zero
  then h-out (list-append (h-line (list-append "── the piece, lines " (list-append (hy-ranges-text xy) (list-append " of " (list-append f (list-append " " hy-rule))))))
    (list-append (if wlt #1 (hy-nth-w zero xy) then list-append (h-line "Before it in the original:") (hy-marked "  | " (hy-lines-in (if wlt #4 (hy-nth-w zero xy) then wsub (hy-nth-w zero xy) #3 else #1) (wsub (hy-nth-w zero xy) #1) ls)) else nil)
    (list-append (list-append (h-line "THE PIECE (> its lines; · lines between them that are not in it):") (hy-piece-lines (hy-nth-w zero xy) (hy-last-w xy) xy (hy-lines-from (hy-nth-w zero xy) ls)))
    (list-append (list-append (h-line "After it in the original:") (hy-marked "  | " (hy-lines-in (wadd (hy-last-w xy) #1) (wadd (hy-last-w xy) #3) ls)))
    (hy-judge "PIECE")))))
  else h-out (list-append (h-line (list-append "── the residual: " (list-append f (list-append " without lines " (list-append (hy-ranges-text xy) (list-append " " hy-rule))))))
    (list-append (h-line "THE RESIDUAL:")
    (list-append (hy-residual-lines #1 false xy ls)
    (hy-judge "RESIDUAL"))))
hy-q : List Word → List Word
hy-q s = cons #34 (list-append s (cons #34 nil))
hy-cons-list : List (List Word) → List Word
hy-cons-list nil = "nil"
hy-cons-list (cons x r) = list-append "(cons " (list-append x (list-append " " (list-append (hy-cons-list r) ")")))
hy-has-byte : Word → List Word → Bool
hy-has-byte b nil = false
hy-has-byte b (cons x r) = if weq x b then true else hy-has-byte b r
hy-lit : List Word → List Word
hy-lit l = if hy-has-byte #34 l then list-append "(quoted " (list-append (hy-cons-list (list-map hy-q (h-split #34 l))) ")") else hy-q l
hy-lines-term : List (List Word) → List Word
hy-lines-term ls = hy-cons-list (list-map hy-lit ls)
-- the byte at which line k (counted from 1) begins
hy-offset : Word → List (List Word) → Word
hy-offset k nil = #0
hy-offset k (cons l r) = if weq k #1 then #0 else wadd (wadd (fromNat (list-length l)) #1) (hy-offset (wsub k #1) r)
hy-as-term : List Word → Sum Unit (List Word) → List Word
hy-as-term flag (inl u) = "as-written"
hy-as-term flag (inr t) = if h-eq flag "r" then list-append "(restated (unlines " (list-append (hy-lines-term (hy-dt (h-split #10 t))) "))") else "as-written"
hy-pred2 : Nat → Nat
hy-pred2 zero = zero
hy-pred2 (suc zero) = zero
hy-pred2 (suc (suc k)) = k
hy-nums : List (List Word) → List (List Word)
hy-nums p = hy-take-lines (hy-pred2 (list-length p)) p
hy-spans-term : List (List Word) → List (List Word) → List Word
hy-spans-term ls nil = "nil"
hy-spans-term ls (cons x nil) = "nil"
hy-spans-term ls (cons x (cons y r)) = list-append "(cons (span #" (list-append (h-decimal (hy-offset (h-number x) ls)) (list-append " #"
  (list-append (h-decimal (hy-offset (wadd (h-number y) #1) ls)) (list-append ") " (list-append (hy-spans-term ls r) ")")))))
hy-pull-decl : List Word → List Word → List (List Word) → List (List Word) → Sum Unit (List Word) → Sum Unit (List Word) → List Word
hy-pull-decl stem nm ls p ps rs = list-append (h-line (list-append nm " : Pull"))
  (h-line (list-append nm (list-append " = pull " (list-append stem (list-append "-source (whole " (list-append stem (list-append "-source) "
    (list-append (hy-spans-term ls (hy-nums p)) (list-append " " (list-append (hy-as-term (hy-head (h-drop-n (hy-pred2 (list-length p)) p)) ps)
    (list-append " " (hy-as-term (hy-second (h-drop-n (hy-pred2 (list-length p)) p)) rs))))))))))))
hy-pull-decls : List Word → List Word → List Word → List (List Word) → List (List (List Word)) → Nat → Proc W (List Word)
hy-pull-decls st stem tag ls nil i = ret nil
hy-pull-decls st stem tag ls (cons p r) i = bind (h-read (hy-self-path st i "piece")) (λ ps → bind (h-read (hy-self-path st i "residual")) (λ rs →
  bind (hy-pull-decls st stem tag ls r (suc i)) (λ rest → ret (list-append (hy-pull-decl stem (list-append stem (list-append "-pull-" (list-append tag (list-append "-" (h-decimal (fromNat (suc i))))))) ls p ps rs) rest))))
hy-ups : List Word → List Word
hy-ups nil = nil
hy-ups (cons x r) = if weq x #47 then list-append "../" (hy-ups r) else hy-ups r
hy-base : List Word → List Word
hy-base f = h-before ".cub" (h-before ".md" (hy-last (h-split #47 f)))
-- the document of a decomposition: the file itself, or a decomposed one's source, written out by the machine
hy-source-probe : List Word → List Word
hy-source-probe f = list-append (h-line (list-append "import " (hy-q (list-append "../" f))))
  (list-append (h-line (list-append "import " (hy-q "../lib/host.cub")))
  (list-append (h-line "hy-source-out : Step W Unit")
  (list-append (h-line (list-append "hy-source-out = to-step (bind (h-write " (list-append (hy-q "build/decompose-source") (list-append " " (list-append (hy-base f) "-source) (λ b → exit #0))")))))
  (h-line "#run hy-source-out"))))
hy-doc : List Word → List Word → Proc W (Sum Unit (List Word))
hy-doc m f = if h-ends ".cub" f
  then bind (h-write "build/decompose-probe.cub" (hy-source-probe f)) (λ b → bind (h-capture (cons m (cons "build/decompose-probe.cub" nil))) (λ r → h-read "build/decompose-source"))
  else h-read f
-- finish: a document becomes a decomposed one (its source the document, checked equal, the file removed); a
-- decomposed one gains the pulls made, appended
hy-new-text : List Word → List Word → List (List Word) → List Word → List Word
hy-new-text f title ls decls =
  list-append (h-line (list-append "-- " (list-append (h-before ".md" f) (list-append ".cub — " title))))
  (list-append (h-line "-- decomposed with hyperactive decompose (lib/knowledge.cub): the document once, as its source, and pulls from it.")
  (list-append (h-line (list-append "import " (hy-q (list-append (hy-ups f) "lib/knowledge.cub"))))
  (list-append (h-line (list-append (hy-base f) "-source : List Word"))
  (list-append (h-line (list-append (hy-base f) (list-append "-source = lines-of " (hy-lines-term ls))))
  decls))))
hy-check-source : List Word → List Word
hy-check-source f = list-append (h-line (list-append "import " (hy-q (list-append "../" (list-append (h-before ".md" f) ".cub")))))
  (h-line (list-append "#same " (list-append (hy-base f) (list-append "-source = text " (hy-q (list-append "../" f))))))
hy-checked-ok : List Word → Bool
hy-checked-ok out = if hy-complete (h-lines out) then h-not (orB (h-infix "FAIL: " out) (h-infix "error" out)) else false
hy-finished : List Word → List Word → Bool → Proc W Unit
hy-finished f out true = bind (h-unlink f) (λ u → h-out (h-line (list-append f (list-append " is now " (list-append (h-before ".md" f) ".cub: its source, checked equal to the file, which is removed, and the pulls made. Point what referred to the file at the source.")))))
hy-finished f out false = h-out (list-append (h-line (list-append (h-before ".md" f) ".cub was written, but its source is not the document exactly; the document is kept:")) out)
hy-finish : List Word → List Word → List Word → Proc W Unit
hy-finish st m f = bind (hy-doc m f) (λ t → bind (h-read (hy-pulls-path st)) (λ pt → bind (sys-call #201 #0 #0 #0 #0 #0 #0) (λ now →
  bind (hy-pull-decls st (hy-base f) (h-decimal now) (hy-doc-lines t) (hy-pulls pt) zero) (λ decls →
  if h-ends ".cub" f
  then bind (h-read f) (λ old → bind (h-write f (list-append (hy-or nil old) decls)) (λ b → h-out (h-line (list-append f ": the pulls made are appended."))))
  else bind (h-write (list-append (h-before ".md" f) ".cub") (hy-new-text f (hy-first-line (hy-or nil t)) (hy-doc-lines t) decls)) (λ b →
    bind (h-write "build/decompose-probe.cub" (hy-check-source f)) (λ b2 →
    bind (h-capture (cons m (cons "--read" (cons "build/decompose-probe.cub" nil)))) (λ r → hy-finished f (snd r) (hy-checked-ok (snd r)))))))))
hy-reading-view : List Word → Sum Unit (List Word) → Sum Unit (List Word) → Proc W Unit
hy-reading-view f t pt = hy-show-reading f (hy-doc-lines t) (list-length (hy-pulls pt))
hy-pull-view : List Word → List Word → Nat → Sum Unit (List Word) → Proc W Unit
hy-pull-view f xy k t = hy-show-pull f xy k (hy-doc-lines t)
hy-show : List Word → List Word → Nat → HyState → Proc W Unit
hy-show st m n (hy-walking k) = bind (hy-get st (list-append "walk/" (h-decimal (fromNat k)))) (hy-show-chunk k n)
hy-show st m n hy-working = bind (hy-view st m "open") (λ u → h-out (list-append (cons #10 nil) hy-work-usage))
hy-show st m n (hy-reading f) = bind (hy-doc m f) (λ t → bind (h-read (hy-pulls-path st)) (hy-reading-view f t))
hy-show st m n (hy-decomposing f xy k) = bind (hy-doc m f) (hy-pull-view f xy k)
-- a working action performed
hy-act : List Word → List Word → List (List Word) → Proc W Unit
hy-act st m nil = ret unit
hy-act st m (cons c rest) =
  if h-eq c "def" then hy-def st rest else
  if h-eq c "write" then bind h-stdin (hy-write st m rest) else
  if h-eq c "remove" then hy-remove st m rest else
  if h-eq c "history" then hy-history st rest else
  if h-eq c "paper" then hy-paper st m rest else
  if h-eq c "check" then hy-check st m rest else
  if h-eq c "done" then bind (h-write (list-append st "/session/log") nil) (λ b → h-out (h-line "The work is declared done; the session is over. The next session begins with the walk."))
  else if h-has c hy-bridge-words then hy-bridge st m c rest
  else hy-views st m (cons c rest)

-- one call: the action taken when valid, then what the state reached shows
hy-log-lines : Sum Unit (List Word) → List (List Word)
hy-log-lines (inl u) = nil
hy-log-lines (inr t) = h-lines t
-- the state before the action (s) and after it: decompose begins with no pulls made; a judgement is
-- recorded; finish writes the pulls
hy-recorded : List Word → List (List Word) → HyState → Proc W Unit
hy-recorded st a (hy-decomposing f xy k) = hy-judged st a xy k
hy-recorded st a (hy-walking k) = ret unit
hy-recorded st a hy-working = bind (h-write (hy-pulls-path st) nil) (λ b → ret unit)
hy-recorded st a (hy-reading f) = ret unit
hy-working-after : List Word → List Word → Nat → List (List Word) → HyState → Proc W Unit
hy-working-after st m n a (hy-reading f) = hy-finish st m f
hy-working-after st m n a (hy-walking k) = if h-has (hy-head a) (cons "next" (cons "prev" nil)) then hy-show st m n hy-working else hy-act st m a
hy-working-after st m n a hy-working = if h-has (hy-head a) (cons "next" (cons "prev" nil)) then hy-show st m n hy-working else hy-act st m a
hy-working-after st m n a (hy-decomposing f xy k) = hy-act st m a
hy-after : List Word → List Word → Nat → List (List Word) → HyState → HyState → Proc W Unit
hy-after st m n a s (hy-walking k) = hy-show st m n (hy-walking k)
hy-after st m n a s hy-working = hy-working-after st m n a s
hy-after st m n a s (hy-reading f) = bind (hy-recorded st a s) (λ u → hy-show st m n (hy-reading f))
hy-after st m n a s (hy-decomposing f xy k) = bind (hy-recorded st a s) (λ u → hy-show st m n (hy-decomposing f xy k))
hy-took : List Word → List Word → Nat → List (List Word) → List (List Word) → HyState → Sum Unit HyState → Proc W Unit
hy-took st m n log a s (inl u) = bind (h-out (h-line (h-line (list-append "Not an action here: hyperactive " (hy-sep " " a))))) (λ u2 → hy-show st m n s)
hy-took st m n log a s (inr t) =
  bind (h-write (list-append st "/session/log") (h-concat (list-map h-line (list-append log (cons (hy-sep " " a) nil))))) (λ b →
  hy-after st m n a s t)
hy-take-at : List Word → List Word → Nat → List (List Word) → List (List Word) → HyState → Proc W Unit
hy-take-at st m n log nil s = hy-show st m n s
hy-take-at st m n log (cons c rest) s = hy-took st m n log (cons c rest) s (hy-step n s (cons c rest))
hy-take : List Word → List Word → Nat → List (List Word) → List (List Word) → Proc W Unit
hy-take st m n log a = hy-take-at st m n log a (hy-fold n (hy-walking (suc zero)) log)
-- the walk's chunks made fresh whenever the session is on its walk
hy-walk-ready-at : List Word → List Word → HyState → Proc W Unit
hy-walk-ready-at st m (hy-walking k) = hy-walk-fresh st m
hy-walk-ready-at st m hy-working = ret unit
hy-walk-ready-at st m (hy-reading f) = ret unit
hy-walk-ready-at st m (hy-decomposing f xy k) = ret unit
hy-walk-ready : List Word → List Word → List (List Word) → Proc W Unit
hy-walk-ready st m log = bind (hy-count st) (λ n → hy-walk-ready-at st m (hy-fold n (hy-walking (suc zero)) log))
hy-begin : List Word → List Word → List (List Word) → Proc W Unit
hy-begin st m a =
  bind (h-run (cons "/usr/bin/env" (cons "git" (cons "config" (cons "core.hooksPath" (cons ".githooks" nil)))))) (λ g →
  bind (h-mkdir st) (λ u → bind (h-mkdir (list-append st "/session")) (λ u2 →
  bind (hy-get st "session/log") (λ l →
  bind (hy-walk-ready st m (hy-log-lines l)) (λ u3 →
  bind (hy-count st) (λ n →
  bind (hy-take st m n (hy-log-lines l) a) (λ u4 → exit #0)))))))
hy-main : Proc W Unit
hy-main = bind (h-env "CUBICAL_STORE") (λ e → bind h-args (λ args → hy-begin (h-store-of e) (hy-machine args) (h-drop-n (suc (suc zero)) args)))
hy-run : Step W Unit
hy-run = to-step hy-main
#run hy-run
