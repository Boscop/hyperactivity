-- lib/linproof.cub — the linear-arithmetic certificate checker, verified (plan 18.13, F32).
-- Loaded after lib/std.cub. The checker of lib/lin.cub works over codes; here the same algorithm
-- is defined over a typed fragment and its soundness is a theorem: equal normal forms denote
-- equal words. The elaborator's bridge from a code to the typed fragment is lib/lin.cub's
-- linearize, the same function over codes. Words: plusw is addition by recursion (lib/std.cub),
-- equal to the machine's wadd (plusw≡wadd).
-- Each step of an induction is its own lemma with a signature: the elaborator determines the
-- implicit endpoints of a composed path from a signature, not from a motive applied inside a
-- step function (an E28 item).
-- ---------------------------------------------------------------- word laws
catw : {x y z : Word} → x ≡ y → y ≡ z → x ≡ z
catw p q = λ i → comp (λ j → Word) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)
symw : {x y : Word} → x ≡ y → y ≡ x
symw p = λ i → p (~ i)
-- paths under functions: the endpoints come from the argument path's type, which is what lets a
-- composed path be checked when the argument is a lemma at open words (a λ i → f (p i) written
-- in an argument position has its endpoints evaluated instead, and a lemma's endpoint at an open
-- word is only propositionally its type's)
congw : (f : Word → Word) → {a b : Word} → a ≡ b → f a ≡ f b
congw f p = λ i → f (p i)
cong2w : (f : Word → Word → Word) → {a b c d : Word} → a ≡ b → c ≡ d → f a c ≡ f b d
cong2w f p q = λ i → f (p i) (q i)
plusw-zero-l : (b : Word) → plusw #0 b ≡ b
plusw-zero-l b = %welimP (λ v → plusw #0 v ≡ v) b (λ i → #0) (λ n h i → %wsucc (h i))
plusw-zero-r : (a : Word) → plusw a #0 ≡ a
plusw-zero-r a = λ i → a
plusw-suc-l : (a b : Word) → plusw (%wsucc a) b ≡ %wsucc (plusw a b)
plusw-suc-l a b = %welimP (λ v → plusw (%wsucc a) v ≡ %wsucc (plusw a v)) b (λ i → %wsucc a) (λ n h i → %wsucc (h i))
plusw-comm-step : (b n : Word) → plusw n b ≡ plusw b n → plusw (%wsucc n) b ≡ plusw b (%wsucc n)
plusw-comm-step b n h = catw (plusw-suc-l n b) (congw (λ z → %wsucc z) h)
plusw-comm : (a b : Word) → plusw a b ≡ plusw b a
plusw-comm a b = %welimP (λ v → plusw v b ≡ plusw b v) a (plusw-zero-l b) (λ n h → plusw-comm-step b n h)
plusw-assoc : (a b c : Word) → plusw (plusw a b) c ≡ plusw a (plusw b c)
plusw-assoc a b c =
  %welimP (λ v → plusw (plusw a b) v ≡ plusw a (plusw b v)) c (λ i → plusw a b) (λ n h i → %wsucc (h i))
-- a + (b + c) = b + (a + c)
plusw-mid : (a b c : Word) → plusw a (plusw b c) ≡ plusw b (plusw a c)
plusw-mid a b c =
  catw (symw (plusw-assoc a b c)) (catw (congw (λ z → plusw z c) (plusw-comm a b)) (plusw-assoc b a c))
-- multiplication by recursion on the first argument
mulw : Word → Word → Word
mulw c x = %welimP (λ v → Word) c #0 (λ n h → plusw h x)
mulw-dist-step : (c x n : Word) → mulw (plusw c n) x ≡ plusw (mulw c x) (mulw n x) →
                 mulw (plusw c (%wsucc n)) x ≡ plusw (mulw c x) (mulw (%wsucc n) x)
mulw-dist-step c x n h = catw (congw (λ z → plusw z x) h) (plusw-assoc (mulw c x) (mulw n x) x)
mulw-dist : (c d x : Word) → mulw (plusw c d) x ≡ plusw (mulw c x) (mulw d x)
mulw-dist c d x =
  %welimP (λ v → mulw (plusw c v) x ≡ plusw (mulw c x) (mulw v x)) d (λ i → mulw c x) (λ n h → mulw-dist-step c x n h)
-- equality of words from the machine's test: eqw (by induction, lib/std.cub) is weq, and eqw true
-- means equal, by double induction
symb : {a b : Bool} → a ≡ b → b ≡ a
symb p = λ i → p (~ i)
false≢true : Path Bool false true → Empty
false≢true p = true≢false (symb p)
eqw-sound-step : (n : Word) → ((b : Word) → eqw n b ≡ true → n ≡ b) →
                 (b : Word) → eqw (%wsucc n) b ≡ true → %wsucc n ≡ b
eqw-sound-step n h b =
  %welimP (λ v → eqw (%wsucc n) v ≡ true → %wsucc n ≡ v) b
    (λ p → Empty-rec {lzero} {%wsucc n ≡ #0} (false≢true p))
    (λ m g p → congw (λ z → %wsucc z) (h m p))
eqw-sound : (a b : Word) → eqw a b ≡ true → a ≡ b
eqw-sound a =
  %welimP (λ v → (b : Word) → eqw v b ≡ true → v ≡ b) a
    (λ b → %welimP (λ w → eqw #0 w ≡ true → #0 ≡ w) b (λ p i → #0) (λ m g p → Empty-rec {lzero} {#0 ≡ %wsucc m} (false≢true p)))
    eqw-sound-step
catw2 : {x y z : Bool} → x ≡ y → y ≡ z → x ≡ z
catw2 p q = λ i → comp (λ j → Bool) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)
weq-sound : (a b : Word) → weq a b ≡ true → a ≡ b
weq-sound a b p = eqw-sound a b (catw2 (eqw≡weq a b) p)
-- ---------------------------------------------------------------- the fragment and its value
data LinCode = lc-lit (n : Word) | lc-var (v : Word) | lc-add (a : LinCode) (b : LinCode) | lc-suc (a : LinCode)
Env : Type
Env = Word → Word
wev : Env → LinCode → Word
wev e c =
  case c return (λ w → Word) of
    lc-lit n → n
    lc-var v → e v
    lc-add a b → plusw (rec a) (rec b)
    lc-suc a → %wsucc (rec a)
-- ---------------------------------------------------------------- normal forms and their value
data Coefs = cnil | ccons (v : Word) (c : Word) (rest : Coefs)
data LinT = lint (k : Word) (cs : Coefs)
csem : Env → Coefs → Word
csem e cs =
  case cs return (λ w → Word) of
    cnil → #0
    ccons v c r → plusw (mulw c (e v)) (rec r)
lsem : Env → LinT → Word
lsem e f = case f return (λ w → Word) of lint k cs → plusw k (csem e cs)
-- inserting a coefficient into a sorted list: added to the variable's entry if present, else
-- placed in order; a merge is the fold of insertions (structural recursion on each argument)
ins-case : Bool → Bool → Word → Word → Word → Word → Coefs → Coefs → Coefs
ins-case eq lt v c v2 c2 r2 ir =
  case eq return (λ w → Coefs) of
    true → ccons v2 (plusw c c2) r2
    false → (case lt return (λ w → Coefs) of true → ccons v c (ccons v2 c2 r2); false → ccons v2 c2 ir)
insert : Word → Word → Coefs → Coefs
insert v c ds =
  case ds return (λ w → Coefs) of
    cnil → ccons v c cnil
    ccons v2 c2 r2 → ins-case (weq v v2) (%wlt v v2) v c v2 c2 r2 (rec r2)
coef-add : Coefs → Coefs → Coefs
coef-add cs ds =
  case cs return (λ w → Coefs) of
    cnil → ds
    ccons v c r → insert v c (rec r)
lin-add : LinT → LinT → LinT
lin-add f g =
  case f return (λ w → LinT) of
    lint k cs → (case g return (λ w → LinT) of lint m ds → lint (plusw k m) (coef-add cs ds))
normalize : LinCode → LinT
normalize c =
  case c return (λ w → LinT) of
    lc-lit n → lint n cnil
    lc-var v → lint #0 (ccons v #1 cnil)
    lc-add a b → lin-add (rec a) (rec b)
    lc-suc a → lin-add (lint #1 cnil) (rec a)
-- ---------------------------------------------------------------- soundness of the normal form
-- an insertion adds c·x to the value: by induction on the list; the three branches are lemmas
ins-lt : (e : Env) (v c : Word) (ds : Coefs) → csem e (ccons v c ds) ≡ plusw (mulw c (e v)) (csem e ds)
ins-lt e v c ds = λ i → plusw (mulw c (e v)) (csem e ds)
ins-gt : (e : Env) (v c v2 c2 : Word) (r2 ir : Coefs) →
         csem e ir ≡ plusw (mulw c (e v)) (csem e r2) →
         plusw (mulw c2 (e v2)) (csem e ir) ≡ plusw (mulw c (e v)) (plusw (mulw c2 (e v2)) (csem e r2))
ins-gt e v c v2 c2 r2 ir h = catw (congw (λ z → plusw (mulw c2 (e v2)) z) h) (plusw-mid (mulw c2 (e v2)) (mulw c (e v)) (csem e r2))
ins-same : (e : Env) (v v2 c c2 : Word) (r2 : Coefs) → v ≡ v2 →
           plusw (mulw (plusw c c2) (e v2)) (csem e r2) ≡ plusw (mulw c (e v)) (plusw (mulw c2 (e v2)) (csem e r2))
ins-same e v v2 c c2 r2 q =
  catw (congw (λ z → plusw z (csem e r2)) (mulw-dist c c2 (e v2)))
    (catw (plusw-assoc (mulw c (e v2)) (mulw c2 (e v2)) (csem e r2))
      (congw (λ z → plusw (mulw c z) (plusw (mulw c2 (e v2)) (csem e r2))) (symw (congw e q))))
ins-case-sound : (e : Env) (eq lt : Bool) (v c v2 c2 : Word) (r2 ir : Coefs) →
                 weq v v2 ≡ eq →
                 csem e ir ≡ plusw (mulw c (e v)) (csem e r2) →
                 csem e (ins-case eq lt v c v2 c2 r2 ir) ≡ plusw (mulw c (e v)) (csem e (ccons v2 c2 r2))
ins-case-sound e eq lt v c v2 c2 r2 ir pe h =
  case eq return (λ b → weq v v2 ≡ b → csem e (ins-case b lt v c v2 c2 r2 ir) ≡ plusw (mulw c (e v)) (csem e (ccons v2 c2 r2))) of
    true → λ pe2 → ins-same e v v2 c c2 r2 (weq-sound v v2 pe2)
    false → λ pe2 →
      (case lt return (λ b → csem e (ins-case false b v c v2 c2 r2 ir) ≡ plusw (mulw c (e v)) (csem e (ccons v2 c2 r2))) of
         true → ins-lt e v c (ccons v2 c2 r2)
         false → ins-gt e v c v2 c2 r2 ir h)
  pe
insert-sound : (e : Env) (v c : Word) (ds : Coefs) → csem e (insert v c ds) ≡ plusw (mulw c (e v)) (csem e ds)
insert-sound e v c ds =
  case ds return (λ w → csem e (insert v c w) ≡ plusw (mulw c (e v)) (csem e w)) of
    cnil → λ i → plusw (mulw c (e v)) #0
    ccons v2 c2 r2 → ins-case-sound e (weq v v2) (%wlt v v2) v c v2 c2 r2 (insert v c r2) (λ i → weq v v2) (rec r2)
-- the value of a merge is the sum of the values
csem-add-step : (e : Env) (v c : Word) (r ds : Coefs) →
                csem e (coef-add r ds) ≡ plusw (csem e r) (csem e ds) →
                csem e (insert v c (coef-add r ds)) ≡ plusw (plusw (mulw c (e v)) (csem e r)) (csem e ds)
csem-add-step e v c r ds h =
  catw (insert-sound e v c (coef-add r ds))
    (catw (congw (λ z → plusw (mulw c (e v)) z) h) (symw (plusw-assoc (mulw c (e v)) (csem e r) (csem e ds))))
csem-add : (e : Env) (cs ds : Coefs) → csem e (coef-add cs ds) ≡ plusw (csem e cs) (csem e ds)
csem-add e cs ds =
  case cs return (λ w → csem e (coef-add w ds) ≡ plusw (csem e w) (csem e ds)) of
    cnil → symw (plusw-zero-l (csem e ds))
    ccons v c r → csem-add-step e v c r ds (rec r)
lsem-add-body : (e : Env) (k : Word) (cs : Coefs) (m : Word) (ds : Coefs) →
                plusw (plusw k m) (csem e (coef-add cs ds)) ≡ plusw (plusw k (csem e cs)) (plusw m (csem e ds))
lsem-add-body e k cs m ds =
  catw (congw (λ z → plusw (plusw k m) z) (csem-add e cs ds))
    (catw (plusw-assoc k m (plusw (csem e cs) (csem e ds)))
      (catw (congw (λ z → plusw k z) (plusw-mid m (csem e cs) (csem e ds)))
        (symw (plusw-assoc k (csem e cs) (plusw m (csem e ds))))))
lsem-add : (e : Env) (f g : LinT) → lsem e (lin-add f g) ≡ plusw (lsem e f) (lsem e g)
lsem-add e f g =
  case f return (λ w → lsem e (lin-add w g) ≡ plusw (lsem e w) (lsem e g)) of
    lint k cs →
      (case g return (λ w → lsem e (lin-add (lint k cs) w) ≡ plusw (lsem e (lint k cs)) (lsem e w)) of
         lint m ds → lsem-add-body e k cs m ds)
-- the normal form denotes the code's value
norm-var : (e : Env) (v : Word) → plusw #0 (plusw (mulw #1 (e v)) #0) ≡ e v
norm-var e v = catw (plusw-zero-l (plusw (mulw #1 (e v)) #0)) (plusw-zero-l (e v))
norm-add : (e : Env) (a b : LinCode) → lsem e (normalize a) ≡ wev e a → lsem e (normalize b) ≡ wev e b →
           lsem e (normalize (lc-add a b)) ≡ wev e (lc-add a b)
norm-add e a b ha hb = catw (lsem-add e (normalize a) (normalize b)) (cong2w (λ z w → plusw z w) ha hb)
norm-suc : (e : Env) (a : LinCode) → lsem e (normalize a) ≡ wev e a → lsem e (normalize (lc-suc a)) ≡ wev e (lc-suc a)
norm-suc e a ha =
  catw (lsem-add e (lint #1 cnil) (normalize a))
    (catw (congw (λ z → plusw #1 z) ha)
      (catw (plusw-suc-l #0 (wev e a)) (congw (λ z → %wsucc z) (plusw-zero-l (wev e a)))))
norm-sound : (e : Env) (c : LinCode) → lsem e (normalize c) ≡ wev e c
norm-sound e c =
  case c return (λ w → lsem e (normalize w) ≡ wev e w) of
    lc-lit n → λ i → n
    lc-var v → norm-var e v
    lc-add a b → norm-add e a b (rec a) (rec b)
    lc-suc a → norm-suc e a (rec a)
-- ---------------------------------------------------------------- deciding equality
-- two codes with the same normal form denote the same word, in every environment
conglw : (e : Env) → {f g : LinT} → f ≡ g → lsem e f ≡ lsem e g
conglw e p = λ i → lsem e (p i)
same-norm-eq : (e : Env) (a b : LinCode) → normalize a ≡ normalize b → wev e a ≡ wev e b
same-norm-eq e a b p = catw (symw (norm-sound e a)) (catw (conglw e p) (norm-sound e b))
-- readings: x + (1 + x) and (x + x) + 1 normalize alike and so agree at any environment
ex1 = lc-add (lc-var #0) (lc-suc (lc-var #0))
ex2 = lc-add (lc-add (lc-var #0) (lc-var #0)) (lc-lit #1)
#same normalize ex1 = lint #1 (ccons #0 #2 cnil)
#same normalize ex2 = lint #1 (ccons #0 #2 cnil)
#same wev (λ v → #7) ex1 = #15
#same wev (λ v → #7) ex2 = #15
