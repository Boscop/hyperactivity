; sort.ctt — 9.15: the declaration Σ[B] (B a rearrangement of X) × Sorted B over a type with a
; total order, posed with the identities a finite bag has and normalized: the elimination of X,
; whose ∪ branch is merge. A bag is the free commutative monoid on the type (∪ with units,
; associativity and commutativity as path constructors); a rearrangement is equality of
; multiplicities, counted with the equality the order decides (x = y when x ≤ y and y ≤ x);
; Sorted is 9.6's. The elements are only ever arguments of the comparator.
; Loaded after lib/std.ctt. Instances and runs are in tests/sort.ctt.

; ---------------------------------------------------------------- a type with a total order
(checked TotalOrder (Pi ((A U) (le (Pi ((x A) (y A)) Bool))) U)
  (lam A le
    (Sigma r (Pi x A (isTrue (le x x)))
    (Sigma t (Pi ((x A) (y A) (e (PathP (plam i Bool) (le x y) false))) (isTrue (le y x)))
    (Sigma c (Pi ((x A) (y A) (z A) (p (isTrue (le x y))) (q (isTrue (le y z)))) (isTrue (le x z)))
      (Pi ((x A) (y A) (p (isTrue (le x y))) (q (isTrue (le y x)))) (PathP (plam i A) x y)))))))
(checked Ord (U 1) (Sigma A U (Sigma le (Pi ((x A) (y A)) Bool) (TotalOrder A le))))
(checked mkOrd (Pi ((A U) (le (Pi ((x A) (y A)) Bool)) (t (TotalOrder A le))) Ord) (lam A le t (pair A (pair le t))))
(checked El (Pi o Ord U) (lam o (fst o)))
(checked leq (Pi ((o Ord) (x (El o)) (y (El o))) Bool) (lam o (fst (snd o))))
(checked ord-refl (Pi ((o Ord) (x (El o))) (isTrue (leq o x x))) (lam o (fst (snd (snd o)))))
(checked ord-total (Pi ((o Ord) (x (El o)) (y (El o)) (e (PathP (plam i Bool) (leq o x y) false))) (isTrue (leq o y x)))
  (lam o (fst (snd (snd (snd o))))))
(checked ord-trans (Pi ((o Ord) (x (El o)) (y (El o)) (z (El o)) (p (isTrue (leq o x y))) (q (isTrue (leq o y z)))) (isTrue (leq o x z)))
  (lam o (fst (snd (snd (snd (snd o)))))))
(checked ord-antisym (Pi ((o Ord) (x (El o)) (y (El o)) (p (isTrue (leq o x y))) (q (isTrue (leq o y x)))) (PathP (plam i (El o)) x y))
  (lam o (snd (snd (snd (snd (snd o)))))))
; the equality the order decides
(checked eqo (Pi ((o Ord) (x (El o)) (y (El o))) Bool) (lam o x y (andB (leq o x y) (leq o y x))))
(checked eqo-sound (Pi ((o Ord) (x (El o)) (y (El o)) (h (isTrue (eqo o x y)))) (PathP (plam i (El o)) x y))
  (lam o x y h (ord-antisym o x y (and-fst (leq o x y) (leq o y x) h) (and-snd (leq o x y) (leq o y x) h))))
(checked eqo-refl (Pi ((o Ord) (x (El o))) (isTrue (eqo o x x)))
  (lam o x (and-intro (leq o x x) (leq o x x) (ord-refl o x) (ord-refl o x))))

; ---------------------------------------------------------------- lists: multiplicity, order, merge
(checked one-if (Pi b Bool Nat) (lam b (if b (suc zero) zero)))
(checked count (Pi ((o Ord) (a (El o)) (l (List (El o)))) Nat)
  (lam o a l (case l ((nil) zero) ((cons x r) (plus (one-if (eqo o a x)) (rec r))))))
(checked AllLe (Pi ((o Ord) (y (El o)) (l (List (El o)))) U)
  (lam o y l (case l ((nil) Unit) ((cons x r) (Sigma h (isTrue (leq o y x)) (rec r))))))
; 9.6: sortedness is the head below every element of the tail, and the tail sorted
(checked Sorted (Pi ((o Ord) (l (List (El o)))) U)
  (lam o l (case l ((nil) Unit) ((cons x r) (Sigma h (AllLe o x r) (rec r))))))
; merge is sortedness unfolded
(checked merge (Pi ((o Ord) (xs (List (El o))) (ys (List (El o)))) (List (El o)))
  (lam o xs (elim (lam w (Pi ys (List (El o)) (List (El o)))) xs
    ((nil) (lam ys ys))
    ((cons x xs1) (lam ys (elim (lam w (List (El o))) ys
        ((nil) (cons x xs1))
        ((cons y ys1) (if (leq o x y) (cons x ((rec xs1) (cons y ys1))) (cons y (rec ys1))))))))))
(checked merge-count (Pi ((o Ord) (a (El o)) (xs (List (El o))) (ys (List (El o))))
    (PathP (plam i Nat) (count o a (merge o xs ys)) (plus (count o a xs) (count o a ys))))
  (lam o a xs (elim (lam w (Pi ys (List (El o)) (PathP (plam i Nat) (count o a (merge o w ys)) (plus (count o a w) (count o a ys))))) xs
    ((nil) (lam ys (plam i (count o a ys))))
    ((cons x xs1) (lam ys (elim (lam w (PathP (plam i Nat) (count o a (merge o (cons x xs1) w)) (plus (count o a (cons x xs1)) (count o a w)))) ys
       ((nil) (symN (plus (count o a (cons x xs1)) zero) (count o a (cons x xs1)) (plus-zero (count o a (cons x xs1)))))
       ((cons y ys1)
         (elim (lam bb (PathP (plam i Nat) (count o a (if bb (cons x (merge o xs1 (cons y ys1))) (cons y (merge o (cons x xs1) ys1))))
                                            (plus (count o a (cons x xs1)) (count o a (cons y ys1)))))
               (leq o x y)
           ((true) (transN (plus (one-if (eqo o a x)) (count o a (merge o xs1 (cons y ys1))))
                           (plus (one-if (eqo o a x)) (plus (count o a xs1) (count o a (cons y ys1))))
                           (plus (plus (one-if (eqo o a x)) (count o a xs1)) (count o a (cons y ys1)))
                     (congN (plus (one-if (eqo o a x))) (count o a (merge o xs1 (cons y ys1))) (plus (count o a xs1) (count o a (cons y ys1)))
                            ((rec xs1) (cons y ys1)))
                     (symN (plus (plus (one-if (eqo o a x)) (count o a xs1)) (count o a (cons y ys1)))
                           (plus (one-if (eqo o a x)) (plus (count o a xs1) (count o a (cons y ys1))))
                           (plus-assoc (one-if (eqo o a x)) (count o a xs1) (count o a (cons y ys1))))))
           ((false) (transN (plus (one-if (eqo o a y)) (count o a (merge o (cons x xs1) ys1)))
                            (plus (one-if (eqo o a y)) (plus (count o a (cons x xs1)) (count o a ys1)))
                            (plus (count o a (cons x xs1)) (plus (one-if (eqo o a y)) (count o a ys1)))
                      (congN (plus (one-if (eqo o a y))) (count o a (merge o (cons x xs1) ys1)) (plus (count o a (cons x xs1)) (count o a ys1))
                             (rec ys1))
                      (plus-comm-mid (one-if (eqo o a y)) (count o a (cons x xs1)) (count o a ys1))))))))))))
(checked allle-trans (Pi ((o Ord) (x (El o)) (y (El o)) (h (isTrue (leq o x y))) (l (List (El o))) (a (AllLe o y l))) (AllLe o x l))
  (lam o x y h l (elim (lam w (Pi a (AllLe o y w) (AllLe o x w))) l
    ((nil) (lam a unit))
    ((cons z r) (lam a (pair (ord-trans o x y z h (fst a)) ((rec r) (snd a))))))))
(checked merge-allle (Pi ((o Ord) (z (El o)) (xs (List (El o))) (ys (List (El o))) (a (AllLe o z xs)) (b (AllLe o z ys)))
    (AllLe o z (merge o xs ys)))
  (lam o z xs (elim (lam w (Pi ((ys (List (El o))) (a (AllLe o z w)) (b (AllLe o z ys))) (AllLe o z (merge o w ys)))) xs
    ((nil) (lam ys a b b))
    ((cons x xs1) (lam ys (elim (lam w (Pi ((a (AllLe o z (cons x xs1))) (b (AllLe o z w))) (AllLe o z (merge o (cons x xs1) w)))) ys
       ((nil) (lam a b a))
       ((cons y ys1) (lam a b
         (elim (lam bb (AllLe o z (if bb (cons x (merge o xs1 (cons y ys1))) (cons y (merge o (cons x xs1) ys1))))) (leq o x y)
           ((true) (pair (fst a) ((rec xs1) (cons y ys1) (snd a) b)))
           ((false) (pair (fst b) ((rec ys1) a (snd b)))))))))))))
(checked merge-sorted (Pi ((o Ord) (xs (List (El o))) (ys (List (El o))) (sx (Sorted o xs)) (sy (Sorted o ys))) (Sorted o (merge o xs ys)))
  (lam o xs (elim (lam w (Pi ((ys (List (El o))) (sx (Sorted o w)) (sy (Sorted o ys))) (Sorted o (merge o w ys)))) xs
    ((nil) (lam ys sx sy sy))
    ((cons x xs1) (lam ys (elim (lam w (Pi ((sx (Sorted o (cons x xs1))) (sy (Sorted o w))) (Sorted o (merge o (cons x xs1) w)))) ys
       ((nil) (lam sx sy sx))
       ((cons y ys1) (lam sx sy
         (ifP (lam bb (Sorted o (if bb (cons x (merge o xs1 (cons y ys1))) (cons y (merge o (cons x xs1) ys1))))) (leq o x y)
           (lam e (let hxy (eq→isTrue (leq o x y) e)
                    (pair (merge-allle o x xs1 (cons y ys1) (fst sx) (pair hxy (allle-trans o x y hxy ys1 (fst sy))))
                          ((rec xs1) (cons y ys1) (snd sx) sy))))
           (lam e (let hyx (ord-total o x y e)
                    (pair (merge-allle o y (cons x xs1) ys1 (pair hyx (allle-trans o y x hyx xs1 (fst sx))) (fst sy))
                          ((rec ys1) sx (snd sy))))))))))))))

; ---------------------------------------------------------------- a sorted list is fixed by its multiplicities
(checked count-head (Pi ((o Ord) (x (El o)) (l (List (El o)))) (PathP (plam i Nat) (count o x (cons x l)) (suc (count o x l))))
  (lam o x l (cong lzero lzero Bool Nat (lam bb (plus (one-if bb) (count o x l))) (eqo o x x) true (isTrue→eq (eqo o x x) (eqo-refl o x)))))
; an element counted in a list bounded below by y is at least y
(checked allle-count (Pi ((o Ord) (y (El o)) (l (List (El o))) (a (AllLe o y l)) (x (El o)) (k Nat) (c (PathP (plam i Nat) (count o x l) (suc k))))
    (isTrue (leq o y x)))
  (lam o y l (elim (lam w (Pi ((a (AllLe o y w)) (x (El o)) (k Nat) (c (PathP (plam i Nat) (count o x w) (suc k)))) (isTrue (leq o y x)))) l
    ((nil) (lam a x k c (Empty-rec lzero (isTrue (leq o y x)) (snotz k (symN zero (suc k) c)))))
    ((cons z r) (lam a x k c
      (ifP (lam bb (Pi c2 (PathP (plam i Nat) (plus (one-if bb) (count o x r)) (suc k)) (isTrue (leq o y x)))) (eqo o x z)
        (lam e c2 (subst lzero lzero (El o) (lam v (isTrue (leq o y v))) z x
                    (sym lzero (El o) x z (eqo-sound o x z (eq→isTrue (eqo o x z) e))) (fst a)))
        (lam e c2 ((rec r) (snd a) x k c2))
        c))))))
(checked sorted-unique (Pi ((o Ord) (xs (List (El o))) (ys (List (El o))) (sx (Sorted o xs)) (sy (Sorted o ys))
                            (c (Pi a (El o) (isTrue (eqb (count o a xs) (count o a ys))))))
    (PathP (plam i (List (El o))) xs ys))
  (lam o xs (elim (lam w (Pi ((ys (List (El o))) (sx (Sorted o w)) (sy (Sorted o ys)) (c (Pi a (El o) (isTrue (eqb (count o a w) (count o a ys))))))
                         (PathP (plam i (List (El o))) w ys))) xs
    ((nil) (lam ys (elim (lam v (Pi ((sx (Sorted o nil)) (sy (Sorted o v)) (c (Pi a (El o) (isTrue (eqb (count o a nil) (count o a v))))))
                                  (PathP (plam i (List (El o))) nil v))) ys
       ((nil) (lam sx sy c (plam i nil)))
       ((cons y q) (lam sx sy c (Empty-rec lzero (PathP (plam i (List (El o))) nil (cons y q))
          (snotz (count o y q) (transN (suc (count o y q)) (count o y (cons y q)) zero
                                 (symN (count o y (cons y q)) (suc (count o y q)) (count-head o y q))
                                 (symN zero (count o y (cons y q)) (eqb-sound zero (count o y (cons y q)) (c y)))))))))))
    ((cons x r) (lam ys (elim (lam v (Pi ((sx (Sorted o (cons x r))) (sy (Sorted o v)) (c (Pi a (El o) (isTrue (eqb (count o a (cons x r)) (count o a v))))))
                                       (PathP (plam i (List (El o))) (cons x r) v))) ys
       ((nil) (lam sx sy c (Empty-rec lzero (PathP (plam i (List (El o))) (cons x r) nil)
          (snotz (count o x r) (transN (suc (count o x r)) (count o x (cons x r)) zero
                                 (symN (count o x (cons x r)) (suc (count o x r)) (count-head o x r))
                                 (eqb-sound (count o x (cons x r)) zero (c x)))))))
       ((cons y q) (lam sx sy c
         (let hx (transN (count o x (cons y q)) (count o x (cons x r)) (suc (count o x r))
                    (symN (count o x (cons x r)) (count o x (cons y q)) (eqb-sound (count o x (cons x r)) (count o x (cons y q)) (c x)))
                    (count-head o x r))
         (let hy (transN (count o y (cons x r)) (count o y (cons y q)) (suc (count o y q))
                    (eqb-sound (count o y (cons x r)) (count o y (cons y q)) (c y))
                    (count-head o y q))
         (let yx (allle-count o y (cons y q) (pair (ord-refl o y) (fst sy)) x (count o x r) hx)
         (let xy (allle-count o x (cons x r) (pair (ord-refl o x) (fst sx)) y (count o y q) hy)
         (let pxy (ord-antisym o x y xy yx)
         (let crq (the (Pi a (El o) (isTrue (eqb (count o a r) (count o a q)))) (lam a (eqb-complete (count o a r) (count o a q)
                    (plus-cancel (one-if (eqo o a x)) (count o a r) (count o a q)
                      (transN (plus (one-if (eqo o a x)) (count o a r)) (plus (one-if (eqo o a y)) (count o a q)) (plus (one-if (eqo o a x)) (count o a q))
                        (eqb-sound (count o a (cons x r)) (count o a (cons y q)) (c a))
                        (plam i (plus (one-if (eqo o a (@ pxy (~ i)))) (count o a q))))))))
           (plam i (cons (@ pxy i) (@ ((rec r) q (snd sx) (snd sy) crq) i)))))))))))))))))
(checked isProp-AllLe (Pi ((o Ord) (y (El o)) (l (List (El o)))) (isProp lzero (AllLe o y l)))
  (lam o y l (elim (lam w (isProp lzero (AllLe o y w))) l
    ((nil) (isProp-isTrue true))
    ((cons x r) (isProp× (isTrue (leq o y x)) (AllLe o y r) (isProp-isTrue (leq o y x)) (rec r))))))
(checked isProp-Sorted (Pi ((o Ord) (l (List (El o)))) (isProp lzero (Sorted o l)))
  (lam o l (elim (lam w (isProp lzero (Sorted o w))) l
    ((nil) (isProp-isTrue true))
    ((cons x r) (isProp× (AllLe o x r) (Sorted o r) (isProp-AllLe o x r) (rec r))))))

; ---------------------------------------------------------------- finite bags
; the free commutative monoid on a type: ∪ with its identities as path constructors
(checked-data (data (Bag (A U)) (emp) (sng (a A)) (un (x (Bag A)) (y (Bag A)))
  (unitl (x (Bag A)) (dims i) ((= i 0) (un emp x)) ((= i 1) x))
  (unitr (x (Bag A)) (dims i) ((= i 0) (un x emp)) ((= i 1) x))
  (assoc (x (Bag A)) (y (Bag A)) (z (Bag A)) (dims i) ((= i 0) (un (un x y) z)) ((= i 1) (un x (un y z))))
  (comm (x (Bag A)) (y (Bag A)) (dims i) ((= i 0) (un x y)) ((= i 1) (un y x)))))
; multiplicity in a bag respects its identities: the laws of +
(checked countB (Pi ((o Ord) (a (El o)) (X (Bag (El o)))) Nat)
  (lam o a X (elim (lam w Nat) X
    ((emp) zero)
    ((sng b) (one-if (eqo o a b)))
    ((un x y) (plus (rec x) (rec y)))
    ((unitl x i) (rec x))
    ((unitr x i) (@ (plus-zero (rec x)) i))
    ((assoc x y z i) (@ (plus-assoc (rec x) (rec y) (rec z)) i))
    ((comm x y i) (@ (plus-comm (rec x) (rec y)) i)))))
; the declaration: a list with X's multiplicities, sorted
(checked Gs (Pi ((o Ord) (X (Bag (El o))) (B (List (El o)))) U)
  (lam o X B (Sigma c (Pi a (El o) (isTrue (eqb (count o a B) (countB o a X)))) (Sorted o B))))
(checked Fs (Pi ((o Ord) (X (Bag (El o)))) U) (lam o X (Sigma B (List (El o)) (Gs o X B))))
(checked isPropGs (Pi ((o Ord) (X (Bag (El o))) (B (List (El o)))) (isProp lzero (Gs o X B)))
  (lam o X B (isProp× (Pi a (El o) (isTrue (eqb (count o a B) (countB o a X)))) (Sorted o B)
    (isPropPi (El o) (lam a (isTrue (eqb (count o a B) (countB o a X)))) (lam a (isProp-isTrue (eqb (count o a B) (countB o a X)))))
    (isProp-Sorted o B))))
; the completion is forced (9.2): the declaration is a proposition
(checked Fs-prop (Pi ((o Ord) (X (Bag (El o)))) (isProp lzero (Fs o X)))
  (lam o X u v
    (let pB (sorted-unique o (fst u) (fst v) (snd (snd u)) (snd (snd v))
              (the (Pi a (El o) (isTrue (eqb (count o a (fst u)) (count o a (fst v)))))
                (lam a (eqb-complete (count o a (fst u)) (count o a (fst v))
                  (transN (count o a (fst u)) (countB o a X) (count o a (fst v))
                    (eqb-sound (count o a (fst u)) (countB o a X) ((fst (snd u)) a))
                    (symN (count o a (fst v)) (countB o a X) (eqb-sound (count o a (fst v)) (countB o a X) ((fst (snd v)) a))))))))
      (plam i (pair (@ pB i)
        (@ (isProp→PathP lzero (Gs o X (fst u)) (Gs o X (fst v)) (plam j (Gs o X (@ pB j))) (isPropGs o X (fst v)) (snd u) (snd v)) i))))))
(checked mempty (Pi o Ord (Fs o emp)) (lam o (pair nil (pair (lam a unit) unit))))
(checked msng (Pi ((o Ord) (b (El o))) (Fs o (sng b)))
  (lam o b (pair (cons b nil)
             (pair (lam a (eqb-complete (plus (one-if (eqo o a b)) zero) (one-if (eqo o a b)) (plus-zero (one-if (eqo o a b)))))
                   (pair unit unit)))))
; ∪ is merge
(checked munion (Pi ((o Ord) (x (Bag (El o))) (y (Bag (El o))) (hx (Fs o x)) (hy (Fs o y))) (Fs o (un x y)))
  (lam o x y hx hy
    (pair (merge o (fst hx) (fst hy))
      (pair (lam a (eqb-complete (count o a (merge o (fst hx) (fst hy))) (plus (countB o a x) (countB o a y))
              (transN (count o a (merge o (fst hx) (fst hy))) (plus (count o a (fst hx)) (count o a (fst hy))) (plus (countB o a x) (countB o a y))
                (merge-count o a (fst hx) (fst hy))
                (cong2N plus (count o a (fst hx)) (countB o a x) (count o a (fst hy)) (countB o a y)
                  (eqb-sound (count o a (fst hx)) (countB o a x) ((fst (snd hx)) a))
                  (eqb-sound (count o a (fst hy)) (countB o a y) ((fst (snd hy)) a))))))
            (merge-sorted o (fst hx) (fst hy) (snd (snd hx)) (snd (snd hy)))))))
; posed with the bag's identities: the elimination of X. The path branches are the declaration's
; propositionality and the path over it between any two inhabitants (isProp→PathP). Both are
; arguments, so checking a branch's boundary reads their types only: as a definition, isProp→PathP
; at an endpoint is a transport in Fs computed back to the point
(checked msort-at (Pi ((o Ord)
                       (hp (Pi m (Bag (El o)) (isProp lzero (Fs o m))))
                       (pp (Pi ((B0 U) (B1 U) (B (PathP (plam i U) B0 B1)) (h (isProp lzero B1)) (b0 B0) (b1 B1)) (PathP B b0 b1)))
                       (X (Bag (El o)))) (Fs o X))
  (lam o hp pp X (elim (lam w (Fs o w)) X
    ((emp) (mempty o))
    ((sng b) (msng o b))
    ((un x y) (munion o x y (rec x) (rec y)))
    ((unitl x i) (@ (pp (Fs o (un emp x)) (Fs o x) (plam j (Fs o (unitl x j))) (hp x)
                        (munion o emp x (mempty o) (rec x)) (rec x)) i))
    ((unitr x i) (@ (pp (Fs o (un x emp)) (Fs o x) (plam j (Fs o (unitr x j))) (hp x)
                        (munion o x emp (rec x) (mempty o)) (rec x)) i))
    ((assoc x y z i) (@ (pp (Fs o (un (un x y) z)) (Fs o (un x (un y z))) (plam j (Fs o (assoc x y z j))) (hp (un x (un y z)))
                            (munion o (un x y) z (munion o x y (rec x) (rec y)) (rec z))
                            (munion o x (un y z) (rec x) (munion o y z (rec y) (rec z)))) i))
    ((comm x y i) (@ (pp (Fs o (un x y)) (Fs o (un y x)) (plam j (Fs o (comm x y j))) (hp (un y x))
                         (munion o x y (rec x) (rec y)) (munion o y x (rec y) (rec x))) i)))))
(checked msort (Pi ((o Ord) (X (Bag (El o)))) (Fs o X)) (lam o X (msort-at o (Fs-prop o) (isProp→PathP lzero) X)))
