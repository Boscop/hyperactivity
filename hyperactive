#!/usr/bin/env python3
"""hyperactive — the way into hyperactivity, for agents and humans alike.

    hyperactive                      the walk, from its start: everything to read, in order, one chunk at a time
    hyperactive next | prev          the next chunk of the walk, or the one before
    hyperactive open                 what is open and what can start now
    hyperactive def NAME             a definition: its statement, its text, where it is, what uses it
    hyperactive paper [SECTION]      the paper as it reads, whole or one section (4.4, A.1, Part II):
                                     the human projection of the value hyperactivity
    hyperactive etym TEXT            the text augmented with the etymology of every word
    hyperactive show NODE ...        a node: its statement, what it serves, what serves it,
                                     its essential context
    hyperactive tree                 the task graph from its root
    hyperactive order                the order of work: what can start now, then what waits on what
    hyperactive why NAME             why a declaration exists: its chain of reasons to the root
    hyperactive unexplained [FILE]   declarations with no reason
    hyperactive view TERM            a view: a term over the task graph, evaluated by the machine
    hyperactive check [FILE ...]     check files (each loads what it imports); no file: the task graph,
                                     and that every piece of information is stored once
    hyperactive repl                 the machine, interactive: declarations and readings (#type e,
                                     #show e, #where name), each block ended by a line holding '.'
    hyperactive decompose FILE       decompose a document into self-contained parts, one by one
                                     (lib/knowledge.cub): an intelligent partition, then each part
                                     shown in its surroundings, made self-contained or asserted so
    hyperactive history [NAME]       the history: every binding of NAME to a key, in the order bound,
                                     with its UTC time (lib/history.cub; no name: every name)
    hyperactive server               the task graph drawn as a graph at http://localhost:8080, the
                                     history at http://localhost:8080/history
    hyperactive library | brunerie | every     the standard checks
    hyperactive install              put `hyperactive` on your PATH (~/.local/bin)
    hyperactive help                 this list

The machine is built on first use and rebuilt when src/ changes. Run it from anywhere: it finds this
repository from its own location.
"""
import contextlib, hashlib, io, os, re, subprocess, sys, time

ROOT = os.path.dirname(os.path.realpath(__file__))
MACHINE = os.path.join(ROOT, 'build', 'cubical')
TASKS = os.path.join(ROOT, 'tools', 'task-graph.py')
ONBOARDING = os.path.join(ROOT, 'docs', 'onboarding.cub')
CHUNK = 8000   # characters per chunk of the walk: small enough that no agent harness truncates it


def tool(*args):
    return subprocess.run([sys.executable, TASKS, *args], cwd=ROOT, capture_output=True, text=True).stdout


def task_graph_module():
    import importlib.util
    spec = importlib.util.spec_from_file_location('task_graph', TASKS)
    tg = importlib.util.module_from_spec(spec); spec.loader.exec_module(tg)
    return tg


def onboarding_documents():
    """the documents of the value onboarding (docs/onboarding.cub), in order, as the machine
    evaluates it: ('file', path from the repository root, sha256 hex) or ('text', name, the text a
    projection computes)"""
    build()
    return task_graph_module().documents(ONBOARDING, 'onboarding')


def served(path, digest):
    """the bytes of a document, exactly those the value identifies: a file whose SHA-256 is not the
    value's digest is not served"""
    full = os.path.join(ROOT, path)
    with open(full, 'rb') as f:
        data = f.read()
    if hashlib.sha256(data).hexdigest() != digest:
        sys.exit(f'{path} changed while the walk was being read (its SHA-256 is not the one the '
                 'value onboarding holds); run hyperactive again')
    return data


HEADING = re.compile(r'^(#{1,3} |\s*(\d+(\.\d+)*|[A-Z])\.?\s{1,3}[A-Z][^.]{2,80}$)')


def chunks(text):
    """text cut at paragraph boundaries into chunks of at most CHUNK characters, preferring a cut
    before a heading (a section of the paper, a section of a markdown file); a paragraph longer than
    CHUNK is cut at its lines"""
    units = []
    for par in re.split(r'\n\s*\n', text):
        if not par.strip(): continue
        while len(par) > CHUNK:
            cut = par.rfind('\n', 0, CHUNK)
            if cut <= 0: cut = CHUNK
            units.append(par[:cut]); par = par[cut:].lstrip('\n')
        units.append(par)
    out, cur = [], ''
    for u in units:
        head = HEADING.match(u.split('\n', 1)[0])
        if cur and len(cur) < CHUNK // 8 and len(cur) + 2 + len(u) > CHUNK:
            # a heading or a short line stays with what follows it: the paragraph is cut at a line
            cut = u.rfind('\n', 0, CHUNK - len(cur) - 2)
            if cut > 0:
                out.append(cur + '\n\n' + u[:cut]); cur = u[cut:].lstrip('\n'); continue
        if cur and (len(cur) + 2 + len(u) > CHUNK or (head and len(cur) > CHUNK // 2)):
            out.append(cur); cur = u
        else:
            cur = cur + '\n\n' + u if cur else u
    if cur.strip(): out.append(cur)
    return out


def code_of(name, found):
    """the code a `code: NAME` line of the pure page stands for: the definition NAME of lib/, whole"""
    hits = [h for h in found.get(name, []) if h[0].startswith('lib/')]
    if len(hits) != 1:
        sys.exit(f'the paper names {name} as code, but lib/ has {len(hits)} definitions of it')
    f, l, text = hits[0]
    return f'{name}   ({f}, line {l})\n{text}'


def with_code(text):
    """a projection's text with each `code: NAME` line replaced by the definition it names"""
    if '\ncode: ' not in '\n' + text: return text
    found = blocks()
    return '\n'.join(code_of(l[6:], found) if l.startswith('code: ') else l for l in text.split('\n'))


def paper(section):
    """the paper as it reads (`human hyperactivity`), whole or the section numbered `section`"""
    build()
    probe = os.path.join(ROOT, 'build', 'paper-human.cub')
    os.makedirs(os.path.dirname(probe), exist_ok=True)
    with open(probe, 'w', encoding='utf-8') as f:
        f.write(f'import "{os.path.join(ROOT, "docs", "hyperactivity.cub")}"\n'
                'paper-human : List Document\npaper-human = cons (projection "human" (human hyperactivity)) nil\n')
    text = task_graph_module().documents(probe, 'paper-human')[0][2]
    if not section: print(text); return
    parts = re.split(r'(?m)^(?=#{1,4} )', text)
    hit = [p for p in parts if re.match(r'#{1,4} (Part |Appendix )?' + re.escape(section) + r'[ .]', p)]
    if not hit: sys.exit(f'the paper has no section {section}')
    start = parts.index(hit[0]); depth = len(hit[0]) - len(hit[0].lstrip('#'))
    out = [hit[0]]
    for p in parts[start + 1:]:
        if len(p) - len(p.lstrip('#')) <= depth: break
        out.append(p)
    print(''.join(out))


def walk_chunks():
    """the walk, in order: (title, text) for every chunk. The documents are those of the value
    `onboarding` (docs/onboarding.cub) as the machine evaluates it, each served only if its bytes are
    the ones the value identifies: the welcome file, the paper (computed from its value, docs/hyperactivity.cub), the Labs note, the pieces of
    the paper delta (docs/paper-delta.cub), the word list, the etymologies. Then the task graph and
    what can be taken up, generated."""
    out = []
    for kind, label, held in onboarding_documents():
        text = served(label, held).decode('utf-8') if kind == 'file' else with_code(held)
        cs = chunks(text)
        for j, c in enumerate(cs):
            out.append((label + (f', part {j + 1} of {len(cs)}' if len(cs) > 1 else ''), c))
    cs = chunks(GRAPH_INTRO + tool('tree'))
    for j, c in enumerate(cs):
        out.append(('The task graph' + (f', part {j + 1} of {len(cs)}' if len(cs) > 1 else ''), c))
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf): open_work()
    for j, c in enumerate(chunks(buf.getvalue() + '\n' + COMMANDS)):
        out.append(('What you can take up' + (f', part {j + 1}' if j else ''), c))
    return out


GRAPH_INTRO = """All work, and all status, is the task graph: a value of the language
(task-graph/hyperactivity.cub over lib/task-graph.cub), ruled by the Hyperactive Workflow you have
read. Every node is a sentence; a node's statement holds what is known about it. [in progress] and
[resolved] mark leaves; every other leaf is pending.

"""

POSITION = os.path.join(ROOT, 'build', 'walk-position')


def walk(move):
    """`hyperactive` begins the walk; `next` and `prev` move one chunk; the position is kept in build/"""
    cs = walk_chunks()
    n = 1
    if move:
        try: n = int(open(POSITION).read())
        except (OSError, ValueError): n = 1
        n = max(1, min(len(cs), n + move))
    os.makedirs(os.path.dirname(POSITION), exist_ok=True)
    open(POSITION, 'w').write(str(n))
    title, text = cs[n - 1]
    if n == 1: print(ARRIVAL + '\n')
    print(f'── {n} of {len(cs)}: {title} ' + '─' * 8 + '\n')
    print(text.strip())
    print('\n' + '─' * 8 + f' end of {n} of {len(cs)}. ' + ('Next: hyperactive next' if n < len(cs) else 'The walk is done.') + ('   (back: hyperactive prev)' if n > 1 else ''))


DECOMPOSING = os.path.join(ROOT, 'build', 'decompose.json')
DECOMPOSE_HOW = """Decomposition (Avik, 2026-11-16 06:03 and 06:08 UTC, “Avik's words, verbatim”): a document is one
unit; its decomposition is a second unit, its parts, asserted to carry the same meaning. First an
intelligent partition: read the whole document and cut it where its meaning divides, each part one
assertion with its evidence. Then each part, one by one, shown with its surroundings in the original:
make it self-contained with any relevant context included, or assert that it already is."""


def decompose_parts(lines, cuts):
    return [(a, (cuts[k + 1] - 1) if k + 1 < len(cuts) else len(lines)) for k, a in enumerate(cuts)]


def decompose_show(st):
    lines = open(os.path.join(ROOT, st['file']), encoding='utf-8').read()[:-1].split('\n')
    ps = decompose_parts(lines, st['cuts']); k = st['k']; a, b = ps[k]
    heads = [l for l in lines[:a - 1] if l.startswith('#')]
    print(f'── part {k + 1} of {len(ps)} of {st["file"]} (lines {a}–{b}) ' + '─' * 8)
    if heads: print('\nUnder: ' + ' › '.join(h.lstrip('# ') for h in heads[-3:]))
    if k: print('\nBefore it in the original:\n' + '\n'.join('  | ' + l for l in lines[ps[k - 1][0] - 1:ps[k - 1][1]]))
    print('\nTHE PART:\n' + '\n'.join('  > ' + l for l in lines[a - 1:b]))
    if k + 1 < len(ps): print('\nAfter it in the original:\n' + '\n'.join('  | ' + l for l in lines[ps[k + 1][0] - 1:ps[k + 1][1]]))
    print("""
Read the part alone, as a reader who has seen nothing else of the document. Ensure it is
self-contained with any relevant context included: every reference to another part ("this",
"above", "these", a label, a section number of the document) resolved to what it refers to, and
any context it leans on stated. Add nothing else and drop nothing. Avik's words stay verbatim: give
their context around a quotation, never inside it.
  It is self-contained and makes sense:      hyperactive decompose self-contained
  It is not; this is its re-expression:      hyperactive decompose re-expressed <<'EOF'
                                             …the part, re-expressed…
                                             EOF""")


def decompose_write(st):
    """the Essay value (lib/knowledge.cub) the walk produced, as docs/<stem>.cub; the document is bare of it"""
    src = os.path.join(ROOT, st['file']); text = open(src, encoding='utf-8').read()
    lines = text[:-1].split('\n'); stem = os.path.splitext(os.path.basename(st['file']))[0]
    lst = lambda xs: 'nil' if not xs else f'(cons {xs[0]} {lst(xs[1:])})'
    lit = lambda l: f'"{l}"' if '"' not in l else '(quoted ' + lst([f'"{x}"' for x in l.split('"')]) + ')'
    out = [f'-- {st["file"][:-3]}.cub — {lines[0].lstrip("# ")}: decomposed by `hyperactive decompose` (lib/knowledge.cub).',
           '-- Each part is a definition; the document is `bare` of the value, and exists only here.',
           'import "' + os.path.relpath(os.path.join(ROOT, 'lib', 'knowledge.cub'), os.path.dirname(src)) + '"']
    names = []
    for k, (a, b) in enumerate(decompose_parts(lines, st['cuts'])):
        n = f'{stem}-{k + 1}'; names.append(n); ls = lst([lit(l) for l in lines[a - 1:b]])
        re_ = st['self'].get(str(k))
        out += [f'{n} : Part', f'{n} = part {ls}' if re_ is None else f'{n} = referring {ls} {lst([lit(l) for l in re_.split(chr(10))])}']
    decl = f'(decomposed-by {lit(st["by"])} "{time.strftime("%Y-%m-%d", time.gmtime())}")'
    out += [f'{stem} : Essay', f'{stem} = essay {lit(lines[0].lstrip("# "))} {lst(names)} {decl}']
    cub = src[:-3] + '.cub'
    open(cub, 'w', encoding='utf-8').write('\n'.join(out) + '\n')
    probe = os.path.join(ROOT, 'build', 'decompose-probe.cub')
    open(probe, 'w').write(f'import "{os.path.join(ROOT, "lib", "document.cub")}"\nimport "{cub}"\n'
                           f'decompose-probe : List Document\ndecompose-probe = cons (projection "bare" (bare {stem})) nil\n')
    if task_graph_module().documents(probe, 'decompose-probe')[0][2] != text:
        sys.exit(f'{cub}: its bare value is not {st["file"]} exactly; nothing is removed')
    os.remove(src); os.remove(DECOMPOSING)
    print(f'{st["file"]} is now {os.path.relpath(cub, ROOT)}: the document is `bare {stem}`, checked equal to the file, which is removed.\n'
          f'Point what referred to the file at the value (a Document is `projection "…" (bare {stem})`), then hyperactive check.')


def decompose(rest):
    import json
    if rest and rest[0] == 'cut':
        if len(rest) < 4 or rest[2] != '--by': sys.exit('hyperactive decompose cut FILE --by WHO LINE LINE …')
        f = os.path.relpath(os.path.abspath(rest[1]), ROOT); n = len(open(os.path.join(ROOT, f), encoding='utf-8').read()[:-1].split('\n'))
        cuts = sorted(set([1] + [int(x) for x in rest[4:]]))
        if cuts[-1] > n: sys.exit(f'{f} has {n} lines')
        st = {'file': f, 'by': rest[3], 'cuts': cuts, 'k': 0, 'self': {}}
    else:
        try: st = json.load(open(DECOMPOSING))
        except OSError:
            if not rest: sys.exit('hyperactive decompose FILE: begin by reading FILE')
            f = rest[0]; ls = open(f, encoding='utf-8').read()[:-1].split('\n')
            print(DECOMPOSE_HOW + '\n')
            print('\n'.join(f'{i:5} {l}' for i, l in enumerate(ls, 1)))
            print(f'\nRead all of it. Then give the line at which each part begins:\n'
                  f'  hyperactive decompose cut {f} --by WHO LINE LINE …'); return
        if not rest or rest[0] == 'part': pass
        elif rest[0] == 'self-contained': st['self'].pop(str(st['k']), None); st['k'] += 1
        elif rest[0] == 're-expressed':
            t = sys.stdin.read().strip('\n')
            if not t: sys.exit('the re-expression is read from standard input')
            st['self'][str(st['k'])] = t; st['k'] += 1
        else: sys.exit('hyperactive decompose [part | self-contained | re-expressed]')
    lines = open(os.path.join(ROOT, st['file']), encoding='utf-8').read()[:-1].split('\n')
    if st['k'] >= len(st['cuts']): build(); return decompose_write(st)
    os.makedirs(os.path.dirname(DECOMPOSING), exist_ok=True); json.dump(st, open(DECOMPOSING, 'w'))
    decompose_show(st)


ARRIVAL = """You are entering hyperactivity. This walk is how an agent comes to hold Avik's complete insight:
every agent reads the same material, whole, in the same order, one chunk at a time. Read every word
of a chunk before running `hyperactive next`; do not search the files or open them out of order.
The documents walked are the value `onboarding` of docs/onboarding.cub; then the task graph and
what can be taken up. `hyperactive` begins again from the start."""


COMMANDS = """
Reading and working:
  hyperactive show NODE      a node: its statement, what it serves, what serves it, its essential context
  hyperactive def NAME       a definition: its statement, its text, where it is, and what uses it
  hyperactive paper [SECTION]  the paper as it reads (its human projection), whole or one section
  hyperactive etym TEXT      any text, every word augmented with its etymology: read Avik's words
                             in the meanings the words carry, not a local frame
  hyperactive open           what is open and what can start now
  hyperactive order          the whole order of work
  hyperactive tree           the task graph from its root
  hyperactive history [NAME] what changed here: every binding of a name to a key, in the order bound
  hyperactive check [FILE]   check files; with no file, the task graph
  hyperactive repl           the machine, interactive
  hyperactive prev           back one chunk of the walk; `hyperactive` begins it again
  hyperactive help           every command

Take up what the order says can start, beginning with what is in progress. A finding goes into the
statement of the goal it concerns; a node is split into children only when work on a child begins."""


def open_work():
    out = tool('priority').split('\n')
    first = []
    for l in out[1:]:
        if l.startswith(' layer 2') or l.startswith('waiting'): break
        first.append(l)
    prog = task_graph_module().in_progress()
    if prog:
        print('In progress:\n')
        for n in prog: print(tool('show', n))
    print('Can start now and unblocks the most:')
    print('\n'.join(l for l in first if l.strip() and not l.startswith(' layer')))


def blocks():
    """every top-level declaration of every .cub file: name -> [(file, line, text)]"""
    found, declarations = {}, task_graph_module().declarations
    for dp, dn, fs in os.walk(ROOT):
        dn[:] = [d for d in dn if not d.startswith('.') and d != 'build']
        for f in fs:
            if not f.endswith('.cub'): continue
            path = os.path.join(dp, f)
            for name, line, text in declarations(open(path, errors='replace').read()):
                found.setdefault(name, []).append((os.path.relpath(path, ROOT), line, text))
    return found


def define(names):
    found = blocks()
    for name in names:
        if name not in found:
            sys.exit(f'hyperactive: no top-level definition named {name}')
        word = re.compile(r"(?<![\w'-])" + re.escape(name) + r"(?![\w'-])")
        for f, l, text in found[name]:
            print(f'{name}   ({f}, line {l})\n')
            print(text + '\n')
        users = sorted({(k, f) for k, v in found.items() if k != name for f, _, t in v
                        if word.search('\n'.join(x for x in t.split('\n') if not x.startswith('--')))})
        print(f'used by {len(users)} definition' + ('s' if len(users) != 1 else '') + (':' if users else ''))
        for k, f in users[:40]: print(f'  {k}   ({f})')
        if len(users) > 40: print(f'  … and {len(users) - 40} more')


def build():
    r = subprocess.run(['make', '-s', '-C', ROOT, 'build/cubical'], stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if r.returncode != 0:
        sys.exit('building the machine failed:\n' + r.stderr[-3000:])


def tasks(*args):
    build()
    return subprocess.call([sys.executable, TASKS, *args], cwd=ROOT)


def guard():
    """One source (Avik, 2026-11-15): every clone that runs hyperactive judges its own commits and
    pushes (.githooks: pre-commit and pre-push run `tools/task-graph.py one-source`)."""
    subprocess.run(['git', '-C', ROOT, 'config', 'core.hooksPath', '.githooks'], capture_output=True)


def main():
    guard()
    a = sys.argv[1:]
    if not a:
        walk(0); return
    c, rest = a[0], a[1:]
    if c in ('help', '-h', '--help'): print(__doc__); return
    if c == 'decompose':
        decompose(rest); return
    if c in ('next', 'prev'):
        walk(1 if c == 'next' else -1); return
    if c == 'open':
        open_work(); return
    if c == 'etym':
        os.execv(sys.executable, [sys.executable, os.path.join(ROOT, 'tools', 'etym.py'), *rest])
    if c == 'paper':
        paper(rest[0] if rest else None); return
    if c == 'def':
        if not rest: sys.exit('hyperactive def NAME')
        define(rest); return
    if c in ('show', 'tree', 'why', 'unexplained', 'view', 'every'): sys.exit(tasks(c, *rest))
    if c == 'order': sys.exit(tasks('priority', *rest))
    if c == 'check':
        if not rest: sys.exit(tasks('check'))
        build()
        sys.exit(subprocess.call([MACHINE, *[os.path.abspath(f) for f in rest]]))
    if c == 'repl':
        build()
        sys.exit(subprocess.call([MACHINE, os.path.join(ROOT, 'lib', 'core.cub'), *rest, '--serve']))
    if c == 'history':
        name = ' '.join(rest)
        if '"' in name or '\\' in name or '\n' in name: sys.exit('hyperactive history: a name holds no quote, backslash or newline')
        build()
        out = subprocess.run([sys.executable, TASKS, 'view', '--in', 'lib/history.cub', '--type', 'List (List Word)',
                              f'history-lines (history "{name}")'], cwd=ROOT, capture_output=True, text=True)
        if out.returncode: sys.exit(out.stdout + out.stderr)
        import json, time
        lines = [json.loads(l).split(' ') for l in out.stdout.split('\n') if l.startswith('"')]
        if not lines: sys.exit(f'no history for {name}' if name else 'the history is empty')
        for n, k, t in lines:
            print(time.strftime('%Y-%m-%d %H:%M:%S UTC', time.gmtime(int(t))), n, 'unbound' if k == '-' else k)
        sys.exit(0)
    if c == 'server':
        sys.exit(subprocess.call([sys.executable, os.path.join(ROOT, 'tools', 'task-tree-server.py'), *rest]))
    if c in ('library', 'brunerie'):
        sys.exit(subprocess.call(['make', '-s', '-C', ROOT, c]))
    if c == 'install':
        d = os.path.expanduser('~/.local/bin'); os.makedirs(d, exist_ok=True)
        link = os.path.join(d, 'hyperactive')
        if os.path.lexists(link): os.remove(link)
        os.symlink(os.path.realpath(__file__), link)
        print(f'{link} -> {os.path.realpath(__file__)}')
        if d not in os.environ.get('PATH', '').split(os.pathsep):
            print(f'{d} is not on your PATH; add it in your shell profile: export PATH="$HOME/.local/bin:$PATH"')
        return
    sys.exit(f'hyperactive: no command "{c}" (hyperactive help)')


if __name__ == '__main__':
    main()
