; tests/codata.ctt — coinductive records with copatterns (Cubical Agda --guardedness). Loaded after
; lib/std.ctt. A value of a codata type is a stuck call of a copattern definition; a projection
; unfolds the call once. Path equality of orbits is bisimulation (punaragamana/Orbit.agda).

; ---------------------------------------------------------------- orbits
(checked-codata (codata (Orbit (A U)) (here A) (next (Orbit A))))
(checked unfold (Pi ((A U) (f (Pi a A A)) (a A)) (Orbit A))
  (lam A f a (record (here a) (next (unfold A f (f a))))))
(checked mapO (Pi ((A U) (B U) (f (Pi a A B)) (o (Orbit A))) (Orbit B))
  (lam A B f o (record (here (f (here o))) (next (mapO A B f (next o))))))

; bisimulation: agreement at the head, and bisimulation of the tails
(checked-codata (codata (Bisim (A U) (x (Orbit A)) (y (Orbit A)))
  (bhere (PathP (plam i A) (here x) (here y)))
  (bnext (Bisim A (next x) (next y)))))
(checked bisim (Pi ((A U) (x (Orbit A)) (y (Orbit A)) (p (Bisim A x y))) (PathP (plam i (Orbit A)) x y))
  (lam A x y p (plam i (record (here (@ (bhere p) i)) (next (@ (bisim A (next x) (next y) (bnext p)) i))))))
(checked path->bisim (Pi ((A U) (x (Orbit A)) (y (Orbit A)) (p (PathP (plam i (Orbit A)) x y))) (Bisim A x y))
  (lam A x y p (record (bhere (plam i (here (@ p i)))) (bnext (path->bisim A (next x) (next y) (plam i (next (@ p i))))))))
(checked iso1 (Pi ((A U) (x (Orbit A)) (y (Orbit A)) (p (PathP (plam i (Orbit A)) x y)))
    (PathP (plam i (PathP (plam j (Orbit A)) x y)) (bisim A x y (path->bisim A x y p)) p))
  (lam A x y p (plam i j (record (here (here (@ p j)))
                                 (next (@ (@ (iso1 A (next x) (next y) (plam k (next (@ p k)))) i) j))))))
(checked iso2 (Pi ((A U) (x (Orbit A)) (y (Orbit A)) (p (Bisim A x y)))
    (PathP (plam i (Bisim A x y)) (path->bisim A x y (bisim A x y p)) p))
  (lam A x y p (plam i (record (bhere (bhere p)) (bnext (@ (iso2 A (next x) (next y) (bnext p)) i))))))
; path equality of orbits is bisimulation
(checked path=bisim (Pi ((A U) (x (Orbit A)) (y (Orbit A))) (Equiv lzero lzero (PathP (plam i (Orbit A)) x y) (Bisim A x y)))
  (lam A x y (isoToEquiv lzero (PathP (plam i (Orbit A)) x y) (Bisim A x y) (path->bisim A x y) (bisim A x y) (iso2 A x y) (iso1 A x y))))

; mapping the identity is the identity: a bisimulation by corecursion, then a path
(checked map-id-b (Pi ((A U) (o (Orbit A))) (Bisim A (mapO A A (lam a a) o) o))
  (lam A o (record (bhere (plam i (here o))) (bnext (map-id-b A (next o))))))
(checked map-id (Pi ((A U) (o (Orbit A))) (PathP (plam i (Orbit A)) (mapO A A (lam a a) o) o))
  (lam A o (bisim A (mapO A A (lam a a) o) o (map-id-b A o))))

; ---------------------------------------------------------------- finite observation
; the first n points of an orbit
(checked take (Pi ((A U) (n Nat) (o (Orbit A))) (List A))
  (lam A n (elim (lam y (Pi o (Orbit A) (List A))) n
    ((zero) (lam o nil))
    ((suc k) (lam o (cons (here o) ((rec k) (next o))))))))
(def n0 zero) (def n1 (suc n0)) (def n2 (suc n1)) (def n3 (suc n2)) (def n4 (suc n3))
(same (take Nat n4 (unfold Nat (lam n (suc n)) zero)) (cons n0 (cons n1 (cons n2 (cons n3 nil)))))
(same (take Nat n3 (mapO Nat Nat (lam n (suc (suc n))) (unfold Nat (lam n (suc n)) zero))) (cons n2 (cons n3 (cons n4 nil))))
; an orbit is its stuck call; a projection unfolds it once
(show (unfold Nat (lam n (suc n)) zero))
(same (here (next (next (unfold Nat (lam n (suc n)) zero)))) n2)
(observe 2 (unfold Nat (lam n (suc n)) zero))
; a long observation: each projection unfolds one call
(def n20 (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))))))))))))))
(same (here (elim (lam y (Orbit Nat)) n20 ((zero) (unfold Nat (lam n (suc n)) zero)) ((suc k) (next (rec k))))) n20)

; a path between orbits computes: at its ends the two orbits, in between their bisimulation
(same (here (@ (map-id Nat (unfold Nat (lam n (suc n)) zero)) 0)) zero)
(same (take Nat n3 (@ (map-id Nat (unfold Nat (lam n (suc n)) zero)) 1)) (cons n0 (cons n1 (cons n2 nil))))

; a typed reading: a stuck call at its type
(checked nats (Orbit Nat) (unfold Nat (lam n (suc n)) zero))
(show nats)

; typed readings: a stuck call is read as the call, its arguments at their types; a field of a
; neutral as the projection. Evaluating the code gives a value convertible with the original
(def qe (lam T v (eval-g lnil (fromopt (quote-top T v) cword))))
(same (fromopt (quote-top (Orbit Nat) nats) cword) (code (unfold Nat (lam n (suc n)) zero)))
(same (conv (Orbit Nat) nats (qe (Orbit Nat) nats)) true)
(checked tl2 (Pi (o (Orbit Nat)) (Orbit Nat)) (lam o (next (next o))))
(same (fromopt (quote-top (Pi (o (Orbit Nat)) (Orbit Nat)) tl2) cword) (code (lam o (next (next o)))))
(same (conv (Pi (o (Orbit Nat)) (Orbit Nat)) tl2 (qe (Pi (o (Orbit Nat)) (Orbit Nat)) tl2)) true)
(show tl2)

; a definition that is its own tail is held once: the value is the call, and its tail is itself
(checked zeros (Orbit Nat) (record (here zero) (next zeros)))
(same (next (next zeros)) zeros)
(show (next zeros))

; ---------------------------------------------------------------- processes
; an interactive process: to each question an answer and the process that continues. The
; corecursive call stands under a λ and a pair in the field's term
(checked-codata (codata (Proc (Q U) (A U)) (step (Pi q Q (Sigma a A (Proc Q A))))))
(checked echo (Pi A U (Proc A A)) (lam A (record (step (lam q (pair q (echo A)))))))
(checked counter (Pi n Nat (Proc Unit Nat)) (lam n (record (step (lam q (pair n (counter (suc n))))))))
; running a process on a list of questions: its answers
(checked run (Pi ((Q U) (A U) (qs (List Q)) (p (Proc Q A))) (List A))
  (lam Q A qs (elim (lam y (Pi p (Proc Q A) (List A))) qs
    ((nil) (lam p nil))
    ((cons q r) (lam p (let s (step p q) (cons (fst s) ((rec r) (snd s)))))))))
(same (run Nat Nat (cons n3 (cons n1 (cons n4 nil))) (echo Nat)) (cons n3 (cons n1 (cons n4 nil))))
(same (run Unit Nat (cons unit (cons unit (cons unit nil))) (counter n2)) (cons n2 (cons n3 (cons n4 nil))))

; ---------------------------------------------------------------- mutual corecursion
(mutual
  (checked ping (Orbit Bool) (record (here true) (next pong)))
  (checked pong (Orbit Bool) (record (here false) (next ping))))
(same (take Bool n4 ping) (cons true (cons false (cons true (cons false nil)))))

; ---------------------------------------------------------------- composition in codata
; field by field, lazily: a field of a transported orbit is the field transported (in a closed data
; type, transport along a constant line is a formal hcomp: there is no regularity)
(same (here (transp (plam i (Orbit Nat)) nats)) (transp (plam i Nat) zero))
(same (here (next (transp (plam i (Orbit Nat)) nats))) (transp (plam i Nat) n1))
; along univalence: an orbit of booleans transported along not
(checked notB (Pi b Bool Bool) (lam b (if b false true)))
(checked notB-inv (Pi b Bool (PathP (plam i Bool) (notB (notB b)) b))
  (lam b (elim (lam y (PathP (plam i Bool) (notB (notB y)) y)) b ((true) (plam i true)) ((false) (plam i false)))))
(checked notB-eq (Equiv lzero lzero Bool Bool) (isoToEquiv lzero Bool Bool notB notB notB-inv notB-inv))
(def notL (ua lzero Bool Bool notB-eq))
(same (here (transp (plam i (Orbit (@ notL i))) ping)) (transp notL true))
(same (here (next (next (next (transp (plam i (Orbit (@ notL i))) ping))))) (transp notL false))
(same (transp notL true) (transp (plam i Bool) (transp (plam i Bool) false)))
; a later field whose type depends on an earlier one: composed along its type at the earlier
; field's filler
(checked-codata (codata Tagged (tag Bool) (val (if tag Nat Bool)) (more Tagged)))
(checked tagged (Pi n Nat Tagged) (lam n (record (tag true) (val n) (more (tagged (suc n))))))
(same (val (more (tagged zero))) n1)
(same (val (transp (plam i Tagged) (tagged zero)))
      (comp (plam i (if (@ (plam k (comp (plam j Bool) (plam j (sys ((= k 0) true))) true)) i) Nat Bool)) (sys) zero))

; ---------------------------------------------------------------- rejected
; a call that is not guarded: under a projection, or as an argument of a function
(checked-fail bad (Orbit Nat) (record (here (here bad)) (next bad)))
(checked-fail bad2 (Pi n Nat (Orbit Nat)) (lam n (record (here n) (next (mapO Nat Nat (lam m m) (bad2 n))))))
; a field of the wrong type
(checked-fail bad3 (Orbit Nat) (record (here true) (next bad3)))
; a boundary that does not hold at the next field
(checked-fail bad4 (Pi ((A U) (x (Orbit A)) (y (Orbit A)) (p (Bisim A x y))) (PathP (plam i (Orbit A)) x y))
  (lam A x y p (plam i (record (here (@ (bhere p) i)) (next (@ (bad4 A (next x) (next y) (bnext p)) (~ i)))))))
; a record only as a copattern definition's body
(check-fail (Orbit Nat) (record (here zero) (next (unfold Nat (lam n (suc n)) zero))))
; a field type not strictly positive
(checked-codata-fail (codata Neg (f (Pi x Neg Nat))))
; a group is rejected when any of its bodies is not guarded, before any is checked (checking w1
; compares (here w2), which would unfold w2's unguarded body)
(checked-codata (codata W (a (Orbit Nat)) (b (PathP (plam i Nat) (here a) (here a)))))
(mutual-fail
  (checked w1 W (record (a w2) (b (plam i zero))))
  (checked w2 (Orbit Nat) (record (here (here w2)) (next w2))))
