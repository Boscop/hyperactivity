-- tests/memo.ctt — one value per live class (README §memo). A term reached by two routes is
-- computed once: a producer firing while another producer of the same class is pending holds its
-- value in a box, and the other reads it. Naive Fibonacci is the case: fib (n+2) = fib (n+1) + fib n,
-- and fib (n+1) itself demands fib n, which is pending in the outer sum. Without this the work is
-- exponential in n; with it, linear in the number of calls (the unary additions dominate the count).
fib zero = zero
fib (suc k) = case k of zero → suc zero; suc j → add (fib k) (fib j)
-- the same function by iteration, for the answer
fibi n =
  fst (case n of zero → (zero , suc zero); suc k → let p = rec k in (snd p , add (fst p) (snd p)))
n10 = suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))
n20 = add n10 n10
n25 = add n20 (suc (suc (suc (suc (suc zero)))))
-- a numeral computed (add n10 n10) and the same numeral written out: the calls on them are one class
l20 =
  suc
    (suc
       (suc
          (suc
             (suc
                (suc
                   (suc
                      (suc
                         (suc
                            (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))))))))))))
#show fib n20
#show fib l20
#show fibi n20
#same fib n10 = fibi n10
#same fib n25 = fibi n25
#show fib n25
-- a term read twice in one reading: the second read is a hit on the first's value
#show (fib n20 , fib n20)
