-- tests/hit.cub — higher inductive types (Coquand–Huber–Mörtberg).
postulate A B X a b e x0
-- the circle: a point and a loop whose boundary is the point
data S1 = base | loop (i : I) [ i = 0 ↦ base , i = 1 ↦ base ]
#same loop i0 = base
#same loop i1 = base
#show λ (i : I) → loop i
-- the boundary holds after substitution: (plam i (loop i)) at 0 is base
#same (λ (i : I) → loop i) @ 0 = base
#same (λ (i : I) → loop (i /\ ~ i)) @ 1 = base
-- elimination, dependent, with its value on the loop
flip x = case x return λ y → S1 of base → base; loop i → loop (~ i)
#same flip base = base
#show λ (i : I) → flip (loop i)
#same (λ (i : I) → flip (loop i)) @ 1 = base
-- transport in the constant family of a closed HIT is a formal hcomp (no regularity)
#show transp (λ (i : I) → S1) base
#same transp (λ (i : I) → S1) base = hcompD [] base
-- elimination on a formal hcomp composes in the motive
#same flip (hcompD [] base) = hcompD [] base
-- the branches share the free variable c: elimination on hcomp keeps it
gc c x = case x return λ y → S1 of base → c; loop i → c
#same gc base (hcompD [] base) = hcompD [] base
#same gc (loop i0) base = base
#show λ (j : I) → flip (hcompD [ j = 0 ↦ λ (k : I) → loop k ] base)
-- composition with a tube: the formal hcomp keeps it
#show λ (j : I) → comp (λ (i : I) → S1) [ j = 0 ↦ λ (i : I) → loop i ] base
-- a covered tube is its end
#same comp (λ (i : I) → S1) (λ (i : I) → loop i) base = base
-- natural numbers: recursion by elimination
two = suc (suc zero)
#same add two two = suc (suc (suc (suc zero)))
#same mul two (add two (suc zero)) = suc (suc (suc (suc (suc (suc zero)))))
ind n = case n return λ m → Nat of zero → zero; suc k → suc k
#same ind two = two
plus zero n = n
plus (suc k) n = suc (rec k)
#same plus two (suc two) = add two (suc two)
double n = case n return λ m → Nat of zero → zero; suc k → suc (suc (rec k))
#same double (suc two) = add (suc two) (suc two)
-- a branch not using its hypotheses builds none: the same steps as before
len2 nil = zero
len2 (cons x r) = suc (rec r)
#same len2 (cons a (cons b nil)) = two
-- suspension: parameterized, with a meridian per point
data Susp T = N | S | merid (t : T) (i : I) [ i = 0 ↦ N , i = 1 ↦ S ]
#same merid a i0 = N
#same merid a i1 = S
#show λ (i : I) → merid a i
-- transport along a line of parameter types acts on the meridian's field
#show transp (λ (i : I) → Susp (ua A B e @ i)) N
#show λ (j : I) → transp (λ (i : I) → Susp (ua A B e @ i)) (merid a j)
-- the transported meridian restricts at its ends to the transported poles
#same (λ (j : I) → transp (λ (i : I) → Susp A) (merid a j)) @ 0 = transp (λ (i : I) → Susp A) N
#same (λ (j : I) → transp (λ (i : I) → Susp (ua A B e @ i)) (merid a j)) @ 1 = transp
                                                                                 (λ (i : I) →
                                                                                    Susp
                                                                                      (ua A B e @ i))
                                                                                 S
-- propositional truncation: recursive path constructor
data Trunc T
  = inc (t : T)
  | sq (v : Trunc T) (w : Trunc T) (i : I) [ i = 0 ↦ v , i = 1 ↦ w ]
#same sq (inc a) (inc b) i0 = inc a
#same sq (inc a) (inc b) i1 = inc b
#show λ (i : I) → sq (inc a) (inc b) i
#show transp (λ (i : I) → Trunc (ua A B e @ i)) (inc a)
-- elimination with induction hypotheses: (rec x) is the elimination of the recursive field x
tmap f (inc x) = inc (f x)
tmap f (sq v w i) = sq (rec v) (rec w) i
#same tmap (λ x → b) (sq (inc a) (inc a) i0) = inc b
#same (λ (i : I) → tmap (λ x → b) (sq (inc a) (sq (inc a) (inc a) i1) i)) @ 1 = inc b
#show λ (i : I) → tmap (λ x → b) (sq (inc a) (inc a) i)
-- lists, parameterized and recursive
#same length (append (cons a nil) (map (λ x → x) (cons a (cons b nil)))) = suc (suc (suc zero))
#show transp (λ (i : I) → List (ua A B e @ i)) (cons a nil)
