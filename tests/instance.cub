-- tests/instance.cub — instance arguments (plan E28): {{e : C A}} binders are implicit arguments
-- found by instance search among the `instance` declarations in scope (the latest matching first;
-- a candidate's own implicit arguments are bound by the match, its instance arguments searched in
-- turn) and the instance arguments in scope. Loaded after lib/std.cub.
record Eq (A : Type) = { eq : A → A → Bool ; eqid : Unit }
instance eqNat : Eq Nat
eqNat = (eqb , unit)
instance eqBool : Eq Bool
eqBool = ((λ a b → if a then b else not b) , unit)
equal : {A : Type} {{e : Eq A}} → A → A → Bool
equal {{e}} x y = eq e x y
#same equal 3 3 = true
#same equal true false = false
-- an instance with an instance argument of its own
eqlist : {A : Type} → (A → A → Bool) → List A → List A → Bool
eqlist f nil nil = true
eqlist f (cons x xs) (cons y ys) = andB (f x y) (eqlist f xs ys)
eqlist f _ _ = false
instance eqList : {A : Type} {{e : Eq A}} → Eq (List A)
eqList {A} {{e}} = (eqlist (eq e) , unit)
#same equal (cons 1 (cons 2 nil)) (cons 1 (cons 2 nil)) = true
#same equal (cons 1 (cons 2 nil)) (cons 1 (cons 3 nil)) = false
-- a local instance: the function's own instance argument
member : {A : Type} {{e : Eq A}} → A → List A → Bool
member x nil = false
member x (cons y ys) = if equal x y then true else member x ys
#same member 2 (cons 1 (cons 2 nil)) = true
#same member 5 (cons 1 (cons 2 nil)) = false
-- no instance for a function type: the argument is not determined
#fail
#check equal (λ (n : Nat) → n) (λ (n : Nat) → n) : Bool
-- an instance given by hand
#same equal {{eqBool}} true true = true
