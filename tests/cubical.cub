-- tests/cubical.cub — each (same t u) reads back t and u and compares.
postulate A B X a b f p q pa z e x0 y0 junk
-- β and projections
#same (λ x → x) a = a
#same (λ x y → x) a b = a
#same fst (a , b) = a
#same snd (a , b) = b
#same (λ x → (x , x)) (fst q) = (fst q , fst q)
-- the interval: De Morgan, i ∧ ~i is not 0
#same (λ (i : I) → (i , ~ i)) @ 0 = (i0 , i1)
#same (λ (i : I) → i /\ ~ i) @ 1 = i0
#show λ (i : I) → i /\ ~ i
#same (λ (i : I) → i \/ ~ i) @ 0 = i1
-- path endpoints, also for a neutral path
#same %@ p 0 a b = a
#same %@ p 1 a b = b
#show λ (j : I) → %@ p j a b
#same (λ (j : I) → %@ p j a b) @ 0 = a
-- the endpoints of a neutral path are read from its type (t 0 = u0 for t : Path A u0 u1)
postulate
  p0 : PathP (λ (i : I) → A) a b
  h0 : (x : A) → PathP (λ (i : I) → A) x x
  s0 : (x : A) × PathP (λ (i : I) → A) x x
#same p0 @ 0 = a
#same p0 @ 1 = b
#same (λ (j : I) → p0 @ j) @ 0 = a
#same h0 b @ 1 = b
#same snd s0 @ 0 = fst s0
#show λ (j : I) → p0 @ j
-- faces and systems
#same [ i0 = 0 ↦ a ] = a
#same [ i0 = 1 ↦ a , tt ↦ b ] = b
#same (λ (i : I) → [ i = 0 ↦ a , i = 1 ↦ b ]) @ 1 = b
#show λ (i : I) → [ i = 0 ↦ a , i = 1 ↦ b ]
#same (λ (i : I) → faceof [ i = 0 ↦ a ]) @ 0 = tt
-- Glue on its face
#same Glue A [ tt ↦ (B , e) ] = B
#same glue [ tt ↦ b ] a = b
#same unglue [ tt ↦ (A , idequiv A) ] a = a
#same (λ (i : I) → unglue [ i = 0 ↦ (A , idequiv A) ] (glue [ i = 0 ↦ a ] a)) = (λ (i : I) → a)
-- composition
#same comp (λ (i : I) → A → A) (λ (i : I) → f) f = f
#show transp (λ (i : I) → A → A) f
#same transp (λ (i : I) → A → A) f a = comp (λ (i : I) → A) [] (f (comp (λ (j : I) → A) [] a))
#same fst (transp (λ (i : I) → A × A) z) = comp (λ (i : I) → A) [] (fst z)
#same transp (λ (i : I) → PathP (λ (j : I) → A) a a) pa @ 0 = a
#same transp (λ (i : I) → Type) A = A
-- univalence
#same ua A B e @ 0 = A
#same ua A B e @ 1 = B
#same transp (ua A B e) a = comp (λ (i : I) → B) [] (comp (λ (i : I) → B) [] (fst e a))
-- transport along ua of a swap is the swap (followed by transport in the constant family)
swap s = (snd s , fst s)
#same transp (ua (X × X) (X × X) (swap , junk)) (x0 , y0) = (comp (λ (i : I) → X) []
                                                               (comp (λ (i : I) → X) [] y0)
                                                            , comp (λ (i : I) → X) []
                                                                (comp (λ (i : I) → X) [] x0))
-- composition in a Glue family over a face independent of the line agrees, on that face, with composition in the fibre
#same (λ (j : I) → transp (λ (i : I) → Glue B [ j = 0 ↦ (B , idequiv B) ]) (glue [ j = 0 ↦ b ] b)) @ 0 = transp
                                                                                                           (λ (i : I) →
                                                                                                              B)
                                                                                                           b
-- composition in the universe is a type of its own: its faces are the tube's lines, and the
-- complement of the tube's face carries the base, so where the tube is empty it is the base
#show λ (j : I) → comp (λ (i : I) → Type) [ j = 0 ↦ λ (i : I) → A ] A
#same (λ (j : I) → comp (λ (i : I) → Type) [ j = 0 ↦ λ (i : I) → A ] A) @ 1 = A
#same (λ (j : I) → comp (λ (i : I) → Type) [ j = 0 ↦ λ (i : I) → A × A ] A) @ 0 = A × A
-- paths
concat p q = λ (i : I) → hcomp A [ i = 0 ↦ λ (j : I) → a , i = 1 ↦ λ (j : I) → q @ j ] (p @ i)
#same concat p q @ 0 = a
#same concat p q @ 1 = q @ 1
-- sharing: a let-bound computation is done once and its value duplicated
big = transp (λ (i : I) → A → A) f
#show let y = big a in (y , y)
#show (big a , big a)
-- a partial input: the computation waits on it
#input w
#show fst w
#supply w = (a , b)
#same fst w = a
-- observation at a port: an unobserved divergent part does not block the answer
#same fst (a , (λ x → x x) (λ x → x x)) = a
-- a stream: a definition unfolds only when eliminated
ones = (a , ones)
#same fst (snd (snd ones)) = a
-- data types
two = suc (suc zero)
#same add two two = suc (suc (suc (suc zero)))
#same mul two (add two (suc zero)) = suc (suc (suc (suc (suc (suc zero)))))
#same iszero zero = true
#same iszero two = false
#same not (and true false) = true
#same length (append (cons a nil) (map f (cons a (cons b nil)))) = suc (suc (suc zero))
#same map f (cons a (cons b nil)) = cons (f a) (cons (f b) nil)
-- transport in a family of function types
#same transp (λ (i : I) → A → A) (λ x → x) a = comp (λ (i : I) → A) [] (comp (λ (j : I) → A) [] a)
-- demand: a component nobody reads is never computed, even one with no normal form
loop n = loop (suc n)
#same fst (zero , loop zero) = zero
#same (case cons zero (loop zero) of nil → suc zero; cons x r → x) = zero
