-- tests/codata.cub — coinductive records with copatterns (Cubical Agda --guardedness). Loaded after
-- lib/std.cub. A value of a codata type is a stuck call of a copattern definition; a projection
-- unfolds the call once. Path equality of orbits is bisimulation (punaragamana/Orbit.agda).
-- ---------------------------------------------------------------- orbits
codata Orbit (A : Type) where
  here : A
  next : Orbit A
unfold : {A : Type} → (A → A) → A → Orbit A
(unfold f a).here = a
(unfold f a).next = unfold f (f a)
mapO : {A B : Type} → (A → B) → Orbit A → Orbit B
(mapO f o).here = f (here o)
(mapO f o).next = mapO f (next o)
-- bisimulation: agreement at the head, and bisimulation of the tails
codata Bisim (A : Type) (x : Orbit A) (y : Orbit A) where
  bhere : PathP (λ (i : I) → A) (here x) (here y)
  bnext : Bisim A (next x) (next y)
bisim : {A : Type} {x y : Orbit A} → Bisim A x y → x ≡ y
(bisim p i).here = bhere p i
(bisim p i).next = bisim (bnext p) i
path->bisim : {A : Type} {x y : Orbit A} → x ≡ y → Bisim A x y
(path->bisim p).bhere = λ i → here (p i)
(path->bisim p).bnext = path->bisim {A} {next x} {next y} (λ i → next (p i))
iso1 : {A : Type} {x y : Orbit A} → (p : x ≡ y) → bisim (path->bisim p) ≡ p
(iso1 p i j).here = here (p j)
(iso1 p i j).next = iso1 {A} {next x} {next y} (λ k → next (p k)) i j
iso2 : {A : Type} {x y : Orbit A} → (p : Bisim A x y) → path->bisim (bisim p) ≡ p
(iso2 p i).bhere = bhere p
(iso2 p i).bnext = iso2 (bnext p) i
-- path equality of orbits is bisimulation
path=bisim : {A : Type} → (x y : Orbit A) → Equiv (x ≡ y) (Bisim A x y)
path=bisim x y =
  isoToEquiv (path->bisim {A} {x} {y}) (bisim {A} {x} {y}) (iso2 {A} {x} {y}) (iso1 {A} {x} {y})
-- mapping the identity is the identity: a bisimulation by corecursion, then a path
map-id-b : {A : Type} → (o : Orbit A) → Bisim A (mapO (λ a → a) o) o
(map-id-b o).bhere = λ i → here o
(map-id-b o).bnext = map-id-b (next o)
map-id : {A : Type} → (o : Orbit A) → mapO (λ a → a) o ≡ o
map-id o = bisim (map-id-b o)
-- ---------------------------------------------------------------- finite observation
-- the first n points of an orbit
take : {A : Type} → Nat → Orbit A → List A
take n =
  case n return (λ y → Orbit A → List A) of
    zero → λ o → nil
    suc k → λ o → cons (here o) (rec k (next o))
n0 = zero
n1 = suc n0
n2 = suc n1
n3 = suc n2
n4 = suc n3
#same take {Nat} n4 (unfold {Nat} (λ n → suc n) zero) = cons n0 (cons n1 (cons n2 (cons n3 nil)))
#same take {Nat} n3 (mapO {Nat} {Nat} (λ n → suc (suc n)) (unfold {Nat} (λ n → suc n) zero)) = cons
                                                                                                 n2
                                                                                                 (cons
                                                                                                    n3
                                                                                                    (cons
                                                                                                       n4
                                                                                                       nil))
-- an orbit is its stuck call; a projection unfolds it once
#show unfold {Nat} (λ n → suc n) zero
#same here (next (next (unfold {Nat} (λ n → suc n) zero))) = n2
#observe 2 unfold {Nat} (λ n → suc n) zero
-- a long observation: each projection unfolds one call
n20 =
  suc
    (suc
       (suc
          (suc
             (suc
                (suc
                   (suc
                      (suc
                         (suc
                            (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))))))))))))
#same here
        (case n20 return (λ y → Orbit Nat) of
           zero → unfold {Nat} (λ n → suc n) zero
           suc k → next (rec k)) = n20
-- a path between orbits computes: at its ends the two orbits, in between their bisimulation
#same here (map-id {Nat} (unfold {Nat} (λ n → suc n) zero) i0) = zero
#same take {Nat} n3 (map-id {Nat} (unfold {Nat} (λ n → suc n) zero) i1) = cons n0
                                                                            (cons n1 (cons n2 nil))
-- a typed reading: a stuck call at its type
nats : Orbit Nat
nats = unfold {Nat} (λ n → suc n) zero
#show nats
-- typed readings: a stuck call is read as the call, its arguments at their types; a field of a
-- neutral as the projection. Evaluating the code gives a value convertible with the original
qe T v = eval-g lnil (fromopt (quote-top T v) cword)
#same fromopt (quote-top (Orbit Nat) nats) cword = code (unfold {Nat} (λ n → suc n) zero)
#same conv (Orbit Nat) nats (qe (Orbit Nat) nats) = true
tl2 : Orbit Nat → Orbit Nat
tl2 o = next (next o)
#same fromopt (quote-top (Orbit Nat → Orbit Nat) tl2) cword = code (λ o → next (next o))
#same conv (Orbit Nat → Orbit Nat) tl2 (qe (Orbit Nat → Orbit Nat) tl2) = true
#show tl2
-- a definition that is its own tail is held once: the value is the call, and its tail is itself
zeros : Orbit Nat
zeros.here = zero
zeros.next = zeros
#same next (next zeros) = zeros
#show next zeros
-- ---------------------------------------------------------------- processes
-- an interactive process: to each question an answer and the process that continues. The
-- corecursive call stands under a λ and a pair in the field's term
codata Proc (Q : Type) (A : Type) where
  step : Q → A × Proc Q A
echo : {A : Type} → Proc A A
echo.step = λ q → (q , echo {A})
counter : Nat → Proc Unit Nat
(counter n).step = λ q → (n , counter (suc n))
-- running a process on a list of questions: its answers
run : {Q A : Type} → List Q → Proc Q A → List A
run qs =
  case qs return (λ y → Proc Q A → List A) of
    nil → λ p → nil
    cons q r → λ p → let s = step p q in cons (fst s) (rec r (snd s))
#same run {Nat} {Nat} (cons n3 (cons n1 (cons n4 nil))) (echo {Nat}) = cons n3
                                                                         (cons n1 (cons n4 nil))
#same run {Unit} {Nat} (cons unit (cons unit (cons unit nil))) (counter n2) = cons n2
                                                                                (cons n3
                                                                                   (cons n4 nil))
-- ---------------------------------------------------------------- mutual corecursion
mutual
  ping : Orbit Bool
  ping.here = true
  ping.next = pong
  pong : Orbit Bool
  pong.here = false
  pong.next = ping
#same take {Bool} n4 ping = cons true (cons false (cons true (cons false nil)))
-- ---------------------------------------------------------------- composition in codata
-- field by field, lazily: a field of a transported orbit is the field transported (composition is
-- generalized, so transport of a closed numeral leaves no formal composition: the numeral comes back)
#same here (transp (λ (i : I) → Orbit Nat) nats) = transp (λ (i : I) → Nat) zero
#same here (next (transp (λ (i : I) → Orbit Nat) nats)) = transp (λ (i : I) → Nat) n1
-- along univalence: an orbit of booleans transported along not
notB : Bool → Bool
notB b = if b then false else true
notB-inv : (b : Bool) → notB (notB b) ≡ b
notB-inv b = case b return (λ y → notB (notB y) ≡ y) of true → λ i → true; false → λ i → false
notB-eq : Equiv Bool Bool
notB-eq = isoToEquiv notB notB notB-inv notB-inv
notL = ua lzero Bool Bool notB-eq
#same here (transp (λ (i : I) → Orbit (notL i)) ping) = transp notL true
#same here (next (next (next (transp (λ (i : I) → Orbit (notL i)) ping)))) = transp notL false
#same transp notL true = transp (λ (i : I) → Bool) (transp (λ (i : I) → Bool) false)
-- canonicity: transport of a closed value of a data type reads as a constructor
#same transp notL true = false
#same transp (λ (i : I) → Nat) n1 = n1
#same here (next (transp (λ (i : I) → Orbit Nat) nats)) = n1
-- ---------------------------------------------------------------- compositions of types
-- the double cover of the circle: Bool over the base, not along the loop. A composite of loops is
-- a formal composition in the circle, so the fibre over it is a composition of types (a type of
-- its own, its faces the fibres' lines); transport through it builds its fibre from transports
-- along those lines, so the cost per loop is constant (before: 31M steps at four loops, no answer
-- at six)
notP : Bool ≡ Bool
notP = ua notB-eq
data Circ = cbase | cloop (i : I) [ i = 0 ↦ cbase , i = 1 ↦ cbase ]
cover : Circ → Type
cover x = case x of cbase → Bool; cloop i → notP i
cl : cbase ≡ cbase
cl = λ i → cloop i
wind : cbase ≡ cbase → Bool → Bool
wind p b = transport (λ i → cover (p i)) b
#same wind cl true = false
#same wind (concat cl cl) true = true
#same wind (concat (concat cl cl) cl) true = false
#same wind (concat (concat (concat (concat (concat (concat (concat cl cl) cl) cl) cl) cl) cl) cl) true = true
#same wind (concat (concat (concat (concat (concat (concat (concat cl cl) cl) cl) cl) cl) cl) cl) false = false
-- a composition with a face in a composition of types (the filler of the transport, checked at a
-- fresh dimension, where its tube's face is r = 0)
#check λ r → comp (λ i → cover (concat cl cl (r /\ i))) (λ i → [ r = 0 ↦ true ]) true
         : PathP (λ r → cover (concat cl cl r)) true true
#check λ r → comp (λ i → cover (concat (concat cl cl) cl (r /\ i))) (λ i → [ r = 0 ↦ true ]) true
         : PathP (λ r → cover (concat (concat cl cl) cl r)) true false
-- ---------------------------------------------------------------- composition into constructors
-- in a type without path constructors, a composition whose cap and sides are one constructor goes
-- into the fields (each along its type at the earlier fields' fillers): a path field transported
-- along ua is the constant path again, and a composition of numerals is a numeral
data DPair (A : Type) = dpair (x : A) (y : PathP (λ (i : I) → A) x x)
#same transp (λ (i : I) → DPair (notP i)) (dpair true (λ (j : I) → true)) = dpair false (λ (j : I) → false)
#same (λ (j : I) → comp (λ (i : I) → Nat) [ j = 0 ↦ λ (i : I) → n1 , j = 1 ↦ λ (i : I) → n1 ] n1) = λ (j : I) → n1
-- a side that is not a constructor keeps the composition formal (it is a variable's)
#show λ (n : Nat) (j : I) → comp (λ (i : I) → Nat) [ j = 0 ↦ λ (i : I) → n ] n
-- a later field whose type depends on an earlier one: composed along its type at the earlier
-- field's filler
codata Tagged where
  tag : Bool
  val : if tag then Nat else Bool
  more : Tagged
tagged : Nat → Tagged
(tagged n).tag = true
(tagged n).val = n
(tagged n).more = tagged (suc n)
#same val (more (tagged zero)) = n1
#same val (transp (λ (i : I) → Tagged) (tagged zero)) = comp
                                                          (λ (i : I) →
                                                             if (λ (k : I) →
                                                                   comp (λ (j : I) → Bool)
                                                                     (λ (j : I) → [ k = 0 ↦ true ])
                                                                     true) i
                                                               then Nat
                                                               else Bool) [] zero
-- ---------------------------------------------------------------- rejected
-- a call that is not guarded: under a projection, or as an argument of a function
#fail
bad : Orbit Nat
bad.here = here bad
bad.next = bad
#fail
bad2 : Nat → Orbit Nat
(bad2 n).here = n
(bad2 n).next = mapO (λ m → m) (bad2 n)
-- a field of the wrong type
#fail
bad3 : Orbit Nat
bad3.here = true
bad3.next = bad3
-- a boundary that does not hold at the next field
#fail
bad4 : {A : Type} {x y : Orbit A} → Bisim A x y → x ≡ y
(bad4 p i).here = bhere p i
(bad4 p i).next = bad4 (bnext p) (~ i)
-- a record only as a copattern definition's body
#fail
#check record { here = zero ; next = unfold {Nat} (λ n → suc n) zero } : Orbit Nat
-- a field type not strictly positive
#fail
codata Neg where
  f : Neg → Nat
-- a group is rejected when any of its bodies is not guarded, before any is checked (checking w1
-- compares (here w2), which would unfold w2's unguarded body)
codata W where
  a : Orbit Nat
  b : PathP (λ (i : I) → Nat) (here a) (here a)
#fail
mutual
  w1 : W
  w1.a = w2
  w1.b = λ i → zero
  w2 : Orbit Nat
  w2.here = here w2
  w2.next = w2
