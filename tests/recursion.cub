-- tests/recursion.cub — recursion beyond a constructor's fields: course-of-values (a call on a field's
-- field, at any depth) and recursion along a measure (decreasing by m using p).
-- ---------------------------------------------------------------- course-of-values
fib : Nat → Nat
fib zero = zero
fib (suc zero) = suc zero
fib (suc (suc n)) = plus (fib n) (fib (suc n))
#same fib 10 = 55
-- three below
trib : Nat → Nat
trib zero = zero
trib (suc zero) = zero
trib (suc (suc zero)) = suc zero
trib (suc (suc (suc n))) = plus (trib n) (plus (trib (suc n)) (trib (suc (suc n))))
#same trib 7 = 13
-- with a later parameter changing
half-add : Nat → Nat → Nat
half-add zero acc = acc
half-add (suc zero) acc = acc
half-add (suc (suc n)) acc = half-add n (suc acc)
#same half-add 9 0 = 4
-- trees: a grandchild
data Tree = leaf | node (l : Tree) (r : Tree)
size : Tree → Nat
size leaf = zero
size (node leaf r) = suc (size r)
size (node (node a b) r) = suc (plus (size a) (plus (size b) (suc (size r))))
#same size (node (node leaf leaf) (node leaf leaf)) = 3
-- ---------------------------------------------------------------- course-of-values, its type depending on the argument
mod2 : Nat → Nat
mod2 zero = zero
mod2 (suc zero) = suc zero
mod2 (suc (suc n)) = mod2 n
small : Nat → Type
small zero = Unit
small (suc zero) = Unit
small (suc (suc k)) = Empty
-- a proof by course-of-values
mod2-small : (n : Nat) → small (mod2 n)
mod2-small zero = unit
mod2-small (suc zero) = unit
mod2-small (suc (suc n)) = mod2-small n
-- with an implicit and a later argument
addd : {A : Type} → Nat → (A → A) → A → A
addd zero f a = a
addd (suc zero) f a = f a
addd (suc (suc n)) f a = f (f (addd n f a))
#same addd 5 suc zero = 5
-- ---------------------------------------------------------------- along a measure
n<ssn : (n : Nat) → n < suc (suc n)
n<ssn zero = unit
n<ssn (suc n) = n<ssn n
half : (n : Nat) → Nat
half zero = zero
half (suc zero) = zero
half (suc (suc n)) = suc (half n)
decreasing by n using n<ssn n
#same half 9 = 4
-- neither argument shrinks at every call; their sum does
<-suc-eq : (x y : Nat) → x ≡ y → x < suc y
<-suc-eq x y p = subst {_} {_} {_} {λ z → x < suc z} p (<-suc-self x)
zig : (a b : Nat) → Nat
zig zero b = b
zig (suc a) b = suc (zig b a)
decreasing by plus a b using <-suc-eq (plus b a) (plus a b) (plus-comm b a)
#same zig 3 2 = 5
-- ---------------------------------------------------------------- a recursion on an earlier argument whose clauses match a later one
-- first: the earlier argument is split first, so that each call re-splits the later one
ltb : Nat → Nat → Bool
ltb m zero = false
ltb zero (suc n) = true
ltb (suc m) (suc n) = ltb m n
#same ltb 2 3 = true
#same ltb 3 3 = false
#same ltb 4 2 = false
