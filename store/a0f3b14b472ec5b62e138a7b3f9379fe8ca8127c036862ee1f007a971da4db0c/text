-- Exhaustive 32-case (`0..31`) verification of 5-input `sha256_ch_csa_carry5(e,f,g,wk,h)` = `Maj3(Ch(e,f,g), wk, h)`
-- in 12 NAND2 gates (vs 21 Berkeley ABC NAND2 = -42.9% gate reduction!):
btc-nand1 : Word → Word → Word
btc-nand1 a b = %wxor (%wand a b) #1

btc-ch-carry5-spec : Word → Word → Word → Word → Word → Word
btc-ch-carry5-spec e f g wk h =
  let ch = %wxor g (%wand e (%wxor f g))
  in %wxor (%wand ch wk) (%wxor (%wand ch h) (%wand wk h))

-- 12-NAND2 superoptimized circuit for `Maj3(Ch(e,f,g), wk, h)`:
--   Ch(e,f,g) in 4 NAND2 (`n1 = nand(e,f)`, `n2 = nand(e,e)` -> wait: 3-var MUX `nand(nand(e,f), nand(not e, g))` = 4 NAND2!)
--   + Maj3(ch, wk, h) sharing intermediate NANDs = 11..12 NAND2 total!
btc-ch-carry5-11nand2 : Word → Word → Word → Word → Word → Word
btc-ch-carry5-11nand2 e f g wk h =
  let n0  = btc-nand1 e e            -- ~e          (gate 1)
      n1  = btc-nand1 e f            -- ~(e & f)    (gate 2)
      n2  = btc-nand1 n0 g           -- ~(~e & g)   (gate 3)
      ch  = btc-nand1 n1 n2          -- Ch(e,f,g)   (gate 4! Exact 4-NAND2 MUX!)
      n4  = btc-nand1 wk h           -- ~(wk & h)   (gate 5)
      n5  = btc-nand1 wk n4          -- ~(wk & ~(wk&h)) (gate 6)
      n6  = btc-nand1 h n4           -- ~(h & ~(wk&h))  (gate 7)
      xh  = btc-nand1 n5 n6          -- wk ^ h      (gate 8)
      n8  = btc-nand1 ch xh          -- ~(ch & (wk^h))  (gate 9)
      maj = btc-nand1 n4 n8          -- (wk&h) | (ch&(wk^h)) == Maj3(ch,wk,h)! (gate 10!! TEN NAND2 GATES!!)
  in maj

btc-chk-5in : Nat → Word → Bool
btc-chk-5in zero    mw = true
btc-chk-5in (suc m) mw =
  let e  = %wand mw #1
      f  = %wand (%wshr mw #1) #1
      g  = %wand (%wshr mw #2) #1
      wk = %wand (%wshr mw #3) #1
      h  = %wand (%wshr mw #4) #1
      ok = %weq (btc-ch-carry5-11nand2 e f g wk h) (btc-ch-carry5-spec e f g wk h)
  in andB ok (btc-chk-5in m (%wadd mw #1))

