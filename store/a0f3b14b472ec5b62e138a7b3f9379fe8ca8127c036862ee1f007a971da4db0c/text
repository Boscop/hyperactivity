btc-m32 : Word
btc-m32 = #4294967295

btc-add32 : Word → Word → Word
btc-add32 a b = %wand (%wadd a b) btc-m32

btc-rotr32 : Word → Word → Word
btc-rotr32 x n = %wand (%wor (%wshr (%wand x btc-m32) n) (%wshl (%wand x btc-m32) (%wsub #32 n))) btc-m32

-- Naive textbook Choose (2 ANDs + 1 NOT + 1 XOR) vs 1-AND Superoptimized Choose:
btc-ch-spec : Word → Word → Word → Word
btc-ch-spec e f g = %wxor (%wand e f) (%wand (%wxor (%wand e btc-m32) btc-m32) g)

btc-ch-opt : Word → Word → Word → Word
btc-ch-opt e f g = %wxor g (%wand e (%wxor f g))

-- Naive textbook Majority (3 ANDs + 2 XORs) vs 1-AND Superoptimized Majority (-66.7% ANDs!):
btc-maj-spec : Word → Word → Word → Word
btc-maj-spec a b c = %wxor (%wand a b) (%wxor (%wand a c) (%wand b c))

btc-maj-opt : Word → Word → Word → Word
btc-maj-opt a b c = %wxor a (%wand (%wxor a b) (%wxor a c))

btc-S0 : Word → Word
btc-S0 x = %wxor (btc-rotr32 x #2) (%wxor (btc-rotr32 x #13) (btc-rotr32 x #22))

btc-S1 : Word → Word
btc-S1 x = %wxor (btc-rotr32 x #6) (%wxor (btc-rotr32 x #11) (btc-rotr32 x #25))

btc-s0 : Word → Word
btc-s0 x = %wxor (btc-rotr32 x #7) (%wxor (btc-rotr32 x #18) (%wshr (%wand x btc-m32) #3))

btc-s1 : Word → Word
btc-s1 x = %wxor (btc-rotr32 x #17) (%wxor (btc-rotr32 x #19) (%wshr (%wand x btc-m32) #10))

