btc-add-iv : List Word → List Word → List Word
btc-add-iv nil         st          = nil
btc-add-iv (cons h hs) nil         = nil
btc-add-iv (cons h hs) (cons s ss) = cons (btc-add32 h s) (btc-add-iv hs ss)

-- Single CSA-Superoptimized SHA-256 round over 8-word state `[a,b,c,d,e,f,g,h]`:
btc-round-csa : Word → Word → List Word → List Word
btc-round-csa r wr st =
  let a   = btc-nth #0 st
      b   = btc-nth #1 st
      c   = btc-nth #2 st
      d   = btc-nth #3 st
      e   = btc-nth #4 st
      f   = btc-nth #5 st
      g   = btc-nth #6 st
      h   = btc-nth #7 st
      wk  = btc-add32 (btc-k r) wr
      c1  = btc-csa32 h (btc-S1 e) (btc-ch-opt e f g)
      c2  = btc-csa32 (fst c1) (snd c1) wk
      t1  = btc-add32 (fst c2) (snd c2)
      c3  = btc-csa32 t1 (btc-S0 a) (btc-maj-opt a b c)
      na  = btc-add32 (fst c3) (snd c3)
      ne  = btc-add32 d t1
  in cons na (cons a (cons b (cons c (cons ne (cons e (cons f (cons g nil)))))))

btc-rounds-n : Nat → Word → List Word → List Word → List Word
btc-rounds-n zero    r ws          st = st
btc-rounds-n (suc k) r nil         st = st
btc-rounds-n (suc k) r (cons w ws) st = btc-rounds-n k (%wadd r #1) ws (btc-round-csa r w st)

btc-compress : List Word → List Word → List Word
btc-compress hIn w16 =
  btc-add-iv hIn (btc-rounds-n (toNat #64) #0 (btc-schedule w16) hIn)

