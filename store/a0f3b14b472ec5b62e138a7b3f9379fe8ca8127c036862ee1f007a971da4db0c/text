btc-nth : Word → List Word → Word
btc-nth idx nil         = #0
btc-nth idx (cons x xs) = if %weq idx #0 then x else btc-nth (%wsub idx #1) xs

btc-expand-go : Nat → List Word → List Word
btc-expand-go zero    revw = cli-rev revw nil
btc-expand-go (suc k) revw =
  let w2  = btc-nth #1 revw
      w7  = btc-nth #6 revw
      w15 = btc-nth #14 revw
      w16 = btc-nth #15 revw
      wn  = btc-add32 (btc-add32 (btc-s1 w2) w7) (btc-add32 (btc-s0 w15) w16)
  in btc-expand-go k (cons wn revw)

btc-schedule : List Word → List Word
btc-schedule w16 = btc-expand-go (toNat #48) (cli-rev w16 nil)

btc-iv : List Word
btc-iv =
