btc-xor2-4nand : Word → Word → Word
btc-xor2-4nand a b =
  let n0 = btc-nand1 a b
      n1 = btc-nand1 a n0
      n2 = btc-nand1 b n0
  in btc-nand1 n1 n2

btc-s1-ch-16nand2 : Word → Word → Word → Word → Word → Word → Word
btc-s1-ch-16nand2 s1a s1b s1c e f g =
  let n0  = btc-nand1 e e
      n1  = btc-nand1 e f
      n2  = btc-nand1 n0 g
      ch  = btc-nand1 n1 n2
      xab = btc-xor2-4nand s1a s1b
      xcc = btc-xor2-4nand s1c ch
  in btc-xor2-4nand xab xcc

btc-chk-6in : Nat → Word → Bool
btc-chk-6in zero    mw = true
btc-chk-6in (suc m) mw =
  let s1a = %wand mw #1
      s1b = %wand (%wshr mw #1) #1
      s1c = %wand (%wshr mw #2) #1
      e   = %wand (%wshr mw #3) #1
      f   = %wand (%wshr mw #4) #1
      g   = %wand (%wshr mw #5) #1
      ref = %wxor (%wxor s1a (%wxor s1b s1c)) (%wxor g (%wand e (%wxor f g)))
