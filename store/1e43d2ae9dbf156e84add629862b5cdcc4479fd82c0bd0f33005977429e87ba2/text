-- bytes that check answer every query with the number of the suffixes that start with it
si-query-ok : (T : List (List Word)) → (L : List Word) → isTrue (si-made-ok T L) → (q : List (List Word)) → si-query L q ≡ fromNat (si-nstarts q (suffix-array T))
si-query-ok T L h q =
  si-index-ok T (list-length L) (text-bytes L) #8 (si-o0 T) (si-rd4 (list-length L) (text-bytes L) #0) (list-length (suffix-array-fast T)) (toNat (si-rd4 (list-length L) (text-bytes L) #4))
    (fst (si-made-and T L h)) (fst (snd (si-made-and T L h))) (fst (snd (snd (si-made-and T L h)))) (snd (snd (snd (si-made-and T L h)))) q
