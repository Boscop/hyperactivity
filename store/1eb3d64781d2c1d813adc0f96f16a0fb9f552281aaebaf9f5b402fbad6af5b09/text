spipe-step : (Word → HartInst) → SpecPipe → SpecPipe
spipe-step imem (spipe hs false ifPc ifInst) =
  spipe hs true (h-pc hs) (imem (h-pc hs))
spipe-step imem (spipe hs true ifPc ifInst) =
  let hs1    = hart-isa-step hs ifInst
      nextPc = %wsucc ifPc
  in spipe-resolve imem hs1 nextPc (weq (h-pc hs1) nextPc)
