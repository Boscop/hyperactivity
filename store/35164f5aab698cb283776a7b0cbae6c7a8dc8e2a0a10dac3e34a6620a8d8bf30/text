-- path application to a degenerate cube gives it back: the fold on the degeneracy section
papp-deg : (sk : Lst Entry) (X : Type 1) (f : DNF) (G : Cube (dims sk) X) →
  PathP (λ i → Cube (dims sk) X) (papp-cube sk X f (cube-map (dims sk) X (Line X) (degen-l X) G)) G
papp-deg sk X f G =
  pfold-sec (Type 1) Line (Cube (dims sk)) (ac sk) (λ X G → cube-map (dims sk) X (Line X) (degen-l X) G)
    (λ X G → pcat (Cube (dims sk) X) (cube-map (dims sk) (Line X) X (λ L → fst L) (cube-map (dims sk) X (Line X) (degen-l X) G)) (cube-map (dims sk) X X (λ x → x) G) G
       (cube-comp (dims sk) X (Line X) X (λ L → fst L) (degen-l X) G) (cube-id (dims sk) X G))
    (λ X G → pcat (Cube (dims sk) X) (cube-map (dims sk) (Line X) X (λ L → fst (snd L)) (cube-map (dims sk) X (Line X) (degen-l X) G)) (cube-map (dims sk) X X (λ x → x) G) G
       (cube-comp (dims sk) X (Line X) X (λ L → fst (snd L)) (degen-l X) G) (cube-id (dims sk) X G))
    (λ X G → cube-comp (dims sk) X (Line X) (Line X) (rev-l X) (degen-l X) G)
    (λ X G → cube-comp2 (dims sk) X (Line X) (Line X) (Line (Line X)) (meet-l X) (degen-l X) (degen-l (Line X)) (degen-l X) G (λ i → cube-map (dims sk) X (Line (Line X)) (λ x → degen-l (Line X) (degen-l X x)) G))
    (λ X G → cube-comp2 (dims sk) X (Line X) (Line X) (Line (Line X)) (join-l X) (degen-l X) (degen-l (Line X)) (degen-l X) G (λ i → cube-map (dims sk) X (Line (Line X)) (λ x → degen-l (Line X) (degen-l X x)) G))
    (λ k X G → diag-deg sk k X G) (dnf-ix f) X G
