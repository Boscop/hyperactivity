-- maps F̃ and the ε contraction are normalised as tr(h_e h_e⁻¹ h_e′ h_e′⁻¹) = 2 requires
pair-unit-sum : rows-eq (mat-plus (mat-plus (pair-unit 0 1 true true (cons 1 (cons 1 (cons 1 (cons 1 nil))))) (pair-unit 0 1 true false (cons 1 (cons 1 (cons 1 (cons 1 nil)))))) (mat-plus (pair-unit 0 1 false true (cons 1 (cons 1 (cons 1 (cons 1 nil))))) (pair-unit 0 1 false false (cons 1 (cons 1 (cons 1 (cons 1 nil))))))) (identity-rows 2 2) ≡ true
pair-unit-sum = λ i → true
