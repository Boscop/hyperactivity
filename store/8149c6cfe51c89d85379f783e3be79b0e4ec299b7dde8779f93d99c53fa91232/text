-- ---------------------------------------------------------------- finite bags
-- the free commutative monoid on a type: ∪ with its identities as path constructors
data Bag (A : Type)
  = emp
  | sng (a : A)
  | un (x : Bag A) (y : Bag A)
  | unitl (x : Bag A) (i : I) [ i = 0 ↦ un
                                                                                                             emp
                                                                                                             x
                                                                                                 , i = 1 ↦ x ]
  | unitr (x : Bag
                                                                                                                              A) (i : I) [ i = 0 ↦ un
                                                                                                                                                     x
                                                                                                                                                     emp
                                                                                                                                         , i = 1 ↦ x ]
  | assoc (x : Bag
                                                                                                                                                                      A) (y : Bag
                                                                                                                                                                                A) (z : Bag
                                                                                                                                                                                          A) (i : I) [ i = 0 ↦ un
                                                                                                                                                                                                                 (un
                                                                                                                                                                                                                    x
                                                                                                                                                                                                                    y)
                                                                                                                                                                                                                 z
                                                                                                                                                                                                     , i = 1 ↦ un
                                                                                                                                                                                                                 x
                                                                                                                                                                                                                 (un
                                                                                                                                                                                                                    y
                                                                                                                                                                                                                    z) ]
  | comm (x : Bag
                                                                                                                                                                                                                                       A) (y : Bag
                                                                                                                                                                                                                                                 A) (i : I) [ i = 0 ↦ un
                                                                                                                                                                                                                                                                        x
                                                                                                                                                                                                                                                                        y
                                                                                                                                                                                                                                                            , i = 1 ↦ un
                                                                                                                                                                                                                                                                        y
                                                                                                                                                                                                                                                                        x ]
