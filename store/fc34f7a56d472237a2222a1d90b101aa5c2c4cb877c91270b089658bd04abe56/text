cs-bind-res-mono : (hp : CsHeap) (r : CsRes) (k : CsHeap → CsVal → CsRes) →
  cs-res-mono hp r →
  ((hp1 : CsHeap) (v1 : CsVal) → cs-res-mono hp1 (k hp1 v1)) →
  cs-res-mono hp (cs-bind-res r k)
cs-bind-res-mono hp cso-abort k mr mk = unit
cs-bind-res-mono hp cso-ub k mr mk = unit
cs-bind-res-mono hp (cso-ok hp1 v1) k mr mk = cs-res-mono-trans hp hp1 (k hp1 v1) mr (mk hp1 v1)
