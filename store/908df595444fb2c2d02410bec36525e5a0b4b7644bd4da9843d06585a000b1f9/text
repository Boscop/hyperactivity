-- the upper bound of a query: top after its last token (after nothing, top alone)
sq-up-c : {A : Type} → A → List (List A) → List A → List (List A)
sq-up-c top r = case r return λ w → List A → List (List A) of
  nil → λ x → cons (list-append x (cons top nil)) nil
  cons z s → λ x → cons x (rec s z)
