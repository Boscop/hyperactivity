-- the borrow passes on: from k + (c + (y + 2Y)) = x + 2X, x + 2c' = s + (y + c), k = kb + 2kh, get kh + (c' + Y) = X
sub-hyp-alg : (kb sb : Bool) → (k kh c y Y x X c2 : Nat) → plus k (plus c (plus y (times 2 Y))) ≡ plus x (times 2 X) → plus x (times 2 c2) ≡ plus (bitn sb) (plus y c) → k ≡ plus (bitn kb) (times 2 kh) → plus kh (plus c2 Y) ≡ X
sub-hyp-alg kb sb k kh c y Y x X c2 h fsid ks =
  transN (congN (plus kh) (plus-comm c2 Y))
  (split-half-eq kb sb (plus kh (plus Y c2)) X
    (transN (congN (plus (bitn kb)) (transN (times2-plus kh (plus Y c2)) (congN (plus (times 2 kh)) (times2-plus Y c2))))
    (transN (symN (plus-assoc (bitn kb) (times 2 kh) (plus (times 2 Y) (times 2 c2))))
    (transN (congN (λ z → plus z (plus (times 2 Y) (times 2 c2))) (symN ks))
    (plus-cancel-l (plus y c) (plus k (plus (times 2 Y) (times 2 c2))) (plus (bitn sb) (times 2 X))
      (transN (symN (sub-lhs-alg k c y Y c2))
      (transN (congN (λ z → plus z (times 2 c2)) h)
      (sub-rhs-alg x X c2 (bitn sb) y c fsid))))))))
