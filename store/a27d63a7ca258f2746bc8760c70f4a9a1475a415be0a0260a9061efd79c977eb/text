pow2-mono : (a b : Nat) → leB a b ≡ true → leB (pow2 a) (pow2 b) ≡ true
pow2-mono zero zero = λ _ _ → true
pow2-mono zero (suc b) = λ _ → pow2-pos (suc b)
pow2-mono (suc a) zero = λ h → Empty-rec {lzero} {leB (pow2 (suc a)) (suc zero) ≡ true} (false≢true h)
pow2-mono (suc a) (suc b) = λ h →
  leB-plus (pow2 a) (pow2 b) (pow2 a) (pow2 b) (pow2-mono a b h) (pow2-mono a b h)
