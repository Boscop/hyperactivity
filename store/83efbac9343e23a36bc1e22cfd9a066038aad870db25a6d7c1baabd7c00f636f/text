lx-dec : (c : LinuxCmd) → List Word → Sum (lx-resp c) Unit
lx-dec c = case c return (λ x → List Word → Sum (lx-resp x) Unit) of
  lx-clock-gettime → lx-dec-sum {Timespec} lx-dec-time
  lx-nanosleep t → lx-dec-sum {Unit} lx-dec-unit
  lx-read fd buf len → lx-dec-sum {Upto len} (lx-dec-upto len)
  lx-write fd buf len → lx-dec-sum {Upto len} (lx-dec-upto len)
  lx-open path flags mode → lx-dec-sum {Word} lx-dec-word
  lx-close fd → lx-dec-sum {Unit} lx-dec-unit
  lx-mmap addr len prot flags fd off → lx-dec-sum {Word} lx-dec-word
  lx-munmap addr len → lx-dec-sum {Unit} lx-dec-unit
  lx-mprotect addr len prot → lx-dec-sum {Unit} lx-dec-unit
  lx-socket domain type proto → lx-dec-sum {Word} lx-dec-word
  lx-bind fd a → lx-dec-sum {Unit} lx-dec-unit
  lx-listen fd backlog → lx-dec-sum {Unit} lx-dec-unit
  lx-accept4 fd flags → lx-dec-sum {Word × SockAddr} lx-dec-peer
  lx-connect fd a → lx-dec-sum {Unit} lx-dec-unit
  lx-recvfrom fd buf len flags → lx-dec-sum {Upto len × SockAddr} (lx-dec-from len)
  lx-sendto fd buf len flags a → lx-dec-sum {Upto len} (lx-dec-upto len)
  lx-setsockopt fd level name val → lx-dec-sum {Unit} lx-dec-unit
  lx-epoll-create1 flags → lx-dec-sum {Word} lx-dec-word
  lx-epoll-ctl ep op fd ev → lx-dec-sum {Unit} lx-dec-unit
  lx-epoll-wait ep max timeout → lx-dec-sum {Upto max × List EpollEvent} (lx-dec-ready max)
  lx-futex-wait addr val → lx-dec-sum {Unit} lx-dec-unit
  lx-futex-wake addr n → lx-dec-sum {Upto n} (lx-dec-upto n)
  lx-getpid → lx-dec-word
  lx-exit-group ec → lx-dec-unit
  lx-alloc n → lx-dec-word
  lx-peek8 a → lx-dec-word
  lx-poke8 a v → lx-dec-unit
  lx-peek64 a → lx-dec-word
  lx-poke64 a v → lx-dec-unit
