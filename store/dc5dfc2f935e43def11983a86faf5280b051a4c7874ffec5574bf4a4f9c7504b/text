sem-contr : (s : TyShape) → Dec1 (Contr1 (Sem s))
sem-contr s-bool = c-derived (one , one-contr)
sem-contr (s-pi a b) = d-bind (Contr1 (Sem a)) (Contr1 (Sem (s-pi a b))) (sem-contr a) (λ Ca → d-bind (Contr1 (Sem b)) (Contr1 (Sem (s-pi a b))) (sem-contr b) (λ Cb → c-derived (fam-contr a b Ca Cb)))
sem-contr (s-sig a b) = d-bind (Contr1 (Sem a)) (Contr1 (Sem (s-sig a b))) (sem-contr a) (λ Ca → d-bind (Contr1 (Sem b)) (Contr1 (Sem (s-sig a b))) (sem-contr b) (λ Cb → c-derived (fam-contr a b Ca Cb)))
sem-contr (s-path a) = c-refused
