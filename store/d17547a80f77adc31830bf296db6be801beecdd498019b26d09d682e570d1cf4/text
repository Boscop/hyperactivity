bn-lut3-minterm : Word → Word → Word → Word → Word → Word
bn-lut3-minterm imm m a b c =
  if %weq (%wand (%wshr imm m) #1) #0
  then #0
  else
    let ma = the Word (if %weq (%wand (%wshr m #2) #1) #1 then a else bn-not64 a)
        mb = the Word (if %weq (%wand (%wshr m #1) #1) #1 then b else bn-not64 b)
        mc = the Word (if %weq (%wand m #1) #1            then c else bn-not64 c)
    in %wand ma (%wand mb mc)
