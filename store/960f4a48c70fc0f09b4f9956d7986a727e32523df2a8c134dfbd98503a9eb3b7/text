hyp-ruling-segs : Nat → Word → SInt → SInt → SInt → Word → List Seg3 → List Seg3
hyp-ruling-segs zero steps fam cv sv idx acc = acc
hyp-ruling-segs (suc rem) steps fam cv sv idx acc =
  let du = wquot #63000 steps
      u0 = si-add (sn #31500) (sp (wmul idx du))
      u1 = si-add (sn #31500) (sp (wmul (%wsucc idx) du))
      p0 = hyp-ruling-pt fam u0 cv sv
      p1 = hyp-ruling-pt fam u1 cv sv
      zm = si-div-w (si-add (snd p0) (snd p1)) #2
      s = seg3 zm (fst (fst p0)) (snd (fst p0)) (fst (fst p1)) (snd (fst p1)) #28
  in hyp-ruling-segs rem steps fam cv sv (%wsucc idx) (cons s acc)
