bn-lem-lut3-bc : (env m a : Word) → (b c : INetExpr) →
  inet-eval env (bn-mk-lut3 m (in-lit a) b c) ≡ bn-lut3-w64 m a (inet-eval env b) (inet-eval env c)
bn-lem-lut3-bc env m a (in-lit b)        c = bn-lem-lut3-c env m a b c
bn-lem-lut3-bc _   _ _ in-var0           _ = refl
bn-lem-lut3-bc _   _ _ (in-dup-add _)    _ = refl
bn-lem-lut3-bc _   _ _ (in-add _ _)      _ = refl
bn-lem-lut3-bc _   _ _ (in-xor _ _)      _ = refl
bn-lem-lut3-bc _   _ _ (in-era-l _ _)    _ = refl
bn-lem-lut3-bc _   _ _ (in-lut3 _ _ _ _) _ = refl
