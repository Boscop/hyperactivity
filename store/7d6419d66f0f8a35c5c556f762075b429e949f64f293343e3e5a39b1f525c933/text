-- the bracket of the lowest level of a Ritz problem with positive definite S: S has no negative direction, N at lo
-- has none (no level below lo), N at hi has one (one level below hi)
hc-bracket3 : (List (List BZ) × BZ) × (List (List BZ) × BZ) → BZ → BZ → BZ → Bool
hc-bracket3 pr lo hi sc = if hc-is 0 (fst (snd pr)) then (if hc-is 0 (hc-n pr lo sc) then hc-is 1 (hc-n pr hi sc) else false) else false
