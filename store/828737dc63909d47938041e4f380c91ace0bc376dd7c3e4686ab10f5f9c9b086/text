-- THE DIMENSION OF A^n IS AT MOST n: more than n vectors of A^n have a dependence with a nonzero coefficient
sy-vn-dim : (A : Type) → (z one : A) → (ad mu : A → A → A) → (ng : A → A) → (isz : A → Bool) → sy-DL A z ad mu ng isz → isz one ≡ false → (n : Nat) → sy-Dim A (sy-vn A n) z (sy-vz A z n) (sy-va A ad n) (sy-vs A mu n) isz n
sy-vn-dim A z one ad mu ng isz DL hone n = case n return λ k → sy-Dim A (sy-vn A k) z (sy-vz A z k) (sy-va A ad k) (sy-vs A mu k) isz k of
  zero → sy-dim-unit A z one isz hone
  suc m → sy-dim-step A (sy-vn A m) z ad mu ng isz (sy-vz A z m) (sy-va A ad m) (sy-vs A mu m) DL (sy-vn-wl A z ad mu ng isz DL m) m (sy-vn-dim A z one ad mu ng isz DL hone m)
