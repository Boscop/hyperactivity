zip-zz-ok : (ps xs : List Word) → zip-zz-dec ps (zip-zz-enc ps xs) ≡ xs
zip-zz-ok ps =
  case ps return (λ u → (xs : List Word) → zip-zz-dec u (zip-zz-enc u xs) ≡ xs) of
    nil → λ xs i → xs
    cons p ps1 → λ xs →
      case xs return (λ v → zip-zz-dec (cons p ps1) (zip-zz-enc (cons p ps1) v) ≡ v) of
        nil → λ i → nil
        cons x xs1 → λ i → cons (zz-dec-enc p x i) (rec ps1 xs1 i)
