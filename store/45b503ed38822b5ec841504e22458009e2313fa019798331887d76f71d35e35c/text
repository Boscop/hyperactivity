-- the search reads the site work by work, never as one value (Avik, 2026-11-18: "the corpus should never exist
-- as one value ... it should require as much memory is needed for local operation on the graph and that's it"):
-- /corpus is the list of the addresses it can read, /corpus/NAME one work's {h, t, x}, made from that work alone
s-corpus-names : List Work → List (List Word)
s-corpus-names nil = nil
s-corpus-names (cons (work n k p) r) = cons (s-cj-str (list-append "/" n)) (s-corpus-names r)
