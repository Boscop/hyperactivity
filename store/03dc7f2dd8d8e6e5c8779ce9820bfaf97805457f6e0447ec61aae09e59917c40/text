-- peeling an exact chain deeper than N down to depth N: each step past N keeps the value in U
descend : (Et : Nat → ZQ → Nat → ZQ) → (step : IE) → (Uv : ZQ → Type) → (N : Nat) →
  ((k : Nat) → (tv w : ZQ) → Uv tv → le (suc zero) (snd tv) → isval (Et (suc (plus k N)) tv) step w → Uv w) →
  (k : Nat) → (tv rv : ZQ) → Uv tv → le (suc zero) (snd tv) → echain Et step (plus k N) tv rv → (u : ZQ) × ((Uv u × le (suc zero) (snd u)) × echain Et step N u rv)
descend Et step Uv N inv k = case k return λ w → (tv rv : ZQ) → Uv tv → le (suc zero) (snd tv) → echain Et step (plus w N) tv rv → (u : ZQ) × ((Uv u × le (suc zero) (snd u)) × echain Et step N u rv) of
  zero → λ tv rv h l ch → (tv , ((h , l) , ch))
  suc k1 → λ tv rv h l ch → rec k1 (fst ch) rv (inv k1 tv (fst ch) h l (fst (snd ch))) (isval-pos (Et (suc (plus k1 N)) tv) step (fst ch) (fst (snd ch))) (snd (snd ch))
