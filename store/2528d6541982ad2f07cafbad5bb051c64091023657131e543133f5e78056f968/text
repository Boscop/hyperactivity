q-emit-rz : Word → Word → List Word
q-emit-rz q k =
  let k8 = %wmod k #8
  in if %weq k8 #0 then nil
     else if %weq k8 #1 then sv-concat (cons "t q[" (cons (q-digit q) (cons "];" (cons sv-nl nil))))
     else if %weq k8 #2 then sv-concat (cons "s q[" (cons (q-digit q) (cons "];" (cons sv-nl nil))))
     else if %weq k8 #3 then sv-concat (cons "s q[" (cons (q-digit q) (cons "]; t q[" (cons (q-digit q) (cons "];" (cons sv-nl nil))))))
     else if %weq k8 #4 then sv-concat (cons "z q[" (cons (q-digit q) (cons "];" (cons sv-nl nil))))
     else if %weq k8 #5 then sv-concat (cons "z q[" (cons (q-digit q) (cons "]; t q[" (cons (q-digit q) (cons "];" (cons sv-nl nil))))))
     else if %weq k8 #6 then sv-concat (cons "sdg q[" (cons (q-digit q) (cons "];" (cons sv-nl nil))))
     else sv-concat (cons "tdg q[" (cons (q-digit q) (cons "];" (cons sv-nl nil))))
