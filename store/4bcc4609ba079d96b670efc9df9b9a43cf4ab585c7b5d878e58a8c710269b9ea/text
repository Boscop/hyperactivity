sta-eco-maint : {O0 O1 O2 V : Type} → (d1 : O1 → Nat) → (d2 : O2 → Nat) → (env : V → Nat) →
  (extra : Nat) → (s : Nat × Circ O0 O1 O2 V) →
  Maintained {Nat × Circ O0 O1 O2 V} {Nat} (macro-sta {O0} d1 d2 env) s →
  Maintained {Nat × Circ O0 O1 O2 V} {Nat} (macro-sta {O0} d1 d2 env) (eco-add-buf {O0} {O1} {O2} {V} extra s)
sta-eco-maint {O0} {O1} {O2} {V} d1 d2 env extra s m =
  maint {Nat × Circ O0 O1 O2 V} {Nat}
    (macro-sta {O0} d1 d2 env) (eco-add-buf {O0} {O1} {O2} {V} extra) (λ r s2 → plus extra r)
    (sta-eco-law {O0} d1 d2 env extra) s m
