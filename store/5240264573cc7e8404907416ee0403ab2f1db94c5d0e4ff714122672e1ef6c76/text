rz-thm-mobius-inversion-60 = refl

-- THEOREM 2: EXACT DIRICHLET CONVOLUTION COMMUTATIVITY (mu * 1) == (1 * mu) FOR ALL n = 1..60!
rz-thm-dirichlet-comm-60 :
  rz-all-upto #60 (λ n → rz-eq (rz-conv rz-mu rz-const1 n) (rz-conv rz-const1 rz-mu n)) ≡ true
rz-thm-dirichlet-comm-60 = refl

-- THEOREM 3: EXACT DIRICHLET IDENTITY (eps * mu)(n) == mu(n) FOR ALL n = 1..60!
rz-thm-dirichlet-id-60 :
  rz-all-upto #60 (λ n → rz-eq (rz-conv rz-eps rz-mu n) (rz-mu n)) ≡ true
