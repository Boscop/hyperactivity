-- THEOREM 4: EXACT LOGARITHMIC PRIME-POWER PRODUCT IDENTITY:
--   prod_{d | n} mangoldt_base(d) == n   (multiplicative form of sum_{d|n} Lambda(d) = log n!)
rz-prod-mangoldt-go : Nat → Word → Word → Word → Word
rz-prod-mangoldt-go zero _ _ acc = acc
rz-prod-mangoldt-go (suc k) n d acc =
  let acc2 = if %weq (%wmod n d) #0 then %wmul acc (rz-mangoldt-base d) else acc
  in rz-prod-mangoldt-go k n (%wsucc d) acc2

rz-prod-mangoldt : Word → Word
rz-prod-mangoldt n = rz-prod-mangoldt-go (toNat n) n #1 #1

rz-thm-mangoldt-euler-60 :
  rz-all-upto #60 (λ n → %weq (rz-prod-mangoldt n) n) ≡ true
rz-thm-mangoldt-euler-60 = refl

-- THEOREM 5: EXACT MERTENS SQUARE-ROOT BOUND |M(n)|^2 <= n FOR ALL n = 1..60!
rz-mertens-sq-le : Word → Bool
rz-mertens-sq-le n =
  case rz-mertens n of
    rz _ m → not (%wlt n (%wmul m m))

rz-thm-mertens-bound-60 : rz-all-upto #60 rz-mertens-sq-le ≡ true
rz-thm-mertens-bound-60 = refl

