-- Exact Chebyshev psi_prod(N) = lcm(1..N) = prod_{p^k <= N} p (rational prime-music fundamental!)
rz-lcm : Word → Word → Word
rz-lcm a b = %wmul (%wdiv a (rz-gcd a b)) b

rz-chebyshev-lcm-go : Nat → Word → Word → Word
rz-chebyshev-lcm-go zero _ acc = acc
rz-chebyshev-lcm-go (suc k) cur acc =
  rz-chebyshev-lcm-go k (%wsucc cur) (rz-lcm acc cur)

rz-chebyshev-lcm : Word → Word
rz-chebyshev-lcm n = rz-chebyshev-lcm-go (toNat n) #1 #1

