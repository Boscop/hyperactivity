-- SECTION 1: EXACT SIGNED INTEGERS Z AND EXACT RATIONALS Q (ZERO FLOATS)
-- ============================================================================

-- Signed integer: zint pos mag (true = +mag, false = -mag; canonical 0 = zint true #0)
data RZ : Type where
  rz : (sgn : Bool) (mag : Word) → RZ

rz-zero : RZ
rz-zero = rz true #0

rz-one : RZ
rz-one = rz true #1

rz-neg1 : RZ
rz-neg1 = rz false #1

rz-norm : Bool → Word → RZ
rz-norm s m = if %weq m #0 then rz true #0 else rz s m

rz-neg : RZ → RZ
rz-neg (rz s m) = rz-norm (if s then false else true) m

rz-eqb : Bool → Bool → Bool
rz-eqb true true = true
rz-eqb false false = true
rz-eqb _ _ = false

rz-add : RZ → RZ → RZ
rz-add (rz s1 m1) (rz s2 m2) =
  if rz-eqb s1 s2 then rz-norm s1 (%wadd m1 m2)
  else if %wlt m1 m2 then rz-norm s2 (%wsub m2 m1)
  else rz-norm s1 (%wsub m1 m2)

rz-sub : RZ → RZ → RZ
rz-sub a b = rz-add a (rz-neg b)

rz-mul : RZ → RZ → RZ
rz-mul (rz s1 m1) (rz s2 m2) =
  rz-norm (rz-eqb s1 s2) (%wmul m1 m2)

rz-eq : RZ → RZ → Bool
rz-eq (rz s1 m1) (rz s2 m2) =
  if andB (%weq m1 #0) (%weq m2 #0) then true
  else andB (rz-eqb s1 s2) (%weq m1 m2)

-- Exact GCD on Word (bounded fuel for structural totality)
rz-gcd-go : Nat → Word → Word → Word
rz-gcd-go zero a _ = if %weq a #0 then #1 else a
rz-gcd-go (suc k) a b =
  if %weq b #0 then (if %weq a #0 then #1 else a)
  else rz-gcd-go k b (%wmod a b)

rz-gcd : Word → Word → Word
rz-gcd a b = rz-gcd-go (toNat #64) a b

-- Exact Rational Q = num / den (den > 0, reduced)
data RQ : Type where
  rq : (num : RZ) (den : Word) → RQ

rq-mk : RZ → Word → RQ
rq-mk (rz s m) d =
  let dd = if %weq d #0 then #1 else d
      g  = rz-gcd m dd
  in if %weq m #0 then rq rz-zero #1
     else rq (rz s (%wdiv m g)) (%wdiv dd g)

rq-zero : RQ
rq-zero = rq rz-zero #1

rq-one : RQ
rq-one = rq rz-one #1

rq-from-z : RZ → RQ
rq-from-z z = rq z #1

rq-neg : RQ → RQ
rq-neg (rq n d) = rq (rz-neg n) d

rq-add : RQ → RQ → RQ
rq-add (rq n1 d1) (rq n2 d2) =
  rq-mk (rz-add (rz-mul n1 (rz true d2)) (rz-mul n2 (rz true d1))) (%wmul d1 d2)

rq-sub : RQ → RQ → RQ
rq-sub a b = rq-add a (rq-neg b)

rq-mul : RQ → RQ → RQ
rq-mul (rq n1 d1) (rq n2 d2) =
  rq-mk (rz-mul n1 n2) (%wmul d1 d2)

rq-div-w : RQ → Word → RQ
rq-div-w (rq n d) k = rq-mk n (%wmul d (if %weq k #0 then #1 else k))

rq-eq : RQ → RQ → Bool
rq-eq (rq n1 d1) (rq n2 d2) =
  rz-eq (rz-mul n1 (rz true d2)) (rz-mul n2 (rz true d1))

rq-pos : RQ → Bool
rq-pos (rq (rz s m) _) = andB s (%wlt #0 m)

-- ============================================================================
-- SECTION 2: ARITHMETIC FUNCTIONS — PRIMALITY, MOBIUS mu(n), MERTENS M(n),
--            VON MANGOLDT Lambda(n), AND DIRICHLET CONVOLUTION RING (f * g)
-- ============================================================================

-- Smallest prime factor of n >= 2
rz-spf-go : Nat → Word → Word → Word
rz-spf-go zero n _ = n
rz-spf-go (suc k) n d =
  if %wlt n (%wmul d d) then n
  else if %weq (%wmod n d) #0 then d
  else rz-spf-go k n (%wsucc d)

rz-spf : Word → Word
rz-spf n = if %wlt n #2 then n else rz-spf-go (toNat n) n #2

rz-is-prime : Word → Bool
rz-is-prime n = andB (%wlt #1 n) (%weq (rz-spf n) n)

-- Exact Mobius function mu(n) in {-1, 0, +1}
rz-mu-go : Nat → Word → RZ → RZ
rz-mu-go zero _ acc = acc
rz-mu-go (suc k) n acc =
  if %wlt n #2 then acc
  else
    let p = rz-spf n
        q = %wdiv n p
    in if %weq (%wmod q p) #0 then rz-zero
       else rz-mu-go k q (rz-neg acc)

rz-mu : Word → RZ
rz-mu n = if %weq n #0 then rz-zero else rz-mu-go (toNat n) n rz-one

-- Exact Mertens function M(N) = sum_{k=1..N} mu(k)
-- (Riemann Hypothesis <=> M(x) = O(x^{1/2 + eps}) for all eps > 0!)
rz-mertens-go : Nat → Word → RZ → RZ
rz-mertens-go zero _ acc = acc
rz-mertens-go (suc k) cur acc =
  rz-mertens-go k (%wsucc cur) (rz-add acc (rz-mu cur))

rz-mertens : Word → RZ
rz-mertens n = rz-mertens-go (toNat n) #1 rz-zero

-- Exact prime-power base: returns p if n = p^k (k >= 1), else #1
-- (von Mangoldt Lambda(n) = log(rz-mangoldt-base n)!)
rz-div-all-p : Nat → Word → Word → Word
rz-div-all-p zero n _ = n
rz-div-all-p (suc k) n p =
  if %weq (%wmod n p) #0 then rz-div-all-p k (%wdiv n p) p else n

rz-mangoldt-base : Word → Word
rz-mangoldt-base n =
  if %wlt n #2 then #1
  else
    let p = rz-spf n
    in if %weq (rz-div-all-p (toNat n) n p) #1 then p else #1

-- Exact Dirichlet identity eps(n) = [n == 1] and constant 1(n) = 1
rz-eps : Word → RZ
rz-eps n = if %weq n #1 then rz-one else rz-zero

rz-const1 : Word → RZ
rz-const1 n = if %weq n #0 then rz-zero else rz-one

-- Exact Dirichlet Convolution: (f * g)(n) = sum_{d | n} f(d) * g(n / d)
rz-conv-go : Nat → (Word → RZ) → (Word → RZ) → Word → Word → RZ → RZ
rz-conv-go zero _ _ _ _ acc = acc
rz-conv-go (suc k) f g n d acc =
  let acc2 = if %weq (%wmod n d) #0
             then rz-add acc (rz-mul (f d) (g (%wdiv n d)))
             else acc
  in rz-conv-go k f g n (%wsucc d) acc2

rz-conv : (Word → RZ) → (Word → RZ) → Word → RZ
rz-conv f g n = if %weq n #0 then rz-zero else rz-conv-go (toNat n) f g n #1 rz-zero

