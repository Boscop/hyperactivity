-- SECTION 4: EXACT RATIONAL BERNOULLI NUMBERS & RIEMANN ZETA AT NEGATIVE INTEGERS
--   zeta(-n) = -B_{n+1} / (n + 1)  (exact analytic continuation over Q!)
--   Proves zeta(0) = -1/2, zeta(-1) = -1/12, zeta(-2) = 0, zeta(-3) = 1/120,
--          zeta(-4) = 0, zeta(-5) = -1/252, zeta(-6) = 0 (all trivial zeros exact!)
-- ============================================================================

-- Exact binomial coefficient C(n, k)
rz-binom-go : Nat → Word → Word → Word → Word
rz-binom-go zero _ _ acc = acc
rz-binom-go (suc rem) n i acc =
  rz-binom-go rem n (%wsucc i) (%wdiv (%wmul acc (%wsub (%wsucc n) i)) i)

rz-binom : Word → Word → Word
rz-binom n k =
  if %wlt n k then #0
  else rz-binom-go (toNat k) n #1 #1

-- Compute list [B_0, B_1, ..., B_m] via exact Akiyama-Tanigawa / recurrence:
--   sum_{j=0}^{m} C(m+1, j) B_j = 0  =>  B_m = -(1/(m+1)) sum_{j=0}^{m-1} C(m+1, j) B_j
rz-list-nth : List RQ → Nat → RQ
rz-list-nth nil _ = rq-zero
rz-list-nth (cons x _) zero = x
rz-list-nth (cons _ xs) (suc k) = rz-list-nth xs k

rz-bern-sum : List RQ → Word → Word → Nat → RQ → RQ
rz-bern-sum _ _ _ zero acc = acc
rz-bern-sum bs m1 j (suc rem) acc =
  let c  = rz-binom m1 j
      bj = rz-list-nth bs (toNat j)
      t  = rq-mul (rq-from-z (rz true c)) bj
  in rz-bern-sum bs m1 (%wsucc j) rem (rq-add acc t)

rz-bern-table-go : Nat → Word → List RQ → List RQ
rz-bern-table-go zero _ bs = bs
rz-bern-table-go (suc rem) m bs =
  let m1 = %wsucc m
      s  = rz-bern-sum bs m1 #0 (toNat m) rq-zero
      bm = rq-neg (rq-div-w s m1)
  in rz-bern-table-go rem m1 (list-append bs (cons bm nil))

rz-bernoulli-table : Word → List RQ
rz-bernoulli-table n = rz-bern-table-go (toNat n) #1 (cons rq-one nil)

rz-bernoulli : Word → RQ
rz-bernoulli n = rz-list-nth (rz-bernoulli-table n) (toNat n)

-- Exact analytic continuation zeta(-n) = -B_{n+1} / (n + 1) (with B_1 = -1/2 -> zeta(0) = -1/2 via B_1^+ = +1/2)
rz-zeta-neg : Word → RQ
rz-zeta-neg n =
  if %weq n #0 then rq-mk rz-neg1 #2
  else rq-neg (rq-div-w (rz-bernoulli (%wsucc n)) (%wsucc n))

