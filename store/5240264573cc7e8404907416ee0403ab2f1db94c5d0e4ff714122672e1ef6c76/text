-- Universal check helper: verify predicate P(k) holds for ALL k in 1..N
rz-all-upto-go : Nat → Word → (Word → Bool) → Bool
rz-all-upto-go zero _ _ = true
rz-all-upto-go (suc k) cur p =
  if p cur then rz-all-upto-go k (%wsucc cur) p else false

rz-all-upto : Word → (Word → Bool) → Bool
rz-all-upto n p = rz-all-upto-go (toNat n) #1 p

-- THEOREM 1: EXACT MOBIUS INVERSION IDENTITY (mu * 1)(n) == eps(n) FOR ALL n = 1..60!
rz-thm-mobius-inversion-60 :
