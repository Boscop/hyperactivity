-- /search?q=…: every published work holding the query, each read from its index where its bytes are: two
-- descents of the work's search tree, each node one comparison of the query's bytes; a work whose text has
-- no index yet is listed as such
sx-answer : List Word → List Word → Proc W (List Word)
sx-answer st q = if sx-none (tokenize (sx-lower q)) then ret {lzero} {W} (s-response "application/json" "[]")
  else bind (sx-each st (tokenize (sx-lower q)) s-published) (λ items →
    ret {lzero} {W} (s-response "application/json" (h-concat (cons "[" (cons (sx-join items) (cons "]" nil))))))
