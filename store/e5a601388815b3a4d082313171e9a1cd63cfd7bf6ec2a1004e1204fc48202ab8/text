-- the front page, then every published work's page and search item, each built in an isolated child only when missing
s-site-all : List Word → List Work → Proc W Unit
s-site-all st nil = bind (s-isolated (bind (s-site-kept st "front" s-front) (λ f → ret {lzero} {W} unit))) (λ ok → ret {lzero} {W} unit)
s-site-all st (cons (work n k p) r) =
  bind (s-ensure-mod st "page" p (if h-ends ".cub" p then s-essay p else s-doc p)) (λ ok1 →
  bind (s-ensure-mod st "corpus" p (s-corpus-one st (list-append "/" n))) (λ ok2 →
  s-site-all st r))
