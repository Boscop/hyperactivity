-- the determinant of a positive semidefinite integer matrix of f rows by fraction-free elimination: each
-- pivot is a leading principal minor, positive until one is zero, and then the determinant is zero (for a
-- semidefinite matrix det M ≤ det A · det C, Fischer's inequality, with A that leading block)
bareiss : Nat → Nat → List (List ZP) → Nat
bareiss f p m = case f of
  zero → p
  suc g → (case m of
    nil → p
    cons r rest → (if eqb (fst (zp-head r)) zero then zero
      else bareiss g (fst (zp-head r)) (rows-elim (zp-head r) p (zp-tail r) rest)))
