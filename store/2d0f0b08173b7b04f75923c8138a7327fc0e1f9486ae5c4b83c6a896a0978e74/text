-- ============================================================================
-- 2. Finite-Scale RG / Folding Convergence ⇒ Exact Relational Stable Fact
-- ============================================================================
-- If at finite coarse-graining scale `obs : Fine → Coarse` the local upper and lower
-- certificates meet everywhere (∀ y, lb y ≡ ub y), then the fine observable `val`
-- is provably a Stable Fact (`StableFor`) for the coarse observer — no further
-- refinement can change its value on any history in the fiber!
rg-tight-bracket-is-stable-fact :
  (Fine Coarse : Type 0) → (obs : Fine → Coarse) → (val : Fine → Nat) →
  (B : DualBracket Fine Coarse obs val) →
  ((y : Coarse) → fst B y ≡ fst (snd B) y) →
  StableFor Fine (Nat , val) (Coarse , obs)
rg-tight-bracket-is-stable-fact Fine Coarse obs val B all-tight =
  (fst B ,
   (λ x → sym (rg-tight-bracket-pins-value Fine Coarse obs val B x (all-tight (obs x)))))
