-- ---------------------------------------------------------------- order laws, by the checker
-- an environment from a list of integers (variables past the end are 0)
ienv : List Int → IEnv
ienv l v = %welimP (λ w → List Int → Z2) v (λ l → case l of nil → toZ2 zeroZ; cons x xs → toZ2 x) (λ n h l → case l of nil → toZ2 zeroZ; cons x xs → h xs) l
