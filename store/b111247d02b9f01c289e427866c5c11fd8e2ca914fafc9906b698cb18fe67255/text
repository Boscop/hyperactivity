-- any number as its head bit plus twice its tail
bin-split : (b : List Bool) → bin-to-nat b ≡ plus (bitn (bin-head b)) (times 2 (bin-to-nat (bin-tail b)))
bin-split b =
  case b return λ m → bin-to-nat m ≡ plus (bitn (bin-head m)) (times 2 (bin-to-nat (bin-tail m))) of
    nil → λ i → zero
    cons y ys → cons-val y ys
