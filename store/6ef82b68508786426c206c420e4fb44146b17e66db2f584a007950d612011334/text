-- an operation reads a held wire: it waits if nothing is there
sm-read : SmSlot → Word → SmOp → SmState → SmState
sm-read sms-none w o (sm-state sl rd n) = sm-state (smsl-cons w (sms-readers (smos-cons o smos-nil)) sl) rd n
sm-read (sms-readers os) w o (sm-state sl rd n) = sm-state (sm-set sl w (sms-readers (smos-cons o os))) rd n
sm-read (sms-val (smv-num m)) w o (sm-state sl rd n) = sm-state sl (smp-cons o (smv-num m) rd) n
sm-read (sms-val (smv-ref y)) w o (sm-state sl rd n) = sm-state sl (smp-cons o (smv-ref y) rd) n
sm-read (sms-val (smv-lam t e)) w o (sm-state sl rd n) = sm-read-copy t o rd (sm-copy e sl n)
sm-read (sms-op p) w o st = st
