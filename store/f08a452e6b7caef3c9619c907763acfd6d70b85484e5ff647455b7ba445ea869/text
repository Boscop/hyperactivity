-- ── 1. Universal Edge & Coupled Graph Laplacian Positivity (al-id over Q) ───
-- By linearity of edge sums, proving the single-edge identity
--   x_i * w*(x_i - x_j) + x_j * w*(x_j - x_i) = w * (x_i - x_j)^2 >= 0
-- proves x^T L x = sum_{(i,j) in E} w_{ij} (x_i - x_j)^2 >= 0 for EVERY N-node
-- graph (1D string, 2D plate, 3D room, non-Euclidean hypercube/Petersen) over Q!
-- Combined with fold-spectral-laplacian-id (3-node coupling) from fold/spectral-gram.
-- Variables (0..2): w, x0, x1.
wave-edge-lap-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wave-edge-lap-poly A ad mu q vs =
  (λ g sub sq →
    let w  = g 0; x0 = g 1; x1 = g 2
        lhs = ad (mu x0 (mu w (sub x0 x1))) (mu x1 (mu w (sub x1 x0)))
        rhs = mu w (sq (sub x0 x1))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
