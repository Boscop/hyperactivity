seg3-render : List Seg3 → List Word
seg3-render nil = nil
seg3-render (cons (seg3 z x0 y0 x1 y1 sw) r) =
  let -- Map depth z ∈ [-6600, +6600] to t ∈ [0, 100]
      zn = si-add z (sp #6600)
      t0 = case zn of sn _ → #0; sp w → wquot (wmul w #100) #13200
      t = if wlt #100 t0 then #100 else t0
      op = wadd #20 (wquot (wmul t #80) #100)
      swAdj = wquot (wmul sw (wadd #65 (wquot (wmul t #55) #100))) #100
      line = lg-concat (cons "<line x1='" (cons (lg-tenths x0) (cons "' y1='" (cons (lg-tenths y0) (cons "' x2='" (cons (lg-tenths x1) (cons "' y2='" (cons (lg-tenths y1) (cons "' stroke='#fff' stroke-width='" (cons (lg-tenths swAdj) (cons "' stroke-linecap='round' opacity='" (cons (lg-op op) (cons "'/>" nil)))))))))))))
  in list-append line (seg3-render r)
