-- the check of bytes L against the tokens T, decided once when they are made
si-made-ok-b : List (List Word) → (n : Nat) → Bytes n → Bool
si-made-ok-b T n B = andB (si-chk-chain n B #8 (si-o0 T) T) (andB (si-chk-tree n B (si-tree T) (si-rd4 n B #0))
  (andB (si-fuel (si-tree T) (toNat (si-rd4 n B #4))) (si-tokens-ok T)))
