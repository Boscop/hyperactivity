-- the number of binary digits of n (n's logarithm, rounded up): a word on n lines identifies one line
-- of about 2^bits, so its weight is 13 less this (n is at most 3000, under 2^12)
c-bits-f : Nat → Word → Word
c-bits-f zero n = #0
c-bits-f (suc f) n = if weq n #0 then #0 else wadd #1 (c-bits-f f (wshr n #1))
