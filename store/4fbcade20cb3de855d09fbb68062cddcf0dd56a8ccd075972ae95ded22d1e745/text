-- ---------------------------------------------------------------- the rule
nk-fire : NkAct → NkEnv → NkEnv → Word → Word → NkOut
nk-fire (act-ap t) aux parts out n = nk-build t (nk-eapp aux parts) out (nk-plan-of nkf-nil n)
nk-fire (act-rp t) aux parts out n = nk-build t (nk-eapp (nk-erev parts nke-nil) aux) out (nk-plan-of nkf-nil n)
nk-fire (act-hd h) aux parts out n = nk-plan-of (nkf-val out (nkv h nke-nil) (nk-era-env aux (nk-era-env parts nkf-nil))) n
nk-fire act-none aux parts out n = nk-plan-of (nk-era-env aux (nk-era-env parts nkf-nil)) n
