-- the conversion rank of an integer type (C17, ISO/IEC 9899:2018, 6.3.1.1 “Boolean, characters, and integers”, paragraph 1); the 128-bit types above long long
ct-rank : CTy → Word
ct-rank c = case c of
  ct-bool → #0
  ct-char → #1
  ct-schar → #1
  ct-uchar → #1
  ct-short → #2
  ct-ushort → #2
  ct-int → #3
  ct-uint → #3
  ct-long → #4
  ct-ulong → #4
  ct-llong → #5
  ct-ullong → #5
  ct-int128 → #6
  ct-uint128 → #6
  _ → #7
