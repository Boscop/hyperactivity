-- division with remainder: a = q·d + r, r < d, for canonical d ≥ 1
bin-divmod-sound : (a d : List Bool) → bcanon d ≡ true → le (suc zero) (bin-to-nat d) → div-post (bin-to-nat a) (bin-to-nat d) (bin-divmod a d)
bin-divmod-sound a d cd hd = div-divmod-fix a d (div-loop-sound (bin-rev-onto a nil) d nil nil cd (λ i → true) hd)
