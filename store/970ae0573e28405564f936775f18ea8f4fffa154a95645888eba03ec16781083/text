-- MMIO Isolation Theorem 2: Tensor-Core MMIO launches (`addr ≥ mmioBase`) NEVER corrupt CPU Data RAM
-- AND advance the 2×2 systolic accumulator by one exact GEMM wavefront!
soc-tensor-isolated : (mmioBase : Nat) → (st : SocBusState) → (addr val : Nat) → (wave : SysWave) →
  leB mmioBase addr ≡ true →
  (fst (soc-bus-write mmioBase st addr val wave) ≡ fst st) ×
  (snd (soc-bus-write mmioBase st addr val wave) ≡ systolic-step (snd st) wave)
soc-tensor-isolated mmioBase st addr val wave hMmio =
  ( (λ i → fst (mmio-dispatch mmioBase st addr val wave (hMmio i)))
  , (λ i → snd (mmio-dispatch mmioBase st addr val wave (hMmio i))) )
