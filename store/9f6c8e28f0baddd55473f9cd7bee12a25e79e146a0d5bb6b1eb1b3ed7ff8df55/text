lc-query-usdc6 : List Word → Proc W Word
lc-query-usdc6 owner20 =
  let cd     = list-append (cons #112 (cons #160 (cons #130 (cons #49 nil))))
                           (list-append (lc-zeros (toNat #12)) (h-take (toNat #20) owner20))
      cdHex  = list-append "0x" (h-hex cd)
      usdc55 = eth-eip55-from-bytes20 lc-usdc-base20
      pJson  = h-concat
                 (cons "[{" (cons (h-quote "to") (cons ":" (cons (h-quote usdc55)
                 (cons "," (cons (h-quote "data") (cons ":" (cons (h-quote cdHex)
                 (cons "}," (cons (h-quote "latest") (cons "]" nil)))))))))))
  in bind (bl-rpc-call "eth_call" pJson) (λ resp →
     ret {lzero} {W} (bl-hex-to-word (bl-extract-json-hex resp)))
