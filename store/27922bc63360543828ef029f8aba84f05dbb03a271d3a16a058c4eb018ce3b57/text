prog-def : Word → Code → Prog → Prog
prog-def g cd st =
  if self-head g cd
    then (case def-source g return (λ _ → Prog) of
            some cw → (if is-rec-body cw then prog-add g cw st else prog-bad g (not-fo infinite cd) st)
            none → prog-bad g (not-fo infinite cd) st)
    else prog-add g cd st
