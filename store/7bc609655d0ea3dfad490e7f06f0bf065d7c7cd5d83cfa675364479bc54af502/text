index-update-eq : (n : Nat) → (a : Array n) → (i j : Nat) → (hi : le (suc i) n) → (hj : le (suc j) n) → (v : Int64) → i ≡ j → index n (update n a i hi v) j hj ≡ v
index-update-eq n a i j hi hj v e =
  concat (cong {lzero} {lzero} {Fin n} {Int64} (λ p → index n (update n a i hi v) (fst p) (snd p)) {the (Fin n) (j , hj)} {the (Fin n) (i , hi)} (fin-eq n j i hj hi (sym {lzero} {Nat} {i} {j} e)))
         (index-update n a i hi v)
