-- Emits one physical standard cell of width `cellW` for every NAND2 gate in `gates`
nand-cell-widths : {V : Type} → Nat → NandCirc V → List Nat
nand-cell-widths cellW (cwire v) = nil
nand-cell-widths cellW (cop0 c) = nil
nand-cell-widths cellW (cop1 u a) = Empty-rec {lzero} {List Nat} u
nand-cell-widths cellW (cop2 b x y) =
  cons cellW (list-append (nand-cell-widths cellW x) (nand-cell-widths cellW y))
