-- UNIVERSAL EXECUTABLE CONTRACTOR SOUNDNESS OVER ALL WExpr & ALL env!
ha-contract-sound : (e : WExpr) → WEdge e (ha-contract e)
ha-contract-sound (we-k b) env = refl
ha-contract-sound (we-v i) env = refl
ha-contract-sound (we-not a) env =
  web-trans-b (λ i → web-notB (ha-contract-sound a env i)) (web-lem-not-xor (weval env (ha-contract a)))
ha-contract-sound (we-xor a b) env =
  web-trans-b (λ i → web-xorB (ha-contract-sound a env i) (ha-contract-sound b env i)) (ha-lem-mk-xor env (ha-contract a) (ha-contract b))
ha-contract-sound (we-and a b) env =
  web-trans-b (λ i → web-andB (ha-contract-sound a env i) (ha-contract-sound b env i)) (ha-lem-mk-and env (ha-contract a) (ha-contract b))
ha-contract-sound (we-or a b) env =
  web-trans-b (λ i → web-orB (ha-contract-sound a env i) (ha-contract-sound b env i)) (web-lem-or-anf (weval env (ha-contract a)) (weval env (ha-contract b)))
ha-contract-sound (we-ch e f g) env =
  web-trans-b (λ i → web-chB (ha-contract-sound e env i) (ha-contract-sound f env i) (ha-contract-sound g env i)) (web-lem-ch-mc1 (weval env (ha-contract e)) (weval env (ha-contract f)) (weval env (ha-contract g)))
ha-contract-sound (we-maj a b c) env =
  web-trans-b (λ i → web-majB (ha-contract-sound a env i) (ha-contract-sound b env i) (ha-contract-sound c env i)) (web-lem-maj-mc1 (weval env (ha-contract a)) (weval env (ha-contract b)) (weval env (ha-contract c)))
