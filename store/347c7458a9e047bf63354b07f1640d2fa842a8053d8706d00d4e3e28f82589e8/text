lqg-wilson-plaq-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-wilson-plaq-poly A ad mu q vs =
  (λ g sub sq →
    let phi = g 0
        q1 = q (fn-q 1 1)
        q2 = q (fn-q 2 1)
        den = ad q1 (sq phi)
        reN = sub q1 (sq phi)
    in (sub den reN , mu q2 (sq phi)))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
