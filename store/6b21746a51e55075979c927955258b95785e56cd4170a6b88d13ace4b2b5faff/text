pull-carry-of : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (gp : (x : X) (y : Y x) → F' (f x y) → F x)
  (s : (x : X) → Y x) (c : Cube n X) (E : DCube n X' F' (cube-map n X X' (λ x → f x (s x)) c)) →
  PathP (λ i → DCube n X F c)
    (dcube-pull n X X' Y F F' f gp c (dcube-of n X Y s c)
       (carry n X' F' (cube-map n X X' (λ x → f x (s x)) c) (dcube-map n X Y X' f c (dcube-of n X Y s c))
          (psym (Cube n X') (dcube-map n X Y X' f c (dcube-of n X Y s c)) (cube-map n X X' (λ x → f x (s x)) c) (dcube-map-of n X Y X' f s c)) E))
    (dcube-fmap n X (λ x → F' (f x (s x))) F (λ x z → gp x (s x) z) c (dcube-unreidx n X X' F' (λ x → f x (s x)) c E))
pull-carry-of zero X X' Y F F' f gp s c E = λ i → gp c (s c) (carry-uniq zero X' F' (f c (s c)) (f c (s c)) (λ j → f c (s c)) E E (λ j → E) i)
pull-carry-of (suc n) X X' Y F F' f gp s c E =
  pull-carry-of n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f gp) (lineo-of X Y s) c E
