nk-env-range-to-set : (al : NkEnv) (n0 n1 : NkW) (e : NkEnv) → (nk-env-in-range n0 n1 e ≡ true) → nk-env-in-set al n0 n1 e ≡ true
nk-env-range-to-set al n0 n1 nke-nil h = refl
nk-env-range-to-set al n0 n1 (nke-cons w r) h =
  nk-and-intro (nk-in-set al n0 n1 w) (nk-env-in-set al n0 n1 r)
    (nk-in-set-range al n0 n1 w (nk-and-l (nk-in-range n0 n1 w) (nk-env-in-range n0 n1 r) h))
    (nk-env-range-to-set al n0 n1 r (nk-and-r (nk-in-range n0 n1 w) (nk-env-in-range n0 n1 r) h))
