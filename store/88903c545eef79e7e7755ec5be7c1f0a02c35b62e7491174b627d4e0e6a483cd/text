zr-pn-inj : (p q : ZrP) → zr-pn p ≡ zr-pn q → p ≡ q
zr-pn-inj p q h = cl-tr ZrP p (zr-posof (zr-pred p)) q (λ i → zr-pa p (~ i))
  (cl-tr ZrP (zr-posof (zr-pred p)) (zr-posof (zr-pred q)) q
    (λ i → zr-posof (zr-npred (cl-tr Nat (suc (zr-pred p)) (zr-pn p) (suc (zr-pred q)) (λ j → zr-pb p (~ j)) (cl-tr Nat (zr-pn p) (zr-pn q) (suc (zr-pred q)) h (zr-pb q)) i)))
    (zr-pa q))
