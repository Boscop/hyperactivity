rm-cast-int : RCx → ROperand → RTy → RClass → RClass → RFrame → REv RV
rm-cast-int cx op sty sc dc = case dc of
  cl-scalar kd → (case sc of
    cl-scalar ks →
                   (let ev = rm-opd-rv cx op
                    in λ fr → rm-bind (ev fr) (λ v → rm-bind (rm-as-s v) (λ x →
                              rm-bind (rm-res (sv-conv ks kd x)) (λ y → rm-ret (rv-s y)))))
    cl-mem → (case op of
      rop-const c → λ fr → rm-throw (rx-unsupported (rz-cast rcast-int-to-int))
      rop-copy pl → rm-cast-enum cx pl sty kd
      rop-move pl → rm-cast-enum cx pl sty kd)
    _ → λ fr → rm-throw (rx-ill-formed ri-operand-class))
  _ → λ fr → rm-throw (rx-ill-formed ri-operand-class)
