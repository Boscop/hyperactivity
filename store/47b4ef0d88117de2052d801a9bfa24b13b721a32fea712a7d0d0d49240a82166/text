-- UNIVERSAL KERNEL SOUNDNESS FOR EVERY WEB ATOM & CONGRUENCE TREE
wa-sound : (r : WAtom) → WEdge (wa-lhs r) (wa-rhs r)
wa-sound (wa-refl e)              env = refl
wa-sound (wa-sym r)               env = web-sym-b (wa-sound r env)
wa-sound (wa-cong-not r)          env = λ i → web-notB (wa-sound r env i)
wa-sound (wa-cong-xor r1 r2)      env = λ i → web-xorB (wa-sound r1 env i) (wa-sound r2 env i)
wa-sound (wa-cong-and r1 r2)      env = λ i → web-andB (wa-sound r1 env i) (wa-sound r2 env i)
wa-sound (wa-cong-or  r1 r2)      env = λ i → web-orB  (wa-sound r1 env i) (wa-sound r2 env i)
wa-sound (wa-xor-self a)          env = web-lem-xor-self (weval env a)
wa-sound (wa-xor-0l a)            env = web-lem-xor-0l (weval env a)
wa-sound (wa-xor-0r a)            env = web-lem-xor-0r (weval env a)
wa-sound (wa-xor-comm a b)        env = web-lem-xor-comm (weval env a) (weval env b)
wa-sound (wa-xor-assoc a b c)     env = web-lem-xor-assoc (weval env a) (weval env b) (weval env c)
wa-sound (wa-and-self a)          env = web-lem-and-self (weval env a)
wa-sound (wa-and-0l a)            env = refl
wa-sound (wa-and-0r a)            env = web-lem-and-0r (weval env a)
wa-sound (wa-and-1l a)            env = refl
wa-sound (wa-and-1r a)            env = web-lem-and-1r (weval env a)
wa-sound (wa-and-comm a b)        env = web-lem-and-comm (weval env a) (weval env b)
wa-sound (wa-and-distrib-l a b c) env = web-lem-and-distrib-l (weval env a) (weval env b) (weval env c)
wa-sound (wa-not-xor a)           env = web-lem-not-xor (weval env a)
wa-sound (wa-or-anf a b)          env = web-lem-or-anf (weval env a) (weval env b)
wa-sound (wa-ch-def e f g)        env = refl
wa-sound (wa-ch-mc1 e f g)        env = web-lem-ch-mc1 (weval env e) (weval env f) (weval env g)
wa-sound (wa-maj-def a b c)       env = refl
wa-sound (wa-maj-mc1 a b c)       env = web-lem-maj-mc1 (weval env a) (weval env b) (weval env c)
