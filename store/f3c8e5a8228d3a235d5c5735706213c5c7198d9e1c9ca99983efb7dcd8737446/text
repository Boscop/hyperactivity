-- the text inside a line's string literals: each run between a quotation mark and the next
os-lits : Bool → List Word → List Word → List (List Word)
os-lits b cur nil = nil
os-lits b cur (cons x r) = if weq x #34 then (if b then cons (h-rev cur nil) (os-lits false nil r) else os-lits true nil r)
  else (if b then os-lits true (cons x cur) r else os-lits false cur r)
