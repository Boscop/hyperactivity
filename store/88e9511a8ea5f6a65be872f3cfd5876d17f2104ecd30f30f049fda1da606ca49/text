-- commit: the writes performed in order (earliest first)
tx-commit : List (Word × Word) → Proc {lzero} MemS Unit
tx-commit ws =
  case ws return (λ x → Proc {lzero} MemS Unit) of
    nil → ret {lzero} {MemS} {Unit} unit
    cons e r → bind {lzero} {MemS} {Unit} {Unit} (rec r) (λ u → cmd {lzero} {MemS} (mstore (fst e) (snd e)))
