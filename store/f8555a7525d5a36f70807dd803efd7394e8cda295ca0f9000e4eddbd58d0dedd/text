outer-branches : (Word → Code) → Word → Lst (Lst (Word × Word)) → Lst (Lst (Word × Word)) → Word → Lst Code
outer-branches eqf d shapes lnil c = lnil
outer-branches eqf d shapes (lcons ks more) c =
  lcons (clams (%wadd (d-len ks) (count-rec ks)) (clam (ccase d (inner-branches eqf ks shapes #0 c) (cvar #0))))
        (outer-branches eqf d shapes more (%wsucc c))
