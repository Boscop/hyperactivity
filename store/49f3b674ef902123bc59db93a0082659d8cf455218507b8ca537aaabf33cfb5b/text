sc-main : List (List Word) → Step W Word
sc-main args =
  let p  = sc-pref args
      sf = list-append p "_fabric.sv"
      mf = list-append p ".metal"
      hf = list-append p "_host.m"
      uf = list-append p "_h100.cu"
      jf = list-append p "_contract.json"
  in scmd w-now (λ t0 →
     scmd (w-file-write-named sf sc-sv-src) (λ bs →
     scmd (w-file-write-named mf sc-metal-src) (λ bm →
     scmd (w-file-write-named hf (sc-host-src mf)) (λ bh →
     scmd (w-file-write-named uf sc-cuda-src) (λ bu →
     scmd (w-file-write-named jf sc-json-src) (λ bj →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-SUPERCOMP DOR-DeadlockFree=1 Bisect=N/2 AllReduce=log2N WireCodec=4:3 SV="
       (list-append (ce-dec bs)
       (list-append "B Metal=" (list-append (ce-dec bm)
       (list-append "B Host=" (list-append (ce-dec bh)
       (list-append "B H100=" (list-append (ce-dec bu)
       (list-append "B JSON=" (list-append (ce-dec bj)
       (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))))))))
       (sdone #0))))))))
