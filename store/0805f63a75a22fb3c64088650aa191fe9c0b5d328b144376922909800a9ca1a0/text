-- Φ(m,n), scaled by s, added into acc: the five kinds, four branches each
proj-kinds : SQ → List Triple → VM → Nat → Nat → Nat → List Nat → Rows → List (List (List PRad)) → List (List (List PRad))
proj-kinds s ts aP k n m dsP xs0 acc = case k of
  zero → acc
  suc j → proj-kinds s ts aP j n m dsP xs0 (proj-term ts aP s k true n true m dsP xs0 (proj-term ts aP s k true n false m dsP xs0
    (proj-term ts aP s k false n true m dsP xs0 (proj-term ts aP s k false n false m dsP xs0 acc))))
