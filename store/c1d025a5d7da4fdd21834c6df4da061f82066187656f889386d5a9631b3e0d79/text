deep-encl-at : (S S2 : List Bool) → (envt : Nat → IV → Nat → IV) → (Et : Nat → ZQ → Nat → ZQ) → (st : IE) → (N : Nat) →
  bcanon S ≡ true → le (suc zero) (bin-to-nat S) → bin-to-nat S2 ≡ times (bin-to-nat S) (bin-to-nat S) → env-ok S envt Et →
  snd (irun S S2 envt st N (iv-unit S , true)) ≡ true → (rv : ZQ) → (u : ZQ) × ((uni S u × le (suc zero) (snd u)) × echain Et st N u rv) →
  inp S (fst (irun S S2 envt st N (iv-unit S , true))) rv
deep-encl-at S S2 envt Et st N cS hS hS2 H hf rv D =
  (fst (irun-sound S S2 envt Et st cS hS hS2 H N (iv-unit S , true) (fst D) rv (unit-canon S cS) (fst (fst (snd D))) (snd (fst (snd D))) (snd (snd D)) hf) ,
   (snd (irun-sound S S2 envt Et st cS hS hS2 H N (iv-unit S , true) (fst D) rv (unit-canon S cS) (fst (fst (snd D))) (snd (fst (snd D))) (snd (snd D)) hf) ,
    echain-pos Et st N (fst D) rv (snd (snd D))))
