nk-norm-it-s : Nat → NkTm → NkTm → NkTm
nk-norm-it-s zero kdefs t = nk-nf-s (toNat #30000) kdefs (nk-sub-forms nk-nil #0 t)
nk-norm-it-s (suc k) kdefs t =
  let nf = nk-nf-s (toNat #30000) kdefs (nk-sub-forms nk-nil #0 t)
      kn = nk-pass nf
  in if nk-tm-eq kn nf then nf else nk-norm-it-s k kdefs kn
