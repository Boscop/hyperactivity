w3-bool-refl-loop : {x y : Bool} → (p : x ≡ y) → (α : p ≡ p) → α ≡ refl
w3-bool-refl-loop {x} {y} p α =
  -- For any loop α : p ≡ p in a set (where ∀ q, p ≡ q via w2-bool-confluence),
  -- naturality of w2-bool-confluence p gives: α ∙ w2(p,p) ≡ w2(p,p), hence α ≡ refl!
  let c0 = w2-bool-confluence p p
      sq = λ i j → w2-bool-confluence p (α i) j
      -- Fill the 3-cube reducing α to refl via the constant-on-endpoint homotopy sq!
      h1 : (λ i → comp (λ j → x ≡ y) (λ j → [ i = 0 ↦ p , i = 1 ↦ sq i j ]) p) ≡ (λ i → α i)
      h1 = λ k i → comp (λ j → x ≡ y) (λ j → [ i = 0 ↦ p , i = 1 ↦ sq i j , k = 1 ↦ α i ]) p
      -- Even cleaner: on Bool, since `w2-bool-confluence p` is constant in its argument `q` when `q = α i`?
      -- Wait: `sq i 0 = p`, `sq i 1 = α i`, `sq 0 j = c0 j`, `sq 1 j = c0 j`!
      -- So composing the 2-cell square `sq` with `sym c0` along `j` cancels `c0` on BOTH faces `i=0` and `i=1`!
      cancel : (i : I) → p ≡ α i
      cancel i = λ k → comp (λ j → x ≡ y) (λ j → [ k = 0 ↦ c0 (~ j) , k = 1 ↦ sq i j ]) p
  in λ k i → comp (λ j → x ≡ y) (λ j → [ i = 0 ↦ c0 (~ j) , i = 1 ↦ c0 (~ j) , k = 0 ↦ sq i j , k = 1 ↦ c0 (~ j) ]) (sq i i0)
