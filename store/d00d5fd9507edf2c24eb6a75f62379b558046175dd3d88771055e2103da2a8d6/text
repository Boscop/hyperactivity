-- the search's index: one suffix array over every text it has read, built once (prefix doubling with counting sort,
-- O(n log n) for n characters); a query of m characters is two binary searches, O(m log n), then one step per place
s-find-index : List Word
s-find-index = "<script>var IX=null;function sabuild(s){var n=s.length,sa=new Int32Array(n),r=new Int32Array(n),t=new Int32Array(n),x=new Int32Array(n),m=65537,i,k,p,cnt;for(i=0;i<n;i++)r[i]=Math.min(s.charCodeAt(i),65535)+1;for(k=1;;k<<=1){cnt=new Int32Array(m+1);for(i=0;i<n;i++)cnt[i+k<n?r[i+k]:0]++;for(i=1;i<=m;i++)cnt[i]+=cnt[i-1];for(i=n-1;i>=0;i-=1){var g=i+k<n?r[i+k]:0;cnt[g]-=1;x[cnt[g]]=i}cnt=new Int32Array(m+1);for(i=0;i<n;i++)cnt[r[i]]++;for(i=1;i<=m;i++)cnt[i]+=cnt[i-1];for(i=n-1;i>=0;i-=1){var j=x[i];cnt[r[j]]-=1;sa[cnt[r[j]]]=j}t[sa[0]]=1;p=1;for(i=1;i<n;i++){var a=sa[i-1],b=sa[i];if(r[a]!==r[b]||(a+k<n?r[a+k]:0)!==(b+k<n?r[b+k]:0))p++;t[b]=p}var u=r;r=t;t=u;m=p;if(p===n)break}return sa}function saindex(D){var sep=String.fromCharCode(1),parts=[],starts=[],o=0;D.forEach(function(d){starts.push(o);parts.push(d.lx);o+=d.lx.length+1});var s=parts.join(sep);IX={s:s,sa:sabuild(s),starts:starts}}function bound(P,strict){var s=IX.s,sa=IX.sa,lo=0,hi=sa.length,m=P.length;while(lo<hi){var mid=(lo+hi)>>1,v=s.substr(sa[mid],m);if(strict?v<=P:v<P)lo=mid+1;else hi=mid}return lo}function docof(p){var st=IX.starts,lo=0,hi=st.length-1;while(lo<hi){var mid=(lo+hi+1)>>1;if(st[mid]<=p)lo=mid;else hi=mid-1}return lo}</script>"
