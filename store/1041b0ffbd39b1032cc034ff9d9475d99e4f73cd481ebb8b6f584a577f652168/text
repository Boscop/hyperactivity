-- the transaction run against the log: its result and the log
tx-run : {A : Type} → Proc {lsuc lzero} TxS A → TxLog → Proc {lzero} MemS (A × TxLog)
tx-run {A} p lg =
  p (TxLog → Proc {lzero} MemS (A × TxLog))
    (λ a lg2 → ret {lzero} {MemS} {A × TxLog} (a , lg2))
    (λ c k lg2 → bind {lzero} {MemS} {tx-resp c × TxLog} {A × TxLog} (tx-step c lg2) (λ r → k (fst r) (snd r)))
    lg
