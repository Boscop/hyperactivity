-- a symmetric matrix from its rows: the corner, the rest of the first row, the matrix below and right
zr-sym : (n : Nat) → List (List BZ) → it-sym ZrC n
zr-sym n = case n return λ k → List (List BZ) → it-sym ZrC k of
  zero → λ m → unit
  suc j → λ m → (zr-ofbz (in-hd (zr-hdr m)) , (zr-tup j (in-tl (zr-hdr m)) , rec j (ln-map (List BZ) (List BZ) in-tl (zr-tlr m))))
