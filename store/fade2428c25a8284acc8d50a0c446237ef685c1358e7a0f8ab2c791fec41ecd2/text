-- steps until rip is stop (checked before each step), at most n of them; none when a step's
-- outcome is not a value or the fuel ends first
run-to : (X86 → Outc exception Unit × X86) → Word → Word → X86 → Opt X86
run-to stp n stop =
  %welimP (λ _ → X86 → Opt X86) n (λ s → if weq (x86-rip s) stop then some s else none)
    (λ j h s → if weq (x86-rip s) stop then some s else x86-run-on h (stp s))
