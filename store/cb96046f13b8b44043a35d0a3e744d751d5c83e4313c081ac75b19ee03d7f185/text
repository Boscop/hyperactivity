-- Public Hyperactivity-computed SVG #3: Braided 3D Catenoid Wormhole H (4 symmetric strands)
logo-catenoid-braid-svg : List Word
logo-catenoid-braid-svg =
  let -- 4 symmetric helical phases: π/4, 3π/4, 5π/4, 7π/4 (scaled by 10000: 7854, 23562, 39270, 54978)
      r0 = split-strand (cat-sample-strand 65 #64 #0 (sp #7854))
      r1 = split-strand (cat-sample-strand 65 #64 #0 (sp #23562))
      r2 = split-strand (cat-sample-strand 65 #64 #0 (sp #39270))
      r3 = split-strand (cat-sample-strand 65 #64 #0 (sp #54978))
      allRuns = rrun-sort (list-append r0 (list-append r1 (list-append r2 r3)))
      inner = render-runs allRuns
      -- Symmetric vertical H mouth caps at x = 128 ± 81.2 (rEnd ≈ 84.0 -> y ∈ [41.5, 214.5], w = 8.4)
      caps : List Word
      caps = "<rect x='42.6' y='41.5' width='8.4' height='173' rx='3.8' fill='#fff'/><rect x='205' y='41.5' width='8.4' height='173' rx='3.8' fill='#fff'/>"
  in lg-concat (cons "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 256 256' width='256' height='256'><rect width='256' height='256' fill='#ff0a94'/><defs><clipPath id='hxW'><rect x='46.8' y='18' width='162.4' height='220'/></clipPath></defs><g clip-path='url(#hxW)'>"
       (cons inner (cons "</g>" (cons caps (cons "</svg>" nil)))))
