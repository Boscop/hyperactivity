bw-allz-map : (A V W : Type) → (isz : A → Bool) → (f : V → V → A) → (t : W → V) → (u : W) → (ur : List W) → it-allz A V isz f (t u) (bw-map V W t ur) ≡ it-allz A W isz (λ x y → f (t x) (t y)) u ur
bw-allz-map A V W isz f t u ur = case ur return λ l → it-allz A V isz f (t u) (bw-map V W t l) ≡ it-allz A W isz (λ x y → f (t x) (t y)) u l of
  nil → λ i → true
  cons x xr → λ i → if isz (f (t x) (t u)) then bw-allz-map A V W isz f t u xr i else false
