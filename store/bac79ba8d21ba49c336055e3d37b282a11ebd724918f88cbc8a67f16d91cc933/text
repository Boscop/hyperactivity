-- NLDM Parasitic Fanout/Wire Capacitance Monotonicity: additional fanout or wire capacitance `cExtra`
-- monotonically increases cell propagation delay!
nldm-cap-mono : (d0 alpha beta inSlew cBase cExtra : Nat) →
  le (nldm-delay d0 alpha beta inSlew cBase)
     (nldm-delay d0 alpha beta inSlew (plus cExtra cBase))
nldm-cap-mono d0 alpha beta inSlew cBase cExtra =
  leB-sound
    (nldm-delay d0 alpha beta inSlew cBase)
    (nldm-delay d0 alpha beta inSlew (plus cExtra cBase))
    (leB-plus d0 d0
      (plus (times alpha inSlew) (times beta cBase))
      (plus (times alpha inSlew) (times beta (plus cExtra cBase)))
      (leB-refl d0)
      (leB-plus
        (times alpha inSlew) (times alpha inSlew)
        (times beta cBase) (times beta (plus cExtra cBase))
        (leB-refl (times alpha inSlew))
        (catB
          (leB (times beta cBase) (times beta (plus cExtra cBase)))
          (leB (times beta cBase) (plus (times beta cExtra) (times beta cBase)))
          true
          (λ i → leB (times beta cBase) (times-distr-r beta cExtra cBase i))
          (leB-add-rc (times beta cBase) (times beta cExtra)))))
