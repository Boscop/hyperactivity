hx-web-main : List (List Word) → Step W Word
hx-web-main args =
  let p  = hx-web-pref args
      mf = list-append p ".metal"
      hf = list-append p "_bench.m"
  in scmd w-now (λ t0 →
     scmd (w-file-write-named mf hx-web-metal-src) (λ bm →
     scmd (w-file-write-named hf (hx-web-host-src mf)) (λ bh →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-WEB InfGroupoid(0/1/2/3-Cells)=1 WEquiv=1 Futamura(1/2/3)=1 Weaves(1->4)=1 Metal="
       (list-append (ce-dec bm)
       (list-append "B Host=" (list-append (ce-dec bh)
       (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))
       (sdone #0)))))
