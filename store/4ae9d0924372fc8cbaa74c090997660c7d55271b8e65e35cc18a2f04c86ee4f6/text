q-verify-toffoli-exact : List QGate → Bool
q-verify-toffoli-exact circ =
  web-andB (q-ok-exact circ #0) (web-andB (q-ok-exact circ #1)
  (web-andB (q-ok-exact circ #2) (web-andB (q-ok-exact circ #3)
  (web-andB (q-ok-exact circ #4) (web-andB (q-ok-exact circ #5)
  (web-andB (q-ok-exact circ #6) (q-ok-exact circ #7)))))))
