-- 1/n for n ≥ 1
iv-inv-inp : (S : List Bool) → (n : Nat) → inp S (iv-inv S (suc n)) (the (Nat × Nat) (suc zero , zero) , suc n)
iv-inv-inp S n = (iv-rat-canon S bin-one (bin-of-nat (suc n)) ,
  (transport (λ i → encl S (iv-inv S (suc n)) (the (Nat × Nat) (suc zero , zero)) (bin-of-nat-sound (suc n) i))
     (iv-rat-sound S bin-one (bin-of-nat (suc n)) (bin-of-nat-canon (suc n)) (transport (λ i → le (suc zero) (bin-of-nat-sound (suc n) (~ i))) (le-one-suc n))) ,
   le-one-suc n))
