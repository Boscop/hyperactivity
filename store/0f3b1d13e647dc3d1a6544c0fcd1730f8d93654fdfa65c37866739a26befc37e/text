-- the query: the number of the text's suffixes that start with q, read from the index's bytes L
si-query : List Word → List (List Word) → Word
si-query L q = wsub (si-cnt (list-length L) (text-bytes L) #8 (sq-up #256 q) (toNat (si-rd4 (list-length L) (text-bytes L) #4)) (si-rd4 (list-length L) (text-bytes L) #0))
                    (si-cnt (list-length L) (text-bytes L) #8 q (toNat (si-rd4 (list-length L) (text-bytes L) #4)) (si-rd4 (list-length L) (text-bytes L) #0))
