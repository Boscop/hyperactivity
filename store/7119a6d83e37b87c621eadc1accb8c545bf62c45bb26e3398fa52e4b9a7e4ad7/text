-- ---------------------------------------------------------------- §5.1
-- Language_ℓ: syntax, contexts, types, static judgment, inputs, configurations, commands and
-- replies, the step to Return + Fault + Tau(Conf) + Σ_c (Reply(c) → Conf), Init, Observe, Law
LanguageL : Type 1
LanguageL = (Syn : Type) × (Ctx : Type) × (Ty : Type) × (Static : Ctx → Syn → Ty → Type) × (Input : Syn → Type) ×
  (Conf : Syn → Type) × (Cmd : Type) × (Reply : Cmd → Type) × (Ret : Type) × (Flt : Type) ×
  ((p : Syn) → Conf p → Sum Ret (Sum Flt (Sum (Conf p) ((c : Cmd) × (Reply c → Conf p))))) ×
  ((p : Syn) → Input p → Conf p) × (Trace : Type) × (Obs : Type) × (Trace → Obs) × Type
