-- Theorem 5: Cross-channel consistency (no contradiction across rooms/formats).
-- For any archetype a and any two channels c1 c2, the wedge, primary artifact,
-- posture, and entity layer are identical.
channel-invariant-wedge : (a : Archetype) → (c1 c2 : Channel) → (K : KnowledgeObject) →
  Path Wedge (cs-wedge (project a c1 K)) (cs-wedge (project a c2 K))
channel-invariant-wedge a c1 c2 K = refl
