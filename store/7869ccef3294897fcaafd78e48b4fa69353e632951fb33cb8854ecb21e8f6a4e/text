-- the machine's definitions a schedule holds: kept as calls, not unfolded, when a use of the
-- machine is specialized
nk-holds : Lst Word
nk-holds = lcons (nk-gix (code nk-run)) (lcons (nk-gix (code nk-start)) (lcons (nk-gix (code nk-answer)) (lcons (nk-gix (code nk-get)) (lcons (nk-gix (code nk-mem)) lnil))))
