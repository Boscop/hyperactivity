hopf-render-arcs : SInt → SInt → SInt → SInt → SInt → List HArc → List Word
hopf-render-arcs cx cy maxSpan baseW ko2 nil = nil
hopf-render-arcs cx cy maxSpan baseW ko2 (cons (harc zAvg hpts) r) =
  let rpts = hopf-fit-pts cx cy maxSpan baseW hpts
      dFg = ribbon-poly-d rpts si-zero
      seg = if si-lt (sn #4000) zAvg
            then let dKo = ribbon-poly-d (hopf-trim1 rpts) ko2
                 in lg-concat (cons "<path d='" (cons dKo (cons "' fill='#ff0a94'/><path d='" (cons dFg (cons "' fill='#fff'/>" nil)))))
            else lg-concat (cons "<path d='" (cons dFg (cons "' fill='#fff'/>" nil)))
  in list-append seg (hopf-render-arcs cx cy maxSpan baseW ko2 r)
