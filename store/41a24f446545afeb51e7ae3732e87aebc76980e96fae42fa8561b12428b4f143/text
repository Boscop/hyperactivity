si-bool3 : (a : Bool) → (u : Bool) → (isTrue u → isTrue a) → one-if (not u) ≡ plus (one-if (not a)) (one-if (andB a (not u)))
si-bool3 a u =
  (case a return λ y → (isTrue u → isTrue y) → one-if (not u) ≡ plus (one-if (not y)) (one-if (andB y (not u))) of
     true → λ h → (case u return λ z → one-if (not z) ≡ plus (one-if (not true)) (one-if (andB true (not z))) of
                    true → λ i → zero
                    false → λ i → suc zero)
     false → λ h → (case u return λ z → (isTrue z → isTrue false) → one-if (not z) ≡ plus (one-if (not false)) (one-if (andB false (not z))) of
                     true → λ h2 → Empty-rec (h2 unit)
                     false → λ h2 i → suc zero) h)
