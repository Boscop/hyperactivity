-- ============================================================================
-- 2. Constructive Levinthal Resolution (Linear-Time Funnel Descent)
-- ============================================================================
-- Iterated local conformational move: k steps of `step` from starting fold `c`.
fold-descent : {C : Type 0} → Nat → (C → C) → C → C
fold-descent zero step c = c
fold-descent (suc k) step c = fold-descent k step (step c)
