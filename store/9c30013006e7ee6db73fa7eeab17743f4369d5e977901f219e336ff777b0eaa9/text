-- run-to at a state whose rip is stop stops there, whatever the fuel
at-stop : (stp : X86Step) → (stop : Word) → (s : X86) → weq (x86-rip s) stop ≡ true → (n : Word) → run-to stp n stop s ≡ some s
at-stop stp stop s h n =
  %welimP (λ v → run-to stp v stop s ≡ some s) n
    (cong (λ b → if b then some s else none) h)
    (λ j ih → cong (λ b → if b then some s else x86-run-on (run-to stp j stop) (stp s)) h)
