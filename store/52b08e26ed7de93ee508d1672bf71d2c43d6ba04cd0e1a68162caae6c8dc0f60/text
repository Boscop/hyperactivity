-- the interval of an expression, and whether every division in it was by an interval holding no zero
ieval : List Bool → List Bool → (Nat → IV) → IE → IV × Bool
ieval S S2 env e = case e return λ w → IV × Bool of
  ie-var k → (env k , true)
  ie-int k → (iv-int S k , true)
  ie-rat n d → (iv-rat S (bin-of-nat n) (bin-of-nat (suc d)) , true)
  ie-add a b → (iv-add (fst (rec a)) (fst (rec b)) , both (snd (rec a)) (snd (rec b)))
  ie-sub a b → (iv-sub (fst (rec a)) (fst (rec b)) , both (snd (rec a)) (snd (rec b)))
  ie-mul a b → (iv-mul S (fst (rec a)) (fst (rec b)) , both (snd (rec a)) (snd (rec b)))
  ie-div a b → (iv-div S S2 (fst (rec a)) (fst (rec b)) , both (both (snd (rec a)) (snd (rec b))) (not (iv-has-zero (fst (rec b)))))
