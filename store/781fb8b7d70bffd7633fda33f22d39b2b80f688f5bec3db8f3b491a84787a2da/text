-- fiber-refinement monotonicity: any intervention warranted under obs1 remains warranted
-- after adding obs2 (zero re-verification needed when new compatible data arrives)
warranted-refine : (M O1 O2 I R : Type 0)
                 → (obs1 : M → O1) → (obs2 : M → O2) → (y1 : O1) → (y2 : O2)
                 → (run : M → I → R) → (target : R) → (u : I)
                 → Warranted M O1 I R obs1 y1 run target u
                 → (mp : ModelFib2 M O1 O2 obs1 obs2 y1 y2) → run (fst mp) u ≡ target
warranted-refine M O1 O2 I R obs1 obs2 y1 y2 run target u w mp =
  w (fst mp , fst (snd mp))
