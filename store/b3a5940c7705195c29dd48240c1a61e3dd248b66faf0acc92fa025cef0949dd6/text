secp-ecdsa-sign : Word → List Word → Word × (Word × Word)
secp-ecdsa-sign priv msgHash32 =
  let z    = %wmod (h-be msgHash32) secp-n
      k    = secp-det-nonce priv msgHash32 #0
      sig0 = secp-ecdsa-sign-nonce priv z k
  in if orB (%weq (fst (snd sig0)) #0) (%weq (snd (snd sig0)) #0)
     then secp-ecdsa-sign-nonce priv z (secp-det-nonce priv msgHash32 #1)
     else sig0
