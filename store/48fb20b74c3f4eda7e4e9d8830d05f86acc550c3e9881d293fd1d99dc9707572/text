-- ---------------------------------------------------------------- 3. Intrinsic manifold constraint
-- Sadtler et al. (Nature, 2014); Golub et al. (Nature Neuroscience, 2018):
-- Neural activity lies on an intrinsic submanifold ι : M → S. A within-manifold decoder perturbation
-- factors through a reassociation equivalence e : Equiv M M and transports reachability constructively.
within-manifold-reach : {M S O : Type} → (ι : M → S) → (d d' : S → O) →
  (e : Equiv M M) → ((m : M) → d' (ι m) ≡ d (ι (fst e m))) →
  (y : O) → fiber (λ (m : M) → d (ι m)) y → fiber (λ (m : M) → d' (ι m)) y
within-manifold-reach {M} {S} {O} ι d d' e fac y wm =
  let inv-m = fst (fst (snd e (fst wm)))
      inv-eq = snd (fst (snd e (fst wm)))
  in (inv-m , concat (fac inv-m) (concat (cong (λ (m : M) → d (ι m)) inv-eq) (snd wm)))
