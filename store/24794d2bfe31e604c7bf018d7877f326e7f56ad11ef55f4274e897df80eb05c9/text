-- a property of each input is a property of every numbered input
env-all3 : (P : IV → ZQ → Type) → (x y z : IV) → (xv yv zv : ZQ) → P x xv → P y yv → P z zv → (k : Nat) → P (env3 x y z k) (env3q xv yv zv k)
env-all3 P x y z xv yv zv hx hy hz k = case k return λ w → P (env3 x y z w) (env3q xv yv zv w) of
  zero → hx
  suc k1 → (case k1 return λ w → P (env3 x y z (suc w)) (env3q xv yv zv (suc w)) of
    zero → hy
    suc k2 → hz)
