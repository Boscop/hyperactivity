s-answer-hi : List Word → List Word → List Word → List Word → Proc W (List Word) → Proc W (List Word)
s-answer-hi st m path p next =
  if h-eq p "/hi/events" then hi-events st (s-query path) else
  if h-eq p "/hi/scene" then hi-scene-get st (s-query path) else
  if h-eq p "/hi/field" then ret {lzero} {W} (s-response s-html hi-field-page) else
  if h-eq p "/hi/room" then ret {lzero} {W} (s-response s-html hi-room-page) else
  if h-eq p "/hi" then hi-view st (s-query path) else
  if h-eq p "/api/meaning" then ch-api (s-param "q" (s-query path)) else
  if h-eq p "/chat" then ch-answer m (s-param "q" (s-query path)) else
  next
