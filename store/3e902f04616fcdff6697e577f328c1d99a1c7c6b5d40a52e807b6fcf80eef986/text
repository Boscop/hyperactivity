-- the sides of a system agree wherever their faces hold together (the context restricted there)
nk-compat-t : NkTm → Word → NkTm → NkTm → NkTm → NkTm → Bool
nk-compat-t ctx n u1 u2 sg (nk-cons tau r) = if nk-consistent sg tau then (if nk-tm-eq (nk-norm-in (nk-sub-clause tau (nk-sub-clause sg ctx)) n (nk-sub-clause tau (nk-sub-clause sg u1))) (nk-norm-in (nk-sub-clause tau (nk-sub-clause sg ctx)) n (nk-sub-clause tau (nk-sub-clause sg u2))) then nk-compat-t ctx n u1 u2 sg r else false) else nk-compat-t ctx n u1 u2 sg r
nk-compat-t ctx n u1 u2 sg t = true
