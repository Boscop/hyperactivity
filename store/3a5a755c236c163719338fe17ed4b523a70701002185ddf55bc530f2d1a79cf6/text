conj-sub-weak : (m : Lit) (c d : Conj) → conj-sub c d ≡ true → conj-sub c (lcons m d) ≡ true
conj-sub-weak m lnil d h = λ i → true
conj-sub-weak m (lcons l ls) d h =
  andB-intro (conj-has l (lcons m d)) (conj-sub ls (lcons m d))
    (conj-has-weak l m d (andB-l (conj-has l d) (conj-sub ls d) h))
    (conj-sub-weak m ls d (andB-r (conj-has l d) (conj-sub ls d) h))
