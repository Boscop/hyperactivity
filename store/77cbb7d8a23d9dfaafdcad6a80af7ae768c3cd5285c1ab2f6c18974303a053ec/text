compress-delta-record-ok : (bs : List Word) → decompress-delta-record (compress-delta-record bs) ≡ bs
compress-delta-record-ok bs =
  concat {lzero} {List Word}
    {zz-undelta (decompress-record (compress-record (zz-delta bs)))}
    {zz-undelta (zz-delta bs)} {bs}
    (cong {lzero} {lzero} {List Word} {List Word} zz-undelta (compress-record-ok (zz-delta bs)))
    (zz-delta-ok bs)
