-- Evaluate total stabilization score of a contact list (pairs of residue indices) + backbone H-bond gain (2 per H-bond).
fold-score-contacts : List AA → List (Nat × Nat) → Nat
fold-score-contacts seq nil = zero
fold-score-contacts seq (cons p rest) =
  plus (plus 2 (aa-pair-gain (aa-nth (fst p) seq) (aa-nth (snd p) seq)))
       (fold-score-contacts seq rest)
