-- Σ over pairs at distance d of ±1 (equal +, unequal −), from position i, on k sites
lc-diag : Nat → Nat → Nat → List Bool → BZ
lc-diag d k i s = case k of
  zero → bz-zero
  suc k1 → if leb (plus i (suc d)) (suc k1) then bz-add (if bit-eq (lc-nth s i) (lc-nth s (plus i d)) then bz-one else in-negint 1) (lc-diag d k1 (suc i) s) else bz-zero
