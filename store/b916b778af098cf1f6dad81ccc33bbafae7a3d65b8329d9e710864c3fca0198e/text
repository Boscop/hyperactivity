-- (part of language-support)
gpr_sbb_spec_8 : (dst' : Bits #64) → (src : Bits #64) → (input_rflags : rflagsbits) → MF ((Bits #64) × rflagsbits × rflagsbits)
gpr_sbb_spec_8 dst' src input_rflags =
  let input_cf : Bits #1
      input_cf = (rflagsbits-cf input_rflags)
      signed_raw_result : Bits #66
      signed_raw_result = (bits_of_int (z-sub (bv-signed #64 dst') (bv-signed #65 (bits_of_int (z-add (bv-signed #64 src) (bv-unsigned #1 input_cf)) (zpos #65)))) (zpos #66))
      result' : Bits #64
      result' = (bv-trunc #66 #64 signed_raw_result)
      cf' : Bits #1
      cf' = (bool_to_bits (z-lt (bv-unsigned #64 dst') (bv-unsigned #65 (bits_of_int (z-add (bv-unsigned #1 input_cf) (bv-unsigned #64 src)) (zpos #65)))))
  in bindF {Bits #1} {((Bits #64) × rflagsbits × rflagsbits)} (pf_spec64 result') (λ pf' →
       let af : Bits #1
           af = (sbb_af_spec64 dst' src input_cf)
           zf : Bits #1
           zf = (zf_spec (bv-unsigned #64 result'))
           sf : Bits #1
           sf = (sf_spec64 result')
       in bindF {Bits #1} {((Bits #64) × rflagsbits × rflagsbits)} (of_spec64 (bv-trunc #66 #65 signed_raw_result)) (λ of' →
            let output_rflags : rflagsbits
                output_rflags = (rflagsbits-set-of (rflagsbits-set-sf (rflagsbits-set-zf (rflagsbits-set-af (rflagsbits-set-pf (rflagsbits-set-cf input_rflags cf') pf') af) zf) sf) of')
                undefined_flags : rflagsbits
                undefined_flags = #0
            in retF {((Bits #64) × rflagsbits × rflagsbits)} (result' , output_rflags , undefined_flags)))
