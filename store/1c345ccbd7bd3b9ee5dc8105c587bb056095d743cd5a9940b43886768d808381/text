-- every rule: the operation and the value that met, and the first unused wire name
sm-rule : SmOp → SmVal → Word → SmOut
sm-rule (smo-app arg out) (smv-lam b e) n = sm-build b (sme-cons arg e) out (sm-out smf-nil n)
sm-rule (smo-app arg out) (smv-num m) n = sm-out (smf-op arg smo-era smf-nil) n
sm-rule (smo-app arg out) (smv-ref w) n = sm-out (smf-read w (smo-app arg out) smf-nil) n
sm-rule (smo-inc out) (smv-lam b e) n = sm-out (sm-era-env e smf-nil) n
sm-rule (smo-inc out) (smv-num m) n = sm-out (smf-val out (smv-num (%wsucc m)) smf-nil) n
sm-rule (smo-inc out) (smv-ref w) n = sm-out (smf-read w (smo-inc out) smf-nil) n
sm-rule (smo-dup a b) (smv-lam t sme-nil) n = sm-out (smf-val a (smv-lam t sme-nil) (smf-val b (smv-lam t sme-nil) smf-nil)) n
sm-rule (smo-dup a b) (smv-lam t (sme-cons w r)) n = sm-out (smf-val n (smv-lam t (sme-cons w r)) (smf-val a (smv-ref n) (smf-val b (smv-ref n) smf-nil))) (%wsucc n)
sm-rule (smo-dup a b) (smv-num m) n = sm-out (smf-val a (smv-num m) (smf-val b (smv-num m) smf-nil)) n
sm-rule (smo-dup a b) (smv-ref w) n = sm-out (smf-val a (smv-ref w) (smf-val b (smv-ref w) smf-nil)) n
sm-rule smo-era (smv-lam b e) n = sm-out (sm-era-env e smf-nil) n
sm-rule smo-era (smv-num m) n = sm-out smf-nil n
sm-rule smo-era (smv-ref w) n = sm-out smf-nil n
sm-rule (smo-fwd out) v n = sm-out (smf-val out v smf-nil) n
