-- 2·n for n = m + 1 is 2m + 2
zr-tw : (n m : Nat) → n ≡ suc m → times 2 n ≡ suc (suc (zr-dd m))
zr-tw n m h = cl-tr Nat (times 2 n) (times 2 (suc m)) (suc (suc (zr-dd m))) (λ i → times 2 (h i))
  (cl-tr Nat (times 2 (suc m)) (suc (suc (times 2 m))) (suc (suc (zr-dd m))) (zr-t2 m) (λ i → suc (suc (zr-ddt m (~ i)))))
