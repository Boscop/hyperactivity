-- Bonnet's recurrence, P_{l+1} = ((2l+1)ηP_l − lP_{l−1})/(l+1), and the Legendre equation d/dη[(1−η²)P′] + l(l+1)P = 0
leg-run : Nat → Nat → (List BQ) → (List BQ) → Bool
leg-run k l p q = case k of
  zero → true
  suc k1 → if u-isz (u-add (u-d (u-mul (cons (fn-q 1 1) (cons (fn-q 0 1) (cons (fn-nq 1 1) nil))) (u-d p))) (u-scale (fn-q (times l (suc l)) 1) p))
    then leg-run k1 (suc l) (u-scale (fn-q 1 (suc l)) (u-add (u-scale (fn-q (suc (times 2 l)) 1) (u-mul (cons (fn-q 0 1) (cons (fn-q 1 1) nil)) p)) (u-scale (fn-nq l 1) q))) p
    else false
