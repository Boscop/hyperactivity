-- Exact Global Credit Conservation Across Outsourced Peer Compute Settlement:
pouw-conserves-credit :
  (i j q kA kD : Nat) → (s : CrState) →
  cr-allowed (cr-allocate i j q kA) s →
  cr-allowed (cr-deliver i j q kD) (cr-move (cr-allocate i j q kA) s) →
  cr-total (pouw-settle-valid i j q kA kD s) ≡ cr-total s
pouw-conserves-credit i j q kA kD s hAlloc hDeliv =
  let s1 = cr-move (cr-allocate i j q kA) s
  in transN (cr-move-total (cr-deliver i j q kD) s1 hDeliv)
            (cr-move-total (cr-allocate i j q kA) s hAlloc)
