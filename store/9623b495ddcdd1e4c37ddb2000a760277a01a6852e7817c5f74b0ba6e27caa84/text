-- every exact value's denominator is positive
isval-pos : (E : Nat → (Nat × Nat) × Nat) → (e : IE) → (v : (Nat × Nat) × Nat) → isval E e v → le (suc zero) (snd v)
isval-pos E e = case e return λ w → (v : (Nat × Nat) × Nat) → isval E w v → le (suc zero) (snd v) of
  ie-var k → λ v h → fst h
  ie-int k → λ v h → fst h
  ie-rat n d → λ v h → fst h
  ie-add a b → λ v h → fst (snd (snd (snd h)))
  ie-sub a b → λ v h → fst (snd (snd (snd h)))
  ie-mul a b → λ v h → fst (snd (snd (snd h)))
  ie-div a b → λ v h → fst (snd (snd (snd h)))
