-- nk-step-swap: steps at two wires commute. If the two plans write different wires, and each plan is
-- the same whether or not the other step went first, then stepping in either order leaves memories
-- that read the same at every wire. The second and third hypotheses are not yet derived from the
-- wires being apart (a plan reads the memory only at its own wire and at the held wire it reads)
-- (part of machine-in-hyperactive)
nk-step-swap : (sl : NkSlots) (u1 n1 u2 n2 : Word) →
  nk-aparts (nk-fx (nk-plan (nk-get sl u1) u1 n1 sl)) (nk-fx (nk-plan (nk-get sl u2) u2 n2 sl)) →
  (nk-plan (nk-get (nk-step-at u2 n2 sl) u1) u1 n1 (nk-step-at u2 n2 sl) ≡ nk-plan (nk-get sl u1) u1 n1 sl) →
  (nk-plan (nk-get (nk-step-at u1 n1 sl) u2) u2 n2 (nk-step-at u1 n1 sl) ≡ nk-plan (nk-get sl u2) u2 n2 sl) →
  nk-same (nk-step-at u2 n2 (nk-step-at u1 n1 sl)) (nk-step-at u1 n1 (nk-step-at u2 n2 sl))
nk-step-swap sl u1 n1 u2 n2 ap p1 p2 x =
  cong (λ p → nk-get (nk-do (nk-fx p) (nk-step-at u1 n1 sl)) x) p2
  ∙ (nk-do-swap (nk-fx (nk-plan (nk-get sl u1) u1 n1 sl)) (nk-fx (nk-plan (nk-get sl u2) u2 n2 sl)) sl ap x
  ∙ sym (cong (λ p → nk-get (nk-do (nk-fx p) (nk-step-at u2 n2 sl)) x) p1))
