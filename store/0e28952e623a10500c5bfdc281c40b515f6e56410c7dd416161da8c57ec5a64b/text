s-kg-drawer = "<style>.hx-kg-link{border-bottom:1.5px solid #ff0a94;cursor:pointer;transition:background .12s,color .12s}.hx-kg-link:hover{background:#ff0a94;color:#fff}#hxKgBg{display:none;position:fixed;inset:0;z-index:80;background:rgba(0,0,0,.35)}#hxKgBg.on{display:block}#hxKgDrawer{position:fixed;top:0;right:0;bottom:0;width:min(540px,96vw);z-index:90;background:#fff;color:#000;border-left:2px solid #000;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .18s ease;font:12.5px/1.45 ui-monospace,'SF Mono',Menlo,monospace}#hxKgDrawer.on{transform:translateX(0)}html.dark #hxKgDrawer,html.syn #hxKgDrawer,html.syn-page #hxKgDrawer{background:#000;color:#fff;border-left-color:#fff}.hx-kg-h{padding:12px 14px;border-bottom:1px solid rgba(128,128,128,.3);display:flex;justify-content:space-between;align-items:flex-start;gap:10px}.hx-kg-t{font-size:14px;font-weight:800;word-break:break-all}.hx-kg-m{font-size:11px;opacity:.75;margin-top:3px}.hx-kg-m b{color:#ff0a94}.hx-kg-acts{display:flex;gap:6px;flex-shrink:0}.hx-kg-btn{font:700 11px/1.2 inherit;background:none;color:inherit;border:1px solid currentColor;padding:4px 8px;cursor:pointer;text-decoration:none}.hx-kg-btn:hover{background:#ff0a94;border-color:#ff0a94;color:#fff}.hx-kg-deps{padding:8px 14px;border-bottom:1px solid rgba(128,128,128,.3);display:flex;flex-wrap:wrap;gap:5px;max-height:92px;overflow:auto;font-size:11px}.hx-kg-chip{padding:1px 6px;border:1px solid #1a73e8;color:#1a73e8;background:none;font:600 11px/1.3 inherit;cursor:pointer}html.dark .hx-kg-chip{border-color:#4da3ff;color:#4da3ff}.hx-kg-chip.in{border-color:#ff0a94;color:#ff0a94}.hx-kg-chip:hover{background:#ff0a94;border-color:#ff0a94;color:#fff}.hx-kg-src{flex:1;overflow:auto;padding:10px 0}.hx-kg-ln{display:grid;grid-template-columns:40px minmax(0,1fr);padding:0 12px 0 0;font-size:12px;line-height:1.48}.hx-kg-ln.hl{background:rgba(255,10,148,.14)}.hx-kg-num{text-align:right;padding-right:8px;opacity:.45;user-select:none;font-size:11px}.hx-kg-code{white-space:pre-wrap;word-break:break-word}.hx-kg-com{opacity:.55;font-style:italic}.hx-kg-op{color:#ff0a94;font-weight:700}.hx-kg-ref{color:#1a73e8;cursor:pointer;text-decoration:underline;text-underline-offset:2px}html.dark .hx-kg-ref{color:#4da3ff}.hx-kg-ref:hover{color:#ff0a94}</style><script>(function(){if(location.pathname==='/kg')return;if(document.documentElement.classList.contains('embed')||document.documentElement.classList.contains('hero'))return;var KG=null,modByPath=new Map(),cache=new Map(),bg,dr,ti,me,dp,sc,op;function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}function ensure(){if(dr)return;bg=document.createElement('div');bg.id='hxKgBg';bg.onclick=close;document.body.appendChild(bg);dr=document.createElement('aside');dr.id='hxKgDrawer';dr.innerHTML='<div class=hx-kg-h><div><div class=hx-kg-t id=hxKgT></div><div class=hx-kg-m id=hxKgM></div></div><div class=hx-kg-acts><a class=hx-kg-btn id=hxKgOpen href=/kg>↗ /kg</a><button class=hx-kg-btn id=hxKgX>✕</button></div></div><div class=hx-kg-deps id=hxKgD></div><div class=hx-kg-src id=hxKgS></div>';document.body.appendChild(dr);ti=dr.querySelector('#hxKgT');me=dr.querySelector('#hxKgM');dp=dr.querySelector('#hxKgD');sc=dr.querySelector('#hxKgS');op=dr.querySelector('#hxKgOpen');dr.querySelector('#hxKgX').onclick=close;sc.addEventListener('click',function(e){var r=e.target.closest('.hx-kg-ref');if(!r||!KG)return;var t=r.getAttribute('data-t');if(KG.terms[t]){var x=KG.terms[t];openKG(x[0],t,x[1])}});document.addEventListener('keydown',function(e){if(e.key==='Escape')close()});}function close(){if(bg)bg.classList.remove('on');if(dr)dr.classList.remove('on')}function hiLine(ln){var s=ln.trim();if(s.indexOf('--')===0)return '<span class=hx-kg-com>'+esc(ln)+'</span>';return ln.split(/([A-Za-z][A-Za-z0-9_\'\-]*|≡|→|λ|×)/g).map(function(tok){if(!tok)return '';if(tok==='≡'||tok==='→'||tok==='λ'||tok==='×')return '<span class=hx-kg-op>'+tok+'</span>';if(KG&&KG.terms[tok]&&tok.length>=4)return '<span class=hx-kg-ref data-t='+esc(tok)+'>'+esc(tok)+'</span>';return esc(tok)}).join('')}function loadMod(p){if(cache.has(p))return Promise.resolve(cache.get(p));return fetch('/api/kg/module?path='+encodeURIComponent(p)).then(function(r){return r.ok?r.text():'-- unavailable'}).then(function(t){cache.set(p,t);return t})}function openKG(modIdx,term,line){ensure();bg.classList.add('on');dr.classList.add('on');var m=KG.mods[modIdx];ti.innerHTML=term?'<span style=color:#ff0a94>'+esc(term)+'</span> <span style=opacity:.6;font-size:11px>in '+esc(m[0])+'</span>':esc(m[0]);me.innerHTML='<b>sha256: '+m[1]+'</b> · '+m[2]+' · '+m[6]+' defs';op.href=term?'/kg?term='+encodeURIComponent(term):'/kg?mod='+encodeURIComponent(m[0]);dp.textContent='';m[4].forEach(function(i){var b=document.createElement('button');b.className='hx-kg-chip';b.textContent='→ '+KG.mods[i][0];b.onclick=function(){openKG(i,null,0)};dp.appendChild(b)});m[5].slice(0,12).forEach(function(i){var b=document.createElement('button');b.className='hx-kg-chip in';b.textContent='← '+KG.mods[i][0];b.onclick=function(){openKG(i,null,0)};dp.appendChild(b)});sc.innerHTML='<div style=padding:14px;opacity:.6>Reading content-addressed source…</div>';loadMod(m[0]).then(function(txt){var ls=txt.split('\n');sc.innerHTML=ls.map(function(l,i){var n=i+1;return '<div class=\'hx-kg-ln'+(line&&n>=line&&n<=line+1?' hl':'')+'\' id=hxkgl'+n+'><span class=hx-kg-num>'+n+'</span><span class=hx-kg-code>'+hiLine(l)+'</span></div>'}).join('');if(line){var el=document.getElementById('hxkgl'+line);if(el)el.scrollIntoView({block:'center',behavior:'instant'})}else sc.scrollTop=0})}function wire(){var els=document.querySelectorAll('main code,[data-kg-term],[data-kg-mod]');if(!els.length)return;fetch('/api/kg/index').then(function(r){return r.json()}).then(function(d){KG=d;d.mods.forEach(function(m,i){modByPath.set(m[0],i);if(m[0].endsWith('.hypercubical'))modByPath.set(m[0].slice(0,-13)+'.cub',i)});els.forEach(function(el){if(el.closest('pre,.katex'))return;var tm=el.getAttribute('data-kg-term'),md=el.getAttribute('data-kg-mod'),tx=(el.textContent||'').trim();if(md&&modByPath.has(md)){el.classList.add('hx-kg-link');el.title='Inspect '+md+' in Knowledge Graph';el.onclick=function(e){e.preventDefault();openKG(modByPath.get(md),null,0)};return}if(tm&&KG.terms[tm]){var x=KG.terms[tm];el.classList.add('hx-kg-link');el.title='Inspect '+tm+' in Knowledge Graph';el.onclick=function(e){e.preventDefault();openKG(x[0],tm,x[1])};return}if(modByPath.has(tx)){el.classList.add('hx-kg-link');el.title='Inspect '+tx+' in Knowledge Graph';el.onclick=function(){openKG(modByPath.get(tx),null,0)};return}if(tx.length>=4&&KG.terms[tx]){var y=KG.terms[tx];el.classList.add('hx-kg-link');el.title='Inspect '+tx+' in Knowledge Graph';el.onclick=function(){openKG(y[0],tx,y[1])}}})}).catch(function(){})}window.hxOpenKG=function(t){if(!KG)return;if(modByPath.has(t))openKG(modByPath.get(t),null,0);else if(KG.terms[t]){var x=KG.terms[t];openKG(x[0],t,x[1])}};document.addEventListener('DOMContentLoaded',wire);})()</script>"
