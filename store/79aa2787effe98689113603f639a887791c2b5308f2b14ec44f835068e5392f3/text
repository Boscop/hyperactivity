nk-rule-dup-wf : (a b : NkW) (v : NkVal) (ps : NkEnv) (n : NkW) →
  nk-out-ok nke-nil (nke-cons a (nke-cons b nke-nil)) n n (nk-rule-dup a b v ps n) ≡ true
nk-rule-dup-wf a b v nke-nil n =
  let outs = nke-cons a (nke-cons b nke-nil)
      ha = nk-in-set-hd a (nke-cons b nke-nil) n n
      hb = nk-in-set-snd a b nke-nil n n
  in nk-out-ok-intro nke-nil outs n n (nkf-val a v (nkf-val b v nkf-nil)) n nke-nil
       (nk-wire-le-refl n)
       (nk-and-intro (nk-in-set outs n n a) (nk-fx-wf nke-nil outs n n (nkf-val b v nkf-nil)) ha (nk-and-intro (nk-in-set outs n n b) true hb refl))
       refl
nk-rule-dup-wf a b v (nke-cons w r) n =
  let outs = nke-cons a (nke-cons b nke-nil)
      sn = nk-s n
      rn = nk-in-range-self n n (nk-wire-le-refl n)
      ha = nk-in-set-hd a (nke-cons b nke-nil) n sn
      hb = nk-in-set-snd a b nke-nil n sn
  in nk-out-ok-intro nke-nil outs n n (nkf-val n v (nkf-val a (nkv-ref n) (nkf-val b (nkv-ref n) nkf-nil))) sn nke-nil
       (nk-wire-le-s n)
       (nk-and-intro (nk-in-set outs n sn n) (nk-fx-wf nke-nil outs n sn (nkf-val a (nkv-ref n) (nkf-val b (nkv-ref n) nkf-nil)))
         (nk-in-set-range outs n sn n rn)
         (nk-and-intro (nk-in-set outs n sn a) (nk-fx-wf nke-nil outs n sn (nkf-val b (nkv-ref n) nkf-nil)) ha (nk-and-intro (nk-in-set outs n sn b) true hb refl)))
       refl
