-- C11 outcome: normal completion with updated arena and value, well-defined abnormal termination
-- via abort() (ISO C11 §7.22.4.1), or C11 Undefined Behaviour (dereferencing non-pointer or
-- out-of-bounds subscript, division/modulo by zero, shift >= 64, unbound local, arity mismatch)
data CsRes =
    cso-ok (hp : CsHeap) (v : CsVal)
  | cso-abort
  | cso-ub
