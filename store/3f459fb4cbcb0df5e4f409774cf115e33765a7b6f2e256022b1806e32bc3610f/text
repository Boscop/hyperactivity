gds6-body-roundtrip : (bs : List Gds6Box) →
  Path (Sum Unit (List Gds6Box))
    (gds6-decode-body (list-length {Gds6Box} bs) (gds6-encode-body bs))
    (inr bs)
gds6-body-roundtrip nil = λ _ → inr nil
gds6-body-roundtrip (cons (gbox6 lay dt x0 y0 x1 y1) bs) =
  λ i →
    bind-res {List Gds6Box} {List Gds6Box}
      (gds6-body-roundtrip bs i)
      (λ tail →
        inr (cons (gbox6 (gb2-eta lay i) (gb2-eta dt i) (gb4-eta x0 i) (gb4-eta y0 i) (gb4-eta x1 i) (gb4-eta y1 i)) tail))
