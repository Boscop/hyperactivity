nk-gather-wf : (d : Word) (k : NkK) (done : NkTm) (todo : NkEnv) (out n : NkW) →
  nk-out-ok todo (nke-cons out nke-nil) n n (nk-gather d k done todo out n) ≡ true
nk-gather-wf d k done nke-nil out n =
  let outs = nke-cons out nke-nil
  in nk-out-ok-intro nke-nil outs n n (nkf-val out (nkv (hd-q (nk-finish k (nk-rev done nk-nil))) nke-nil) nkf-nil) n nke-nil
       (nk-wire-le-refl n)
       (nk-and-intro (nk-in-set outs n n out) true (nk-in-set-hd out nke-nil n n) refl)
       refl
nk-gather-wf d k done (nke-cons w r) out n =
  let ins = nke-cons w r
      outs = nke-cons out nke-nil
      sn = nk-s n
      rn = nk-in-range-self n n (nk-wire-le-refl n)
      hfx = nk-and-intro (nk-in-set ins n sn w) (nk-fx-wf ins outs n sn (nkf-op n (nko-gather d k done r out) nkf-nil))
              (nk-in-set-hd w r n sn)
              (nk-and-intro (nk-in-set ins n sn n) true (nk-in-set-range ins n sn n rn) refl)
  in nk-out-ok-intro ins outs n n (nkf-op w (nko-quote d n) (nkf-op n (nko-gather d k done r out) nkf-nil)) sn nke-nil (nk-wire-le-s n) hfx refl
