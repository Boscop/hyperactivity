-- 16-Valued Signed-Bit Generalized-Condition Lattice (bit0=00, bit1=01[n=-1], bit2=10[u=+1], bit3=11)
-- Prove carry-cancellation soundness: u (+1, mask=4) + n (-1, mask=2) yields equal (00 or 11 -> sum bit diff=0)!
s256-gc-xor1 : Word → Word → Word
s256-gc-xor1 x y =
  let x0 = %wand x #1
      x1 = %wand (%wshr x #1) #1
      x2 = %wand (%wshr x #2) #1
      x3 = %wand (%wshr x #3) #1
      y0 = %wand y #1
      y1 = %wand (%wshr y #1) #1
      y2 = %wand (%wshr y #2) #1
      y3 = %wand (%wshr y #3) #1
      r0 = %wor (%wand x0 y0) (%wor (%wand x1 y1) (%wor (%wand x2 y2) (%wand x3 y3)))
      r1 = %wor (%wand x0 y1) (%wor (%wand x1 y0) (%wor (%wand x2 y3) (%wand x3 y2)))
      r2 = %wor (%wand x0 y2) (%wor (%wand x2 y0) (%wor (%wand x1 y3) (%wand x3 y1)))
      r3 = %wor (%wand x0 y3) (%wor (%wand x3 y0) (%wor (%wand x1 y2) (%wand x2 y1)))
  in %wor r0 (%wor (%wshl r1 #1) (%wor (%wshl r2 #2) (%wshl r3 #3)))
