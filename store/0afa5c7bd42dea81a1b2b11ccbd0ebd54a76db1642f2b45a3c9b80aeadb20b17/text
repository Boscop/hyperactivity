-- ============================================================================

ml-cong : {A B : Type} → (f : A → B) → {x y : A} → x ≡ y → f x ≡ f y
ml-cong f p = λ i → f (p i)

ml-max : Nat → Nat → Nat
ml-max zero    b       = b
ml-max (suc a) zero    = suc a
ml-max (suc a) (suc b) = suc (ml-max a b)

-- THEOREM 1: UNIVERSAL IDEMPOTENCE OF SWARM LEASE EPOCH MERGE (ALL a : Nat)
ml-thm-max-idem : (a : Nat) → ml-max a a ≡ a
ml-thm-max-idem zero    = refl
ml-thm-max-idem (suc a) = ml-cong suc (ml-thm-max-idem a)

-- THEOREM 2: UNIVERSAL COMMUTATIVITY OF SWARM LEASE EPOCH MERGE (ALL a b : Nat)
ml-thm-max-comm : (a b : Nat) → ml-max a b ≡ ml-max b a
ml-thm-max-comm zero    zero    = refl
ml-thm-max-comm zero    (suc b) = refl
ml-thm-max-comm (suc a) zero    = refl
ml-thm-max-comm (suc a) (suc b) = ml-cong suc (ml-thm-max-comm a b)

-- THEOREM 3: UNIVERSAL ASSOCIATIVITY OF SWARM LEASE EPOCH MERGE (ALL a b c : Nat)
ml-thm-max-assoc : (a b c : Nat) → ml-max (ml-max a b) c ≡ ml-max a (ml-max b c)
ml-thm-max-assoc zero    b       c       = refl
ml-thm-max-assoc (suc a) zero    c       = refl
ml-thm-max-assoc (suc a) (suc b) zero    = refl
ml-thm-max-assoc (suc a) (suc b) (suc c) = ml-cong suc (ml-thm-max-assoc a b c)

-- Exact Nat <= and min for proved strictly-monotone cost-descent tower
ml-le : Nat → Nat → Bool
ml-le zero    _       = true
ml-le (suc _) zero    = false
ml-le (suc a) (suc b) = ml-le a b

ml-min : Nat → Nat → Nat
ml-min zero    _       = zero
ml-min (suc _) zero    = zero
ml-min (suc a) (suc b) = suc (ml-min a b)

ml-thm-min-le-l : (a b : Nat) → ml-le (ml-min a b) a ≡ true
ml-thm-min-le-l zero    b       = refl
ml-thm-min-le-l (suc a) zero    = refl
ml-thm-min-le-l (suc a) (suc b) = ml-thm-min-le-l a b

ml-thm-min-le-r : (a b : Nat) → ml-le (ml-min a b) b ≡ true
ml-thm-min-le-r zero    b       = refl
ml-thm-min-le-r (suc a) zero    = refl
ml-thm-min-le-r (suc a) (suc b) = ml-thm-min-le-r a b

