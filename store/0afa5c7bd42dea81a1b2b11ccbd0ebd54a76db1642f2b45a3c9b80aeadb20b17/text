data SwarmLease = swarm-lease
  (sl-res   : Word)
  (sl-owner : Word)
  (sl-epoch : Word)
  (sl-cost  : Word)

ml-lease-to-pkt : SwarmLease → SovPkt
ml-lease-to-pkt (swarm-lease res own ep cst) =
  sov-pkt pk-shard ep res own cst #1

ml-pack-lease : Word → SwarmLease → List Word
ml-pack-lease secret l = sov-pack-pkt secret (ml-lease-to-pkt l)

ml-sample-lease : SwarmLease
