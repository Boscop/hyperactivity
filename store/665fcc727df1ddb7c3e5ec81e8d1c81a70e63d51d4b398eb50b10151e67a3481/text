lc-wait-code : Nat → List Word → Proc W Word
lc-wait-code zero    addr55 = ret {lzero} {W} #0
lc-wait-code (suc k) addr55 =
  bind (bl-rpc-call "eth_getCode" (h-concat (cons "[" (cons (h-quote addr55) (cons "," (cons (h-quote "latest") (cons "]" nil))))))) (λ rCd →
    let nHex = fromNat (list-length (bl-extract-json-hex rCd))
    in if %wlt #0 nHex
       then ret {lzero} {W} (%wdiv nHex #2)
       else bind (h-capture (cons "/bin/sleep" (cons "2" nil))) (λ s0 → lc-wait-code k addr55))
