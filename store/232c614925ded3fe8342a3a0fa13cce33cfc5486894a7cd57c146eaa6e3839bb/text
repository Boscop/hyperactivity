-- the bracket's ends checked (F(lo) < 0 < F(hi), both starts sound), then j halvings
h2p-root : List Bool → List Bool → Nat → Nat → Nat → Nat → BZ → BZ → Bool × IV
h2p-root S S2 M K N j a b = h2p-bisect S S2 M K N j
  (both (both (fst (h2p-at S S2 a M K N)) (iv-neg-sure (snd (h2p-at S S2 a M K N))))
        (both (fst (h2p-at S S2 b M K N)) (iv-pos-sure (snd (h2p-at S S2 b M K N)))) , (a , b))
