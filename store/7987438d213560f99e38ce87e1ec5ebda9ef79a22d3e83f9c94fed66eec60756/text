-- a total order on the elements is one on their lists
lex-refl : {A : Type} {le : A → A → Bool} → TotalOrder le → (xs : List A) → isTrue (lexle le xs xs)
lex-refl t xs =
  case xs return λ w → isTrue (lexle le w w) of
    nil → unit
    cons x r → step-eq {le x x} {le x x} {lexle le r r} (fst t x) (fst t x) (rec r)
