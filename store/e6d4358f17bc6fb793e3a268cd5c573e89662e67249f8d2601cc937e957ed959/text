sg-enqueue : Lst (Bool × List Word) → Lst Word → Lst Word → Lst (Bool × List Word) → Word → (Lst Word × Lst Word) × Lst (Bool × List Word)
sg-enqueue lnil sd sg work q = if %weq q #0 then ((sd , sg) , work) else ((sd , sg) , work)
sg-enqueue (lcons it rest) sd sg work q =
  let is-d = fst it
      hex = snd it
      k = nk-key60 hex
  in if is-d then
       (if sg-mem-w k sd #0 then sg-enqueue rest sd sg work (%wsucc q)
        else sg-enqueue rest (lcons k sd) sg (lcons it work) (%wsucc q))
     else
       (if sg-mem-w k sg #0 then sg-enqueue rest sd sg work (%wsucc q)
        else sg-enqueue rest sd (lcons k sg) (lcons it work) (%wsucc q))
