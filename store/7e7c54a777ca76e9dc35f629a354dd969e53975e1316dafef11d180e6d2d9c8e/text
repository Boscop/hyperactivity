-- the same machine run directly as a node (its state is the word): 5 + 6 + 6 + 5
ping-mfinal : FState Word Word
ping-mfinal = fleet-run {Word} {Word} ping-mach
                (cons (a-run 0) (cons (a-run 0) (cons (a-dup 0) (cons (a-deliver 0) (cons (a-deliver 0) (cons (a-deliver 0) nil))))))
                ((λ i → #5) , net-empty {Word})
