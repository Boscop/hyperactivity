-- the sign changes along the minors after prev, and whether every minor was nonzero
in-changes : BZ → List BZ → Nat × Bool
in-changes prev ds = case ds of
  nil → (zero , true)
  cons d rest → (if bin-null (snd d) then (zero , false) else in-step (not (bit-eq (bz-pos prev) (bz-pos d))) (in-changes d rest))
