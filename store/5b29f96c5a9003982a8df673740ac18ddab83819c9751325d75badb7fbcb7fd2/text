-- Zero-copy raw file I/O using w-sys #904 (stat), #902 (raw read), #903 (raw write)
hcm-cstr : List Word → (Word → Step W Word) → Step W Word
hcm-cstr path k =
  let plen = cli-len path
  in scmd (w-alloc (%wadd plen #2)) (λ pb →
     cli-poke pb path (λ _ →
     scmd (w-store8 (%wadd pb plen) #0) (λ _ → k pb)))
