-- a level, by Level's constructors lzero lsuc lmax (lomega has no code)
q-lvl bs l =
  let w = %view l
  in case w of
       wcon d c fs ds → 
         if %weq c #0
           then some clzero
           else if %weq c #1
                  then omap clsuc (q-lvl bs (lhead fs))
                  else if %weq c #2
                         then obind (q-lvl bs (lhead fs))
                                (λ a → omap (clmax a) (q-lvl bs (lhead (ltail fs))))
                         else none
       _ → if is-neu w then omap q-fst (qneu bs (some Level) l w) else none
