-- Master Constraint kernel theorem (forward): M(ψ) = 0 implies every local H_v ψ = 0.
lqg-master-zero-implies-all : (xs : List Nat) → lqg-sum xs ≡ zero → lqg-all-zero xs
lqg-master-zero-implies-all nil p = unit
lqg-master-zero-implies-all (cons x rest) p =
  (lqg-plus-zero-l x (lqg-sum rest) p ,
   lqg-master-zero-implies-all rest (lqg-plus-zero-r x (lqg-sum rest) p))
