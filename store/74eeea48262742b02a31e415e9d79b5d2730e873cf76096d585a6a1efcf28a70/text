-- a line of types by composition in the universe: the numbers, with the constant line of the
-- numbers on both ends (part of machine-in-hyperactive)
nk-hcu-line : NkTm
nk-hcu-line = nk-lam (nk-hcomp nk-U (nk-sys (nk-cons (nk-br (nk-neg (nk-var #0)) (nk-lam nk-N)) (nk-cons (nk-br (nk-var #0) (nk-lam nk-N)) nk-nil))) nk-N)
