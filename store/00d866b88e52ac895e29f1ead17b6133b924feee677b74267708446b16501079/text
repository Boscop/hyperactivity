-- a body run for at most k steps and its answer read: by cases on the count, so that with a count
-- known only when run this stays one call (a definition's code is the quote of its value, a tree
-- without sharing; an entry that unfolds over a stuck part copies it at every use)
nk-eval-f : Nat → NkTm → Word
nk-eval-f zero t = #999994
nk-eval-f (suc k) t = nk-answer (nk-get (nk-mem (nk-run k (nk-start t))) #0)
