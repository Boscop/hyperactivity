-- MMIO Isolation Theorem 1: CPU RAM stores (`addr < mmioBase`) NEVER perturb Tensor-Core accumulators!
soc-ram-isolated : (mmioBase : Nat) → (st : SocBusState) → (addr val : Nat) → (wave : SysWave) →
  leB mmioBase addr ≡ false →
  snd (soc-bus-write mmioBase st addr val wave) ≡ snd st
soc-ram-isolated mmioBase st addr val wave hBelow =
  λ i → snd (mmio-dispatch mmioBase st addr val wave (hBelow i))
