-- ---------------------------------------------------------------- 2. Pipeline Retiming Bisimulation & STA Speedup
-- Before retiming: register holds s : A, combinational output is g(f(s)) (critical path df + dg).
-- After retiming: register pushed forward across f to hold t = f(s) : B (critical path max(df, dg)).
pipe-before : {A B C : Type} → (A → B) → (B → C) → A → List A → List C
pipe-before f g s nil = nil
pipe-before f g s (cons x xs) = cons (g (f s)) (pipe-before f g x xs)
