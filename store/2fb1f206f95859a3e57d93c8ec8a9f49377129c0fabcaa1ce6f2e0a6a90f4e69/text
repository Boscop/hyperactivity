cs-sim-snd-at : (hp1 : CsHeap) (addr : Nat) (ma mb : CsMVal) (ov1 ov2 : CsOptV) →
  (cs-loadv hp1 (csv-ptr addr) (suc zero) ≡ ov1) →
  (cs-loadv hp1 (csv-ptr addr) (suc (suc zero)) ≡ ov2) →
  (cs-pair-rel-ov (cs-val-rel hp1 ma) (cs-val-rel hp1 mb) ov1 ov2 ≡ true) →
  cs-res-rel mb (cs-load-res hp1 (csv-ptr addr) (suc (suc zero))) ≡ true
cs-sim-snd-at hp1 addr ma mb csov-none ov2 ho1 ho2 hrel = cs-no hrel
cs-sim-snd-at hp1 addr ma mb (csov-some va) csov-none ho1 ho2 hrel = cs-no hrel
cs-sim-snd-at hp1 addr ma mb (csov-some va) (csov-some vb) ho1 ho2 hrel =
  cong (λ o → cs-res-rel mb (cs-bind-opt o (λ v → cso-ok hp1 v)))
    (cs-loadv-inv (cs-load hp1 (csv-ptr addr) (suc (suc zero))) vb ho2)
  ∙ csr-and-r (cs-val-rel hp1 ma va) (cs-val-rel hp1 mb vb) hrel
