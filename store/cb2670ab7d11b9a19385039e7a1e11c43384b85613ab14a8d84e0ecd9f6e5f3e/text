ch-check-witness : CryptoHyperspace → Bool
ch-check-witness
  (mk-hyperspace _ _ _ _ (mk-lending-vault _ cap fee _) _ (mk-bounty-target _ bmax tr _) (mk-compute-node _ gpus hbm _)) =
  andB (%weq fee #0)
  (andB (%weq cap #485)
  (andB (%weq bmax #23000)
  (andB (%weq tr #335)
  (andB (%weq gpus #8)
        (%weq hbm #1150)))))
