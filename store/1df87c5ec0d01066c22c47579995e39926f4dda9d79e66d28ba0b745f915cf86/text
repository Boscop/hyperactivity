eth-tx1559-unsigned : Eip1559Tx → List Word
eth-tx1559-unsigned (mk-tx1559 cid nc prio mfee gas to20 val dat) =
  cons #2
  (rlp-list
    (cons (rlp-uint cid)
    (cons (rlp-uint nc)
    (cons (rlp-uint prio)
    (cons (rlp-uint mfee)
    (cons (rlp-uint gas)
    (cons (rlp-bytes to20)
    (cons (rlp-uint val)
    (cons (rlp-bytes dat)
    (cons (rlp-list nil) nil))))))))))
