-- waiting is not a step: an operation that needs the value, facing a reference to a held wire
-- that holds nothing yet, leaves the memory as it was (part of machine-in-hyperactive)
nk-wait : (sl : NkSlots) (u n w : NkW) (o : NkOp) → (nk-get sl u ≡ nks-pair o (nkv-ref w)) → (nk-reads o ≡ true) → (nk-get sl w ≡ nks-none) → nk-step-at u n sl ≡ sl
nk-wait sl u n w o p r q =
  cong (λ s → nk-do (nk-fx (nk-plan s u n sl)) sl) p
  ∙ (cong (λ b → nk-do (nk-fx (nk-plan-by (if b then nkh-wire w else nkh-none) o (nkv-ref w) u n sl)) sl) r
  ∙ cong (λ z → nk-do (nk-fx (nk-plan-read z o u n)) sl) q)
