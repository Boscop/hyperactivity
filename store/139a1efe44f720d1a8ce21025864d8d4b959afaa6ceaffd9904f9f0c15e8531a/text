emit-c-cli-program : Word → Defs → List Word
emit-c-cli-program m defs =
  let ars = x-arities defs
  in list-append ce-world-inc (list-append ce-cli-prelude (list-append ce-prelude2
       (list-append ce-world-helpers (list-append ce-posix-sys (list-append ce-world-run
         (list-append (list-append "#undef syscall" ce-nl)
           (ce-protos defs (ce-wraps defs (ce-wfns ars defs (ce-cli-main m))))))))))
