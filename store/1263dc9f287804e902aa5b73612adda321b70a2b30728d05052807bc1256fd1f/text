tw-lem-mk-dup-go : (env : Word → Bool) → (l : Word) → (a b : INet) →
  (b0 b1 : Bool) → %weq l #0 ≡ b0 → %weq l #1 ≡ b1 →
  in-eval env (if b0 then in-mk-xor-c (in-eq a b) a b else if b1 then in-mk-and-c (in-eq a b) a b else a)
  ≡ (if b0 then web-xorB (in-eval env a) (in-eval env b) else if b1 then web-andB (in-eval env a) (in-eval env b) else in-eval env a)
tw-lem-mk-dup-go env l a b true  _     _ _ = tw-lem-mk-xor env a b (in-eq a b) refl
tw-lem-mk-dup-go env l a b false true  _ _ = tw-lem-mk-and env a b (in-eq a b) refl
tw-lem-mk-dup-go env l a b false false _ _ = refl
