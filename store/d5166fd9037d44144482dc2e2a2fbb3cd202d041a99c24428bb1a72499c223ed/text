-- Execute the 192-byte zero-`solc` deployless EVM state-sieve in ONE `eth_call` (`to` omitted!):
ms-run-live-sieve : Proc W (List Word)
ms-run-live-sieve =
  let dataHex = list-append "0x" (h-hex ms-sieve-bytecode)
      params  = h-concat
                  (cons "[{"
                  (cons (h-quote "data") (cons ":" (cons (h-quote dataHex)
                  (cons "}," (cons (h-quote "latest") (cons "]" nil)))))))
  in bind (bl-rpc-call "eth_call" params) (λ resp →
       ret {lzero} {W} (bl-extract-json-hex resp))
