-- the work at a public name, its page kept per state of the source (s-site-kept); any other address is not found
s-public : List Word → Sum Unit Work → Proc W (List Word)
s-public st (inl u) = ret {lzero} {W} (s-respond "404 Not Found" s-html s-not-found)
s-public st (inr (work n k p)) = s-site-kept st n (if h-ends ".cub" p then s-essay-at (list-append "/" n) p else s-doc-at (list-append "/" n) p)
