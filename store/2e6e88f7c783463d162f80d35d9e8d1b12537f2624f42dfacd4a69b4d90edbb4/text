-- (to do , (seen , kept)): a definition reached is kept (hold-ok), or copied into its caller, and
-- then the definitions it names are reached too
hold-step : Word → Lst Word × (Lst Word × Lst Word) → Lst Word × (Lst Word × Lst Word)
hold-step e st =
  case fst st return (λ _ → Lst Word × (Lst Word × Lst Word)) of
    lnil → st
    lcons g rest →
      (if w-mem g (fst (snd st)) then (rest , snd st)
       else (if hold-ok e g then (rest , (lcons g (fst (snd st)) , lcons g (snd (snd st))))
             else (l-app rest (opt-or (opt-map code-globals (def-code g)) lnil) , (lcons g (fst (snd st)) , snd (snd st)))))
