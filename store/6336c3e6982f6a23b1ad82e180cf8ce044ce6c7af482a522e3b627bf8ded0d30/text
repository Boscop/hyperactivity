-- x is a prefix of y exactly when y is at least x and below x with top after it
sq-pre-range : {A : Type} → (le : A → A → Bool) → (top : A) → (x : List A) → (y : List A) → sq-below le top y →
  sq-pre le x y ≡ andB (lexle le x y) (not (lexle le (list-append x (cons top nil)) y))
sq-pre-range le top x = case x return λ w → (y : List A) → sq-below le top y → sq-pre le w y ≡ andB (lexle le w y) (not (lexle le (list-append w (cons top nil)) y)) of
  nil → λ y h → cong not (sym (sq-top-above le top y h))
  cons c r → λ y → case y return λ v → sq-below le top v → sq-pre le (cons c r) v ≡ andB (lexle le (cons c r) v) (not (lexle le (list-append (cons c r) (cons top nil)) v)) of
    nil → λ h i → false
    cons d s → λ h → concat (cong (andB (andB (le c d) (le d c))) (rec r s (snd h)))
      (sq-step-and (le c d) (le d c) (lexle le r s) (lexle le (list-append r (cons top nil)) s))
