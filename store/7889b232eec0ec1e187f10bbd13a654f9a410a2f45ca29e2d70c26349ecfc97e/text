-- the open page listens: presence and what is written arrive as events, each swap one view transition
hi-script : List Word
hi-script = "<script>(function(){var q=location.search.slice(1),es=new EventSource('/hi/events?'+q);function put(id,h){var e=document.getElementById(id);if(!e||e.innerHTML===h)return;var f=function(){e.innerHTML=h};if(document.startViewTransition)document.startViewTransition(f);else f()}es.addEventListener('presence',function(m){put('hi-present',m.data)});es.addEventListener('written',function(m){put('hi-written',m.data)})})()</script>"
