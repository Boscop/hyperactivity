-- internal workflow surfaces: never exposed to unauthenticated public visitors (public Knowledge Graph is /kg)
s-views-path : List Word → Bool
s-views-path p =
  orB (h-eq (h-before "?" p) "/graph") (
  orB (h-prefix "/api/graph" p) (
  orB (h-eq (h-before "?" p) "/hi") (
  orB (h-prefix "/hi/" p) (
  orB (h-prefix "/history" p)
      (h-prefix "/api/history" p)))))
