-- ---------------------------------------------------------------- named worlds (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §18.11 “D24–D27 — The world”, its part D27; library half)
-- a world a binary links against is named: a handler implementation under a name, with the
-- model (the in-language world the implementation is specified against) beside it. A registry is
-- a list of named worlds; a binary picks one by name. `world "name" = handler` (the surface form
-- that lists the implementation under #trusted) is the machine side of this
record Named (S : Sig) (St : Type) = { wid : Word ; model : World S St }
