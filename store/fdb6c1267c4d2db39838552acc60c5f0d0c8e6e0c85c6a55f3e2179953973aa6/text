-- what each node holds as essential context, as lines "DOCUMENT NODE": every essential-context line of a node's
-- view, direct or inherited ("essential context: DOC  (from NODE)")
hi-ctx-lines : List Word → List (List Word) → List (List Word)
hi-ctx-lines n nil = nil
hi-ctx-lines n (cons l r) = if h-infix "essential context: " l then cons (list-append (h-before "  " (h-after "essential context: " l)) (cons #32 n)) (hi-ctx-lines n r) else hi-ctx-lines n r
