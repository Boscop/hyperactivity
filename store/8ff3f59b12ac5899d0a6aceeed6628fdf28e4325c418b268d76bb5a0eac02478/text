-- one pair's contribution along edge 0 after H_0 of side sp, with its table's check
eig-hop-pair-with : List SpaceData → VM → Nat → Nat → SQ → List Nat → Rows → Bool × List (List (List PRad))
eig-hop-pair-with tbl aP m n s dsP xs0 = (table-ok tbl , eig-pair tbl aP m n s dsP xs0 (proj-zero (rows-len xs0) (vertex-count (vw-frs (fst aP)))))
