-- THE ELIMINATION on A × W, given the dependence dc found in W. ys: vectors of W already passed, their first coordinate
-- zero; xs: vectors still to read. A vector whose first coordinate is zero joins ys; the first whose first coordinate
-- is not zero is the pivot, against which the padded ys and the rest are reduced into W, where the dependence is found.
-- The coefficients for ys (sy-ecy) and for xs (sy-ecw)
sy-ecy : (A W : Type) → (z : A) → (ad mu : A → A → A) → (ng : A → A) → (isz : A → Bool) → (wz : W) → (wa : W → W → W) → (ws : A → W → W) → (dc : List W → List A) → List W → List (A × W) → List A
sy-ecy A W z ad mu ng isz wz wa ws dc ys xs = case xs of
  nil → dc ys
  cons w wr → if isz (fst w) then (cl-tl A (sy-ecy A W z ad mu ng isz wz wa ws dc (cons (snd w) ys) wr)) else (sy-outs A W z mu (fst w) (dc (ln-map (A × W) W (λ t2 → sy-red A W ng wa ws (fst w) (snd w) t2) (sy-app (A × W) (ln-map W (A × W) (λ y → (z , y)) ys) wr))) (sy-app (A × W) (ln-map W (A × W) (λ y → (z , y)) ys) wr))
