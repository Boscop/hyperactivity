vh-eval-dag vEnv lEnv (vt-ref r)   = lEnv r
vh-eval-dag vEnv lEnv (vt-add a b) = %wadd (vh-eval-dag vEnv lEnv a) (vh-eval-dag vEnv lEnv b)
vh-eval-dag vEnv lEnv (vt-mul a b) = %wmul (vh-eval-dag vEnv lEnv a) (vh-eval-dag vEnv lEnv b)
