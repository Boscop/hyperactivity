vh-dag-cells (vt-add a b) = %wadd #1 (%wadd (vh-dag-cells a) (vh-dag-cells b))
vh-dag-cells (vt-mul a b) = %wadd #1 (%wadd (vh-dag-cells a) (vh-dag-cells b))
vh-dag-cells (vt-xor a b) = %wadd #1 (%wadd (vh-dag-cells a) (vh-dag-cells b))

vh-quad-unboxed : VHTerm → VHTerm
