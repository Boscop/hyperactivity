vh-parse-milli-frac (suc r) (cons b bs) acc =
  if andB (not (%wlt b #48)) (%wlt b #58)
  then vh-parse-milli-frac r bs (%wadd (%wmul acc #10) (%wsub b #48))
  else vh-parse-milli-frac r nil (%wmul acc #10)

vh-parse-milli : List Word → Word → Word
vh-parse-milli nil         acc = %wmul acc #1000
vh-parse-milli (cons b bs) acc =
  if andB (not (%wlt b #48)) (%wlt b #58)
  then vh-parse-milli bs (%wadd (%wmul acc #10) (%wsub b #48))
  else if %weq b #46 then vh-parse-milli-frac (toNat #3) bs acc
  else %wmul acc #1000

vh-skip-nondig : Nat → List Word → List Word
vh-skip-nondig zero    bs          = nil
vh-skip-nondig (suc f) nil         = nil
vh-skip-nondig (suc f) (cons b bs) =
  if andB (not (%wlt b #48)) (%wlt b #58) then cons b bs else vh-skip-nondig f bs

vh-drop-num : Nat → List Word → List Word
vh-drop-num zero    bs          = bs
vh-drop-num (suc f) nil         = nil
vh-drop-num (suc f) (cons b bs) =
  if vh-orB (%weq b #46) (andB (not (%wlt b #48)) (%wlt b #58))
  then vh-drop-num f bs
  else cons b bs

