hi-morph : List Word → List Word → List Word → List Word → Proc W (List Word)
hi-morph st rd f o = bind (hi-says st f) (λ a → bind (hi-says st o) (λ b → bind (hi-link rd o) (λ ol →
  ret (h-concat (cons "<div class='morph card' style='max-width:none;width:100%'><div class='who'>asserted equivalent: " (cons ol (cons "</div><div class='ma'>" (cons (hi-mside "+" (list-append "m" (h-hex o)) zero (hi-aligned a b)) (cons "</div><div class='mb' style='display:none'>" (cons (hi-mside "-" (list-append "m" (h-hex o)) zero (hi-aligned a b)) (cons "</div><button class='mt'>morph</button></div>" nil)))))))))))
