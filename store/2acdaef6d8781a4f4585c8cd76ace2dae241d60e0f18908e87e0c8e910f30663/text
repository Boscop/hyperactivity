nk-uses-bcadr-tl : (i : Word) (a tl : NkTm) → (nk-uses-var #0 i (nk-bcadr (nk-cons a tl)) ≡ true) → nk-uses-var #0 i (nk-cons a tl) ≡ true
nk-uses-bcadr-tl i a (nk-cons b r) hu =
  nk-or-r (nk-uses-var #0 i a) (nk-uses-var #0 i (nk-cons b r))
    (nk-or-l (nk-uses-var #0 i b) (nk-uses-var #0 i r) hu)
nk-uses-bcadr-tl i a (nk-var x) hu = nk-no hu
nk-uses-bcadr-tl i a (nk-free x) hu = nk-no hu
nk-uses-bcadr-tl i a (nk-num m) hu = nk-no hu
nk-uses-bcadr-tl i a (nk-lam b) hu = nk-no hu
nk-uses-bcadr-tl i a (nk-susp b) hu = nk-no hu
nk-uses-bcadr-tl i a (nk-con c as) hu = nk-no hu
nk-uses-bcadr-tl i a (nk-op op p as) hu = nk-no hu
nk-uses-bcadr-tl i a (nk-match op p cs) hu = nk-no hu
nk-uses-bcadr-tl i a nk-nil hu = nk-no hu
