-- at doubled a, c, J: each row e = a ± ½ that couples (e c → J) has norm one, and two such rows are orthogonal
brecouple-orth-at : List Bool → List Bool → List Bool → Bool
brecouple-orth-at a c j = if bin-null a
  then (if btri-ok j c (bin-add a bin-one) then (amp-unit2 (fst (brecouple-row a (bin-add a bin-one) c j)) (snd (brecouple-row a (bin-add a bin-one) c j))) else true)
  else (and (and
    (if btri-ok j c (bin-add a bin-one) then amp-unit2 (fst (brecouple-row a (bin-add a bin-one) c j)) (snd (brecouple-row a (bin-add a bin-one) c j)) else true)
    (if btri-ok j c (bin-sub a bin-one) then amp-unit2 (fst (brecouple-row a (bin-sub a bin-one) c j)) (snd (brecouple-row a (bin-sub a bin-one) c j)) else true))
    (if and (btri-ok j c (bin-add a bin-one)) (btri-ok j c (bin-sub a bin-one))
      then amp-cancel (amp-mul (fst (brecouple-row a (bin-add a bin-one) c j)) (fst (brecouple-row a (bin-sub a bin-one) c j)))
        (amp-mul (snd (brecouple-row a (bin-add a bin-one) c j)) (snd (brecouple-row a (bin-sub a bin-one) c j)))
      else true))
