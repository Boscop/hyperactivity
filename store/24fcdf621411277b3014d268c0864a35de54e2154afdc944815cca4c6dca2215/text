-- Word operations (cwop 0..12): eq, lt, checked add, max, monus, checked mul, div, mod, and, or, xor, _, shr
a64-wop : Word → Lst Word
a64-wop k =
  if %weq k #0 then l-app (a64-cmp #0 #1) (a64-bool-cc #0 a64-cc-eq)
  else if %weq k #1 then l-app (a64-cmp #0 #1) (a64-bool-cc #0 a64-cc-lo)
  else if %weq k #2 then l-app (a64-adds #0 #0 #1) a64-over-if-hs
  else if %weq k #3 then l-app (a64-cmp #0 #1) (a64-csel #0 #1 #0 a64-cc-lo)
  else if %weq k #4 then xcat3 (a64-subs #2 #0 #1) (a64-movz #9 #0 #0) (a64-csel #0 #2 #9 a64-cc-hs)
  else if %weq k #5 then xcat4 (a64-umulh #2 #0 #1) (a64-mul #0 #0 #1) (l-app (a64-movz #9 #0 #0) (a64-cmp #2 #9)) a64-over-if-ne
  else if %weq k #6 then a64-udiv #0 #0 #1
  else if %weq k #7 then a64-umod
  else if %weq k #8 then a64-and-r #0 #0 #1
  else if %weq k #9 then a64-orr-r #0 #0 #1
  else if %weq k #10 then a64-eor-r #0 #0 #1
  else xcat5 (a64-movz #9 #63 #0) (a64-cmp #1 #9) (a64-lsrv #2 #0 #1) (a64-movz #9 #0 #0) (a64-csel #0 #2 #9 a64-cc-ls)
