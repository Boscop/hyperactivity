-- Wigner's Friend coexistence: Friend (oF) and Wigner (oW) can hold simultaneous
-- relative facts on the exact same history h without contradiction, even when oF
-- and oW are mutually complementary.
rqm-wigner-relative-consistent :
  (H : Type 0) → (oF oW : Observer H) → (h : H) →
  RelativeFact H oF h (obs-of H oF h) × RelativeFact H oW h (obs-of H oW h)
rqm-wigner-relative-consistent H oF oW h =
  ((λ i → obs-of H oF h) , (λ i → obs-of H oW h))
