-- Starting from clean reset pipeline (wbV = false), pipelined execution + 1-cycle drain ≡ isa-run!
pipe-reset-sound : (rf0 : RegFile) → (prog : List IsaInst) →
  pipe-flush (pipe-run (pstate rf0 false #0 zero) prog) ≡ isa-run rf0 prog
pipe-reset-sound rf0 prog = pipe-run-sound prog (pstate rf0 false #0 zero)
