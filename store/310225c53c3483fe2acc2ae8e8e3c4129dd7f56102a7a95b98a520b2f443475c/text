zvol-steps : Nat → List Bool → List Bool → List Bool → List Bool → List Bool → List Bool × (List BZ × List BZ) → List Bool × (List BZ × List BZ)
zvol-steps f j1 j2 j3 j4 a st = case f of
  zero → st
  suc g → zvol-steps g j1 j2 j3 j4 (bin-add a bin-two) (zchar-step (bin-mul (btri4 j1 j2 a) (btri4 j3 j4 a)) (bin-mul (bin-sub a bin-one) (bin-add a bin-one)) st)
