-- k suffixes from point q on (s the one at q), each against t: the longest common prefix and where
best-match : List (List Word) → Nat → Nat → List (List Word) → Nat × Nat
best-match t k =
  case k return λ w → Nat → List (List Word) → Nat × Nat of
    zero → λ q s → (zero , zero)
    suc k1 → λ q s → best-step (lcp s t) q (rec k1 (suc q) (tail-of s))
