-- functoriality: composition of flow homomorphisms composes on basins
basin-map-comp : {S T V : Type 0} {s1 : S → S → Bool} {s2 : T → T → Bool} {s3 : V → V → Bool}
               → (g : S → T) → (hg : FlowHom S T s1 s2 g)
               → (k : T → V) → (hk : FlowHom T V s2 s3 k)
               → (u : Basins S s1)
               → basin-map {T} {V} {s2} {s3} k hk (basin-map {S} {T} {s1} {s2} g hg u)
                 ≡ basin-map {S} {V} {s1} {s3} (λ x → k (g x)) (λ a b p → hk (g a) (g b) (hg a b p)) u
basin-map-comp {S} {T} {V} {s1} {s2} {s3} g hg k hk (basin-pt x) = refl
basin-map-comp {S} {T} {V} {s1} {s2} {s3} g hg k hk (basin-step a b p i) = refl
