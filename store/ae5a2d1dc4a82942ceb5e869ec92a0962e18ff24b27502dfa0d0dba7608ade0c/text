-- the answers to a list of messages of a size, from a fresh program
rd-run : RCrate → Word → Word → List (List Word) → MRes (Ctl RExc (List Word))
rd-run c fuel size ms =
  ev-value (ev-run-pure
    (rm-bind (rust-init rd-target c) (λ img →
     rm-bind (rm-alloc-static size #1) (λ p → rd-msgs ms c fuel img p)))
    (mem-empty rd-target))
