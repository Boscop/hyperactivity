-- the node an address belongs to: its index in the configuration, or the number of nodes (no
-- node) when it is nobody's
dp-id-of : List NodeCfg → SockAddr → Nat
dp-id-of l a = case l of
  nil → zero
  cons nc r → (case andB (weq (sa-port (nc-addr nc)) (sa-port a)) (weq (sa-ip (nc-addr nc)) (sa-ip a)) of true → zero; false → suc (rec r))
