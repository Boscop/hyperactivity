-- one request moves past a plan that writes none of its wire
nk-do-upd : (fx : NkFx) (sl : NkSlots) (w : Word) (f : NkSlot → NkSlot) → nk-apart w fx → nk-same (nk-do fx (nk-upd sl w f)) (nk-upd (nk-do fx sl) w f)
nk-do-upd nkf-nil sl w f ap x = refl
nk-do-upd (nkf-val k v r) sl w f ap x =
  nk-do-same r (nk-upd (nk-upd sl w f) k (nk-arrive-val v)) (nk-upd (nk-upd sl k (nk-arrive-val v)) w f) (nk-upd-swap sl w k f (nk-arrive-val v) (fst ap) (fst (snd ap))) x
  ∙ nk-do-upd r (nk-upd sl k (nk-arrive-val v)) w f (snd (snd ap)) x
nk-do-upd (nkf-op k o r) sl w f ap x =
  nk-do-same r (nk-upd (nk-upd sl w f) k (nk-arrive-op o)) (nk-upd (nk-upd sl k (nk-arrive-op o)) w f) (nk-upd-swap sl w k f (nk-arrive-op o) (fst ap) (fst (snd ap))) x
  ∙ nk-do-upd r (nk-upd sl k (nk-arrive-op o)) w f (snd (snd ap)) x
nk-do-upd (nkf-put k s r) sl w f ap x =
  nk-do-same r (nk-upd (nk-upd sl w f) k (λ s0 → s)) (nk-upd (nk-upd sl k (λ s0 → s)) w f) (nk-upd-swap sl w k f (λ s0 → s) (fst ap) (fst (snd ap))) x
  ∙ nk-do-upd r (nk-upd sl k (λ s0 → s)) w f (snd (snd ap)) x
