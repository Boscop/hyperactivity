-- cancelling a positive, or a negative, integer factor
zle-cancel-pos : (a b P : Nat × Nat) → zpos P → zle (zmul a P) (zmul b P) → zle a b
zle-cancel-pos a b P hp h = zle-cancel-scale a b (suc (fst hp))
  (zle-path (zmul a (the (Nat × Nat) (suc (fst hp) , zero))) (zsc a (suc (fst hp))) (zmul b (the (Nat × Nat) (suc (fst hp) , zero))) (zsc b (suc (fst hp)))
     (zmul-zsc a (suc (fst hp))) (zmul-zsc b (suc (fst hp)))
     (zle-zeq-r (zmul a (the (Nat × Nat) (suc (fst hp) , zero))) (zmul b P) (zmul b (the (Nat × Nat) (suc (fst hp) , zero))) (zmul-zeq-r b P (the (Nat × Nat) (suc (fst hp) , zero)) (zpos-eq P hp))
        (zle-zeq-l (zmul a P) (zmul a (the (Nat × Nat) (suc (fst hp) , zero))) (zmul b P) (zmul-zeq-r a P (the (Nat × Nat) (suc (fst hp) , zero)) (zpos-eq P hp)) h)))
  (le-one-suc (fst hp))
