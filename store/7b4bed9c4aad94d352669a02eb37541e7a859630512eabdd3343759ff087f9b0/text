-- which of two tests passed, from the fact that their disjunction did
or-cases : (b : Bool) → (c : Bool) → isTrue (case b of true → true; false → c) → Sum (isTrue b) (isTrue c)
or-cases b c = case b return (λ w → isTrue (case w of true → true; false → c) → Sum (isTrue w) (isTrue c)) of
  true → (λ q → inl unit)
  false → (λ q → inr q)
