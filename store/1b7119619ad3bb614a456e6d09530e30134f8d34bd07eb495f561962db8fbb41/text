lx-then : {l : Level} {A B : Type} → Proc {l} Linux (Sum Errno A) → (A → Proc {l} Linux (Sum Errno B)) → Proc {l} Linux (Sum Errno B)
lx-then {l} {A} {B} p f = bind {l} {Linux} {Sum Errno A} {Sum Errno B} p (λ r → lx-sum {l} {Linux} {Errno} {A} {Sum Errno B} r (λ e → ret {l} {Linux} {Sum Errno B} (inl e)) f)
