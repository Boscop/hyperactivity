-- (part of language-support)
mul_spec : (size : ZI) → (dst' : Bits #64) → (src : Bits #64) → ((Bits #64) × (Bits #64) × (Bits #128))
mul_spec size dst' src =
  let t'4 : ((Bits #64) × (Bits #64) × (Bits #128))
      t'4 =
        if (z-eq size (zpos #1)) then
          (let t'1 : ((Bits #8) × (Bits #8) × (Bits #16))
               t'1 = (mul_spec_8 (bv-trunc #64 #8 dst') (bv-trunc #64 #8 src))
               elem0 : Bits #8
               elem0 = (fst t'1)
               elem1 : Bits #8
               elem1 = (fst (snd t'1))
               elem2 : Bits #16
               elem2 = (snd (snd t'1))
           in ((bv-zext #8 #64 elem0) , (bv-zext #8 #64 elem1) , (bv-zext #16 #128 elem2)))
        else if (z-eq size (zpos #2)) then
          (let t'2 : ((Bits #16) × (Bits #16) × (Bits #32))
               t'2 = (mul_spec_16 (bv-trunc #64 #16 dst') (bv-trunc #64 #16 src))
               elem0 : Bits #16
               elem0 = (fst t'2)
               elem1 : Bits #16
               elem1 = (fst (snd t'2))
               elem2 : Bits #32
               elem2 = (snd (snd t'2))
           in ((bv-zext #16 #64 elem0) , (bv-zext #16 #64 elem1) , (bv-zext #32 #128 elem2)))
        else if (z-eq size (zpos #4)) then
          (let t'3 : ((Bits #32) × (Bits #32) × (Bits #64))
               t'3 = (mul_spec_32 (bv-trunc #64 #32 dst') (bv-trunc #64 #32 src))
               elem0 : Bits #32
               elem0 = (fst t'3)
               elem1 : Bits #32
               elem1 = (fst (snd t'3))
               elem2 : Bits #64
               elem2 = (snd (snd t'3))
           in ((bv-zext #32 #64 elem0) , (bv-zext #32 #64 elem1) , (bv-zext #64 #128 elem2)))
        else if (z-eq size (zpos #8)) then
          (mul_spec_64 dst' src)
        else
          (#0 , #0 , #0)
  in t'4
