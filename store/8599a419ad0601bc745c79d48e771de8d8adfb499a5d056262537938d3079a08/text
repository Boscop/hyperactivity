     cli-say "HX-PHYSICAL-DATATYPES | Exact Typed CAD + Robotics + Circuits + Chemistry + Markets (0 postulates)"
       (cli-say (list-append "  [CAD]      Euler chi(tetra)=2, chi(cube)=2, 3D translation invariance & d(tri)=0: "
                (if ok-cad then "PASS (EXACT)" else "FAIL"))
       (cli-say (list-append "  [ROBOTICS] SE(3) FK associativity/identity + KUKA CBF joint-limit invariance: "
                (if ok-rob then "PASS (EXACT)" else "FAIL"))
       (cli-say "  [UNIFIED]  PhysObj lossless fiberEquiv over 5 physical domains (CAD/Robot/Circuit/Chem/Market)"
       (cli-say "  [WIRE]     Wrote 32-byte authenticated HXSV frame -> /tmp/hx_agent_bus/physical_datatypes.hxsv"
         (sdone #0))))))

pd-c : List Word
