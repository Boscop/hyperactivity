-- composition in the universe: the base type glued, on each face, with the end of that side's
-- line of types, along the equivalence the line run backwards is
nk-hcu-sides : NkTm → NkTm
nk-hcu-sides (nk-cons b r) = nk-cons (nk-br (nk-bf b) (nk-mkpair (nk-app (nk-bv b) nk-i1) (nk-line-equiv (nk-lam (nk-app (nk-up (nk-bv b)) (nk-neg (nk-var #0))))))) (nk-hcu-sides r)
nk-hcu-sides t = nk-nil
