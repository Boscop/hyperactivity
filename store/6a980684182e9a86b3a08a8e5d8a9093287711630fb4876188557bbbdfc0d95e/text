lt-digit : (D R P : Word) → wlt D #256 ≡ true → wlt R P ≡ true → wlt (wadd (wmul D P) R) (wmul #256 P) ≡ true
lt-digit D R P hD hR =
  lt-wlt (wadd (wmul D P) R) (wmul #256 P)
    (wadd (fst (wlt-lt R P hR)) (wmul (fst (wlt-lt D #256 hD)) P) ,
     lt-digit-path D R P (fst (wlt-lt D #256 hD)) (fst (wlt-lt R P hR)) (snd (wlt-lt D #256 hD)) (snd (wlt-lt R P hR)))
