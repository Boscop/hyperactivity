v-context-lines : VEnv → List Word → List (List Word) → List Word
v-context-lines env a nil = nil
v-context-lines env a (cons m r) =
  list-append (h-concat (list-map (λ d → h-line (list-append "  essential context: " (list-append d (if h-eq m a then nil else list-append "  (from " (list-append m ")"))))) (v-collect-list m (ve-ctx env))))
    (v-context-lines env a r)
