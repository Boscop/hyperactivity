-- Shared 4-NAND2 XOR evaluated under Liberty NLDM (arrival, slew) STA in one pass!
xor4-nldm-sta : Nat → Nat → Nat → Nat → Nat → Nat → StaSlew
xor4-nldm-sta d0 alpha beta s0 gamma cLoad =
  net-eval (toNat #3) (toNat #2)
    (nldm-nand2-alg d0 alpha beta s0 gamma cLoad)
    (λ _ → (zero , zero))
    xor4-shared-net unit
