-- ============================================================================
-- 4. Combined H_EM = H_E + H_M Flux-Sector Spectral Discriminant SOS Certificate
-- ============================================================================
-- On a 2-state U(1) flux sector, H_EM = [[e1, m], [m, e2]] (e1, e2 from chem/electric.cub,
-- off-diagonal loop coupling m from chem/magnetic.cub & chem/magloop.cub).
-- Exact characteristic discriminant SOS identity:
--   (e1 + e2)² - 4(e1 e2 - m²) = (e1 - e2)² + 4 m² ≥ 0.
-- Certifies real spectrum and strict level-splitting enhancement by magnetic loops!
-- Variables (0..2): e1, e2, m.
lqg-hem-disc-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-hem-disc-poly A ad mu q vs =
  (λ g sub sq →
    let e1 = g 0; e2 = g 1; m = g 2
        q4 = q (fn-q 4 1)
        tr = ad e1 e2
        dt = sub (mu e1 e2) (sq m)
        lhs = sub (sq tr) (mu q4 dt)
        rhs = ad (sq (sub e1 e2)) (mu q4 (sq m))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
