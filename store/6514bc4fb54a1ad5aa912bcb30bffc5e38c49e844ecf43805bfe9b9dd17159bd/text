-- the sum of intervals holds the sum of rationals X1/q1 + X2/q2 = (X1 q2 + X2 q1)/(q1 q2)
iv-add-sound : (S : List Bool) → (I1 I2 : IV) → (X1 X2 : Nat × Nat) → (q1 q2 : Nat) → ivc I1 → ivc I2 → encl S I1 X1 q1 → encl S I2 X2 q2 → encl S (iv-add I1 I2) (zplus (zsc X1 q2) (zsc X2 q1)) (times q1 q2)
iv-add-sound S I1 I2 X1 X2 q1 q2 c1 c2 e1 e2 =
  (zle-zeq-l (zsc (zplus (zv (fst I1)) (zv (fst I2))) (times q1 q2)) (zsc (zv (bz-add (fst I1) (fst I2))) (times q1 q2)) (zsc (zplus (zsc X1 q2) (zsc X2 q1)) (bin-to-nat S))
     (zeq-zsc (zplus (zv (fst I1)) (zv (fst I2))) (zv (bz-add (fst I1) (fst I2))) (times q1 q2)
        (zeq-sym (zv (bz-add (fst I1) (fst I2))) (zplus (zv (fst I1)) (zv (fst I2)))
          (bz-add-sound (fst (fst I1)) (snd (fst I1)) (fst (fst I2)) (snd (fst I2)) (fst c1) (fst c2))))
     (add-low (zv (fst I1)) (zv (fst I2)) X1 X2 q1 q2 (bin-to-nat S) (fst e1) (fst e2)) ,
   zle-zeq-r (zsc (zplus (zsc X1 q2) (zsc X2 q1)) (bin-to-nat S)) (zsc (zplus (zv (snd I1)) (zv (snd I2))) (times q1 q2)) (zsc (zv (bz-add (snd I1) (snd I2))) (times q1 q2))
     (zeq-zsc (zplus (zv (snd I1)) (zv (snd I2))) (zv (bz-add (snd I1) (snd I2))) (times q1 q2)
        (zeq-sym (zv (bz-add (snd I1) (snd I2))) (zplus (zv (snd I1)) (zv (snd I2)))
          (bz-add-sound (fst (snd I1)) (snd (snd I1)) (fst (snd I2)) (snd (snd I2)) (snd c1) (snd c2))))
     (add-high (zv (snd I1)) (zv (snd I2)) X1 X2 q1 q2 (bin-to-nat S) (snd e1) (snd e2)))
