dadda-fa-blif : List Word → List Word → List Word → List Word → List Word → Word → List Word
dadda-fa-blif x y z s c uid =
  let u  = epfl-dec uid
      t0 = list-append "dt0_" u
      t1 = list-append "dt1_" u
      xr = list-append "dx_"  u
      t2 = list-append "dt2_" u
      t3 = list-append "dt3_" u
  in sv-concat
       (cons (epfl-gate2 x  y  t0 "11")
       (cons (epfl-gate2 x  y  t1 "00")
       (cons (epfl-gate2 t0 t1 xr "00")
       (cons (epfl-gate2 xr z  t2 "11")
       (cons (epfl-gate2 xr z  t3 "00")
       (cons (epfl-gate2 t2 t3 s  "00")
       (cons (epfl-or2-blif t0 t2 c) nil)))))))
