keccak256 : List Word → List Word
keccak256 msg =
  let padded = kc-pad136 msg
      nblks  = %wdiv (fromNat (list-length padded)) #136
      st     = kc-absorb (toNat nblks) padded (kc-zeros (toNat #25))
  in list-append (kc-u64-bytes-le (toNat #8) (kc-nth64 #0 st))
     (list-append (kc-u64-bytes-le (toNat #8) (kc-nth64 #1 st))
     (list-append (kc-u64-bytes-le (toNat #8) (kc-nth64 #2 st))
                  (kc-u64-bytes-le (toNat #8) (kc-nth64 #3 st))))
