word-bytes-ok : (k : Nat) → (w : Word) → bytes-to-word-with (word-to-bytes-go k w) ≡ w
word-bytes-ok k =
  case k return (λ n → (w : Word) → bytes-to-word-with (word-to-bytes-go n w) ≡ w) of
    zero → λ w i → w
    suc n → λ w →
      ifP {λ b → bytes-to-word-with (if b then (nil , #0) else let p = word-to-bytes-go n (wquot w #256) in (cons (wrem w #256) (fst p) , snd p)) ≡ w} {weq w #0}
        (λ e → symw (cm-weq-sound w #0 e))
        (λ e →
           catw (congw (λ z → wadd (wmul z #256) (wrem w #256)) (rec n (wquot w #256)))
             (symw (wdiv-mod w #256)))
