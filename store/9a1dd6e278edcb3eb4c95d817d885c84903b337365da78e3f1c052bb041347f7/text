-- logand_int recurses in Sail; here on the bound (wadd (z-mag i') #2) (i's magnitude halves (floor) until i is 0 or -1)
-- (part of language-support)
logand_int-body : ((i' : ZI) → (j' : ZI) → ZI) → (i' : ZI) → (j' : ZI) → ZI
logand_int-body self' i' j' =
  let t'4 : ZI
      t'4 =
        if (z-eq i' (zpos #0)) then
          (zpos #0)
        else
          (let t'3 : ZI
               t'3 =
                 if (z-eq j' (zpos #0)) then
                   (zpos #0)
                 else
                   (let t'2 : ZI
                        t'2 =
                          if (z-eq i' (zneg #1)) then
                            j'
                          else
                            (let t'1 : ZI
                                 t'1 =
                                   if (z-eq j' (zneg #1)) then
                                     i'
                                   else
                                     (let x' : ZI
                                          x' = (z-mul (zpos #2) (self' (floor2 i' (zpos #2)) (floor2 j' (zpos #2))))
                                      in (z-add x' (if (isEven i') then (zpos #0) else (if (isEven j') then (zpos #0) else (zpos #1)))))
                             in t'1)
                    in t'2)
           in t'3)
  in t'4
