-- a value: a closure, a number, a reference to a held wire, a blocked term (a free variable, a
-- variable introduced by quotation at a depth, an application or an increment waiting on a blocked
-- term), or a quoted body
data NkVal = nkv-lam (b : NkTm) (e : NkEnv) | nkv-num (m : Word) | nkv-ref (w : Word) | nkv-var (x : Word) | nkv-lvl (l : Word) | nkv-napp (f : Word) (a : Word) | nkv-ninc (a : Word) | nkv-q (t : NkTm)
