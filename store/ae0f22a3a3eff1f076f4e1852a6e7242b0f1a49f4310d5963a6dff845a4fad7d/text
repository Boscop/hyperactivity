-- maps equal at every element are equal
cl-map-ext : (A B : Type) → (f g : B → A) → ((r : B) → f r ≡ g r) → (m : List B) → ln-map B A f m ≡ ln-map B A g m
cl-map-ext A B f g h m = case m return λ w → ln-map B A f w ≡ ln-map B A g w of
  nil → λ i → nil
  cons r rest → λ i → cons (h r i) (cl-map-ext A B f g h rest i)
