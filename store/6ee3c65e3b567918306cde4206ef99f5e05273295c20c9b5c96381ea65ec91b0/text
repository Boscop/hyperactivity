hs-bench-one : List Word → Word → Word → Step W Word → Step W Word
hs-bench-one name target maxd next =
  scmd w-now (λ t0 →
  let res = hs-id target maxd
      gates = fst res
      prog = fst (snd res)
      nodes = snd (snd res)
      ok = hs-verify target prog (toNat gates)
      dig = hs-digest target gates prog
  in scmd w-now (λ t1 →
     let us = %wmax #1 (%wdiv (%wsub t1 t0) #1000)
         knps = %wdiv (%wmul nodes #1000) us
     in cli-say (list-append "SYNTH " (list-append name (list-append " tt=" (list-append (ce-dec target)
          (list-append " OPT_NAND2=" (list-append (ce-dec gates) (list-append " VERIFIED=" (list-append (if ok then "1" else "0")
          (list-append " nodes=" (list-append (ce-dec nodes) (list-append " (" (list-append (ce-dec us) (list-append " us, "
          (list-append (ce-dec knps) (list-append "k eval/s) pouw_digest=" (list-append (ce-dec dig)
          (hs-fmt-net (toNat gates) #3 prog))))))))))))))))) next))
