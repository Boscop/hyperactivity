-- THEOREM 4: RECURSIVE HALVING-DOUBLING SATURATES THE EXACT FAN-IN-2 LOG2(N) LOWER BOUND
sc-thm-allreduce-tree-opt : (d : Nat) → sc-tree-cap d ≡ sc-nodes d
sc-thm-allreduce-tree-opt zero    = refl
sc-thm-allreduce-tree-opt (suc d) =
  λ i → hm-add (sc-thm-allreduce-tree-opt d i) (sc-thm-allreduce-tree-opt d i)
