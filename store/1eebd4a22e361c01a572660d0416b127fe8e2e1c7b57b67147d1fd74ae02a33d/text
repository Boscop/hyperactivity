-- with the pattern q, the key of the selected context forward (e bytes), read over a key forward: how many
-- places match it whole (state e: q has no longer state)
m-count : (n : Nat) → Bytes n → (k : Nat) → Bytes k → Word → (s : Nat) → Bytes s → Word
m-count n q k f e s b = m-count-end e (%welimP (λ _ → Word) (bytes-length s b) #0
  (λ i a → m-with (if weq (m-lo a) e then wadd (wshr a #32) #1 else wshr a #32) (m-next n q k f e (m-lo a) (cstr-get s b i))))
