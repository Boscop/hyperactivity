-- a suffix outside the shard is not begun by q: dropping it leaves the points unchanged
sx-skip : (v : Bool) → (i : Nat) → (H : List Nat) → (X : List Nat) → (isTrue v → Empty) → X ≡ H → X ≡ (if v then cons i H else H)
sx-skip v =
  case v return λ y → (i : Nat) → (H : List Nat) → (X : List Nat) → (isTrue y → Empty) → X ≡ H → X ≡ (if y then cons i H else H) of
    true → λ i H X h e → Empty-rec (h unit)
    false → λ i H X h e → e
