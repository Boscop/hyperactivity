s-load64 : Word → Proc W Word
s-load64 a =
  bind (load8-at a) (λ b0 → bind (load8-at (wadd a #1)) (λ b1 →
  bind (load8-at (wadd a #2)) (λ b2 → bind (load8-at (wadd a #3)) (λ b3 →
  bind (load8-at (wadd a #4)) (λ b4 → bind (load8-at (wadd a #5)) (λ b5 →
  bind (load8-at (wadd a #6)) (λ b6 → bind (load8-at (wadd a #7)) (λ b7 →
  ret (wadd b0 (wadd (wshl b1 #8) (wadd (wshl b2 #16) (wadd (wshl b3 #24)
    (wadd (wshl b4 #32) (wadd (wshl b5 #40) (wadd (wshl b6 #48) (wshl b7 #56))))))))))))))))
