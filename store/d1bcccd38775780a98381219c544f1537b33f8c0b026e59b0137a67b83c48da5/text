v-build-s0 : List (List Word × Node) → List (List Word) → Nat → List (List Word × List (List Word)) → List (List Word × List (List Word)) → List (List Word × List Word) → List Node → List (Node × List Node) → List (Node × List Document) → VEnv
v-build-s0 all names rounds ptab ktab res ip-raw aft-raw ctx-raw =
  let roots = v-filter (λ i → v-empty (v-look-list i ptab)) names in
  let res-ids = list-map {List Word × List Word} {List Word} (λ e → fst e) res in
  let done-set = v-resolve rounds ktab res-ids in
  v-build-s1 rounds names (v-mk-sents all) ptab ktab roots (v-ids-in all ip-raw) res res-ids done-set (v-mk-aft all aft-raw) (v-mk-ctx all ctx-raw) (v-mk-anc rounds names ptab) (v-mk-und rounds names ktab)
