mdiff-mundiff : (B p d : Word) → wlt p B ≡ true → wlt d B ≡ true → mdiff-val B p (mundiff-val B p d) ≡ d
mdiff-mundiff B p d hp hd =
  ifP {λ b → mdiff-val B p (if b then wadd p d else wsub (wadd p d) B) ≡ d} {wlt (wadd p d) B}
    (λ e →
       let eq1 : wlt (wadd p d) p ≡ false
           eq1 = cm-le-add-l p d
       in catw (cm-ifw (wsub (wadd (wadd p d) B) p) (wsub (wadd p d) p) eq1) (cm-wsub-add p d))
    (λ e →
       let eq1 : wlt (wsub (wadd p d) B) p ≡ true
           eq1 = mundiff-sub-lt-p B p d hd e
           eq2 : wadd (wsub (wadd p d) B) B ≡ wadd p d
           eq2 = catw (cm-wadd-comm (wsub (wadd p d) B) B) (cm-wadd-sub-le (wadd p d) B e)
       in catw (cm-ifw (wsub (wadd (wsub (wadd p d) B) B) p) (wsub (wsub (wadd p d) B) p) eq1)
            (catw (congw (λ z → wsub z p) eq2) (cm-wsub-add p d)))
