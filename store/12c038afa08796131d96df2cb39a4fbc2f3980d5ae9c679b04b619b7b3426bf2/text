place-row-above-y : (y0 cellH xGap : Nat) → (ws : List Nat) → (yBound xCur : Nat) →
  leB yBound y0 ≡ true → AllAboveY yBound (place-row xCur y0 cellH xGap ws)
place-row-above-y y0 cellH xGap nil = λ yBound xCur hy → unit
place-row-above-y y0 cellH xGap (cons w ws) = λ yBound xCur hy →
  (hy , place-row-above-y y0 cellH xGap ws yBound (plus xGap (plus w xCur)) hy)
