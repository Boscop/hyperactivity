-- the count of [[a, 0], [0, G]], a nonzero: the count of G, one more when a is negative; the flag is G's
cl-bd-count : (A B : Type) → (z a : A) → (isz neg : A → Bool) → isz z ≡ true → isz a ≡ false → (ws : List B) → (g : List (List A)) →
  cl-count A z isz neg (cl-top A B z a ws g) ≡ (if neg a then suc (fst (cl-count A z isz neg g)) else fst (cl-count A z isz neg g) , snd (cl-count A z isz neg g))
cl-bd-count A B z a isz neg hz ha ws g = cl-tr (Nat × Bool)
  (cl-step A isz neg a (cl-offz A isz zero (suc zero) (ln-map B A (λ w → z) ws)) (cl-count-go A z isz neg (suc zero) (ln-map (List A) (List A) (λ r → cons z r) g)))
  (cl-step A isz neg a true (cl-count-go A z isz neg zero g))
  (if neg a then suc (fst (cl-count A z isz neg g)) else fst (cl-count A z isz neg g) , snd (cl-count A z isz neg g))
  (λ i → cl-step A isz neg a (cl-zeros-offz A B z isz hz ws zero i) (cl-go-shift A z isz neg hz g zero i))
  (λ i → (if neg a then suc (fst (cl-count A z isz neg g)) else fst (cl-count A z isz neg g) , if ha i then false else snd (cl-count A z isz neg g)))
