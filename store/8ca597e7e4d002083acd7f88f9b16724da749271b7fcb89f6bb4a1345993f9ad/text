-- a shorter list is not of equal length
tso-len-eq-lt : {A : Type} → (xs ys : List A) → tso-len xs < tso-len ys → isTrue (tso-len-eq xs ys) → Empty
tso-len-eq-lt nil nil h k = h
tso-len-eq-lt nil (cons y r) h k = k
tso-len-eq-lt (cons x xs) nil h k = k
tso-len-eq-lt (cons x xs) (cons y r) h k = tso-len-eq-lt xs r h k
