  %weq (%wadd (ch-lane-bit k a) (%wadd (ch-lane-bit k b) (ch-lane-bit k c)))
       (%wadd (ch-lane-bit k (fst sc)) (%wmul #2 (ch-lane-bit k (snd sc))))

