ch-le : Nat → Nat → Bool
ch-le zero    _       = true
ch-le (suc _) zero    = false
ch-le (suc x) (suc y) = ch-le x y

ch-mul : Nat → Nat → Nat
ch-mul zero    _ = zero
ch-mul (suc x) y = plus y (ch-mul x y)

ch-le-add-l : (c x y : Nat) → ch-le x y ≡ true → ch-le (plus c x) (plus c y) ≡ true
ch-le-add-l zero    _ _ h = h
ch-le-add-l (suc c) x y h = ch-le-add-l c x y h

ch-le-weak-z : (x : Nat) → ch-le (suc x) zero ≡ true → ch-le (suc x) (suc zero) ≡ true
ch-le-weak-z zero    _ = refl
ch-le-weak-z (suc _) h = h

ch-le-weak : (x y : Nat) → ch-le x y ≡ true → ch-le x (suc y) ≡ true
ch-le-weak zero    _       _ = refl
ch-le-weak (suc x) zero    h = ch-le-weak-z x h
ch-le-weak (suc x) (suc y) h = ch-le-weak x y h

ch-le-plus-l : (d x y : Nat) → ch-le x y ≡ true → ch-le x (plus d y) ≡ true
ch-le-plus-l zero    _ _ h = h
ch-le-plus-l (suc d) x y h = ch-le-weak x (plus d y) (ch-le-plus-l d x y h)

ch-lem-tail :
  (s k : Nat) →
  ch-le (suc (suc (suc k))) (ch-mul (suc k) (suc (suc (suc s)))) ≡ true
ch-lem-tail _ zero    = refl
ch-lem-tail s (suc k) =
  let rhs = the Nat (ch-mul (suc k) (suc (suc (suc s))))
      ih  = ch-lem-tail s k
  in ch-le-weak (suc (suc (suc k))) (suc (plus s rhs))
       (ch-le-weak (suc (suc (suc k))) (plus s rhs)
         (ch-le-plus-l s (suc (suc (suc k))) rhs ih))

-- UNIVERSAL THEOREM 1 (`S + K < K * S` STRICT HYPERFACTORIZATION GAIN, 0 POSTULATES):
ch-thm-hyperfactor-strict :
  (s k : Nat) →
  let bigS = suc (suc (suc s))
      bigK = suc (suc k)
  in ch-le (plus bigS (suc bigK)) (ch-mul bigK bigS) ≡ true
ch-thm-hyperfactor-strict s k =
  ch-le-add-l (suc (suc (suc s))) (suc (suc (suc k)))
    (ch-mul (suc k) (suc (suc (suc s))))
    (ch-lem-tail s k)

