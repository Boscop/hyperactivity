ml-le-trans : (a b c : Nat) → ml-le a b ≡ true → ml-le b c ≡ true → ml-le a c ≡ true
ml-le-trans zero    b       c       h1 h2 = refl
ml-le-trans (suc a) zero    c       h1 h2 = Empty-rec (true≢false (λ i → h1 (~ i)))
ml-le-trans (suc a) (suc b) zero    h1 h2 = Empty-rec (true≢false (λ i → h2 (~ i)))
ml-le-trans (suc a) (suc b) (suc c) h1 h2 = ml-le-trans a b c h1 h2
