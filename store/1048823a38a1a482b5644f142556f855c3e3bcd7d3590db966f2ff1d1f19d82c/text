-- the table: from p, four bytes per token, each its record's place
si-tab : (n : Nat) → Bytes n → Word → Word → List (List Word) → Type
si-tab n B p o L = (case L return λ w → Word → Word → Type of
  nil → λ p o → Unit
  cons y r → λ p o → (si-rd4 n B p ≡ o) × rec r (wadd p #4) (si-next n B o)) p o
