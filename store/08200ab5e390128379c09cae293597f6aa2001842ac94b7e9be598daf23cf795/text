hxb-fmt : Word → HxbBook → Word → List Word
hxb-fmt n (hxb-bk b a e ad _) ms =
  list-append "OrderBook N=" (list-append (ce-dec n) (list-append " bid=" (list-append (ce-dec b)
  (list-append " ask=" (list-append (ce-dec a) (list-append " exec=" (list-append (ce-dec e)
  (list-append " adds=" (list-append (ce-dec ad) (list-append " (" (list-append (ce-dec ms) " ms)")))))))))))
