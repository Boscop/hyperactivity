sc-sv3 : List Word → List Word
sc-sv3 tail =
  hw-ln "// Parametric PSC-1 Supercomputer Compute+Router Tile (embeds kir-opt superoptimized ALU)"
  (hw-ln "module hx_supercomp_node #(parameter int DIM = 20) ("
  (hw-ln "  input  logic [DIM-1:0] cur_id, dst_id,"
  (hw-ln "  input  logic [31:0]    x0, x1, x2,"
  (hw-ln "  output logic           arrived,"
  (hw-ln "  output logic [DIM-1:0] next_id,"
  (hw-ln "  output logic [31:0]    y_ch, y_maj"
  (hw-ln ");"
  (hw-ln "  logic [$clog2(DIM)-1:0] dim_sel;"
  (hw-ln "  hx_dor_router #(.DIM(DIM)) u_dor (.cur_id(cur_id), .dst_id(dst_id), .arrived(arrived), .out_dim(dim_sel), .next_id(next_id));"
  (hw-ln (list-append "  assign y_ch  = " (list-append (kir-emit-expr "32'h0" "32'hFFFFFFFF" (kir-opt kir-ex-ch)) ";"))
  (hw-ln (list-append "  assign y_maj = " (list-append (kir-emit-expr "32'h0" "32'hFFFFFFFF" (kir-opt kir-ex-maj)) ";"))
  (hw-ln "endmodule" tail))))))))))))
