text-pass1-ok : (qids : List Word) → text-pass1-dec (text-pass1-enc qids) ≡ qids
text-pass1-ok qids =
  let ts0 = list-map mlit qids
      m = factor-motifs-auto 3 ts0
      s1 : expand-lam-auto (factor-lam-auto (snd m)) ≡ snd m
      s1 = factor-lam-auto-ok (snd m)
      s2 : expand-motifs-auto (fst m , expand-lam-auto (factor-lam-auto (snd m))) ≡ ts0
      s2 = concat {lzero} {List MTerm}
             {expand-motifs-auto (fst m , expand-lam-auto (factor-lam-auto (snd m)))}
             {expand-motifs-auto m} {ts0}
             (λ i → expand-motifs-auto (fst m , s1 i))
             (factor-motifs-auto-ok 3 ts0)
  in concat {lzero} {List Word}
       {list-map unmlit (expand-motifs-auto (fst m , expand-lam-auto (factor-lam-auto (snd m))))}
       {list-map unmlit ts0} {qids}
       (cong {lzero} {lzero} {List MTerm} {List Word} (list-map unmlit) s2)
       (codec-ok mlit-codec qids)
