-- UNIVERSAL PROOF 1: TRANSITIVITY OF <= OVER ALL Nat^3
hm-le-trans : (a b c : Nat) → hm-le a b ≡ true → hm-le b c ≡ true → hm-le a c ≡ true
hm-le-trans zero    _       _       _   _   = refl
hm-le-trans (suc _) zero    _       hab _   = Empty-rec (true≢false (web-sym-b hab))
hm-le-trans (suc _) (suc _) zero    _   hbc = Empty-rec (true≢false (web-sym-b hbc))
hm-le-trans (suc a) (suc b) (suc c) hab hbc = hm-le-trans a b c hab hbc
