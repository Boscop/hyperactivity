-- over both branches x2 = x ± 1 (one when x = 0)
hop-total-sq : List Bool → List Bool → List Bool → List Bool → List Bool → List Bool → List Bool × List Bool
hop-total-sq x v2 k kt w2 m = if bin-null x then hop-branch-sq (nil , bin-one) x (bin-add x bin-one) v2 k kt w2 m
  else hop-branch-sq (hop-branch-sq (nil , bin-one) x (bin-add x bin-one) v2 k kt w2 m) x (bin-sub x bin-one) v2 k kt w2 m
