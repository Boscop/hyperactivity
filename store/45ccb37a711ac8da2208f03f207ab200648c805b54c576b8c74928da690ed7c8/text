-- writing one wire leaves the reading of every other wire as it was: the two names are walked
-- together, and where they part the write is in the other branch
nk-get-set-other : (sl : NkSlots) (w x : NkW) (s : NkSlot) → (nk-weq w x ≡ false) → nk-get (nk-set sl w s) x ≡ nk-get sl x
nk-get-set-other nksl-nil w-end w-end s q = nk-no (sym q)
nk-get-set-other nksl-nil (w-0 r) (w-0 y) s q = nk-get-set-other nksl-nil r y s q
nk-get-set-other nksl-nil (w-1 r) (w-1 y) s q = nk-get-set-other nksl-nil r y s q
nk-get-set-other nksl-nil w-end (w-0 y) s q = refl
nk-get-set-other nksl-nil w-end (w-1 y) s q = refl
nk-get-set-other nksl-nil (w-0 r) w-end s q = refl
nk-get-set-other nksl-nil (w-0 r) (w-1 y) s q = refl
nk-get-set-other nksl-nil (w-1 r) w-end s q = refl
nk-get-set-other nksl-nil (w-1 r) (w-0 y) s q = refl
nk-get-set-other (nksl-node t a b) w-end w-end s q = nk-no (sym q)
nk-get-set-other (nksl-node t a b) (w-0 r) (w-0 y) s q = nk-get-set-other a r y s q
nk-get-set-other (nksl-node t a b) (w-1 r) (w-1 y) s q = nk-get-set-other b r y s q
nk-get-set-other (nksl-node t a b) w-end (w-0 y) s q = refl
nk-get-set-other (nksl-node t a b) w-end (w-1 y) s q = refl
nk-get-set-other (nksl-node t a b) (w-0 r) w-end s q = refl
nk-get-set-other (nksl-node t a b) (w-0 r) (w-1 y) s q = refl
nk-get-set-other (nksl-node t a b) (w-1 r) w-end s q = refl
nk-get-set-other (nksl-node t a b) (w-1 r) (w-0 y) s q = refl
