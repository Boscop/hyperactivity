-- an entry added into a canonical list: summed with the entry of the same exponents, kept in order, dropped at zero
p-insert : PRad → List PRad → List PRad
p-insert x rs = case rs of
  nil → (if sq-nz (snd x) then cons x nil else nil)
  cons r rest → (if exp-eq (fst x) (fst r) then (if sq-nz (sq-plus (snd x) (snd r)) then cons (fst r , sq-plus (snd x) (snd r)) rest else rest)
    else (if nats-lt (fst x) (fst r) then (if sq-nz (snd x) then cons x rs else rs) else cons r (p-insert x rest)))
