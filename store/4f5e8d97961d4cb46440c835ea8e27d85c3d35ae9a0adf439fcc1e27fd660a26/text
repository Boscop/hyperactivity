cm-ltw-shift : (c r f : Word) → ltw r f ≡ true → ltw (wadd c r) (wadd c f) ≡ true
cm-ltw-shift c r f h =
  %welimP (λ v → ltw (wadd v r) (wadd v f) ≡ true) c
    (cm-catb (cm-congb (λ z → ltw z (wadd #0 f)) (cm-wadd-zero-l r))
      (cm-catb (cm-congb (λ z → ltw r z) (cm-wadd-zero-l f)) h))
    (λ k ih → cm-ltw-shift-step k r f ih)
