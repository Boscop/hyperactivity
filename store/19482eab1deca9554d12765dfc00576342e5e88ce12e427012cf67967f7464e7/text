-- 10 chunks per circle shifted by +π/10 (3142) so seams fall strictly between crossings (zero whiskers!)
hopf-fiber-chunks : Nat → Word → SInt → SInt → SInt → List HArc
hopf-fiber-chunks zero c cEta sEta xi2 = nil
hopf-fiber-chunks (suc rem) c cEta sEta xi2 =
  let t0 = si-sub (si-add (sp (wquot (wmul fx-two-pi c) #10)) (sp #3142)) (sp #450)
      t1 = si-add (si-add (sp (wquot (wmul fx-two-pi (%wsucc c)) #10)) (sp #3142)) (sp #450)
      pts = hopf-sample-pts 13 #12 #0 cEta sEta t0 (si-sub t1 t0) xi2
  in cons (harc (hpts-z-avg pts) pts) (hopf-fiber-chunks rem (%wsucc c) cEta sEta xi2)
