-- a body with the free variable named x made the bound variable at depth d
nk-abs : Word → Word → NkTm → NkTm
nk-abs x d (nk-free y) = if %weq x y then nk-var d else nk-free y
nk-abs x d (nk-lam b) = nk-lam (nk-abs x (%wsucc d) b)
nk-abs x d (nk-susp b) = nk-susp (nk-abs x d b)
nk-abs x d (nk-con c as) = nk-con c (nk-abs x d as)
nk-abs x d (nk-op h p as) = nk-op h (nk-abs x d p) (nk-abs x d as)
nk-abs x d (nk-match h p cs) = nk-match h (nk-abs x d p) (nk-abs x d cs)
nk-abs x d (nk-cons t r) = nk-cons (nk-abs x d t) (nk-abs x d r)
nk-abs x d t = t
