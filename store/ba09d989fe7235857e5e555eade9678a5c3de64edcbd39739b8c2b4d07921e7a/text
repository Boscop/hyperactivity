-- Master Tree Equivalence Theorem: ANY two trees with the same fringe evaluate identically!
atree-equiv : {A : Type} → (op : A → A → A) → ((x y z : A) → op (op x y) z ≡ op x (op y z)) →
  (t1 t2 : ATree A) → atree-norm t1 ≡ atree-norm t2 → atree-eval op t1 ≡ atree-eval op t2
atree-equiv op assoc t1 t2 h =
  concat (sym (atree-norm-sound op assoc t1))
    (concat (λ i → atree-eval op (h i)) (atree-norm-sound op assoc t2))
