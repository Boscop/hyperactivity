-- THE SUPEROPTIMIZER `kir-opt`: runs MC=1 Ch/Maj + ANF + constant-fold + self-XOR/AND cancellation!
kir-opt : WExpr → WExpr
kir-opt (we-k b)       = we-k b
kir-opt (we-v i)       = we-v i
kir-opt (we-not a)     = kir-mk-xor (kir-opt a) (we-k true)
kir-opt (we-xor a b)   = kir-mk-xor (kir-opt a) (kir-opt b)
kir-opt (we-and a b)   = kir-mk-and (kir-opt a) (kir-opt b)
kir-opt (we-or  a b)   = let a' = kir-opt a in let b' = kir-opt b in we-xor (we-xor a' b') (we-and a' b')
kir-opt (we-ch  e f g) = let e' = kir-opt e in let f' = kir-opt f in let g' = kir-opt g in we-xor g' (we-and e' (we-xor f' g'))
kir-opt (we-maj a b c) = let a' = kir-opt a in let b' = kir-opt b in let c' = kir-opt c in we-xor a' (we-and (we-xor a' b') (we-xor a' c'))
