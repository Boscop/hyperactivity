sy-nzc-map : (A X Y : Type) → (z : A) → (isz : A → Bool) → (g : X → Y) → (xs : List X) → (cs : List A) → sy-nzc A Y z isz cs (ln-map X Y g xs) ≡ sy-nzc A X z isz cs xs
sy-nzc-map A X Y z isz g xs cs = (case xs return λ w → (cs2 : List A) → sy-nzc A Y z isz cs2 (ln-map X Y g w) ≡ sy-nzc A X z isz cs2 w of
  nil → λ cs2 → λ i → false
  cons x xr → λ cs2 → λ i → if isz (cl-hd A z cs2) then sy-nzc-map A X Y z isz g xr (cl-tl A cs2) i else true) cs
