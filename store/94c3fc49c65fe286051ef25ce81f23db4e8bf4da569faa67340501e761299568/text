-- the versions record (store/versions/HEX): a line "HASH TIME" each time what a name or path points to
-- moved; a write that leaves it where it was adds nothing
hy-versions-next : List Word → List Word → List Word → List Word
hy-versions-next old h t = if h-eq (h-before " " (hy-last-of (h-lines old))) h then old else list-append old (h-line (h-concat (cons h (cons " " (cons t nil)))))
