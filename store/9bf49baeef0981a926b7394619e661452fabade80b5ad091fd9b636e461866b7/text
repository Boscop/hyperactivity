msort-fuel-count : {o : Ord} → (a : El o) → (f : Nat) → (l : List (El o)) → count a (msort-fuel f l) ≡ count a l
msort-fuel-count a f =
  case f return λ w → (l : List (El o)) → count a (msort-fuel w l) ≡ count a l of
    zero → λ l → ins-sort-count a l
    suc f1 →
      λ l →
        case l return λ v → count a (msort-fuel (suc f1) v) ≡ count a v of
          nil → λ i → zero
          cons x r →
            case r return λ u → count a (msort-fuel (suc f1) (cons x u)) ≡ count a (cons x u) of
              nil → λ i → count a (cons x nil)
              cons y r2 →
                transN
                  (merge-count a (msort-fuel f1 (fst (halves (cons x (cons y r2))))) (msort-fuel f1 (snd (halves (cons x (cons y r2))))))
                  (transN
                     (cong2N plus (rec f1 (fst (halves (cons x (cons y r2))))) (rec f1 (snd (halves (cons x (cons y r2))))))
                     (halves-count a (cons x (cons y r2))))
