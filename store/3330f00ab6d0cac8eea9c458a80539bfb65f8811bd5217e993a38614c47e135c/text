cs-fst-pair-sound : (k j : Nat) (fns : CsFns) (ars : Lst (Word × Word)) (hp hp0 : CsHeap) (env : CsEnv) (d : Word) (p : Code) (va vb : CsVal) →
  (cs-eval k fns hp env (cs-compile j ars d p) ≡ cs-hy-con hp0 #0 (lcons va (lcons vb lnil))) →
  cs-eval (suc k) fns hp env (cs-compile (suc j) ars d (cfst p))
  ≡ cso-ok (fst (cs-alloc hp0 (lcons (csv-word #0) (lcons va (lcons vb lnil))))) va
cs-fst-pair-sound k j fns ars hp hp0 env d p va vb hp_eq =
  let blk = lcons (csv-word #0) (lcons va (lcons vb lnil))
      hp1 = fst (cs-alloc hp0 blk)
  in cong (λ r → cs-bind-res r (λ h1 v1 → cs-load-res h1 v1 (suc zero))) hp_eq
     ∙ cong (λ o → cs-bind-opt o (λ v → cso-ok hp1 v)) (cs-alloc-load-self hp0 blk (suc zero))
