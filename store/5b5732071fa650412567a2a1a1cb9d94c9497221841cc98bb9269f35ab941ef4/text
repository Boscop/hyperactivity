psc-wasm-bytes : List Word
psc-wasm-bytes =
  let hdr  = the (List Word) (cons #0 (cons #97 (cons #115 (cons #109 (cons #1 (cons #0 (cons #0 (cons #0 nil))))))))
      tSec = pw-sec #1 (the (List Word)
               (cons #2
               (cons #96 (cons #4 (cons #127 (cons #127 (cons #127 (cons #127 (cons #1 (cons #127
               (cons #96 (cons #2 (cons #127 (cons #127 (cons #1 (cons #127 nil))))))))))))))))
      fSec = pw-sec #3 (the (List Word) (cons #4 (cons #0 (cons #1 (cons #1 (cons #1 nil))))))
      eSec = pw-sec #7 (cons #4 (pw-cat (cons (pw-exp "bf16_unpack" #0)
                                        (cons (pw-exp "bf16_mul_fp32" #1)
                                        (cons (pw-exp "fiber_xor" #2)
                                        (cons (pw-exp "fiber_and" #3) nil))))))
      cSec = pw-sec #10 (cons #4 (pw-cat (cons (pw-wrap-fn pw-f0)
                                         (cons (pw-wrap-fn pw-f1)
                                         (cons (pw-wrap-fn pw-f2)
                                         (cons (pw-wrap-fn pw-f3) nil))))))
  in pw-cat (cons hdr (cons tSec (cons fSec (cons eSec (cons cSec nil)))))
