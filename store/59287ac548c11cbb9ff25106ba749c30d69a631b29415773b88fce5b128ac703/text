macho-build-plan : Word → BPlan
macho-build-plan g =
  let Tc = opt-or (def-type-code g) cword
  in if c-not (is-step-w Tc) then (not-fo dep-type (cglob g) , (false , lnil)) else
     (case unfold g return (λ _ → BPlan) of
        none → (not-fo reflect (cglob g) , (false , lnil))
        some c → macho-build-plan-at g Tc c)
