ce-cli-call : (Code → List Word → List Word) → Word → Lst Code → (List Word → List Word) → List Word → List Word
ce-cli-call pr g lnil val acc = list-append "g" (list-append (ce-dec g) (list-append "(" (val (list-append ")" acc))))
ce-cli-call pr g as val acc = list-append "g" (list-append (ce-dec g) (list-append "(" (ce-args pr as true (list-append ", " (val (list-append ")" acc))))))
