-- transport of the pair (3, λx. inc x) along the constant line of Σ N (λ_. N → N) computes, by the
-- pair clause and then the number and function clauses, to that pair (part of machine-in-hyperactive)
nk-kan-pair : nk-norm (nk-transp (nk-lam (nk-sig nk-N (nk-lam (nk-pi nk-N (nk-lam nk-N))))) nk-i0 (nk-mkpair (nk-num #3) (nk-lam (nk-inc (nk-var #0))))) ≡ nk-mkpair (nk-num #3) (nk-lam (nk-inc (nk-var #0)))
nk-kan-pair = refl
