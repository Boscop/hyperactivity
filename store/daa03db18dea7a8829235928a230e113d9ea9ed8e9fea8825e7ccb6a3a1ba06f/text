bn-sha256 : List Word → List Word
bn-sha256 msg =
  let lenB = fromNat (list-length msg)
      rem  = %wmod (%wadd lenB #1) #64
      zpad = if eth-le rem #56 then %wsub #56 rem else %wsub #120 rem
      pad  = list-append msg (cons #128 (list-append (bn-zeros (toNat zpad)) (bn-be64-bytes (%wmul lenB #8))))
      nblk = %wdiv (fromNat (list-length pad)) #64
      fin  = bn-s256-blocks (toNat nblk) pad bn-sha256-iv
  in h-concat
       (cons (bn-be32-bytes (bn-nth-w #0 fin))
       (cons (bn-be32-bytes (bn-nth-w #1 fin))
       (cons (bn-be32-bytes (bn-nth-w #2 fin))
       (cons (bn-be32-bytes (bn-nth-w #3 fin))
       (cons (bn-be32-bytes (bn-nth-w #4 fin))
       (cons (bn-be32-bytes (bn-nth-w #5 fin))
       (cons (bn-be32-bytes (bn-nth-w #6 fin))
       (cons (bn-be32-bytes (bn-nth-w #7 fin)) nil))))))))
