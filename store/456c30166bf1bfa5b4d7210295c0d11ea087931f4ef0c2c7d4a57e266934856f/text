-- THE VALUE IS INJECTIVE: two members of the carrier with the same integer value are equal
zr-inj : (a b : ZrC) → zeq (zr-val a) (zr-val b) → a ≡ b
zr-inj a = case a return λ u → (b : ZrC) → zeq (zr-val u) (zr-val b) → u ≡ b of
  zrz → λ b → (case b return λ w → zeq (zr-val zrz) (zr-val w) → zrz ≡ w of
    zrz → λ h → λ i → zrz
    zrp q → λ h → zr-s0 (zrz ≡ zrp q) q zero (λ i → h (~ i))
    zrn q → λ h → zr-s0 (zrz ≡ zrn q) q zero (cl-tr Nat (plus (zr-pn q) zero) (zr-pn q) zero (plus-zero (zr-pn q)) h))
  zrp p → λ b → (case b return λ w → zeq (zr-val (zrp p)) (zr-val w) → zrp p ≡ w of
    zrz → λ h → zr-s0 (zrp p ≡ zrz) p zero h
    zrp q → λ h → λ i → zrp (zr-pn-inj p q (cl-tr Nat (zr-pn p) (plus (zr-pn p) zero) (zr-pn q) (λ j → plus-zero (zr-pn p) (~ j)) (cl-tr Nat (plus (zr-pn p) zero) (plus (zr-pn q) zero) (zr-pn q) h (plus-zero (zr-pn q)))) i)
    zrn q → λ h → zr-s0 (zrp p ≡ zrn q) p (zr-pn q) h)
  zrn p → λ b → (case b return λ w → zeq (zr-val (zrn p)) (zr-val w) → zrn p ≡ w of
    zrz → λ h → zr-s0 (zrn p ≡ zrz) p zero (cl-tr Nat (plus (zr-pn p) zero) (zr-pn p) zero (plus-zero (zr-pn p)) (λ i → h (~ i)))
    zrp q → λ h → zr-s0 (zrn p ≡ zrp q) q (zr-pn p) (λ i → h (~ i))
    zrn q → λ h → λ i → zrn (zr-pn-inj p q (λ j → h (~ j)) i))
