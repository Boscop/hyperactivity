sg-read-file : Word → List Word → Proc W (Opt (List Word))
sg-read-file buf path =
  bind (sg-write-buf buf path) (λ _ →
  bind (sys-call #2 buf #0 #0 #0 #0 #0) (λ fd →
    if sg-sys-err fd then ret {lzero} {W} none
    else
      bind (sg-read-chunks (toNat #64) fd buf nil) (λ acc →
      bind (sys-call #3 fd #0 #0 #0 #0 #0) (λ _ →
      ret {lzero} {W} (some (sg-rev-w acc nil))))))
