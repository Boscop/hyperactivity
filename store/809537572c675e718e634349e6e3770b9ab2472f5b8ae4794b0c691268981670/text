bn-b64-val : Word → Word
bn-b64-val c =
  if andB (eth-le #65 c) (eth-le c #90) then %wsub c #65
  else if andB (eth-le #97 c) (eth-le c #122) then %wadd #26 (%wsub c #97)
  else if andB (eth-le #48 c) (eth-le c #57) then %wadd #52 (%wsub c #48)
  else if orB (%weq c #43) (%weq c #45) then #62
  else if orB (%weq c #47) (%weq c #95) then #63
  else if %weq c #61 then #64
  else #65
