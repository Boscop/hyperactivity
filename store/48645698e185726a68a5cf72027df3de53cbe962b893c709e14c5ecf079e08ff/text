-- UNIVERSAL SUPEROPTIMIZER SOUNDNESS OVER ALL WExpr & ALL ENVIRONMENTS!
kir-opt-sound : (e : WExpr) → WEdge e (kir-opt e)
kir-opt-sound (we-k _) env = refl
kir-opt-sound (we-v _) env = refl
kir-opt-sound (we-not a) env =
  web-trans-b
    (web-trans-b (λ k → web-notB (kir-opt-sound a env k)) (web-lem-not-xor (weval env (kir-opt a))))
    (kir-lem-xor-c env (kir-opt a) (we-k true) (kir-eq (kir-opt a) (we-k true)) refl)
kir-opt-sound (we-xor a b) env =
  web-trans-b
    (λ k → web-xorB (kir-opt-sound a env k) (kir-opt-sound b env k))
    (kir-lem-xor-c env (kir-opt a) (kir-opt b) (kir-eq (kir-opt a) (kir-opt b)) refl)
kir-opt-sound (we-and a b) env =
  web-trans-b
    (λ k → web-andB (kir-opt-sound a env k) (kir-opt-sound b env k))
    (kir-lem-and-c env (kir-opt a) (kir-opt b) (kir-eq (kir-opt a) (kir-opt b)) refl)
kir-opt-sound (we-or a b) env =
  web-trans-b (λ k → web-orB (kir-opt-sound a env k) (kir-opt-sound b env k)) (web-lem-or-anf (weval env (kir-opt a)) (weval env (kir-opt b)))
kir-opt-sound (we-ch e f g) env =
  web-trans-b (λ k → web-chB (kir-opt-sound e env k) (kir-opt-sound f env k) (kir-opt-sound g env k)) (web-lem-ch-mc1 (weval env (kir-opt e)) (weval env (kir-opt f)) (weval env (kir-opt g)))
kir-opt-sound (we-maj a b c) env =
  web-trans-b (λ k → web-majB (kir-opt-sound a env k) (kir-opt-sound b env k) (kir-opt-sound c env k)) (web-lem-maj-mc1 (weval env (kir-opt a)) (weval env (kir-opt b)) (weval env (kir-opt c)))
