mundiff-mdiff : (B p x : Word) → wlt p B ≡ true → wlt x B ≡ true → mundiff-val B p (mdiff-val B p x) ≡ x
mundiff-mdiff B p x hp hx =
  ifP {λ b → mundiff-val B p (if b then wsub (wadd x B) p else wsub x p) ≡ x} {wlt x p}
    (λ e →
       let hle : wlt (wadd x B) p ≡ false
           hle = cm-le-trans p B (wadd x B) (cm-lt-asym p B hp) (cm-le-add-r x B)
           eq1 : wadd p (wsub (wadd x B) p) ≡ wadd x B
           eq1 = cm-wadd-sub-le (wadd x B) p hle
           eq2 : wlt (wadd p (wsub (wadd x B) p)) B ≡ false
           eq2 = cm-catb (cm-congb (λ z → wlt z B) eq1) (cm-le-add-r x B)
       in catw (cm-ifw (wadd p (wsub (wadd x B) p)) (wsub (wadd p (wsub (wadd x B) p)) B) eq2)
            (catw (congw (λ z → wsub z B) eq1) (cm-wsub-add-r B x)))
    (λ e →
       let eq1 : wadd p (wsub x p) ≡ x
           eq1 = cm-wadd-sub-le x p e
           eq2 : wlt (wadd p (wsub x p)) B ≡ true
           eq2 = cm-catb (cm-congb (λ z → wlt z B) eq1) hx
       in catw (cm-ifw (wadd p (wsub x p)) (wsub (wadd p (wsub x p)) B) eq2) eq1)
