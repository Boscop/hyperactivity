-- what the table said, done: clause for clause nk-fire
nk-ev-fire : (NkEvJ → NkEv) → NkAct → Word → NkTm → NkEv → NkEv → NkEv
nk-ev-fire r (act-ap t) h cs aux v = r (nkevj-tm t (nk-ev-app aux (nk-ev-parts v)))
nk-ev-fire r (act-rp t) h cs aux v = r (nkevj-tm t (nk-ev-app (nk-ev-rev (nk-ev-parts v) nkev-nil) aux))
nk-ev-fire r (act-self t) h cs aux v = r (nkevj-tm t (nkev-cons v aux))
nk-ev-fire r (act-hd g) h cs aux v = nkev g nkev-nil
nk-ev-fire r act-none h cs aux v = if nk-blocked (nk-ev-hd v) then nk-ev-stuck r h cs aux v else nkev-nil
nk-ev-fire r act-stuck h cs aux v = nk-ev-stuck r h cs aux v
