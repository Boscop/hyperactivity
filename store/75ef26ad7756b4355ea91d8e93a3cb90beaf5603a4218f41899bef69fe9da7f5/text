-- Parametric Calma GDSII `AREF` (`0x0B00` = #2816, `COLROW` `cols × rows`)
gds6-aref-grid : Word → List Word → Word → Word → Word → Word → Word → Word → List Word
gds6-aref-grid snameRecLen paddedName cols rows x0 y0 xColEnd yRowEnd =
  sv-concat
    (cons (gds-u16s (cons #4 (cons #2816 nil)))
    (cons (gds-u16s (cons snameRecLen (cons #4614 nil)))
    (cons paddedName
    (cons (gds-u16s (cons #8 (cons #4866 (cons cols (cons rows nil)))))
    (cons (gds-u16s (cons #28 (cons gds-rec-xy nil)))
    (cons (gds-u32s (cons x0 (cons y0 (cons xColEnd (cons y0 (cons x0 (cons yRowEnd nil)))))))
    (cons (gds-u16s (cons #4 (cons gds-rec-endel nil))) nil)))))))
