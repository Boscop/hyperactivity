  bind (s-isolated (bind (s-paper st m) (λ p → ret {lzero} {W} unit))) (λ okp →
  bind (s-isolated (bind (s-site-kept st "paper-pdf" s-paper-pdf) (λ pdf → ret {lzero} {W} unit))) (λ okpdf →
  bind (s-isolated (bind (s-site-kept st "pdf-view" s-pdf-view) (λ pv → ret {lzero} {W} unit))) (λ okpv →
  bind (s-isolated (bind (s-site-kept st "nets" s-nets) (λ nt → ret {lzero} {W} unit))) (λ okn →
  bind (s-isolated (bind (s-site-kept st "neuro" s-neuro) (λ nr → ret {lzero} {W} unit))) (λ oknr →
  bind (s-isolated (bind (s-site-kept st "physics" s-physics) (λ ph → ret {lzero} {W} unit))) (λ okph →
  bind (s-isolated (bind (s-site-kept st "ai" s-ai) (λ ai → ret {lzero} {W} unit))) (λ okai →
  bind (s-isolated (bind (s-site-kept st "music" s-music) (λ ms → ret {lzero} {W} unit))) (λ okm →
  bind (s-site-all st s-published) (λ u →
  bind (s-isolated (bind (s-corpus-kept-one st "/paper") (λ c → ret {lzero} {W} unit))) (λ okc →
  bind (s-isolated (bind (s-site-kept st "synesthesia" (ret {lzero} {W} (sy-answer nil))) (λ y → ret {lzero} {W} unit))) (λ oky →
  bind (h-read (list-append h-index "/meta/root")) (λ s →
  bind (h-write (list-append st "/site-stamp") (s-or nil s)) (λ w → if w then exit #0 else exit #1)))))))))))))
