cf-frame-dec : List Word → Nat × (Word × List Word)
cf-frame-dec nil = (zero , (#0 , nil))
cf-frame-dec (cons tag rest) =
  if weq tag #0 then
    let r1 = pf-dec pf-nat rest
    in (fst r1 , (bytes-to-word-with (snd r1 , #0) , nil))
  else
    let r1 = pf-dec pf-nat rest
        r2 = pf-dec pf-word (snd r1)
        r3 = pf-dec (pf-list pf-word) (snd r2)
    in (fst r1 , (bytes-to-word-with (snd r3 , fst r2) , fst r3))
