-- a branch's fields read out of the block: field i of the value p<d> is variable v<d+i>
ce-binds : Nat → Word → Word → List Word
ce-binds zero d i = nil
ce-binds (suc k) d i = list-append "uint64_t v" (list-append (ce-dec (%wadd d i)) (list-append " = p" (list-append (ce-dec d) (list-append "[" (list-append (ce-dec (%wsucc i)) (list-append "]; " (ce-binds k d (%wsucc i))))))))
