-- Compositional N-bit ripple-carry adder executing cir-fa1-net bit-by-bit (288 NAND2 gates for 32-bit)
cir-add-bits : Nat → Word → Word → Word → Word → Word → Word × Word
cir-add-bits zero _ _ _ cin acc = (acc , cin)
cir-add-bits (suc k) bit a b cin acc =
  let ab = %wand (%wshr a bit) #1
      bb = %wand (%wshr b bit) #1
      sc = cir-fa1 ab bb cin
      acc2 = %wor acc (%wshl (fst sc) bit)
  in cir-add-bits k (%wsucc bit) a b (snd sc) acc2
