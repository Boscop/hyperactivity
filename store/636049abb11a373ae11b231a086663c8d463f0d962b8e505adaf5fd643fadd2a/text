lead-paragraphs-rest : Nat → List (List Word) → List (List Word)
lead-paragraphs-rest zero ls = ls
lead-paragraphs-rest (suc n) nil = nil
lead-paragraphs-rest (suc zero) (cons nil ls) = cons nil ls
lead-paragraphs-rest (suc (suc m)) (cons nil ls) = lead-paragraphs-rest (suc m) ls
lead-paragraphs-rest (suc n) (cons (cons x l) ls) = lead-paragraphs-rest (suc n) ls
