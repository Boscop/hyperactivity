-- what a change made worse, file by file (before , after): the checks that fail after and did not
-- before, or that the machine no longer reads the file to the end. A file it did not read to the end
-- before the change either (one that exceeds this machine's memory, say) is not made worse by it
hy-wrong : List (Bool × List (List Word)) → List (Bool × List (List Word)) → List (List Word)
hy-wrong nil a = nil
hy-wrong (cons b bs) nil = nil
hy-wrong (cons b bs) (cons a as) = list-append (if fst a then hy-subset (snd a) (snd b) else (if fst b then cons "(the machine did not read to the end)" nil else nil)) (hy-wrong bs as)
