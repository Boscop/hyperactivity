zr-dl : (c p q : ZrC) → zr-mu c (zr-ad p q) ≡ zr-ad (zr-mu c p) (zr-mu c q)
zr-dl c p q = zr-law (zr-mu c (zr-ad p q)) (zr-ad (zr-mu c p) (zr-mu c q)) (zmul (zr-val c) (zplus (zr-val p) (zr-val q))) (zplus (zmul (zr-val c) (zr-val p)) (zmul (zr-val c) (zr-val q)))
  (zr-tma c p q) (zr-pdl (zr-val c) (zr-val p) (zr-val q)) (zr-tam c p c q)
