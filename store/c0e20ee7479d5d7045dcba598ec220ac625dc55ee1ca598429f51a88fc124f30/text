cs-env-rel-mono-ov : (hp1 hp2 : CsHeap) (om : CsOptM) (ov : CsOptV) →
  cs-heap-ext hp1 hp2 →
  (cs-sim-ok om (cs-bind-ov ov (λ v → cso-ok hp1 v)) ≡ true) →
  cs-sim-ok om (cs-bind-ov ov (λ v → cso-ok hp2 v)) ≡ true
cs-env-rel-mono-ov hp1 hp2 csom-none ov ext hs = refl
cs-env-rel-mono-ov hp1 hp2 (csom-some mv) csov-none ext hs = cs-no hs
cs-env-rel-mono-ov hp1 hp2 (csom-some mv) (csov-some cv) ext hs =
  cs-val-rel-mono hp1 hp2 mv cv ext hs
