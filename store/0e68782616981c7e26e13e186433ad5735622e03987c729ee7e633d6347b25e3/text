premJ : (r : DRule) → RData r → JL
premJ r-var x = jl-nil
premJ r-app (x-app Γ a b R f c) =
  jl-cons q-hd (j-tm , Γ , s-pi a b , f , fmapM Γ (AppV a b) (TV (s-pi a b)) (app-f a b) R)
  (jl-cons q-arg (j-tm , Γ , a , c , fmapM Γ (AppV a b) (TV a) (app-a a b) R) jl-nil)
premJ r-fst (x-proj Γ a b R p) = jl-cons q-hd (j-tm , Γ , s-sig a b , p , R) jl-nil
premJ r-snd (x-proj Γ a b R p) = jl-cons q-hd (j-tm , Γ , s-sig a b , p , R) jl-nil
premJ r-case (x-case Γ s R cP x t f) =
  jl-cons q-arg (j-ty , ext-h Γ s-bool (CaseV s) (case-b s) R , s , cP , case-mot Γ s R)
  (jl-cons q-hd (j-tm , Γ , s-bool , x , fmapM Γ (CaseV s) (TV s-bool) (case-x s) R)
  (jl-cons q-arg (j-tm , Γ , s , t , fmapM Γ (CaseV s) (TV s) (case-t s) R)
  (jl-cons q-arg (j-tm , Γ , s , f , fmapM Γ (CaseV s) (TV s) (case-f s) R) jl-nil)))
premJ r-ne (x-ne Γ R c) = jl-cons q-ne (j-tm , Γ , s-bool , c , R) jl-nil
premJ (r-con b) x = jl-nil
premJ r-lam (x-lam Γ a b X cA c) =
  jl-cons q-arg (j-ty , Γ , a , cA , fmapM Γ (TV (s-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) X)
  (jl-cons q-arg (j-tm , lam-ctx Γ a b X , b , c , lam-body Γ a b X) jl-nil)
premJ r-pair (x-pair Γ a b R cB c1 c2) =
  jl-cons q-arg (j-ty , ext-h Γ a (TV (s-sig a b)) (λ q → fam-dom a b (fst q)) R , b , cB , pair-cod Γ a b R)
  (jl-cons q-arg (j-tm , Γ , a , c1 , fmapM Γ (TV (s-sig a b)) (TV a) (sig-1 a b) R)
  (jl-cons q-arg (j-tm , Γ , b , c2 , fmapM Γ (TV (s-sig a b)) (TV b) (sig-2 a b) R) jl-nil))
premJ r-plam (x-pc Γ a X c) = jl-cons q-arg (j-tm , dext Γ , a , c , plam-body Γ a X) jl-nil
premJ r-papp (x-papp Γ a P p f cf nc Y y) = jl-cons q-hd (j-tm , Γ , s-path a , p , P) jl-nil
premJ (r-pend b) (x-pc Γ a P c) = jl-cons q-hd (j-tm , Γ , s-path a , c , P) jl-nil
premJ r-ty-bool x = jl-nil
premJ (r-ty-fam fm) (x-fam Γ a b T cA cB) =
  jl-cons q-arg (j-ty , Γ , a , cA , fmapM Γ (Fam a b) (Sem a) (fam-dom a b) T)
  (jl-cons q-arg (j-ty , ext-h Γ a (Fam a b) (fam-dom a b) T , b , cB , fam-body Γ a b T) jl-nil)
premJ r-ty-path (x-tp Γ a T cL c0 c1) =
  jl-cons q-arg (j-ty , dext Γ , a , cL , path-line-ty Γ a T)
  (jl-cons q-arg (j-tm , Γ , a , c0 , fmapM Γ (Sem (s-path a)) (TV a) (tend-0 a) T)
  (jl-cons q-arg (j-tm , Γ , a , c1 , fmapM Γ (Sem (s-path a)) (TV a) (tend-1 a) T) jl-nil))
