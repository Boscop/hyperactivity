bn-take-json-obj-go : Nat → Word → Bool → Bool → List Word → List Word × List Word
bn-take-json-obj-go zero    dep inQ esc bs          = (nil , bs)
bn-take-json-obj-go (suc f) dep inQ esc nil         = (nil , nil)
bn-take-json-obj-go (suc f) dep inQ esc (cons b bs) =
  if esc
  then let r = bn-take-json-obj-go f dep inQ false bs in (cons b (fst r) , snd r)
  else if inQ
  then if %weq b #92
       then let r = bn-take-json-obj-go f dep true true bs in (cons b (fst r) , snd r)
       else if %weq b #34
       then let r = bn-take-json-obj-go f dep false false bs in (cons b (fst r) , snd r)
       else let r = bn-take-json-obj-go f dep true false bs in (cons b (fst r) , snd r)
  else if %weq b #34
  then let r = bn-take-json-obj-go f dep true false bs in (cons b (fst r) , snd r)
  else if %weq b #123
  then let r = bn-take-json-obj-go f (%wadd dep #1) false false bs in (cons b (fst r) , snd r)
  else if %weq b #125
  then if %weq dep #1
       then (cons b nil , bs)
       else let r = bn-take-json-obj-go f (%wsub dep #1) false false bs in (cons b (fst r) , snd r)
  else if %weq dep #0
  then bn-take-json-obj-go f #0 false false bs
  else let r = bn-take-json-obj-go f dep false false bs in (cons b (fst r) , snd r)
