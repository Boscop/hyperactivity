data D : (G : Goal) → Type 1 where
  dnil : D (g-many tj-nil)
  dcons : (t₀ : Tag) (J₀ : Jdg) (ps₀ : TJL) → D (g-one t₀ J₀) → D (g-many ps₀) → D (g-many (tj-cons t₀ J₀ ps₀))
  drule : (r₀ : DRule) (t₀ : Tag) (x₀ : RData r₀) → isTrue (kallows (rkind r₀) t₀) → D (g-many (tagged t₀ (premJ r₀ x₀))) → D (g-one t₀ (concl r₀ x₀))
