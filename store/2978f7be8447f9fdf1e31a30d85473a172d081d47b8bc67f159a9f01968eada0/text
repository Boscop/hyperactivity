data TlTm : (GA : TlCtx × TlTy) → Type where
  tl-var : (g : TlCtx) (a : TlTy) → TlVar (g , a) → TlTm (g , a)
  tl-lit : (g : TlCtx) → Byte → TlTm (g , tl-byte)
  tl-tt : (g : TlCtx) → TlTm (g , tl-unit)
  tl-lam : (g : TlCtx) (a b : TlTy) → TlTm (tl-ext g a , b) → TlTm (g , tl-fun a b)
  tl-app : (g : TlCtx) (a b : TlTy) → TlTm (g , tl-fun a b) → TlTm (g , a) → TlTm (g , b)
  tl-pair : (g : TlCtx) (a b : TlTy) → TlTm (g , a) → TlTm (g , b) → TlTm (g , tl-prod a b)
  tl-fst : (g : TlCtx) (a b : TlTy) → TlTm (g , tl-prod a b) → TlTm (g , a)
  tl-snd : (g : TlCtx) (a b : TlTy) → TlTm (g , tl-prod a b) → TlTm (g , b)
  tl-inl : (g : TlCtx) (a b : TlTy) → TlTm (g , a) → TlTm (g , tl-sum a b)
  tl-inr : (g : TlCtx) (a b : TlTy) → TlTm (g , b) → TlTm (g , tl-sum a b)
  tl-case : (g : TlCtx) (a b c : TlTy) → TlTm (g , tl-sum a b) → TlTm (tl-ext g a , c) → TlTm (tl-ext g b , c) → TlTm (g , c)
