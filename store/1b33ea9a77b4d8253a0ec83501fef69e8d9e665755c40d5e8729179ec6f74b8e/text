ke-opt-rotr-sound : (env : Word → Word) → (a : KExpr) → (n : Word) → keval env (ke-rotr a n) ≡ keval env (ke-opt-rotr a n)
ke-opt-rotr-sound _ (ke-k _)      _ = refl
ke-opt-rotr-sound _ (ke-v _)      _ = refl
ke-opt-rotr-sound _ (ke-not _)    _ = refl
ke-opt-rotr-sound _ (ke-xor _ _)  _ = refl
ke-opt-rotr-sound _ (ke-and _ _)  _ = refl
ke-opt-rotr-sound _ (ke-or  _ _)  _ = refl
ke-opt-rotr-sound _ (ke-add _ _)  _ = refl
ke-opt-rotr-sound _ (ke-sub _ _)  _ = refl
ke-opt-rotr-sound _ (ke-mul _ _)  _ = refl
ke-opt-rotr-sound _ (ke-rotr _ _) _ = refl
ke-opt-rotr-sound _ (ke-ch _ _ _) _ = refl
ke-opt-rotr-sound _ (ke-maj _ _ _) _ = refl
