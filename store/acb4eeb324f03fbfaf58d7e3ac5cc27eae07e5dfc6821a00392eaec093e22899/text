-- §4.5 Contradicted Cubical Face Absorbs Any Universal Combinator Redex in 1 Step (Zero Heap Pop):
ucell-conflict-erases :
  (kA kB : UKind) → (tA tB a1 a2 b1 b2 : Word) →
  (cA cB : ClauseVec (toNat #4)) → (l : Nat) → (f0 f1 : Word) → (rest : List Word) →
  clause-ok (toNat #4) (clause-meet (toNat #4) cA cB) ≡ false →
  urewrite-pair (ucell kA tA cA a1 a2) (ucell kB tB cB b1 b2) l f0 f1 rest ≡ urw-erase2 a1 b1
ucell-conflict-erases kA kB tA tB a1 a2 b1 b2 cA cB l f0 f1 rest hBad =
  λ i →
    if hBad i
    then
      (case kA of
         uc-era → urw-erase2 b1 b2
         uc-con →
           (case kB of
              uc-era → urw-erase2 a1 a2
              uc-con → (if %weq tA tB then urw-annihilate (a1 , b1) (a2 , b2) else urw-commute4 (hpool (suc (suc (suc (suc l)))) rest))
              uc-dup → urw-commute4 (hpool (suc (suc (suc (suc l)))) rest))
         uc-dup →
           (case kB of
              uc-era → urw-erase2 a1 a2
              uc-con → urw-commute4 (hpool (suc (suc (suc (suc l)))) rest)
              uc-dup → (if %weq tA tB then urw-annihilate (a1 , b1) (a2 , b2) else urw-commute4 (hpool (suc (suc (suc (suc l)))) rest))))
    else urw-erase2 a1 b1
