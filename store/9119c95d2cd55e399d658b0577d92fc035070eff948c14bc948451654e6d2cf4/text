-- the parts of a value quoted one after another, then put back together
nk-gather : Word → NkK → NkTm → NkEnv → Word → Word → NkOut
nk-gather d k done nke-nil out n = nk-plan-of (nkf-val out (nkv (hd-q (nk-finish k (nk-rev done nk-nil))) nke-nil) nkf-nil) n
nk-gather d k done (nke-cons w r) out n = nk-plan-of (nkf-op w (nko-quote d n) (nkf-op n (nko-gather d k done r out) nkf-nil)) (%wsucc n)
