-- hy-fail-why: what the machine says about a failure, the indented lines that follow it (Avik,
-- 2026-11-21: "do not be guessing and checking where information may be received deterministically":
-- a refused write printed only the names) (part of language-implementation-remainder)
hy-fail-why : List (List Word) → List Word
hy-fail-why nil = nil
hy-fail-why (cons l r) = if h-prefix "   " l then list-append l (hy-fail-why r) else nil
