ms-metal-src : List Word
ms-metal-src =
  ms-ln "// hx_meta_inet.metal — Mechanically Lowered 4-Input GPU-Superoptimized Cubical INet VM"
  (ms-ln "#include <metal_stdlib>"
  (ms-ln "using namespace metal;"
  (mm-emit-list ms-all-circuits
  (ms-ln ""
  (ms-ln "// Local SRAM Interaction-Net Cell: 2-bit tag (0=ERA, 1=CON, 2=DUP, 3=NUM/ADD), 4-dim cubical face (f0,f1), aux ports (p1,p2)"
  (ms-ln "struct INetCell { uint8_t tag; uint8_t f0; uint8_t f1; uint8_t p1; uint8_t p2; uint32_t val; };"
  (ms-ln "struct ActPair  { uint8_t a; uint8_t b; };"
  (ms-ln ""
  (ms-ln "// WORKLOAD 1: Real Lafont + Cubical Graph Reducer across 65,536 parallel GPU tiles!"
  (ms-ln "// Every active-pair dispatch executes through our GPU-discovered 4-input NAND2 circuits!"
  (ms-ln "kernel void hx_meta_inet_reduce_graph("
  (ms-ln "  device uint32_t* out_val    [[buffer(0)]],"
  (ms-ln "  device uint32_t* out_rew    [[buffer(1)]],"
  (ms-ln "  device uint32_t* out_pruned [[buffer(2)]],"
  (ms-ln "  constant uint32_t& rounds   [[buffer(3)]],"
  (ms-ln "  uint gid [[thread_position_in_grid]])"
  (ms-ln "{"
  (ms-ln "  uint32_t x = gid & 255u;"
  (ms-ln "  uint32_t last_res = 0u, tot_rew = 0u, tot_prn = 0u;"
  (ms-ln "  for (uint r = 0; r < rounds; ++r) {"
  (ms-ln "    INetCell mem[20]; ActPair stk[16]; uint32_t sp = 0u, alloc = 10u, acc = 0u;"
  (ms-ln "    // Build real Cubical INet graph: DUP(CON(NUM(x), NUM(x+1))) + §4.5 contradicted-face dead branch + ERA!"
  (ms-ln "    mem[0] = {2, 0x0, 0x0, 2, 3, 0};     // DUP sharing root"
  (ms-ln "    mem[1] = {1, 0x0, 0x0, 4, 5, 0};     // CON(NUM(x), NUM(x+1))"
  (ms-ln "    mem[2] = {1, 0x0, 0x0, 6, 7, 0};     // Consumer A (CON annihilator)"
  (ms-ln "    mem[3] = {1, 0x0, 0x0, 6, 7, 0};     // Consumer B (CON annihilator)"
  (ms-ln "    mem[4] = {3, 0x0, 0x0, 0, 0, x};     // NUM(x)"
  (ms-ln "    mem[5] = {3, 0x0, 0x0, 0, 0, x + 1}; // NUM(x+1)"
  (ms-ln "    mem[6] = {3, 0x0, 0x0, 0, 0, 0};     // ADD sink"
  (ms-ln "    mem[7] = {3, 0x0, 0x0, 0, 0, 0};     // ADD sink"
  (ms-ln "    // §4.5 Contradicted Cubical Face Active Pair: dim0=(i=0) vs dim0=(i=1) -> 1-cycle zero-alloc prune!"
  (ms-ln "    mem[8] = {1, 0x1, 0x0, 4, 5, 999};   // face i=0"
  (ms-ln "    mem[9] = {1, 0x0, 0x1, 4, 5, 999};   // face i=1 -> conflict!"
  (ms-ln "    stk[sp++] = {8, 9}; // contradicted cubical face redex"
  (ms-ln "    stk[sp++] = {0, 1}; // DUP x CON optimal-sharing commutation redex"
  (ms-ln "    while (sp > 0u) {"
  (ms-ln "      ActPair ap = stk[--sp];"
  (ms-ln "      INetCell ca = mem[ap.a], cb = mem[ap.b];"
  (ms-ln "      // 1-cycle GPU-superoptimized 4-input §4.5 Face Contradiction (6 NAND2!)"
  (ms-ln "      uint32_t fc_bits = opt_cub_face_conflict4(ca.f0, cb.f0, ca.f1, cb.f1) & 0xFu;"
  (ms-ln "      uint32_t conflict = (fc_bits != 0u) ? 1u : 0u;"
  (ms-ln "      // 1-cycle GPU-superoptimized 4-input ERA detector (7 NAND2!)"
  (ms-ln "      uint32_t is_era = opt_inet_era_either4(ca.tag & 1u, (ca.tag >> 1) & 1u, cb.tag & 1u, (cb.tag >> 1) & 1u) & 1u;"
  (ms-ln "      uint32_t pruned = conflict | is_era;"
  (ms-ln "      // 1-cycle GPU-superoptimized 4-input Commute (9 NAND2) & Annihilate (10 NAND2) dispatch!"
  (ms-ln "      uint32_t do_comm = opt_inet_commute4(1u, pruned, ca.tag & 1u, cb.tag & 1u) & 1u;"
  (ms-ln "      uint32_t do_ann  = opt_inet_annihilate4(1u, pruned, ca.tag & 1u, cb.tag & 1u) & 1u;"
  (ms-ln "      uint32_t t_neq   = opt_inet_tag_neq4(ca.tag & 1u, (ca.tag >> 1) & 1u, cb.tag & 1u, (cb.tag >> 1) & 1u) & 1u;"
  (ms-ln "      tot_rew++;"
  (ms-ln "      if (pruned) { tot_prn++; continue; }"
  (ms-ln "      if (do_comm && t_neq) {"
  (ms-ln "        // Real DUP x CON 4-node commutation: clone CON payload into both consumers!"
  (ms-ln "        uint8_t c0 = uint8_t(alloc++), c1 = uint8_t(alloc++);"
  (ms-ln "        mem[c0] = {1, uint8_t(ca.f0 | cb.f0), uint8_t(ca.f1 | cb.f1), cb.p1, cb.p2, 0};"
  (ms-ln "        mem[c1] = {1, uint8_t(ca.f0 | cb.f0), uint8_t(ca.f1 | cb.f1), cb.p1, cb.p2, 0};"
  (ms-ln "        stk[sp++] = {ca.p1, c0}; stk[sp++] = {ca.p2, c1};"
  (ms-ln "      } else if (do_ann && !t_neq) {"
  (ms-ln "        if (ca.tag == 1u) {"
  (ms-ln "          // Real CON x CON annihilation: wire auxiliary ports (p1<->p1, p2<->p2)!"
  (ms-ln "          stk[sp++] = {ca.p1, cb.p1}; stk[sp++] = {ca.p2, cb.p2};"
  (ms-ln "        } else if (ca.tag == 3u) {"
  (ms-ln "          // Real NUM x ADD fused arithmetic reduction!"
  (ms-ln "          acc += ca.val + cb.val;"
  (ms-ln "        }"
  (ms-ln "      }"
  (ms-ln "    }"
  (ms-ln "    last_res = acc;"
  (ms-ln "  }"
  (ms-ln "  out_val[gid] = last_res; out_rew[gid] = tot_rew; out_pruned[gid] = tot_prn;"
  (ms-ln "}"
  (ms-ln ""
  (ms-ln "// WORKLOAD 2: Real §4.5 Cubical Face-Pruning Parallel 8-Queens Solver (uses 6-NAND2 opt_cub_face_conflict4!)"
  (ms-ln "kernel void hx_meta_inet_nqueens8("
  (ms-ln "  device uint32_t* out_sols   [[buffer(0)]],"
  (ms-ln "  device uint32_t* out_checks [[buffer(1)]],"
  (ms-ln "  uint gid [[thread_position_in_grid]])"
  (ms-ln "{"
  (ms-ln "  // Iterative backtracking stack (0 recursion): encodes cols/diags as cubical face bits!"
  (ms-ln "  uint32_t col_stk[9], d1_stk[9], d2_stk[9], c_stk[9];"
  (ms-ln "  int row = 0; col_stk[0] = 0u; d1_stk[0] = 0u; d2_stk[0] = 0u; c_stk[0] = 0u;"
  (ms-ln "  uint32_t sols = 0u, checks = 0u;"
  (ms-ln "  while (row >= 0) {"
  (ms-ln "    uint32_t c = c_stk[row];"
  (ms-ln "    if (c >= 8u) { row--; continue; }"
  (ms-ln "    c_stk[row] = c + 1u;"
  (ms-ln "    uint32_t bit = 1u << c;"
  (ms-ln "    uint32_t busy = col_stk[row] | d1_stk[row] | d2_stk[row];"
  (ms-ln "    // §4.5 Cubical Face Conflict check via our GPU-discovered 6-NAND2 circuit!"
  (ms-ln "    uint32_t fc = opt_cub_face_conflict4(busy, 0u, bit, 0u) & 0xFFu;"
  (ms-ln "    checks++;"
  (ms-ln "    if (fc != 0u) continue; // 1-cycle §4.5 contradicted face dead-tree prune!"
  (ms-ln "    if (row == 7) { sols++; continue; }"
  (ms-ln "    col_stk[row+1] = col_stk[row] | bit;"
  (ms-ln "    d1_stk[row+1]  = (d1_stk[row] | bit) << 1;"
  (ms-ln "    d2_stk[row+1]  = (d2_stk[row] | bit) >> 1;"
  (ms-ln "    c_stk[row+1]   = 0u;"
  (ms-ln "    row++;"
  (ms-ln "  }"
  (ms-ln "  out_sols[gid] = sols; out_checks[gid] = checks;"
  (ms-ln "}" nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
