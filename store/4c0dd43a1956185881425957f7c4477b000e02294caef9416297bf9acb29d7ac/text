fd-rtl-specialized-eq : (keep : Nat → Bool) → (pkt : List Nat) → (out : FdFrame) →
  fd-rtl-specialized keep pkt out ≡ fd-filter-post keep (fd-rtl pkt out) out
fd-rtl-specialized-eq keep nil out = refl
fd-rtl-specialized-eq keep (cons b0 nil) out = refl
fd-rtl-specialized-eq keep (cons b0 (cons b1 nil)) out = refl
fd-rtl-specialized-eq keep (cons b0 (cons b1 (cons b2 nil))) out = refl
fd-rtl-specialized-eq keep (cons b0 (cons b1 (cons b2 (cons b3 payload)))) out =
  fd-spec-branch keep (plus b0 (times fd-256 b1)) (plus b2 (times fd-256 b3)) out
    (fd-ltb (list-length payload) (plus b2 (times fd-256 b3)))
