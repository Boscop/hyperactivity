-- 2. "Pseudoaddiction" Dose-Escalation Trap:
--    Answering inter-dose withdrawal with higher dose d ↦ d + Δ changes trough deficit by:
--      s(d + Δ) - s(d) = -(α - ρ)·Δ < 0  (strictly WORSE withdrawal at the next trough!).
--    Variables (0..3): d, Δ, ρ, α.
oxy-escalation-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
oxy-escalation-poly A ad mu q vs =
  (λ g sub →
    let d = g 0; del = g 1; rho = g 2; al = g 3
        z = q (fn-q 0 1)
        s0 = sub (mu rho d) (mu al d)
        s1 = sub (mu rho (ad d del)) (mu al (ad d del))
        lhs = sub s1 s0
        rhs = sub z (mu (sub al rho) del)
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
