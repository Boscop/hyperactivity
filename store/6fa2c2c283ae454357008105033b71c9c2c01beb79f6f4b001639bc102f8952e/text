cfs-dec-sym : Word → Nat → Nat → List Word → CtxState → SRState → Word × SRState
cfs-dec-sym L fuel zero excl st st0 = cfs-ground-dec L fuel excl st0
cfs-dec-sym L fuel (suc k) excl st st0 =
  case ftbl-exclude excl (cstate-fiber-at k st) of
    nil → cfs-dec-sym L fuel k excl st st0
    cons e r →
      let ft  = fiber-with-esc e r
          p   = sr-dec-step ft L fuel st0
          tag = fst p
          st1 = snd p
      in if weq tag #0 then cfs-dec-sym L fuel k (ftbl-add-syms (cons e r) excl) st st1
         else (wsub tag #1 , st1)
