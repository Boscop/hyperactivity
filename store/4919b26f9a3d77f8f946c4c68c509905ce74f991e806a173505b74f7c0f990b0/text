-- ============================================================================
-- SECTION 1: UNIVERSAL `< 50%` MACBOOK NEO COORDINATION-HUB CBF GOVERNOR
--   Hardware Envelope: 6 CPU cores (`#600` centi-cores), 8,192 MiB unified RAM.
--   Invariant: Swarm coordination tasks admit ONLY when `2 * used <= total`
--   on BOTH CPU load and active wired/compressed memory (`<= 50%` strictly!).
-- ============================================================================

nh-le-nat : Nat → Nat → Bool
nh-le-nat zero    y       = true
nh-le-nat (suc x) zero    = false
nh-le-nat (suc x) (suc y) = nh-le-nat x y

nh-double-nat : Nat → Nat
nh-double-nat zero    = zero
nh-double-nat (suc k) = suc (suc (nh-double-nat k))

nh-andB : Bool → Bool → Bool
nh-andB true  b = b
nh-andB false b = false

nh-false-elim : {A : Type} → false ≡ true → A
nh-false-elim p = Empty-rec (transport (λ i → if p i then Empty else Unit) unit)

nh-andB-fst : (a b : Bool) → nh-andB a b ≡ true → a ≡ true
nh-andB-fst true  b h = refl
nh-andB-fst false b h = nh-false-elim h

nh-andB-snd : (a b : Bool) → nh-andB a b ≡ true → b ≡ true
nh-andB-snd true  b h = h
nh-andB-snd false b h = nh-false-elim h

-- Strict `<= 50%` MacBook Neo Admission Gate over `(usedCpu, capCpu, usedMb, capMb)`:
nh-neo-admit : Nat → Nat → Nat → Nat → Bool
nh-neo-admit usedCpu capCpu usedMb capMb =
  nh-andB (nh-le-nat (nh-double-nat usedCpu) capCpu)
          (nh-le-nat (nh-double-nat usedMb)  capMb)

-- UNIVERSAL THEOREM 1A: Any admitted swarm task satisfies `2 * usedCpu <= capCpu` (`<= 50%` CPU)!
nh-thm-neo-50pct-cpu-bound :
  (uCpu cCpu uMb cMb : Nat) →
  nh-neo-admit uCpu cCpu uMb cMb ≡ true →
  nh-le-nat (nh-double-nat uCpu) cCpu ≡ true
nh-thm-neo-50pct-cpu-bound uCpu cCpu uMb cMb h =
  nh-andB-fst (nh-le-nat (nh-double-nat uCpu) cCpu) (nh-le-nat (nh-double-nat uMb) cMb) h

-- UNIVERSAL THEOREM 1B: Any admitted swarm task satisfies `2 * usedMb <= capMb` (`<= 50%` RAM)!
nh-thm-neo-50pct-ram-bound :
  (uCpu cCpu uMb cMb : Nat) →
  nh-neo-admit uCpu cCpu uMb cMb ≡ true →
  nh-le-nat (nh-double-nat uMb) cMb ≡ true
nh-thm-neo-50pct-ram-bound uCpu cCpu uMb cMb h =
  nh-andB-snd (nh-le-nat (nh-double-nat uCpu) cCpu) (nh-le-nat (nh-double-nat uMb) cMb) h

