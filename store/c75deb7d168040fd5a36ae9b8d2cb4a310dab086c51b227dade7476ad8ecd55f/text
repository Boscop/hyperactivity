-- Pack 16-bit PCM list into Word samples, Haar-lift to (s, d) byte streams, HXZ encode & verify!
pcm-bytes-to-s16 : List Word → List Word
pcm-bytes-to-s16 nil = nil
pcm-bytes-to-s16 (cons lo (cons hi r)) =
  let v = %wor lo (%wshl hi #8)
      -- sign-extend 16-bit to 32-bit two's-complement Word for exact Haar lifting
      s32 = if %wlt v #32768 then v else %wor v #4294901760
  in cons s32 (pcm-bytes-to-s16 r)
pcm-bytes-to-s16 (cons _ nil) = nil
