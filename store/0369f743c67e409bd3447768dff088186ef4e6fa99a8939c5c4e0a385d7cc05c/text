-- the final replica states are equal: the three stores are equal as functions, because the
-- applied writes are the same set (replica 1's list repeats one)
kvr-s01 : (a b c x : KvWrite) → InL {KvWrite} x (cons a (cons b (cons c nil))) → InL {KvWrite} x (cons a (cons b (cons c (cons c nil))))
kvr-s01 a b c x m = case m of
  inl e → inl e
  inr m2 → (case m2 of
    inl e → inr (inl e)
    inr m3 → (case m3 of
      inl e → inr (inr (inl e))
      inr m4 → Empty-rec m4))
