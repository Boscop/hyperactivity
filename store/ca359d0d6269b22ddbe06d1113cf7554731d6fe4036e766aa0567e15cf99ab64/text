q-emit-gate : QGate → List Word
q-emit-gate (qg-rz q k) = q-emit-rz q k
q-emit-gate (qg-h q) = sv-concat (cons "h q[" (cons (q-digit q) (cons "];" (cons sv-nl nil))))
q-emit-gate (qg-cnot c t) =
  sv-concat (cons "cx q[" (cons (q-digit c) (cons "], q[" (cons (q-digit t) (cons "];" (cons sv-nl nil))))))
