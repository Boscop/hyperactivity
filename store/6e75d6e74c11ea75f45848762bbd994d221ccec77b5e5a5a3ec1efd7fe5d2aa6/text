-- Shared-fanout DAG:
--   w0 (n10) = nand(n1, n3)     [env6: w0=0, n1=1, n2=2, n3=3, n6=4, n7=5]
--   w1 (n11) = nand(n3, n6)     [env7: w1=0, w0=1, n1=2, n2=3, n3=4, n6=5, n7=6]
--   w2 (n16) = nand(n2, w1)     [env8: w2=0, w1=1, w0=2, n1=3, n2=4, n3=5, n6=6, n7=7]
--   w3 (n19) = nand(w1, n7)     [env9: w3=0, w2=1, w1=2, w0=3, ...]
--   out false (n22) = nand(w0, w2)
--   out true  (n23) = nand(w2, w3)
c17-net : Net B0 Empty Unit Bool (toNat #5) (toNat #4)
c17-net =
  ( sc-nand (cwire (inl unit)) (cwire (inr (inr (inl unit))))
  , ( sc-nand (cwire (inr (inr (inr (inl unit))))) (cwire (inr (inr (inr (inr (inl unit))))))
    , ( sc-nand (cwire (inr (inr (inr (inl unit))))) (cwire (inl unit))
      , ( sc-nand (cwire (inr (inl unit))) (cwire (inr (inr (inr (inr (inr (inr (inr (inl unit)))))))))
        , (λ o → case o of
                   false → sc-nand (cwire (inr (inr (inr (inl unit))))) (cwire (inr (inl unit)))
                   true  → sc-nand (cwire (inr (inl unit))) (cwire (inl unit))) ) ) ) )
