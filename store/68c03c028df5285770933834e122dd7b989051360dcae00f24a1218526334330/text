-- When s ≥ L (wlt s L ≡ false), sr-refill-loop with any nonzero fuel is the identity
sr-refill-ge : (fuel : Nat) → (L s : Word) → (out : List Word) →
               wlt s L ≡ false →
               sr-refill-loop (suc fuel) L s out ≡ (s , out)
sr-refill-ge fuel L s out hge =
  λ i → if hge i then
          (case out of
            nil → (s , nil)
            cons b rest → sr-refill-loop fuel L (wadd (wmul s sr-base) b) rest)
        else (s , out)
