bn-lem-add : (env : Word) → (a b : INetExpr) →
  inet-eval env (bn-mk-add a b) ≡ bn-add64 (inet-eval env a) (inet-eval env b)
bn-lem-add env (in-lit a)        b = bn-lem-add2 env a b
bn-lem-add _   in-var0           _ = refl
bn-lem-add _   (in-dup-add _)    _ = refl
bn-lem-add _   (in-add _ _)      _ = refl
bn-lem-add _   (in-xor _ _)      _ = refl
bn-lem-add _   (in-era-l _ _)    _ = refl
bn-lem-add _   (in-lut3 _ _ _ _) _ = refl
