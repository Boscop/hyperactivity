val4-hom-2 b2-and false true = refl
val4-hom-2 b2-and true false = refl
val4-hom-2 b2-and true true = refl
val4-hom-2 b2-or false false = refl
val4-hom-2 b2-or false true = refl
val4-hom-2 b2-or true false = refl
val4-hom-2 b2-or true true = refl
val4-hom-2 b2-xor false false = refl
val4-hom-2 b2-xor false true = refl
val4-hom-2 b2-xor true false = refl
val4-hom-2 b2-xor true true = refl
