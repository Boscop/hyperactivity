-- an automorphism's inverse is one: the two relabellings exchanged, and preservation recovered by
-- reading the original's preservation at the relabelled atom and sliding along f (g x) ≡ x
auto-inv : (M : Mol) → Auto M → Auto M
auto-inv M a =
  ( auto-inv-fun M a
  , auto-fun M a
  , auto-fg M a
  , auto-gf M a
  , (λ x → concat (sym (auto-el M a (auto-inv-fun M a x))) (λ i → mol-el M (auto-fg M a x i)))
  , (λ x → λ y → concat (sym (auto-bd M a (auto-inv-fun M a x) (auto-inv-fun M a y))) (λ i → mol-bd M (auto-fg M a x i) (auto-fg M a y i))) )
