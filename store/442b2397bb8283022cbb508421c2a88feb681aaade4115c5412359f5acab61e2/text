-- a class of the unit; one the unit does not hold is a reader's error (the importer writes
-- every class a written declaration needs)
cx-find-rec : List CDecl → Word → MRes CRecord
cx-find-rec nil i = mstop st-ill-typed
cx-find-rec (cons d ds) i = case d of
  cd-record r → (case weq (cx-rec-id r) i of
    true → mok r
    false → cx-find-rec ds i)
  cd-class-template-specialization args r → (case weq (cx-rec-id r) i of
    true → mok r
    false → cx-find-rec ds i)
  _ → cx-find-rec ds i
