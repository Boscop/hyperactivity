-- 1. Symmetric 2-learner neural co-processor:
--    de_B/dt = -η_B e_B + γ e_C,   de_C/dt = γ e_B - η_C e_C,   V = (1/2)(e_B² + e_C²).
--    -dV/dt = η_B e_B² - 2 γ e_B e_C + η_C e_C².
--    Variables (0..4): η_B, η_C, γ, e_B, e_C.
--    Identity: η_B · (η_B e_B² - 2 γ e_B e_C + η_C e_C²) = (η_B e_B - γ e_C)² + (η_B η_C - γ²) e_C².
two-learner-sym-sos : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
two-learner-sym-sos A ad mu q vs =
  (λ g sub sq →
    let eb = g 0
        ec = g 1
        gm = g 2
        x  = g 3
        y  = g 4
        lhs = mu eb (ad (sub (mu eb (sq x)) (mu (q (fn-q 2 1)) (mu gm (mu x y)))) (mu ec (sq y)))
        rhs = ad (sq (sub (mu eb x) (mu gm y))) (mu (sub (mu eb ec) (sq gm)) (sq y))
    in (lhs , rhs))
  (λ i → al-nth A (q (fn-q 0 1)) i vs) (al-gsub A ad mu q) (al-gsq A mu)
