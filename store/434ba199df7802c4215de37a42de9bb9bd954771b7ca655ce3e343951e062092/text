-- Exact hardware node-count delta (encoded as +2 offset so non-negative: 0 => -2, 2 => 0, 4 => +2)
inet-rule-delta2 : INetKind → INetKind → Word
inet-rule-delta2 ik-con ik-con = #0   -- Annihilation: -2 nodes
inet-rule-delta2 ik-dup ik-dup = #0   -- Annihilation: -2 nodes
inet-rule-delta2 ik-era ik-era = #0   -- Double erase: -2 nodes
inet-rule-delta2 ik-era ik-con = #2   -- In-place erase: 0 net nodes (reuses both slots)
inet-rule-delta2 ik-con ik-era = #2   -- In-place erase: 0 net nodes
inet-rule-delta2 ik-era ik-dup = #2   -- In-place erase: 0 net nodes
inet-rule-delta2 ik-dup ik-era = #2   -- In-place erase: 0 net nodes
inet-rule-delta2 ik-con ik-dup = #4   -- Commutation diamond: +2 nodes (reuses 2 + allocates 2)
inet-rule-delta2 ik-dup ik-con = #4   -- Commutation diamond: +2 nodes
inet-rule-delta2 _      _      = #2   -- FREE: no-op
