-- Mouth & throat rings from exact circle table
hyp-ring-segs : SInt → SInt → Word → Cx → List Cx → List Seg3 → List Seg3
hyp-ring-segs x R sw first nil acc = acc
hyp-ring-segs x R sw first (cons a nil) acc =
  let p0 = proj-3d x (fx-mul R (fst a)) (fx-mul R (snd a))
      p1 = proj-3d x (fx-mul R (fst first)) (fx-mul R (snd first))
      zm = si-div-w (si-add (snd p0) (snd p1)) #2
  in cons (seg3 zm (fst (fst p0)) (snd (fst p0)) (fst (fst p1)) (snd (fst p1)) sw) acc
hyp-ring-segs x R sw first (cons a (cons b r)) acc =
  let p0 = proj-3d x (fx-mul R (fst a)) (fx-mul R (snd a))
      p1 = proj-3d x (fx-mul R (fst b)) (fx-mul R (snd b))
      zm = si-div-w (si-add (snd p0) (snd p1)) #2
      s = seg3 zm (fst (fst p0)) (snd (fst p0)) (fst (fst p1)) (snd (fst p1)) sw
  in hyp-ring-segs x R sw first (cons b r) (cons s acc)
