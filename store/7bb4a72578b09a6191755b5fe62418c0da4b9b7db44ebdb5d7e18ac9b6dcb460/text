-- the table: its first row the header, the rule dropped, the rest its body
s-table : List (List Word) → List Word
s-table nil = nil
s-table (cons h r) = h-concat (cons "<div class='table'><table><thead><tr>" (cons (s-row-cells "th" (s-cells h)) (cons "</tr></thead><tbody>" (cons (s-rows (s-no-rule r)) (cons "</tbody></table></div>" nil)))))
