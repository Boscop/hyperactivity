xp-sound-fst-t : (g : List XpTy) → (p : XpExpr) → (A : XpTy) → ((T : XpTy) → xp-infer g p ≡ inl T → XpDer (g , p , T)) →
  (t : XpTy) → xp-infer g p ≡ inl t → xp-fst-ty (inl t) ≡ inl A → XpDer (g , xp-fst p , A)
xp-sound-fst-t g p A sp xt-nat ep h = Empty-rec (xp-inr-inl A h)
xp-sound-fst-t g p A sp (xt-prod c d) ep h = xp-retype g (xp-fst p) c A (xp-inl-inj c A h) (xd-fst g p c d (sp (xt-prod c d) ep))
