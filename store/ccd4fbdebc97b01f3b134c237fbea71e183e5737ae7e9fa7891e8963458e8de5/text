-- 531 name tokens is a few dozen distinct names), then every token drawn
hi-linked : List Word → List Word → Proc W (List Word)
hi-linked rd t = bind (hi-bound-of (hi-uniq (h-msort (hi-cores (hi-toks nil t))))) (λ bs → ret (h-concat (list-map (hi-link-in rd bs) (hi-toks nil t))))
