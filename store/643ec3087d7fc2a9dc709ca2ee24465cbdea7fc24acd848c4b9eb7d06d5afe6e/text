-- ============================================================================
-- 2. Exact Lorentzian Extrinsic Curvature K = [H_E, V] on a 2-Level Vertex
-- ============================================================================
-- With volume operator V = diag(v1, v2) and Euclidean Hamiltonian H_E = [[a, b], [c, d]]:
--   (H_E V - V H_E)_{11} = a v1 - v1 a = 0
--   (H_E V - V H_E)_{12} = b v2 - v1 b = b(v2 - v1)
--   (H_E V - V H_E)_{21} = c v1 - v2 c = c(v1 - v2)
--   (H_E V - V H_E)_{22} = d v2 - v2 d = 0.
-- Check all 4 matrix entries via linear combination with independent probes (or check K12 & K21).
-- Variables (0..5): a, b, c, d, v1, v2.
lqg-lorentzian-K12-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-lorentzian-K12-poly A ad mu q vs =
  (λ g sub →
    let a = g 0; b = g 1; c = g 2; d = g 3; v1 = g 4; v2 = g 5
        k11 = sub (mu a v1) (mu v1 a)
        k12 = sub (mu b v2) (mu v1 b)
        k21 = sub (mu c v1) (mu v2 c)
        k22 = sub (mu d v2) (mu v2 d)
        lhs = ad (ad k11 k22) (ad (sub k12 (mu b (sub v2 v1))) (sub k21 (mu c (sub v1 v2))))
    in (lhs , q (fn-q 0 1)))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
