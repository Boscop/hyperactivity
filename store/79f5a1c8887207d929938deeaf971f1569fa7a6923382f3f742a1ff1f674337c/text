    (ieq-meet sk (lit-ix l) (lit-ix l) (ixmeet (lit-ix m) (conj-ix ms)) (conj-ix (lcons m ms)) (ieq-refl sk (lit-ix l)) (ieq-sym sk (conj-ix (lcons m ms)) (ixmeet (lit-ix m) (conj-ix ms)) (conj-ix-cons sk m ms))))))))
