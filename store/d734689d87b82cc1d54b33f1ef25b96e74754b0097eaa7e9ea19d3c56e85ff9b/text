-- dimension 0: one vector of Unit is already dependent, with coefficient 1 (1 nonzero)
sy-dim-unit : (A : Type) → (z one : A) → (isz : A → Bool) → isz one ≡ false → sy-Dim A Unit z unit (λ p q → unit) (λ c p → unit) isz zero
sy-dim-unit A z one isz hone = ((λ xs → cons one nil) ,
  ((λ xs hl → λ i → sy-unit-eta (sy-comb A Unit unit (λ p q → unit) (λ c p → unit) z (cons one nil) xs) (~ i)) ,
   (λ xs → case xs return λ w → le (suc zero) (sy-len Unit w) → sy-nzc A Unit z isz (cons one nil) w ≡ true of
     nil → λ h → le-sz-absurd (false ≡ true) zero h
     cons u ur → λ h → λ i → if hone i then sy-nzc A Unit z isz nil ur else true)))
