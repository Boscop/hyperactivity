-- the group checked: kept, or its file put back as it was
hy-keep-group : List Word → List Word → List (List Word) → List Word → List Word → List (List Word) → List (List Word) → Proc W Unit
hy-keep-group st m names path old roots nil = bind (hy-forget st) (λ f → hy-keep-new st names)
hy-keep-group st m names path old roots (cons p ps) =
  bind (h-record m path old) (λ w → bind (hy-forget st) (λ f → bind (hy-verdicts st m roots) (λ v →
  bind (h-say (list-append (h-line "nothing written: it does not check") (h-indented "  " (cons p ps)))) (λ u → exit #1))))
