-- M's eigenvalues from S's characteristic polynomial p, 0 first when present
m-eigen-of : List SQ → List SQ
m-eigen-of p = if sq-nz (poly-head p) then roots-low (strip-x (alt-sign true (alt-take (not (odd (monus (poly-len p) (suc zero)))) p)))
  else cons sq-zero (roots-low (strip-x (alt-sign true (alt-take (not (odd (monus (poly-len p) (suc zero)))) p))))
