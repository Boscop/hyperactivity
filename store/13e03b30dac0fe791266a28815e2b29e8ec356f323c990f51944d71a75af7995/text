-- and the theorem: a reflexive relation with one such instance cannot be read as identity. Each
-- pairwise comparison to the reference product can hold, and no composition of them holds, so a
-- chain of substitutions is never covered by the comparisons that were made. Identity composes
-- because it is a path; similarity, as the regime defines it, does not and was never claimed to.
non-transitive-not-identity : (R : Substance → Substance → Type 0) → ((P : Substance) → R P P) → NonTransitive R → (((P : Substance) → (Q : Substance) → R P Q → P ≡ Q) → Empty)
non-transitive-not-identity R rfl n =
  λ det →
    let A = fst n in
    let B = fst (snd n) in
    let C = fst (snd (snd n)) in
    let ab = fst (snd (snd (snd n))) in
    let bc = fst (snd (snd (snd (snd n)))) in
    let nac = snd (snd (snd (snd (snd n)))) in
    nac (transport (λ i → R A (concat (det A B ab) (det B C bc) i)) (rfl A))
