x-na-n : Nat → Lst (Word × Word) → Code → Bool
x-na-n zero ars c = false
x-na-n (suc k) ars (cglob g) = c-not (%weq (x-look ars g) #0)
x-na-n (suc k) ars (capp f a) =
  (let sp = x-spine (capp f a) in
   case fst sp return (λ _ → Bool) of
     cglob g → c-or (c-not (%weq (x-look ars g) (l-count (snd sp)))) (x-na-l (λ c2 → x-na-n k ars c2) (snd sp))
     _ → true)
x-na-n (suc k) ars c = x-na-l (λ c2 → x-na-n k ars c2) (code-kids c)
