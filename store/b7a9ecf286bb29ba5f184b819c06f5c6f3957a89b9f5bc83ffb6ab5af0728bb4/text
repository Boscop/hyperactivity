bn-s256-ext : Nat → Word → List Word → List Word
bn-s256-ext zero    idx ws = ws
bn-s256-ext (suc k) idx ws =
  let w2  = bn-nth-w (%wsub idx #2)  ws
      w7  = bn-nth-w (%wsub idx #7)  ws
      w15 = bn-nth-w (%wsub idx #15) ws
      w16 = bn-nth-w (%wsub idx #16) ws
      wi  = bn-add32 (bn-add32 (bn-s256-s1 w2) w7) (bn-add32 (bn-s256-s0 w15) w16)
  in bn-s256-ext k (%wadd idx #1) (list-append ws (cons wi nil))
