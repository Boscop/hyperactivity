-- Bennett's Compute–Copy–Uncompute Zero-Garbage Theorem:
-- Lifts ANY reversible workspace `fwd`/`bwd` + target readout `outBit` to compute `y0 ⊕ outBit(fwd s0)`
-- while restoring 100% of ancilla/workspace state `s0` cleanly (ZERO thermodynamic garbage bits!)
bennett-run : {St : Type} → (St → St) → (St → St) → (St → Bool) → (St × Bool) → (St × Bool)
bennett-run fwd bwd outBit sy =
  let s1 = fwd (fst sy)
      y1 = b-xor2 (snd sy) (outBit s1)
      s2 = bwd s1
  in (s2 , y1)
