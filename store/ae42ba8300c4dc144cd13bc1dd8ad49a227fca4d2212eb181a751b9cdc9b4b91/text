best-in-fiber-le-init-b : {C S : Type} → (sem : C → S) → (spec : S) → (cost : C → Nat) →
  (c0 : fiber sem spec) → (cs : List (fiber sem spec)) →
  leB (cost (fst (best-in-fiber sem spec cost c0 cs))) (cost (fst c0)) ≡ true
best-in-fiber-le-init-b sem spec cost c0 nil = leB-refl (cost (fst c0))
best-in-fiber-le-init-b sem spec cost c0 (cons c cs) =
  pick-min-l sem spec cost c0 (best-in-fiber sem spec cost c cs)
