-- the six of 1, s, z, s², sz, z², at R = 1 … k
lap-r : Nat → Bool
lap-r k = case k of
  zero → true
  suc k1 → if (if lap-mono (fn-q k 1) 0 0 then (if lap-mono (fn-q k 1) 1 0 then (if lap-mono (fn-q k 1) 0 1 then (if lap-mono (fn-q k 1) 2 0 then (if lap-mono (fn-q k 1) 1 1 then lap-mono (fn-q k 1) 0 2 else false) else false) else false) else false) else false) then lap-r k1 else false
