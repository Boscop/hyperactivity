compress-record-upto-ok : (q : Word → Word) → (ctx xs : List Word) →
                          decompress-record-upto q ctx (compress-record-upto q ctx xs) ≡ xs
compress-record-upto-ok q ctx xs =
  let st = cstate-feed (cstate-empty q) ctx
      p0 = cf-frame-ok (list-length xs) (cf-enc-list st xs)
  in concat {lzero} {List Word}
       {let p = cf-frame-dec (cf-frame-enc (list-length xs) (cf-enc-list st xs))
        in cf-dec-list (fst p) st (snd p)}
       {cf-dec-list (list-length xs) st (cf-enc-list st xs)} {xs}
       (λ i → let p = p0 i in cf-dec-list (fst p) st (snd p))
       (cf-list-ok xs st)
