-- Sample hyperbolic catenoid bridge spanning [-halfSpan, +halfSpan]: y = cy ± B * (6800 + 4400*s²) / 10000
bridge-edge : Nat → Word → Word → SInt → SInt → SInt → SInt → SInt → List Pt2
bridge-edge zero n idx ySign cx cy halfSpan B = nil
bridge-edge (suc rem) n idx ySign cx cy halfSpan B =
  let s = si-sub (si-div-w (si-mul (sp #20000) (sp idx)) n) (sp #10000)
      s2 = fx-mul s s
      px = si-add cx (fx-mul halfSpan s)
      py = si-add cy (si-mul ySign (fx-mul B (si-add (sp #6800) (fx-mul (sp #4400) s2))))
  in cons (px , py) (bridge-edge rem n (%wsucc idx) ySign cx cy halfSpan B)
