mono-comp : (r2 r1 : Word → Word) → MonoW r2 → MonoW r1 → MonoW (λ k → r2 (r1 k))
mono-comp r2 r1 m2 m1 =
  ((λ a b → pcat0 Bool (weq (r2 (r1 a)) (r2 (r1 b))) (weq (r1 a) (r1 b)) (weq a b) (fst m2 (r1 a) (r1 b)) (fst m1 a b)) ,
   (λ a b → pcat0 Bool (wlt (r2 (r1 a)) (r2 (r1 b))) (wlt (r1 a) (r1 b)) (wlt a b) (snd m2 (r1 a) (r1 b)) (snd m1 a b)))
