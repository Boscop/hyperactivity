rfy-pi-body : (a b : TyShape) → RRT a → (Δ : CCtx) (X : Mean Δ (TV (s-fam f-pi a b))) → CompS (s-fam f-pi a b) Δ X → CompS b (lam-ctx Δ a b X) (lam-body Δ a b X)
rfy-pi-body a b Ra Δ X cx =
  jc-tr j-tm b (lam-ctx Δ a b X)
    (fmapM (lam-ctx Δ a b X) (AppV a b) (TV b) (app-r a b) (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (AppV a b) (λ q x → (fst q , snd q , x)) X))
    (lam-body Δ a b X)
    (lift-fm Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) X (AppV a b) (TV b) (λ q x → (fst q , snd q , x)) (app-r a b))
    (snd cx (lam-ctx Δ a b X) (world-wk Δ a (TV (s-fam f-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X)
       (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (AppV a b) (λ q x → (fst q , snd q , x)) X)
       (pcat (Mean (lam-ctx Δ a b X) (TV (s-fam f-pi a b)))
          (fmapM (lam-ctx Δ a b X) (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (AppV a b) (λ q x → (fst q , snd q , x)) X))
          (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (TV (s-fam f-pi a b)) (λ q x → q) X)
          (wact (lam-ctx Δ a b X) Δ (world-wk Δ a (TV (s-fam f-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X) (TV (s-fam f-pi a b)) X)
          (lift-fm Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) X (AppV a b) (TV (s-fam f-pi a b)) (λ q x → (fst q , snd q , x)) (app-f a b))
          (psym (Mean (lam-ctx Δ a b X) (TV (s-fam f-pi a b)))
             (wact (lam-ctx Δ a b X) Δ (world-wk Δ a (TV (s-fam f-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X) (TV (s-fam f-pi a b)) X)
             (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (TV (s-fam f-pi a b)) (λ q x → q) X)
             (pcat (Mean (lam-ctx Δ a b X) (TV (s-fam f-pi a b)))
                (wact (lam-ctx Δ a b X) Δ (world-wk Δ a (TV (s-fam f-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X) (TV (s-fam f-pi a b)) X)
                (wact (lam-ctx Δ a b X) Δ (world-wk Δ a (TV (s-fam f-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X) (TV (s-fam f-pi a b)) (fmapM Δ (TV (s-fam f-pi a b)) (TV (s-fam f-pi a b)) (λ q → q) X))
                (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (TV (s-fam f-pi a b)) (λ q x → q) X)
                (λ i → wact (lam-ctx Δ a b X) Δ (world-wk Δ a (TV (s-fam f-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X) (TV (s-fam f-pi a b))
                   (fmap-id (dims (fst Δ)) (CtxV (fst Δ)) (FbE (fst Δ) (TV (s-fam f-pi a b))) (snd Δ) X (~ i)))
                (wk-fm Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) X (TV (s-fam f-pi a b)) (λ q → q)))))
       (jc-tr j-tm a (lam-ctx Δ a b X) (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (TV a) (λ q x → (fam-dom a b (fst q) , x)) X)
          (fmapM (lam-ctx Δ a b X) (AppV a b) (TV a) (app-a a b) (ext-lift Δ a (TV (s-fam f-pi a b)) (λ q → fam-dom a b (fst q)) (AppV a b) (λ q x → (fst q , snd q , x)) X))
          (psym (Mean (lam-ctx Δ a b X) (TV a))
