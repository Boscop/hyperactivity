-- propositions are sets; a path over a line of types ending in a set is a proposition (the line of
-- types from PathP P p q to the path type at the end, agda/cubical's PathP≡Path)
isProp→isSet : {A : Type} → isProp A → isSet A
isProp→isSet {A} h a b p q = λ j i →
  comp (λ k → A)
    (λ k → [ i = 0 ↦ h a a k , i = 1 ↦ h a b k , j = 0 ↦ h a (p i) k , j = 1 ↦ h a (q i) k ]) a
