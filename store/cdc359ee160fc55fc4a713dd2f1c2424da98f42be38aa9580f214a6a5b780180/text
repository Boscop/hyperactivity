-- an eliminator meets a value: blocked, it becomes a blocked value; otherwise the table says what is built
nk-rule-el : Word → NkTm → NkEnv → Word → NkHd → NkEnv → Word → NkOut
nk-rule-el h cs aux out hd parts n = if nk-blocked hd then nk-stuck-el h cs aux out (nkv hd parts) n else nk-fire (nk-act h cs hd parts) aux parts out n
