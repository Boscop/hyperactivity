-- the meaning of the turn computed in this process (lib/meaning.cub), no machine started for it
ch-answer : List Word → List Word → Proc W (List Word)
ch-answer m q = if h-null q then ret {lzero} {W} (s-response s-html (ch-page nil nil))
  else bind (c-say q) (λ r → ret (s-response s-html (ch-page q r)))
