ins-gt : (e : Env) (v c v2 c2 : Word) (r2 ir : Coefs) →
         csem e ir ≡ plusw (mulw c (e v)) (csem e r2) →
         plusw (mulw c2 (e v2)) (csem e ir) ≡ plusw (mulw c (e v)) (plusw (mulw c2 (e v2)) (csem e r2))
ins-gt e v c v2 c2 r2 ir h = catw (congw (λ z → plusw (mulw c2 (e v2)) z) h) (plusw-mid (mulw c2 (e v2)) (mulw c (e v)) (csem e r2))
