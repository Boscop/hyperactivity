ho-code-nodes : Code → Word
ho-code-nodes (capp f a)  = %wsucc (%wadd (ho-code-nodes f) (ho-code-nodes a))
ho-code-nodes (clam b)    = %wsucc (ho-code-nodes b)
ho-code-nodes (cpair a b) = %wsucc (%wadd (ho-code-nodes a) (ho-code-nodes b))
ho-code-nodes (cfst p)    = %wsucc (ho-code-nodes p)
ho-code-nodes (csnd p)    = %wsucc (ho-code-nodes p)
ho-code-nodes _           = #1
