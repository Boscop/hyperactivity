-- the text cut into the named declarations: the names still to find, the current piece's lines, the
-- comment lines waiting to see whether a declaration follows them, and the lines left; a name not
-- found, in order, is given back
hy-cut : List (List Word) → List (List Word) → List (List Word) → List (List Word) → Sum (List Word) (List (List Word))
hy-cut nil acc pend nil = inr (cons (hy-piece-text (list-append acc pend)) nil)
hy-cut (cons n ns) acc pend nil = inl n
hy-cut nil acc pend (cons l r) = hy-cut nil (list-append acc (list-append pend (cons l nil))) nil r
hy-cut (cons n ns) acc pend (cons l r) =
  if hy-decl-line n l then hy-cons-piece (hy-piece-text acc) (hy-cut ns (list-append pend (cons l nil)) nil r)
  else if h-prefix "--" l then hy-cut (cons n ns) acc (list-append pend (cons l nil)) r
  else hy-cut (cons n ns) (list-append acc (list-append pend (cons l nil))) nil r
