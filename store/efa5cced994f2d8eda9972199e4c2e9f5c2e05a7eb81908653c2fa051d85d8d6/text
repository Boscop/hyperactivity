-- a letter times a normal word, in normal form
fa-put : FaL → FaW → FaP
fa-put l w = case w of
  nil → cons (cons l nil , fn-q 1 1) nil
  cons y s → if fa-llt l y then cons (cons l (cons y s) , fn-q 1 1) nil else (if fa-leq l y then nil else (if (if fst l then false else fst y) then (if al-neq (snd l) (snd y) then fa-add (cons (s , fn-q 1 1) nil) (fa-scal (fn-nq 1 1) (fa-pre y (fa-put l s))) else fa-scal (fn-nq 1 1) (fa-pre y (fa-put l s))) else fa-scal (fn-nq 1 1) (fa-pre y (fa-put l s))))
