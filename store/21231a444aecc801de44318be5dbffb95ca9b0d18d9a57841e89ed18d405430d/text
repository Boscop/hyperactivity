-- bits ms most significant first, with quotient q and remainder r so far
bin-div-loop : List Bool → Bin → Bin → Bin → Bin × Bin
bin-div-loop ms d q r = case ms of
  nil → (q , r)
  cons x rest → (if bin-leb d (bin-cons x r) then bin-div-loop rest d (bin-cons true q) (bin-sub (bin-cons x r) d) else bin-div-loop rest d (bin-cons false q) (bin-cons x r))
