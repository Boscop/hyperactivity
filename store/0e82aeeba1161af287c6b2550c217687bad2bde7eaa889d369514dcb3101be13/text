-- 2. Exact Quantum Virial Theorem under Wavefunction Scaling (Universal SOS):
--    E(λ) = λ² T + λ V (T > 0).
--    Exact identity: 4 T (λ² T + λ V) + V² = (2 T λ + V)² ≥ 0.
--    Minimum occurs uniquely at λ* = -V / (2T), forcing 2 T(λ*) + V(λ*) = 0 identically!
--    Variables (0..2): T, V, λ.
chem-virial-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-virial-poly A ad mu q vs =
  (λ g sq →
    let T = g 0; V = g 1; s = g 2
        q2 = q (fn-q 2 1)
        q4 = q (fn-q 4 1)
        E  = ad (mu (sq s) T) (mu s V)
        lhs = ad (mu q4 (mu T E)) (sq V)
        rhs = sq (ad (mu q2 (mu T s)) V)
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsq A mu)
