-- ---------------------------------------------------------------- how the parts move
-- fewer packets
rf-shrink : (app0 : List KvWrite) → (pd0 : KvPend) → (hist : Hist KvS) → (conf : List KvWrite) → (idx : Word) → (ph : KvPhase) → (fl fl2 : List (Pkt KvMsg)) →
            SubL {Pkt KvMsg} fl2 fl → RfCore app0 pd0 hist conf idx ph fl → RfCore app0 pd0 hist conf idx ph fl2
rf-shrink app0 pd0 hist conf idx ph fl fl2 s h = (fst h , (fst (snd h) , (fst (snd (snd h)) , ((λ p m → fst (snd (snd (snd h))) p (s p m)) , snd (snd (snd (snd h)))))))
