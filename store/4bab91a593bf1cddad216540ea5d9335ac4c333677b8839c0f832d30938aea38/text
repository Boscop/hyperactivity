cm-valid-abo3 : IonCand → IonCand → Bool
cm-valid-abo3 a b =
  andB (%weq (%wadd (ic-q a) (ic-q b)) #6)
  (andB (cm-perovskite-cone (ic-r a) (ic-r b) #140)
        (cm-pauling-octahedral (ic-r b) #140))

cm-count-b : IonCand → List IonCand → Word
cm-count-b _ nil = #0
cm-count-b a (cons b bs) =
  %wadd (if cm-valid-abo3 a b then #1 else #0) (cm-count-b a bs)

cm-discover-abo3 : List IonCand → List IonCand → Word
cm-discover-abo3 nil _ = #0
cm-discover-abo3 (cons a as) bs =
  %wadd (cm-count-b a bs) (cm-discover-abo3 as bs)

