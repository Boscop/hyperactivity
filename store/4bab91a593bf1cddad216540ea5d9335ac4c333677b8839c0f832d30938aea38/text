 (cons (IonCand { ic-z = #40 ; ic-q = #4 ; ic-r = #72 }) -- Zr4+
 (cons (IonCand { ic-z = #13 ; ic-q = #3 ; ic-r = #54 }) -- Al3+ (Wait: (54+140)^2 = 37636 < 39200 -> borderline octahedral!)
