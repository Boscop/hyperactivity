-- SECTION 2: ZERO-FLOAT SQUARED GOLDSCHMIDT PEROVSKITE TOLERANCE CONE & OCTAHEDRAL FACTOR
-- ============================================================================
-- Shannon ionic radii in picometers (pm, exact integers!):
--   O^{2-} (VI)  = 140 pm    | I^{-} (VI)   = 220 pm
--   Ba^{2+} (XII)= 161 pm    | Sr^{2+} (XII)= 144 pm    | Ca^{2+} (XII)= 134 pm
--   La^{3+} (XII)= 136 pm    | Cs^{+} (XII) = 188 pm    | Mg^{2+} (VIII)= 89 pm
--   Ti^{4+} (VI) =  60 pm    | Al^{3+} (VI) =  54 pm    | Pb^{2+} (VI) = 119 pm
--
-- Exact Cubic/Orthogonal Perovskite Stability Cone WITHOUT floats or sqrt(2):
--   t = (rA + rX) / (sqrt(2) * (rB + rX))  in [0.80, 1.05]
--   Squaring both sides (all radii > 0) gives the EXACT integer polynomial cone:
--     Lower bound t^2 >= 64/100 = 16/25:  25 * (rA + rX)^2 >= 32 * (rB + rX)^2
--     Upper bound t^2 <= 441/400:        400 * (rA + rX)^2 <= 882 * (rB + rX)^2
--   Ideal cubic window t^2 in [81/100, 102/100] (t in [0.90, 1.01]):
--     100 * (rA + rX)^2 >= 162 * (rB + rX)^2  AND  100 * (rA + rX)^2 <= 204 * (rB + rX)^2!
--   Pauling octahedral coordination factor mu = rB / rX >= 414/1000 (sqrt(2) - 1):
--     1000 * rB >= 414 * rX  (or exact algebraic: (rB + rX)^2 >= 2 * rX^2)!

cm-le : Word → Word → Bool
cm-le a b = if %wlt b a then false else true

cm-perovskite-cone : Word → Word → Word → Bool
cm-perovskite-cone rA rB rX =
  let sAX  = %wadd rA rX
      sBX  = %wadd rB rX
      sqAX = %wmul sAX sAX
      sqBX = %wmul sBX sBX
  in andB (cm-le (%wmul #32 sqBX) (%wmul #25 sqAX))   -- t >= 0.80  (25*sAX^2 >= 32*sBX^2)
          (cm-le (%wmul #100 sqAX) (%wmul #229 sqBX)) -- t <= 1.070 (includes ferroelectric BaTiO3 t=1.0642!)

cm-cubic-ideal-cone : Word → Word → Word → Bool
cm-cubic-ideal-cone rA rB rX =
  let sAX  = %wadd rA rX
      sBX  = %wadd rB rX
      sqAX = %wmul sAX sAX
      sqBX = %wmul sBX sBX
  in andB (cm-le (%wmul #162 sqBX) (%wmul #100 sqAX))
          (cm-le (%wmul #100 sqAX) (%wmul #222 sqBX)) -- t <= ~1.054 (includes ferroelectric BaTiO3 t=1.06!)

-- Pauling exact algebraic octahedral limit: rB/rX >= sqrt(2) - 1  <==>  (rB + rX)^2 >= 2 * rX^2!
cm-pauling-octahedral : Word → Word → Bool
cm-pauling-octahedral rB rX =
  let sBX = %wadd rB rX
  in cm-le (%wmul #2 (%wmul rX rX)) (%wmul sBX sBX)

-- THEOREM 2: ZERO-FLOAT PEROVSKITE & PAULING OCTAHEDRAL CLASSIFICATION BY `refl`!
--   * SrTiO3 (quantum paraelectric cubic standard: rA=144, rB=60, rX=140): ideal cubic & octahedral!
--   * BaTiO3 (ferroelectric piezo/capacitor: rA=161, rB=60, rX=140): perovskite & octahedral!
--   * CaTiO3 (orthorhombic mineral perovskite: rA=134, rB=60, rX=140): inside perovskite cone!
