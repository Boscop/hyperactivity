  (andB (cm-perovskite-cone #134 #60 #140)  -- CaTiO3
  (andB (cm-cubic-ideal-cone #136 #54 #140) -- LaAlO3
        (if cm-perovskite-cone #72 #60 #140 then false else true))))) ≡ true
