-- ============================================================================
-- SECTION 1: CRYSTALLOGRAPHIC RESTRICTION THEOREM (EXACT LATTICE TRACE INTEGRALITY)
-- ============================================================================
-- In any 3D Bravais lattice, a proper rotation matrix R in GL(3, Z) has integer trace:
--   Tr(R) = 1 + 2*cos(2*pi / n)  in Z   ==>   2*cos(2*pi / n) in {-2, -1, 0, 1, 2}.
-- Encoding `two_cos_shifted = 2*cos(theta) + 2` in {0, 1, 2, 3, 4}:
--   0 -> 2*cos = -2 -> n = 2 (2-fold)
--   1 -> 2*cos = -1 -> n = 3 (3-fold hexagonal/trigonal)
--   2 -> 2*cos =  0 -> n = 4 (4-fold tetragonal/cubic)
--   3 -> 2*cos = +1 -> n = 6 (6-fold hexagonal)
--   4 -> 2*cos = +2 -> n = 1 (1-fold triclinic identity)
-- Conversely, for n = 5 (golden ratio: (2*cos(72 deg))^2 + (2*cos(72 deg)) - 1 = 0):
--   NO integer t in {-2..2} satisfies t^2 + t - 1 == 0! (Proved exhaustively over Z!)

cm-cryst-order : Word → Word
cm-cryst-order x =
  if %weq x #0 then #2
  else if %weq x #1 then #3
  else if %weq x #2 then #4
  else if %weq x #3 then #6
  else if %weq x #4 then #1
  else #0

-- Check if shifted integer `s = t + 2` (so t = s - 2 in {-2,-1,0,1,2}) could ever satisfy
-- the 5-fold minimal polynomial t^2 + t - 1 == 0  <==>  (s - 2)^2 + (s - 2) == 1
-- Expanded without negative numbers: s^2 + 2 == 3*s + 1? Wait:
--   (s - 2)^2 + (s - 2) = s^2 - 4s + 4 + s - 2 = s^2 - 3s + 2.
--   So t^2 + t == 1  <==>  s^2 + 2 == 3*s + 1  <==>  s^2 + 1 == 3*s!
cm-fivefold-root : Word → Bool
cm-fivefold-root s = %weq (%wadd (%wmul s s) #1) (%wmul #3 s)

cm-no-fivefold-in-range : Nat → Word → Bool
cm-no-fivefold-in-range zero _ = true
cm-no-fivefold-in-range (suc k) s =
  andB (if cm-fivefold-root s then false else true)
       (cm-no-fivefold-in-range k (%wadd s #1))

-- Check 7-fold minimal polynomial: 8*cos^3(2pi/7) + 4*cos^2 - 4*cos - 1 = 0
-- For t = 2*cos(2pi/7) = s - 2: t^3 + t^2 - 2*t - 1 = 0
--   (s-2)^3 + (s-2)^2 - 2(s-2) - 1 = (s^3 - 6s^2 + 12s - 8) + (s^2 - 4s + 4) - (2s - 4) - 1
--   = s^3 - 5s^2 + 6s - 1 == 0  <==>  s^3 + 6*s == 5*s^2 + 1!
cm-sevenfold-root : Word → Bool
cm-sevenfold-root s =
  %weq (%wadd (%wmul s (%wmul s s)) (%wmul #6 s))
       (%wadd (%wmul #5 (%wmul s s)) #1)

cm-no-sevenfold-in-range : Nat → Word → Bool
cm-no-sevenfold-in-range zero _ = true
cm-no-sevenfold-in-range (suc k) s =
  andB (if cm-sevenfold-root s then false else true)
       (cm-no-sevenfold-in-range k (%wadd s #1))

-- THEOREM 1: CRYSTALLOGRAPHIC RESTRICTION THEOREM — ONLY ORDERS {1,2,3,4,6} EXIST IN 3D
-- PERIODIC LATTICES; BOTH 5-FOLD QUASICRYSTAL AND 7-FOLD SYMMETRIES HAVE ZERO INTEGER TRACE ROOTS BY `refl`!
cm-thm-crystallographic-restriction :
  andB (%weq (%wadd (cm-cryst-order #0) (%wadd (cm-cryst-order #1) (%wadd (cm-cryst-order #2) (%wadd (cm-cryst-order #3) (cm-cryst-order #4))))) #16)
  (andB (cm-no-fivefold-in-range (toNat #5) #0)
        (cm-no-sevenfold-in-range (toNat #5) #0)) ≡ true
cm-thm-crystallographic-restriction = refl

