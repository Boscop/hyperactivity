-- ---------------------------------------------------------------- 1. Zero-Bank-Conflict XOR-Swizzled Tensor SRAM
b-xor2-inv : (a b : Bool) → b-xor2 a (b-xor2 a b) ≡ b
b-xor2-inv false false = λ _ → false
b-xor2-inv false true  = λ _ → true
b-xor2-inv true  false = λ _ → false
b-xor2-inv true  true  = λ _ → true
