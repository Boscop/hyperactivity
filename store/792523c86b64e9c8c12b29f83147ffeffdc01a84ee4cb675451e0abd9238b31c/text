-- a function out of the tautomers is exactly a function on the forms together with, for each
-- admissible transfer, a proof that it reads the same on both sides
taut-rec : (A : Type 0) → (step : A → A → Bool) → (B : Type 0) → (f : A → B) → ((a : A) → (b : A) → isTrue (step a b) → f a ≡ f b) → Taut A step → B
taut-rec A step B f r t =
  case t return (λ w → B) of
    taut-pt a → f a
    taut-tr a b p i → r a b p i
