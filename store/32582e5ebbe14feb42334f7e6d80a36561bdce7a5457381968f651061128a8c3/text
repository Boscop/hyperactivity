-- ---------------------------------------------------------------- the index's guarantee
-- the count read down the bytes, for any bound k, is the count of the suffix array's entries before k
si-cnt-sa : (T : List (List Word)) → (n : Nat) → (B : Bytes n) → (p : Word) → (o0 : Word) → (r : Word) → (g : Nat) → (f : Nat) →
  isTrue (si-chk-chain n B p o0 T) → isTrue (si-chk-tree n B (build g (suffix-array-fast T)) r) →
  isTrue (si-fuel (build g (suffix-array-fast T)) f) → (k : List (List Word)) →
  si-cnt n B p k f r ≡ fromNat (count-lt {entry-ord} (k , #0) (suffix-array T))
si-cnt-sa T n B p o0 r g f hc ht hf k =
  let ht2 = subst {_} {_} {List (El entry-ord)} {λ l → isTrue (si-chk-tree n B (build {El entry-ord} g l) r)} (suffix-array-fast-is T) ht
      hf2 = subst {_} {_} {List (El entry-ord)} {λ l → isTrue (si-fuel {El entry-ord} (build {El entry-ord} g l) f)} (suffix-array-fast-is T) hf
      rep = si-chk-chain-ok n B T p o0 hc
  in concat (si-cnt-ok n B T p o0 (fst rep) (snd rep) k (build {El entry-ord} g (suffix-array T))
               (si-all-build {El entry-ord} (si-keyok T) g (suffix-array T) (si-sa-keyok T)) f r ht2 hf2)
       (tree-cnt {entry-ord} g (suffix-array T) (suffix-array-sorted T) (k , #0))
