par-allowed-run : {CP CQ M N E : Type} → (CP → ParLab M N E → CP → Type) → (CQ → ParLab N M E → CQ → Type) → List (ParMove CP CQ M N E) → ParState CP CQ M N → Type
par-allowed-run stepP stepQ nil s = Unit
par-allowed-run stepP stepQ (cons mv r) s = par-allowed stepP stepQ mv s × par-allowed-run stepP stepQ r (par-move mv s)
