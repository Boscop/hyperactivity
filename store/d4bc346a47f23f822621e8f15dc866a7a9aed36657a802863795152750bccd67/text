-- ceiling, positive and exact: A ≤ QD
cdiv-pos-exact : (Q D A : Nat) → A ≡ times Q D → le (plus A (plus (times Q zero) zero)) (plus (plus (times Q D) zero) zero)
cdiv-pos-exact Q D A hA = (zero ,
  transN (congN (plus A) (symN (zero-pz Q)))
  (transN (plus-zero A)
  (transN hA (symN (transN (plus-zero (plus (times Q D) zero)) (plus-zero (times Q D)))))))
