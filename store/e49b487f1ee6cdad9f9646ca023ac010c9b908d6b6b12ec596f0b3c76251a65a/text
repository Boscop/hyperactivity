dsl-c : List Word
dsl-c = emit-c-cli-opt (code dsl-main)

dsl-is-direct : List (List Word) → Bool
dsl-is-direct nil         = false
dsl-is-direct (cons a rs) =
  if h-eq a "--with" then
    (case rs of
      nil → false
      cons v rs2 →
        (case rs2 of
          nil → false
          cons r rs3 → dsl-is-direct rs3))
  else if h-infix "hx-deep-semantic-link" a then true
  else dsl-is-direct rs

dsl-run : Step W Unit
dsl-run =
  tmc-step-bind-vm (to-step h-args) (λ av →
    if dsl-is-direct av
    then tmc-step-bind-vm (dsl-main nil) (λ rc → scmd (w-exit rc) (λ u → sdone unit))
    else sdone unit)

