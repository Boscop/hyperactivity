-- Deep Orderbook Level: `(price_cents , available_usd)`
-- Walk state: `(remaining_usd , (filled_usd , weighted_px_x_usd))`
dsl-walk-book : Word → List (Word × Word) → Word × (Word × Word)
dsl-walk-book rem nil = (rem , (#0 , #0))
dsl-walk-book rem (cons lv lvs) =
  let px   = fst lv
      cap  = snd lv
      take = dsl-min rem cap
      rem2 = %wsub rem take
      rest = dsl-walk-book rem2 lvs
      fRest = fst (snd rest)
      wRest = snd (snd rest)
  in (fst rest , (%wadd take fRest , %wadd (%wmul take px) wRest))

