-- Export 0: wasm_impact_cbps(diffScaled=0, midScaled=1, scale=2) -> abs(diffScaled) * scale / max(1, midScaled)
dsl-wf-impact : List Word
dsl-wf-impact =
  let loc  = the (List Word) (cons #1 (cons #1 (cons #127 nil)))
      diff = list-append (cfu-w-bin #107 (cfu-w-get #0) (cfu-w-get #1)) (cfu-w-set #3)
      neg  = cfu-w-bin #107 (cfu-w-c #0) (cfu-w-get #3)
      isNg = cfu-w-bin #72 (cfu-w-get #3) (cfu-w-c #0)
      absv = cfu-wasm-sel neg (cfu-w-get #3) isNg
      num  = cfu-w-bin #108 absv (cfu-w-get #2)
      denOk = cfu-w-bin #74 (cfu-w-get #1) (cfu-w-c #1)
      den  = cfu-wasm-sel (cfu-w-get #1) (cfu-w-c #1) denOk
      res  = cfu-w-bin #110 num den
  in cfu-w-cat (cons loc (cons diff (cons res (cons (cfu-w-op #11) nil))))

-- Export 1: wasm_net_edge_cbps(gross=0, impCost=1, fee=2) -> gross - impCost - fee
dsl-wf-net-edge : List Word
dsl-wf-net-edge =
  let loc = the (List Word) (cons #0 nil)
      s1  = cfu-w-bin #107 (cfu-w-get #0) (cfu-w-get #1)
      res = cfu-w-bin #107 s1 (cfu-w-get #2)
  in cfu-w-cat (cons loc (cons res (cons (cfu-w-op #11) nil)))

-- Export 2: wasm_kkt_alloc(edgeCbps=0, depthCapUsd=1, muCbps=2) ->
--   if edgeCbps > muCbps then min(depthCapUsd, ((edgeCbps - muCbps) * depthCapUsd) / 2000) else 0
dsl-wf-kkt : List Word
dsl-wf-kkt =
  let loc   = the (List Word) (cons #1 (cons #1 (cons #127 nil)))
      surp  = cfu-w-bin #107 (cfu-w-get #0) (cfu-w-get #2)
      raw   = list-append (cfu-w-bin #110 (cfu-w-bin #108 surp (cfu-w-get #1)) (cfu-w-c #2000)) (cfu-w-set #3)
      gtCap = cfu-w-bin #74 (cfu-w-get #3) (cfu-w-get #1)
      capped = cfu-wasm-sel (cfu-w-get #1) (cfu-w-get #3) gtCap
      isPos = cfu-w-bin #74 (cfu-w-get #0) (cfu-w-get #2)
      res   = cfu-wasm-sel capped (cfu-w-c #0) isPos
  in cfu-w-cat (cons loc (cons raw (cons res (cons (cfu-w-op #11) nil))))

dsl-wasm-bytes : List Word
dsl-wasm-bytes =
  let hdr  = the (List Word) (cons #0 (cons #97 (cons #115 (cons #109 (cons #1 (cons #0 (cons #0 (cons #0 nil))))))))
      tSec = cfu-w-sec #1 (cons #2 (list-append cfu-wasm-ty0 cfu-wasm-ty1))
      fSec = cfu-w-sec #3 (the (List Word) (cons #4 (cons #0 (cons #0 (cons #0 (cons #1 nil))))))
      eSec = cfu-w-sec #7
               (cfu-w-cat
                 (cons (cons #4 nil)
                 (cons (cfu-w-exp "wasm_impact_cbps" #0)
                 (cons (cfu-w-exp "wasm_net_edge_cbps" #1)
                 (cons (cfu-w-exp "wasm_kkt_alloc" #2)
                 (cons (cfu-w-exp "wasm_cell" #3) nil))))))
      cSec = cfu-w-sec #10
               (cfu-w-cat
                 (cons (cons #4 nil)
                 (cons (cfu-wfn dsl-wf-impact)
                 (cons (cfu-wfn dsl-wf-net-edge)
                 (cons (cfu-wfn dsl-wf-kkt)
                 (cons (cfu-wfn cfu-wf-cell) nil))))))
  in cfu-w-cat (cons hdr (cons tSec (cons fSec (cons eSec (cons cSec nil)))))

