-- Universal Conservation of Order Units (Nat-indexed proof across ALL ladders & ALL order sizes!):
dsl-add-n : Nat → Nat → Nat
dsl-add-n zero    b = b
dsl-add-n (suc a) b = suc (dsl-add-n a b)

dsl-min-n : Nat → Nat → Nat
dsl-min-n zero    b       = zero
dsl-min-n (suc a) zero    = zero
dsl-min-n (suc a) (suc b) = suc (dsl-min-n a b)

dsl-sub-n : Nat → Nat → Nat
dsl-sub-n a       zero    = a
dsl-sub-n zero    (suc b) = zero
dsl-sub-n (suc a) (suc b) = dsl-sub-n a b

dsl-walk-qty-n : Nat → List Nat → Nat × Nat
dsl-walk-qty-n rem nil = (zero , rem)
dsl-walk-qty-n rem (cons cap cs) =
  let tk   = dsl-min-n rem cap
      rest = dsl-walk-qty-n (dsl-sub-n rem tk) cs
  in (dsl-add-n tk (fst rest) , snd rest)

dsl-lem-add-assoc : (a b c : Nat) → dsl-add-n (dsl-add-n a b) c ≡ dsl-add-n a (dsl-add-n b c)
dsl-lem-add-assoc zero    b c = refl
dsl-lem-add-assoc (suc a) b c = tmc-cong suc (dsl-lem-add-assoc a b c)

dsl-lem-min-sub : (r c : Nat) → dsl-add-n (dsl-min-n r c) (dsl-sub-n r (dsl-min-n r c)) ≡ r
dsl-lem-min-sub zero    c       = refl
dsl-lem-min-sub (suc r) zero    = refl
dsl-lem-min-sub (suc r) (suc c) = tmc-cong suc (dsl-lem-min-sub r c)

-- UNIVERSAL THEOREM 2 (100% EXACT CAPITAL CONSERVATION ACROSS ALL ARBITRARY DEEP ORDERBOOKS):
-- For EVERY order size `rem : Nat` and EVERY deep orderbook capacity list `caps : List Nat`,
-- `filled + unspent ≡ rem` holds universally without exception!
dsl-thm-walk-conserves-all-capital :
  (rem : Nat) → (caps : List Nat) →
  dsl-add-n (fst (dsl-walk-qty-n rem caps)) (snd (dsl-walk-qty-n rem caps)) ≡ rem
dsl-thm-walk-conserves-all-capital rem nil = refl
dsl-thm-walk-conserves-all-capital rem (cons c cs) =
  let tk  = dsl-min-n rem c
      rm2 = dsl-sub-n rem tk
      w   = dsl-walk-qty-n rm2 cs
  in tmc-trans
       (dsl-lem-add-assoc tk (fst w) (snd w))
       (tmc-trans
         (tmc-cong (dsl-add-n tk) (dsl-thm-walk-conserves-all-capital rm2 cs))
         (dsl-lem-min-sub rem c))

