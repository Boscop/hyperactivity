cdivz-pos-sm : (n : BZ) → (s : Bool) → (m : List Bool) → bcanon m ≡ true → zpos (zv (s , m)) → zle (zv n) (zmul (zv (bz-cdiv-z n (s , m))) (zv (s , m)))
cdivz-pos-sm n s m c = case s return λ u → zpos (zv (u , m)) → zle (zv n) (zmul (zv (bz-cdiv-z n (u , m))) (zv (u , m))) of
  true → λ h → bz-cdiv-sound n m c (pos1 (bin-to-nat m) h)
  false → λ h → le-sz-absurd (zle (zv n) (zmul (zv (bz-cdiv-z n (false , m))) (zv (false , m)))) (bin-to-nat m) h
