-- a vtable's method slots: pointers to the instances
rm-init-methods : List RCallee → Target → List RInstance → MPtr → Word → REv Unit
rm-init-methods nil t is p off = rm-ret unit
rm-init-methods (cons f fs) t is p off = case f of
  rcallee-fn b args → rm-st (rm-inst-index is b args #0) (λ j →
    rm-then (rm-bind (rm-off p off) (λ q → rm-store t sk-ptr (tg-align t ck-ptr) q (rm-fn-ptr j)))
            (rm-init-methods fs t is p (wadd off (tg-size t ck-ptr))))
  rcallee-dyn tr mi → rm-throw (rx-ill-formed ri-operand-class)
  rcallee-ptr op → rm-throw (rx-ill-formed ri-operand-class)
