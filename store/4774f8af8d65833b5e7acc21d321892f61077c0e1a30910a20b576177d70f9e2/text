ixo-s : (o : Word) (e : IEx) → Path IEx (ixr (λ k → %wsucc k) (ixo o e)) (ixo (%wsucc o) e)
ixo-s o ix0 = λ i → ix0
ixo-s o ix1 = λ i → ix1
ixo-s o (ixv k) = λ i → ixv (wadd-s k o (~ i))
ixo-s o (ixneg x) = λ i → ixneg (ixo-s o x i)
ixo-s o (ixmeet x y) = λ i → ixmeet (ixo-s o x i) (ixo-s o y i)
ixo-s o (ixjoin x y) = λ i → ixjoin (ixo-s o x i) (ixo-s o y i)
