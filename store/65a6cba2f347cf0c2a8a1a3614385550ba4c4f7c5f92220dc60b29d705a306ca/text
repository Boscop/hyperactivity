-- sums and products respect zeq
zr-cpl : (x x2 y y2 : Nat × Nat) → zeq x x2 → zeq y y2 → zeq (zplus x y) (zplus x2 y2)
zr-cpl x x2 y y2 p q = cl-tr Nat (plus (plus (fst x) (fst y)) (plus (snd x2) (snd y2))) (plus (plus (fst x) (snd x2)) (plus (fst y) (snd y2))) (plus (plus (fst x2) (fst y2)) (plus (snd x) (snd y)))
  (plus-mid4 (fst x) (fst y) (snd x2) (snd y2))
  (cl-tr Nat (plus (plus (fst x) (snd x2)) (plus (fst y) (snd y2))) (plus (plus (fst x2) (snd x)) (plus (fst y2) (snd y))) (plus (plus (fst x2) (fst y2)) (plus (snd x) (snd y)))
    (λ i → plus (p i) (q i))
    (plus-mid4 (fst x2) (snd x) (fst y2) (snd y)))
