-- Glue types: the same face, and on it the same types and equivalences
conv-glue-sys A S S2 =
  if %feq (faceof S) (faceof S2)
    then lall
           (λ d →
              let te = %restrict d S
                  te2 = %restrict d S2
              in if conv-ty (fst te) (fst te2)
                   then conv (%Equiv (fst te) (%restrict d A)) (snd te) (snd te2)
                   else false) (%clauses (faceof S))
    else false
