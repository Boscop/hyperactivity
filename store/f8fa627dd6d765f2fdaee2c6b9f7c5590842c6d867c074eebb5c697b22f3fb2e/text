cs-nth-snoc-old : (A : Type) (xs : Lst A) (y : A) (i : Nat) (v : A) →
  (cs-nth A xs i ≡ some v) → cs-nth A (cs-snoc A xs y) i ≡ some v
cs-nth-snoc-old A xs y i v =
  (case xs return (λ xs0 → (j : Nat) → (cs-nth A xs0 j ≡ some v) → cs-nth A (cs-snoc A xs0 y) j ≡ some v) of
     lnil → λ j h → cs-no (cong (cs-is-some A) h)
     lcons x r → λ j →
       (case j return (λ j0 → (cs-nth A (the (Lst A) (lcons x r)) j0 ≡ some v) → cs-nth A (the (Lst A) (lcons x (cs-snoc A r y))) j0 ≡ some v) of
          zero → λ h → h
          suc j0 → λ h → rec r j0 h)) i
