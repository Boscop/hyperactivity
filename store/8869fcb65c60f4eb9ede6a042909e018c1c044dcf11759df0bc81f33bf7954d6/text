-- an interval as signed decimals with k digits after the point, rounded outward: (sign, digits of |lo|·10^k), the same for hi
iv-dec : List Bool → Nat → IV → (Bool × List Nat) × (Bool × List Nat)
iv-dec S k x = ((fst (bz-fdiv (bz-mul (fst x) (true , bin-of-nat-pow10 k)) S) , dec-digits 60 (snd (bz-fdiv (bz-mul (fst x) (true , bin-of-nat-pow10 k)) S)) nil) ,
  (fst (bz-cdiv (bz-mul (snd x) (true , bin-of-nat-pow10 k)) S) , dec-digits 60 (snd (bz-cdiv (bz-mul (snd x) (true , bin-of-nat-pow10 k)) S)) nil))
