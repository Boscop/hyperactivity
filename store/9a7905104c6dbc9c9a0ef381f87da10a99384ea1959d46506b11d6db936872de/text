best-motif-len : Nat → List MTerm → List MTerm → List MTerm × Word → List MTerm × Word
best-motif-len len full nil best = best
best-motif-len len full (cons x r) best =
  let cand = take-mterms len (cons x r)
      sc = if weq (fromNat (list-length cand)) (fromNat len) then motif-score cand full else #0
      best2 : List MTerm × Word
      best2 = if wlt (snd best) sc then (cand , sc) else best
  in best-motif-len len full r best2
