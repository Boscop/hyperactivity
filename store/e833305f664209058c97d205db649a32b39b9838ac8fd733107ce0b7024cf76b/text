count-lt-all : {o : Ord} → (k x : El o) → (a b : List (El o)) → Sorted (list-append a (cons x b)) → isTrue (not (leq k x)) → count-lt k a ≡ list-length a
count-lt-all k x a b =
  case a return λ w → Sorted (list-append w (cons x b)) → isTrue (not (leq k x)) → count-lt k w ≡ list-length w of
    nil → λ s n i → zero
    cons y r →
      λ s n →
        let yx = allle-app-x y x r b (fst s)
            ny = bool-cases {isTrue (not (leq k y))} (leq k y) (λ t → Empty-rec (true-not {leq k x} (ord-trans {o} {k} {y} {x} t yx) n)) (λ f → f)
        in tr (suc (count-lt k r)) (λ i → plus (one-if (isTrue→eq ny i)) (count-lt k r)) (λ i → suc (rec r (snd s) n i))
