lb-trans : (a b : Lit) (c : Conj) → lit-lt a b ≡ true → lit-lb b c ≡ true → lit-lb a c ≡ true
lb-trans a b lnil p h = λ i → true
lb-trans a b (lcons m ms) p h =
  andB-intro (lit-lt a m) (lit-lb a ms) (lit-lt-trans a b m p (andB-l (lit-lt b m) (lit-lb b ms) h)) (lb-trans a b ms p (andB-r (lit-lt b m) (lit-lb b ms) h))
