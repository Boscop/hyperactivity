-- (part of language-support)
genericBitstructUpdater : (w_n : Word) → (width : ZI) → (spliceBits : Bits (z-nat width)) → (low : ZI) → (inputBits : Bits w_n) → Bits w_n
genericBitstructUpdater w_n width spliceBits low inputBits =
  (bv-update w_n inputBits (z-nat (z-sub (z-add low width) (zpos #1))) (z-nat low) spliceBits)
