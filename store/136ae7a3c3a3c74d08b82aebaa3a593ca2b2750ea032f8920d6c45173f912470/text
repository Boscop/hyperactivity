-- (8.9) decodeLE(encodeLE(w)) = w
decode-encode : (w : Word32) → decodeLE (encodeLE w) ≡ w
decode-encode w =
  concat {lzero} {Word32} {decodeLE (encodeLE w)} {bv-cat 8 24 (fst (le-s1 w)) (snd (le-s1 w))} {w}
    (λ k → bv-cat 8 24 (fst (le-s1 w))
      (concat {lzero} {BitVec 24} {bv-cat 8 16 (fst (le-s2 w)) (bv-cat 8 8 (fst (le-s3 w)) (snd (le-s3 w)))} {bv-cat 8 16 (fst (le-s2 w)) (snd (le-s2 w))} {snd (le-s1 w)}
        (λ k2 → bv-cat 8 16 (fst (le-s2 w)) (bv-cat-split 8 8 (snd (le-s2 w)) k2))
        (bv-cat-split 8 16 (snd (le-s1 w))) k))
    (bv-cat-split 8 24 w)
