-- reading a canonical nonempty list and writing it back is the identity
zr-ob : (rest : List Bool) → (b : Bool) → bcanon (cons b rest) ≡ true → zr-bits (zr-ofbits (cons b rest)) ≡ cons b rest
zr-ob rest = case rest return λ w → (b : Bool) → bcanon (cons b w) ≡ true → zr-bits (zr-ofbits (cons b w)) ≡ cons b w of
  nil → λ b h → λ i → cons (h (~ i)) nil
  cons c r2 → λ b → (case b return λ u → bcanon (cons u (cons c r2)) ≡ true → zr-bits (zr-ofbits (cons u (cons c r2))) ≡ cons u (cons c r2) of
    true → λ h → λ i → cons true (zr-ob r2 c h i)
    false → λ h → λ i → cons false (zr-ob r2 c h i))
