-- Header: "HXC2" (4 B) + raw_len (4 B big-endian) + payload
hcm-put32 : Word → Word → Word → (Word → Step W Word) → Step W Word
hcm-put32 buf off v k =
  scmd (w-store8 (%wadd buf off) (%wand (%wshr v #24) #255)) (λ _ →
  scmd (w-store8 (%wadd buf (%wadd off #1)) (%wand (%wshr v #16) #255)) (λ _ →
  scmd (w-store8 (%wadd buf (%wadd off #2)) (%wand (%wshr v #8) #255)) (λ _ →
  scmd (w-store8 (%wadd buf (%wadd off #3)) (%wand v #255)) (λ _ → k (%wadd off #4)))))
