hxl-synth-suite : Word × Word
hxl-synth-suite =
  let r1 = hxl-synth-one #15  #1
      r2 = hxl-synth-one #192 #2
      r3 = hxl-synth-one #252 #3
      r4 = hxl-synth-one #102 #4
      r5 = hxl-synth-one #202 #4
      r6 = hxl-synth-one #232 #6
      ok_n = %wadd (fst r1) (%wadd (fst r2) (%wadd (fst r3) (%wadd (fst r4) (%wadd (fst r5) (fst r6)))))
      tot_g = %wadd (snd r1) (%wadd (snd r2) (%wadd (snd r3) (%wadd (snd r4) (%wadd (snd r5) (snd r6)))))
  in (ok_n , tot_g)
