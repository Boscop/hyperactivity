-- a λ's binder against its Π's multiplicity (a linear domain is 1 when the Π says nothing)
mult-ok x body A m =
  let m2 = if %weq m #2 then (if linear-ty A then #1 else #2) else m
  in if %weq m2 #2 then ok
     else let u = lhead (usage (lcons x lnil) body)
          in if %weq m2 #0 then chk (%weq u #0) (refused (cfree x) E-erased-used opq opq)
             else if %weq u #0 then refused (cfree x) E-linear-dropped opq opq
             else if %weq u #2 then refused (cfree x) E-linear-dup opq opq
             else ok
