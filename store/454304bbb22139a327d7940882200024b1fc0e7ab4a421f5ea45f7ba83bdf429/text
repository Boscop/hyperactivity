-- ============================================================================
-- 1. SU(2) Spin-Network Area Spectrum & Exact Area Gap Theorem
-- ============================================================================
-- In doubled-spin units d = 2j (so spin 1/2 is d = 1, spin 1 is d = 2, ...),
-- the SU(2) Casimir eigenvalue is 4 j(j+1) = d(d+2), so A_e^2 = (1/4) γ^2 ℓ_P^4 · lqg-casimir4 d.
lqg-casimir4 : Nat → Nat
lqg-casimir4 d = times d (plus 2 d)
