              (gmf-thm-metacircular-quote-eval vEnv b i)

gmf-code-unboxed4 : Code → Code
gmf-code-unboxed4 sub = cwop #10 (cwop #2 sub sub) (cwop #5 sub sub)

gmf-code-clet-boxed4 : Code → Code
gmf-code-clet-boxed4 sub =
  clet sub (cwop #10 (cwop #2 (cvar #0) (cvar #0)) (cwop #5 (cvar #0) (cvar #0)))

gmf-code-size : Code → Word
gmf-code-size (capp f a)   = %wsucc (%wadd (gmf-code-size f) (gmf-code-size a))
gmf-code-size (clam b)     = %wsucc (gmf-code-size b)
gmf-code-size (cpair a b)  = %wsucc (%wadd (gmf-code-size a) (gmf-code-size b))
gmf-code-size (cfst p)     = %wsucc (gmf-code-size p)
gmf-code-size (csnd p)     = %wsucc (gmf-code-size p)
