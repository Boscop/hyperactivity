-- L1 Nonlinear `Maj -> MC=1` ANF Contractor (`GMFAnf`):
data GMFAnf
  = ga-var (k : Word)
  | ga-xor (a : GMFAnf) (b : GMFAnf)
  | ga-and (a : GMFAnf) (b : GMFAnf)
  | ga-maj (a : GMFAnf) (b : GMFAnf) (c : GMFAnf)

gmf-majB : Bool → Bool → Bool → Bool
gmf-majB a b c =
  gmf-bxor (gmf-band a b) (gmf-bxor (gmf-band a c) (gmf-band b c))

gmf-lem-maj-mc1 : (a b c : Bool) →
  gmf-bxor a (gmf-band (gmf-bxor a b) (gmf-bxor a c)) ≡ gmf-majB a b c
gmf-lem-maj-mc1 false false false = refl
gmf-lem-maj-mc1 false false true  = refl
gmf-lem-maj-mc1 false true  false = refl
gmf-lem-maj-mc1 false true  true  = refl
gmf-lem-maj-mc1 true  false false = refl
gmf-lem-maj-mc1 true  false true  = refl
gmf-lem-maj-mc1 true  true  false = refl
gmf-lem-maj-mc1 true  true  true  = refl

gmf-anf-eval : (Word → Bool) → GMFAnf → Bool
gmf-anf-eval env (ga-var k)     = env k
gmf-anf-eval env (ga-xor a b)   = gmf-bxor (gmf-anf-eval env a) (gmf-anf-eval env b)
gmf-anf-eval env (ga-and a b)   = gmf-band (gmf-anf-eval env a) (gmf-anf-eval env b)
gmf-anf-eval env (ga-maj a b c) = gmf-majB (gmf-anf-eval env a) (gmf-anf-eval env b) (gmf-anf-eval env c)

gmf-anf-mc : GMFAnf → Nat
gmf-anf-mc (ga-var k)     = zero
gmf-anf-mc (ga-xor a b)   = plus (gmf-anf-mc a) (gmf-anf-mc b)
gmf-anf-mc (ga-and a b)   = suc (plus (gmf-anf-mc a) (gmf-anf-mc b))
gmf-anf-mc (ga-maj a b c) = suc (suc (suc (plus (gmf-anf-mc a) (plus (gmf-anf-mc b) (gmf-anf-mc c)))))

gmf-anf-step : GMFAnf → GMFAnf
gmf-anf-step (ga-var k)   = ga-var k
gmf-anf-step (ga-xor a b) = ga-xor (gmf-anf-step a) (gmf-anf-step b)
gmf-anf-step (ga-and a b) = ga-and (gmf-anf-step a) (gmf-anf-step b)
gmf-anf-step (ga-maj a b c) =
  let a1 = gmf-anf-step a
      b1 = gmf-anf-step b
      c1 = gmf-anf-step c
  in ga-xor a1 (ga-and (ga-xor a1 b1) (ga-xor a1 c1))

gmf-thm-anf-step-sound : (env : Word → Bool) → (e : GMFAnf) →
  gmf-anf-eval env (gmf-anf-step e) ≡ gmf-anf-eval env e
gmf-thm-anf-step-sound env (ga-var k)   = refl
gmf-thm-anf-step-sound env (ga-xor a b) =
  λ i → gmf-bxor (gmf-thm-anf-step-sound env a i) (gmf-thm-anf-step-sound env b i)
gmf-thm-anf-step-sound env (ga-and a b) =
  λ i → gmf-band (gmf-thm-anf-step-sound env a i) (gmf-thm-anf-step-sound env b i)
gmf-thm-anf-step-sound env (ga-maj a b c) =
  hn-trans
    (gmf-lem-maj-mc1
      (gmf-anf-eval env (gmf-anf-step a))
      (gmf-anf-eval env (gmf-anf-step b))
      (gmf-anf-eval env (gmf-anf-step c)))
    (λ i → gmf-majB
      (gmf-thm-anf-step-sound env a i)
      (gmf-thm-anf-step-sound env b i)
      (gmf-thm-anf-step-sound env c i))

