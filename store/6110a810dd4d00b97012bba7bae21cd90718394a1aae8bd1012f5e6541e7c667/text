gmf-run : Step W Word
gmf-run =
  gmf-then (to-step h-args) (λ av →
    if gmf-is-direct av
    then
      let restArgs = h-tail-lists av
      in gmf-then (to-step (am-tick gmf-agent-card)) (λ peers →
         gmf-then (gmf-main restArgs) (λ rc →
         gmf-then gmf-vm-self-reflect (λ rc2 →
         to-step (gmf-prime-and-maybe-spawn restArgs))))
    else sdone #0)

