data FlowArc = mk-farc
  (fa-src  : Word)
  (fa-dst  : Word)
  (fa-cap  : Nat)
  (fa-flow : Nat)
  (fa-tir  : Bool)

gmf-fa-src : FlowArc → Word
gmf-fa-src (mk-farc s d c f t) = s

gmf-fa-dst : FlowArc → Word
gmf-fa-dst (mk-farc s d c f t) = d

gmf-fa-flow : FlowArc → Nat
gmf-fa-flow (mk-farc s d c f t) = f

-- Total-Internal-Reflection Boundary Capacity Law:
-- Any arc crossing to an unverified/forged/phantom exterior port (`fa-tir = false`) has capacity ZERO.
gmf-eff-cap : FlowArc → Nat
gmf-eff-cap (mk-farc s d c f t) = if t then c else zero

-- THEOREM 1A (ZERO EXTERIOR CUT CAPACITY — TIR BOUNDARY ANNIHILATION FOR ALL ARCS):
gmf-thm-tir-exterior-zero :
  (s d : Word) → (cap fl : Nat) →
  gmf-eff-cap (mk-farc s d cap fl false) ≡ zero
gmf-thm-tir-exterior-zero s d cap fl = refl

-- Interior Kirchhoff Interaction-Cell Conservation (`x1 + x2 === out1 + out2` under port commutation):
gmf-plus-comm : (a b : Nat) → plus a b ≡ plus b a
gmf-plus-comm zero    b = hn-sym (hn-plus-zero-r b)
gmf-plus-comm (suc a) b = hn-trans (cong suc (gmf-plus-comm a b)) (hn-sym (hn-plus-suc-r b a))

gmf-kirchhoff-commute : Nat → Nat → Nat × Nat
gmf-kirchhoff-commute x1 x2 = (x2 , x1)

gmf-thm-kirchhoff-conserved :
  (x1 x2 : Nat) →
  plus (fst (gmf-kirchhoff-commute x1 x2)) (snd (gmf-kirchhoff-commute x1 x2)) ≡ plus x1 x2
gmf-thm-kirchhoff-conserved x1 x2 = gmf-plus-comm x2 x1

gmf-le-suc-r : (x y : Nat) → ml-le x y ≡ true → ml-le x (suc y) ≡ true
gmf-le-suc-r zero    y       h = refl
gmf-le-suc-r (suc x) zero    h = Empty-rec (vh-false-neq-true h)
gmf-le-suc-r (suc x) (suc y) h = gmf-le-suc-r x y h

gmf-le-plus-l : (b c d : Nat) → ml-le c d ≡ true → ml-le c (plus b d) ≡ true
gmf-le-plus-l zero    c d h = h
gmf-le-plus-l (suc b) c d h = gmf-le-suc-r c (plus b d) (gmf-le-plus-l b c d h)

gmf-lem-le-plus : (a b c d : Nat) → ml-le a b ≡ true → ml-le c d ≡ true → ml-le (plus a c) (plus b d) ≡ true
gmf-lem-le-plus zero    b       c d hab hcd = gmf-le-plus-l b c d hcd
gmf-lem-le-plus (suc a) zero    c d hab hcd = Empty-rec (vh-false-neq-true hab)
gmf-lem-le-plus (suc a) (suc b) c d hab hcd = gmf-lem-le-plus a b c d hab hcd

-- THEOREM 1B (UNIVERSAL PARALLEL DOMINANCE OVER SERIAL LINEAR BOTTLENECKING):
gmf-thm-parallel-dominates-serial :
  (c1 c2 : Nat) → ml-le (ml-min c1 c2) (plus c1 c2) ≡ true
gmf-thm-parallel-dominates-serial c1 c2 =
  gmf-le-plus-l c1 (ml-min c1 c2) c2 (ml-thm-min-le-r c1 c2)

gmf-and-l : (p q : Bool) → andB p q ≡ true → p ≡ true
gmf-and-l true  true  h = refl
gmf-and-l true  false h = refl
gmf-and-l false true  h = Empty-rec (vh-false-neq-true h)
gmf-and-l false false h = Empty-rec (vh-false-neq-true h)

gmf-and-r : (p q : Bool) → andB p q ≡ true → q ≡ true
gmf-and-r true  true  h = refl
gmf-and-r true  false h = Empty-rec (vh-false-neq-true h)
gmf-and-r false true  h = Empty-rec (vh-false-neq-true h)
gmf-and-r false false h = Empty-rec (vh-false-neq-true h)

gmf-arc-valid : FlowArc → Bool
gmf-arc-valid a = ml-le (gmf-fa-flow a) (gmf-eff-cap a)

gmf-net-valid : List FlowArc → Bool
gmf-net-valid nil         = true
gmf-net-valid (cons a as) = andB (gmf-arc-valid a) (gmf-net-valid as)

gmf-crosses-cut : (Word → Bool) → FlowArc → Bool
gmf-crosses-cut inS a = andB (inS (gmf-fa-src a)) (not (inS (gmf-fa-dst a)))

gmf-cut-flow : (Word → Bool) → List FlowArc → Nat
gmf-cut-flow inS nil = zero
gmf-cut-flow inS (cons a as) =
  if gmf-crosses-cut inS a
  then plus (gmf-fa-flow a) (gmf-cut-flow inS as)
  else gmf-cut-flow inS as

gmf-cut-cap : (Word → Bool) → List FlowArc → Nat
gmf-cut-cap inS nil = zero
gmf-cut-cap inS (cons a as) =
  if gmf-crosses-cut inS a
  then plus (gmf-eff-cap a) (gmf-cut-cap inS as)
  else gmf-cut-cap inS as

gmf-cut-step-le :
  (cross : Bool) → (fl cp tailFl tailCp : Nat) →
  ml-le fl cp ≡ true → ml-le tailFl tailCp ≡ true →
  ml-le (if cross then plus fl tailFl else tailFl) (if cross then plus cp tailCp else tailCp) ≡ true
gmf-cut-step-le true  fl cp tailFl tailCp h1 h2 = gmf-lem-le-plus fl cp tailFl tailCp h1 h2
gmf-cut-step-le false fl cp tailFl tailCp h1 h2 = h2

-- THEOREM 1C (UNIVERSAL GLOBAL INTERACTION-NET MAX-FLOW / MIN-CUT WEAK DUALITY, 0 POSTULATES):
gmf-thm-global-cut-weak-duality :
  (inS : Word → Bool) → (net : List FlowArc) →
  gmf-net-valid net ≡ true →
  ml-le (gmf-cut-flow inS net) (gmf-cut-cap inS net) ≡ true
gmf-thm-global-cut-weak-duality inS nil hv = refl
gmf-thm-global-cut-weak-duality inS (cons a as) hv =
  let ha  = gmf-and-l (gmf-arc-valid a) (gmf-net-valid as) hv
      has = gmf-and-r (gmf-arc-valid a) (gmf-net-valid as) hv
  in gmf-cut-step-le
       (gmf-crosses-cut inS a)
       (gmf-fa-flow a)
       (gmf-eff-cap a)
       (gmf-cut-flow inS as)
       (gmf-cut-cap inS as)
       ha
       (gmf-thm-global-cut-weak-duality inS as has)

-- Executable Residual-Graph Global Max-Flow Solver (with Backward Residual Pushback!):
data ResEdge = mk-redge (re-u : Word) (re-v : Word) (re-cap : Word)

gmf-res-get : Word → Word → List ResEdge → Word
gmf-res-get u v nil = #0
gmf-res-get u v (cons (mk-redge a b c) es) =
  if andB (%weq u a) (%weq v b)
  then %wadd c (gmf-res-get u v es)
  else gmf-res-get u v es

gmf-res-add : Word → Word → Word → List ResEdge → List ResEdge
gmf-res-add u v delta nil =
  if %weq delta #0 then nil else cons (mk-redge u v delta) nil
gmf-res-add u v delta (cons (mk-redge a b c) es) =
  if andB (%weq u a) (%weq v b)
  then cons (mk-redge a b (%wadd c delta)) es
  else cons (mk-redge a b c) (gmf-res-add u v delta es)

gmf-res-sub : Word → Word → Word → List ResEdge → List ResEdge
gmf-res-sub u v delta nil = nil
gmf-res-sub u v delta (cons (mk-redge a b c) es) =
  if andB (%weq u a) (%weq v b)
  then
    if %wlt c delta
    then cons (mk-redge a b #0) (gmf-res-sub u v (%wsub delta c) es)
    else cons (mk-redge a b (%wsub c delta)) es
  else cons (mk-redge a b c) (gmf-res-sub u v delta es)

data RawFlowEdge = mk-raw-edge (rw-u : Word) (rw-v : Word) (rw-cap : Word) (rw-tir : Bool)

gmf-init-residual : List RawFlowEdge → List ResEdge
gmf-init-residual nil = nil
gmf-init-residual (cons (mk-raw-edge u v c tir) es) =
  let rest = gmf-init-residual es
  in if andB tir (%wlt #0 c) then gmf-res-add u v c rest else rest

gmf-best-single-edge-out : Word → List ResEdge → Word × Word
gmf-best-single-edge-out u nil = (#0 , #0)
gmf-best-single-edge-out u (cons (mk-redge a b c) es) =
  let tl = gmf-best-single-edge-out u es
  in if andB (%weq u a) (%wlt (snd tl) c) then (b , c) else tl

gmf-single-linear-flow : Nat → Word → Word → Word → List ResEdge → Word
gmf-single-linear-flow zero    cur sink bot res = if %weq cur sink then bot else #0
gmf-single-linear-flow (suc k) cur sink bot res =
  if %weq cur sink then bot
  else
    let nxt = gmf-best-single-edge-out cur res
        v   = fst nxt
        c   = snd nxt
    in if %weq c #0 then #0
       else gmf-single-linear-flow k v sink (hn-min-w bot c) res

gmf-scan-neighbors :
  (Word → List Word → List Word) → List ResEdge → Word → Word → List Word → List Word
gmf-scan-neighbors rec nil u sink vis = nil
gmf-scan-neighbors rec (cons (mk-redge a b c) scan) u sink vis =
  if andB (%weq u a) (andB (%wlt #0 c) (not (hn-mem-w b vis)))
  then
    if %weq b sink
    then cons u (cons sink nil)
    else
      case rec b (cons b vis) of
        nil       → gmf-scan-neighbors rec scan u sink vis
        cons x xs → cons u (cons x xs)
  else gmf-scan-neighbors rec scan u sink vis

gmf-dfs-depth : Nat → List ResEdge → Word → Word → List Word → List Word
gmf-dfs-depth zero    allRes sink u vis = nil
gmf-dfs-depth (suc k) allRes sink u vis =
  gmf-scan-neighbors (gmf-dfs-depth k allRes sink) allRes u sink vis

gmf-find-aug-path : Nat → Word → Word → List ResEdge → List Word
gmf-find-aug-path depth src sink res =
  if %weq src sink then cons src nil
  else gmf-dfs-depth depth res sink src (cons src nil)

gmf-path-bottleneck : Word → List Word → List ResEdge → Word
gmf-path-bottleneck cur nil                  res = #0
gmf-path-bottleneck cur (cons u nil)         res = cur
gmf-path-bottleneck cur (cons u (cons v ps)) res =
  let c = gmf-res-get u v res
  in gmf-path-bottleneck (hn-min-w cur c) (cons v ps) res

-- Residual forward-sub + optional BACKWARD-ADD (non-linear interaction-net flow rerouting!):
gmf-augment-path : Bool → Word → List Word → List ResEdge → List ResEdge
gmf-augment-path useBack bot nil                  res = res
gmf-augment-path useBack bot (cons u nil)         res = res
gmf-augment-path useBack bot (cons u (cons v ps)) res =
  let r1 = gmf-res-sub u v bot res
      r2 = the (List ResEdge) (if useBack then gmf-res-add v u bot r1 else r1)
  in gmf-augment-path useBack bot (cons v ps) r2

gmf-maxflow-loop : Bool → Nat → Nat → Word → Word → Word → List ResEdge → Word × List ResEdge
gmf-maxflow-loop useBack zero    depth src sink tot res = (tot , res)
gmf-maxflow-loop useBack (suc w) depth src sink tot res =
  let p = gmf-find-aug-path depth src sink res
  in case p of
       nil → (tot , res)
       cons u ps →
         let bot = gmf-path-bottleneck #1000000000000 (cons u ps) res
         in if %weq bot #0
            then (tot , res)
            else gmf-maxflow-loop useBack w depth src sink (%wadd tot bot)
                   (gmf-augment-path useBack bot (cons u ps) res)

gmf-maxflow : Nat → Nat → Word → Word → List RawFlowEdge → Word × List ResEdge
gmf-maxflow waves depth src sink raw =
  gmf-maxflow-loop true waves depth src sink #0 (gmf-init-residual raw)

gmf-greedy-forward-only : Nat → Nat → Word → Word → List RawFlowEdge → Word
gmf-greedy-forward-only waves depth src sink raw =
  fst (gmf-maxflow-loop false waves depth src sink #0 (gmf-init-residual raw))

gmf-reach-step : List ResEdge → List Word → List Word
gmf-reach-step nil vis = vis
gmf-reach-step (cons (mk-redge u v c) es) vis =
  let vis2 =
        the (List Word)
          (if andB (%wlt #0 c) (andB (hn-mem-w u vis) (not (hn-mem-w v vis)))
           then cons v vis
           else vis)
  in gmf-reach-step es vis2

gmf-reach-fix : Nat → List ResEdge → List Word → List Word
gmf-reach-fix zero    res vis = vis
gmf-reach-fix (suc k) res vis = gmf-reach-fix k res (gmf-reach-step res vis)

gmf-raw-cut-cap : List Word → List RawFlowEdge → Word
gmf-raw-cut-cap sSet nil = #0
gmf-raw-cut-cap sSet (cons (mk-raw-edge u v c tir) es) =
  let rest = gmf-raw-cut-cap sSet es
  in if andB tir (andB (hn-mem-w u sSet) (not (hn-mem-w v sSet)))
     then %wadd c rest
