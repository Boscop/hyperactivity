gmf-vm-self-reflect : Step W Word
gmf-vm-self-reflect =
  let nMf   = ho-reflect-def-nodes (code gmf-maxflow-loop)
      nWave = ho-reflect-def-nodes (code gmf-meta-wave)
      nCode = ho-reflect-def-nodes (code gmf-quote-vhterm)
