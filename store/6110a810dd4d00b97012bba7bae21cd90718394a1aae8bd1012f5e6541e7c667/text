  in h-run cmdArgs

gmf-spawn-n : Nat → Bool → Bool → Word → List Word → Proc W Word
gmf-spawn-n zero    useGem autoApp idx primerTxt = ret {lzero} {W} idx
gmf-spawn-n (suc k) useGem autoApp idx primerTxt =
  bind (gmf-spawn-one useGem autoApp idx primerTxt) (λ rc →
  gmf-spawn-n k useGem autoApp (%wsucc idx) primerTxt)

gmf-prime-and-maybe-spawn : List (List Word) → Proc W Word
gmf-prime-and-maybe-spawn args =
  bind time-now (λ nowNs →
  bind (h-read "store/ROOT/root") (λ mr →
  bind (h-list gmf-brain-root) (λ cids →
    let nowSec = %wdiv nowNs #1000000000
        rh     = the (List Word) (case mr of inl u → "unknown"; inr t → gmf-trim t)
    in bind (gmf-harvest-cids nowSec cids nil) (λ harv →
         let prompts   = fst harv
             nSess     = snd harv
             nPrompts  = fromNat (list-length prompts)
             primerDoc = gmf-build-primer-doc rh nSess prompts
             primerOut = the (List Word) "/tmp/hx_agent_bus/hx_autopoietic_primer.md"
             sub       = h-head-or args
             cntArg    = h-head-or (h-tail-lists args)
             flagArg   = h-head-or (h-tail-lists (h-tail-lists args))
             nSpawn    = hn-min-w (if %weq (cli-len cntArg) #0 then #1 else cli-word cntArg) #12
             autoYolo  = cli-eq flagArg "yolo"
         in bind (h-mkdir "/tmp/hx_agent_bus") (λ m0 →
            bind (h-write primerOut primerDoc) (λ w0 →
            bind (h-out (bn-ln (h-concat
                   (cons "  [7. AUTOPOIETIC PRIMER]   Harvested "
                   (cons (h-decimal nPrompts)
                   (cons " live Founder directives across "
                   (cons (h-decimal nSess)
                   (cons " active sessions -> "
                   (cons primerOut
                   (cons " (ready: spawn-gemini N [yolo] | spawn-agy N [yolo])" nil)))))))))) (λ o0 →
              if cli-eq sub "spawn-gemini"
              then gmf-spawn-n (toNat nSpawn) true autoYolo #0 primerDoc
              else if cli-eq sub "spawn-agy"
              then gmf-spawn-n (toNat nSpawn) false autoYolo #0 primerDoc
              else ret {lzero} {W} nPrompts)))))))

