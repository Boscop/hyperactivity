si-all-drop : {A : Type} → (P : A → Type) → (k : Nat) → (l : List A) → si-all P l → si-all P (drop-n k l)
si-all-drop P k = case k return λ w → (l : List A) → si-all P l → si-all P (drop-n w l) of
  zero → λ l h → h
  suc g → λ l → case l return λ v → si-all P v → si-all P (drop-n (suc g) v) of
    nil → λ h → unit
    cons x r → λ h → rec g r (snd h)
