-- memi: from prelude.sail (it calls what is defined after it there)
-- (part of language-support)
memi : (w_addr_width : Word) → (addr : Bits w_addr_width) → MS (Bits #8)
memi w_addr_width addr =
  bindS {Bits #8} {Bits #8} (getS {Bits #8} (x86-read-mem #1 (bv-mask #64 addr))) (λ result' →
    bindS {Unit} {Bits #8} (log_memory_read w_addr_width addr (zpos #1) result') (λ t'2 →
      retS {Bits #8} result'))
