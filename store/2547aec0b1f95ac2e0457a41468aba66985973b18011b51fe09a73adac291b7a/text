-- Higher-order meta-tower: Level-m transformer acting on transformers ((INet -> INet) -> (INet -> INet))!
-- Level 0: f | Level 1: f o f | Level 2: (f o f) o (f o f) | Level m: 2^m fused self-applications!
in-hyper-tower : Nat → (INet → INet) → INet → INet
in-hyper-tower zero    f = f
in-hyper-tower (suc m) f = in-meta-fuse (in-hyper-tower m f) (in-hyper-tower m f)
