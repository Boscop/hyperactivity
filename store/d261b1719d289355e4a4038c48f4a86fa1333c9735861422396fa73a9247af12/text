-- what the public server withholds: any path under private/, whether asked for via /doc?path=, /source/text?path=
-- (in hex), /hi?focus=, or /hi/scene?focus= (including percent-encoded paths).
s-withheld : List Word → Bool
s-withheld p =
  orB (andB (h-prefix "/doc?" p) (h-infix "private/" (s-unescape (s-param "path" (s-query p)))))
  (orB (andB (h-prefix "/source/text" p) (h-infix "private/" (h-unhex (s-param "path" (s-query p)))))
  (andB (h-prefix "/hi" p) (h-infix "private/" (s-unescape (s-param "focus" (s-query p))))))
