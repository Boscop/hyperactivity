-- composition by the head of its type: in the numbers, a number whose sides are all constant at
-- it is that number; in a function type, the function of an x that is the composition at x; in a
-- path type, the path whose point at j is the composition there with the two ends added as sides
nk-hcomp-at : NkTm → NkTm → NkTm → NkTm
nk-hcomp-at (nk-con c args) bs u0 =
  if %weq c #3 then nk-hcomp-num (nk-con c args) bs u0
  else (if %weq c #41 then (if nk-tm-eq bs nk-nil then u0 else nk-hcomp (nk-con c args) (nk-sys bs) u0)
  else (if %weq c #1 then nk-lam (nk-hcomp (nk-app (nk-up (nk-nth args #1)) (nk-var #0)) (nk-sys (nk-sys-app bs)) (nk-app (nk-up u0) (nk-var #0)))
  else (if %weq c #4 then nk-lam (nk-hcomp (nk-app (nk-up (nk-nth args #0)) (nk-var #0)) (nk-sys (nk-cons (nk-br (nk-neg (nk-var #0)) (nk-lam (nk-up2 (nk-nth args #1)))) (nk-cons (nk-br (nk-var #0) (nk-lam (nk-up2 (nk-nth args #2)))) (nk-sys-app bs)))) (nk-app (nk-up u0) (nk-var #0)))
  else (if %weq c #6 then nk-hcomp-sig (nk-nth args #0) (nk-nth args #1) bs u0
  else (if %weq c #7 then nk-hcomp-glue (nk-nth args #0) (nk-args (nk-nth args #1)) bs u0
  else (if %weq c #2 then nk-hcomp-u bs u0
  else nk-hcomp (nk-con c args) (nk-sys bs) u0))))))
nk-hcomp-at ty bs u0 = nk-hcomp ty (nk-sys bs) u0
