-- ---------------------------------------------------------------- reading and writing through the world
-- n bytes at a, little-endian, by w-load8 / w-store8
fl-rd-n : Nat → Word → Step W Word
fl-rd-n zero a = sdone #0
fl-rd-n (suc n) a = scmd (w-load8 a) (λ b → o-map {W} {Word} {Word} (λ r → wor (wand b #255) (wshl r #8)) (fl-rd-n n (wadd a #1)))
