-- the graph's JSON (lib/views.cub), made again only when the source has changed: kept beside the view's
-- stamp it was made at (STORE/index/meta/stamp, which moves exactly when an entry is added), so a reader
-- waits for it once per change of the source, and the child at start makes it before any reader
s-graph-kept : List Word → List Word → Sum Unit (List Word) → Proc W Word
s-graph-kept st s (inl u) = ret #0
s-graph-kept st s (inr j) = bind (h-write (list-append st "/views/source-stamp") s) (λ ok → ret {lzero} {W} #0)
