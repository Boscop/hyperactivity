-- 3-Cell type between parallel 2-cell homotopies (cube filler / higher coherence):
WCell3 : {a b : WExpr} → {p q : WEdge a b} → WCell2 p q → WCell2 p q → Type
WCell3 α β = (env : Word → Bool) → α env ≡ β env

-- Hedberg / Discrete Decidability on Bool -> constructive 2-cell & 3-cell coherence!
-- Any two 1-paths p, q : x ≡ y in Bool are connected by a 2-cell, and any two 2-cells by a 3-cell!
web-bool-code : Bool → Bool → Type
web-bool-code true  true  = Unit
web-bool-code false false = Unit
web-bool-code _     _     = Empty

web-bool-r : (x : Bool) → web-bool-code x x
web-bool-r true  = unit
web-bool-r false = unit

web-bool-encode : {x y : Bool} → x ≡ y → web-bool-code x y
web-bool-encode {x} p = transport (λ i → web-bool-code x (p i)) (web-bool-r x)

web-bool-decode : (x y : Bool) → web-bool-code x y → x ≡ y
web-bool-decode true  true  _ = refl
web-bool-decode false false _ = refl
web-bool-decode true  false e = Empty-rec e
web-bool-decode false true  e = Empty-rec e

-- Every path p : x ≡ y in Bool is homotopic (by a genuine Cubical 2-cell!) to `web-bool-decode x y (encode p)`
-- via J-induction on the path endpoint `p` (filling the square along the interval `j`):
web-j-bool : (x : Bool) → (P : (y : Bool) → x ≡ y → Type) → P x refl → (y : Bool) → (p : x ≡ y) → P y p
web-j-bool x P base y p = transport (λ i → P (p i) (λ j → p (i ∧ j))) base

-- 2-CELL: Exact Involution of Path Inversion (`sym (sym p) ≡ p` — strict refl in Cubical!)
w2-sym-sym : {x y : Bool} → (p : x ≡ y) → web-sym-b (web-sym-b p) ≡ p
w2-sym-sym p = refl

-- 2-CELL: Left Unit Coherence (`refl ∙ p ≡ p`)
w2-refl-l : {x y : Bool} → (p : x ≡ y) → web-trans-b refl p ≡ p
w2-refl-l {x} {y} p = web-j-bool x (λ z q → web-trans-b refl q ≡ q) (λ k i → comp (λ j → Bool) (λ j → [ i = 0 ↦ x , i = 1 ↦ x , k = 1 ↦ x ]) x) y p

-- 2-CELL: Right Unit Coherence (`p ∙ refl ≡ p`)
w2-refl-r : {x y : Bool} → (p : x ≡ y) → web-trans-b p refl ≡ p
w2-refl-r {x} {y} p = web-j-bool x (λ z q → web-trans-b q refl ≡ q) (λ k i → comp (λ j → Bool) (λ j → [ i = 0 ↦ x , i = 1 ↦ x , k = 1 ↦ x ]) x) y p

-- 2-CELL: Right Inverse / Gauge Cancellation (`p ∙ sym p ≡ refl` — eliminates loop redundancy!)
w2-inv-r : {x y : Bool} → (p : x ≡ y) → web-trans-b p (web-sym-b p) ≡ refl
w2-inv-r {x} {y} p = web-j-bool x (λ z q → web-trans-b q (web-sym-b q) ≡ refl) (λ k i → comp (λ j → Bool) (λ j → [ i = 0 ↦ x , i = 1 ↦ x , k = 1 ↦ x ]) x) y p

-- 2-CELL: Mac Lane Associator (`(p ∙ q) ∙ r ≡ p ∙ (q ∙ r)`)
w2-assoc-base : {x y z : Bool} → (p : x ≡ y) → (q : y ≡ z) → web-trans-b (web-trans-b p q) refl ≡ web-trans-b p (web-trans-b q refl)
w2-assoc-base {x} {y} {z} p q =
  let h1 = w2-refl-r (web-trans-b p q)
      h2 = λ k → web-trans-b p (w2-refl-r q (~ k))
  in λ i → comp (λ j → x ≡ z) (λ j → [ i = 0 ↦ web-trans-b (web-trans-b p q) refl , i = 1 ↦ h2 j ]) (h1 i)

w2-assoc : {x y z w : Bool} → (p : x ≡ y) → (q : y ≡ z) → (r : z ≡ w) →
  web-trans-b (web-trans-b p q) r ≡ web-trans-b p (web-trans-b q r)
w2-assoc {x} {y} {z} {w} p q r =
  web-j-bool z (λ u s → web-trans-b (web-trans-b p q) s ≡ web-trans-b p (web-trans-b q s)) (w2-assoc-base p q) w r

-- Universal 2-Cell Confluence on Bool (Hedberg/UIP via constant retraction `k_xy`):
-- Any two parallel 1-cells p, q : x ≡ y in Bool are connected by an explicit 2-cell!
web-const-path : (x y : Bool) → x ≡ y → x ≡ y
web-const-path x y p = web-bool-decode x y (web-bool-encode p)

web-const-eq : (x y : Bool) → (p q : x ≡ y) → web-const-path x y p ≡ web-const-path x y q
web-const-eq true  true  p q = refl
web-const-eq false false p q = refl
web-const-eq true  false p q = Empty-rec (web-bool-encode p)
web-const-eq false true  p q = Empty-rec (web-bool-encode p)

web-retract-base : (x : Bool) → web-const-path x x refl ≡ refl
web-retract-base true  = refl
web-retract-base false = refl

web-retract : {x y : Bool} → (p : x ≡ y) → web-const-path x y p ≡ p
web-retract {x} {y} p = web-j-bool x (λ z q → web-const-path x z q ≡ q) (web-retract-base x) y p

w2-bool-confluence : {x y : Bool} → (p q : x ≡ y) → p ≡ q
w2-bool-confluence {x} {y} p q =
  let a = λ i → web-retract p (~ i)
      b = web-const-eq x y p q
      c = web-retract q
      ab = λ i → comp (λ j → x ≡ y) (λ j → [ i = 0 ↦ p , i = 1 ↦ b j ]) (a i)
  in λ i → comp (λ j → x ≡ y) (λ j → [ i = 0 ↦ p , i = 1 ↦ c j ]) (ab i)

-- UNIVERSAL 2-CELL CONFLUENCE FOR ANY TWO PARALLEL WEB CONTRACTION PATHS (PRUNES k! ORDERS TO 1!):
w2-web-confluence : {a b : WExpr} → (p q : WEdge a b) → WCell2 p q
w2-web-confluence p q env = w2-bool-confluence (p env) (q env)

-- 3-CELL: Cube-Filler Coherence — Any 2-cell α : p ≡ q on Bool contracts via J-induction on the 2-cell!
-- Proves that NO higher gauge redundancy survives above dimension 2 on Boolean contraction webs!
web-j-path2 : {x y : Bool} → (p : x ≡ y) → (P : (q : x ≡ y) → p ≡ q → Type) → P p refl → (q : x ≡ y) → (α : p ≡ q) → P q α
web-j-path2 {x} {y} p P base q α = transport (λ i → P (α i) (λ j → α (i ∧ j))) base

-- 3-CELL: Genuine Cubical 3-Cube Filler proving ANY 2-cell loop α : p ≡ p contracts to refl,
-- and ANY two parallel 2-cells α, β : p ≡ q are connected by a 3-cell (α ≡ β)!
w3-bool-loop : {x y : Bool} → (p : x ≡ y) → (α : p ≡ p) → α ≡ refl
w3-bool-loop {x} {y} p α =
  let c0 = w2-bool-confluence p p
      sq = λ i j → w2-bool-confluence p (α i) j
  in λ k i → comp (λ j → x ≡ y) (λ j → [ i = 0 ↦ c0 j , i = 1 ↦ c0 j , k = 0 ↦ sq i j , k = 1 ↦ c0 j ]) p

w3-bool-coherence : {x y : Bool} → {p q : x ≡ y} → (α β : p ≡ q) → α ≡ β
w3-bool-coherence {x} {y} {p} {q} α β =
  web-j-path2 p (λ r γ → (δ : p ≡ r) → γ ≡ δ) (λ δ → λ k → w3-bool-loop p δ (~ k)) q α β

-- UNIVERSAL 3-CELL COHERENCE FOR ANY TWO PARALLEL 2-CELLS IN THE WEB OF IDENTITY!
w3-web-coherence : {a b : WExpr} → {p q : WEdge a b} → (α β : WCell2 p q) → WCell3 α β
w3-web-coherence α β env = w3-bool-coherence (α env) (β env)

