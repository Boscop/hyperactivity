data FExpr : Type where
  fk   : Bool → FExpr
  fv   : Word → FExpr
  fxor : FExpr → FExpr → FExpr
  fand : FExpr → FExpr → FExpr

feval : (Word → Bool) → FExpr → Bool
feval d (fk b)     = b
feval d (fv i)     = d i
feval d (fxor a b) = web-xorB (feval d a) (feval d b)
feval d (fand a b) = web-andB (feval d a) (feval d b)

f-opt-val : (Word → Bool) → Word → Opt Bool → Bool
f-opt-val d i none     = d i
f-opt-val d i (some b) = b

f-merge : (Word → Opt Bool) → (Word → Bool) → Word → Bool
f-merge s d i = f-opt-val d i (s i)

f-opt-expr : Word → Opt Bool → FExpr
f-opt-expr i none     = fv i
f-opt-expr i (some b) = fk b

f-mk-xor : FExpr → FExpr → FExpr
f-mk-xor (fk false) b          = b
f-mk-xor (fk true)  (fk false) = fk true
f-mk-xor (fk true)  (fk true)  = fk false
f-mk-xor a          (fk false) = a
f-mk-xor a          b          = fxor a b

f-mk-and : FExpr → FExpr → FExpr
f-mk-and (fk false) _          = fk false
f-mk-and (fk true)  b          = b
f-mk-and a          (fk false) = fk false
f-mk-and a          (fk true)  = a
f-mk-and a          b          = fand a b

f-mix : (Word → Opt Bool) → FExpr → FExpr
f-mix s (fk b)     = fk b
f-mix s (fv i)     = f-opt-expr i (s i)
f-mix s (fxor a b) = f-mk-xor (f-mix s a) (f-mix s b)
f-mix s (fand a b) = f-mk-and (f-mix s a) (f-mix s b)

f-lem-mk-xor : (d : Word → Bool) → (a b : FExpr) → feval d (f-mk-xor a b) ≡ web-xorB (feval d a) (feval d b)
f-lem-mk-xor d (fk false) b          = web-sym-b (web-lem-xor-0l (feval d b))
f-lem-mk-xor d (fk true)  (fk false) = refl
f-lem-mk-xor d (fk true)  (fk true)  = refl
f-lem-mk-xor d (fk true)  (fv _)     = refl
f-lem-mk-xor d (fk true)  (fxor _ _) = refl
f-lem-mk-xor d (fk true)  (fand _ _) = refl
f-lem-mk-xor d (fv i)     (fk false) = web-sym-b (web-lem-xor-0r (d i))
f-lem-mk-xor d (fv _)     (fk true)  = refl
f-lem-mk-xor d (fv _)     (fv _)     = refl
f-lem-mk-xor d (fv _)     (fxor _ _) = refl
f-lem-mk-xor d (fv _)     (fand _ _) = refl
f-lem-mk-xor d (fxor x y) (fk false) = web-sym-b (web-lem-xor-0r (web-xorB (feval d x) (feval d y)))
f-lem-mk-xor d (fxor _ _) (fk true)  = refl
f-lem-mk-xor d (fxor _ _) (fv _)     = refl
f-lem-mk-xor d (fxor _ _) (fxor _ _) = refl
f-lem-mk-xor d (fxor _ _) (fand _ _) = refl
f-lem-mk-xor d (fand x y) (fk false) = web-sym-b (web-lem-xor-0r (web-andB (feval d x) (feval d y)))
f-lem-mk-xor d (fand _ _) (fk true)  = refl
f-lem-mk-xor d (fand _ _) (fv _)     = refl
f-lem-mk-xor d (fand _ _) (fxor _ _) = refl
f-lem-mk-xor d (fand _ _) (fand _ _) = refl

f-lem-mk-and : (d : Word → Bool) → (a b : FExpr) → feval d (f-mk-and a b) ≡ web-andB (feval d a) (feval d b)
f-lem-mk-and d (fk false) _          = refl
f-lem-mk-and d (fk true)  _          = refl
f-lem-mk-and d (fv i)     (fk false) = web-sym-b (web-lem-and-0r (d i))
f-lem-mk-and d (fv i)     (fk true)  = web-sym-b (web-lem-and-1r (d i))
f-lem-mk-and d (fv _)     (fv _)     = refl
f-lem-mk-and d (fv _)     (fxor _ _) = refl
f-lem-mk-and d (fv _)     (fand _ _) = refl
f-lem-mk-and d (fxor x y) (fk false) = web-sym-b (web-lem-and-0r (web-xorB (feval d x) (feval d y)))
f-lem-mk-and d (fxor x y) (fk true)  = web-sym-b (web-lem-and-1r (web-xorB (feval d x) (feval d y)))
f-lem-mk-and d (fxor _ _) (fv _)     = refl
f-lem-mk-and d (fxor _ _) (fxor _ _) = refl
f-lem-mk-and d (fxor _ _) (fand _ _) = refl
f-lem-mk-and d (fand x y) (fk false) = web-sym-b (web-lem-and-0r (web-andB (feval d x) (feval d y)))
f-lem-mk-and d (fand x y) (fk true)  = web-sym-b (web-lem-and-1r (web-andB (feval d x) (feval d y)))
f-lem-mk-and d (fand _ _) (fv _)     = refl
f-lem-mk-and d (fand _ _) (fxor _ _) = refl
f-lem-mk-and d (fand _ _) (fand _ _) = refl

f-lem-var : (d : Word → Bool) → (i : Word) → (o : Opt Bool) →
