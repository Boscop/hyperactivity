data WAtom : Type where
  wa-refl          : WExpr → WAtom
  wa-sym           : WAtom → WAtom
  wa-cong-not      : WAtom → WAtom
  wa-cong-xor      : WAtom → WAtom → WAtom
  wa-cong-and      : WAtom → WAtom → WAtom
  wa-cong-or       : WAtom → WAtom → WAtom
  wa-xor-self      : WExpr → WAtom
  wa-xor-0l        : WExpr → WAtom
  wa-xor-0r        : WExpr → WAtom
  wa-xor-comm      : WExpr → WExpr → WAtom
  wa-xor-assoc     : WExpr → WExpr → WExpr → WAtom
  wa-and-self      : WExpr → WAtom
  wa-and-0l        : WExpr → WAtom
  wa-and-0r        : WExpr → WAtom
  wa-and-1l        : WExpr → WAtom
  wa-and-1r        : WExpr → WAtom
  wa-and-comm      : WExpr → WExpr → WAtom
  wa-and-distrib-l : WExpr → WExpr → WExpr → WAtom
  wa-not-xor       : WExpr → WAtom
  wa-or-anf        : WExpr → WExpr → WAtom
  wa-ch-def        : WExpr → WExpr → WExpr → WAtom
  wa-ch-mc1        : WExpr → WExpr → WExpr → WAtom
  wa-maj-def       : WExpr → WExpr → WExpr → WAtom
  wa-maj-mc1       : WExpr → WExpr → WExpr → WAtom

wa-ends : WAtom → WExpr × WExpr
wa-ends (wa-refl e)              = (e , e)
wa-ends (wa-sym r)               = let p = wa-ends r in (snd p , fst p)
wa-ends (wa-cong-not r)          = let p = wa-ends r in (we-not (fst p) , we-not (snd p))
wa-ends (wa-cong-xor r1 r2)      = let p1 = wa-ends r1 in let p2 = wa-ends r2 in (we-xor (fst p1) (fst p2) , we-xor (snd p1) (snd p2))
wa-ends (wa-cong-and r1 r2)      = let p1 = wa-ends r1 in let p2 = wa-ends r2 in (we-and (fst p1) (fst p2) , we-and (snd p1) (snd p2))
wa-ends (wa-cong-or  r1 r2)      = let p1 = wa-ends r1 in let p2 = wa-ends r2 in (we-or  (fst p1) (fst p2) , we-or  (snd p1) (snd p2))
wa-ends (wa-xor-self a)          = (we-xor a a , we-k false)
wa-ends (wa-xor-0l a)            = (we-xor (we-k false) a , a)
wa-ends (wa-xor-0r a)            = (we-xor a (we-k false) , a)
wa-ends (wa-xor-comm a b)        = (we-xor a b , we-xor b a)
wa-ends (wa-xor-assoc a b c)     = (we-xor (we-xor a b) c , we-xor a (we-xor b c))
wa-ends (wa-and-self a)          = (we-and a a , a)
wa-ends (wa-and-0l a)            = (we-and (we-k false) a , we-k false)
wa-ends (wa-and-0r a)            = (we-and a (we-k false) , we-k false)
wa-ends (wa-and-1l a)            = (we-and (we-k true) a , a)
wa-ends (wa-and-1r a)            = (we-and a (we-k true) , a)
wa-ends (wa-and-comm a b)        = (we-and a b , we-and b a)
wa-ends (wa-and-distrib-l a b c) = (we-and a (we-xor b c) , we-xor (we-and a b) (we-and a c))
wa-ends (wa-not-xor a)           = (we-not a , we-xor a (we-k true))
wa-ends (wa-or-anf a b)          = (we-or a b , we-xor (we-xor a b) (we-and a b))
wa-ends (wa-ch-def e f g)        = (we-ch e f g , we-xor (we-and e f) (we-and (we-not e) g))
wa-ends (wa-ch-mc1 e f g)        = (we-ch e f g , we-xor g (we-and e (we-xor f g)))
wa-ends (wa-maj-def a b c)       = (we-maj a b c , we-xor (we-and a b) (we-xor (we-and a c) (we-and b c)))
wa-ends (wa-maj-mc1 a b c)       = (we-maj a b c , we-xor a (we-and (we-xor a b) (we-xor a c)))

wa-lhs : WAtom → WExpr
wa-lhs r = fst (wa-ends r)

wa-rhs : WAtom → WExpr
wa-rhs r = snd (wa-ends r)

