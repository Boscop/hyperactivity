web-notB : Bool → Bool
web-notB true  = false
web-notB false = true

web-xorB : Bool → Bool → Bool
web-xorB true  true  = false
web-xorB true  false = true
web-xorB false true  = true
web-xorB false false = false

web-andB : Bool → Bool → Bool
web-andB true  b = b
web-andB false _ = false

web-orB : Bool → Bool → Bool
web-orB true  _ = true
web-orB false b = b

web-chB : Bool → Bool → Bool → Bool
web-chB e f g = web-xorB (web-andB e f) (web-andB (web-notB e) g)

web-majB : Bool → Bool → Bool → Bool
web-majB a b c = web-xorB (web-andB a b) (web-xorB (web-andB a c) (web-andB b c))

-- 0-Cells: Universal Web Expression IR (Boolean / F2-ANF / CNF-Clause / SHA-256 Gate / Tensor AST)
data WExpr : Type where
  we-k   : Bool → WExpr
  we-v   : Word → WExpr
  we-not : WExpr → WExpr
  we-xor : WExpr → WExpr → WExpr
  we-and : WExpr → WExpr → WExpr
  we-or  : WExpr → WExpr → WExpr
  we-ch  : WExpr → WExpr → WExpr → WExpr
  we-maj : WExpr → WExpr → WExpr → WExpr

weval : (Word → Bool) → WExpr → Bool
weval env (we-k b)       = b
weval env (we-v i)       = env i
weval env (we-not a)     = web-notB (weval env a)
weval env (we-xor a b)   = web-xorB (weval env a) (weval env b)
weval env (we-and a b)   = web-andB (weval env a) (weval env b)
weval env (we-or  a b)   = web-orB  (weval env a) (weval env b)
weval env (we-ch  e f g) = web-chB  (weval env e) (weval env f) (weval env g)
weval env (we-maj a b c) = web-majB (weval env a) (weval env b) (weval env c)

-- Cost Functors on the SAME Web of Identity
wcost-size : WExpr → Word
wcost-size (we-k _)       = #1
wcost-size (we-v _)       = #1
wcost-size (we-not a)     = %wadd #1 (wcost-size a)
wcost-size (we-xor a b)   = %wadd #1 (%wadd (wcost-size a) (wcost-size b))
wcost-size (we-and a b)   = %wadd #1 (%wadd (wcost-size a) (wcost-size b))
wcost-size (we-or  a b)   = %wadd #1 (%wadd (wcost-size a) (wcost-size b))
wcost-size (we-ch  e f g) = %wadd #4 (%wadd (wcost-size e) (%wadd (wcost-size f) (wcost-size g)))
wcost-size (we-maj a b c) = %wadd #5 (%wadd (wcost-size a) (%wadd (wcost-size b) (wcost-size c)))

wcost-mc : WExpr → Word
wcost-mc (we-k _)       = #0
wcost-mc (we-v _)       = #0
wcost-mc (we-not a)     = wcost-mc a
wcost-mc (we-xor a b)   = %wadd (wcost-mc a) (wcost-mc b)
wcost-mc (we-and a b)   = %wadd #1 (%wadd (wcost-mc a) (wcost-mc b))
wcost-mc (we-or  a b)   = %wadd #1 (%wadd (wcost-mc a) (wcost-mc b))
wcost-mc (we-ch  e f g) = %wadd #2 (%wadd (wcost-mc e) (%wadd (wcost-mc f) (wcost-mc g)))
wcost-mc (we-maj a b c) = %wadd #3 (%wadd (wcost-mc a) (%wadd (wcost-mc b) (wcost-mc c)))

-- 1-Cells: Cubical Path Groupoid on Bool & on WExpr
web-sym-b : {x y : Bool} → x ≡ y → y ≡ x
web-sym-b p = λ i → p (~ i)

web-trans-b : {x y z : Bool} → x ≡ y → y ≡ z → x ≡ z
web-trans-b {x} {y} {z} p q = λ i → comp (λ j → Bool) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

WEdge : WExpr → WExpr → Type
WEdge a b = (env : Word → Bool) → weval env a ≡ weval env b

we-refl : (a : WExpr) → WEdge a a
we-refl a env = refl

we-sym : {a b : WExpr} → WEdge a b → WEdge b a
we-sym p env = web-sym-b (p env)

we-trans : {a b c : WExpr} → WEdge a b → WEdge b c → WEdge a c
we-trans p q env = web-trans-b (p env) (q env)

-- Productive Identity Generation: two contraction paths (p : a===b, q : a===c) produce NEW identity (b===c)!
web-derive-id : {a b c : WExpr} → WEdge a b → WEdge a c → WEdge b c
web-derive-id p q = we-trans (we-sym p) q

