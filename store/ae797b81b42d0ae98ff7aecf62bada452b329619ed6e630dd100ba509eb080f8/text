-- Bidirectional Lossless Transport (1-Cell in the Groupoid of Representations!)
WEquiv : Type → Type → Type
WEquiv A B = (f : A → B) × ((g : B → A) × (((b : B) → Path B (f (g b)) b) × ((a : A) → Path A (g (f a)) a)))

wequiv-to : {A B : Type} → WEquiv A B → A → B
wequiv-to e = fst e

wequiv-from : {A B : Type} → WEquiv A B → B → A
wequiv-from e = fst (snd e)

wequiv-refl : (A : Type) → WEquiv A A
wequiv-refl A = ((λ x → x) , ((λ x → x) , ((λ _ → refl) , (λ _ → refl))))

wequiv-sym : {A B : Type} → WEquiv A B → WEquiv B A
wequiv-sym e = (fst (snd e) , (fst e , (snd (snd (snd e)) , fst (snd (snd e)))))

-- Composition of Representation Transports (transitivity in the ∞-Groupoid of Representations!)
wequiv-comp-path : {A : Type} → {x y z : A} → Path A x y → Path A y z → Path A x z
wequiv-comp-path {A} {x} {y} {z} p q = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

wequiv-comp : {A B C : Type} → WEquiv A B → WEquiv B C → WEquiv A C
wequiv-comp e1 e2 =
  let f1 = fst e1
      g1 = fst (snd e1)
      s1 = fst (snd (snd e1))
      r1 = snd (snd (snd e1))
      f2 = fst e2
      g2 = fst (snd e2)
      s2 = fst (snd (snd e2))
      r2 = snd (snd (snd e2))
  in ((λ a → f2 (f1 a)) ,
     ((λ c → g1 (g2 c)) ,
     ((λ c → wequiv-comp-path (λ i → f2 (s1 (g2 c) i)) (s2 c)) ,
      (λ a → wequiv-comp-path (λ i → g1 (r2 (f1 a) i)) (r1 a)))))

-- Non-trivial Automorphism 1-Cell on Bool (`notB : Bool ≃ Bool`, a non-trivial loop in Type!)
wt-lem-not-inv : (b : Bool) → web-notB (web-notB b) ≡ b
wt-lem-not-inv true  = refl
wt-lem-not-inv false = refl

wt-equiv-not : WEquiv Bool Bool
wt-equiv-not = (web-notB , (web-notB , (wt-lem-not-inv , wt-lem-not-inv)))

-- Bidirectional Delta-XOR Stream Transport (Lossless Compression 1-Cell on ALL Bitstreams!)
wt-delta-enc : Bool → List Bool → List Bool
wt-delta-enc _ nil = nil
wt-delta-enc p (cons x r) = cons (web-xorB p x) (wt-delta-enc x r)

wt-delta-dec : Bool → List Bool → List Bool
wt-delta-dec _ nil = nil
wt-delta-dec p (cons d r) = let x = web-xorB p d in cons x (wt-delta-dec x r)

wt-thm-delta-rt : (p : Bool) → (xs : List Bool) → wt-delta-dec p (wt-delta-enc p xs) ≡ xs
wt-thm-delta-rt _ nil = refl
wt-thm-delta-rt true  (cons true  r) = λ i → cons true  (wt-thm-delta-rt true  r i)
wt-thm-delta-rt true  (cons false r) = λ i → cons false (wt-thm-delta-rt false r i)
wt-thm-delta-rt false (cons true  r) = λ i → cons true  (wt-thm-delta-rt true  r i)
wt-thm-delta-rt false (cons false r) = λ i → cons false (wt-thm-delta-rt false r i)

wt-thm-delta-sec : (p : Bool) → (ds : List Bool) → wt-delta-enc p (wt-delta-dec p ds) ≡ ds
wt-thm-delta-sec _ nil = refl
wt-thm-delta-sec true  (cons true  r) = λ i → cons true  (wt-thm-delta-sec false r i)
wt-thm-delta-sec true  (cons false r) = λ i → cons false (wt-thm-delta-sec true  r i)
wt-thm-delta-sec false (cons true  r) = λ i → cons true  (wt-thm-delta-sec true  r i)
wt-thm-delta-sec false (cons false r) = λ i → cons false (wt-thm-delta-sec false r i)

-- Complete Bidirectional Lossless Equivalence 1-Cell for ALL Bitstreams:
wt-equiv-delta : (p : Bool) → WEquiv (List Bool) (List Bool)
wt-equiv-delta p = (wt-delta-enc p , (wt-delta-dec p , (wt-thm-delta-sec p , wt-thm-delta-rt p)))

-- Composed Lossless Transport (2nd-order Delta-Delta Transport across the Groupoid of Representations!):
wt-equiv-delta2 : (p : Bool) → WEquiv (List Bool) (List Bool)
wt-equiv-delta2 p = wequiv-comp (wt-equiv-delta p) (wt-equiv-delta (web-notB p))

