-- ---------------------------------------------------------------- steps commute
-- wire u is none of the wires a plan changes; such a wire reads the same after the plan
nk-apart : NkW → NkFx → Type
nk-apart u nkf-nil = Unit
nk-apart u (nkf-at k c r) = (nk-weq u k ≡ false) × ((nk-weq k u ≡ false) × nk-apart u r)
