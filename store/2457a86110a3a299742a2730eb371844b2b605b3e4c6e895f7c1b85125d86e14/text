-- Exact rANS single-step encoder and decoder
rans-enc-step : FTbl → Word → Word → Word
rans-enc-step tbl s x =
  let M = ftbl-total tbl
  in case ftbl-find #0 x tbl of
       none → s
       some cf →
         let C = fst cf
             f = snd cf
         in wadd (wmul (wquot s f) M) (wadd C (wrem s f))
