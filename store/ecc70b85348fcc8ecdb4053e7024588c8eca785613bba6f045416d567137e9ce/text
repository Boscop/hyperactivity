-- pieces written to the descriptor, as they are read
c-put-pieces : Word → List (List Word) → Proc W Unit
c-put-pieces fd nil = ret unit
c-put-pieces fd (cons pc r) = bind (h-read (list-append h-source (cons #47 (list-append pc "/text")))) (λ t →
  bind (fd-write fd (h-source-or t)) (λ w → c-put-pieces fd r))
