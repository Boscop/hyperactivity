s-tune-sock : Word → Proc W Unit
s-tune-sock c =
  bind (with-bytes {Unit} #16 (λ tv →
    bind (h-poke tv (s-tv16 #10)) (λ u1 →
    bind (sys-call #54 c #1 #20 tv #16 #0) (λ r1 →
    bind (h-poke tv (s-tv16 #15)) (λ u2 →
    bind (sys-call #54 c #1 #21 tv #16 #0) (λ r2 → ret {lzero} {W} unit)))))) (λ u3 →
  bind (with-bytes {Unit} #4 (λ one →
    bind (h-poke one (cons #1 (cons #0 (cons #0 (cons #0 nil))))) (λ u4 →
    bind (sys-call #54 c #6 #1 one #4 #0) (λ r3 → ret {lzero} {W} unit)))) (λ u5 →
  ret {lzero} {W} unit))
