-- (part of language-support)
idiv_spec_64 : (dst' : Bits #128) → (src : Bits #64) → (Bool × (Bits #64) × (Bits #64))
idiv_spec_64 dst' src =
  let dst_int : Bits #128
      dst_int = dst'
      src_int : Bits #64
      src_int = src
      quotient_int : Bits #129
      quotient_int = (bits_of_int (z-tdiv (bv-signed #128 dst_int) (bv-signed #64 src_int)) (zpos #129))
      remainder_int : Bits #64
      remainder_int = (bits_of_int (z-tmod (bv-signed #128 dst_int) (bv-signed #64 src_int)) (zpos #64))
      overflow? : Bool
      overflow? = (b-or (z-lt (bv-signed #129 quotient_int) (zneg #9223372036854775808)) (z-lt (zpos #9223372036854775807) (bv-signed #129 quotient_int)))
      t'1 : (Bool × (Bits #64) × (Bits #64))
      t'1 =
        if overflow? then
          (true , #0 , #0)
        else
          (let quotient : Bits #64
               quotient = (bv-trunc #129 #64 quotient_int)
               remainder : Bits #64
               remainder = remainder_int
           in (overflow? , quotient , remainder))
  in t'1
