fd-ok : (b : Nat → Nat) → (n bp : Nat) → (out : FdFrame) → fd-ltb n fd-four ≡ false → fd-ltb (fd-monus n fd-four) (fd-len b) ≡ false →
  fd-decode b n bp out ≡ (true , (fd-tag b , fd-len b , plus bp fd-four))
fd-ok b n bp out h1 h2 = λ k →
  if h1 k then (false , out)
  else (if h2 k then (false , out) else (true , (fd-tag b , fd-len b , plus bp fd-four)))
