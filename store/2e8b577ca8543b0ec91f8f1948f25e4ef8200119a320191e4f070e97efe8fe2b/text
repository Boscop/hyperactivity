sm-demo-term : Word → SmTm
sm-demo-term x = sm-inc (sm-app (sm-lam (sm-app (sm-lam (sm-app (sm-var #0) (sm-app (sm-var #0) (sm-num x)))) (sm-lam (sm-app (sm-var #1) (sm-var #0))))) (sm-lam (sm-inc (sm-var #0))))
