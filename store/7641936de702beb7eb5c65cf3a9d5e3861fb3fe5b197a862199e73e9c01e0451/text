-- ---------------------------------------------------------------- 4. Template-by-template soundness and UB-freedom theorems
-- Template: cvar
cs-var-template-sound : (k j : Nat) (fns : CsFns) (ars : Lst (Word × Word)) (hp : CsHeap) (env : CsEnv) (d n : Word) (v : CsVal) →
  (cs-get-var env (%wsub (%wsub d #1) n) ≡ some v) →
  cs-eval (suc k) fns hp env (cs-compile (suc j) ars d (cvar n)) ≡ cs-ok hp v
cs-var-template-sound k j fns ars hp env d n v h =
  cong (λ o → cs-bind-opt o (λ x → cs-ok hp x)) h
