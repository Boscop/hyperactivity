all-f3-sound : (p : Fin3 → Bool) → all-f3 p ≡ true → (x : Fin3) → p x ≡ true
all-f3-sound p h f3-0 = andB-l (p f3-0) (andB (p f3-1) (p f3-2)) h
all-f3-sound p h f3-1 = andB-l (p f3-1) (p f3-2) (andB-r (p f3-0) (andB (p f3-1) (p f3-2)) h)
all-f3-sound p h f3-2 = andB-r (p f3-1) (p f3-2) (andB-r (p f3-0) (andB (p f3-1) (p f3-2)) h)
