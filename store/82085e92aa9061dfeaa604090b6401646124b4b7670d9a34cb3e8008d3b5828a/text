-- maximal: no suffix among the k from q has a longer common prefix with t
best-match-max : (t ts : List (List Word)) → (k q : Nat) → (s : List (List Word)) → s ≡ drop-n q ts →
                 (j : Nat) → isTrue (ltn j k) → ltn (fst (best-match t k q s)) (lcp (drop-n (plus q j) ts) t) ≡ false
best-match-max t ts k =
  case k return λ w → (q : Nat) → (s : List (List Word)) → s ≡ drop-n q ts →
                      (j : Nat) → isTrue (ltn j w) → ltn (fst (best-match t w q s)) (lcp (drop-n (plus q j) ts) t) ≡ false of
    zero → λ q s es j hj → Empty-rec (ltn-zero-r j hj)
    suc k1 →
      λ q s es j →
        case j return λ w → isTrue (ltn w (suc k1)) → ltn (fst (best-match t (suc k1) q s)) (lcp (drop-n (plus q w) ts) t) ≡ false of
          zero →
            λ hj →
              concat
                (cong (ltn (fst (best-match t (suc k1) q s)))
                   (cong (λ u → lcp u t) (concat (cong (λ n → drop-n n ts) (plus-zero q)) (sym es))))
                (best-ge-a (lcp s t) q (best-match t k1 (suc q) (tail-of s)))
          suc j1 →
            λ hj →
              concat
                (cong (ltn (fst (best-match t (suc k1) q s))) (cong (λ n → lcp (drop-n n ts) t) (plus-suc q j1)))
                (best-ge-b (lcp s t) q (best-match t k1 (suc q) (tail-of s)) (lcp (drop-n (suc (plus q j1)) ts) t)
                   (rec k1 (suc q) (tail-of s) (concat (cong tail-of es) (sym (drop-suc q ts))) j1 hj))
