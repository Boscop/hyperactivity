kc-xor-block : Nat → Word → List Word → List UInt64 → List UInt64
kc-xor-block zero    idx blk st = st
kc-xor-block (suc n) idx blk st =
  let lane = kc-le64 (toNat #8) #0 blk
      st2  = kc-set64 idx (u64xor (kc-nth64 idx st) lane) st
  in kc-xor-block n (%wadd idx #1) (kc-drop (toNat #8) blk) st2
