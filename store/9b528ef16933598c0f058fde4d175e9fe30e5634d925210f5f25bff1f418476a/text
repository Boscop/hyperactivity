<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 920 200" width="920" height="200" role="img" aria-label="Decentralized Content-Addressed P2P Knowledge Graph">
  <style>
    .bg { fill: #000000; }
    .frame { fill: none; stroke: #ffffff; stroke-width: 1.5; }
    .lbl { fill: #ffffff; font: 700 11.5px ui-monospace, 'SF Mono', Menlo, monospace; text-anchor: middle; dominant-baseline: central; }
    .pink { fill: #ff0a94; font: 700 11px ui-monospace, 'SF Mono', Menlo, monospace; }
    .blue { fill: #4da3ff; font: 700 11px ui-monospace, 'SF Mono', Menlo, monospace; }
    .sub { fill: rgba(255,255,255,0.65); font: 600 10.5px ui-monospace, 'SF Mono', Menlo, monospace; text-anchor: middle; }
    @keyframes pulse { 0% { r: 22; opacity: 0.9; } 100% { r: 38; opacity: 0; } }
    .ring { fill: none; stroke: #ff0a94; stroke-width: 1.8; animation: pulse 2.4s ease-out infinite; }
    .ring2 { fill: none; stroke: #4da3ff; stroke-width: 1.8; animation: pulse 2.4s ease-out 1.2s infinite; }
  </style>
  <rect class="bg" width="920" height="200"/>
  <rect class="frame" x="1" y="1" width="918" height="198"/>
  <text class="pink" x="24" y="26">◈ DECENTRALIZED HYPERACTIVE WEB · CONTENT-ADDRESSED SET UNION · WEBRTC P2P + WASM</text>

  <!-- Edges -->
  <line x1="150" y1="112" x2="365" y2="82" stroke="#4da3ff" stroke-width="1.8"/>
  <line x1="150" y1="112" x2="365" y2="148" stroke="#ff0a94" stroke-width="1.8"/>
  <line x1="365" y1="82" x2="585" y2="112" stroke="#ff0a94" stroke-width="2"/>
  <line x1="365" y1="148" x2="585" y2="112" stroke="#4da3ff" stroke-width="2"/>
  <line x1="585" y1="112" x2="795" y2="112" stroke="#ffffff" stroke-width="1.6" stroke-dasharray="5 5"/>

  <!-- Packets -->
  <circle r="4" fill="#ff0a94"><animateMotion dur="1.8s" repeatCount="indefinite" path="M 365 82 L 585 112"/></circle>
  <circle r="4" fill="#4da3ff"><animateMotion dur="2.1s" repeatCount="indefinite" path="M 585 112 L 365 148"/></circle>
  <circle r="3.5" fill="#ffffff"><animateMotion dur="2.2s" repeatCount="indefinite" path="M 150 112 L 365 82"/></circle>

  <!-- Nodes -->
  <circle cx="150" cy="112" r="24" fill="#000" stroke="#ffffff" stroke-width="2"/>
  <text class="lbl" x="150" y="112">store/</text>
  <text class="sub" x="150" y="152">SHA-256 pool</text>

  <circle class="ring" cx="365" cy="82" r="22"/>
  <circle cx="365" cy="82" r="22" fill="#000" stroke="#ff0a94" stroke-width="2.4"/>
  <text class="lbl" x="365" y="82">Peer A</text>

  <circle class="ring2" cx="365" cy="148" r="22"/>
  <circle cx="365" cy="148" r="22" fill="#000" stroke="#4da3ff" stroke-width="2.4"/>
  <text class="lbl" x="365" y="148">Peer B</text>

  <circle class="ring" cx="585" cy="112" r="24"/>
  <circle cx="585" cy="112" r="24" fill="#000" stroke="#ff0a94" stroke-width="2.4"/>
  <text class="lbl" x="585" y="112">WebRTC</text>
  <text class="sub" x="585" y="152">WANT / OBJ sync</text>

  <circle cx="795" cy="112" r="26" fill="#000" stroke="#4da3ff" stroke-width="2.4"/>
  <text class="lbl" x="795" y="112">WASM</text>
  <text class="sub" x="795" y="152">cubical.wasm</text>
</svg>
