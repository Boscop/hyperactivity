-- x < p implies wlt p x = false
cm-lt-asym-step : (x : Word) → ((p : Word) → ltw x p ≡ true → ltw p x ≡ false) →
                  (p : Word) → ltw (%wsucc x) p ≡ true → ltw p (%wsucc x) ≡ false
cm-lt-asym-step x ih p =
  %welimP (λ v → ltw (%wsucc x) v ≡ true → ltw v (%wsucc x) ≡ false) p
    (λ h → cm-ft-absurd h)
    (λ p1 gp h → ih p1 h)
