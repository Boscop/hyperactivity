min-not-observed : (L : Landscape) → (r : ls-idx L → Nat) → (obs : ls-idx L → Bool) → (i : ls-idx L) → ((j : ls-idx L) → isTrue (leb (r i) (r j))) → (obs i ≡ false) → (MinimumIsObserved L r obs → Empty)
min-not-observed L r obs i least no = λ m → transport (λ k → isTrue (no k)) (m i least)
