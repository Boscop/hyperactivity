-- check: the machine's verdict on the workflow (kept like a write's) and the graph's rules
hy-verdict-text : List Word → Bool × List (List Word) → List Word
hy-verdict-text f v = list-append (h-line (list-append f (if fst v then (if h-null (h-concat (snd v)) then ": the machine reads it to the end; nothing fails" else ": these fail:") else ": the machine does not read it to the end")))
  (h-indented "  " (snd v))
