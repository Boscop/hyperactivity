zr-mas s x y = zr-law (zr-mu (zr-mu s x) y) (zr-mu s (zr-mu x y)) (zmul (zmul (zr-val s) (zr-val x)) (zr-val y)) (zmul (zr-val s) (zmul (zr-val x) (zr-val y)))
  (zr-tml s x y) (zr-pas (zr-val s) (zr-val x) (zr-val y)) (zr-tmr s x y)
