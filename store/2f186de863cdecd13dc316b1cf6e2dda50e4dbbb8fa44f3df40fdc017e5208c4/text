ks-init-loop : Nat → Word → List Word
ks-init-loop zero _ = nil
ks-init-loop (suc k) i =
  let ai = epfl-indexed "a" i
      bi = epfl-indexed "b" i
      g0 = ks-gn #0 i
      p0 = ks-pn #0 i
      px = list-append "x0_" (epfl-dec i)
  in sv-concat
       (cons (epfl-gate2 ai bi g0 "11")
       (cons (epfl-xor-blif ai bi p0 px)
       (cons (ks-init-loop k (%wsucc i)) nil)))
