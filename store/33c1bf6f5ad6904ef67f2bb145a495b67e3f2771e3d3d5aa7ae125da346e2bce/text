expand-lam-cell-shift : (pre suf : List MTerm) → (t : MTerm) →
                        expand-lam-cell pre suf (mterm-shift-app t) ≡ cons t nil
expand-lam-cell-shift pre suf t =
  case t return (λ u → expand-lam-cell pre suf (mterm-shift-app u) ≡ cons u nil) of
    mempty → λ i → cons mempty nil
    mlit a → λ i → cons (mlit a) nil
    mref k → λ i → cons (mref k) nil
    mapp tid arg → λ i → cons (mapp tid (mterm-subst-shift-app (mterm-pack-list pre) (mterm-pack-list suf) arg i)) nil
    mcat l r → λ i → cons (mcat (mterm-subst-shift-app (mterm-pack-list pre) (mterm-pack-list suf) l i)
                                (mterm-subst-shift-app (mterm-pack-list pre) (mterm-pack-list suf) r i)) nil
