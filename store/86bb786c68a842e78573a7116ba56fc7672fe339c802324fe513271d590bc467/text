-- from-read: e1 reads from a write (or the initial memory) that the other write e2 to the same
-- location follows in the order on writes
tso-fr : TsoN → TsoN → Bool
tso-fr (tso-n id1 t1 k1 a1 vr1 vw1 s1 c1 sc1) (tso-n id2 t2 k2 a2 vr2 vw2 s2 c2 sc2) =
  andB (andB (tso-k-reads k1) (tso-k-writes k2)) (andB (weq a1 a2) (andB (tso-not (weq id1 id2)) (wlt sc1 c2)))
