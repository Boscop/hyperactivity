-- what the table said, done; where it says nothing, a blocked value blocks the eliminator and any
-- other value is dropped with the eliminator's wires
nk-fire : NkAct → Word → NkTm → NkEnv → NkW → NkHd → NkEnv → NkW → NkOut
nk-fire (act-ap t) h cs aux out hd parts n = nk-build t (nk-eapp aux parts) out (nk-plan-of nkf-nil n)
nk-fire (act-rp t) h cs aux out hd parts n = nk-build t (nk-eapp (nk-erev parts nke-nil) aux) out (nk-plan-of nkf-nil n)
nk-fire (act-self t) h cs aux out hd parts n = nk-build t (nke-cons n aux) out (nk-plan-of (nkf-val n (nkv hd parts) nkf-nil) (nk-s n))
nk-fire (act-hd g) h cs aux out hd parts n = nk-plan-of (nkf-val out (nkv g nke-nil) (nk-era-env aux (nk-era-env parts nkf-nil))) n
nk-fire act-none h cs aux out hd parts n = if nk-blocked hd then nk-stuck-el h cs aux out (nkv hd parts) n else nk-plan-of (nk-era-env aux (nk-era-env parts nkf-nil)) n
