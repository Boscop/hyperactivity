-- ============================================================================
-- 2. LQC Raychaudhuri Bounce Acceleration Identity
-- ============================================================================
-- Clearing ρ_c in the LQC Raychaudhuri bracket:
--   B(ρ, P, ρ_c) = ρ(ρ_c - 4ρ) + 3P(ρ_c - 2ρ).
-- At the bounce ρ = ρ_c:
--   B(ρ_c, P, ρ_c) = -3 ρ_c (ρ_c + P),
-- so ä/a = -(4πG / (3 ρ_c)) · B = +4πG (ρ_c + P) > 0 universally!
-- Variables (0..1): ρ_c, P.
lqg-lqc-bounce-accel-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-lqc-bounce-accel-poly A ad mu q vs =
  (λ g sub →
    let z = q (fn-q 0 1)
        rhoc = g 0; P = g 1
        q2 = q (fn-q 2 1)
        q3 = q (fn-q 3 1)
        q4 = q (fn-q 4 1)
        lhs = ad (mu rhoc (sub rhoc (mu q4 rhoc)))
                 (mu q3 (mu P (sub rhoc (mu q2 rhoc))))
        rhs = sub z (mu q3 (mu rhoc (ad rhoc P)))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
