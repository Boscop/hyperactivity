-- a code's immediate parts
code-kids : Code → Lst Code
code-kids (clam b) = lcons b lnil
code-kids (capp a b) = lcons a (lcons b lnil)
code-kids (cpair a b) = lcons a (lcons b lnil)
code-kids (cfst p) = lcons p lnil
code-kids (csnd p) = lcons p lnil
code-kids (cpi m A B) = lcons A (lcons B lnil)
code-kids (csigma A B) = lcons A (lcons B lnil)
code-kids (cuniv l) = lcons l lnil
code-kids (cpathp A a b) = lcons A (lcons a (lcons b lnil))
code-kids (cplam b) = lcons b lnil
code-kids (cpapp p r) = lcons p (lcons r lnil)
code-kids (cneg r) = lcons r lnil
code-kids (cmeet r s) = lcons r (lcons s lnil)
code-kids (cjoin r s) = lcons r (lcons s lnil)
code-kids (ceq0 r) = lcons r lnil
code-kids (ceq1 r) = lcons r lnil
code-kids (cfand a b) = lcons a (lcons b lnil)
code-kids (cfor a b) = lcons a (lcons b lnil)
code-kids (cforall b) = lcons b lnil
code-kids (csysc a t r) = lcons a (lcons t (lcons r lnil))
code-kids (ccomp A u a) = lcons A (lcons u (lcons a lnil))
code-kids (cgluet A S) = lcons A (lcons S lnil)
code-kids (cglue S a) = lcons S (lcons a lnil)
code-kids (cunglue S b) = lcons S (lcons b lnil)
code-kids (chcompu A S) = lcons A (lcons S lnil)
code-kids (cunglueu S b) = lcons S (lcons b lnil)
code-kids (clet t b) = lcons t (lcons b lnil)
code-kids (cann t T) = lcons t (lcons T lnil)
code-kids (cdata dd ps) = ps
code-kids (ccon dd k fs ds) = l-app fs ds
code-kids (celim dd P B x) = lcons P (lcons x B)
code-kids (ccase dd B x) = lcons x B
code-kids (chcomp u a) = lcons u (lcons a lnil)
code-kids (cdlam b) = lcons b lnil
code-kids (cforce t) = lcons t lnil
code-kids (cthunk t) = lcons t lnil
code-kids (clsuc l) = lcons l lnil
code-kids (clmax a b) = lcons a (lcons b lnil)
code-kids (cpty k n) = lcons n lnil
code-kids (cwsucc a) = lcons a lnil
code-kids (cwop k a b) = lcons a (lcons b lnil)
code-kids (cwelim w z s none) = lcons w (lcons z (lcons s lnil))
code-kids (cwelim w z s (some P)) = lcons P (lcons w (lcons z (lcons s lnil)))
code-kids (ctrans dd psi ls x) = lcons psi (lcons x ls)
code-kids (cproj dd k x) = lcons x lnil
code-kids (crec dd fs) = fs
code-kids (ctick k) = lcons k lnil
code-kids (cprim k as) = as
code-kids _ = lnil
