tso-least : {A : Type} → (st : A → Nat) → (r : List A) → (y : A) → (m : A) × TsoLeast st (cons y r) m
tso-least st nil y =
  (y , (inl (λ i → y) , (λ z mz → case mz of
                                    inl e → subst {_} {_} {_} {λ w → st y < suc (st w)} (sym e) (<-suc-self (st y))
                                    inr f → Empty-rec f)))
tso-least st (cons y2 r2) y =
  (case tso-cmp (st y) (st (fst (tso-least st r2 y2))) of
     inl le →
       (y , (inl (λ i → y) , (λ z mz → case mz of
                                         inl e → subst {_} {_} {_} {λ w → st y < suc (st w)} (sym e) (<-suc-self (st y))
                                         inr mz2 → tso-le-trans (st y) (st (fst (tso-least st r2 y2))) (st z) le (snd (snd (tso-least st r2 y2)) z mz2))))
     inr lt →
       (fst (tso-least st r2 y2) ,
        (inr (fst (snd (tso-least st r2 y2))) ,
         (λ z mz → case mz of
                     inl e → subst {_} {_} {_} {λ w → st (fst (tso-least st r2 y2)) < suc (st w)} (sym e)
                               (tso-lt-le (st (fst (tso-least st r2 y2))) (st y) lt)
                     inr mz2 → snd (snd (tso-least st r2 y2)) z mz2))))
