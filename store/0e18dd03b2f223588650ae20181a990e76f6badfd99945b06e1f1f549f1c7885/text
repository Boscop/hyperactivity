lqg-thiemann-jacobi-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-thiemann-jacobi-poly A ad mu q vs =
  (λ g sub →
    let z  = q (fn-q 0 1)
        a0 = g 0; a1 = g 1; a2 = g 2; a3 = g 3
        v1 = g 4; v2 = g 5
        h0 = g 6; h1 = g 7; h2 = g 8; h3 = g 9
        -- [V, h]
        vh0 = lqg-m2-c11 A ad sub mu v1 z z v2 h0 h1 h2 h3
        vh1 = lqg-m2-c12 A ad sub mu v1 z z v2 h0 h1 h2 h3
        vh2 = lqg-m2-c21 A ad sub mu v1 z z v2 h0 h1 h2 h3
        vh3 = lqg-m2-c22 A ad sub mu v1 z z v2 h0 h1 h2 h3
        -- [h, H_E]
        ha0 = lqg-m2-c11 A ad sub mu h0 h1 h2 h3 a0 a1 a2 a3
        ha1 = lqg-m2-c12 A ad sub mu h0 h1 h2 h3 a0 a1 a2 a3
        ha2 = lqg-m2-c21 A ad sub mu h0 h1 h2 h3 a0 a1 a2 a3
        ha3 = lqg-m2-c22 A ad sub mu h0 h1 h2 h3 a0 a1 a2 a3
        -- [H_E, V]
        av0 = lqg-m2-c11 A ad sub mu a0 a1 a2 a3 v1 z z v2
        av1 = lqg-m2-c12 A ad sub mu a0 a1 a2 a3 v1 z z v2
        av2 = lqg-m2-c21 A ad sub mu a0 a1 a2 a3 v1 z z v2
        av3 = lqg-m2-c22 A ad sub mu a0 a1 a2 a3 v1 z z v2
        -- (1,2) entry of [H_E, [V, h]] + [V, [h, H_E]] + [h, [H_E, V]]
        t1 = lqg-m2-c12 A ad sub mu a0 a1 a2 a3 vh0 vh1 vh2 vh3
        t2 = lqg-m2-c12 A ad sub mu v1 z z v2 ha0 ha1 ha2 ha3
        t3 = lqg-m2-c12 A ad sub mu h0 h1 h2 h3 av0 av1 av2 av3
    in (ad (ad t1 t2) t3 , z))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
