wlist-eq-sound : (a b : List Word) → wlist-eq a b ≡ true → a ≡ b
wlist-eq-sound a =
  case a return (λ u → (b : List Word) → wlist-eq u b ≡ true → u ≡ b) of
    nil → λ b → (case b return (λ v → wlist-eq nil v ≡ true → nil ≡ v) of
                   nil → λ h i → nil
                   cons y ys → λ h → cm-ft-absurd h)
    cons x xs → λ b →
      case b return (λ v → wlist-eq (cons x xs) v ≡ true → cons x xs ≡ v) of
        nil → λ h → cm-ft-absurd h
        cons y ys → λ h i → cons (cm-weq-sound x y (isTrue→eq (and-fst {weq x y} {wlist-eq xs ys} (eq→isTrue h))) i)
                                 (rec xs ys (isTrue→eq (and-snd {weq x y} {wlist-eq xs ys} (eq→isTrue h))) i)
