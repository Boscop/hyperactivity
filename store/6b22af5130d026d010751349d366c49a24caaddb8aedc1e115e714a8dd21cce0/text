mw-gate-ops : Word → List (Word × Word) → List Word
mw-gate-ops _ nil = nil
mw-gate-ops nw (cons g gs) =
  let step = the (List Word)
        (cons #32 (cons (fst g) (cons #32 (cons (snd g)
        (cons #113 (cons #65 (cons #1 (cons #115 (cons #33 (cons nw nil))))))))))
  in list-append step (mw-gate-ops (%wsucc nw) gs)
