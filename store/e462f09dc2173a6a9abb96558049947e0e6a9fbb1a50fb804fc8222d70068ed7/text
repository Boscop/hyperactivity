word-order : TotalOrder word-le
word-order =
  ( (λ x → isTrue-not (concat (wlt-toNat x x) (ltn-irr (toNat x))))
  , (λ x y e →
       isTrue-not
         (concat (wlt-toNat x y)
            (ltn-asym (toNat y) (toNat x) (concat (sym (wlt-toNat y x)) (not-false e)))))
  , (λ x y z hxy hyz →
       isTrue-not
         (concat (wlt-toNat z x)
            (ltn-nlt-trans (toNat x) (toNat y) (toNat z)
               (concat (sym (wlt-toNat y x)) (not-isTrue hxy))
               (concat (sym (wlt-toNat z y)) (not-isTrue hyz)))))
  , (λ x y hxy hyx →
       concat (sym (fromNat-toNat x))
         (concat
            (cong fromNat
               (ltn-tri (toNat x) (toNat y)
                  (concat (sym (wlt-toNat x y)) (not-isTrue hyx))
                  (concat (sym (wlt-toNat y x)) (not-isTrue hxy))))
            (fromNat-toNat y))) )
