-- Universal Bellman Value Monotonicity (Optimal Policy Always Dominates `act-hold` for ALL Candidate Lists):
mdp-le-nat : Nat → Nat → Bool
mdp-le-nat zero    y       = true
mdp-le-nat (suc x) zero    = false
mdp-le-nat (suc x) (suc y) = mdp-le-nat x y

mdp-max-nat : Nat → Nat → Nat
mdp-max-nat zero    y       = y
mdp-max-nat (suc x) zero    = suc x
mdp-max-nat (suc x) (suc y) = suc (mdp-max-nat x y)

mdp-false-elim : {A : Type} → false ≡ true → A
mdp-false-elim p = Empty-rec (transport (λ i → if p i then Empty else Unit) unit)

mdp-le-trans : (a b c : Nat) → mdp-le-nat a b ≡ true → mdp-le-nat b c ≡ true → mdp-le-nat a c ≡ true
mdp-le-trans zero    b       c       hab hbc = refl
mdp-le-trans (suc a) zero    c       hab hbc = mdp-false-elim hab
mdp-le-trans (suc a) (suc b) zero    hab hbc = mdp-false-elim hbc
mdp-le-trans (suc a) (suc b) (suc c) hab hbc = mdp-le-trans a b c hab hbc

mdp-le-refl : (a : Nat) → mdp-le-nat a a ≡ true
mdp-le-refl zero    = refl
mdp-le-refl (suc a) = mdp-le-refl a

mdp-le-max-l : (a b : Nat) → mdp-le-nat a (mdp-max-nat a b) ≡ true
mdp-le-max-l zero    b       = refl
mdp-le-max-l (suc a) zero    = mdp-le-refl a
mdp-le-max-l (suc a) (suc b) = mdp-le-max-l a b

mdp-bellman-best : Nat → List Nat → Nat
mdp-bellman-best cur nil         = cur
mdp-bellman-best cur (cons v vs) = mdp-bellman-best (mdp-max-nat cur v) vs

-- UNIVERSAL THEOREM 4: BELLMAN MAX-BACKUP MONOTONICALLY DOMINATES `hold` BASELINE FOR ALL CANDIDATE SETS!
mdp-thm-bellman-dominates-hold :
  (holdVal : Nat) → (candVals : List Nat) →
  mdp-le-nat holdVal (mdp-bellman-best holdVal candVals) ≡ true
mdp-thm-bellman-dominates-hold holdVal nil = mdp-le-refl holdVal
mdp-thm-bellman-dominates-hold holdVal (cons v vs) =
  let nxt = mdp-max-nat holdVal v
  in mdp-le-trans holdVal nxt (mdp-bellman-best nxt vs)
       (mdp-le-max-l holdVal v)
       (mdp-thm-bellman-dominates-hold nxt vs)

