mdp-load-tranche-priv =
  bind (h-read mdp-key-path) (λ rk →
    let rawHex = h-take (toNat #64) (mdp-or-nil rk)
        priv   = if h-null rawHex then #1 else h-be (eth-from-hex rawHex)
    in ret {lzero} {W} priv)

