mdp-bootstrap : Proc W Unit
mdp-bootstrap =
  bind (h-mkdir "/tmp/hy_out") (λ m0 →
  bind (h-mkdir "/tmp/hx_agent_bus") (λ m1 →
  bind (h-write "/tmp/hy_out/hx_mdp_link.c" mdp-c) (λ wc →
  bind mdp-load-tranche-priv (λ priv →
    let vlt20  = eth-priv-to-addr20 priv
        vlt55  = eth-eip55-from-bytes20 vlt20
        testTx = mk-tx1559 #8453 #0 #1000000 #50000000 #21000 eth-founder-coinbase-addr20 #0 nil
        sigOk  = andB (%wlt #0 priv) (andB (%wlt priv secp-n) (eth-tx1559-selfcheck priv testTx))
        hxsvP  = mdp-mk-hxsv-frame #1 #100 #24 #1211
        hyTerm = mdp-hyperos-term vlt55 sigOk
        vJson  = mdp-vault-json vlt55 sigOk
        pJson  = mdp-pulse-json vlt55
        bLine  = mdp-bus-line vlt55
    in if eth-not sigOk
       then h-fail "CRITICAL: Tranche vault EIP-1559 ecrecover self-check failed!"
       else
         bind (h-write "/tmp/hx_agent_bus/mdp_env_state.hxsv" hxsvP) (λ w1 →
         bind (h-write "/tmp/hx_agent_bus/mdp_env_state.hypercubical" hyTerm) (λ w2 →
         bind (h-write "/tmp/hx_agent_bus/mdp_tranche_vault.json" vJson) (λ w3 →
         bind (h-write "/tmp/hx_agent_bus/agent_diamond_hfke_2b7c3400_state.json" pJson) (λ w4 →
         bind (h-read "/tmp/hx_agent_bus/outbox.jsonl") (λ prev →
         bind (h-write "/tmp/hx_agent_bus/outbox.jsonl" (list-append (mdp-or-nil prev) bLine)) (λ w5 →
         h-out (h-concat (cons vJson (cons hyTerm nil)))))))))))))

mdp-last-arg : List (List Word) → List Word
mdp-last-arg nil          = nil
mdp-last-arg (cons a nil) = a
mdp-last-arg (cons a rs)  = mdp-last-arg rs

mdp-has-flag : List Word → List (List Word) → Bool
mdp-has-flag fl nil         = false
mdp-has-flag fl (cons a rs) = if h-eq fl a then true else mdp-has-flag fl rs

mdp-is-direct : List (List Word) → Bool
mdp-is-direct argv = h-infix "hx-mdp-swarm-link" (mdp-last-arg argv)

mdp-run : Step W Unit
mdp-run =
  to-step
    (bind h-args (λ av →
      if mdp-has-flag "--mdp-drip-gas" av
      then bind mdp-cmd-drip-gas (λ u → exit #0)
      else if mdp-has-flag "--mdp-alloc-morpho" av
      then bind mdp-cmd-alloc-morpho (λ u → exit #0)
      else if mdp-has-flag "--mdp-return-all" av
      then bind mdp-cmd-return-all (λ u → exit #0)
      else if mdp-is-direct av
      then bind mdp-bootstrap (λ u → exit #0)
      else ret {lzero} {W} unit))

#run mdp-run
