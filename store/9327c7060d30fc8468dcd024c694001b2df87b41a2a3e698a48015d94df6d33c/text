-- Strict Machine-Checked Admissibility Gate (`mdp-admissible`):
--   * Blocks `minOutU6 == #0` unconditionally (eliminating `amountOutMinimum = 0` MEV sandwich bugs!)
--   * Enforces `quoteOut * 9995 <= minOut * 10000` (<= 5 bps max slippage vs cross-venue oracle!)
--   * Enforces `amtIn * 50 <= poolDepth` (<= 2% of active pool liquidity — blocks thin micro-cap pools!)
--   * Enforces `abs(spotLeg - perpShort) * 1000 <= spotLeg` (<= 10 bps delta-neutral lock!)
mdp-admissible : MdpState → MdpAction → Bool
mdp-admissible (mk-mdp-state ep vU mU hU fU px bp gl) act-hold = true
mdp-admissible (mk-mdp-state ep vU mU hU fU px bp gl) (act-morpho-prime amt) =
  andB (%wlt #0 amt) (eth-le amt vU)
mdp-admissible (mk-mdp-state ep vU mU hU fU px bp gl) (act-atomic-flash notional surpBps) =
  andB (%wlt #0 notional) (%wlt #0 surpBps)
mdp-admissible (mk-mdp-state ep vU mU hU fU px bp gl) (act-guarded-swap amtIn quoteOut minOut depth) =
  andB (%wlt #0 amtIn)
  (andB (eth-le amtIn vU)
  (andB (%wlt #0 minOut)
  (andB (eth-le (%wmul quoteOut #9995) (%wmul minOut #10000))
        (eth-le (%wmul amtIn #50) depth))))
mdp-admissible (mk-mdp-state ep vU mU hU fU px bp gl) (act-delta-locked-basis spotU perpU) =
  andB (%wlt #0 spotU)
  (andB (eth-le spotU vU)
        (eth-le (%wmul (mdp-abs-diff spotU perpU) #1000) spotU))
mdp-admissible (mk-mdp-state ep vU mU hU fU px bp gl) (act-stream-founder royU) =
  andB (%wlt #0 royU) (eth-le royU vU)
mdp-admissible (mk-mdp-state ep vU mU hU fU px bp gl) act-return-all-founder = true

-- Deterministic Symbolic MDP Transition Operator (`mdp-step`):
mdp-inject-tranche : Word → MdpState → MdpState
mdp-inject-tranche trU6 (mk-mdp-state ep vU mU hU fU px bp gl) =
  mk-mdp-state (%wadd ep #1) (%wadd vU trU6) mU hU fU px bp gl

mdp-step : MdpState → MdpAction → MdpState
mdp-step st act =
  if eth-not (mdp-admissible st act) then st
  else
    case st of
      mk-mdp-state ep vU mU hU fU px bp gl →
        case act of
          act-hold → mk-mdp-state (%wadd ep #1) vU mU hU fU px bp gl
          act-morpho-prime amt →
            mk-mdp-state (%wadd ep #1) (%wsub vU amt) (%wadd mU amt) hU fU px bp gl
          act-atomic-flash notional surpBps →
            let netU6 = %wdiv (%wmul notional surpBps) #10000
                royU6 = %wdiv netU6 #5
                cmpU6 = %wsub netU6 royU6
            in mk-mdp-state (%wadd ep #1) (%wadd vU cmpU6) mU hU (%wadd fU royU6) px bp gl
          act-guarded-swap amtIn quoteOut minOut depth →
            mk-mdp-state (%wadd ep #1) vU mU hU fU px bp gl
          act-delta-locked-basis spotU perpU →
            mk-mdp-state (%wadd ep #1) (%wsub vU spotU) mU (%wadd hU spotU) fU px bp gl
          act-stream-founder royU →
            mk-mdp-state (%wadd ep #1) (%wsub vU royU) mU hU (%wadd fU royU) px bp gl
          act-return-all-founder →
            let allLiq = %wadd vU (%wadd mU hU)
            in mk-mdp-state (%wadd ep #1) #0 #0 #0 (%wadd fU allLiq) px bp gl

