opt-2-sound : {V : Type} → (env : V → Bool) → (b : B2) → (x y : Circ B0 B1 B2 V) →
  fold {B0} {B1} {B2} {V} {Bool} bool-alg env (opt-2 b x y) ≡
  snd (snd bool-alg) b (fold {B0} {B1} {B2} {V} {Bool} bool-alg env x) (fold {B0} {B1} {B2} {V} {Bool} bool-alg env y)
opt-2-sound env b (cwire v) y = refl
opt-2-sound env b (cop0 c) y = opt-2-l0-sound env b c y
opt-2-sound env b (cop1 u a) y = refl
opt-2-sound env b (cop2 b2 x1 x2) y = refl
