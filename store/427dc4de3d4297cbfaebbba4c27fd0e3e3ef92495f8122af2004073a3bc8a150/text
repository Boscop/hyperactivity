-- the pointer a register holds (the address part of a wide one)
rm-slot-ptr : RSlot → REv MPtr
rm-slot-ptr s = case s of
  sl-reg v → (case v of
    rv-s x → rm-res (sv-as-p x)
    rv-fat a m → rm-res (sv-as-p a)
    rv-dead → rm-throw (rx-ub rub-dead-local)
    rv-unit → rm-throw (rx-ill-formed ri-operand-class))
  sl-mem p → rm-throw (rx-ill-formed ri-operand-class)
  sl-none → rm-throw (rx-ill-formed ri-operand-class)
