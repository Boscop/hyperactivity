syn-all-linear : (x y : Code8) →
  syn-all (bv-xor (toNat #8) x y) ≡ b-xor2 (syn-all x) (syn-all y)
syn-all-linear x y =
  let pL = xor4-linear (c8-0 x) (c8-1 x) (c8-2 x) (c8-3 x) (c8-0 y) (c8-1 y) (c8-2 y) (c8-3 y)
      pR = xor4-linear (c8-4 x) (c8-5 x) (c8-6 x) (c8-7 x) (c8-4 y) (c8-5 y) (c8-6 y) (c8-7 y)
  in catB
       (syn-all (bv-xor (toNat #8) x y))
       (b-xor2 (b-xor2 (xor4 (c8-0 x) (c8-1 x) (c8-2 x) (c8-3 x)) (xor4 (c8-0 y) (c8-1 y) (c8-2 y) (c8-3 y)))
               (b-xor2 (xor4 (c8-4 x) (c8-5 x) (c8-6 x) (c8-7 x)) (xor4 (c8-4 y) (c8-5 y) (c8-6 y) (c8-7 y))))
       (b-xor2 (syn-all x) (syn-all y))
       (λ i → b-xor2 (pL i) (pR i))
       (xor-swap4
         (xor4 (c8-0 x) (c8-1 x) (c8-2 x) (c8-3 x))
         (xor4 (c8-0 y) (c8-1 y) (c8-2 y) (c8-3 y))
         (xor4 (c8-4 x) (c8-5 x) (c8-6 x) (c8-7 x))
         (xor4 (c8-4 y) (c8-5 y) (c8-6 y) (c8-7 y)))
