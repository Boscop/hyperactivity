-- u · (0, …, 0) = 0
cl-dot-const : (A : Type) → (z : A) → (ad mu : A → A → A) → ((x : A) → mu x z ≡ z) → ad z z ≡ z → (B : Type) → (u : List A) → (m : List B) →
  cl-dot A z ad mu u (ln-map B A (λ r → z) m) ≡ z
cl-dot-const A z ad mu m0 a0 B u m = (case u return λ w → (m2 : List B) → cl-dot A z ad mu w (ln-map B A (λ r → z) m2) ≡ z of
  nil → λ m2 → λ i → z
  cons x xs → λ m2 → (case m2 return λ w → cl-dot A z ad mu (cons x xs) (ln-map B A (λ r → z) w) ≡ z of
    nil → cl-tr A (ad (mu x z) (cl-dot A z ad mu xs nil)) (ad z z) z (λ i → ad (m0 x i) (cl-dot-nil-r A z ad mu m0 a0 xs i)) a0
    cons r rest → cl-tr A (ad (mu x z) (cl-dot A z ad mu xs (ln-map B A (λ r2 → z) rest))) (ad z z) z (λ i → ad (m0 x i) (cl-dot-const A z ad mu m0 a0 B xs rest i)) a0)) m
