data LiveChannel = live-ch
  (cid    : Word)          -- content-addressed channel ID
  (parent : Word)          -- #0 for root channel, else upstream parent channel ID
  (patch  : Word)          -- SHA-256 hash prefix of physical wave-graph patch
  (policy : WarrantPolicy) -- wp-open (transparent) or keyed/joint/delegated warrant
  (clock  : RatPair)       -- rational beat-grid clock ratio
