zip-mundiff-mdiff : (B : Word) → (ps xs : List (Bounded B)) → zip-mundiff B ps (zip-mdiff B ps xs) ≡ xs
zip-mundiff-mdiff B ps =
  case ps return (λ u → (xs : List (Bounded B)) → zip-mundiff B u (zip-mdiff B u xs) ≡ xs) of
    nil → λ xs i → xs
    cons p ps1 → λ xs →
      case xs return (λ v → zip-mundiff B (cons p ps1) (zip-mdiff B (cons p ps1) v) ≡ v) of
        nil → λ i → nil
        cons x xs1 →
          let q : Bounded B
              q = (mundiff-val B (fst p) (mdiff-val B (fst p) (fst x)) ,
                   mundiff-lt B (fst p) (mdiff-val B (fst p) (fst x)) (snd p) (mdiff-lt B (fst p) (fst x) (snd p) (snd x)))
          in λ i → cons (bounded-eq B q x (mundiff-mdiff B (fst p) (fst x) (snd p) (snd x)) i) (rec ps1 xs1 i)
