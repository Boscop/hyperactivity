-- congruence in both arguments at once: a function of a compound and a condition respects a path in each.
-- One line in a cubical setting, where a path is a function of the interval and the two paths are taken
-- at the same point.
cong-cmp-cond : (h : Compound → Cond → Nat) → (k1 : Compound) → (k2 : Compound) → k1 ≡ k2 → (c1 : Cond) → (c2 : Cond) → c1 ≡ c2 → h k1 c1 ≡ h k2 c2
cong-cmp-cond h k1 k2 q c1 c2 s = λ i → h (q i) (s i)
