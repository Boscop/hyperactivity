-- the context and the body of an instance
rm-inst-cx : Target → RCrate → RInstance → RSt (RCx × RBody)
rm-inst-cx t c i = case i of
  rinstance b a → sr-map (λ bd →
    ( RCx { cx-t = t ; cx-crate = c ; cx-args = a ; cx-locals = rb-locals bd
          ; cx-depth = wadd (rm-len (cr-layouts c)) #2 }
    , bd )) (rm-nth (cr-bodies c) b (ri-no-body b))
