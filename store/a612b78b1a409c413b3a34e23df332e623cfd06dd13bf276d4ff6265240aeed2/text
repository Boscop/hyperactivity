-- a value arrives at a wire, by what waited there
sm-put-val : SmSlot → Word → SmVal → SmState → SmState
sm-put-val sms-none w v (sm-state sl rd n) = sm-state (smsl-cons w (sms-val v) sl) rd n
sm-put-val (sms-op o) w v (sm-state sl rd n) = sm-state (sm-del sl w) (smp-cons o v rd) n
sm-put-val (sms-readers os) w v (sm-state sl rd n) = sm-state (sm-set sl w (sms-val v)) (sm-wake os w rd) n
sm-put-val (sms-val u) w v st = st
