-- one branch of one kind, from the vertex's states (xs0, over the monomials of the vertex holding H_p's leg)
hop-term-with : SQ → VM → VM → VM → Nat → Bool → Nat → Bool → Nat → List Nat → Rows → Term
hop-term-with wt a1 a2 aP k sn n sm m dsP xs0 = (wt , ((vw-m (fst a1) , suc zero) , ((vw-m (fst a2) , suc zero) ,
  r-d-mats (m-deg (vw-m (fst a1))) (m-deg (vw-m (fst a2))) (zero-rows (rows-len xs0) (vertex-count (vw-frs (fst aP)))) (vw-m (fst a1)) (vw-m (fst a2))
    (hop-b2 (m-deg (vw-m (fst a1))) (m-deg (vw-m (fst a2))) a1 a2 (hop-mid a1 a2 k sn n sm m dsP) (hop-fin a2 aP k sn n sm m dsP) (to-coords a1 (first-maps k sn n dsP xs0))) zero)))
