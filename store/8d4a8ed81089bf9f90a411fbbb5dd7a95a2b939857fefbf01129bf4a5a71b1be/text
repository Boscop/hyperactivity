md-step : MdB → MdLk → List Word → List Word
md-step b lk-fence r = list-append (md-close b) (md-go (mb-code nil) r)
md-step (mb-table rs) (lk-row l) r = md-go (mb-table (cons l rs)) r
md-step b (lk-row l) r = list-append (md-close b) (md-go (mb-table (cons l nil)) r)
md-step b (lk-head n t) r = list-append (md-close b) (list-append (s-h n (s-inline t)) (md-go mb-none r))
md-step (mb-quote ls) (lk-quote q) r = md-go (mb-quote (cons q ls)) r
md-step b (lk-quote q) r = list-append (md-close b) (md-go (mb-quote (cons q nil)) r)
md-step (mb-list is) (lk-item i) r = md-go (mb-list (cons (cons i nil) is)) r
md-step b (lk-item i) r = list-append (md-close b) (md-go (mb-list (cons (cons i nil) nil)) r)
md-step b lk-hr r = list-append (md-close b) (list-append "<hr>" (md-go mb-none r))
md-step b lk-blank r = list-append (md-close b) (md-go mb-none r)
md-step (mb-list is) (lk-text s true) r = md-go (mb-list (md-more is s)) r
md-step (mb-para ls) (lk-text s c) r = md-go (mb-para (cons s ls)) r
md-step b (lk-text s c) r = list-append (md-close b) (md-go (mb-para (cons s nil)) r)
