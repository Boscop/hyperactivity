ci-vxor _           nil         = nil
ci-vxor (cons a as) (cons b bs) = cons (ci-bxor a b) (ci-vxor as bs)

-- Exact pair-indexed bitvector representation (guaranteed equal length for ALL dimensions d : Nat!):
