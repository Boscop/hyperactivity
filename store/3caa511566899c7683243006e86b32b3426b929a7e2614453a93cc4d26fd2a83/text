-- Functional equivalence relation (membership in the same observation fiber Fib(f)):
FiberEquiv : {X Y : Type} → (X → Y) → (X → Y) → Type
FiberEquiv {X} f g = (x : X) → f x ≡ g x

ci-fiber-refl : {X Y : Type} → (f : X → Y) → FiberEquiv f f
ci-fiber-refl f x = refl

ci-fiber-sym : {X Y : Type} → {f g : X → Y} → FiberEquiv f g → FiberEquiv g f
ci-fiber-sym h x = ci-sym (h x)

ci-fiber-trans : {X Y : Type} → {f g k : X → Y} → FiberEquiv f g → FiberEquiv g k → FiberEquiv f k
ci-fiber-trans h1 h2 x = ci-trans (h1 x) (h2 x)

-- Abstract Indistinguishability Obfuscator Interface over a program representation P,
-- parameterized by a computational indistinguishability relation Indist : P -> P -> Type:
