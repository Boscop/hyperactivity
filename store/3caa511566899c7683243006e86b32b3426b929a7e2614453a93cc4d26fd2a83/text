-- Garbled active-pair evaluation given masks (ka, kb, ko) and masked wire values (wa, wb):
ci-garbled-nand : Bool → Bool → Bool → Bool → Bool → Bool
ci-garbled-nand ka kb ko wa wb = ci-bxor ko (ci-bnand (ci-bxor ka wa) (ci-bxor kb wb))

-- UNIVERSAL THEOREM 5 (EXACT CORRECTNESS OF GARBLED LAFONT ACTIVE PAIR FOR ALL KEYS & INPUTS):
--   Unmasking the garbled output with ko recovers exact NAND(a, b) for ALL (ka, kb, ko, a, b : Bool)!
ci-thm-garbled-inet-correct :
  (ka kb ko a b : Bool) →
  ci-bxor ko (ci-garbled-nand ka kb ko (ci-bxor ka a) (ci-bxor kb b)) ≡ ci-bnand a b
ci-thm-garbled-inet-correct ka kb ko a b =
  let p1 = ci-bxor-inv ko (ci-bnand (ci-bxor ka (ci-bxor ka a)) (ci-bxor kb (ci-bxor kb b)))
      p2 = ci-cong (λ x → ci-bnand x (ci-bxor kb (ci-bxor kb b))) (ci-bxor-inv ka a)
      p3 = ci-cong (ci-bnand a) (ci-bxor-inv kb b)
  in ci-trans p1 (ci-trans p2 p3)

