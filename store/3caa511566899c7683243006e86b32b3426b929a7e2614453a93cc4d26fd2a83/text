ci-cong : {A B : Type} → (f : A → B) → {x y : A} → x ≡ y → f x ≡ f y
ci-cong f p = λ i → f (p i)

ci-trans : {A : Type} → {x y z : A} → x ≡ y → y ≡ z → x ≡ z
ci-trans {A} {x} p q = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

ci-sym : {A : Type} → {x y : A} → x ≡ y → y ≡ x
ci-sym {A} {x} p = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ p j , i = 1 ↦ x ]) x

ci-mod : Word → Word → Word
ci-mod a m = if %weq m #0 then #0 else %wsub a (%wmul (%wdiv a m) m)

ci-addm : Word → Word → Word → Word
ci-addm m a b = ci-mod (%wadd a b) m

ci-subm : Word → Word → Word → Word
ci-subm m a b = ci-mod (%wadd (%wadd a m) (%wsub m (ci-mod b m))) m

