-- UNIVERSAL THEOREM 2B (ALL DIMENSIONS d : Nat): Exact OTP involution on arbitrary-length key-message streams!
ci-thm-otp-stream-exact : (s : List KeyMsgBit) → ci-enc-stream (ci-enc-stream s) ≡ s
ci-thm-otp-stream-exact nil = refl
ci-thm-otp-stream-exact (cons (kmb k m) r) =
