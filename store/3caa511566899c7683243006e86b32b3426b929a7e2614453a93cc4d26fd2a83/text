-- SECTION 3: EXACT MODULAR LWE HOMOMORPHIC ENCRYPTION (BGV/FHE CORE, 0 FLOATS!)
-- ============================================================================
-- Exact scalar LWE/BGV ciphertext over Z_q with plaintext modulus t = 2 (q = 257, Delta = 128):
--   Enc(s, a, e, m) = (a, (a*s + 2*e + m) mod q)  where |2*e| < q/2.
--   Dec(s, (a, b))  = ((b - a*s) mod q) mod 2.
--   Homomorphic Addition: (a1, b1) + (a2, b2) = ((a1+a2) mod q, (b1+b2) mod q)
--   satisfies Dec(Enc(m1) + Enc(m2)) == m1 XOR m2 whenever noise |2*(e1+e2)| < q/2!

data LweCt = lwect (ct-a : Word) (ct-b : Word)

ci-lwe-q : Word
ci-lwe-q = #257

ci-lwe-enc : Word → Word → Word → Word → LweCt
ci-lwe-enc s a e m =
  lwect (ci-mod a ci-lwe-q) (ci-mod (%wadd (%wmul a s) (%wadd (%wmul #2 e) m)) ci-lwe-q)

ci-lwe-dec : Word → LweCt → Word
ci-lwe-dec s (lwect a b) =
  let diff = ci-subm ci-lwe-q b (ci-mod (%wmul a s) ci-lwe-q)
  in ci-mod diff #2

ci-lwe-add : LweCt → LweCt → LweCt
ci-lwe-add (lwect a1 b1) (lwect a2 b2) =
  lwect (ci-addm ci-lwe-q a1 a2) (ci-addm ci-lwe-q b1 b2)

