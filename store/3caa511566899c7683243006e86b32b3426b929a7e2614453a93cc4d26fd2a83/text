ci-onion-wrap : List Bool → Bool → Bool
ci-onion-wrap nil         p = p
ci-onion-wrap (cons k ks) p = ci-onion-wrap ks (ci-bxor k p)

ci-rev-keys : List Bool → List Bool
ci-rev-keys nil         = nil
ci-rev-keys (cons k ks) = list-append (ci-rev-keys ks) (cons k nil)

ci-onion-append : (ks1 ks2 : List Bool) → (p : Bool) →
  ci-onion-wrap (list-append ks1 ks2) p ≡ ci-onion-wrap ks2 (ci-onion-wrap ks1 p)
ci-onion-append nil         ks2 p = refl
ci-onion-append (cons k ks) ks2 p = ci-onion-append ks ks2 (ci-bxor k p)

-- UNIVERSAL THEOREM 6 (ALL ONION DEPTHS n : Nat, SCALE-FREE TOR-IN-INET):
--   Peeling n onion layers in reverse order recovers the EXACT original flit payload for ALL depths n!
ci-thm-onion-peel-exact : (ks : List Bool) → (p : Bool) →
  ci-onion-wrap (ci-rev-keys ks) (ci-onion-wrap ks p) ≡ p
ci-thm-onion-peel-exact nil p = refl
ci-thm-onion-peel-exact (cons k ks) p =
  let p1 = ci-onion-append (ci-rev-keys ks) (cons k nil) (ci-onion-wrap ks (ci-bxor k p))
      p2 = ci-cong (ci-bxor k) (ci-thm-onion-peel-exact ks (ci-bxor k p))
      p3 = ci-bxor-inv k p
  in ci-trans p1 (ci-trans p2 p3)

