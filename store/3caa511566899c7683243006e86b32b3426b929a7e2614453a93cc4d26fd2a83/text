  { io-obf      : P → P
  ; io-correct  : (p : P) → FiberEquiv (Eval (io-obf p)) (Eval p)
  ; io-indist   : (p0 p1 : P) → (Size p0 ≡ Size p1) → FiberEquiv (Eval p0) (Eval p1) → Indist (io-obf p0) (io-obf p1)
  }

