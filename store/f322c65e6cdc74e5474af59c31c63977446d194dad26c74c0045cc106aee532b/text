-- the type of a branch's body at fresh fields and dimensions (no hypotheses)
br-infer tel b =
  case tel of
    tx A nm r → 
      case b of
        bx nm b1 → let Av = tval A in let x = %var nm Av in br-infer (r x Av) (b1 x Av)
        _ → none
    ty nm r → (case b of bi nm b1 → let i = %dim nm in br-infer (r i) (b1 i); _ → none)
    tz bdy → (case b of be t → infer t; _ → none)
