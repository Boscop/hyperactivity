     (cmap-id (fst Γ) (CtxV (fst Γ)) (snd Γ))
     (psym (Cube (dims (fst Γ)) (CtxV (fst Γ))) (sub-base Γ Γ (dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (SubF (fst Γ) (fst Γ)) (λ γ → (γ , λ ρ → ρ)) (snd Γ))) (snd Γ)
        (pcat (Cube (dims (fst Γ)) (CtxV (fst Γ))) (sub-base Γ Γ (dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (SubF (fst Γ) (fst Γ)) (λ γ → (γ , λ ρ → ρ)) (snd Γ)))
