nk-split-bounds : (e : NkEnv) (o : NkOut) →
  (nk-wire-le (nk-n o) (nk-n (nk-so (nk-split e o))) ≡ true)
  × ((nk-ebound (nk-sa (nk-split e o)) (nk-n (nk-so (nk-split e o))) ≡ true)
     × (nk-ebound (nk-sb (nk-split e o)) (nk-n (nk-so (nk-split e o))) ≡ true))
nk-split-bounds nke-nil o = (nk-wire-le-refl (nk-n o) , (refl , refl))
nk-split-bounds (nke-cons w r) o =
  let ih = nk-split-bounds r o
  in nk-split-bounds-cons w (nk-split r o) (nk-n o) (fst ih) (fst (snd ih)) (snd (snd ih))
