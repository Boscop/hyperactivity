-- text-written-raw: a notation for a text written as itself. Its first line is the name; the lines
-- after it are the text, byte for byte, its meaning the declaration of the name at List Word with
-- that text as value
text-written-raw : List Word → Lst Meaning
text-written-raw s = lcons (means (raw-first-line s) (code (List Word)) (text-code (raw-after-first-line s))) lnil
