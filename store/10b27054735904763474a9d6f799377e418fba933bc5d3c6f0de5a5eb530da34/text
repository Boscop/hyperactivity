-- fork only when the target cache file is not yet present on disk, so live delta refreshes skip unchanged works in O(1)
s-ensure-mod : List Word → List Word → List Word → Proc W (List Word) → Proc W Unit
s-ensure-mod st kind path mk = bind (s-mod-file st kind path) (λ f → bind (h-read f) (λ ex →
  case ex of
    inr r → ret {lzero} {W} unit
    inl u → bind (s-isolated (bind (s-site-or f mk (inl unit)) (λ x → ret {lzero} {W} unit))) (λ ok → ret {lzero} {W} unit)))
