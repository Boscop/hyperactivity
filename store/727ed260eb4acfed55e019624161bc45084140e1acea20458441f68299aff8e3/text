-- a branch's and a loop step's leading λs bind its fields and hypotheses: they stay; so do the
-- λs after a let among them (a definition as written names the whole matched value by a let)
x-push-lams-f : (Code → Code) → Code → Code
x-push-lams-f f (clam b) = clam (x-push-lams-f f b)
x-push-lams-f f (clet t b) = clet (f t) (x-push-lams-f f b)
x-push-lams-f f c = f c
