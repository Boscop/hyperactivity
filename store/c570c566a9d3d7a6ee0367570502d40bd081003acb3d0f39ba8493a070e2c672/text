one-if-strict2 : {p p' : Bool} → (isTrue p' → isTrue p) → (c c' : Nat) → ltn c' c ≡ true → ltn (plus (one-if p') c') (plus (one-if p) c) ≡ true
one-if-strict2 imp c c' e =
  (case p' return λ y → (isTrue y → isTrue p) → ltn (plus (one-if y) c') (plus (one-if p) c) ≡ true of
     true → λ imp → (case p return λ z → isTrue z → ltn (suc c') (plus (one-if z) c) ≡ true of true → λ u → e; false → λ u → Empty-rec u) (imp unit)
     false → λ imp → (case p return λ z → ltn c' (plus (one-if z) c) ≡ true of true → ltn-weaken c' c e; false → e)) imp
