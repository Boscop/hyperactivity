-- a byte of a byte string, written and read (lib/cxx/ast.cub's strings): %store8 and %load8 are
-- bounds-checked by the machine, a store outside the string leaving it unchanged and a load there 0
primitive cstr-put : (n : Nat) → Bytes n → Word → Word → Bytes n = λ n b off v → %store8 b off (%u32ofw v)
