-- an entry as staged: its size and time the ones the index recorded, then its prose's keys (k)
os-staged : List Word × (List Word × (Word × Word)) → Proc W (Sum (List Word) (List (List Word × List Word))) → Proc W (Sum (List Word) (List (List Word × List Word)))
os-staged e k =
  with-bytes {Sum (List Word) (List (List Word × List Word))} (wadd (fromNat (list-length (fst e))) #1) (λ p → bind (h-poke p (fst e)) (λ u0 →
  with-bytes {Sum (List Word) (List (List Word × List Word))} #256 (λ st → bind (sys-call #262 #18446744073709551516 p st #0 #0 #0) (λ r →
  bind (load-at (wadd st #48)) (λ size → bind (load-at (wadd st #88)) (λ mtime →
  if andB (weq r #0) (andB (weq (wand size #4294967295) (fst (snd (snd e)))) (weq (wand mtime #4294967295) (snd (snd (snd e)))))
  then k
  else ret {lzero} {W} (inl (list-append (fst e) (list-append " differs from what is staged; stage it whole: git add " (fst e))))))))))
