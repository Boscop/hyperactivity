cmp-true-le : (m n : Nat) → cmpN true m n ≡ true → le m n
cmp-true-le m = case m return λ z → (n : Nat) → cmpN true z n ≡ true → le z n of
  zero → λ n h → (n , plus-zero n)
  suc m2 → λ n → (case n return λ w → cmpN true (suc m2) w ≡ true → le (suc m2) w of
    zero → λ h → absurd-ft (le (suc m2) zero) h
    suc n2 → λ h → le-suc2 m2 n2 (rec m2 n2 h))
