mterm-subst-shift-ref : (pat t : MTerm) → mterm-subst-ref pat (mterm-shift-ref t) ≡ t
mterm-subst-shift-ref pat t =
  case t return (λ u → mterm-subst-ref pat (mterm-shift-ref u) ≡ u) of
    mempty → λ i → mempty
    mlit a → λ i → mlit a
    mref k → λ i → mref k
    mapp tid arg → λ i → mapp tid (rec arg i)
    mcat l r → λ i → mcat (rec l i) (rec r i)
