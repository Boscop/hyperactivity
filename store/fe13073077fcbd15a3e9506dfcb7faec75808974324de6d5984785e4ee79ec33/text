-- Theorem (the round trip): printing a name with no newline and a text, then reading, gives back the
-- meaning, the declaration of the name with the text as value
text-written-raw-round-trip : (n s : List Word) → isTrue (no-newline n) → Path (Lst Meaning) (text-written-raw (text-written-raw-print n s)) (lcons (means n (code (List Word)) (text-code s)) lnil)
text-written-raw-round-trip n s h = λ i → lcons (means (first-line-print n s h i) (code (List Word)) (text-code (after-line-print n s h i))) lnil
