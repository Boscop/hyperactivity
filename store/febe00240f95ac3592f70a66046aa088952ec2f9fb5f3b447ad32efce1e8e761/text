-- multiplication: a · b, shifting and adding
bin-mul-sound : (a b : List Bool) → bin-to-nat (bin-mul a b) ≡ times (bin-to-nat a) (bin-to-nat b)
bin-mul-sound a b =
  case a return λ m → bin-to-nat (bin-mul m b) ≡ times (bin-to-nat m) (bin-to-nat b) of
    nil → λ i → zero
    cons x xs → bin-mul-step x xs b (rec xs)
