-- the tag of a variant written (nothing for a single-variant type and for the untagged variant)
rm-set-tag : Target → RLayout → RTy → Word → MPtr → REv Unit
rm-set-tag t l ty v = case ly-tag-of l of
  rtag-none → λ p → rm-ret unit
  rtag-direct off size → rm-set-tag-at t off size (ly-variants-of l) ty v
  rtag-niche off size → rm-set-tag-at t off size (ly-variants-of l) ty v
