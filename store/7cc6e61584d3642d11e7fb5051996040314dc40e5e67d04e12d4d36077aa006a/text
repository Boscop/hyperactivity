-- the primitive operations by their number (lib/code.cub prim-apply; src/core.h PO_*)
x-prim : Enc → XEnv → Word → Word → Lst Code → Lst Word
x-prim ce env d k as =
  if %wlt k #512 then x-un ce env d (%wsub k #256) (l-at (cwlit #0) as #0)
  else if %wlt k #768 then x-bin ce env d (l-at (cwlit #0) as #0) (l-at (cwlit #0) as #1) (x-op2 (%wsub k #512))
  else if %wlt k #1024 then x-bin ce env d (l-at (cwlit #0) as #0) (l-at (cwlit #0) as #1) (l-app i-add-rax-rcx (x-ld (%wsub k #768)))
  else if %wlt k #1280 then x-store ce env d (%wsub k #1024) (l-at (cwlit #0) as #0) (l-at (cwlit #0) as #1) (l-at (cwlit #0) as #2)
  else if %wlt k #1536 then l-app (ce env d (l-at (cwlit #0) as #0)) (i-ld-rax #0)
  else x-fresh ce env d (l-at (cwlit #0) as #0)
