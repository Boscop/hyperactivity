converges-fold : {Upd A : Type} → (j : A → A → A) → (bot : A) → SemiLat {A} j bot → (f : Upd → A) → Converges {Upd} {A} (jfold {Upd} {A} j bot f)
converges-fold {Upd} {A} j bot sl f l1 l2 s12 s21 =
  concat (sym (jf-sub {Upd} {A} j bot sl f l2 l1 s21))
    (concat (fst sl (jfold {Upd} {A} j bot f l2) (jfold {Upd} {A} j bot f l1)) (jf-sub {Upd} {A} j bot sl f l1 l2 s12))
