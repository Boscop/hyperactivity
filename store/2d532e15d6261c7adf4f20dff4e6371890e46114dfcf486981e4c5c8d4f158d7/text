nk-keep-wf : (ins outs : NkEnv) (n0 nst : NkW) (ws : NkEnv) (o : NkOut) →
  (nk-env-in-range n0 (nk-n o) ws ≡ true) → (nk-out-ok ins outs n0 nst o ≡ true) →
  nk-out-ok ins outs n0 nst (nk-keep ws o) ≡ true
nk-keep-wf ins outs n0 nst ws (nk-out fx n ws0) hws ho =
  nk-out-ok-intro ins outs n0 nst fx n ws
    (nk-out-ok-le ins outs n0 nst (nk-out fx n ws0) ho)
    (nk-out-ok-fx ins outs n0 nst (nk-out fx n ws0) ho)
    hws
