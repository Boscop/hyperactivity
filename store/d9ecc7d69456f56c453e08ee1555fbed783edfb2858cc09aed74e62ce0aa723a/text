hy-render-swapped : List Word → List (List Word) → List (List Word × List Word) → Proc W (List Word)
hy-render-swapped st nil rs = ret nil
hy-render-swapped st (cons p r) rs = bind (hy-get st (list-append p "/text")) (λ x →
  bind (hy-render-swapped st r rs) (λ rest → ret (list-append (hy-swap p (hy-or nil x) rs) rest)))
