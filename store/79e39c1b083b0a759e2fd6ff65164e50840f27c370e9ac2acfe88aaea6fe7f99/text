-- + - * modulo 2^width
rm-wrap : BinOp → SK → SV → SV → MRes SV
rm-wrap o k a b = case k of
  sk-int sg w → (case w of
    iw128 → mstop st-unsupported
    _ → mr-bind (sv-as-i a) (λ x → mr-bind (sv-as-i b) (λ y →
          mr-map (λ r → sv-i (uq-cn sg w r)) (ni-op o false w x y))))
  _ → mstop st-ill-typed
