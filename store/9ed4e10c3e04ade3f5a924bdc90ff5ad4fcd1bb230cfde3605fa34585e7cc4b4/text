-- ---------------------------------------------------------------- the rvalue as a value
rm-discr-rv : RCx → RPlace → RTy → RFrame → REv RV
rm-discr-rv cx pl dty =
  sr-on (rm-place-ty cx pl) (λ e fr → rm-throw e) (λ pty →
  sr-on (rm-lay (cx-ls cx) pty) (λ e fr → rm-throw e) (λ l →
  sr-on (cx-class cx dty) (λ e fr → rm-throw e) (λ dc → case dc of
    cl-scalar kd →
                   (let f = rm-discr (cx-t cx) l kd
                        addr = rm-place-addr cx pl
                    in λ fr → rm-bind (addr fr) (λ q → rm-bind (f q) (λ v → rm-ret (rv-s v))))
    _ → λ fr → rm-throw (rx-ill-formed ri-operand-class))))
