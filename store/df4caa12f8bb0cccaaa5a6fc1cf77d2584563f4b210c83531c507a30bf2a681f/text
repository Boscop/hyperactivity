-- ============================================================================
-- 2. Exact sp³ Tetrahedral Hybridization (Hadamard Orthogonality ⇒ cos θ = -1/3)
-- ============================================================================
-- Four normalized sp³ orbitals in (s, px, py, pz) basis (scaled by 2):
--   h1 = (1,  1,  1,  1),   h2 = (1,  1, -1, -1)
--   h3 = (1, -1,  1, -1),   h4 = (1, -1, -1,  1).
-- Any two distinct hybrids have exact dot product 1·1 + p_i·p_j = 0 ⇒ p_i·p_j = -1,
-- while ‖p_i‖² = 3 ⇒ cos θ_tet = (p_i · p_j) / ‖p_i‖² = -1/3!
-- Verified universally for arbitrary scaling c (1 variable): 4c² norm, 0 off-diagonal!
chem-sp3-ortho-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-sp3-ortho-poly A ad mu q vs =
  (λ g sub sq →
    let c = g 0
        mc = sub (q (fn-q 0 1)) c
        -- h1 · h2 = c·c + c·c + c·(-c) + c·(-c) = 0
        d12 = ad (ad (mu c c) (mu c c)) (ad (mu c mc) (mu c mc))
        -- h1 · h3 = c·c + c·(-c) + c·c + c·(-c) = 0
        d13 = ad (ad (mu c c) (mu c mc)) (ad (mu c c) (mu c mc))
        -- h1 · h4 = c·c + c·(-c) + c·(-c) + c·c = 0
        d14 = ad (ad (mu c c) (mu c mc)) (ad (mu c mc) (mu c c))
        -- ‖h1‖² = 4 c²
        n1  = ad (ad (sq c) (sq c)) (ad (sq c) (sq c))
    in (ad (ad d12 (ad d13 d14)) n1 , mu (q (fn-q 4 1)) (sq c)))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
