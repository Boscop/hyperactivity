-- bang_memi: from prelude.sail (it calls what is defined after it there)
-- (part of language-support)
bang_memi : (w_addr_width : Word) → (addr : Bits w_addr_width) → (valToWrite : Bits #8) → MS Unit
bang_memi w_addr_width addr valToWrite =
  let dummy : Unit
      dummy = unit
  in bindS {Unit} {Unit} (putS (x86-write-mem #1 (bv-mask #64 addr) valToWrite)) (λ _ →
       let dummy2 : Bool
           dummy2 = true
       in log_memory_write w_addr_width addr (zpos #1) valToWrite)
