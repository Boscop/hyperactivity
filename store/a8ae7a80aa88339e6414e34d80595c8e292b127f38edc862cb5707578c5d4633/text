prefix-split-at : (p l : List Word) → (ls : List (List Word)) →
                  list-append (before-prefix p ls) (from-prefix p ls) ≡ ls → (b : Bool) →
                  list-append (if b then nil else cons l (before-prefix p ls)) (if b then cons l ls else from-prefix p ls) ≡ cons l ls
prefix-split-at p l ls e true = λ i → cons l ls
prefix-split-at p l ls e false = λ i → cons l (e i)
