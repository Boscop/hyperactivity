h-publish-text : List Word → List Word → List Word → List Word → List Word → List Word → Sum Unit (List Word) → Proc W Bool
h-publish-text st srv tok m path was (inl u) = bind (h-post srv tok (list-append "/source/unrecord?path=" (list-append (h-hex path) (list-append "&was=" was))) nil) (h-publish-answer st srv m path)
h-publish-text st srv tok m path was (inr t) = bind (h-post srv tok (list-append "/source/record?path=" (list-append (h-hex path) (list-append "&was=" was))) t) (h-publish-answer st srv m path)
