-- Single-pass structurally recursive backtick span extractor
cite-ticks-go : Bool → List Word → List Word → List (List Word)
cite-ticks-go _ _ nil = nil
cite-ticks-go inT acc (cons x r) =
  if weq x #96 then
    if inT then cons (h-rev acc nil) (cite-ticks-go false nil r)
    else cite-ticks-go true nil r
  else
    if inT then cite-ticks-go true (cons x acc) r
    else cite-ticks-go false nil r
