-- a pair whose step asked nothing is waiting on a held wire: looked at again later
nk-again : NkSlot → NkFx → Word → NkWork
nk-again (nks-pair o v) nkf-nil u = nkw-cons u nkw-nil
nk-again (nks-pair o v) (nkf-val w x r) u = nkw-nil
nk-again (nks-pair o v) (nkf-op w x r) u = nkw-nil
nk-again (nks-pair o v) (nkf-put w x r) u = nkw-nil
nk-again nks-none fx u = nkw-nil
nk-again (nks-val v) fx u = nkw-nil
nk-again (nks-op o) fx u = nkw-nil
