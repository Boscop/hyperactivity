-- x + 2(QD + R) = 2QD + T when T = x + 2R
div-alg-f : (x Q D R T : Nat) → T ≡ plus x (times 2 R) → plus x (times 2 (plus (times Q D) R)) ≡ plus (times (times 2 Q) D) T
div-alg-f x Q D R T h = transN (rev-alg x (times Q D) R) (cong2plus (times 2 (times Q D)) (times (times 2 Q) D) (plus x (times 2 R)) T (symN (times-assoc 2 Q D)) (symN h))
