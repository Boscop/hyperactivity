-- the search reads one shard and finds exactly every point q begins
search-ok : (q : List (List Word)) (i : Nat) (ts : List (List Word)) → search q i ts ≡ hits q i ts
search-ok q =
  case q return λ w → (i : Nat) (ts : List (List Word)) → search w i ts ≡ hits w i ts of
    nil → λ i ts j → hits nil i ts
    cons x r → λ i ts → search-ok-cons x r ts i
