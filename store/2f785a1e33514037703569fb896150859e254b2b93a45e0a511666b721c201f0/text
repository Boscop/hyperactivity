-- transport in a line of pair types: the first part along the first line, the second along the
-- second line at the first part's filler
nk-transp-sig : NkTm → NkTm → NkTm → NkTm → NkTm
nk-transp-sig aline fline phi p =
  nk-mkpair (nk-transp aline phi (nk-p1 p))
    (nk-transp (nk-lam (nk-app (nk-app (nk-up fline) (nk-var #0)) (nk-transp (nk-lam (nk-app (nk-up2 aline) (nk-and-i (nk-var #1) (nk-var #0)))) (nk-or-i (nk-up phi) (nk-neg (nk-var #0))) (nk-p1 (nk-up p))))) phi (nk-p2 p))
