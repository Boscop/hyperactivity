-- and the consequence: provenance does not determine the substance. One such pair refutes it, and
-- with it the inference that licenses sharing hazard data between registrants of the same source and
-- process — which is the inference REACH's one-substance-one-registration rests on.
provenance-not-identity : ProvenanceCollision → (((P : Substance) → (Q : Substance) → sub-prov P ≡ sub-prov Q → P ≡ Q) → Empty)
provenance-not-identity c =
  λ det →
    let P = fst c in
    let Q = fst (snd c) in
    let pr = fst (snd (snd c)) in
    let M = fst (snd (snd (snd c))) in
    let inP = fst (snd (snd (snd (snd c)))) in
    let notQ = snd (snd (snd (snd (snd c)))) in
    notQ (transport (λ i → sub-scope (det P Q pr i) M) inP)
