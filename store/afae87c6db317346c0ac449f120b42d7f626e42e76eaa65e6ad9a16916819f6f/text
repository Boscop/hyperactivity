-- the index read: its header (DIRC, the version, the count), then its entries
g-read-index : Word → Word → List Word → Proc W Unit
g-read-index base len hd =
  if h-prefix "DIRC" hd then
    (if andB (wlt #1 (h-be (h-take (toNat #4) (h-drop "DIRC" hd)))) (wlt (h-be (h-take (toNat #4) (h-drop "DIRC" hd))) #4)
     then bind (g-entries base len (h-be (h-take (toNat #4) (h-drop "DIRC" hd))) #12 (toNat (h-be (h-drop "DIRCvers" hd)))) g-verdict
     else h-fail "the index is not version 2 or 3, which this guard reads")
  else h-fail "the index does not begin with DIRC"
