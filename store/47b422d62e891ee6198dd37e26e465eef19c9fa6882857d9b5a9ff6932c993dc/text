-- each branch checked under each clause of its face; overlapping branches agree
check-sys s T =
  case s of
    tsys bs V → 
      and-then
        (rall
           (λ b →
              if check-face (fst b)
                then rall (λ d → check (br-at d b) (%restrict d T)) (%clauses (tval (fst b)))
                else err (fst b) E-notface opq opq) bs)
        (rall
           (λ bb →
              let b1 = fst bb
                  b2 = snd bb
              in rall
                   (λ d →
                      let v1 = tval (br-at d b1)
                          v2 = tval (br-at d b2)
                      in chk (conv (%restrict d T) v1 v2) (refused V E-sysdis v1 v2))
                   (%clauses (%fand (tval (fst b1)) (tval (fst b2))))) (lpairs bs))
    _ → err s E-notsys opq opq
