-- nk-oks-of-fits: plans that fit beside each other may be done in either order
-- (part of machine-in-hyperactive)
nk-oks-of-fits : (fx1 fx2 : NkFx) → nk-fits fx1 fx2 → nk-oks fx1 fx2
nk-oks-of-fits nkf-nil fx2 h = unit
nk-oks-of-fits (nkf-val w v r) fx2 h = (nk-ok-val fx2 w v (fst (fst h)) (snd (fst h)) , nk-oks-of-fits r fx2 (snd h))
nk-oks-of-fits (nkf-op w o r) fx2 h = (nk-ok-op fx2 w o (fst (fst h)) (snd (fst h)) , nk-oks-of-fits r fx2 (snd h))
nk-oks-of-fits (nkf-put w s r) fx2 h = (nk-ok-put fx2 w s (fst (fst h)) (fst (snd (fst h))) (snd (snd (fst h))) , nk-oks-of-fits r fx2 (snd h))
