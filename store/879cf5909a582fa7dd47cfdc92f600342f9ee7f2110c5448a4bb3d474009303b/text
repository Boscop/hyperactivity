cmp-00-f : (t y : Bool) → cmpN t (plus (bitn false) (times 2 zero)) (plus (bitn y) (times 2 zero)) ≡ (if bit-eq false y then t else y)
cmp-00-f t y = case y return λ v → cmpN t (plus (bitn false) (times 2 zero)) (plus (bitn v) (times 2 zero)) ≡ (if bit-eq false v then t else v) of
  true → λ i → true
  false → λ i → t
