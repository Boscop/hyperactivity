-- Coupled Electrothermal STA Signoff Theorem: worst-case IR-drop + thermal corner soundly bounds
-- nominal arrival time across EVERY combinational circuit!
sta-late-mono : {O0 O1 O2 V : Type} → (d1 d1h : O1 → Nat) → (d2 d2h : O2 → Nat) →
  (env envh : V → Nat) →
  ((u : O1) → leB (d1 u) (d1h u) ≡ true) →
  ((b : O2) → leB (d2 b) (d2h b) ≡ true) →
  ((v : V) → leB (env v) (envh v) ≡ true) →
  (c : Circ O0 O1 O2 V) →
  le (fold {O0} {O1} {O2} {V} {Nat} (sta-late-alg {O0} {O1} {O2} d1 d2) env c)
     (fold {O0} {O1} {O2} {V} {Nat} (sta-late-alg {O0} {O1} {O2} d1h d2h) envh c)
sta-late-mono {O0} {O1} {O2} {V} d1 d1h d2 d2h env envh h1 h2 hv c =
  leB-sound
    (fold {O0} {O1} {O2} {V} {Nat} (sta-late-alg {O0} {O1} {O2} d1 d2) env c)
    (fold {O0} {O1} {O2} {V} {Nat} (sta-late-alg {O0} {O1} {O2} d1h d2h) envh c)
    (sta-late-mono-leB {O0} {O1} {O2} {V} d1 d1h d2 d2h env envh h1 h2 hv c)
