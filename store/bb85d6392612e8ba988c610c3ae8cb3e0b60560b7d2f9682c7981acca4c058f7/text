sg-read-chunks : Nat → Word → Word → List Word → Proc W (List Word)
sg-read-chunks zero _ _ acc = ret {lzero} {W} acc
sg-read-chunks (suc k) fd buf acc =
  bind (sys-call #0 fd buf #4096 #0 #0 #0) (λ n →
    if orB (%weq n #0) (sg-sys-err n)
      then ret {lzero} {W} acc
      else bind (sg-load-chunk (toNat #64) buf #0 n acc) (λ acc2 → sg-read-chunks k fd buf acc2))
