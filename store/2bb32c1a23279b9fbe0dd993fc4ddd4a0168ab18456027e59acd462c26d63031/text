dnf-eq-sound : (f g : DNF) → dnf-eq f g ≡ true → f ≡ g
dnf-eq-sound lnil lnil e = λ i → lnil
dnf-eq-sound lnil (lcons d ds) e = false-true (Path DNF lnil (lcons d ds)) e
dnf-eq-sound (lcons c cs) lnil e = false-true (Path DNF (lcons c cs) lnil) e
dnf-eq-sound (lcons c cs) (lcons d ds) e =
  λ i → lcons (conj-eq-sound c d (andB-l (conj-eq c d) (dnf-eq cs ds) e) i) (dnf-eq-sound cs ds (andB-r (conj-eq c d) (dnf-eq cs ds) e) i)
