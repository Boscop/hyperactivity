-- ============================================================================
-- 2. Exact Bond-Length & SE(3) Pairwise-Distance Isometry: ‖M(q) v‖² = N² ‖v‖²
-- ============================================================================
-- Rotating ANY 3D peptide bond vector v = (x, y, z) by M(q) scales ‖v‖² by exactly N².
-- Since M(q) is linear, applying M(q) + T to two atoms p1, p2 maps (p1 - p2) to M(q)(p1 - p2),
-- so pairwise squared distances (steric clash & H-bond constraints) are EXACT SE(3) invariants!
-- Variables (0..6): q0, q1, q2, q3, x, y, z.
fold-rodrigues-isom-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
fold-rodrigues-isom-poly A ad mu q vs =
  (λ g sub sq →
    let q0 = g 0; q1 = g 1; q2 = g 2; q3 = g 3
        x  = g 4; y  = g 5; z  = g 6
        c2 = q (fn-q 2 1)
        s0 = sq q0; s1 = sq q1; s2 = sq q2; s3 = sq q3
        N  = ad (ad s0 s1) (ad s2 s3)
        r11 = sub (sub (ad s0 s1) s2) s3
        r12 = mu c2 (sub (mu q1 q2) (mu q0 q3))
        r13 = mu c2 (ad (mu q1 q3) (mu q0 q2))
        r21 = mu c2 (ad (mu q1 q2) (mu q0 q3))
        r22 = sub (ad (sub s0 s1) s2) s3
        r23 = mu c2 (sub (mu q2 q3) (mu q0 q1))
        r31 = mu c2 (sub (mu q1 q3) (mu q0 q2))
        r32 = mu c2 (ad (mu q2 q3) (mu q0 q1))
        r33 = ad (sub (sub s0 s1) s2) s3
        vx = ad (ad (mu r11 x) (mu r12 y)) (mu r13 z)
        vy = ad (ad (mu r21 x) (mu r22 y)) (mu r23 z)
        vz = ad (ad (mu r31 x) (mu r32 y)) (mu r33 z)
        lhs = ad (ad (sq vx) (sq vy)) (sq vz)
        rhs = mu (sq N) (ad (ad (sq x) (sq y)) (sq z))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
