pos-var d2 pvs2 v A =
  orb (notb (cany (is-var-v v) A))
    (case A of
       tv x T → same-var x v
       tdata d3 ps V → andb (%weq d3 d2) (uniform-at ps pvs2)
       tpi B nm b V → andb (notb (cany (is-var-v v) B)) (pos-var d2 pvs2 v (b (%var nm Uw) Uw))
       tsigma B nm b V → andb (pos-var d2 pvs2 v B) (pos-var d2 pvs2 v (b (%var nm Uw) Uw))
       _ → false)
