-- All-Pairs DRC Clean-by-Construction Theorem: whenever inter-cell pitch gap ≥ foundry minS,
-- EVERY pair of standard cells placed by `place-row` passes foundry horizontal spacing DRC!
place-row-drc-sound : (minS y0 h gap : Nat) → leB minS gap ≡ true →
  (ws : List Nat) → (xCur : Nat) →
  PairwiseDrc minS (place-row xCur y0 h gap ws)
place-row-drc-sound minS y0 h gap hGap nil = λ xCur → unit
place-row-drc-sound minS y0 h gap hGap (cons w ws) = λ xCur →
  ( place-row-after y0 h gap ws
      (plus minS (plus w xCur))
      (plus gap (plus w xCur))
      (leB-plus minS gap (plus w xCur) (plus w xCur) hGap (leB-refl (plus w xCur)))
  , place-row-drc-sound minS y0 h gap hGap ws (plus gap (plus w xCur)) )
