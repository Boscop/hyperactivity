zero-lt-canon : (t : Bool) → (ys : List Bool) → (y : Bool) → bcanon (cons y ys) ≡ true → cmpN t zero (bin-to-nat (cons y ys)) ≡ true
zero-lt-canon t ys = case ys return λ m → (y : Bool) → bcanon (cons y m) ≡ true → cmpN t zero (bin-to-nat (cons y m)) ≡ true of
  nil → λ y → (case y return λ u → bcanon (cons u nil) ≡ true → cmpN t zero (bin-to-nat (cons u nil)) ≡ true of
    true → λ h → λ i → true
    false → λ h → absurd-ft (cmpN t zero zero ≡ true) h)
  cons c r → λ y → zero-lt-step t c r y (rec r c)
