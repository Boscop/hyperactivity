pf-seq-step : {A B : Type} → (e : A → List Word) → (d : List Word → A × List Word) →
              ((a : A) → (t : List Word) → d (list-append (e a) t) ≡ (a , t)) →
              (rest : List Word) → (g : A → List Word → B) → (a : A) →
              (let r1 = d (list-append (e a) rest) in g (fst r1) (snd r1)) ≡ g a rest
pf-seq-step e d pf rest g a =
  let p = pf a rest
  in λ i → g (fst (p i)) (snd (p i))
