-- ---------------------------------------------------------------- integer arithmetic at 128 bits
wi-add : Bool → DQ → DQ → MRes DQ
wi-add sg a b =
  let r = dq-add a b
  in case sg of
       false → mok r
       true → (case uq-isneg (u64and (u64xor (snd a) (snd r)) (u64xor (snd b) (snd r))) of
         true → mub ub-signed-overflow
         false → mok r)
