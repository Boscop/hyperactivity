-- Theorem: An IDP cannot be well-folded in isolation (a disagreement witness refutes contractibility).
fold-idp-not-well-folded :
  (C O V : Type 0) → (obs : C → O) → (y : O) → (f : C → V) →
  IDPWitness C O V obs y f → WellFolded C O obs y → Empty
fold-idp-not-well-folded C O V obs y f idp wf =
  let c1 = fst idp
      c2 = fst (snd idp)
      neq = snd (snd idp)
      p1 = snd wf c1
      p2 = snd wf c2
      eq12 = concat (λ i → p1 (~ i)) p2
  in neq (λ i → f (fst (eq12 i)))
