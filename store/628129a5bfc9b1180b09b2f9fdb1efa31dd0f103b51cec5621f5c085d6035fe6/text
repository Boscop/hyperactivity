tom-step-commute : (ts : TomState) → (inst : IsaInst) →
  (case ts of tstate ep rat _ → RatBounded ep rat) →
  tom-proj (tom-step ts inst) ≡ isa-step (tom-proj ts) inst
tom-step-commute (tstate ep rat prf) i-nop _ = λ _ → proj-arf rat prf
tom-step-commute (tstate ep rat prf) (i-imm rd imm) hb =
  funExt {lzero} {lzero} {Word} {Nat}
    {tom-proj (tom-write-rd ep rat prf rd imm)}
    {reg-write rd imm (proj-arf rat prf)}
    (tom-write-proj-r ep rat prf rd imm hb)
tom-step-commute (tstate ep rat prf) (i-addi rd rs1 imm) hb =
  funExt {lzero} {lzero} {Word} {Nat}
    {tom-proj (tom-write-rd ep rat prf rd (plus (prf (rat rs1)) imm))}
    {reg-write rd (plus (prf (rat rs1)) imm) (proj-arf rat prf)}
    (tom-write-proj-r ep rat prf rd (plus (prf (rat rs1)) imm) hb)
tom-step-commute (tstate ep rat prf) (i-alu op rd rs1 rs2) hb =
  funExt {lzero} {lzero} {Word} {Nat}
    {tom-proj (tom-write-rd ep rat prf rd (alu-eval op (prf (rat rs1)) (prf (rat rs2))))}
    {reg-write rd (alu-eval op (prf (rat rs1)) (prf (rat rs2))) (proj-arf rat prf)}
    (tom-write-proj-r ep rat prf rd (alu-eval op (prf (rat rs1)) (prf (rat rs2))) hb)
