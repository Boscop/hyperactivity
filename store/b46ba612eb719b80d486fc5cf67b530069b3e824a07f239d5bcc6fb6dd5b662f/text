sg-hide-glob : NkTm → Word → NkTm
sg-hide-glob ksig g =
  let kd = nk-nth (nk-args ksig) #0
      kf = nk-nth (nk-args ksig) #1
      dm = nk-nth (nk-args ksig) #2
      gm = nk-nth (nk-args ksig) #3
  in case nk-find-g-ks gm #0 g return (λ _ → NkTm) of
       some gi → nk-con #56 (nk-cons kd (nk-cons (nk-hide-at gi kf) (nk-cons dm (nk-cons gm nk-nil))))
       none → ksig
