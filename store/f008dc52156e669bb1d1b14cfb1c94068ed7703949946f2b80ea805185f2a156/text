-- ── 4. Multi-GPU NVIDIA Hopper `sm_90a` PTX `lop3.b32` Lightspeed Superkernel (`_h200.cu`) ──

lir-asm-lop3-lo : List Word
lir-asm-lop3-lo =
  lir-s5 "  asm(" (lir-qq "lop3.b32 %0, %1, %2, %3, 0xCA;") " : " (lir-qq "=r") "(olo) : "

lir-asm-lop3-lo2 : List Word
lir-asm-lop3-lo2 =
  list-append lir-asm-lop3-lo (lir-s5 (lir-qq "r") "(alo), " (lir-qq "r") "(blo), " (list-append (lir-qq "r") "(klo));"))

lir-asm-lop3-hi : List Word
lir-asm-lop3-hi =
  list-append (lir-s5 "  asm(" (lir-qq "lop3.b32 %0, %1, %2, %3, 0xCA;") " : " (lir-qq "=r") "(ohi) : ")
              (lir-s5 (lir-qq "r") "(ahi), " (lir-qq "r") "(bhi), " (list-append (lir-qq "r") "(khi));"))

lir-cu1 : List Word → List Word
lir-cu1 tl =
