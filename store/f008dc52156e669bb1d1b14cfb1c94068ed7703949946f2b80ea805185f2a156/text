-- lib/silicon/hx-lux-ir.hypercubical — Ontology-Free Lightspeed Hardware Emitter (`hx lux`, 43rd Engine).
-- Mechanically emits 6 physical fabrication & silicon-benchmark artifacts from ONE pure .hypercubical source:
--   1. `<prefix>_asic.sv`       : Ontology-Free Self-Timed GALS + Golay-23 Zero-Table Chord Router + Cryptic Plaquette ASIC (Verilog-2001).
--   2. `<prefix>_m2_pcb.gbr`    : Extended Gerber RS-274X M.2-2280 / USB4 Personal Supercomputer Carrier PCB.
--   3. `<prefix>_bom_cpl.csv`   : Complete 5-Tier Physical Hardware BOM (`LUX-NANO` -> `LUX-DESK` Diamond Orb -> `LUX-BLADE` -> `LUX-POD` -> `LUX-OMEGA`).
--   4. `<prefix>_h200.cu`       : Multi-GPU NVIDIA Hopper `sm_90a` PTX `lop3.b32` Plaquette + Golay-23 + Wire-Codec Superkernel.
--   5. `<prefix>_metal.metal` + `<prefix>_metal_host.m` : Apple Silicon Metal (`MTLMathModeSafe`) Lightspeed Plaquette Verifier.
import "../core.hypercubical"
import "../prim.hypercubical"

lir-q : List Word
lir-q = cons #34 nil

lir-esc-n : List Word
lir-esc-n = cons #92 (cons #110 nil)

lir-qq : List Word → List Word
lir-qq s = list-append lir-q (list-append s lir-q)

lir-s3 : List Word → List Word → List Word → List Word
lir-s3 a b c = list-append a (list-append b c)

lir-s5 : List Word → List Word → List Word → List Word → List Word → List Word
lir-s5 a b c d e = list-append a (list-append b (list-append c (list-append d e)))

lir-cstmt : List Word → List Word → List Word → List Word
lir-cstmt pre fmt suf =
  list-append pre (list-append lir-q (list-append fmt (list-append lir-esc-n (list-append lir-q suf))))

lir-lines : List (List Word) → List Word → List Word
lir-lines nil tl = tl
lir-lines (cons s ss) tl = list-append s (cons #10 (lir-lines ss tl))

lir-l4 : List Word → List Word → List Word → List Word → List (List Word)
lir-l4 a b c d = cons a (cons b (cons c (cons d nil)))

lir-l6 : List Word → List Word → List Word → List Word → List Word → List Word → List (List Word)
lir-l6 a b c d e f = cons a (cons b (cons c (cons d (cons e (cons f nil)))))

lir-l8 : List Word → List Word → List Word → List Word → List Word → List Word → List Word → List Word → List (List Word)
lir-l8 a b c d e f g h = cons a (cons b (cons c (cons d (cons e (cons f (cons g (cons h nil)))))))

-- ── 1. Ontology-Free Synthesizable Verilog-2001 ASIC (`_asic.sv`) ──

lir-sv1 : List Word → List Word
lir-sv1 tl =
  lir-lines
    (list-append
      (lir-l8
        "// SPDX-FileCopyrightText: 2026 Avik Jain / Hyperactive Labs, Inc."
        "// Mechanically generated by lib/silicon/hx-lux-ir.hypercubical (43rd Engine: hx lux)"
        "// ONTOLOGY-FREE LIGHTSPEED WAVE-PLAQUETTE & GOLAY-23 ZERO-TABLE OPTICAL CHORD ASIC"
        "`default_nettype none"
        "module hx_lux_golay23_chord ("
        "  input  wire [10:0] syn_in,"
        "  input  wire [10:0] dst_syn,"
        "  output wire [10:0] syn_next,")
      (lir-l8
        "  output wire        antipode_fold,"
        "  output wire [3:0]  hop_dist_ub"
        ");"
        "  assign syn_next = {syn_in[9:0], 1'b0} ^ (syn_in[10] ? 11'h2E3 : 11'h000);"
        "  wire [10:0] diff = syn_in ^ dst_syn;"
        "  wire [3:0] hw = diff[0]+diff[1]+diff[2]+diff[3]+diff[4]+diff[5]+diff[6]+diff[7]+diff[8]+diff[9]+diff[10];"
        "  assign antipode_fold = (hw > 4'd5);"
        "  assign hop_dist_ub = antipode_fold ? (4'd11 - hw) : hw;"))
    (lir-lines
      (lir-l4
        "endmodule"
        ""
        "module hx_lux_cryptic_plaquette ("
        "  input  wire [63:0] edge_n, input wire [63:0] edge_e, input wire [63:0] edge_s, input wire [63:0] edge_w,")
      tl)

lir-sv2 : List Word → List Word
lir-sv2 tl =
  lir-lines
    (list-append
      (lir-l8
        "  input  wire [63:0] gauge_mask,"
        "  input  wire        pol_mode,"
        "  output wire [63:0] plaq_out,"
        "  output wire        stokes_closed"
        ");"
        "  wire [63:0] a = edge_n ^ gauge_mask;"
        "  wire [63:0] b = edge_e ^ gauge_mask;"
        "  wire [63:0] c = edge_s ^ gauge_mask;")
      (lir-l8
        "  wire [63:0] d = edge_w ^ gauge_mask;"
        "  wire [63:0] coboundary = (a ^ b) ^ (b ^ c) ^ (c ^ d) ^ (d ^ a);"
        "  assign stokes_closed = (coboundary == 64'd0);"
        "  wire [63:0] cut_ab = pol_mode ? (a | b) : (a & b);"
        "  wire [63:0] cut_cd = pol_mode ? (~(c | d)) : (~(c & d));"
        "  assign plaq_out = (cut_ab ^ cut_cd) ^ gauge_mask;"
        "endmodule"
        ""))
    (lir-lines
      (list-append
        (lir-l8
          "module hx_lux_top ("
          "  input  wire        clk,"
          "  input  wire        rst_n,"
          "  input  wire        wave_valid,"
          "  input  wire        pol_mode,"
          "  input  wire [10:0] dst_syn,"
          "  input  wire [11:0] bf16_packed12,"
          "  input  wire [7:0]  bf16_pal_exp,")
        (lir-l8
          "  input  wire [63:0] wave_in_a,"
          "  input  wire [63:0] wave_in_b,"
          "  input  wire [63:0] gauge_key,"
          "  output reg  [63:0] wave_out,"
          "  output reg  [10:0] cur_syn,"
          "  output wire [15:0] bf16_unpacked,"
          "  output wire        antipode_fold,"
          "  output wire        stokes_ok"))
      (lir-lines
        (list-append
          (lir-l8
            ");"
            "  wire [10:0] next_syn;"
            "  wire [3:0]  hop_ub;"
            "  wire [63:0] plaq_y;"
            "  assign bf16_unpacked = {bf16_packed12[11], bf16_pal_exp, bf16_packed12[6:0]};"
            "  hx_lux_golay23_chord u_g23 (.syn_in(cur_syn), .dst_syn(dst_syn), .syn_next(next_syn), .antipode_fold(antipode_fold), .hop_dist_ub(hop_ub));"
            "  hx_lux_cryptic_plaquette u_plq ("
            "    .edge_n(wave_in_a), .edge_e(wave_in_b), .edge_s(wave_out), .edge_w({48'd0, bf16_unpacked}),")
          (lir-l8
            "    .gauge_mask(gauge_key), .pol_mode(pol_mode), .plaq_out(plaq_y), .stokes_closed(stokes_ok));"
            "  always @(posedge clk) begin"
            "    if (!rst_n) begin cur_syn <= 11'h001; wave_out <= 64'd0; end"
            "    else if (wave_valid) begin cur_syn <= next_syn ^ {7'd0, hop_ub}; wave_out <= plaq_y; end"
            "  end"
            "endmodule"
            "`default_nettype wire"
            ""))
        tl))

lir-asic-sv : List Word
lir-asic-sv = lir-sv1 (lir-sv2 nil)

