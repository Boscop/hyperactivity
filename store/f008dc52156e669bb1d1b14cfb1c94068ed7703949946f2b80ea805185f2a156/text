    (list-append
      (lir-l8
        "// Mechanically generated by lib/silicon/hx-lux-ir.hypercubical (43rd Engine: hx lux)"
        "// MULTI-GPU NVIDIA HOPPER (H200 / H100 sm_90a) ONTOLOGY-FREE LIGHTSPEED PLAQUETTE & GOLAY-23 KERNEL"
        "#include <cuda_runtime.h>"
        "#include <stdio.h>"
        "#include <stdint.h>"
        "#include <stdlib.h>"
        "#include <sys/time.h>"
        "static double now_s(void) { struct timeval tv; gettimeofday(&tv, NULL); return tv.tv_sec + tv.tv_usec * 1e-6; }")
      (lir-l8
        "__device__ __forceinline__ uint64_t lux_lop3_cryptic64(uint64_t a, uint64_t b, uint64_t k) {"
        "#if __CUDA_ARCH__ >= 500"
        "  uint32_t alo=(uint32_t)a, ahi=(uint32_t)(a>>32), blo=(uint32_t)b, bhi=(uint32_t)(b>>32), klo=(uint32_t)k, khi=(uint32_t)(k>>32);"
        "  uint32_t olo, ohi;"
        lir-asm-lop3-lo2
        lir-asm-lop3-hi
        "  return ((uint64_t)ohi << 32) | (uint64_t)olo;"
        "#else"))
    (lir-lines
      (lir-l4
        "  return (a & k) | (b & (~k));"
        "#endif"
        "}"
        "__global__ void __launch_bounds__(256, 4) hx_lux_lightspeed_kernel(uint64_t* __restrict__ out_sink, uint64_t gauge_key, uint32_t iters) {")
      tl)

