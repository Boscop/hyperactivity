  lir-lines
    (list-append
      (lir-l8
        "// Mechanically generated by lib/silicon/hx-lux-ir.hypercubical — Apple Metal Lightspeed Plaquette Kernel"
        "#include <metal_stdlib>"
        "using namespace metal;"
        "kernel void hx_lux_plaquette_metal("
        "    device ulong*       sink      [[buffer(0)]],"
        "    constant ulong&     gauge_key [[buffer(1)]],"
        "    constant uint&      iters     [[buffer(2)]],"
        "    uint tid [[thread_position_in_grid]]) {")
      (lir-l8
        "  ulong n = 0xAAAAAAAAAAAAAAAAul ^ (ulong(tid) * 0x9E3779B97F4A7C15ul);"
        "  ulong e = 0xCCCCCCCCCCCCCCCCul ^ (ulong(tid) * 0xBF58476D1CE4E5B9ul);"
        "  ulong s = 0xF0F0F0F0F0F0F0F0ul ^ gauge_key;"
        "  ulong w = 0xFF00FF00FF00FF00ul ^ (~gauge_key);"
        "  uint  syn = (tid & 0x7FFu) | 1u;"
        "  ulong stokes_err = 0ul;"
        "  for (uint it = 0; it < iters; it++) {"
        "    stokes_err |= (n ^ e) ^ (e ^ s) ^ (s ^ w) ^ (w ^ n);"))
    (lir-lines
      (lir-l6
        "    ulong p0 = (n & gauge_key) | (e & (~gauge_key));"
        "    ulong p1 = (s & (p0 ^ gauge_key)) | (w & (~(p0 ^ gauge_key)));"
        "    n = p0 ^ s; e = p1 ^ w; s = p0 ^ n; w = p1 ^ e;"
        "    syn = ((syn << 1u) & 0x7FFu) ^ (((syn & 0x400u) != 0u) ? 0x2E3u : 0u); w ^= ulong(syn);"
        "  }"
        "  if (stokes_err != 0ul || (n == 1ul && e == 2ul)) sink[tid & 1023u] = stokes_err ^ n; }")
      nil)

