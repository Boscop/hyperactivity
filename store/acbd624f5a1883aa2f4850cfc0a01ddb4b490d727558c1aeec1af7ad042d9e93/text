op-sub : (S : List Bool) → (A B : IV) → (v va vb : (Nat × Nat) × Nat) → ivc A × encl S A (fst va) (snd va) → ivc B × encl S B (fst vb) (snd vb) → le (suc zero) (snd va) → le (suc zero) (snd vb) →
  qeq v (zplus (zsc (fst va) (snd vb)) (zsc (the (Nat × Nat) (snd (fst vb) , fst (fst vb))) (snd va)) , times (snd va) (snd vb)) → ivc (iv-sub A B) × encl S (iv-sub A B) (fst v) (snd v)
op-sub S A B v va vb RA RB la lb qv = (iv-add-canon A (iv-neg B) (fst RA) (iv-neg-canon B (fst RB)) ,
  encl-qeq S (iv-sub A B) (zplus (zsc (fst va) (snd vb)) (zsc (the (Nat × Nat) (snd (fst vb) , fst (fst vb))) (snd va))) (times (snd va) (snd vb)) (fst v) (snd v)
    (iv-sub-sound S A B (fst va) (fst vb) (snd va) (snd vb) (fst RA) (fst RB) (snd RA) (snd RB)) qv (le1-times (snd va) (snd vb) la lb))
