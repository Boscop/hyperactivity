-- a token as the page shows it, given the names the source binds
hi-link-in : List Word → List (List Word) → List Word → List Word
hi-link-in rd bs nil = nil
hi-link-in rd bs (cons x r) = if orB (h-not (hi-ident-char x)) (h-null (hi-core (cons x r))) then s-esc (cons x r) else
  if h-has (hi-core (cons x r)) bs then list-append (hi-a rd (hi-core (cons x r)) (hi-core (cons x r))) (s-esc (h-drop-n (list-length (hi-core (cons x r))) (cons x r))) else s-esc (cons x r)
