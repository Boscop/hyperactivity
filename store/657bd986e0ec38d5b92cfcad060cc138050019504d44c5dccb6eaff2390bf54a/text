-- the lowest level between lo/2^m and hi/2^m by halving, in integers: each step certified either way; where neither
-- count is certified at this precision, or the ends are one apart, the search stops
dy-findz : BZ → BZ → List (List BZ) → List (List BZ) → Nat → BZ → BZ → BZ × BZ
dy-findz t e hz sz n lo hi = case n of
  zero → (lo , hi)
  suc m → if dy-le (bz-sub hi lo) bz-one then (lo , hi) else (if dy-countz 0 t e (bz-fdiv (bz-add lo hi) (cons false (cons true nil))) hz sz then dy-findz t e hz sz m (bz-fdiv (bz-add lo hi) (cons false (cons true nil))) hi else (if dy-countz 1 t e (bz-fdiv (bz-add lo hi) (cons false (cons true nil))) hz sz then dy-findz t e hz sz m lo (bz-fdiv (bz-add lo hi) (cons false (cons true nil))) else (lo , hi)))
