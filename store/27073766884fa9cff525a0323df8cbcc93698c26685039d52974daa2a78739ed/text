-- Theorem: what follows the first line of a printed text is its text, when the name holds no newline
after-line-print : (n s : List Word) → isTrue (no-newline n) → Path (List Word) (raw-after-first-line (text-written-raw-print n s)) s
after-line-print nil s h = refl
after-line-print (cons b r) s h = after-line-step (weq b #10) (text-written-raw-print r s) (raw-after-first-line (text-written-raw-print r s)) s r (after-line-print r s) h
