flush-concat : (cur : List Word) → (rest : List (List Word)) → concat-all (flush cur rest) ≡ list-append (rev-into cur nil) (concat-all rest)
flush-concat cur rest =
  case cur return λ w → concat-all (flush w rest) ≡ list-append (rev-into w nil) (concat-all rest) of
    nil → λ i → concat-all rest
    cons c cs → λ i → list-append (rev-into (cons c cs) nil) (concat-all rest)
