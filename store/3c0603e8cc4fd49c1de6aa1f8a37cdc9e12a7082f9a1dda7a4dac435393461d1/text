q-hyps bs E d f mo c tel prm lnil fs = q-dims bs E d f mo c tel prm fs lnil
q-hyps bs E d f mo c tel prm (lcons y rest) fs =
  -- (a path-, function- or pair-typed field's hypothesis, over the motive, is a variable of unstated type)
  let h = %var (case snd y of sh-rec → (case mo of some P → P (fst y); none → fromopt E Uw); _ → Uw)
  in omap clam (q-hyps (lcons (qh (var-level h)) bs) E d f mo c tel (lsnoc prm h) rest fs)
