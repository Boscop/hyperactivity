-- in one text: how many occurrences of the end of length e it holds, and what followed the first q met
c-after-rt : (n : Nat) → Bytes n → (k : Nat) → Bytes k → Word → Word → List Word → List Word → List Word → Proc W (Word × List (List Word))
c-after-rt n p k f m e d t qs = bind (c-lines-of e d qs) (λ ls → ret (m-count n p k f m e (list-length t) (text-bytes t) , ls))
