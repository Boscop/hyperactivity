-- ============================================================================
-- 3. 4D Simplicial Pachner Move Invariance of S³ Boundary Euler Characteristic
-- ============================================================================
-- Under a 1→4 Pachner move on a 3-sphere triangulation (subdividing one tetrahedron into 4):
--   ΔV = +1, ΔE = +4, ΔF = +6, ΔT = +3  ⇒  (V+1) - (E+4) + (F+6) - (T+3) = V - E + F - T.
-- Under a 2→3 Pachner move (replacing 2 tetrahedra sharing a triangle with 3 around an edge):
--   ΔV = 0, ΔE = +1, ΔF = +2, ΔT = +1   ⇒  V - (E+1) + (F+2) - (T+1) = V - E + F - T.
-- Proved universally over chem/algebra.cub (`al-id`) for ALL V, E, F, T!
lqg-pachner-14-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-pachner-14-poly A ad mu q vs =
  (λ g sub →
    let V = g 0; E = g 1; F = g 2; T = g 3
        chi0 = sub (ad V F) (ad E T)
        chi1 = sub (ad (ad V (q (fn-q 1 1))) (ad F (q (fn-q 6 1))))
                   (ad (ad E (q (fn-q 4 1))) (ad T (q (fn-q 3 1))))
    in (chi1 , chi0))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
