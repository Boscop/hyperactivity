-- THEOREM 3: UNIVERSAL ASSOCIATIVITY OF SWARM LEASE EPOCH MERGE (ALL a b c : Nat)
ml-thm-max-assoc : (a b c : Nat) → ml-max (ml-max a b) c ≡ ml-max a (ml-max b c)
ml-thm-max-assoc zero    b       c       = refl
ml-thm-max-assoc (suc a) zero    c       = refl
ml-thm-max-assoc (suc a) (suc b) zero    = refl
ml-thm-max-assoc (suc a) (suc b) (suc c) = ml-cong suc (ml-thm-max-assoc a b c)
