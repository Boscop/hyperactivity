pauli1-op p-Y p-Z = (ph-i  , p-X)
pauli1-op p-Z p-I = (ph-1  , p-Z)
pauli1-op p-Z p-X = (ph-i  , p-Y)
pauli1-op p-Z p-Y = (ph-mi , p-X)
pauli1-op p-Z p-Z = (ph-1  , p-I)
