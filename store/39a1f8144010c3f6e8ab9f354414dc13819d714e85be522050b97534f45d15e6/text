-- the identity with k states below: Σ E_i w_i + E·w − (E_{k+1} − Σ(E_{k+1}−E_i)d_i)·W = (E − E_{k+1})·w + slack
tb-tailk-at : BQ → BQ → BQ → List BQ → List BQ → List BQ → Bool
tb-tailk-at ek e w es ws ds = fn-eq (fn-sub (bq-add (ln-dot es ws) (bq-mul e w)) (bq-mul (fn-sub ek (tb-drop ek es ds)) (bq-add (tb-sum ws) w))) (bq-add (bq-mul (fn-sub e ek) w) (tb-slack ek (bq-add (tb-sum ws) w) es ws ds))
