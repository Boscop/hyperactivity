-- (part of language-support)
wml_size : (nbytes : ZI) → (addr : Bits #48) → (sailval : ZI) → MS Unit
wml_size nbytes addr sailval =
  λ σ →
    if (z-lt nbytes (zpos #6)) then
      (if (z-lt nbytes (zpos #2)) then
         (if (z-eq nbytes (zpos #1)) then
            the (MS Unit)
              (wml_size-case1 addr sailval) σ
          else
            the (MS Unit)
              (wml_size-case8 nbytes addr sailval) σ)
       else
         (if (z-lt nbytes (zpos #4)) then
            (if (z-eq nbytes (zpos #2)) then
               the (MS Unit)
                 (wml_size-case2 addr sailval) σ
             else
               the (MS Unit)
                 (wml_size-case8 nbytes addr sailval) σ)
          else
            (if (z-eq nbytes (zpos #4)) then
               the (MS Unit)
                 (wml_size-case3 addr sailval) σ
             else
               the (MS Unit)
                 (wml_size-case8 nbytes addr sailval) σ)))
    else
      (if (z-lt nbytes (zpos #10)) then
         (if (z-lt nbytes (zpos #8)) then
            (if (z-eq nbytes (zpos #6)) then
               the (MS Unit)
                 (wml_size-case4 addr sailval) σ
             else
               the (MS Unit)
                 (wml_size-case8 nbytes addr sailval) σ)
          else
            (if (z-eq nbytes (zpos #8)) then
               the (MS Unit)
                 (wml_size-case5 addr sailval) σ
             else
               the (MS Unit)
                 (wml_size-case8 nbytes addr sailval) σ))
       else
         (if (z-lt nbytes (zpos #16)) then
            (if (z-eq nbytes (zpos #10)) then
               the (MS Unit)
                 (wml_size-case6 addr sailval) σ
             else
               the (MS Unit)
                 (wml_size-case8 nbytes addr sailval) σ)
          else
            (if (z-eq nbytes (zpos #16)) then
               the (MS Unit)
                 (wml_size-case7 addr sailval) σ
             else
               the (MS Unit)
                 (wml_size-case8 nbytes addr sailval) σ)))
