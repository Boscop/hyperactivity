-- so the order in which two pools meet, and meeting again, change no view
po-view-order : {E : Type} → (es : List E) → (follows : E → E → Bool) → (p q : Pool E) → po-live es follows (po-union p q) ≡ po-live es follows (po-union q p)
po-view-order {E} es follows p q = po-view-membership es follows (po-union p q) (po-union q p) (po-union-comm p q)
