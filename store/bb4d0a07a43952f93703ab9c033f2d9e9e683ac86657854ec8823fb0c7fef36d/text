-- ---------------------------------------------------------------- faces
-- a face, in normal form, as the cases in which it holds: each case a list of a variable and the
-- end it is at
nk-lit-of : NkTm → NkTm
nk-lit-of (nk-free x) = nk-con #40 (nk-cons (nk-num x) (nk-cons nk-i1 nk-nil))
nk-lit-of (nk-op h (nk-free x) as) = nk-con #40 (nk-cons (nk-num x) (nk-cons nk-i0 nk-nil))
nk-lit-of t = nk-fail
