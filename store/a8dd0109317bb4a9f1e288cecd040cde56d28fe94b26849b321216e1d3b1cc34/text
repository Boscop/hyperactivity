-- the pencil of n electrons at charge z on k modes of hydrogen's orbitals, in the sector with j spins down
df-atom : BQ → Nat → Nat → Nat → BQ → List (List BQ)
df-atom z k n j lam = df-pen lam (fk-h (fk-d (fk-tab z)) (fk-h1 (fk-tab z)) (fk-v (fk-tab z)) (fk-filt j (fk-states k n))) (fk-s (fk-d (fk-tab z)) (fk-filt j (fk-states k n)))
