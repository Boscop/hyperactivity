-- ---------------------------------------------------------------- the index's bytes, read where they are
-- a number in four bytes, low first
si-rd4 : (n : Nat) → Bytes n → Word → Word
si-rd4 n B o = wadd (cstr-get n B o) (wmul #256 (wadd (cstr-get n B (wadd o #1)) (wmul #256 (wadd (cstr-get n B (wadd o #2)) (wmul #256 (cstr-get n B (wadd o #3)))))))
