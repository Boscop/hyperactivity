-- the entry from its code as written (src-of), so the calls it keeps are still calls in it
jit-plan : Word → Lst Rule → Plan
jit-plan g rules =
  case unfold g return (λ _ → Plan) of
    none → (not-fo reflect (cglob g) , (false , (cwlit #0 , (cwlit #0 , lnil))))
    some c → jit-plan-at g (opt-or (def-type-code g) cword) rules (opt-or (src-of g) c)
