-- the graph's JSON, made again when anything under the repository has changed
s-graph : List Word → List Word → Proc W (List Word)
s-graph st m = bind (h-read (list-append st "/views/stamp")) (λ s → bind (h-dir-time (toNat #12) ".") (λ now →
  bind (if h-eq (s-or nil s) (h-decimal now) then ret {lzero} {W} #0 else h-run (cons m (cons "lib/views.cub" nil))) (λ r →
  bind (h-read (list-append st "/views/graph.json")) (λ j → ret (s-response "application/json" (s-or "{}" j))))))
