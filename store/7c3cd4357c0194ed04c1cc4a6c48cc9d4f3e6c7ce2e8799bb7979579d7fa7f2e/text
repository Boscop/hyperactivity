-- every step of the computed chain surely positive
run-pos : List Bool → List Bool → (Nat → IV → Nat → IV) → IE → Nat → IV × Bool → Bool
run-pos S S2 envt st n = case n return λ w → IV × Bool → Bool of
  zero → λ s0 → true
  suc g → λ s0 → both (iv-pos-sure (fst (ieval S S2 (envt (suc g) (fst s0)) st))) (rec g (istep s0 (ieval S S2 (envt (suc g) (fst s0)) st)))
