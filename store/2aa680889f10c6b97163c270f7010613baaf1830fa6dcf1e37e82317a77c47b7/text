-- the mirror's orbits, one per class
lc-orbits : List (List Bool) → List (List (List Bool))
lc-orbits xs = case xs of
  nil → nil
  cons s rest → if lc-beq s (lc-revonto s nil) then cons (cons s nil) (lc-orbits rest)
    else (if lc-ltb s (lc-revonto s nil) then cons (cons s (cons (lc-revonto s nil) nil)) (lc-orbits rest) else lc-orbits rest)
