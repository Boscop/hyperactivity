rev-into-app : {A : Type} → (l acc : List A) → rev-into l acc ≡ list-append (rev-into l nil) acc
rev-into-app l =
  case l return λ w → (acc : List A) → rev-into w acc ≡ list-append (rev-into w nil) acc of
    nil → λ acc i → acc
    cons x r →
      λ acc →
        concat (rec r (cons x acc))
          (concat (sym (app-assoc (rev-into r nil) (cons x nil) acc))
             (cong (λ u → list-append u acc) (sym (rec r (cons x nil)))))
