-- relabelling an arrangement: the map carries the points and the rotation paths with them, so an
-- arrangement is transported as a configuration and not as a triple
cyc-map : (A : Type 0) → (B : Type 0) → (A → B) → Cyc A → Cyc B
cyc-map A B f z =
  case z return (λ w → Cyc B) of
    cyc a b c → cyc (f a) (f b) (f c)
    cyc-rot a b c i → cyc-rot (f a) (f b) (f c) i
