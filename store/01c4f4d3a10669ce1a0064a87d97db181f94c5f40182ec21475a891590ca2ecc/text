import "host.hypercubical"

m3-trans : {A : Type} → {x y z : A} → x ≡ y → y ≡ z → x ≡ z
m3-trans {A} {x} p q = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

m3-cong : {A B : Type} → (f : A → B) → {x y : A} → x ≡ y → f x ≡ f y
m3-cong f p = λ i → f (p i)

record MetaStage (Code Sem : Type) =
  { ms-compile : Code → Code
  ; ms-eval    : Code → Sem
  ; ms-sound   : (c : Code) → ms-eval (ms-compile c) ≡ ms-eval c
  }

m3-iter : {A : Type} → Nat → (A → A) → A → A
m3-iter zero    _ x = x
m3-iter (suc n) f x = f (m3-iter n f x)

-- UNIVERSAL THEOREM 1 (ARBITRARY n-LEVEL CODE-WRITES-CODE-WRITES-CODE SOUNDNESS — 0 POSTULATES!):
m3-thm-tower-sound : {Code Sem : Type} → (st : MetaStage Code Sem) → (n : Nat) → (c : Code) →
  ms-eval st (m3-iter n (ms-compile st) c) ≡ ms-eval st c
m3-thm-tower-sound st zero    c = refl
m3-thm-tower-sound st (suc n) c =
  m3-trans (ms-sound st (m3-iter n (ms-compile st) c)) (m3-thm-tower-sound st n c)

record AutoFix (S : Type) =
  { af-err    : S → Nat
  ; af-repair : S → S
  ; af-drop   : (s : S) → af-err (af-repair s) ≡ predN (af-err s)
  }

m3-iter-pred-comm : (k : Nat) → (x : Nat) → m3-iter k predN (predN x) ≡ predN (m3-iter k predN x)
m3-iter-pred-comm zero    x = refl
m3-iter-pred-comm (suc k) x = m3-cong predN (m3-iter-pred-comm k x)

m3-iter-pred-self : (n : Nat) → m3-iter n predN n ≡ zero
m3-iter-pred-self zero = refl
m3-iter-pred-self (suc n) =
  m3-trans (λ i → m3-iter-pred-comm n (suc n) (~ i)) (m3-iter-pred-self n)

m3-af-err-iter : {S : Type} → (af : AutoFix S) → (k : Nat) → (s : S) →
  af-err af (m3-iter k (af-repair af) s) ≡ m3-iter k predN (af-err af s)
m3-af-err-iter af zero    s = refl
m3-af-err-iter af (suc k) s =
  m3-trans (af-drop af (m3-iter k (af-repair af) s))
           (m3-cong predN (m3-af-err-iter af k s))

-- UNIVERSAL THEOREM 2 (AUTOMATED REPAIR FIXED-POINT CONVERGENCE FOR ALL STATES s : S — 0 POSTULATES!):
m3-thm-autofix-converges : {S : Type} → (af : AutoFix S) → (s : S) →
  af-err af (m3-iter (af-err af s) (af-repair af) s) ≡ zero
m3-thm-autofix-converges af s =
  m3-trans (m3-af-err-iter af (af-err af s) s) (m3-iter-pred-self (af-err af s))
