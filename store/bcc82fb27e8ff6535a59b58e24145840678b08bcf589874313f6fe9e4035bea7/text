hs-chk-diag-j : Nat → Word → Word → Word
hs-chk-diag-j zero _ acc = acc
hs-chk-diag-j (suc n) da acc =
  let db = hs-diag (fromNat n)
      okx = hs-is-diag (hs-fiber-xor da db)
      oka = hs-is-diag (hs-fiber-and da db)
      okb = hs-is-diag (%wand da (hs-fiber-and-bwd db da))
      bad = if okx then (if oka then (if okb then #0 else #1) else #1) else #1
  in hs-chk-diag-j n da (%wadd acc bad)
