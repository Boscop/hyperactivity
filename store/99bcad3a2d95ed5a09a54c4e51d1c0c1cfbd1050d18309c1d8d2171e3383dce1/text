nk-fo-tm : NkTm → Bool
nk-fo-tm (nk-var i) = true
nk-fo-tm (nk-free x) = true
nk-fo-tm (nk-num m) = true
nk-fo-tm (nk-lam b) = false
nk-fo-tm (nk-susp b) = false
nk-fo-tm (nk-con c as) = nk-fo-tm as
nk-fo-tm (nk-op h p as) = nk-and (nk-fo-tm p) (nk-fo-tm as)
nk-fo-tm (nk-match h p cs) = false
nk-fo-tm nk-nil = true
nk-fo-tm (nk-cons a d) = nk-and (nk-fo-tm a) (nk-fo-tm d)
