mm-gates : Word → List (Word × Word) → List Word → List Word
mm-gates _ nil tl = tl
mm-gates nw (cons g gs) tl =
  ms-cat (cons "  uint32_t w" (cons (ce-dec nw) (cons " = ~(w" (cons (ce-dec (fst g))
         (cons " & w" (cons (ce-dec (snd g)) (cons ");" (cons ce-nl
         (cons (mm-gates (%wsucc nw) gs tl) nil)))))))))
