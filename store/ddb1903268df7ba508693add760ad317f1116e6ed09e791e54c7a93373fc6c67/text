count-lt-split : {o : Ord} → (k : El o) → (l a : List (El o)) → (x : El o) → (r : List (El o)) → list-append a (cons x r) ≡ l →
                 plus (count-lt k a) (plus (one-if (not (leq k x))) (count-lt k r)) ≡ count-lt k l
count-lt-split k l a x r ea = tr (count-lt k (list-append a (cons x r))) (sym (count-lt-app k a (cons x r))) (λ i → count-lt k (ea i))
