lir-metal-host : List Word
lir-metal-host =
  lir-lines
    (list-append
      (lir-l8
        "// Mechanically generated by lib/silicon/hx-lux-ir.hypercubical — Apple Metal Lightspeed Host"
        "#import <Foundation/Foundation.h>"
        "#import <Metal/Metal.h>"
        "#include <stdio.h>"
        "#include <stdint.h>"
        "#include <sys/time.h>"
        "static double now_ms(void) { struct timeval tv; gettimeofday(&tv, NULL); return tv.tv_sec * 1000.0 + tv.tv_usec * 1e-3; }"
        "int main(int argc, char** argv) { @autoreleasepool {")
      (lir-l8
        (lir-s3 "  const char* mp = (argc > 1) ? argv[1] : " (lir-qq "/tmp/hy_out/hx_lux_metal.metal") ";")
        "  id<MTLDevice> dev = MTLCreateSystemDefaultDevice(); if (!dev) return 1;"
        "  NSError* err = nil; NSString* src = [NSString stringWithContentsOfFile:[NSString stringWithUTF8String:mp] encoding:NSUTF8StringEncoding error:&err];"
        "  MTLCompileOptions* opts = [[MTLCompileOptions alloc] init]; opts.mathMode = MTLMathModeSafe;"
        "  id<MTLLibrary> lib = [dev newLibraryWithSource:src options:opts error:&err]; if (!lib) return 2;"
        (lir-s3 "  id<MTLComputePipelineState> pso = [dev newComputePipelineStateWithFunction:[lib newFunctionWithName:@" (lir-qq "hx_lux_plaquette_metal") "] error:&err];")
        "  id<MTLCommandQueue> q = [dev newCommandQueue];"
        "  id<MTLBuffer> bSink = [dev newBufferWithLength:1024*sizeof(uint64_t) options:MTLResourceStorageModeShared];"))
    (lir-lines
      (list-append
        (lir-l8
          "  memset([bSink contents], 0, 1024*sizeof(uint64_t));"
          "  uint64_t gkey = 0x87A5BF7891ACB902ull; uint32_t iters = 1024u; NSUInteger grid = 4194304u;"
          "  double t0 = now_ms();"
          "  id<MTLCommandBuffer> cb = [q commandBuffer]; id<MTLComputeCommandEncoder> enc = [cb computeCommandEncoder];"
          "  [enc setComputePipelineState:pso]; [enc setBuffer:bSink offset:0 atIndex:0];"
          "  [enc setBytes:&gkey length:8 atIndex:1]; [enc setBytes:&iters length:4 atIndex:2];"
          "  [enc dispatchThreads:MTLSizeMake(grid, 1, 1) threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];"
          "  [enc endEncoding]; [cb commit]; [cb waitUntilCompleted]; double dt_ms = now_ms() - t0;")
        (lir-l4
          "  uint64_t* sp = (uint64_t*)[bSink contents]; uint64_t err_or = 0ull; for (int i = 0; i < 1024; i++) err_or |= sp[i];"
          "  double gplaq_s = ((double)grid * (double)iters) / (dt_ms * 1e6); double tbit_s = (gplaq_s * 64.0 * 6.0) / 1e3;"
          (lir-cstmt "  printf(" "HX_LUX_METAL_OK device=%s threads=%lu iters=%u dt_ms=%.3f G_plaquettes_s=%.2f T_bit_interactions_s=%.2f stokes_err=%llu" ", [[dev name] UTF8String], (unsigned long)grid, iters, dt_ms, gplaq_s, tbit_s, (unsigned long long)err_or);")
          "  return (err_or == 0ull) ? 0 : 3; } }"))
      nil)
