-- Standalone C driver loop for `Step W Word` processes (sdone=0, scmd=1; w-exit=4, w-fd-write=16, w-file-write-named=18)
ce-world-driver : List Word
ce-world-driver =
  list-append "static unsigned char *hy_list_bytes(uint64_t lst, size_t *out_n) { size_t n = 0, cap = 256; unsigned char *b = malloc(cap); uint64_t cur = lst; while (((uint64_t *)cur)[0] == 1) { if (n + 1 >= cap) { cap *= 2; b = realloc(b, cap); } b[n++] = (unsigned char)((uint64_t *)cur)[1]; cur = ((uint64_t *)cur)[2]; } b[n] = 0; *out_n = n; return b; }" (list-append ce-nl
  (list-append "static uint64_t hy_run_world(uint64_t st) { for (;;) { uint64_t *p = (uint64_t *)st; if (p[0] == 0) return p[1]; uint64_t *cm = (uint64_t *)p[1]; uint64_t k = p[2]; uint64_t resp = 0; if (cm[0] == 4) exit((int)cm[1]); else if (cm[0] == 16) { size_t n; unsigned char *b = hy_list_bytes(cm[2], &n); size_t w = fwrite(b, 1, n, cm[1] == 2 ? stderr : stdout); free(b); resp = (uint64_t)w; } else if (cm[0] == 18) { size_t pn, tn; unsigned char *path = hy_list_bytes(cm[1], &pn); unsigned char *txt = hy_list_bytes(cm[2], &tn); FILE *f = fopen((const char *)path, "
  (list-append (cons #34 (list-append "wb" (cons #34 nil)))
  (list-append "); size_t w = f ? fwrite(txt, 1, tn, f) : 0; if (f) fclose(f); free(path); free(txt); resp = (uint64_t)w; } else abort(); st = hy_app(k, resp); } }" ce-nl))))
