-- Universal step identity: (d+1)(d+3) - d(d+2) = 2d + 3 (strictly increasing discrete spectrum).
lqg-casimir-step-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-casimir-step-poly A ad mu q vs =
  (λ g sub →
    let d  = g 0
        q1 = q (fn-q 1 1)
        q2 = q (fn-q 2 1)
        q3 = q (fn-q 3 1)
        lhs = sub (mu (ad d q1) (ad d q3)) (mu d (ad d q2))
        rhs = ad (mu q2 d) q3
    in (lhs , rhs))
  (λ i → al-nth A (q (fn-q 0 1)) i vs) (al-gsub A ad mu q)
