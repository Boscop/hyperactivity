-- standalone C11 process emitter for Step W Unit programs (lib/guard.cub g-run, lib/views.cub v-run, lib/hyperactive.cub hy-run)
emit-c-proc-unit : Code → List Word
emit-c-proc-unit (cglob g) =
  emit-c-proc-unit-program g (x-forms-all (snd (program-of-at ce-src g (opt-or (ce-src g) cword) #2048)))
emit-c-proc-unit c = "/* not a definition */"
