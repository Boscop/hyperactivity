nk-check-ihs : (NkTm → Word → NkTm → NkTm → NkTm) → NkTm → NkTm → Word → Word → Word → NkTm → NkTm → NkTm → NkTm → NkTm → Bool
nk-check-ihs chk kdefs curCtx curN di j P fvsOrig (nk-cons v vr) (nk-cons (nk-num rf) rr) br =
  if %weq rf #1
    then (if nk-is-lam br
            then let ihTy = nk-norm-in-s kdefs curCtx curN (nk-app P v)
                     c2 = nk-ext-s kdefs curCtx curN ihTy
                 in nk-check-ihs chk kdefs c2 (%wsucc curN) di j P fvsOrig vr rr (nk-subst (nk-lam-body br) #0 (nk-free curN))
            else false)
    else nk-check-ihs chk kdefs curCtx curN di j P fvsOrig vr rr br
nk-check-ihs chk kdefs curCtx curN di j P fvsOrig fvs recs br =
  let exBr = nk-norm-in-s kdefs curCtx curN (nk-app P (nk-mk-dcon di j fvsOrig))
  in if nk-failed (chk curCtx curN br exBr) then false else true
