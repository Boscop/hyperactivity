sg-push-ref : List Word → Lst (Bool × List Word) → Lst (Bool × List Word)
sg-push-ref nil acc = acc
sg-push-ref (cons c r) acc =
  let tok = sg-rev-w (cons c r) nil
      h = sg-whd tok
      t = sg-wtl tok
      sp = nk-split-dot t
  in if andB (%weq h #71) (%weq (nk-wlist-len t) #64) then lcons (false , t) acc
     else if andB (%weq h #68) (%weq (nk-wlist-len t) #64) then lcons (true , t) acc
     else if andB (%weq h #67) (%weq (nk-wlist-len (fst sp)) #64) then lcons (true , fst sp) acc
     else acc
