sc-h5 : List Word → List Word
sc-h5 tail =
  hw-ln "    // 4. Parametric 5-Tier Supercomputer Contract Table (d = 0, 4, 10, 17, 20)"
  (hw-ln (list-append "    printf(" (list-append hw-q (list-append "--- COMPILED SUPERCOMPUTER CONTRACT TIERS (1 PSC-1 = 128GB HBM, 2 PFLOP/s FP8, 1.333x Wire Codec) ---" (list-append hw-esc-n (list-append hw-q ");")))))
  (hw-ln "    const int dims[5] = {0, 4, 10, 17, 20};"
  (hw-ln (list-append "    const char* names[5] = {" (list-append (psc-q "PSC-1 Personal") (list-append ", " (list-append (psc-q "HX-Rack16") (list-append ", " (list-append (psc-q "HX-Pod1K") (list-append ", " (list-append (psc-q "HX-Colossus131K") (list-append ", " (list-append (psc-q "HX-Zetta1M") "};"))))))))))
  (hw-ln "    for (int i = 0; i < 5; i++) {"
  (hw-ln "      int d = dims[i]; uint64_t N = 1ULL << d; uint64_t bis = (d==0)?0ULL:(1ULL<<(d-1));"
  (hw-ln "      double hbm_tb = (double)N * 0.128; double fp8_ef = (double)N * 0.002;"
  (hw-ln "      double eff_bis_pbps = (double)bis * 0.8 * (4.0/3.0) / 1000.0; // 800Gbps raw -> 1.067Tbps eff per link"
  (hw-ln (list-append "      printf(" (list-append hw-q (list-append "  d=%2d %-16s | N=%7llu | HBM=%8.1f TB | FP8=%7.2f EFLOP/s | Bisect=%6llu links (%.1f PB/s eff) | AR=%2d hops" (list-append hw-esc-n (list-append hw-q ", d, names[i], N, hbm_tb, fp8_ef, bis, eff_bis_pbps, d);")))))
  (hw-ln "    }"
  (hw-ln "    // 5. CLOSED-LOOP SELF-OPTIMIZING DATACENTER (Gen 0 -> Gen 4, 1,048,576 candidate machines/gen on GPU!)"
  (hw-ln (list-append "    printf(" (list-append hw-q (list-append "--- CLOSED-LOOP DATACENTER(g) -> DATACENTER(g+1) RECURSIVE SELF-OPTIMIZATION (1,048,576 configs/gen) ---" (list-append hw-esc-n (list-append hw-q ");")))))
  (hw-ln "    const uint32_t NC = 1048576u;"
  (hw-ln "    id<MTLBuffer> b_gp = [dev newBufferWithLength:16 options:MTLResourceStorageModeShared];"
  (hw-ln "    id<MTLBuffer> b_sc = [dev newBufferWithLength:NC*4 options:MTLResourceStorageModeShared];"
  (hw-ln "    id<MTLBuffer> b_cf = [dev newBufferWithLength:NC*4 options:MTLResourceStorageModeShared];"
  (hw-ln "    uint32_t cur_gate = 260u, cur_pj = 200u, prev_best = 0xFFFFFFFFu; int mono_ok = 1;"
  (hw-ln "    for (uint32_t g = 0; g < 5u; g++) {"
  (hw-ln "      uint32_t* gp = (uint32_t*)b_gp.contents; gp[0] = g; gp[1] = cur_gate; gp[2] = cur_pj; gp[3] = 0u;"
  (hw-ln "      double tg = now_ms();"
  (hw-ln "      id<MTLCommandBuffer> cbg = [q commandBuffer]; id<MTLComputeCommandEncoder> eg = [cbg computeCommandEncoder];"
  (hw-ln "      [eg setComputePipelineState:p_opt]; [eg setBuffer:b_gp offset:0 atIndex:0];"
  (hw-ln "      [eg setBuffer:b_sc offset:0 atIndex:1]; [eg setBuffer:b_cf offset:0 atIndex:2];"
  (hw-ln "      [eg dispatchThreads:MTLSizeMake(NC,1,1) threadsPerThreadgroup:MTLSizeMake(256,1,1)]; [eg endEncoding]; [cbg commit]; [cbg waitUntilCompleted];"
  (hw-ln "      double dtg = now_ms() - tg;"
  (hw-ln "      uint32_t* sc = (uint32_t*)b_sc.contents; uint32_t best = 0xFFFFFFFFu, best_id = 0u;"
  (hw-ln "      for (uint32_t k = 0; k < NC; k++) if (sc[k] < best) { best = sc[k]; best_id = k; }"
  (hw-ln "      if (best > prev_best) mono_ok = 0;"
  (hw-ln "      prev_best = best;"
  (hw-ln "      uint32_t go = best_id & 0xFu, wm = (best_id >> 4u) & 3u, tc = (best_id >> 6u) & 0xFu;"
  (hw-ln "      cur_gate = (cur_gate > go*8u) ? (cur_gate - go*8u) : 40u; cur_pj = (cur_pj * 4u) / 5u;"
  (hw-ln (list-append "      printf(" (list-append hw-q (list-append "  Gen %u -> Gen %u | best_cost=%3u pJ-eq | gate_opt=%2u wire_48b=%u sc_Tc_lvl=%2u | %.2f ms (%.2f G-machines/s)" (list-append hw-esc-n (list-append hw-q ", g, g+1u, best, go, (wm==3u)?1u:0u, tc, dtg, (double)NC / (dtg * 1e6));")))))
  (hw-ln "    }"
  (hw-ln "    return (dor_err == 0u && ar_ok && wc_err == 0u && mono_ok) ? 0 : 1;"
  (hw-ln "  }"
  (hw-ln "}" tail)))))))))))))))))))))))))))))))))))
