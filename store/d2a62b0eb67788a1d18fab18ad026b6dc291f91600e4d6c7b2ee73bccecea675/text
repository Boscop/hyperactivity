-- the count of negative levels read from a Gram matrix: rows from index k; the count, and whether the matrix is
-- diagonal with nonzero diagonal
ln-count-step : BQ → Bool → Nat × Bool → Nat × Bool
ln-count-step d off c = (if ln-neg d then suc (fst c) else fst c , if off then (if fn-eq d (fn-q 0 1) then false else snd c) else false)
