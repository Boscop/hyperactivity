-- the type of a body, in normal form, or nk-fail: in a context of the types of its free variables
-- (the newest first, n of them), against the type expected if one is. One clause for each form
-- of body: a variable has its type in the context; a function is checked against a function type
-- by checking its body, opened with a new variable, against the codomain at that variable; an
-- application has the codomain of its function's type at its argument; a type former has type U
nk-ty : Nat → NkTm → Word → NkTm → NkTm → NkTm
nk-ty zero ctx n t ex = nk-fail
nk-ty (suc k) ctx n (nk-free x) ex = nk-agree (nk-nth ctx (%wsub (%wsub n #1) x)) ex
nk-ty (suc k) ctx n (nk-num m) ex = nk-agree nk-N ex
nk-ty (suc k) ctx n (nk-lam b) (nk-con c (nk-cons a (nk-cons f r))) =
  if nk-failed (nk-ty k (nk-cons a ctx) (%wsucc n) (nk-subst b #0 (nk-free n)) (nk-norm (nk-app f (nk-free n)))) then nk-fail else (if %weq c #1 then nk-pi a f else nk-fail)
nk-ty (suc k) ctx n (nk-op h f as) ex =
  nk-agree
    (if %weq h #0
     then (if nk-failed (nk-ty k ctx n (nk-nth as #0) (nk-nth (nk-args (nk-ty k ctx n f nk-nil)) #0)) then nk-fail else nk-norm (nk-app (nk-nth (nk-args (nk-ty k ctx n f nk-nil)) #1) (nk-nth as #0)))
     else (if nk-failed (nk-ty k ctx n f nk-N) then nk-fail else nk-N))
    ex
nk-ty (suc k) ctx n (nk-con c as) ex =
  nk-agree
    (if %weq c #1
     then (if nk-failed (nk-ty k ctx n (nk-nth as #0) nk-U) then nk-fail else (if nk-failed (nk-ty k ctx n (nk-nth as #1) (nk-pi (nk-norm (nk-nth as #0)) (nk-lam nk-U))) then nk-fail else nk-U))
     else nk-U)
    ex
nk-ty (suc k) ctx n t ex = nk-fail
