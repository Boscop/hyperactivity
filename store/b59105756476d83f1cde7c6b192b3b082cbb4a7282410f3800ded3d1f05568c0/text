-- the local labels at a vertex from the network's labels: + where the edge leaves the vertex, − where it enters
local-labels : List (Nat × Bool) → List SQ → List SQ
local-labels slots ns = case slots of
  nil → nil
  cons s rest → cons (if snd s then sq-nth (fst s) ns else sq-neg (sq-nth (fst s) ns)) (local-labels rest ns)
