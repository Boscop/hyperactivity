-- the bracket of the rule, by how many modes differ
fk-core : (Nat → BQ) → (Nat → Nat → BQ) → (Nat → Nat → Nat → Nat → BQ) → List Nat → List Nat → List Nat → BQ
fk-core d h v da db sh = case da of
  nil → fk-diag d h v sh
  cons a ra → (case ra of
    nil → (case db of
      nil → fn-q 0 1
      cons b rb → bq-add (h a b) (fk-sing d v a b sh))
    cons a2 ra2 → (case ra2 of
      nil → (case db of
        nil → fn-q 0 1
        cons b rb → (case rb of
          nil → fn-q 0 1
          cons b2 rb2 → fn-sub (v a a2 b b2) (v a a2 b2 b)))
      cons x y → fn-q 0 1))
