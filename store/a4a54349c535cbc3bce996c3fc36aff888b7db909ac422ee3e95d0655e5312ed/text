-- Exact hardware node-count delta (+2 offset so non-negative: 0 => -2, 1 => -1, 2 => 0, 4 => +2)
inet-rule-delta2 : INetKind → INetKind → Word
inet-rule-delta2 ik-con  ik-con  = #0   -- Annihilation: -2 nodes
inet-rule-delta2 ik-dup  ik-dup  = #0   -- Annihilation: -2 nodes
inet-rule-delta2 ik-era  ik-era  = #0   -- Double erase: -2 nodes
inet-rule-delta2 ik-num  ik-era  = #0   -- Erase number: -2 nodes
inet-rule-delta2 ik-era  ik-num  = #0
inet-rule-delta2 ik-num  ik-add  = #1   -- Fused curry: NUM(x) ⋈ ADD -> ADD1(x), -1 node
inet-rule-delta2 ik-add  ik-num  = #1
inet-rule-delta2 ik-num  ik-add1 = #1   -- Fused add:   NUM(y) ⋈ ADD1(x) -> NUM(x+y), -1 node
inet-rule-delta2 ik-add1 ik-num  = #1
inet-rule-delta2 ik-num  ik-dup  = #2   -- Unboxed dup: NUM(x) ⋈ DUP -> 2x NUM(x), 0 net nodes
inet-rule-delta2 ik-dup  ik-num  = #2
inet-rule-delta2 ik-era  ik-con  = #2   -- In-place erase: 0 net nodes
inet-rule-delta2 ik-con  ik-era  = #2
inet-rule-delta2 ik-era  ik-dup  = #2   -- In-place erase: 0 net nodes
inet-rule-delta2 ik-dup  ik-era  = #2
inet-rule-delta2 ik-con  ik-dup  = #4   -- Commutation diamond: +2 nodes
inet-rule-delta2 ik-dup  ik-con  = #4
inet-rule-delta2 _       _       = #2
