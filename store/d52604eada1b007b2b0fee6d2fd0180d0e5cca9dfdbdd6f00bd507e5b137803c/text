-- Contraction unlock: if workspace A has a local lemma f : P A → Q A and a remote result
-- r : P B arrives along e : A ≡ B, the portal immediately unlocks Q A in A's workspace!
portal-unlock :
  {A B : Type 0} → (P Q : Type 0 → Type 0) →
  (e : A ≡ B) → (f : P A → Q A) → P B → Q A
portal-unlock P Q e f r = f (portal-arrive P e r)
