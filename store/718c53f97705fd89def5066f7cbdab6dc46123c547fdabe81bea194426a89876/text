-- (part of language-support)
jcc_cmovcc_setcc_spec-case15 : MS Bool
jcc_cmovcc_setcc_spec-case15 =
  bindS {rflagsbits} {Bool} (getS {rflagsbits} x86-rflags) (λ rflags_var →
    λ σ →
      if (weq #1 (rflagsbits-zf rflags_var)) then
        the (MS Bool)
          (retS {Bool} true) σ
      else
        the (MS Bool)
          (bindS {rflagsbits} {Bool} (getS {rflagsbits} x86-rflags) (λ rflags_var →
             bindS {rflagsbits} {Bool} (getS {rflagsbits} x86-rflags) (λ rflags_var →
               retS {Bool} (b-not (weq (rflagsbits-sf rflags_var) (rflagsbits-of rflags_var)))))) σ)
