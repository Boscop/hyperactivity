-- 2. Exact Hall–Post (1967) 3-Electron Operator Partition (Zero Approximation):
--    H₃ = Σ_{i=1}^3 (t_i - Z u_i) + (v₁₂ + v₁₃ + v₂₃)
--       = Σ_{1≤i<j≤3} ((1/2)(t_i + t_j) - (Z/2)(u_i + u_j) + v_{ij}).
--    Variables (0..9): Z, t1, t2, t3, u1, u2, u3, v12, v13, v23.
chem-hall-post-3e-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-hall-post-3e-poly A ad mu q vs =
  (λ g sub →
    let Z = g 0
        t1 = g 1; t2 = g 2; t3 = g 3
        u1 = g 4; u2 = g 5; u3 = g 6
        v12 = g 7; v13 = g 8; v23 = g 9
        qh = q (fn-q 1 2)
        H3 = ad (ad (sub t1 (mu Z u1)) (ad (sub t2 (mu Z u2)) (sub t3 (mu Z u3))))
                (ad v12 (ad v13 v23))
        p12 = ad (sub (mu qh (ad t1 t2)) (mu (mu qh Z) (ad u1 u2))) v12
        p13 = ad (sub (mu qh (ad t1 t3)) (mu (mu qh Z) (ad u1 u3))) v13
        p23 = ad (sub (mu qh (ad t2 t3)) (mu (mu qh Z) (ad u2 u3))) v23
    in (H3 , ad p12 (ad p13 p23)))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
