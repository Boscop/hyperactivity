hcn-mkdir : List Word → Proc W Unit
hcn-mkdir p =
  bind (h-capture (cons "/bin/mkdir" (cons "-p" (cons p nil)))) (λ r →
    if %weq (fst r) #0 then ret {lzero} {W} unit else ret {lzero} {W} unit)

hcn-arg-at : Nat → List Word → List (List Word) → List Word
hcn-arg-at n def nil         = def
hcn-arg-at zero def (cons x xs) = x
hcn-arg-at (suc k) def (cons x xs) = hcn-arg-at k def xs

hcn-drop-with : List (List Word) → List (List Word)
hcn-drop-with nil                             = nil
hcn-drop-with (cons a (cons b (cons c rest))) =
  if h-eq a "--with" then hcn-drop-with rest else cons a (cons b (cons c rest))
hcn-drop-with xs                              = xs

hcn-bundle-key : List Word → Proc W Unit
hcn-bundle-key handle =
  let outSh = the (List Word) "/tmp/hy_out/rad2520_oracle_setup.sh"
      mkCmd = the (List Word)
                (hos-tr "test -f `$HOME/.gemini/oracle.env` && { b64=$(base64 < `$HOME/.gemini/oracle.env` | tr -d '\n\r '); printf 'mkdir -p ~/.gemini && printf %s %s | (base64 -d 2>/dev/null || base64 -D) > ~/.gemini/oracle.env && chmod 600 ~/.gemini/oracle.env && echo OK_SHARED_GEMINI_SWARM_KEY_INSTALLED\n' '%s' `$b64` > /tmp/hy_out/rad2520_oracle_setup.sh && chmod 600 /tmp/hy_out/rad2520_oracle_setup.sh && echo BUNDLE_READY; } || echo NO_LOCAL_ORACLE_ENV")
  in bind (hcn-mkdir "/tmp/hy_out") (λ m0 →
     bind (h-capture (cons "/bin/sh" (cons "-c" (cons mkCmd nil)))) (λ r →
       h-out
         (hos-cat
           (cons (hcn-ln (list-append "[HX-COLLAB-KEY-BUNDLE | Collaborator: " (list-append handle "]")))
           (cons (hcn-ln (list-append "  Status : " (snd r)))
           (cons (hcn-ln (list-append "  Private 1-Line Installer Written (chmod 600, gitignored): " outSh))
           (cons (hcn-ln "  Send the 1-line contents of /tmp/hy_out/rad2520_oracle_setup.sh privately (Signal/iMessage) to rad2520 before or after clone!")
           nil)))))))

hcn-run-node : List Word → List Word → List Word → Proc W Unit
hcn-run-node mode handle port =
  let baseDir = the (List Word) "/tmp/hy_out/hyperos_8080"
      tplDir  = the (List Word) "/tmp/hy_out/hyperos_8080/tpl"
      wwwDir  = the (List Word) "/tmp/hy_out/hyperos_8080/www"
      cPath   = the (List Word) "/tmp/hy_out/hyperos_8080/hx_collab_studio_srv.c"
      binPath = the (List Word) "/tmp/hy_out/hyperos_8080/hx_collab_studio_srv"
      hxsvP   = the (List Word) (h-concat (cons "/tmp/hx_agent_bus/collab_" (cons handle (cons ".hxsv" nil))))
  in bind (hcn-mkdir tplDir) (λ m1 →
     bind (hcn-mkdir wwwDir) (λ m2 →
     bind (hcn-mkdir "/tmp/hx_agent_bus") (λ m3 →
     bind (h-write "/tmp/hy_out/hyperos_8080/tpl/bar_css.html" hos-bar-css) (λ w1 →
     bind (h-write "/tmp/hy_out/hyperos_8080/tpl/bar_html.html" hos-bar-html) (λ w2 →
     bind (h-write "/tmp/hy_out/hyperos_8080/tpl/studio_tail.html" hos-studio-tail) (λ w3 →
     bind (h-write "/tmp/hy_out/hyperos_8080/tpl/kg_inject.html" hos-kg-head-inject) (λ w4 →
     bind (h-write "/tmp/hy_out/hyperos_8080/www/being.css" being-compiled-css) (λ w5 →
     bind (h-write "/tmp/hx_agent_bus/autopoietic_primer.md" (hcn-collab-primer handle)) (λ w6 →
     bind (h-write hxsvP (hcn-mk-collab-hxsv #1 #2520)) (λ w7 →
     bind (h-write cPath hcn-c-full) (λ w8 →
     bind (h-capture (cons "/bin/sh" (cons "-c" (cons (h-concat (cons "cc -std=c11 -O3 " (cons cPath (cons " -o " (cons binPath (cons " 2>&1" nil)))))) nil)))) (λ rCc →
       if %weq (fst rCc) #0 then
         if h-eq mode "launch" then
           bind (h-out
             (hos-cat
               (cons (hcn-ln (list-append "[HX-COLLABORATOR-NODE | Welcome " (list-append handle " to Hyperactive Collaborative Intelligence OS]")))
               (cons (hcn-ln "  1. Autopoietic Primer : /tmp/hx_agent_bus/autopoietic_primer.md")
               (cons (hcn-ln (list-append "  2. Authenticated HXSV : " (list-append hxsvP " (32B MAC_OK)")))
               (cons (hcn-ln (h-concat (cons "  3. Zero-Prompt Swarm  : agy --dangerously-skip-permissions --mode auto -i " (cons hcn-q (cons "Read /tmp/hx_agent_bus/autopoietic_primer.md, strap into /tmp/hx_agent_bus/*.hxsv, and execute." (cons hcn-q nil))))))
               (cons (hcn-ln (list-append "  4. Launching Unified HyperOS Studio & Live Sync on http://localhost:" (list-append port "/ ...")))
               nil))))))) (λ uo →
           bind (h-run (cons binPath (cons "launch" (cons handle (cons port (cons "." nil)))))) (λ rc →
             ret {lzero} {W} unit))
         else
           bind (h-capture (cons binPath (cons mode (cons handle (cons port (cons "." nil)))))) (λ rBuild →
             h-out (snd rBuild))
       else h-out (list-append "[HX-COLLAB-NODE] C11 compile error: " (snd rCc))))))))))))))

hcn-entry : Proc W Unit
hcn-entry =
  bind h-args (λ av →
    let clean = hcn-drop-with (h-tail-lists av)
        rest  = h-tail-lists clean
        mode  = hcn-arg-at zero "build" rest
        hand  = hcn-arg-at (suc zero) "rad2520" rest
        port  = hcn-arg-at (toNat #2) "8080" rest
    in if h-eq mode "bundle-key"
       then hcn-bundle-key hand
       else hcn-run-node mode hand port)

hcn-is-direct : List (List Word) → Bool
hcn-is-direct av =
  let clean = hcn-drop-with (h-tail-lists av)
  in h-infix "hx-collaborator-node" (hcn-arg-at zero "" clean)

hcn-run : Step W Unit
hcn-run =
  to-step
    (bind h-args (λ av →
      if hcn-is-direct av
      then bind hcn-entry (λ u → exit #0)
      else ret {lzero} {W} unit))

#run hcn-run
