pex-diag : (sk : Lst Entry) (e : IEx) → PDiagT sk e
pex-diag sk ix0 X F G d = fmap-sw (dims sk) X (DL X (DL X F)) (DL X F) (DL X F) F (λ x q → fst q) (λ x q → fst q) (ddiag X F) (λ x q → fst q) (λ i x q → fst (fst q)) G d
pex-diag sk ix1 X F G d =
  fmap-sw (dims sk) X (DL X (DL X F)) (DL X F) (DL X F) F (λ x q → fst (snd q)) (λ x q → fst (snd q)) (ddiag X F) (λ x q → fst (snd q)) (λ i x q → fst (snd (fst (snd q)))) G d
pex-diag sk (ixv k) X F G d = ddv-diag sk k X F G d
pex-diag sk (ixneg r) X F G d = pex-diag-neg sk r (pex-diag sk r) X F G d
pex-diag sk (ixmeet r s) X F G d =
  pex-diag-cn sk dmeet r s (pex-diag sk r) (pex-diag sk s) (pex-exch sk s r) X F G d (λ i x y → dmeet X F x (ddiag X F x y))
pex-diag sk (ixjoin r s) X F G d =
  pex-diag-cn sk djoin r s (pex-diag sk r) (pex-diag sk s) (pex-exch sk s r) X F G d (λ i x y → djoin X F x (ddiag X F x y))
