-- ---------------------------------------------------------------- the hop's root-sum terms
-- B_kl for a term whose two √V act on the spaces of a1 and a2: xs in a1's coordinates, mid to a2's, fin to the target's
hop-row : Nat → VM → (Rows → Rows) → Rows → List Rows
hop-row n a2 fin ys = case n of
  zero → nil
  suc g → cons (fin ys) (hop-row g a2 fin (rows-apply-all (snd a2) ys))
