fd-rtl-specialized : (Nat → Bool) → List Nat → FdFrame → Bool × FdFrame
fd-rtl-specialized keep nil out = (false , out)
fd-rtl-specialized keep (cons b0 nil) out = (false , out)
fd-rtl-specialized keep (cons b0 (cons b1 nil)) out = (false , out)
fd-rtl-specialized keep (cons b0 (cons b1 (cons b2 nil))) out = (false , out)
fd-rtl-specialized keep (cons b0 (cons b1 (cons b2 (cons b3 payload)))) out =
  let len = plus b2 (times fd-256 b3)
      tag = plus b0 (times fd-256 b1)
  in if fd-ltb (list-length payload) len then (false , out)
     else (if keep tag then (true , (tag , len , fd-four)) else (false , out))
