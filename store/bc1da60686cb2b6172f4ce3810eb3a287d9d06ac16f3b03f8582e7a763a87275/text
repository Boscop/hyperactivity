-- the statement of archive/2026-11-11/README.md: if the meaning of C does not fail (no undefined behaviour,
-- no stop, whatever the world answers), then the compiled C gives the same observations: the
-- same commands of the world with the same responses, the same result, the same bytes
mem-sound-nofail : {S : Sig} {A : Type} → (t : Target) → (C : Step (MK S) A) → (s : AMem) →
  m-NoFail (std-run {S} {A} t C s) →
  o-BisimR {MT S} {MRes (A × AMem)} {A × FM} (MOk (MRel {A})) (std-run {S} {A} t C s) (flat-run {S} {A} t C (am-data s))
mem-sound-nofail {S} {A} t C s nf =
  m-ref-nofail {MT S} {A × AMem} {A × FM} (MRel {A}) (std-run {S} {A} t C s) (flat-run {S} {A} t C (am-data s))
    (mem-sound {S} {A} t C s (am-data s) (λ i → am-data s)) nf
