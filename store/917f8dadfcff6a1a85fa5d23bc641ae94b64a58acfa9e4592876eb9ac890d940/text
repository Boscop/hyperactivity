-- a step taken after a plan that changes neither its wire nor the wire it reads is its own plan,
-- as it stood before, done after that plan
nk-step-as-do : (sl : NkSlots) (u n : Word) (fx : NkFx) → nk-apart u fx → nk-apart (nk-rw (nk-get sl u) u) fx → nk-same (nk-step-at u n (nk-do fx sl)) (nk-do (nk-plan-fx sl u n) (nk-do fx sl))
nk-step-as-do sl u n fx a1 a2 x = cong (λ p → nk-get (nk-do (nk-fx p) (nk-do fx sl)) x) (nk-plan-stable sl u n fx a1 a2)
