nk-fo-bcadr-tl : (a : NkTm) (tl : NkTm) → (nk-fo-tm tl ≡ true) → nk-fo-tm (nk-bcadr (nk-cons a tl)) ≡ true
nk-fo-bcadr-tl a (nk-cons b r) h = nk-and-l (nk-fo-tm b) (nk-fo-tm r) h
nk-fo-bcadr-tl a (nk-var i) h = refl
nk-fo-bcadr-tl a (nk-free x) h = refl
nk-fo-bcadr-tl a (nk-num m) h = refl
nk-fo-bcadr-tl a (nk-lam b) h = refl
nk-fo-bcadr-tl a (nk-susp b) h = refl
nk-fo-bcadr-tl a (nk-con c as) h = refl
nk-fo-bcadr-tl a (nk-op op p as) h = refl
nk-fo-bcadr-tl a (nk-match op p cs) h = refl
nk-fo-bcadr-tl a nk-nil h = refl
