emit-evm-inet-initcode : INetExpr → List Word
emit-evm-inet-initcode e =
  let rtProg = the (List EvmInst)
                 (list-append (bn-evm-emit-expr (superchip-opt e))
                   (cons (ev-push bn-empty-bytes)
                   (cons (ev-op #82)
                   (cons (ev-push (cons #32 nil))
                   (cons (ev-push bn-empty-bytes)
                   (cons (ev-op #243) nil))))))
  in evm-wrap-initcode (evm-assemble rtProg)
