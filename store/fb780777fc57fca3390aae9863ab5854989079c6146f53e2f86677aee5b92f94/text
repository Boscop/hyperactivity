-- feature_flags_fn recurses in Sail; here on the bound (vec-len {Text} features) (the list shortens)
-- (part of language-support)
feature_flags_fn-body : ((features : List Text) → ZI) → (features : List Text) → ZI
feature_flags_fn-body self' features =
  let t'3 : ZI
      t'3 =
        case features of
          nil → (zpos #1)
          cons h'1 r'2 →
            (let x' : Text
                 x' = h'1
                 xs' : List Text
                 xs' = r'2
             in (if (z-eq (feature_flag_fn x') (zpos #0)) then (zpos #0) else (self' xs')))
  in t'3
