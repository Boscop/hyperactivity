-- Structural 4-NAND2 shared-fanout gate netlist emitted directly from `xor4-shared-net`
sv-xor4-shared-net : List Word
sv-xor4-shared-net =
  sv-concat
    (cons "module xor4_shared_net (input logic a, input logic b, output logic y);"
    (cons sv-nl
    (cons (sv-net-lines (toNat #3) (toNat #2) zero sv-env2-ab xor4-shared-net)
    (cons "endmodule" (cons sv-nl nil)))))
