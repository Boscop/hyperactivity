-- ---------------------------------------------------------------- 3. GALS Empty-Wire Clock Gating ("Waiting Is Not a Step")
-- Tick = inl ev (active wire arrival) | inr unit (idle wire cycle)
sync-state : {St Ev : Type} → (St → Ev → St) → St → List (Sum Ev Unit) → St
sync-state step st nil = st
sync-state step st (cons tk rest) =
  case tk of
    inl ev → sync-state step (step st ev) rest
    inr u  → sync-state step st rest
