-- the field of a closure class that holds a captured variable, or the captured this
cx-cap-var : List CField → Word → MRes CField
cx-cap-var nil i = mstop st-ill-typed
cx-cap-var (cons f fs) i = case cx-fld-capture f of
  ccap-var id → (case weq id i of
    true → mok f
    false → cx-cap-var fs i)
  _ → cx-cap-var fs i
