-- one kind of Φ(m,n), its four branches, scaled by s, added into acc
proj-kind-one : SQ → List Triple → VM → Nat → Nat → Nat → List Nat → Rows → List (List (List PRad)) → List (List (List PRad))
proj-kind-one s ts aP k n m dsP xs0 acc = proj-term ts aP s k true n true m dsP xs0 (proj-term ts aP s k true n false m dsP xs0 (proj-term ts aP s k false n true m dsP xs0 (proj-term ts aP s k false n false m dsP xs0 acc)))
