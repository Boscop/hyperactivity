hyp-holds : (m : Model) (hs : Eqs) (i : Word) → EqHolds m hs →
            (vals : Vals) → tev (vals , snd m) (fst (hyp-at i hs)) ≡ tev (vals , snd m) (snd (hyp-at i hs))
hyp-holds m hs i hh =
  case hs return (λ w → (i : Word) → EqHolds m w →
                        (vals : Vals) → tev (vals , snd m) (fst (hyp-at i w)) ≡ tev (vals , snd m) (snd (hyp-at i w))) of
    enil → λ i hh vals j → fst (snd m) #0
    econs l r rest → λ i hh →
      %welimP (λ v → (vals : Vals) → tev (vals , snd m) (fst (hyp-at v (econs l r rest))) ≡ tev (vals , snd m) (snd (hyp-at v (econs l r rest)))) i
        (fst hh) (λ j h → rec rest j (snd hh))
  i hh
