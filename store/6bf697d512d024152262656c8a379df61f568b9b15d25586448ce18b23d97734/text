-- primitive operations (lib/code.cub cprim) and computational box erasure for Step W Unit processes
ce-prim : (Code → List Word → List Word) → Word → Lst Code → List Word → List Word
ce-prim ce j as acc =
  if %wlt j #512 then
    list-append "hy_prim1(" (list-append (ce-dec j) (list-append "ull, " (ce (l-at (cwlit #0) as #0) (list-append ")" acc))))
  else if %wlt j #768 then
    list-append "hy_prim2(" (list-append (ce-dec j) (list-append "ull, " (ce (l-at (cwlit #0) as #0) (list-append ", " (ce (l-at (cwlit #0) as #1) (list-append ")" acc))))))
  else if %weq j #769 then
    list-append "hy_load8(" (ce (l-at (cwlit #0) as #0) (list-append ", " (ce (l-at (cwlit #0) as #1) (list-append ")" acc))))
  else if %weq j #776 then
    list-append "hy_load64(" (ce (l-at (cwlit #0) as #0) (list-append ", " (ce (l-at (cwlit #0) as #1) (list-append ")" acc))))
  else if %weq j #1025 then
    list-append "hy_store8(" (ce (l-at (cwlit #0) as #0) (list-append ", " (ce (l-at (cwlit #0) as #1) (list-append ", " (ce (l-at (cwlit #0) as #2) (list-append ")" acc))))))
  else if %weq j #1032 then
    list-append "hy_store64(" (ce (l-at (cwlit #0) as #0) (list-append ", " (ce (l-at (cwlit #0) as #1) (list-append ", " (ce (l-at (cwlit #0) as #2) (list-append ")" acc))))))
  else if %weq j #1280 then
    list-append "hy_blen(" (ce (l-at (cwlit #0) as #0) (list-append ")" acc))
  else if %weq j #1536 then
    list-append "hy_fresh_bytes((uint64_t)hy_nat(" (ce (l-at (cwlit #0) as #0) (list-append "))" acc))
  else list-append "hy_bad()" acc
