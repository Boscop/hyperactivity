zseq-steps : Nat → List Bool → List Bool → List Bool → List Bool → List Bool → BZ → List Bool → List Bool × (BZ × (BZ × (Bool × (Bool × Nat)))) → List Bool × (BZ × (BZ × (Bool × (Bool × Nat))))
zseq-steps f j1 j2 j3 j4 a x m2 st = case f of
  zero → st
  suc g → zseq-steps g j1 j2 j3 j4 (bin-add a bin-two) x m2 (zseq-step (bin-mul (btri4 j1 j2 a) (btri4 j3 j4 a)) (bin-mul (bin-sub a bin-one) (bin-add a bin-one)) x m2 st)
