-- a read after a write at a disjoint pointer gives the old value
rd-wr-disj : {n : Nat} → (p q : Ptr n) → (v : Int64) → (r : Region n) →
  Sum (le (plus (fst p) 8) (fst q)) (le (plus (fst q) 8) (fst p)) →
  PathP (λ (i : I) → Int64) (snd (rthen (wr p v) (rd q) r)) (snd (rd q r))
rd-wr-disj p q v r d = load64-store64-disj n r (fst p) (fst q) (snd p) (snd q) v d
