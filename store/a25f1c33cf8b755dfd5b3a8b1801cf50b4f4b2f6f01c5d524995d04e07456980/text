mesi-write-then-read-sound : (writer reader : Word) → (val : Nat) → (cl : MesiCluster) →
  snd (snd (mesi-pr-rd reader writer (mesi-pr-wr writer val cl)) reader) ≡ val
mesi-write-then-read-sound writer reader val cl =
  mesi-rd-branch writer reader val cl (weq reader writer) (λ _ → weq reader writer)
