-- from an initially empty P → Q queue, N = D + |u|, hence D ≤ N
par-D-le-N : {CP CQ M N E : Type} → (stepP : CP → ParLab M N E → CP → Type) → (stepQ : CQ → ParLab N M E → CQ → Type) →
  (mvs : List (ParMove CP CQ M N E)) → (p : CP) → (q : CQ) → (v : List N) → par-allowed-run stepP stepQ mvs (the (ParState CP CQ M N) (p , q , nil , v)) →
  le (par-recvs mvs) (par-sends mvs)
par-D-le-N {CP} {CQ} {M} {N} {E} stepP stepQ mvs p q v h = (list-length (fst (snd (snd (par-run mvs (the (ParState CP CQ M N) (p , q , nil , v)))))) ,
  transN (plus-comm (list-length (fst (snd (snd (par-run mvs (the (ParState CP CQ M N) (p , q , nil , v))))))) (par-recvs mvs))
  (transN (par-count stepP stepQ mvs (the (ParState CP CQ M N) (p , q , nil , v)) h) (plus-zero (par-sends mvs))))
