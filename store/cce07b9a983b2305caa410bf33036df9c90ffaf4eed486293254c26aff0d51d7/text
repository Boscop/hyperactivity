-- ---------------------------------------------------------------- the attachment's normalization
-- ⟨u, v⟩ = Σ_jl u_j G_jl v_l on kernel coordinates
gram-dot : Rows → List SQ → List SQ → SQ
gram-dot g u v = case g of
  nil → sq-zero
  cons row rest → (case u of nil → sq-zero; cons x urest → sq-plus (sq-mul x (vec-dot row v)) (gram-dot rest urest v))
