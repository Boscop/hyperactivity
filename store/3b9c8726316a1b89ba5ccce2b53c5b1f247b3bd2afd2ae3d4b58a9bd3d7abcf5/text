-- TSO outcomes of the handled program (every schedule: none cut by the bound n) within RC11's
rl-incl : Handler AtomS TsoIS → Nat → List AtomThread → Bool
rl-incl hd n ths =
  andB (weq (tso-sum-cut (tso-outcomes n (rc-x86 hd ths))) #0)
       (rc-subset (tso-sum-outs (tso-outcomes n (rc-x86 hd ths))) (tso-ax-outs (rl-rc ths)))
