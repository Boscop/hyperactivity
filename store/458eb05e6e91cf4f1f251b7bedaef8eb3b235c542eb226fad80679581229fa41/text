ltn-to-suc : (a b : Nat) → ltn b a ≡ false → ltn a (suc b) ≡ true
ltn-to-suc a =
  case a return λ y → (b : Nat) → ltn b y ≡ false → ltn y (suc b) ≡ true of
    zero → λ b e i → true
    suc a1 → λ b → (case b return λ z → ltn z (suc a1) ≡ false → ltn (suc a1) (suc z) ≡ true of zero → λ e → Empty-rec (true≢false e); suc b1 → λ e → rec a1 b1 e)
