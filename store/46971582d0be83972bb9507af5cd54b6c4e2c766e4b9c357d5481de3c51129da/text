-- rml32: from linear_memory.sail (it calls what is defined after it there)
-- (part of language-support)
rml32 : (lin_addr : Bits #48) → (r_x : Text) → MS (Bits #32)
rml32 lin_addr r_x =
  onS {Bool} {Bits #32} (canonical_address_p (bv-signed #48 lin_addr)) (λ t'1 →
    onS {Unit} {Bits #32} (fl-assert {exception} t'1 #158444082776146152862243554262028736828230367590195) (λ _ →
      let three__plus_lin_addr : Bits #49
          three__plus_lin_addr = (bits_of_int (z-add (zpos #3) (bv-signed #48 lin_addr)) (zpos #49))
      in onS {Bool} {Bits #32} (canonical_address_p (bv-signed #49 three__plus_lin_addr)) (λ t'3 →
           λ σ →
             if t'3 then
               the (MS (Bits #32))
                 (rb_ #48 (zpos #4) lin_addr r_x) σ
             else
               the (MS (Bits #32))
                 (liftS {Bits #32} (x86_model_error {Bits #32} #491462079282)) σ)))
