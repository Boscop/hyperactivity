count-lt-zero : {o : Ord} → (k x : El o) → (r : List (El o)) → AllLe x r → isTrue (leq k x) → count-lt k r ≡ zero
count-lt-zero k x r =
  case r return λ w → AllLe x w → isTrue (leq k x) → count-lt k w ≡ zero of
    nil → λ a h i → zero
    cons y q →
      λ a h →
        let ky = ord-trans {o} {k} {x} {y} h (fst a)
        in tr (count-lt k q) (λ i → plus (one-if (cong not (isTrue→eq ky) i)) (count-lt k q)) (rec q (snd a) h)
