bn-s256-blocks : Nat → List Word → List Word → List Word
bn-s256-blocks zero    bs st = st
bn-s256-blocks (suc k) bs st =
  let w16 = bn-parse-be32s (toNat #16) (h-take (toNat #64) bs)
      w64 = bn-s256-ext (toNat #48) #16 w16
      out = bn-s256-rounds (toNat #64) #0 w64 st
      nx  = cons (bn-add32 (bn-nth-w #0 st) (bn-nth-w #0 out))
            (cons (bn-add32 (bn-nth-w #1 st) (bn-nth-w #1 out))
            (cons (bn-add32 (bn-nth-w #2 st) (bn-nth-w #2 out))
            (cons (bn-add32 (bn-nth-w #3 st) (bn-nth-w #3 out))
            (cons (bn-add32 (bn-nth-w #4 st) (bn-nth-w #4 out))
            (cons (bn-add32 (bn-nth-w #5 st) (bn-nth-w #5 out))
            (cons (bn-add32 (bn-nth-w #6 st) (bn-nth-w #6 out))
            (cons (bn-add32 (bn-nth-w #7 st) (bn-nth-w #7 out)) nil)))))))
  in bn-s256-blocks k (kc-drop (toNat #64) bs) nx
