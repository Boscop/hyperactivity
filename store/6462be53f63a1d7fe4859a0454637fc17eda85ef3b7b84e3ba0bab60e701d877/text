pr-step-running : {A Res Snap Rd W Q Tok Ans Err : Type} → PrMove Res Rd Q Tok Ans A Err → Res → Snap → List Rd → List W → PrState A Res Snap Rd W Q Tok Err
pr-step-running (prm-lookup rd r2) r s d w = pr-running r2 s (list-append d (cons rd nil)) w
pr-step-running (prm-request q tok r2) r s d w = pr-suspended r2 s d w (q , tok)
pr-step-running (prm-response q tok a) r s d w = pr-running r s d w
pr-step-running (prm-return v) r s d w = pr-ready v d unit
pr-step-running (prm-fault e) r s d w = pr-failed e d unit
