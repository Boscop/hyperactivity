-- the entry is compiled from its code as written (src-of) when it has one, so the calls it keeps
-- (jit-holds) are still calls in it (c, its checked value, otherwise); its pairs contracted (eta-pairs)
jit-plan-at : Word → Code → Lst Rule → Code → Plan
jit-plan-at g Tc rules c =
  let c1 = opt-or (src-of g) c
      hs = jit-holds g c1
      s = specialize Tc (sched #64 lnil hs) rules (inline-src hs c1)
      cs = eta-pairs c-fuel #0 (fst s)
      p = program-of-at unfold-jit g cs #256
      ok = code-conv-at Tc (cglob g) cs
      defs0 = x-forms-all (snd p)
      defs = x-erase g defs0
  in case x-verdict (fst p) defs return (λ _ → Plan) of
       not-fo w at → ((not-fo w at , lnil) , (ok , (snd s , (cs , lnil))))
       -- the entry's arity in the blob is the code's leading λs, which is what the boundary passes
       -- (the directive counts them): a pass that changed it is refused here
       fo q2 → (if x-arity-is defs g (fst (x-split cs)) then ((fo cs , jit-reads g defs0) , (ok , (snd s , (cs , encode-prog g defs))))
                else ((not-fo reflect cs , lnil) , (ok , (snd s , (cs , lnil)))))
