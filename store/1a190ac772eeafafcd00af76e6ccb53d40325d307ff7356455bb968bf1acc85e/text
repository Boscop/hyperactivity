-- two requests on different wires, in either order, leave memories that read the same
nk-upd-swap : (sl : NkSlots) (w1 w2 : Word) (f1 f2 : NkSlot → NkSlot) → (%weq w1 w2 ≡ false) → (%weq w2 w1 ≡ false) → nk-same (nk-upd (nk-upd sl w1 f1) w2 f2) (nk-upd (nk-upd sl w2 f2) w1 f1)
nk-upd-swap sl w1 w2 f1 f2 q12 q21 x = nk-upd-swap-at (%weq w2 x) (%weq w1 x) sl w1 w2 x f1 f2 q12 q21 refl refl
