-- (x + 2X) + 2c' = (y + c) + (s + 2X), from x + 2c' = s + (y + c)
sub-rhs-alg : (x X c2 s y c : Nat) → plus x (times 2 c2) ≡ plus s (plus y c) → plus (plus x (times 2 X)) (times 2 c2) ≡ plus (plus y c) (plus s (times 2 X))
sub-rhs-alg x X c2 s y c fsid =
  transN (plus-assoc x (times 2 X) (times 2 c2))
  (transN (congN (plus x) (plus-comm (times 2 X) (times 2 c2)))
  (transN (symN (plus-assoc x (times 2 c2) (times 2 X)))
  (transN (congN (λ z → plus z (times 2 X)) fsid)
  (transN (plus-assoc s (plus y c) (times 2 X))
  (plus-comm-mid s (plus y c) (times 2 X))))))
