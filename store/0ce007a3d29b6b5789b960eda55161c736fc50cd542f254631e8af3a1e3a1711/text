cs-ltw-neq : (x y : Word) → (ltw y x ≡ true) → eqw x y ≡ false
cs-ltw-neq x y =
  %welimP (λ u → (v : Word) → (ltw v u ≡ true) → eqw u v ≡ false) x
    (λ v hv → cs-no (sym (cs-ltw-zero v) ∙ hv))
    (λ n hn v → %welimP (λ w → (ltw w (%wsucc n) ≡ true) → eqw (%wsucc n) w ≡ false) v
      (λ _ → refl)
      (λ m _ h → hn m h))
    y
