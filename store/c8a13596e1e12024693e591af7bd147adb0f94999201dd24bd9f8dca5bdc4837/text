synth-nand2-sound : {V : Type} → (env : V → Bool) → (c : Circ B0 B1 B2 V) →
  fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env (synth-nand2 c) ≡
  fold {B0} {B1} {B2} {V} {Bool} bool-alg env c
synth-nand2-sound {V} env c =
  catB
    (fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env (tech-map {V} (circ-opt {V} c)))
    (fold {B0} {B1} {B2} {V} {Bool} bool-alg env (circ-opt {V} c))
    (fold {B0} {B1} {B2} {V} {Bool} bool-alg env c)
    (tech-map-sound {V} env (circ-opt {V} c))
    (circ-opt-sound {V} env c)
