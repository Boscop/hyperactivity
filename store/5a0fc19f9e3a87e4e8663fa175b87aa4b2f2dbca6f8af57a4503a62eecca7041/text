-- the count of rows from index k + 1 of a matrix padded by a zero column is the count from k of the matrix
cl-go-shift : (A : Type) → (z : A) → (isz neg : A → Bool) → isz z ≡ true → (g : List (List A)) → (k : Nat) →
  cl-count-go A z isz neg (suc k) (ln-map (List A) (List A) (λ r → cons z r) g) ≡ cl-count-go A z isz neg k g
cl-go-shift A z isz neg hz g k = (case g return λ w → (k2 : Nat) → cl-count-go A z isz neg (suc k2) (ln-map (List A) (List A) (λ r → cons z r) w) ≡ cl-count-go A z isz neg k2 w of
  nil → λ k2 → λ i → (zero , true)
  cons r rest → λ k2 → λ i → cl-step A isz neg (cl-nth A z k2 r)
    (cl-tr Bool (if isz z then cl-offz A isz (suc k2) (suc zero) r else false) (cl-offz A isz (suc k2) (suc zero) r) (cl-offz A isz k2 zero r)
      (λ j → if hz j then cl-offz A isz (suc k2) (suc zero) r else false) (cl-offz-shift A isz k2 r zero) i)
    (cl-go-shift A z isz neg hz rest (suc k2) i)) k
