nk-ok-val : (fx : NkFx) (w : Word) (v : NkVal) → nk-off w (nk-puts fx) → nk-off w (nk-vals fx) → nk-ok w (nk-arrive-val v) fx
nk-ok-val nkf-nil w v hp hv = unit
nk-ok-val (nkf-val k v2 r) w v hp hv = (inl (fst hv) , nk-ok-val r w v hp (snd hv))
nk-ok-val (nkf-op k o r) w v hp hv = (nk-vo (%weq w k) w k v o refl , nk-ok-val r w v hp hv)
nk-ok-val (nkf-put k s r) w v hp hv = (inl (fst hp) , nk-ok-val r w v (snd hp) hv)
