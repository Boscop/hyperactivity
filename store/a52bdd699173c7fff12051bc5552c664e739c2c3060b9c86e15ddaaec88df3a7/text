b2-inv-fst : (x y : ZWord) → z-eq (fst (b2 (b2 (x , y)))) (z-double x)
b2-inv-fst x y =
  same-norm-eq (z4-env (fst x) (snd x) (fst y) (snd y))
    (lc-add (lc-add (lc-add (lc-var #0) (lc-var #2)) (lc-add (lc-var #0) (lc-var #3)))
            (lc-add (lc-var #1) (lc-var #1)))
    (lc-add (lc-add (lc-var #0) (lc-var #0))
            (lc-add (lc-add (lc-var #1) (lc-var #3)) (lc-add (lc-var #1) (lc-var #2))))
    refl
