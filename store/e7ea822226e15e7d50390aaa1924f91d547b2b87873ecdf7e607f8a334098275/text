-- the two branches weighted (d_n ± 1 + 1)/(d_n + 1): at √V → 1, (M_n)_cd = δ_cd, so this is the identity
open-unit : Nat → List Nat → List SQ → List SQ
open-unit n dsP v = vec-plus (vec-scale ((suc (suc (exp-at n dsP)) , suc (exp-at n dsP)) , (zero , suc zero)) (open-branch n true dsP v))
  (if eqb (exp-at n dsP) zero then zero-row (mons-count (mons0 dsP)) else vec-scale ((exp-at n dsP , suc (exp-at n dsP)) , (zero , suc zero)) (open-branch n false dsP v))
