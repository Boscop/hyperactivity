shift-tail : (f : List (List Word) → Word) → (h : Nat) → (x : List Word) → (r : List (List Word)) →
             zippad (list-map f (sufs r)) (list-map f (sufs (drop-n h r))) ≡ list-map (dkey f h) (sufs r) →
             zippad (list-map f (sufs r)) (tail-of (list-map f (sufs (drop-n h (cons x r))))) ≡ list-map (dkey f h) (sufs r)
shift-tail f h x r ih =
  tr (zippad (list-map f (sufs r)) (list-map f (sufs (drop-n h r))))
     (λ j → zippad (list-map f (sufs r)) (shift-q f h x r j)) ih
