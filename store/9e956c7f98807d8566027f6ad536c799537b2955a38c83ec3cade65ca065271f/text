nk-env-ev-set-apart : (rho : NkW → NkEv) (u : NkW) (val : NkEv) (e : NkEnv) →
  (nk-emem u e ≡ false) → nk-env-ev (nk-rho-set rho u val) e ≡ nk-env-ev rho e
nk-env-ev-set-apart rho u val e hu =
  nk-env-ev-ext (nk-rho-set rho u val) rho e
    (λ w hm → nk-rho-set-other rho u w val (nk-emem-not-eq u w e hu hm))
