-- and how many the configured molecule gets wrong against the peaks actually reported
tally-conf-wrong-of : List Compd → Nat
tally-conf-wrong-of cs = case cs of
  nil → 0
  cons c r → (case eqb (compd-conf-count c) (compd-peaks c) of true → tally-conf-wrong-of r; false → suc (tally-conf-wrong-of r))
