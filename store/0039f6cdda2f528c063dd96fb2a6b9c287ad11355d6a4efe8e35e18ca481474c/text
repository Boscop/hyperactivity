br-count-ones : BitR → Word × BitR
br-count-ones r =
  let fin = %welimP (λ _ → Bool × (Word × BitR)) #15 (false , (#0 , r)) (λ _ st →
              if fst st then st
              else let q  = fst (snd st)
                       r0 = snd (snd st)
                       p  = br-get1 r0
                   in if %weq (fst p) #1 then (false , (%wadd q #1 , snd p))
                      else (true , (q , snd p)))
  in snd fin
