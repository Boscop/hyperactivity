-- Product algebra: two analyses run in one pass equal the pair of separate passes
alg-prod : {O0 O1 O2 R T : Type} → Alg O0 O1 O2 R → Alg O0 O1 O2 T → Alg O0 O1 O2 (R × T)
alg-prod A B =
  ( (λ c → (fst A c , fst B c))
  , (λ u p → (fst (snd A) u (fst p) , fst (snd B) u (snd p)))
  , (λ b p q → (snd (snd A) b (fst p) (fst q) , snd (snd B) b (snd p) (snd q))) )
