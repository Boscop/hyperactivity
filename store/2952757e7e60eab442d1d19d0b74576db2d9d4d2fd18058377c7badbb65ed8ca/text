lg-mulw-dist-l : (a b c : Word) → mulw a (plusw b c) ≡ plusw (mulw a b) (mulw a c)
lg-mulw-dist-l a b c =
  catw (lg-mulw-comm a (plusw b c))
    (catw (mulw-dist b c a)
      (catw (congw (λ z → plusw z (mulw c a)) (lg-mulw-comm b a))
        (congw (λ z → plusw (mulw a b) z) (lg-mulw-comm c a))))
