-- the one wire, beyond its own, whose content a step's plan depends on: the held wire, when an
-- operation that needs the value faces a reference; otherwise its own wire
nk-rw-pair : Bool → NkVal → Word → Word
nk-rw-pair true (nkv-ref w) u = w
nk-rw-pair true (nkv-lam b e) u = u
nk-rw-pair true (nkv-num m) u = u
nk-rw-pair true (nkv-var x) u = u
nk-rw-pair true (nkv-lvl l) u = u
nk-rw-pair true (nkv-q t) u = u
nk-rw-pair true (nkv-napp f a) u = u
nk-rw-pair true (nkv-ninc a) u = u
nk-rw-pair false v u = u
