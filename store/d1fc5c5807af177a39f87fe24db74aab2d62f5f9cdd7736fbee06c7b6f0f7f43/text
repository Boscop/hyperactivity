-- division by a signed divisor: the floor and ceiling inequalities, by sign of the divisor
fdivz-pos-sm : (n : BZ) → (s : Bool) → (m : List Bool) → bcanon m ≡ true → zpos (zv (s , m)) → zle (zmul (zv (bz-fdiv-z n (s , m))) (zv (s , m))) (zv n)
fdivz-pos-sm n s m c = case s return λ u → zpos (zv (u , m)) → zle (zmul (zv (bz-fdiv-z n (u , m))) (zv (u , m))) (zv n) of
  true → λ h → bz-fdiv-sound n m c (pos1 (bin-to-nat m) h)
  false → λ h → le-sz-absurd (zle (zmul (zv (bz-fdiv-z n (false , m))) (zv (false , m))) (zv n)) (bin-to-nat m) h
