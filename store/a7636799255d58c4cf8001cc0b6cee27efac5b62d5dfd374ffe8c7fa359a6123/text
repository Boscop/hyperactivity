cs-hy-bop-w : Word → CsHeap → Word → Word → CsRes
cs-hy-bop-w j hp a b =
  if %weq j #0 then cs-hy-con hp (if %weq a b then #0 else #1) lnil
  else if %weq j #1 then cs-hy-con hp (if %wlt a b then #0 else #1) lnil
  else if %weq j #2 then cs-hy-add hp a b
  else if %weq j #3 then cs-hy-max hp a b
  else if %weq j #4 then cs-hy-sub hp a b
  else if %weq j #5 then cs-hy-mul hp a b
  else if %weq j #6 then cs-hy-div hp a b
  else if %weq j #7 then cs-hy-mod hp a b
  else if %weq j #8 then cso-ok hp (csv-word (%wand a b))
  else if %weq j #9 then cso-ok hp (csv-word (%wor a b))
  else if %weq j #10 then cso-ok hp (csv-word (%wxor a b))
  else if %weq j #11 then cs-hy-shl hp a b
  else if %weq j #12 then cs-hy-shr hp a b
  else cso-abort
