pm-swap4 : (a b c d : Bool) → pm-xor (pm-xor a b) (pm-xor c d) ≡ pm-xor (pm-xor a c) (pm-xor b d)
pm-swap4 true true true d = λ i → not d
pm-swap4 true true false d = sym (pm-not-not d)
pm-swap4 true false true d = pm-not-not d
pm-swap4 true false false d = λ i → not d
pm-swap4 false true true d = λ i → not (not d)
pm-swap4 false true false d = λ i → not d
pm-swap4 false false true d = λ i → not d
pm-swap4 false false false d = λ i → d
