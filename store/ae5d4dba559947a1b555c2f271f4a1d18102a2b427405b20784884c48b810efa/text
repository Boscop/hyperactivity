-- nk-linear-net-commute: unconditional parallel commutation of any two linear active wires in NkSlots,
-- discharging plan well-formedness directly from nk-plan-wf for every rule of the cubical machine
-- (part of machine-in-hyperactive)
nk-linear-net-commute : (sl : NkSlots) (u1 n1 u2 n2 : NkW) →
  (nk-weq u1 u2 ≡ false) →
  (nk-weq (nk-rw (nk-get sl u1) u1) u2 ≡ false) →
  (nk-weq u2 (nk-rw (nk-get sl u1) u1) ≡ false) →
  (nk-weq u1 (nk-rw (nk-get sl u2) u2) ≡ false) →
  (nk-weq (nk-rw (nk-get sl u2) u2) u1 ≡ false) →
  (nk-wire-lt u1 n1 ≡ true) → (nk-wire-lt (nk-rw (nk-get sl u1) u1) n1 ≡ true) →
  (nk-wire-lt u2 n1 ≡ true) → (nk-wire-lt (nk-rw (nk-get sl u2) u2) n1 ≡ true) →
  (nk-emem u1 (nk-slot-ins (nk-get sl u2)) ≡ false) → (nk-emem u1 (nk-slot-outs (nk-get sl u2)) ≡ false) →
  (nk-emem (nk-rw (nk-get sl u1) u1) (nk-slot-ins (nk-get sl u2)) ≡ false) → (nk-emem (nk-rw (nk-get sl u1) u1) (nk-slot-outs (nk-get sl u2)) ≡ false) →
  (nk-emem u2 (nk-slot-ins (nk-get sl u1)) ≡ false) → (nk-emem u2 (nk-slot-outs (nk-get sl u1)) ≡ false) →
  (nk-emem (nk-rw (nk-get sl u2) u2) (nk-slot-ins (nk-get sl u1)) ≡ false) → (nk-emem (nk-rw (nk-get sl u2) u2) (nk-slot-outs (nk-get sl u1)) ≡ false) →
  (nk-ebound (nk-slot-ins (nk-get sl u1)) n1 ≡ true) → (nk-ebound (nk-slot-outs (nk-get sl u1)) n1 ≡ true) →
  (nk-ebound (nk-slot-ins (nk-get sl u2)) n1 ≡ true) → (nk-ebound (nk-slot-outs (nk-get sl u2)) n1 ≡ true) →
  (nk-edisj (nk-slot-ins (nk-get sl u1)) (nk-slot-ins (nk-get sl u2)) ≡ true) →
  (nk-edisj (nk-slot-outs (nk-get sl u1)) (nk-slot-outs (nk-get sl u2)) ≡ true) →
  (nk-wire-le (nk-n (nk-plan (nk-get sl u1) u1 n1 sl)) n2 ≡ true) →
  nk-same (nk-step-at u2 n2 (nk-step-at u1 n1 sl)) (nk-step-at u1 n1 (nk-step-at u2 n2 sl))
nk-linear-net-commute sl u1 n1 u2 n2 neq nrw1u2 nu2rw1 nu1rw2 nrw2u1 ltu1 ltrw1 ltu2 ltrw2 u1i2 u1o2 rw1i2 rw1o2 u2i1 u2o1 rw2i1 rw2o1 bi1 bo1 bi2 bo2 di do0 pm =
  let ins1 = nk-slot-ins (nk-get sl u1)
      outs1 = nk-slot-outs (nk-get sl u1)
      ins2 = nk-slot-ins (nk-get sl u2)
      outs2 = nk-slot-outs (nk-get sl u2)
      m1 = nk-n (nk-plan (nk-get sl u1) u1 n1 sl)
      m2 = nk-n (nk-plan (nk-get sl u2) u2 n2 sl)
      hp1 = nk-plan-wf sl u1 n1
      hp2 = nk-plan-wf sl u2 n2
  in nk-linear-steps-commute sl u1 n1 m1 u2 n2 m2 ins1 outs1 ins2 outs2
       neq nrw1u2 nu2rw1 nu1rw2 nrw2u1 ltu1 ltrw1 ltu2 ltrw2
       u1i2 u1o2 rw1i2 rw1o2 u2i1 u2o1 rw2i1 rw2o1
       bi1 bo1 bi2 bo2 di do0
       (nk-and-l (nk-wire-le n1 m1) (nk-step-fx-wf u1 ins1 outs1 n1 m1 (nk-plan-fx sl u1 n1)) hp1)
       pm
       (nk-and-r (nk-wire-le n1 m1) (nk-step-fx-wf u1 ins1 outs1 n1 m1 (nk-plan-fx sl u1 n1)) hp1)
       (nk-and-r (nk-wire-le n2 m2) (nk-step-fx-wf u2 ins2 outs2 n2 m2 (nk-plan-fx sl u2 n2)) hp2)
