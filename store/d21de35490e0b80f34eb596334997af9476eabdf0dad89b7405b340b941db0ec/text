-- THEOREM 2: UNIVERSAL COMMUTATIVITY OF SWARM LEASE EPOCH MERGE (ALL a b : Nat)
ml-thm-max-comm : (a b : Nat) → ml-max a b ≡ ml-max b a
ml-thm-max-comm zero    zero    = refl
ml-thm-max-comm zero    (suc b) = refl
ml-thm-max-comm (suc a) zero    = refl
ml-thm-max-comm (suc a) (suc b) = ml-cong suc (ml-thm-max-comm a b)
