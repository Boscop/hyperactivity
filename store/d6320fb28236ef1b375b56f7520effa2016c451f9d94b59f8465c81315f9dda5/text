-- the machine's verdict on the name as now bound, read from STORE/bound/HEX (the name's key now, kept by the
-- machine for reading by name with no log to scan), and the versions the source records of it
hi-verdict : List Word → List Word → Proc W (List Word)
hi-verdict st n = bind (h-read (list-append st (list-append "/bound/" (h-hex n)))) (λ key →
  bind (h-read (list-append h-source (list-append "/versions/" (h-hex n)))) (λ v → hi-verdict-of st key (list-length (h-lines (s-or nil v)))))
