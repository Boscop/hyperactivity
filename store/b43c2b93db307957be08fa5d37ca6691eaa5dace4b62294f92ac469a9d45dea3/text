-- Layer 2: Organic Bioluminescent Yellow (#ffd400) strictly for THIS Steering Filament
ossc-layer2-sheet : CssSheet
ossc-layer2-sheet =
  cons (css-rule ".os-steer-bar"
    (list-append
      (d6 "display" "flex" "align-items" "center" "gap" "10px" "padding" "9px 12px 9px 16px" "margin" "0 0 18px" "border-radius" "999px")
      (d4 "background" "rgba(255,212,0,0.10)" "border" "1px solid rgba(217,154,0,0.45)" "backdrop-filter" "blur(20px)" "box-shadow" "0 8px 28px rgba(255,212,0,0.12)")))
  (cons (css-rule ".os-steer-in"
    (d6 "flex" "1" "background" "transparent" "border" "0" "outline" "0" "color" "var(--ink)" "font" "500 14px/1.4 -apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif"))
  (cons (css-rule ".os-steer-go"
    (list-append
      (d6 "font" "700 11.5px/1 ui-monospace,'SF Mono',Menlo,monospace" "padding" "8px 14px" "border-radius" "999px" "border" "0" "background" "#ffd400" "color" "#000000")
      (d1 "cursor" "pointer")))
  (cons (css-rule ".os-steer-go:hover" (d2 "background" "#000000" "color" "#ffd400"))
  (cons (css-rule ".os-inject-stream"
    (d6 "display" "none" "border-radius" "18px" "padding" "16px 20px" "margin" "0 0 24px" "border" "1px solid rgba(217,154,0,0.45)" "background" "rgba(255,212,0,0.08)"))
  (cons (css-rule ".os-inject-stream.on"
    (d4 "display" "block" "color" "var(--ink)" "font" "400 14.5px/1.6 -apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif" "white-space" "pre-wrap"))
  nil)))))
