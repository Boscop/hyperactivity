leB-max : (a a2 b b2 : Nat) → leB a a2 ≡ true → leB b b2 ≡ true → leB (maxN a b) (maxN a2 b2) ≡ true
leB-max zero a2 zero b2 = λ ha hb → refl
leB-max zero zero (suc b) zero = λ ha hb → Empty-rec (false≢true hb)
leB-max zero zero (suc b) (suc b2) = λ ha hb → hb
leB-max zero (suc a2) (suc b) zero = λ ha hb → Empty-rec (false≢true hb)
leB-max zero (suc a2) (suc b) (suc b2) = λ ha hb → leB-max zero a2 b b2 refl hb
leB-max (suc a) zero zero b2 = λ ha hb → Empty-rec (false≢true ha)
leB-max (suc a) (suc a2) zero zero = λ ha hb → ha
leB-max (suc a) (suc a2) zero (suc b2) = λ ha hb →
  concat {lzero} {Bool}
    {leB a (maxN a2 b2)} {leB (maxN a zero) (maxN a2 b2)} {true}
    (λ i → leB (sym (maxN-zero-r a) i) (maxN a2 b2))
    (leB-max a a2 zero b2 ha refl)
leB-max (suc a) zero (suc b) b2 = λ ha hb → Empty-rec (false≢true ha)
leB-max (suc a) (suc a2) (suc b) zero = λ ha hb → Empty-rec (false≢true hb)
leB-max (suc a) (suc a2) (suc b) (suc b2) = λ ha hb → leB-max a a2 b b2 ha hb
