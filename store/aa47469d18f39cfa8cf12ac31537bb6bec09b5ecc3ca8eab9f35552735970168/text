-- every eigenvalue of q_123 in (lo, hi], lo < hi integers in units of 2^{−s}, hi − lo a power of two: the intervals of
-- width one unit holding eigenvalues, each with how many (clo, chi the counts above lo and hi)
isolate : List Bool → List Bool → List Bool → List Bool → List Bool → List Bool → Nat → BZ → BZ → Nat → Nat → List (BZ × (BZ × Nat))
isolate j1 j2 j3 j4 m m2 f lo hi clo chi = if eqb clo chi then nil else (case f of
  zero → cons (lo , (hi , monus clo chi)) nil
  suc g → isolate-mid j1 j2 j3 j4 m m2 g lo hi clo chi (bz-half (bz-add lo hi)))
