rl-iriw : MOrd → MOrd → List AtomThread
rl-iriw so lo = cons (ai-store so #0 #1 (ai-ret nil)) (cons (ai-store so #1 #1 (ai-ret nil))
               (cons (ai-load lo #0 (λ r0 → ai-load lo #1 (λ r1 → ai-ret (cons r0 (cons r1 nil)))))
               (cons (ai-load lo #1 (λ r2 → ai-load lo #0 (λ r3 → ai-ret (cons r2 (cons r3 nil))))) nil)))
