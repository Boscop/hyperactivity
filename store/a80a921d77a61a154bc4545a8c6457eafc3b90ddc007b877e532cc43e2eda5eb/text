-- from Pd + Y = X + Nd and Nd < Pd, Y < X
lt-transfer : (Pd Nd X Y : Nat) → plus Pd Y ≡ plus X Nd → le (suc (plus zero Nd)) (plus Pd zero) → le (suc Y) X
lt-transfer Pd Nd X Y zq h = (fst h , plus-cancel-l Nd (plus (fst h) (suc Y)) X
  (transN (plus-comm-mid Nd (fst h) (suc Y))
  (transN (congN (plus (fst h)) (plus-suc Nd Y))
  (transN (symN (plus-assoc (fst h) (suc Nd) Y))
  (transN (congN (λ z → plus z Y) (transN (snd h) (plus-zero Pd)))
  (transN zq (plus-comm X Nd)))))))
