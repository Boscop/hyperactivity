-- so the computed partition matches the two relations exactly: the graph identifies the pair and the
-- orientation separates it, and the representatives say so without any appeal to the proofs
at-or-rep-differs : at-or-rep at-h1 ≡ at-or-rep at-h2 → Empty
at-or-rep-differs q = at-h1-not-h2 (concat (sym at-or-rep-h1) (concat q at-or-rep-h2))
