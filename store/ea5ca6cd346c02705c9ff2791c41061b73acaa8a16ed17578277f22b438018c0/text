-- Exact Word arithmetic agreement of hy_add, hy_mul, hy_sub, hy_max, hy_div, hy_mod
cs-ltw-subw : (a b : Word) → (if ltw b a then subw a b else #0) ≡ subw a b
cs-ltw-subw a b =
  %welimP (λ u → (v : Word) → (if ltw v u then subw u v else #0) ≡ subw u v) a
    (λ v → cs-if-same (ltw v #0) #0)
    (λ n hn v →
       %welimP (λ w → (if ltw w (%wsucc n) then subw (%wsucc n) w else #0) ≡ subw (%wsucc n) w) v
         refl
         (λ m hm → hn m))
    b
