-- a pack's identification classes, written once from its text: P.yek the key reversed (what the selection
-- reads), P.key the key, P.forms the forms; the text itself is then removed
c-derive : List Word → Proc W Unit
c-derive d = bind (h-read (list-append c-dir (list-append d ".text"))) (λ r →
  bind (h-write (list-append c-dir (list-append d ".yek")) (m-norm-rev #1 (list-length (h-source-or r)) (text-bytes (h-source-or r)))) (λ a →
  bind (h-write (list-append c-dir (list-append d ".key")) (m-norm #1 (list-length (h-source-or r)) (text-bytes (h-source-or r)))) (λ b →
  bind (h-write (list-append c-dir (list-append d ".forms")) (m-norm #0 (list-length (h-source-or r)) (text-bytes (h-source-or r)))) (λ c →
  h-unlink (list-append c-dir (list-append d ".text"))))))
