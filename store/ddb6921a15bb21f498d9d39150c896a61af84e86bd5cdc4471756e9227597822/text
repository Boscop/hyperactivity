it-dtz A z ad mu m0r a0r n = case n return λ k → (b : sy-vn A k) → it-dt A z ad mu k b (sy-vz A z k) ≡ z of
  zero → λ b → λ i → z
  suc m → λ b → cl-tr A (ad (mu (fst b) z) (it-dt A z ad mu m (snd b) (sy-vz A z m))) (ad z z) z (λ i → ad (m0r (fst b) i) (it-dtz A z ad mu m0r a0r m (snd b) i)) (a0r z)
