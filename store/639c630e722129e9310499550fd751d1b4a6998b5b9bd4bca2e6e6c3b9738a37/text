io-emit-sv-block : List Word → Word → Word → List Word → List Word
io-emit-sv-block name ng prog tl =
  io-cat
    (cons "module hx_opt_" (cons name (cons "(input logic w0, input logic w1, input logic w2, output logic y);" (cons ce-nl
    (cons (io-sv-gates (toNat ng) #3 prog
      (io-cat (cons "  assign y = w" (cons (ce-dec (%wadd #2 ng)) (cons ";" (cons ce-nl
              (cons "endmodule" (cons ce-nl (cons tl nil))))))))) nil)))))
