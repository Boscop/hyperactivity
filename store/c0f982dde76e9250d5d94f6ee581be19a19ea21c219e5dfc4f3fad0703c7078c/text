ni-op : BinOp → Bool → IW → UInt64 → UInt64 → MRes UInt64
ni-op o sg w a b = case o of
  ao-add → ni-add sg w a b
  ao-sub → ni-sub sg w a b
  ao-mul → ni-mul sg w a b
  ao-div → ni-div sg w a b
  ao-rem → ni-rem sg w a b
  ao-and → mok (u64and a b)
  ao-or → mok (u64or a b)
  ao-xor → mok (u64xor a b)
