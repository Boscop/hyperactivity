-- the orderings the languages allow per operation (C++ [atomics.types.operations], the same in
-- C11 and Rust): a load is not release or acq_rel; a store is not acquire or acq_rel; a
-- compare-exchange's failure ordering is not release or acq_rel. A program issuing a command
-- outside these has no defined meaning in its language; the handlers below are defined on
-- every command, and a reader is to check `atom-valid` where it reads the program
mo-is-seq-cst : MOrd → Bool
mo-is-seq-cst o = case o of mo-relaxed → false; mo-acquire → false; mo-release → false; mo-acq-rel → false; mo-seq-cst → true
