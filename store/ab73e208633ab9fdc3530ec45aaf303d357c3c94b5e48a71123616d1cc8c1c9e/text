-- a step at wire u, given the first wire name it may use: what it asks of the memory
nk-plan : NkSlot → Word → Word → NkSlots → NkOut
nk-plan (nks-pair o v) u n sl = nk-plan-pair (nk-reads o) v o u n sl
nk-plan nks-none u n sl = nk-out nkf-nil n
nk-plan (nks-val v) u n sl = nk-out nkf-nil n
nk-plan (nks-op o) u n sl = nk-out nkf-nil n
