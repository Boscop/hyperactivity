    else hy-runs (cons m (cons "lib/ir/hx-collaborator-node.hypercubical" (cons "launch" (cons handle more))))))

hy-node-launch : List Word → List (List Word) → Proc W Unit
hy-node-launch m nil         = hy-node-go m "founder_avik" nil
hy-node-launch m (cons h mr) = hy-node-go m (if h-null h then "founder_avik" else h) mr

hy-bridge : List Word → List Word → List Word → List (List Word) → Proc W Unit
