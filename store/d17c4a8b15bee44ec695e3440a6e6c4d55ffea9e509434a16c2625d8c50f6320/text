-- Exact rational Padé approximation for exp(-u) where u >= 0 in scale 10000:
--   exp(-u) ≈ 1 / (1 + u + u²/2 + u³/6)
fx-exp-neg : Word → Word
fx-exp-neg u =
  if wlt #60000 u then #0
  else let t2 = wquot (wmul u u) #20000
           t3 = wquot (wmul t2 u) #30000
           den = wadd #10000 (wadd u (wadd t2 t3))
       in wquot #100000000 den
