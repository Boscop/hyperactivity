-- Exact Reverse-Mode Adjoint Duality Theorem: ⟨∇c(x, dy), dx⟩ ≡ dy · d(c(x + ε·dx)) for ALL circuits!
grad-dot-fwd : (n : Nat) → (c : Circ A0 A1 A2 (SumFin n)) → (x dx : SumFin n → Nat) → (dy : Nat) →
  fin-dot n (circ-grad n c x dy) dx ≡ times dy (snd (fold fwd-alg (fwd-env x dx) c))
grad-dot-fwd n (cwire v) x dx dy = dot-onehot n v dy dx
grad-dot-fwd n (cop0 k) x dx dy = transN (dot-zero n dx) (zero-snd-0 k dy)
grad-dot-fwd n (cop1 u a) x dx dy = grad-dot-fwd n a x dx dy
grad-dot-fwd n (cop2 b a d) x dx dy =
  grad-dot-2 n b a d x dx dy (grad-dot-fwd n a x dx) (grad-dot-fwd n d x dx)
