-- quote at depth d: a closure is applied to a new variable numbered d and its result quoted one
-- deeper, under a λ; a constructor's and a blocked eliminator's parts are quoted and put back
-- together; a variable introduced at depth l is index d-1-l
nk-rule-quote : Word → NkW → NkHd → NkEnv → NkW → NkOut
nk-rule-quote d out (hd-clo b) parts n = nk-build b (nke-cons n parts) (nk-s n) (nk-plan-of (nkf-val n (nkv (hd-lvl d) nke-nil) (nkf-op (nk-s n) (nko-quote (%wsucc d) (nk-s (nk-s n))) (nkf-op (nk-s (nk-s n)) (nko-gather d nkk-lam nk-nil nke-nil out) nkf-nil))) (nk-s (nk-s (nk-s n))))
nk-rule-quote d out (hd-num m) parts n = nk-plan-of (nkf-val out (nkv (hd-q (nk-num m)) nke-nil) nkf-nil) n
nk-rule-quote d out (hd-var x) parts n = nk-plan-of (nkf-val out (nkv (hd-q (nk-free x)) nke-nil) nkf-nil) n
nk-rule-quote d out (hd-lvl l) parts n = nk-plan-of (nkf-val out (nkv (hd-q (nk-var (%wsub (%wsub d #1) l))) nke-nil) nkf-nil) n
nk-rule-quote d out (hd-con c) parts n = nk-gather d (nkk-con c) nk-nil parts out n
nk-rule-quote d out (hd-stuck h) parts n = nk-gather d (nkk-op h) nk-nil parts out n
nk-rule-quote d out (hd-stuckm h) parts n = nk-gather d (nkk-match h) nk-nil parts out n
nk-rule-quote d out hd parts n = nk-plan-of nkf-nil n
