-- the test the engine counts with: when bit-eq (bz-pos a) (bz-pos b) holds, a·b > 0 (a positive pivot b/a); when
-- it fails, a·b < 0 (a negative pivot), for nonzero canonical a and b
in-pivot-sign : (s1 s2 : Bool) → (m1 m2 : List Bool) → bcanon m1 ≡ true → bcanon m2 ≡ true → bin-null m1 ≡ false → bin-null m2 ≡ false → zpos (if bit-eq (bz-pos (s1 , m1)) (bz-pos (s2 , m2)) then zmul (zv (s1 , m1)) (zv (s2 , m2)) else in-sw (zmul (zv (s1 , m1)) (zv (s2 , m2))))
in-pivot-sign s1 s2 m1 m2 hc1 hc2 hn1 hn2 = transport (λ i → zpos (if bit-eq (symB (in-bzpos s1 m1 hn1) i) (symB (in-bzpos s2 m2 hn2) i) then zmul (zv (s1 , m1)) (zv (s2 , m2)) else in-sw (zmul (zv (s1 , m1)) (zv (s2 , m2))))) (in-sign-core s1 s2 m1 m2 hc1 hc2 hn1 hn2)
