DLift : (sk : Lst Entry) (k : Word) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y)) (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X Y c) → Type 1
DLift sk k X Y Z H f g c d =
  PathP (λ i → DCube (dims sk) Z H (diag-dmap sk k X Y Z f c d i))
    (diag-sk-d sk k Z H (dcube-map (suc (dims sk)) X Y Z f c d) (dcube-lift (suc (dims sk)) X Z Y H f g c d))
    (dcube-lift (dims sk) X Z Y H f g (diag-sk sk k X c) (diag-sk-d sk k X Y c d))
