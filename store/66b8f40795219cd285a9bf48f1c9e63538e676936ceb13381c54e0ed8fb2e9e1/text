-- apply meets a closure: its body, the argument first. Increment meets a number: the next number.
-- Case meets constructor c: the body of branch c, the fields bound
nk-act : Word → NkTm → NkHd → NkEnv → NkAct
nk-act h cs (hd-clo b) parts = if %weq h #0 then act-ap b else act-none
nk-act h cs (hd-num m) parts = if %weq h #1 then act-hd (hd-num (%wsucc m)) else act-none
nk-act h cs (hd-con c) parts = if %weq h #2 then act-rp (nk-strip (nk-branch cs c) parts) else act-none
nk-act h cs hd parts = act-none
