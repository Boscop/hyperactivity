-- ---------------------------------------------------------------- 3. Multi-Layer 5-Layer 3nm Physical SoC GDSII Layout
map-rects-gbox6 : Word → Word → Word → List Rect → List Gds6Box
map-rects-gbox6 lay dt scaleNm nil = nil
map-rects-gbox6 lay dt scaleNm (cons r rs) =
  cons (rect-to-gbox6 lay dt scaleNm r) (map-rects-gbox6 lay dt scaleNm rs)
