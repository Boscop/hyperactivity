io-metal-src =
  io-ln "// hx_hyperinet_opt.metal — Mechanically Lowered 32-Way Bit-Sliced Superoptimized Cubical INet GPU Shader"
  (io-ln "#include <metal_stdlib>"
  (io-ln "using namespace metal;"
  (im-fn "face_conflict" #3 io-w-face-conflict
  (im-fn "demorgan_mux"  #5 io-w-demorgan-mux
  (im-fn "commute"       #6 io-w-commute
  (im-fn "era_prune"     #6 io-w-era-prune
  (im-fn "gals_clk_en"   #4 io-w-gals-clk
  (im-fn "vxchg_fire"    #5 io-w-vxchg-fire
  (im-fn "aux_mux2"      #4 io-w-aux-mux2
  (im-fn "maj3_carry"    #6 io-w-maj3-carry
  (im-fn "xor2_vxchg"    #4 io-w-xor2-vxchg
  (io-ln ""
  (io-ln "// 32-way bit-sliced gate-level Cubical Interaction-Net active-pair reduction engine:"
  (io-ln "// Each thread executes 32 independent cubical active pairs per iteration through ALL 45 superoptimized NAND2 gates!"
  (io-ln "kernel void hx_inet_opt_step("
  (io-ln "  device uint32_t* out_stats [[buffer(0)]],"
  (io-ln "  constant uint32_t& iters   [[buffer(1)]],"
  (io-ln "  uint gid [[thread_position_in_grid]])"
  (io-ln "{"
  (io-ln "  uint32_t a0 = 0xA5A5F00Fu ^ (gid * 0x9E3779B9u);"
  (io-ln "  uint32_t b0 = 0x3C3C55AAu ^ (gid * 0x85EBCA6Bu);"
  (io-ln "  uint32_t m1 = 0xF0F033CCu ^ (gid * 0xC2B2AE35u);"
  (io-ln "  uint32_t ta = 0x55AA33CCu ^ gid, tb = 0xAA55CC33u ^ (gid << 3), pv = 0xFFFFFFFFu;"
  (io-ln "  uint32_t ea = 0x0F0F0F0Fu, eb = 0x00FF00FFu, vx_a = 0xAAAAAAAAu, vx_w = 0xCCCCCCCCu;"
  (io-ln "  uint32_t acc = 0u;"
  (io-ln "  for (uint i = 0; i < iters; ++i) {"
  (io-ln "    uint32_t fc   = opt_face_conflict(a0, b0, m1);"
  (io-ln "    uint32_t iv   = opt_demorgan_mux(a0, b0, m1);"
  (io-ln "    uint32_t era  = opt_era_prune(ea, eb, fc);"
  (io-ln "    uint32_t clk  = opt_gals_clk_en(pv, fc, 0u);"
  (io-ln "    uint32_t act  = pv & ~era;"
  (io-ln "    uint32_t comm = opt_commute(ta, tb, act);"
  (io-ln "    uint32_t ncm  = ~(comm & comm); uint32_t nann = ~(act & ncm); uint32_t ann = ~(nann & nann);"
  (io-ln "    uint32_t vxf  = opt_vxchg_fire(vx_a, vx_w, era);"
  (io-ln "    uint32_t vxn  = opt_xor2_vxchg(vx_a, vx_w, 0u);"
  (io-ln "    uint32_t mux  = opt_aux_mux2(ta, tb, comm);"
  (io-ln "    uint32_t cry  = opt_maj3_carry(ann, comm, vxf);"
  (io-ln "    acc ^= (fc ^ iv ^ clk ^ ann ^ vxn ^ mux ^ cry);"
  (io-ln "    a0 = (a0 << 1) | (iv >> 31); b0 = (b0 >> 1) | (comm << 31); ta = mux; vx_w = vxn;"
  (io-ln "  }"
  (io-ln "  out_stats[gid] = acc;"
  (io-ln "}" nil))))))))))))))))))))))))))))))))))))))))))
