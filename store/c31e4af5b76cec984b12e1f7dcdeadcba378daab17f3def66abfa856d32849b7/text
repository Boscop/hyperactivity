succ-canon-step : (b : Bool) → (rest : List Bool) → (bcanon rest ≡ true → bcanon (bin-succ rest) ≡ true) → bcanon (cons b rest) ≡ true → bcanon (bin-succ (cons b rest)) ≡ true
succ-canon-step b rest ih = case b return λ u → bcanon (cons u rest) ≡ true → bcanon (bin-succ (cons u rest)) ≡ true of
  true → (case rest return λ m → (bcanon m ≡ true → bcanon (bin-succ m) ≡ true) → bcanon (cons true m) ≡ true → bcanon (bin-succ (cons true m)) ≡ true of
    nil → λ g h → λ i → true
    cons r rs → λ g h → succ-canon-cons r rs (g h)) ih
  false → (case rest return λ m → bcanon (cons false m) ≡ true → bcanon (bin-succ (cons false m)) ≡ true of
    nil → λ h → λ i → true
    cons r rs → λ h → h)
