cmp-00 : (t x y : Bool) → cmpN t (plus (bitn x) (times 2 zero)) (plus (bitn y) (times 2 zero)) ≡ (if bit-eq x y then t else y)
cmp-00 t x y = case x return λ u → cmpN t (plus (bitn u) (times 2 zero)) (plus (bitn y) (times 2 zero)) ≡ (if bit-eq u y then t else y) of
  true → cmp-00-t t y
  false → cmp-00-f t y
