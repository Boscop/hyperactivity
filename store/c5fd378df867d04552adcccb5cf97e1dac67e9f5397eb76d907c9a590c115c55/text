-- Iterative deepening d = 1..5 -> provably minimal NAND2 gate count!
hs-id : Word → Word → Word × (Word × Word)
hs-id target maxd =
  %welimP (λ _ → Word × (Word × Word)) maxd (#0 , (#0 , #0)) (λ d0 acc →
    if %wlt #0 (fst acc) then acc
    else
      let d = %wsucc d0
          r = hs-dfs (toNat d) target hs-init #3 #0 #0
          tot = %wadd (snd (snd acc)) (snd r)
      in if %wlt #0 (fst r) then (d , (%wsub (fst r) #1 , tot))
         else (#0 , (#0 , tot)))
