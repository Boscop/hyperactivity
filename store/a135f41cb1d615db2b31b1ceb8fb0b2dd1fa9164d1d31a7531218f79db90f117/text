-- composition clauses (archive/HANDOFF.md, v13, 16 Oct 2026, sha256 04025bd9f961…, §14 “Derived filling and transport”, §16 “Glue computation and composition”, §17 “Universe composition and univalence data”)
-- (2026-11-12) matches CCHM §4.5 “Equality judgments for composition” (Π): the argument x1 at the end is carried back along the domain
-- by the filler of the reversed line (vl, with vl 1 = x1), and the composite is the composition of
-- the applications at vl i.
%comp-pi D E u f0 x1 =
  let vl = λ (k : I) → fill (λ (j : I) → D @ ~ j) [] x1 (~ k)
  in comp (λ (i : I) → (E @ i) (vl @ i)) (sysmap (λ w (i : I) → (w @ i) (vl @ i)) u) (f0 (vl @ 0))
