-- Reverse-mode backpropagation over arbitrary arithmetic circuits (placement wirelength, OPC, gate sizing)
circ-grad : (n : Nat) → Circ A0 A1 A2 (SumFin n) → (SumFin n → Nat) → Nat → SumFin n → Nat
circ-grad n (cwire v) x dy = one-hot n v dy
circ-grad n (cop0 k) x dy = zero-vec n
circ-grad n (cop1 u a) x dy = circ-grad n a x dy
circ-grad n (cop2 b a d) x dy =
  case b of
    a2-add → add-vec n (circ-grad n a x dy) (circ-grad n d x dy)
    a2-mul → add-vec n (circ-grad n a x (times dy (fold val-alg x d)))
                       (circ-grad n d x (times dy (fold val-alg x a)))
