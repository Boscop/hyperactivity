-- the page made once per version of the paper (its stamp) and kept beside it, since making it takes the
-- machine about 15 s; only a page that was answered (200) is kept
s-paper-cached : List Word → List Word → List Word → Sum Unit (List Word) → Proc W (List Word)
s-paper-cached st m pp (inr h) = ret h
s-paper-cached st m pp (inl u) = bind (s-paper-raw st m) (λ r → if h-prefix "HTTP/1.1 200" r then bind (h-write pp r) (λ ok → ret {lzero} {W} r) else ret {lzero} {W} r)
