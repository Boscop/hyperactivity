s-flush : MdOpen → List Word
s-flush md-none = nil
s-flush (md-para ls) = list-append "<p>" (list-append (s-inline (h-sep-words ls)) "</p>")
s-flush (md-quote ls) = list-append "<blockquote>" (list-append (h-concat (list-map (λ p → list-append "<p>" (list-append (s-inline p) "</p>")) (s-quote-paras nil ls))) "</blockquote>")
s-flush (md-list is) = list-append "<ul>" (list-append (h-concat (list-map (λ i → list-append "<li>" (list-append (s-inline i) "</li>")) is)) "</ul>")
