-- independent product flow of two uncoupled subsystems (S1, s1) and (S2, s2):
-- either subsystem steps locally while the other stays fixed (requiring decidable equality on states)
prod-step : {S1 S2 : Type 0}
          → (eq1 : S1 → S1 → Bool) → (eq2 : S2 → S2 → Bool)
          → (S1 → S1 → Bool) → (S2 → S2 → Bool)
          → (S1 × S2) → (S1 × S2) → Bool
prod-step eq1 eq2 s1 s2 p q =
  orB (andB (s1 (fst p) (fst q)) (eq2 (snd p) (snd q)))
      (andB (eq1 (fst p) (fst q)) (s2 (snd p) (snd q)))
