round-e : (t : List (List Word)) → (h0 : Nat) → (r : List Word) → (inv : DblInv t (suc h0) r) → round (suc h0) r ≡ list-map (round-f t h0 r inv) (sufs t)
round-e t h0 r inv =
  tr (list-map (rk {WW} (key-tree {WW} (zippad r (drop-n (suc h0) r)))) (list-map (dkey (fst inv) (suc h0)) (sufs t)))
     (λ i → list-map (rk {WW} (key-tree {WW} (zippad r (drop-n (suc h0) r)))) (keys-eq (fst inv) (suc h0) t r (fst (snd inv)) i))
     (map-map (rk {WW} (key-tree {WW} (zippad r (drop-n (suc h0) r)))) (dkey (fst inv) (suc h0)) (sufs t))
