-- the resolvent's remainder: (1 + μw)(1 − μw) = 1 − μ²w², w = E − V
pl-res2 : BQ → List BQ → Bool
pl-res2 mu w = pl-eq (u-mul (u-add (cons (fn-q 1 1) nil) (u-scale mu w)) (u-add (cons (fn-q 1 1) nil) (u-scale (fn-neg mu) w)))
  (u-add (cons (fn-q 1 1) nil) (u-scale (fn-neg (bq-mul mu mu)) (u-mul w w)))
