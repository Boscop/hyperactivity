-- the rational n/d and the integer k
iv-rat-sound : (S n d : List Bool) → bcanon d ≡ true → le (suc zero) (bin-to-nat d) → encl S (iv-rat S n d) (the (Nat × Nat) (bin-to-nat n , zero)) (bin-to-nat d)
iv-rat-sound S n d cd hd =
  (zle-path (zmul (zv (bz-fdiv (true , bin-mul n S) d)) (the (Nat × Nat) (bin-to-nat d , zero))) (zsc (zv (bz-fdiv (true , bin-mul n S) d)) (bin-to-nat d))
            (the (Nat × Nat) (bin-to-nat (bin-mul n S) , zero)) (zsc (the (Nat × Nat) (bin-to-nat n , zero)) (bin-to-nat S))
     (zmul-zsc (zv (bz-fdiv (true , bin-mul n S) d)) (bin-to-nat d))
     (pairNN (bin-to-nat (bin-mul n S)) zero (times (bin-to-nat n) (bin-to-nat S)) zero (bin-mul-sound n S) (λ i → zero))
     (bz-fdiv-sound (true , bin-mul n S) d cd hd) ,
   zle-path (the (Nat × Nat) (bin-to-nat (bin-mul n S) , zero)) (zsc (the (Nat × Nat) (bin-to-nat n , zero)) (bin-to-nat S))
            (zmul (zv (bz-cdiv (true , bin-mul n S) d)) (the (Nat × Nat) (bin-to-nat d , zero))) (zsc (zv (bz-cdiv (true , bin-mul n S) d)) (bin-to-nat d))
     (pairNN (bin-to-nat (bin-mul n S)) zero (times (bin-to-nat n) (bin-to-nat S)) zero (bin-mul-sound n S) (λ i → zero))
     (zmul-zsc (zv (bz-cdiv (true , bin-mul n S) d)) (bin-to-nat d))
     (bz-cdiv-sound (true , bin-mul n S) d cd hd))
