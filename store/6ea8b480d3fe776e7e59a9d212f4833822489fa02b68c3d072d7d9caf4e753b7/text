-- UNIVERSAL FUTAMURA 1ST PROJECTION SOUNDNESS (1-CELL)
fut-thm-mix-sound : (s : Word → Opt Bool) → (d : Word → Bool) → (e : FExpr) →
  feval d (f-mix s e) ≡ feval (f-merge s d) e
fut-thm-mix-sound s d (fk b)     = refl
fut-thm-mix-sound s d (fv i)     = f-lem-var d i (s i)
fut-thm-mix-sound s d (fxor a b) =
  web-trans-b
    (f-lem-mk-xor d (f-mix s a) (f-mix s b))
    (λ i → web-xorB (fut-thm-mix-sound s d a i) (fut-thm-mix-sound s d b i))
fut-thm-mix-sound s d (fand a b) =
  web-trans-b
    (f-lem-mk-and d (f-mix s a) (f-mix s b))
    (λ i → web-andB (fut-thm-mix-sound s d a i) (fut-thm-mix-sound s d b i))
