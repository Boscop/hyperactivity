nand2-cmos-sound : (a b : Bool) →
  (pmos-on (nand2-env a b) (cmos-dual nand2-pdn) ≡ nand2 a b) ×
  (pmos-on (nand2-env a b) (cmos-dual nand2-pdn) ≡ not (nmos-on (nand2-env a b) nand2-pdn))
nand2-cmos-sound false false = (refl , refl)
nand2-cmos-sound false true  = (refl , refl)
nand2-cmos-sound true  false = (refl , refl)
nand2-cmos-sound true  true  = (refl , refl)
