pf-text-ok : (pkt : TextPacket) → pf-text-dec (pf-text-enc pkt) ≡ pkt
pf-text-ok pkt =
  case pkt return (λ u → pf-text-dec (pf-text-enc u) ≡ u) of
    mk-tpkt h tb →
      let d1 = ok-hdr h (enc-br tb)
          d2 = ok-br tb
      in concat {lzero} {TextPacket}
           {pf-text-dec (list-append (enc-hdr h) (enc-br tb))}
           {mk-tpkt h (dec-br (enc-br tb))} {mk-tpkt h tb}
           (λ i → mk-tpkt (fst (d1 i)) (dec-br (snd (d1 i))))
           (λ i → mk-tpkt h (d2 i))
