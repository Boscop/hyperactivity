ms-lem-hyper-tail :
  (s k : Nat) →
  bn-le-nat (suc (suc (suc k))) (bn-mul-nat (suc k) (suc (suc (suc s)))) ≡ true
ms-lem-hyper-tail _ zero    = refl
ms-lem-hyper-tail s (suc k) =
  let rhs = the Nat (bn-mul-nat (suc k) (suc (suc (suc s))))
      ih  = ms-lem-hyper-tail s k
  in ms-le-weaken (suc (suc (suc k))) (suc (plus s rhs))
       (ms-le-weaken (suc (suc (suc k))) (plus s rhs)
         (ms-le-plus-l s (suc (suc (suc k))) rhs ih))
