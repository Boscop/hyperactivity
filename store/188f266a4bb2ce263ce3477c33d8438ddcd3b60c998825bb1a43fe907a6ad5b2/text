-- the four end bounds: t·P against A·q, from t·E against A and P against E·q
rb1 : (t E P : Nat × Nat) → (A q : Nat) → zle (zmul t E) (the (Nat × Nat) (A , zero)) → zle P (zsc E q) → zle (the (Nat × Nat) (zero , zero)) P → zle (zmul t P) (the (Nat × Nat) (times A q , zero))
rb1 t E P A q F ev hP0 = zsplit t (zle (zmul t P) (the (Nat × Nat) (times A q , zero)))
  (λ hT → zle-trans (zmul t P) (zmul t (zsc E q)) (the (Nat × Nat) (times A q , zero))
     (zle-comm2 P t (zsc E q) t (zle-mul-nonneg P (zsc E q) t hT ev))
     (zle-path (zsc (zmul t E) q) (zmul t (zsc E q)) (zsc (the (Nat × Nat) (A , zero)) q) (the (Nat × Nat) (times A q , zero))
        (symNN (zmul-zsc-r t E q)) (λ i → the (Nat × Nat) (times A q , zero)) (zle-scale (zmul t E) (the (Nat × Nat) (A , zero)) q F)))
  (λ hT → zle-trans (zmul t P) (the (Nat × Nat) (zero , zero)) (the (Nat × Nat) (times A q , zero)) (zle-mul-nonneg t (the (Nat × Nat) (zero , zero)) P hP0 hT) (zle-0n (times A q)))
