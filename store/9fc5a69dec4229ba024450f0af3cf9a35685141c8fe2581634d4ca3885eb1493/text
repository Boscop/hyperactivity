-- the quantized triad of edge 0 on the tetrahedral vertex's states is the edge's spin times the difference of the
-- root volumes of the vertex with that edge raised and lowered: tr(σ_k A_e) = (√V₊ − √V₋) J_k^{(e)},
-- √V± = M±^{1/8}/√2 with M₊ = 75 and M₋ = 3; the z-component on the two states fixes it (Wigner–Eckart: a vector
-- operator from spin 0 to spin 1 has one reduced matrix element)
tet-triad-is-spin : (if triad-row-ok (sides-entries-row tet-cands (edge-sigma-trace-vw 0 tet-ds tet-ts (vw-of tet-ds tet-ts)) 0 0 6) (jz-row 0 tet-ds (mons0 tet-ds) (rows-nth 0 (inv-basis tet-ds)))
  then triad-row-ok (sides-entries-row tet-cands (edge-sigma-trace-vw 0 tet-ds tet-ts (vw-of tet-ds tet-ts)) 1 0 6) (jz-row 0 tet-ds (mons0 tet-ds) (rows-nth 1 (inv-basis tet-ds))) else false) ≡ true
tet-triad-is-spin = λ i → true
