-- a module recorded (the body its text) or dropped, and logged when its pointer moved; a text the
-- source does not hold after recording (it does not read) is refused
s-held : Bool → List Word → Sum Unit (List Word) → Bool
s-held rec body (inl u) = h-not rec
s-held rec body (inr t) = h-not (andB rec (h-not (h-eq t body)))
