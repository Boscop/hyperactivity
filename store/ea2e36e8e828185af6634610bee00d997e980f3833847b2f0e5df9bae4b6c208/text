h-take-at : List Word → List Word → List Word → List Word → Proc W Unit
h-take-at srv m hx q = bind (h-pointer (h-unhex hx)) (λ p →
  if h-eq p q then ret {lzero} {W} unit
  else if h-eq "-" q then h-unrecord-raw (h-unhex hx)
  else bind (h-get srv (list-append "/source/text?path=" hx)) (h-take-text m (h-unhex hx)))
