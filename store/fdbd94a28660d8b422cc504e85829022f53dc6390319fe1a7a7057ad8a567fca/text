nk-fwd-plan-fx : (sl : NkSlots) (u out n : NkW) (v : NkVal) →
  (nk-get sl u ≡ nks-pair (nko-fwd out) v) →
  nk-plan-fx sl u n ≡ nkf-put u nks-none (nkf-val out v nkf-nil)
nk-fwd-plan-fx sl u out n v pu =
  cong (λ s → nk-fx (nk-plan s u n sl)) pu
  ∙ cong (λ h → nk-fx (nk-plan-by h (nko-fwd out) v u n sl)) (nk-held-fwd out v)
