nk-lvl-of : Nat → NkTm → NkTm
nk-lvl-of zero v = nk-con #49 (nk-cons (nk-num #0) (nk-cons (nk-con #40 (nk-cons v (nk-cons (nk-num #0) nk-nil))) nk-nil))
nk-lvl-of (suc k) (nk-num m) = nk-con #49 (nk-cons (nk-num m) nk-nil)
nk-lvl-of (suc k) (nk-con c as) =
  if %weq c #45 then nk-con #49 (nk-cons (nk-num #0) nk-nil)
  else (if %weq c #46 then nk-lvl-suc (nk-lvl-of k (nk-nth as #0))
  else (if %weq c #47 then nk-lvl-max (nk-lvl-of k (nk-nth as #0)) (nk-lvl-of k (nk-nth as #1))
  else (if %weq c #48 then nk-con #48 nk-nil
  else nk-con #49 (nk-cons (nk-num #0) (nk-cons (nk-con #40 (nk-cons (nk-con c as) (nk-cons (nk-num #0) nk-nil))) nk-nil)))))
nk-lvl-of (suc k) v = nk-con #49 (nk-cons (nk-num #0) (nk-cons (nk-con #40 (nk-cons v (nk-cons (nk-num #0) nk-nil))) nk-nil))
