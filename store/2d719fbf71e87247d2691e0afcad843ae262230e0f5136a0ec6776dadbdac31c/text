halves-count : {o : Ord} → (a : El o) → (l : List (El o)) →
               plus (count a (fst (halves l))) (count a (snd (halves l))) ≡ count a l
halves-count a l =
  case l return λ w → plus (count a (fst (halves w))) (count a (snd (halves w))) ≡ count a w of
    nil → λ i → zero
    cons x r →
      transN (plus-assoc (one-if (eqo a x)) (count a (snd (halves r))) (count a (fst (halves r))))
        (congN (plus (one-if (eqo a x)))
           (transN (plus-comm (count a (snd (halves r))) (count a (fst (halves r)))) (rec r)))
