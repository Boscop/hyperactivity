-- Groove transfer: transport any WarpPath onto a target sequence of timings
warp-apply-go : List Word → List WarpStep → Word → List Word
warp-apply-go _ nil _ = nil
warp-apply-go ys (cons ws-diag r) j = cons (w-nth j ys) (warp-apply-go ys r (%wsucc j))
warp-apply-go ys (cons ws-right r) j = cons (w-nth j ys) (warp-apply-go ys r j)
warp-apply-go ys (cons ws-up r) j = warp-apply-go ys r (%wsucc j)
