-- ---------------------------------------------------------------- the gravitational factor K_lp
-- ¼ tr M_l tr M_p, one side of tr M_l against every side of tr M_p: each tr M carries √V = M^{1/8}/√2, so the
-- product carries ½ besides the sides' weights
tt-row : Nat → Side → List Side → List Term
tt-row d s ss = case ss of
  nil → nil
  cons t rest → cons (sq-mul (sq-mul ((suc zero , 2) , (zero , suc zero)) (fst s)) (fst t) , ((fst (snd s) , suc zero) , ((fst (snd t) , suc zero) , outer-mul d (snd (snd s)) (snd (snd t))))) (tt-row d s rest)
