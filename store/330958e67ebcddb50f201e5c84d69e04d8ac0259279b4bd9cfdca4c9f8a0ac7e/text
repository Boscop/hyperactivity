m-resp : MemC → Type
m-resp c = case c return (λ _ → Type) of
  m-alloc kd z s a → MPtr
  m-release kd p → Unit
  m-free p → Unit
  m-load k al p → SV
  m-store k al p v → Unit
  m-ptr-add p e i → MPtr
  m-ptr-diff p q e → UInt64
  m-ptr-cmp o p q → Bool
  m-ptr-int sg w p → SV
  m-int-ptr sg w v → MPtr
  m-memmove d s n → Unit
  m-memcpy d s n → Unit
  m-memset d v n → Unit
