ap-z-neg-neg (zpos zero)    = refl
ap-z-neg-neg (zpos (suc n)) = refl
ap-z-neg-neg (zneg n)       = refl

ap-z-add-neg-l : (x : Z) → z-add (z-neg x) x ≡ z-zero
ap-z-add-neg-l x = concat (z-add-comm (z-neg x) x) (z-add-neg-r x)

z-scale-suc : (c x : Z) → z-scale (z-suc c) x ≡ z-add (z-scale c x) x
z-scale-suc (zpos n)       x = z-add-comm x (z-scale-nat n x)
z-scale-suc (zneg zero)    x =
  concat (sym (ap-z-add-neg-l x))
         (cong (λ t → z-add t x) (cong z-neg (sym (z-add-zero-r x))))
z-scale-suc (zneg (suc n)) x =
  let a  = z-scale-nat (suc n) x
      s1 = sym (z-add-zero-r (z-neg a))
      s2 = cong (z-add (z-neg a)) (sym (ap-z-add-neg-l x))
      s3 = sym (z-add-assoc (z-neg a) (z-neg x) x)
      s4 = cong (λ t → z-add t x) (z-add-comm (z-neg a) (z-neg x))
      s5 = cong (λ t → z-add t x) (sym (z-neg-add x a))
  in concat s1 (concat s2 (concat s3 (concat s4 s5)))

z-scale-pred : (c x : Z) → z-scale (z-pred c) x ≡ z-sub (z-scale c x) x
z-scale-pred (zpos zero)    x =
  concat (cong z-neg (z-add-zero-r x)) refl
z-scale-pred (zpos (suc n)) x =
  let a  = z-scale-nat n x
      s1 = sym (z-add-zero-r a)
      s2 = cong (z-add a) (sym (z-add-neg-r x))
      s3 = sym (z-add-assoc a x (z-neg x))
      s4 = cong (λ t → z-add t (z-neg x)) (z-add-comm a x)
  in concat s1 (concat s2 (concat s3 s4))
z-scale-pred (zneg n)       x =
  let a = z-scale-nat (suc n) x
  in concat (z-neg-add x a) (z-add-comm (z-neg x) (z-neg a))

z-scale-add-nat : (n : Nat) → (c x : Z) → z-scale (z-add-nat n c) x ≡ z-add (z-scale-nat n x) (z-scale c x)
z-scale-add-nat zero    c x = refl
z-scale-add-nat (suc n) c x =
  let s1 = z-scale-suc (z-add-nat n c) x
      s2 = cong (λ t → z-add t x) (z-scale-add-nat n c x)
      s3 = z-add-comm (z-add (z-scale-nat n x) (z-scale c x)) x
      s4 = sym (z-add-assoc x (z-scale-nat n x) (z-scale c x))
  in concat s1 (concat s2 (concat s3 s4))

z-scale-sub-nat : (n : Nat) → (c x : Z) → z-scale (z-sub-nat n c) x ≡ z-sub (z-scale c x) (z-scale-nat n x)
z-scale-sub-nat zero    c x = sym (z-add-zero-r (z-scale c x))
z-scale-sub-nat (suc n) c x =
  let s1 = z-scale-pred (z-sub-nat n c) x
      s2 = cong (λ t → z-sub t x) (z-scale-sub-nat n c x)
      s3 = z-add-assoc (z-scale c x) (z-neg (z-scale-nat n x)) (z-neg x)
      s4 = cong (z-add (z-scale c x)) (z-add-comm (z-neg (z-scale-nat n x)) (z-neg x))
      s5 = cong (z-add (z-scale c x)) (sym (z-neg-add x (z-scale-nat n x)))
  in concat s1 (concat s2 (concat s3 (concat s4 s5)))

z-scale-add : (a b x : Z) → z-scale (z-add a b) x ≡ z-add (z-scale a x) (z-scale b x)
z-scale-add (zpos n) b x = z-scale-add-nat n b x
z-scale-add (zneg n) b x =
  let s1 = z-scale-pred (z-sub-nat n b) x
      s2 = cong (λ t → z-sub t x) (z-scale-sub-nat n b x)
      s3 = z-add-assoc (z-scale b x) (z-neg (z-scale-nat n x)) (z-neg x)
      s4 = cong (z-add (z-scale b x)) (z-add-comm (z-neg (z-scale-nat n x)) (z-neg x))
      s5 = cong (z-add (z-scale b x)) (sym (z-neg-add x (z-scale-nat n x)))
      s6 = z-add-comm (z-scale b x) (z-neg (z-add x (z-scale-nat n x)))
  in concat s1 (concat s2 (concat s3 (concat s4 (concat s5 s6))))

z-scale-neg-pos : (n : Nat) → (x : Z) → z-scale (z-neg (zpos n)) x ≡ z-neg (z-scale-nat n x)
z-scale-neg-pos zero    x = refl
z-scale-neg-pos (suc n) x = refl

z-scale-neg : (a x : Z) → z-scale (z-neg a) x ≡ z-neg (z-scale a x)
z-scale-neg (zpos n) x = z-scale-neg-pos n x
z-scale-neg (zneg n) x = λ i → ap-z-neg-neg (z-scale-nat (suc n) x) (~ i)

ap-cong2 : {A B C : Type} → (f : A → B → C) → {x1 x2 : A} → {y1 y2 : B} →
  x1 ≡ x2 → y1 ≡ y2 → f x1 y1 ≡ f x2 y2
ap-cong2 f p q = λ i → f (p i) (q i)

-- Evaluate canonical normal form Vec6 in Env6
ap-eval-vec : Env6 → Vec6 → Z
ap-eval-vec (env6 x0 x1 x2 x3 x4 x5) (vec6 c0 c1 c2 c3 c4 c5) =
  z-add (z-add (z-add (z-scale c0 x0) (z-scale c1 x1)) (z-scale c2 x2))
        (z-add (z-add (z-scale c3 x3) (z-scale c4 x4)) (z-scale c5 x5))

ap-eval-vadd-3 : (a0 a1 a2 b0 b1 b2 : Z) →
  z-add (z-add (z-add a0 b0) (z-add a1 b1)) (z-add a2 b2) ≡
  z-add (z-add (z-add a0 a1) a2) (z-add (z-add b0 b1) b2)
ap-eval-vadd-3 a0 a1 a2 b0 b1 b2 =
  concat (cong (λ t → z-add t (z-add a2 b2)) (z-swap4 a0 b0 a1 b1))
         (z-swap4 (z-add a0 a1) (z-add b0 b1) a2 b2)

ap-eval-vec-add : (env : Env6) → (u v : Vec6) →
  ap-eval-vec env (v6-add u v) ≡ z-add (ap-eval-vec env u) (ap-eval-vec env v)
ap-eval-vec-add (env6 x0 x1 x2 x3 x4 x5) (vec6 a0 a1 a2 a3 a4 a5) (vec6 b0 b1 b2 b3 b4 b5) =
  let q1 = ap-cong2 z-add (ap-cong2 z-add (z-scale-add a0 b0 x0) (z-scale-add a1 b1 x1)) (z-scale-add a2 b2 x2)
      q2 = ap-cong2 z-add (ap-cong2 z-add (z-scale-add a3 b3 x3) (z-scale-add a4 b4 x4)) (z-scale-add a5 b5 x5)
      s1 = ap-cong2 z-add q1 q2
      s2 = ap-cong2 z-add
             (ap-eval-vadd-3 (z-scale a0 x0) (z-scale a1 x1) (z-scale a2 x2)
                             (z-scale b0 x0) (z-scale b1 x1) (z-scale b2 x2))
             (ap-eval-vadd-3 (z-scale a3 x3) (z-scale a4 x4) (z-scale a5 x5)
                             (z-scale b3 x3) (z-scale b4 x4) (z-scale b5 x5))
      s3 = z-swap4 (z-add (z-add (z-scale a0 x0) (z-scale a1 x1)) (z-scale a2 x2))
                   (z-add (z-add (z-scale b0 x0) (z-scale b1 x1)) (z-scale b2 x2))
                   (z-add (z-add (z-scale a3 x3) (z-scale a4 x4)) (z-scale a5 x5))
                   (z-add (z-add (z-scale b3 x3) (z-scale b4 x4)) (z-scale b5 x5))
  in concat s1 (concat s2 s3)

ap-eval-vneg-3 : (a0 a1 a2 : Z) →
  z-add (z-add (z-neg a0) (z-neg a1)) (z-neg a2) ≡ z-neg (z-add (z-add a0 a1) a2)
ap-eval-vneg-3 a0 a1 a2 =
  concat (cong (λ t → z-add t (z-neg a2)) (sym (z-neg-add a0 a1)))
         (sym (z-neg-add (z-add a0 a1) a2))

ap-eval-vec-neg : (env : Env6) → (u : Vec6) →
  ap-eval-vec env (v6-neg u) ≡ z-neg (ap-eval-vec env u)
ap-eval-vec-neg (env6 x0 x1 x2 x3 x4 x5) (vec6 a0 a1 a2 a3 a4 a5) =
  let q1 = ap-cong2 z-add (ap-cong2 z-add (z-scale-neg a0 x0) (z-scale-neg a1 x1)) (z-scale-neg a2 x2)
