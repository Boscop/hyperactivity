data Var6 = vx0 | vx1 | vx2 | vx3 | vx4 | vx5

data AlgExpr : Type where
  ae-zero : AlgExpr
  ae-var  : Var6 → AlgExpr
  ae-add  : AlgExpr → AlgExpr → AlgExpr
  ae-neg  : AlgExpr → AlgExpr

ae-sub : AlgExpr → AlgExpr → AlgExpr
ae-sub a b = ae-add a (ae-neg b)

data Env6 = env6 (e0 e1 e2 e3 e4 e5 : Z)

ap-lookup : Env6 → Var6 → Z
ap-lookup (env6 x0 x1 x2 x3 x4 x5) vx0 = x0
ap-lookup (env6 x0 x1 x2 x3 x4 x5) vx1 = x1
ap-lookup (env6 x0 x1 x2 x3 x4 x5) vx2 = x2
ap-lookup (env6 x0 x1 x2 x3 x4 x5) vx3 = x3
ap-lookup (env6 x0 x1 x2 x3 x4 x5) vx4 = x4
ap-lookup (env6 x0 x1 x2 x3 x4 x5) vx5 = x5

ap-eval : Env6 → AlgExpr → Z
ap-eval env ae-zero       = z-zero
ap-eval env (ae-var v)    = ap-lookup env v
ap-eval env (ae-add a b)  = z-add (ap-eval env a) (ap-eval env b)
ap-eval env (ae-neg a)    = z-neg (ap-eval env a)

-- Canonical normal form: exact coefficient vector (c0, c1, c2, c3, c4, c5) : Vec6 in Z^6!
data Vec6 = vec6 (c0 c1 c2 c3 c4 c5 : Z)

v6-zero : Vec6
v6-zero = vec6 z-zero z-zero z-zero z-zero z-zero z-zero

v6-add : Vec6 → Vec6 → Vec6
v6-add (vec6 a0 a1 a2 a3 a4 a5) (vec6 b0 b1 b2 b3 b4 b5) =
  vec6 (z-add a0 b0) (z-add a1 b1) (z-add a2 b2) (z-add a3 b3) (z-add a4 b4) (z-add a5 b5)

v6-neg : Vec6 → Vec6
v6-neg (vec6 a0 a1 a2 a3 a4 a5) =
  vec6 (z-neg a0) (z-neg a1) (z-neg a2) (z-neg a3) (z-neg a4) (z-neg a5)

v6-var : Var6 → Vec6
v6-var vx0 = vec6 z-one  z-zero z-zero z-zero z-zero z-zero
v6-var vx1 = vec6 z-zero z-one  z-zero z-zero z-zero z-zero
v6-var vx2 = vec6 z-zero z-zero z-one  z-zero z-zero z-zero
v6-var vx3 = vec6 z-zero z-zero z-zero z-one  z-zero z-zero
v6-var vx4 = vec6 z-zero z-zero z-zero z-zero z-one  z-zero
v6-var vx5 = vec6 z-zero z-zero z-zero z-zero z-zero z-one

ap-norm : AlgExpr → Vec6
ap-norm ae-zero      = v6-zero
ap-norm (ae-var v)   = v6-var v
ap-norm (ae-add a b) = v6-add (ap-norm a) (ap-norm b)
ap-norm (ae-neg a)   = v6-neg (ap-norm a)

-- Exact integer scaling c * x over Z (structural induction, 0 postulates!)
z-scale-nat : Nat → Z → Z
z-scale-nat zero    _ = z-zero
z-scale-nat (suc n) x = z-add x (z-scale-nat n x)

z-scale : Z → Z → Z
z-scale (zpos n) x = z-scale-nat n x
z-scale (zneg n) x = z-neg (z-scale-nat (suc n) x)

-- Exact Abelian laws for z-scale (proved universally for ALL c, d, x : Z!)
z-scale-nat-add : (n : Nat) → (x : Z) → z-scale-nat n (z-neg x) ≡ z-neg (z-scale-nat n x)
z-scale-nat-add zero    x = refl
z-scale-nat-add (suc n) x =
  concat (cong (z-add (z-neg x)) (z-scale-nat-add n x))
         (sym (z-neg-add x (z-scale-nat n x)))

-- Missing 2-line helpers on Z from lib/hx-vision's Abelian group laws
