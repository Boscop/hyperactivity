ap-nat-eq : Nat → Nat → Bool
ap-nat-eq zero    zero    = true
ap-nat-eq (suc a) (suc b) = ap-nat-eq a b
ap-nat-eq _       _       = false

ap-z-eq : Z → Z → Bool
ap-z-eq (zpos a) (zpos b) = ap-nat-eq a b
ap-z-eq (zneg a) (zneg b) = ap-nat-eq a b
ap-z-eq _        _        = false

ap-v6-eq : Vec6 → Vec6 → Bool
ap-v6-eq (vec6 a0 a1 a2 a3 a4 a5) (vec6 b0 b1 b2 b3 b4 b5) =
  andB (ap-z-eq a0 b0)
  (andB (ap-z-eq a1 b1)
  (andB (ap-z-eq a2 b2)
  (andB (ap-z-eq a3 b3)
  (andB (ap-z-eq a4 b4) (ap-z-eq a5 b5)))))

-- Pure cubical elimination of `false === true` into any type A (via `transp`, 0 postulates!)
ap-tf-fam : Type → Bool → Type
ap-tf-fam A false = Nat
ap-tf-fam A true  = A

ap-false-is-true : {A : Type} → false ≡ true → A
ap-false-is-true {A} eq = comp (λ i → ap-tf-fam A (eq i)) (λ i → []) zero

-- Soundness of Boolean normal-form equality: `ap-nat-eq a b === true -> a === b` -> `ap-v6-eq u v === true -> u === v`!
ap-nat-eq-sound : (a b : Nat) → ap-nat-eq a b ≡ true → a ≡ b
ap-nat-eq-sound zero    zero    _  = refl
ap-nat-eq-sound zero    (suc b) eq = ap-false-is-true eq
ap-nat-eq-sound (suc a) zero    eq = ap-false-is-true eq
ap-nat-eq-sound (suc a) (suc b) eq = cong suc (ap-nat-eq-sound a b eq)

ap-z-eq-sound : (a b : Z) → ap-z-eq a b ≡ true → a ≡ b
ap-z-eq-sound (zpos a) (zpos b) eq = cong zpos (ap-nat-eq-sound a b eq)
ap-z-eq-sound (zneg a) (zneg b) eq = cong zneg (ap-nat-eq-sound a b eq)
ap-z-eq-sound (zpos a) (zneg b) eq = ap-false-is-true eq
ap-z-eq-sound (zneg a) (zpos b) eq = ap-false-is-true eq

ap-andB-l : (a b : Bool) → andB a b ≡ true → a ≡ true
ap-andB-l true  b _  = refl
ap-andB-l false b eq = eq

ap-andB-r : (a b : Bool) → andB a b ≡ true → b ≡ true
ap-andB-r true  b eq = eq
ap-andB-r false b eq = ap-false-is-true eq

ap-v6-eq-sound : (u v : Vec6) → ap-v6-eq u v ≡ true → u ≡ v
ap-v6-eq-sound (vec6 a0 a1 a2 a3 a4 a5) (vec6 b0 b1 b2 b3 b4 b5) eq =
  let t4  = andB (ap-z-eq a4 b4) (ap-z-eq a5 b5)
      t3  = andB (ap-z-eq a3 b3) t4
      t2  = andB (ap-z-eq a2 b2) t3
      t1  = andB (ap-z-eq a1 b1) t2
      q0  = ap-z-eq-sound a0 b0 (ap-andB-l (ap-z-eq a0 b0) t1 eq)
      r1  = ap-andB-r (ap-z-eq a0 b0) t1 eq
      q1  = ap-z-eq-sound a1 b1 (ap-andB-l (ap-z-eq a1 b1) t2 r1)
      r2  = ap-andB-r (ap-z-eq a1 b1) t2 r1
      q2  = ap-z-eq-sound a2 b2 (ap-andB-l (ap-z-eq a2 b2) t3 r2)
      r3  = ap-andB-r (ap-z-eq a2 b2) t3 r2
      q3  = ap-z-eq-sound a3 b3 (ap-andB-l (ap-z-eq a3 b3) t4 r3)
      r4  = ap-andB-r (ap-z-eq a3 b3) t4 r3
      q4  = ap-z-eq-sound a4 b4 (ap-andB-l (ap-z-eq a4 b4) (ap-z-eq a5 b5) r4)
      q5  = ap-z-eq-sound a5 b5 (ap-andB-r (ap-z-eq a4 b4) (ap-z-eq a5 b5) r4)
  in λ i → vec6 (q0 i) (q1 i) (q2 i) (q3 i) (q4 i) (q5 i)

