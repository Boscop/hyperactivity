emit-wasm-inet : INetExpr → List Word
emit-wasm-inet e =
  let epay  = the (List Word) (cons #1 (cons #6 (list-append "reduce" (cons #0 (cons #0 nil)))))
      secE  = the (List Word) (cons #7 (list-append (bn-wasm-uleb (fromNat (list-length epay))) epay))
      insns = the (List Word) (list-append (bn-wasm-emit-expr (superchip-opt e)) (cons #11 nil))
      fbody = the (List Word) (cons #1 (cons #1 (cons #126 insns)))
      cpay  = the (List Word) (cons #1 (list-append (bn-wasm-uleb (fromNat (list-length fbody))) fbody))
      secC  = the (List Word) (cons #10 (list-append (bn-wasm-uleb (fromNat (list-length cpay))) cpay))
  in h-concat (cons bn-wasm-hdr (cons bn-wasm-sec-type (cons bn-wasm-sec-func (cons secE (cons secC nil)))))
