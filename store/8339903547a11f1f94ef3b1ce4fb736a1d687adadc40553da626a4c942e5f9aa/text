-- ============================================================================
-- 1. Tight Dual Bracket Pins Every Fine State in the Coarse Fiber (Zero Width)
-- ============================================================================
rg-tight-bracket-pins-value :
  (Fine Coarse : Type 0) → (obs : Fine → Coarse) → (val : Fine → Nat) →
  (B : DualBracket Fine Coarse obs val) →
  (x : Fine) → fst B (obs x) ≡ fst (snd B) (obs x) →
  val x ≡ fst B (obs x)
rg-tight-bracket-pins-value Fine Coarse obs val B x tight =
  let lb = fst B
      ub = fst (snd B)
      cert = snd (snd B) x
      le1 = fst cert
      le2 = transport (λ i → rg-leb (val x) (tight (~ i)) ≡ true) (snd cert)
  in rg-leb-antisym (val x) (lb (obs x)) le2 le1
