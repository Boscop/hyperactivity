-- the kernel vector of the free column fr: 1 there, 0 at the other free columns, −(pivot row)[fr] at each pivot
kernel-vec : Nat → Nat → Nat → Pivots → List SQ
kernel-vec n k fr ps = case n of
  zero → nil
  suc g → cons (if eqb k fr then sq-one else (if piv-has k ps then sq-neg (sq-nth fr (piv-row k ps)) else sq-zero)) (kernel-vec g (suc k) fr ps)
