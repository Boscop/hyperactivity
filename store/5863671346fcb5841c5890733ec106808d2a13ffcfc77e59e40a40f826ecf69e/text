ins-sort-count : {o : Ord} → (a : El o) → (l : List (El o)) → count a (ins-sort l) ≡ count a l
ins-sort-count a l =
  case l return λ w → count a (ins-sort w) ≡ count a w of
    nil → λ i → zero
    cons x r →
      transN (merge-count a (cons x nil) (ins-sort r))
        (transN (congN (λ m → plus m (count a (ins-sort r))) (plus-zero (one-if (eqo a x))))
           (congN (plus (one-if (eqo a x))) (rec r)))
