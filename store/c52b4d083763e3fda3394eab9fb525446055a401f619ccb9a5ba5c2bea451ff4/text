-- at p, R: F = c − r_1 from A's interval, with both starts' soundness
h2p-at-a : List Bool → List Bool → IV → IV → IV → Nat → Nat → IV → Bool × IV
h2p-at-a S S2 R p sig M N a = (both (ang-start-ok S (iv-mul S p p) a M) (rad-start-ok S p sig (rad-c S R p a sig) N) ,
  iv-sub (rad-c S R p a sig) (rad-down S S2 p sig (rad-c S R p a sig) N (iv-unit S)))
