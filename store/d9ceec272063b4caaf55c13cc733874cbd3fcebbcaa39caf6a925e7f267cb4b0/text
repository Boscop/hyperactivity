-- transport in a line of path types: a path whose point at j is the composition, along the line
-- of types at j, of the given path's point with the two ends on the faces j = 0 and j = 1
nk-transp-path : NkTm → NkTm → NkTm → NkTm → NkTm → NkTm
nk-transp-path lline aline bline phi p =
  nk-lam (nk-comp
    (nk-lam (nk-app (nk-app (nk-up2 lline) (nk-var #0)) (nk-var #1)))
    (nk-cons (nk-br (nk-up phi) (nk-lam (nk-app (nk-up2 p) (nk-var #1))))
      (nk-cons (nk-br (nk-neg (nk-var #0)) (nk-lam (nk-app (nk-up2 aline) (nk-var #0))))
      (nk-cons (nk-br (nk-var #0) (nk-lam (nk-app (nk-up2 bline) (nk-var #0)))) nk-nil)))
    (nk-app (nk-up p) (nk-var #0)))
