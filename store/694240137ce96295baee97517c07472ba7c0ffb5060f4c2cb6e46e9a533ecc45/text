this-lower-ch : Word → Word
this-lower-ch c =
  if andB (%wlt #64 c) (%wlt c #91) then %wadd c #32 else c

this-lower : List Word → List Word
this-lower nil = nil
this-lower (cons c r) = cons (this-lower-ch c) (this-lower r)

this-has-any : List (List Word) → List Word → Bool
this-has-any nil _ = false
this-has-any (cons k ks) s =
  if h-infix k s then true else this-has-any ks s

-- Extract explicit `/doc?path=<mod>` route parameter cleanly
this-doc-route-path : List Word → List Word
this-doc-route-path r =
  if h-infix "path=" r then
    let rest = h-after "path=" r
        cut1 = h-before "&" rest
    in h-before "#" cut1
  else nil

