this-kv : List Word → List Word → List Word
this-kv k rawVal =
  h-concat (cons this-q (cons k (cons this-q (cons ":" (cons this-q (cons rawVal (cons this-q nil)))))))

this-grounding-rule : List Word
this-grounding-rule =
  "LIVE KNOWLEDGE-GRAPH CONTEXT: Below is live verified source straight from Hyperactivity's content-addressed store/ and live interaction trace (store/trace.jsonl) for the user's current route and question. You have direct read access to this exact state — never say you cannot read store/ or the trace. Write in a fluent, expert, mathematically and mechanically precise technical register: explain the exact mechanism cleanly without vague analogies, buzzwords, chatbot filler, or unsolicited mini-challenges; cite exact definitions and verified numbers from the slice when relevant; never dump raw logs or code walls unprompted."

this-build-payload : List Word → List Word → List Word → List Word → List Word → List Word
this-build-payload sysPrefix liveCtx qRaw rRaw qtRaw =
  let nl = h-concat (cons this-bs (cons "n" nil))
      sysFull = h-concat (cons sysPrefix (cons this-nl-raw (cons this-nl-raw (cons this-grounding-rule (cons this-nl-raw (cons this-nl-raw (cons liveCtx nil)))))))
      userRaw =
        h-concat (cons "[Space: " (cons rRaw (cons "]" (cons nl
          (if h-null qtRaw then cons qRaw nil
           else cons "[Context: " (cons qtRaw (cons "]" (cons nl (cons nl (cons qRaw nil))))))))))
  in h-concat (
    cons "{" (
    cons this-q (cons "systemInstruction" (cons this-q (cons ":{" (
    cons this-q (cons "parts" (cons this-q (cons ":[{" (
    cons (this-kv "text" (this-esc-json sysFull)) (
    cons "}]}," (
    cons this-q (cons "contents" (cons this-q (cons ":[{" (
    cons (this-kv "role" "user") (cons "," (
    cons this-q (cons "parts" (cons this-q (cons ":[{" (
    cons (this-kv "text" userRaw) (
    cons "}]}]," (
    cons this-q (cons "generationConfig" (cons this-q (cons ":{" (
    cons this-q (cons "temperature" (cons this-q (cons ":0.3," (
    cons this-q (cons "maxOutputTokens" (cons this-q (cons ":2048," (
    cons this-q (cons "thinkingConfig" (cons this-q (cons ":{" (
    cons this-q (cons "thinkingBudget" (cons this-q (cons ":1024" (
    cons "}}}" nil))))))))))))))))))))))))))))))))))))))))))))

this-trim-nl : List Word → List Word
this-trim-nl nil = nil
this-trim-nl (cons c r) =
  if orB (%weq c #10) (%weq c #13) then this-trim-nl r else cons c (this-trim-nl r)

-- Read configured Supergenius model strictly when GEMINI_API_KEY is present in process env
this-check-env-args : List (List Word)
this-check-env-args =
  cons "/bin/sh" (cons "-c" (cons (h-concat (cons "test -n " (cons this-q (cons "$GEMINI_API_KEY" (cons this-q (cons " && printf '%s' " (cons this-q (cons "${HX_GEMINI_MODEL:-gemini-4-neon}" (cons this-q nil))))))))) nil))

-- Concurrency-safe per-request curl invocation (reads reqPath, then unlinks reqPath!)
this-curl-cmd : List Word → List Word
this-curl-cmd reqPath =
  list-append "test -n "
  (list-append this-q
  (list-append "$GEMINI_API_KEY"
  (list-append this-q
  (list-append " || exit 2; res=$(curl -sS --max-time 45 -X POST -H 'Content-Type: application/json' -H "
  (list-append this-q
  (list-append "x-goog-api-key: $GEMINI_API_KEY"
  (list-append this-q
  (list-append " --data-binary @"
  (list-append reqPath
  (list-append " "
  (list-append this-q
  (list-append "https://generativelanguage.googleapis.com/v1beta/models/${HX_GEMINI_MODEL:-gemini-4-neon}:generateContent"
  (list-append this-q
  (list-append "); rm -f "
  (list-append reqPath
  (list-append "; printf '%s' "
  (list-append this-q
  (list-append "$res" this-q))))))))))))))))))

this-curl-args-for : List Word → List (List Word)
this-curl-args-for reqPath =
  cons "/bin/sh" (cons "-c" (cons (this-curl-cmd reqPath) nil))

this-status-json : List Word → List Word
this-status-json model =
  if h-null model then
    h-concat (cons "{" (cons (this-kv "engine" "") (cons "," (cons (this-kv "link" "THIS") (cons "," (cons (this-kv "hint" "Set GEMINI_API_KEY on Render to activate live THIS Supergenius link") (cons "}" nil)))))))
  else
    h-concat (cons "{" (cons (this-kv "engine" (this-esc-json model)) (cons ","
      (cons (this-kv "link" "THIS") (cons ","
      (cons (this-kv "grounding" "live-store+trace") (cons ","
      (cons this-q (cons "bankUsd" (cons this-q (cons ":100,"
      (cons this-q (cons "monthSpentUsd" (cons this-q (cons ":0,"
      (cons this-q (cons "monthCapUsd" (cons this-q (cons ":3000}" nil)))))))))))))))))))

this-handle-status : Proc W (List Word)
this-handle-status =
  bind (h-capture this-check-env-args) (λ r →
    let model = if %weq (fst r) #0 then this-trim-nl (snd r) else nil in
    ret {lzero} {W} (this-status-json model))

this-or-doc : List Word → Sum Unit (List Word) → List Word
this-or-doc fallback (inl u) = fallback
this-or-doc fallback (inr d) = if h-null d then fallback else d

this-default-sys : List Word
this-default-sys =
  "You are THIS — the interactive first-principles guide and Supergenius link inside Hyperactivity OS (hyperactivity.ai). Hyperactivity itself is the deterministic oracle and crystal ball; you are fluent in both human language and the live content-addressed codebase."

this-format-response : List Word → List Word → List Word → List Word → List Word
this-format-response model m1 m2 raw =
  let ans = this-extract-gemini-answer raw in
  if h-not (h-null ans) then
    h-concat (cons "{" (cons (this-kv "answer" ans) (cons ","
      (cons (this-kv "meta" (h-concat (cons "THIS · live " (cons (this-esc-json model) (cons " · KG[" (cons (this-esc-json m1) (cons ", " (cons (this-esc-json m2) (cons "]" nil))))))))) (cons "}" nil)))))
  else
    let errMsg = this-extract-gemini-err raw
        shown  = the (List Word) (if h-null errMsg then "THIS upstream returned no candidate (check GEMINI_API_KEY and HX_GEMINI_MODEL on Render)" else errMsg)
    in h-concat (cons "{" (cons (this-kv "error" shown) (cons "}" nil)))

this-format-live-ctx : List Word → List Word → List Word → List Word → List Word → List Word → List Word
this-format-live-ctx rh tr m1 d1 m2 d2 =
