-- Assemble live grounded Knowledge-Graph slice + real-time store/ROOT + store/trace.jsonl tail!
this-gather-live-ctx : List Word → List Word → Proc W (List Word)
this-gather-live-ctx m1 m2 =
  bind (h-read "store/ROOT/root") (λ mr →
  bind (h-read "store/trace.jsonl") (λ mt →
  bind (h-document m1) (λ md1 →
  bind (h-document m2) (λ md2 →
    let rh  = this-trim-nl (this-or-doc "unknown" mr)
        tr  = this-tail-bytes (toNat #1800) (this-or-doc "(no trace events yet)" mt)
        d1  = h-take (toNat #4200) (this-or-doc "(not in store)" md1)
        d2  = h-take (toNat #2800) (this-or-doc "(not in store)" md2)
    in ret {lzero} {W} (this-format-live-ctx rh tr m1 d1 m2 d2)))))

-- Forward optional multi-turn `history` context into Gemini prompt + support `steer` or `question`
this-extract-hist-snippet : List Word → List Word
this-extract-hist-snippet body =
  let pat = h-concat (cons this-q (cons "history" (cons this-q (cons ":[" nil)))) in
  if h-infix pat body then
    h-take (toNat #2048) (h-before "]" (h-after pat body))
  else nil

this-post-with-model : List Word → List Word → List Word → Proc W (List Word)
this-post-with-model model sysPrefix reqBody =
  let qRaw   = this-json-raw-field "question" reqBody
      sRaw   = this-json-raw-field "steer" reqBody
      effQ   = the (List Word) (if h-null qRaw then sRaw else qRaw)
      rRaw   = this-json-raw-field "route" reqBody
      qtRaw  = this-json-raw-field "quote" reqBody
      hRaw   = this-extract-hist-snippet reqBody
      fullQt = the (List Word) (if h-null hRaw then qtRaw else h-concat (cons qtRaw (cons " | Recent dialogue: " (cons (this-esc-json hRaw) nil))))
      m1     = this-select-mod1 rRaw effQ
      m2     = this-select-mod2 rRaw effQ
      reqP   = this-req-path (h-concat (cons rRaw (cons "|" (cons effQ (cons "|" (cons fullQt nil))))))
  in if h-null effQ then
       ret {lzero} {W} (h-concat (cons "{" (cons (this-kv "error" "empty steering vector") (cons "}" nil))))
     else
       bind (this-gather-live-ctx m1 m2) (λ liveCtx →
       bind (h-write reqP (this-build-payload sysPrefix liveCtx effQ rRaw fullQt)) (λ ok →
       bind (h-capture (this-curl-args-for reqP)) (λ res →
         ret {lzero} {W} (this-format-response model m1 m2 (snd res)))))

this-handle-post : List Word → Proc W (List Word)
this-handle-post reqBody =
  bind (h-capture this-check-env-args) (λ ev →
    let model = if %weq (fst ev) #0 then this-trim-nl (snd ev) else nil in
    if h-null model then
      ret {lzero} {W} (h-concat (cons "{" (cons (this-kv "error" "GEMINI_API_KEY not set on server (add GEMINI_API_KEY on Render or connect BYOK in THIS)") (cons "}" nil))))
    else
      bind (h-document "docs/this-prefix.txt") (λ doc →
        this-post-with-model model (this-or-doc this-default-sys doc) reqBody))
