-- Fast pure FNV-1a 32-bit hash -> hex string for collision-free per-request temp paths!
this-fnv-go : Word → List Word → Word
this-fnv-go h nil = h
this-fnv-go h (cons c r) =
  this-fnv-go (%wand (%wmul (%wxor h c) #16777619) #4294967295) r

this-hex-dig : Word → Word
this-hex-dig d = if %wlt d #10 then %wadd #48 d else %wadd #87 d

this-hex8 : Word → List Word
this-hex8 v =
  cons (this-hex-dig (%wand (%wshr v #28) #15))
  (cons (this-hex-dig (%wand (%wshr v #24) #15))
  (cons (this-hex-dig (%wand (%wshr v #20) #15))
  (cons (this-hex-dig (%wand (%wshr v #16) #15))
  (cons (this-hex-dig (%wand (%wshr v #12) #15))
  (cons (this-hex-dig (%wand (%wshr v #8) #15))
  (cons (this-hex-dig (%wand (%wshr v #4) #15))
  (cons (this-hex-dig (%wand v #15)) nil)))))))

this-req-path : List Word → List Word
this-req-path seed =
  h-concat (cons "/tmp/hx-this-" (cons (this-hex8 (this-fnv-go #2166136261 seed)) (cons ".json" nil)))

-- Take the last N bytes of a list cleanly (for live store/trace.jsonl tail!)
this-rev-go : List Word → List Word → List Word
this-rev-go nil acc = acc
this-rev-go (cons c r) acc = this-rev-go r (cons c acc)

this-tail-bytes : Nat → List Word → List Word
this-tail-bytes n xs = this-rev-go (h-take n (this-rev-go xs nil)) nil

