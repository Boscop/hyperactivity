-- ============================================================================
-- SECTION 1: PURE JSON STRING ESCAPER & RAW JSON STRING EXTRACTOR (PROVED REFL)
-- ============================================================================

this-q : List Word
this-q = cons #34 nil

this-bs : List Word
this-bs = cons #92 nil

this-nl-raw : List Word
this-nl-raw = cons #10 nil

this-esc-json : List Word → List Word
this-esc-json nil = nil
this-esc-json (cons c r) =
  if %weq c #34 then cons #92 (cons #34 (this-esc-json r)) else
  if %weq c #92 then cons #92 (cons #92 (this-esc-json r)) else
  if %weq c #10 then cons #92 (cons #110 (this-esc-json r)) else
  if %weq c #13 then cons #92 (cons #114 (this-esc-json r)) else
  if %weq c #9  then cons #92 (cons #116 (this-esc-json r)) else
  if %wlt c #32 then this-esc-json r else
  cons c (this-esc-json r)

-- Read raw JSON string body (already JSON-escaped!) up to unescaped closing quote #34
this-take-jstr : List Word → List Word
this-take-jstr nil = nil
this-take-jstr (cons c r) =
  if %weq c #34 then nil
  else if %weq c #92 then
    (case r of
      nil → nil
      cons c2 r2 → cons #92 (cons c2 (this-take-jstr r2)))
  else cons c (this-take-jstr r)

this-skip-ws : List Word → List Word
this-skip-ws nil = nil
this-skip-ws (cons c r) =
  if orB (%weq c #32) (orB (%weq c #9) (orB (%weq c #10) (%weq c #13)))
  then this-skip-ws r else cons c r

this-after-colon-jstr : List Word → List Word
this-after-colon-jstr s =
  let a = this-skip-ws s in
  case a of
    nil → nil
    cons c r →
      if %weq c #58 then
        (let b = this-skip-ws r in
         case b of
           nil → nil
           cons q rest → if %weq q #34 then this-take-jstr rest else nil)
      else nil

this-json-raw-field : List Word → List Word → List Word
this-json-raw-field key body =
  let pat = h-concat (cons this-q (cons key (cons this-q nil))) in
  if h-infix pat body then this-after-colon-jstr (h-after pat body) else nil

-- Extract the LAST `"text"` string inside `"candidates"` (skips earlier `"thought": true` parts!)
this-last-text-go : Nat → List Word → List Word → List Word
this-last-text-go zero s best = best
this-last-text-go (suc k) s best =
  let pat = h-concat (cons this-q (cons "text" (cons this-q nil))) in
  if h-infix pat s then
    let rest = h-after pat s
        val  = this-after-colon-jstr rest
        next = if h-null val then best else val
    in this-last-text-go k rest next
  else best

this-extract-gemini-answer : List Word → List Word
this-extract-gemini-answer resp =
  let cpat = h-concat (cons this-q (cons "candidates" (cons this-q nil))) in
  if h-infix cpat resp then this-last-text-go (toNat #24) (h-after cpat resp) nil
  else nil

this-extract-gemini-err : List Word → List Word
this-extract-gemini-err resp = this-json-raw-field "message" resp

