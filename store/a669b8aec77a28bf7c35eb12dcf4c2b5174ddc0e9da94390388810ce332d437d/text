-- ---------------------------------------------------------------- safety
-- no replica applies a write it has not logged: applied ⊆ log, and a write whose
-- acknowledgement is owed is logged. It is an invariant of each replica's own state, so it
-- holds in every reachable state under every choice sequence, whatever node 3 does
KvPendIn : List KvWrite → KvPend → Type
KvPendIn lg pd = case pd of kp-none → Unit; kp-ack to w → InL {KvWrite} w lg; kp-val to rid v → Unit
