-- every side of a system applied, at each point of its path, to one more argument: the new
-- innermost variable
nk-sys-app : NkTm → NkTm
nk-sys-app (nk-cons b r) = nk-cons (nk-br (nk-up (nk-nth (nk-args b) #0)) (nk-lam (nk-app (nk-app (nk-up2 (nk-nth (nk-args b) #1)) (nk-var #0)) (nk-var #1)))) (nk-sys-app r)
nk-sys-app t = nk-nil
