it-neg-fn : (A V : Type) → (neg : A → Bool) → (f : V → V → A) → (ws : List V) → sy-all V (λ u → neg (f u u) ≡ true) (it-fn A V neg f ws)
it-neg-fn A V neg f ws = case ws return λ w → sy-all V (λ u → neg (f u u) ≡ true) (it-fn A V neg f w) of
  nil → unit
  cons u ur → it-ifc V (neg (f u u)) u (it-fn A V neg f ur) (λ l → sy-all V (λ x → neg (f x x) ≡ true) l) (λ e → (e , it-neg-fn A V neg f ur)) (it-neg-fn A V neg f ur)
