hi-lines-at : List Word → List Word → List (List Word) → List Word
hi-lines-at f p nil = nil
hi-lines-at f p (cons l r) = if h-infix (hi-mark f) l then h-concat (cons "<li>" (cons (s-esc (h-drop "- " l)) (cons " <span class='who'>— " (cons (s-esc (h-before ".md" (h-drop "readers/" p))) (cons "</span></li>" (cons (hi-lines-at f p r) nil)))))) else hi-lines-at f p r
