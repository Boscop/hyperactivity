-- Strict erasure witness: if two internal states s1, s2 are distinguished by direct
-- optical observation (o_direct s1 ≠ o_direct s2) yet mapped to the same symbolic message
-- (g (o_direct s1) ≡ g (o_direct s2)), then no decoder d : Z → Y can recover o_direct from g.
ec-abstraction-erases :
  {S Y Z : Type 0} → (o-direct : S → Y) → (g : Y → Z) →
  (s1 s2 : S) →
  (o-direct s1 ≡ o-direct s2 → Empty) →
  g (o-direct s1) ≡ g (o-direct s2) →
  ((d : Z → Y) → ((y : Y) → d (g y) ≡ y) → Empty)
ec-abstraction-erases o-direct g s1 s2 neq coll d inv =
  neq (concat (sym (inv (o-direct s1)))
              (concat (λ i → d (coll i)) (inv (o-direct s2))))
