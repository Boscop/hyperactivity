-- T = Q_v² = −S²/16 on vectors over the weight-zero monomials of ds
t-apply : List Nat → List Triple → List SQ → List SQ
t-apply ds ts v = vec-scale ((zero , suc zero) , (suc zero , 16)) (qsum-apply ds ts (mons0 ds) (qsum-apply ds ts (mons0 ds) v))
