-- (part of language-support)
rr08 : (reg' : Bits #4) → (rex : Bits #8) → MS (Bits #8)
rr08 reg' rex =
  let reg' : ZI
      reg' = (bv-unsigned #4 reg')
  in λ σ →
       if (b-or (b-not (weq rex #0)) (z-lt reg' (zpos #4))) then
         the (MS (Bits #8))
           (bindS {Bits #64} {Bits #8} (rgfi reg') (λ qword →
              retS {Bits #8} (bv-trunc #64 #8 qword))) σ
       else
         the (MS (Bits #8))
           (bindS {Bits #64} {Bits #8} (rgfi (bv-unsigned #4 (bits_of_int (z-sub reg' (zpos #4)) (zpos #4)))) (λ qword →
              retS {Bits #8} (bv-slice #64 qword #15 #8))) σ
