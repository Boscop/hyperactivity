-- 64-bit Apple Silicon Mach-O executable image (`MH_MAGIC_64 = 0xfeedfacf`, `CPU_TYPE_ARM64 = 0x0100000c`,
-- `MH_EXECUTE = 2`, 16 KiB page-aligned `__TEXT`/`__text` at VM base `0x100000000` = `#4294967296`,
-- header + 5 load commands = 376 bytes, code placed at file offset 384 (`0x180`, 16-byte aligned)):
macho-image : Lst Word → Lst Word
macho-image code-bytes =
  let csz   = l-count code-bytes
      raw   = %wadd #384 csz
      tsz   = macho-align16k raw
      pad   = %wsub tsz raw
      vm0   = #4294967296
      hdr   = xcat4 (xb4 #207 #250 #237 #254) (xb4 #12 #0 #0 #1)
                    (xcat3 (xle #0 #4) (xle #2 #4) (xle #5 #4))
                    (xcat3 (xle #344 #4) (xle #1 #4) (xle #0 #4))
      lc-pz = xcat5 (xle #25 #4) (xle #72 #4) macho-nm-pagezero
                    (xcat4 (xle #0 #8) (xle vm0 #8) (xle #0 #8) (xle #0 #8))
                    (xcat4 (xle #0 #4) (xle #0 #4) (xle #0 #4) (xle #0 #4))
      sect  = xcat6 macho-nm-text-sec macho-nm-text-seg
                    (l-app (xle (%wadd vm0 #384) #8) (xle csz #8))
                    (l-app (xle #384 #4) (xle #4 #4))
                    (xcat3 (xle #0 #4) (xle #0 #4) (xle #2147484672 #4))
                    (xcat3 (xle #0 #4) (xle #0 #4) (xle #0 #4))
      lc-tx = xcat6 (xle #25 #4) (xle #152 #4) macho-nm-text-seg
                    (xcat4 (xle vm0 #8) (xle tsz #8) (xle #0 #8) (xle tsz #8))
                    (xcat4 (xle #5 #4) (xle #5 #4) (xle #1 #4) (xle #0 #4))
                    sect
      lc-le = xcat5 (xle #25 #4) (xle #72 #4) macho-nm-linkedit
                    (xcat4 (xle (%wadd vm0 tsz) #8) (xle #16384 #8) (xle tsz #8) (xle #0 #8))
                    (xcat4 (xle #1 #4) (xle #1 #4) (xle #0 #4) (xle #0 #4))
      lc-mn = xcat4 (xle #2147483688 #4) (xle #24 #4) (xle #384 #8) (xle #0 #8)
      lc-bv = xcat6 (xle #50 #4) (xle #24 #4) (xle #1 #4) (xle #983040 #4) (xle #983040 #4) (xle #0 #4)
      pre   = xcat6 hdr lc-pz lc-tx lc-le lc-mn (l-app lc-bv (macho-zeros #8))
  in xcat3 pre code-bytes (macho-zeros pad)
