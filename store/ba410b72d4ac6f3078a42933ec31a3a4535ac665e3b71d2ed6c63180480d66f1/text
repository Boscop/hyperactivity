-- a versions record two repositories both added to comes back from git with its marks of conflict
-- between the two sides' lines. The record only ever gains lines, so both sides' lines are kept and
-- the marks dropped whenever it is read to be added to (2026-11-22: a merge left the welcome file's
-- record so)
hy-unmarked-lines : List (List Word) → List (List Word)
hy-unmarked-lines nil = nil
hy-unmarked-lines (cons l r) = if orB (h-prefix "<<<<<<<" l) (orB (h-prefix "=======" l) (h-prefix ">>>>>>>" l)) then hy-unmarked-lines r else cons l (hy-unmarked-lines r)
