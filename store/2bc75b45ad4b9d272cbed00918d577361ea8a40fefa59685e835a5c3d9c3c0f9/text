s-serve : Nat → List Word → List Word → Word → Proc W Unit
s-serve zero st m fd = ret unit
s-serve (suc k) st m fd = bind (sys-call #43 fd #0 #0 #0 #0 #0) (λ c →
  bind (alloc-bytes #65536) (λ buf → bind (sys-call #0 c buf #65536 #0 #0 #0) (λ n →
  bind (h-peek buf (toNat (if wlt n #65537 then n else #0))) (λ req →
  bind (s-answer st m (s-request-path req)) (λ resp →
  bind (fd-write c resp) (λ w → bind (sys-call #3 c #0 #0 #0 #0 #0) (λ cl → s-serve k st m fd)))))))
