-- a product of positives is positive; a positive product with a positive factor has a positive other factor
zpos-mul : (x y : Nat × Nat) → zpos x → zpos y → zpos (zmul x y)
zpos-mul x y hx hy = zle-zeq-r (the (Nat × Nat) (suc zero , zero)) (zsc (the (Nat × Nat) (suc (fst hx) , zero)) (suc (fst hy))) (zmul x y)
  (zeq-trans (zsc (the (Nat × Nat) (suc (fst hx) , zero)) (suc (fst hy))) (zmul (the (Nat × Nat) (suc (fst hx) , zero)) y) (zmul x y)
     (zeq-trans (zsc (the (Nat × Nat) (suc (fst hx) , zero)) (suc (fst hy))) (zmul (the (Nat × Nat) (suc (fst hx) , zero)) (the (Nat × Nat) (suc (fst hy) , zero))) (zmul (the (Nat × Nat) (suc (fst hx) , zero)) y)
        (zeq-of-path (zsc (the (Nat × Nat) (suc (fst hx) , zero)) (suc (fst hy))) (zmul (the (Nat × Nat) (suc (fst hx) , zero)) (the (Nat × Nat) (suc (fst hy) , zero))) (symNN (zmul-zsc (the (Nat × Nat) (suc (fst hx) , zero)) (suc (fst hy)))))
        (zmul-zeq-r (the (Nat × Nat) (suc (fst hx) , zero)) (the (Nat × Nat) (suc (fst hy) , zero)) y (zeq-sym y (the (Nat × Nat) (suc (fst hy) , zero)) (zpos-eq y hy))))
     (zeq-trans (zmul (the (Nat × Nat) (suc (fst hx) , zero)) y) (zmul y (the (Nat × Nat) (suc (fst hx) , zero))) (zmul x y)
        (zeq-of-path (zmul (the (Nat × Nat) (suc (fst hx) , zero)) y) (zmul y (the (Nat × Nat) (suc (fst hx) , zero))) (zmul-comm (the (Nat × Nat) (suc (fst hx) , zero)) y))
        (zeq-trans (zmul y (the (Nat × Nat) (suc (fst hx) , zero))) (zmul y x) (zmul x y)
           (zmul-zeq-r y (the (Nat × Nat) (suc (fst hx) , zero)) x (zeq-sym x (the (Nat × Nat) (suc (fst hx) , zero)) (zpos-eq x hx)))
           (zeq-of-path (zmul y x) (zmul x y) (zmul-comm y x)))))
  (le-one-suc (plus (plus (fst hy) (times (fst hx) (suc (fst hy)))) zero))
