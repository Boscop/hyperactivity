nk-unshift0 : Word → NkTm → NkTm
nk-unshift0 d (nk-var j) = if %wlt j d then nk-var j else (if %weq j d then nk-fail else nk-var (%wsub j #1))
nk-unshift0 d (nk-lam b) = nk-lam (nk-unshift0 (%wsucc d) b)
nk-unshift0 d (nk-susp b) = nk-susp (nk-unshift0 d b)
nk-unshift0 d (nk-con c as) = nk-con c (nk-unshift0 d as)
nk-unshift0 d (nk-op h p as) = nk-op h (nk-unshift0 d p) (nk-unshift0 d as)
nk-unshift0 d (nk-match h p cs) = nk-match h (nk-unshift0 d p) (nk-unshift0 d cs)
nk-unshift0 d (nk-cons t r) = nk-cons (nk-unshift0 d t) (nk-unshift0 d r)
nk-unshift0 d t = t
