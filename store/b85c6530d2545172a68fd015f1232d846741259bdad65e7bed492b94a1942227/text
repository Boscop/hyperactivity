nk-clear?-at : (b : Bool) (u k : NkW) (c : NkCh) (r : NkFx) → (nk-weq u k ≡ b) → ((if b then false else nk-clear? u r) ≡ true) → ((nk-clear? u r ≡ true) → nk-apart u r) → nk-apart u (nkf-at k c r)
nk-clear?-at true u k c r p h ih = nk-no h
nk-clear?-at false u k c r p h ih = (p , (nk-weq-sym-f u k p , ih h))
