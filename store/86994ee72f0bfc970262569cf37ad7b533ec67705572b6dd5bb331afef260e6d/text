-- Func 3: fiber_and(x=0, y=1) -> i32 (exact branchless hs-fiber-and)
pw-f3 : List Word
pw-f3 =
  let xAny = pw-bin #71 (pw-bin #113 (pw-get #0) (pw-c #15)) (pw-c #0)
      yAny = pw-bin #71 (pw-bin #113 (pw-get #1) (pw-c #15)) (pw-c #0)
      z0   = pw-or4 (pw-and2 (pw-bit #0 #0) yAny) (pw-and2 (pw-bit #1 #0) xAny)
                    (pw-and2 (pw-bit #0 #1) (pw-bit #1 #2)) (pw-and2 (pw-bit #0 #2) (pw-bit #1 #1))
      z1   = pw-bin #114 (pw-and2 (pw-bit #0 #1) (pw-bin #114 (pw-bit #1 #1) (pw-bit #1 #3)))
                         (pw-and2 (pw-bit #0 #3) (pw-bit #1 #1))
      z2   = pw-bin #114 (pw-and2 (pw-bit #0 #2) (pw-bin #114 (pw-bit #1 #2) (pw-bit #1 #3)))
                         (pw-and2 (pw-bit #0 #3) (pw-bit #1 #2))
      z3   = pw-and2 (pw-bit #0 #3) (pw-bit #1 #3)
  in pw-cat (cons (cons #0 nil)
            (cons (pw-or4 z0 (pw-bin #116 z1 (pw-c #1)) (pw-bin #116 z2 (pw-c #2)) (pw-bin #116 z3 (pw-c #3)))
            (cons (pw-op #11) nil)))
