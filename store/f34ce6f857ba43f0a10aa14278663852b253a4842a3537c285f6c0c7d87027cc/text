-- the quotient by 256·P is the quotient by P, then by 256
quot-step : (V P : Word) → wlt #0 P ≡ true → wquot (wquot V P) #256 ≡ wquot V (wmul #256 P)
quot-step V P h0 =
  symw (catw (congw (λ z → wquot z (wmul #256 P)) (digit-split V P))
         (wdiv-unique (wquot (wquot V P) #256) (wadd (wmul (wrem (wquot V P) #256) P) (wrem V P)) (wmul #256 P)
           (lt-digit (wrem (wquot V P) #256) (wrem V P) P (wrem-lt (wquot V P) #256 refl) (wrem-lt V P h0))))
