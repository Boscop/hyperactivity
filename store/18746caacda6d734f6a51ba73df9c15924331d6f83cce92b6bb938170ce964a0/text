-- from a lower bound on the common prefix, the rest compared is the common prefix
k-skip : (k : Nat) → (p s : List (List Word)) → ltn (lcp p s) k ≡ false → k-skip-lcp k p s ≡ lcp p s
k-skip k =
  case k return λ w → (p s : List (List Word)) → ltn (lcp p s) w ≡ false → plus w (lcp (drop-n w p) (drop-n w s)) ≡ lcp p s of
    zero → λ p s h i → lcp p s
    suc k1 → k-skip-s k1 (rec k1)
