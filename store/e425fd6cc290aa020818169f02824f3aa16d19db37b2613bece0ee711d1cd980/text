h-publish-one : List Word → List Word → List Word → List Word → List Word → Proc W Bool
h-publish-one st srv tok m path = bind (h-read (h-before-of st path)) (λ w → bind (h-pointer path) (λ now →
  if h-eq (h-pointer-or w) now then bind (h-unlink (h-before-of st path)) (λ u → ret {lzero} {W} true)
  else bind (h-source-text path) (h-publish-text st srv tok m path (h-pointer-or w))))
