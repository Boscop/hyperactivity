cm-isSetBool : isSet Bool
cm-isSetBool =
  Discrete→isSet {Bool}
    (λ a b → case a return (λ x → Dec (x ≡ b)) of
       true → (case b return (λ y → Dec (true ≡ y)) of
                 true → yes (λ i → true)
                 false → no true≢false)
       false → (case b return (λ y → Dec (false ≡ y)) of
                  true → no (λ p → true≢false (cm-symb p))
                  false → yes (λ i → false)))
