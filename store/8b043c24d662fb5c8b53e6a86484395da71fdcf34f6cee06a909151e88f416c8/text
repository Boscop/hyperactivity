-- a + t = 0 and t + b = 0 give a = b
sy-cancel : (A : Type) → (z : A) → (ad mu : A → A → A) → sy-RL A z ad mu → (a t b : A) → ad a t ≡ z → ad t b ≡ z → a ≡ b
sy-cancel A z ad mu L a t b e1 e2 = sy-tr5 A a (ad a z) (ad a (ad t b)) (ad (ad a t) b) (ad z b) b
  (λ i → fst (snd L) a (~ i)) (λ i → ad a (e2 (~ i))) (λ i → snd (snd (snd (snd L))) a t b (~ i)) (λ i → ad (e1 i) b) (fst (snd (snd L)) b)
