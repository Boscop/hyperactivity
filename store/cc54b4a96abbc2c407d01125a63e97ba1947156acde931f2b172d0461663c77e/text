-- check_linear_memory_access: from memory_accessors.sail (it calls what is defined after it there)
-- (part of language-support)
check_linear_memory_access : (proc_mode' : proc_mode) → (addr_size : ZI) → (nbytes : ZI) → (lin_addr : Bits #64) → (base_reg : Option ZI) → (seg_reg : ZI) → (access_kind : Text) → (check_alignment? : Bool) → (mem_ptr? : Bool) → MF Unit
check_linear_memory_access proc_mode' addr_size nbytes lin_addr base_reg seg_reg access_kind check_alignment? mem_ptr? =
  let k'5 : Bool → MF Unit
      k'5 =
        λ t'2 →
          if (b-not t'2) then
            (x86_fault {Unit} #366163589934646530478908460796221172663815143935466889630547)
          else
            (retF {Unit} unit)
  in if (b-not check_alignment?) then
       (k'5 true)
     else
       (bindF {Bool} {Unit} (address_aligned_p (bv-trunc #64 #48 lin_addr) nbytes mem_ptr?) (λ t'1 →
          k'5 t'1))
