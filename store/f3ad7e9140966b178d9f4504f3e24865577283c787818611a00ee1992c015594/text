cs-bind-fields-con-sound : (hp0 : CsHeap) (tag : Word) (fs : Lst CsVal) (d : Word) (env : CsEnv) →
  let blk = lcons (csv-word tag) fs
  in cs-bind-fields (fst (cs-alloc hp0 blk)) (snd (cs-alloc hp0 blk)) d zero (cs-hlen CsVal fs) env
     ≡ some (cs-bind-params d fs env)
cs-bind-fields-con-sound hp0 tag fs d env =
  let blk = lcons (csv-word tag) fs
  in cs-bind-fields-from-loads (fst (cs-alloc hp0 blk)) (snd (cs-alloc hp0 blk)) fs d zero env
       (λ i → cs-alloc-load-self hp0 blk (suc i))
