diag-dd-pull : (sk : Lst Entry) (k : Word) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (c : Cube (dims sk) X) (d : DCube (dims sk) X Y c) (e : DCube (dims sk) X' (DL X' F') (dcube-map (dims sk) X Y X' f c d)) →
  DDPull (dims sk) (λ Z H G q → diag-dd sk k Z H G q) X X' Y F F' f g c d e
diag-dd-pull lnil k X X' Y F F' f g c d e = λ i → g c d (fst e)
diag-dd-pull (lcons (e-ty s) sk) k X X' Y F F' f g c d e =
  bool-elim1 (λ b → DDPull (dims sk) (λ Z H G q → bool-elim1 (λ b' → DCube (dims sk) Z H G) (dcube-fmap (dims sk) Z (DL Z H) H (λ x q' → fst q') G q) (diag-dd sk (%wsub k #1) Z H G q) b) X X' Y F F' f g c d e)
    (pull-sw (dims sk) X X' Y (DL X F) F (DL X' F') F' f (pdl X X' Y F F' f g) g (λ x q → fst q) (λ x q → fst q) (λ t x y z → g x y (fst z)) c d e)
    (diag-dd-pull sk (%wsub k #1) X X' Y F F' f g c d e) (weq k #0)
diag-dd-pull (lcons e-dim sk) k X X' Y F F' f g c d e =
  bool-elim1 (λ b → DDPull (suc (dims sk)) (λ Z H G q → bool-elim1 (λ b' → DCube (dims sk) (Line Z) (LineO Z H) G)
                     (dcube-fmap (dims sk) (Line Z) (LineO Z (DL Z H)) (LineO Z H) (λ L q' → diag-o Z H (line-map Z (Line Z) (degen-l Z) L) q') G q)
                     (diag-dd sk (%wsub k #1) (Line Z) (LineO Z H) G
                        (dcube-fmap (dims sk) (Line Z) (LineO Z (DL Z H)) (DL (Line Z) (LineO Z H)) (λ L q' → exch-o Z H (line-map Z (Line Z) (degen-l Z) L) q') G q)) b)
                   X X' Y F F' f g c d e)
    (pull-sw (dims sk) (Line X) (Line X') (LineO X Y) (LineO X (DL X F)) (LineO X F) (LineO X' (DL X' F')) (LineO X' F') (lineo-map X Y X' f)
       (lineo-pull X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g)) (lineo-pull X X' Y F F' f g)
       (λ L q → diag-o X F (line-map X (Line X) (degen-l X) L) q) (λ L q → diag-o X' F' (line-map X' (Line X') (degen-l X') L) q)
       (λ t L D z → lineo-pull X X' Y F F' f g L D (diag-o X' F' (line-map X' (Line X') (degen-l X') (lineo-map X Y X' f L D)) z)) c d e)
    (pcat (DCube (dims sk) (Line X) (LineO X F) c)
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F) c
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) c
             (dcube-pull (dims sk) (Line X) (Line X') (LineO X Y) (LineO X (DL X F)) (LineO X' (DL X' F')) (lineo-map X Y X' f) (lineo-pull X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g)) c d e)))
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F) c
          (dcube-pull (dims sk) (Line X) (Line X') (LineO X Y) (DL (Line X) (LineO X F)) (DL (Line X') (LineO X' F')) (lineo-map X Y X' f)
             (pdl (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g)) c d
             (dcube-fmap (dims sk) (Line X') (LineO X' (DL X' F')) (DL (Line X') (LineO X' F')) (λ L q → exch-o X' F' (line-map X' (Line X') (degen-l X') L) q) (dcube-map (dims sk) (Line X) (LineO X Y) (Line X') (lineo-map X Y X' f) c d) e)))
       (dcube-pull (dims sk) (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g) c d
          (diag-dd sk (%wsub k #1) (Line X') (LineO X' F') (dcube-map (dims sk) (Line X) (LineO X Y) (Line X') (lineo-map X Y X' f) c d)
             (dcube-fmap (dims sk) (Line X') (LineO X' (DL X' F')) (DL (Line X') (LineO X' F')) (λ L q → exch-o X' F' (line-map X' (Line X') (degen-l X') L) q) (dcube-map (dims sk) (Line X) (LineO X Y) (Line X') (lineo-map X Y X' f) c d) e)))
       (λ i → diag-dd sk (%wsub k #1) (Line X) (LineO X F) c
          (pull-sw (dims sk) (Line X) (Line X') (LineO X Y) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (LineO X' (DL X' F')) (DL (Line X') (LineO X' F')) (lineo-map X Y X' f)
             (lineo-pull X X' Y (DL X F) (DL X' F') f (pdl X X' Y F F' f g)) (pdl (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g))
             (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) (λ L q → exch-o X' F' (line-map X' (Line X') (degen-l X') L) q)
             (λ t L D z → pdl (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g) L D (exch-o X' F' (line-map X' (Line X') (degen-l X') (lineo-map X Y X' f L D)) z)) c d e i))
       (diag-dd-pull sk (%wsub k #1) (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g) c d
          (dcube-fmap (dims sk) (Line X') (LineO X' (DL X' F')) (DL (Line X') (LineO X' F')) (λ L q → exch-o X' F' (line-map X' (Line X') (degen-l X') L) q) (dcube-map (dims sk) (Line X) (LineO X Y) (Line X') (lineo-map X Y X' f) c d) e)))
    (weq k #0)
