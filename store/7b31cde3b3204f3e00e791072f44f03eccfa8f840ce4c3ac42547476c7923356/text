-- the negated interval holds the negated rational
iv-neg-sound : (S : List Bool) → (I : IV) → (X : Nat × Nat) → (q : Nat) → encl S I X q → encl S (iv-neg I) (snd X , fst X) q
iv-neg-sound S I X q e =
  (zle-path (snd (zsc (zv (snd I)) q) , fst (zsc (zv (snd I)) q)) (zsc (zv (bz-neg (snd I))) q) (snd (zsc X (bin-to-nat S)) , fst (zsc X (bin-to-nat S))) (zsc (snd X , fst X) (bin-to-nat S))
     (λ i → zsc (bz-neg-sound (fst (snd I)) (snd (snd I)) (~ i)) q) (λ i → zsc (snd X , fst X) (bin-to-nat S))
     (zle-swap (zsc (zv (snd I)) q) (zsc X (bin-to-nat S)) (snd e)) ,
   zle-path (snd (zsc X (bin-to-nat S)) , fst (zsc X (bin-to-nat S))) (zsc (snd X , fst X) (bin-to-nat S)) (snd (zsc (zv (fst I)) q) , fst (zsc (zv (fst I)) q)) (zsc (zv (bz-neg (fst I))) q)
     (λ i → zsc (snd X , fst X) (bin-to-nat S)) (λ i → zsc (bz-neg-sound (fst (fst I)) (snd (fst I)) (~ i)) q)
     (zle-swap (zsc X (bin-to-nat S)) (zsc (zv (fst I)) q) (fst e)))
