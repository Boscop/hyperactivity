hhf-scan : List (List Word × List Word) → Word → Word → Word → (Word → Word → Word → Step W Word) → Step W Word
hhf-scan nil mods chunks bytes k = k mods chunks bytes
hhf-scan (cons e r) mods chunks bytes k =
  let phex = fst e
      mh   = snd e
  in if cli-eq phex "names" then hhf-scan r mods chunks bytes k
     else scmd (w-file-read-named (list-append "store/" (list-append mh "/module"))) (λ rm →
          let mtxt = snd rm
              nc   = hhf-lines-count mtxt #0
          in hhf-scan r (%wsucc mods) (%wadd chunks nc) (%wadd bytes (cli-len mtxt)) k)
