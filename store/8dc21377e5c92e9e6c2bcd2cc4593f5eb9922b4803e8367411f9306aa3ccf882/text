-- unimported: the modules no module imports, as every finds them (the machine's own reading of imports).
hy-unimported-list : List Word → Proc W (List (List Word))
hy-unimported-list m = bind hy-every-files (λ fs → bind (h-capture (cons m (cons "--imports" fs))) (λ im →
  ret (h-msort (h-minus fs (h-msort (h-imported (h-lines (snd im))))))))
