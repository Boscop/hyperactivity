sta-eco-law : {O0 O1 O2 V : Type} → (d1 : O1 → Nat) → (d2 : O2 → Nat) → (env : V → Nat) → (extra : Nat) →
  MaintLaw {Nat × Circ O0 O1 O2 V} {Nat}
    (macro-sta {O0} d1 d2 env) (eco-add-buf {O0} {O1} {O2} {V} extra) (λ r s → plus extra r)
sta-eco-law {O0} d1 d2 env extra s =
  sym (plus-assoc extra (fst s) (fold (sta-late-alg {O0} d1 d2) env (snd s)))
