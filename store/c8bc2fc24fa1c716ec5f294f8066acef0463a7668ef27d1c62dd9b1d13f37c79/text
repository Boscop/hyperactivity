-- two wires drawn from disjoint bounded sets or disjoint fresh intervals [n1, m1) and [n2, m2) (m1 <= n2) are distinct
nk-set-disj-neq-at : (b1 b2 : Bool) (al1 al2 : NkEnv) (n1 m1 n2 m2 w k : NkW) →
  (nk-ebound al1 n1 ≡ true) → (nk-ebound al2 n1 ≡ true) → (nk-edisj al1 al2 ≡ true) →
  (nk-wire-le n1 m1 ≡ true) → (nk-wire-le m1 n2 ≡ true) →
  (nk-emem w al1 ≡ b1) → (nk-emem k al2 ≡ b2) →
  ((if b1 then true else nk-in-range n1 m1 w) ≡ true) →
  ((if b2 then true else nk-in-range n2 m2 k) ≡ true) →
  nk-weq w k ≡ false
nk-set-disj-neq-at true true al1 al2 n1 m1 n2 m2 w k bnd1 bnd2 dj p12 pm mw mk hw hk =
  nk-edisj-neq w k al1 al2 dj mw mk
nk-set-disj-neq-at true false al1 al2 n1 m1 n2 m2 w k bnd1 bnd2 dj p12 pm mw mk hw hk =
  nk-lt-range-neq w n2 m2 k (nk-wire-lt-wle-trans w n1 n2 (nk-emem-bound w al1 n1 mw bnd1) (nk-wire-le-trans n1 m1 n2 p12 pm)) hk
nk-set-disj-neq-at false true al1 al2 n1 m1 n2 m2 w k bnd1 bnd2 dj p12 pm mw mk hw hk =
  nk-wgt-neq k w (nk-wire-lt-wle-trans k n1 w (nk-emem-bound k al2 n1 mk bnd2) (nk-and-l (nk-wire-le n1 w) (nk-wire-lt w m1) hw))
nk-set-disj-neq-at false false al1 al2 n1 m1 n2 m2 w k bnd1 bnd2 dj p12 pm mw mk hw hk =
  nk-ranges-disj n1 m1 n2 m2 w k pm hw hk
