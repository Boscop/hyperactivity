nk-wop-hd : Word → Word → Word → NkHd
nk-wop-hd op a b =
  if %weq op #0 then hd-con (if %weq a b then #1024 else #1025)
  else if %weq op #1 then hd-con (if %wlt a b then #1024 else #1025)
  else if %weq op #2 then hd-num (%wadd a b)
  else if %weq op #3 then hd-num (%wmax a b)
  else if %weq op #4 then hd-num (%wsub a b)
  else if %weq op #5 then hd-num (%wmul a b)
  else if %weq op #6 then hd-num (if %weq b #0 then #0 else %wdiv a b)
  else if %weq op #7 then hd-num (if %weq b #0 then #0 else %wmod a b)
  else if %weq op #8 then hd-num (%wand a b)
  else if %weq op #9 then hd-num (%wor a b)
  else if %weq op #10 then hd-num (%wxor a b)
  else if %weq op #11 then hd-num (%wshl a b)
  else hd-num (%wshr a b)
