wkM : (Γ : CCtx) (a : TyShape) (Y : Type 1) (f : (γ : CtxV (fst Γ)) → (EnvV (fst Γ) γ → Y) → EnvV (fst Γ) γ → Sem a) (M : Mean Γ Y)
  (Z : Type 1) → Mean Γ Z → Mean (extM Γ a Y f M) Z
wkM Γ a Y f M Z N =
  dcube-push (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y) (FbE (fst Γ) Z) (FbE (lcons (e-ty a) (fst Γ)) Z)
    (λ γ e → (γ , f γ e)) (λ γ e N' ρ → N' (fst ρ)) (snd Γ) M N
