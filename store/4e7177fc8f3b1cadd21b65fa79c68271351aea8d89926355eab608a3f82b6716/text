-- halving b + 2A gives A with low bit b
half-of : (b : Bool) → (A : Nat) → bhalf (plus (bitn b) (times 2 A)) ≡ (A , b)
half-of b A = case A return λ m → bhalf (plus (bitn b) (times 2 m)) ≡ (m , b) of
  zero → bhalf-zero b
  suc a → transNB (bhalf-gen (plus (bitn b) (times 2 (suc a))) (plus (bitn b) (times 2 a)) (dbl-suc b a)) (transNB (λ i → bhalf-step (bhalf-step (rec a i))) (bhalf2 a b))
