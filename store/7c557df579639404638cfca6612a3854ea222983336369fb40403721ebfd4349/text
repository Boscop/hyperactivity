dot-onehot : (n : Nat) → (v : SumFin n) → (dy : Nat) → (dx : SumFin n → Nat) →
  fin-dot n (one-hot n v dy) dx ≡ times dy (dx v)
dot-onehot n =
  case n return (λ m → (v : SumFin m) → (dy : Nat) → (dx : SumFin m → Nat) →
    fin-dot m (one-hot m v dy) dx ≡ times dy (dx v)) of
    zero → λ v dy dx → Empty-rec v
    suc m → λ v dy dx →
      case v return (λ u → fin-dot (suc m) (one-hot (suc m) u dy) dx ≡ times dy (dx u)) of
        inl u →
          (case u return (λ z → fin-dot (suc m) (one-hot (suc m) (inl z) dy) dx ≡ times dy (dx (inl z))) of
             unit → transN (congN (plus (times dy (dx (inl unit)))) (dot-zero m (λ v2 → dx (inr v2))))
                      (plus0r (times dy (dx (inl unit)))))
        inr v2 → rec m v2 dy (λ v3 → dx (inr v3))
