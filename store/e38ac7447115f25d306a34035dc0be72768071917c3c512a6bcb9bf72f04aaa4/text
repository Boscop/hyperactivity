c-ready : Proc W Unit
c-ready = bind (c-exists c-record) (λ have → if have then ret {lzero} {W} unit else
  bind (h-mkdir "build") (λ u → bind (h-mkdir "build/chat") (λ v →
  bind (h-list "store/modules") (λ ms → bind (c-docs ms) (λ ds →
  bind (h-write "build/chat/docs" (h-concat (list-map h-line ds))) (λ w →
  bind (c-sh c-record-cmd) (λ r → if weq r #0 then ret {lzero} {W} unit else h-fail "chat: the record could not be made")))))))
