-- the minimal polynomials among the terms whose roots the candidates do not all cover
p-uncovered : List PCand → List STerm → List (List SQ)
p-uncovered cs ts = case ts of
  nil → nil
  cons t rest → (if eqb (p-cand-count (fst (fst (snd t))) cs) (m-deg (fst (fst (snd t)))) then (if eqb (p-cand-count (fst (fst (snd (snd t)))) cs) (m-deg (fst (fst (snd (snd t))))) then p-uncovered cs rest else cons (fst (fst (snd (snd t)))) (p-uncovered cs rest)) else cons (fst (fst (snd t))) (p-uncovered cs rest))
