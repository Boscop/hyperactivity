chem-born-desolvation-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-born-desolvation-poly A ad mu q vs =
  (λ g sub →
    let kc = g 0; epsW = g 1; chg = g 2; rExp = g 3; rBur = g 4
        q1 = q (fn-q 1 1)
        pref = mu (mu kc (mu chg chg)) (sub epsW q1)
        lhs = mu pref (sub rBur rExp)
        rhs = sub (mu pref rBur) (mu pref rExp)
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
