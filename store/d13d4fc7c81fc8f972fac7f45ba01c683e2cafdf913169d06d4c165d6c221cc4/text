-- Theorem (cs-eval-mono): whenever C11 evaluation of any CsExp expression succeeds with (hp', v),
-- every block and slot already allocated in hp remains valid with identical value in hp'
cs-eval-mono : (k : Nat) (fns : CsFns) (hp hp' : CsHeap) (env : CsEnv) (e : CsExp) (v : CsVal) →
  (cs-eval k fns hp env e ≡ cso-ok hp' v) → cs-heap-ext hp hp'
cs-eval-mono k fns hp hp' env e v h =
  comp (λ i → cs-res-mono hp (h i)) (λ i → []) (cs-eval-mono-res k fns hp env e)
