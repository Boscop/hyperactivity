cs-for-loop-mono : (ev : CsHeap → CsEnv → CsExp → CsRes) →
  ((hp1 : CsHeap) (env1 : CsEnv) (e : CsExp) → cs-res-mono hp1 (ev hp1 env1 e)) →
  (rem : Nat) (idx d : Word) (hp : CsHeap) (acc : CsVal) (env : CsEnv) (step : CsExp) →
  cs-res-mono hp (cs-for-loop ev rem idx d hp acc env step)
cs-for-loop-mono ev hev zero idx d hp acc env step = cs-heap-ext-refl hp
cs-for-loop-mono ev hev (suc rem) idx d hp acc env step =
  cs-bind-res-mono hp
    (ev hp (cs-env-push (%wsucc d) acc (cs-env-push d (csv-word idx) env)) step)
    (λ hp1 acc1 → cs-for-loop ev rem (%wsucc idx) d hp1 acc1 env step)
    (hev hp (cs-env-push (%wsucc d) acc (cs-env-push d (csv-word idx) env)) step)
    (λ hp1 acc1 → cs-for-loop-mono ev hev rem (%wsucc idx) d hp1 acc1 env step)
