mterm-dec-sym : Nat → List Word → MTerm × List Word
mterm-dec-sym zero ws = (mempty , ws)
mterm-dec-sym (suc fuel) nil = (mempty , nil)
mterm-dec-sym (suc fuel) (cons w rest) =
  if wlt w #4 then (mref w , rest)
  else if weq w #4 then
    (case rest of nil → (mref #0 , nil); cons k r → (mref k , r))
  else if weq w #5 then
    (case rest of
       nil → (mempty , nil)
       cons tid r → let p = mterm-dec-sym fuel r in (mapp tid (fst p) , snd p))
  else if weq w #6 then (mempty , rest)
  else if weq w #7 then
    let p1 = mterm-dec-sym fuel rest
        p2 = mterm-dec-sym fuel (snd p1)
    in (mcat (fst p1) (fst p2) , snd p2)
  else (mlit (wsub w #8) , rest)
