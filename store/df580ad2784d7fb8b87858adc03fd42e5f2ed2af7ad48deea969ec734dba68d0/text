-- is the exact address taken by a socket of the table
k-bound : SockAddr → List (Word × KObj) → Bool
k-bound d nil = false
k-bound d (cons e r) =
  case snd e of
    k-pipe-in q → k-bound d r
    k-pipe-out w → k-bound d r
    k-udp b → (case b of inl a → (if k-addr-eq a d then true else k-bound d r); inr u → k-bound d r)
    k-epoll l → k-bound d r
