psc-soc-sv : List Word
psc-soc-sv =
  (psc-ln "// hx_psc1_soc.sv — Single-Source 4-Plane Personal Supercomputer #1 (PSC-1) SoC"
  (psc-ln "// Generated from lib/hx-psc.hypercubical (0 postulates, kernel-checked)"
  (psc-ln "//   Plane 1: hx_psc1_bf16_unzip    (4-lane 1-cycle 48b->64b lossless BF16 = 1.333x wire BW)"
  (psc-ln "//   Plane 2: hx_psc1_bf16_mul_fp32 (EXACT IEEE-754 BF16xBF16->FP32, 0 rounding error!)"
  (psc-ln "//   Plane 3: hx_psc1_fiber_unit    (4-lane 1-cycle uint4 (L:XOR, Q:AND) symbolic fiber ALU)"
  (psc-ln "//   Plane 4: hx_rv32i_alu          (10-op 9-NAND2/bit 32-bit RV32I ALU from CircuitIR)"
  (psc-ln ""
  (psc-ln "module hx_psc1_bf16_unzip ("
  (psc-ln "  input  logic [47:0]  pkt_in,"
  (psc-ln "  input  logic [119:0] pal_exp,"
  (psc-ln "  input  logic [31:0]  esc_exp,"
  (psc-ln "  output logic [63:0]  bf16_out"
  (psc-ln ");"
  (psc-ln "  genvar i;"
  (psc-ln "  generate"
  (psc-ln "    for (i = 0; i < 4; i = i + 1) begin : lane"
  (psc-ln "      wire [7:0] sm_i  = pkt_in[i*8 +: 8];"
  (psc-ln "      wire [3:0] idx_i = pkt_in[32 + i*4 +: 4];"
  (psc-ln "      wire [7:0] esc_i = esc_exp[i*8 +: 8];"
  (psc-ln "      wire [7:0] exp_i = (idx_i == 4'hF) ? esc_i : pal_exp[idx_i*8 +: 8];"
  (psc-ln "      assign bf16_out[i*16 +: 16] = {sm_i[7], exp_i, sm_i[6:0]};"
  (psc-ln "    end"
  (psc-ln "  endgenerate"
  (psc-ln "endmodule"
  (psc-ln ""
  (psc-ln "module hx_psc1_bf16_mul_fp32 ("
  (psc-ln "  input  logic [15:0] a,"
  (psc-ln "  input  logic [15:0] b,"
  (psc-ln "  output logic [31:0] fp32_out"
  (psc-ln ");"
  (psc-ln "  wire        sr   = a[15] ^ b[15];"
  (psc-ln "  wire [7:0]  ea   = a[14:7];"
  (psc-ln "  wire [7:0]  eb   = b[14:7];"
  (psc-ln "  wire [6:0]  ma   = a[6:0];"
  (psc-ln "  wire [6:0]  mb   = b[6:0];"
  (psc-ln "  wire        infA = (ea == 8'hFF), infB = (eb == 8'hFF);"
  (psc-ln "  wire        zerA = (ea == 8'h00), zerB = (eb == 8'h00);"
  (psc-ln "  wire        nanR = (infA && (ma != 0)) || (infB && (mb != 0)) || ((infA || infB) && (zerA || zerB));"
  (psc-ln "  wire [15:0] prod = {1'b1, ma} * {1'b1, mb};"
  (psc-ln "  wire        norm = prod[15];"
  (psc-ln "  wire [9:0]  rawE = {2'd0, ea} + {2'd0, eb} + {9'd0, norm};"
  (psc-ln "  wire [7:0]  er   = rawE[7:0] - 8'd127;"
  (psc-ln "  wire [22:0] mr   = norm ? {prod[14:0], 8'd0} : {prod[13:0], 9'd0};"
  (psc-ln "  always_comb begin"
  (psc-ln "    if (infA || infB)      fp32_out = nanR ? 32'h7FC00000 : {sr, 8'hFF, 23'd0};"
  (psc-ln "    else if (zerA || zerB) fp32_out = {sr, 31'd0};"
  (psc-ln "    else if (rawE < 10'd128) fp32_out = {sr, 31'd0};"
  (psc-ln "    else if (rawE > 10'd381) fp32_out = {sr, 8'hFF, 23'd0};"
  (psc-ln "    else                   fp32_out = {sr, er, mr};"
  (psc-ln "  end"
  (psc-ln "endmodule"
  (psc-ln ""
  (psc-ln "module hx_psc1_fiber_unit ("
  (psc-ln "  input  logic        op_and,  // 0 = L:XOR fiber, 1 = Q:AND fiber"
  (psc-ln "  input  logic [15:0] a_vec,   // 4 x uint4 signed-bit fiber masks"
  (psc-ln "  input  logic [15:0] b_vec,"
  (psc-ln "  output logic [15:0] y_vec"
  (psc-ln ");"
  (psc-ln "  genvar i;"
  (psc-ln "  generate"
  (psc-ln "    for (i = 0; i < 4; i = i + 1) begin : flane"
  (psc-ln "      wire [3:0] a = a_vec[i*4 +: 4];"
  (psc-ln "      wire [3:0] b = b_vec[i*4 +: 4];"
  (psc-ln "      wire [3:0] lx = { (a[0]&b[3])|(a[3]&b[0])|(a[1]&b[2])|(a[2]&b[1]),"
  (psc-ln "                        (a[0]&b[2])|(a[2]&b[0])|(a[1]&b[3])|(a[3]&b[1]),"
  (psc-ln "                        (a[0]&b[1])|(a[1]&b[0])|(a[2]&b[3])|(a[3]&b[2]),"
  (psc-ln "                        (a[0]&b[0])|(a[1]&b[1])|(a[2]&b[2])|(a[3]&b[3]) };"
  (psc-ln "      wire [3:0] qa = { (a[3]&b[3]),"
  (psc-ln "                        (a[2]&(b[2]|b[3]))|(a[3]&b[2]),"
  (psc-ln "                        (a[1]&(b[1]|b[3]))|(a[3]&b[1]),"
  (psc-ln "                        (a[0]&(|b))|(b[0]&(|a))|(a[1]&b[2])|(a[2]&b[1]) };"
  (psc-ln "      assign y_vec[i*4 +: 4] = op_and ? qa : lx;"
  (psc-ln "    end"
  (psc-ln "  endgenerate"
  (psc-ln "endmodule"
  (psc-ln ""
  (psc-ln "module hx_psc1_soc ("
  (psc-ln "  input  logic        clk, input logic rst_n,"
  (psc-ln "  input  logic [3:0]  alu_op, input logic [31:0] alu_a, input logic [31:0] alu_b, output logic [31:0] alu_y,"
  (psc-ln "  input  logic [47:0] pkt_w,  input logic [119:0] pal_exp, input logic [31:0] esc_exp,"
  (psc-ln "  input  logic [63:0] act_x,  output logic [127:0] fp32_prods,"
  (psc-ln "  input  logic        fib_op, input logic [15:0] fib_a, input logic [15:0] fib_b, output logic [15:0] fib_y"
  (psc-ln ");"
  (psc-ln "  wire [63:0] w_bf16;"
  (psc-ln "  hx_rv32i_alu u_ctrl_alu (.op(alu_op), .a(alu_a), .b(alu_b), .y(alu_y));"
  (psc-ln "  hx_psc1_bf16_unzip u_unzip (.pkt_in(pkt_w), .pal_exp(pal_exp), .esc_exp(esc_exp), .bf16_out(w_bf16));"
  (psc-ln "  genvar k;"
  (psc-ln "  generate"
  (psc-ln "    for (k = 0; k < 4; k = k + 1) begin : fma_lane"
  (psc-ln "      hx_psc1_bf16_mul_fp32 u_mul (.a(w_bf16[k*16 +: 16]), .b(act_x[k*16 +: 16]), .fp32_out(fp32_prods[k*32 +: 32]));"
  (psc-ln "    end"
  (psc-ln "  endgenerate"
  (psc-ln "  hx_psc1_fiber_unit u_fiber (.op_and(fib_op), .a_vec(fib_a), .b_vec(fib_b), .y_vec(fib_y));"
  (psc-ln "endmodule"
  (psc-ln ""
  (psc-ln "// TinyTapeout Sky130 / GF180 Shuttle Wrapper (ui_in[7:0], uio_in[7:0] -> uo_out[7:0])"
  (psc-ln "module tt_um_hx_psc1 ("
  (psc-ln "  input  logic [7:0] ui_in, output logic [7:0] uo_out,"
  (psc-ln "  input  logic [7:0] uio_in, output logic [7:0] uio_out, output logic [7:0] uio_oe,"
  (psc-ln "  input  logic ena, input logic clk, input logic rst_n"
  (psc-ln ");"
  (psc-ln "  wire [15:0] fy;"
  (psc-ln "  hx_psc1_fiber_unit u_tt_fib (.op_and(uio_in[0]), .a_vec({12'd0, ui_in[3:0]}), .b_vec({12'd0, ui_in[7:4]}), .y_vec(fy));"
  (psc-ln "  assign uo_out  = {4'd0, fy[3:0]};"
  (psc-ln "  assign uio_out = 8'd0;"
  (psc-ln "  assign uio_oe  = 8'd0;"
  (psc-ln "endmodule"
  (psc-ln "" cir-alu32-sv))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
