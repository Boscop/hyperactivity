-- THEOREM 3 (SATURATED MULTI-SM `SM_90a` PTX CONTAINS GRID CTAID + 32x `lop3.b32` PIPELINE BY `refl`):
ht-thm-saturated-ptx-valid :
  let ptx = ht-emit-saturated-sm90a-ptx
  in andB (h-infix ".target sm_90a" ptx)
     (andB (h-infix "%ctaid.x" ptx)
     (andB (h-infix "lop3.b32 %r4, %r4, %r5, %r6, 150;" ptx)
     (andB (h-infix "lop3.b32 %r5, %r5, %r6, %r7, 232;" ptx)
           (h-infix "lop3.b32 %r7, %r7, %r8, %r9, 32;" ptx)))) ≡ true
ht-thm-saturated-ptx-valid = refl
