-- b ≤ a (i.e. wlt a b = false) implies b + (a - b) = a
cm-add-sub-step : (n : Word) → ((b : Word) → ltw n b ≡ false → wadd b (subw n b) ≡ n) →
                  (b : Word) → ltw (%wsucc n) b ≡ false → wadd b (subw (%wsucc n) b) ≡ %wsucc n
cm-add-sub-step n ih b =
  %welimP (λ v → ltw (%wsucc n) v ≡ false → wadd v (subw (%wsucc n) v) ≡ %wsucc n) b
    (λ h → cm-wadd-zero-l (%wsucc n))
    (λ m g h → catw (cm-wadd-suc-l m (subw n m)) (congw (λ z → %wsucc z) (ih m h)))
