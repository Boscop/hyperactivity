-- Inductive simulation of cwelim C for-loops under Kripke heap monotonicity
cs-for-sem : (CsMVal → CsMVal → CsOptM) → Nat → Word → CsMVal → CsOptM
cs-for-sem step_m zero idx macc = csom-some macc
cs-for-sem step_m (suc rem) idx macc =
  cs-bind-om (step_m (cmv-word idx) macc) (λ macc1 → cs-for-sem step_m rem (%wsucc idx) macc1)
