cnot-symp-invol : (s : Symp2) → cnot-symp (cnot-symp s) ≡ s
cnot-symp-invol s =
  let x1 = fst s
      z1 = fst (snd s)
      x2 = fst (snd (snd s))
      z2 = snd (snd (snd s))
      pz = catB (b-xor2 (b-xor2 z1 z2) z2) (b-xor2 z2 (b-xor2 z2 z1)) z1
             (catB (b-xor2 (b-xor2 z1 z2) z2) (b-xor2 z2 (b-xor2 z1 z2)) (b-xor2 z2 (b-xor2 z2 z1))
               (b-xor2-comm (b-xor2 z1 z2) z2)
               (λ i → b-xor2 z2 (b-xor2-comm z1 z2 i)))
             (b-xor2-inv z2 z1)
      px = catB (b-xor2 (b-xor2 x2 x1) x1) (b-xor2 x1 (b-xor2 x1 x2)) x2
             (catB (b-xor2 (b-xor2 x2 x1) x1) (b-xor2 x1 (b-xor2 x2 x1)) (b-xor2 x1 (b-xor2 x1 x2))
               (b-xor2-comm (b-xor2 x2 x1) x1)
               (λ i → b-xor2 x1 (b-xor2-comm x2 x1 i)))
             (b-xor2-inv x1 x2)
  in λ i → (x1 , (pz i , (px i , z2)))
