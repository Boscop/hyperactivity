nk-split-cons-denotes : (rho rho1 : NkW → NkEv) (w : NkW) (r : NkEnv) (sp : NkSplit) →
  (rho1 w ≡ rho w) →
  (nk-ebound (nk-sa sp) (nk-n (nk-so sp)) ≡ true) →
  (nk-ebound (nk-sb sp) (nk-n (nk-so sp)) ≡ true) →
  (nk-env-ev rho1 (nk-sa sp) ≡ nk-env-ev rho r) →
  (nk-env-ev rho1 (nk-sb sp) ≡ nk-env-ev rho r) →
  (nk-env-ev (nk-rho-split-cons rho1 w sp) (nk-sa (nk-split-cons w sp)) ≡ nk-env-ev rho (nke-cons w r))
  × (nk-env-ev (nk-rho-split-cons rho1 w sp) (nk-sb (nk-split-cons w sp)) ≡ nk-env-ev rho (nke-cons w r))
nk-split-cons-denotes rho rho1 w r (nk-split-r a b (nk-out fx n ws)) hw ha hb iha ihb =
  let n1 = nk-s n
      val = rho1 w
      rho_n = nk-rho-set rho1 n val
      rho_n1 = nk-rho-set rho_n n1 val
      ha1 = nk-ebound-up n n1 a (nk-wire-le-s n) ha
      hb1 = nk-ebound-up n n1 b (nk-wire-le-s n) hb
      hd_a = nk-rho-set-other rho_n n1 n val (nk-wgt-neq n n1 (nk-wire-lt-s n))
             ∙ (nk-rho-set-same rho1 n val ∙ hw)
      tl_a = nk-env-ev-set-lt rho_n n1 val a ha1
             ∙ (nk-env-ev-set-lt rho1 n val a ha ∙ iha)
      hd_b = nk-rho-set-same rho_n n1 val ∙ hw
      tl_b = nk-env-ev-set-lt rho_n n1 val b hb1
             ∙ (nk-env-ev-set-lt rho1 n val b hb ∙ ihb)
      eq_a = cong (λ z → nkev-cons z (nk-env-ev rho_n1 a)) hd_a
             ∙ cong (λ z → nkev-cons (rho w) z) tl_a
      eq_b = cong (λ z → nkev-cons z (nk-env-ev rho_n1 b)) hd_b
             ∙ cong (λ z → nkev-cons (rho w) z) tl_b
  in (eq_a , eq_b)
