<style>
  :root {
    --bg: #ffffff;
    --fg: #000000;
    --muted: #444444;
    --dim: #767676;
    --rule: #e5e5e5;
    --rule-strong: #000000;
    --pink: #ff0a94;
    --pink-tint: rgba(255, 10, 148, 0.06);
    --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    --sans: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }
  html.dark {
    --bg: #000000;
    --fg: #ffffff;
    --muted: #b0b0b0;
    --dim: #787878;
    --rule: #222222;
    --rule-strong: #ffffff;
    --pink: #ff0a94;
    --pink-tint: rgba(255, 10, 148, 0.12);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 18px/1.6 var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }

  /* ICONIC MINIMAL HOT-PINK MONOSPACE SPLASH — PURE, UNCLUTTERED, UNMISTAKABLE */
  .splash {
    min-height: calc(100svh - 48px);
    background: #ff0a94;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(48px, 8vh, 96px) clamp(24px, 7vw, 96px);
    position: relative;
    font-family: var(--mono);
  }
  .splash-inner {
    max-width: 960px;
  }
  .splash h1 {
    font: 700 clamp(44px, 8.2vw, 128px)/0.95 var(--mono);
    letter-spacing: -0.045em;
    margin: 0;
    color: #ffffff;
  }
  .splash .sub {
    font: 400 clamp(17px, 2.2vw, 26px)/1.44 var(--mono);
    margin-top: 28px;
    max-width: 34ch;
    color: #ffffff;
  }
  .splash .who {
    margin-top: 24px;
    font: 400 13px/1.4 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
  }
  .splash-scroll {
    position: absolute;
    left: clamp(24px, 7vw, 96px);
    bottom: 28px;
    font: 400 12.5px/1 var(--mono);
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.88);
    border-bottom: 1px solid rgba(255, 255, 255, 0.45);
    padding-bottom: 3px;
    transition: border-color 0.12s, color 0.12s;
  }
  .splash-scroll:hover {
    color: #ffffff;
    border-color: #ffffff;
  }

  /* SWISS EDITORIAL COLUMN */
  .wrap {
    max-width: 780px;
    margin: 0 auto;
    padding: 56px 24px 96px;
  }
  .sec-label {
    font: 600 11.5px/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    margin: 56px 0 18px;
  }
  .sec-label:first-child { margin-top: 0; }

  /* THE MONOGRAPH FEATURE */
  .feature {
    display: block;
    padding: 20px 0 22px;
    border-top: 2px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule);
    transition: border-color 0.12s;
  }
  .feature:hover { border-top-color: var(--pink); }
  .feature .t {
    font: 700 clamp(26px, 3.6vw, 36px)/1.12 var(--mono);
    letter-spacing: -0.03em;
    color: var(--fg);
  }
  .feature:hover .t { color: var(--pink); }
  .feature .s {
    margin-top: 8px;
    font: 400 17px/1.48 var(--sans);
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }
  .act {
    display: inline-flex;
    align-items: center;
    font: 600 12.5px/1 var(--mono);
    padding: 9px 14px;
    border: 1px solid var(--rule-strong);
    color: var(--fg);
    background: transparent;
    transition: background 0.12s, color 0.12s, border-color 0.12s;
  }
  .act:hover {
    border-color: var(--pink);
    color: var(--pink);
  }
  .act.primary {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .act.primary:hover {
    background: var(--pink);
    border-color: var(--pink);
    color: #ffffff;
  }

  /* HYPERGRAPH DERIVATION SPINE (SEMANTIC, NOT STAT-FLEX) */
  .hg-intro {
    font: 400 16.5px/1.58 var(--sans);
    color: var(--muted);
    margin: 0 0 22px;
  }
  .hg-intro code {
    font: 400 14px var(--mono);
    color: var(--fg);
  }
  .hg-diagram {
    border: 1px solid var(--rule-strong);
    background: var(--bg);
    margin-bottom: 24px;
  }
  .hg-svg-wrap {
    width: 100%;
    overflow-x: auto;
    border-bottom: 1px solid var(--rule);
  }
  .hg-svg {
    display: block;
    width: 100%;
    min-width: 580px;
    height: auto;
  }
  .hg-edge {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1.5;
    transition: stroke 0.15s, stroke-width 0.15s;
  }
  .hg-edge.lit {
    stroke: var(--pink);
    stroke-width: 2.2;
  }
  .hg-node { cursor: pointer; }
  .hg-node rect {
    fill: var(--bg);
    stroke: var(--rule-strong);
    stroke-width: 1.25;
    transition: fill 0.12s, stroke 0.12s;
  }
  .hg-node text {
    font-family: var(--mono);
    fill: var(--fg);
    transition: fill 0.12s;
  }
  .hg-node .n-k { font-size: 9.5px; fill: var(--dim); letter-spacing: 0.08em; }
  .hg-node .n-t { font-size: 12px; font-weight: 700; }
  .hg-node:hover rect, .hg-node.on rect {
    stroke: var(--pink);
    fill: var(--pink-tint);
  }
  .hg-node.on rect {
    fill: #ff0a94;
    stroke: #ff0a94;
  }
  .hg-node.on text, .hg-node.on .n-k { fill: #ffffff; }
  .hg-node.dep rect { stroke: var(--pink); stroke-width: 1.6; }

  .hg-inspector {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .hg-ins-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .hg-ins-title {
    font: 700 15px/1.3 var(--mono);
    color: var(--fg);
  }
  .hg-ins-mod {
    font: 400 12px/1.3 var(--mono);
    color: var(--pink);
  }
  .hg-ins-desc {
    font: 400 15px/1.55 var(--sans);
    color: var(--muted);
    margin: 0;
  }
  .hg-ins-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 6px;
    font: 600 12px/1.3 var(--mono);
  }
  .hg-ins-deps { color: var(--dim); font-weight: 400; }
  .hg-ins-go {
    color: var(--pink);
    border-bottom: 1px solid var(--pink);
    padding-bottom: 1px;
  }

  /* CLEAN HAIRLINE LISTS */
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .list li {
    border-bottom: 1px solid var(--rule);
  }
  .list a {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 14px;
    padding: 15px 0;
    transition: color 0.12s;
  }
  .list a:hover .l-title { color: var(--pink); }
  .l-idx {
    font: 600 12px/1 var(--mono);
    color: var(--dim);
  }
  .list a:hover .l-idx { color: var(--pink); }
  .l-body { min-width: 0; }
  .l-title {
    display: block;
    font: 600 17px/1.3 var(--sans);
    color: var(--fg);
    transition: color 0.12s;
  }
  .l-desc {
    display: block;
    margin-top: 3px;
    font: 400 14.5px/1.48 var(--sans);
    color: var(--muted);
  }
  .l-path {
    font: 400 12px/1 var(--mono);
    color: var(--dim);
    white-space: nowrap;
  }
  .list a:hover .l-path { color: var(--pink); }

  /* SEARCH & ARCHIVE */
  .search-row {
    display: flex;
    gap: 10px;
    margin-top: 6px;
  }
  .search-row input {
    flex: 1;
    min-width: 0;
    font: 400 14px/1.2 var(--mono);
    padding: 10px 12px;
    border: 1px solid var(--rule-strong);
    background: var(--bg);
    color: var(--fg);
    outline: none;
  }
  .search-row input:focus { border-color: var(--pink); }
  .search-row button {
    font: 600 12.5px/1 var(--mono);
    padding: 10px 16px;
    border: 1px solid var(--rule-strong);
    background: var(--fg);
    color: var(--bg);
    cursor: pointer;
  }
  .search-row button:hover {
    background: var(--pink);
    border-color: var(--pink);
    color: #ffffff;
  }

  .foot {
    margin-top: 64px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font: 400 12.5px/1.5 var(--mono);
    color: var(--dim);
  }
  .foot a:hover { color: var(--pink); }

  @media (max-width: 640px) {
    .list a { grid-template-columns: 28px minmax(0, 1fr); }
    .l-path { display: none; }
    .wrap { padding: 40px 18px 72px; }
  }
</style>
