  var nodes = document.querySelectorAll('.hg-node');
  var edges = document.querySelectorAll('.hg-edge');
  var elTitle = document.getElementById('hgTitle');
  var elMod = document.getElementById('hgMod');
  var elDesc = document.getElementById('hgDesc');
  var elDeps = document.getElementById('hgDeps');
  var elLink = document.getElementById('hgLink');

  function select(id) {
    var d = NODES[id] || NODES.kernel;
    var litSet = {};
    d.lit.forEach(function(k) { litSet[k] = true; });
    nodes.forEach(function(n) {
      var nid = n.getAttribute('data-id');
      n.classList.toggle('on', nid === id);
      var connected = false;
      d.lit.forEach(function(k) {
        var ps = k.split(':');
        if (ps[0] === nid || ps[1] === nid) connected = true;
      });
      n.classList.toggle('dep', nid !== id && connected);
    });
    edges.forEach(function(e) {
      var k = e.getAttribute('data-from') + ':' + e.getAttribute('data-to');
      e.classList.toggle('lit', !!litSet[k]);
    });
    elTitle.textContent = d.title;
    elMod.textContent = d.mod;
    elDesc.textContent = d.desc;
    elDeps.textContent = d.deps;
    elLink.href = d.href;
    elLink.textContent = d.go;
  }

  nodes.forEach(function(n) {
    var id = n.getAttribute('data-id');
    var go = function(ev) {
      select(id);
      var d = NODES[id];
      if (!d || !d.href) return;
      if (ev && (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.button === 1)) return;
      if (n.closest && n.closest('a[href]')) return;
      window.location.href = d.href;
    };
    n.addEventListener('click', go);
    n.addEventListener('mouseenter', function() { select(id); });
    n.addEventListener('focus', function() { select(id); });
    n.addEventListener('keydown', function(ev) {
      if (ev.key === 'Enter' || ev.key === ' ') {
        ev.preventDefault();
        select(id);
        var d = NODES[id];
        if (d && d.href) window.location.href = d.href;
      }
    });
  });
  select('kernel');
})();
</script>
