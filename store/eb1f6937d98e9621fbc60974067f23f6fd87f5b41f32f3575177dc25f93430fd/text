-- the order of the entries this server holds, those it holds and has not ordered yet appended
s-log-all : List Word → Proc W (List (List Word))
s-log-all st = bind (h-list (list-append h-source "/entries")) (λ ids → bind (s-log-new st ids) (λ new →
  bind (h-mkdir (list-append st "/logged")) (λ u → bind (h-read (list-append st "/source-log")) (λ l →
  bind (h-write (list-append st "/source-log") (list-append (s-or nil l) (h-concat (list-map h-line new)))) (λ w →
  bind (s-mark st new) (λ u2 → ret (list-append (h-lines (s-or nil l)) new)))))))
