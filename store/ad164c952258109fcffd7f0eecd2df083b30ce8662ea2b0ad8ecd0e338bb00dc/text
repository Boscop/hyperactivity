-- the H–H contacts of sequence s in a labelling
sp-hh : Nat → Nat × (Nat × (Nat × Nat)) → Nat
sp-hh s v = plus (plus (if sl-bit s 0 then (if sl-bit s 3 then fst v else 0) else 0) (if sl-bit s 0 then (if sl-bit s 5 then fst (snd v) else 0) else 0))
  (plus (if sl-bit s 1 then (if sl-bit s 4 then fst (snd (snd v)) else 0) else 0) (if sl-bit s 2 then (if sl-bit s 5 then snd (snd (snd v)) else 0) else 0))
