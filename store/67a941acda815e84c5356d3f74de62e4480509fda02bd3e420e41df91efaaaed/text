-- the index's bytes: the root's place and the depth (four bytes each), the table from 8, the records, the tree
si-make : List (List Word) → List Word
si-make T = si-w4 (wadd (si-o0 T) (si-recs-size T)) (si-w4 (fromNat (si-depth (si-tree T)))
  (si-w-tab T (si-o0 T) (si-w-recs T (si-w-tree (si-tree T) (wadd (si-o0 T) (si-recs-size T)) nil))))
