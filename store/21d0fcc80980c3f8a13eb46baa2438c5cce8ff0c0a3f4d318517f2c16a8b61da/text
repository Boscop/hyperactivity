-- store_bytes_to_ea: from memory_accessors.sail (it calls what is defined after it there)
-- (part of language-support)
store_bytes_to_ea : (proc_mode' : proc_mode) → (addr_size : ZI) → (nbytes : ZI) → (eff_addr : Bits #64) → (base_reg : Option ZI) → (seg_reg : ZI) → (data' : Bits (wmul #8 (z-nat nbytes))) → (check_alignment? : Bool) → (mem_ptr? : Bool) → MS Unit
store_bytes_to_ea proc_mode' addr_size nbytes eff_addr base_reg seg_reg data' check_alignment? mem_ptr? =
  bindS {List (Bits #16)} {Unit} (getS {List (Bits #16)} x86-seg_hidden_attrs) (λ seg_hidden_attrs'1 →
    let seg_attrs : data_segment_descriptor_attributesbits
        seg_attrs = (vec-get {Bits #16} #0 seg_hidden_attrs'1 (z-nat seg_reg))
    in λ σ →
         if (b-and (b-not (in_64bit_mode proc_mode')) (b-or (z-eq seg_reg (zpos #1)) (weq (data_segment_descriptor_attributesbits-w seg_attrs) #0))) then
           the (MS Unit)
             (liftS {Unit} (x86_fault {Unit} #85214164814374391937940507063768957460581066296916)) σ
         else
           the (MS Unit)
             (bindS {Bits #64} {Unit} (ea_to_la proc_mode' eff_addr seg_reg nbytes) (λ lin_addr →
                onS {Unit} {Unit} (check_linear_memory_access proc_mode' addr_size nbytes lin_addr base_reg seg_reg #14935 check_alignment? mem_ptr?) (λ t'4 →
                  wb #64 nbytes lin_addr #14935 data'))) σ)
