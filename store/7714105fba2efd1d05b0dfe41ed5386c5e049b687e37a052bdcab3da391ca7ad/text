cs-call-fn-mono : (ev : CsHeap → CsEnv → CsExp → CsRes) →
  ((hp1 : CsHeap) (env1 : CsEnv) (e : CsExp) → cs-res-mono hp1 (ev hp1 env1 e)) →
  (fns : CsFns) (hp : CsHeap) (fn : Word) (vs : Lst CsVal) →
  cs-res-mono hp (cs-call-fn ev fns hp fn vs)
cs-call-fn-mono ev hev fns hp fn vs =
  cs-opt-res-mono hp (cs-find-fn fns fn)
    (λ entry → if %weq (fst entry) (l-count vs) then ev hp (cs-bind-params #0 vs lnil) (snd entry) else cso-ub)
    (λ entry → cs-ite-res-mono (%weq (fst entry) (l-count vs)) hp
      (ev hp (cs-bind-params #0 vs lnil) (snd entry)) cso-ub
      (hev hp (cs-bind-params #0 vs lnil) (snd entry)) unit)
