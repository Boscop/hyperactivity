bfm-andB false b = false

bfm-iteB : Bool → Bool → Bool → Bool
bfm-iteB true  t f = t
bfm-iteB false t f = f

bfm-eqB : Bool → Bool → Bool
bfm-eqB true  true  = true
bfm-eqB false false = true
bfm-eqB true  false = false
bfm-eqB false true  = false

bfm-eq-nat : Nat → Nat → Bool
bfm-eq-nat zero    zero    = true
bfm-eq-nat zero    (suc j) = false
bfm-eq-nat (suc i) zero    = false
bfm-eq-nat (suc i) (suc j) = bfm-eq-nat i j

bfm-eq-nat-sound : (i j : Nat) → bfm-eq-nat i j ≡ true → i ≡ j
bfm-eq-nat-sound zero    zero    h = refl
bfm-eq-nat-sound zero    (suc j) h = bfm-false-absurd h
bfm-eq-nat-sound (suc i) zero    h = bfm-false-absurd h
bfm-eq-nat-sound (suc i) (suc j) h = λ k → suc (bfm-eq-nat-sound i j h k)

