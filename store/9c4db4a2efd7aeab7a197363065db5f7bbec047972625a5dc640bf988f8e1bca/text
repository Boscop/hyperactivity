bfm-trans : {A : Type} → {x y z : A} → x ≡ y → y ≡ z → x ≡ z
bfm-trans {A} {x} p q = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

bfm-sym : {A : Type} → {x y : A} → x ≡ y → y ≡ x
bfm-sym {A} {x} p = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ p j , i = 1 ↦ x ]) x

bfm-false-absurd : {A : Type} → false ≡ true → A
bfm-false-absurd {A} h = transport (λ i → if h i then A else Unit) unit

bfm-false-neq-true : false ≡ true → Empty
bfm-false-neq-true h = bfm-false-absurd {Empty} h

bfm-exfalso : {A : Type} → false ≡ true → A
bfm-exfalso {A} h = bfm-false-absurd {A} h

bfm-notB : Bool → Bool
bfm-notB true  = false
bfm-notB false = true

bfm-andB : Bool → Bool → Bool
