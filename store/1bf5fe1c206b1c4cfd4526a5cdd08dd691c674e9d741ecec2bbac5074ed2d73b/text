-- the paper's markdown as a page reads it: its front matter (between the first two "---" lines) and its HTML
-- comments left out, and each heading's anchor ({#id}) dropped from the heading's words
s-unfront : List (List Word) → List (List Word)
s-unfront (cons l r) = if h-eq l "---" then s-after-front r else cons l r
s-unfront nil = nil
