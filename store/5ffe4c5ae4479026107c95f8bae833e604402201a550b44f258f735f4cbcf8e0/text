zle-mul-nonneg : (a b v : Nat × Nat) → zle (zero , zero) v → zle a b → zle (zmul a v) (zmul b v)
zle-mul-nonneg a b v hv h = zle-zeq-r (zmul a v) (zmul b (fst hv , zero)) (zmul b v)
  (zmul-zeq-r b (fst hv , zero) v (snd hv))
  (zle-zeq-l (zmul a (fst hv , zero)) (zmul a v) (zmul b (fst hv , zero))
    (zmul-zeq-r a (fst hv , zero) v (snd hv))
    (zle-mul-posk a b (fst hv) h))
