-- ---------------------------------------------------------------- the circle's multiplication
rotLoop : (a : S1) → a ≡ a
rotLoop a = case a return (λ y → PathP (λ (j : I) → S1) y y) of
    base → λ j → loop j
    loop i → λ j → comp (λ k → S1) (λ k → [ i = 0 ↦ loop (j \/ ~ k) , i = 1 ↦ loop (j /\ k) , j = 0 ↦ loop (i \/ ~ k) , j = 1 ↦ loop (i /\ k) ]) base
