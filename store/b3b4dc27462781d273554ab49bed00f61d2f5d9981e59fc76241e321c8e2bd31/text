fd-spec-branch : (keep : Nat → Bool) → (tag len : Nat) → (out : FdFrame) → (bad : Bool) →
  (if bad then (false , out)
   else (if keep tag then (true , (tag , len , fd-four)) else (false , out))) ≡
  fd-filter-post keep (if bad then (false , out) else (true , (tag , len , fd-four))) out
fd-spec-branch keep tag len out true = refl
fd-spec-branch keep tag len out false = refl
