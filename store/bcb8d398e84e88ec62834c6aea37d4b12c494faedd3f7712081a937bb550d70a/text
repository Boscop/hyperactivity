dm-eval-cone : Word → Word → Word → DmCone3 → Word
dm-eval-cone a b c dc-var0        = %wand a dm-mask64
dm-eval-cone a b c dc-var1        = %wand b dm-mask64
dm-eval-cone a b c dc-var2        = %wand c dm-mask64
dm-eval-cone a b c (dc-not x)     = dm-not64 (dm-eval-cone a b c x)
dm-eval-cone a b c (dc-and x y)   = %wand (dm-eval-cone a b c x) (dm-eval-cone a b c y)
dm-eval-cone a b c (dc-or x y)    = %wor  (dm-eval-cone a b c x) (dm-eval-cone a b c y)
dm-eval-cone a b c (dc-xor x y)   = %wxor (dm-eval-cone a b c x) (dm-eval-cone a b c y)
dm-eval-cone a b c (dc-mux s x y) =
  let sv = dm-eval-cone a b c s
  in %wor (%wand sv (dm-eval-cone a b c x)) (%wand (dm-not64 sv) (dm-eval-cone a b c y))
dm-eval-cone a b c (dc-ulop3 imm) = bn-lut3-w64 imm a b c
