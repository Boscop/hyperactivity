-- F's sign on top: below the root F < 0, above it F > 0, for every A in the bracket, every exact σ, c and every chain
cert-neg-sound : (S S2 : List Bool) → (sta gt str ce se : IE) → (R : IV) → (m : BZ) → (lh : IV) → (M N : Nat) → (rq : ZQ) →
  bcanon S ≡ true → le (suc zero) (bin-to-nat S) → bin-to-nat S2 ≡ times (bin-to-nat S) (bin-to-nat S) → inp S R rq →
  cert-neg S S2 sta gt str ce se R m lh M N ≡ true →
  cert-means S S2 sta gt str ce se R m lh M N rq ×
  ((aq sq cq : ZQ) → inp S lh aq → isval (env3q rq (zv m , bin-to-nat S) aq) se sq → isval (env3q rq (zv m , bin-to-nat S) aq) ce cq →
     (k : Nat) → (tv rv : ZQ) → uni S tv → le (suc zero) (snd tv) → echain (rad-envq (zv m , bin-to-nat S) sq cq) str (plus k N) tv rv →
     zpos (zsw (zsc (zplus (zsc (fst cq) (snd rv)) (zsc (zsw (fst rv)) (snd cq))) (bin-to-nat S))))
cert-neg-sound S S2 sta gt str ce se R m lh M N rq cS hS hS2 hR h =
  sign-neg S S2 sta gt str ce se R m lh M N rq
    (cert-core-sound S S2 sta gt str ce se R m lh M N rq cS hS hS2 hR (both-true-l (cert-core S S2 sta gt str ce se R m lh M N) (iv-neg-sure (fst (f-val-of S S2 str ce se R (m , m) lh N))) h))
    (both-true-r (cert-core S S2 sta gt str ce se R m lh M N) (iv-neg-sure (fst (f-val-of S S2 str ce se R (m , m) lh N))) h)
