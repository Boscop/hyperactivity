nk-dnf-of : NkHd → NkTm
nk-dnf-of (hd-con c) = if %weq c #11 then nk-cons nk-nil nk-nil else nk-nil
nk-dnf-of (hd-var x) = nk-cons (nk-cons (nk-num (%wmul x #4)) nk-nil) nk-nil
nk-dnf-of (hd-lvl l) = nk-cons (nk-cons (nk-num (%wadd (%wmul l #4) #2)) nk-nil) nk-nil
nk-dnf-of (hd-dnf d) = d
nk-dnf-of h = nk-nil
