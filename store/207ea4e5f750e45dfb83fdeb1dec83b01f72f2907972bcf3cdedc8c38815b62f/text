pillar-inner : Nat → Word → Word → SInt → SInt → SInt → SInt → SInt → SInt → SInt → List Pt2
pillar-inner zero n idx side cx cy W H T F = nil
pillar-inner (suc rem) n idx side cx cy W H T F =
  let u = si-sub (si-div-w (si-mul (sp #20000) (sp idx)) n) (sp #10000)
      u2 = fx-mul u u
      oneMu2 = si-sub (sp fx-S) u2
      xMid = si-add cx (si-mul side (si-sub W (fx-mul F oneMu2)))
      th = fx-mul T (si-add (sp #8600) (fx-mul (sp #1400) u2))
      px = si-add xMid th
      py = si-add cy (fx-mul H u)
  in cons (px , py) (pillar-inner rem n (%wsucc idx) side cx cy W H T F)
