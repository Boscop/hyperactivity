-- ============================================================================
-- SECTION 1: MACHINE-CHECKED BASE `8453` `USDC` `Transfer` LOG COLD VERIFIER
-- ============================================================================

x4-q : List Word
x4-q = cons #34 nil

x4-nl : List Word
x4-nl = cons #10 nil

x4-ln : List Word → List Word → List Word
x4-ln s rest = list-append s (cons #10 rest)

x4-qstr : List Word → List Word
x4-qstr s = list-append x4-q (list-append s x4-q)

x4-lower-ch : Word → Word
x4-lower-ch c = if andB (%wlt #64 c) (%wlt c #91) then %wadd c #32 else c

x4-lower : List Word → List Word
x4-lower nil = nil
x4-lower (cons c cs) = cons (x4-lower-ch c) (x4-lower cs)

x4-hex-nib : Word → Word
x4-hex-nib c =
  if andB (%wlt #47 c) (%wlt c #58) then %wsub c #48
  else if andB (%wlt #64 c) (%wlt c #71) then %wadd (%wsub c #65) #10
  else if andB (%wlt #96 c) (%wlt c #103) then %wadd (%wsub c #97) #10
  else #0

x4-is-hex-ch : Word → Bool
x4-is-hex-ch c =
  orB (andB (%wlt #47 c) (%wlt c #58))
      (orB (andB (%wlt #64 c) (%wlt c #71))
           (andB (%wlt #96 c) (%wlt c #103)))

x4-all-hex : List Word → Bool
x4-all-hex nil = true
x4-all-hex (cons c cs) = andB (x4-is-hex-ch c) (x4-all-hex cs)

x4-strip-0x : List Word → List Word
x4-strip-0x s =
  if h-prefix "0x" s then h-drop "0x" s
  else if h-prefix "0X" s then h-drop "0X" s
  else s

x4-hex-to-word-go : Word → List Word → Word
x4-hex-to-word-go acc nil = acc
x4-hex-to-word-go acc (cons c cs) = x4-hex-to-word-go (%wadd (%wshl acc #4) (x4-hex-nib c)) cs

x4-hex-to-word : List Word → Word
x4-hex-to-word s = x4-hex-to-word-go #0 (x4-strip-0x s)

x4-usdc-base-lc : List Word
x4-usdc-base-lc = "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913"

x4-founder-coinbase-eip55 : List Word
x4-founder-coinbase-eip55 = "0x4A50FBF0128E2679C42466A8cC1A9D230b08A26f"

x4-founder-topic32-lc : List Word
x4-founder-topic32-lc = "0x0000000000000000000000004a50fbf0128e2679c42466a8cc1a9d230b08a26f"

x4-transfer-topic0-lc : List Word
x4-transfer-topic0-lc = "0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef"

-- Exact cold-verification predicate for a single EVM receipt log:
-- Credits `paidU6` iff:
--   1. `statusOk == true` (`receipt.status == 0x1` on Base Mainnet `8453`),
--   2. `notReplayed == true` (`txHash` not yet in `/tmp/hx_x402_ledger/`),
--   3. `logAddr` is canonical Base native `USDC` (`0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913`),
--   4. `topic0` is ERC-20 `Transfer(address,address,uint256)` (`0xddf252ad...`),
--   5. `topic2` is Founder Coinbase (`0x0000000000000000000000004a50fbf0128e2679c42466a8cc1a9d230b08a26f`),
--   6. `paidU6 >= minU6`!
x4-verify-transfer-log : Bool → Bool → List Word → List Word → List Word → Word → Word → Word
x4-verify-transfer-log statusOk notReplayed logAddr topic0 topic2 paidU6 minU6 =
  let okAddr = h-eq (x4-lower logAddr) x4-usdc-base-lc
      okT0   = h-eq (x4-lower topic0)  x4-transfer-topic0-lc
      okT2   = h-eq (x4-lower topic2)  x4-founder-topic32-lc
      okAmt  = h-not (%wlt paidU6 minU6)
  in if andB statusOk (andB notReplayed (andB okAddr (andB okT0 (andB okT2 okAmt))))
     then paidU6
     else #0

-- Compute step quota unlocked per micro-USDC (`#1` uUSDC = `#2500` supercompiler steps; `$1.00` = `2.5B` steps):
x4-u6-to-step-quota : Word → Word
x4-u6-to-step-quota paidU6 = %wmul paidU6 #2500

