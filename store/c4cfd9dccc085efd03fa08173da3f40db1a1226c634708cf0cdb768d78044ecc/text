x4-extract-field-hex : List Word → List Word → List Word
x4-extract-field-hex key obj =
  let pat = list-append (x4-qstr key) ":"
      s1  = h-after pat obj
      s2  = h-after x4-q s1
  in h-before x4-q s2

-- Scan `logs` chunks (split on `}`) in `eth_getTransactionReceipt` JSON for Base `USDC` Transfer to `0x4A50...A26f`:
x4-scan-log-objs : Bool → Bool → Word → List (List Word) → Word
x4-scan-log-objs statusOk notReplayed minU6 nil = #0
x4-scan-log-objs statusOk notReplayed minU6 (cons chunk rest) =
  let lc      = x4-lower chunk
      hasUsdc = h-infix x4-usdc-base-lc lc
      hasT0   = h-infix x4-transfer-topic0-lc lc
      hasT2   = h-infix x4-founder-topic32-lc lc
      dataHex = x4-extract-field-hex "data" chunk
      amtU6   = x4-hex-to-word dataHex
      cred    = if andB hasUsdc (andB hasT0 hasT2)
                then x4-verify-transfer-log statusOk notReplayed x4-usdc-base-lc x4-transfer-topic0-lc x4-founder-topic32-lc amtU6 minU6
                else #0
  in %wadd cred (x4-scan-log-objs statusOk notReplayed minU6 rest)

x4-rpc-receipt : List Word → Proc W (List Word)
x4-rpc-receipt tx0x =
  let body = h-concat
               (cons "{" (cons (x4-qstr "jsonrpc") (cons ":" (cons (x4-qstr "2.0")
               (cons "," (cons (x4-qstr "id") (cons ":1,"
               (cons (x4-qstr "method") (cons ":" (cons (x4-qstr "eth_getTransactionReceipt")
               (cons "," (cons (x4-qstr "params") (cons ":[" (cons (x4-qstr tx0x) (cons "]}" nil)))))))))))))))
  in bind (h-capture
       (cons "/usr/bin/curl"
       (cons "-sS" (cons "--max-time" (cons "6"
       (cons "-H" (cons "Content-Type: application/json"
       (cons "-d" (cons body (cons "https://mainnet.base.org" nil)))))))))) (λ r →
       if %weq (fst r) #0 then ret {lzero} {W} (snd r) else ret {lzero} {W} nil)

