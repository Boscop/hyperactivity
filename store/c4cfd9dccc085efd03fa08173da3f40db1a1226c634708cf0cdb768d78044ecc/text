                  else if h-eq tier0 "pro" then #5000000
                  else #250000)
      quota  = x4-u6-to-step-quota amtU6
      eip681 = h-concat
                 (cons "ethereum:0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913@8453/transfer?address="
                 (cons x4-founder-coinbase-eip55
