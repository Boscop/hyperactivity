-- check(Γ_h, A_h, t′) ⇝ d′, plug(K, (t′, d′)), checkEnclosing ⇝ Code(Γ, A): a replacement of the
-- type at the hole keeps the enclosing derivation
xp-replace : (g : List XpTy) → (k : XpK) → (t t2 : XpExpr) → (A Ah : XpTy) → XpDer (g , xp-plug k t , A) →
  XpDer (g , t , Ah) → XpDer (g , t2 , Ah) → XpDer (g , xp-plug k t2 , A)
xp-replace g k t t2 A Ah d dt dt2 = xp-sound g (xp-plug k t2) A
  (concat {lzero} {Sum XpTy Unit} {xp-infer g (xp-plug k t2)} {xp-infer g (xp-plug k t)} {inl A}
    (xp-plug-infer g k t2 t (concat {lzero} {Sum XpTy Unit} {xp-infer g t2} {inl Ah} {xp-infer g t} (xp-complete dt2) (λ i → xp-complete dt (~ i))))
    (xp-complete d))
