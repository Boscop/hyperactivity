spine-cnt : {o : Ord} → (l : List (El o)) → Sorted l → (k : El o) → cnt-tree k (spine l) ≡ fromNat (count-lt k l)
spine-cnt l =
  case l return λ w → Sorted w → (k : El o) → cnt-tree k (spine w) ≡ fromNat (count-lt k w) of
    nil → λ s k i → #0
    cons x r →
      λ s k →
        ifP {λ bb → (if bb then cnt-tree k rleaf else wadd (%wsucc #0) (cnt-tree k (spine r))) ≡ fromNat (plus (one-if (not bb)) (count-lt k r))} {leq k x}
          (λ e → λ i → fromNat (sym (count-lt-zero k x r (fst s) (eq→isTrue e)) i))
          (λ e → tr (wadd (%wsucc #0) (fromNat (count-lt k r))) (λ i → wadd (%wsucc #0) (rec r (snd s) k i)) (sym (fromNat-wadd (suc zero) (count-lt k r))))
