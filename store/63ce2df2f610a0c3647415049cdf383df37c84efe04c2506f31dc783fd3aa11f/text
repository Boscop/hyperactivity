-- Helper: if leb (suc a) b ≡ true and leb b (suc k) ≡ true, then leb a k ≡ true.
fold-leb-trans : (a b c : Nat) → leb a b ≡ true → leb b c ≡ true → leb a c ≡ true
fold-leb-trans zero b c p q = λ i → true
fold-leb-trans (suc a) zero c p q = Empty-rec (fold-false-ne-true p)
fold-leb-trans (suc a) (suc b) zero p q = Empty-rec (fold-false-ne-true q)
fold-leb-trans (suc a) (suc b) (suc c) p q = fold-leb-trans a b c p q
