-- merge is sortedness unfolded
merge : {o : Ord} → List (El o) → List (El o) → List (El o)
merge xs =
  case xs return (λ w → List (El o) → List (El o)) of
    nil → λ ys → ys
    cons x xs1 → 
      λ ys →
        case ys return (λ w → List (El o)) of
          nil → cons x xs1
          cons y ys1 → if leq x y then cons x (rec xs1 (cons y ys1)) else cons y (rec ys1)
