-- Universal Binary `2 → 4` Commutation (`DUP ⋈ CON`) Strictly Conserves Local Heap Pool Capacity:
dup-con-commutes-conserves :
  (l : Nat) → (f0 f1 : Word) → (rest : List Word) →
  pool-capacity (hpool (suc (suc (suc (suc l)))) rest)
  ≡ pool-capacity (hpool (suc (suc l)) (cons f0 (cons f1 rest)))
dup-con-commutes-conserves zero    f0 f1 rest = refl
dup-con-commutes-conserves (suc l) f0 f1 rest = λ i → suc (dup-con-commutes-conserves l f0 f1 rest i)
