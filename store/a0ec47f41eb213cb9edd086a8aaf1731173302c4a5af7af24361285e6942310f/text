-- the remainder by P plus the next digit times P is the remainder by 256·P
digit-step : (V P : Word) → wlt #0 P ≡ true → wadd (wrem V P) (wmul (wrem (wquot V P) #256) P) ≡ wrem V (wmul #256 P)
digit-step V P h0 =
  catw (wadd-comm (wrem V P) (wmul (wrem (wquot V P) #256) P))
    (symw (catw (congw (λ z → wrem z (wmul #256 P)) (digit-split V P))
            (wmod-unique (wquot (wquot V P) #256) (wadd (wmul (wrem (wquot V P) #256) P) (wrem V P)) (wmul #256 P)
              (lt-digit (wrem (wquot V P) #256) (wrem V P) P (wrem-lt (wquot V P) #256 refl) (wrem-lt V P h0)))))
