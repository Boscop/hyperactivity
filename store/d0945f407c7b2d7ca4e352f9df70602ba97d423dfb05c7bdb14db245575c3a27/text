-- f a with f and a already pushed
x-push-app : Nat → Code → Code → Code
x-push-app zero f a = capp f a
x-push-app (suc k) (clam b) a = clet a b
x-push-app (suc k) (clet t b) a = clet t (x-push-app k b (code-shift #0 #1 a))
x-push-app (suc k) (ccase dd B x) a = ccase dd (x-push-br (λ b y → x-push-app k b y) dd #0 B a) x
x-push-app (suc k) f a = capp f a
