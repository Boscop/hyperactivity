dm-verify-hxsv32 : List Word → Bool × (Word × Word)
dm-verify-hxsv32 bs =
  if %weq (fromNat (list-length bs)) #32
  then
    let g0 = dm-get32-be bs
        g1 = dm-get32-be (snd g0)
        g2 = dm-get32-be (snd g1)
        g3 = dm-get32-be (snd g2)
        g4 = dm-get32-be (snd g3)
        g5 = dm-get32-be (snd g4)
        g6 = dm-get32-be (snd g5)
        g7 = dm-get32-be (snd g6)
        gotMac = %wor (%wshl (fst g6) #32) (fst g7)
        expMac = dm-sov-mac64 dm-sov-secret (fst g1) (fst g2) (fst g3) (fst g4) (fst g5)
    in if andB (%weq (fst g0) dm-sov-magic) (%weq gotMac expMac)
       then (true , (%wand (fst g1) #16777215 , fst g4))
       else (false , (#0 , #0))
  else (false , (#0 , #0))
