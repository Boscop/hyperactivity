-- Exact fixed-point sin(x) for x ∈ [-π/2, π/2]: x - x³/6 + x⁵/120 - x⁷/5040
fx-sin-core : SInt → SInt
fx-sin-core x =
  let x2 = fx-mul x x
      x3 = fx-mul x2 x
      x5 = fx-mul x3 x2
      x7 = fx-mul x5 x2
  in si-sub (si-add x (si-div-w x5 #120)) (si-add (si-div-w x3 #6) (si-div-w x7 #5040))
