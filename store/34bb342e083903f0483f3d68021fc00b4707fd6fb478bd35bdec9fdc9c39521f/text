po-view-again : {E : Type} → (es : List E) → (follows : E → E → Bool) → (p q : Pool E) → po-live es follows (po-union (po-union p q) q) ≡ po-live es follows (po-union p q)
po-view-again {E} es follows p q = po-view-membership es follows (po-union (po-union p q) q) (po-union p q) (po-union-again p q)
