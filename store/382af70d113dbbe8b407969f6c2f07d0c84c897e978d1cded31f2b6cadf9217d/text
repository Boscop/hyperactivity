-- exactly c levels of the pencil (H, S) lie below l/2^m, H and S given rounded to scale t (t the fixed-point scale too)
dy-countz : Nat → BZ → BZ → BZ → List (List BZ) → List (List BZ) → Bool
dy-countz c t e l hz sz = dy-is c (bz-mul (true , bin-of-nat (dy-len (List BZ) hz)) (bz-add e (dy-abs l))) t (dy-zpen e l hz sz)
