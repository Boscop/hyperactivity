diag-deg : (sk : Lst Entry) (k : Word) (X : Type 1) (G : Cube (dims sk) X) →
  PathP (λ i → Cube (dims sk) X) (diag-sk sk k X (cube-map (dims sk) X (Line X) (degen-l X) G)) G
diag-deg lnil k X G = λ i → G
diag-deg (lcons (e-ty s) sk) k X G =
  bool-elim1 (λ b → PathP (λ i → Cube (dims sk) X)
                 (if b then cube-map (dims sk) (Line X) X (face0-l X) (cube-map (dims sk) X (Line X) (degen-l X) G)
                  else diag-sk sk (%wsub k #1) X (cube-map (dims sk) X (Line X) (degen-l X) G)) G)
    (pcat (Cube (dims sk) X) (cube-map (dims sk) (Line X) X (face0-l X) (cube-map (dims sk) X (Line X) (degen-l X) G))
          (cube-map (dims sk) X X (λ x → x) G) G
          (cube-comp (dims sk) X (Line X) X (face0-l X) (degen-l X) G) (cube-id (dims sk) X G))
    (diag-deg sk (%wsub k #1) X G) (weq k #0)
diag-deg (lcons e-dim sk) k X G =
  bool-elim1 (λ b → PathP (λ i → Cube (suc (dims sk)) X)
                 (if b then cube-map (dims sk) (Line (Line X)) (Line X) (diag-l X) (cube-map (dims sk) (Line X) (Line (Line X)) (line-map X (Line X) (degen-l X)) G)
                  else diag-sk sk (%wsub k #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X)
                         (cube-map (dims sk) (Line X) (Line (Line X)) (line-map X (Line X) (degen-l X)) G))) G)
    (pcat (Cube (dims sk) (Line X)) (cube-map (dims sk) (Line (Line X)) (Line X) (diag-l X) (cube-map (dims sk) (Line X) (Line (Line X)) (line-map X (Line X) (degen-l X)) G))
          (cube-map (dims sk) (Line X) (Line X) (λ x → x) G) G
          (cube-comp (dims sk) (Line X) (Line (Line X)) (Line X) (diag-l X) (line-map X (Line X) (degen-l X)) G) (cube-id (dims sk) (Line X) G))
    (pcat (Cube (dims sk) (Line X))
          (diag-sk sk (%wsub k #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X)
             (cube-map (dims sk) (Line X) (Line (Line X)) (line-map X (Line X) (degen-l X)) G)))
          (diag-sk sk (%wsub k #1) (Line X) (cube-map (dims sk) (Line X) (Line (Line X)) (degen-l (Line X)) G)) G
          (λ i → diag-sk sk (%wsub k #1) (Line X)
                   (cube-comp (dims sk) (Line X) (Line (Line X)) (Line (Line X)) (exch-l X) (line-map X (Line X) (degen-l X)) G i))
          (diag-deg sk (%wsub k #1) (Line X) G))
    (weq k #0)
