-- Exact base-256 byte packing of arbitrary-precision Words (never calls toNat!)
word-to-bytes-go : Nat → Word → List Word × Word
word-to-bytes-go zero w = (nil , w)
word-to-bytes-go (suc k) w =
  if weq w #0 then (nil , #0)
  else let p = word-to-bytes-go k (wquot w #256)
       in (cons (wrem w #256) (fst p) , snd p)
