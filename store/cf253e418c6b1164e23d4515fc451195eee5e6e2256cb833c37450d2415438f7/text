pf2-end-ok : {A B : Type} → (ea : A → List Word) → (da : List Word → A × List Word) →
             ((a : A) → (t : List Word) → da (list-append (ea a) t) ≡ (a , t)) →
             (eb : B → List Word) → (db : List Word → B) →
             ((b : B) → db (eb b) ≡ b) →
             (p : A × B) → pf2-end-dec da db (pf2-enc ea eb p) ≡ p
pf2-end-ok {A} {B} ea da oka eb db okb p =
  let d1 = oka (fst p) (eb (snd p))
      d2 = okb (snd p)
  in concat {lzero} {A × B}
       {pf2-end-dec da db (list-append (ea (fst p)) (eb (snd p)))}
       {(fst p , db (eb (snd p)))} {p}
       (λ i → (fst (d1 i) , db (snd (d1 i))))
       (λ i → (fst p , d2 i))
