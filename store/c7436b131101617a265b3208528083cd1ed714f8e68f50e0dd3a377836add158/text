-- POST /source/object?h=H&k=K, the object's bytes as the body: the object taken into this server's pool
-- through the machine's --put, which answers only when the hash is the content's, so a session can
-- publish what this server lacks and nothing it names can be anything other than what it is
s-take : List Word → List Word → List Word → Proc W (List Word)
s-take m q body = if h-not (s-valid-obj-ref (s-param "h" q) (s-param "k" q)) then ret {lzero} {W} (s-respond "400 Bad Request" "text/plain" "invalid object ref") else bind (h-take-object m (s-param "h" q) (s-param "k" q) body) (λ ok →
  ret (if ok then s-response "text/plain" "" else s-respond "400 Bad Request" "text/plain" ""))
