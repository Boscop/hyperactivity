bac-true : {o : Ord} → (b : List (El o) → RTree (El o)) →
           ((l : List (El o)) → Sorted l → (k : El o) → cnt-tree k (b l) ≡ fromNat (count-lt k l)) →
           (k x : El o) → (a r : List (El o)) → Sorted a → AllLe x r → leq k x ≡ true →
           cnt-tree k (b a) ≡ fromNat (plus (count-lt k a) (plus (one-if (not true)) (count-lt k r)))
bac-true b ih k x a r sa ar e =
  tr (fromNat (count-lt k a)) (ih a sa k)
    (λ i → fromNat (zero-tail (count-lt k a) (count-lt k r) (count-lt-zero {o} k x r ar (eq→isTrue e)) i))
