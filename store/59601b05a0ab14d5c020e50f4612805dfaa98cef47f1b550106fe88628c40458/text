nk-env-in-set-up : (al : NkEnv) (n0 n1 n2 : NkW) (e : NkEnv) → (nk-wire-le n1 n2 ≡ true) → (nk-env-in-set al n0 n1 e ≡ true) → nk-env-in-set al n0 n2 e ≡ true
nk-env-in-set-up al n0 n1 n2 nke-nil p h = refl
nk-env-in-set-up al n0 n1 n2 (nke-cons w r) p h =
  nk-and-intro (nk-in-set al n0 n2 w) (nk-env-in-set al n0 n2 r)
    (nk-in-set-up al n0 n1 n2 w p (nk-and-l (nk-in-set al n0 n1 w) (nk-env-in-set al n0 n1 r) h))
    (nk-env-in-set-up al n0 n1 n2 r p (nk-and-r (nk-in-set al n0 n1 w) (nk-env-in-set al n0 n1 r) h))
