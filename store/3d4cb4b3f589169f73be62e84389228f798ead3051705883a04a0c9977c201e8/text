-- the table: the interval's rows for an interval eliminator at an interval point; the eliminators
-- numbered 20 and up (transport, composition) are kept whole; the rest by the rows above
nk-act : Word → NkTm → NkHd → NkEnv → NkAct
nk-act h cs hd parts = if nk-is-iop h then (if nk-is-pt hd then nk-act-i h cs (nk-dnf-of hd) else act-none) else (if %wlt #19 h then act-stuck else nk-act0 h cs hd parts)
