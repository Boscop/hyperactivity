-- 2. Exact N = 3 Lithium-like Ion Pair-Base Lower Bound (F = {1s}, Z > 0):
--    H₀(1s² 2s¹) = 2(-Z²/2) + (-Z²/8) = -(9/8) Z².
--    Inner projection R₁₂ = (16/35) Z on 1s² lifts the exact lower bound to -(9/8) Z² + (16/35) Z.
--    Clearing 280 = 8 × 35:  280 · (2(-Z²/2) + (-Z²/8) + (16/35) Z) = -315 Z² + 128 Z.
--    Variable (0): Z.
chem-li-pair-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-li-pair-poly A ad mu q vs =
  (λ g sub sq →
    let Z = g 0
        z0 = q (fn-q 0 1)
        e1s = sub z0 (mu (q (fn-q 1 2)) (sq Z))
        e2s = sub z0 (mu (q (fn-q 1 8)) (sq Z))
        r12 = mu (q (fn-q 16 35)) Z
        ea  = ad (ad (mu (q (fn-q 2 1)) e1s) e2s) r12
        lhs = mu (q (fn-q 280 1)) ea
        rhs = sub (mu (q (fn-q 128 1)) Z) (mu (q (fn-q 315 1)) (sq Z))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
