-- 6. SHA-256 Ch(e,f,g): (e & f) ^ (~e & g) -> g ^ (e & (f ^ g)) [2 ANDs -> 1 AND, -50%]
cert-sha256-ch : F2OptCert
cert-sha256-ch =
  mk-f2-cert "sha256_ch"
    (f2prog #3 nil (cons (f2-xor (f2-and (f2-v #0) (f2-v #1)) (f2-and (f2-not (f2-v #0)) (f2-v #2))) nil))
    (f2prog #3 nil (cons (f2-xor (f2-v #2) (f2-and (f2-v #0) (f2-xor (f2-v #1) (f2-v #2)))) nil))
    refl refl
