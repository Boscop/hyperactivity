-- THEOREM 7 (GEN-3 128-OP 8-LANE ZERO-RAW `SM_90a` PTX VERIFIED COLD BY `refl`):
ho-thm-gen3-128op-ilp-valid :
  let p0 = ho-compile-genome-ptx ho-gen0
      p2 = ho-compile-genome-ptx ho-gen2
      p3 = ho-compile-genome-ptx ho-gen3
  in andB (h-infix ".target sm_90a" p3)
     (andB (h-infix "lop3.b32 %r4, %r4, %r12, %r13, 150;" p3)
     (andB (h-infix "lop3.b32 %r9, %r9, %r12, %r13, 142;" p3)
     (andB (%wlt (fromNat (list-length p0)) (fromNat (list-length p2)))
           (%wlt (fromNat (list-length p2)) (fromNat (list-length p3)))))) ≡ true
ho-thm-gen3-128op-ilp-valid = refl
