factor-lam-go : Nat → Nat → List MTerm → List MTerm → List MTerm → List MTerm
factor-lam-go zero maxa pre suf xs = list-map mterm-shift-app xs
factor-lam-go (suc fuel) maxa pre suf nil = nil
factor-lam-go (suc fuel) maxa pre suf (cons x xs) =
  case split-prefix mterm-eq pre (cons x xs) of
    some after-pre →
      (case split-until mterm-eq maxa suf after-pre of
         some p → cons (mapp #0 (mterm-shift-app (mterm-pack-list (fst p)))) (factor-lam-go fuel maxa pre suf (snd p))
         none → cons (mterm-shift-app x) (factor-lam-go fuel maxa pre suf xs))
    none → cons (mterm-shift-app x) (factor-lam-go fuel maxa pre suf xs)
