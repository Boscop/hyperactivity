-- ============================================================================
-- 3. Cooperative Ramachandran / H-Bond Native Basin SOS Certificate
-- ============================================================================
-- Coupled backbone dihedral energy around native minimum (φ, ψ):
--   V(φ, ψ) = kφ φ² - 2 κ φ ψ + kψ ψ².
-- Exact SOS identity:
--   kφ · V(φ, ψ) = (kφ φ - κ ψ)² + (kφ kψ - κ²) ψ².
-- Strict native-basin convexity holds universally whenever kφ > 0 and kφ kψ > κ².
-- Variables (0..4): kφ, kψ, κ, φ, ψ.
fold-hbond-coop-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
fold-hbond-coop-poly A ad mu q vs =
  (λ g sub sq →
    let kp = g 0; ks = g 1; kap = g 2; phi = g 3; psi = g 4
        q2 = q (fn-q 2 1)
        V  = ad (sub (mu kp (sq phi)) (mu q2 (mu kap (mu phi psi)))) (mu ks (sq psi))
        lhs = mu kp V
        rhs = ad (sq (sub (mu kp phi) (mu kap psi)))
                 (mu (sub (mu kp ks) (sq kap)) (sq psi))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
