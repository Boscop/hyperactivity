-- ---------------------------------------------------------------- the suffix array
-- every suffix of the tokens with the point it starts at
entries : List (List Word) → Word → List (List (List Word) × Word)
entries l = case l return λ w → Word → List (List (List Word) × Word) of nil → λ i → nil; cons x r → λ i → cons (cons x r , i) (rec r (wadd i #1))
