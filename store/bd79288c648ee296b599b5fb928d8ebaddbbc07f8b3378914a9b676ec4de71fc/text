-- Theorem (Non-ergodic non-descent): no autonomous population-level law g : Nat → Nat exists
-- for the cross-sectional summary pop-sum, despite both individuals obeying deterministic laws.
-- At (true, false), pop-sum = 1 → next pop-sum = 2.
-- At (false, true), pop-sum = 1 → next pop-sum = 0.
non-ergodic-no-pop-law : (g : Nat → Nat) → Descends pop-sum ens-step g → Empty
non-ergodic-no-pop-law g d =
  zero≢two (concat (sym (d (the (Bool × Bool) (false , true)))) (d (the (Bool × Bool) (true , false))))
