-- one node of the scene: its place, its side (h), its ring, and the field over it (readers here, open or resolved)
hi-jnode : List Word → Word × Word → List Word → Word → Word → Bool → List Word
hi-jnode n p h ring rd op = h-concat (cons "{" (cons (hi-key "id") (cons (s-json-str n) (cons "," (cons (hi-key "x") (cons (h-decimal (fst p))
  (cons "," (cons (hi-key "y") (cons (h-decimal (snd p)) (cons "," (cons (hi-key "h") (cons h (cons "," (cons (hi-key "ring") (cons (h-decimal ring)
  (cons "," (cons (hi-key "readers") (cons (h-decimal rd) (cons "," (cons (hi-key "open") (cons (if op then "1" else "0") (cons "}" nil))))))))))))))))))))))
