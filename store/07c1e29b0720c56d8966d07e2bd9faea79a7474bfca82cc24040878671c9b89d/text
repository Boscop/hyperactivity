pl-ag-row : Nat → Nat → Nat × (Nat × Nat) → List (Nat × (Nat × Nat)) → Bool
pl-ag-row ap aq x ys = case ys of
  nil → true
  cons y r → if fn-eq (pl-hm ap aq (fn-q 1 1) x y) (he-hel ap aq x y) then (if pl-n3eq (pl-hh ap aq (fn-q 1 1) x y) (hq-hh ap aq x y) then pl-ag-row ap aq x r else false) else false
