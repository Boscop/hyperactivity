motive-level T P =
  case P of
    tguess k g t V → if %weq g #1 then redo k else motive-level T t
    tlam nm b V → infer-sort (b (%var nm T) T)
    _ → 
      case infer P of
        typed Pt → 
          case %view Pt of
            wpi A B → 
              if conv-ty A T
                then case %view (B (%var A)) of wu l → typed (Type l); _ → err P E-motive Pt T
                else err P E-motive Pt T
            _ → err P E-motive Pt T
        r → r
