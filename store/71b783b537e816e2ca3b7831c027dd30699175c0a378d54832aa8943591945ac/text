ce-try-str : (Code → List Word → List Word) → Code → List Word → Opt (List Word)
ce-try-str pr c acc =
  let res = ce-str-take (toNat #512) c
      bs  = fst res
      n   = fst (snd res)
      tl  = snd (snd res)
  in if %wlt #1 n then
       some (list-append "hy_str((const unsigned char *)" (cons #34 (ce-esc-bytes bs (cons #34
         (list-append ", " (list-append (ce-dec n) (list-append ", " (pr tl (list-append ")" acc)))))))))
     else none
