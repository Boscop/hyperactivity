rm-assert : RCx → ROperand → Bool → RAssertMsg → Word → RFrame → REv RNext
rm-assert cx cond expected msg target =
  let ev = rm-opd-rv cx cond
  in λ fr → rm-bind (ev fr) (λ v → rm-bind (rm-as-s v) (λ x → rm-bind (rm-res (sv-as-b x)) (λ b →
            case u64eq (uq-b b) (uq-b expected) of
              true → rm-ret (rn-goto fr target)
              false → rm-throw (rx-abort (rm-assert-kind msg)))))
