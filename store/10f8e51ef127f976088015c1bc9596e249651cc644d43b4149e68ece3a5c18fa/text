-- Overflow-safe 64-bit mixing digest binding (target, optimal_gates, netlist)
hs-digest : Word → Word → Word → Word
hs-digest t g p =
  let h1 = %wmod (%wadd (%wmul (%wxor #2166136261 t) #16777619) g) #4294967291
      h2 = %wmod (%wadd (%wmul h1 #2654435761) p) #4294967291
  in %wor (%wshl h1 #32) h2
