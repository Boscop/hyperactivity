sup-world : {S : Sig} {A : Type} {St : Type} → (PKey → Proc {lzero} S A) → World S St → World (SupS A) (SupSt A St)
sup-world {S} {A} {St} reg w c st =
  case c return (λ x → Sum (sup-resp {A} x × SupSt A St) (SupSt A St)) of
    spawn k →
      (let r = runp {S} {A} {St} (reg k) w (fst st)
       in inl (snd (snd (snd st)) , (snd r , (cons (snd (snd (snd st)) , fst r) (fst (snd st)) , (fst (snd (snd st)) , %wsucc (snd (snd (snd st))))))))
    await h →
      inl ((case mem-w h (fst (snd (snd st))) of true → failed external; false → lookup-out {A} h (fst (snd st))) , st)
