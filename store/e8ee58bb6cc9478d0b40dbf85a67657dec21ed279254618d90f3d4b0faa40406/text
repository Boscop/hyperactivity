ok-br : (b : TextBody) → dec-br (enc-br b) ≡ b
ok-br b =
  case b return (λ u → dec-br (enc-br u) ≡ u) of
    mk-tbody body ranks →
      let d1 = ok-mt-chunk body (compress-rans-bytes ranks)
          d2 = compress-rans-bytes-ok ranks
      in concat {lzero} {TextBody}
           {dec-br (list-append (enc-mt-chunk body) (compress-rans-bytes ranks))}
           {mk-tbody body (decompress-rans-bytes (compress-rans-bytes ranks))}
           {mk-tbody body ranks}
           (λ i → mk-tbody (fst (d1 i)) (decompress-rans-bytes (snd (d1 i))))
           (λ i → mk-tbody body (d2 i))
