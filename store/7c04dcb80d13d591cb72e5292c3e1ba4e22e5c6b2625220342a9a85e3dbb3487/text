-- (part of language-support)
div_spec_64 : (dst' : Bits #128) → (src : Bits #64) → (Bool × (Bits #128) × (Bits #64))
div_spec_64 dst' src =
  let quotient : Bits #128
      quotient = (bits_of_int (floor2 (bv-unsigned #128 dst') (bv-unsigned #64 src)) (zpos #128))
      remainder : Bits #64
      remainder = (bits_of_int (mod (bv-unsigned #128 dst') (bv-unsigned #64 src)) (zpos #64))
      overflow? : Bool
      overflow? = (z-lt (zpos #18446744073709551615) (bv-unsigned #128 quotient))
  in (if overflow? then (true , #0 , #0) else (overflow? , quotient , remainder))
