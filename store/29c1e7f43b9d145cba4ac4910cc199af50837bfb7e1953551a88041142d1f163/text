-- ---------------------------------------------------------------- the laws on the carrier, by injectivity of the value
zr-lawq : (l r : ZrC) → (x y : Nat × Nat) → zeq (zr-val l) x → zeq x y → zeq (zr-val r) y → l ≡ r
zr-lawq l r x y p e q = zr-inj l r (zr-c3 (zr-val l) x y (zr-val r) p e (zr-zs (zr-val r) y q))
