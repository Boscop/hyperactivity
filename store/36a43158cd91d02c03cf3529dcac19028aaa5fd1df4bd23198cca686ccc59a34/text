import "../host.hypercubical"

usf-cong : {A B : Type} → (f : A → B) → {x y : A} → x ≡ y → f x ≡ f y
usf-cong f p = λ i → f (p i)

usf-trans : {A : Type} → {x y z : A} → x ≡ y → y ≡ z → x ≡ z
usf-trans {A} {x} p q = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

usf-sym : {A : Type} → {x y : A} → x ≡ y → y ≡ x
usf-sym {A} {x} p = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ p j , i = 1 ↦ x ]) x

usf-app-nil-r : (xs : List Word) → list-append xs nil ≡ xs
usf-app-nil-r nil         = refl
usf-app-nil-r (cons x xs) = usf-cong (cons x) (usf-app-nil-r xs)

usf-ln : List Word → List Word → List Word
usf-ln s rest = list-append s (cons #10 rest)

usf-has-backslash : List Word → Bool
usf-has-backslash nil         = false
usf-has-backslash (cons c cs) = if weq c #92 then true else usf-has-backslash cs

usf-contains : List Word → List Word → Bool
usf-contains pat nil         = h-null pat
usf-contains pat (cons x xs) =
  if h-prefix pat (cons x xs) then true else usf-contains pat xs

data UsfPillar : Type where
  usf-pillar : List Word → List Word → List Word → UsfPillar

data UsfBench : Type where
  usf-bench : List Word → List Word → List Word → List Word → UsfBench

data UsfNode : Type where
  usf-empty   : UsfNode
  usf-seq     : UsfNode → UsfNode → UsfNode
  usf-nav     : Bool → UsfNode
  usf-splash  : List Word → List Word → List Word → UsfNode
  usf-portal  : UsfNode
  usf-section : List Word → List Word → List UsfPillar → UsfNode
  usf-benches : List Word → List Word → List UsfBench → UsfNode
  usf-footer  : UsfNode

usf-drop-empty-l : UsfNode → UsfNode → UsfNode
usf-drop-empty-l usf-empty b           = b
usf-drop-empty-l (usf-seq x y) b       = usf-seq (usf-seq x y) b
usf-drop-empty-l (usf-nav p) b         = usf-seq (usf-nav p) b
usf-drop-empty-l (usf-splash t s w) b  = usf-seq (usf-splash t s w) b
usf-drop-empty-l usf-portal b          = usf-seq usf-portal b
usf-drop-empty-l (usf-section i l p) b = usf-seq (usf-section i l p) b
usf-drop-empty-l (usf-benches i l r) b = usf-seq (usf-benches i l r) b
usf-drop-empty-l usf-footer b          = usf-seq usf-footer b

usf-drop-empty-r : UsfNode → UsfNode → UsfNode
usf-drop-empty-r a usf-empty           = a
usf-drop-empty-r a (usf-seq x y)       = usf-drop-empty-l a (usf-seq x y)
usf-drop-empty-r a (usf-nav p)         = usf-drop-empty-l a (usf-nav p)
usf-drop-empty-r a (usf-splash t s w)  = usf-drop-empty-l a (usf-splash t s w)
usf-drop-empty-r a usf-portal          = usf-drop-empty-l a usf-portal
usf-drop-empty-r a (usf-section i l p) = usf-drop-empty-l a (usf-section i l p)
usf-drop-empty-r a (usf-benches i l r) = usf-drop-empty-l a (usf-benches i l r)
usf-drop-empty-r a usf-footer          = usf-drop-empty-l a usf-footer

usf-superopt : UsfNode → UsfNode
usf-superopt usf-empty           = usf-empty
usf-superopt (usf-seq a b)       = usf-drop-empty-r (usf-superopt a) (usf-superopt b)
usf-superopt (usf-nav p)         = usf-nav p
usf-superopt (usf-splash t s w)  = usf-splash t s w
usf-superopt usf-portal          = usf-portal
usf-superopt (usf-section i l p) = usf-section i l p
usf-superopt (usf-benches i l b) = usf-benches i l b
usf-superopt usf-footer          = usf-footer

