usf-drop-l-sound :
  (a b : UsfNode) →
  usf-emit-node (usf-drop-empty-l a b) ≡ list-append (usf-emit-node a) (usf-emit-node b)
usf-drop-l-sound usf-empty b           = refl
usf-drop-l-sound (usf-seq x y) b       = refl
usf-drop-l-sound (usf-nav p) b         = refl
usf-drop-l-sound (usf-splash t s w) b  = refl
usf-drop-l-sound usf-portal b          = refl
usf-drop-l-sound (usf-section i l p) b = refl
usf-drop-l-sound (usf-benches i l r) b = refl
usf-drop-l-sound usf-footer b          = refl

usf-drop-r-sound :
  (a b : UsfNode) →
  usf-emit-node (usf-drop-empty-r a b) ≡ list-append (usf-emit-node a) (usf-emit-node b)
usf-drop-r-sound a usf-empty           = usf-sym (usf-app-nil-r (usf-emit-node a))
usf-drop-r-sound a (usf-seq x y)       = usf-drop-l-sound a (usf-seq x y)
usf-drop-r-sound a (usf-nav p)         = usf-drop-l-sound a (usf-nav p)
usf-drop-r-sound a (usf-splash t s w)  = usf-drop-l-sound a (usf-splash t s w)
usf-drop-r-sound a usf-portal          = usf-drop-l-sound a usf-portal
usf-drop-r-sound a (usf-section i l p) = usf-drop-l-sound a (usf-section i l p)
usf-drop-r-sound a (usf-benches i l r) = usf-drop-l-sound a (usf-benches i l r)
usf-drop-r-sound a usf-footer          = usf-drop-l-sound a usf-footer

usf-thm-superopt-sound : (n : UsfNode) → usf-emit-node (usf-superopt n) ≡ usf-emit-node n
usf-thm-superopt-sound usf-empty = refl
usf-thm-superopt-sound (usf-seq a b) =
  let iha = usf-thm-superopt-sound a
      ihb = usf-thm-superopt-sound b
      st1 = usf-drop-r-sound (usf-superopt a) (usf-superopt b)
      st2 = λ i → list-append (iha i) (ihb i)
  in usf-trans st1 st2
usf-thm-superopt-sound (usf-nav p)         = refl
usf-thm-superopt-sound (usf-splash t s w)  = refl
usf-thm-superopt-sound usf-portal          = refl
usf-thm-superopt-sound (usf-section i l p) = refl
usf-thm-superopt-sound (usf-benches i l b) = refl
usf-thm-superopt-sound usf-footer          = refl

