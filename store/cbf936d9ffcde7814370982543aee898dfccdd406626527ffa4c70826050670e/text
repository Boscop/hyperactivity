dd-dim-op : (sk : Lst Entry) (k : Word) (b : Bool) (Z : Type 1) (H : Z → Type 1) (G : Cube (suc (dims sk)) Z) → DCube (suc (dims sk)) Z (DL Z H) G → DCube (suc (dims sk)) Z H G
dd-dim-op sk k b Z H G q =
  bool-elim1 (λ b' → DCube (dims sk) (Line Z) (LineO Z H) G)
    (dcube-fmap (dims sk) (Line Z) (LineO Z (DL Z H)) (LineO Z H) (λ L q' → diag-o Z H (line-map Z (Line Z) (degen-l Z) L) q') G q)
    (diag-dd sk (%wsub k #1) (Line Z) (LineO Z H) G
       (dcube-fmap (dims sk) (Line Z) (LineO Z (DL Z H)) (DL (Line Z) (LineO Z H)) (λ L q' → exch-o Z H (line-map Z (Line Z) (degen-l Z) L) q') G q)) b
