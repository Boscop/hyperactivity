-- the amount of a named substance, zero if it is absent. A rate reads this, so a rate can depend on a
-- concentration: how much base, not only whether there is base.
sol-amount : Nat → Solution → Nat
sol-amount n l = case l of
  nil → 0
  cons e r → (case eqb (dis-tag e) n of true → dis-amount e; false → sol-amount n r)
