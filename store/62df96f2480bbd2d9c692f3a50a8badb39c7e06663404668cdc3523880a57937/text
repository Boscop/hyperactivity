-- Native OS Foundry Export (`W`) for the Complete 4-Part `HyperNet` MPW Tapeout Package
export-hypernet-mpw :
  List Word → List Word → List Word → List Word →
  Step W (Word × (Word × (Word × Word)))
export-hypernet-mpw libPath rtlPath tbPath gdsPath =
  to-step {W} {Word × (Word × (Word × Word))}
    (bind (file-write-named libPath hypercore-cmos7nm-lib)    (λ nLib →
     bind (file-write-named rtlPath hypernet-mpw-rtl-sv)      (λ nRtl →
     bind (file-write-named tbPath  sv-hypernet-vs-rv32-tb)   (λ nTb  →
     bind (file-write-named gdsPath hypernet-4tile-gds-bytes) (λ nGds →
       ret {lzero} {W} (nLib , (nRtl , (nTb , nGds))))))))
