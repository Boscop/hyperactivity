-- the result's value: (s + 2R) + (c + (y + 2Y)) = x + 2X, from x + 2c' = s + (y + c) and R + (c' + Y) = X
sub-goal-alg : (s c y x c2 R Y X : Nat) → plus x (times 2 c2) ≡ plus s (plus y c) → plus R (plus c2 Y) ≡ X → plus (plus s (times 2 R)) (plus c (plus y (times 2 Y))) ≡ plus x (times 2 X)
sub-goal-alg s c y x c2 R Y X fsid ih =
  transN (shuffle6 s (times 2 R) c y (times 2 Y))
  (transN (congN (λ z → plus z (plus (times 2 R) (times 2 Y))) (symN fsid))
  (transN (plus-assoc x (times 2 c2) (plus (times 2 R) (times 2 Y)))
  (transN (congN (plus x) (plus-comm-mid (times 2 c2) (times 2 R) (times 2 Y)))
  (transN (congN (λ z → plus x (plus (times 2 R) z)) (symN (times2-plus c2 Y)))
  (transN (congN (plus x) (symN (times2-plus R (plus c2 Y))))
  (congN (λ z → plus x (times 2 z)) ih))))))
