-- ---------------------------------------------------------------- one query
-- a text's file of one kind (".yek", ".key", ".forms"), or the turns read and identified now
c-file : List Word → List Word → Proc W (List Word)
c-file d kind = if h-eq d "turns"
  then bind (h-read c-record) (λ t → ret (if h-eq kind ".yek" then m-norm-rev #1 (list-length (h-source-or t)) (text-bytes (h-source-or t))
                                          else m-norm (if h-eq kind ".key" then #1 else #0) (list-length (h-source-or t)) (text-bytes (h-source-or t))))
  else bind (h-read (list-append c-dir (list-append d kind))) (λ t → ret (h-source-or t))
