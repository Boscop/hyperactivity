it-pos-fp : (A V : Type) → (isz neg : A → Bool) → (f : V → V → A) → (ws : List V) → it-ok A V isz f ws ≡ true → sy-all V (λ u → (isz (f u u) ≡ false) × (neg (f u u) ≡ false)) (it-fp A V neg f ws)
it-pos-fp A V isz neg f ws = case ws return λ w → it-ok A V isz f w ≡ true → sy-all V (λ u → (isz (f u u) ≡ false) × (neg (f u u) ≡ false)) (it-fp A V neg f w) of
  nil → λ h → unit
  cons u ur → λ h → it-ifd V (neg (f u u)) u (it-fp A V neg f ur) (λ l → sy-all V (λ x → (isz (f x x) ≡ false) × (neg (f x x) ≡ false)) l)
    (λ e → ((fst (snd (it-ok3 (it-allz A V isz f u ur) (isz (f u u)) (it-ok A V isz f ur) h)) , e) , it-pos-fp A V isz neg f ur (snd (snd (it-ok3 (it-allz A V isz f u ur) (isz (f u u)) (it-ok A V isz f ur) h)))))
    (it-pos-fp A V isz neg f ur (snd (snd (it-ok3 (it-allz A V isz f u ur) (isz (f u u)) (it-ok A V isz f ur) h))))
