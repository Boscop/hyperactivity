-- ---------------------------------------------------------------- the search tree, held as bytes
-- a node at o: the byte 1, the size of its lower tree (four bytes), its entry's point (four), the place
-- of its upper tree (four), its lower tree at o + 13; a leaf: the byte 0
si-chk-tree : (n : Nat) → Bytes n → RTree (El entry-ord) → Word → Bool
si-chk-tree n B t = case t return λ w → Word → Bool of
  rleaf → λ o → weq (cstr-get n B o) #0
  rnode a sz x b → λ o → andB (weq (cstr-get n B o) #1) (andB (weq (si-rd4 n B (wadd o #1)) sz)
    (andB (weq (si-rd4 n B (wadd o #5)) (snd x)) (andB (rec a (wadd o #13)) (rec b (si-rd4 n B (wadd o #9))))))
