ex-of-code : Code → Opt Ex
ex-of-code (cvar v) = some (ev v)
ex-of-code (cann t T) = ex-of-code t
ex-of-code (ccon d k fs ds) = (case nat-of-code (ccon d k fs ds) of none → none; some n → some (ec n))
ex-of-code (capp f x) =
  case f of
    capp g a → (case rg-glob g of
                  none → none
                  some gi → ex-of-bin gi (ex-of-code a) (ex-of-code x))
    _ → none
ex-of-code c = none
