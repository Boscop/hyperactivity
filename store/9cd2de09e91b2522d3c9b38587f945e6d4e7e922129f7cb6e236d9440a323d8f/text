-- the cases of soundness: each split carries the equation that selected it
xp-sp-y2 : (g : List XpTy) → (a b : XpExpr) → (A : XpTy) → XpDer (g , a , xt-nat) →
  ((T : XpTy) → xp-infer g b ≡ inl T → XpDer (g , b , T)) → (t2 : XpTy) → xp-infer g b ≡ inl t2 → xp-plus-ty-r (inl t2) ≡ inl A → XpDer (g , xp-plus a b , A)
xp-sp-y2 g a b A da sb xt-nat eb h = xp-retype g (xp-plus a b) xt-nat A (xp-inl-inj xt-nat A h) (xd-plus g a b da (sb xt-nat eb))
xp-sp-y2 g a b A da sb (xt-prod c d) eb h = Empty-rec (xp-inr-inl A h)
