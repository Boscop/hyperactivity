tl-subst : {GA : TlCtx × TlTy} → TlTm GA → (d : TlCtx) → TlSub (fst GA) d → TlTm (d , snd GA)
tl-subst (tl-var g a i) d th = th a i
tl-subst (tl-lit g b) d th = tl-lit d b
tl-subst (tl-tt g) d th = tl-tt d
tl-subst (tl-lam g a b t) d th = tl-lam d a b (tl-subst t (tl-ext d a) (tl-sub-lift g d a th))
tl-subst (tl-app g a b f x) d th = tl-app d a b (tl-subst f d th) (tl-subst x d th)
tl-subst (tl-pair g a b x y) d th = tl-pair d a b (tl-subst x d th) (tl-subst y d th)
tl-subst (tl-fst g a b p) d th = tl-fst d a b (tl-subst p d th)
tl-subst (tl-snd g a b p) d th = tl-snd d a b (tl-subst p d th)
tl-subst (tl-inl g a b x) d th = tl-inl d a b (tl-subst x d th)
tl-subst (tl-inr g a b y) d th = tl-inr d a b (tl-subst y d th)
tl-subst (tl-case g a b c e l r) d th = tl-case d a b c (tl-subst e d th) (tl-subst l (tl-ext d a) (tl-sub-lift g d a th)) (tl-subst r (tl-ext d b) (tl-sub-lift g d b th))
