-- a forged sub-net payload sent over a cross-peer wire is stripped to absent (inl unit) at the port boundary
wire-forged-rejected : {K V : Type} → (chk : K → V → Bool) → (k : K) → (arg : WireId) → (v : V) →
  chk k v ≡ false → wf-verify chk (wf-ref k arg (inr v)) ≡ wf-ref k arg (inl unit)
wire-forged-rejected chk k arg v bad =
  λ i → wf-ref k arg (peer-forged-rejected chk k v bad i)
