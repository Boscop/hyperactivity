-- a value read back at depth d: clause for clause nk-rule-quote, put together by nk-finish
nk-ev-quote : (NkEvJ → NkEv) → Word → NkHd → NkEv → NkEv
nk-ev-quote r d (hd-clo b) parts = nk-ev-q (nk-finish nkk-lam (nk-cons (nk-ev-qt (r (nkevj-q (%wsucc d) (r (nkevj-tm b (nkev-cons (nkev (hd-lvl d) nkev-nil) parts)))))) nk-nil))
nk-ev-quote r d (hd-susp b) parts = nk-ev-q (nk-finish (nkk-susp b) (nk-ev-qt (r (nkevj-qs d parts))))
nk-ev-quote r d (hd-num m) parts = nk-ev-q (nk-num m)
nk-ev-quote r d (hd-var x) parts = nk-ev-q (nk-free x)
nk-ev-quote r d (hd-lvl l) parts = nk-ev-q (nk-var (%wsub (%wsub d #1) l))
nk-ev-quote r d (hd-dnf f) parts = nk-ev-q (nk-dnf-tm d f)
nk-ev-quote r d (hd-con c) parts = nk-ev-q (nk-finish (nkk-con c) (nk-ev-qt (r (nkevj-qs d parts))))
nk-ev-quote r d (hd-stuck h) parts = nk-ev-q (nk-finish (nkk-op h) (nk-ev-qt (r (nkevj-qs d parts))))
nk-ev-quote r d (hd-stuckm h) parts = nk-ev-q (nk-finish (nkk-match h) (nk-ev-qt (r (nkevj-qs d parts))))
nk-ev-quote r d (hd-q t) parts = nkev-nil
