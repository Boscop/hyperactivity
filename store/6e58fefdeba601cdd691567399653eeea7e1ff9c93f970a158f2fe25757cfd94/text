-- THEOREM 9 (RFC 4648 BASE64 ENCODE + DECODE ROUNDTRIP EXACT BY `refl`):
bn-thm-rfc4648-base64 :
  andB (h-eq (bn-base64-enc "f") "Zg==")
  (andB (h-eq (bn-base64-enc "fo") "Zm8=")
  (andB (h-eq (bn-base64-enc "foo") "Zm9v")
  (andB (h-eq (bn-base64-enc "foobar") "Zm9vYmFy")
        (h-eq (bn-base64-dec (bn-base64-enc "Hyperactivity-x402-v2!")) "Hyperactivity-x402-v2!")))) ≡ true
bn-thm-rfc4648-base64 = refl
