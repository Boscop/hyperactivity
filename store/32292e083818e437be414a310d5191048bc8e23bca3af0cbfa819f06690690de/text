above-to-sep2d : (minX minY : Nat) → (r : Rect) → (ys : List Rect) →
  AllAboveY (plus minY (ry1 r)) ys → AllSep2D minX minY r ys
above-to-sep2d minX minY r nil h = unit
above-to-sep2d minX minY r (cons r2 ys) h =
  ( orB-true-r (drc-sep-x minX r r2) (drc-sep-y minY r r2) (fst h)
  , above-to-sep2d minX minY r ys (snd h) )
