-- a pack written again unless its modules are the ones it holds
c-pack-make : List (List Word) → List Word → Proc W Unit
c-pack-make mhs d = bind (h-read (list-append c-dir (list-append d ".mods"))) (λ had →
  if h-eq (h-source-or had) (c-in d mhs) then ret {lzero} {W} unit else c-pack-write d (c-in d mhs))
