-- issuing gate-flip transitions a process from mode m into a continuation at mode (not m)
gate-switch : {S-off S-on : Sig} {A : Type} → (m : Bool)
            → ▸ κ (RProc κ (GatedDS S-off S-on) A (not m))
            → RProc κ (GatedDS S-off S-on) A m
gate-switch m nextp = rcmd m gate-flip (λ u → nextp)
