guarded grp c =
  if notb (mentions grp c)
    then true
    else case c of
           tguess k g t V → guarded grp t
           tspine t V → guarded grp t
           tlam nm b V → guarded grp (b (%var Uw) Uw)
           tplam nm b V → guarded grp (b (%dim))
           tpair a b V → andb (guarded grp a) (guarded grp b)
           tcon d k fs ds V → lall (guarded grp) fs
           tcase d B x F V → andb (notb (mentions grp x)) (lall (guarded-br grp) B)
           telim d P B x F V → 
             andb (notb (mentions grp P)) (andb (notb (mentions grp x)) (lall (guarded-br grp) B))
           tlet t nm b V → andb (notb (mentions grp t)) (guarded grp (b (%var Uw) Uw))
           tsys bs V → 
             lall (λ b → andb (notb (mentions grp (fst b))) (guarded grp (force (snd b)))) bs
           tann t T V → andb (guarded grp t) (notb (mentions grp T))
           _ → spine-call grp c
