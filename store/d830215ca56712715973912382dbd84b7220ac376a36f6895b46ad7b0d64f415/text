rm-drop-fields : List RFieldLayout → (RTy → RCall → MPtr → REv Unit) → RCall → MPtr → REv Unit
rm-drop-fields nil g = λ call p → rm-ret unit
rm-drop-fields (cons f fs) g =
  let one = g (rf-ty f)
      rest = rm-drop-fields fs g
  in λ call p → rm-bind (rm-off p (rf-off f)) (λ q → rm-then (one call q) (rest call p))
