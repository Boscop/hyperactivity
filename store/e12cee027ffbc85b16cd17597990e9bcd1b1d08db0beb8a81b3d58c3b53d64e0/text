cm-ltw-shift-inv-step : (k a b : Word) → (ltw (wadd k a) (wadd k b) ≡ true → ltw a b ≡ true) →
                        ltw (wadd (%wsucc k) a) (wadd (%wsucc k) b) ≡ true → ltw a b ≡ true
cm-ltw-shift-inv-step k a b ih h =
  ih (cm-catb (cm-congb (λ z → ltw (%wsucc (wadd k a)) z) (symw (cm-wadd-suc-l k b)))
        (cm-catb (cm-congb (λ z → ltw z (wadd (%wsucc k) b)) (symw (cm-wadd-suc-l k a))) h))
