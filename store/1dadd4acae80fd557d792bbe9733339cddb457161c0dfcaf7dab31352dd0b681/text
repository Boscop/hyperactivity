-- Binary Calma GDSII BOUNDARY Record Parser: validates every record length & opcode and recovers Rect
gds-decode-one : List Word → Sum Unit ((Word × Word × Rect) × List Word)
gds-decode-one s0 =
  bind-res (expect-w #4 s0) (λ s1 →
  bind-res (expect-w gds-rec-boundary s1) (λ s2 →
  bind-res (expect-w #6 s2) (λ s3 →
  bind-res (expect-w gds-rec-layer s3) (λ s4 →
  bind-res (pop-w s4) (λ pLay →
  bind-res (expect-w #6 (snd pLay)) (λ s5 →
  bind-res (expect-w gds-rec-datatype s5) (λ s6 →
  bind-res (pop-w s6) (λ pDt →
  bind-res (expect-w #44 (snd pDt)) (λ s7 →
  bind-res (expect-w gds-rec-xy s7) (λ s8 →
  bind-res (pop-w s8) (λ px0 →
  bind-res (pop-w (snd px0)) (λ py0 →
  bind-res (pop-w (snd py0)) (λ px1 →
  bind-res (pop-w (snd px1)) (λ py0b →
  bind-res (pop-w (snd py0b)) (λ px1b →
  bind-res (pop-w (snd px1b)) (λ py1 →
  bind-res (pop-w (snd py1)) (λ px0b →
  bind-res (pop-w (snd px0b)) (λ py1b →
  bind-res (pop-w (snd py1b)) (λ px0c →
  bind-res (pop-w (snd px0c)) (λ py0c →
  bind-res (expect-w #4 (snd py0c)) (λ s9 →
  bind-res (expect-w gds-rec-endel s9) (λ rest →
    let x0 = nat-of-w (fst px0)
        y0 = nat-of-w (fst py0)
        x1 = nat-of-w (fst px1)
        y1 = nat-of-w (fst py1)
    in inr ((fst pLay , (fst pDt , rect x0 y0 (sub-by x0 x1) (sub-by y0 y1))) , rest)))))))))))))))))))))))
