-- the run's last obligations decided: at the return, and the result v (or the overflow exit)
-- (a word result compared with v)
res-word : (v x : Word) → (b : Bool) → weq x v ≡ b → Opt (opt-or (some x) v ≡ v)
res-word v x b e =
  case b return (λ c → weq x v ≡ c → Opt (opt-or (some x) v ≡ v)) of
    true → λ q → some (weq-sound x v q)
    false → λ q → none
  e
