-- Non-negative signed LEB128 for i32.const (handles up to 32-bit positive constants including 0x7FC00000)
pw-sleb-pos-go : Nat → Word → List Word
pw-sleb-pos-go zero n = cons (%wand n #127) nil
pw-sleb-pos-go (suc k) n =
  let b = %wand n #127
      r = %wshr n #7
  in if (if %weq r #0 then %wlt b #64 else false)
     then cons b nil
     else cons (%wor b #128) (pw-sleb-pos-go k r)
