-- a process typed by a protocol: it is never refused by the guard over the given world
GSProc : {St : Type} (S : Sig) (A : Type) → GSession S → World S St → St → Type (lsuc lzero)
GSProc {St} S A ses w st = (p : Proc {lzero} S A) × IsDone {A} (fst (runp {S} {A} {GSession S × St} p (gsession-guard {S} {St} w) (ses , st)))