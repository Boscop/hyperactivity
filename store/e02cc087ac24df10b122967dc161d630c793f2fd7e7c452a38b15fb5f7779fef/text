-- a change to one wire: a value arrives, an operation arrives, or the slot is set. A value waits or
-- meets the operation waiting; an operation waits or meets the value waiting; anything else (a
-- second value, a second operation) leaves the slot as it was
data NkCh = nkc-val (v : NkVal) | nkc-op (o : NkOp) | nkc-put (s : NkSlot)
