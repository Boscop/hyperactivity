dnf-of : Code → Opt DNF
dnf-of ci0 = some dnf-zero
dnf-of ci1 = some dnf-one
dnf-of (cvar k) = some (lcons (lcons (k , true) lnil) lnil)
dnf-of (cneg r) = case dnf-of r of none → none; some f → some (dnf-neg f)
dnf-of (cmeet r s) = case dnf-of r of none → none; some f → (case dnf-of s of none → none; some g → some (dnf-meet f g))
dnf-of (cjoin r s) = case dnf-of r of none → none; some f → (case dnf-of s of none → none; some g → some (dnf-join f g))
dnf-of c = none
