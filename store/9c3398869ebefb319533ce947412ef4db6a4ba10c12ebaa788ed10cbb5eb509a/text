-- nk-safe?: the test an executor runs before stepping two wires in either order, or at once
nk-safe? : NkSlots → Word → Word → Word → Word → Bool
nk-safe? sl u1 n1 u2 n2 =
  nk-and (nk-oks? (nk-plan-fx sl u1 n1) (nk-plan-fx sl u2 n2))
  (nk-and (nk-clear? u1 (nk-plan-fx sl u2 n2))
  (nk-and (nk-clear? (nk-rw (nk-get sl u1) u1) (nk-plan-fx sl u2 n2))
  (nk-and (nk-clear? u2 (nk-plan-fx sl u1 n1))
  (nk-clear? (nk-rw (nk-get sl u2) u2) (nk-plan-fx sl u1 n1)))))
