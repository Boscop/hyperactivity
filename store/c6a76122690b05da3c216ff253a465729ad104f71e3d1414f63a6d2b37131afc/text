fmap-lift : (n : Nat) (X X' : Type 1) (Y : X → Type 1) (F' F2 : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y))
  (h : (x' : X') → F' x' → F2 x') (c : Cube n X) (d : DCube n X Y c) →
  PathP (λ i → DCube n X' F2 (dcube-map n X Y X' f c d))
    (dcube-fmap n X' F' F2 h (dcube-map n X Y X' f c d) (dcube-lift n X X' Y F' f g c d)) (dcube-lift n X X' Y F2 f (λ x y → h (f x y) (g x y)) c d)
fmap-lift zero X X' Y F' F2 f g h c d = λ i → h (f c d) (g c d)
fmap-lift (suc n) X X' Y F' F2 f g h c d =
  fmap-lift n (Line X) (Line X') (LineO X Y) (LineO X' F') (LineO X' F2) (lineo-map X Y X' f) (lineo-lift X X' Y F' f g) (lineo-fmap X' F' F2 h) c d
