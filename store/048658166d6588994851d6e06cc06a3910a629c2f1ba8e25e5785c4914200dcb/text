<script>
(function(){
  document.getElementById('hxtheme').addEventListener('click',function(){
    var d=!document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('dark',d);
    try{localStorage.setItem('hxTheme',d?'dark':'light')}catch(e){}
    drawMan(); drawCP(); drawFHN(); drawDet();
  });
  function col(name){ return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }
  function setupCanvas(cv){
    var dpr=Math.min(window.devicePixelRatio||1,2), w=cv.clientWidth, h=cv.clientHeight;
    cv.width=Math.round(w*dpr); cv.height=Math.round(h*dpr);
    var ctx=cv.getContext('2d'); ctx.setTransform(dpr,0,0,dpr,0,0);
    return {ctx:ctx,w:w,h:h};
  }
  var manOutside=false;
  var manTarget=document.getElementById('manTarget'), manNull=document.getElementById('manNull');
  document.getElementById('btnManWithin').onclick=function(){ manOutside=false; this.classList.add('on'); document.getElementById('btnManOut').classList.remove('on'); drawMan(); };
  document.getElementById('btnManOut').onclick=function(){ manOutside=true; this.classList.add('on'); document.getElementById('btnManWithin').classList.remove('on'); drawMan(); };
  manTarget.oninput=drawMan; manNull.oninput=drawMan;
  function drawMan(){
    var s=setupCanvas(document.getElementById('manCanvas')), ctx=s.ctx, w=s.w, h=s.h;
    var y=manTarget.value/100, nf=manNull.value/100;
    document.getElementById('manTargetVal').textContent=y.toFixed(2);
    document.getElementById('manNullVal').textContent=nf.toFixed(2);
    var cx=w/2, cy=h/2, sc=Math.min(w,h)*0.38;
    ctx.clearRect(0,0,w,h);
    ctx.strokeStyle=col('--line'); ctx.lineWidth=1;
    ctx.beginPath(); ctx.moveTo(0,cy); ctx.lineTo(w,cy); ctx.moveTo(cx,0); ctx.lineTo(cx,h); ctx.stroke();
    ctx.strokeStyle=col('--blue'); ctx.lineWidth=4;
    ctx.beginPath(); ctx.moveTo(cx-sc*1.15,cy); ctx.lineTo(cx+sc*1.15,cy); ctx.stroke();
    ctx.fillStyle=col('--blue'); ctx.font='600 11px monospace'; ctx.fillText('Intrinsic manifold M (s₂ = 0)',12,cy-10);
    ctx.strokeStyle=col('--pink'); ctx.lineWidth=2; ctx.setLineDash([5,4]);
    ctx.beginPath();
    if(!manOutside){
      var px=cx+y*sc; ctx.moveTo(px,16); ctx.lineTo(px,h-16);
      ctx.stroke(); ctx.setLineDash([]);
      ctx.fillStyle=col('--blue'); ctx.beginPath(); ctx.arc(px,cy,6,0,Math.PI*2); ctx.fill();
      var ny=cy-nf*sc;
      ctx.fillStyle=col('--pink'); ctx.beginPath(); ctx.arc(px,ny,7,0,Math.PI*2); ctx.fill();
      ctx.fillStyle=col('--ink'); ctx.fillText('Fib_o(y) ∩ M ≠ ∅ (output y = '+y.toFixed(2)+' invariant)',12,22);
      var st=document.getElementById('manStatus'); st.textContent='WITHIN-MANIFOLD · REACHABLE'; st.className='badge ok';
    } else {
      var py=cy-y*sc; ctx.moveTo(16,py); ctx.lineTo(w-16,py);
      ctx.stroke(); ctx.setLineDash([]);
      var nx=cx+nf*sc;
      ctx.fillStyle=col('--pink'); ctx.beginPath(); ctx.arc(nx,py,7,0,Math.PI*2); ctx.fill();
      var empty=Math.abs(y)>0.06;
      ctx.fillStyle=empty?col('--red'):col('--green');
      ctx.fillText(empty?'Fib_d\'(y) ∩ M = ∅  (outside-manifold-impossible)':'y ≈ 0 lies on M',12,22);
      var st=document.getElementById('manStatus');
      st.textContent=empty?'OUTSIDE-MANIFOLD · EMPTY FIBER':'y ≈ 0 ON MANIFOLD';
      st.className='badge '+(empty?'bad':'ok');
    }
  }
  var cpSeeds=[[0.75,0.45],[-0.7,0.5],[0.4,-0.8],[-0.6,-0.55]];
  var cpCv=document.getElementById('cpCanvas');
  cpCv.addEventListener('click',function(ev){
    var r=cpCv.getBoundingClientRect(), x=(ev.clientX-r.left)/r.width*2.6-1.3, y=-(ev.clientY-r.top)/r.height*2.6+1.3;
    cpSeeds.push([x,y]); if(cpSeeds.length>12)cpSeeds.shift(); drawCP();
  });
  ['cpEb','cpEc','cpGm','cpAl'].forEach(function(id){ document.getElementById(id).oninput=drawCP; });
  function drawCP(){
    var s=setupCanvas(cpCv), ctx=s.ctx, w=s.w, h=s.h;
    var eb=cpEb.value/10, ec=cpEc.value/10, gm=cpGm.value/10, al=cpAl.value/10;
    cpEbVal.textContent=eb.toFixed(1); cpEcVal.textContent=ec.toFixed(1); cpGmVal.textContent=gm.toFixed(1); cpAlVal.textContent=al.toFixed(1);
    var stable=(eb*ec > gm*gm);
    var cbfOk=(2*eb>al && (2*eb-al)*(2*ec-al)>=4*gm*gm);
    var st=document.getElementById('cpStatus');
    if(cbfOk){ st.textContent='SOS STABLE · CBF SAFE'; st.className='badge ok'; }
    else if(stable){ st.textContent='SOS STABLE · CBF MARGIN < 0'; st.className='badge'; }
    else { st.textContent='RUNAWAY INSTABILITY (η_B η_C ≤ γ²)'; st.className='badge bad'; }
    var cx=w/2, cy=h/2, sc=Math.min(w,h)*0.38;
    ctx.clearRect(0,0,w,h);
    ctx.strokeStyle=col('--line'); ctx.lineWidth=1;
    ctx.beginPath(); ctx.moveTo(0,cy); ctx.lineTo(w,cy); ctx.moveTo(cx,0); ctx.lineTo(cx,h); ctx.stroke();
    ctx.strokeStyle=cbfOk?col('--green'):col('--red'); ctx.lineWidth=2; ctx.setLineDash([6,4]);
    ctx.beginPath(); ctx.arc(cx,cy,sc,0,Math.PI*2); ctx.stroke(); ctx.setLineDash([]);
    cpSeeds.forEach(function(pt){
      var x=pt[0], y=pt[1], dt=0.025;
      ctx.strokeStyle=stable?col('--blue'):col('--pink'); ctx.lineWidth=1.8;
      ctx.beginPath(); ctx.moveTo(cx+x*sc,cy-y*sc);
      for(var k=0;k<180;k++){
        var dx=-eb*x+gm*y, dy=gm*x-ec*y;
        x+=dx*dt; y+=dy*dt;
        if(x*x+y*y>9)break;
        ctx.lineTo(cx+x*sc,cy-y*sc);
      }
      ctx.stroke();
      ctx.fillStyle=col('--ink'); ctx.beginPath(); ctx.arc(cx+pt[0]*sc,cy-pt[1]*sc,3.5,0,Math.PI*2); ctx.fill();
    });
    ctx.fillStyle=col('--muted'); ctx.font='600 11px monospace';
    ctx.fillText('η_B·η_C − γ² = '+(eb*ec-gm*gm).toFixed(2)+'  |  CBF det = '+((2*eb-al)*(2*ec-al)-4*gm*gm).toFixed(2),10,18);
  }
  ['fhnI','fhnA','fhnB'].forEach(function(id){ document.getElementById(id).oninput=drawFHN; });
  function drawFHN(){
    var s=setupCanvas(document.getElementById('fhnCanvas')), ctx=s.ctx, w=s.w, h=s.h;
    var I=fhnI.value/100, a=fhnA.value/100, b=fhnB.value/100, eps=0.08;
    fhnIVal.textContent=I.toFixed(2); fhnAVal.textContent=a.toFixed(2); fhnBVal.textContent=b.toFixed(2);
    var cx=w/2, cy=h/2, sx=w/6.2, sy=h/5.0;
    ctx.clearRect(0,0,w,h);
    ctx.strokeStyle=col('--line'); ctx.lineWidth=1;
    ctx.beginPath(); ctx.moveTo(0,cy); ctx.lineTo(w,cy); ctx.moveTo(cx,0); ctx.lineTo(cx,h); ctx.stroke();
    ctx.strokeStyle=col('--blue'); ctx.lineWidth=1.5; ctx.beginPath();
    for(var px=0;px<w;px+=2){
      var v=(px-cx)/sx, wn=v-v*v*v/3+I, py=cy-wn*sy;
      if(px===0)ctx.moveTo(px,py); else ctx.lineTo(px,py);
    }
    ctx.stroke();
    ctx.strokeStyle=col('--muted'); ctx.setLineDash([4,4]); ctx.beginPath();
    ctx.moveTo(0,cy-((-3.1+a)/b)*sy); ctx.lineTo(w,cy-((3.1+a)/b)*sy); ctx.stroke(); ctx.setLineDash([]);
    var Rtrap=Math.sqrt(2.25 + Math.sqrt((81*b+24*b*I*I+12*a*a)/(16*b)));
    ctx.strokeStyle=col('--green'); ctx.lineWidth=1.5; ctx.setLineDash([5,4]);
    ctx.beginPath(); ctx.ellipse(cx,cy,Rtrap*sx,Rtrap*0.65*sy,0,0,Math.PI*2); ctx.stroke(); ctx.setLineDash([]);
    var v=-1.2, ww=-0.5, dt=0.05;
    ctx.strokeStyle=col('--pink'); ctx.lineWidth=2; ctx.beginPath();
    for(var k=0;k<1200;k++){
      var dv=v-v*v*v/3-ww+I, dw=eps*(v+a-b*ww);
      v+=dv*dt; ww+=dw*dt;
      if(k===100)ctx.moveTo(cx+v*sx,cy-ww*sy); else if(k>100)ctx.lineTo(cx+v*sx,cy-ww*sy);
    }
    ctx.stroke();
    ctx.fillStyle=col('--muted'); ctx.font='600 11px monospace';
    ctx.fillText('Blue: v-nullcline · Dashed: w-nullcline · Green: certified trapping bound',10,18);
  }
  var PAL={a:'#e53935',b:'#f9a825',c:'#66bb6a',d:'#795548',e:'#76ff03',f:'#1b5e20',g:'#2e7d32',h:'#ff0a94',i:'#1e88e5',j:'#1565c0',k:'#8e24aa',l:'#777',m:'#d32f2f',n:'#fbc02d',o:'#4fc3f7',p:'#ec407a',q:'#ab47bc',r:'#8d6e63',s:'#fdd835',t:'#43a047',u:'#f06292',v:'#ffee58',w:'#26a69a',x:'#9c27b0',y:'#fff176',z:'#bdbdbd'};
  function renderSyn(){
    var txt=document.getElementById('synInput').value, out=document.getElementById('synOut');
    out.innerHTML='';
    for(var i=0;i<txt.length;i++){
      var ch=txt[i], sp=document.createElement('span');
      sp.textContent=ch;
      var c=PAL[ch.toLowerCase()];
      if(c) sp.style.color=c;
      out.appendChild(sp);
    }
  }
  document.getElementById('synInput').oninput=renderSyn;
  document.getElementById('litPrev').oninput=drawDet;
  function drawDet(){
    var s=setupCanvas(document.getElementById('detCanvas')), ctx=s.ctx, w=s.w, h=s.h;
    var p=document.getElementById('litPrev').value/100;
    document.getElementById('litPrevVal').textContent=Math.round(p*100)+'%';
    var sig=Math.round(4*p*(1-p)*100);
    var b=document.getElementById('detBadge');
    b.textContent='DETECTOR SIGNAL: '+sig+'%';
    b.className='badge '+(sig===0?'bad':'ok');
    ctx.clearRect(0,0,w,h);
    ctx.strokeStyle=col('--line'); ctx.beginPath(); ctx.moveTo(30,h-24); ctx.lineTo(w-14,h-24); ctx.moveTo(30,14); ctx.lineTo(30,h-24); ctx.stroke();
    ctx.strokeStyle=col('--pink'); ctx.lineWidth=2.5; ctx.beginPath();
    for(var k=0;k<=100;k++){
      var pk=k/100, sk=4*pk*(1-pk);
      var x=30+pk*(w-44), y=(h-24)-sk*(h-42);
      if(k===0)ctx.moveTo(x,y); else ctx.lineTo(x,y);
    }
    ctx.stroke();
    var px=30+p*(w-44), py=(h-24)-(4*p*(1-p))*(h-42);
    ctx.fillStyle=col('--blue'); ctx.beginPath(); ctx.arc(px,py,6,0,Math.PI*2); ctx.fill();
    ctx.fillStyle=col('--muted'); ctx.font='600 11px monospace';
    ctx.fillText('Prevalence p → 100% (universal literacy): deviation detector = 0',36,22);
  }
  renderSyn(); drawMan(); drawCP(); drawFHN(); drawDet();
  window.addEventListener('resize',function(){ drawMan(); drawCP(); drawFHN(); drawDet(); });
})();
</script>
