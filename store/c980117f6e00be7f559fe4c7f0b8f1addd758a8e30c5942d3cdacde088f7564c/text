-- the searches, outside every proof: n halvings of [lo, hi]/2^20
pl-find : Nat → BQ → (List (List BQ) × List (List BQ)) × List (List (BQ × (BQ × BQ))) → Nat → BZ → BZ → BZ × BZ
pl-find k mu m n lo hi = case n of
  zero → (lo , hi)
  suc j → if eqb (fst (wt-crt (pl-blk mu (pl-q (bz-half (bz-add lo hi))) pl-l1 pl-p1 m))) k then pl-find k mu m j (bz-half (bz-add lo hi)) hi else pl-find k mu m j lo (bz-half (bz-add lo hi))
