-- ---------------------------------------------------------------- (6.8) reduction
data XpStep : (tu : XpExpr × XpExpr) → Type where
  xs-fst : (a b : XpExpr) → XpStep (xp-fst (xp-pair a b) , a)
  xs-snd : (a b : XpExpr) → XpStep (xp-snd (xp-pair a b) , b)
  xs-plus : (m n : Nat) → XpStep (xp-plus (xp-num m) (xp-num n) , xp-num (plus m n))
  xs-plus-l : (a a2 b : XpExpr) → XpStep (a , a2) → XpStep (xp-plus a b , xp-plus a2 b)
  xs-plus-r : (a b b2 : XpExpr) → XpStep (b , b2) → XpStep (xp-plus a b , xp-plus a b2)
  xs-pair-l : (a a2 b : XpExpr) → XpStep (a , a2) → XpStep (xp-pair a b , xp-pair a2 b)
  xs-pair-r : (a b b2 : XpExpr) → XpStep (b , b2) → XpStep (xp-pair a b , xp-pair a b2)
  xs-fst-c : (p p2 : XpExpr) → XpStep (p , p2) → XpStep (xp-fst p , xp-fst p2)
  xs-snd-c : (p p2 : XpExpr) → XpStep (p , p2) → XpStep (xp-snd p , xp-snd p2)
