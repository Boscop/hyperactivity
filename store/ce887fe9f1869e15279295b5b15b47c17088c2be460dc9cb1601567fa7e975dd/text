MachStep : {M X : Type} → (X → Proc {lzero} (NetSig M) X) → X → NView M X → Type
MachStep {M} {X} nx y vx = case vx of
  v-tau s → Unit
  _ → Path (NView M (Step (NetSig M) X)) (proc-view {M} {X} (to-step {NetSig M} {X} (mp-step {lzero} {M} {X} nx y vx)))
                                         (nview-map {M} {X} {Step (NetSig M) X} (λ z → to-step {NetSig M} {X} (nx z)) vx)
