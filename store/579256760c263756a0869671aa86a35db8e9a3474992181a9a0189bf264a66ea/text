    const tx = bx + bw + 28, tw = Math.max(180, W - tx - 20);
    ctx.fillStyle = hasConf ? pink : blue; ctx.font = '700 11.5px ui-monospace, Menlo, monospace';
    ctx.fillText(hasConf ? 'DOWNSTREAM SUBTREE: ANNIHILATED AT ROOT' : 'DOWNSTREAM SUBTREE: LIVE & REDUCING', tx, 24);

    // Draw 3-level binary tree
    const nodes = [
      { x: tx + tw * 0.5, y: 66 },
      { x: tx + tw * 0.25, y: 146 }, { x: tx + tw * 0.75, y: 146 },
      { x: tx + tw * 0.13, y: 236 }, { x: tx + tw * 0.37, y: 236 },
      { x: tx + tw * 0.63, y: 236 }, { x: tx + tw * 0.87, y: 236 }
    ];
    const edges = [[0,1],[0,2],[1,3],[1,4],[2,5],[2,6]];
    edges.forEach(([u, v]) => {
      ctx.strokeStyle = hasConf ? muted : blue;
