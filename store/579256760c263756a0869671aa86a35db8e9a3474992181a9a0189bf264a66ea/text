      ctx.lineWidth = hasConf ? 1 : 1.8;
      ctx.beginPath(); ctx.moveTo(nodes[u].x, nodes[u].y); ctx.lineTo(nodes[v].x, nodes[v].y); ctx.stroke();
    });
    ctx.setLineDash([]);
    nodes.forEach((n, i) => {
      const r = i === 0 ? 20 : 14;
      ctx.beginPath(); ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
      if (hasConf && i === 0) {
        ctx.fillStyle = pink; ctx.fill();
        ctx.fillStyle = '#fff'; ctx.font = '700 13px ui-monospace, Menlo, monospace'; ctx.textAlign = 'center';
        ctx.fillText('⊥', n.x, n.y + 5);
      } else if (hasConf) {
        ctx.fillStyle = bg; ctx.fill(); ctx.strokeStyle = muted; ctx.lineWidth = 1; ctx.stroke();
        ctx.fillStyle = muted; ctx.font = '700 10px ui-monospace, Menlo, monospace'; ctx.textAlign = 'center';
        ctx.fillText('×', n.x, n.y + 4);
      } else {
        const glow = (Math.floor(phase) % 7 === i);
        ctx.fillStyle = glow ? pink : (i === 0 ? blue : bg); ctx.fill();
        ctx.strokeStyle = i === 0 ? blue : pink; ctx.lineWidth = 1.6; ctx.stroke();
        ctx.fillStyle = (glow || i === 0) ? '#fff' : ink; ctx.font = '700 10px ui-monospace, Menlo, monospace'; ctx.textAlign = 'center';
        ctx.fillText(i === 0 ? '●═●' : `n${i}`, n.x, n.y + 4);
      }
      ctx.textAlign = 'left';
    });

    ctx.fillStyle = ink; ctx.font = '600 11.5px ui-monospace, Menlo, monospace';
