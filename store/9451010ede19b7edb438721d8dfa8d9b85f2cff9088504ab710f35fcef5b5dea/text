ce-brs-a : Lst Code → (Word → Code → List Word → List Word) → Word → Word → Word → List Word → List Word
ce-brs-a lnil f dd d k acc = acc
ce-brs-a (lcons br r) f dd d k acc =
  list-append "case " (list-append (ce-dec k) (list-append ": { " (list-append (ce-binds (toNat (x-nf dd k)) d #0)
    (list-append "r" (list-append (ce-dec d) (list-append " = "
      (f (%wadd d (x-nf dd k)) (x-strip (x-nf dd k) br) (list-append "; break; } " (ce-brs-a r f dd d (%wsucc k) acc)))))))))
