-- wire w is none of the wires a plan writes
nk-apart : Word → NkFx → Type
nk-apart w nkf-nil = Unit
nk-apart w (nkf-val k v r) = (%weq w k ≡ false) × ((%weq k w ≡ false) × nk-apart w r)
nk-apart w (nkf-op k o r) = (%weq w k ≡ false) × ((%weq k w ≡ false) × nk-apart w r)
nk-apart w (nkf-put k s r) = (%weq w k ≡ false) × ((%weq k w ≡ false) × nk-apart w r)
