hy-reasoned : List Word → List (List Word × List (List Word)) → List (List Word) → Proc W ((List (List Word)) × (List (List Word)))
hy-reasoned st t nil = ret (nil , nil)
hy-reasoned st t (cons n r) = bind (hy-stated st n) (λ s → bind (hy-reasoned st t r) (λ rest → ret (hy-reasoned-add t n s rest)))
