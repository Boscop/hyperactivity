v-state-of : VEnv → List Word → Sum Unit Nat → List Word
v-state-of env n (inr k) =
  let g = v-look-list n (ve-gtab env) in
  if andB (weq (fromNat k) #1) (h-not (v-empty g)) then "first"
  else if v-empty g then "last" else "ready"
v-state-of env n (inl u) =
  if andB (h-has n (ve-leaves env)) (h-not (v-empty (v-look-list n (ve-wtab env)))) then "waiting" else "goal"
