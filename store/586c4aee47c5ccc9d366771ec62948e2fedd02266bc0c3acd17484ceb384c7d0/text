-- text cut at every byte b: the pieces, in order (the last piece after the last b), in one pass:
-- each byte is consed once onto the piece it begins, Θ(1) a byte, nothing reversed
h-split : Word → List Word → List (List Word)
h-split b nil = cons nil nil
h-split b (cons x r) = if weq x b then cons nil (h-split b r) else h-split-on x (h-split b r)
