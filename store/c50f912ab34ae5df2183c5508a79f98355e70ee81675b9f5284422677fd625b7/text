record SynModalityKnot (A : Type) (B : Type) =
  { sm-fwd : A → B
  ; sm-bwd : B → A
  ; sm-ret : (a : A) → sm-bwd (sm-fwd a) ≡ a
  ; sm-sec : (b : B) → sm-fwd (sm-bwd b) ≡ b
  }

sm-id : (A : Type) → SynModalityKnot A A
sm-id A = SynModalityKnot
  { sm-fwd = λ a → a
  ; sm-bwd = λ a → a
  ; sm-ret = λ a → refl
  ; sm-sec = λ a → refl
  }

sm-dual : {A B : Type} → SynModalityKnot A B → SynModalityKnot B A
sm-dual k = SynModalityKnot
  { sm-fwd = sm-bwd k
  ; sm-bwd = sm-fwd k
  ; sm-ret = sm-sec k
  ; sm-sec = sm-ret k
  }

sm-path-trans : {A : Type} → {x y z : A} → x ≡ y → y ≡ z → x ≡ z
sm-path-trans {A} {x} {y} {z} p q =
  λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

sm-path-cong : {A B : Type} → (f : A → B) → {x y : A} → x ≡ y → f x ≡ f y
sm-path-cong f p = λ i → f (p i)

