record BoundaryProtocol (State : Type) =
  { bp-inv      : State → Bool
  ; bp-rewrite  : State → State
  ; bp-preserve : (s : State) → bp-inv s ≡ true → bp-inv (bp-rewrite s) ≡ true
  }

-- Iterate an autopoietic self-rewriting boundary protocol n times (n in Nat)
bp-iter : {S : Type} → (S → S) → Nat → S → S
bp-iter f zero s = s
bp-iter f (suc n) s = f (bp-iter f n s)

-- THEOREM 4 (UNIVERSAL AUTOPOIETIC INVARIANT CONSERVATION ACROSS ALL SCALES & STEPS):
-- For ANY boundary protocol and ANY horizon n in Nat (unbounded time / scale),
-- self-similar rewriting strictly conserves the local & distributed invariant!
bp-thm-autopoietic-conserves : {S : Type} → (P : BoundaryProtocol S) → (n : Nat) → (s : S) →
  bp-inv P s ≡ true → bp-inv P (bp-iter (bp-rewrite P) n s) ≡ true
bp-thm-autopoietic-conserves P zero s h = h
bp-thm-autopoietic-conserves P (suc n) s h =
  bp-preserve P (bp-iter (bp-rewrite P) n s) (bp-thm-autopoietic-conserves P n s h)

