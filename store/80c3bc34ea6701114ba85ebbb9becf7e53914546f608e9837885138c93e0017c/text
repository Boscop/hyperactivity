gals-state-eq : {St Ev : Type} → (step : St → Ev → St) → (st : St) → (ticks : List (Sum Ev Unit)) →
  gals-state step st ticks ≡ sync-state step st ticks
gals-state-eq step st nil = refl
gals-state-eq step st (cons tk rest) =
  case tk return (λ x → gals-state step st (cons x rest) ≡ sync-state step st (cons x rest)) of
    inl ev → gals-state-eq step (step st ev) rest
    inr u  → gals-state-eq step st rest
