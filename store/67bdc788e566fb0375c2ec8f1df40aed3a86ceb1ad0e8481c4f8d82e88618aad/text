bn-emit-akash-sdl : BnNodeSpec → List Word → List Word
bn-emit-akash-sdl (mk-bn-node nid prov tr gpus rl ep sp rate) bootTokHex =
  let asmBin = bn-compile-tier-primary tr #11 bn-demo-inet
      asmTag = bn-tier-asm-target tr
      asmHx  = list-append "sha256:" (h-hex (keccak256 asmBin))
  in h-concat
       (cons (bn-ln "version: '2.0'")
       (cons (bn-ln "services:")
       (cons (bn-ln (list-append "  " (list-append nid ":")))
       (cons (bn-ln (list-append "    image: ghcr.io/avikj/hyperactivity-brainnet-scratch@" asmHx))
       (cons (bn-ln "    env:")
       (cons (bn-ln (list-append "      - HX_BRAINNET_NODE=" nid))
       (cons (bn-ln (list-append "      - HX_TARGET_ASM=" asmTag))
       (cons (bn-ln (list-append "      - HX_SOVEREIGN_TOKEN=" bootTokHex))
       (cons (bn-ln "      - HX_FOUNDER_BENEFICIARY=0x4A50FBF0128E2679C42466A8cC1A9D230b08A26f")
       (cons (bn-ln "    expose:")
       (cons (bn-ln "      - port: 22")
       (cons (bn-ln "        as: 22")
       (cons (bn-ln "        to:")
       (cons (bn-ln "          - global: true")
       (cons (bn-ln "profiles:")
       (cons (bn-ln "  compute:")
       (cons (bn-ln (list-append "    " (list-append nid ":")))
       (cons (bn-ln "      resources:")
       (cons (bn-ln "        cpu: { units: 32 }")
       (cons (bn-ln "        memory: { size: 128Gi }")
       (cons (bn-ln "        storage: { size: 256Gi }")
       (cons (bn-ln "        gpu:")
       (cons (bn-ln (list-append "          units: " (h-decimal gpus)))
       (cons (bn-ln "          attributes:")
       (cons (bn-ln (list-append "            vendor: { nvidia: [ { model: " (list-append (bn-tier-akash-model tr) " } ] }")))
       (cons (bn-ln "  placement:")
       (cons (bn-ln "    akash:")
       (cons (bn-ln "      pricing:")
       (cons (bn-ln (list-append "        " (list-append nid (list-append ": { denom: ibc/USDC_BASE8453, amount: " (list-append (h-decimal rate) " }")))))
       (cons (bn-ln "deployment:")
       (cons (bn-ln (list-append "  " (list-append nid (list-append ": { akash: { profile: " (list-append nid ", count: 1 } }")))))
       nil)))))))))))))))))))))))))))))))
