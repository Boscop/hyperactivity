-- what a value is, apart from its parts: a closure's body, a number, a constructor, a blocked term
-- (a free variable, a variable introduced by quotation at a depth, an eliminator waiting on a
-- blocked value), a quoted body
data NkHd = hd-clo (b : NkTm) | hd-num (m : Word) | hd-con (c : Word) | hd-var (x : Word) | hd-lvl (l : Word) | hd-stuck (h : Word) | hd-q (t : NkTm)
