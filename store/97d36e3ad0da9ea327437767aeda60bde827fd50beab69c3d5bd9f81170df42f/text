-- 5. GENERIC FUNCTOR 2: CERTIFIED 7nm CALMA GDSII v6.0 PLACER (61 CELLS + ROUTING = 71 POLYS)
-- ============================================================================
ms-place-gates : Word → Word → List (Word × Word) → List Gds6Box → List Gds6Box
ms-place-gates _ _ nil tl = tl
ms-place-gates col row (cons _ gs) tl =
  let x = %wadd #1 (%wmul col #3)
      y = %wadd #2 (%wmul row #3)
  in cons (rect-to-gbox6 #10 #0 #100 (rect (toNat x) (toNat y) (toNat #2) (toNat #2)))
          (ms-place-gates (%wsucc col) row gs tl)
