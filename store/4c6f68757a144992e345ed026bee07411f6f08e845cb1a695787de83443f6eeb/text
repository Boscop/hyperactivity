kc-rhopi-step : Nat → Word → Word → Word → List UInt64 → List UInt64 → List UInt64
kc-rhopi-step zero    t x y st out = out
kc-rhopi-step (suc n) t x y st out =
  let nx   = y
      ny   = %wmod (%wadd (%wmul #2 x) (%wmul #3 y)) #5
      rot  = %wmod (%wdiv (%wmul (%wadd t #1) (%wadd t #2)) #2) #64
      srcI = %wadd x (%wmul #5 y)
      dstI = %wadd nx (%wmul #5 ny)
      val  = kc-rotl64 (kc-nth64 srcI st) rot
  in kc-rhopi-step n (%wadd t #1) nx ny st (kc-set64 dstI val out)
