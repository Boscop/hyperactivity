-- a product by (0, k) is a reversed scaling
zmul-negk : (x : Nat × Nat) → (k : Nat) → zmul x (zero , k) ≡ (snd (zsc x k) , fst (zsc x k))
zmul-negk x k = pairNN (plus (times (fst x) zero) (times (snd x) k)) (plus (times (fst x) k) (times (snd x) zero)) (times (snd x) k) (times (fst x) k)
  (congN (λ z → plus z (times (snd x) k)) (times-zero (fst x)))
  (transN (congN (plus (times (fst x) k)) (times-zero (snd x))) (plus-zero (times (fst x) k)))
