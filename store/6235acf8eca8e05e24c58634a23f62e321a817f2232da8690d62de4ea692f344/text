sg-decl-cf : Nat → List Word → Lst (List Word) → Lst NkSexp → (Code × Word) × (Lst (List Word) × Lst Code)
sg-decl-cf _ _ ds lnil = ((cuniv clzero , #0) , (ds , lnil))
sg-decl-cf cf dsym ds (lcons pk rest) =
  let it = sg-sx-items pk
      nm = sg-dc-bname #0 (sg-sx0 it)
      t0 = fst (sg-subst-self cf #0 dsym (sg-sx1 it) lnil)
      dt = fst (snd (sg-dc cf #0 #0 ds #0 t0 lnil))
      ct = fst (sg-tc cf #0 nk-nil ds #0 #0 #0 dt lnil)
      r = sg-decl-cf cf dsym (lcons nm ds) rest
  in ((cpi #2 ct (fst (fst r)) , %wsucc (snd (fst r))) , (fst (snd r) , lcons ct (snd (snd r))))
