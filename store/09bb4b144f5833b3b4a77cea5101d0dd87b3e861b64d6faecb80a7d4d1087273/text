-- THEOREM 2: UNIVERSAL SINGLE-STEP INTERACTION-NET REDUCTION SOUNDNESS OVER ALL INet & ALL env!
tw-thm-step-sound : (env : Word → Bool) → (n : INet) → in-eval env (in-step n) ≡ in-eval env n
tw-thm-step-sound env (in-wire _)    = refl
tw-thm-step-sound env in-era         = refl
tw-thm-step-sound env (in-con t a b) =
  web-trans-b (tw-lem-mk-con env t (in-step a) (in-step b))
              (λ i → in-opB t (tw-thm-step-sound env a i) (tw-thm-step-sound env b i))
tw-thm-step-sound env (in-dup l a b) =
  web-trans-b (tw-lem-mk-dup-go env l (in-step a) (in-step b) (%weq l #0) (%weq l #1) refl refl)
              (λ i → in-dupB l (tw-thm-step-sound env a i) (tw-thm-step-sound env b i))
