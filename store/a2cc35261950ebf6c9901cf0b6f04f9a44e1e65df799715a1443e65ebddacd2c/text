-- UNIVERSAL THEOREM 2B (ALL-DEPTH `k : Nat` METACIRCULAR SUPEROPTIMIZATION SOUNDNESS, 0 POSTULATES):
dm-thm-meta-tower-sound :
  (k : Nat) → (env : Word) → (e : INetExpr) →
  inet-eval env (dm-tower k superchip-opt e) ≡ inet-eval env e
dm-thm-meta-tower-sound zero    env e = refl
dm-thm-meta-tower-sound (suc k) env e =
  let ih   = dm-thm-meta-tower-sound k env e
      step = bn-thm-opt-sound env (dm-tower k superchip-opt e)
  in λ i → comp (λ j → Word)
       (λ j → [ i = 0 ↦ step (~ j) , i = 1 ↦ inet-eval env e ])
       (ih i)
