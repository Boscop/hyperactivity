-- at √V → 1, tr(σ_z h_e h_e^{-1}) = tr σ_z = 0: the two sides, weighted (d+2)/(d+1) and d/(d+1), cancel. Each alone is
-- −2J_z^{(e)}/(d+1) and +2J_z^{(e)}/(d+1), edge e's own spin, so the cancellation is not trivial.
sigma-unit : List Nat → Nat → List SQ → List SQ
sigma-unit ds e v = vec-plus (vec-scale ((suc (suc (exp-at e ds)) , suc (exp-at e ds)) , (zero , suc zero)) (sigma-re-plus e ds v))
  (if eqb (exp-at e ds) zero then zero-row (mons-count (mons0 ds)) else vec-scale ((exp-at e ds , suc (exp-at e ds)) , (zero , suc zero)) (sigma-re-minus e ds v))
