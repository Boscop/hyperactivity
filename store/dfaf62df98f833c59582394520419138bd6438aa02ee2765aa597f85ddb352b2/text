nk-upd-swap-at : (b2 b1 : Bool) (sl : NkSlots) (w1 w2 x : Word) (f1 f2 : NkSlot → NkSlot) → (%weq w1 w2 ≡ false) → (%weq w2 w1 ≡ false) → (%weq w2 x ≡ b2) → (%weq w1 x ≡ b1) → nk-get (nk-upd (nk-upd sl w1 f1) w2 f2) x ≡ nk-get (nk-upd (nk-upd sl w2 f2) w1 f1) x
nk-upd-swap-at true b1 sl w1 w2 x f1 f2 q12 q21 p2 p1 =
  cong (λ z → nk-get (nk-upd (nk-upd sl w1 f1) w2 f2) z) (sym (weq-sound w2 x p2))
  ∙ (nk-get-set (nk-upd sl w1 f1) w2 (f2 (nk-get (nk-upd sl w1 f1) w2))
  ∙ (cong f2 (nk-get-set-other sl w1 w2 (f1 (nk-get sl w1)) q12)
  ∙ (sym (nk-get-set sl w2 (f2 (nk-get sl w2)))
  ∙ (sym (nk-get-set-other (nk-upd sl w2 f2) w1 w2 (f1 (nk-get (nk-upd sl w2 f2) w1)) q12)
  ∙ cong (λ z → nk-get (nk-upd (nk-upd sl w2 f2) w1 f1) z) (weq-sound w2 x p2)))))
nk-upd-swap-at false true sl w1 w2 x f1 f2 q12 q21 p2 p1 =
  nk-get-set-other (nk-upd sl w1 f1) w2 x (f2 (nk-get (nk-upd sl w1 f1) w2)) p2
  ∙ (cong (λ z → nk-get (nk-upd sl w1 f1) z) (sym (weq-sound w1 x p1))
  ∙ (nk-get-set sl w1 (f1 (nk-get sl w1))
  ∙ (sym (cong f1 (nk-get-set-other sl w2 w1 (f2 (nk-get sl w2)) q21))
  ∙ (sym (nk-get-set (nk-upd sl w2 f2) w1 (f1 (nk-get (nk-upd sl w2 f2) w1)))
  ∙ cong (λ z → nk-get (nk-upd (nk-upd sl w2 f2) w1 f1) z) (weq-sound w1 x p1)))))
nk-upd-swap-at false false sl w1 w2 x f1 f2 q12 q21 p2 p1 =
  nk-get-set-other (nk-upd sl w1 f1) w2 x (f2 (nk-get (nk-upd sl w1 f1) w2)) p2
  ∙ (nk-get-set-other sl w1 x (f1 (nk-get sl w1)) p1
  ∙ (sym (nk-get-set-other sl w2 x (f2 (nk-get sl w2)) p2)
  ∙ sym (nk-get-set-other (nk-upd sl w2 f2) w1 x (f1 (nk-get (nk-upd sl w2 f2) w1)) p1)))
