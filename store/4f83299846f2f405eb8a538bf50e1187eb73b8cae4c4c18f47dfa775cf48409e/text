list-rev-acc-rev : {A : Type} → (xs acc : List A) → list-rev (list-rev-acc xs acc) ≡ list-append (list-rev acc) xs
list-rev-acc-rev {A} xs =
  case xs return (λ u → (acc : List A) → list-rev (list-rev-acc u acc) ≡ list-append (list-rev acc) u) of
    nil → λ acc → sym (cm-append-nil (list-rev acc))
    cons x r → λ acc →
      concat {lzero} {List A} {list-rev (list-rev-acc r (cons x acc))} {list-append (list-rev (cons x acc)) r} {list-append (list-rev acc) (cons x r)}
        (rec r (cons x acc))
        (concat {lzero} {List A} {list-append (list-rev-acc acc (cons x nil)) r} {list-append (list-append (list-rev acc) (cons x nil)) r} {list-append (list-rev acc) (cons x r)}
          (λ i → list-append (list-rev-acc-app acc (cons x nil) i) r)
          (cm-append-assoc (list-rev acc) (cons x nil) r))
