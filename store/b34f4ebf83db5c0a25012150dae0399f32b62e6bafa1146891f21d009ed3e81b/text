-- elimination in fixed point: each step gives its pivot and the multipliers below it (at scale t)
-- (the recursion follows the rows of the matrix it started from: one step for each)
dy-elimg : List (List BZ) → BZ → List (List BZ) → List (BZ × List BZ)
dy-elimg fuel t a = case fuel of
  nil → nil
  cons f0 fs → (case a of
    nil → nil
    cons r0 rs → cons (dy-hd r0 , ln-map (List BZ) BZ (λ row → dy-div (bz-mul t (dy-hd row)) (dy-hd r0)) rs) (dy-elimg fs t (dy-sub t (ln-map (List BZ) BZ (λ row → dy-div (bz-mul t (dy-hd row)) (dy-hd r0)) rs) rs (dy-tl r0))))
