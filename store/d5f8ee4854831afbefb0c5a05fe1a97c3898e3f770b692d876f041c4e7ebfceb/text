compile-silicon : {V : Type} → PdkSpec → (V → List Word) → Circ B0 B1 B2 V → SiliconBuild V
compile-silicon {V} tech vNames rtl =
  let optRtl = circ-opt {V} rtl
      svCode = fold {B0} {B1} {B2} {V} {List Word} sv-alg vNames optRtl
      gates  = tech-map {V} optRtl
      widths = nand-cell-widths {V} (pdk-cellW tech) gates
      cells  = place-row zero zero (pdk-cellH tech) (pdk-gap tech) widths
      gds    = gds-emit-rects (pdk-layer tech) cells
  in (optRtl , (svCode , (gates , (cells , gds))))
