  (hlz-line "]] error:&err];"
  (list-append "  id<MTLComputePipelineState> pZip = [dev newComputePipelineStateWithFunction:[lib newFunctionWithName:[NSString stringWithUTF8String:"
  (list-append (ce-qstr "hx_gemv_bf16_zip")
  (hlz-line "]] error:&err];"
  (hlz-line "  const uint32_t R = 4096, C = 4096; const size_t N = (size_t)R * C;"
  (hlz-line "  id<MTLBuffer> bW = [dev newBufferWithLength:N*2 options:MTLResourceStorageModeShared];"
  (hlz-line "  id<MTLBuffer> bX = [dev newBufferWithLength:C*4 options:MTLResourceStorageModeShared];"
  (hlz-line "  id<MTLBuffer> bY0 = [dev newBufferWithLength:R*4 options:MTLResourceStorageModeShared];"
  (hlz-line "  id<MTLBuffer> bY1 = [dev newBufferWithLength:R*4 options:MTLResourceStorageModeShared];"
  (hlz-line "  uint16_t *W = bW.contents; float *X = bX.contents;"
