  (hlz-line "      for (uint32_t j = 0; j < 4; j++) {"
  (hlz-line "        uint16_t w = W[r*C + c + j]; uint8_t ex = (w >> 7) & 255;"
  (hlz-line "        sm[r*C + c + j] = (uint8_t)(((w >> 8) & 128) | (w & 127));"
  (hlz-line "        uint8_t k = (ex == top[0]) ? 0 : ((ex == top[1]) ? 1 : ((ex == top[2]) ? 2 : 3));"
  (hlz-line "        code |= (k << (j * 2));"
  (hlz-line "        if (k == 3) { ec_tmp[esc_n] = (uint16_t)(c + j); ee_tmp[esc_n] = ex; esc_n++; }"
  (hlz-line "      }"
  (hlz-line "      ei[r*(C/4) + (c/4)] = code;"
  (hlz-line "    }"
  (hlz-line "  }"
  (hlz-line "  eo[R] = esc_n;"
  (hlz-line "  id<MTLBuffer> bEC = [dev newBufferWithBytes:ec_tmp length:(esc_n ? esc_n*2 : 4) options:MTLResourceStorageModeShared];"
  (hlz-line "  id<MTLBuffer> bEE = [dev newBufferWithBytes:ee_tmp length:(esc_n ? esc_n : 4) options:MTLResourceStorageModeShared];"
  (hlz-line "  size_t raw_bytes = N * 2, zip_bytes = N + N/4 + R*4 + (R+1)*4 + (size_t)esc_n * 3;"
  (hlz-line "  LlmDims dm = { R, C }; MTLSize gr = MTLSizeMake(R, 1, 1), grp = MTLSizeMake(128, 1, 1);"
  (hlz-line "  for (int w = 0; w < 3; w++) {"
  (hlz-line "    id<MTLCommandBuffer> c0 = [q commandBuffer]; id<MTLComputeCommandEncoder> e0 = [c0 computeCommandEncoder];"
  (hlz-line "    [e0 setComputePipelineState:pRaw]; [e0 setBuffer:bW offset:0 atIndex:0]; [e0 setBuffer:bX offset:0 atIndex:1]; [e0 setBuffer:bY0 offset:0 atIndex:2]; [e0 setBytes:&dm length:sizeof(dm) atIndex:3]; [e0 dispatchThreadgroups:gr threadsPerThreadgroup:grp]; [e0 endEncoding]; [c0 commit]; [c0 waitUntilCompleted];"
  (hlz-line "    id<MTLCommandBuffer> c1 = [q commandBuffer]; id<MTLComputeCommandEncoder> e1 = [c1 computeCommandEncoder];"
  (hlz-line "    [e1 setComputePipelineState:pZip]; [e1 setBuffer:bSM offset:0 atIndex:0]; [e1 setBuffer:bEI offset:0 atIndex:1]; [e1 setBuffer:bPal offset:0 atIndex:2]; [e1 setBuffer:bEO offset:0 atIndex:3]; [e1 setBuffer:bEC offset:0 atIndex:4]; [e1 setBuffer:bEE offset:0 atIndex:5]; [e1 setBuffer:bX offset:0 atIndex:6]; [e1 setBuffer:bY1 offset:0 atIndex:7]; [e1 setBytes:&dm length:sizeof(dm) atIndex:8]; [e1 dispatchThreadgroups:gr threadsPerThreadgroup:grp]; [e1 endEncoding]; [c1 commit]; [c1 waitUntilCompleted];"
  (hlz-line "  }"
  (hlz-line "  double t0 = now_ms();"
  (hlz-line "  id<MTLCommandBuffer> cb0 = [q commandBuffer]; id<MTLComputeCommandEncoder> enc0 = [cb0 computeCommandEncoder];"
  (hlz-line "  [enc0 setComputePipelineState:pRaw]; [enc0 setBuffer:bW offset:0 atIndex:0]; [enc0 setBuffer:bX offset:0 atIndex:1]; [enc0 setBuffer:bY0 offset:0 atIndex:2]; [enc0 setBytes:&dm length:sizeof(dm) atIndex:3];"
  (hlz-line "  for (int it = 0; it < 40; it++) [enc0 dispatchThreadgroups:gr threadsPerThreadgroup:grp];"
  (hlz-line "  [enc0 endEncoding]; [cb0 commit]; [cb0 waitUntilCompleted];"
  (hlz-line "  double raw_ms = (now_ms() - t0) / 40.0;"
  (hlz-line "  double t1 = now_ms();"
  (hlz-line "  id<MTLCommandBuffer> cb1 = [q commandBuffer]; id<MTLComputeCommandEncoder> enc1 = [cb1 computeCommandEncoder];"
  (hlz-line "  [enc1 setComputePipelineState:pZip]; [enc1 setBuffer:bSM offset:0 atIndex:0]; [enc1 setBuffer:bEI offset:0 atIndex:1]; [enc1 setBuffer:bPal offset:0 atIndex:2]; [enc1 setBuffer:bEO offset:0 atIndex:3]; [enc1 setBuffer:bEC offset:0 atIndex:4]; [enc1 setBuffer:bEE offset:0 atIndex:5]; [enc1 setBuffer:bX offset:0 atIndex:6]; [enc1 setBuffer:bY1 offset:0 atIndex:7]; [enc1 setBytes:&dm length:sizeof(dm) atIndex:8];"
  (hlz-line "  for (int it = 0; it < 40; it++) [enc1 dispatchThreadgroups:gr threadsPerThreadgroup:grp];"
