  (hlz-line ", raw_bytes/1e6, zip_bytes/1e6, (1.0 - (double)zip_bytes/raw_bytes)*100.0, 100.0*esc_n/N, raw_ms, raw_bytes/(raw_ms*1e6), zip_ms, raw_ms/zip_ms, raw_bytes/(zip_ms*1e6), max_err); putchar(10);"
  (hlz-line "  free(ec_tmp); free(ee_tmp); return max_err < 1e-5 ? 0 : 3;"
  (hlz-line "} }" nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
