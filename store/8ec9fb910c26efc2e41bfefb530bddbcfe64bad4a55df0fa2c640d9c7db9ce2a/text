  (hlz-line "  float *Y0 = bY0.contents, *Y1 = bY1.contents; double max_err = 0.0;"
  (hlz-line "  for (uint32_t r = 0; r < R; r++) { double e = fabs((double)Y0[r] - (double)Y1[r]); if (e > max_err) max_err = e; }"
