  (hlz-line "  for (uint32_t i = 0; i < C; i++) X[i] = sinf(i * 0.017f) * 0.5f;"
  (hlz-line "  for (size_t i = 0; i < N; i++) {"
  (hlz-line "    rng ^= rng >> 12; rng ^= rng << 25; rng ^= rng >> 27;"
  (hlz-line "    double u1 = ((rng & 0xFFFFFF) + 1.0) / 16777217.0;"
  (hlz-line "    double u2 = (((rng >> 24) & 0xFFFFFF) + 1.0) / 16777217.0;"
  (hlz-line "    float g = (float)(sqrt(-2.0 * log(u1)) * cos(6.2831853 * u2) * 0.02);"
  (hlz-line "    W[i] = f32_to_bf16(g);"
  (hlz-line "  }"
  (hlz-line "  id<MTLBuffer> bSM = [dev newBufferWithLength:N options:MTLResourceStorageModeShared];"
  (hlz-line "  id<MTLBuffer> bEI = [dev newBufferWithLength:N/4 options:MTLResourceStorageModeShared];"
  (hlz-line "  id<MTLBuffer> bPal = [dev newBufferWithLength:R*4 options:MTLResourceStorageModeShared];"
