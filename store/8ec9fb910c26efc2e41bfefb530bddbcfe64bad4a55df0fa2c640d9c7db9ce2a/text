  (hlz-line "typedef struct { uint32_t rows, cols; } LlmDims;"
  (hlz-line "static double now_ms(void) { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return ts.tv_sec * 1e3 + ts.tv_nsec * 1e-6; }"
  (hlz-line "static uint16_t f32_to_bf16(float f) { uint32_t u; memcpy(&u, &f, 4); return (uint16_t)(u >> 16); }"
  (hlz-line "int main(void) { @autoreleasepool {"
