-- a − b as a sum with −b: its difference parts against a's and b's
bz-sub-eq : (s1 : Bool) → (m1 : List Bool) → (s2 : Bool) → (m2 : List Bool) → bcanon m1 ≡ true → bcanon m2 ≡ true → plus (fst (zv (bz-add (s1 , m1) (bz-neg (s2 , m2))))) (plus (snd (zv (s1 , m1))) (fst (zv (s2 , m2)))) ≡ plus (plus (fst (zv (s1 , m1))) (snd (zv (s2 , m2)))) (snd (zv (bz-add (s1 , m1) (bz-neg (s2 , m2)))))
bz-sub-eq s1 m1 s2 m2 c1 c2 =
  transN (symN (congN (λ z → plus (fst (zv (bz-add (s1 , m1) (bz-neg (s2 , m2))))) (plus (snd (zv (s1 , m1))) z))
                 (sndNN (zv (bz-neg (s2 , m2))) (the (Nat × Nat) (snd (zv (s2 , m2)) , fst (zv (s2 , m2)))) (bz-neg-sound s2 m2))))
  (transN (bz-add-sound s1 m1 (fst (bz-neg (s2 , m2))) (snd (bz-neg (s2 , m2))) c1 (bz-neg-canon (s2 , m2) c2))
  (congN (λ z → plus (plus (fst (zv (s1 , m1))) z) (snd (zv (bz-add (s1 , m1) (bz-neg (s2 , m2))))))
    (fstNN (zv (bz-neg (s2 , m2))) (the (Nat × Nat) (snd (zv (s2 , m2)) , fst (zv (s2 , m2)))) (bz-neg-sound s2 m2))))
