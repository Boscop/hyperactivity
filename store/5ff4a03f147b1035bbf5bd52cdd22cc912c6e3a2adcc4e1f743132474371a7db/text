-- The numbers stay names: the scale S, its exponent n, p = m/S and A's bracket lh are variables pinned
-- by equations, so no check ever unfolds 2^48 into a count; only the certificate itself is computed.
pin-canon : (S : List Bool) → (n : Nat) → S ≡ bin-pow2 n → n ≡ 48 → bcanon S ≡ true
pin-canon S n pS pn = transport (λ i → Path Bool (bcanon (pS (~ i))) true) (transport (λ i → Path Bool (bcanon (bin-pow2 (pn (~ i)))) true) (λ j → true))
