-- ============================================================================
-- SECTION 1: KERNEL-CHECKED HEX PATH CODEC, WASM MAGIC & 0PX UI ALGEBRA PROOFS
-- ============================================================================

hos-nl : List Word
hos-nl = cons #10 nil

hos-tr : List Word → List Word
hos-tr nil         = nil
hos-tr (cons c cs) = cons (if %weq c #96 then #34 else c) (hos-tr cs)

hos-ql : List Word → List Word → List Word
hos-ql s tl = list-append (hos-tr s) (list-append hos-nl tl)

hos-cat : List (List Word) → List Word
hos-cat nil           = nil
hos-cat (cons xs xss) = list-append xs (hos-cat xss)

hos-tr-cat : List (List Word) → List Word
hos-tr-cat nil           = nil
hos-tr-cat (cons xs xss) = list-append (hos-tr xs) (hos-tr-cat xss)

-- Proof that backtick `#96` lowers bit-identically to ASCII quote `#34`:
hos-thm-quote-macro : hos-tr "a`b" ≡ cons #97 (cons #34 (cons #98 nil))
hos-thm-quote-macro = refl

hos-hex-nib : Word → Word
hos-hex-nib n =
  let v = %wand n #15
  in if %wlt v #10 then %wadd #48 v else %wadd #87 v

hos-unhex-nib : Word → Word
hos-unhex-nib c =
  if andB (%wlt #47 c) (%wlt c #58) then %wsub c #48
  else if andB (%wlt #96 c) (%wlt c #103) then %wadd #10 (%wsub c #97)
  else if andB (%wlt #64 c) (%wlt c #71) then %wadd #10 (%wsub c #65)
  else #0

hos-hex : List Word → List Word
hos-hex nil         = nil
hos-hex (cons b bs) =
  cons (hos-hex-nib (%wshr b #4))
  (cons (hos-hex-nib b) (hos-hex bs))

hos-unhex : List Word → List Word
hos-unhex nil                 = nil
hos-unhex (cons a nil)        = nil
hos-unhex (cons a (cons b r)) =
  cons (%wor (%wshl (hos-unhex-nib a) #4) (hos-unhex-nib b)) (hos-unhex r)

-- THEOREM 1: LOSSLESS `/source/text?path=<hex>` CODEC ROUNDTRIP FOR `cubical.wasm` MODULE LOADER BY `refl`!
hos-thm-hex-path-roundtrip :
  hos-unhex (hos-hex "lib/core.hypercubical") ≡ "lib/core.hypercubical"
hos-thm-hex-path-roundtrip = refl

hos-wasm-magic : List Word
hos-wasm-magic = cons #0 (cons #97 (cons #115 (cons #109 (cons #1 (cons #0 (cons #0 (cons #0 nil)))))))

hos-is-wasm : List Word → Bool
hos-is-wasm (cons b0 (cons b1 (cons b2 (cons b3 (cons v0 rs))))) =
  andB (%weq b0 #0) (andB (%weq b1 #97) (andB (%weq b2 #115) (andB (%weq b3 #109) (%weq v0 #1))))
hos-is-wasm xs = false

-- THEOREM 2: EXACT WEBASSEMBLY 1.0 BINARY HEADER VALIDATION BY `refl`!
hos-thm-wasm-magic : hos-is-wasm hos-wasm-magic ≡ true
hos-thm-wasm-magic = refl

-- THEOREM 3: EXACT LAFONT PRINCIPAL-PORT INTERACTION-NET REDEX LAWS BY `refl`!
hos-thm-redex-laws :
  andB (wire-is-active-redex pr-prin pr-prin)
