opt-not-le : {V : Type} → (x : Circ B0 B1 B2 V) →
  Path Bool (leB (circ-gates {B0} {B1} {B2} {V} (opt-not {V} x)) (suc (circ-gates {B0} {B1} {B2} {V} x))) true
opt-not-le {V} x =
  case x return (λ w → Path Bool (leB (circ-gates {B0} {B1} {B2} {V} (opt-not {V} w)) (suc (circ-gates {B0} {B1} {B2} {V} w))) true) of
    cwire v → λ _ → true
    cop0 c → opt-not-0-le V c
    cop1 u a → opt-not-1-le {V} u a
    cop2 b x1 x2 → leB-refl (suc (suc (plus (circ-gates x1) (circ-gates x2))))
