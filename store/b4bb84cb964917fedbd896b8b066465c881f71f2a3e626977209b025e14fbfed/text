s-public-answer : List Word → List Word → List Word → Proc W (List Word)
s-public-answer st m path =
  let p = h-before "?" path in
  s-public-core st m path p (
  s-public-treatises st p (
  s-public-api st m path p (
  if andB (h-prefix "/corpus/" path) (s-known (s-at-name (h-drop "/corpus" p) s-published))
  then s-kept-mod-public st "corpus" (s-corpus-work-path (s-at-name (h-drop "/corpus" p) s-published)) else
  if s-known (s-at-name p s-published)
  then s-kept-mod-public st "page" (s-corpus-work-path (s-at-name p s-published)) else
  if s-public-passthrough path p
  then s-answer st m path else
  ret {lzero} {W} (s-respond "404 Not Found" s-html s-not-found))))
