bl-fmt-pool : List Word → List Word → Word → List Word
bl-fmt-pool label adr pxU6 =
  h-concat
    (cons "  * " (cons label (cons " (" (cons adr
    (cons ") : $" (cons (h-decimal (%wdiv pxU6 #1000000))
    (cons "." (cons (h-decimal (%wmod pxU6 #1000000))
    (cons " USDC/WETH" (cons (cons #10 nil) nil))))))))))
