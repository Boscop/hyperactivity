-- reduced row echelon form over f columns from c: the pivots, each column with its row
rref : Nat → Nat → Rows → Pivots → Pivots
rref f c rs ps = case f of
  zero → ps
  suc g → (if rows-has c rs then rref-with c g (vec-scale (sq-inv (sq-nth c (rows-first c rs))) (rows-first c rs)) rs ps (rref g) else rref g (suc c) rs ps)
