nk-trim-susp-denotes : (rho : NkW → NkEv) (b : NkTm) (j : Word) (e : NkEnv) (o : NkOut) →
  (nk-ebound e (nk-n o) ≡ true) →
  nk-env-ev (nk-rho-trim rho b j e o) (nk-ws (nk-trim-susp b j e o))
  ≡ nk-trim-ev b j (nk-env-ev rho e)
nk-trim-susp-denotes rho b j nke-nil (nk-out fx n ws) hb = refl
nk-trim-susp-denotes rho b j (nke-cons w r) o hb =
  let hw = nk-and-l (nk-wire-lt w (nk-n o)) (nk-ebound r (nk-n o)) hb
      hr = nk-and-r (nk-wire-lt w (nk-n o)) (nk-ebound r (nk-n o)) hb
      bds = nk-trim-susp-bounds b (%wsucc j) r o hr
  in nk-trim-susp-denotes-step (nk-uses-var #0 j b) rho (nk-rho-trim rho b (%wsucc j) r o) b j w r (nk-trim-susp b (%wsucc j) r o)
       (nk-rho-trim-below rho b (%wsucc j) r o w hr hw)
       (snd bds)
       (nk-trim-susp-denotes rho b (%wsucc j) r o hr)
