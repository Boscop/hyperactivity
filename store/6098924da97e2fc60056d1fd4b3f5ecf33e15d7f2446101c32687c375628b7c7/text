-- a context with one more variable, of a type: its form at that type, in normal form
nk-ext : NkTm → Word → NkTm → NkTm
nk-ext ctx n a = nk-cons (nk-ent a (nk-norm-in (nk-cons (nk-ent a (nk-free n)) ctx) (%wsucc n) (nk-rfl (toNat #60) (nk-cons (nk-ent a (nk-free n)) ctx) (%wsucc n) a (nk-free n)))) ctx
