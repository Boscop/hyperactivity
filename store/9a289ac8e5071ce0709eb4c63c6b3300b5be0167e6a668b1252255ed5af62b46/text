-- the call of g on the r-th recursive field (field j), r lets down: AUX fv… field
x-hyp-call : Word → Lst Word → Word → Word → Word → Word → Word → Code
x-hyp-call g fv m nf r j extra =
  x-apps (cglob g) (l-app (x-param-vars fv m nf r extra #0) (lcons (cvar (%wadd r (%wsub (%wsub nf #1) j))) lnil))
