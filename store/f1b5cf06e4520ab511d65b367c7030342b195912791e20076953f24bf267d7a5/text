-- congruence in both arguments at once, which in a cubical setting is one line: both paths taken at the
-- same point of the interval
cong-species-situation : (h : Species → Situation → Nat) → (k1 : Species) → (k2 : Species) → k1 ≡ k2 → (s1 : Situation) → (s2 : Situation) → s1 ≡ s2 → h k1 s1 ≡ h k2 s2
cong-species-situation h k1 k2 q s1 s2 p = λ i → h (q i) (p i)
