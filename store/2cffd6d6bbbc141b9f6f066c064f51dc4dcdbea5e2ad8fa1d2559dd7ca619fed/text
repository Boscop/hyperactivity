-- (part of language-support)
imul_spec_8 : (dst' : Bits #8) → (src : Bits #8) → ((Bits #8) × (Bits #8) × (Bits #16) × (Bits #1))
imul_spec_8 dst' src =
  let dst_int : Bits #8
      dst_int = dst'
      src_int : Bits #8
      src_int = src
      product_int : Bits #16
      product_int = (bits_of_int (z-mul (bv-signed #8 dst_int) (bv-signed #8 src_int)) (zpos #16))
      product : Bits #16
      product = product_int
      product_high : Bits #8
      product_high = (bv-slice #16 product #15 #8)
      product_low : Bits #8
      product_low = (bv-slice #16 product #7 #0)
      product_low_int : Bits #8
      product_low_int = product_low
      cf_and_of : Bits #1
      cf_and_of = (bool_to_bits (b-not (weq (bv-sext #8 #16 product_low_int) product_int)))
  in (product_high , product_low , product , cf_and_of)
