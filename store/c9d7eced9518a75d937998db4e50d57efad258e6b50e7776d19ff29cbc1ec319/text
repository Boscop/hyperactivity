data RTerm
  = rt-goto (bb : Word)
  | rt-switch-int (op : ROperand) (arms : List RSwitchArm) (otherwise : Word)
  | rt-return
  | rt-unreachable
  | rt-call (f : RCallee) (args : List ROperand) (dest : RPlace) (target : Word) (unwind : RUnwind)
  | rt-assert (cond : ROperand) (expected : Bool) (msg : RAssertMsg) (target : Word) (unwind : RUnwind)
  | rt-drop (p : RPlace) (target : Word) (unwind : RUnwind)
