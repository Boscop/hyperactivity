nk-emem-eapp-l-at : (eq : Bool) (w x : NkW) (r b : NkEnv) →
  ((if eq then true else nk-emem w r) ≡ true) →
  ((nk-emem w r ≡ true) → nk-emem w (nk-eapp r b) ≡ true) →
  (if eq then true else nk-emem w (nk-eapp r b)) ≡ true
nk-emem-eapp-l-at true w x r b hm ih = refl
nk-emem-eapp-l-at false w x r b hm ih = ih hm
