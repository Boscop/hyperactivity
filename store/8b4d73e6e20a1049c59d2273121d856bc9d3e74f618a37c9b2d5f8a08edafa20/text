-- (part of language-support)
imul_spec_32 : (dst' : Bits #32) → (src : Bits #32) → ((Bits #32) × (Bits #32) × (Bits #64) × (Bits #1))
imul_spec_32 dst' src =
  let dst_int : Bits #32
      dst_int = dst'
      src_int : Bits #32
      src_int = src
      product_int : Bits #64
      product_int = (bits_of_int (z-mul (bv-signed #32 dst_int) (bv-signed #32 src_int)) (zpos #64))
      product : Bits #64
      product = product_int
      product_high : Bits #32
      product_high = (bv-slice #64 product #63 #32)
      product_low : Bits #32
      product_low = (bv-slice #64 product #31 #0)
      product_low_int : Bits #32
      product_low_int = product_low
      cf_and_of : Bits #1
      cf_and_of = (bool_to_bits (b-not (weq (bv-sext #32 #64 product_low_int) product_int)))
  in (product_high , product_low , product , cf_and_of)
