mesi-wr-swmr : (writer : Word) → (val : Nat) → (cl : MesiCluster) →
  (c1 c2 : Word) → weq c1 c2 ≡ false →
  mesi-is-excl (fst (snd (mesi-pr-wr writer val cl) c1)) ≡ true →
  fst (snd (mesi-pr-wr writer val cl) c2) ≡ m-inv
mesi-wr-swmr writer val cl c1 c2 hDisj hEx =
  swmr-wr-branch writer c1 c2 val
    (weq c1 writer) (weq c2 writer)
    (λ _ → weq c1 writer) (λ _ → weq c2 writer)
    hDisj hEx
