-- of the form and the vectors: F(0, x) = 0, F additive and homogeneous in its first argument, F symmetric, 0 + x = x and
-- (x + y) + w = x + (y + w) for vectors
sy-FL : (A V : Type) → (z : A) → (ad mu : A → A → A) → (vz : V) → (va : V → V → V) → (vs : A → V → V) → (f : V → V → A) → Type
sy-FL A V z ad mu vz va vs f = ((x : V) → f vz x ≡ z) × (((a b x : V) → f (va a b) x ≡ ad (f a x) (f b x)) × (((c : A) → (a x : V) → f (vs c a) x ≡ mu c (f a x)) × (((x y : V) → f x y ≡ f y x) × (((x : V) → va vz x ≡ x) × ((x y w : V) → va (va x y) w ≡ va x (va y w))))))
