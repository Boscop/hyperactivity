expand-lam-map-shift : (pre suf xs : List MTerm) →
                       expand-lam-list pre suf (list-map mterm-shift-app xs) ≡ xs
expand-lam-map-shift pre suf xs =
  case xs return (λ u → expand-lam-list pre suf (list-map mterm-shift-app u) ≡ u) of
    nil → λ i → nil
    cons t r →
      concat {lzero} {List MTerm}
        {list-append (expand-lam-cell pre suf (mterm-shift-app t)) (expand-lam-list pre suf (list-map mterm-shift-app r))}
        {list-append (cons t nil) r} {cons t r}
        (λ i → list-append (expand-lam-cell-shift pre suf t i) (rec r i))
        (λ i → cons t r)
