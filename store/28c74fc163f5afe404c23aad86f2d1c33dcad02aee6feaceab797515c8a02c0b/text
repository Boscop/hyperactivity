hadamard4-mix : QuadW → QuadW
hadamard4-mix (quad-w x0 x1 x2 x3) =
  let s01 = w32-add x0 x1; d01 = w32-sub x0 x1
      s23 = w32-add x2 x3; d23 = w32-sub x2 x3
  in quad-w (w32-asr1 (w32-add s01 s23))
            (w32-asr1 (w32-add d01 d23))
            (w32-asr1 (w32-sub s01 s23))
            (w32-asr1 (w32-sub d01 d23))
