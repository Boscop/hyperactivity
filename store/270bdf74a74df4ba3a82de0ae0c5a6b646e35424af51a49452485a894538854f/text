hm-run : List (List Word) → List (List Word × List Word) → List (List Word × List Word) → List (List Word × List Word) → Word → Word → List Word → (Word × Word) × List Word
hm-run nil b o t cnt conf out = ((cnt , conf) , out)
hm-run (cons k r) b o t cnt conf out =
  let res = hm-pick (hm-find k b) (hm-find k o) (hm-find k t)
      st2 = hm-emit-line k (fst res) (cnt , out)
  in hm-run r b o t (fst st2) (%wadd conf (snd res)) (snd st2)
