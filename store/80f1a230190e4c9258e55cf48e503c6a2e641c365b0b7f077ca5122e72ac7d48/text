-- ---------------------------------------------------------------- lists
take-drop : {A : Type} → (k : Nat) → (l : List A) → list-append (take-n k l) (drop-n k l) ≡ l
take-drop k =
  case k return λ w → (l : List A) → list-append (take-n w l) (drop-n w l) ≡ l of
    zero → λ l i → l
    suc k1 → λ l → (case l return λ v → list-append (take-n (suc k1) v) (drop-n (suc k1) v) ≡ v of nil → λ i → nil; cons x r → λ i → cons x (rec k1 r i))
