-- (part of language-support)
idiv_spec_16 : (dst' : Bits #32) → (src : Bits #16) → (Bool × (Bits #16) × (Bits #16))
idiv_spec_16 dst' src =
  let dst_int : Bits #32
      dst_int = dst'
      src_int : Bits #16
      src_int = src
      quotient_int : Bits #33
      quotient_int = (bits_of_int (z-tdiv (bv-signed #32 dst_int) (bv-signed #16 src_int)) (zpos #33))
      remainder_int : Bits #16
      remainder_int = (bits_of_int (z-tmod (bv-signed #32 dst_int) (bv-signed #16 src_int)) (zpos #16))
      overflow? : Bool
      overflow? = (b-or (z-lt (bv-signed #33 quotient_int) (zneg #32768)) (z-lt (zpos #32767) (bv-signed #33 quotient_int)))
      t'1 : (Bool × (Bits #16) × (Bits #16))
      t'1 =
        if overflow? then
          (true , #0 , #0)
        else
          (let quotient : Bits #16
               quotient = (bv-trunc #33 #16 quotient_int)
               remainder : Bits #16
               remainder = remainder_int
           in (overflow? , quotient , remainder))
  in t'1
