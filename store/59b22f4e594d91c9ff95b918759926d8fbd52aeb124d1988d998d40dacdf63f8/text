-- an integer value as 128 bits (extended by its kind's sign), and 128 bits wrapped to a kind:
-- the low bits kept, in canonical form. Every integer conversion is the second after the first
-- (modulo 2^N for an unsigned target; for a signed one the same, C++20's two's complement)
sv-int-dq : Bool → IW → SV → MRes DQ
sv-int-dq sg w v = case w of
  iw128 → sv-as-w v
  _ → mr-map (λ x → case sg of
                 true → dq-sx x
                 false → dq-zx x) (sv-as-i v)
