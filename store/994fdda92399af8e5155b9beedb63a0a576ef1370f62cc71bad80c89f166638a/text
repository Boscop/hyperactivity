-- B_kl for k from 0: xs in space 3; F̃ to space 4, E to space 5, ε contraction to space 6
b2-vw : Nat → Nat → VW → VM → Mons → Mons → VM → (List Nat → List Nat → SQ) → (List Nat → List Nat → SQ) → (List Nat → List Nat → SQ) → Rows → List (List Rows)
b2-vw n3 n6 w a3 ms4 ms5 a6 fent eent rent xs = case n3 of
  zero → nil
  suc g → cons (b2-row-vw n6 w a6 rent (coords-all (vw-frs (fst a6)) (rows-map-entry contr-entry (vw-ms (fst a6)) ms5 (rows-map-entry eent ms5 ms4 (rows-map-entry fent ms4 (vw-ms (fst a3)) (lift-all (mons-count (vw-ms (fst a3))) (vw-bs (fst a3)) xs)))))) (b2-vw g n6 w a3 ms4 ms5 a6 fent eent rent (rows-apply-all (snd a3) xs))
