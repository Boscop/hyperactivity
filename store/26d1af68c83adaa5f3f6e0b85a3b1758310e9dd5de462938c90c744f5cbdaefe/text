-- ============================================================================
-- 3. Coherent-State Peakedness / Ehrenfest Variance Decomposition
-- ============================================================================
-- For any state with first moment m1 = ⟨x⟩, second moment m2 = ⟨x²⟩, and classical target x0:
--   m2 - 2 x0 m1 + x0² = (m2 - m1²) + (m1 - x0)².
-- Proves semiclassical error around classical geometry x0 splits orthogonally into
-- intrinsic quantum variance (m2 - m1²) plus Ehrenfest mean-value bias (m1 - x0)².
-- Variables (0..2): m1, m2, x0.
lqg-coherent-var-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-coherent-var-poly A ad mu q vs =
  (λ g sub sq →
    let m1 = g 0; m2 = g 1; x0 = g 2
        q2 = q (fn-q 2 1)
        lhs = ad (sub m2 (mu q2 (mu x0 m1))) (sq x0)
        rhs = ad (sub m2 (sq m1)) (sq (sub m1 x0))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
