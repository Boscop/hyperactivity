-- ---------------------------------------------------------------- pointers
mp-eq : MPtr → MPtr → Bool
mp-eq p q = case p of
  mp-null → (case q of
    mp-null → true
    _ → false)
  mp-obj a o → (case q of
    mp-obj b o2 → m-and (weq a b) (weq o o2)
    _ → false)
  mp-fn f → (case q of
    mp-fn g → weq f g
    _ → false)
  mp-addr x → (case q of
    mp-addr y → weq x y
    _ → false)
