-- a text cut into runs: the names (and paths) a source can bind, and what lies between them
hi-toks : List Word → List Word → List (List Word)
hi-toks nil nil = nil
hi-toks nil (cons x r) = hi-toks (cons x nil) r
hi-toks (cons c cs) nil = cons (h-rev (cons c cs) nil) nil
hi-toks (cons c cs) (cons x r) = if hi-same (hi-ident-char c) (hi-ident-char x) then hi-toks (cons x (cons c cs)) r else cons (h-rev (cons c cs) nil) (hi-toks (cons x nil) r)
