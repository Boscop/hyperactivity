dm-read-peer-hxsv : List Word → Proc W (Word × (Word × Word))
dm-read-peer-hxsv path =
  bind (h-read path) (λ mr →
    case mr of
      inl u  → ret {lzero} {W} (#0 , (#0 , #0))
      inr bs →
        let vr = dm-verify-hxsv32 bs
        in if fst vr
           then ret {lzero} {W} (#1 , snd vr)
           else ret {lzero} {W} (#0 , (#0 , #0)))
