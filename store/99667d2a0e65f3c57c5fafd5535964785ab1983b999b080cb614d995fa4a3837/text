diag-exch-d : (sk : Lst Entry) (j j' : Word) (X : Type 1) (F : X → Type 1) (D : Cube (dims sk) (Line (Line X))) (d : DCube (dims sk) (Line (Line X)) (LineO (Line X) (LineO X F)) D) → DexD sk j j' X F D d
diag-exch-d lnil j j' X F D d = λ i → fst (fst d)
diag-exch-d (lcons (e-ty s) sk) j j' X F D d =
  %welimP (λ v → (v' : Word) → DexD (lcons (e-ty s) sk) v v' X F D d) j
    (λ v' → %welimP (λ u → DexD (lcons (e-ty s) sk) #0 u X F D d) v' (dexd-t00 sk s X F D d) (λ k' h' → dexd-t0S sk s k' X F D d))
    (λ k h v' → %welimP (λ u → DexD (lcons (e-ty s) sk) (%wsucc k) u X F D d) v' (dexd-tS0 sk s k X F D d) (λ k' h' → dexd-tSS sk s k k' (λ X' F' D' d' → diag-exch-d sk k k' X' F' D' d') X F D d))
    j'
diag-exch-d (lcons e-dim sk) j j' X F D d =
  %welimP (λ v → (v' : Word) → DexD (lcons e-dim sk) v v' X F D d) j
    (λ v' → %welimP (λ u → DexD (lcons e-dim sk) #0 u X F D d) v' (dexd-d00 sk X F D d) (λ k' h' → dexd-d0S sk k' X F D d))
    (λ k h v' → %welimP (λ u → DexD (lcons e-dim sk) (%wsucc k) u X F D d) v' (dexd-dS0 sk k X F D d) (λ k' h' → dexd-dSS sk k k' (λ X' F' D' d' → diag-exch-d sk k k' X' F' D' d') X F D d))
    j'
