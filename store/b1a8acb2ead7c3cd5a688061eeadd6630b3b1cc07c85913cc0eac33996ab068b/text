cs-ltw-step : (x y : Word) → (ltw x y ≡ true) → ltw x (%wsucc y) ≡ true
cs-ltw-step x y h =
  %welimP (λ u → (v : Word) → (ltw u v ≡ true) → ltw u (%wsucc v) ≡ true) x
    (λ v hv → refl)
    (λ n hn v →
       %welimP (λ w → (ltw (%wsucc n) w ≡ true) → ltw (%wsucc n) (%wsucc w) ≡ true) v
         (λ h0 → cs-no h0)
         (λ m hm hs → hn m hs))
    y h
