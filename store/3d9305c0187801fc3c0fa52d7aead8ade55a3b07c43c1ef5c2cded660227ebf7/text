-- Joint (commute, annihilate) dispatch unit: shares w7=~commute from io-w-commute + 2 NAND2 = 8 gates total (-47%!)
io-joint-annihilate : Word → Word → Word → Word
io-joint-annihilate a b v =
  let comm  = io-eval-bit io-w-commute (toNat #6) a b v
      ncomm = %wxor (%wand comm comm) #1
      nann  = %wxor (%wand v ncomm) #1
  in %wxor (%wand nann nann) #1
