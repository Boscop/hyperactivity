hxtp-sv-gates : Nat → Word → Word → List Word → List Word
hxtp-sv-gates zero _ _ tl = tl
hxtp-sv-gates (suc k) nw prog tl =
  let g = %wand prog #63
      i = %wshr g #3
      j = %wand g #7
  in list-append "  wire w" (list-append (ce-dec nw) (list-append " = ~(w" (list-append (ce-dec i) (list-append " & w" (list-append (ce-dec j) (list-append ");" (list-append ce-nl (hxtp-sv-gates k (%wsucc nw) (%wshr prog #6) tl))))))))
