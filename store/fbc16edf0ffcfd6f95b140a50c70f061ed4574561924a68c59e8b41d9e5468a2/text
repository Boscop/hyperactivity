-- ---------------------------------------------------------------- a first state
-- nothing mapped (fresh memory reads zero), addresses from 2^32, descriptors 0, 1, 2 as a read
-- end holding the given bytes and two write ends, the datagrams that will arrive, the clock at
-- the given time with a tick of one nanosecond, ephemeral ports from 32768, 4096-byte pages
k-boot : (pid : Word) → (now : Word) → (stdin : List Word) → (arriving : List Dgram) → KState
k-boot pid now stdin arriving =
  KState { k-mem = λ a → #0 ; k-regions = nil ; k-brk = #4294967296
         ; k-fds = cons (#0 , k-pipe-in stdin) (cons (#1 , k-pipe-out nil) (cons (#2 , k-pipe-out nil) nil))
         ; k-net = arriving ; k-sent = nil ; k-clock = now ; k-tick = #1
         ; k-eph = #32768 ; k-page = #4096 ; k-pid = pid ; k-exit = inr unit }
