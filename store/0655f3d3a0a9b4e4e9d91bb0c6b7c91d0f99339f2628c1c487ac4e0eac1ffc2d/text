s-sha256 : List Word → Proc W (Word × List Word)
s-sha256 file = h-capture (cons "/bin/sh" (cons "-c" (cons "IFS=; sha256sum $1 2>/dev/null || shasum -a 256 $1" (cons "_" (cons file nil)))))
