-- positive after scaling by q ≥ 1 means positive
zpos-unscale : (X : Nat × Nat) → (q : Nat) → zpos (zsc X q) → zpos X
zpos-unscale X q h = zpos-or-np X (zpos X) (λ p → p)
  (λ np → le-sz-absurd (zpos X) zero (zle-trans (the (Nat × Nat) (suc zero , zero)) (zsc X q) (the (Nat × Nat) (zero , zero)) h (zle-scale X (the (Nat × Nat) (zero , zero)) q np)))
