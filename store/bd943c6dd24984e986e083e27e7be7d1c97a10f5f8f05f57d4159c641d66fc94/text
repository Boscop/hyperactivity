s-changes-from : Word → Word → List (List Word) → List Word
s-changes-from since i nil = nil
s-changes-from since i (cons l r) = list-append (if wlt since i then h-line (list-append (h-decimal i) (list-append " " l)) else nil) (s-changes-from since (wadd i #1) r)







s-changes : List Word → List Word → Proc W (List Word)
