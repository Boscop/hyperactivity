  let h = s-param "h" q in let k = s-param "k" q in
  if s-valid-obj-ref h k then bind (h-read (h-object-path h k)) (λ r → ret {lzero} {W} (s-object-of r))
  else ret {lzero} {W} (s-respond "400 Bad Request" "text/plain" "invalid object ref")







-- GET /source/entries?since=N: every entry this server holds, each line a number and the entry's hash.
-- The number is the line's place in the answer, and the answer holds them all: a session takes the ones
-- it lacks (it checks each against its own pool first, lib/host.cub h-take-if), so correctness does not
-- turn on the order, while numbering by a place in a listing and then skipping what is below `since`
-- would lose an entry that the listing happens to order earlier than one already taken
s-entry-lines : Word → List (List Word) → List Word
s-entry-lines n nil = nil
s-entry-lines n (cons i r) =
  if h-eq i "." then s-entry-lines n r else
  if h-eq i ".." then s-entry-lines n r else
  list-append (h-line (list-append (h-decimal n) (list-append " " i))) (s-entry-lines (wadd n #1) r)







s-entries : Proc W (List Word)
s-entries = bind (h-list (list-append h-source "/entries")) (λ ids → ret (s-response "text/plain" (s-entry-lines #1 ids)))







-- POST /source/object?h=H&k=K, the object's bytes as the body: the object taken into this server's pool
-- through the machine's --put, which answers only when the hash is the content's, so a session can
-- publish what this server lacks and nothing it names can be anything other than what it is
