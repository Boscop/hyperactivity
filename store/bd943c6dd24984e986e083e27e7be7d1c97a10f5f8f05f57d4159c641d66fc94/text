s-upto-cons : Word → Sum Unit (List Word × List Word) → Sum Unit (List Word × List Word)
s-upto-cons x (inl u) = inl unit
s-upto-cons x (inr p) = inr (cons x (fst p) , snd p)







s-upto : Word → List Word → Sum Unit (List Word × List Word)
s-upto b nil = inl unit
s-upto b (cons x r) = if weq x b then inr (nil , r) else s-upto-cons x (s-upto b r)







-- *italic*: a star not after a word character or a star, a run without a star or newline, a star not
-- before one
s-word : Word → Bool
s-word b = orB (orB (andB (wlt #47 b) (wlt b #58)) (andB (wlt #64 b) (wlt b #91))) (orB (andB (wlt #96 b) (wlt b #123)) (orB (weq b #95) (wlt #127 b)))







-- links: [text](url), and a bare http(s) address not already inside a link or after a word character
s-url-stop : Word → Bool
s-url-stop b = orB (orB (weq b #32) (weq b #10)) (orB (weq b #60) (weq b #41))







s-punct : Word → Bool
s-punct b = orB (orB (weq b #46) (weq b #44)) (orB (weq b #59) (weq b #58))







-- a run to a byte: none (the text, given back whole) or the text before it and the text after
data MdTo = to-none (all : List Word) | to-at (before : List Word) (after : List Word)







md-to-cons : Word → MdTo → MdTo
md-to-cons x (to-none a) = to-none (cons x a)
md-to-cons x (to-at a c) = to-at (cons x a) c







-- the text up to the byte b; stopped by the byte c first, there is none
md-to : Word → Word → List Word → MdTo
md-to b c nil = to-none nil
md-to b c (cons x r) = if weq x b then to-at nil r else if weq x c then to-none (cons x r) else md-to-cons x (md-to b c r)







-- an address: the bytes up to a space, a newline, < or )
md-stop : List Word → MdTo
md-stop nil = to-at nil nil
md-stop (cons x r) = if s-url-stop x then to-at nil (cons x r) else md-to-cons x (md-stop r)







-- an address and its trailing punctuation, which belongs to the sentence
md-tr-x : Word → MdTo → MdTo
md-tr-x x (to-at nil d) = if s-punct x then to-at nil (cons x d) else to-at (cons x nil) d
md-tr-x x (to-at (cons y a) d) = to-at (cons x (cons y a)) d
md-tr-x x (to-none a) = to-none (cons x a)







md-tr : List Word → MdTo
md-tr nil = to-at nil nil
md-tr (cons x r) = md-tr-x x (md-tr r)







-- `code`: its text escaped and nothing more read in it
md-code : (Bool → Word → List Word → List Word) → Bool → MdTo → List Word
md-code k lk (to-none t) = cons #96 (k lk #96 t)
md-code k lk (to-at nil c) = cons #96 (k lk #96 (cons #96 c))
md-code k lk (to-at (cons z a) c) = list-append "<code>" (list-append (s-esc (cons z a)) (list-append "</code>" (k lk #96 c)))







-- **bold**: two stars, a run without a star, two stars
md-bold-c : (Bool → Word → List Word → List Word) → Bool → List Word → List Word → List Word
md-bold-c k lk a nil = list-append "**" (k lk #42 (list-append a "*"))
md-bold-c k lk a (cons y c) = if weq y #42 then list-append "<b>" (list-append (k lk #32 a) (list-append "</b>" (k lk #42 c))) else list-append "**" (k lk #42 (list-append a (cons #42 (cons y c))))







md-bold : (Bool → Word → List Word → List Word) → Bool → MdTo → List Word
md-bold k lk (to-none t) = list-append "**" (k lk #42 t)
md-bold k lk (to-at nil c) = list-append "**" (k lk #42 (cons #42 c))
md-bold k lk (to-at (cons z a) c) = md-bold-c k lk (cons z a) c







-- *italic*: a star not after a word character or a star, a run without a star, a star not before a
-- word character or a star
md-ital-c : (Bool → Word → List Word → List Word) → Bool → List Word → List Word → List Word
md-ital-c k lk a nil = list-append "<i>" (list-append (k lk #32 a) "</i>")
md-ital-c k lk a (cons z c) = if h-not (orB (s-word z) (weq z #42)) then list-append "<i>" (list-append (k lk #32 a) (list-append "</i>" (k lk #42 (cons z c)))) else cons #42 (k lk #42 (list-append a (cons #42 (cons z c))))







md-ital : (Bool → Word → List Word → List Word) → Bool → MdTo → List Word
md-ital k lk (to-none t) = cons #42 (k lk #42 t)
md-ital k lk (to-at nil c) = cons #42 (k lk #42 (cons #42 c))
md-ital k lk (to-at (cons z a) c) = md-ital-c k lk (cons z a) c







md-star : (Bool → Word → List Word → List Word) → Bool → Word → List Word → List Word
md-star k lk p nil = "*"
md-star k lk p (cons y r) = if weq y #42 then md-bold k lk (md-to #42 #42 r) else if h-not (orB (s-word p) (weq p #42)) then md-ital k lk (md-to #42 #42 (cons y r)) else cons #42 (k lk #42 (cons y r))







-- []{#id}: an anchor a link can reach (Pandoc's empty span)
md-anch-id : (Bool → Word → List Word → List Word) → Bool → MdTo → List Word
md-anch-id k lk (to-none t) = list-append "[]{#" (k lk #35 t)
md-anch-id k lk (to-at i c) = list-append "<span id='" (list-append (s-esc i) (list-append "'></span>" (k lk #125 c)))







md-anch : (Bool → Word → List Word → List Word) → Bool → List Word → List Word
md-anch k lk (cons a (cons b r)) = if andB (weq a #123) (weq b #35) then md-anch-id k lk (md-to #125 #125 r) else list-append "[]" (k lk #93 (cons a (cons b r)))
md-anch k lk t = list-append "[]" (k lk #93 t)







-- [text](url): its text read with no address made a link inside it
md-link-u : (Bool → Word → List Word → List Word) → Bool → List Word → MdTo → List Word
md-link-u k lk a (to-none t) = cons #91 (k lk #91 (list-append a (cons #93 (cons #40 t))))
md-link-u k lk a (to-at nil c) = cons #91 (k lk #91 (list-append a (cons #93 (cons #40 (cons #41 c)))))
md-link-u k lk a (to-at (cons z u) c) = list-append "<a href='" (list-append (s-esc (cons z u)) (list-append "'>" (list-append (k false #32 a) (list-append "</a>" (k lk #41 c)))))







md-link : (Bool → Word → List Word → List Word) → Bool → MdTo → List Word
md-link k lk (to-none t) = cons #91 (k lk #91 t)
md-link k lk (to-at a nil) = cons #91 (k lk #91 (list-append a "]"))
md-link k lk (to-at a (cons z c)) = if weq z #40 then md-link-u k lk a (md-to #41 #41 c) else cons #91 (k lk #91 (list-append a (cons #93 (cons z c))))







md-bracket : (Bool → Word → List Word → List Word) → Bool → List Word → List Word
md-bracket k lk nil = "["
md-bracket k lk (cons y r) = if weq y #93 then md-anch k lk r else md-link k lk (md-to #93 #91 (cons y r))







-- a bare http(s) address, not after a word character, = or ', becomes a link to itself
md-bare : (Bool → Word → List Word → List Word) → Bool → MdTo → List Word → List Word
md-bare k lk (to-at a d) c = list-append "<a href='" (list-append (s-esc a) (list-append "'>" (list-append (s-esc a) (list-append "</a>" (k lk #32 (list-append d c))))))
md-bare k lk (to-none a) c = k lk #32 (list-append a c)







md-url : (Bool → Word → List Word → List Word) → Bool → MdTo → List Word
md-url k lk (to-at u c) = if orB (h-prefix "ttps://" u) (h-prefix "ttp://" u) then md-bare k lk (md-tr (cons #104 u)) c else cons #104 (k lk #104 (list-append u c))
md-url k lk (to-none t) = cons #104 (k lk #104 t)







-- a paragraph's text as HTML, in one pass: each byte escaped or opening a mark; a mark's run is found
-- by one scan (md-to), which stops at the first byte that ends it, so a byte is scanned by at most one
-- mark of each kind and made once; the fuel (f) only bounds the passes the machine counts as recursion
-- (lk: whether an address may become a link; p: the byte before)
md-i : Nat → Bool → Word → List Word → List Word
md-i zero lk p t = s-esc t
md-i (suc f) lk p nil = nil
md-i (suc f) lk p (cons x r) =
  if weq x #96 then md-code (md-i f) lk (md-to #96 #96 r) else
  if weq x #42 then md-star (md-i f) lk p r else
  if weq x #91 then md-bracket (md-i f) lk r else
  if andB lk (andB (weq x #104) (h-not (orB (weq p #61) (orB (weq p #39) (s-word p))))) then md-url (md-i f) lk (md-stop r) else
  list-append (s-esc (cons x nil)) (md-i f lk x r)







md-fuel : Nat
md-fuel = toNat #4294967296







-- a paragraph's text as HTML: one pass over its bytes (md-i)
s-inline : List Word → List Word
s-inline t = md-i md-fuel true #32 t









h-sep-words : List (List Word) → List Word
h-sep-words nil = nil
h-sep-words (cons x nil) = x
h-sep-words (cons x (cons y r)) = list-append x (cons #32 (h-sep-words (cons y r)))







h-rev-lists : List (List Word) → List (List Word) → List (List Word)
h-rev-lists nil acc = acc
h-rev-lists (cons x r) acc = h-rev-lists r (cons x acc)







-- a quote's paragraphs: its lines between blank ones
s-quote-paras : List (List Word) → List (List Word) → List (List Word)
s-quote-paras cur nil = if h-null (h-concat cur) then nil else cons (h-sep-words (h-rev-lists cur nil)) nil
s-quote-paras cur (cons q r) = if h-null q then (if h-null (h-concat cur) then s-quote-paras nil r else cons (h-sep-words (h-rev-lists cur nil)) (s-quote-paras nil r)) else s-quote-paras (cons q cur) r







-- text without spaces at either end
s-strip : List Word → List Word
s-strip l = h-rev (h-trim (h-rev (h-trim l) nil)) nil







s-hashes : List Word → Nat
s-hashes nil = zero
s-hashes (cons x r) = if weq x #35 then suc (s-hashes r) else zero







s-space-start : List Word → Bool
s-space-start nil = false
s-space-start (cons x r) = orB (weq x #32) (weq x #9)







s-heading-at : Nat → List Word → Nat
s-heading-at zero l = zero
s-heading-at (suc k) l = if andB (wlt (fromNat (suc k)) #5) (s-space-start (h-drop-n (suc k) l)) then suc k else zero







s-heading : List Word → Nat
s-heading l = s-heading-at (s-hashes l) l







-- a list item: - or * or a number and a dot, then spaces
s-digits : List Word → List Word
s-digits nil = nil
s-digits (cons x r) = if andB (wlt #47 x) (wlt x #58) then s-digits r else cons x r







s-item-at : List Word → Sum Unit (List Word)
s-item-at nil = inl unit
s-item-at (cons x r) = if andB (orB (weq x #45) (weq x #42)) (s-space-start r) then inr (h-trim r)
  else if andB (andB (wlt #47 x) (wlt x #58)) (h-prefix "." (s-digits r)) then (if s-space-start (h-drop "." (s-digits r)) then inr (h-trim (h-drop "." (s-digits r))) else inl unit) else inl unit







s-item : List Word → Sum Unit (List Word)
s-item l = s-item-at (h-trim l)







v-join-lines : List (List Word) → List Word
v-join-lines nil = nil
v-join-lines (cons x nil) = x
v-join-lines (cons x (cons y r)) = list-append x (cons #10 (v-join-lines (cons y r)))







-- a heading, with its anchor when it names one (Pandoc's "# Title {#id}"), so a link to #id reaches it
s-h : Nat → List Word → List Word
s-h n t = list-append "<h" (list-append (h-decimal (fromNat n)) (list-append (if h-infix " {#" t then list-append " id='" (list-append (h-before "}" (h-after " {#" t)) "'") else nil) (list-append ">" (list-append (if h-infix " {#" t then h-before " {#" t else t) (list-append "</h" (list-append (h-decimal (fromNat n)) ">"))))))







s-h-anchor : Path (List Word) (s-h (suc zero) "Part I {#part-i}") "<h1 id='part-i'>Part I</h1>"
s-h-anchor = refl







-- a table, written with pipes (| a | b |, then a rule | --- | --- |, then its rows): the run of lines that begin "|"
s-table-rows : List (List Word) → List (List Word)
s-table-rows nil = nil
s-table-rows (cons l r) = if h-prefix "|" (h-trim l) then cons l (s-table-rows r) else nil







s-table-rest : List (List Word) → List (List Word)
s-table-rest nil = nil
s-table-rest (cons l r) = if h-prefix "|" (h-trim l) then s-table-rest r else cons l r







-- the pieces between a row's pipes: the text before its first pipe and after its last are not cells
s-cells-inner : List (List Word) → List (List Word)
s-cells-inner nil = nil
s-cells-inner (cons x nil) = if h-null (h-trim x) then nil else cons x nil
s-cells-inner (cons x (cons y r)) = cons x (s-cells-inner (cons y r))







-- a row's cells: the pieces between its pipes (none before the first; the text after the last is not a cell), each stripped of spaces at both ends
s-cells : List Word → List (List Word)
s-cells l = list-map s-strip (s-cells-inner (h-split #124 (h-drop "|" (h-trim l))))







-- the rule under the header: every cell made of dashes, colons and spaces
s-dashes : List Word → Bool
s-dashes nil = true
s-dashes (cons c r) = if orB (weq c #45) (orB (weq c #58) (weq c #32)) then s-dashes r else false







s-rule : List (List Word) → Bool
s-rule nil = true
s-rule (cons c r) = andB (h-not (h-null c)) (andB (s-dashes c) (s-rule r))







s-row-cells : List Word → List (List Word) → List Word
s-row-cells t nil = nil
s-row-cells t (cons c r) = h-concat (cons "<" (cons t (cons ">" (cons (s-inline c) (cons "</" (cons t (cons ">" (cons (s-row-cells t r) nil))))))))







s-rows : List (List Word) → List Word
s-rows nil = nil
s-rows (cons l r) = list-append "<tr>" (list-append (s-row-cells "td" (s-cells l)) (list-append "</tr>" (s-rows r)))







s-no-rule : List (List Word) → List (List Word)
s-no-rule nil = nil
s-no-rule (cons l r) = if s-rule (s-cells l) then r else cons l r







-- the table: its first row the header, the rule dropped, the rest its body
s-table : List (List Word) → List Word
s-table nil = nil
s-table (cons h r) = h-concat (cons "<div class='table'><table><thead><tr>" (cons (s-row-cells "th" (s-cells h)) (cons "</tr></thead><tbody>" (cons (s-rows (s-no-rule r)) (cons "</tbody></table></div>" nil)))))







