s-request : Bool → List Word → List Word → Sum Unit (List Word) → List Word → Proc W (List Word)
s-request pub st m tok req =
  if h-prefix "PUT " req then (
    let p = h-before " " (h-drop "PUT " (h-before (cons #13 nil) req)) in
    if s-allowed pub tok req then (
      if h-prefix "/roots/" p then s-put-root st m (h-drop "/roots/" (h-before "?" p)) (h-after (list-append h-crlf h-crlf) req)
      else ret {lzero} {W} (s-respond "404 Not Found" "text/plain" "not found"))
    else ret {lzero} {W} (s-respond "403 Forbidden" "text/plain" "this server is read-only"))
  else if h-prefix "POST " req then (
    let p = h-before " " (h-drop "POST " (h-before (cons #13 nil) req)) in
    if um-send-path p then um-send req
    else if orB (h-eq (h-before "?" p) "/api/this") (h-eq (h-before "?" p) "/api/oracle") then bind (this-handle-post (h-after (list-append h-crlf h-crlf) req)) (λ j → ret {lzero} {W} (s-response "application/json" j))
    else if h-eq (h-before "?" p) "/api/trace" then s-trace-post st (h-after (list-append h-crlf h-crlf) req)
    else if h-prefix "/api/p2p/signal" p then s-p2p-signal-body st (s-query p) (h-after (list-append h-crlf h-crlf) req)
    else if h-eq (h-before "?" p) "/dht/announce" then s-dht-announce pub st (h-after (list-append h-crlf h-crlf) req)
    else if h-eq (h-before "?" p) "/dht/provide" then s-dht-provide pub st (h-after (list-append h-crlf h-crlf) req)
    else if s-allowed pub tok req then s-post st m p req
    else if h-eq (h-before "?" p) "/peer/reduce" then bind (h-env "HYPERACTIVE_PEER_COMPUTE") (λ pc → case pc of
      inr v → (if h-null v then ret {lzero} {W} (s-respond "403 Forbidden" "text/plain" "peer compute not enabled") else s-peer-reduce st m (h-after (list-append h-crlf h-crlf) req))
      inl u → ret {lzero} {W} (s-respond "403 Forbidden" "text/plain" "peer compute requires token or HYPERACTIVE_PEER_COMPUTE=1"))
    else ret {lzero} {W} (s-respond "403 Forbidden" "text/plain" "this server is read-only"))
  else if h-not (orB (h-prefix "GET " req) (h-prefix "HEAD " req)) then ret {lzero} {W} (s-respond "405 Method Not Allowed" "text/plain" "method not allowed")
  else if s-redirect-onrender pub req then ret {lzero} {W} (s-to-canonical req)
  else if andB pub (andB (s-views-path (s-request-path req)) (h-not (s-allowed pub tok req))) then ret {lzero} {W} s-to-front
  else if andB pub (andB (s-withheld (s-request-path req)) (h-not (s-allowed pub tok req))) then ret {lzero} {W} (s-respond "404 Not Found" s-html s-not-found)
  else if andB pub (h-not (s-allowed pub tok req)) then s-public-answer st m (s-request-path req)
  else s-answer st m (s-request-path req)









-- the socket: port, listening on 127.0.0.1, or on every address when HYPERACTIVE_PUBLIC is set
s-addr-bytes : Bool → Word → List Word
s-addr-bytes pub port = cons #2 (cons #0 (cons (wshr port #8) (cons (wand port #255) (if pub then cons #0 (cons #0 (cons #0 (cons #0 nil))) else cons #127 (cons #0 (cons #0 (cons #1 nil)))))))







s-addr : Bool → Word → Proc W Word
s-addr pub port = bind (alloc-bytes #16) (λ a → bind (h-poke a (s-addr-bytes pub port)) (λ u → ret a))







s-listen : Bool → Word → Proc W Word
s-listen pub port = bind (sys-call #41 #2 #1 #0 #0 #0 #0) (λ fd → bind (alloc-bytes #4) (λ one → bind (store8-at one #1) (λ u →
  bind (sys-call #54 fd #1 #2 one #4 #0) (λ o → bind (s-addr pub port) (λ a → bind (sys-call #49 fd a #16 #0 #0 #0) (λ b →
  bind (sys-call #50 fd #128 #0 #0 #0 #0) (λ l → ret {lzero} {W} (if orB (wlt #9223372036854775807 b) (wlt #9223372036854775807 l) then #18446744073709551615 else fd))))))))









