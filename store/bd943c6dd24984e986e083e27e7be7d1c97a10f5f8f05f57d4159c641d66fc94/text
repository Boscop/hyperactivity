hi-link : List Word → List Word → Proc W (List Word)
hi-link rd nil = ret nil
hi-link rd (cons x r) = if orB (h-not (hi-ident-char x)) (h-null (hi-core (cons x r))) then ret {lzero} {W} (s-esc (cons x r)) else
  bind (hi-bound (hi-core (cons x r))) (λ b → ret (if b then list-append (hi-a rd (hi-core (cons x r)) (hi-core (cons x r))) (s-esc (h-drop-n (list-length (hi-core (cons x r))) (cons x r))) else s-esc (cons x r)))







hi-each : List (List Word) → (List Word → Proc W (List Word)) → Proc W (List Word)
hi-each nil k = ret nil
hi-each (cons x r) k = bind (k x) (λ a → bind (hi-each r k) (λ b → ret (list-append a b)))







-- the names among a text's tokens (each token's core, when the token is made of name characters)
hi-cores : List (List Word) → List (List Word)
hi-cores nil = nil
hi-cores (cons nil r) = hi-cores r
hi-cores (cons (cons c cs) r) = if orB (h-not (hi-ident-char c)) (h-null (hi-core (cons c cs))) then hi-cores r else cons (hi-core (cons c cs)) (hi-cores r)







-- a sorted list with each run of equal entries kept once
hi-uniq : List (List Word) → List (List Word)
hi-uniq nil = nil
hi-uniq (cons x nil) = cons x nil
hi-uniq (cons x (cons y r)) = if h-eq x y then hi-uniq (cons y r) else cons x (hi-uniq (cons y r))







-- of the names, those the source binds (or holds a module or document at)
hi-bound-of : List (List Word) → Proc W (List (List Word))
hi-bound-of nil = ret nil
hi-bound-of (cons n r) = bind (hi-bound n) (λ b → bind (hi-bound-of r) (λ rest → ret (if b then cons n rest else rest)))







-- a token as the page shows it, given the names the source binds
hi-link-in : List Word → List (List Word) → List Word → List Word
hi-link-in rd bs nil = nil
hi-link-in rd bs (cons x r) = if orB (h-not (hi-ident-char x)) (h-null (hi-core (cons x r))) then s-esc (cons x r) else
  if h-has (hi-core (cons x r)) bs then list-append (hi-a rd (hi-core (cons x r)) (hi-core (cons x r))) (s-esc (h-drop-n (list-length (hi-core (cons x r))) (cons x r))) else s-esc (cons x r)







hi-link-in-example : hi-link-in "r" (cons "a-b" nil) "a-b." ≡ list-append (hi-a "r" "a-b" "a-b") "."
hi-link-in-example = refl







hi-uniq-example : hi-uniq (h-msort (cons "b" (cons "a" (cons "b" (cons "a" nil))))) ≡ cons "a" (cons "b" nil)
hi-uniq-example = refl







-- a text with every name the source binds made a way into it: each distinct name looked up once (a text of
-- 531 name tokens is a few dozen distinct names), then every token drawn
hi-linked : List Word → List Word → Proc W (List Word)
hi-linked rd t = bind (hi-bound-of (hi-uniq (h-msort (hi-cores (hi-toks nil t))))) (λ bs → ret (h-concat (list-map (hi-link-in rd bs) (hi-toks nil t))))







hi-pre : List Word → List Word → Proc W (List Word)
hi-pre rd t = bind (hi-linked rd t) (λ x → ret (list-append "<pre>" (list-append x "</pre>")))







-- the workflow's relations, from STORE/views/nodes: each node and what it is part of
hi-rows : List Word → List (List (List Word))
hi-rows t = list-map (h-split #32) (h-lines t)







hi-first : List (List Word) → List Word
hi-first nil = nil
hi-first (cons x r) = x







hi-parents : List (List (List Word)) → List Word → List (List Word)
hi-parents nil f = nil
hi-parents (cons row r) f = if h-eq (hi-first row) f then h-tail-lists row else hi-parents r f







hi-children : List (List (List Word)) → List Word → List (List Word)
hi-children nil f = nil
hi-children (cons row r) f = if h-has f (h-tail-lists row) then cons (hi-first row) (hi-children r f) else hi-children r f







hi-rows-example : List (List (List Word))
hi-rows-example = hi-rows (h-concat (cons (h-line "a") (cons (h-line "b a") (cons (h-line "c a b") nil))))







hi-parents-example : hi-parents hi-rows-example "c" ≡ cons "a" (cons "b" nil)
hi-parents-example = refl







hi-children-example : hi-children hi-rows-example "a" ≡ cons "b" (cons "c" nil)
hi-children-example = refl







hi-around : List (List (List Word)) → List Word → List (List Word)
hi-around rows n = list-append (hi-parents rows n) (hi-children rows n)







hi-outside : List (List Word) → List (List Word) → List (List Word)
hi-outside ex nil = nil
hi-outside ex (cons x r) = if h-has x ex then hi-outside ex r else cons x (hi-outside ex r)







hi-show : List Word → List Word → Proc W (Sum Unit (List Word))
hi-show st n = h-read (list-append st (list-append "/views/show-" (h-hex n)))







hi-sentence : Sum Unit (List Word) → List Word
hi-sentence s = h-trim (hi-first (h-tail-lists (h-lines (s-or nil s))))







-- each value's own transition name, so a value moving between scenes is drawn moving
hi-vt : List Word → List Word
hi-vt n = list-append "view-transition-name:v" (h-hex n)







hi-card : List Word → List Word → List Word → Proc W (List Word)
hi-card st rd n = bind (hi-show st n) (λ s → ret (h-concat (cons "<div class='card' style='" (cons (hi-vt n) (cons "'>" (cons (hi-a rd n n) (cons "<div class='s'>" (cons (s-esc (hi-sentence s)) (cons "</div></div>" nil)))))))))







hi-chip : List Word → List Word → List Word
hi-chip rd n = list-append "<span class='chip'>" (list-append (hi-a rd n n) "</span>")







hi-sect : List Word → List Word → List Word
hi-sect label x = if h-null x then nil else h-concat (cons "<div class='label'>" (cons label (cons "</div><div class='row'>" (cons x (cons "</div>" nil)))))







-- what each node holds as essential context, as lines "DOCUMENT NODE": every essential-context line of a node's
-- view, direct or inherited ("essential context: DOC  (from NODE)")
hi-ctx-lines : List Word → List (List Word) → List (List Word)
hi-ctx-lines n nil = nil
hi-ctx-lines n (cons l r) = if h-infix "essential context: " l then cons (list-append (h-before "  " (h-after "essential context: " l)) (cons #32 n)) (hi-ctx-lines n r) else hi-ctx-lines n r







hi-ctx-lines-example : hi-ctx-lines "a" (cons "  essential context: docs/x.md  (from b)" (cons "  part of b" nil)) ≡ cons "docs/x.md a" nil
hi-ctx-lines-example = refl







hi-ctx-build : List Word → List (List Word) → Proc W (List (List Word))
hi-ctx-build st nil = ret nil
hi-ctx-build st (cons n r) = bind (hi-show st n) (λ s → bind (hi-ctx-build st r) (λ rest → ret (list-append (hi-ctx-lines n (h-lines (s-or nil s))) rest)))







-- the index kept in the store (STORE/hi/context-STAMP), made once for each state of the views (views/stamp) and
-- read whole after
hi-ctx-or : List Word → List (List Word) → List Word → Sum Unit (List Word) → Proc W (List (List Word))
hi-ctx-or st ns s (inr t) = ret (h-lines t)
hi-ctx-or st ns s (inl u) = bind (hi-ctx-build st ns) (λ es → bind (h-mkdir (list-append st "/hi")) (λ m →
  bind (h-write (list-append st (list-append "/hi/context-" (h-hex s))) (h-concat (list-map h-line es))) (λ w → ret es)))







hi-ctx-index : List Word → List (List Word) → Proc W (List (List Word))
hi-ctx-index st ns = bind (h-read (list-append st "/views/stamp")) (λ s → bind (h-read (list-append st (list-append "/hi/context-" (h-hex (s-or nil s))))) (λ ix → hi-ctx-or st ns (s-or nil s) ix))







-- the nodes the index gives a document as essential context of
hi-ctx-nodes : List Word → List (List Word) → List (List Word)
hi-ctx-nodes f nil = nil
hi-ctx-nodes f (cons e r) = if h-eq (h-before " " e) f then cons (h-after " " e) (hi-ctx-nodes f r) else hi-ctx-nodes f r







-- the nodes a document is essential context of, from the index
hi-context-of : List Word → List Word → List Word → List (List Word) → Proc W (List Word)
hi-context-of st rd f ns = bind (hi-ctx-index st ns) (λ ix → hi-each (hi-uniq (h-msort (hi-ctx-nodes f ix))) (hi-card st rd))







hi-piece : Sum Unit (List Word) → Proc W (Sum Unit (List Word))
hi-piece (inl u) = ret (inl unit)
hi-piece (inr h) = h-read (list-append h-source (cons #47 (list-append (h-before (cons #10 nil) h) "/text")))







-- a name's code: the piece the source has written for it, withholding any name bound in a module under private/
hi-code : List Word → Proc W (Sum Unit (List Word))
hi-code n = bind (h-read (list-append h-index (list-append "/module-of/" (h-hex n)))) (λ mod →
  if h-infix "private/" (s-or nil mod) then ret {lzero} {W} (inl unit)
  else bind (h-read (list-append h-index (list-append "/written/" (h-hex n)))) hi-piece)







-- a selection essay (lib/selection.cub) as it reads: the lines of its source piece, NAME-source = lines-of
-- (cons "line" ...), a line holding quotation marks given as (quoted (cons "stretch" ...)), joined by them.
-- The state: outside a quoted line, or inside one with its open parentheses counted and its text so far
s-q-join : Sum Unit (List Word) → List Word → List Word
s-q-join (inl u) s = s
s-q-join (inr a) s = list-append a (cons #34 s)







s-src-str : (Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)) → Sum Unit (Nat × Sum Unit (List Word)) → Sum Unit (List Word × List Word) → List (List Word)
s-src-str k q (inl u) = nil
s-src-str k (inl u) (inr p) = cons (fst p) (k (inl unit) (snd p))
s-src-str k (inr g) (inr p) = k (inr (fst g , inr (s-q-join (snd g) (fst p)))) (snd p)







-- a citation in an essay's source, (cite NAME "words") (lib/selection.cub), as the page draws it: the words,
-- linked to NAME's place in the human interface. The reference is the definition the checker resolved, so
-- the link cannot point at nothing; the words are exactly what every projection of the text shows (cite-shows).
s-cite-md : List Word → List Word → List Word
s-cite-md n w = h-concat (cons "[" (cons w (cons "](" (cons (hi-href nil n) (cons ")" nil)))))







s-src-cite-at : (Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)) → List Word → Sum Unit (List Word × List Word) → List (List Word)
s-src-cite-at k n (inl u) = k (inl unit) nil
s-src-cite-at k n (inr p) = cons (s-cite-md n (fst p)) (k (inl unit) (snd p))







s-src-cite-q : (Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)) → List Word → Sum Unit (List Word × List Word) → List (List Word)
s-src-cite-q k n (inl u) = k (inl unit) nil
s-src-cite-q k n (inr p) = s-src-cite-at k n (s-upto #34 (snd p))







-- after "(cite ": the cited name up to the space, then the quoted words
s-src-cite : (Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)) → Sum Unit (List Word × List Word) → List (List Word)
s-src-cite k (inl u) = k (inl unit) nil
s-src-cite k (inr p) = s-src-cite-q k (fst p) (s-upto #34 (snd p))







s-src-open : (Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)) → Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)
s-src-open k (inl u) r = if h-prefix "quoted" r then k (inr (suc zero , inl unit)) r else if h-prefix "cite " r then s-src-cite k (s-upto #32 (h-drop "cite " r)) else k (inl u) r
s-src-open k (inr g) r = k (inr (suc (fst g) , snd g)) r







s-src-close-at : (Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)) → Nat → Sum Unit (List Word) → List Word → List (List Word)
s-src-close-at k zero a r = k (inl unit) r
s-src-close-at k (suc zero) a r = cons (s-or nil a) (k (inl unit) r)
s-src-close-at k (suc (suc n)) a r = k (inr (suc n , a)) r







s-src-close : (Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)) → Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)
s-src-close k (inl u) r = k (inl u) r
s-src-close k (inr g) r = s-src-close-at k (fst g) (snd g) r







s-src-lines : Nat → Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)
s-src-lines zero q t = nil
s-src-lines (suc f) q nil = nil
s-src-lines (suc f) q (cons x r) = if weq x #34 then s-src-str (s-src-lines f) q (s-upto #34 r)
  else if weq x #40 then s-src-open (s-src-lines f) q r else if weq x #41 then s-src-close (s-src-lines f) q r else s-src-lines f q r







s-src-example-in : List Word
s-src-example-in = h-concat (cons "x = lines-of (cons " (cons (cons #34 nil) (cons "# T" (cons (cons #34 nil) (cons " (cons (quoted (cons " (cons (cons #34 nil) (cons "a " (cons (cons #34 nil) (cons " (cons " (cons (cons #34 nil) (cons "b" (cons (cons #34 nil) (cons " nil))) nil))" nil)))))))))))))







-- the lines are read back exactly, a quoted line with its quotation mark
s-src-lines-example : Path (List (List Word)) (s-src-lines (toNat #400) (inl unit) s-src-example-in) (cons "# T" (cons (list-append "a " (cons #34 "b")) nil))
s-src-lines-example = refl







s-src-cite-example-in : List Word
s-src-cite-example-in = h-concat (cons "x = lines-of (cons " (cons (cons #34 nil) (cons "a" (cons (cons #34 nil) (cons " (cons (cite s10-5-p2 " (cons (cons #34 nil) (cons "the words" (cons (cons #34 nil) (cons ") nil))" nil)))))))))







-- a citation is drawn as its words linked to the cited definition, and the lines around it are kept
