-- Markdown read as one left-to-right pass over its bytes (Avik, 2026-11-18: "this is just fucking
-- expanding a basic language isomorphic to a subset of html into html"). A line is cut off the text
-- (md-cut), classed by its first bytes (md-kind-of), and joined to the open block or closing it
-- (md-step); a block's HTML is made when it closes (md-close). Each list is used once in each
-- clause, so no part of the text is shared (shared, a list is boxed and read through references one
-- level at a time): the document's text is read once, and what is held at any point is the open
-- block, its line, and the output not yet written
data MdB = mb-none | mb-para (ls : List (List Word)) | mb-quote (ls : List (List Word)) | mb-list (items : List (List (List Word))) | mb-table (rows : List (List Word)) | mb-code (ls : List (List Word))







-- what a line is, by its first bytes: a fence, a table row, a heading (its level and text), a quote's
-- line, a list item, a rule, a blank line, or text (stripped; whether it was indented, continuing an item)
data MdLk = lk-fence | lk-row (l : List Word) | lk-head (n : Nat) (t : List Word) | lk-quote (q : List Word) | lk-item (i : List Word) | lk-hr | lk-blank | lk-text (s : List Word) (cont : Bool)







md-kt : List Word → Bool → MdLk
md-kt s c = if h-eq s "---" then lk-hr else if h-null s then lk-blank else lk-text s c







md-ki : List Word → Sum Unit (List Word) → MdLk
md-ki l (inr i) = lk-item i
md-ki l (inl u) = md-kt (s-strip l) (h-prefix "  " l)







md-kl : List Word → Nat → MdLk
md-kl l zero = if h-prefix ">" l then lk-quote (s-strip (h-drop ">" l)) else md-ki l (s-item l)
md-kl l (suc k) = lk-head (suc k) (h-trim (h-drop-n (suc k) l))







-- what a line is: read from its first bytes
md-kind-of : List Word → MdLk
md-kind-of l = if h-prefix "```" l then lk-fence else if h-prefix "|" (h-trim l) then lk-row l else md-kl l (s-heading l)







md-rev : {A : Type} → List A → List A → List A
md-rev nil acc = acc
md-rev (cons x r) acc = md-rev r (cons x acc)







md-more : List (List (List Word)) → List Word → List (List (List Word))
md-more nil s = nil
md-more (cons i is) s = cons (cons s i) is







md-p : List Word → List Word
md-p t = list-append "<p>" (list-append (s-inline t) "</p>")







md-li : List (List Word) → List Word
md-li i = list-append "<li>" (list-append (s-inline (h-sep-words (md-rev i nil))) "</li>")







md-pre : List (List Word) → List Word
md-pre ls = list-append "<pre>" (list-append (s-esc (v-join-lines (md-rev ls nil))) "</pre>")







-- a block's HTML, made when it closes (its lines are held reversed, each added in one step)
md-close : MdB → List Word
md-close mb-none = nil
md-close (mb-para ls) = md-p (h-sep-words (md-rev ls nil))
md-close (mb-quote ls) = list-append "<blockquote>" (list-append (h-concat (list-map md-p (s-quote-paras nil (md-rev ls nil)))) "</blockquote>")
md-close (mb-list is) = list-append "<ul>" (list-append (h-concat (list-map md-li (md-rev is nil))) "</ul>")
md-close (mb-table rs) = s-table (md-rev rs nil)
md-close (mb-code ls) = md-pre ls







-- one line read: the HTML of the block it closes, and the block left open
data MdS = md-s (out : List Word) (left : MdB)







md-out : MdS → List Word
md-out (md-s o b) = o







md-left : MdS → MdB
md-left (md-s o b) = b







-- a line of any kind but inside fenced code: joined to the open block, or closing it and opening its own
md-k : MdB → MdLk → MdS
md-k b lk-fence = md-s (md-close b) (mb-code nil)
md-k (mb-table rs) (lk-row l) = md-s nil (mb-table (cons l rs))
md-k b (lk-row l) = md-s (md-close b) (mb-table (cons l nil))
md-k b (lk-head n t) = md-s (list-append (md-close b) (s-h n (s-inline t))) mb-none
md-k (mb-quote ls) (lk-quote q) = md-s nil (mb-quote (cons q ls))
md-k b (lk-quote q) = md-s (md-close b) (mb-quote (cons q nil))
md-k (mb-list is) (lk-item i) = md-s nil (mb-list (cons (cons i nil) is))
md-k b (lk-item i) = md-s (md-close b) (mb-list (cons (cons i nil) nil))
md-k b lk-hr = md-s (list-append (md-close b) "<hr>") mb-none
md-k b lk-blank = md-s (md-close b) mb-none
md-k (mb-list is) (lk-text s true) = md-s nil (mb-list (md-more is s))
md-k (mb-para ls) (lk-text s c) = md-s nil (mb-para (cons s ls))
md-k b (lk-text s c) = md-s (md-close b) (mb-para (cons s nil))







-- a line read in the open block: inside fenced code a line is its text until the fence closes it
md-next : MdB → List Word → MdS
md-next (mb-code ls) l = if h-prefix "```" l then md-s (md-pre ls) mb-none else md-s nil (mb-code (cons l ls))
