s-essay-lines p = let st = if h-ends ".hypercubical" (h-drop "docs/" p) then h-before ".hypercubical" (h-drop "docs/" p) else h-before ".cub" (h-drop "docs/" p) in bind (hi-code (list-append st "-source")) (s-essay-lines-of st)







