s-src-cite-example = refl







-- an essay's source is either its lines written out (lines-of (cons "line" ...)) or, since the essays were
-- re-cut into runs (2026-11-18), lines-of over its runs NAME-lines-1, NAME-lines-2, ...: the run names are
-- read from the source piece in order, and each run's lines from its own piece
s-unparen : List Word → List Word
s-unparen nil = nil
s-unparen (cons x r) = if orB (weq x #40) (weq x #41) then s-unparen r else cons x (s-unparen r)







s-nl-sp : List Word → List Word
s-nl-sp nil = nil
s-nl-sp (cons x r) = cons (if weq x #10 then #32 else x) (s-nl-sp r)







s-run-names : List Word → List (List Word) → List (List Word)
s-run-names base nil = nil
s-run-names base (cons w r) = if h-prefix (list-append base "-lines-") (s-unparen w) then cons (s-unparen w) (s-run-names base r) else s-run-names base r







s-piece-lines : Sum Unit (List Word) → List (List Word)
