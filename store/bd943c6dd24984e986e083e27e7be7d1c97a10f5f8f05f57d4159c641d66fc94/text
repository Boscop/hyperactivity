-- excerpt extraction for per-page meta descriptions and RSS summaries
s-skip-sp : List Word → List Word
s-skip-sp nil = nil
s-skip-sp (cons x r) = if orB (weq x #32) (orB (weq x #9) (weq x #13)) then s-skip-sp r else cons x r









s-para-ok : List Word → Bool
s-para-ok l =
  andB (wlt #45 (fromNat (list-length (h-take (toNat #46) l)))) (
  andB (h-not (h-prefix "#" l)) (
  andB (h-not (h-prefix "```" l)) (
  andB (h-not (h-prefix "---" l)) (
  andB (h-not (h-prefix "|" l)) (
  andB (h-not (h-prefix "<" l)) (
  andB (h-not (h-prefix "![" l)) (
  andB (h-not (h-prefix ">" l)) (
       (h-not (h-prefix "--" l))))))))))









s-first-para : List (List Word) → List Word
s-first-para nil = nil
s-first-para (cons l r) = if s-para-ok (s-skip-sp l) then s-skip-sp l else s-first-para r









s-plain : List Word → List Word
s-plain nil = nil
s-plain (cons x r) =
  if orB (weq x #42) (orB (weq x #96) (orB (weq x #35) (orB (weq x #60) (orB (weq x #62) (weq x #95))))) then s-plain r else
  if orB (weq x #10) (orB (weq x #13) (weq x #9)) then cons #32 (s-plain r) else
  cons x (s-plain r)









s-excerpt : List Word → List Word
s-excerpt text =
  if h-null (s-plain (h-take (toNat #180) (s-first-para (h-split #10 text))))
  then s-site-desc
  else s-plain (h-take (toNat #180) (s-first-para (h-split #10 text)))







