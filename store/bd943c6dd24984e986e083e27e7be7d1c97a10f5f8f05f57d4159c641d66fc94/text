s-text-of : Sum Unit (List Word) → List Word
s-text-of (inl u) = s-respond "404 Not Found" "text/plain" "no such module"
s-text-of (inr t) = s-response "text/plain" t







s-alt-ext : List Word → List Word
s-alt-ext p =
  if h-ends ".hypercubical" p then list-append (h-before ".hypercubical" p) ".cub"
  else if h-ends ".cub" p then list-append (h-before ".cub" p) ".hypercubical"
  else nil







s-text : List Word → Proc W (List Word)
s-text q =
  let p = h-unhex (s-param "path" q) in
  bind (h-source-text p) (λ t →
  case t of
    inr txt → ret {lzero} {W} (s-response "text/plain" txt)
    inl u →
      if h-null (s-alt-ext p) then ret {lzero} {W} (s-text-of (inl unit))
      else bind (h-source-text (s-alt-ext p)) (λ t2 → ret {lzero} {W} (s-text-of t2)))







-- GET /source/object?h=H&k=K: one object of the pool by its hash and kind (text, module, entry), the
-- bytes as they are. A session fetches what it lacks with this, and asks with the same request whether
-- the server already holds an object before it posts one (lib/host.cub h-held-there)
s-object-of : Sum Unit (List Word) → List Word
s-object-of (inl u) = s-respond "404 Not Found" "text/plain" ""
s-object-of (inr t) = s-response "text/plain" t







s-obj-hex-char : Word → Bool
s-obj-hex-char c = orB (andB (wlt #47 c) (wlt c #58)) (andB (wlt #96 c) (wlt c #103))









s-obj-all-hex : List Word → Bool
s-obj-all-hex nil = true
s-obj-all-hex (cons c r) = andB (s-obj-hex-char c) (s-obj-all-hex r)









s-valid-obj-kind : List Word → Bool
s-valid-obj-kind k =
  orB (h-eq k "text") (orB (h-eq k "module") (orB (h-eq k "entry") (
  orB (h-eq k "root") (orB (h-eq k "names") (orB (h-eq k "forms") (
  orB (h-eq k "imp") (orB (h-eq k "comp") (h-eq k "decl"))))))))









s-valid-obj-ref : List Word → List Word → Bool
s-valid-obj-ref h k = andB (weq (fromNat (list-length h)) #64) (andB (s-obj-all-hex h) (s-valid-obj-kind k))









-- traversal via /source/object is rejected (part of product-implementation)
s-object-traversal-rejected : Path Bool (s-valid-obj-ref ".." "../../proc/self/environ") false
s-object-traversal-rejected = refl









s-object : List Word → Proc W (List Word)
