-- JSON-LD string escaper safe inside HTML <script type='application/ld+json'>
s-ld-esc : List Word → List Word
s-ld-esc nil = nil
s-ld-esc (cons x r) =
  if orB (weq x #34) (weq x #92) then cons #92 (cons x (s-ld-esc r)) else
  if orB (weq x #60) (weq x #62) then s-ld-esc r else
  if wlt x #32 then cons #32 (s-ld-esc r) else
  cons x (s-ld-esc r)









s-ld-str : List Word → List Word
s-ld-str s = cons #34 (list-append (s-ld-esc s) (cons #34 nil))









s-ld-kv : List Word → List Word → List Word
s-ld-kv k v = h-concat (cons (s-ld-str k) (cons ":" (cons (s-ld-str v) nil)))









