-- the inner branch for constructor c2 against the outer constructor c with field kinds ks
inner-branches : (Word → Code) → Lst (Word × Word) → Lst (Lst (Word × Word)) → Word → Word → Lst Code
inner-branches eqf ks lnil c2 c = lnil
inner-branches eqf ks (lcons ks2 more) c2 c =
  lcons (clams (%wadd (d-len ks2) (count-rec ks2))
           (if %weq c2 c then compare-fields eqf ks (d-len ks) (count-rec ks) (d-len ks2) (count-rec ks2) #0 #0
            else d-false))
        (inner-branches eqf ks more (%wsucc c2) c)
