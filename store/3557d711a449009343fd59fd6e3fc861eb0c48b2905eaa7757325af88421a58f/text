-- Instantiated directly on cs-compile (nf_of = x-nf): any Code evaluating to mv compiles to C11
-- code that terminates in cso-ok hp' cv with Kripke denotation cs-val-rel hp' mv cv ≡ true
cs-compile-sound : (k : Nat) (fns : CsFns) (ars : Lst (Word × Word))
  (menv : Lst CsMVal) (hp : CsHeap) (cenv : CsEnv) (c : Code) (mv : CsMVal) →
  cs-env-rel hp menv cenv →
  (cs-code-eval k menv c ≡ csom-some mv) →
  cs-res-rel mv (cs-eval k fns hp cenv (cs-compile k ars (cs-wlen menv) c)) ≡ true
cs-compile-sound k fns ars menv hp cenv c mv henv hev =
  cong (λ om → cs-sim-ok om (cs-eval k fns hp cenv (cs-compile k ars (cs-wlen menv) c))) (sym hev)
  ∙ cs-compile-code-sim x-nf k fns ars menv hp cenv c henv
