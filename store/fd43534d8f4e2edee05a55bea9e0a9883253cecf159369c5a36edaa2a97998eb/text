-- the block-diagonal lemma, the Gram matrix: from the four values of the form on e₀ and padded vectors
cl-bd-gram : (A : Type) → (z one : A) → (ad mu : A → A → A) → (a : A) → (c : List A → List A → A) → (ws : List (List A)) →
  ad (mu a (mu one one)) (c nil nil) ≡ a → ((w : List A) → ad (mu a (mu one z)) (c nil w) ≡ z) → ((w : List A) → ad (mu a (mu z one)) (c w nil) ≡ z) →
  ((w w2 : List A) → ad (mu a (mu z z)) (c w w2) ≡ c w w2) →
  cl-gram A (cl-bd A z ad mu a c) (cl-wit A z one ws) ≡ cl-mid A z a c ws
cl-bd-gram A z one ad mu a c ws hA hB hC hD = λ i → cons
  (cons (hA i) (cl-map-pad A A z (λ y → cl-bd A z ad mu a c (cons one nil) y) (λ w → z) hB ws i))
  (cl-map-pad A (List A) z (λ x → ln-map (List A) A (λ y → cl-bd A z ad mu a c x y) (cl-wit A z one ws)) (λ w → cons z (ln-map (List A) A (λ y → c w y) ws))
    (λ w → λ j → cons (hC w j) (cl-map-pad A A z (λ y → cl-bd A z ad mu a c (cons z w) y) (λ y → c w y) (hD w) ws j)) ws i)
