bn-bits8-to-5-go : Nat → Word → Word → List Word → List Word
bn-bits8-to-5-go zero    acc bits bs = nil
bn-bits8-to-5-go (suc f) acc bits nil =
  if %weq bits #0 then nil else cons (%wand (%wshl acc (%wsub #5 bits)) #31) nil
bn-bits8-to-5-go (suc f) acc bits (cons b bs) =
  let acc2  = %wor (%wshl acc #8) (%wand b #255)
      bits2 = %wadd bits #8
      em    = bn-emit-5bits (toNat #3) acc2 bits2
  in list-append (snd (snd em)) (bn-bits8-to-5-go f (fst em) (fst (snd em)) bs)
