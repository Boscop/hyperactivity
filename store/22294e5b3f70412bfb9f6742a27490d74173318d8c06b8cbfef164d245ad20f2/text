-- the most of p any position of the reversed text matches: the longest end of the turn the text holds
m-best-go : (n : Nat) → Bytes n → (k : Nat) → Bytes k → Word → Word → Word → List Word → Word
m-best-go n p k f m j b nil = wmax b j
m-best-go n p k f m j b (cons c r) = m-best-go n p k f m (m-next n p k f m j c) (wmax b j) r
