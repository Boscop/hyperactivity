-- THEOREM 4C (32B `HX-HFKE` MAC WIRE COMPATIBILITY, FORGERY REJECTION & ZERO-DUST WATERFALL BY `refl`):
dm-thm-hxsv-32b :
  let pkt    = dm-pack-hxsv32 #108 #424242 #40 #77777
      forged = cons #0 (dm-tl-w pkt)
      wf     = dm-waterfall4 #9999999
      wfSum  = %wadd (fst wf) (%wadd (fst (snd wf)) (%wadd (fst (snd (snd wf))) (snd (snd (snd wf)))))
  in andB (%weq (fromNat (list-length pkt)) #32)
     (andB (fst (dm-verify-hxsv32 pkt))
     (andB (eth-not (fst (dm-verify-hxsv32 forged)))
           (%weq wfSum #9999999))) ≡ true
dm-thm-hxsv-32b = refl
