hg-main : List (List Word) → Step W Word
hg-main args =
  let p = hg-pref args
      mf = list-append p "_flash.metal"
      cf = list-append p "_flash.cu"
      hf = list-append p "_metal_bench.m"
  in scmd w-now (λ t0 →
     scmd (w-file-write-named mf hg-metal-src) (λ bm →
     scmd (w-file-write-named cf hg-cuda-src) (λ bc →
     scmd (w-file-write-named hf (hg-host-src mf)) (λ bh →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-GPU emitted Metal=" (list-append (ce-dec bm) (list-append "B CUDA=" (list-append (ce-dec bc) (list-append "B Host=" (list-append (ce-dec bh) (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))))
       (sdone #0))))))
