cmap-skip : (e : Entry) (sk' sk : Lst Entry) (r : Word → Word) (X : Type 1) (c : Cube (dims sk) X) →
  PathP (λ i → Cube (dims (lcons e sk')) X)
    (cmap-cube (lcons e sk') sk (cmap-of (lcons e sk') sk (λ k → %wsucc (r k))) X c) (skip-cube e sk' X (cmap-cube sk' sk (cmap-of sk' sk r) X c))
cmap-skip e sk' lnil r X c = skip-const e sk' X c
cmap-skip e sk' (lcons (e-ty a) sk) r X c = cmap-skip e sk' sk (λ k → r (%wsucc k)) X c
cmap-skip e sk' (lcons e-dim sk) r X c =
  pcat (Cube (dims (lcons e sk')) X)
    (papp-cube (lcons e sk') X (lcons (lcons (%wsucc (r #0) , true) lnil) lnil)
       (cmap-cube (lcons e sk') sk (cmap-of (lcons e sk') sk (λ k → %wsucc (r (%wsucc k)))) (Line X) c))
    (diag-sk (lcons e sk') (%wsucc (r #0)) X (skip-cube e sk' (Line X) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)))
    (skip-cube e sk' X (papp-cube sk' X (lcons (lcons (r #0 , true) lnil) lnil) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)))
    (pcat (Cube (dims (lcons e sk')) X)
       (papp-cube (lcons e sk') X (lcons (lcons (%wsucc (r #0) , true) lnil) lnil)
          (cmap-cube (lcons e sk') sk (cmap-of (lcons e sk') sk (λ k → %wsucc (r (%wsucc k)))) (Line X) c))
       (papp-cube (lcons e sk') X (lcons (lcons (%wsucc (r #0) , true) lnil) lnil)
          (skip-cube e sk' (Line X) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)))
       (diag-sk (lcons e sk') (%wsucc (r #0)) X (skip-cube e sk' (Line X) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)))
       (λ i → papp-cube (lcons e sk') X (lcons (lcons (%wsucc (r #0) , true) lnil) lnil) (cmap-skip e sk' sk (λ k → r (%wsucc k)) (Line X) c i))
       (papp-var (lcons e sk') X (%wsucc (r #0)) (skip-cube e sk' (Line X) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c))))
    (pcat (Cube (dims (lcons e sk')) X)
       (diag-sk (lcons e sk') (%wsucc (r #0)) X (skip-cube e sk' (Line X) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)))
       (skip-cube e sk' X (diag-sk sk' (r #0) X (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)))
       (skip-cube e sk' X (papp-cube sk' X (lcons (lcons (r #0 , true) lnil) lnil) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)))
       (diag-skip e sk' (r #0) X (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c))
       (λ i → skip-cube e sk' X (papp-var sk' X (r #0) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c) (~ i))))
