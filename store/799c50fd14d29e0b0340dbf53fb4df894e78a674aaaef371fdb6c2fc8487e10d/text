-- THEOREM 7 (INCREMENTAL GUARD CACHE SOUNDNESS — ZERO POSTULATES):
-- If blob `b1` passed guard (`gs-ok b1 == true`) and incoming blob `b2` has the
-- same content-addressed hash (`gs-hash b1 == gs-hash b2`), then `gs-ok b2 == true`!
ml-thm-incremental-guard-sound :
  {Blob Hash : Type} → (gs : GuardSpec Blob Hash) →
  (b1 b2 : Blob) →
  gs-hash gs b1 ≡ gs-hash gs b2 →
  gs-ok gs b1 ≡ true →
  gs-ok gs b2 ≡ true
ml-thm-incremental-guard-sound gs b1 b2 heq hok =
  let beq = gs-inj gs b1 b2 heq
      p   = ml-cong (gs-ok gs) beq
  in λ i → comp (λ j → Bool) (λ j → [ i = 0 ↦ p j , i = 1 ↦ hok j ]) (gs-ok gs b1)
