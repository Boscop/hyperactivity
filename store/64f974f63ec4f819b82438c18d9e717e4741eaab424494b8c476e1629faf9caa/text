si-bytes-below : (y : List Word) → isTrue (si-bytes-ok y) → sq-below word-le #256 y
si-bytes-below y = case y return λ w → isTrue (si-bytes-ok w) → sq-below word-le #256 w of
  nil → λ h → unit
  cons d r → λ h → (cong not (isTrue→eq {wlt d #256} (and-fst {wlt d #256} {si-bytes-ok r} h)) , rec r (and-snd {wlt d #256} {si-bytes-ok r} h))
