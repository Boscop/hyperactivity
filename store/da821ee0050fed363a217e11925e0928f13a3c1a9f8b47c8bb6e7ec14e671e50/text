dm-emit-clebsch-sv : List Word
dm-emit-clebsch-sv =
  bn-lines
    (cons "module hx_diamond2_clebsch_chord("
    (cons "  input  wire [3:0] node_id,"
    (cons "  input  wire [63:0] in_a,"
    (cons "  input  wire [63:0] in_b,"
    (cons "  input  wire [63:0] in_c,"
    (cons "  output wire [3:0] chord_peer,"
    (cons "  output wire [63:0] ulop3_mux"
    (cons ");"
    (cons "  assign chord_peer = node_id ^ 4'b1010;"
    (cons "  assign ulop3_mux  = (in_a & in_b) | (~in_a & in_c);"
    (cons "endmodule" nil)))))))))))
