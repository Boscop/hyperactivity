-- a family of vertices: (x, v2, w2, m) = (i/2, i/4, i/2, i) and (i, i/2, i, i/2) for i ≤ n
hop-unit-sweep : Nat → Nat → Bool
hop-unit-sweep i n = case i of
  zero → hop-unit-k nil nil nil nil n
  suc g → both (both (hop-unit-k (bin-of-nat (nat-half i)) (bin-of-nat (nat-half (nat-half i))) (bin-of-nat (nat-half i)) (bin-of-nat i) n)
                     (hop-unit-k (bin-of-nat i) (bin-of-nat (nat-half i)) (bin-of-nat i) (bin-of-nat (nat-half i)) n))
                (hop-unit-sweep g n)
