-- the edges among the scene's nodes: each node to what it is part of
hi-jedges : List (List Word) → List (List (List Word)) → List (List Word)
hi-jedges sc nil = nil
hi-jedges sc (cons row r) = if h-has (hi-first row) sc then list-append (hi-jedges-of sc (hi-first row) (h-tail-lists row)) (hi-jedges sc r) else hi-jedges sc r
