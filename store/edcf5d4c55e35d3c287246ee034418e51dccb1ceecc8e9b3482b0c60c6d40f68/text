lc-verify-nand-dag16 : Word → Word → Word → Bool
lc-verify-nand-dag16 spec16 numGates packedGates =
  if orB (%weq numGates #0) (%wlt #16 numGates)
  then false
  else
    let res  = lc-dag-step (toNat numGates) #4 packedGates lc-init-wires16
        okAc = fst res
        ws   = snd res
        last = lc-nth-w (%wadd #3 numGates) ws
    in andB okAc (%weq last (%wand spec16 lc-mask16))
