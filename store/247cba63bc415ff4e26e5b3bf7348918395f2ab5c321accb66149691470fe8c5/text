-- 3. Two-cell bioelectric gap-junction dissipation splitting (Levin isopotential domain quotient):
--    For two identical leak-conductance cells (conductance g, resting potential E) coupled by
--    gap-junction conductance gc, total quadratic dissipation splits orthogonally into mean-field
--    (V1 + V2 - 2 E) and isopotential-difference (V1 - V2) modes:
--      2 · (g (V1 - E)² + g (V2 - E)² + gc (V1 - V2)²)
--      = g (V1 + V2 - 2 E)² + (g + 2 gc) (V1 - V2)².
--    As gc grows, the difference mode (V1 - V2) is damped at rate (g + 2 gc), collapsing the pair
--    onto the isopotential quotient V1 = V2 while preserving the collective mean-field mode.
--    Variables (0..4): V1, V2, E, g, gc.
bioelectric-gap-split-sos : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
bioelectric-gap-split-sos A ad mu q vs =
  (λ g sub sq →
    let v1 = g 0
        v2 = g 1
        E  = g 2
        gl = g 3
        gc = g 4
        q2 = q (fn-q 2 1)
        lhs = mu q2 (ad (mu gl (sq (sub v1 E)))
                        (ad (mu gl (sq (sub v2 E)))
                            (mu gc (sq (sub v1 v2)))))
        rhs = ad (mu gl (sq (sub (ad v1 v2) (mu q2 E))))
                 (mu (ad gl (mu q2 gc)) (sq (sub v1 v2)))
    in (lhs , rhs))
  (λ i → al-nth A (q (fn-q 0 1)) i vs) (al-gsub A ad mu q) (al-gsq A mu)
