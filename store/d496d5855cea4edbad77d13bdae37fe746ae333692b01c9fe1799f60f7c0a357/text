-- the first reading: the turn's key reversed (its last 1024 bytes, with its failures) against every text's
c-first-s : List Word → List Word → (n : Nat) → Bytes n → Word → (k : Nat) → Bytes k → Proc W (List Word)
c-first-s key forms n p m k f = bind (c-bests n p k f m c-texts) (λ bs →
  if wlt (c-top #0 bs) #2 then ret {lzero} {W} (c-meaning nil) else c-second (c-top #0 bs) key forms bs (c-top #0 bs))
