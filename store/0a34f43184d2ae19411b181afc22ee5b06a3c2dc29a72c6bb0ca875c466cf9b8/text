pmul-step : (e : Val) (c : Nat) (m : Mono) (r q : Poly) →
            pev e (pmul r q) ≡ times (pev e r) (pev e q) →
            pev e (padd (pscale c m q) (pmul r q)) ≡ times (plus (times c (mev e m)) (pev e r)) (pev e q)
pmul-step e c m r q h =
  transN (padd-sound e (pscale c m q) (pmul r q))
    (transN (cong2N (λ x y → plus x y) (pscale-sound e c m q) h)
      (symN (times-distr (times c (mev e m)) (pev e r) (pev e q))))
