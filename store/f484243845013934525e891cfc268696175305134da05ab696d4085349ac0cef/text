-- s_l from t = s_{l+2}, l = 2m + 2
ang-s-at : List Bool → List Bool → IV → IV → Nat → IV → IV
ang-s-at S S2 p2 a m t = iv-div S S2 (iv-neg (iv-mul S p2 (leg-alpha S (times 2 m))))
  (iv-add (iv-add (iv-sub a (iv-int S (times (plus (times 2 m) 2) (plus (times 2 m) 3)))) (iv-mul S p2 (leg-beta S (plus (times 2 m) 2))))
          (iv-mul S p2 (iv-mul S (leg-gamma S (plus (times 2 m) 4)) t)))
