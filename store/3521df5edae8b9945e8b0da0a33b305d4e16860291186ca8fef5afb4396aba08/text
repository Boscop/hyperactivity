-- an operation: an eliminator with its arguments' wires, duplicate, erase, forward, quote at a
-- depth, and the gathering of quoted parts
data NkOp = nko-el (h : Word) (cs : NkTm) (aux : NkEnv) (out : NkW) | nko-dup (a : NkW) (b : NkW) | nko-era | nko-fwd (out : NkW) | nko-quote (d : Word) (out : NkW) | nko-gather (d : Word) (k : NkK) (done : NkTm) (todo : NkEnv) (out : NkW)
