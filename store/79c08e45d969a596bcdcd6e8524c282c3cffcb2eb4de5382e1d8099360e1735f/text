-- every term's roots are all candidates
p-terms-covered : List PCand → List STerm → Bool
p-terms-covered cs ts = case ts of
  nil → true
  cons t rest → (if eqb (p-cand-count (fst (fst (snd t))) cs) (m-deg (fst (fst (snd t)))) then (if eqb (p-cand-count (fst (fst (snd (snd t)))) cs) (m-deg (fst (fst (snd (snd t))))) then p-terms-covered cs rest else false) else false)
