omni-c2c tail =
  hw-ln "// Real Jacobi SVD truncation of 2-site tensor Theta[(cl*4) x (4*cr)] -> U*S*Vt (exact Schmidt spectrum!)"
  (hw-ln "static double svd_split_2site(int i, const double* theta, int chi_cap, int dir_right) {"
  (hw-ln "  int cl = chi_L[i], cr = chi_R[i+1], nr = cl * 4, nc = 4 * cr;"
  (hw-ln "  // Gram matrix G = Theta * Theta^T (nr x nr, max 40x40)"
  (hw-ln "  static double G[40][40], U[40][40];"
  (hw-ln "  for (int r=0;r<nr;r++) for (int c=0;c<nr;c++) {"
  (hw-ln "    double sm=0; for (int k=0;k<nc;k++) sm += theta[r*nc+k]*theta[c*nc+k]; G[r][c]=sm; U[r][c]=(r==c)?1.0:0.0;"
  (hw-ln "  }"
  (hw-ln "  for (int it=0;it<240;it++) {"
  (hw-ln "    int p=0,q=1; double mx=0;"
  (hw-ln "    for (int r=0;r<nr;r++) for (int c=r+1;c<nr;c++) if (fabs(G[r][c])>mx){mx=fabs(G[r][c]);p=r;q=c;}"
  (hw-ln "    if (mx<1e-13) break;"
  (hw-ln "    double th=0.5*atan2(2.0*G[p][q], G[q][q]-G[p][p]), c=cos(th), s=sin(th);"
  (hw-ln "    for (int r=0;r<nr;r++){double urp=U[r][p],urq=U[r][q]; U[r][p]=c*urp-s*urq; U[r][q]=s*urp+c*urq;}"
  (hw-ln "    double gpp=G[p][p],gqq=G[q][q],gpq=G[p][q];"
  (hw-ln "    G[p][p]=c*c*gpp-2*s*c*gpq+s*s*gqq; G[q][q]=s*s*gpp+2*s*c*gpq+c*c*gqq; G[p][q]=G[q][p]=0.0;"
  (hw-ln "    for (int r=0;r<nr;r++) if (r!=p&&r!=q){double grp=G[r][p],grq=G[r][q]; G[r][p]=G[p][r]=c*grp-s*grq; G[r][q]=G[q][r]=s*grp+c*grq;}"
  (hw-ln "  }"
  (hw-ln "  int ord[40]; for (int r=0;r<nr;r++) ord[r]=r;"
  (hw-ln "  for (int a=0;a<nr;a++) for (int b=a+1;b<nr;b++) if (G[ord[b]][ord[b]] > G[ord[a]][ord[a]]) { int t=ord[a]; ord[a]=ord[b]; ord[b]=t; }"
  (hw-ln "  int k_new = nr; if (nc < k_new) k_new = nc; if (chi_cap < k_new) k_new = chi_cap;"
  (hw-ln "  double trunc_err = 0.0; for (int r=k_new;r<nr;r++) if (G[ord[r]][ord[r]]>0) trunc_err += G[ord[r]][ord[r]];"
  (hw-ln "  // Compute B = U_k^T * Theta (k_new x nc)"
  (hw-ln "  static double B[DMRG_MAXC][40];"
  (hw-ln "  for (int m=0;m<k_new;m++) for (int c=0;c<nc;c++) {"
  (hw-ln "    double sm=0; for (int r=0;r<nr;r++) sm += U[r][ord[m]]*theta[r*nc+c]; B[m][c]=sm;"
  (hw-ln "  }"
  (hw-ln "  memset(MPS[i], 0, sizeof(MPS[i])); memset(MPS[i+1], 0, sizeof(MPS[i+1]));"
  (hw-ln "  if (dir_right) {"
  (hw-ln "    // Left-canonical MPS[i] = U_k, MPS[i+1] = B (normalized)"
  (hw-ln "    double nrm=0; for (int m=0;m<k_new;m++) for (int c=0;c<nc;c++) nrm+=B[m][c]*B[m][c]; nrm=sqrt(nrm); if(nrm<1e-14)nrm=1.0;"
  (hw-ln "    for (int a=0;a<cl;a++) for (int s=0;s<4;s++) for (int m=0;m<k_new;m++) MPS[i][a][s][m] = U[a*4+s][ord[m]];"
  (hw-ln "    for (int m=0;m<k_new;m++) for (int s=0;s<4;s++) for (int c=0;c<cr;c++) MPS[i+1][m][s][c] = B[m][s*cr+c]/nrm;"
  (hw-ln "  } else {"
  (hw-ln "    // Right-canonical MPS[i+1] = Vt_k, MPS[i] = U_k * S_k"
  (hw-ln "    double nrm=0;"
  (hw-ln "    for (int m=0;m<k_new;m++) {"
  (hw-ln "      double sv = (G[ord[m]][ord[m]] > 1e-14) ? sqrt(G[ord[m]][ord[m]]) : 0.0; nrm += sv*sv;"
  (hw-ln "      for (int c=0;c<nc;c++) B[m][c] = (sv > 1e-12) ? (B[m][c]/sv) : 0.0;"
  (hw-ln "    }"
  (hw-ln "    nrm = sqrt(nrm); if (nrm<1e-14) nrm=1.0;"
  (hw-ln "    for (int a=0;a<cl;a++) for (int s=0;s<4;s++) for (int m=0;m<k_new;m++) {"
  (hw-ln "      double sv = (G[ord[m]][ord[m]] > 1e-14) ? sqrt(G[ord[m]][ord[m]]) : 0.0;"
  (hw-ln "      MPS[i][a][s][m] = U[a*4+s][ord[m]] * sv / nrm;"
  (hw-ln "    }"
  (hw-ln "    for (int m=0;m<k_new;m++) for (int s=0;s<4;s++) for (int c=0;c<cr;c++) MPS[i+1][m][s][c] = B[m][s*cr+c];"
  (hw-ln "  }"
  (hw-ln "  chi_R[i] = k_new; chi_L[i+1] = k_new;"
  (hw-ln "  return trunc_err;"
  (hw-ln "}"
