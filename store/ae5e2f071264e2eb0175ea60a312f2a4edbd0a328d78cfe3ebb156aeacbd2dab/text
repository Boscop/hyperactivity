  (hw-ln "        int cl=chi_L[i], cm=chi_R[i], cr=chi_R[i+1], dim=cl*16*cr;"
  (hw-ln "        memset(theta,0,(size_t)dim*sizeof(double));"
  (hw-ln "        for (int a=0;a<cl;a++) for (int s1=0;s1<4;s1++) for (int m=0;m<cm;m++) for (int s2=0;s2<4;s2++) for (int c=0;c<cr;c++)"
  (hw-ln "          theta[((a*4+s1)*4+s2)*cr+c] += MPS[i][a][s1][m]*MPS[i+1][m][s2][c];"
  (hw-ln "        E_last = lanczos_2site(i, theta, dim);"
  (hw-ln "        double tr = svd_split_2site(i, theta, cc, 0); if (tr>max_tr) max_tr=tr;"
  (hw-ln "        update_R(i+1);"
  (hw-ln "      }"
  (hw-ln "    }"
  (hw-ln "    if (E_last > prev_E + 1e-8) mono = 0;"
  (hw-ln "    prev_E = E_last;"
  (hw-ln (list-append "    printf(" (list-append hw-q (list-append "  [DMRG chi=%d] 64-site La3Ni2O7 E0=%.6f (%.6f/site) | max_SVD_trunc=%.2e" (list-append hw-esc-n (list-append hw-q ", cc, E_last, E_last/64.0, max_tr);")))))
  (hw-ln "  }"
  (hw-ln "  uint64_t sharp_sat = 0;"
  (hw-ln "  for (uint32_t m = 0; m < 16u; m++) {"
