  (hw-ln "        memset(theta,0,(size_t)dim*sizeof(double));"
  (hw-ln "        for (int a=0;a<cl;a++) for (int s1=0;s1<4;s1++) for (int m=0;m<cm;m++) for (int s2=0;s2<4;s2++) for (int c=0;c<cr;c++)"
