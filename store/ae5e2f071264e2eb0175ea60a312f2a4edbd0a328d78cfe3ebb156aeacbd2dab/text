  (hw-ln (list-append "  printf(" (list-append hw-q (list-append "[B] 64-Site La3Ni2O7 REAL 2-Site DMRG : E(chi=1)=%.4f -> E(chi=8)=%.6f | mono=%d | #SAT=%llu" (list-append hw-esc-n (list-append hw-q ", E_init, E_last, mono, (unsigned long long)sharp_sat);")))))
