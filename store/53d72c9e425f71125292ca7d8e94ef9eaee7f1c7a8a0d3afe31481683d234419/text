-- Keyed De Morgan / Feistel hypercube wire involution: masks all 4 rails symmetrically
upr-mask4 : Cube4 → Cube4 → Cube4
upr-mask4 (mk-cube4 k0 k1 k2 k3) (mk-cube4 x0 x1 x2 x3) =
  mk-cube4 (upr-xorB k0 x0) (upr-xorB k1 x1) (upr-xorB k2 x2) (upr-xorB k3 x3)

upr-lem-mask4-inv : (k x : Cube4) → upr-mask4 k (upr-mask4 k x) ≡ x
upr-lem-mask4-inv (mk-cube4 k0 k1 k2 k3) (mk-cube4 x0 x1 x2 x3) =
  let p0 = upr-lem-xorB-cancel k0 x0
      p1 = upr-lem-xorB-cancel k1 x1
      p2 = upr-lem-xorB-cancel k2 x2
      p3 = upr-lem-xorB-cancel k3 x3
  in λ i → mk-cube4 (p0 i) (p1 i) (p2 i) (p3 i)

upr-cube4-codec : Cube4 → FiberCodec Cube4
upr-cube4-codec k =
  (upr-mask4 k , upr-mask4 k , upr-lem-mask4-inv k , upr-lem-mask4-inv k)

