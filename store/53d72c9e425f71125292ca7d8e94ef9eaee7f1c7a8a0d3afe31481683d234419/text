upr-lem-tir-step-conserved : (p : Plaq4) → upr-plaq-sum (upr-tir-step p) ≡ upr-plaq-sum p
upr-lem-tir-step-conserved (mk-plaq4 a b c d) =
  let bcd = plus b (plus c d)
      s1  = fio-sym (upr-plus-assoc b c (plus d a))
      s2  = fio-sym (upr-plus-assoc (plus b c) d a)
      s3  = upr-plus-assoc b c d
      s4  = fio-cong (λ z → plus z a) s3
      s5  = upr-plus-comm bcd a
  in fio-trans s1 (fio-trans s2 (fio-trans s4 s5))

upr-iter-plaq : Nat → Plaq4 → Plaq4
upr-iter-plaq zero    p = p
upr-iter-plaq (suc n) p = upr-tir-step (upr-iter-plaq n p)

