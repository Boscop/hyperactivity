-- O(1) arbitrary-precision 256-bit `Word` settlement (`ceil(w/2)` Founder + `floor(w/2)` Reinvest)
-- proved bit-for-bit equivalent to `upr-settle-event` over `#0..#128`:
upr-settle-word : Word → Word × Word
upr-settle-word w =
  if %weq w #0
  then (#0 , #0)
  else (%wdiv (%wadd w #1) #2 , %wdiv w #2)

upr-chk-settle-word : Nat → Word → Bool
upr-chk-settle-word zero    w = true
upr-chk-settle-word (suc k) w =
  let sw = upr-settle-word w
      sn = upr-settle-event (toNat w)
      ok = andB (%weq (fst sw) (fromNat (fst sn)))
                (andB (%weq (snd sw) (fromNat (snd sn)))
                      (%weq (%wadd (fst sw) (snd sw)) w))
  in if ok then upr-chk-settle-word k (%wadd w #1) else false

