-- Micro-Tick Unclamped Concave Sizing vs Coarse `$250`-Floor Bug:
-- Models thin 1-bp CLMM virtual depth (`$40,000` = `#40000000000` uUSDC, `+8 bps` raw edge, `1 bp` fee/leg):
upr-clmm-leg : Word → Word → Word → Word
upr-clmm-leg rx ry dx =
  let dxf = %wmul dx #9999
      den = %wadd (%wmul rx #10000) dxf
  in if %weq den #0 then #0 else %wdiv (%wmul ry dxf) den

upr-thin-out : Word → Word
upr-thin-out sDollars =
  let dx = %wmul sDollars #1000000
      dy = upr-clmm-leg #40000000000 #40060000000 dx
  in upr-clmm-leg #40000000000 #40060000000 dy

upr-thin-net : Word → Word
upr-thin-net sDollars =
  let dx   = %wmul sDollars #1000000
      out  = upr-thin-out sDollars
      cost = %wadd dx #1800
  in if %wlt cost out then %wsub out cost else #0

upr-thin-lin : Nat → Word → Word → Word
upr-thin-lin zero    s best = best
upr-thin-lin (suc k) s best =
  let p  = upr-thin-net s
      nb = if %wlt best p then p else best
  in upr-thin-lin k (%wadd s #1) nb

-- 9-step unclamped `O(log2 N)` micro-tick concave sizer over `$1..$512` (`out1 + dx0 > out0 + dx1`):
upr-thin-concave : Nat → Word → Word → Word
upr-thin-concave zero    lo hi = upr-thin-net lo
upr-thin-concave (suc k) lo hi =
  if %weq lo hi then upr-thin-net lo
  else
    let mid  = %wshr (%wadd lo hi) #1
        s1   = %wadd mid #1
        dx0  = %wmul mid #1000000
        dx1  = %wmul s1 #1000000
        out0 = upr-thin-out mid
        out1 = upr-thin-out s1
    in if %wlt (%wadd out0 dx1) (%wadd out1 dx0)
       then upr-thin-concave k s1 hi
       else upr-thin-concave k lo mid

