upr-plaq-sum : Plaq4 → Nat
upr-plaq-sum (mk-plaq4 a b c d) = plus a (plus b (plus c d))

upr-plus-zero-r : (a : Nat) → plus a zero ≡ a
upr-plus-zero-r zero    = refl
upr-plus-zero-r (suc a) = fio-cong suc (upr-plus-zero-r a)

upr-plus-suc-r : (a b : Nat) → plus a (suc b) ≡ suc (plus a b)
upr-plus-suc-r zero    b = refl
upr-plus-suc-r (suc a) b = fio-cong suc (upr-plus-suc-r a b)

upr-plus-comm : (a b : Nat) → plus a b ≡ plus b a
upr-plus-comm zero    b = fio-sym (upr-plus-zero-r b)
upr-plus-comm (suc a) b =
  fio-trans (fio-cong suc (upr-plus-comm a b)) (fio-sym (upr-plus-suc-r b a))

upr-plus-assoc : (a b c : Nat) → plus (plus a b) c ≡ plus a (plus b c)
upr-plus-assoc zero    b c = refl
upr-plus-assoc (suc a) b c = fio-cong suc (upr-plus-assoc a b c)

-- Unitary 4-port TIR scattering step `(a, b, c, d) |-> (b, c, d, a)` (lossless 90-degree diamond orb circulation):
upr-tir-step : Plaq4 → Plaq4
