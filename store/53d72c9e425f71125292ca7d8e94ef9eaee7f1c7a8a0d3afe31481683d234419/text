      ses = upr-settle-stream es
  in (plus (fst se) (fst ses) , plus (snd se) (snd ses))

-- Swap middle two summands `(a + b) + (c + d) === (a + c) + (b + d)`:
upr-plus-four-swap : (a b c d : Nat) → plus (plus a b) (plus c d) ≡ plus (plus a c) (plus b d)
upr-plus-four-swap a b c d =
  let s1 = upr-plus-assoc a b (plus c d)
      s2 = fio-cong (plus a) (fio-trans (fio-sym (upr-plus-assoc b c d))
             (fio-trans (fio-cong (λ z → plus z d) (upr-plus-comm b c))
                        (upr-plus-assoc c b d)))
      s3 = fio-sym (upr-plus-assoc a c (plus b d))
  in fio-trans s1 (fio-trans s2 s3)

