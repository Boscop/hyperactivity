data Cube4 : Type where
  mk-cube4 : Bool → Bool → Bool → Bool → Cube4

upr-xorB : Bool → Bool → Bool
upr-xorB false b     = b
upr-xorB true  false = true
upr-xorB true  true  = false

upr-lem-xorB-cancel : (k x : Bool) → upr-xorB k (upr-xorB k x) ≡ x
upr-lem-xorB-cancel false false = refl
upr-lem-xorB-cancel false true  = refl
upr-lem-xorB-cancel true  false = refl
