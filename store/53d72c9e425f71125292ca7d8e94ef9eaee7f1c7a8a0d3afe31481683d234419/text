      (cons (upr-evm-call4 upr-aerocl-wu-dyn20 upr-sel4-liq #256 #32)
      (cons (upr-evm-call4 upr-univ3-wu-5bp20 upr-sel4-slot0 #288 #32)
      (cons (upr-evm-erc20-bal bn-usdc-base20 eth-founder-coinbase-addr20 #320)
      (cons (cons (ev-push (eth-word-be-min #352))
            (cons (ev-push bn-empty-bytes)
            (cons (ev-op #243) nil))) nil)))))))))))))

upr-drop : Nat → List Word → List Word
upr-drop zero    xs          = xs
upr-drop (suc k) nil         = nil
upr-drop (suc k) (cons x xs) = upr-drop k xs

upr-dec40 : Word → List Word
upr-dec40 w = h-digits-onto (toNat #40) w nil

upr-word-at : Nat → List Word → Word
upr-word-at idx hex0x =
  let body  = if h-prefix "0x" hex0x then upr-drop (toNat #2) hex0x else hex0x
      start = bn-mul-nat idx (toNat #64)
  in bl-hex-to-word (h-take (toNat #64) (upr-drop start body))

upr-mask160 : Word
upr-mask160 = %wsub (%wshl #1 #160) #1

upr-sqrtpx96-to-usdc6 : Word → Word
upr-sqrtpx96-to-usdc6 w =
  let sp = %wand w upr-mask160
  in %wshr (%wmul (%wmul sp sp) #1000000000000000000) #192

upr-abs-diff : Word → Word → Word
upr-abs-diff a b = if %wlt a b then %wsub b a else %wsub a b

-- Gross pairwise spread in hundredths of a bip (`pips`, 100 pips = 1.00 bp):
upr-gross-pips : Word → Word → Word
upr-gross-pips pxA pxB =
  let lo = if %wlt pxA pxB then pxA else pxB
  in if %weq lo #0 then #0 else %wdiv (%wmul (upr-abs-diff pxA pxB) #1000000) lo

upr-max3 : Word → Word → Word → Word
upr-max3 a b c =
  let m = if %wlt a b then b else a
  in if %wlt m c then c else m

upr-run-sieve : Proc W (List Word)
upr-run-sieve =
  let dataHex = list-append "0x" (h-hex upr-hf-sieve-bytecode)
      params  = h-concat
                  (cons "[{"
                  (cons (h-quote "data") (cons ":" (cons (h-quote dataHex)
                  (cons "}," (cons (h-quote "latest") (cons "]" nil)))))))
  in bind (bl-rpc-call "eth_call" params) (λ resp →
       ret {lzero} {W} (bl-extract-json-hex resp))

upr-h200-cmd : List Word
upr-h200-cmd =
  "nvidia-smi --query-gpu=index,name,utilization.gpu --format=csv,noheader | paste -sd ';' - && (test -f /tmp/hx_brainnet_asm/masterstroke_ulop3_sm90a.ptx && /usr/local/cuda/bin/ptxas --gpu-name=sm_90a /tmp/hx_brainnet_asm/masterstroke_ulop3_sm90a.ptx -o /tmp/hx_brainnet_asm/upr_ulop3.cubin 2>&1 || true) && echo H200_PORTAL_ULOP3_READY"

upr-h200-activate : Proc W (Word × List Word)
upr-h200-activate =
  h-capture
    (cons "/usr/bin/ssh"
    (cons "-o" (cons "BatchMode=yes"
    (cons "-o" (cons "ConnectTimeout=8"
    (cons "-o" (cons "StrictHostKeyChecking=no"
    (cons "-p" (cons "10166"
    (cons "root@213.181.104.219"
    (cons upr-h200-cmd nil)))))))))))

upr-drop-args : Nat → List (List Word) → List (List Word)
upr-drop-args zero    xs          = xs
upr-drop-args (suc k) nil         = nil
upr-drop-args (suc k) (cons x xs) = upr-drop-args k xs

upr-clean-args : Nat → List (List Word) → List (List Word)
upr-clean-args zero    xs          = nil
upr-clean-args (suc k) nil         = nil
upr-clean-args (suc k) (cons a rs) =
  if h-eq a "--with"
  then upr-clean-args k (upr-drop-args (toNat #2) rs)
  else cons a (upr-clean-args k rs)

upr-is-activate : List (List Word) → Bool
upr-is-activate nil         = false
upr-is-activate (cons a rs) = if h-eq a "hyperactivate" then true else upr-is-activate rs

upr-is-direct : List (List Word) → Bool
upr-is-direct nil         = false
upr-is-direct (cons a rs) =
  if h-infix "hx-univalent-portal-router" a then true
  else upr-is-direct rs

upr-offline-summary : List Word
upr-offline-summary =
  let demoSurplus = upr-thin-concave (toNat #9) #1 #512
      demoSplit   = upr-settle-word demoSurplus
      fnd55       = eth-eip55-from-bytes20 eth-founder-coinbase-addr20
  in h-concat
       (cons (bn-ln "[HX-PORTAL-ROUTER | COLD-VERIFIED OFFLINE SUMMARY — PASS `hyperactivate` FOR LIVE BASE+H200]")
       (cons (bn-ln (list-append "  1. Zero-solc 11-Word Sieve : " (list-append (upr-dec40 (fromNat (list-length upr-hf-sieve-bytecode))) (list-append "B init -> 352B ret | Founder=" fnd55))))
       (cons (bn-ln (list-append "  2. Thin-Tick Concave Proof : [SIMULATED WITNESS] opt_uUSDC=" (list-append (upr-dec40 demoSurplus) (list-append " ($250_floor=0) -> Founder=" (list-append (upr-dec40 (fst demoSplit)) (list-append " + Reinvest=" (upr-dec40 (snd demoSplit)))))))) nil)))

upr-exec-live : Proc W Unit
upr-exec-live =
  bind (bl-rpc-call "eth_blockNumber" "[]") (λ rBlk →
  bind upr-run-sieve (λ sHex →
  bind upr-h200-activate (λ rH200 →
    let blkNum      = bl-hex-to-word (bl-extract-json-hex rBlk)
        morUsdc6    = upr-word-at zero sHex
        morWethW    = upr-word-at (suc zero) sHex
        pxUni1      = upr-sqrtpx96-to-usdc6 (upr-word-at (toNat #2) sHex)
        liqUni1     = upr-word-at (toNat #3) sHex
        pxCake1     = upr-sqrtpx96-to-usdc6 (upr-word-at (toNat #4) sHex)
        liqCake1    = upr-word-at (toNat #5) sHex
        pxAero      = upr-sqrtpx96-to-usdc6 (upr-word-at (toNat #6) sHex)
        rawFeeAero  = upr-word-at (toNat #7) sHex
        feeAeroPips = if %weq rawFeeAero #0 then #100 else rawFeeAero
        liqAero     = upr-word-at (toNat #8) sHex
        pxUni5      = upr-sqrtpx96-to-usdc6 (upr-word-at (toNat #9) sHex)
        fndUsdc6    = upr-word-at (toNat #10) sHex
        gpUC        = upr-gross-pips pxUni1 pxCake1
        gpUA        = upr-gross-pips pxUni1 pxAero
        gpCA        = upr-gross-pips pxCake1 pxAero
        feeUC       = #200
        feeUA       = %wadd #100 feeAeroPips
        feeCA       = %wadd #100 feeAeroPips
        netUC       = if %wlt feeUC gpUC then %wsub gpUC feeUC else #0
        netUA       = if %wlt feeUA gpUA then %wsub gpUA feeUA else #0
        netCA       = if %wlt feeCA gpCA then %wsub gpCA feeCA else #0
        bestNetPips = upr-max3 netUC netUA netCA
        demoSurplus = upr-thin-concave (toNat #9) #1 #512
        demoSplit   = upr-settle-word demoSurplus
        fnd55       = eth-eip55-from-bytes20 eth-founder-coinbase-addr20
        l1 = bn-ln "[HX-PORTAL-ROUTER | UNIVALENT PORTAL + DIAMOND TIR + PER-EVENT FOUNDER ROUTER | READ-ONLY ON-CHAIN SIEVE]"
        l2 = bn-ln (list-append "  1. Base 8453 Block #" (list-append (upr-dec40 blkNum) (list-append " | 11-Word Zero-solc Sieve=" (list-append (upr-dec40 (fromNat (list-length upr-hf-sieve-bytecode))) (list-append "B->352B | Founder=" (list-append fnd55 (list-append " (onchain_uUSDC=" (list-append (upr-dec40 fndUsdc6) ")"))))))))
        l3 = bn-ln (list-append "  2. Morpho 0-bps Pulse  : USDC=$" (list-append (upr-dec40 (%wdiv morUsdc6 #1000000000000)) (list-append "M | WETH=" (list-append (upr-dec40 (%wdiv morWethW #1000000000000000000)) " ETH (0.00% fee, 0B parked LP inventory)"))))
        l4 = bn-ln (list-append "  3. 1bp/Dyn Plaquette   : UniV3_1bp=" (list-append (upr-dec40 pxUni1) (list-append " | CakeV3_1bp=" (list-append (upr-dec40 pxCake1) (list-append " | Aero_dyn=" (list-append (upr-dec40 pxAero) (list-append " (fee=" (list-append (upr-dec40 feeAeroPips) (list-append " pips) | UniV3_5bp=" (upr-dec40 pxUni5))))))))))
        l5 = bn-ln (list-append "  4. Active Tick Liq (L) : L_Uni1=" (list-append (upr-dec40 liqUni1) (list-append " | L_Cake1=" (list-append (upr-dec40 liqCake1) (list-append " | L_Aero=" (list-append (upr-dec40 liqAero) (list-append " | live_net_pips=" (upr-dec40 bestNetPips))))))))
        l6 = bn-ln (list-append "  5. Micro-Concave Proof : [SIMULATED THIN-TICK WITNESS $0 SETTLED] opt_uUSDC=" (list-append (upr-dec40 demoSurplus) (list-append " ($250_floor=0!) -> Founder_50pct=" (list-append (upr-dec40 (fst demoSplit)) (list-append " + Reinvest=" (upr-dec40 (snd demoSplit)))))))
        l7 = bn-ln (list-append "  6. 8x H200 SM_90a Mesh : " (snd rH200))
    in h-out (h-concat (cons l1 (cons l2 (cons l3 (cons l4 (cons l5 (cons l6 (cons l7 nil)))))))))))

upr-run : Step W Unit
upr-run =
  to-step
    (bind h-args (λ av →
      let tailAv  = h-tail-lists av
          cleanAv = upr-clean-args (list-length tailAv) tailAv
      in if upr-is-activate cleanAv
         then bind upr-exec-live (λ u → exit #0)
         else if upr-is-direct cleanAv
              then h-out upr-offline-summary
              else ret {lzero} {W} unit))

#run upr-run
