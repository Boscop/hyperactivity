--   * `networkReinvest = snd (upr-split2 d)` (`<= 50%`, compounding active routing capacity!)
upr-split2 : Nat → Nat × Nat
upr-split2 zero          = (zero , zero)
upr-split2 (suc zero)    = (zero , suc zero)
upr-split2 (suc (suc d)) =
  let r = upr-split2 d
  in (suc (fst r) , suc (snd r))

upr-lem-split2-sum : (d : Nat) → plus (fst (upr-split2 d)) (snd (upr-split2 d)) ≡ d
upr-lem-split2-sum zero          = refl
upr-lem-split2-sum (suc zero)    = refl
upr-lem-split2-sum (suc (suc d)) =
  let r  = upr-split2 d
      s1 = upr-plus-suc-r (fst r) (snd r)
      s2 = fio-cong suc (upr-lem-split2-sum d)
  in fio-cong suc (fio-trans s1 s2)

-- Settle one routing event of surplus `ev`:
--   If `ev = zero`, `(0, 0)`.
--   If `ev = suc d` (positive value delivered!), Founder receives `suc (fst (upr-split2 d))` (`>= 1`, ceiling 50%!)
--   and network receives `snd (upr-split2 d)`, with exact sum `=== suc d` (ZERO dust)!
upr-settle-event : Nat → Nat × Nat
upr-settle-event zero    = (zero , zero)
upr-settle-event (suc d) =
  let r = upr-split2 d
  in (suc (fst r) , snd (upr-split2 d))

upr-lem-event-conserved : (ev : Nat) → plus (fst (upr-settle-event ev)) (snd (upr-settle-event ev)) ≡ ev
upr-lem-event-conserved zero    = refl
upr-lem-event-conserved (suc d) = fio-cong suc (upr-lem-split2-sum d)

