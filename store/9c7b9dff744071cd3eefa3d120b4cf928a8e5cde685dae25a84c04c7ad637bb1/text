-- ---------------------------------------------------------------- the theorems
k-run-path : (t : List (List Word)) → (rr : List Word) → (f : List (List Word) → Word) → rr ≡ list-map f (sufs t) →
             kasai-by t rr ≡ k-scan (build (list-length (k-Lf t f)) (k-Lf t f)) zero t (list-map f (sufs t))
k-run-path t rr f e =
  tr {List KOut} {kasai-by t rr} {k-scan (build (list-length (k-Lf t f)) (k-Lf t f)) zero t (list-map f (sufs t))}
     (k-scan (build (list-length (k-L t (list-map f (sufs t)))) (k-L t (list-map f (sufs t)))) zero t (list-map f (sufs t)))
     (λ i → k-scan (build (list-length (k-L t (e i))) (k-L t (e i))) zero t (e i))
     (λ i → k-scan (build (list-length (msort-list {k-PR} (k-zipr-map f (sufs t) i))) (msort-list {k-PR} (k-zipr-map f (sufs t) i))) zero t (list-map f (sufs t)))
