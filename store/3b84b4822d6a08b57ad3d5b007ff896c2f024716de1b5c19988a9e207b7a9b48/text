fi-hi : Bool → IW → Float64
fi-hi sg w = case sg of
  true → (case w of
    iw8 → f64 #128
    iw16 → f64 #32768
    iw32 → f64 #2147483648
    _ → f64 #9223372036854775808)
  false → (case w of
    iw8 → f64 #256
    iw16 → f64 #65536
    iw32 → f64 #4294967296
    _ → f64mul (f64 #4294967296) (f64 #4294967296))
