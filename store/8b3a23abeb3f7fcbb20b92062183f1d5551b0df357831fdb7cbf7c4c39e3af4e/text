-- the first q occurrences met reading the reversed text (of l bytes), each as the position it starts at in
-- the text read forward: after i bytes read, the last of them (position i - 1 of the reversed text) in
-- state e is an occurrence starting at l - i. They are met latest first, so the list, consed as they are
-- met, is in increasing order
m-occ-go : (n : Nat) → Bytes n → (k : Nat) → Bytes k → Word → Word → Word → Word → Word → Word → List Word → List Word → List Word
m-occ-go n p k f m e l q i j acc nil = if andB (weq j e) (h-not (weq q #0)) then cons (wsub l i) acc else acc
m-occ-go n p k f m e l q i j acc (cons c r) = if weq q #0 then acc else
  (if weq j e then m-occ-go n p k f m e l (wsub q #1) (wadd i #1) (m-next n p k f m j c) (cons (wsub l i) acc) r
   else m-occ-go n p k f m e l q (wadd i #1) (m-next n p k f m j c) acc r)
