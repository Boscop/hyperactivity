nk-dup-shared-ev : (rho : NkW → NkEv) (a b n : NkW) (h : NkHd) (w : NkW) (r : NkEnv) →
  (nk-ebound (nke-cons w r) n ≡ true) →
  let v = nkv h (nke-cons w r)
      rho2 = nk-rho-set rho n (nk-val-ev rho v)
  in (nk-val-ev rho2 v ≡ nk-val-ev rho v)
     × ((nk-val-ev rho2 (nkv-ref n) ≡ nk-val-ev rho v)
        × (nk-val-ev rho2 (nkv-ref n) ≡ nk-val-ev rho v))
nk-dup-shared-ev rho a b n h w r hb =
  let v = nkv h (nke-cons w r)
      rho2 = nk-rho-set rho n (nk-val-ev rho v)
      ev_v = cong (λ z → nkev h z) (nk-env-ev-set-lt rho n (nk-val-ev rho v) (nke-cons w r) hb)
      ev_r = nk-rho-set-same rho n (nk-val-ev rho v)
  in (ev_v , (ev_r , ev_r))
