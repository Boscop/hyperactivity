-- taking q from an account holding k + q leaves k there and q fewer in the sum
cr-take : (xs : List Nat) → (i k q : Nat) → cr-has xs i → plus k q ≡ cr-at xs i → plus q (cr-sum (cr-set xs i k)) ≡ cr-sum xs
cr-take nil i k q h e = Empty-rec (cr-no-account i h)
cr-take (cons x r) zero k q h e = transN (sym (plus-assoc q k (cr-sum r)))
  (transN (congN (λ z → plus z (cr-sum r)) (plus-comm q k)) (congN (λ z → plus z (cr-sum r)) e))
cr-take (cons x r) (suc i) k q h e =
  transN (plus-comm-mid q x (cr-sum (cr-set r i k))) (congN (plus x) (cr-take r i k q (cr-has-tail x r i h) e))
