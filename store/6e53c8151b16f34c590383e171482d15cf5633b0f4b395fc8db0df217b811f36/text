-- Exact compositional telescoping law: feeding (a ++ b) advances the exact same causal state as a then b
cstate-feed-append : (a : List Word) → (st : CtxState) → (b : List Word) →
                     cstate-feed st (list-append a b) ≡ cstate-feed (cstate-feed st a) b
cstate-feed-append a =
  case a return (λ u → (st : CtxState) → (b : List Word) → cstate-feed st (list-append u b) ≡ cstate-feed (cstate-feed st u) b) of
    nil → λ st b i → cstate-feed st b
    cons x r → λ st b → rec r (cstate-advance st x) b
