-- Factoring shared block scale s out of an arbitrary-shape MAC tree saves N-1 exponent multiplies per tile!
mxfp-scale-factor : (s : Nat) → (t : ATree Nat) →
  atree-eval plus (atree-map (times s) t) ≡ times s (atree-eval plus t)
mxfp-scale-factor s (aleaf a) = refl
mxfp-scale-factor s (anode l r) =
  transN (cong2N plus (mxfp-scale-factor s l) (mxfp-scale-factor s r))
    (sym (times-distr-r s (atree-eval plus l) (atree-eval plus r)))
