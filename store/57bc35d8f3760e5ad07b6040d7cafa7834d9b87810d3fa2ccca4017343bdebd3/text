tw-main : List (List Word) → Step W Word
tw-main args =
  let p  = tw-pref args
      sf = list-append p "_tower.sv"
      uf = list-append p "_tower.cu"
      cf = list-append p "_tower.c"
      mf = list-append p "_tower.metal"
      hf = list-append p "_tower_host.m"
  in scmd w-now (λ t0 →
     scmd (w-file-write-named sf tw-sv-src) (λ bs →
     scmd (w-file-write-named uf tw-cuda-src) (λ bu →
     scmd (w-file-write-named cf tw-c-src) (λ bc →
     scmd (w-file-write-named mf tw-metal-src) (λ bm →
     scmd (w-file-write-named hf (tw-host-src mf)) (λ bh →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-TOWER (Metacircular Fixpoint) | 2^m-Level Sound=Proved | Cost-Mono=Proved | 7->1 Fixpoint=Proved | SV="
       (list-append (ce-dec bs)
       (list-append "B CUDA=" (list-append (ce-dec bu)
       (list-append "B C11=" (list-append (ce-dec bc)
       (list-append "B Metal=" (list-append (ce-dec bm)
       (list-append "B Host=" (list-append (ce-dec bh)
       (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))))))))
       (sdone #0))))))))
