cs-hy-shl-mono : (hp : CsHeap) (a b : Word) → cs-res-mono hp (cs-hy-shl hp a b)
cs-hy-shl-mono hp a b =
  cs-ite-res-mono (if %weq a #0 then true else %weq b #0) hp
    (cso-ok hp (csv-word a))
    (if c-not (%wlt b #64) then cso-abort else cs-hy-shl-prim hp a b (cs-c11-shr64 a (%wsub #64 b)))
    (cs-heap-ext-refl hp)
    (cs-ite-res-mono (c-not (%wlt b #64)) hp cso-abort
      (cs-hy-shl-prim hp a b (cs-c11-shr64 a (%wsub #64 b)))
      unit (cs-hy-shl-prim-mono hp a b (cs-c11-shr64 a (%wsub #64 b))))
