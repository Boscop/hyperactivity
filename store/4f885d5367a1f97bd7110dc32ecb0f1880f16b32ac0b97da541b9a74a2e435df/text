nk-clear?-sound : (u : Word) (fx : NkFx) → (nk-clear? u fx ≡ true) → nk-apart u fx
nk-clear?-sound u fx h =
  let a = nk-off? u (nk-puts fx)
      b = nk-off? u (nk-vals fx)
      c = nk-off? u (nk-ops fx)
  in nk-apart-of-offs fx u (nk-off?-sound u (nk-puts fx) (nk-and-l a (nk-and b c) h)) (nk-off?-sound u (nk-vals fx) (nk-and-l b c (nk-and-r a (nk-and b c) h))) (nk-off?-sound u (nk-ops fx) (nk-and-r b c (nk-and-r a (nk-and b c) h)))
