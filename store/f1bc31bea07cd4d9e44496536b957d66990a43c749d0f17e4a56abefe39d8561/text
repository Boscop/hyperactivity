b2-inv-snd : (x y : ZWord) → z-eq (snd (b2 (b2 (x , y)))) (z-double y)
b2-inv-snd x y =
  same-norm-eq (z4-env (fst x) (snd x) (fst y) (snd y))
    (lc-add (lc-add (lc-add (lc-var #0) (lc-var #2)) (lc-add (lc-var #1) (lc-var #2)))
            (lc-add (lc-var #3) (lc-var #3)))
    (lc-add (lc-add (lc-var #2) (lc-var #2))
            (lc-add (lc-add (lc-var #1) (lc-var #3)) (lc-add (lc-var #0) (lc-var #3))))
    refl
