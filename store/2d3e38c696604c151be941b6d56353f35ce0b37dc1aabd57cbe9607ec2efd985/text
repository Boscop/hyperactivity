grid-zz-ok : (g : List (List Word)) → grid-zz-dec (grid-zz-enc g) ≡ g
grid-zz-ok g =
  concat {lzero} {List (List Word)}
    {list-map zz-undelta (grid-col-zz-dec nil (grid-col-zz-enc nil (list-map zz-delta g)))}
    {list-map zz-undelta (list-map zz-delta g)} {g}
    (cong {lzero} {lzero} {List (List Word)} {List (List Word)} (list-map zz-undelta) (grid-col-zz-ok nil (list-map zz-delta g)))
    (concat {lzero} {List (List Word)}
      {list-map zz-undelta (list-map zz-delta g)} {list-map (λ r → zz-undelta (zz-delta r)) g} {g}
      (cm-map-comp zz-undelta zz-delta g) (cm-map-id (λ r → zz-undelta (zz-delta r)) zz-delta-ok g))
