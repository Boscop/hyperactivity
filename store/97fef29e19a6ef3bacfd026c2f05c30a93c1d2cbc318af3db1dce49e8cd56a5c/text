-- replay: the run is a function of the recorded choices. Running the fleet as a process over
-- the environment's signature against the record (feed-world) ends done in the same state
-- with the record used up
kvr-replay : Path (Outcome (FState KvMsg KvSt) × List Adv)
                  (runp {EnvS} {FState KvMsg KvSt} {List Adv} (fleet-proc {KvMsg} {KvSt} kv-seq-beh (nt-len {Adv} kvr-choices) kvr-init) (feed-world {Adv}) kvr-choices)
                  (done kvr-final , nil)
kvr-replay = fleet-proc-run {KvMsg} {KvSt} kv-seq-beh kvr-choices kvr-init
