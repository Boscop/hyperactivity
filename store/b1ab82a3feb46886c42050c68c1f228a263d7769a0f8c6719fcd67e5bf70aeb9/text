circ-opt-leB : {V : Type} → (c : Circ B0 B1 B2 V) →
  leB (circ-gates (circ-opt c)) (circ-gates c) ≡ true
circ-opt-leB {V} c =
  case c return (λ w →
    Path Bool (leB (circ-gates {B0} {B1} {B2} {V} (circ-opt {V} w)) (circ-gates {B0} {B1} {B2} {V} w)) true) of
    cwire v → λ _ → true
    cop0 k → λ _ → true
    cop1 u a →
      leB-trans
        (circ-gates (opt-1 u (circ-opt {V} a)))
        (suc (circ-gates (circ-opt {V} a)))
        (suc (circ-gates a))
        (opt-1-le u (circ-opt {V} a))
        (rec a)
    cop2 b x y →
      leB-trans
        (circ-gates (opt-2 b (circ-opt {V} x) (circ-opt {V} y)))
        (suc (plus (circ-gates (circ-opt {V} x)) (circ-gates (circ-opt {V} y))))
        (suc (plus (circ-gates x) (circ-gates y)))
        (opt-2-le b (circ-opt {V} x) (circ-opt {V} y))
        (leB-plus (circ-gates (circ-opt {V} x)) (circ-gates x) (circ-gates (circ-opt {V} y)) (circ-gates y) (rec x) (rec y))
