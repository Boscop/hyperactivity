zeq-trans : (x y z : Nat × Nat) → zeq x y → zeq y z → zeq x z
zeq-trans x y z e1 e2 = plus-cancel-l (plus (fst y) (snd y)) (plus (fst x) (snd z)) (plus (fst z) (snd x))
  (transN (rearr4 (fst y) (snd y) (fst x) (snd z))
  (transN (cong2plus (plus (fst x) (snd y)) (plus (fst y) (snd x)) (plus (fst y) (snd z)) (plus (fst z) (snd y)) e1 e2)
  (transN (rearr4 (fst y) (snd x) (fst z) (snd y)) (plus-comm (plus (fst z) (snd x)) (plus (fst y) (snd y))))))
