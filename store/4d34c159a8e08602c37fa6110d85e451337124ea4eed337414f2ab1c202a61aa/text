-- Closed-form Q16 modal inverse: given squared angular frequencies (om1Sq, om2Sq),
-- returns exact (k, w) such that symmetric mode = om1Sq and antisymmetric mode = om2Sq!
hologram-invert-kw : Word → Word → Word × Word
hologram-invert-kw om1Sq om2Sq =
  let k = om1Sq
      w = if %wlt om1Sq om2Sq then %wshr (%wsub om2Sq om1Sq) #1 else #0
  in (k , w)
