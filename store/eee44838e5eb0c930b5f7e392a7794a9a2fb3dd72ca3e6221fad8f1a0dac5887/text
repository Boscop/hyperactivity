ni-mul : Bool → IW → UInt64 → UInt64 → MRes UInt64
ni-mul sg w a b =
  let r = u64mul a b
  in case sg of
       false → mok (uq-zx w r)
       true → (case w of
         iw64 → (let p = dq-mul (dq-sx a) (dq-sx b)
                 in case u64eq (snd p) (snd (dq-sx (fst p))) of
                      true → mok r
                      false → mub ub-signed-overflow)
         _ → ni-fit w r)
