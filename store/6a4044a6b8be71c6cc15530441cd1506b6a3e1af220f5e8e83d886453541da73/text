nk-set-disj-neq : (al1 al2 : NkEnv) (n1 m1 n2 m2 w k : NkW) →
  (nk-ebound al1 n1 ≡ true) → (nk-ebound al2 n1 ≡ true) → (nk-edisj al1 al2 ≡ true) →
  (nk-wire-le n1 m1 ≡ true) → (nk-wire-le m1 n2 ≡ true) →
  (nk-in-set al1 n1 m1 w ≡ true) → (nk-in-set al2 n2 m2 k ≡ true) →
  nk-weq w k ≡ false
nk-set-disj-neq al1 al2 n1 m1 n2 m2 w k bnd1 bnd2 dj p12 pm hw hk =
  nk-set-disj-neq-at (nk-emem w al1) (nk-emem k al2) al1 al2 n1 m1 n2 m2 w k bnd1 bnd2 dj p12 pm refl refl hw hk
