-- LVS Euler Extraction Soundness Theorem: extracted transistor schematic equals physical diffusion strip!
lvs-euler-sound : {V : Type} → (env : V → Bool) → (gs : List V) → (g0 : V) →
  nmos-on env (extract-strip-pdn g0 gs) ≡ strip-conducts env g0 gs
lvs-euler-sound env nil = λ g0 _ → env g0
lvs-euler-sound env (cons g gs) = λ g0 i → andB (env g0) (lvs-euler-sound env gs g i)
