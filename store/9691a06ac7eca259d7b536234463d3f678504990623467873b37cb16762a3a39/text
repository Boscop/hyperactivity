cmap-id : (sk : Lst Entry) (X : Type 1) (c : Cube (dims sk) X) → PathP (λ i → Cube (dims sk) X) (cmap-cube sk sk (cmap-of sk sk (λ k → k)) X c) c
cmap-id lnil X c = λ i → c
cmap-id (lcons (e-ty s) sk) X c =
  pcat (Cube (dims sk) X) (cmap-cube (lcons (e-ty s) sk) (lcons (e-ty s) sk) (cmap-of (lcons (e-ty s) sk) (lcons (e-ty s) sk) (λ k → k)) X c)
    (cmap-cube sk sk (cmap-of sk sk (λ k → k)) X c) c (cmap-skip (e-ty s) sk sk (λ k → k) X c) (cmap-id sk X c)
cmap-id (lcons e-dim sk) X c =
  pcat (Cube (suc (dims sk)) X) (cmap-cube (lcons e-dim sk) (lcons e-dim sk) (cmap-of (lcons e-dim sk) (lcons e-dim sk) (λ k → k)) X c)
    (cmap-cube sk sk (cmap-of sk sk (λ k → k)) (Line X) c) c (cmap-keep e-dim sk sk (λ k → k) X c) (cmap-id sk (Line X) c)
