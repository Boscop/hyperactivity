ms-sv-gates : Word → List (Word × Word) → List Word → List Word
ms-sv-gates _ nil tl = tl
ms-sv-gates nw (cons g gs) tl =
  ms-cat (cons "  wire w" (cons (ce-dec nw) (cons " = ~(w" (cons (ce-dec (fst g))
         (cons " & w" (cons (ce-dec (snd g)) (cons ");" (cons ce-nl
         (cons (ms-sv-gates (%wsucc nw) gs tl) nil)))))))))
