sx-ok-cons : (x : List Word) (qr : List (List Word)) (ts : List (List Word)) (i : Nat) →
  look (cons x qr) (shard (skey x) i ts) ≡ hits (cons x qr) i ts
sx-ok-cons x qr ts =
  case ts return λ w → (i : Nat) → look (cons x qr) (shard (skey x) i w) ≡ hits (cons x qr) i w of
    nil → λ i j → nil
    cons t r → λ i →
      sx-step (cons x qr) i (cons t r) (tok-eq (skey t) (skey x)) (in-shard x qr t r)
        (shard (skey x) (suc i) r) (hits (cons x qr) (suc i) r) (rec r (suc i))
