-- a plan reads the memory at one wire only: two memories that agree there give the same plan
nk-plan-by-at : (h : Opt Word) (o : NkOp) (v : NkVal) (u n : Word) (a b : NkSlots) → (nk-get a (opt-or h u) ≡ nk-get b (opt-or h u)) → nk-plan-by h o v u n a ≡ nk-plan-by h o v u n b
nk-plan-by-at (some w) o v u n a b e = cong (λ z → nk-plan-read z o u n) e
nk-plan-by-at none o v u n a b e = refl
