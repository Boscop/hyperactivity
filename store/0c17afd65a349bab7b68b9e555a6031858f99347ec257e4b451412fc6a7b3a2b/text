nk-has-fail : NkTm → Bool
nk-has-fail (nk-lam b) = nk-has-fail b
nk-has-fail (nk-susp b) = nk-has-fail b
nk-has-fail (nk-con c as) = if %weq c #99 then true else nk-has-fail as
nk-has-fail (nk-op h p as) = if nk-has-fail p then true else nk-has-fail as
nk-has-fail (nk-match h p cs) = if nk-has-fail p then true else nk-has-fail cs
nk-has-fail (nk-cons t r) = if nk-has-fail t then true else nk-has-fail r
nk-has-fail t = false
