fl-apply-self : {M St R : Type} → (P : St → Type) → (i j : NodeId) → (g : FState M St) → (r : Sum (R × Net M) (Net M)) → (k : R → St) → eqb i j ≡ true →
                P (fst g i) → ((x : R) → P (k x)) → P (fst (fl-apply {M} {St} {R} j g r k) i)
fl-apply-self {M} {St} {R} P i j g (inl x) k e h hk = subst {lzero} {lzero} {St} {P} (sym (put-node-same {St} i j (k (fst x)) (fst g) e)) (hk (fst x))
fl-apply-self {M} {St} {R} P i j g (inr n) k e h hk = h
