-- ---------------------------------------------------------------- §8.5 (8.17) fixed-size encodings
-- an n-byte word: the high n bytes then the least significant byte; enc(x)(i) is byte i counted from
-- the least significant, ⌊x / 256^i⌋ mod 256, and dec is Σ 256^i b(i), returned as some value
bytes-bits : Nat → Nat
bytes-bits zero = zero
bytes-bits (suc n) = plus (bytes-bits n) 8
