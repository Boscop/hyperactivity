nk-build-gref-wf : (ins outs : NkEnv) (n0 : NkW) (gi : Word) (e : NkEnv) (out : NkW) (o : NkOut) →
  (nk-wire-le n0 (nk-n o) ≡ true) → (nk-env-in-set ins n0 (nk-n o) e ≡ true) →
  (nk-out-ok ins outs n0 (nk-n o) o ≡ true) →
  nk-out-ok ins outs n0 (nk-n o) (nk-build-gref gi e out o) ≡ true
nk-build-gref-wf ins outs n0 gi e out (nk-out fx n ws) p0 he ho =
  let sn = nk-s n
      rn = nk-in-range-self n0 n p0
      pfx0 = nk-out-ok-fx ins outs n0 n (nk-out fx n ws) ho
      he_s = nk-env-in-set-up ins n0 n sn e (nk-wire-le-s n) he
      pfx_e = nk-era-env-wf ins outs n0 sn e fx he_s (nk-fx-wf-up ins outs n0 n sn fx (nk-wire-le-s n) pfx0)
      pfx_op = nk-and-intro (nk-in-set ins n0 sn n) (nk-fx-wf ins outs n0 sn (nk-era-env e fx)) (nk-in-set-range ins n0 sn n rn) pfx_e
      pfx_v = nk-and-intro (nk-in-set outs n0 sn n) (nk-fx-wf ins outs n0 sn (nkf-op n (nko-el #4 nk-nil nke-nil out) (nk-era-env e fx))) (nk-in-set-range outs n0 sn n rn) pfx_op
  in nk-out-ok-intro ins outs n0 n (nkf-val n (nkv-ref (nk-bw-of (%wadd gi #2))) (nkf-op n (nko-el #4 nk-nil nke-nil out) (nk-era-env e fx))) sn nke-nil
       (nk-wire-le-s n) pfx_v refl
