-- the tree with its root at o
si-w-tree : RTree (El entry-ord) → Word → List Word → List Word
si-w-tree t = case t return λ w → Word → List Word → List Word of
  rleaf → λ o rest → cons #0 rest
  rnode a sz x b → λ o rest → cons #1 (si-w4 sz (si-w4 (snd x) (si-w4 (wadd (wadd o #13) (si-tsize a))
    (rec a (wadd o #13) (rec b (wadd (wadd o #13) (si-tsize a)) rest)))))
