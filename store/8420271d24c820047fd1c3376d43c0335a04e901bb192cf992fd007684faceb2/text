-- Unified End-to-End Byte-to-Byte 2D Sensory Grid Compressor:
--   2D grid → Pass 3 2-cell cubical curvature Δ_xy (grid-zz-enc) → flatten → Pass 5 rANS → bytes!
split-at-n : {A : Type} → Nat → List A → List A × List A
split-at-n zero xs = (nil , xs)
split-at-n (suc n) nil = (nil , nil)
split-at-n (suc n) (cons x r) = let p = split-at-n n r in (cons x (fst p) , snd p)
