fold-lie-torque-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
fold-lie-torque-poly A ad mu q vs =
  (λ g sub →
    let ux = g 0; uy = g 1; uz = g 2
        px = g 3; py = g 4; pz = g 5
        rx = g 6; ry = g 7; rz = g 8
        fx = g 9; fy = g 10; fz = g 11
        dx = sub rx px; dy = sub ry py; dz = sub rz pz
        vx = sub (mu uy dz) (mu uz dy)
        vy = sub (mu uz dx) (mu ux dz)
        vz = sub (mu ux dy) (mu uy dx)
        lhs = ad (ad (mu fx vx) (mu fy vy)) (mu fz vz)
        mx = sub (mu ry fz) (mu rz fy)
        my = sub (mu rz fx) (mu rx fz)
        mz = sub (mu rx fy) (mu ry fx)
        qx = sub (mu py fz) (mu pz fy)
        qy = sub (mu pz fx) (mu px fz)
        qz = sub (mu px fy) (mu py fx)
        uM = ad (ad (mu ux mx) (mu uy my)) (mu uz mz)
        uP = ad (ad (mu ux qx) (mu uy qy)) (mu uz qz)
        rhs = sub uM uP
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
