-- THEOREM 6: UNIVERSAL ARBITRARY-DEPTH SELF-IMPROVEMENT MONOTONICITY OVER ALL TOWER LEVELS k : Nat!
tw-thm-tower-cost-monotone : (f : INet → INet) →
  ((n : INet) → hm-le (in-cost (f n)) (in-cost n) ≡ true) →
  (k : Nat) → (n : INet) → hm-le (in-cost (in-tower k f n)) (in-cost n) ≡ true
tw-thm-tower-cost-monotone _ _  zero    n = hm-le-refl (in-cost n)
tw-thm-tower-cost-monotone f pf (suc k) n =
  hm-le-trans (in-cost (f (in-tower k f n))) (in-cost (in-tower k f n)) (in-cost n)
    (pf (in-tower k f n)) (tw-thm-tower-cost-monotone f pf k n)
