-- 10 chunks per circle (multiple of 5 & 10 -> exact C_5 / C_10 rotational symmetry!)
hopf-fiber-chunks : Nat → Word → SInt → SInt → SInt → List HArc
hopf-fiber-chunks zero c cEta sEta xi2 = nil
hopf-fiber-chunks (suc rem) c cEta sEta xi2 =
  let t0 = si-sub (sp (wquot (wmul fx-two-pi c) #10)) (sp #400)
      t1 = si-add (sp (wquot (wmul fx-two-pi (%wsucc c)) #10)) (sp #400)
      pts = hopf-sample-pts 9 #8 #0 cEta sEta t0 (si-sub t1 t0) xi2
  in cons (harc (hpts-z-avg pts) pts) (hopf-fiber-chunks rem (%wsucc c) cEta sEta xi2)
