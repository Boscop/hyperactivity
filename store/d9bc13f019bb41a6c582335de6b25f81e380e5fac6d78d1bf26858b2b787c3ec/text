-- a command of the memory signature, and one of the reader's world: the response is the value
ev-memc : {l : Level} {S : Sig} {V : Type} → (c : MemC) → Ev {l} S V (m-resp c)
ev-memc {l} {S} {V} c =
  bind {l} {MK S} {m-resp c} {EvR V (m-resp c)} (cmd {l} {MK S} (inl c)) (λ r → ev-ret {l} {S} {V} {m-resp c} r)
