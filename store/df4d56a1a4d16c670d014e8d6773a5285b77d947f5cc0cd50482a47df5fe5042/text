-- a primitive written as a word: the machine's conversion (i64 17, u32 19; a float through its
-- Int64 part, 22 then 17), unary operations from 256
prim-to-word : Word → Code → Code
prim-to-word k f =
  if %weq k #0 then cprim #273 (lcons f lnil)
  else (if %weq k #1 then cprim #275 (lcons f lnil)
  else cprim #273 (lcons (cprim #278 (lcons f lnil)) lnil))
