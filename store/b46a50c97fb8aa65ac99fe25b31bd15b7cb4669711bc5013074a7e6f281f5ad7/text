ch-lem-tail :
  (s k : Nat) →
  ch-le (suc (suc (suc k))) (ch-mul (suc k) (suc (suc (suc s)))) ≡ true
ch-lem-tail _ zero    = refl
ch-lem-tail s (suc k) =
  let rhs = the Nat (ch-mul (suc k) (suc (suc (suc s))))
      ih  = ch-lem-tail s k
  in ch-le-weak (suc (suc (suc k))) (suc (plus s rhs))
       (ch-le-weak (suc (suc (suc k))) (plus s rhs)
         (ch-le-plus-l s (suc (suc (suc k))) rhs ih))
