-- ---------------------------------------------------------------- correct at an argument
-- a run from the call's state to the return whose result is f's value (or the overflow exit)
Reaches : Lst Word → Lst Word → Word → Type
Reaches bs args v =
  (k : Word) × ((s2 : X86) × (Runs x86-step mn-ret k (mn-init bs args) s2 × ((weq (x86-rip s2) mn-ret ≡ true) × (opt-or (mn-result (some s2)) v ≡ v))))
