nk-stuck-el-wf : (ins : NkEnv) (h : Word) (cs : NkTm) (aux : NkEnv) (out : NkW) (v : NkVal) (n : NkW) →
  (nk-env-in-set ins n (nk-s n) aux ≡ true) →
  nk-out-ok ins (nke-cons out nke-nil) n n (nk-stuck-el h cs aux out v n) ≡ true
nk-stuck-el-wf ins h nk-nil aux out v n haux =
  let outs = nke-cons out nke-nil
      sn = nk-s n
      rn = nk-in-range-self n n (nk-wire-le-refl n)
      hout = nk-in-set-hd out nke-nil n sn
      hfx = nk-and-intro (nk-in-set outs n sn n) (nk-fx-wf ins outs n sn (nkf-val out (nkv (hd-stuck h) (nke-cons n aux)) nkf-nil))
              (nk-in-set-range outs n sn n rn)
              (nk-and-intro (nk-in-set outs n sn out) true hout refl)
  in nk-out-ok-intro ins outs n n (nkf-val n v (nkf-val out (nkv (hd-stuck h) (nke-cons n aux)) nkf-nil)) sn nke-nil (nk-wire-le-s n) hfx refl
nk-stuck-el-wf ins h (nk-var i) aux out v n haux = nk-stuck-cs-wf ins h (nk-var i) aux out v n haux
nk-stuck-el-wf ins h (nk-free x) aux out v n haux = nk-stuck-cs-wf ins h (nk-free x) aux out v n haux
nk-stuck-el-wf ins h (nk-num m) aux out v n haux = nk-stuck-cs-wf ins h (nk-num m) aux out v n haux
nk-stuck-el-wf ins h (nk-lam b) aux out v n haux = nk-stuck-cs-wf ins h (nk-lam b) aux out v n haux
nk-stuck-el-wf ins h (nk-susp b) aux out v n haux = nk-stuck-cs-wf ins h (nk-susp b) aux out v n haux
nk-stuck-el-wf ins h (nk-con c as) aux out v n haux = nk-stuck-cs-wf ins h (nk-con c as) aux out v n haux
nk-stuck-el-wf ins h (nk-op g p as) aux out v n haux = nk-stuck-cs-wf ins h (nk-op g p as) aux out v n haux
nk-stuck-el-wf ins h (nk-match g p bs) aux out v n haux = nk-stuck-cs-wf ins h (nk-match g p bs) aux out v n haux
nk-stuck-el-wf ins h (nk-cons t r) aux out v n haux = nk-stuck-cs-wf ins h (nk-cons t r) aux out v n haux
