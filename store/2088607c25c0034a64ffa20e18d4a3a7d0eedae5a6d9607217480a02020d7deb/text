atree-norm-sound : {A : Type} → (op : A → A → A) → ((x y z : A) → op (op x y) z ≡ op x (op y z)) →
  (t : ATree A) → atree-eval op (atree-norm t) ≡ atree-eval op t
atree-norm-sound op assoc (aleaf a) = refl
atree-norm-sound op assoc (anode l r) =
  concat (atree-cat-eval op assoc (atree-norm l) (atree-norm r))
    (λ i → op (atree-norm-sound op assoc l i) (atree-norm-sound op assoc r i))
