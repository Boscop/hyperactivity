qec5-decode-syn : (e : PauliErr16) → qec5-decode (qec5-syndrome (err-pauli5 e)) ≡ e
qec5-decode-syn qe-none = λ _ → qe-none
qec5-decode-syn qe-x0   = λ _ → qe-x0
qec5-decode-syn qe-x1   = λ _ → qe-x1
qec5-decode-syn qe-x2   = λ _ → qe-x2
qec5-decode-syn qe-x3   = λ _ → qe-x3
qec5-decode-syn qe-x4   = λ _ → qe-x4
qec5-decode-syn qe-z0   = λ _ → qe-z0
qec5-decode-syn qe-z1   = λ _ → qe-z1
qec5-decode-syn qe-z2   = λ _ → qe-z2
qec5-decode-syn qe-z3   = λ _ → qe-z3
qec5-decode-syn qe-z4   = λ _ → qe-z4
qec5-decode-syn qe-y0   = λ _ → qe-y0
qec5-decode-syn qe-y1   = λ _ → qe-y1
qec5-decode-syn qe-y2   = λ _ → qe-y2
qec5-decode-syn qe-y3   = λ _ → qe-y3
qec5-decode-syn qe-y4   = λ _ → qe-y4
