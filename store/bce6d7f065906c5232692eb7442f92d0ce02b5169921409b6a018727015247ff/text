-- the version written: what store/KIND/HEX points to now, with the time (seconds since 1970)
hy-version : List Word → List Word → Proc W Unit
hy-version kind hx = bind (h-read (list-append h-index (cons #47 (list-append kind (cons #47 hx))))) (λ w →
  bind (h-read (list-append h-source (list-append "/versions/" hx))) (λ v →
  bind (sys-call #201 #0 #0 #0 #0 #0 #0) (λ t →
  bind (h-mkdir (list-append h-source "/versions")) (λ u →
  bind (h-write (list-append h-source (list-append "/versions/" hx)) (hy-versions-next (hy-unmarked (hy-text-or v)) (h-take (toNat #64) (hy-text-or w)) (h-decimal t))) (λ b → ret unit)))))
