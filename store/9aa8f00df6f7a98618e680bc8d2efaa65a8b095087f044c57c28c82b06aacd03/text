-- Active-sensing safety transfer: if every transition under response r from a K-compatible world
-- lands in a P-safe world, then the action is safe over the updated world family WorldAfter K H r.
query-establishes-safe : {W R : Type} → (K : W → Type) → (H : W → R → W → Type) →
  (r : R) → (P : W → Type) →
  ((w w' : W) → K w → H w r w' → P w') →
  SafeOver (WorldAfter K H r) P
query-establishes-safe K H r P step w' wa = step (fst wa) w' (fst (snd wa)) (snd (snd wa))
