-- CVTEntry: one vtable slot, as the target ABI lays it out. cvt-thunk is a slot that holds a thunk to the function of the entry inside: `this` adjusted by this-nv bytes and then, when this-vcall is there, by the vcall offset stored that many bytes from the vtable address; the result adjusted by ret-nv and, when ret-vbase is there, by the virtual base offset stored that many bytes from the result's vtable address
data CVTEntry =
    cvt-offset-to-top (v : CInt)
  | cvt-rtti
  | cvt-method (id : Word)
  | cvt-pure (id : Word)
  | cvt-complete-dtor (id : Word)
  | cvt-deleting-dtor (id : Word)
  | cvt-vbase-offset (v : CInt)
  | cvt-vcall-offset (v : CInt)
  | cvt-thunk (e : CVTEntry) (this-nv : CInt) (this-vcall : COptInt) (ret-nv : CInt) (ret-vbase : COptInt)
