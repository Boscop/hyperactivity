cs-hy-div-nz-at : (z1 z2 : Bool) (hp : CsHeap) (a b : Word) → (z1 ≡ false) → (z2 ≡ false) →
  (if z1 then cso-ok hp (csv-word #0) else cs-prim-res hp (if z2 then csp-ub else csp-ok (%wdiv a b)))
  ≡ cso-ok hp (csv-word (%wdiv a b))
cs-hy-div-nz-at true z2 hp a b h1 h2 = cs-no (sym h1)
cs-hy-div-nz-at false true hp a b h1 h2 = cs-no (sym h2)
cs-hy-div-nz-at false false hp a b h1 h2 = refl
