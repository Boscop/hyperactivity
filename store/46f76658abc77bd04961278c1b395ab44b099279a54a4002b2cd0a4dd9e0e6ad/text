-- addition with carry in at the least significant end, carry out at the most significant
bv-adc : (n : Nat) → BitVec n → BitVec n → Bool → BitVec n × Bool
bv-adc zero a b c = (unit , c)
bv-adc (suc n) a b c = ((bxor (bxor (fst a) (fst b)) (snd (bv-adc n (snd a) (snd b) c)) , fst (bv-adc n (snd a) (snd b) c)) ,
  maj (fst a) (fst b) (snd (bv-adc n (snd a) (snd b) c)))
