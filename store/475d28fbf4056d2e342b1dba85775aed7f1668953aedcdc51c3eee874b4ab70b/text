-- reversing a onto l and reading most significant first: l read after a's value
rev-msval : (a l : List Bool) → (v : Nat) → msval (bin-rev-onto a l) v ≡ msval l (plus (times (pw2 (bits-len a)) v) (bin-to-nat a))
rev-msval a = case a return λ m → (l : List Bool) → (v : Nat) → msval (bin-rev-onto m l) v ≡ msval l (plus (times (pw2 (bits-len m)) v) (bin-to-nat m)) of
  nil → λ l v → msval-cong l v (plus (times (pw2 zero) v) zero) (rev-nil-alg v)
  cons x xs → λ l v → transN (rec xs (cons x l) v)
    (msval-cong l (plus (bitn x) (times 2 (plus (times (pw2 (bits-len xs)) v) (bin-to-nat xs)))) (plus (times (pw2 (suc (bits-len xs))) v) (bin-to-nat (cons x xs)))
      (transN (rev-alg (bitn x) (times (pw2 (bits-len xs)) v) (bin-to-nat xs))
        (cong2plus (times 2 (times (pw2 (bits-len xs)) v)) (times (pw2 (suc (bits-len xs))) v) (plus (bitn x) (times 2 (bin-to-nat xs))) (bin-to-nat (cons x xs))
          (symN (times-assoc 2 (pw2 (bits-len xs)) v)) (symN (cons-val x xs)))))
