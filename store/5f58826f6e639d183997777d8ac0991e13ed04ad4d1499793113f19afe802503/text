-- the stage spaces of every term of Φ(m,n) for ordered (n, m), both branches
stage-dss : Nat → Nat → Nat → List Nat → List (List Nat) → List (List Nat)
stage-dss k n m dsP acc = case k of
  zero → acc
  suc j → stage-dss j n m dsP (cons (stage1-ds k true n dsP) (cons (stage1-ds k false n dsP)
    (cons (stage2-ds k true n true m dsP) (cons (stage2-ds k true n false m dsP) (cons (stage2-ds k false n true m dsP) (cons (stage2-ds k false n false m dsP) acc))))))
