irun-flag : (S S2 : List Bool) → (envt : Nat → IV → Nat → IV) → (step : IE) → (n : Nat) → (st : IV × Bool) → snd (irun S S2 envt step n st) ≡ true → snd st ≡ true
irun-flag S S2 envt step n = case n return λ w → (st : IV × Bool) → snd (irun S S2 envt step w st) ≡ true → snd st ≡ true of
  zero → λ st h → h
  suc g → λ st h → both-true-l (snd st) (snd (ieval S S2 (envt (suc g) (fst st)) step)) (rec g (istep st (ieval S S2 (envt (suc g) (fst st)) step)) h)
