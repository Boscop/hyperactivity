ossc-ui-to-html : UiNode → List Word
ossc-ui-to-html ui-nil = nil
ossc-ui-to-html (ui-row a b) =
  h-concat (cons "<div class='os-row'>" (cons (ossc-ui-leaf a) (cons (ossc-ui-leaf b) (cons "</div>" nil))))
ossc-ui-to-html (ui-col a b) = list-append (ossc-ui-to-html a) (ossc-ui-to-html b)
ossc-ui-to-html u = ossc-ui-leaf u
