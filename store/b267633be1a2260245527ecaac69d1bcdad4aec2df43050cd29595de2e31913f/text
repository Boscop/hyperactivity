-- Exact 12-halfword timestamp payload for BGNLIB (0x0102) & BGNSTR (0x0502): 2026-11-23 00:00:00 (mod + acc)
gds-timestamp-bytes : List Word
gds-timestamp-bytes =
  gds-u16s
    (cons #2026 (cons #11 (cons #23 (cons #0 (cons #0 (cons #0
    (cons #2026 (cons #11 (cons #23 (cons #0 (cons #0 (cons #0 nil))))))))))))
