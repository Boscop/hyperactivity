-- canonical quotient map from uncoupled product basins to coupled collective basins
basin-prod-coupled : {S1 S2 : Type 0}
                   → (eq1 : S1 → S1 → Bool) → (eq2 : S2 → S2 → Bool)
                   → (s1 : S1 → S1 → Bool) → (s2 : S2 → S2 → Bool)
                   → (c : (S1 × S2) → (S1 × S2) → Bool)
                   → Basins (S1 × S2) (prod-step eq1 eq2 s1 s2)
                   → Basins (S1 × S2) (coupled-step eq1 eq2 s1 s2 c)
basin-prod-coupled {S1} {S2} eq1 eq2 s1 s2 c =
  basin-refine {S1 × S2} {prod-step eq1 eq2 s1 s2} {c}
