-- ---------------------------------------------------------------- forward mode
fwd : Nat → Pl → Nat × Nat
fwd x p =
  case p return (λ w → Nat × Nat) of
    kc n → (n , zero)
    kx → (x , suc zero)
    kadd a b → (plus (fst (rec a)) (fst (rec b)) , plus (snd (rec a)) (snd (rec b)))
    kmul a b → (times (fst (rec a)) (fst (rec b)) , plus (times (snd (rec a)) (fst (rec b))) (times (fst (rec a)) (snd (rec b))))
