fold-hom : {O0 O1 O2 V R T : Type} → (A : Alg O0 O1 O2 R) → (B : Alg O0 O1 O2 T) → (h : R → T) →
  AlgHom A B h → (env : V → R) → (d : Circ O0 O1 O2 V) →
  h (fold A env d) ≡ fold B (λ v → h (env v)) d
fold-hom A B h hh env (cwire v) = λ i → h (env v)
fold-hom A B h hh env (cop0 c) = fst hh c
fold-hom A B h hh env (cop1 u a) =
  concat (fst (snd hh) u (fold A env a)) (λ i → fst (snd B) u (fold-hom A B h hh env a i))
fold-hom A B h hh env (cop2 b x y) =
  concat (snd (snd hh) b (fold A env x) (fold A env y))
    (λ i → snd (snd B) b (fold-hom A B h hh env x i) (fold-hom A B h hh env y i))
