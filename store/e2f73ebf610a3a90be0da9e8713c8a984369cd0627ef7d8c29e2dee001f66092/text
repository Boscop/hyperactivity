toZ2-neg-snd : (a : Int) → plusw (snd (toZ2 (negZ a))) (snd (toZ2 a)) ≡ plusw #0 (plusw (fst (toZ2 a)) (snd (toZ2 a)))
toZ2-neg-snd a =
  case a return (λ w → plusw (snd (toZ2 (negZ w))) (snd (toZ2 w)) ≡ plusw #0 (plusw (fst (toZ2 w)) (snd (toZ2 w)))) of
    pos n → (case n return (λ m → plusw (snd (toZ2 (negZ (pos m)))) (snd (toZ2 (pos m))) ≡ plusw #0 (plusw (fst (toZ2 (pos m))) (snd (toZ2 (pos m))))) of
               zero → λ i → #0
               suc k → sym (plusw-zero-l (plusw (%wsucc (fromNat k)) #0)))
    negsuc n → sym (plusw-zero-l (plusw #0 (%wsucc (fromNat n))))
