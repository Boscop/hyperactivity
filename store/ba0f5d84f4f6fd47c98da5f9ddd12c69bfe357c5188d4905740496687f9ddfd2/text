-- (part of language-support)
div_spec_32 : (dst' : Bits #64) → (src : Bits #32) → (Bool × (Bits #64) × (Bits #32))
div_spec_32 dst' src =
  let quotient : Bits #64
      quotient = (bits_of_int (floor2 (bv-unsigned #64 dst') (bv-unsigned #32 src)) (zpos #64))
      remainder : Bits #32
      remainder = (bits_of_int (mod (bv-unsigned #64 dst') (bv-unsigned #32 src)) (zpos #32))
      overflow? : Bool
      overflow? = (z-lt (zpos #4294967295) (bv-unsigned #64 quotient))
  in (if overflow? then (true , #0 , #0) else (overflow? , quotient , remainder))
