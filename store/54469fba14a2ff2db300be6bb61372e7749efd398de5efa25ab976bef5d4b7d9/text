this-after-colon-jstr : List Word → List Word
this-after-colon-jstr s =
  let a = this-skip-ws s in
  case a of
    nil → nil
    cons c r →
      if %weq c #58 then
        (let b = this-skip-ws r in
         case b of
           nil → nil
           cons q rest → if %weq q #34 then this-take-jstr rest else nil)
      else nil
