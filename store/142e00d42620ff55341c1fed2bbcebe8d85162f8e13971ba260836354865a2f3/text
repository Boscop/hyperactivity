-- a signed product overflows exactly when dividing the wrapped product by a (not zero) does not
-- give b back, or a is -1 and b the minimum (whose wrapped quotient is b again)
wi-mul : Bool → DQ → DQ → MRes DQ
wi-mul sg a b =
  let r = dq-mul a b
  in case sg of
       false → mok r
       true → (case dq-iszero a of
         true → mok r
         false → (case m-and (dq-eq a (uq-ones , uq-ones)) (dq-eq b dq-min) of
           true → mub ub-signed-overflow
           false → (case dq-eq (dq-sdiv r a) b of
             true → mok r
             false → mub ub-signed-overflow)))
