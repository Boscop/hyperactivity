hy-check-source : List Word → List Word
hy-check-source f = list-append (h-line (list-append "import " (hy-q (list-append "../" (list-append (h-before ".md" f) ".hypercubical")))))
  (h-line (list-append "#same " (list-append (hy-base f) (list-append "-source = text " (hy-q (list-append "../" f))))))
