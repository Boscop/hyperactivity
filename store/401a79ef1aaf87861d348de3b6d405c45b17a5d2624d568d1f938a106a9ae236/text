bp-split-join : (B : Word) → (hB : wlt #0 B ≡ true) → (p : Word × Bounded B) → bp-split B hB (bp-join B p) ≡ p
bp-split-join B hB p =
  let bp1 : Bounded B
      bp1 = bp-rem B hB (bp-join B p)
      p1 : wquot (bp-join B p) B ≡ fst p
      p1 = wdiv-unique (fst p) (fst (snd p)) B (snd (snd p))
      pfst : fst bp1 ≡ fst (snd p)
      pfst = catw (bp-rem-fst B hB (bp-join B p)) (wmod-unique (fst p) (fst (snd p)) B (snd (snd p)))
      p2 : Path (Bounded B) bp1 (snd p)
      p2 = bounded-eq B bp1 (snd p) pfst
  in λ i → (p1 i , p2 i)
