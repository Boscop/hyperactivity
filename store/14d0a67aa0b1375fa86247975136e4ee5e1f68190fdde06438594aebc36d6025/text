-- §4.5 Cubical Subgraph Pruning Theorem:
-- Whenever `cA` and `cB` conflict (`clause-ok 4 (clause-meet 4 cA cB) ≡ false`), `hn-eval` returns
-- `fb` immediately without evaluating `hugeSubgraph`!
hnode-conflict-prunes-subgraph :
  (cA cB : ClauseVec (toNat #4)) → (hugeSubgraph : HNode) → (fb : Nat) →
  clause-ok (toNat #4) (clause-meet (toNat #4) cA cB) ≡ false →
  hn-eval (hn-face-guard cA cB hugeSubgraph fb) ≡ fb
hnode-conflict-prunes-subgraph cA cB hugeSubgraph fb hBad =
  λ i → if hBad i then hn-eval hugeSubgraph else fb
