-- Exact custom-IV SHA-256 compression (for Bitcoin 2-chunk 80-byte block header Midstate -> Chunk 1):
hcs-fin-iv : List Word → Word → Word → Word → Word → List Word
hcs-fin-iv iv ab cd ef gh =
  let a = %wand ab s256-m32
      b = %wshr ab #32
      c = %wand cd s256-m32
      d = %wshr cd #32
      e = %wand ef s256-m32
      f = %wshr ef #32
      g = %wand gh s256-m32
      h = %wshr gh #32
  in cons (s256-add (s256-nth #0 iv) a)
     (cons (s256-add (s256-nth #1 iv) b)
     (cons (s256-add (s256-nth #2 iv) c)
     (cons (s256-add (s256-nth #3 iv) d)
     (cons (s256-add (s256-nth #4 iv) e)
     (cons (s256-add (s256-nth #5 iv) f)
     (cons (s256-add (s256-nth #6 iv) g)
     (cons (s256-add (s256-nth #7 iv) h) nil)))))))

