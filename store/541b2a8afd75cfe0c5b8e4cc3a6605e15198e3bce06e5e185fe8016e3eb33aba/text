hcs-rounds-mc1 iv (suc rem) i nil ab cd ef gh = hcs-fin-iv iv ab cd ef gh
hcs-rounds-mc1 iv (suc rem) i (cons wi wr) ab cd ef gh =
  let a  = %wand ab s256-m32
      b  = %wshr ab #32
      c  = %wand cd s256-m32
      d  = %wshr cd #32
      e  = %wand ef s256-m32
      f  = %wshr ef #32
      g  = %wand gh s256-m32
      h  = %wshr gh #32
      t1 = s256-add (s256-add (s256-add h (s256-S1 e)) (s256-add (s256-ch-1and e f g) (s256-k i))) wi
      t2 = s256-add (s256-S0 a) (s256-maj-1and a b c)
  in hcs-rounds-mc1 iv rem (%wsucc i) wr (s256-pk (s256-add t1 t2) a) (s256-pk b c) (s256-pk (s256-add d t1) e) (s256-pk f g)

