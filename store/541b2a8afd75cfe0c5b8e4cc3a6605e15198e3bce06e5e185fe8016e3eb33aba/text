HcsState8 : Type
HcsState8 = Word × (Word × (Word × (Word × (Word × (Word × (Word × Word))))))

hcs-h-of : HcsState8 → Word
hcs-h-of st = snd (snd (snd (snd (snd (snd (snd st))))))

-- Exact abstract SHA-256 round transition `(a,b,c,d,e,f,g,h) -> (t1+t2, a, b, c, d+t1, e, f, g)`:
hcs-round-step : HcsState8 → Word → Word → HcsState8
hcs-round-step st t1 t2 =
  let a = fst st
      b = fst (snd st)
      c = fst (snd (snd st))
      d = fst (snd (snd (snd st)))
      e = fst (snd (snd (snd (snd st))))
      f = fst (snd (snd (snd (snd (snd st)))))
      g = fst (snd (snd (snd (snd (snd (snd st))))))
  in (s256-add t1 t2 , (a , (b , (c , (s256-add d t1 , (e , (f , g)))))))

