  let skipT2 = andB isOuter (not (%wlt t #57))
      here   = hcs-ptx-one-round skipT2 t regs
      nxtR   = hcs-rot-regs regs
      rest   = hcs-ptx-rounds-loop isOuter k (%wsucc t) nxtR
  in (list-append here (fst rest) , snd rest)

hcs-init-regs8 : List Word
hcs-init-regs8 = cons #8 (cons #9 (cons #10 (cons #11 (cons #12 (cons #13 (cons #14 (cons #15 nil)))))))

-- Complete Hopper `.target sm_90` PTX 8.0 Bitcoin `SHA-256d` Miner Kernel:
--   * Inner `SHA256_1`: starts from precomputed `r0..2` state (`t = 3 .. 63` = 61 rounds, `-3` rounds!)
--   * Outer `SHA256_2`: runs `t = 0 .. 60` (`61` rounds, skipping `T2` on `57..60` & skipping `61..63`!)
hcs-emit-btc-ptx : List Word
hcs-emit-btc-ptx =
  let innerP = hcs-ptx-rounds-loop false (toNat #61) #3 hcs-init-regs8
      rInEnd = snd innerP
      outerP = hcs-ptx-rounds-loop true  (toNat #61) #0 hcs-init-regs8
      rOut61 = snd outerP
      re61   = s256-nth #4 rOut61
  in h-concat
       (cons (hcs-ln ".version 8.0")
       (cons (hcs-ln ".target sm_90")
       (cons (hcs-ln ".address_size 64")
       (cons (hcs-ln ".visible .entry hx_btc_sha256d_superopt_sm90(")
