positive d pvs A =
  orb (notb (cany (is-data-d d) A))
    (case A of
       tdata d2 ps V → 
         if %weq d2 d
           then andb (lall (λ q → notb (cany (is-data-d d) q)) ps) (uniform-at (uniform-params d ps) (uniform-params d pvs))
           else nested-pos d pvs d2 ps
       -- a later D (guarded recursion): a field, not a recursive one (no hypothesis is taken); a
       -- function whose domain does not mention D: positive iff its codomain is (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §18.18 “E28b — Strict positivity under Π codomains and Σ components”)
       tpi B nm b V →
         (case B of
            ttick k V2 → positive d pvs (b (%var Uw) Uw)
            _ → andb (notb (cany (is-data-d d) B)) (positive d pvs (b (%var nm Uw) Uw)))
       -- a pair: positive iff both components are (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §18.18 “E28b — Strict positivity under Π codomains and Σ components”)
       tsigma B nm b V → andb (positive d pvs B) (positive d pvs (b (%var nm Uw) Uw))
       -- a path in D (a truncation's argument): a map from the interval into D, its line positive
       -- and its endpoints elements, D not among their types
       tpathp L x y V → 
         andb (notb (orb (cany (is-data-d d) x) (cany (is-data-d d) y))) (positive-line d pvs L)
       _ → false)
