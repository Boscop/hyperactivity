index-updateV : (A : Type) → (to : A → Int64) → (from : Int64 → A) → ((v : A) → from (to v) ≡ v) → (n : Nat) → (a : Array n) → (i : Nat) → (h : le (suc i) n) → (v : A) → indexV A from n (updateV A to n a i h v) i h ≡ v
index-updateV A to from ft n a i h v =
  concat {lzero} {A} {from (index n (update n a i h (to v)) i h)} {from (to v)} {v}
    (cong {lzero} {lzero} {Int64} {A} from {index n (update n a i h (to v)) i h} {to v} (index-update n a i h (to v))) (ft v)
