data FounderHud : Type where
  mk-hud : Word → Word → Word → Word → FounderHud

fh-seq : FounderHud → Word
fh-seq (mk-hud sq vm sm bp) = sq

fh-vault-m : FounderHud → Word
fh-vault-m (mk-hud sq vm sm bp) = vm

fh-h200-sm : FounderHud → Word
fh-h200-sm (mk-hud sq vm sm bp) = sm

fh-bps : FounderHud → Word
fh-bps (mk-hud sq vm sm bp) = bp

vpf-mask32 : Word → Word
vpf-mask32 x = %wand x #4294967295

vpf-mix32 : Word → Word → Word
vpf-mix32 h x =
  vpf-mask32 (%wxor (%wmul (%wadd h #2654435761) #2246822519) x)

vpf-mac32 : Word → Word → Word → Word → Word → Word
vpf-mac32 key sq vm sm bp =
  vpf-mix32 (vpf-mix32 (vpf-mix32 (vpf-mix32 (vpf-mask32 key) sq) vm) sm) bp

vpf-put32 : Word → List Word → List Word
vpf-put32 w rest =
  let x = vpf-mask32 w
  in cons (%wand (%wshr x #24) #255)
     (cons (%wand (%wshr x #16) #255)
     (cons (%wand (%wshr x #8) #255)
     (cons (%wand x #255) rest)))

vpf-get32 : List Word → Word × List Word
vpf-get32 nil = (#0 , nil)
vpf-get32 (cons b0 r0) =
  case r0 of
    nil → (#0 , nil)
    cons b1 r1 →
      case r1 of
        nil → (#0 , nil)
        cons b2 r2 →
          case r2 of
            nil → (#0 , nil)
            cons b3 r3 →
              (%wor (%wshl (%wand b0 #255) #24)
               (%wor (%wshl (%wand b1 #255) #16)
               (%wor (%wshl (%wand b2 #255) #8) (%wand b3 #255))) , r3)

vpf-hxsv-magic : Word
vpf-hxsv-magic = #1213748054 -- "HXSV" = 0x48585356

vpf-pack-hud : Word → FounderHud → List Word
vpf-pack-hud key h =
  let sq = vpf-mask32 (fh-seq h)
      vm = vpf-mask32 (fh-vault-m h)
      sm = vpf-mask32 (fh-h200-sm h)
      bp = vpf-mask32 (fh-bps h)
      m1 = vpf-mac32 key sq vm sm bp
      m2 = vpf-mix32 m1 #1337
  in vpf-put32 vpf-hxsv-magic
     (vpf-put32 sq
     (vpf-put32 vm
     (vpf-put32 sm
     (vpf-put32 bp
     (vpf-put32 #1
     (vpf-put32 m1
     (vpf-put32 m2 nil)))))))

vpf-unpack-hud : Word → List Word → Sum Unit FounderHud
vpf-unpack-hud key bs =
  if %weq (fromNat (list-length bs)) #32 then
    let p0 = vpf-get32 bs
        mg = fst p0
        p1 = vpf-get32 (snd p0)
        sq = fst p1
        p2 = vpf-get32 (snd p1)
        vm = fst p2
        p3 = vpf-get32 (snd p2)
        sm = fst p3
        p4 = vpf-get32 (snd p3)
        bp = fst p4
        p5 = vpf-get32 (snd p4)
        p6 = vpf-get32 (snd p5)
        m1 = fst p6
        p7 = vpf-get32 (snd p6)
        m2 = fst p7
        ex1 = vpf-mac32 key sq vm sm bp
        ex2 = vpf-mix32 ex1 #1337
    in if andB (%weq mg vpf-hxsv-magic) (andB (%weq m1 ex1) (%weq m2 ex2))
       then inr (mk-hud sq vm sm bp)
       else inl unit
  else inl unit

vpf-tamper-head : List Word → List Word
vpf-tamper-head nil = nil
vpf-tamper-head (cons b bs) = cons (%wxor b #1) bs

vpf-hud-ok-sm : Sum Unit FounderHud → Word
