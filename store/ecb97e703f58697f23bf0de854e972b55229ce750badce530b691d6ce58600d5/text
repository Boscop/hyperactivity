  (sl-ln "      hx_vp_render_binaural_48k(fo.tonnetz_triad, 2u, &ph, audL, audR, 512u);"
  (sl-ln "      HxVpUniforms u = { { matrix_identity_float4x4, matrix_identity_float4x4 }, {fo.head_pred[0],fo.head_pred[1],fo.head_pred[2],1}, {-0.15f,0,-0.45f,(float)fo.l_chord}, {0.15f,0,-0.45f,(float)fo.r_chord}, {0,1,0,fo.clamped_y}, {fo.hxsv_seq,(uint32_t)fo.cubical_evals,fo.tonnetz_triad,fo.bimanual_cmd} };"
  (sl-ln "      id<MTLCommandBuffer> cb = [q commandBuffer]; id<MTLComputeCommandEncoder> enc = [cb computeCommandEncoder];"
