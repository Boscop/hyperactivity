-- Complete O(N) bit-exact audio stream encoder & decoder:
--   enc: [samples] -> Haar lift -> [delta(s) ++ d] -> escaped Golomb-Rice bytes
hxgr-enc : List Word → List Word
hxgr-enc sams =
  let sd  = haar-lift-tr sams nil nil
      ds  = delta-enc-go #0 (fst sd) nil
      all = w-app ds (snd sd)
  in gr-enc-list-go all (bw-st #0 #0 nil)
