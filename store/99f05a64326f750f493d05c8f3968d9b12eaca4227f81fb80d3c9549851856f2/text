sw-merge-cert : SwarmCert → List SwarmCert → List SwarmCert
sw-merge-cert (swarm-cert nm c ex) nil =
  if ex then cons (swarm-cert nm c ex) nil else nil
sw-merge-cert (swarm-cert nm c ex) (cons (swarm-cert nm0 c0 ex0) rest) =
  if ex then
    (if h-eq nm nm0 then
       cons (swarm-cert nm0 (sw-min c c0) ex0) rest
     else cons (swarm-cert nm0 c0 ex0) (sw-merge-cert (swarm-cert nm c ex) rest))
  else cons (swarm-cert nm0 c0 ex0) rest
