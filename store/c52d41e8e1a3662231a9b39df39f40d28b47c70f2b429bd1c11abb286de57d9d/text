-- (part of language-support)
wz32 : (reg' : Bits #5) → (sailval : Bits #32) → (keywords : struct_wz32) → MS Unit
wz32 reg' sailval keywords =
  bindS {List (Bits #512)} {Unit} (getS {List (Bits #512)} x86-zmms) (λ zmms'1 →
    let data' : Bits #512
        data' = (vec-get {Bits #512} #0 zmms'1 (z-nat (bv-unsigned #5 reg')))
        regtype' : Bits #3
        regtype' = (bits_of_int (struct_wz32-regtype keywords) (zpos #3))
        data' : Bits #512
        data' =
          if (weq regtype' #2) then
            (bv-zext #128 #512 (loghead_bits #512 (zpos #128) data'))
          else if (weq regtype' #3) then
            (bv-zext #256 #512 (loghead_bits #512 (zpos #256) data'))
          else
            data'
    in bindS {List (Bits #512)} {Unit} (getS {List (Bits #512)} x86-zmms) (λ zmms'3 →
         bindS {Unit} {Unit} (putS (x86-set-zmms (vec-set {Bits #512} zmms'3 (z-nat (bv-unsigned #5 reg')) (changeSlice_bits #512 data' (zpos #0) (zpos #32) sailval)))) (λ _ →
           retS {Unit} unit)))
