nk-in-range-up : (n0 n1 n2 w : NkW) → (nk-wire-le n1 n2 ≡ true) → (nk-in-range n0 n1 w ≡ true) → nk-in-range n0 n2 w ≡ true
nk-in-range-up n0 n1 n2 w p h =
  nk-and-intro (nk-wire-le n0 w) (nk-wire-lt w n2)
    (nk-and-l (nk-wire-le n0 w) (nk-wire-lt w n1) h)
    (nk-wire-lt-wle-trans w n1 n2 (nk-and-r (nk-wire-le n0 w) (nk-wire-lt w n1) h) p)
