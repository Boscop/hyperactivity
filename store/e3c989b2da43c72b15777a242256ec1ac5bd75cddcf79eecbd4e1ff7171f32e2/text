ren-alg : (r : DRule) (t : Tag) (x : RData r) → isTrue (kallows (rkind r) t) → AllP Pren (tagged t (premJ r x)) → Pren t (concl r x)
ren-alg r t-any x k p = one
ren-alg r-var t-ne (x-var Γ v) k p = λ Δ' w → rn-var Δ' Γ w v
ren-alg r-app t-ne (x-app Γ a b R f c) k p = λ Δ' w → rn-app Δ' Γ w a b R (fst p Δ' w) (fst (snd p) Δ' w)
ren-alg r-fst t-ne (x-proj Γ a b R c) k p = λ Δ' w → rn-fst Δ' Γ w a b R (fst p Δ' w)
ren-alg r-snd t-ne (x-proj Γ a b R c) k p = λ Δ' w → rn-snd Δ' Γ w a b R (fst p Δ' w)
ren-alg r-case t-ne (x-case Γ s R cP cx ct cf) k p = λ Δ' w →
  rn-case Δ' Γ w s R
    (rn-ext Δ' Γ w s-bool (CaseV s) (case-b s) R s (λ q b → fst (snd q) b)
       (fst p (ext-h Δ' s-bool (CaseV s) (case-b s) (wact Δ' Γ w (CaseV s) R)) (world-keep Δ' Γ s-bool (CaseV s) (case-b s) R w)))
    (fst (snd p) Δ' w) (fst (snd (snd p)) Δ' w) (fst (snd (snd (snd p))) Δ' w)
ren-alg r-ne t-nf (x-ne Γ R c) k p = λ Δ' w → rn-ne Δ' Γ w R (fst p Δ' w)
ren-alg (r-con b) t-nf (x-unit Γ B) k p = λ Δ' w →
  (c-con b , d-fm-out t-nf j-tm Δ' Γ w One1 s-bool (bool-v b) B (c-con b) (by-rule (r-con b) t-nf (x-unit Δ' (wact Δ' Γ w One1 B)) unit one))
ren-alg r-lam t-nf (x-lam Γ a b X cA c) k p = λ Δ' w →
  rn-lam Δ' Γ w a b X (fst p Δ' w) (fst (snd p) (lam-ctx Δ' a b (wact Δ' Γ w (TV (s-pi a b)) X)) (world-keep Δ' Γ a (TV (s-pi a b)) (λ q → fst (fst q)) X w))
ren-alg r-pair t-nf (x-pair Γ a b R cB c1 c2) k p = λ Δ' w →
  rn-pair Δ' Γ w a b R
    (rn-ext Δ' Γ w a (TV (s-sig a b)) (λ q → fam-dom a b (fst q)) R b (λ q x → snd (fst q) x)
       (fst p (ext-h Δ' a (TV (s-sig a b)) (λ q → fam-dom a b (fst q)) (wact Δ' Γ w (TV (s-sig a b)) R)) (world-keep Δ' Γ a (TV (s-sig a b)) (λ q → fam-dom a b (fst q)) R w)))
    (fst (snd p) Δ' w) (fst (snd (snd p)) Δ' w)
ren-alg r-plam t-nf (x-pc Γ a X c) k p = λ Δ' w → rn-plam Δ' Γ w a X (fst p (dext Δ') (world-dkeep Δ' Γ w))
ren-alg r-papp t-ne (x-papp Γ a P c f cf nc Y y) k p = λ Δ' w → rn-papp Δ' Γ w a P f cf nc Y y (fst p Δ' w)
ren-alg r-ty-bool t-nf (x-unit Γ B) k p = λ Δ' w → (c-bool , nty-bool Δ' (wact Δ' Γ w One1 B))
ren-alg (r-ty-fam f-pi) t-nf (x-fam Γ a b T cA cB) k p = λ Δ' w → rn-ty-pi Δ' Γ w a b T (fst p Δ' w) 
    (rn-ext Δ' Γ w a (Fam a b) (fam-dom a b) T b (λ F x → snd F x)
       (fst (snd p) (ext-h Δ' a (Fam a b) (fam-dom a b) (wact Δ' Γ w (Fam a b) T)) (world-keep Δ' Γ a (Fam a b) (fam-dom a b) T w)))
ren-alg (r-ty-fam f-sig) t-nf (x-fam Γ a b T cA cB) k p = λ Δ' w → rn-ty-sig Δ' Γ w a b T (fst p Δ' w) 
    (rn-ext Δ' Γ w a (Fam a b) (fam-dom a b) T b (λ F x → snd F x)
       (fst (snd p) (ext-h Δ' a (Fam a b) (fam-dom a b) (wact Δ' Γ w (Fam a b) T)) (world-keep Δ' Γ a (Fam a b) (fam-dom a b) T w)))
ren-alg r-ty-path t-nf (x-tp Γ a T cL c0 c1) k p = λ Δ' w →
  rn-ty-path Δ' Γ w a T (fst p (dext Δ') (world-dkeep Δ' Γ w)) (fst (snd p) Δ' w) (fst (snd (snd p)) Δ' w)
ren-alg r t x k p = Empty-rec k
