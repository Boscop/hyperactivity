-- quote at depth d: a closure is applied to a new variable numbered d and its result quoted one
-- deeper, under a λ; a blocked term's parts are quoted and joined; a variable introduced at depth l
-- is index d-1-l
nk-rule-quote : Word → Word → NkVal → Word → NkOut
nk-rule-quote d out (nkv-lam b e) n = nk-build b (nke-cons n e) (%wsucc n) (nk-out (nkf-val n (nkv-lvl d) (nkf-op (%wsucc n) (nko-quote (%wsucc d) (%wadd n #2)) (nkf-op (%wadd n #2) (nko-wrap nkr-lam out) nkf-nil))) (%wadd n #3))
nk-rule-quote d out (nkv-num m) n = nk-out (nkf-val out (nkv-q (nk-num m)) nkf-nil) n
nk-rule-quote d out (nkv-var x) n = nk-out (nkf-val out (nkv-q (nk-free x)) nkf-nil) n
nk-rule-quote d out (nkv-lvl l) n = nk-out (nkf-val out (nkv-q (nk-var (%wsub (%wsub d #1) l))) nkf-nil) n
nk-rule-quote d out (nkv-napp f a) n = nk-out (nkf-op f (nko-quote d n) (nkf-op a (nko-quote d (%wsucc n)) (nkf-op n (nko-qapp (%wsucc n) out) nkf-nil))) (%wadd n #2)
nk-rule-quote d out (nkv-ninc a) n = nk-out (nkf-op a (nko-quote d n) (nkf-op n (nko-wrap nkr-inc out) nkf-nil)) (%wsucc n)
nk-rule-quote d out v n = nk-out nkf-nil n
