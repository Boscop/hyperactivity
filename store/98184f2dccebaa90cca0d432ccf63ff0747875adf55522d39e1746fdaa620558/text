in-qr-neg : (qr : List Bool × List Bool) → bin-null (snd qr) ≡ true → zv (bz-fdiv-qr false qr) ≡ the (Nat × Nat) (zero , bin-to-nat (fst qr))
in-qr-neg qr hb = transport (λ i → zv (if symB hb i then bz-neg (true , fst qr) else (false , bin-succ (fst qr))) ≡ the (Nat × Nat) (zero , bin-to-nat (fst qr))) (bz-neg-sound true (fst qr))
