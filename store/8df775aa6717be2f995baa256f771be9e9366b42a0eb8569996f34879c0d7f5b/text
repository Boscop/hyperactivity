-- a value arriving at w and an operation arriving at k: different wires, or one wire's two ends
nk-vo : (c : Bool) (w k : Word) (v : NkVal) (o : NkOp) → (%weq w k ≡ c) → nk-ok1 w (nk-arrive-val v) k (nk-arrive-op o)
nk-vo true w k v o p = inr (weq-sound w k p , (λ s → nk-arrive-comm v o s))
nk-vo false w k v o p = inl (p , nk-weq-sym-f w k p)
