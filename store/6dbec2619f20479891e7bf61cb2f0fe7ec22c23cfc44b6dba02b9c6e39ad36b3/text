-- State S = Bool × Bool = (uttered-password , genuine-consent).
-- Observing only the surface lexical token `fst` cannot warrant genuine consent `snd = true`,
-- because (true , false) inhabits fiber fst true.
lexical-gate-fails : Neg (SafeAt {Bool × Bool} {Bool} (λ s → fst s) true (λ s → snd s ≡ true))
lexical-gate-fails safe = true≢false (sym (safe ((true , false) , λ i → true)))
