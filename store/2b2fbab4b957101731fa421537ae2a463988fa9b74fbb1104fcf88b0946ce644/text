cs-hy-shr-at : (lt : Bool) (hp : CsHeap) (a b : Word) → (%wlt b #64 ≡ lt) →
  cs-no-ub (if lt then cs-prim-res hp (cs-c11-shr64 a b) else cso-ok hp (csv-word #0)) ≡ true
cs-hy-shr-at true hp a b hlt =
  cong (λ z → cs-no-ub (cs-prim-res hp (if z then csp-ok (%wshr a b) else csp-ub))) hlt
cs-hy-shr-at false hp a b hlt = refl
