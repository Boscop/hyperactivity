opt-le-plus : (a b c d : Nat) → leB a b ≡ true → leB c d ≡ true → leB (plus a c) (plus b d) ≡ true
opt-le-plus zero zero c d hab hcd = hcd
opt-le-plus zero (suc b') c d hab hcd =
  opt-le-suc-r c (plus b' d) (opt-le-plus zero b' c d refl hcd)
opt-le-plus (suc a') zero c d hab hcd = Empty-rec (opt-true-neq-false (sym hab))
opt-le-plus (suc a') (suc b') c d hab hcd = opt-le-plus a' b' c d hab hcd
