inet-interact-cost : Word → Word → Word
inet-interact-cost a b =
  if %weq a #0 then #1                          -- ERA annihilates/erases in 1 step
  else if %weq b #0 then #1
  else if %weq a #2 then (if %weq b #1 then #2 else #4)  -- APP-LAM annihilates (2), APP-SUP commutes (4)
  else if %weq a #3 then (if %weq b #4 then #2 else #4)  -- DUP-SUP annihilates (2), DUP-LAM commutes (4)
  else #1
