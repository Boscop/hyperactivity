-- the record: Avik's documents and the workflow, the prose the work is made of (not the code's
-- comments): every document whole, and of docs/ and workflow/ every comment and every string, a
-- paragraph at a time, cut into sentences, one a line (a line longer than 600 characters is no
-- sentence and is left out)
c-record-cmd : List Word
c-record-cmd = c-dq "{ xargs -a build/chat/docs-md cat; xargs -a build/chat/docs-cub cat | sed 's/^-- \{0,1\}//; t; /`/!s/.*//; s/^[^`]*`//; s/`[^`]*$//; s/` *(cons `/ /g'; } | sed 's/^ *$/\x1e/' | tr '\n\t' '  ' | tr '\036' '\n' | sed 's/\([.!?]\)  */\1\n/g' | sed 's/   */ /g; s/^ //' | grep -E '^.{30,600}$' | grep '[a-z]' > build/chat/record.tmp && mv build/chat/record.tmp build/chat/record"
