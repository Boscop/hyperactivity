chem-hb-lagrange-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-hb-lagrange-poly A ad mu q vs =
  (λ g sub sq →
    let ux = g 0; uy = g 1; uz = g 2
        vx = g 3; vy = g 4; vz = g 5
        cx = sub (mu uy vz) (mu uz vy)
        cy = sub (mu uz vx) (mu ux vz)
        cz = sub (mu ux vy) (mu uy vx)
        dp = ad (ad (mu ux vx) (mu uy vy)) (mu uz vz)
        lhs = ad (ad (ad (sq cx) (sq cy)) (sq cz)) (sq dp)
        nu = ad (ad (sq ux) (sq uy)) (sq uz)
        nv = ad (ad (sq vx) (sq vy)) (sq vz)
        rhs = mu nu nv
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
