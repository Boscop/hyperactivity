-- lift(θ)(vz) = var(vz), lift(θ)(vs(i)) = weaken(θ(i))
tl-sub-lift-var : {GA : TlCtx × TlTy} → TlVar GA → (d : TlCtx) → TlSub (tl-tail (fst GA)) d → TlTm (tl-ext d (tl-head (fst GA)) , snd GA)
tl-sub-lift-var (tl-vz g a) d th = tl-var (tl-ext d a) a (tl-vz d a)
tl-sub-lift-var (tl-vs g a b i) d th = tl-weaken d a b (th b i)
