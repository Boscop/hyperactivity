-- ---------------------------------------------------------------- certificates
-- hypotheses l_i ≤ r_i with multipliers c_i: the goal a ≤ b is certified by the check
--   a + Σ c_i r_i ≤ b + Σ c_i l_i on normal forms (lib/lin.cub's cert-check). A multiple c·l is
-- the code l added c times, so no multiplication enters the proof
data Hyps = hnil | hcons (l : LinCode) (r : LinCode) (rest : Hyps)
