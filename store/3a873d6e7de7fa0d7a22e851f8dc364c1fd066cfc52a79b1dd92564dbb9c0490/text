hcm-stretch : Word → Word
hcm-stretch p =
  let pos = %wlt #2047 p
      q   = if pos then %wsub #4096 p else p
      m   = if %wlt q #9 then %wsub #2048 (%wdiv (%wmul (%wsub q #1) #450) #7)
            else if %wlt q #33 then %wsub #1598 (%wdiv (%wmul (%wsub q #8) #357) #24)
            else if %wlt q #129 then %wsub #1241 (%wdiv (%wmul (%wsub q #32) #361) #96)
            else if %wlt q #385 then %wsub #880 (%wdiv (%wmul (%wsub q #128) #299) #256)
            else if %wlt q #769 then %wsub #581 (%wdiv (%wmul (%wsub q #384) #205) #384)
            else if %wlt q #1281 then %wsub #376 (%wdiv (%wmul (%wsub q #768) #180) #512)
            else if %wlt q #1793 then %wsub #196 (%wdiv (%wmul (%wsub q #1280) #131) #512)
            else %wsub #65 (%wdiv (%wmul (%wsub q #1792) #65) #256)
  in if pos then %wadd #2048 m else %wsub #2048 m
