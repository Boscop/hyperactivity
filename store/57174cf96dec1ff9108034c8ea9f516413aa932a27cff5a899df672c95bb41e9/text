-- one step of orbit growth: every generator applied to every atom reached so far
orbit-step : (M : Mol) → List (Auto M) → List (mol-atoms M) → List (mol-atoms M)
orbit-step M gens ys = chem-concat (mol-atoms M) (chem-map (Auto M) (List (mol-atoms M)) (λ a → chem-map (mol-atoms M) (mol-atoms M) (auto-fun M a) ys) gens)
