  (hw-ln "  inet_annihilate4   u4 (.w0(pair_tag[0]), .w1(pair_tag[1]), .w2(pair_tag[2]), .w3(pair_tag[3]), .y(r4));"
  (hw-ln "  inet_vxchg_arb4    u5 (.w0(pair_tag[0]), .w1(pair_tag[1]), .w2(pair_tag[2]), .w3(pair_tag[3]), .y(r5));"
  (hw-ln "  inet_tag_neq4      u6 (.w0(pair_tag[0]), .w1(pair_tag[1]), .w2(pair_tag[2]), .w3(pair_tag[3]), .y(r6));"
