-- every rule: the operation and the value that met, and the first wire name the rule may use
nk-rule : NkOp → NkVal → Word → NkOut
nk-rule (nko-el h aux out) (nkv hd parts) n = nk-rule-el h aux out hd parts n
nk-rule (nko-dup a b) v n = nk-rule-dup a b v (nk-parts v) n
nk-rule nko-era v n = nk-plan-of (nk-era-env (nk-parts v) nkf-nil) n
nk-rule (nko-fwd out) v n = nk-plan-of (nkf-val out v nkf-nil) n
nk-rule (nko-quote d out) (nkv hd parts) n = nk-rule-quote d out hd parts n
nk-rule (nko-gather d k done todo out) (nkv (hd-q t) e) n = nk-gather d k (nk-cons t done) todo out n
nk-rule o v n = nk-plan-of nkf-nil n
