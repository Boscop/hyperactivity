-- the suffixes that start with q are those at least q and not at least sq-up q
sq-starts-range : {A : Type} → (le : A → A → Bool) → (top : A) → (q : List (List A)) → (s : List (List A)) → sq-below-all le top s →
  sq-starts le q s ≡ andB (lexle (lexle le) q s) (not (lexle (lexle le) (sq-up top q) s))
sq-starts-range le top q = case q return λ w → (s : List (List A)) → sq-below-all le top s → sq-starts le w s ≡ andB (lexle (lexle le) w s) (not (lexle (lexle le) (sq-up top w) s)) of
  nil → λ s → case s return λ v → sq-below-all le top v → sq-starts le nil v ≡ andB (lexle (lexle le) nil v) (not (lexle (lexle le) (sq-up top nil) v)) of
    nil → λ h i → true
    cons y t → λ h → cong not (sym (λ i → lex-step (sq-top-above le top y (fst h) i) (lexle le y (cons top nil)) true))
  cons x r → λ s h → sq-starts-c-range le top r x s h
