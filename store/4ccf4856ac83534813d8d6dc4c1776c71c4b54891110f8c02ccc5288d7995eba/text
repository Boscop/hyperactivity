ho-http-post-json : List Word → List Word → Proc W (List Word)
ho-http-post-json url bodyJson =
  bind (h-capture
    (cons "/usr/bin/curl"
    (cons "-sS" (cons "--max-time" (cons "5"
    (cons "-H" (cons "Content-Type: application/json"
    (cons "-H" (cons "User-Agent: hx-hyperoperator/2.0"
    (cons "-d" (cons bodyJson (cons url nil)))))))))))) (λ r →
    ret {lzero} {W} (snd r))
