-- C(t) = Σ_{leaves a} depth_t(a): each leaf is charged once by every union above it
stree-cost-depths : (t : SumTree) → stree-cost t ≡ stree-depths zero t
stree-cost-depths stree-one = λ k → zero
stree-cost-depths (stree-plus l r) =
  transN (stree-rearr (stree-cost l) (stree-cost r) (stree-size l) (stree-size r))
  (transN (λ k → plus (plus (stree-size l) (stree-cost-depths l k)) (plus (stree-size r) (stree-cost-depths r k)))
  (λ k → plus (stree-deeper zero l (~ k)) (stree-deeper zero r (~ k))))
