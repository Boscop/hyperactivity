-- Racah's sum over k = 0 … n, kept as its even-k part and its odd-k part, the sign (−1)^k deciding
-- which; the sum itself is their difference
racah-sum : Nat → Nat → Nat → Nat → Nat → Nat → QP × QP
racah-sum a b c y1 x2 n = case n of
  zero → (racah-term a b c y1 x2 zero , (zero , suc zero))
  suc k → (if odd (suc k)
    then (fst (racah-sum a b c y1 x2 k) , qp-add (snd (racah-sum a b c y1 x2 k)) (racah-term a b c y1 x2 (suc k)))
    else (qp-add (fst (racah-sum a b c y1 x2 k)) (racah-term a b c y1 x2 (suc k)) , snd (racah-sum a b c y1 x2 k)))
