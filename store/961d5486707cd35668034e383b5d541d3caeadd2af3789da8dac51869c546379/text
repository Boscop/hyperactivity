-- (part of language-support)
wvm08 : (addr : Bits #48) → (sailval : Bits #8) → MS Unit
wvm08 addr sailval =
  onS {Bool} {Unit} (canonical_address_p (bv-signed #48 addr)) (λ t'1 →
    λ σ →
      if t'1 then
        the (MS Unit)
          (bang_memi #64 (bv-zext #48 #64 addr) sailval) σ
      else
        the (MS Unit)
          (liftS {Unit} (x86_model_error {Unit} #513087975480)) σ)
