v-layers-text : VEnv → Nat → List (List (List Word)) → List Word
v-layers-text env k nil = nil
v-layers-text env k (cons top rest) =
  let gains = v-step-all (λ x → v-look-list x (ve-gtab env)) top in
  list-append (h-line (list-append " layer " (list-append (h-decimal (fromNat (suc k))) (if v-empty gains then " (a prerequisite of nothing that waits)" else nil))))
    (list-append (h-concat (list-map (λ x → list-append (v-line env x) (v-gain-line env x)) top))
      (v-layers-text env (suc k) rest))
