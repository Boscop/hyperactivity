record LiveLoop =
  { ll-id     : List Word
  ; ll-name   : List Word
  ; ll-status : List Word
  ; ll-url    : List Word
  ; ll-ok     : Bool
  }

record LiveDom =
  { ld-patch  : List Word
  ; ld-sel    : List Word
  ; ld-text   : List Word
  }

record LiveNode =
  { ln-patch  : List Word
  ; ln-label  : List Word
  ; ln-clade  : Word
  ; ln-cost   : Word
  ; ln-mod    : List Word
  }

cl-q : List Word
cl-q = cons #34 nil

cl-nl : List Word
cl-nl = cons #10 nil

cl-esc : List Word → List Word
cl-esc nil = nil
cl-esc (cons c r) =
  if %weq c #34 then cons #92 (cons #34 (cl-esc r)) else
  if %weq c #92 then cons #92 (cons #92 (cl-esc r)) else
  if %weq c #10 then cons #92 (cons #110 (cl-esc r)) else
  if %wlt c #32 then cl-esc r else
  cons c (cl-esc r)

cl-qstr : List Word → List Word
cl-qstr s = h-concat (cons cl-q (cons (cl-esc s) (cons cl-q nil)))

cl-kv : List Word → List Word → List Word
cl-kv k v = h-concat (cons (cl-qstr k) (cons ":" (cons (cl-qstr v) nil)))

cl-kv-raw : List Word → List Word → List Word
cl-kv-raw k v = h-concat (cons (cl-qstr k) (cons ":" (cons v nil)))

cl-join : List (List Word) → List Word
cl-join nil = nil
cl-join (cons x nil) = x
cl-join (cons x xs) = h-concat (cons x (cons "," (cons (cl-join xs) nil)))

cl-bool-json : Bool → List Word
cl-bool-json true = "true"
cl-bool-json false = "false"

cl-emit-loop : LiveLoop → Word → List Word
cl-emit-loop l ts =
  h-concat (cons "{" (cons (cl-join (
    cons (cl-kv "id" "agent_closed_loop") (
    cons (cl-kv "from" "agent_closed_loop") (
    cons (cl-kv "to" "LIVE_OS") (
    cons (cl-kv "kind" "live_loop") (
    cons (cl-kv "loop_id" (ll-id l)) (
    cons (cl-kv "name" (ll-name l)) (
    cons (cl-kv "status" (ll-status l)) (
    cons (cl-kv "url" (ll-url l)) (
    cons (cl-kv-raw "ok" (cl-bool-json (ll-ok l))) (
    cons (cl-kv "msg" (list-append (ll-name l) (list-append ": " (ll-status l)))) (
    cons (cl-kv-raw "ts" (h-decimal ts)) nil)))))))))))) (cons "}" nil)))

cl-emit-dom : LiveDom → Word → List Word
cl-emit-dom d ts =
  h-concat (cons "{" (cons (cl-join (
    cons (cl-kv "id" "agent_closed_loop") (
    cons (cl-kv "kind" "live_dom") (
    cons (cl-kv "patch_id" (ld-patch d)) (
    cons (cl-kv "sel" (ld-sel d)) (
    cons (cl-kv "text" (ld-text d)) (
    cons (cl-kv-raw "ts" (h-decimal ts)) nil))))))) (cons "}" nil)))

cl-emit-node : LiveNode → Word → List Word
cl-emit-node n ts =
  h-concat (cons "{" (cons (cl-join (
    cons (cl-kv "id" "agent_closed_loop") (
    cons (cl-kv "kind" "live_node") (
    cons (cl-kv "patch_id" (ln-patch n)) (
    cons (cl-kv "label" (ln-label n)) (
    cons (cl-kv-raw "clade" (h-decimal (ln-clade n))) (
    cons (cl-kv-raw "cost" (h-decimal (ln-cost n))) (
    cons (cl-kv "mod" (ln-mod n)) (
    cons (cl-kv-raw "ts" (h-decimal ts)) nil))))))))) (cons "}" nil)))

-- Pure parser for {"next":<N>,"trace":[...]} returned by GET /api/trace?since=M
cl-is-digit : Word → Bool
cl-is-digit c = if %wlt c #48 then false else %wlt c #58

cl-take-digits : List Word → List Word
cl-take-digits nil = nil
cl-take-digits (cons c r) = if cl-is-digit c then cons c (cl-take-digits r) else nil

cl-parse-next : List Word → Word
cl-parse-next resp =
  let key = h-concat (cons cl-q (cons "next" (cons cl-q (cons ":" nil))))
      aft = h-after key resp
      digs = cl-take-digits aft
  in if h-null digs then #0 else h-number digs

cl-extract-trace-arr : List Word → List Word
cl-extract-trace-arr resp =
  let key = h-concat (cons cl-q (cons "trace" (cons cl-q (cons ":[" nil))))
      aft = h-after key resp
  in h-before "]}" aft

cl-not : Bool → Bool
cl-not true = false
cl-not false = true

cl-has-sub : List Word → List Word → Bool
cl-has-sub needle hay =
  if h-null needle then true else cl-not (h-eq (h-before needle hay) hay)

-- KERNEL CERTIFICATES (0 POSTULATES, ALL PROVED BY refl)
cl-sample-resp-1 : List Word
cl-sample-resp-1 = h-concat (cons "{" (cons (cl-kv-raw "next" "42") (cons "," (cons (cl-kv-raw "trace" "[]") (cons "}" nil)))))

cl-sample-resp-2 : List Word
cl-sample-resp-2 = h-concat (cons "{" (cons (cl-kv-raw "next" "1") (cons "," (cons (cl-kv-raw "trace" "[{1}]") (cons "}" nil)))))

cl-parse-next-cert : cl-parse-next cl-sample-resp-1 ≡ #42
cl-parse-next-cert = refl

cl-extract-arr-cert : cl-extract-trace-arr cl-sample-resp-2 ≡ "{1}"
cl-extract-arr-cert = refl

cl-starts-brace : List Word → Bool
cl-starts-brace (cons c _) = %weq c #123
cl-starts-brace nil = false

