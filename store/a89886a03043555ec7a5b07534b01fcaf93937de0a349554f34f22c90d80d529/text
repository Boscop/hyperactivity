-- ============================================================================
-- SECTION 2: EXECUTABLE PURE .hypercubical BIDIRECTIONAL CLOSED-LOOP RELAY
-- ============================================================================

cl-trace-url-since : Word → List Word
cl-trace-url-since n = list-append "https://hyperactivity.ai/api/trace?since=" (h-decimal n)

cl-curl-get : List Word → List (List Word)
cl-curl-get url =
  cons "/usr/bin/env" (cons "curl" (cons "-sS" (cons "--max-time" (cons "5" (cons url nil)))))

cl-curl-post : List Word → List Word → List (List Word)
cl-curl-post url file =
  cons "/usr/bin/env" (cons "curl" (cons "-sS" (cons "--max-time" (cons "6" (cons "-X" (cons "POST"
    (cons "-H" (cons "Content-Type: application/json"
    (cons "--data-binary" (cons (list-append "@" file) (cons url nil)))))))))))

cl-push-json : List Word → Proc W (List Word)
cl-push-json payload =
  let tmp = the (List Word) "/tmp/hx_agent_bus/cl_tx.json"
  in bind (h-mkdir "/tmp/hx_agent_bus") (λ u0 →
     bind (h-write tmp payload) (λ w1 →
     bind (h-capture (cl-curl-post "https://hyperactivity.ai/api/trace" tmp)) (λ rx →
     ret {lzero} {W} (snd rx))))

-- Drain local /tmp/hx_agent_bus/live_outbox.jsonl lines sequentially to POST /api/trace
cl-push-lines : List (List Word) → Proc W Unit
cl-push-lines nil = ret {lzero} {W} unit
cl-push-lines (cons l ls) =
  if h-null l then cl-push-lines ls
  else bind (cl-push-json l) (λ r → cl-push-lines ls)

-- One bidirectional sync tick:
--   (A) Pull remote GET /api/trace?since=cur -> if human_steer arrived, append to /tmp/hx_agent_bus/human_steer.jsonl
--   (B) Flush any new lines in /tmp/hx_agent_bus/live_outbox.jsonl -> POST /api/trace
cl-sync-tick : Word → Proc W Word
cl-sync-tick cur =
  let steerPath = the (List Word) "/tmp/hx_agent_bus/human_steer.jsonl"
      outPath   = the (List Word) "/tmp/hx_agent_bus/live_outbox.jsonl"
      curPath   = the (List Word) "/tmp/hx_agent_bus/remote_trace_cursor.txt"
  in bind (h-mkdir "/tmp/hx_agent_bus") (λ u0 →
     bind (h-capture (cl-curl-get (cl-trace-url-since cur))) (λ rx →
     let body = snd rx
         nxt  = cl-parse-next body
         arr  = cl-extract-trace-arr body
         nextCur = if %wlt cur nxt then nxt else cur
         isSteer = if %wlt cur nxt then cl-has-sub "human_steer" arr else false
     in bind (if isSteer
              then bind (h-read steerPath) (λ prev →
                   let old = the (List Word) (case prev of inl _ → nil ; inr b → b)
                       upd = list-append old (list-append arr cl-nl)
                   in h-write steerPath upd)
              else ret {lzero} {W} false) (λ w1 →
        bind (if %wlt cur nxt then h-write curPath (h-decimal nextCur) else ret {lzero} {W} false) (λ w2 →
        bind (h-read outPath) (λ ob →
        let obText = the (List Word) (case ob of inl _ → nil ; inr b → b)
        in if h-null obText then ret {lzero} {W} nextCur
           else bind (h-write outPath nil) (λ w3 →
                bind (cl-push-lines (h-lines obText)) (λ u4 →
                ret {lzero} {W} nextCur)))))))

cl-relay-loop : Nat → Word → Word → Proc W Unit
cl-relay-loop zero ns cur = ret {lzero} {W} unit
cl-relay-loop (suc k) ns cur =
  bind (cl-sync-tick cur) (λ nextCur →
  bind (sleep ns) (λ u →
  cl-relay-loop k ns nextCur))

cl-boot-relay : Nat → Proc W Unit
cl-boot-relay steps =
  bind (h-read "/tmp/hx_agent_bus/remote_trace_cursor.txt") (λ r →
  let raw = the (List Word) (case r of inl _ → nil ; inr b → b)
      c0  = if h-null raw then #0 else h-number raw
  in cl-relay-loop steps #1200000000 c0)
