-- inserting a coefficient into a sorted list: added to the variable's entry if present, else
-- placed in order; a merge is the fold of insertions (structural recursion on each argument)
ins-case : Bool → Bool → Word → Word → Word → Word → Coefs → Coefs → Coefs
ins-case eq lt v c v2 c2 r2 ir =
  case eq return (λ w → Coefs) of
    true → ccons v2 (plusw c c2) r2
    false → (case lt return (λ w → Coefs) of true → ccons v c (ccons v2 c2 r2); false → ccons v2 c2 ir)
