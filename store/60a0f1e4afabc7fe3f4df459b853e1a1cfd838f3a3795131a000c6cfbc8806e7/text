-- the completion is forced ("Respecting Equality" Theorem 9.2 “the fibre is the relabellings”, as above): the declaration is a proposition
Fs-prop : {o : Ord} → (X : Bag (El o)) → isProp (Fs X)
Fs-prop X =
  λ u v →
    let pB = sorted-unique {_} {fst u} {fst v} (snd (snd u)) (snd (snd v))
               (the ((a : El o) → isTrue (eqb (count a (fst u)) (count a (fst v))))
                  (λ a →
                     eqb-complete
                       (transN (eqb-sound {count a (fst u)} {countB a X} (fst (snd u) a))
                          (symN (eqb-sound {count a (fst v)} {countB a X} (fst (snd v) a))))))
    in λ i → (pB i , isProp→PathP (λ j → Gs X (pB j)) (isPropGs X (fst v)) (snd u) (snd v) i)
