drop-suc : {A : Type} → (q : Nat) → (l : List A) → drop-n (suc q) l ≡ tail-of (drop-n q l)
drop-suc q =
  case q return λ w → (l : List A) → drop-n (suc w) l ≡ tail-of (drop-n w l) of
    zero → λ l → case l return λ v → drop-n (suc zero) v ≡ tail-of v of nil → λ i → nil; cons x r → λ i → r
    suc k →
      λ l →
        case l return λ v → drop-n (suc (suc k)) v ≡ tail-of (drop-n (suc k) v) of
          nil → λ i → nil
          cons x r → rec k r
