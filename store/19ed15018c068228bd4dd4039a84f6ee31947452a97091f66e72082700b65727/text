-- and with a negative dividend: (0, Q)·(D, 0) is the integer (0, M)
in-ex-neg : (M Q D R : Nat) → M ≡ plus (times Q D) R → R ≡ zero → plus (times Q zero) M ≡ times Q D
in-ex-neg M Q D R h hr = transN (congN (λ z → plus z M) (times-zero Q)) (transN h (transN (congN (λ z → plus (times Q D) z) hr) (plus-zero (times Q D))))
