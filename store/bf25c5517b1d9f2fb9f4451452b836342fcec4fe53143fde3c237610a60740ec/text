-- a scratch path of this process's own under build/etym/tmp (two runs at once never share one)
e-tmp : List Word → Proc W (List Word)
e-tmp name = bind (h-mkdir "build/etym") (λ u → bind (h-mkdir "build/etym/tmp") (λ v → bind e-pid (λ p →
  ret (list-append "build/etym/tmp/" (list-append name (list-append "-" (h-decimal p)))))))
