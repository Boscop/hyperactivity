varp-disc : (sk : Lst Entry) → Discrete (VarP sk)
varp-disc lnil a b = Empty-rec {lzero} {Dec (Path (VarP lnil) a b)} a
varp-disc (lcons e-dim sk) a b = varp-disc sk a b
varp-disc (lcons (e-ty s) sk) none none = yes (λ i → none)
varp-disc (lcons (e-ty s) sk) (some x) (some y) = dec-some x y (varp-disc sk x y)
varp-disc (lcons (e-ty s) sk) none (some y) = no (apart (Opt (VarP sk)) opt-none? none (some y) unit (λ e → e))
varp-disc (lcons (e-ty s) sk) (some x) none = no (apart (Opt (VarP sk)) (λ o → not (opt-none? o)) (some x) none unit (λ e → e))
