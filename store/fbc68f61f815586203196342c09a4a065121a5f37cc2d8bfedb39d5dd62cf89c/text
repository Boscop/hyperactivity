-- v is an exact value of e when the inputs take the values E: every denominator positive, each
-- operation's equation holding of the values of its parts
isval : ((Nat → (Nat × Nat) × Nat)) → IE → (Nat × Nat) × Nat → Type
isval E e = case e return λ w → (Nat × Nat) × Nat → Type of
  ie-var k → λ v → le (suc zero) (snd v) × qeq v (E k)
  ie-int k → λ v → le (suc zero) (snd v) × qeq v (the (Nat × Nat) (k , zero) , suc zero)
  ie-rat n d → λ v → le (suc zero) (snd v) × qeq v (the (Nat × Nat) (n , zero) , suc d)
  ie-add a b → λ v → (va vb : (Nat × Nat) × Nat) × (rec a va × rec b vb) × (le (suc zero) (snd v) × qeq v (zplus (zsc (fst va) (snd vb)) (zsc (fst vb) (snd va)) , times (snd va) (snd vb)))
  ie-sub a b → λ v → (va vb : (Nat × Nat) × Nat) × (rec a va × rec b vb) × (le (suc zero) (snd v) × qeq v (zplus (zsc (fst va) (snd vb)) (zsc (the (Nat × Nat) (snd (fst vb) , fst (fst vb))) (snd va)) , times (snd va) (snd vb)))
  ie-mul a b → λ v → (va vb : (Nat × Nat) × Nat) × (rec a va × rec b vb) × (le (suc zero) (snd v) × qeq v (zmul (fst va) (fst vb) , times (snd va) (snd vb)))
  ie-div a b → λ v → (va vb : (Nat × Nat) × Nat) × (rec a va × rec b vb) × (le (suc zero) (snd v) × qeq (zmul (fst v) (fst vb) , times (snd v) (snd vb)) va)
