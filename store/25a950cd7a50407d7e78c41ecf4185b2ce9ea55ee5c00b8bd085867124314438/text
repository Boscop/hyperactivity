-- ============================================================================
-- 1. Chirality Non-Descent from Pairwise Distance Matrices
-- ============================================================================
-- Mirror reflection v ↦ -v preserves squared distance ‖v1 - v2‖² identically.
-- Variables (0..5): v1x, v1y, v1z, v2x, v2y, v2z.
fold-dist2-mirror-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
fold-dist2-mirror-poly A ad mu q vs =
  (λ g sub sq →
    let z = q (fn-q 0 1)
        x1 = g 0; y1 = g 1; z1 = g 2
        x2 = g 3; y2 = g 4; z2 = g 5
        dL = ad (ad (sq (sub x1 x2)) (sq (sub y1 y2))) (sq (sub z1 z2))
        dD = ad (ad (sq (sub (sub z x1) (sub z x2)))
                    (sq (sub (sub z y1) (sub z y2))))
                (sq (sub (sub z z1) (sub z z2)))
    in (dL , dD))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
