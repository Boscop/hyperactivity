h-publish-all : List Word → List Word → List (List Word) → Proc W (List Word)
h-publish-all srv tok nil = ret nil
h-publish-all srv tok (cons hx r) = bind (h-source-text (h-unhex hx)) (λ t → bind (h-publish-text srv tok (h-unhex hx) t) (λ ok →
  bind (h-publish-all srv tok r) (λ rest → ret (if ok then rest else list-append (h-line hx) rest))))
