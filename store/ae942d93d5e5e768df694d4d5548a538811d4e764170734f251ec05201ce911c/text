-- Canonical first-principles zero-VST plugins as checked DspExpr terms:
-- IEEE-754 f32 literals: 1.0 = 1065353216 (0x3f800000), 0.05 = 1028443341 (0x3d4ccccd)
dsp-softclip : DspExpr
dsp-softclip =
  let driven = d-mul d-in d-p1
  in d-mul (d-div driven (d-add (d-lit #1065353216) (d-abs driven))) d-p2
