-- a wire just written reads as what was written
nk-get-set : (sl : NkSlots) (w : NkW) (s : NkSlot) → nk-get (nk-set sl w s) w ≡ s
nk-get-set nksl-nil w-end s = refl
nk-get-set nksl-nil (w-0 r) s = nk-get-set nksl-nil r s
nk-get-set nksl-nil (w-1 r) s = nk-get-set nksl-nil r s
nk-get-set (nksl-node t a b) w-end s = refl
nk-get-set (nksl-node t a b) (w-0 r) s = nk-get-set a r s
nk-get-set (nksl-node t a b) (w-1 r) s = nk-get-set b r s
