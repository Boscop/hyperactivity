-- Theorem: a printer, a text for each meaning that reads back as it, is a point of printing over
-- every meaning
printer-prints : {C M : Type} → (r : C → List Word → M) → (p : C → M → List Word) → ((c : C) → (m : M) → Path M (r c (p c m)) m) → (c : C) → (m : M) → printing (reads-as r) c m
printer-prints {C} {M} r p h c m = (p c m , h c m)
