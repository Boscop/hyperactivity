  rprog #1
    (cons (#1 , re-sub (re-v #0) (oo-zk #2))
    (cons (#2 , re-add (re-v #0) (oo-zk #2))
    (cons (#3 , re-sub (re-v #0) (oo-zk #1))
    (cons (#4 , re-add (re-v #0) (oo-zk #1)) nil))))
    (cons (re-mul (re-mul (re-v #1) (re-v #2))
