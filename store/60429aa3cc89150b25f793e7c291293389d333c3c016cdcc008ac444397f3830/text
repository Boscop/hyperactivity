-- Exact Hydrogen Deficiency Index: 2 * IHD = 2*C + 2 + N - H - X  (X = F + Cl + Br + I)
-- Strictly derived from quantum valence (C=4, N=3, O=2, S=2, H=1, X=1) in periodic-table-exact!

record OrgFormula =
  { of-c : Word
  ; of-h : Word
  ; of-n : Word
  ; of-o : Word
  ; of-s : Word
  ; of-x : Word   -- total halogens F + Cl + Br + I
  }

oo-ihd-x2 : OrgFormula → Word
oo-ihd-x2 f =
  %wsub (%wadd (%wadd (%wmul #2 (of-c f)) #2) (of-n f))
        (%wadd (of-h f) (of-x f))

-- Exact valence parity check: 2*IHD must be even (Nitrogen Rule of Mass Spectrometry!)
oo-nitrogen-rule-ok : OrgFormula → Bool
oo-nitrogen-rule-ok f =
  let d = oo-ihd-x2 f
  in %weq (%wmul #2 (%wdiv d #2)) d

oo-ihd : OrgFormula → Word
oo-ihd f = %wdiv (oo-ihd-x2 f) #2

