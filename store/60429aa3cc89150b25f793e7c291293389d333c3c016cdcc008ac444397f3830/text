-- SECTION 3: UNIVERSAL 3D STEREOCHEMISTRY / CHIRALITY MIRROR-INVERSION THEOREM OVER Z^9
-- ============================================================================
-- For ANY tetrahedral stereocenter with substituent vectors u=(v0,v1,v2), v=(v3,v4,v5), w=(v6,v7,v8):
--   det([u, v, w]) = u_x*(v_y*w_z - v_z*w_y) - u_y*(v_x*w_z - v_z*w_x) + u_z*(v_x*w_y - v_y*w_x)
-- Under mirror reflection across the yz-plane (x -> -x):
--   det([mirror(u), mirror(v), mirror(w)]) + det([u, v, w]) == 0 IDENTICALLY over ALL Z^9!

oo-det3 : RExpr → RExpr → RExpr → RExpr → RExpr → RExpr → RExpr → RExpr → RExpr → RExpr
oo-det3 ux uy uz vx vy vz wx wy wz =
  re-add
    (re-sub (re-mul ux (re-sub (re-mul vy wz) (re-mul vz wy)))
            (re-mul uy (re-sub (re-mul vx wz) (re-mul vz wx))))
    (re-mul uz (re-sub (re-mul vx wy) (re-mul vy wx)))

oo-neg : RExpr → RExpr
oo-neg x = re-sub (oo-zk #0) x

oo-chiral-mirror-sum : RProg
oo-chiral-mirror-sum =
  rprog #9 nil
    (cons (re-add
            (oo-det3 (re-v #0) (re-v #1) (re-v #2) (re-v #3) (re-v #4) (re-v #5) (re-v #6) (re-v #7) (re-v #8))
            (oo-det3 (oo-neg (re-v #0)) (re-v #1) (re-v #2)
                     (oo-neg (re-v #3)) (re-v #4) (re-v #5)
                     (oo-neg (re-v #6)) (re-v #7) (re-v #8))) nil)

oo-zero-prog9 : RProg
oo-zero-prog9 = rprog #9 nil (cons (oo-zk #0) nil)

