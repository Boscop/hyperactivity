oo-zk : Word → RExpr
oo-zk n = re-k (zi n #0)

oo-sq : RExpr → RExpr
oo-sq x = re-mul x x

oo-benzene-expanded : RProg
oo-benzene-expanded =
  rprog #1
    (cons (#1 , oo-sq (re-v #0))          -- l^2
    (cons (#2 , oo-sq (re-v #1))          -- l^4
    (cons (#3 , re-mul (re-v #1) (re-v #2)) nil))) -- l^6
    (cons (re-sub (re-add (re-sub (re-v #3) (re-mul (oo-zk #6) (re-v #2)))
                          (re-mul (oo-zk #9) (re-v #1)))
                  (oo-zk #4)) nil)

