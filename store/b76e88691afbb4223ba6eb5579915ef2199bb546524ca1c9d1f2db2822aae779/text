-- (part of language-support)
wml_size-case8 : (nbytes : ZI) → (addr : Bits #48) → (sailval : ZI) → MS Unit
wml_size-case8 nbytes addr sailval =
  onS {Bool} {Unit} (canonical_address_p (z-add (zneg #1) (z-add nbytes (bv-signed #48 addr)))) (λ t'8 →
    λ σ →
      if t'8 then
        the (MS Unit)
          (wb #48 nbytes addr #14935 (bits_of_int sailval (z-mul (zpos #8) nbytes))) σ
      else
        the (MS Unit)
          (liftS {Unit} (x86_model_error {Unit} #8605653405440506469)) σ)
