-- ---------------------------------------------------------------- convergence
-- a replica's store is a function of the set of writes it has applied: two replicas whose
-- applied writes are the same set (in any order, with any repetition) have equal stores
kv-converges : Converges {KvWrite} {Word → Word} kv-store
kv-converges l1 l2 s12 s21 = λ i k → converges-fold {KvWrite} {Word} wmax #0 wmax-semilat (λ w → kv-sel w k) l1 l2 s12 s21 i
