iv-pos-sure-sound : (S : List Bool) → (x : IV) → (X : Nat × Nat) → (q : Nat) → ivc x → le (suc zero) q → iv-pos-sure x ≡ true → encl S x X q → zpos (zsc X (bin-to-nat S))
iv-pos-sure-sound S x X q cx hq h e = zle-trans (the (Nat × Nat) (suc zero , zero)) (zsc (zv (fst x)) q) (zsc X (bin-to-nat S))
  (zpos-scale (zv (fst x)) q (bz-nonpos-false (fst (fst x)) (snd (fst x)) (fst cx) (not-true (bz-nonpos (fst x)) h)) hq) (fst e)
