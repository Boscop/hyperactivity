-- what followed the occurrences at qs in the text d (read forward)
c-lines-of : Word → List Word → List Word → Proc W (List (List Word))
c-lines-of e d qs = if h-null qs then ret {lzero} {W} nil else bind (c-text d) (λ t → ret (list-map (λ l → h-rev l nil) (m-lines #240 e qs (list-length t) (text-bytes t))))
