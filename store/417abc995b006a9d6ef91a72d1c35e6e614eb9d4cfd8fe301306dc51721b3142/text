v-write-json : List Word → List Word → Proc W Unit
v-write-json st path =
  with-bytes {Unit} (wadd (fromNat (list-length path)) #1) (λ p →
  bind (h-poke p path) (λ u →
  bind (sys-call #2 p #577 #420 #0 #0 #0) (λ fd →
  bind (fd-write fd (list-append "{" (j-field "nodes" "["))) (λ w1 →
  bind (v-write-json-nodes st fd true (list-map (λ e → fst e) v-all)) (λ u2 →
  bind (fd-write fd (list-append "]," (list-append (j-field "roots" (j-strs v-roots)) "}"))) (λ w2 →
  bind (close-file fd) (λ c → ret unit)))))))
