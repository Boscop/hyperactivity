-- the pencil in integers: H and S rounded once to scale 2^k (hz, sz), λ = l/2^m; 2^m·hz − l·sz is 2^(k+m)·(H − λS)
-- to within 2^m + |l| in every entry
dy-zrow : BZ → BZ → List BZ → List BZ → List BZ
dy-zrow e l a b = case a of
  nil → nil
  cons x r → (case b of
    nil → nil
    cons y s → cons (bz-sub (bz-mul e x) (bz-mul l y)) (dy-zrow e l r s))
