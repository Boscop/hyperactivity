soc-prog-imem : Word → HartInst
soc-prog-imem pc =
  if weq pc #0 then h-alu alu-add #6 #1 #2
  else if weq pc #1 then h-alu alu-mul #7 #6 #2
  else if weq pc #2 then h-store #5 #7
  else if weq pc #3 then h-load #3 #5
  else if weq pc #4 then h-store #4 #7
  else if weq pc #5 then h-bnez #1 #7
  else if weq pc #6 then h-nop
  else if weq pc #7 then h-alu alu-max #6 #7 #6
  else if weq pc #8 then h-store #4 #6
  else h-nop
