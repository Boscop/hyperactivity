-- c²·d = 0 with d not zero gives c = 0
zr-q6 : (c d : ZrC) → zr-isz d ≡ false → zr-mu (zr-mu c c) d ≡ zrz → c ≡ zrz
zr-q6 c d hd e = case zr-dec c of
  inl e0 → e0
  inr hc → absurd-ft (c ≡ zrz) (cl-tr Bool false (zr-isz (zr-mu (zr-mu c c) d)) true (λ i → zr-nzd (zr-mu c c) d (zr-nzd c c hc hc) hd (~ i)) (λ i → zr-isz (e i)))
