-- Signed tetrahedral volume determinant det(v1, v2, v3) strictly negates under v ↦ -v:
--   det(-v1, -v2, -v3) + det(v1, v2, v3) = 0.
-- Variables (0..8): v1, v2, v3 ∈ R³.
fold-det3 : (A : Type) → (A → A → A) → (A → A → A) → (A → A → A) →
            A → A → A → A → A → A → A → A → A → A
fold-det3 A ad sub mu a1 a2 a3 b1 b2 b3 c1 c2 c3 =
  ad (sub (mu a1 (sub (mu b2 c3) (mu b3 c2)))
          (mu a2 (sub (mu b1 c3) (mu b3 c1))))
     (mu a3 (sub (mu b1 c2) (mu b2 c1)))
