-- r_n = γ_n / (β_n − α_n r_{n+1}), from t = r_{n+1}
rad-r-at : List Bool → List Bool → IV → IV → IV → Nat → IV → IV
rad-r-at S S2 p sig c n t = iv-div S S2 (iv-mul S (iv-sub (iv-int S (monus n 1)) sig) (iv-sub (iv-int S (monus n 1)) sig))
  (iv-sub (iv-add (iv-add (iv-int S (times 2 (times n n))) (iv-mul S (iv-sub (iv-add (iv-add p p) (iv-add p p)) (iv-add sig sig)) (iv-int S n))) c)
          (iv-mul S (iv-int S (times (suc n) (suc n))) t))
