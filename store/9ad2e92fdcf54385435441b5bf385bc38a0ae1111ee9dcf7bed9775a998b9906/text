mentions-lt d b t =
  case t of
    cvar n → andb (notb (%wlt n d)) (%wlt n (%wadd d b))
    clam x → mentions-lt (%wsucc d) b x
    capp f x → orb (mentions-lt d b f) (mentions-lt d b x)
    cpair x y → orb (mentions-lt d b x) (mentions-lt d b y)
    cfst x → mentions-lt d b x
    csnd x → mentions-lt d b x
    clet a x → orb (mentions-lt d b a) (mentions-lt (%wsucc d) b x)
    ccon dd c fs ds → mentions-any d b fs
    ccase dd B x → orb (mentions-any d b B) (mentions-lt d b x)
    celim dd P B x → orb (mentions-lt d b P) (orb (mentions-any d b B) (mentions-lt d b x))
    cforce x → mentions-lt d b x
    cthunk x → mentions-lt d b x
    cdata dd ps → mentions-any d b ps
    cwsucc x → mentions-lt d b x
    cwop o x y → orb (mentions-lt d b x) (mentions-lt d b y)
    cwelim w z s mo → orb (mentions-lt d b w) (orb (mentions-lt d b z) (orb (mentions-lt d b s) (case mo of some P → mentions-lt d b P; none → false)))
    cann a T → mentions-lt d b a
    cpty q n → mentions-lt d b n
    cprim q as → mentions-any d b as
    cpi m x y → orb (mentions-lt d b x) (mentions-lt (%wsucc d) b y)
    csigma x y → orb (mentions-lt d b x) (mentions-lt (%wsucc d) b y)
    _ → false
