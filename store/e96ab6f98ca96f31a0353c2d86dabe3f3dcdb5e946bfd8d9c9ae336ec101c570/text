-- and above every list of tokens beginning with such a token
sq-top-above2 : {A : Type} → (le : A → A → Bool) → (top : A) → (y : List A) → (t : List (List A)) → sq-below le top y → lexle (lexle le) (cons (cons top nil) nil) (cons y t) ≡ false
sq-top-above2 le top y t h i = lex-step (sq-top-above le top y h i) (lexle le y (cons top nil)) true
