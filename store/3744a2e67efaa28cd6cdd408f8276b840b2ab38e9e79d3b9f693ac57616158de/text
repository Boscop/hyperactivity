bn-node-aup-ok : BnNodeSpec → Bool
bn-node-aup-ok (mk-bn-node nid prov tr gpus rl ep sp rate) =
  case rl of
    br-zk-pouw-miner →
      (case prov of
         bp-akash          → true
         bp-clore          → true
         bp-x402           → true
         bp-ssh-mesh minOk → minOk)
    br-queen-hub       → true
    br-superopt-weaver → true
    br-synesthesia-72b → true
    br-hft-relayer     → true
