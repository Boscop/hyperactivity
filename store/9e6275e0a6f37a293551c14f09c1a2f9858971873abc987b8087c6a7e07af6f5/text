sta-slew-alg : {O0 O1 O2 : Type} → (O1 → Nat → StaSlew) → (O2 → Nat → Nat → StaSlew) → Alg O0 O1 O2 StaSlew
sta-slew-alg u1 u2 =
  ( (λ c → (zero , zero))
  , (λ u a → let ds = u1 u (snd a) in (plus (fst a) (fst ds) , snd ds))
  , (λ b x y → let ds = u2 b (snd x) (snd y) in (plus (maxN (fst x) (fst y)) (fst ds) , snd ds)) )
