zr-pa : (p : ZrP) → zr-posof (zr-pred p) ≡ p
zr-pa p = case p return λ w → zr-posof (zr-pred w) ≡ w of
  zr1 → λ i → zr1
  zro q → cl-tr ZrP (zr-posof (suc (zr-dd (zr-pred q)))) (zro (zr-posof (zr-pred q))) (zro q) (zr-a1 (zr-pred q)) (λ i → zro (zr-pa q i))
  zri q → cl-tr ZrP (zr-posof (suc (suc (zr-dd (zr-pred q))))) (zri (zr-posof (zr-pred q))) (zri q) (zr-a2 (zr-pred q)) (λ i → zri (zr-pa q i))
