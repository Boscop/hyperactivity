-- signed multiplication
bz-mul-sound : (s1 : Bool) → (m1 : List Bool) → (s2 : Bool) → (m2 : List Bool) → zeq (zv (bz-mul (s1 , m1) (s2 , m2))) (zmul (zv (s1 , m1)) (zv (s2 , m2)))
bz-mul-sound s1 m1 s2 m2 = case s1 return λ u → zeq (zv (bz-mul (u , m1) (s2 , m2))) (zmul (zv (u , m1)) (zv (s2 , m2))) of
  true → (case s2 return λ w → zeq (zv (bz-mul (true , m1) (w , m2))) (zmul (zv (true , m1)) (zv (w , m2))) of
    true → zeq-cong (zv (bz-mul (true , m1) (true , m2))) (times (bin-to-nat m1) (bin-to-nat m2)) zero
             (plus (times (bin-to-nat m1) (bin-to-nat m2)) zero) (plus (times (bin-to-nat m1) zero) zero)
             (symN (plus-zero (times (bin-to-nat m1) (bin-to-nat m2)))) (zero-pz (bin-to-nat m1))
             (zmag-pos (bin-mul m1 m2) (times (bin-to-nat m1) (bin-to-nat m2)) (bin-mul-sound m1 m2))
    false → zeq-cong (zv (bz-mul (true , m1) (false , m2))) zero (times (bin-to-nat m1) (bin-to-nat m2))
             (plus (times (bin-to-nat m1) zero) zero) (plus (times (bin-to-nat m1) (bin-to-nat m2)) zero)
             (zero-pz (bin-to-nat m1)) (symN (plus-zero (times (bin-to-nat m1) (bin-to-nat m2))))
             (zmag-neg (bin-mul m1 m2) (times (bin-to-nat m1) (bin-to-nat m2)) (bin-mul-sound m1 m2)))
  false → (case s2 return λ w → zeq (zv (bz-mul (false , m1) (w , m2))) (zmul (zv (false , m1)) (zv (w , m2))) of
    true → zeq-cong (zv (bz-mul (false , m1) (true , m2))) zero (times (bin-to-nat m1) (bin-to-nat m2))
             (times (bin-to-nat m1) zero) (times (bin-to-nat m1) (bin-to-nat m2))
             (symN (times-zero (bin-to-nat m1))) (λ i → times (bin-to-nat m1) (bin-to-nat m2))
             (zmag-neg (bin-mul m1 m2) (times (bin-to-nat m1) (bin-to-nat m2)) (bin-mul-sound m1 m2))
    false → zeq-cong (zv (bz-mul (false , m1) (false , m2))) (times (bin-to-nat m1) (bin-to-nat m2)) zero
             (times (bin-to-nat m1) (bin-to-nat m2)) (times (bin-to-nat m1) zero)
             (λ i → times (bin-to-nat m1) (bin-to-nat m2)) (symN (times-zero (bin-to-nat m1)))
             (zmag-pos (bin-mul m1 m2) (times (bin-to-nat m1) (bin-to-nat m2)) (bin-mul-sound m1 m2)))
