nk-copy-env-denotes : (rho : NkW → NkEv) (parts : NkEnv) (n : NkW) →
  (nk-ebound parts n ≡ true) →
  nk-env-ev (nk-rho-copy rho parts n) (nk-copy-env parts n) ≡ nk-env-ev rho parts
nk-copy-env-denotes rho nke-nil n hb = refl
nk-copy-env-denotes rho (nke-cons w r) n hb =
  let rho1 = nk-rho-set rho n (rho w)
      sn = nk-s n
      r_lt_n = nk-and-r (nk-wire-lt w n) (nk-ebound r n) hb
      r_lt_sn = nk-ebound-up n sn r (nk-wire-le-s n) r_lt_n
      hd_eq = nk-rho-copy-below rho1 r sn n (nk-wire-lt-s n) ∙ nk-rho-set-same rho n (rho w)
      tl_eq = nk-copy-env-denotes rho1 r sn r_lt_sn ∙ nk-env-ev-set-lt rho n (rho w) r r_lt_n
  in cong (λ z → nkev-cons z (nk-env-ev (nk-rho-copy rho1 r sn) (nk-copy-env r sn))) hd_eq
     ∙ cong (λ z → nkev-cons (rho w) z) tl_eq
