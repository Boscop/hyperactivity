-- top alone is above every list whose elements it is above
sq-top-above : {A : Type} → (le : A → A → Bool) → (top : A) → (y : List A) → sq-below le top y → lexle le (cons top nil) y ≡ false
sq-top-above le top y = case y return λ v → sq-below le top v → lexle le (cons top nil) v ≡ false of
  nil → λ h i → false
  cons d s → λ h i → lex-step (fst h i) (le d top) (lexle le nil s)
