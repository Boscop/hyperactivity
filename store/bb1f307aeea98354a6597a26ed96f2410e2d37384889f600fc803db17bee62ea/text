-- ---------------------------------------------------------------- 4. concrete gated / movable-boundary interface
-- a two-mode dynamic interface (mode = false: decoupled / closed gate; mode = true: coupled / open gate).
-- In either mode, the process can issue a mode-specific command from S-off / S-on, OR issue a
-- boundary-reshaping flip command that switches the interface mode for the next tick.
data GateCmd (S-off S-on : Sig) (m : Bool) =
    gate-act (c : Cmd (if m then S-on else S-off))
  | gate-flip
