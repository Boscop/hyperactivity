-- the most of the end each text holds (p the end reversed, of m bytes, f its failures)
c-bests : (n : Nat) → Bytes n → (k : Nat) → Bytes k → Word → List (List Word) → Proc W (List (List Word × Word))
c-bests n p k f m nil = ret nil
c-bests n p k f m (cons d r) = bind (c-text d) (λ t → bind (c-bests n p k f m r) (λ rest →
  ret (cons (d , m-best n p k f m t) rest)))
