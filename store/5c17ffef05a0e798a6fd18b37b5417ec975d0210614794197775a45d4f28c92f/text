-- the runs of a static's initial bytes: written ones stored, the others left unwritten
rm-init-runs : List RBytes → Target → MPtr → Word → REv Unit
rm-init-runs nil t p off = rm-ret unit
rm-init-runs (cons r rs) t p off = case r of
  rbytes-init bs → rm-then (rm-init-bytes bs t p off) (rm-init-runs rs t p (wadd off (rm-wlen bs)))
  rbytes-uninit n → rm-init-runs rs t p (wadd off n)
