const-pull : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (c : X) (d : Y c) (e : F' (f c d)) →
  PathP (λ i → DCube n X F (cube-const n X c)) (dcube-const n X F c (g c d e))
    (dcube-pull n X X' Y F F' f g (cube-const n X c) (dcube-const n X Y c d)
       (carry n X' F' (cube-const n X' (f c d)) (dcube-map n X Y X' f (cube-const n X c) (dcube-const n X Y c d))
          (psym (Cube n X') (dcube-map n X Y X' f (cube-const n X c) (dcube-const n X Y c d)) (cube-const n X' (f c d)) (dmap-const-cube n X Y X' f c d))
          (dcube-const n X' F' (f c d) e)))
const-pull zero X X' Y F F' f g c d e =
  λ i → g c d (carry-fill zero X' F' (f c d) (f c d) (psym (Cube zero X') (f c d) (f c d) (dmap-const-cube zero X Y X' f c d)) e i)
const-pull (suc n) X X' Y F F' f g c d e =
  const-pull n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g) (degen-l X c) (degen-o X Y c d) (degen-o X' F' (f c d) e)
