-- Postulate 1 (1-bit capacity): given ANY binary observation o : H → Bool and ANY
-- three histories h1, h2, h3 : H, at least two share the exact same observation outcome.
rqm-postulate1-bool-pigeonhole :
  (H : Type 0) → (o : H → Bool) → (h1 h2 h3 : H) →
  RqmOr (o h1 ≡ o h2) (RqmOr (o h1 ≡ o h3) (o h2 ≡ o h3))
rqm-postulate1-bool-pigeonhole H o h1 h2 h3 = rqm-bool3 (o h1) (o h2) (o h3)
