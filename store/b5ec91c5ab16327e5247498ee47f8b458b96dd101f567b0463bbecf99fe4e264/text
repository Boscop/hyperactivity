nk-compile-sig : NkRawSig → NkTm
nk-compile-sig rsig =
  let kd = nk-compile-datas rsig (fst rsig)
      kf0 = nk-compile-defs0 rsig (snd rsig)
      dm = nk-words-tm (l-map (λ e → fst e) (fst rsig))
      gm = nk-words-tm (l-map (λ e → fst e) (snd rsig))
  in if (if nk-has-fail kd then true else nk-has-fail kf0)
       then nk-fail
       else nk-con #56 (nk-cons kd (nk-cons (nk-norm-defs kf0 kf0) (nk-cons dm (nk-cons gm nk-nil))))
