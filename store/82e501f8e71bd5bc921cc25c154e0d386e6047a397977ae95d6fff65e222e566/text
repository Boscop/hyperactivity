csr-flat-len : (t : CsRope) → (csr-wf t ≡ true) → csr-list-len (csr-flat t) ≡ csr-len t
csr-flat-len (csr-leaf bs) hw = refl
csr-flat-len (csr-cat n l r) hw =
  let heq = csr-eqb-sound n (csr-len l) (csr-and-l (eqb n (csr-len l)) (c-and (csr-wf l) (csr-wf r)) hw)
      hw2 = csr-and-r (eqb n (csr-len l)) (c-and (csr-wf l) (csr-wf r)) hw
      hwl = csr-and-l (csr-wf l) (csr-wf r) hw2
      hwr = csr-and-r (csr-wf l) (csr-wf r) hw2
  in csr-app-len (csr-flat l) (csr-flat r)
     ∙ (cong (λ z → plus z (csr-list-len (csr-flat r))) (csr-flat-len l hwl ∙ sym heq)
        ∙ cong (plus n) (csr-flat-len r hwr))
