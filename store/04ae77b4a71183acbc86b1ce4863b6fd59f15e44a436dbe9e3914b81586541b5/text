quotient-split : List (List Word) → List Word → List Word × List Word
quotient-split qmap nil = (nil , nil)
quotient-split qmap (cons x r) =
  let p = quotient-split qmap r
      k = fromNat (list-length qmap)
  in case find-in-qmap x qmap of
       some cr → (cons (fst cr) (fst p) , cons (snd cr) (snd p))
       none → (cons (wadd k x) (fst p) , snd p)
