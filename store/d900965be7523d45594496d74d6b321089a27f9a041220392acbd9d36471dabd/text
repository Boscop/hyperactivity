-- the electric form on flux is half the squared triad sum: O_00 − O_01 = ½(G_00 − G_01) with G = −4K, so for labels with
-- Σ_e n_e = 0 the vertex's electric energy is ½ |Σ_e n_e T_e|², T_e the quantized triad
tet-electric-triad-of : VW → List (List Side) → List PRad
tet-electric-triad-of w ss = tet-half-trace (terms-append (flux-half-trace-terms 0 1 w ss) (terms-scale (sq-nat 2) (terms-append (k-terms 0 0 tet-ds tet-ts w (sides-nth 0 ss) (sides-nth 0 ss)) (terms-scale (sq-neg sq-one) (k-terms 0 1 tet-ds tet-ts w (sides-nth 0 ss) (sides-nth 1 ss))))))
