pull-fmap : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' F2 : X' → Type 1) (f : (x : X) → Y x → X') (h : (x : X') → F' x → F2 x)
  (g : (x : X) (y : Y x) → F2 (f x y) → F x) (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' F' (dcube-map n X Y X' f c d)) →
  PathP (λ i → DCube n X F c)
    (dcube-pull n X X' Y F F2 f g c d (dcube-fmap n X' F' F2 h (dcube-map n X Y X' f c d) e))
    (dcube-pull n X X' Y F F' f (λ x y z → g x y (h (f x y) z)) c d e)
pull-fmap zero X X' Y F F' F2 f h g c d e = λ i → g c d (h (f c d) e)
pull-fmap (suc n) X X' Y F F' F2 f h g c d e =
  pull-fmap n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (LineO X' F2) (lineo-map X Y X' f) (lineo-fmap X' F' F2 h)
    (lineo-pull X X' Y F F2 f g) c d e
