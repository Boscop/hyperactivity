-- ---------------------------------------------------------------- propositions
isPropIsContr : {l : Level} {A : Type l} → isProp (isContr A)
isPropIsContr =
  λ z w j →
    (snd z (fst w) j
    , λ y i →
        comp (λ k → A)
          (λ k →
             [ i = 0 ↦ snd z (snd z (fst w) j) k
             , i = 1 ↦ snd z y k
             , j = 0 ↦ snd z (snd z y i) k
             , j = 1 ↦ snd z (snd w y i) k ]) (fst z))
