-- C(a + b, a)·a!·b! = (a + b)!
ilv-fact-s : (a : Nat) → ((b : Nat) → times (times (interleavings a b) (fact a)) (fact b) ≡ fact (plus a b)) →
  (b : Nat) → times (times (interleavings (suc a) b) (fact (suc a))) (fact b) ≡ fact (plus (suc a) b)
ilv-fact-s a ih zero = transN (times-one (times (suc zero) (fact (suc a))))
  (transN (times-one-l (fact (suc a))) (congN fact (sym (plus-zero (suc a)))))
ilv-fact-s a ih (suc b) = transN (ilv-step (interleavings a (suc b)) (interleavings (suc a) b) (fact a) (fact b) a b (plus a b)
    (fact (plus a (suc b))) (ih (suc b))
    (transN (ilv-fact-s a ih b) (congN fact (sym (plus-suc a b)))))
  (λ k → times (plus (suc a) (suc b)) (fact (plus a (suc b))))
