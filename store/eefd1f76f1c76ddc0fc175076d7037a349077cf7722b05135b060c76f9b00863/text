-- Exact curved aperture clip bounded by the centerlines of the concave hyperbolic portals ) and (
portal-center-pts : Nat → Word → Word → SInt → SInt → SInt → SInt → List Pt2
portal-center-pts zero n idx side W H F = nil
portal-center-pts (suc rem) n idx side W H F =
  let u = si-sub (si-div-w (si-mul (sp #20000) (sp idx)) n) (sp #10000)
      u2 = fx-mul u u
      oneMu2 = si-sub (sp fx-S) u2
      px = si-add (sp #1280) (si-mul side (si-sub W (fx-mul F oneMu2)))
      py = si-add (sp #1280) (fx-mul H u)
  in cons (px , py) (portal-center-pts rem n (%wsucc idx) side W H F)
