ns-self : {M St : Type} → (P : St → Type) → (i j : NodeId) → (e : Ev M) → (g : FState M St) → (v : NView M St) → eqb i j ≡ true →
          P (fst g i) → VOk {M} {St} P v → P (fst (ns-go {M} {St} j e g v) i)
ns-self {M} {St} P i j e g v-halt eq h hv = h
ns-self {M} {St} P i j e g (v-send to m s) eq h hv = fl-apply-self {M} {St} {Unit} P i j g (net-world {M} j e (n-send to m) (snd g)) (λ u → s) eq h (λ u → hv)
ns-self {M} {St} P i j e g (v-recv k) eq h hv = fl-apply-self {M} {St} {Rcv M} P i j g (net-world {M} j e n-recv (snd g)) k eq h hv
ns-self {M} {St} P i j e g (v-now kn) eq h hv = fl-apply-self {M} {St} {Word} P i j g (net-world {M} j e n-now (snd g)) kn eq h hv
ns-self {M} {St} P i j ev-run g (v-tau s) eq h hv = subst {lzero} {lzero} {St} {P} (sym (put-node-same {St} i j s (fst g) eq)) hv
ns-self {M} {St} P i j (ev-deliver p rest) g (v-tau s) eq h hv = h
