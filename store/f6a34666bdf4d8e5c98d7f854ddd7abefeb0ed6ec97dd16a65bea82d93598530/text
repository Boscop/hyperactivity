lsem-add-body : (e : Env) (k : Word) (cs : Coefs) (m : Word) (ds : Coefs) →
                plusw (plusw k m) (csem e (lcoef-add cs ds)) ≡ plusw (plusw k (csem e cs)) (plusw m (csem e ds))
lsem-add-body e k cs m ds =
  catw (congw (λ z → plusw (plusw k m) z) (csem-add e cs ds))
    (catw (plusw-assoc k m (plusw (csem e cs) (csem e ds)))
      (catw (congw (λ z → plusw k z) (plusw-mid m (csem e cs) (csem e ds)))
        (symw (plusw-assoc k (csem e cs) (plusw m (csem e ds))))))
