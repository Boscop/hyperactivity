-- B_k with the σ_z-weighted closing, the image kept over the vertex's weight-zero monomials msW (not restricted)
sigma-b-mats : Nat → Mons → Mons → Rows → Rows → (List Nat → List Nat → SQ) → Rows → List Rows
sigma-b-mats n msW ms2 bs2 tm rent cs = case n of
  zero → nil
  suc g → cons (rows-map-entry (sigma-entry rent) msW ms2 (lift-all (mons-count ms2) bs2 cs)) (sigma-b-mats g msW ms2 bs2 tm rent (rows-apply-all tm cs))
