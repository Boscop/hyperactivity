nk-upd-same-at : (c : Bool) (a b : NkSlots) (w x : NkW) (f : NkSlot → NkSlot) → (nk-weq w x ≡ c) → nk-same a b → nk-get (nk-upd a w f) x ≡ nk-get (nk-upd b w f) x
nk-upd-same-at true a b w x f p h =
  nk-tr5 (nk-get (nk-upd a w f) x) (nk-get (nk-upd a w f) w) (f (nk-get a w)) (f (nk-get b w)) (nk-get (nk-upd b w f) w) (nk-get (nk-upd b w f) x)
    (cong (λ z → nk-get (nk-upd a w f) z) (sym (nk-weq-sound w x p))) (nk-get-set a w (f (nk-get a w))) (cong f (h w)) (sym (nk-get-set b w (f (nk-get b w)))) (cong (λ z → nk-get (nk-upd b w f) z) (nk-weq-sound w x p))
nk-upd-same-at false a b w x f p h = nk-get-set-other a w x (f (nk-get a w)) p ∙ (h x ∙ sym (nk-get-set-other b w x (f (nk-get b w)) p))
