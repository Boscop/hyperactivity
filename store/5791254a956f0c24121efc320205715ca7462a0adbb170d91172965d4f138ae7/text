ang-a : List Bool → List Bool → IV → Nat → Nat → IV → IV
ang-a S S2 p2 M k lh = case k of
  zero → lh
  suc g → ang-a S S2 p2 M g (ang-a-pick (fst lh) (snd lh) (bz-fdiv (bz-add (fst lh) (snd lh)) bin-two)
    (ang-g S S2 p2 ((bz-fdiv (bz-add (fst lh) (snd lh)) bin-two) , (bz-fdiv (bz-add (fst lh) (snd lh)) bin-two)) M))
