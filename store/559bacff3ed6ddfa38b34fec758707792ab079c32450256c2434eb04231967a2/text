-- duplicate: a value without parts is copied; a value with parts is held once on a new wire, each
-- side getting a reference
nk-rule-dup : Word → Word → NkVal → NkEnv → Word → NkOut
nk-rule-dup a b v nke-nil n = nk-plan-of (nkf-val a v (nkf-val b v nkf-nil)) n
nk-rule-dup a b v (nke-cons w r) n = nk-plan-of (nkf-val n v (nkf-val a (nkv-ref n) (nkf-val b (nkv-ref n) nkf-nil))) (%wsucc n)
