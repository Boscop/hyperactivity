-- write_user_rflags: from register_readers_and_writers.sail (it calls what is defined after it there)
-- (part of language-support)
write_user_rflags : (user_flags_vector : rflagsbits) → (undefined_mask : rflagsbits) → MS Unit
write_user_rflags user_flags_vector undefined_mask =
  bindS {rflagsbits} {Unit} (getS {rflagsbits} x86-rflags) (λ input_rflags →
    let k'53 : Unit → MS Unit
        k'53 =
          λ t'6 →
            let k'50 : Unit → MS Unit
                k'50 =
                  λ t'11 →
                    let k'47 : Unit → MS Unit
