                                                             the (MS Unit)
                                                               (bindS {Unit} {Unit} log_rflags_write (λ t'33 →
                                                                  k'35 t'33)) σ
                                                           else
                                                             the (MS Unit)
                                                               (k'35 unit) σ)
                                            in λ σ →
                                                 if (weq (rflagsbits-of undefined_mask) #1) then
                                                   the (MS Unit)
                                                     (bindS {rflagsbits} {Unit} (getS {rflagsbits} x86-rflags) (λ rflags_var →
                                                        let sailval : Bits #1
                                                            sailval = undef_flg
                                                            new_rflags : rflagsbits
                                                            new_rflags = (rflagsbits-set-of rflags_var sailval)
                                                        in bindS {Unit} {Unit} (putS (x86-set-rflags new_rflags)) (λ _ →
                                                             k'38 unit))) σ
                                                 else
                                                   the (MS Unit)
                                                     (bindS {rflagsbits} {Unit} (getS {rflagsbits} x86-rflags) (λ rflags_var →
                                                        let new_rflags : rflagsbits
                                                            new_rflags = (rflagsbits-set-of rflags_var (rflagsbits-of user_flags_vector))
                                                        in bindS {Unit} {Unit} (putS (x86-set-rflags new_rflags)) (λ _ →
                                                             k'38 unit))) σ
                                    in λ σ →
                                         if (weq (rflagsbits-sf undefined_mask) #1) then
                                           the (MS Unit)
                                             (bindS {rflagsbits} {Unit} (getS {rflagsbits} x86-rflags) (λ rflags_var →
