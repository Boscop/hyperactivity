                                         else
                                           the (MS Unit)
                                             (bindS {rflagsbits} {Unit} (getS {rflagsbits} x86-rflags) (λ rflags_var →
                                                let new_rflags : rflagsbits
                                                    new_rflags = (rflagsbits-set-sf rflags_var (rflagsbits-sf user_flags_vector))
                                                in bindS {Unit} {Unit} (putS (x86-set-rflags new_rflags)) (λ _ →
                                                     k'41 unit))) σ
                            in λ σ →
                                 if (weq (rflagsbits-zf undefined_mask) #1) then
