                                     (bindS {rflagsbits} {Unit} (getS {rflagsbits} x86-rflags) (λ rflags_var →
                                        let new_rflags : rflagsbits
                                            new_rflags = (rflagsbits-set-zf rflags_var (rflagsbits-zf user_flags_vector))
                                        in bindS {Unit} {Unit} (putS (x86-set-rflags new_rflags)) (λ _ →
                                             k'44 unit))) σ
                    in λ σ →
                         if (weq (rflagsbits-af undefined_mask) #1) then
                           the (MS Unit)
                             (bindS {rflagsbits} {Unit} (getS {rflagsbits} x86-rflags) (λ rflags_var →
                                let sailval : Bits #1
                                    sailval = undef_flg
                                    new_rflags : rflagsbits
                                    new_rflags = (rflagsbits-set-af rflags_var sailval)
                                in bindS {Unit} {Unit} (putS (x86-set-rflags new_rflags)) (λ _ →
