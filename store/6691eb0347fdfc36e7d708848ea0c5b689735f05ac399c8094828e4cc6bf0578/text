-- Exact reversible symplectic 1-node Verlet step (undamped):
--   F(q) = k * q  (or nonlinear k * q + alpha * q^3)
--   p1 = p0 - F(q0),   q1 = q0 + p1
verlet-fwd : Word → Word → Word × Word → Word × Word
verlet-fwd k alpha qp =
  let q0 = fst qp
      p0 = snd qp
      q2 = s32-mul16 q0 q0
      q3 = s32-mul16 q2 q0
      f  = w32-add (s32-mul16 k q0) (s32-mul16 alpha q3)
      p1 = w32-sub p0 f
      q1 = w32-add q0 p1
  in (q1 , p1)
