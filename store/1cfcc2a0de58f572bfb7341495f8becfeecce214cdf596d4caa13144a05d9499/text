-- Read configured Supergenius model strictly when GEMINI_API_KEY is present in process env
this-check-env-args : List (List Word)
this-check-env-args =
  cons "/bin/sh" (cons "-c" (cons (h-concat (cons "test -n " (cons this-q (cons "$GEMINI_API_KEY" (cons this-q (cons " && printf '%s' " (cons this-q (cons "${HX_GEMINI_MODEL:-gemini-4-neon}" (cons this-q nil))))))))) nil))
