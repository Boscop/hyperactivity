-- Off-shell anomaly freedom on spatially diffeomorphism-invariant states:
-- Given a state space Ψ with zero state z, diffeomorphism action D(v, ψ), and Hamiltonian
-- commutator [H(N), H(M)]ψ = D(shift(N, M), ψ) (Dirac hypersurface-deformation law),
-- ANY diffeomorphism-invariant state (∀ v, D(v, ψ) ≡ z) is annihilated by [H(N), H(M)]
-- for EVERY pair of lapse functions (N, M) without requiring any anomaly cancellation.
lqg-diff-inv-annihilates-commutator :
  (Lapse Shift State : Type 0) →
  (z : State) →
  (D : Shift → State → State) →
  (commH : Lapse → Lapse → State → State) →
  (shift : Lapse → Lapse → Shift) →
  ((N M : Lapse) → (psi : State) → commH N M psi ≡ D (shift N M) psi) →
  (psi : State) →
  ((v : Shift) → D v psi ≡ z) →
  (N M : Lapse) → commH N M psi ≡ z
lqg-diff-inv-annihilates-commutator Lapse Shift State z D commH shift dirac-law psi diff-inv N M =
  concat (dirac-law N M psi) (diff-inv (shift N M))
