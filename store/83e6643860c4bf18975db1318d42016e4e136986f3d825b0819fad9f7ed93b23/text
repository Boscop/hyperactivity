-- Dual-lane parallel showcase trace (reset net):
--   Cycle 0: 5 live nodes:
--     Subgraph A: n0=NUM(17) ⋈ n1=ADD(p1->n2, p2->EXT), n2=NUM(25)
--     Subgraph B: n3=NUM(10) ⋈ n4=DUP(p1->EXT, p2->EXT)
--   Cycle 1 (DUAL FIRE: Lane 0 + Lane 1 simultaneously!):
--     Lane 0: n0(NUM 17) ⋈ n1(ADD) -> n1=ADD1(17) wired to n2=NUM(25), n0=FREE (-1 node)
--     Lane 1: n3(NUM 10) ⋈ n4(DUP) -> n3=NUM(10), n4=NUM(10) (0 net nodes)
--     Result: 4 live nodes, redex_count = 2 (2 reductions in 1 clock cycle!)
--   Cycle 2 (Lane 0):
--     n1(ADD1 17) ⋈ n2(NUM 25) -> n2=NUM(42), n1=FREE (-1 node)
--     Result: 3 live nodes, redex_count = 3, done = 1, val[2] = 42!
inet-v2-trace-redex : Word → Word
inet-v2-trace-redex c =
  if %weq c #0 then #0
  else if %weq c #1 then #2
  else #3
