-- Self-certifying multi-hop lookup: route across arbitrary untrusted peers, verify locally at boundary
dht-lookup : {b : Nat} {N K V : Type} → (K → V → Bool) → Nat → (N → BKey b) → (K → BKey b) → (N → List N) → (N → CAStore K V) → N → K → Sum Unit V
dht-lookup {b} chk fuel nid kid rt stores start k =
  ca-check chk k (dht-walk {b} fuel nid kid rt stores start k)
