-- every rule: the operation and the value that met, and the first unused wire name
k-rule : KOp → KVal → Word → KOut
k-rule (ko-app arg out) (kv-lam b e) n = k-build b (ke-cons arg e) out (k-out fx-nil n)
k-rule (ko-app arg out) (kv-num m) n = k-out (fx-op arg ko-era fx-nil) n
k-rule (ko-app arg out) (kv-ref w) n = k-out (fx-read w (ko-app arg out) fx-nil) n
k-rule (ko-inc out) (kv-lam b e) n = k-out (k-era-env e fx-nil) n
k-rule (ko-inc out) (kv-num m) n = k-out (fx-val out (kv-num (%wsucc m)) fx-nil) n
k-rule (ko-inc out) (kv-ref w) n = k-out (fx-read w (ko-inc out) fx-nil) n
k-rule (ko-dup a b) (kv-lam t ke-nil) n = k-out (fx-val a (kv-lam t ke-nil) (fx-val b (kv-lam t ke-nil) fx-nil)) n
k-rule (ko-dup a b) (kv-lam t (ke-cons w r)) n = k-out (fx-val n (kv-lam t (ke-cons w r)) (fx-val a (kv-ref n) (fx-val b (kv-ref n) fx-nil))) (%wsucc n)
k-rule (ko-dup a b) (kv-num m) n = k-out (fx-val a (kv-num m) (fx-val b (kv-num m) fx-nil)) n
k-rule (ko-dup a b) (kv-ref w) n = k-out (fx-val a (kv-ref w) (fx-val b (kv-ref w) fx-nil)) n
k-rule ko-era (kv-lam b e) n = k-out (k-era-env e fx-nil) n
k-rule ko-era (kv-num m) n = k-out fx-nil n
k-rule ko-era (kv-ref w) n = k-out fx-nil n
k-rule (ko-fwd out) v n = k-out (fx-val out v fx-nil) n
