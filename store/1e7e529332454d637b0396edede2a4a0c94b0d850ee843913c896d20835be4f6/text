nk-psub : Word → NkTm → NkTm → NkTm
nk-psub c ts (nk-var i) =
  if %wlt i c
    then nk-var i
    else let j = %wsub i c
         in if %wlt j (nk-el-len ts) then nk-shift-n c (nk-branch ts j) else nk-var i
nk-psub c ts (nk-lam b) = nk-lam (nk-psub (%wsucc c) ts b)
nk-psub c ts (nk-susp b) = nk-susp (nk-psub c ts b)
nk-psub c ts (nk-con k as) = nk-con k (nk-psub c ts as)
nk-psub c ts (nk-op h p as) = nk-op h (nk-psub c ts p) (nk-psub c ts as)
nk-psub c ts (nk-match h p cs) = nk-match h (nk-psub c ts p) (nk-psub c ts cs)
nk-psub c ts (nk-cons t r) = nk-cons (nk-psub c ts t) (nk-psub c ts r)
nk-psub c ts t = t
