-- the certificate: λ < μ and B(λ) has k negative directions at the four corners
pl-cert : Nat → BQ → BQ → (List (List BQ) × List (List BQ)) × List (List (BQ × (BQ × BQ))) → Bool
pl-cert k mu lam m = if bq-pos (fn-sub mu lam) then (if wt-is k (pl-blk mu lam pl-l0 pl-p0 m) then (if wt-is k (pl-blk mu lam pl-l0 pl-p1 m) then (if wt-is k (pl-blk mu lam pl-l1 pl-p0 m) then wt-is k (pl-blk mu lam pl-l1 pl-p1 m) else false) else false) else false) else false
