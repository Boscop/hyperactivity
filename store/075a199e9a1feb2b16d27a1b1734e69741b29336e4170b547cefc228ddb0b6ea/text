dsp-emit-expr : DspExpr → List Word
dsp-emit-expr d-in = cons #32 (cons #0 nil)
dsp-emit-expr d-sc = cons #32 (cons #1 nil)
dsp-emit-expr d-p1 = cons #32 (cons #2 nil)
dsp-emit-expr d-p2 = cons #32 (cons #3 nil)
dsp-emit-expr d-st = cons #32 (cons #4 nil)
dsp-emit-expr (d-lit b) = cons #67 (dw-le32 b)
dsp-emit-expr (d-add a b) = dw-app (dsp-emit-expr a) (dw-app (dsp-emit-expr b) (cons #146 nil))
dsp-emit-expr (d-sub a b) = dw-app (dsp-emit-expr a) (dw-app (dsp-emit-expr b) (cons #147 nil))
dsp-emit-expr (d-mul a b) = dw-app (dsp-emit-expr a) (dw-app (dsp-emit-expr b) (cons #148 nil))
dsp-emit-expr (d-div a b) = dw-app (dsp-emit-expr a) (dw-app (dsp-emit-expr b) (cons #149 nil))
dsp-emit-expr (d-min a b) = dw-app (dsp-emit-expr a) (dw-app (dsp-emit-expr b) (cons #150 nil))
dsp-emit-expr (d-max a b) = dw-app (dsp-emit-expr a) (dw-app (dsp-emit-expr b) (cons #151 nil))
dsp-emit-expr (d-abs a)   = dw-app (dsp-emit-expr a) (cons #139 nil)
dsp-emit-expr (d-neg a)   = dw-app (dsp-emit-expr a) (cons #140 nil)
