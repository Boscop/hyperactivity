j-esc : List Word → List Word
j-esc nil = nil
j-esc (cons x r) =
  if weq x #34 then cons #92 (cons #34 (j-esc r)) else
  if weq x #92 then cons #92 (cons #92 (j-esc r)) else
  if wlt x #32 then list-append (cons #92 "u00") (cons (j-hex (wshr x #4)) (cons (j-hex (wand x #15)) (j-esc r))) else cons x (j-esc r)
