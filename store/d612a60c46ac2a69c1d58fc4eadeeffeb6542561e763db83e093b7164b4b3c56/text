nk-no-free-ge : Word → NkTm → Bool
nk-no-free-ge n0 (nk-free x) = %wlt x n0
nk-no-free-ge n0 (nk-lam b) = nk-no-free-ge n0 b
nk-no-free-ge n0 (nk-susp b) = nk-no-free-ge n0 b
nk-no-free-ge n0 (nk-con c as) = nk-no-free-ge n0 as
nk-no-free-ge n0 (nk-op h p as) = nk-and (nk-no-free-ge n0 p) (nk-no-free-ge n0 as)
nk-no-free-ge n0 (nk-match h p cs) = nk-and (nk-no-free-ge n0 p) (nk-no-free-ge n0 cs)
nk-no-free-ge n0 (nk-cons t r) = nk-and (nk-no-free-ge n0 t) (nk-no-free-ge n0 r)
nk-no-free-ge n0 t = true
