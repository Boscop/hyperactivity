zr-pmc : (a b : Nat × Nat) → zmul a b ≡ zmul b a
zr-pmc a b = zr-pp (zmul a b) (zmul b a)
  (ring-eq (zr-e (fst a) (snd a) (fst b) (snd b) zero zero) (eadd (emul zx0 zx2) (emul zx1 zx3)) (eadd (emul zx2 zx0) (emul zx3 zx1)) (λ i → norm (eadd (emul zx0 zx2) (emul zx1 zx3))))
  (ring-eq (zr-e (fst a) (snd a) (fst b) (snd b) zero zero) (eadd (emul zx0 zx3) (emul zx1 zx2)) (eadd (emul zx2 zx1) (emul zx3 zx0)) (λ i → norm (eadd (emul zx0 zx3) (emul zx1 zx2))))
