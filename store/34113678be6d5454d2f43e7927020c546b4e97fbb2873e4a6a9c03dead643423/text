-- a page made once for each state of the source (or per module hash) and kept in the store as the
-- response's bytes: the build makes every published page so (s-make-site), and a reader is served the kept
-- bytes; the response is written as it is made and then read back from the file, so it is not held twice
s-site-or : List Word → Proc W (List Word) → Sum Unit (List Word) → Proc W (List Word)
s-site-or f mk (inr r) = ret {lzero} {W} r
s-site-or f mk (inl u) = bind mk (λ r → bind (h-write f r) (λ ok → if ok then bind (h-read f) (λ k → ret {lzero} {W} (s-or nil k)) else mk))
