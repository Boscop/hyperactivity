-- ── 3. Closed Photonic Light-Knots & Constructive Standing-Wave Resonance ────
-- Exact integer GCD (Euclidean algorithm, bounded fuel) for torus-knot coprimality (p, q):
ph-mod : Word → Word → Word
ph-mod a b = if %weq b #0 then #0 else %wsub a (%wmul (%wdiv a b) b)

ph-gcd-step : Nat → Word → Word → Word
ph-gcd-step zero    a _ = a
ph-gcd-step (suc k) a b = if %weq b #0 then a else ph-gcd-step k b (ph-mod a b)

ph-coprime : Word → Word → Bool
ph-coprime p q = %weq (ph-gcd-step (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))) p q) #1

-- A photonic orbit forms a prime single-component torus light-knot T(p, q) iff gcd(p, q) == 1
-- AND optical perimeter is an exact integer multiple of wavelength (constructive interference mod lambda == 0)!
knot-resonant : Word → Word → Word → Word → Bool
knot-resonant p q opt-perim lambda =
  andB (ph-coprime p q) (%weq (ph-mod opt-perim lambda) #0)

