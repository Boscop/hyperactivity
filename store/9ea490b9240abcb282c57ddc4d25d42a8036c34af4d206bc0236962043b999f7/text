-- ── 1. Exact Integer Refractive Media & Total Internal Reflection (Snell's Law)
ph-le : Word → Word → Bool
ph-le a b = if %wlt b a then false else true

-- Refractive index represented as exact rational n = num / den (scaled by 1000):
data Medium = med-mk (name : List Word) (n-num : Word) (n-den : Word)

med-vacuum  : Medium
med-vacuum  = med-mk "vacuum"  #1000 #1000

med-water   : Medium
med-water   = med-mk "water"   #1333 #1000

med-glass   : Medium
med-glass   = med-mk "silica"  #1500 #1000

med-diamond : Medium
med-diamond = med-mk "diamond" #2417 #1000

-- Exact Total Internal Reflection (TIR) condition from high-index medium into vacuum:
-- Given sin^2(theta) = s2_num / 10000 (0..10000), TIR holds iff:
--   s2_num * n_num^2 >= 10000 * n_den^2   (ZERO trig, ZERO float!)
tir-trapped : Medium → Word → Bool
tir-trapped (med-mk _ nn nd) sin2-bps =
  ph-le (%wmul #10000 (%wmul nd nd)) (%wmul sin2-bps (%wmul nn nn))

-- At theta = 30 deg (sin^2(30) = 1/4 = 2500/10000):
--   Diamond (n=2.417, theta_c=24.4 deg): 100% TRAPPED by Total Internal Reflection!
