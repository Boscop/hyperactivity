-- ── 2. Exact Unitary Internal Reflection & Optical Action Conservation ───────
-- Ray state inside diamond orb of radius R: (impact_param_b, bounces, optical_path_len, energy_units).
data PhotonRay = pray (b-param : Word) (bounces : Word) (opt-len : Word) (energy : Word)

-- Exact specular reflection on the smooth sphere boundary:
-- Under TIR, impact parameter b and energy are 100% CONSERVED (unitary!), bounces += 1, opt_len += chord_opt.
ray-reflect : Medium → Word → Word → PhotonRay → PhotonRay
ray-reflect m sin2-bps chord-opt (pray b n opl e) =
  if tir-trapped m sin2-bps
  then pray b (%wadd n #1) (%wadd opl chord-opt) e
  else pray b (%wadd n #1) (%wadd opl chord-opt) (%wdiv e #4)

ray-energy : PhotonRay → Word
ray-energy (pray _ _ _ e) = e

ray-b : PhotonRay → Word
ray-b (pray b _ _ _) = b

ray-seed : PhotonRay
ray-seed = pray #866 #0 #0 #10000

-- After 3 consecutive Total Internal Reflections inside the diamond sphere:
--   Energy is 100% conserved (10000 == 10000, zero dissipation!) & angular momentum b is invariant!
ray-after-3-tir : PhotonRay
ray-after-3-tir =
  ray-reflect med-diamond #7500 #2417
    (ray-reflect med-diamond #7500 #2417
      (ray-reflect med-diamond #7500 #2417 ray-seed))

ph-thm-tir-unitary-energy : ray-energy ray-after-3-tir ≡ ray-energy ray-seed
ph-thm-tir-unitary-energy = refl

ph-thm-tir-impact-conserved : ray-b ray-after-3-tir ≡ ray-b ray-seed
ph-thm-tir-impact-conserved = refl

-- In contrast, a non-TIR leaky reflection loses energy immediately (10000 -> 2500):
