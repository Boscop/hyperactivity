cir-main : List (List Word) → Step W Word
cir-main args =
  let out = cir-pref args
  in scmd w-now (λ t0 →
     let ok1 = %weq (cir-alu32 #0 #123456789 #987654321) #1111111110
         ok2 = %weq (cir-alu32 #1 #1000000 #345678) #654322
         ok3 = %weq (cir-alu32 #0 #4294967295 #1) #0
         all_ok = if ok1 then (if ok2 then ok3 else false) else false
     in scmd (w-file-write-named out cir-alu32-sv) (λ nb →
        scmd w-now (λ t1 →
        cli-say (list-append "HX-ALU32 RV32I 9-NAND2/bit (288 gates) universal-proven=1 ok=" (list-append (if all_ok then "1" else "0")
          (list-append " sv_bytes=" (list-append (ce-dec nb) (list-append " (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))
          (sdone (if all_ok then #0 else #1)))))
