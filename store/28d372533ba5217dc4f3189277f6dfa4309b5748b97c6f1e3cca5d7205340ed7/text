-- nk-do-swap: two plans that write different wires, done in either order, leave memories that read
-- the same at every wire. This is the proof that steps in different places commute, at the level
-- of the memory; it uses nothing about which rules made the plans (part of machine-in-hyperactive)
nk-do-swap : (fx1 fx2 : NkFx) (sl : NkSlots) → nk-aparts fx1 fx2 → nk-same (nk-do fx2 (nk-do fx1 sl)) (nk-do fx1 (nk-do fx2 sl))
nk-do-swap nkf-nil fx2 sl ap x = refl
nk-do-swap (nkf-val w v r) fx2 sl ap x =
  nk-do-swap r fx2 (nk-upd sl w (nk-arrive-val v)) (snd ap) x
  ∙ nk-do-same r (nk-do fx2 (nk-upd sl w (nk-arrive-val v))) (nk-upd (nk-do fx2 sl) w (nk-arrive-val v)) (nk-do-upd fx2 sl w (nk-arrive-val v) (fst ap)) x
nk-do-swap (nkf-op w o r) fx2 sl ap x =
  nk-do-swap r fx2 (nk-upd sl w (nk-arrive-op o)) (snd ap) x
  ∙ nk-do-same r (nk-do fx2 (nk-upd sl w (nk-arrive-op o))) (nk-upd (nk-do fx2 sl) w (nk-arrive-op o)) (nk-do-upd fx2 sl w (nk-arrive-op o) (fst ap)) x
nk-do-swap (nkf-put w s r) fx2 sl ap x =
  nk-do-swap r fx2 (nk-upd sl w (λ s0 → s)) (snd ap) x
  ∙ nk-do-same r (nk-do fx2 (nk-upd sl w (λ s0 → s))) (nk-upd (nk-do fx2 sl) w (λ s0 → s)) (nk-do-upd fx2 sl w (λ s0 → s) (fst ap)) x
