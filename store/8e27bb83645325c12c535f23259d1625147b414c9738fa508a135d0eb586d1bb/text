inv-solve-step : Word → Word → Word → Word
inv-solve-step targetQ alpha k =
  let l0 = inv-loss k alpha targetQ
      lp = inv-loss (%wadd k #40) alpha targetQ
      lm = inv-loss (%wsub k #40) alpha targetQ
  in if andB (%wlt lp l0) (%wlt lp lm) then %wadd k #40
     else if %wlt lm l0 then %wsub k #40
     else k
