gview : {M A : Type} → GNode M A → NView M (GNode M A)
gview {M} {A} p = case p κ0 of
  gret a → v-halt
  gcmd c k → (case c of
                n-send to m → v-send to m (g-force {M} {A} p r-timeout #0)
                n-recv → v-recv (λ r → g-force {M} {A} p r #0)
                n-now → v-now (λ w → g-force {M} {A} p r-timeout w))
  gtau t → v-tau (g-force {M} {A} p r-timeout #0)
