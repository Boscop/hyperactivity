-- CMOS Complementarity Theorem: pull-up (cmos-dual t) conducts iff pull-down (t) is off
-- (proving simultaneously ZERO VDD-to-GND short-circuit contention AND ZERO floating high-Z outputs!)
cmos-complementary : {V : Type} → (env : V → Bool) → (t : Cmos V) →
  pmos-on env (cmos-dual t) ≡ not (nmos-on env t)
cmos-complementary env (cgate v) = refl
cmos-complementary env (cser a b) =
  concat (λ i → b-or2 (cmos-complementary env a i) (cmos-complementary env b i))
    (sym (demorgan-and (nmos-on env a) (nmos-on env b)))
cmos-complementary env (cpar a b) =
  concat (λ i → andB (cmos-complementary env a i) (cmos-complementary env b i))
    (sym (demorgan-or (nmos-on env a) (nmos-on env b)))
