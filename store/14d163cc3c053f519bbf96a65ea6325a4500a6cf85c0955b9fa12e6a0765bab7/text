-- UNIVERSAL F2 LINEARITY OF DOT PRODUCT OVER ALL BIT-VECTORS OF ARBITRARY LENGTH!
ha-thm-dot-linear : (x r1 r2 : List Bool) →
  ha-f2-dot x (ha-f2-add r1 r2) ≡ web-xorB (ha-f2-dot x r1) (ha-f2-dot x r2)
ha-thm-dot-linear nil         _           _           = refl
ha-thm-dot-linear (cons x rx) nil         r2          = web-sym-b (web-lem-xor-0l (ha-f2-dot (cons x rx) r2))
ha-thm-dot-linear (cons x rx) (cons a ra) nil         = web-sym-b (web-lem-xor-0r (ha-f2-dot (cons x rx) (cons a ra)))
ha-thm-dot-linear (cons x rx) (cons a ra) (cons b rb) =
  web-trans-b
    (λ i → web-xorB (web-andB x (web-xorB a b)) (ha-thm-dot-linear rx ra rb i))
    (ha-lem-f2-step x a b (ha-f2-dot rx ra) (ha-f2-dot rx rb))
