lcm-v : (a b S : Nat) → le (times a S) (times b S) → le (suc zero) S → (v : Bool) → cmpN true a b ≡ v → le a b
lcm-v a b S h hs v = case v return λ u → cmpN true a b ≡ u → le a b of
  true → λ e → cmp-true-le a b e
  false → λ e → absurd-sz (le a b) (plus (fst hs) zero)
    (transN (symN (plus-suc (fst hs) zero)) (transN (snd hs) (lcm-zero a b S (fst h) (fst (cmp-false-lt a b e)) (snd h) (snd (cmp-false-lt a b e)))))
