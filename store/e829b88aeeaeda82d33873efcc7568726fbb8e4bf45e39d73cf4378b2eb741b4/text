k-app-ge : {o : Ord} → (k x : El o) → (a r : List (El o)) → leq k x ≡ true → k-last k (list-append a (cons x r)) ≡ k-last k a
k-app-ge k x a r e =
  case a return λ w → k-last k (list-append w (cons x r)) ≡ k-last k w of
    nil → λ i → if e i then inl unit else k-comb x (k-last k r)
    cons y q → λ i → if leq k y then inl unit else k-comb y (rec q i)
