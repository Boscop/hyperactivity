-- ---------------------------------------------------------------- the measure rule at work
-- the client finishes: the writes still to send are a measure that a fair sequence decreases
-- (live-measure; the premise is kvl-client)
kvl-len-lt : (a b u : (List (NodeId × KvWrite))) → (x : NodeId × KvWrite) → Path (List (NodeId × KvWrite)) b u → Path (List (NodeId × KvWrite)) a (cons x u) → nt-len {NodeId × KvWrite} b < nt-len {NodeId × KvWrite} a
kvl-len-lt a b u x eb ea =
  subst {lzero} {lzero} {(List (NodeId × KvWrite))} {λ o → above (nt-len {NodeId × KvWrite} a) (nt-len {NodeId × KvWrite} o)} (sym eb)
     (subst {lzero} {lzero} {(List (NodeId × KvWrite))} {λ o2 → above (nt-len {NodeId × KvWrite} o2) (nt-len {NodeId × KvWrite} u)} (sym ea) (<-suc-self (nt-len {NodeId × KvWrite} u)))
