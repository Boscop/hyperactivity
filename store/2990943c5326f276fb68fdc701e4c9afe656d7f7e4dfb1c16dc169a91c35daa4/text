find-nat-ok-zero : (x y : Word) → (r : List Word) → (k : Nat) →
                   weq x y ≡ true → Path (Opt Nat) (some zero) (some k) →
                   (wlt (fromNat k) (fromNat (suc (list-length r))) ≡ true) × (wnth-nat (cons y r) k ≡ x)
find-nat-ok-zero x y r k eq h =
  let kz : Path Nat zero k
      kz = cm-some-inj {Nat} {zero} {k} h
      kz' : Path Nat k zero
      kz' = λ i → kz (~ i)
      exy : y ≡ x
      exy = symw (cm-weq-sound x y eq)
  in ( cm-catb (cm-congb (λ z → wlt z (fromNat (suc (list-length r)))) (λ i → fromNat (kz' i))) (cm-lt-zero-suc (list-length r))
     , catw (λ i → wnth-nat (cons y r) (kz' i)) exy )
