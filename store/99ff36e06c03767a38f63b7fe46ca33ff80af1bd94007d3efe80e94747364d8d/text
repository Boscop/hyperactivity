kvr-s10 : (a b c x : KvWrite) → InL {KvWrite} x (cons a (cons b (cons c (cons c nil)))) → InL {KvWrite} x (cons a (cons b (cons c nil)))
kvr-s10 a b c x m = case m of
  inl e → inl e
  inr m2 → (case m2 of
    inl e → inr (inl e)
    inr m3 → (case m3 of
      inl e → inr (inr (inl e))
      inr m4 → (case m4 of
        inl e → inr (inr (inl e))
        inr m5 → Empty-rec m5)))
