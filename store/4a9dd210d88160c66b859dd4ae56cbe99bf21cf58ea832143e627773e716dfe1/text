-- Exact cubical linearity of N=2^k FWHT!
fwht-add : (k : Nat) → (u v : HVec k) → fwht k (hvec-add k u v) ≡ hvec-add k (fwht k u) (fwht k v)
fwht-add zero u v = refl
fwht-add (suc k) u v =
  let p0 = fwht-add k (fst u) (fst v)
      p1 = fwht-add k (snd u) (snd v)
      a0 = fwht k (hvec-add k (fst u) (fst v))
      a1 = fwht k (hvec-add k (snd u) (snd v))
      fu0 = fwht k (fst u); fv0 = fwht k (fst v)
      fu1 = fwht k (snd u); fv1 = fwht k (snd v)
      cL = catH k
             (hvec-add k a0 a1)
             (hvec-add k (hvec-add k fu0 fv0) (hvec-add k fu1 fv1))
             (hvec-add k (hvec-add k fu0 fu1) (hvec-add k fv0 fv1))
             (λ i → hvec-add k (p0 i) (p1 i))
             (hvec-add-swap4 k fu0 fv0 fu1 fv1)
      cR = catH k
             (hvec-sub k a0 a1)
             (hvec-sub k (hvec-add k fu0 fv0) (hvec-add k fu1 fv1))
             (hvec-add k (hvec-sub k fu0 fu1) (hvec-sub k fv0 fv1))
             (λ i → hvec-sub k (p0 i) (p1 i))
             (hvec-add-sub-swap4 k fu0 fv0 fu1 fv1)
  in λ i → (cL i , cR i)
