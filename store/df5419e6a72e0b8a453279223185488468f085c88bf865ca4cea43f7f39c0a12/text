bn-bech32-encode : List Word → List Word → List Word
bn-bech32-encode hrp data8 =
  let d5  = bn-bits8-to-5-go (toNat #64) #0 #0 data8
      inp = list-append (bn-hrp-expand hrp) (list-append d5 (bn-zeros (toNat #6)))
      pm  = %wxor (bn-polymod (toNat #128) #1 inp) #1
  in list-append hrp (cons #49 (bn-bech32-map (list-append d5 (bn-polymod-cs6 pm))))
