-- k < k2, k + l = n: more than n vectors in a family of k2 followed by one of l
sy-over : (V : Type) → (xs ys : List V) → (k l n : Nat) → le (suc k) (sy-len V xs) → sy-len V ys ≡ l → plus k l ≡ n → le (suc n) (sy-len V (sy-app V xs ys))
sy-over V xs ys k l n h el e = le-cong-r (suc n) (plus (sy-len V xs) (sy-len V ys)) (sy-len V (sy-app V xs ys))
  (le-cong-l (plus (suc k) (sy-len V ys)) (suc n) (plus (sy-len V xs) (sy-len V ys)) (sy-le-plus (suc k) (sy-len V xs) (sy-len V ys) h)
    (transN (congN (λ x → suc (plus k x)) el) (congN suc e)))
  (symN (sy-len-app V xs ys))
