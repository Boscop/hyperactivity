-- Arbitrary-depth 3-variable Boolean/bitwise cone (`x0`, `x1`, `x2`):
data BoolCone : Type where
  bc-var0 : BoolCone
  bc-var1 : BoolCone
  bc-var2 : BoolCone
  bc-not  : BoolCone → BoolCone
  bc-and  : BoolCone → BoolCone → BoolCone
  bc-or   : BoolCone → BoolCone → BoolCone
  bc-xor  : BoolCone → BoolCone → BoolCone
  bc-nand : BoolCone → BoolCone → BoolCone
  bc-mux  : BoolCone → BoolCone → BoolCone → BoolCone
