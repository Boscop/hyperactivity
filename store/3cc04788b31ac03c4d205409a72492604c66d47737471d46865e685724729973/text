h-post-module : List Word → List Word → List Word → Proc W Bool
h-post-module srv tok mh = if h-eq mh "-" then ret {lzero} {W} true else
  bind (h-read (h-object-path mh "module")) (λ mo → bind (h-post-texts srv tok (h-lines (h-source-or mo))) (λ ok →
  if ok then h-post-object srv tok mh "module" (h-source-or mo) else ret {lzero} {W} false))
