h-publish-all : List Word → List Word → List Word → List Word → List (List Word) → Proc W Bool
h-publish-all st srv tok m nil = ret true
h-publish-all st srv tok m (cons hx r) = bind (h-publish-one st srv tok m (h-unhex hx)) (λ ok →
  bind (h-publish-all st srv tok m r) (λ rest → ret (andB ok rest)))
