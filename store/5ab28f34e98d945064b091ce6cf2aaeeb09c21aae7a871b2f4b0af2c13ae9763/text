nk-uses-con52 : (i : Word) (as : NkTm) →
  (nk-uses-var #0 i (nk-op #0 (nk-bcadr as) (nk-cons (nk-bcar as) nk-nil)) ≡ true) →
  nk-uses-var #0 i as ≡ true
nk-uses-con52 i as hu =
  nk-or-elim (nk-uses-var #0 i (nk-bcadr as)) (nk-uses-var #0 i (nk-cons (nk-bcar as) nk-nil)) hu
    (λ h1 → nk-uses-bcadr i as h1)
    (λ h2 → nk-or-elim (nk-uses-var #0 i (nk-bcar as)) false h2
              (λ h3 → nk-uses-bcar i as h3)
              (λ h4 → nk-no h4))
