-- comparison of canonical numbers, the tie decided by t
bin-leb-from-sound : (a : List Bool) → (t : Bool) → (b : List Bool) → bcanon a ≡ true → bcanon b ≡ true → bin-leb-from t a b ≡ cmpN t (bin-to-nat a) (bin-to-nat b)
bin-leb-from-sound a = case a return λ m → (t : Bool) → (b : List Bool) → bcanon m ≡ true → bcanon b ≡ true → bin-leb-from t m b ≡ cmpN t (bin-to-nat m) (bin-to-nat b) of
  nil → λ t b ca → (case b return λ n → bcanon n ≡ true → bin-leb-from t nil n ≡ cmpN t zero (bin-to-nat n) of
    nil → λ cb → λ i → t
    cons y ys → λ cb → symB (zero-lt-canon t ys y cb))
  cons x xs → λ t b ca → (case b return λ n → bcanon n ≡ true → bin-leb-from t (cons x xs) n ≡ cmpN t (bin-to-nat (cons x xs)) (bin-to-nat n) of
    nil → λ cb → symB (gt-zero-canon t xs x ca)
    cons y ys → λ cb → transB (rec xs (if bit-eq x y then t else y) ys (canon-tail x xs ca) (canon-tail y ys cb))
      (symB (cmp-sub t (cmpN (if bit-eq x y then t else y) (bin-to-nat xs) (bin-to-nat ys)) (bin-to-nat (cons x xs)) (bin-to-nat (cons y ys))
        (plus (bitn x) (times 2 (bin-to-nat xs))) (plus (bitn y) (times 2 (bin-to-nat ys))) (cons-val x xs) (cons-val y ys) (cmp-double t x y (bin-to-nat xs) (bin-to-nat ys)))))
