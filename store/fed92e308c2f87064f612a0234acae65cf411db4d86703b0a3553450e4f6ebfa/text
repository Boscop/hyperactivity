-- ---------------------------------------------------------------- 7. Whole-program C11 arena monotonicity (cs-eval-mono)
-- Kripke bump-arena extension preorder: every previously allocated block and slot in hp1 keeps its
-- exact value in hp2 (blocks in emit-c.cub's arena are never freed or mutated after initialization)
cs-heap-ext : CsHeap → CsHeap → Type
cs-heap-ext hp1 hp2 =
  (addr idx : Nat) (v : CsVal) →
  (cs-load hp1 (csv-ptr addr) idx ≡ some v) →
  cs-load hp2 (csv-ptr addr) idx ≡ some v
