-- a wire that is none of a plan's set, value or operation wires is apart from the plan
nk-apart-of-offs : (fx : NkFx) (u : Word) → nk-off u (nk-puts fx) → nk-off u (nk-vals fx) → nk-off u (nk-ops fx) → nk-apart u fx
nk-apart-of-offs nkf-nil u hp hv ho = unit
nk-apart-of-offs (nkf-val k v r) u hp hv ho = (fst (fst hv) , (snd (fst hv) , nk-apart-of-offs r u hp (snd hv) ho))
nk-apart-of-offs (nkf-op k o r) u hp hv ho = (fst (fst ho) , (snd (fst ho) , nk-apart-of-offs r u hp hv (snd ho)))
nk-apart-of-offs (nkf-put k s r) u hp hv ho = (fst (fst hp) , (snd (fst hp) , nk-apart-of-offs r u (snd hp) hv ho))
