-- ============================================================================
-- 3. Metamorphic Folds & Coupled Basin Merging (from chem/basin-compose.cub)
-- ============================================================================
-- Any flow-invariant observable on a metamorphic protein factors uniquely through its
-- condition-indexed basin quotient `meta-basin E C M e w`.
fold-meta-observable-factors :
  (E C O : Type 0) → (M : MetaFold E C) → (e : E) → (w : Nat) →
  (f : C → O) →
  ((a b : C) → isTrue (fst (snd (M e)) w a b) → f a ≡ f b) →
  meta-basin E C M e w → O
fold-meta-observable-factors E C O M e w f inv = basin-rec f inv
