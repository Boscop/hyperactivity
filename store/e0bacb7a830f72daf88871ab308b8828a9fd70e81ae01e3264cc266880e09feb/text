ho-lop3-ins : Word → Word → Word → Word → Word → List Word
ho-lop3-ins dst a b c imm =
  h-concat
    (cons "  lop3.b32 %r" (cons (h-decimal dst)
    (cons ", %r" (cons (h-decimal a)
    (cons ", %r" (cons (h-decimal b)
    (cons ", %r" (cons (h-decimal c)
    (cons ", " (cons (h-decimal imm) (cons ";" (cons bn-nl nil))))))))))))
