-- halving b + 2A gives A with low bit b
half-of : (b : Bool) → (A : Nat) → hp (plus (bitn b) (times 2 A)) ≡ (A , b)
half-of b A = case A return λ m → hp (plus (bitn b) (times 2 m)) ≡ (m , b) of
  zero → hp-zero b
  suc a → transNB (hp-gen (plus (bitn b) (times 2 (suc a))) (plus (bitn b) (times 2 a)) (dbl-suc b a)) (transNB (λ i → hp-step (hp-step (rec a i))) (hp2 a b))
