-- the graph's problems kept: views/problems, each problem a line (none when the graph keeps every
-- rule), and views/check, the problems and the summary
v-keep-check : List Word → List (List Word) → Proc W Bool
v-keep-check st ps = bind (h-write (list-append st "/views/problems") (v-lines ps)) (λ b →
  h-write (list-append st "/views/check") (list-append (v-lines ps) (v-summary ps)))
