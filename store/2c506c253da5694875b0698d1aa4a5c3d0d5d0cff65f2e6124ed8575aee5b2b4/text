cs-compile-closed-sound : (k : Nat) (fns : CsFns) (ars : Lst (Word × Word))
  (hp : CsHeap) (cenv : CsEnv) (c : Code) (mv : CsMVal) →
  (cs-code-eval k lnil c ≡ csom-some mv) →
  cs-res-rel mv (cs-eval k fns hp cenv (cs-compile k ars #0 c)) ≡ true
cs-compile-closed-sound k fns ars hp cenv c mv hev =
  cs-compile-sound k fns ars lnil hp cenv c mv (cs-env-rel-nil hp cenv) hev
