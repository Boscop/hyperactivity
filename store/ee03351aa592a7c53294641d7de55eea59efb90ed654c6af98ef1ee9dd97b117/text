c-after-one : (n : Nat) → Bytes n → (k : Nat) → Bytes k → Word → Word → Word → List Word × Word → Proc W (Word × List (List Word))
c-after-one n p k f m e q x = if weq (snd x) e then bind (c-text (fst x)) (λ t → c-after-rt n p k f m e (fst x) t (m-occ n p k f m e q t))
  else ret {lzero} {W} (#0 , nil)
