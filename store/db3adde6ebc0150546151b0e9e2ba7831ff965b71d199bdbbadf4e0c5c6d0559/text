s-text : List Word → Proc W (List Word)
s-text q =
  let p = h-unhex (s-param "path" q) in
  bind (h-source-text p) (λ t →
  case t of
    inr txt → ret {lzero} {W} (s-response "text/plain" txt)
    inl u →
      if h-null (s-alt-ext p) then ret {lzero} {W} (s-text-of (inl unit))
      else bind (h-source-text (s-alt-ext p)) (λ t2 → ret {lzero} {W} (s-text-of t2)))
