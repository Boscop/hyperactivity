-- UNIVERSAL F2 XOR-GAUSSIAN ELIMINATION SOLUTION-SET INVARIANCE THEOREM!
ha-thm-gauss-row-sound : (x r1 r2 : List Bool) → (rhs1 rhs2 : Bool) →
  ha-f2-dot x r1 ≡ rhs1 → ha-f2-dot x r2 ≡ rhs2 →
  ha-f2-dot x (ha-f2-add r1 r2) ≡ web-xorB rhs1 rhs2
ha-thm-gauss-row-sound x r1 r2 rhs1 rhs2 h1 h2 =
  web-trans-b (ha-thm-dot-linear x r1 r2) (λ i → web-xorB (h1 i) (h2 i))
