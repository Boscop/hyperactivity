-- nk-plan-wf: for every memory sl and wire u, nk-plan-fx sl u n satisfies nk-step-fx-wf and advances n monotonically
nk-plan-wf : (sl : NkSlots) (u n : NkW) →
  nk-and (nk-wire-le n (nk-n (nk-plan (nk-get sl u) u n sl)))
         (nk-step-fx-wf u (nk-slot-ins (nk-get sl u)) (nk-slot-outs (nk-get sl u)) n (nk-n (nk-plan (nk-get sl u) u n sl)) (nk-plan-fx sl u n)) ≡ true
nk-plan-wf sl u n = nk-plan-slot-wf (nk-get sl u) u n sl
