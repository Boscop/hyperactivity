-- wrap any standalone HTML document with Hyperactivity's single canonical head & navbar
s-chrome-html : List Word → List Word → List Word
s-chrome-html title doc =
  s-inject-nav (
    if h-infix "</head>" doc then
      h-concat (cons (h-before "</head>" doc) (cons (s-head-chrome title) (cons "</head>" (cons (h-after "</head>" doc) nil))))
    else doc
  )
