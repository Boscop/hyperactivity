-- the measured shifts, in hundredths of a ppm: the methyl at 2.36 ppm, the near ring hydrogens at 7.17,
-- the far position at 7.17 as well, and the middle pair at 7.25
num-tol-shift : Nat → Nat
num-tol-shift x = case eqb x 2 of
  true → 236
  false → (case eqb x 3 of true → 236; false → (case eqb x 4 of true → 236; false → (case eqb x 10 of true → 725; false → (case eqb x 12 of true → 725; false → 717))))
