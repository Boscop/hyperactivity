shift : (f : List (List Word) → Word) → (h : Nat) → (t : List (List Word)) →
        zippad (list-map f (sufs t)) (list-map f (sufs (drop-n h t))) ≡ list-map (dkey f h) (sufs t)
shift f h t =
  case t return λ w → zippad (list-map f (sufs w)) (list-map f (sufs (drop-n h w))) ≡ list-map (dkey f h) (sufs w) of
    nil → λ i → nil
    cons x r → λ i → cons (f (cons x r) , head-sufs f (drop-n h (cons x r)) i) (shift-tail f h x r (rec r) i)
