-- Exact Q16 Brickwall Mastering Limiter (guaranteed |y| <= ceil for all inputs)
limiter-q16 : Word → Word → Word
limiter-q16 ceil x =
  let u = w32 x
      neg = %wlt #2147483647 u
      mag = if neg then s32-neg u else u
      cl  = if %wlt ceil mag then ceil else mag
  in if neg then s32-neg cl else cl
