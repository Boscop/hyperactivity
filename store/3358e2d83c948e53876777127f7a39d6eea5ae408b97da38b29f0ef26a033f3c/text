-- ---------------------------------------------------------------- the recorded run as a replay
-- the fleet as a process over EnvS, run against the recorded choices (lib/proc.cub's feed-world
-- answers each request with the next), ends done with the state fleet-run computes and the
-- record used up: the run is a function of the record
nt-len : {A : Type} → List A → Nat
nt-len l = case l of nil → zero; cons x r → suc (rec r)
