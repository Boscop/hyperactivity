tri-bools : (s t : Bool) → bool-eq s t ≡ false → andB (not s) t ≡ false → (s ≡ true) × (t ≡ false)
tri-bools true true e a = false-true ((true ≡ true) × (true ≡ false)) (sym e)
tri-bools true false e a = ((λ i → true) , (λ i → false))
tri-bools false true e a = false-true ((false ≡ true) × (true ≡ false)) (sym a)
tri-bools false false e a = false-true ((false ≡ true) × (false ≡ false)) (sym e)
