-- ---------------------------------------------------------------- 1. Structured C11 subset AST & exact byte-printer equivalence
data CsExp
  = cs-bad
  | cs-var (vid : Word)
  | cs-ull (lit : Word)
  | cs-add1 (a : CsExp)
  | cs-bop (op : Word) (a : CsExp) (b : CsExp)
  | cs-let (vid : Word) (t : CsExp) (b : CsExp)
  | cs-call (fn : Word) (args : CsExp)
  | cs-clo (fn : Word) (ar : Word) (n : Word) (args : CsExp)
  | cs-app (f : CsExp) (a : CsExp)
  | cs-pair (a : CsExp) (b : CsExp)
  | cs-fst (p : CsExp)
  | cs-snd (p : CsExp)
  | cs-con (tag : Word) (nf : Word) (args : CsExp)
  | cs-switch (d : Word) (scrut : CsExp) (brs : CsExp)
  | cs-for (d : Word) (bound : CsExp) (init : CsExp) (step : CsExp)
  | cs-args-nil
  | cs-fargs (hd : CsExp) (tl : CsExp)
  | cs-cargs (hd : CsExp) (tl : CsExp)
  | cs-br-nil
  | cs-br-cons (tag : Word) (d : Word) (nf : Word) (body : CsExp) (rest : CsExp)
