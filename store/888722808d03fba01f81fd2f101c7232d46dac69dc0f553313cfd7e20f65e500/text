hg-metal-src : List Word
hg-metal-src =
  hg-line "#include <metal_stdlib>"
  (hg-line "#include <metal_simdgroup_matrix>"
  (hg-line "using namespace metal;"
  (hg-line ""
  (hg-line "struct GemmDims { uint M; uint N; uint K; };"
  (hg-line "struct AttnDims { uint N; uint D; float scale; };"
  (hg-line ""
  (hg-line "kernel void hx_gemm_simd16("
  (hg-line "    device const half* A [[buffer(0)]],"
  (hg-line "    device const half* B [[buffer(1)]],"
  (hg-line "    device float* C [[buffer(2)]],"
  (hg-line "    constant GemmDims& dm [[buffer(3)]],"
  (hg-line "    uint2 tgid [[threadgroup_position_in_grid]],"
  (hg-line "    uint sgid [[simdgroup_index_in_threadgroup]],"
  (hg-line "    uint tid [[thread_index_in_threadgroup]]) {"
  (hg-line "  threadgroup half As[32][32];"
  (hg-line "  threadgroup half Bs[32][32];"
  (hg-line "  uint bm = tgid.y * 32, bn = tgid.x * 32;"
  (hg-line "  uint sgr = (sgid >> 1) * 16, sgc = (sgid & 1) * 16;"
  (hg-line "  simdgroup_float8x8 acc00 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);"
  (hg-line "  simdgroup_float8x8 acc01 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);"
  (hg-line "  simdgroup_float8x8 acc10 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);"
  (hg-line "  simdgroup_float8x8 acc11 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);"
  (hg-line "  for (uint bk = 0; bk < dm.K; bk += 32) {"
  (hg-line "    for (uint e = tid; e < 1024; e += 128) {"
  (hg-line "      uint r = e >> 5, c = e & 31;"
  (hg-line "      As[r][c] = A[(bm + r) * dm.K + (bk + c)];"
  (hg-line "      Bs[r][c] = B[(bk + r) * dm.N + (bn + c)];"
  (hg-line "    }"
  (hg-line "    threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hg-line "    for (uint k = 0; k < 32; k += 8) {"
  (hg-line "      simdgroup_half8x8 a0, a1, b0, b1;"
  (hg-line "      simdgroup_load(a0, &As[sgr][k], 32); simdgroup_load(a1, &As[sgr + 8][k], 32);"
  (hg-line "      simdgroup_load(b0, &Bs[k][sgc], 32); simdgroup_load(b1, &Bs[k][sgc + 8], 32);"
  (hg-line "      simdgroup_multiply_accumulate(acc00, a0, b0, acc00);"
  (hg-line "      simdgroup_multiply_accumulate(acc01, a0, b1, acc01);"
  (hg-line "      simdgroup_multiply_accumulate(acc10, a1, b0, acc10);"
  (hg-line "      simdgroup_multiply_accumulate(acc11, a1, b1, acc11);"
  (hg-line "    }"
  (hg-line "    threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hg-line "  }"
  (hg-line "  simdgroup_store(acc00, &C[(bm + sgr) * dm.N + (bn + sgc)], dm.N);"
  (hg-line "  simdgroup_store(acc01, &C[(bm + sgr) * dm.N + (bn + sgc + 8)], dm.N);"
  (hg-line "  simdgroup_store(acc10, &C[(bm + sgr + 8) * dm.N + (bn + sgc)], dm.N);"
  (hg-line "  simdgroup_store(acc11, &C[(bm + sgr + 8) * dm.N + (bn + sgc + 8)], dm.N);"
  (hg-line "}"
  (hg-line ""
  (hg-line "// Hardware simdgroup_half8x8 FlashAttention-2 (32x64 Q tile, 32x64 K/V tiles, QK^T and PV on matrix units!)"
  (hg-line "kernel void hx_flash_attn_simd16("
  (hg-line "    device const half* Q [[buffer(0)]],"
  (hg-line "    device const half* Kt [[buffer(1)]],"
  (hg-line "    device const half* V [[buffer(2)]],"
  (hg-line "    device float* O [[buffer(3)]],"
  (hg-line "    constant AttnDims& ad [[buffer(4)]],"
  (hg-line "    uint tgid [[threadgroup_position_in_grid]],"
  (hg-line "    uint sgid [[simdgroup_index_in_threadgroup]],"
  (hg-line "    uint lane [[thread_index_in_simdgroup]],"
  (hg-line "    uint tid [[thread_index_in_threadgroup]]) {"
  (hg-line "  threadgroup half Qs[32][64];"
  (hg-line "  threadgroup half Kts[64][32];"
  (hg-line "  threadgroup half Vs[32][64];"
  (hg-line "  threadgroup float St[32][32];"
  (hg-line "  threadgroup half Pt[32][32];"
  (hg-line "  threadgroup float Ot[32][64];"
  (hg-line "  threadgroup float rm[32];"
  (hg-line "  threadgroup float rl[32];"
  (hg-line "  threadgroup float ralpha[32];"
  (hg-line "  uint qbase = tgid * 32;"
  (hg-line "  for (uint e = tid; e < 2048; e += 128) {"
  (hg-line "    uint r = e >> 6, c = e & 63;"
  (hg-line "    Qs[r][c] = Q[(qbase + r) * 64 + c];"
  (hg-line "    Ot[r][c] = 0.0f;"
  (hg-line "  }"
  (hg-line "  if (tid < 32) { rm[tid] = -1e30f; rl[tid] = 0.0f; }"
  (hg-line "  threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hg-line "  uint qrow = sgid * 8;"
  (hg-line "  for (uint kv = 0; kv < ad.N; kv += 32) {"
  (hg-line "    for (uint e = tid; e < 2048; e += 128) {"
  (hg-line "      uint r = e >> 6, c = e & 63;"
  (hg-line "      Vs[r][c] = V[(kv + r) * 64 + c];"
  (hg-line "      Kts[c][r] = Kt[(kv + r) * 64 + c];"
  (hg-line "    }"
  (hg-line "    threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hg-line "    simdgroup_float8x8 s0 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);"
  (hg-line "    simdgroup_float8x8 s1 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);"
  (hg-line "    simdgroup_float8x8 s2 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);"
  (hg-line "    simdgroup_float8x8 s3 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);"
  (hg-line "    for (uint k = 0; k < 64; k += 8) {"
  (hg-line "      simdgroup_half8x8 qm, k0, k1, k2, k3;"
  (hg-line "      simdgroup_load(qm, &Qs[qrow][k], 64);"
  (hg-line "      simdgroup_load(k0, &Kts[k][0], 32); simdgroup_load(k1, &Kts[k][8], 32);"
  (hg-line "      simdgroup_load(k2, &Kts[k][16], 32); simdgroup_load(k3, &Kts[k][24], 32);"
  (hg-line "      simdgroup_multiply_accumulate(s0, qm, k0, s0);"
  (hg-line "      simdgroup_multiply_accumulate(s1, qm, k1, s1);"
  (hg-line "      simdgroup_multiply_accumulate(s2, qm, k2, s2);"
  (hg-line "      simdgroup_multiply_accumulate(s3, qm, k3, s3);"
  (hg-line "    }"
  (hg-line "    simdgroup_store(s0, &St[qrow][0], 32); simdgroup_store(s1, &St[qrow][8], 32);"
  (hg-line "    simdgroup_store(s2, &St[qrow][16], 32); simdgroup_store(s3, &St[qrow][24], 32);"
  (hg-line "    threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hg-line "    if (tid < 32) {"
  (hg-line "      float m = rm[tid], l = rl[tid], mx = m;"
  (hg-line "      for (uint j = 0; j < 32; j++) { float v = St[tid][j] * ad.scale; St[tid][j] = v; if (v > mx) mx = v; }"
  (hg-line "      float alpha = exp(m - mx), sum = 0.0f;"
  (hg-line "      for (uint j = 0; j < 32; j++) { float p = exp(St[tid][j] - mx); Pt[tid][j] = half(p); sum += p; }"
  (hg-line "      rl[tid] = l * alpha + sum; rm[tid] = mx; ralpha[tid] = alpha;"
  (hg-line "    }"
  (hg-line "    threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hg-line "    for (uint e = tid; e < 2048; e += 128) { uint r = e >> 6, c = e & 63; Ot[r][c] *= ralpha[r]; }"
  (hg-line "    threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hg-line "    for (uint col = 0; col < 64; col += 16) {"
  (hg-line "      simdgroup_float8x8 o0, o1;"
  (hg-line "      simdgroup_load(o0, &Ot[qrow][col], 64); simdgroup_load(o1, &Ot[qrow][col + 8], 64);"
  (hg-line "      for (uint k = 0; k < 32; k += 8) {"
  (hg-line "        simdgroup_half8x8 pm, v0, v1;"
  (hg-line "        simdgroup_load(pm, &Pt[qrow][k], 32);"
  (hg-line "        simdgroup_load(v0, &Vs[k][col], 64); simdgroup_load(v1, &Vs[k][col + 8], 64);"
  (hg-line "        simdgroup_multiply_accumulate(o0, pm, v0, o0);"
  (hg-line "        simdgroup_multiply_accumulate(o1, pm, v1, o1);"
  (hg-line "      }"
  (hg-line "      simdgroup_store(o0, &Ot[qrow][col], 64); simdgroup_store(o1, &Ot[qrow][col + 8], 64);"
  (hg-line "    }"
  (hg-line "    threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hg-line "  }"
  (hg-line "  for (uint e = tid; e < 2048; e += 128) {"
  (hg-line "    uint r = e >> 6, c = e & 63;"
  (hg-line "    O[(qbase + r) * 64 + c] = Ot[r][c] / rl[r];"
  (hg-line "  }"
  (hg-line "}" nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
