logo-hopf-body : List Word → List Word → Nat → Word → SInt → SInt → SInt → SInt → List Word
logo-hopf-body bgCol fgCol nNat nW cEta sEta baseW ko2 =
  let raw = hopf-all-arcs nNat nW #0 cEta sEta
      initBx = hbox (sp #999999) (sn #999999) (sp #999999) (sn #999999)
      bx = hbox-arcs raw initBx
      cx = case bx of hbox minX maxX _ _ → si-div-w (si-add minX maxX) #2
      cy = case bx of hbox _ _ minY maxY → si-div-w (si-add minY maxY) #2
      spanX = case bx of hbox minX maxX _ _ → si-sub maxX minX
      spanY = case bx of hbox _ _ minY maxY → si-sub maxY minY
      maxSpan = si-max (sp #1) (si-max spanX spanY)
      sorted = harc-sort raw
  in hopf-render-arcs bgCol fgCol cx cy maxSpan baseW ko2 sorted
