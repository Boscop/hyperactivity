dm-get32-be : List Word → Word × List Word
dm-get32-be xs =
  let b0 = dm-hd-w xs
      r0 = dm-tl-w xs
      b1 = dm-hd-w r0
      r1 = dm-tl-w r0
      b2 = dm-hd-w r1
      r2 = dm-tl-w r1
      b3 = dm-hd-w r2
      r3 = dm-tl-w r2
  in (%wor (%wshl (%wand b0 #255) #24)
     (%wor (%wshl (%wand b1 #255) #16)
     (%wor (%wshl (%wand b2 #255) #8)
           (%wand b3 #255))) , r3)
