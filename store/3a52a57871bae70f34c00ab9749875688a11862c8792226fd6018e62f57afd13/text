nsup-drop : (c : Conj) (f : DNF) → every-c (λ e → not (conj-sub c e)) f ≡ true → dnf-drop-sup c f ≡ f
nsup-drop c lnil h = λ i → lnil
nsup-drop c (lcons d ds) h =
  pcat0 DNF (dnf-drop-sup c (lcons d ds)) (lcons d (dnf-drop-sup c ds)) (lcons d ds)
    (λ i → if not-true (conj-sub c d) (andB-l (not (conj-sub c d)) (every-c (λ e → not (conj-sub c e)) ds) h) i then dnf-drop-sup c ds else lcons d (dnf-drop-sup c ds))
    (λ i → lcons d (nsup-drop c ds (andB-r (not (conj-sub c d)) (every-c (λ e → not (conj-sub c e)) ds) h) i))
