-- Hardware-total unsigned & signed 64-bit quotient and remainder on ARM64:
--   UDIV x2, x0, x1 gives 0 when x1 == 0; MSUB x0, x2, x1, x0 gives x0 - 0*0 = x0 when x1 == 0!
--   SDIV x2, x0, x1 gives 0 when x1 == 0 and INT64_MIN on INT64_MIN / -1; MSUB gives 0 on INT64_MIN % -1!
a64-umod : Lst Word
a64-umod = l-app (a64-udiv #2 #0 #1) (a64-msub #0 #2 #1 #0)
