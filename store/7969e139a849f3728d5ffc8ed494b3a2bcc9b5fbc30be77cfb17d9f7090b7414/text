tE : {X Y : Type} (P : X ≡ Y) → PathP (λ i → Equiv (P i) Y) (pE P) (idEquiv {lzero} {Y})
tE P = λ i →
  ( λ x → comp (λ j → P (i \/ j)) (λ j → [ i = 1 ↦ x ]) x
  , comp (λ k → isEquiv (λ (x : P i) → comp (λ j → P (i \/ (k /\ j))) (λ j → [ i = 1 ↦ x , k = 0 ↦ x ]) x))
      (λ k → [ i = 1 ↦ snd (idEquiv {lzero} {Y}) ]) (snd (idEquiv {lzero} {P i})) )
