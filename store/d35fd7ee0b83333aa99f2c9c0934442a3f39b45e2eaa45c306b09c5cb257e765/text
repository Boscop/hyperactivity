data RTerm = rterm (ru : Word) (rv : Word) (rw : Word)

rf-len : List RTerm → Word
rf-len nil = #0
rf-len (cons _ xs) = %wsucc (rf-len xs)

rf-bit : Word → Word → Bool
rf-bit mask idx = %weq (%wand (%wshr mask idx) #1) #1

-- Exact F_2 bilinear evaluation of scheme S at input basis pair (a, b)
rf-eval-ab : Word → Word → List RTerm → Word
rf-eval-ab _ _ nil = #0
rf-eval-ab a b (cons (rterm u v w) rest) =
  let tail = rf-eval-ab a b rest
  in if andB (rf-bit u a) (rf-bit v b) then %wxor w tail else tail

-- Exact expected output mask for <m, k, n> matrix multiplication at (a, b)
rf-exp-ab : Word → Word → Word → Word → Word
rf-exp-ab k n a b =
  let ai = %wdiv a k
      aj = %wmod a k
      bj = %wdiv b n
      bl = %wmod b n
  in if %weq aj bj then %wshl #1 (%wadd (%wmul ai n) bl) else #0

rf-verify-b : Nat → Word → Word → Word → Word → List RTerm → Bool
rf-verify-b zero    _ _ _ _ _ = true
rf-verify-b (suc r) k n a b s =
  if %weq (rf-eval-ab a b s) (rf-exp-ab k n a b)
  then rf-verify-b r k n a (%wsucc b) s
  else false

rf-verify-a : Nat → Word → Word → Word → Word → List RTerm → Bool
rf-verify-a zero    _ _ _  _ _ = true
rf-verify-a (suc r) k n bn a s =
  if rf-verify-b (toNat bn) k n a #0 s
  then rf-verify-a r k n bn (%wsucc a) s
  else false

-- Exact algebraic verifier for ANY <m, k, n> bilinear tensor over F_2 (0 approximations!)
rf-verify : Word → Word → Word → List RTerm → Bool
rf-verify m k n s = rf-verify-a (toNat (%wmul m k)) k n (%wmul k n) #0 s

-- Pure .hypercubical canonical schoolbook generator for <m, k, n>
rf-sb-l : Nat → Word → Word → Word → Word → Word → Word → List RTerm → List RTerm
rf-sb-l zero    _ _ _ _ _ _ acc = acc
rf-sb-l (suc r) k n i j l _ acc =
  let u = %wshl #1 (%wadd (%wmul i k) j)
      v = %wshl #1 (%wadd (%wmul j n) l)
      w = %wshl #1 (%wadd (%wmul i n) l)
  in rf-sb-l r k n i j (%wsucc l) #0 (cons (rterm u v w) acc)

rf-sb-j : Nat → Word → Word → Word → Word → List RTerm → List RTerm
rf-sb-j zero    _ _ _ _ acc = acc
rf-sb-j (suc r) k n i j acc =
  rf-sb-j r k n i (%wsucc j) (rf-sb-l (toNat n) k n i j #0 #0 acc)

rf-sb-i : Nat → Word → Word → Word → List RTerm → List RTerm
rf-sb-i zero    _ _ _ acc = acc
rf-sb-i (suc r) k n i acc =
  rf-sb-i r k n (%wsucc i) (rf-sb-j (toNat k) k n i #0 acc)

rf-schoolbook : Word → Word → Word → List RTerm
rf-schoolbook m k n = rf-sb-i (toNat m) k n #0 nil

-- Pure .hypercubical exact pair-merge / zero-elimination rank collapse
rf-drop-zeros : List RTerm → List RTerm
rf-drop-zeros nil = nil
rf-drop-zeros (cons (rterm u v w) xs) =
  if orB (%weq u #0) (orB (%weq v #0) (%weq w #0))
  then rf-drop-zeros xs
  else cons (rterm u v w) (rf-drop-zeros xs)

rf-merge-one : RTerm → List RTerm → Sum (List RTerm) (List RTerm)
rf-merge-one t nil = inl (cons t nil)
rf-merge-one (rterm u1 v1 w1) (cons (rterm u2 v2 w2) xs) =
  if andB (%weq u1 u2) (%weq v1 v2) then inr (cons (rterm u1 v1 (%wxor w1 w2)) xs)
  else if andB (%weq u1 u2) (%weq w1 w2) then inr (cons (rterm u1 (%wxor v1 v2) w1) xs)
  else if andB (%weq v1 v2) (%weq w1 w2) then inr (cons (rterm (%wxor u1 u2) v1 w1) xs)
  else
    case rf-merge-one (rterm u1 v1 w1) xs of
      inl ys → inl (cons (rterm u2 v2 w2) ys)
      inr ys → inr (cons (rterm u2 v2 w2) ys)

rf-reduce-pass : List RTerm → List RTerm
rf-reduce-pass nil = nil
rf-reduce-pass (cons t xs) =
  case rf-merge-one t xs of
    inl _  → cons t (rf-reduce-pass xs)
    inr ys → ys

rf-reduce-go : Nat → List RTerm → List RTerm
rf-reduce-go zero    s = rf-drop-zeros s
rf-reduce-go (suc k) s =
  let s1 = rf-drop-zeros (rf-reduce-pass s)
  in if %wlt (rf-len s1) (rf-len s) then rf-reduce-go k s1 else s1

rf-reduce : List RTerm → List RTerm
rf-reduce s = rf-reduce-go (toNat #8) s

-- Pure .hypercubical exact neutral fiber flip (along shared u, v, or w)
rf-nth : Word → List RTerm → RTerm
rf-nth _ nil = rterm #0 #0 #0
rf-nth i (cons x xs) = if %weq i #0 then x else rf-nth (%wsub i #1) xs

rf-set : Word → RTerm → List RTerm → List RTerm
rf-set _ _ nil = nil
rf-set i v (cons x xs) = if %weq i #0 then cons v xs else cons x (rf-set (%wsub i #1) v xs)

-- Exact Kauers-Moosbauer F_2 flip on pair (i, j) sharing u (mode 0), v (mode 1), or w (mode 2)
rf-flip-ij : Word → Word → Word → List RTerm → List RTerm
rf-flip-ij mode i j s =
  case rf-nth i s of
    rterm u1 v1 w1 →
      case rf-nth j s of
        rterm u2 v2 w2 →
          if andB (%weq mode #0) (%weq u1 u2) then
            rf-reduce (rf-set j (rterm u2 v2 (%wxor w2 w1)) (rf-set i (rterm u1 (%wxor v1 v2) w1) s))
          else if andB (%weq mode #1) (%weq v1 v2) then
            rf-reduce (rf-set j (rterm u2 v2 (%wxor w2 w1)) (rf-set i (rterm (%wxor u1 u2) v1 w1) s))
          else if andB (%weq mode #2) (%weq w1 w2) then
            rf-reduce (rf-set j (rterm u2 (%wxor v2 v1) w2) (rf-set i (rterm (%wxor u1 u2) v1 w1) s))
          else if %weq u1 u2 then
            rf-reduce (rf-set j (rterm u2 v2 (%wxor w2 w1)) (rf-set i (rterm u1 (%wxor v1 v2) w1) s))
          else if %weq v1 v2 then
            rf-reduce (rf-set j (rterm u2 v2 (%wxor w2 w1)) (rf-set i (rterm (%wxor u1 u2) v1 w1) s))
          else if %weq w1 w2 then
            rf-reduce (rf-set j (rterm u2 (%wxor v2 v1) w2) (rf-set i (rterm (%wxor u1 u2) v1 w1) s))
          else s

-- Pure .hypercubical overflow-free 32-bit xorshift PRNG (masks before %wshl so zero bit-loss!)
rf-rng : Word → Word
rf-rng x0 =
  let a  = %wand x0 #4294967295
      x1 = %wxor a (%wshl (%wand a #524287) #13)
      x2 = %wxor x1 (%wshr x1 #17)
  in %wxor x2 (%wshl (%wand x2 #134217727) #5)

-- Find first flippable pair starting from random index (100% active flips, 0 wasted steps!)
rf-can-flip : RTerm → RTerm → Bool
rf-can-flip (rterm u1 v1 w1) (rterm u2 v2 w2) =
  orB (%weq u1 u2) (orB (%weq v1 v2) (%weq w1 w2))

rf-find-j : Nat → Word → Word → Word → RTerm → List RTerm → Word
rf-find-j zero    _ _ j _  _ = j
rf-find-j (suc k) n i j ti s =
  if andB (not (%weq i j)) (rf-can-flip ti (rf-nth j s)) then j
  else rf-find-j k n i (%wmod (%wsucc j) n) ti s

rf-walk-step : Word → List RTerm → Word × List RTerm
rf-walk-step seed s =
  let r1 = rf-rng seed
      r2 = rf-rng r1
      n  = rf-len s
  in if %wlt n #2 then (r2 , s)
     else
       let i  = %wmod r1 n
           j0 = %wmod r2 n
           ti = rf-nth i s
           j  = rf-find-j (toNat n) n i j0 ti s
           md = %wmod (%wshr r2 #1) #3
           s1 = if %weq i j then s
                else if %weq (%wand r2 #1) #0 then rf-flip-ij md i j s
                else rf-flip-ij md j i s
       in (r2 , s1)

rf-walk-go : Nat → Word → List RTerm → List RTerm → Word × (List RTerm × List RTerm)
rf-walk-go zero    r best cur = (r , (best , cur))
rf-walk-go (suc k) r best cur =
  let st   = rf-walk-step r cur
      r2   = fst st
      cur2 = snd st
      b2   = if %wlt (rf-len cur2) (rf-len best) then cur2 else best
  in rf-walk-go k r2 b2 cur2

-- Bounded-stack 2D walk with basin-hopping restart from `best` each outer epoch!
rf-walk-2d : Nat → Nat → Word → List RTerm → List RTerm → List RTerm
rf-walk-2d zero    _     _ best _   = best
rf-walk-2d (suc o) inner r best cur =
  let res = rf-walk-go inner r best best
  in rf-walk-2d o inner (fst res) (fst (snd res)) (fst (snd res))

