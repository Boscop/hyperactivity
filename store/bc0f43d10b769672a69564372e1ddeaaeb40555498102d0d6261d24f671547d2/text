io-wasm-bytes : List Word
io-wasm-bytes =
  let hdr  = the (List Word) (cons #0 (cons #97 (cons #115 (cons #109 (cons #1 (cons #0 (cons #0 (cons #0 nil))))))))
      -- 1 type: (i32, i32, i32) -> i32
      tSec = iw-sec #1 (the (List Word) (cons #1 (cons #96 (cons #3 (cons #127 (cons #127 (cons #127 (cons #1 (cons #127 nil)))))))))
      -- 9 functions all of type 0
      fSec = iw-sec #3 (the (List Word) (cons #9 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 nil)))))))))))
      eSec = iw-sec #7 (cons #9 (io-cat
               (cons (iw-exp "face_conflict" #0)
               (cons (iw-exp "demorgan_mux"  #1)
               (cons (iw-exp "commute"       #2)
               (cons (iw-exp "era_prune"     #3)
               (cons (iw-exp "gals_clk_en"   #4)
               (cons (iw-exp "vxchg_fire"    #5)
               (cons (iw-exp "aux_mux2"      #6)
               (cons (iw-exp "maj3_carry"    #7)
               (cons (iw-exp "xor2_vxchg"    #8) nil)))))))))))
      cSec = iw-sec #10 (cons #9 (io-cat
               (cons (iw-fn-body #3 io-w-face-conflict)
               (cons (iw-fn-body #5 io-w-demorgan-mux)
               (cons (iw-fn-body #6 io-w-commute)
               (cons (iw-fn-body #6 io-w-era-prune)
               (cons (iw-fn-body #4 io-w-gals-clk)
               (cons (iw-fn-body #5 io-w-vxchg-fire)
               (cons (iw-fn-body #4 io-w-aux-mux2)
               (cons (iw-fn-body #6 io-w-maj3-carry)
               (cons (iw-fn-body #4 io-w-xor2-vxchg) nil)))))))))))
  in io-cat (cons hdr (cons tSec (cons fSec (cons eSec (cons cSec nil)))))
