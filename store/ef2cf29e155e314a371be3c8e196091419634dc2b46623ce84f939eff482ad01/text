bw-iflen : (V W : Type) → (b : Bool) → (x : V) → (y : W) → (r1 : List V) → (r2 : List W) → sy-len V r1 ≡ sy-len W r2 → sy-len V (if b then cons x r1 else r1) ≡ sy-len W (if b then cons y r2 else r2)
bw-iflen V W b x y r1 r2 = case b return λ w → sy-len V r1 ≡ sy-len W r2 → sy-len V (if w then cons x r1 else r1) ≡ sy-len W (if w then cons y r2 else r2) of
  true → λ h → λ i → suc (h i)
  false → λ h → h
