-- wire orientation swap relating (u ⋈ v) to (v ⋈ u)
co-flip : {K : Type} → CutOutcome K → CutOutcome K
co-flip co-empty = co-empty
co-flip (co-erase2 w1 w2) = co-erase2 w1 w2
co-flip (co-link2 l1 r1 l2 r2) = co-link2 r1 l1 r2 l2
co-flip (co-commute t1 t2 a1 a2 b1 b2) = co-commute t2 t1 b1 b2 a1 a2
co-flip (co-expand k arg p) = co-expand k arg p
