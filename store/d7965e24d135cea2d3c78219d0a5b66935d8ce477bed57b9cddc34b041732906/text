-- Σ_{q after p} (v_pqpq − v_pqqp)/(d_p d_q), and the whole diagonal bracket
fk-pairs : (Nat → BQ) → (Nat → Nat → Nat → Nat → BQ) → Nat → List Nat → BQ
fk-pairs d v p r = case r of
  nil → fn-q 0 1
  cons q rr → bq-add (oc-div (fn-sub (v p q p q) (v p q q p)) (bq-mul (d p) (d q))) (fk-pairs d v p rr)
