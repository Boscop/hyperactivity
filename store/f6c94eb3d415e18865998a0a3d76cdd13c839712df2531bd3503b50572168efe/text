vocab-add-self : (t : List Word) → (vs : List (List Word)) → InVocab (vocab-add t vs) t
vocab-add-self t vs =
  (case find-tok t vs return (λ o → find-tok t vs ≡ o → InVocab (case o of some _ → vs; none → cons t vs) t) of
     some k → λ h → (k , h)
     none → λ h → (#0 , (λ i → if wlist-eq-refl t i then some #0 else (case find-tok t vs of some k → some (%wsucc k); none → none))))
    (λ i → find-tok t vs)
