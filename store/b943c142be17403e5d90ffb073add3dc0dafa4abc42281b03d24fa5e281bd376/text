cs-sim-switch-tag : (bc : Bool) (ev_c : CsHeap → CsEnv → CsExp → CsRes) (hp1 : CsHeap) (cenv : CsEnv) (d : Word) (vp : CsVal) (om_t om_f : CsOptM) (bt bf : CsExp) →
  (cs-sim-ok om_t (ev_c hp1 cenv bt) ≡ true) →
  (cs-sim-ok om_f (ev_c hp1 cenv bf) ≡ true) →
  cs-sim-ok (if bc then om_t else om_f)
    (cs-eval-switch ev_c hp1 cenv vp (cs-bool-tag bc)
      (cse-br-cons #0 d #0 bt (cse-br-cons #1 d #0 bf cse-br-nil))) ≡ true
cs-sim-switch-tag true ev_c hp1 cenv d vp om_t om_f bt bf ht hf = ht
cs-sim-switch-tag false ev_c hp1 cenv d vp om_t om_f bt bf ht hf = hf
