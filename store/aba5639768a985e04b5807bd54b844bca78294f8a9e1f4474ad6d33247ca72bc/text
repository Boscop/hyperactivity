nk-lvl-le : NkTm → NkTm → Bool
nk-lvl-le l m =
  if nk-con-is l #48
    then nk-con-is m #48
    else (if nk-con-is m #48
            then true
            else (let c = nk-code (nk-nth (nk-args l) #0)
                      ts = nk-tail (nk-args l)
                      d = nk-code (nk-nth (nk-args m) #0)
                      us = nk-tail (nk-args m)
                  in if (if nk-wle c d then true else nk-lvl-has-ge c us)
                       then nk-lvl-atoms-le ts us
                       else false))
