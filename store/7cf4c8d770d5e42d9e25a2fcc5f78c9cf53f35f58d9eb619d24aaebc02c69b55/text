emit-superchip-sv : INetExpr → List Word
emit-superchip-sv e =
  h-concat
    (cons "// Generated directly from pure .hypercubical INetExpr -> Superchip Wire Fabric (0 Python, 0 C!)" (cons bn-nl
    (cons "module hx_brainnet_superchip(input wire [63:0] x0, output wire [63:0] y0);" (cons bn-nl
    (cons "  assign y0 = " (cons (bn-sv-expr (superchip-opt e)) (cons ";" (cons bn-nl
    (cons "endmodule" (cons bn-nl nil))))))))))
