-- A subscribed subset `sub` of channels is a coherent cone iff every channel in `sub`
-- exists in the live DAG and its parent is either root (#0) or also in `sub`.
cone-coherent-go : List LiveChannel → List Word → List Word → Bool
cone-coherent-go _ _ nil = true
cone-coherent-go dag full (cons id r) =
  let p = ch-parent id dag
      okParent = if %weq p #0 then true else w-elem p full
  in andB (andB (ch-find id dag) okParent) (cone-coherent-go dag full r)
