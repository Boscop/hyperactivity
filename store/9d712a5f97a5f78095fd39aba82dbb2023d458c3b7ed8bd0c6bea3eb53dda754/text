-- a body built in an environment, its result to arrive on out
nk-build : NkTm → NkEnv → Word → NkOut → NkOut
nk-build (nk-var i) e out (nk-out fx n) = nk-out (nk-pick e i out fx) n
nk-build (nk-num m) e out (nk-out fx n) = nk-out (nkf-val out (nkv-num m) (nk-era-env e fx)) n
nk-build (nk-lam b) e out (nk-out fx n) = nk-out (nkf-val out (nkv-lam b e) fx) n
nk-build (nk-inc a) e out (nk-out fx n) = nk-build a e n (nk-out (nkf-op n (nko-inc out) fx) (%wsucc n))
nk-build (nk-app f a) e out o =
  let s = nk-split e o
      n = nk-n (nk-so s)
  in nk-build f (nk-sa s) n (nk-build a (nk-sb s) (%wsucc n) (nk-out (nkf-op n (nko-app (%wsucc n) out) (nk-fx (nk-so s))) (%wadd n #2)))
