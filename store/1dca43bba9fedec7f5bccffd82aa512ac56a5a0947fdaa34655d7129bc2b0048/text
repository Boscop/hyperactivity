-- `ERC-4626` Unprotected First-Depositor Inflation Exploit Witness (`victimDeposit - redeemedAssets`):
ms-erc4626-donation-drain : Word → Word → Word → Word
ms-erc4626-donation-drain attackerInit donationWei victimDeposit =
  let totalAssets0 = %wadd attackerInit donationWei
      victimShares = %wdiv (%wmul victimDeposit attackerInit) totalAssets0
      totalShares1 = %wadd attackerInit victimShares
      totalAssets1 = %wadd totalAssets0 victimDeposit
      attRedeemed  = %wdiv (%wmul attackerInit totalAssets1) totalShares1
      attCost      = %wadd attackerInit donationWei
  in if %wlt attCost attRedeemed then %wsub attRedeemed attCost else #0
