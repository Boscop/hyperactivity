data TirProg : Type where
  tp-var0    : TirProg
  tp-lit     : Word → TirProg
  tp-xor     : TirProg → TirProg → TirProg
  tp-add     : TirProg → TirProg → TirProg
  tp-dup-xor : TirProg → TirProg
  tp-dup-add : TirProg → TirProg
  tp-era-l   : TirProg → TirProg → TirProg
  tp-lut3    : Word → TirProg → TirProg → TirProg → TirProg
  tp-reflect : TirProg → TirProg

tmc-eval : Word → TirProg → Word
tmc-eval env tp-var0            = bn-w64 env
tmc-eval env (tp-lit w)         = w
tmc-eval env (tp-xor a b)       = bn-xor64 (tmc-eval env a) (tmc-eval env b)
tmc-eval env (tp-add a b)       = bn-add64 (tmc-eval env a) (tmc-eval env b)
tmc-eval env (tp-dup-xor a)     =
  let v = tmc-eval env a
  in bn-xor64 v v
tmc-eval env (tp-dup-add a)     =
  let v = tmc-eval env a
  in bn-add64 v v
tmc-eval env (tp-era-l dead lv) = tmc-eval env lv
tmc-eval env (tp-lut3 m a b c)  =
  bn-lut3-w64 m (tmc-eval env a) (tmc-eval env b) (tmc-eval env c)
tmc-eval env (tp-reflect inner) = tmc-eval env inner

tmc-cost : TirProg → Nat
tmc-cost tp-var0            = suc zero
tmc-cost (tp-lit w)         = suc zero
tmc-cost (tp-xor a b)       = suc (tmc-add (tmc-cost a) (tmc-cost b))
tmc-cost (tp-add a b)       = suc (tmc-add (tmc-cost a) (tmc-cost b))
tmc-cost (tp-dup-xor a)     = suc (suc (tmc-cost a))
tmc-cost (tp-dup-add a)     = suc (suc (tmc-cost a))
tmc-cost (tp-era-l dead lv) = suc (tmc-add (tmc-cost dead) (tmc-cost lv))
tmc-cost (tp-lut3 m a b c)  = suc (tmc-add (tmc-cost a) (tmc-add (tmc-cost b) (tmc-cost c)))
tmc-cost (tp-reflect inner) = suc (tmc-cost inner)

-- Exact constant-folding smart constructors (100% `refl` branch soundness!):
tmc-mk-xor : TirProg → TirProg → TirProg
tmc-mk-xor (tp-lit a) (tp-lit b) = tp-lit (bn-xor64 a b)
tmc-mk-xor a          b          = tp-xor a b

tmc-mk-add : TirProg → TirProg → TirProg
tmc-mk-add (tp-lit a) (tp-lit b) = tp-lit (bn-add64 a b)
tmc-mk-add a          b          = tp-add a b

tmc-mk-dup-add : TirProg → TirProg
tmc-mk-dup-add (tp-lit a) = tp-lit (bn-add64 a a)
tmc-mk-dup-add a          = tp-dup-add a

tmc-mk-lut3 : Word → TirProg → TirProg → TirProg → TirProg
tmc-mk-lut3 m (tp-lit a) (tp-lit b) (tp-lit c) = tp-lit (bn-lut3-w64 m a b c)
tmc-mk-lut3 m a          b          c          = tp-lut3 m a b c

