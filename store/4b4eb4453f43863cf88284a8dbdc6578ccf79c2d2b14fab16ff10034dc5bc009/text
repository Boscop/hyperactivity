  (cons "-sS" (cons "--max-time" (cons "5"
  (cons "-X" (cons "POST"
  (cons "-H" (cons "Content-Type: application/json"
  (cons "--data-binary" (cons "@/tmp/hx_agent_bus/agent_tir_compiler_cdc3fcb9_state.json"
