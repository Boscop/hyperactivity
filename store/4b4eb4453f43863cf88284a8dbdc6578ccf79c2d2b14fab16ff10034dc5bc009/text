tmc-cong : {A B : Type} → (f : A → B) → {x y : A} → x ≡ y → f x ≡ f y
tmc-cong f p = λ i → f (p i)

tmc-cong2 : {A B C : Type} → (f : A → B → C) → {a1 a2 : A} → {b1 b2 : B} →
  a1 ≡ a2 → b1 ≡ b2 → f a1 b1 ≡ f a2 b2
tmc-cong2 f p q = λ i → f (p i) (q i)

tmc-sym : {A : Type} → {x y : A} → x ≡ y → y ≡ x
tmc-sym {A} {x} p = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ p j , i = 1 ↦ x ]) x

tmc-trans : {A : Type} → {x y z : A} → x ≡ y → y ≡ z → x ≡ z
tmc-trans {A} {x} p q = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

tmc-add : Nat → Nat → Nat
tmc-add zero    b = b
tmc-add (suc a) b = suc (tmc-add a b)

tmc-mul : Nat → Nat → Nat
tmc-mul zero    b = zero
tmc-mul (suc a) b = tmc-add b (tmc-mul a b)

tmc-add-zero-r : (a : Nat) → tmc-add a zero ≡ a
tmc-add-zero-r zero    = refl
tmc-add-zero-r (suc a) = tmc-cong suc (tmc-add-zero-r a)

tmc-add-suc-r : (a b : Nat) → tmc-add a (suc b) ≡ suc (tmc-add a b)
tmc-add-suc-r zero    b = refl
tmc-add-suc-r (suc a) b = tmc-cong suc (tmc-add-suc-r a b)

tmc-add-assoc : (a b c : Nat) → tmc-add (tmc-add a b) c ≡ tmc-add a (tmc-add b c)
tmc-add-assoc zero    b c = refl
tmc-add-assoc (suc a) b c = tmc-cong suc (tmc-add-assoc a b c)

tmc-add-comm : (a b : Nat) → tmc-add a b ≡ tmc-add b a
tmc-add-comm zero    b = tmc-sym (tmc-add-zero-r b)
tmc-add-comm (suc a) b =
  tmc-trans (tmc-cong suc (tmc-add-comm a b)) (tmc-sym (tmc-add-suc-r b a))

tmc-le-weaken-suc : (a b : Nat) → ml-le a b ≡ true → ml-le a (suc b) ≡ true
tmc-le-weaken-suc zero    b       h = refl
tmc-le-weaken-suc (suc a) zero    h = Empty-rec (true≢false (tmc-sym h))
tmc-le-weaken-suc (suc a) (suc b) h = tmc-le-weaken-suc a b h

tmc-le-pad-l : (m a b : Nat) → ml-le a b ≡ true → ml-le a (tmc-add m b) ≡ true
tmc-le-pad-l zero    a b h = h
tmc-le-pad-l (suc m) a b h =
  tmc-le-weaken-suc a (tmc-add m b) (tmc-le-pad-l m a b h)

tmc-le-s-mul : (s m : Nat) → ml-le s (tmc-mul s (suc m)) ≡ true
tmc-le-s-mul zero    m = refl
tmc-le-s-mul (suc s) m =
  tmc-le-pad-l m s (tmc-mul s (suc m)) (tmc-le-s-mul s m)

tmc-le-cancel-add-l : (k a b : Nat) → ml-le a b ≡ true → ml-le (tmc-add k a) (tmc-add k b) ≡ true
tmc-le-cancel-add-l zero    a b h = h
tmc-le-cancel-add-l (suc k) a b h = tmc-le-cancel-add-l k a b h

