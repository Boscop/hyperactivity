tmc-step-bind-vm : {A B : Type} → Step W A → (A → Step W B) → Step W B
tmc-step-bind-vm (sdone a)  k = k a
tmc-step-bind-vm (scmd c f) k = scmd c (λ r → tmc-step-bind-vm (f r) k)

tmc-has-link-arg : List (List Word) → Bool
tmc-has-link-arg nil         = false
tmc-has-link-arg (cons a rs) =
  if h-eq a "--with" then
    (case rs of
      nil → false
      cons v rs2 →
        (case rs2 of
          nil → false
          cons r rs3 → tmc-has-link-arg rs3))
  else if orB (h-eq a "link") (h-eq a "hyperactivate") then true
  else tmc-has-link-arg rs

tmc-is-direct : List (List Word) → Bool
tmc-is-direct nil         = false
tmc-is-direct (cons a rs) =
  if h-eq a "--with" then
    (case rs of
      nil → false
      cons v rs2 →
        (case rs2 of
          nil → false
          cons r rs3 → tmc-is-direct rs3))
  else if h-infix "hx-tir-metacircular" a then true
  else tmc-is-direct rs

tmc-run : Step W Unit
tmc-run =
  tmc-step-bind-vm (to-step h-args) (λ av →
    if tmc-is-direct av then
      (if tmc-has-link-arg av
       then tmc-step-bind-vm (tmc-main nil) (λ rc →
            tmc-step-bind-vm (to-step tmc-link-cyberbeasts) (λ u →
            scmd (w-exit rc) (λ u2 → sdone unit)))
       else tmc-step-bind-vm (tmc-main nil) (λ rc → scmd (w-exit rc) (λ u → sdone unit)))
    else sdone unit)

#run tmc-run
