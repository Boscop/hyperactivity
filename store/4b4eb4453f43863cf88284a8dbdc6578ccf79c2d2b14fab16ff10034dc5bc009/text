-- Metacircular Compiler-on-Compiler Operator (unwraps `tp-reflect`, erases `ERA`, folds cones):
tmc-compile : TirProg → TirProg
tmc-compile tp-var0            = tp-var0
tmc-compile (tp-lit w)         = tp-lit w
tmc-compile (tp-xor a b)       = tmc-mk-xor (tmc-compile a) (tmc-compile b)
tmc-compile (tp-add a b)       = tmc-mk-add (tmc-compile a) (tmc-compile b)
tmc-compile (tp-dup-xor a)     =
  let ca = tmc-compile a
  in tmc-mk-xor ca ca
tmc-compile (tp-dup-add a)     = tmc-mk-dup-add (tmc-compile a)
tmc-compile (tp-era-l dead lv) = tmc-compile lv
tmc-compile (tp-lut3 m a b c)  =
  tmc-mk-lut3 m (tmc-compile a) (tmc-compile b) (tmc-compile c)
tmc-compile (tp-reflect inner) = tmc-compile inner

-- Arbitrary-Height Metacircular Tower (`m` levels of programs-on-programs-on-programs!):
tmc-tower : Nat → TirProg → TirProg
tmc-tower zero    p = p
tmc-tower (suc m) p = tmc-compile (tmc-tower m p)

-- UNIVERSAL THEOREM 2A (SINGLE-STAGE METACIRCULAR SOUNDNESS — ZERO POSTULATES):
tmc-thm-compile-sound : (env : Word) → (p : TirProg) →
  tmc-eval env (tmc-compile p) ≡ tmc-eval env p
tmc-thm-compile-sound env tp-var0    = refl
tmc-thm-compile-sound env (tp-lit w) = refl
tmc-thm-compile-sound env (tp-xor a b) =
  tmc-trans (tmc-lem-mk-xor env (tmc-compile a) (tmc-compile b))
            (tmc-cong2 bn-xor64 (tmc-thm-compile-sound env a) (tmc-thm-compile-sound env b))
tmc-thm-compile-sound env (tp-add a b) =
  tmc-trans (tmc-lem-mk-add env (tmc-compile a) (tmc-compile b))
            (tmc-cong2 bn-add64 (tmc-thm-compile-sound env a) (tmc-thm-compile-sound env b))
tmc-thm-compile-sound env (tp-dup-xor a) =
  let ih = tmc-thm-compile-sound env a
  in tmc-trans (tmc-lem-mk-xor env (tmc-compile a) (tmc-compile a))
               (tmc-cong2 bn-xor64 ih ih)
tmc-thm-compile-sound env (tp-dup-add a) =
  let ih = tmc-thm-compile-sound env a
  in tmc-trans (tmc-lem-mk-dup-add env (tmc-compile a))
               (tmc-cong2 bn-add64 ih ih)
tmc-thm-compile-sound env (tp-era-l dead lv) = tmc-thm-compile-sound env lv
tmc-thm-compile-sound env (tp-lut3 m a b c) =
  tmc-trans (tmc-lem-mk-lut3 env m (tmc-compile a) (tmc-compile b) (tmc-compile c))
            (bn-cong3 (bn-lut3-w64 m)
              (tmc-thm-compile-sound env a)
              (tmc-thm-compile-sound env b)
              (tmc-thm-compile-sound env c))
tmc-thm-compile-sound env (tp-reflect inner) = tmc-thm-compile-sound env inner

