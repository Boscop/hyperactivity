                (%wadd (tmc-lane-bit #0 (fst sc)) (%wmul #2 (tmc-lane-bit #0 (snd sc))))
      l63 = %weq (%wadd (tmc-lane-bit #63 vA) (%wadd (tmc-lane-bit #63 vB) (tmc-lane-bit #63 vC)))
                 (%wadd (tmc-lane-bit #63 (fst sc)) (%wmul #2 (tmc-lane-bit #63 (snd sc))))
