-- 4-Port Unitary Optical Plaquette Energy Conservation Across ALL Reflection Steps `n : Nat`:
data TmcPlaq4 = mk-tmc-plaq4 (pa pb pc pd : Nat)

tmc-plaq-energy : TmcPlaq4 → Nat
tmc-plaq-energy (mk-tmc-plaq4 a b c d) = tmc-add a (tmc-add b (tmc-add c d))

tmc-plaq-step : TmcPlaq4 → TmcPlaq4
tmc-plaq-step (mk-tmc-plaq4 a b c d) = mk-tmc-plaq4 b c d a

tmc-plaq-iter : Nat → TmcPlaq4 → TmcPlaq4
tmc-plaq-iter zero    q = q
tmc-plaq-iter (suc n) q = tmc-plaq-step (tmc-plaq-iter n q)

tmc-lem-plaq-step : (q : TmcPlaq4) → tmc-plaq-energy (tmc-plaq-step q) ≡ tmc-plaq-energy q
tmc-lem-plaq-step (mk-tmc-plaq4 a b c d) =
  let bcd = tmc-add b (tmc-add c d)
      s1  = tmc-sym (tmc-add-assoc b c (tmc-add d a))
      s2  = tmc-sym (tmc-add-assoc (tmc-add b c) d a)
      s3  = tmc-cong (λ z → tmc-add z a) (tmc-add-assoc b c d)
      s4  = tmc-add-comm bcd a
  in tmc-trans s1 (tmc-trans s2 (tmc-trans s3 s4))

tmc-thm-optical-all-n :
  (n : Nat) → (q : TmcPlaq4) → tmc-plaq-energy (tmc-plaq-iter n q) ≡ tmc-plaq-energy q
tmc-thm-optical-all-n zero    q = refl
tmc-thm-optical-all-n (suc n) q =
  tmc-trans (tmc-lem-plaq-step (tmc-plaq-iter n q)) (tmc-thm-optical-all-n n q)

