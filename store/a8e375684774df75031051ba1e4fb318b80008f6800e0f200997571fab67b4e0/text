fold-det-mirror-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
fold-det-mirror-poly A ad mu q vs =
  (λ g sub →
    let z = q (fn-q 0 1)
        a1 = g 0; a2 = g 1; a3 = g 2
        b1 = g 3; b2 = g 4; b3 = g 5
        c1 = g 6; c2 = g 7; c3 = g 8
        detL = fold-det3 A ad sub mu a1 a2 a3 b1 b2 b3 c1 c2 c3
        detD = fold-det3 A ad sub mu
                 (sub z a1) (sub z a2) (sub z a3)
                 (sub z b1) (sub z b2) (sub z b3)
                 (sub z c1) (sub z c2) (sub z c3)
    in (ad detL detD , z))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
