-- 3. ZERO-POSTULATE KERNEL PROOFS OVER ALL 2^4 = 16 INPUTS PER CIRCUIT (112/112)
-- ============================================================================
ms-verify-all : List MetaCircuit → Bool
ms-verify-all nil = true
ms-verify-all (cons (mcirc _ t16 _ gs) rest) =
  if ms-verify16 t16 gs then ms-verify-all rest else false
