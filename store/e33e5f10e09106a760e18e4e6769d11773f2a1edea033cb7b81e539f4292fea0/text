-- (part of language-support)
x86_run_halt : (haltAddr : Bits #48) → (maxSteps : ZI) → (printEachStep : Bool) → (printCount : Bool) → (count' : ZI) → MS ZI
x86_run_halt haltAddr maxSteps printEachStep printCount count' = x86_run_halt-fuel (wadd (z-nat maxSteps) #1) haltAddr maxSteps printEachStep printCount count'
