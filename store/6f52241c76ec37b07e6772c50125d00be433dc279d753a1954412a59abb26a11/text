-- every comment line of the store (its statements, its documentation) and every document, run
-- together and cut into sentences, one a line
c-record-cmd : List Word
c-record-cmd = c-dq "{ cat store/[0-9a-f]*/text | sed -n 's/^-- \{0,1\}//p'; xargs -a build/chat/docs cat; } | tr '\n\t' '  ' | sed 's/\([.!?]\)  */\1\n/g' | sed 's/   */ /g; s/^ //' | grep -E '[a-z].{28,}' > build/chat/record.tmp && mv build/chat/record.tmp build/chat/record"
