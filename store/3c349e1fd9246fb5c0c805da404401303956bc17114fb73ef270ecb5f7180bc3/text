pull-ignore : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (k : (x : X) → Y x → F x)
  (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' F' (dcube-map n X Y X' f c d)) →
  PathP (λ i → DCube n X F c) (dcube-pull n X X' Y F F' f (λ x y z → k x y) c d e) (dcube-fmap n X Y F k c d)
pull-ignore zero X X' Y F F' f k c d e = λ i → k c d
pull-ignore (suc n) X X' Y F F' f k c d e =
  pull-ignore n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-fmap X Y F k) c d e
