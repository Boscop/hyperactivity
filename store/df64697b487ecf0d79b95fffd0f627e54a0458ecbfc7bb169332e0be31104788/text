-- two requests at one wire whose changes commute, in either order, leave memories that read the same
nk-upd-twice : (sl : NkSlots) (w : Word) (f1 f2 : NkSlot → NkSlot) → ((s : NkSlot) → f2 (f1 s) ≡ f1 (f2 s)) → nk-same (nk-upd (nk-upd sl w f1) w f2) (nk-upd (nk-upd sl w f2) w f1)
nk-upd-twice sl w f1 f2 c x = nk-upd-twice-at (%weq w x) sl w x f1 f2 c refl
