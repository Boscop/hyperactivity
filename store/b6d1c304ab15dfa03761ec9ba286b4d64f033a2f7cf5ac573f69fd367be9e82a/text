-- so every molecule of the standard representation is two-centred, proved: the embedding cannot produce
-- a bond incident on three distinct atoms, whatever molecule it is given.
hmol-two-centred : (Q : MolEq) → TwoCentred (hmol-of-moleq Q)
hmol-two-centred Q = λ i → λ x → λ y → λ z → λ px → λ py → λ pz → two-of-three (mol-atoms (meq-mol Q)) (fst i) (fst (snd i)) x y z (meq-inc-cases Q i x px) (meq-inc-cases Q i y py) (meq-inc-cases Q i z pz)
