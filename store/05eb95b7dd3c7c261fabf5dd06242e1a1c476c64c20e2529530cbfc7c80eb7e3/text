-- an entry: its path, its object id, and the size and modification time (seconds) git recorded
g-cons-entry : List Word → List Word → List Word → Sum (List Word) (List (List Word × (List Word × (Word × Word)))) → Sum (List Word) (List (List Word × (List Word × (Word × Word))))
g-cons-entry path id st (inl why) = inl why
g-cons-entry path id st (inr es) = inr (cons (path , (h-hex id , (h-be (h-drop-n (toNat #36) st) , h-be (h-take (toNat #4) (h-drop-n (toNat #8) st))))) es)
