-- at p (a dyadic m/2^s, given as m): A to k halvings, then F = c − r_1, with both starts' soundness
h2p-at-a : List Bool → List Bool → IV → IV → Nat → Nat → IV → Bool × IV
h2p-at-a S S2 p sig M N a = (both (ang-start-ok S (iv-mul S p p) a M) (rad-start-ok S p sig (rad-c S p a sig) N) ,
  iv-sub (rad-c S p a sig) (rad-down S S2 p sig (rad-c S p a sig) N (iv-unit S)))
