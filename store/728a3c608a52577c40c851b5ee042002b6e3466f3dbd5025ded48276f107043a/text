-- Build Hyperbolic-Portal Eternal Golden Braid H (3 voices: Gödel, Escher, Bach)
logo-portal-braid-build : SInt → SInt → SInt → SInt → SInt → SInt → List Word
logo-portal-braid-build T r0 k ribBase koFront koBack =
  let W = sp #840
      H = sp #880
      F = sp #184
      L = sp #807
      twist = sp #23600
      -- 3 exact C2-symmetric B3 voices: π/2, π/2 + 2π/3, π/2 + 4π/3 (scaled by 10000)
      r0s = split-strand (b3-sample-strand 65 #64 #0 L r0 k twist ribBase (sp #15708))
      r1s = split-strand (b3-sample-strand 65 #64 #0 L r0 k twist ribBase (sp #36652))
      r2s = split-strand (b3-sample-strand 65 #64 #0 L r0 k twist ribBase (sp #57596))
      allRuns = rrun-sort (list-append r0s (list-append r1s r2s))
      inner = render-runs koFront koBack allRuns
      clipD = portal-clip-d W H F
      pL = pillar-d (sn #1) (sp #1280) (sp #1280) W H T F
      pR = pillar-d (sp #1) (sp #1280) (sp #1280) W H T F
  in lg-concat (cons "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 256 256' width='256' height='256'><rect width='256' height='256' fill='#ff0a94'/><defs><clipPath id='hxGB'><path d='"
       (cons clipD (cons "'/></clipPath></defs><g clip-path='url(#hxGB)'>"
       (cons inner (cons "</g><path d='" (cons pL (cons " " (cons pR (cons "' fill='#fff'/></svg>" nil)))))))))
