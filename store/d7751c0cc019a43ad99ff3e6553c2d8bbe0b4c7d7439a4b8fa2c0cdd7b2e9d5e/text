-- Exact zero-dust proportional splitter for ANY budget `B` (10% / 50% / 30% / remainder=10%):
ms-split-budget : Word → StrikeAlloc
ms-split-budget totalUsdc6 =
  let t1 = %wdiv (%wmul totalUsdc6 #10) #100
      t2 = %wdiv (%wmul totalUsdc6 #50) #100
      t3 = %wdiv (%wmul totalUsdc6 #30) #100
      t4 = %wsub totalUsdc6 (%wadd t1 (%wadd t2 t3))
  in mk-strike-alloc t1 t2 t3 t4
