-- is some socket of the table bound to receive at d
k-local : SockAddr → List (Word × KObj) → Bool
k-local d nil = false
k-local d (cons e r) =
  case snd e of
    k-pipe-in q → k-local d r
    k-pipe-out w → k-local d r
    k-udp b → (case b of inl a → (if k-for a d then true else k-local d r); inr u → k-local d r)
    k-epoll l → k-local d r
