-- Apply diagonal phase gate f on qubit q in {0,1,2}
q-apply-diag : (Z8 → Z8) → Word → QState3 → QState3
q-apply-diag f q (qs3 s0 s1 s2 s3 s4 s5 s6 s7) =
  if %weq q #0 then qs3 s0 (f s1) s2 (f s3) s4 (f s5) s6 (f s7)
  else if %weq q #1 then qs3 s0 s1 (f s2) (f s3) s4 s5 (f s6) (f s7)
  else qs3 s0 s1 s2 s3 (f s4) (f s5) (f s6) (f s7)
