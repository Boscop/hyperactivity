-- 7-to-3 Bit-Sliced Wallace/CSA Tree (sums SEVEN 64-bit partition masks into 3 bit-planes `(b0, b1, b2)`
-- representing exact 3-bit counts `0..7` for ALL 64 partitions simultaneously in 4 CSA stages = 8 `ULOP3`s!):
ht-popcount7-64lanes :
  Word → Word → Word → Word → Word → Word → Word → Word × (Word × Word)
ht-popcount7-64lanes m0 m1 m2 m3 m4 m5 m6 =
  let s1  = ht-csa64 m0 m1 m2
      s2  = ht-csa64 m3 m4 m5
      s3  = ht-csa64 (fst s1) (fst s2) m6
      b0  = fst s3
      c12 = ht-csa64 (snd s1) (snd s2) (snd s3)
      b1  = fst c12
      b2  = snd c12
  in (b0 , (b1 , b2))
