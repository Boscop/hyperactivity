sg-dc-head : Word → Lst (List Word) → (Word → Lst (List Word) → NkSexp → Word × NkSexp) → Lst NkSexp → Word × NkSexp
sg-dc-head fr _ _ lnil = (fr , nks-lst lnil)
sg-dc-head fr ds go (lcons h rest) =
  case h return (λ _ → Word × NkSexp) of
    nks-sym tg →
      if nk-wlist-eq tg "lam" then sg-dc-lams go fr ds "lam" rest
      else if nk-wlist-eq tg "plam" then sg-dc-lams go fr ds "plam" rest
      else if nk-wlist-eq tg "forall" then sg-dc-lams go fr ds "forall" rest
      else if nk-wlist-eq tg "let" then sg-dc-let go fr ds rest
      else (let pr = sg-dc-list go fr ds rest in (fst pr , nks-lst (lcons (nks-sym tg) (snd pr))))
    nks-lst _ →
      let pr = sg-dc-list go fr ds (lcons h rest) in (fst pr , nks-lst (snd pr))
