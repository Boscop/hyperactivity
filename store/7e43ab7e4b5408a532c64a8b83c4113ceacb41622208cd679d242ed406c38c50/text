hi-jedges-of : List (List Word) → List Word → List (List Word) → List (List Word)
hi-jedges-of sc n nil = nil
hi-jedges-of sc n (cons p r) = if h-has p sc then cons (h-concat (cons "[" (cons (s-json-str n) (cons "," (cons (s-json-str p) (cons "]" nil)))))) (hi-jedges-of sc n r) else hi-jedges-of sc n r
