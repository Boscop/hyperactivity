nk-upd-same-at : (b : Bool) (a c : NkSlots) (w x : Word) (f : NkSlot → NkSlot) → (%weq w x ≡ b) → nk-same a c → nk-get (nk-upd a w f) x ≡ nk-get (nk-upd c w f) x
nk-upd-same-at true a c w x f p h =
  cong (λ z → nk-get (nk-upd a w f) z) (sym (weq-sound w x p)) ∙ (nk-get-set a w (f (nk-get a w)) ∙ (cong f (h w) ∙ (sym (nk-get-set c w (f (nk-get c w))) ∙ cong (λ z → nk-get (nk-upd c w f) z) (weq-sound w x p))))
nk-upd-same-at false a c w x f p h = nk-get-set-other a w x (f (nk-get a w)) p ∙ (h x ∙ sym (nk-get-set-other c w x (f (nk-get c w)) p))
