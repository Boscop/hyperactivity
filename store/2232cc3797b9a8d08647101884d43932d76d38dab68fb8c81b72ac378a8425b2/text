-- THEOREM 2: UNIVERSAL UNBOUNDED-GENERATION GLOBAL SUPEROPTIMIZATION MONOTONICITY!
-- Across ALL generations g : Nat of the closed-loop 5-axis superoptimizer, cost(g) <= cost(0) universally!
str-thm-global-superopt-mono : (gen-cost : Nat → StrikeCost) →
  ((g : Nat) → hm-le (str-total-cost (gen-cost (suc g))) (str-total-cost (gen-cost g)) ≡ true) →
  (g : Nat) → hm-le (str-total-cost (gen-cost g)) (str-total-cost (gen-cost zero)) ≡ true
str-thm-global-superopt-mono gc step = sc-thm-dc-gen-monotone (λ g → str-total-cost (gc g)) step
