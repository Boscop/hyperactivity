cstate-advance : CtxState → Word → CtxState
cstate-advance (mk-cstate q hist t0 t1 t2 t3 t4) x =
  let t0' = ftbl-inc x t0
      t1' = ct-inc-opt (ctx-key-at 1 hist) x t1
      t2' = ct-inc-opt (ctx-key-at 2 hist) x t2
      t3' = ct-inc-opt (ctx-key-at 3 hist) x t3
      t4' = ct-inc-opt (ctx-key-at 4 hist) x t4
  in mk-cstate q (cm-take4 (cons (q x) hist)) t0' t1' t2' t3' t4'
