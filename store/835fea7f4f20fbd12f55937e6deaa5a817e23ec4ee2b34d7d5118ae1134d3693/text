-- no property of an aromatic ring distinguishes its two Kekule structures: not by convention, because
-- there is no such function on the carrier at all
kek-no-distinguishing-property : (B : Type 0) → (g : Taut Kek (ic-within Kek kek-conv 1) → B) → g (taut-pt kek-a) ≡ g (taut-pt kek-b)
kek-no-distinguishing-property B g = ic-respects Kek kek-conv 1 B g kek-a kek-b unit
