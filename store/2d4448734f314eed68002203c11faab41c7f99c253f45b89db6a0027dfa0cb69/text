-- (part of language-support)
__SetConfig-case18 : (m'3 : (Text × ZI)) → MS Unit
__SetConfig-case18 m'3 =
  let value : ZI
      value = (snd m'3)
  in bindS {Unit} {Unit} (putS (x86-set-rflags (bv-of-int #32 value #0))) (λ _ →
       bindS {Bool} {Unit} (getS {Bool} x86-log_register_writes) (λ log_register_writes'22 →
         λ σ →
           if log_register_writes'22 then
             the (MS Unit)
               log_rflags_write σ
           else
             the (MS Unit)
               (retS {Unit} unit) σ))
