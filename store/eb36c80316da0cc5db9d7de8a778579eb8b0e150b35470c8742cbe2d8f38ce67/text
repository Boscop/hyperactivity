-- the layers in turn; a labelling's record is its numbers of contacts (0,3), (0,5), (1,4), (2,5)
sp-l5 : List (Nat × Nat) → Nat → Nat → List (List (Nat × Nat)) → List (Nat × (Nat × (Nat × Nat))) → List (Nat × (Nat × (Nat × Nat)))
sp-l5 l2 n03 n14 cs acc = case cs of
  nil → acc
  cons l5 rest → sp-l5 l2 n03 n14 rest (cons (n03 , (sp-adjn l5 (cons sp-o nil) , (n14 , sp-adjn l5 l2))) acc)
