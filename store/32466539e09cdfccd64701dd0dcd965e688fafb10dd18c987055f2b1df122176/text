      [[94, true, 'VALID 52B rANS -> ACCEPT (escrow=0, bal=150) · 1.01 ms'],
       [176, false, '1-BIT FORGERY -> REJECT (escrow=100, bal=50) · 1.01 ms']].forEach(function(row) {
