        ctx.beginPath(); ctx.moveTo(rootX, rootY); ctx.lineTo(x, 138); ctx.stroke();
        ctx.fillStyle = keep ? green : bg; ctx.strokeStyle = keep ? green : pink;
        ctx.beginPath(); ctx.arc(x, 138, 12, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        ctx.fillStyle = keep ? green : pink; ctx.textAlign = 'center';
