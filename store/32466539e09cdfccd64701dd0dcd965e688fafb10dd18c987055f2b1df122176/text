      ctx.fillStyle = ink; ctx.beginPath(); ctx.arc(rootX, rootY, 10, 0, Math.PI * 2); ctx.fill();
      ctx.textAlign = 'left'; ctx.fillStyle = green;
      ctx.fillText('16,777,216 scaffolds  ->  16,776,448 pruned (99.9954%)  ->  768 leaves in 0 ms', 20, 250);
    } else if (activeLayer === 5) {
      // Order book bid/ask depth + exact conservation bar
      var mid = W * 0.5;
      for (var b = 0; b < 6; b++) {
