<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hyperactive Labs · hyperactivity</title>
<meta name="description" content="hyperactivity: a decentralized operating system language for collective superintelligence">
<style>
  :root {
    --bg: #ffffff; --fg: #000000; --muted: #3f3f46; --dim: #71717a;
    --line: rgba(0,0,0,0.14); --line-strong: #000000;
    --surface: #ffffff; --surface2: #fafafa; --code-bg: #f4f4f5;
    --pink: #ff0a94; --pink-soft: rgba(255,10,148,0.08); --pink-line: rgba(255,10,148,0.45);
    --blue: #1a73e8; --blue-soft: rgba(26,115,232,0.08); --blue-line: rgba(26,115,232,0.4);
    --green: #0d8a4e; --green-soft: rgba(13,138,78,0.1);
    --mono: ui-monospace, 'SF Mono', Menlo, Monaco, Consolas, monospace;
    --sans: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  }
  html.dark {
    --bg: #000000; --fg: #ffffff; --muted: #a1a1aa; --dim: #71717a;
    --line: rgba(255,255,255,0.16); --line-strong: rgba(255,255,255,0.42);
    --surface: #000000; --surface2: #0a0a0c; --code-bg: #111114;
    --pink: #ff0a94; --pink-soft: rgba(255,10,148,0.14); --pink-line: rgba(255,10,148,0.5);
    --blue: #4da3ff; --blue-soft: rgba(77,163,255,0.13); --blue-line: rgba(77,163,255,0.42);
    --green: #38d388; --green-soft: rgba(56,211,136,0.14);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: var(--bg); color: var(--fg); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  code { font-family: var(--mono); font-size: 0.88em; background: var(--code-bg); padding: 1px 5px; border-radius: 0; }

  /* ICONIC MINIMAL HOT-PINK MONOSPACE SPLASH (THE ROOT DESIGN) */
  .splash {
    min-height: calc(100svh - 48px);
    background: #ff0a94;
    color: #fff;
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(340px, 0.94fr);
    align-items: center;
    gap: clamp(24px, 4vw, 60px);
    padding: clamp(32px, 5vw, 64px) clamp(20px, 5vw, 72px);
    position: relative;
    font-family: var(--mono);
    border-bottom: 2px solid #000;
  }
  .splash-inner { min-width: 0; display: flex; flex-direction: column; }
  .splash h1 {
    font: 700 clamp(44px, 6vw, 96px)/.95 var(--mono);
    letter-spacing: -0.04em;
    margin: 0;
    color: #fff;
    white-space: nowrap;
  }
  .splash .sub {
    font: 400 clamp(16px, 1.9vw, 23px)/1.44 var(--mono);
    margin-top: 24px;
    max-width: 34ch;
    color: #fff;
  }
  .splash .who {
    margin-top: 20px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.92;
  }
  .splash-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }
  .sp-btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 700;
    padding: 9px 15px;
    border: 1.5px solid rgba(255,255,255,0.72);
    color: #fff;
    background: transparent;
    letter-spacing: 0.01em;
    transition: background 0.12s, color 0.12s, border-color 0.12s;
  }
  .sp-btn:hover { background: #fff; color: #ff0a94; border-color: #fff; }
  .sp-btn.sp-primary { background: #fff; color: #ff0a94; border-color: #fff; }
  .sp-btn.sp-primary:hover { background: #000; color: #fff; border-color: #000; }
  .splash-foot {
    margin-top: 28px;
    padding-top: 14px;
    border-top: 1px solid rgba(255,255,255,0.32);
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 11.5px;
    color: rgba(255,255,255,0.9);
    letter-spacing: 0.02em;
  }
  .splash-foot strong { color: #fff; font-weight: 700; }

  /* LIVE NET VIEWPORT ON THE PINK GROUND */
  .hero-stage {
    display: flex;
    flex-direction: column;
    border: 2px solid #000;
    border-radius: 0;
    overflow: hidden;
    background: #fff;
    color: #000;
    height: min(540px, 74svh);
    min-height: 390px;
  }
  .hero-stage-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 7px 10px;
    border-bottom: 1.5px solid #000;
    background: #fff;
    color: #000;
    font-family: var(--mono);
    font-size: 11.5px;
  }
  .stage-tabs { display: flex; gap: 4px; flex-wrap: wrap; }
  .stage-tab {
    font-family: var(--mono);
    font-size: 11.5px;
    padding: 4px 9px;
    border-radius: 0;
    border: 1px solid transparent;
    background: transparent;
    color: #555;
    cursor: pointer;
  }
  .stage-tab:hover { color: #000; border-color: #000; }
  .stage-tab.on { background: #000; border-color: #000; color: #fff; font-weight: 700; }
  .stage-ext { color: #000; font-weight: 700; white-space: nowrap; }
  .stage-ext:hover { color: #ff0a94; }
  .hero-stage iframe { width: 100%; flex: 1; min-height: 320px; border: 0; display: block; background: #fff; }

  .hx-wrap { max-width: 1240px; margin: 0 auto; padding: 0 24px 72px; }

  .btn { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 12.5px; font-weight: 700; padding: 10px 15px; border-radius: 0; border: 1.5px solid var(--line-strong); background: var(--surface); color: var(--fg); transition: border-color 0.12s, background 0.12s, color 0.12s; cursor: pointer; }
  .btn:hover { background: var(--fg); color: var(--bg); }
  .btn-primary { background: var(--pink); border-color: var(--pink); color: #fff; }
  .btn-primary:hover { background: #000; border-color: #000; color: #fff; }
  .btn-blue { background: var(--blue-soft); border-color: var(--blue-line); color: var(--blue); }
  .btn-blue:hover { background: var(--blue); border-color: var(--blue); color: #fff; }

  /* TELEMETRY RIBBON */
  .telemetry { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0; margin-top: 28px; border: 1.5px solid var(--line-strong); }
  .t-card { display: flex; flex-direction: column; gap: 4px; padding: 14px 14px; border-right: 1px solid var(--line); background: var(--surface); transition: background 0.12s; }
  .t-card:last-child { border-right: 0; }
  .t-card:hover { background: var(--pink-soft); }
  .t-val { font-family: var(--mono); font-size: 1.05rem; font-weight: 800; letter-spacing: -0.02em; color: var(--fg); }
  .t-val.pink { color: var(--pink); }
  .t-val.blue { color: var(--blue); }
  .t-lbl { font-family: var(--mono); font-size: 11px; font-weight: 700; color: var(--fg); }
  .t-sub { font-family: var(--mono); font-size: 10.5px; color: var(--dim); line-height: 1.35; }

  /* SECTION HEADERS */
  .band { padding: 44px 0 38px; border-bottom: 1px solid var(--line); }
  .band-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 22px; flex-wrap: wrap; }
  .band-kicker { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--pink); margin-bottom: 6px; font-weight: 700; }
  .band h2 { font-family: var(--mono); font-size: clamp(1.35rem, 2.2vw, 1.85rem); letter-spacing: -0.03em; margin: 0; font-weight: 700; line-height: 1.15; }
  .band-desc { font-size: 0.96rem; color: var(--muted); max-width: 60ch; margin: 8px 0 0; line-height: 1.52; }

  /* ROLE ROUTER */
  .lens-bar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .lens-btn { font-family: var(--mono); font-size: 12px; font-weight: 700; padding: 9px 14px; border-radius: 0; border: 1.5px solid var(--line-strong); background: var(--surface); color: var(--fg); cursor: pointer; transition: all 0.12s; }
  .lens-btn:hover { border-color: var(--pink); color: var(--pink); }
  .lens-btn.on { background: var(--pink); border-color: var(--pink); color: #fff; }
  .lens-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .lens-step { display: flex; flex-direction: column; gap: 8px; padding: 18px; border: 1.5px solid var(--line); border-radius: 0; background: var(--surface); transition: border-color 0.12s; }
  .lens-step:hover { border-color: var(--pink); }
  .lens-num { font-family: var(--mono); font-size: 11px; font-weight: 700; color: var(--pink); letter-spacing: 0.06em; }
  .lens-title { font-family: var(--mono); font-size: 1rem; font-weight: 700; letter-spacing: -0.02em; }
  .lens-text { font-size: 0.9rem; color: var(--muted); line-height: 1.5; flex: 1; }
  .lens-go { font-family: var(--mono); font-size: 11.5px; font-weight: 700; color: var(--fg); }
  .lens-step:hover .lens-go { color: var(--pink); }

  /* 3 FLAGSHIP TEXTBOOKS */
  .flag-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .flag-card { display: flex; flex-direction: column; padding: 22px; border: 1.5px solid var(--line-strong); border-radius: 0; background: var(--surface); position: relative; transition: border-color 0.12s, background 0.12s; }
  .flag-card:hover { border-color: var(--pink); background: var(--pink-soft); }
  .flag-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; font-family: var(--mono); font-size: 11px; }
  .flag-badge { padding: 3px 8px; border-radius: 0; font-weight: 700; background: var(--pink); color: #fff; border: 1px solid var(--pink); }
  .flag-badge.blue { background: #000; color: #fff; border-color: #000; }
  html.dark .flag-badge.blue { background: #fff; color: #000; border-color: #fff; }
  .flag-stats { color: var(--dim); }
  .flag-card h3 { font-family: var(--mono); font-size: 1.18rem; letter-spacing: -0.025em; margin: 0 0 10px; line-height: 1.22; }
  .flag-card p { font-size: 0.92rem; color: var(--muted); line-height: 1.55; margin: 0 0 16px; flex: 1; }
  .flag-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
  .flag-tags span { font-family: var(--mono); font-size: 10.5px; color: var(--fg); background: var(--surface2); border: 1px solid var(--line); padding: 3px 7px; border-radius: 0; }
  .flag-foot { font-family: var(--mono); font-size: 12px; font-weight: 700; color: var(--pink); display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid var(--line); }

  /* INTERACTIVE GEODESIC EXPLORER */
  .geo-shell { display: grid; grid-template-columns: 310px minmax(0, 1fr); gap: 18px; align-items: stretch; }
  .geo-layers { display: flex; flex-direction: column; gap: 6px; }
  .geo-btn { text-align: left; padding: 10px 12px; border: 1px solid var(--line); border-radius: 0; background: var(--surface); cursor: pointer; transition: all 0.12s; display: flex; flex-direction: column; gap: 2px; }
  .geo-btn:hover { border-color: var(--line-strong); }
  .geo-btn.on { border-color: var(--pink); background: var(--pink-soft); border-left: 3px solid var(--pink); }
  .geo-btn .g-k { font-family: var(--mono); font-size: 10px; color: var(--dim); letter-spacing: 0.05em; text-transform: uppercase; }
  .geo-btn.on .g-k { color: var(--pink); }
  .geo-btn .g-t { font-family: var(--mono); font-size: 12.5px; font-weight: 700; color: var(--fg); }
  .geo-btn .g-m { font-family: var(--mono); font-size: 10.5px; color: var(--muted); }

  .geo-view { border: 1.5px solid var(--line-strong); border-radius: 0; background: var(--surface); overflow: hidden; display: flex; flex-direction: column; }
  .geo-canvas-wrap { position: relative; height: 270px; border-bottom: 1px solid var(--line); background: var(--bg); }
  .geo-canvas-wrap canvas { width: 100%; height: 100%; display: block; }
  .geo-body { padding: 18px 20px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
  .geo-hdr { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
  .geo-hdr h3 { font-family: var(--mono); margin: 0; font-size: 1.12rem; letter-spacing: -0.02em; }
  .geo-mod { font-family: var(--mono); font-size: 11px; color: var(--pink); background: var(--pink-soft); border: 1px solid var(--pink-line); padding: 4px 8px; border-radius: 0; }
  .geo-desc { margin: 0; font-size: 0.93rem; color: var(--muted); line-height: 1.55; }
  .geo-term { font-family: var(--mono); font-size: 11.5px; line-height: 1.5; background: var(--bg); border: 1px solid var(--line); border-radius: 0; padding: 11px 13px; color: var(--fg); overflow-x: auto; white-space: pre; }
  .geo-term .p { color: var(--pink); }
  .geo-term .g { color: var(--green); }
  .geo-term .d { color: var(--dim); }
  .geo-actions { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: auto; }

  /* FRONTIER DOMAINS GRID */
  .dom-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .dom-card { display: flex; flex-direction: column; gap: 8px; padding: 18px 20px; border: 1.5px solid var(--line); border-radius: 0; background: var(--surface); transition: border-color 0.12s; }
  .dom-card:hover { border-color: var(--pink); }
  .dom-tag { font-family: var(--mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--pink); font-weight: 700; }
  .dom-card h3 { font-family: var(--mono); margin: 0; font-size: 1.04rem; letter-spacing: -0.02em; }
  .dom-card p { margin: 0; font-size: 0.89rem; color: var(--muted); line-height: 1.5; flex: 1; }
  .dom-go { font-family: var(--mono); font-size: 11.5px; font-weight: 700; color: var(--fg); padding-top: 6px; }
  .dom-card:hover .dom-go { color: var(--pink); }

  /* SEARCH & ARCHIVE BAR */
  .vault { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 18px; align-items: center; padding: 28px 0 0; }
  .vault-search { display: flex; gap: 8px; }
  .vault-search input { flex: 1; min-width: 200px; font-family: var(--mono); font-size: 13px; padding: 11px 14px; border-radius: 0; border: 1.5px solid var(--line-strong); background: var(--surface); color: var(--fg); outline: none; }
  .vault-search input:focus { border-color: var(--pink); }
  .vault-links { display: flex; flex-wrap: wrap; gap: 10px; font-family: var(--mono); font-size: 12px; }
  .vault-links a { padding: 9px 13px; border: 1.5px solid var(--line); border-radius: 0; background: var(--surface); color: var(--fg); font-weight: 600; }
  .vault-links a:hover { border-color: var(--pink); color: var(--pink); }

  @media (max-width: 1040px) {
    .splash { grid-template-columns: 1fr; min-height: auto; padding: 40px 20px; }
    .hero-stage { height: 420px; }
    .telemetry { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .t-card { border-bottom: 1px solid var(--line); }
    .flag-grid, .dom-grid, .lens-grid { grid-template-columns: 1fr; }
    .geo-shell { grid-template-columns: 1fr; }
    .vault { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .telemetry { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hx-wrap { padding: 0 16px 56px; }
  }
</style>
</head>
<body>
