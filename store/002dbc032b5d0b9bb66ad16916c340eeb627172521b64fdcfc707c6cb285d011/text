dm-run : Step W Unit
dm-run =
  to-step
    (bind (h-env "HX_DIAMOND_SYNC_ROOT") (λ eSync →
      case eSync of
        inr sr → bind (dm-sync-kg-root sr) (λ u0 → exit #0)
        inl u1 →
          bind (h-env "HX_DIAMOND_CMD") (λ eCmd →
            case eCmd of
              inr c →
                if h-eq c "daemon"
                then dm-start-daemon
                else bind (dm-execute (orB (h-eq c "hyperactivate") (h-eq c "strike"))) (λ u2 → exit #0)
              inl u3 →
                bind h-args (λ av →
                  if dm-is-direct av
                  then bind (dm-execute (dm-is-live-arg (h-tail-lists av))) (λ u4 → exit #0)
                  else ret {lzero} {W} unit))))
