-- an expression whose interval lies in [0, 1] has every exact value in [0, 1]
tail-inv-r : (S : List Bool) → (W : IV) → (w : ZQ) → bcanon S ≡ true → ivc W × encl S W (fst w) (snd w) → iv-within S W (iv-unit S) ≡ true → uni S w
tail-inv-r S W w cS R hw = encl-within S W (iv-unit S) (fst w) (snd w) (fst R) (unit-canon S cS) hw (snd R)
