-- every entry of the image matches −½(75^{1/8} − 3^{1/8}) times the image under 2J_z^{(e)}
triad-row-ok : List (List PRad) → List SQ → Bool
triad-row-ok ts js = case ts of
  nil → true
  cons t rest → (case js of nil → false; cons x jrest → (if prads-eq t (p-scale (sq-neg x) tet-lambda) then triad-row-ok rest jrest else false))
