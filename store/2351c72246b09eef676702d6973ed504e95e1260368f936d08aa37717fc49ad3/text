-- Apply CNOT(ctrl, tgt) on 3-qubit statevector
q-apply-cx : Word → Word → QState3 → QState3
q-apply-cx c t (qs3 s0 s1 s2 s3 s4 s5 s6 s7) =
  if web-andB (%weq c #0) (%weq t #1) then qs3 s0 s3 s2 s1 s4 s7 s6 s5
  else if web-andB (%weq c #0) (%weq t #2) then qs3 s0 s5 s2 s7 s4 s1 s6 s3
  else if web-andB (%weq c #1) (%weq t #2) then qs3 s0 s1 s6 s7 s4 s5 s2 s3
  else if web-andB (%weq c #1) (%weq t #0) then qs3 s0 s1 s3 s2 s4 s5 s7 s6
  else if web-andB (%weq c #2) (%weq t #0) then qs3 s0 s1 s2 s3 s5 s4 s7 s6
  else if web-andB (%weq c #2) (%weq t #1) then qs3 s0 s1 s2 s3 s6 s7 s4 s5
  else qs3 s0 s1 s2 s3 s4 s5 s6 s7
