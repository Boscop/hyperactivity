kvl-merge : (x : NodeId × KvWrite) → (u : (List (NodeId × KvWrite))) → (chs : AdvSeq) → (g0 : KvG) →
            (a : (T : Nat) × InL {KvWrite} (snd x) (kv-app (fst x) (fleet-at {KvMsg} {KvSt} kv-bc-beh chs g0 T))) → (ih : (T : Nat) × KvAllApp u (fleet-at {KvMsg} {KvSt} kv-bc-beh chs g0 T)) →
            (T : Nat) × KvAllApp (cons x u) (fleet-at {KvMsg} {KvSt} kv-bc-beh chs g0 T)
kvl-merge x u chs g0 a ih =
  (nt-later (fst ih) (fst a) ,
   (kv-app-later (fst x) (snd x) chs g0 (fst ih) (fst a) (snd a) ,
    subst {lzero} {lzero} {Nat} {λ T → KvAllApp u (fleet-at {KvMsg} {KvSt} kv-bc-beh chs g0 T)} (nt-later-comm (fst a) (fst ih)) (kvl-all-later u chs g0 (fst a) (fst ih) (snd ih))))
