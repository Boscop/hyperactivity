-- a product by (c, 0) is a scaling
zmul-zsc : (x : Nat × Nat) → (c : Nat) → zmul x (c , zero) ≡ zsc x c
zmul-zsc x c = pairNN (plus (times (fst x) c) (times (snd x) zero)) (plus (times (fst x) zero) (times (snd x) c)) (times (fst x) c) (times (snd x) c)
  (transN (congN (plus (times (fst x) c)) (times-zero (snd x))) (plus-zero (times (fst x) c)))
  (congN (λ z → plus z (times (snd x) c)) (times-zero (fst x)))
