std-post : Target → (c : MemC) → m-resp c → AMem → MRes ATI
std-post t c = case c return (λ y → m-resp y → AMem → MRes ATI) of
  m-alloc kd z size al → λ r s → post-alloc t kd z size al r s
  m-release kd p → λ r s → mok (tb-kill (am-table s) (mp-address p) , am-init s)
  m-free p → λ r s → mok (tb-kill (am-table s) (mp-address p) , am-init s)
  m-load k al p → λ r s → mok (am-ti s)
  m-store k al p v → λ r s → mok (am-table s , in-set (am-init s) (mp-address p) (sk-size t k) true)
  m-ptr-add p e i → λ r s → mok (am-ti s)
  m-ptr-diff p q e → λ r s → mok (am-ti s)
  m-ptr-cmp o p q → λ r s → mok (am-ti s)
  m-ptr-int sg w p → λ r s → mok (am-ti s)
  m-int-ptr sg w v → λ r s → mok (am-ti s)
  m-memmove d sr n → λ r s → mok (am-table s , in-move (am-init s) (mp-address d) (mp-address sr) n)
  m-memcpy d sr n → λ r s → mok (am-table s , in-move (am-init s) (mp-address d) (mp-address sr) n)
  m-memset d v n → λ r s → mok (am-table s , in-set (am-init s) (mp-address d) n true)
