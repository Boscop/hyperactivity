-- Universal workgroup decomposition theorem: splitting a batch across arbitrary GPU threadgroups
-- `wg0` and `wg1` produces the exact same sequence of normal-form payloads as reducing the whole batch.
gpu-batch-commutes : (wg0 wg1 : Lst GpuPair) → gpu-reduce-batch (l-app wg0 wg1) ≡ l-app (gpu-reduce-batch wg0) (gpu-reduce-batch wg1)
gpu-batch-commutes lnil wg1 = refl
gpu-batch-commutes (lcons p r) wg1 = cong (lcons (gpu-eval-pair p)) (gpu-batch-commutes r wg1)
