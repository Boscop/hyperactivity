-- leucine in the numeric encoding, over its carbon-bound hydrogens, numbered as in the worked encoding:
-- 5 the alpha hydrogen, 10 and 11 the beta pair, 13 the gamma hydrogen, 15 to 17 and 19 to 21 the two
-- methyls
num-leu-obs : List Nat
num-leu-obs = cons 5 (cons 10 (cons 11 (cons 13 (cons 15 (cons 16 (cons 17 (cons 19 (cons 20 (cons 21 nil)))))))))
