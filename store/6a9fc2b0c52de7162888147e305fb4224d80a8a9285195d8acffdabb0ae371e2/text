-- any transition in the added flow s2 creates a path in the refined basin
basin-refine-new : {S : Type 0} {s1 s2 : S → S → Bool}
                 → (a b : S) → isTrue (s2 a b)
                 → basin-of S (step-or s1 s2) a ≡ basin-of S (step-or s1 s2) b
basin-refine-new {S} {s1} {s2} a b p =
  λ i → basin-step a b (orB-inr (s1 a b) (s2 a b) p) i
