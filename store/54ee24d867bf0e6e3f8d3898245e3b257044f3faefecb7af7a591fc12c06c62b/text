-- rewrite-first-path r t: the first position in pre-order where the rule applies, rewritten, with
-- the path λ i → t[(g σ) @ i at that position]; every untouched part is shifted by one for the
-- dimension binder (d the binder depth, so the hole's reference to the dimension is cvar d)
rewrite-first-path r t = case rfp r #0 t of none → none; some p → some (fst p , cplam (snd p))
