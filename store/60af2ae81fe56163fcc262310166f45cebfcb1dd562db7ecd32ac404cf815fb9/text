-- the paper kept fresh: lib/paper-view.cub runs when the latest change under the repository has moved past paper/stamp
hy-paper-ready : List Word → List Word → Proc W Word
hy-paper-ready st m =
  bind (hy-get st "paper/stamp") (λ s → bind (h-dir-time (toNat #12) ".") (λ now →
  if h-eq (hy-or nil s) (h-decimal now) then ret {lzero} {W} #0 else h-run (cons m (cons "lib/paper-view.cub" nil))))
