list-rev-acc-app : {A : Type} → (xs ys : List A) → list-rev-acc xs ys ≡ list-append (list-rev xs) ys
list-rev-acc-app {A} xs =
  case xs return (λ u → (ys : List A) → list-rev-acc u ys ≡ list-append (list-rev u) ys) of
    nil → λ ys i → ys
    cons x r → λ ys →
      concat {lzero} {List A} {list-rev-acc r (cons x ys)} {list-append (list-rev r) (cons x ys)} {list-append (list-rev-acc r (cons x nil)) ys}
        (rec r (cons x ys))
        (concat {lzero} {List A} {list-append (list-rev r) (cons x ys)} {list-append (list-append (list-rev r) (cons x nil)) ys} {list-append (list-rev-acc r (cons x nil)) ys}
          (sym (cm-append-assoc (list-rev r) (cons x nil) ys))
          (λ i → list-append (sym (rec r (cons x nil)) i) ys))
