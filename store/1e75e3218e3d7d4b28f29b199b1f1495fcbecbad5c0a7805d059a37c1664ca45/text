dcube-liftp : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (Z : Type 1) (k : (x : X) → F x → Z) (H : Z → Type 1) (l : (x : X) (y : Y x) (v : F' (f x y)) → H (k x (g x y v)))
  (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' F' (dcube-map n X Y X' f c d)) →
  DCube n Z H (dcube-map n X F Z k c (dcube-pull n X X' Y F F' f g c d e))
dcube-liftp zero X X' Y F F' f g Z k H l c d e = l c d e
dcube-liftp (suc n) X X' Y F F' f g Z k H l c d e =
  dcube-liftp n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g)
    (Line Z) (lineo-map X F Z k) (LineO Z H) (lineo-liftp X X' Y F F' f g Z k H l) c d e
