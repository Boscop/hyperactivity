nk-fits?-sound : (fx1 fx2 : NkFx) → (nk-fits? fx1 fx2 ≡ true) → nk-fits fx1 fx2
nk-fits?-sound nkf-nil fx2 h = unit
nk-fits?-sound (nkf-val w v r) fx2 h =
  let a = nk-off? w (nk-puts fx2)
      b = nk-off? w (nk-vals fx2)
      c = nk-fits? r fx2
  in ((nk-off?-sound w (nk-puts fx2) (nk-and-l a (nk-and b c) h) , nk-off?-sound w (nk-vals fx2) (nk-and-l b c (nk-and-r a (nk-and b c) h))) , nk-fits?-sound r fx2 (nk-and-r b c (nk-and-r a (nk-and b c) h)))
nk-fits?-sound (nkf-op w o r) fx2 h =
  let a = nk-off? w (nk-puts fx2)
      b = nk-off? w (nk-ops fx2)
      c = nk-fits? r fx2
  in ((nk-off?-sound w (nk-puts fx2) (nk-and-l a (nk-and b c) h) , nk-off?-sound w (nk-ops fx2) (nk-and-l b c (nk-and-r a (nk-and b c) h))) , nk-fits?-sound r fx2 (nk-and-r b c (nk-and-r a (nk-and b c) h)))
nk-fits?-sound (nkf-put w s r) fx2 h =
  let a = nk-off? w (nk-puts fx2)
      b = nk-off? w (nk-vals fx2)
      c = nk-off? w (nk-ops fx2)
      d = nk-fits? r fx2
      h2 = nk-and-r a (nk-and b (nk-and c d)) h
      h3 = nk-and-r b (nk-and c d) h2
  in ((nk-off?-sound w (nk-puts fx2) (nk-and-l a (nk-and b (nk-and c d)) h) , (nk-off?-sound w (nk-vals fx2) (nk-and-l b (nk-and c d) h2) , nk-off?-sound w (nk-ops fx2) (nk-and-l c d h3))) , nk-fits?-sound r fx2 (nk-and-r c d h3))
