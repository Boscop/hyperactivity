xp-plug : XpK → XpExpr → XpExpr
xp-plug xk-hole t = t
xp-plug (xk-plus-l k b) t = xp-plus (xp-plug k t) b
xp-plug (xk-plus-r a k) t = xp-plus a (xp-plug k t)
xp-plug (xk-pair-l k b) t = xp-pair (xp-plug k t) b
xp-plug (xk-pair-r a k) t = xp-pair a (xp-plug k t)
xp-plug (xk-fst k) t = xp-fst (xp-plug k t)
xp-plug (xk-snd k) t = xp-snd (xp-plug k t)
