-- Constants. rc-adt's fields are a list (rcs-nil / rcs-cons).
data RConst
  = rc-int (v : RInt) (k : RIntTy)
  | rc-bool (b : Bool)
  | rc-param (i : Word)                    -- a constant parameter of the enclosing body
  | rc-zst (ty : RTy)                      -- the one value of a zero-sized type
  | rc-adt (ty : RTy) (variant : Word) (fields : RConst)
  | rc-static (id : Word) (ty : RTy)       -- the address of a static, at pointer type ty
  | rc-fn (body : Word) (args : RTy)       -- a function item: a body of this crate at generic arguments
  | rcs-nil
  | rcs-cons (c : RConst) (cs : RConst)
