cs-for-loop-no-ub : (ev : CsHeap → CsEnv → CsExp → CsRes) (rem : Nat) (idx d : Word) (hp : CsHeap) (acc : CsVal) (env : CsEnv) (step : CsExp) →
  ((i : Word) (hpi : CsHeap) (acci : CsVal) → cs-no-ub (ev hpi (cs-env-push (%wsucc d) acci (cs-env-push d (csv-word i) env)) step) ≡ true) →
  cs-no-ub (cs-for-loop ev rem idx d hp acc env step) ≡ true
cs-for-loop-no-ub ev zero idx d hp acc env step hstep = refl
cs-for-loop-no-ub ev (suc rem) idx d hp acc env step hstep =
  cs-for-loop-step-no-ub (ev hp (cs-env-push (%wsucc d) acc (cs-env-push d (csv-word idx) env)) step)
    ev rem idx d env step (hstep idx hp acc)
    (λ hp1 acc1 → cs-for-loop-no-ub ev rem (%wsucc idx) d hp1 acc1 env step hstep)
