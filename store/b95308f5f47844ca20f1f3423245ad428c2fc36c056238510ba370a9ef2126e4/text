mach-step : {M X : Type} → (nx : X → Proc {lzero} (NetSig M) X) → (y : X) → (vx : NView M X) → MachStep {M} {X} nx y vx
mach-step {M} {X} nx y v-halt = λ i → v-halt
mach-step {M} {X} nx y (v-send to m s) = λ i → v-send to m (to-step {NetSig M} {X} (nx s))
mach-step {M} {X} nx y (v-recv k) = λ i → v-recv (λ r → to-step {NetSig M} {X} (nx (k r)))
mach-step {M} {X} nx y (v-now kn) = λ i → v-now (λ w → to-step {NetSig M} {X} (nx (kn w)))
mach-step {M} {X} nx y (v-tau s) = unit
