bn-thm-aup-guard-exact :
  let badRunpod = mk-bn-node "bad-pod" (bp-ssh-mesh false) bt-h200-sxm #4 br-zk-pouw-miner "213.181.104.219" #10166 #12000000
      okClore   = mk-bn-node "clore-01" bp-clore bt-rtx4090 #8 br-zk-pouw-miner "api.clore.ai" #22 #3200000
      okAkash   = mk-bn-node "akash-01" bp-akash bt-h100-sxm #4 br-zk-pouw-miner "akash-dseq" #22 #7600000
  in andB (eth-not (bn-node-aup-ok badRunpod))
          (andB (bn-node-aup-ok okClore) (bn-node-aup-ok okAkash)) ≡ true
