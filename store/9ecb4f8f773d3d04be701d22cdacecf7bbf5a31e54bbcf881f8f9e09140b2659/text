dcube-pull : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') →
  ((x : X) (y : Y x) → F' (f x y) → F x) → (c : Cube n X) (d : DCube n X Y c) → DCube n X' F' (dcube-map n X Y X' f c d) → DCube n X F c
dcube-pull zero X X' Y F F' f g c d e = g c d e
dcube-pull (suc n) X X' Y F F' f g c d e =
  dcube-pull n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g) c d e
