-- the view is the membership's: pools holding the same entries hold the same live entries
po-view-membership : {E : Type} → (es : List E) → (follows : E → E → Bool) → (p q : Pool E) → p ≡ q → po-live es follows p ≡ po-live es follows q
po-view-membership {E} es follows p q h = λ i → po-live es follows (h i)
