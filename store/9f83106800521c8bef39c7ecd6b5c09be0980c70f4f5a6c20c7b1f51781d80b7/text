dir-sound : (m : Model) (d : Bool) (σ : Subst) (eq : ETm × ETm) → tev m (tsubst σ (fst eq)) ≡ tev m (tsubst σ (snd eq)) →
            tev m (tsubst σ (lhs d eq)) ≡ tev m (tsubst σ (rhs d eq))
dir-sound m d σ eq h = case d return (λ w → tev m (tsubst σ (lhs w eq)) ≡ tev m (tsubst σ (rhs w eq))) of true → symw h; false → h
