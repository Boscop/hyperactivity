-- retype's pmap, at a cube and a coherence path
rt-pm : (Γ : CCtx) (a : TyShape) (U1 W : Type 1) (ty : U1 → Sem a) (w : (u : U1) → El a (ty u) → W) (Zq : Mean Γ (U1 × TV a)) →
  PathM Γ (Sem a) (fmapM Γ (U1 × TV a) (Sem a) (λ zq → fst (snd zq)) Zq) (fmapM Γ (U1 × TV a) (Sem a) (λ zq → ty (fst zq)) Zq) → Mean Γ W
rt-pm Γ a U1 W ty w Zq P =
  dcube-pmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (U1 × TV a)) (FbE (fst Γ) (Sem a)) (FbE (fst Γ) W) (λ xq zq ρq → fst (snd (zq ρq))) (λ xq zq ρq → ty (fst (zq ρq)))
    (λ xq zq Qq ρq → w (fst (zq ρq)) (el-tr a (Sem a) (λ yq → yq) (fst (snd (zq ρq))) (ty (fst (zq ρq))) (λ jq → Qq jq ρq) (snd (snd (zq ρq))))) (snd Γ) Zq P
