-- |a + b*zeta + c*i + d*zeta^3|^2 = (a^2+b^2+c^2+d^2) + sqrt(2)*(ab+bc+cd-da).
-- After 2 unnormalized H = sqrt(2)*H_unitary gates, unit amplitude has |amp|^2 = 4 and cross-term = 0.
z8-is-unit2 : Z8 → Bool
z8-is-unit2 (mk-z8 a b c d) =
  let norm0 = zi-add (zi-add (zi-mul a a) (zi-mul b b)) (zi-add (zi-mul c c) (zi-mul d d))
      cross = zi-add (zi-add (zi-mul a b) (zi-mul b c)) (zi-add (zi-mul c d) (zi-neg (zi-mul d a)))
  in web-andB (zi-eq norm0 zi-four) (zi-eq cross zi-zero)
