wl-m4 : List Word → List Word
wl-m4 tail =
  hw-ln "// Exp 4: Stiffness-10^12 Enzyme Catalysis + Thermal Protein Folding (65,536 mutant/T flasks)"
  (hw-ln "// E_u <-> E_nat + S <-> ES -> E_nat + P  |  Unconditionally positive, exact mass-conserving Patankar!"
  (hw-ln "kernel void wl_stiff_enzyme_fold("
  (hw-ln "  device float* out_prod     [[buffer(0)]],"
  (hw-ln "  device float* out_cons_err [[buffer(1)]],"
  (hw-ln "  uint tid [[thread_position_in_grid]]) {"
  (hw-ln "  // 128 temps (275..402K) x 512 stability/catalysis variants (Tm = 315..365K)"
  (hw-ln "  float T  = 275.0f + (float)(tid & 127u);"
  (hw-ln "  float Tm = 315.0f + 0.1f * (float)(tid >> 7u);"
  (hw-ln "  float RT = 8.3144626e-3f * T;"
  (hw-ln "  // Arrhenius catalysis (Ea = 52 kJ/mol) vs Gibbs-Helmholtz protein unfolding (dH_u = 280 kJ/mol)"
  (hw-ln "  float k1   = 1.0e8f; // diffusion-limited binding (10^12 stiffness vs slow turnover/folding!)"
  (hw-ln "  float km1  = 1.0e4f;"
  (hw-ln "  float kcat = 1.2e11f * exp(-52.0f / RT);"
  (hw-ln "  float dGu  = 280.0f * (1.0f - T / Tm);"
  (hw-ln "  float Ku   = exp(-clamp(dGu / RT, -40.0f, 40.0f)); // [Eu]/[E_nat]"
  (hw-ln "  float E0 = 1.0e-3f, S0 = 1.0f;"
  (hw-ln "  float E = E0 / (1.0f + Ku), Eu = E0 - E, ES = 0.0f, S = S0, P = 0.0f;"
  (hw-ln "  // 50 unconditionally positive implicit Patankar steps (dt = 0.02s -> stiffness k1*dt = 2e6!)"
  (hw-ln "  float dt = 0.02f;"
  (hw-ln "  for (int it = 0; it < 50; it++) {"
  (hw-ln "    // Exact quasi-steady implicit split of E_active = E + ES under folding ratio Ku"
  (hw-ln "    float Eact = E + ES;"
  (hw-ln "    float Km   = (km1 + kcat) / k1;"
  (hw-ln "    float ES_new = (Eact * S) / (Km + S);"
  (hw-ln "    float E_new  = Eact - ES_new;"
  (hw-ln "    float dP = (dt * kcat * ES_new) / (1.0f + dt * kcat * Eact / (Km + S + 1e-12f));"
  (hw-ln "    dP = clamp(dP, 0.0f, S);"
  (hw-ln "    S -= dP; P += dP; E = E_new; ES = ES_new;"
  (hw-ln "  }"
  (hw-ln "  float errE = fabs((E + ES + Eu) - E0);"
  (hw-ln "  float errS = fabs((S + P) - S0);"
  (hw-ln "  out_prod[tid]     = P;"
  (hw-ln "  out_cons_err[tid] = errE + errS;"
  (hw-ln "}" tail))))))))))))))))))))))))))))))))))
