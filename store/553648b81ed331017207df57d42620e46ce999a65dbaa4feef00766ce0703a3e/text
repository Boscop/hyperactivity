-- (a + b) + (c + d) = (a + c) + (b + d)
wadd-swap : (a b c d : Word) → wadd (wadd a b) (wadd c d) ≡ wadd (wadd a c) (wadd b d)
wadd-swap a b c d =
  catw (wadd-assoc a b (wadd c d))
    (catw (congw (λ z → wadd a z) (catw (symw (wadd-assoc b c d)) (catw (congw (λ z → wadd z d) (wadd-comm b c)) (wadd-assoc c b d))))
      (symw (wadd-assoc a c (wadd b d))))
