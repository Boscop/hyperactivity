acm-c : List Word
acm-c = emit-c-cli-opt (code acm-main)

acm-is-direct : List (List Word) → Bool
acm-is-direct nil         = false
acm-is-direct (cons a rs) =
  if h-eq a "--with" then
    (case rs of
      nil → false
      cons v rs2 →
        (case rs2 of
          nil → false
          cons r rs3 → acm-is-direct rs3))
  else if h-infix "hx-all-crypto-matrix" a then true
  else acm-is-direct rs

acm-run : Step W Unit
acm-run =
  tmc-step-bind-vm (to-step h-args) (λ av →
    if acm-is-direct av
    then tmc-step-bind-vm (acm-main nil) (λ rc → scmd (w-exit rc) (λ u → sdone unit))
    else sdone unit)

