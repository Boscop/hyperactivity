         mergedLaunch = acm-splice-between acm-start-tag acm-end-tag frag (snd rPrev)
     in scmd (w-file-write-named "/tmp/hy_out/hx_live_human_node.html" mergedNode) (λ bNode →
        scmd (w-file-write-named "/tmp/hy_out/hx_universal_launch.html" mergedLaunch) (λ bLaunch →
