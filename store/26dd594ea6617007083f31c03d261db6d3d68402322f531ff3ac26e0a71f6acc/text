acm-splice-between : List Word → List Word → List Word → List Word → List Word
acm-splice-between stTag enTag newFrag existing =
  if andB (h-infix stTag existing) (h-infix enTag existing)
  then let pre  = h-before stTag existing
           post = h-after enTag existing
       in list-append pre (list-append newFrag post)
  else if h-infix acm-v3-anchor existing
       then let pre  = h-before acm-v3-anchor existing
                post = h-after acm-v3-anchor existing
            in list-append pre (list-append newFrag (list-append acm-nl (list-append acm-v3-anchor post)))
  else if h-infix acm-cockpit-end existing
       then let pre  = h-before acm-cockpit-end existing
                post = h-after acm-cockpit-end existing
            in list-append pre (list-append acm-cockpit-end (list-append acm-nl (list-append newFrag post)))
       else list-append existing (list-append acm-nl newFrag)

