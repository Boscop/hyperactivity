-- Exact symmetry of all 49 hardware interaction pairs: delta(a, b) = delta(b, a)
inet-rule-sym-con : (b : INetKind) → Path Word (inet-rule-delta2 ik-con b) (inet-rule-delta2 b ik-con)
inet-rule-sym-con ik-free = refl
inet-rule-sym-con ik-con  = refl
inet-rule-sym-con ik-dup  = refl
inet-rule-sym-con ik-era  = refl
inet-rule-sym-con ik-num  = refl
inet-rule-sym-con ik-add  = refl
inet-rule-sym-con ik-add1 = refl
