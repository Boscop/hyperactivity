nonpos-ff : (m : List Bool) → (v : Bool) → (if v then true else not false) ≡ false → le (suc (bin-to-nat m)) zero
nonpos-ff m v = case v return λ u → (if u then true else not false) ≡ false → le (suc (bin-to-nat m)) zero of
  true → λ h → absurd-tf (le (suc (bin-to-nat m)) zero) h
  false → λ h → absurd-tf (le (suc (bin-to-nat m)) zero) h
