-- Compile ANY packed NAND2 witness (ng, prog) into a complete WASM function body!
-- Params: 0=w0, 1=w1, 2=w2; Locals: 3..(2+ng) = gate outputs w3..w(2+ng)
iw-fn-body : Word → Word → List Word
iw-fn-body ng prog =
  let locHdr = the (List Word) (cons #1 (cons ng (cons #127 nil)))
      gates  = iw-gate-code (toNat ng) #3 prog
      retOut = the (List Word) (cons #32 (cons (%wadd #2 ng) (cons #11 nil)))
      body   = io-cat (cons locHdr (cons gates (cons retOut nil)))
  in list-append (iw-uleb (iw-len body)) body
