bn-elf64-image : Word → List Word → List Word
bn-elf64-image eMachine mc =
  let totalSz = the Word (%wadd #120 (fromNat (list-length mc)))
      ehdr    = the (List Word)
                  (h-concat
                    (cons bn-elf-ident
                    (cons (bn-u16-le #2)
                    (cons (bn-u16-le eMachine)
                    (cons (bn-u32-le #1)
                    (cons (bn-u64-le #4194424)
                    (cons (bn-u64-le #64)
                    (cons (bn-u64-le #0)
                    (cons (bn-u32-le #0)
                    (cons (bn-u16-le #64)
                    (cons (bn-u16-le #56)
                    (cons (bn-u16-le #1)
                    (cons (bn-u16-le #0)
                    (cons (bn-u16-le #0)
                    (cons (bn-u16-le #0) nil)))))))))))))))
      phdr    = the (List Word)
                  (h-concat
                    (cons (bn-u32-le #1)
                    (cons (bn-u32-le #5)
                    (cons (bn-u64-le #0)
                    (cons (bn-u64-le #4194304)
                    (cons (bn-u64-le #4194304)
                    (cons (bn-u64-le totalSz)
                    (cons (bn-u64-le totalSz)
                    (cons (bn-u64-le #4096) nil)))))))))
  in list-append ehdr (list-append phdr mc)
