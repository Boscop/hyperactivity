cs-ltw-maxw : (a b : Word) → (if ltw b a then a else b) ≡ maxw a b
cs-ltw-maxw a b =
  %welimP (λ u → (v : Word) → (if ltw v u then u else v) ≡ maxw u v) a
    (λ v → cong (λ z → if z then #0 else v) (cs-ltw-zero v))
    (λ n hn v →
       %welimP (λ w → (if ltw w (%wsucc n) then %wsucc n else w) ≡ maxw (%wsucc n) w) v
         refl
         (λ m hm → cs-if-wsucc (ltw m n) n m ∙ cong (λ z → %wsucc z) (hn m)))
    b
