-- Compile a 4-tuple Hyperactivity table directly into a JavaScript array literal
pyth-js : List (List Word × (List Word × (List Word × List Word))) → List Word
pyth-js nil = nil
pyth-js (cons e r) = h-concat (
  cons "{n:'" (cons (fst e) (
  cons "',a:" (cons (fst (snd e)) (
  cons ",b:" (cons (fst (snd (snd e))) (
  cons ",r:'" (cons (snd (snd (snd e))) (
  cons "'}," (cons (pyth-js r) nil))))))))))
