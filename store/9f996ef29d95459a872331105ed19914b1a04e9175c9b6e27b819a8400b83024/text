-- nk-split denotation: splitting wire environment e allocates two fresh environments nk-sa and nk-sb
-- both denoting nk-env-ev rho e while preserving all wires below nk-n o
nk-split-bounds-cons : (w : NkW) (sp : NkSplit) (n0 : NkW) →
  (nk-wire-le n0 (nk-n (nk-so sp)) ≡ true) →
  (nk-ebound (nk-sa sp) (nk-n (nk-so sp)) ≡ true) →
  (nk-ebound (nk-sb sp) (nk-n (nk-so sp)) ≡ true) →
  (nk-wire-le n0 (nk-n (nk-so (nk-split-cons w sp))) ≡ true)
  × ((nk-ebound (nk-sa (nk-split-cons w sp)) (nk-n (nk-so (nk-split-cons w sp))) ≡ true)
     × (nk-ebound (nk-sb (nk-split-cons w sp)) (nk-n (nk-so (nk-split-cons w sp))) ≡ true))
nk-split-bounds-cons w (nk-split-r a b (nk-out fx n ws)) n0 ple ha hb =
  let n1 = nk-s n
      n2 = nk-s n1
      nn2 = nk-wire-le-trans n n1 n2 (nk-wire-le-s n) (nk-wire-le-s n1)
      nlt2 = nk-wire-lt-wle-trans n n1 n2 (nk-wire-lt-s n) (nk-wire-le-s n1)
      ha2 = nk-and-intro (nk-wire-lt n n2) (nk-ebound a n2) nlt2 (nk-ebound-up n n2 a nn2 ha)
      hb2 = nk-and-intro (nk-wire-lt n1 n2) (nk-ebound b n2) (nk-wire-lt-s n1) (nk-ebound-up n n2 b nn2 hb)
  in (nk-wire-le-trans n0 n n2 ple nn2 , (ha2 , hb2))
