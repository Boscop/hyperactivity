-- Signed arithmetic right shift by 1 in 16-bit audio range (offset-binary safe via 32-bit)
-- Forward Haar lifting: d = b - a (mod 2^32), s = a + (d >>> 1) (mod 2^32)
-- Inverse Haar lifting: a = s - (d >>> 1) (mod 2^32), b = a + d (mod 2^32)
w32-asr1 : Word → Word
w32-asr1 d =
  let u = w32 d
  in if %wlt u #2147483648 then %wshr u #1
     else %wor (%wshr u #1) #2147483648
