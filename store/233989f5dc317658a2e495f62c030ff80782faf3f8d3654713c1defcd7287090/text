lg-sq-mul : (u x : Word) → wsq (mulw u x) ≡ mulw (wsq u) (wsq x)
lg-sq-mul u x =
  catw (lg-mulw-assoc u x (mulw u x))
    (catw (congw (λ z → mulw u z)
            (catw (symw (lg-mulw-assoc x u x))
              (catw (congw (λ z → mulw z x) (lg-mulw-comm x u))
                (lg-mulw-assoc u x x))))
      (symw (lg-mulw-assoc u u (wsq x))))
