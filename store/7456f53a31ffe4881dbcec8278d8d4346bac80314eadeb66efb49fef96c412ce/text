-- the rows. Eliminators: 0 apply, 1 increment, 2 case, 3 induction, 4 force, 5 the reversal of an
-- interval point, 8 a path at a point, its arguments the path and its two ends, 11 and 12 word
-- operations, 13 word recursion. Constructors 10 and 11 are the ends of the interval.
-- apply meets a closure: its body, the argument first. Increment meets a number: the next number.
-- Case meets constructor c: the body of branch c, the fields bound. Reversal meets an end: the
-- other end. A path at an end of the interval: that end of the path, the path not read. A path at
-- a point that is blocked: the path applied to it. First (9) and second (10) meet a pair: that part
nk-act0 : Word → NkTm → NkHd → NkEnv → NkAct
nk-act0 h cs (hd-clo b) parts = if %weq h #0 then act-ap b else act-none
nk-act0 h cs (hd-susp b) parts = if %weq h #4 then act-ap b else act-none
nk-act0 h cs (hd-num m) parts =
  if %weq h #1 then act-hd (hd-num (%wsucc m))
  else (if %weq h #11 then act-ap (nk-match #12 (nk-branch cs #1) (nk-cons (nk-branch cs #0) (nk-cons (nk-num m) nk-nil)))
  else (if %weq h #12 then act-hd (nk-wop-hd (nk-code (nk-branch cs #0)) (nk-code (nk-branch cs #1)) m)
  else (if %weq h #13 then (if %weq m #0 then act-ap (nk-force (nk-branch cs #1)) else act-ap (nk-app (nk-app (nk-force (nk-branch cs #2)) (nk-num (%wsub m #1))) (nk-match #13 (nk-num (%wsub m #1)) cs)))
  else act-none)))
nk-act0 h cs (hd-con c) parts =
  if %weq h #2 then act-rp (nk-strip (nk-branch cs c) parts)
  else (if %weq h #3 then (if nk-is-dcon c then act-rp (nk-elim-body cs (nk-dc-k c)) else act-none)
  else (if %weq h #9 then (if %weq c #0 then act-rp (nk-var #1) else act-stuck)
  else (if %weq h #10 then (if %weq c #0 then act-rp (nk-var #0) else act-stuck)
  else (if %weq h #8 then (if (if %weq c #10 then true else %weq c #11) then act-ap (nk-var (if %weq c #10 then #1 else #2)) else act-none)
  else act-none))))
nk-act0 h cs hd parts = if %weq h #8 then (if nk-blocked hd then act-self (nk-app (nk-var #1) (nk-var #0)) else act-none) else act-none
