sv-hn16-part2 : List Word
sv-hn16-part2 =
  sv-lines
    (cons "  assign can_offer      = (dq_len >= 4'd2);"
    (cons "  assign offer_flit     = dq[0];"
    (cons "  assign want_steal     = (dq_len == 4'd0) && (rx_q_len == 3'd0) && !net_tx_valid;"
    (cons "  assign free_cells_out = free_sp;"
    (cons "  assign free_vars_out  = vfree_sp;"
    (cons "  assign busy_out       = (dq_len != 4'd0) || (rx_q_len != 3'd0) || out_tx_valid || out_ret_valid || root_hit;"
    (cons "  wire [2:0]  top_idx = (dq_len == 4'd0) ? 3'd0 : (dq_len[2:0] - 3'd1);"
    (cons "  wire [51:0] cur     = dq[top_idx];"
    (cons "  wire [2:0]  rk      = cur[51:49];"
    (cons "  wire        is_mul  = cur[48];"
    (cons "  wire [6:0]  cid     = cur[47:41];"
    (cons "  wire [7:0]  dst     = cur[40:33];"
    (cons "  wire [1:0]  pa = cur[32:31], na = cur[30:29], pb = cur[28:27], nb = cur[26:25];"
    (cons "  wire        conf    = |((pa | pb) & (na | nb));"
    (cons "  wire [10:0] ahi     = cur[20:10];"
    (cons "  wire [9:0]  alo     = cur[9:0];"
    (cons "  wire [2:0]  t_dep   = cur[22:20];"
    (cons "  wire        cptr    = cur[20];"
    (cons "  wire [2:0]  nq_r    = cur[22:20];"
    (cons "  wire [4:0]  nq_cols = cur[19:15];"
    (cons "  wire [4:0]  nq_dl   = cur[14:10];"
    (cons "  wire [4:0]  nq_dr   = cur[9:5];"
    (cons "  wire [4:0]  nq_mask = cur[4:0];"
    (cons "  wire [4:0]  nq_avail = 5'b11111 & ~(nq_cols | nq_dl | nq_dr) & nq_mask;"
    (cons "  wire [4:0]  nq_lsb   = nq_avail & (~nq_avail + 5'd1);"
    (cons "  wire [4:0]  nq_rem_m = nq_avail ^ nq_lsb;"
    (cons "  wire        nq_zero  = (nq_avail == 5'd0);"
    (cons "  wire        nq_done  = !nq_zero && (nq_r == 3'd4);"
    (cons "  wire        nq_one   = !nq_zero && !nq_done && (nq_rem_m == 5'd0);"
    (cons "  wire        nq_fork  = !nq_zero && !nq_done && (nq_rem_m != 5'd0);"
    (cons "  wire        step_emits_tx = (dq_len != 4'd0) && (conf || rk == 3'd1 || rk == 3'd2 || rk == 3'd6 || (rk == 3'd5 && (nq_zero || nq_done)));"
    (cons "  wire        rx_emits_ret  = net_tx_valid && !var_valid[net_tx_vid[6:4]] && (net_tx_src_cid[3:0] != TILE_ID);"
    (cons "  wire        can_step_dq   = (dq_len != 4'd0) && !(step_emits_tx && ((!dst[7] && tx_busy) || (dst[7] && cid[3:0] != TILE_ID && (ret_busy || rx_emits_ret))))"
    (cons "                              && !((rk == 3'd3 || rk == 3'd4 || (rk == 3'd5 && nq_fork)) && !conf && ((free_sp == 4'd0 && !net_ret_valid) || vfree_sp == 4'd0 || dq_len >= 4'd7));"
    (cons "  wire        do_split    = active && !quiescent && can_step_dq && !conf && (rk == 3'd3 || rk == 3'd4 || (rk == 3'd5 && nq_fork));"
    (cons "  wire [6:0]  popped_cid  = net_ret_valid ? net_ret_cid : free_stk[free_sp - 4'd1];"
    (cons "  wire [2:0]  popped_vidx = vfree_stk[vfree_sp - 4'd1];"
    (cons "  wire [7:0]  minted_vid  = {1'b0, popped_vidx, TILE_ID};"
    (cons "  wire [15:0] cls_word = cell_sram[cptr];"
    (cons "  wire [15:0] cls_res  = cls_word[15] ? ({6'd0, alo} * {1'b0, cls_word[14:0]}) : ({6'd0, alo} + {1'b0, cls_word[14:0]});"
    (cons "  wire [15:0] alu_res  = is_mul ? ({6'd0, alo} * {5'd0, ahi}) : ({6'd0, alo} + {5'd0, ahi});"
    (cons "  wire [9:0]  t_step   = (t_dep == 3'd4) ? 10'd8 : ((t_dep == 3'd3) ? 10'd4 : 10'd2);"
    (cons "  wire [51:0] dup_c0  = {3'd6, 1'b0, cid,        minted_vid, 8'h00, 4'd0, cptr, 10'd0, alo};"
    (cons "  wire [51:0] dup_c1  = {3'd1, 1'b1, popped_cid, minted_vid, 8'h00, 15'd0, {9'd0, cptr}};"
    (cons "  wire [51:0] tl_c0   = {3'd1, 1'b0, cid,        minted_vid, 8'h00, 15'd0, alo};" nil)))))))))))))))))))))))))))))))))))))))))))))
