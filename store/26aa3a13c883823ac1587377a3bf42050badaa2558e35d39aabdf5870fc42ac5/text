-- ce-q: a word's decimal digits onto acc, k digits at most. The library has no decimal printer at
-- this point (h-decimal is the command line's), and the library's own check failed on that
ce-q : Nat → Word → List Word → List Word
ce-q zero w acc = acc
ce-q (suc k) w acc = if %wlt w #10 then cons (%wadd w #48) acc else ce-q k (%wdiv w #10) (cons (%wadd (%wsub w (%wmul (%wdiv w #10) #10)) #48) acc)
