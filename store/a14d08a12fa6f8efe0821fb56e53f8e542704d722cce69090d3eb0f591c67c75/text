atree-cat-eval : {A : Type} → (op : A → A → A) → ((x y z : A) → op (op x y) z ≡ op x (op y z)) →
  (l r : ATree A) → atree-eval op (atree-cat l r) ≡ op (atree-eval op l) (atree-eval op r)
atree-cat-eval op assoc (aleaf a) r = refl
atree-cat-eval op assoc (anode l m) r =
  concat (λ i → op (atree-eval op l) (atree-cat-eval op assoc m r i))
    (sym (assoc (atree-eval op l) (atree-eval op m) (atree-eval op r)))
