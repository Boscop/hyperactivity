cf-frame-enc : Nat → (Word × List Word) → List Word
cf-frame-enc n st0 =
  let wb = word-to-bytes-go (cf-fuel n) (fst st0)
      bs = fst wb
      rem = snd wb
      ov = snd st0
  in if andB (weq rem #0) (cm-list-is-nil ov) then
       cons #0 (list-append (pf-enc pf-nat n) bs)
     else
       cons #1 (list-append (pf-enc pf-nat n)
                 (list-append (pf-enc pf-word rem)
                   (list-append (pf-enc (pf-list pf-word) ov) bs)))
