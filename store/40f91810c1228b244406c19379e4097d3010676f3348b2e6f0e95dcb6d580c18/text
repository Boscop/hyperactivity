kvl-claim : (u : (List (NodeId × KvWrite))) → (chs : AdvSeq) → (g0 : KvG) → Fair {KvMsg} {KvSt} 4 kv-bc-beh chs g0 → KvAllRep u → (t : Nat) →
            Path (List (NodeId × KvWrite)) (kv-out (fleet-at {KvMsg} {KvSt} kv-bc-beh chs g0 t)) u → (T : Nat) × KvAllApp u (fleet-at {KvMsg} {KvSt} kv-bc-beh chs g0 T)
kvl-claim nil chs g0 fair ar t e = (t , unit)
kvl-claim (cons x u) chs g0 fair ar t e =
  kvl-claim-c x u chs g0 fair (fst ar) (kvl-client chs g0 fair t (fst x) (snd x) u e) (λ t2 e2 → kvl-claim u chs g0 fair (snd ar) t2 e2)
