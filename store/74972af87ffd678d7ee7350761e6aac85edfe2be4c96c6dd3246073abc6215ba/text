bool-iff : {b c : Bool} → (isTrue b → isTrue c) → (isTrue c → isTrue b) → b ≡ c
bool-iff f g =
  (case b return λ y → (isTrue y → isTrue c) → (isTrue c → isTrue y) → y ≡ c of
     true → λ f g → (case c return λ z → (isTrue true → isTrue z) → true ≡ z of true → λ f i → true; false → λ f → Empty-rec (f unit)) f
     false → λ f g → (case c return λ z → (isTrue z → isTrue false) → false ≡ z of true → λ g → Empty-rec (g unit); false → λ g i → false) g) f g
