nk-plan-pair-at : (b : Bool) (v : NkVal) (o : NkOp) (u n : Word) (a c : NkSlots) → (nk-get a (nk-rw-pair b v u) ≡ nk-get c (nk-rw-pair b v u)) → nk-plan-pair b v o u n a ≡ nk-plan-pair b v o u n c
nk-plan-pair-at true (nkv-ref w) o u n a c h = cong (λ z → nk-plan-read z o u n) h
nk-plan-pair-at true (nkv-lam b e) o u n a c h = refl
nk-plan-pair-at true (nkv-num m) o u n a c h = refl
nk-plan-pair-at true (nkv-var x) o u n a c h = refl
nk-plan-pair-at true (nkv-napp f d) o u n a c h = refl
nk-plan-pair-at true (nkv-ninc d) o u n a c h = refl
nk-plan-pair-at false v o u n a c h = refl
