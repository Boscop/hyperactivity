-- occurrences of metavariable m (cvar m at pattern depth 0, cvar (m + d) under d binders) in a code
mv-count m d c =
  case c of
    cvar n → if %weq n (%wadd m d) then #1 else #0
    clam x → mv-count m (%wsucc d) x
    capp f a → %wadd (mv-count m d f) (mv-count m d a)
    cpair a b → %wadd (mv-count m d a) (mv-count m d b)
    cfst p → mv-count m d p
    csnd p → mv-count m d p
    clet a b → %wadd (mv-count m d a) (mv-count m (%wsucc d) b)
    ccon dd k fs ds → %wadd (mv-list m d fs) (mv-list m d ds)
    ccase dd B x → %wadd (mv-list m d B) (mv-count m d x)
    celim dd P B x → %wadd (mv-count m d P) (%wadd (mv-list m d B) (mv-count m d x))
    cforce x → mv-count m d x
    cthunk x → mv-count m d x
    cdata dd ps → mv-list m d ps
    cwsucc a → mv-count m d a
    cwop o a b → %wadd (mv-count m d a) (mv-count m d b)
    cwelim w z s mo → %wadd (mv-count m d w) (%wadd (mv-count m d z) (mv-count m d s))
    cann a T → %wadd (mv-count m d a) (mv-count m d T)
    cpi mm A B → %wadd (mv-count m d A) (mv-count m (%wsucc d) B)
    csigma A B → %wadd (mv-count m d A) (mv-count m (%wsucc d) B)
    cprim k as → mv-list m d as
    _ → #0
