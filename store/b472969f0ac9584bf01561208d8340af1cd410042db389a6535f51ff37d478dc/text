-- ---------------------------------------------------------------- 2. String & decimal formatting
lg-digits-go : Nat → Word → List Word → List Word
lg-digits-go zero n acc = acc
lg-digits-go (suc k) n acc =
  if weq n #0 then acc
  else lg-digits-go k (wquot n #10) (cons (wadd #48 (wrem n #10)) acc)
