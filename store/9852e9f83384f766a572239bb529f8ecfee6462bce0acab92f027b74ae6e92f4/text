-- Monotone endpoint reached by following a WarpPath from (i, j)
warp-end-go : List WarpStep → Word → Word → Word × Word
warp-end-go nil i j = (i , j)
warp-end-go (cons ws-diag r) i j = warp-end-go r (%wsucc i) (%wsucc j)
warp-end-go (cons ws-right r) i j = warp-end-go r (%wsucc i) j
warp-end-go (cons ws-up r) i j = warp-end-go r i (%wsucc j)
