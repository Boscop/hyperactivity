arm64-encode-proc : Word → Defs → Lst Word
arm64-encode-proc m defs =
  let slen = l-count (a64-stub #0 #0)
      ars = x-arities defs
      dlen = l-count (a64-driver #0 #0)
      aoff = slen
      doff = %wadd slen (l-count a64-apply)
      offs = lcons (x-apply-key , aoff) (a64-layout ars defs (%wadd doff dlen))
      tbl = (ars , offs)
  in xcat4 (a64-stub #0 doff) a64-apply (a64-driver (x-tbl tbl m) aoff) (a64-fns tbl defs)
