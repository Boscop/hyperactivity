bn-rmd-f : Word → Word → Word → Word → Word
bn-rmd-f rnd x y z =
  if %weq rnd #0 then %wxor x (%wxor y z)
  else if %weq rnd #1 then %wor (%wand x y) (%wand (bn-not32 x) z)
  else if %weq rnd #2 then %wxor (%wor x (bn-not32 y)) z
  else if %weq rnd #3 then %wor (%wand x z) (%wand y (bn-not32 z))
  else %wxor x (%wor y (bn-not32 z))
