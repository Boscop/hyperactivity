-- A projection (2026-11-15, Avik: "ONE SOURCE OF INFORMATION"; "Nothing is ever allowed to be
-- stale") is a document that is not a file: the text a projection of a value computes (for the
-- paper, `human hyperactivity`, lib/paper.cub), named; it is computed from the value whenever it is
-- read, so it cannot differ from what the value holds.
data Document = document-at (path : List Word) (sha256 : List Word)
              | projection (name : List Word) (text : List Word)
