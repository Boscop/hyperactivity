-- the chain of r_n from N down to 1, with whether every r_n is surely positive (so every g_n > 0)
rad-pos-down : List Bool → List Bool → IV → IV → IV → Nat → Bool × IV → Bool × IV
rad-pos-down S S2 p sig c n st = case n of
  zero → st
  suc g → rad-pos-down S S2 p sig c g (both (fst st) (iv-pos-sure (rad-r-at S S2 p sig c n (snd st))) , rad-r-at S S2 p sig c n (snd st))
