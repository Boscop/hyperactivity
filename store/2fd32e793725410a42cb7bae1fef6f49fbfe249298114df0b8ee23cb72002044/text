-- the sequential composition of trace contracts retains the intermediate state and t = t₁ ++ t₂
seq-rel : {S Ev : Type} → (S → List Ev → S → Type) → (S → List Ev → S → Type) → S → List Ev → S → Type
seq-rel {S} {Ev} R1 R2 s t s2 = (s1 : S) × (t1 : List Ev) × (t2 : List Ev) × (t ≡ list-append t1 t2) × R1 s t1 s1 × R2 s1 t2 s2
