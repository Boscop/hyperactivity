-- GALS tile sleeps on empty wires (inr unit) and only fires local handshake clock on inl ev
gals-state : {St Ev : Type} → (St → Ev → St) → St → List (Sum Ev Unit) → St
gals-state step st nil = st
gals-state step st (cons tk rest) =
  case tk of
    inl ev → gals-state step (step st ev) rest
    inr u  → gals-state step st rest
