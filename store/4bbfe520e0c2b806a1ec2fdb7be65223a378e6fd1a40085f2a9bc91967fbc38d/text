-- the step a + 1, b + 1 from (a, b + 1) and (a + 1, b)
ilv-step : (X Y A B a b N M : Nat) → times (times X A) (times (suc b) B) ≡ M → times (times Y (times (suc a) A)) B ≡ M →
  times (times (plus X Y) (times (suc a) A)) (times (suc b) B) ≡ times (plus (suc a) (suc b)) M
ilv-step X Y A B a b N M h1 h2 =
  transN (congN (λ z → times z (times (suc b) B)) (times-distr X Y (times (suc a) A)))
  (transN (times-distr (times X (times (suc a) A)) (times Y (times (suc a) A)) (times (suc b) B))
  (transN (λ k → plus
      (transN (congN (λ z → times z (times (suc b) B)) (times-comm-mid X (suc a) A))
        (transN (times-assoc (suc a) (times X A) (times (suc b) B)) (congN (times (suc a)) h1)) k)
      (transN (times-comm-mid (times Y (times (suc a) A)) (suc b) B) (congN (times (suc b)) h2) k))
  (sym (times-distr (suc a) (suc b) M))))
