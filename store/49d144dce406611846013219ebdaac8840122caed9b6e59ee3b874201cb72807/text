-- equality of types (deriving eq does not go through a field of another data type: see the track file)
rm-ty-eq : RTy → RTy → Bool
rm-ty-eq rty-bool b = case b of
  rty-bool → true
  _ → false
rm-ty-eq (rty-int a0) b = case b of
  rty-int b0 → rm-ik-eq a0 b0
  _ → false
rm-ty-eq rty-never b = case b of
  rty-never → true
  _ → false
rm-ty-eq (rty-ref a0 a1) b = case b of
  rty-ref b0 b1 → m-and (rm-mut-eq a0 b0) (rm-ty-eq a1 b1)
  _ → false
rm-ty-eq (rty-ptr a0 a1) b = case b of
  rty-ptr b0 b1 → m-and (rm-mut-eq a0 b0) (rm-ty-eq a1 b1)
  _ → false
rm-ty-eq (rty-array a0 a1) b = case b of
  rty-array b0 b1 → m-and (rm-ty-eq a0 b0) (rm-ty-eq a1 b1)
  _ → false
rm-ty-eq (rty-slice a0) b = case b of
  rty-slice b0 → rm-ty-eq a0 b0
  _ → false
rm-ty-eq (rty-tuple a0) b = case b of
  rty-tuple b0 → rm-ty-eq a0 b0
  _ → false
rm-ty-eq (rty-adt a0 a1) b = case b of
  rty-adt b0 b1 → m-and (weq a0 b0) (rm-ty-eq a1 b1)
  _ → false
rm-ty-eq (rty-dyn a0) b = case b of
  rty-dyn b0 → weq a0 b0
  _ → false
rm-ty-eq (rty-fn-ptr a0 a1) b = case b of
  rty-fn-ptr b0 b1 → m-and (rm-ty-eq a0 b0) (rm-ty-eq a1 b1)
  _ → false
rm-ty-eq (rty-param a0) b = case b of
  rty-param b0 → weq a0 b0
  _ → false
rm-ty-eq (rty-const a0) b = case b of
  rty-const b0 → weq a0 b0
  _ → false
rm-ty-eq (rty-const-param a0) b = case b of
  rty-const-param b0 → weq a0 b0
  _ → false
rm-ty-eq rtys-nil b = case b of
  rtys-nil → true
  _ → false
rm-ty-eq (rtys-cons a0 a1) b = case b of
  rtys-cons b0 b1 → m-and (rm-ty-eq a0 b0) (rm-ty-eq a1 b1)
  _ → false
