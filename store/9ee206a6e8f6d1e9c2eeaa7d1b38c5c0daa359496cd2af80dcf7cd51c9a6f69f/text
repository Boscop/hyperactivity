-- ---------------------------------------------------------------- the calculus, as a table
-- what an eliminator does with a value: a body to build with the eliminator's arguments innermost
-- (act-ap), or with the value's parts innermost (act-pa), a value outright, or nothing
data NkAct = act-ap (t : NkTm) | act-pa (t : NkTm) | act-hd (h : NkHd) | act-none
