-- and the concentration decides, at a fixed temperature, instrument and handedness, with the same
-- substance dissolved in both baths
m-concentration-decides : count-bath m-glucose (bath-room 1 sol-trace-base) ≡ count-bath m-glucose (bath-room 1 sol-base) → Empty
m-concentration-decides q = transport (λ i → isTrue (eqb 2 ((concat (sym m-glu-trace) (concat q m-glu-base)) i))) unit
