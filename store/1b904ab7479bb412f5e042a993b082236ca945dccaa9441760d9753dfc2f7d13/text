eqo-phi-c : {b : Bool} → (f : List (List Word) → Word) → (a : El PO) → (e : El entry-ord) → eqo {PO} a (phi f (snd a)) ≡ b →
            eqo {PO} a (phi f e) ≡ andB b (eqo {entry-ord} (snd a) e)
eqo-phi-c f a e c = tr (andB (eqo {PO} a (phi f (snd a))) (eqo {entry-ord} (snd a) e)) (eqo-phi f a e) (λ j → andB (c j) (eqo {entry-ord} (snd a) e))
