round-ok : (t : List (List Word)) → (h0 : Nat) → (r : List Word) → DblInv t (suc h0) r → DblInv t (plus (suc h0) (suc h0)) (round (suc h0) r)
round-ok t h0 r inv =
  (round-f t h0 r inv , round-e t h0 r inv , round-p t h0 r inv , λ s → rank-pos {WW} (key-tree {WW} (zippad r (drop-n (suc h0) r))) (dkey (fst inv) (suc h0) s))
