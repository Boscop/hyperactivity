-- the longest end of t the record holds: lengths lo (held) to hi (not held), halved
c-longest-f : Nat → Word → Word → List Word → Proc W Word
c-longest-f zero lo hi t = ret lo
c-longest-f (suc f) lo hi t = if wlt (wadd lo #1) hi then
  bind (c-holds (c-end (toNat (wshr (wadd lo hi) #1)) t)) (λ h →
  if h then c-longest-f f (wshr (wadd lo hi) #1) hi t else c-longest-f f lo (wshr (wadd lo hi) #1) t)
  else ret {lzero} {W} lo
