-- bit 0 after an update of bit 0: the value's bit 0
bu-bit0 : (x v : Word) → wbit (bv-update #32 x #0 #0 v) #0 ≡ wbit v #0
bu-bit0 x v =
  wbit-or (wxor x (wand x #1)) (wshl v #0) #0
  ∙ cong2 (λ p q → bit-or p q) (wbit-xor x (wand x #1) #0 ∙ cong (λ q → bit-xor (wbit x #0) q) (wbit-and x #1 #0) ∙ bit-clear (wbit x #0))
                               (wbit-shl v #0 #0)
