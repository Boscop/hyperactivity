-- the coefficient from the triangle quantities a = j1+j2−J, b = j1−j2+J, c = −j1+j2+J, s = j1+j2+J,
-- the doubled total tJ, the projections x1 = j1+m1, y1 = j1−m1, x2 = j2+m2, y2 = j2−m2, X = J+M,
-- Y = J−M, and whether the projections add (M = m1 + m2) and the spins close a triangle. The square is
-- (2J+1) a! b! c! / (s+1)! · X! Y! x1! y1! x2! y2! · (Racah's sum)², and the sign is the sum's.
cg-from : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Bool → CG
cg-from a b c s tJ x1 y1 x2 y2 X Y ok =
  if ok
    then (qp-diff-sign (fst (racah-sum a b c y1 x2 a)) (snd (racah-sum a b c y1 x2 a)) ,
          qp-mul (times (suc tJ) (times (fact a) (times (fact b) (fact c))) , fact (suc s))
            (qp-mul (times (fact X) (times (fact Y) (times (fact x1) (times (fact y1) (times (fact x2) (fact y2))))) , suc zero)
              (qp-diff-sq (fst (racah-sum a b c y1 x2 a)) (snd (racah-sum a b c y1 x2 a)))))
    else (true , (zero , suc zero))
