s-corpus-make : List Word → Proc W (List Word)
s-corpus-make st = bind (h-read (list-append st "/paper/text")) (λ pt → bind (s-corpus-works s-published) (λ ws →
  ret {lzero} {W} (h-concat (cons "[" (cons (s-commas (cons (s-corpus-item "/paper" "hyperactivity: the paper" (s-paper-text (s-or nil pt))) ws)) (cons "]" nil))))))
