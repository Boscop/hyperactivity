-- a list of (l , r) codes as hypotheses, in order; none when one is outside the fragment
eqs-of-codes : Lst (Code × Code) → Opt Eqs
eqs-of-codes lnil = some enil
eqs-of-codes (lcons h r) =
  case tm-of-code (fst h) of
    none → none
    some l → (case tm-of-code (snd h) of
                none → none
                some rr → (case eqs-of-codes r of none → none; some rest → some (econs l rr rest)))
