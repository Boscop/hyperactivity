dnf-ix-cons : (sk : Lst Entry) (c : Conj) (cs : DNF) → IEq sk (dnf-ix (lcons c cs)) (ixjoin (conj-ix c) (dnf-ix cs))
dnf-ix-cons sk c lnil = ieq-sym sk (ixjoin (conj-ix c) ix0) (conj-ix c) (law-unit-j-r sk (conj-ix c))
dnf-ix-cons sk c (lcons d ds) = ieq-refl sk (ixjoin (conj-ix c) (dnf-ix-from d ds))
