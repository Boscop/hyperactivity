-- comparing x + 2X with y + 2Y is comparing X with Y, the tie decided by the low bits
cmp-double : (t x y : Bool) → (X Y : Nat) → cmpN t (plus (bitn x) (times 2 X)) (plus (bitn y) (times 2 Y)) ≡ cmpN (if bit-eq x y then t else y) X Y
cmp-double t x y X = case X return λ m → (Y : Nat) → cmpN t (plus (bitn x) (times 2 m)) (plus (bitn y) (times 2 Y)) ≡ cmpN (if bit-eq x y then t else y) m Y of
  zero → λ Y → cmp-double-z t x y Y
  suc k → λ Y → cmp-double-s t x y k Y (rec k)
