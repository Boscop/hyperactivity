xp-subst-steps : {tu : XpExpr × XpExpr} → XpSteps tu → (th : Nat → XpExpr) → XpSteps (xp-subst th (fst tu) , xp-subst th (snd tu))
xp-subst-steps (xs-refl t) th = xs-refl (xp-subst th t)
xp-subst-steps (xs-then t u w r rs) th = xs-then (xp-subst th t) (xp-subst th u) (xp-subst th w) (xp-subst-step r th) (xp-subst-steps rs th)
