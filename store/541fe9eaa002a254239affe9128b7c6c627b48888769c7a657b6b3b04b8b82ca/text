-- the children that have finished, waited for (wait4 on any child, not blocking) so none is left a zombie
s-reap : Nat → Proc W Unit
s-reap zero = ret unit
s-reap (suc k) = bind (sys-call #61 #18446744073709551615 #0 #1 #0 #0 #0) (λ r → if andB (wlt #0 r) (wlt r #9223372036854775808) then s-reap k else ret unit)
