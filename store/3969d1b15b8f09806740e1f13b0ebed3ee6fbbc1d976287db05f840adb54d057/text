cx-field-any : List CDecl → Word → MRes (CRecord × CField)
cx-field-any nil i = mstop st-ill-typed
cx-field-any (cons d ds) i = case d of
  cd-record r → cx-field-in (cx-rec-fields r) i r (cx-field-any ds i)
  cd-class-template-specialization args r → cx-field-in (cx-rec-fields r) i r (cx-field-any ds i)
  _ → cx-field-any ds i
