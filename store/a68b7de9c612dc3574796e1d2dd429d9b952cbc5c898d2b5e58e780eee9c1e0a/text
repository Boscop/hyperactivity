zip-mdiff-mundiff : (B : Word) → (ps ds : List (Bounded B)) → zip-mdiff B ps (zip-mundiff B ps ds) ≡ ds
zip-mdiff-mundiff B ps =
  case ps return (λ u → (ds : List (Bounded B)) → zip-mdiff B u (zip-mundiff B u ds) ≡ ds) of
    nil → λ ds i → ds
    cons p ps1 → λ ds →
      case ds return (λ v → zip-mdiff B (cons p ps1) (zip-mundiff B (cons p ps1) v) ≡ v) of
        nil → λ i → nil
        cons d ds1 →
          let x : Bounded B
              x = (mundiff-val B (fst p) (fst d) , mundiff-lt B (fst p) (fst d) (snd p) (snd d))
              d2 : Bounded B
              d2 = (mdiff-val B (fst p) (fst x) , mdiff-lt B (fst p) (fst x) (snd p) (snd x))
          in λ i → cons (bounded-eq B d2 d (mdiff-mundiff B (fst p) (fst d) (snd p) (snd d)) i) (rec ps1 ds1 i)
