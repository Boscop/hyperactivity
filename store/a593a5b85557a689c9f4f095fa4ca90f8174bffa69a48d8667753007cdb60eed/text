-- Pack a 44-byte-header WAV into HXW2: "HXW2" + 44B header + u32(nSams) + hxgr-enc(sams)
hxwav-pack : List Word → List Word
hxwav-pack wav =
  let hdr   = list-take-rev #44 wav nil
      pcm   = list-drop #44 wav
      sams  = pcm-bytes-to-s16-go pcm nil
      nSams = cli-len sams
      enc   = hxgr-enc sams
  in list-append "HXW2" (list-append hdr (le32 nSams enc))
