cs-switch-mid-dl : (d : Word) (tl : List Word) → cs-switch-mid d tl ≡ list-append (cs-switch-mid d nil) tl
cs-switch-mid-dl d tl =
  let d0 = ce-dec d
  in cs-dl-comp (list-append "; uint64_t r") (λ x → list-append d0 (list-append "; switch (p" (list-append d0 (list-append "[0]) { " x))))
       (cs-dl-lit "; uint64_t r")
       (cs-dl-comp (list-append d0) (λ x → list-append "; switch (p" (list-append d0 (list-append "[0]) { " x)))
         (cs-dl-lit d0)
         (cs-dl-comp (list-append "; switch (p") (λ x → list-append d0 (list-append "[0]) { " x))
           (cs-dl-lit "; switch (p")
           (cs-dl-comp (list-append d0) (list-append "[0]) { ")
             (cs-dl-lit d0) (cs-dl-lit "[0]) { ")))) tl
