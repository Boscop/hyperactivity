-- a change in a sub-plan writes values only to outs or [n0, n1), operations only to ins or [n0, n1), and never puts
nk-chg-wf : NkEnv → NkEnv → NkW → NkW → NkW → NkCh → Bool
nk-chg-wf ins outs n0 n1 w (nkc-val v) = nk-in-set outs n0 n1 w
nk-chg-wf ins outs n0 n1 w (nkc-op o) = nk-in-set ins n0 n1 w
nk-chg-wf ins outs n0 n1 w (nkc-put s) = false
