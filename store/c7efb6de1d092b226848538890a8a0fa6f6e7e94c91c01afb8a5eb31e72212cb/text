-- G = A + p²/3 + (2/15) p² s_2, s from l = 2M + 2 down, started at [0, 1]
ang-g : List Bool → List Bool → IV → IV → Nat → IV
ang-g S S2 p2 a M = iv-add (iv-add a (iv-mul S p2 (iv-rat S bin-one (bin-of-nat 3))))
  (iv-mul S (iv-mul S p2 (iv-rat S bin-two (bin-of-nat 15))) (ang-down S S2 p2 a M (iv-unit S)))
