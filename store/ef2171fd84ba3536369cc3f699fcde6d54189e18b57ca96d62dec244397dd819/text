-- what followed each occurrence of s in a line, to the line's end: the test h-prefix s built once a
-- line and shared by every position, Θ(ℓ + k) a line to build it and Θ(1 + lcp) a position to run it
c-after-p : (List Word → Bool) → List Word → List Word → List (List Word)
c-after-p p s nil = nil
c-after-p p s (cons c r) = if p (cons c r) then cons (h-drop s (cons c r)) (c-after-p p s r) else c-after-p p s r
