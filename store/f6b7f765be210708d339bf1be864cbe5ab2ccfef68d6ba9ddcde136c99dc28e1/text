op-rat : (S : List Bool) → (n d : Nat) → (v : (Nat × Nat) × Nat) → qeq v (the (Nat × Nat) (n , zero) , suc d) → ivc (iv-rat S (bin-of-nat n) (bin-of-nat (suc d))) × encl S (iv-rat S (bin-of-nat n) (bin-of-nat (suc d))) (fst v) (snd v)
op-rat S n d v qv = (iv-rat-canon S (bin-of-nat n) (bin-of-nat (suc d)) ,
  encl-qeq S (iv-rat S (bin-of-nat n) (bin-of-nat (suc d))) (the (Nat × Nat) (n , zero)) (suc d) (fst v) (snd v)
    (transport (λ i → encl S (iv-rat S (bin-of-nat n) (bin-of-nat (suc d))) (the (Nat × Nat) (bin-of-nat-sound n i , zero)) (bin-of-nat-sound (suc d) i))
       (iv-rat-sound S (bin-of-nat n) (bin-of-nat (suc d)) (bin-of-nat-canon (suc d)) (transport (λ i → le (suc zero) (bin-of-nat-sound (suc d) (~ i))) (le-one-suc d))))
    qv (le-one-suc d))
