wl-m2 : List Word → List Word
wl-m2 tail =
  hw-ln "// Exp 2: Aspirin Esterification Wet-Lab Protocol Optimizer (65,536 virtual flasks)"
  (hw-ln "// C7H6O3 (SA) + C4H6O3 (Ac2O) <-> C9H8O4 (ASA) + C2H4O2 (AcOH)  [DeltaG0 = -24.8 kJ/mol]"
  (hw-ln "// Side reaction: ASA + H2O <-> SA + AcOH (acid/thermal hydrolysis, Ea_hydro = 71 kJ/mol, Ea_est = 56 kJ/mol)"
  (hw-ln "kernel void wl_aspirin_flasks("
  (hw-ln "  device float* out_yield    [[buffer(0)]],"
  (hw-ln "  device float* out_mass_err [[buffer(1)]],"
  (hw-ln "  uint tid [[thread_position_in_grid]]) {"
  (hw-ln "  // Grid: 64 temps (300..363K) x 32 Ac2O ratios (1.0..4.1 eq) x 32 cat/time settings"
  (hw-ln "  float T     = 300.0f + (float)(tid & 63u);"
  (hw-ln "  float ratio = 1.0f + 0.1f * (float)((tid >> 6u) & 31u);"
  (hw-ln "  float cat   = 0.005f + 0.005f * (float)(tid >> 11u);"
  (hw-ln "  float RT = 8.3144626e-3f * T; // kJ/mol"
  (hw-ln "  float k_est  = cat * 2.5e7f * exp(-56.0f / RT);"
  (hw-ln "  float k_rev  = k_est * exp(-24.8f / RT); // exact detailed balance Keq = exp(-dG0/RT)!"
  (hw-ln "  float k_hyd  = cat * 1.8e8f * exp(-71.0f / RT) * 0.02f; // trace H2O hydrolysis"
  (hw-ln "  float sa = 1.0f, ac2o = ratio, asa = 0.0f, acoh = 0.0f, h2o = 0.02f;"
  (hw-ln "  float C0 = 7.0f*sa + 4.0f*ac2o + 9.0f*asa + 2.0f*acoh;"
  (hw-ln "  float H0 = 6.0f*sa + 6.0f*ac2o + 8.0f*asa + 4.0f*acoh + 2.0f*h2o;"
  (hw-ln "  float O0 = 3.0f*sa + 3.0f*ac2o + 4.0f*asa + 2.0f*acoh + 1.0f*h2o;"
  (hw-ln "  // 40 exact mass-conserving implicit Patankar reaction steps (t_total = 1800 s)"
  (hw-ln "  float dt = 45.0f;"
  (hw-ln "  for (int s = 0; s < 40; s++) {"
  (hw-ln "    float f1 = dt * k_est * sa * ac2o;"
  (hw-ln "    float b1 = dt * k_rev * asa * acoh;"
  (hw-ln "    float d1 = (f1 - b1) / (1.0f + dt * k_est * (sa + ac2o) + dt * k_rev * (asa + acoh));"
  (hw-ln "    d1 = clamp(d1, -min(asa, acoh), min(sa, ac2o));"
  (hw-ln "    sa -= d1; ac2o -= d1; asa += d1; acoh += d1;"
  (hw-ln "    float f2 = dt * k_hyd * asa * h2o / (1.0f + dt * k_hyd * (asa + h2o));"
  (hw-ln "    f2 = clamp(f2, 0.0f, min(asa, h2o));"
  (hw-ln "    asa -= f2; h2o -= f2; sa += f2; acoh += f2;"
  (hw-ln "  }"
  (hw-ln "  float C1 = 7.0f*sa + 4.0f*ac2o + 9.0f*asa + 2.0f*acoh;"
  (hw-ln "  float H1 = 6.0f*sa + 6.0f*ac2o + 8.0f*asa + 4.0f*acoh + 2.0f*h2o;"
  (hw-ln "  float O1 = 3.0f*sa + 3.0f*ac2o + 4.0f*asa + 2.0f*acoh + 1.0f*h2o;"
  (hw-ln "  out_yield[tid]    = asa;"
  (hw-ln "  out_mass_err[tid] = fabs(C1 - C0) + fabs(H1 - H0) + fabs(O1 - O0);"
  (hw-ln "}"
  (hw-ln nil tail)))))))))))))))))))))))))))))))))))))
