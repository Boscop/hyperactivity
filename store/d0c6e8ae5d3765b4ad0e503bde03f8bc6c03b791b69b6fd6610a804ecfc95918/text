-- Derived step-cost bound (CLAUDE.md: cost derived and proven from definitions, never measured):
-- csr-at visits at most csr-depth internal nodes regardless of total byte length or leaf count
csr-nat-max : Nat → Nat → Nat
csr-nat-max zero b = b
csr-nat-max (suc a) zero = suc a
csr-nat-max (suc a) (suc b) = suc (csr-nat-max a b)
