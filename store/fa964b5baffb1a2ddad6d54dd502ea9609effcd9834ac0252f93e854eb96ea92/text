-- the graph's views, kept in the store by lib/views.cub (views/), made again when anything under the
-- repository has changed since
hy-views-ready : List Word → List Word → Proc W Unit
hy-views-ready st m = bind (hy-get st "views/stamp") (λ s → bind (h-dir-time (toNat #12) ".") (λ now →
  if h-eq (hy-or nil s) (h-decimal now) then ret {lzero} {W} unit else bind (h-run (cons m (cons "lib/views.cub" nil))) (λ r → ret {lzero} {W} unit)))
