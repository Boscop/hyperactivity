-- ---------------------------------------------------------------- 3b. dynamic interface morphisms & pushforward
-- a morphism of reshaping interfaces D1 → D2: maps interface states, translates commands forward,
-- translates responses backward, and preserves the interface-reshaping transition ds-next
DynHom : DynSig → DynSig → Type
DynHom D1 D2 =
  (f : ds-idx D1 → ds-idx D2)
  × (fc : (i : ds-idx D1) → Cmd (ds-sig D1 i) → Cmd (ds-sig D2 (f i)))
  × (fr : (i : ds-idx D1) → (c : Cmd (ds-sig D1 i)) → Resp (ds-sig D2 (f i)) (fc i c) → Resp (ds-sig D1 i) c)
  × ((i : ds-idx D1) → (c : Cmd (ds-sig D1 i)) → (r2 : Resp (ds-sig D2 (f i)) (fc i c))
     → f (ds-next D1 i c (fr i c r2)) ≡ ds-next D2 (f i) (fc i c) r2)
