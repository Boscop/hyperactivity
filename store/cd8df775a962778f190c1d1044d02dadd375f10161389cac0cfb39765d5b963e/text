conj-eq-sound : (c d : Conj) → conj-eq c d ≡ true → c ≡ d
conj-eq-sound lnil lnil e = λ i → lnil
conj-eq-sound lnil (lcons m ms) e = false-true (Path Conj lnil (lcons m ms)) e
conj-eq-sound (lcons l ls) lnil e = false-true (Path Conj (lcons l ls) lnil) e
conj-eq-sound (lcons l ls) (lcons m ms) e =
  λ i → lcons (lit-eq-sound l m (andB-l (lit-eq l m) (conj-eq ls ms) e) i) (conj-eq-sound ls ms (andB-r (lit-eq l m) (conj-eq ls ms) e) i)
