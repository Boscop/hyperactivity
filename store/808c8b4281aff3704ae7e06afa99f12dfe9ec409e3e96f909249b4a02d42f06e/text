hxf-bb : Word → Word × (Word × Word)
hxf-bb K =
  let K2 = %wmul K K
      K3 = %wmul K2 K
  in %welimP (λ _ → Word × (Word × Word)) K (#9999 , (#0 , #0)) (λ r1 st1 →
       let e1 = hxf-e1 r1
       in if %wlt (fst st1) e1 then (fst st1 , (%wadd (fst (snd st1)) K3 , snd (snd st1)))
          else %welimP (λ _ → Word × (Word × Word)) K st1 (λ r2 st2 →
            let e12 = %wadd e1 (hxf-e2 r2)
            in if %wlt (fst st2) e12 then (fst st2 , (%wadd (fst (snd st2)) K2 , snd (snd st2)))
               else %welimP (λ _ → Word × (Word × Word)) K st2 (λ r3 st3 →
                 let e123 = %wadd e12 (hxf-e2 r3)
                 in if %wlt (fst st3) e123 then (fst st3 , (%wadd (fst (snd st3)) K , snd (snd st3)))
                    else %welimP (λ _ → Word × (Word × Word)) K st3 (λ r4 st4 →
                      let e = %wadd e123 (hxf-e2 r4)
                          b = if %wlt e (fst st4) then e else fst st4
                      in (b , (fst (snd st4) , %wsucc (snd (snd st4))))))))
