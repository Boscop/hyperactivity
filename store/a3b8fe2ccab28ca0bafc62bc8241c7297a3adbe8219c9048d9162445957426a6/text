eig-kinds : SQ → List SpaceData → VM → Nat → Nat → Nat → List Nat → Rows → List (List (List PRad)) → List (List (List PRad))
eig-kinds s tbl aP k n m dsP xs0 acc = case k of
  zero → acc
  suc j → eig-kinds s tbl aP j n m dsP xs0 (eig-term tbl aP s k true n true m dsP xs0 (eig-term tbl aP s k true n false m dsP xs0
    (eig-term tbl aP s k false n true m dsP xs0 (eig-term tbl aP s k false n false m dsP xs0 acc))))
