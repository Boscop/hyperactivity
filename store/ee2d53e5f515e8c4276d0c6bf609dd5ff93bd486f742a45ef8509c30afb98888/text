-- SYLVESTER'S LAW OF INERTIA. In dimension at most n, two witnesses of one form, each n vectors split into an
-- orthogonal family where F is negative (un, vn) and an orthogonal family where F is positive (up, vp), have the same
-- number of negative vectors
sy-law : (A V : Type) → (z : A) → (ad mu : A → A → A) → (vz : V) → (va : V → V → V) → (vs : A → V → V) → (f : V → V → A) → sy-RL A z ad mu → sy-FL A V z ad mu vz va vs f → (isz : A → Bool) → isz z ≡ true → (N Ng P Ps : A → Type) → sy-QL A z ad mu N Ng → sy-QL A z ad mu P Ps → ((x : A) → N x → P x → x ≡ z) → (n : Nat) → sy-Dim A V z vz va vs isz n →
  (un up vn vp : List V) → sy-orth A V z f un → sy-all V (λ u → Ng (f u u)) un → sy-orth A V z f up → sy-all V (λ u → Ps (f u u)) up →
  sy-orth A V z f vn → sy-all V (λ u → Ng (f u u)) vn → sy-orth A V z f vp → sy-all V (λ u → Ps (f u u)) vp →
  plus (sy-len V un) (sy-len V up) ≡ n → plus (sy-len V vn) (sy-len V vp) ≡ n → sy-len V un ≡ sy-len V vn
sy-law A V z ad mu vz va vs f L K isz hz0 N Ng P Ps MN MP both n D un up vn vp oun hun oup hup ovn hvn ovp hvp e1 e2 = case sy-tri (sy-len V un) (sy-len V vn) of
  inl p → p
  inr s → (case s of
    inl h → Empty-rec (sy-bound A V z ad mu vz va vs f L K isz hz0 N Ng P Ps MN MP both n D vn up ovn hvn oup hup (sy-over V vn up (sy-len V un) (sy-len V up) n h (λ i → sy-len V up) e1))
    inr h → Empty-rec (sy-bound A V z ad mu vz va vs f L K isz hz0 N Ng P Ps MN MP both n D un vp oun hun ovp hvp (sy-over V un vp (sy-len V vn) (sy-len V vp) n h (λ i → sy-len V vp) e2)))
