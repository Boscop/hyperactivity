-- the two scalar computations of the reduced form's laws
bw-adds : (A : Type) → (ad mu : A → A → A) → (ng : A → A) → ((c p q : A) → mu c (ad p q) ≡ ad (mu c p) (mu c q)) → ((p q a : A) → mu (ad p q) a ≡ ad (mu p a) (mu q a)) → ((p q r s : A) → ad (ad p q) (ad r s) ≡ ad (ad p r) (ad q s)) → ((p q : A) → ng (ad p q) ≡ ad (ng p) (ng q)) →
  (a fp fq fpq hp hq hpq c : A) → fpq ≡ ad fp fq → hpq ≡ ad hp hq → ad (mu a fpq) (mu (ng hpq) c) ≡ ad (ad (mu a fp) (mu (ng hp) c)) (ad (mu a fq) (mu (ng hq) c))
bw-adds A ad mu ng dl dr sw nadd a fp fq fpq hp hq hpq c e1 e2 = cl-tr A (ad (mu a fpq) (mu (ng hpq) c)) (ad (ad (mu a fp) (mu a fq)) (ad (mu (ng hp) c) (mu (ng hq) c))) (ad (ad (mu a fp) (mu (ng hp) c)) (ad (mu a fq) (mu (ng hq) c)))
  (λ i → ad (cl-tr A (mu a fpq) (mu a (ad fp fq)) (ad (mu a fp) (mu a fq)) (λ t → mu a (e1 t)) (dl a fp fq) i)
            (cl-tr3 A (mu (ng hpq) c) (mu (ng (ad hp hq)) c) (mu (ad (ng hp) (ng hq)) c) (ad (mu (ng hp) c) (mu (ng hq) c)) (λ t → mu (ng (e2 t)) c) (λ t → mu (nadd hp hq t) c) (dr (ng hp) (ng hq) c) i))
  (sw (mu a fp) (mu a fq) (mu (ng hp) c) (mu (ng hq) c))
