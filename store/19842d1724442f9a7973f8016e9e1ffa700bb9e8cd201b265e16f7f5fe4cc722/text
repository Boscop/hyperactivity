c-meaning : List (List (List Word)) → List Word
c-meaning nil = h-line "(the record holds nothing of this)"
c-meaning (cons x nil) = h-line (c-unwords x)
c-meaning fam = list-append (h-line (c-unwords (c-agreed fam)))
  (h-concat (list-map (λ x → h-line (list-append "  " (c-unwords (h-drop-n (list-length (c-agreed fam)) x)))) fam))
