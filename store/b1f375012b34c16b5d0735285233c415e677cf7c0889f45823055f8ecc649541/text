-- UNIVERSAL THEOREM 3B (ALL-HORIZON `n : Nat` HOMEOMORPHIC CONJUGATED EXECUTION, 0 POSTULATES):
dm-thm-conjugated-exec-all-n :
  {S : Type} → (enc dec : S → S) → ((s : S) → dec (enc s) ≡ s) →
  (step : S → S) → (n : Nat) → (x : S) →
  dec (dm-iter n (dm-conj-step enc dec step) (enc x)) ≡ dm-iter n step x
dm-thm-conjugated-exec-all-n enc dec retS step n x =
  let p1 = cong dec (dm-thm-conj-inner enc dec retS step n x)
      p2 = retS (dm-iter n step x)
  in λ i → comp (λ j → S)
       (λ j → [ i = 0 ↦ p1 (~ j) , i = 1 ↦ p2 j ])
       (dec (enc (dm-iter n step x)))
