split-at-append : {A : Type} → (xs ys : List A) → split-at-n (list-length xs) (list-append xs ys) ≡ (xs , ys)
split-at-append {A} xs =
  case xs return (λ u → (ys : List A) → split-at-n (list-length u) (list-append u ys) ≡ (u , ys)) of
    nil → λ ys i → (nil , ys)
    cons x r → λ ys → let ih = rec r ys in λ i → (cons x (fst (ih i)) , snd (ih i))
