bio-thm-spatial-too-far = refl

-- ── 7. CRISPR-Cas9 Guide Design (PAM NGG, Exact GC%, Off-Target Gate) ────────
-- SpCas9 PAM = NGG (any base followed by G, G):
is-pam-ngg : Base → Base → Base → Bool
is-pam-ngg _ b2 b3 = andB (base-eq b2 bG) (base-eq b3 bG)

st-gc-count : Strand → Word
st-gc-count st-nil = #0
st-gc-count (st-cons b r) =
  %wadd (if orB (base-eq b bG) (base-eq b bC) then #1 else #0) (st-gc-count r)

-- Exact GC% in [min_pct, max_pct] without floats:
crispr-gc-ok : Strand → Word → Word → Bool
crispr-gc-ok s min-pct max-pct =
  let n = st-len s
      gc100 = %wmul (st-gc-count s) #100
  in andB (bio-le (%wmul min-pct n) gc100) (bio-le gc100 (%wmul max-pct n))

-- Off-target safety: require Hamming distance >= 3 mismatches against any genomic off-target locus:
crispr-offtarget-safe : Strand → Strand → Bool
crispr-offtarget-safe guide off = bio-le #3 (dna-hamming guide off)

