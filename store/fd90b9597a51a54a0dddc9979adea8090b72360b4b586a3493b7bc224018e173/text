-- Exact 3D C-alpha integer distance squared (in Angstroms^2):
prot-dist2 : Word → Word → Word → Word → Word → Word → Word
prot-dist2 x1 y1 z1 x2 y2 z2 =
  let dx = bio-abs-diff x1 x2
      dy = bio-abs-diff y1 y2
      dz = bio-abs-diff z1 z2
  in %wadd (%wmul dx dx) (%wadd (%wmul dy dy) (%wmul dz dz))

-- Contact iff 9 <= d^2 <= 64 (3A..8A valid folding contact without steric clash!):
prot-valid-contact : Word → Word → Word → Word → Word → Word → Bool
prot-valid-contact x1 y1 z1 x2 y2 z2 =
  let d2 = prot-dist2 x1 y1 z1 x2 y2 z2
  in andB (bio-le #9 d2) (bio-le d2 #64)

-- Steric clash iff d^2 < 9 (< 3A atomic overlap — rejected at compile time!):
prot-steric-clash : Word → Word → Word → Word → Word → Word → Bool
prot-steric-clash x1 y1 z1 x2 y2 z2 = %wlt (prot-dist2 x1 y1 z1 x2 y2 z2) #9

bio-thm-prot-contact-6A : prot-valid-contact #10 #10 #10 #16 #10 #10 ≡ true
bio-thm-prot-contact-6A = refl

