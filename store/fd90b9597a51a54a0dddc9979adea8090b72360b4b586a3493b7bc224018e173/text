-- ── 2. Exact 2-Bit DNA Base, Watson-Crick XOR-3, K-Mer & Minimizer Sketching ─
-- A = 0 (00), C = 1 (01), G = 2 (10), T = 3 (11); Watson-Crick complement = XOR #3 (1 gate!).
data Base = bA | bC | bG | bT

base-to-2b : Base → Word
base-to-2b bA = #0
base-to-2b bC = #1
base-to-2b bG = #2
base-to-2b bT = #3

base-from-2b : Word → Base
base-from-2b w =
  let k = %wand w #3
  in if %weq k #0 then bA
     else if %weq k #1 then bC
     else if %weq k #2 then bG
     else bT

base-eq : Base → Base → Bool
base-eq a b = %weq (base-to-2b a) (base-to-2b b)

base-comp : Base → Base
base-comp b = base-from-2b (%wxor (base-to-2b b) #3)

-- Constructive 2-bit lossless codec & Watson-Crick involution proofs (ALL 4/4 bases!):
bio-thm-codec-A : base-from-2b (base-to-2b bA) ≡ bA
bio-thm-codec-A = refl
bio-thm-codec-C : base-from-2b (base-to-2b bC) ≡ bC
bio-thm-codec-C = refl
bio-thm-codec-G : base-from-2b (base-to-2b bG) ≡ bG
bio-thm-codec-G = refl
bio-thm-codec-T : base-from-2b (base-to-2b bT) ≡ bT
bio-thm-codec-T = refl

bio-thm-comp-invol-A : base-comp (base-comp bA) ≡ bA
bio-thm-comp-invol-A = refl
bio-thm-comp-invol-C : base-comp (base-comp bC) ≡ bC
bio-thm-comp-invol-C = refl
bio-thm-comp-invol-G : base-comp (base-comp bG) ≡ bG
bio-thm-comp-invol-G = refl
bio-thm-comp-invol-T : base-comp (base-comp bT) ≡ bT
bio-thm-comp-invol-T = refl

data Strand = st-nil | st-cons (hd : Base) (tl : Strand)

st-len : Strand → Word
st-len st-nil = #0
st-len (st-cons _ r) = %wadd #1 (st-len r)

st-revcomp-acc : Strand → Strand → Strand
st-revcomp-acc st-nil acc = acc
st-revcomp-acc (st-cons b r) acc = st-revcomp-acc r (st-cons (base-comp b) acc)

st-revcomp : Strand → Strand
st-revcomp s = st-revcomp-acc s st-nil

-- Exact bit-packed k-mer (2 bits per base: 32-mer fits in one 64-bit register!):
kmer-pack-acc : Strand → Word → Word
kmer-pack-acc st-nil acc = acc
kmer-pack-acc (st-cons b r) acc = kmer-pack-acc r (%wor (%wshl acc #2) (base-to-2b b))

kmer-pack : Strand → Word
kmer-pack s = kmer-pack-acc s #0

-- Canonical k-mer = min(kmer, revcomp(kmer)) — invariant under double-strand orientation!
kmer-canon : Strand → Word
kmer-canon s = bio-min (kmer-pack s) (kmer-pack (st-revcomp s))

-- Exact minimizer over a pair of adjacent canonical k-mers (Minimap2 sketch primitive):
kmer-minimizer2 : Strand → Strand → Word
kmer-minimizer2 s1 s2 = bio-min (kmer-canon s1) (kmer-canon s2)

ecori-site : Strand
ecori-site = st-cons bG (st-cons bA (st-cons bA (st-cons bT (st-cons bT (st-cons bC st-nil)))))

crispr-seed : Strand
crispr-seed = st-cons bA (st-cons bC (st-cons bG (st-cons bT (st-cons bG (st-cons bA st-nil)))))

crispr-seed-mut : Strand
crispr-seed-mut = st-cons bA (st-cons bC (st-cons bA (st-cons bT (st-cons bC (st-cons bA st-nil)))))

bio-thm-ecori-palindrome : st-revcomp ecori-site ≡ ecori-site
bio-thm-ecori-palindrome = refl

bio-thm-revcomp-invol : st-revcomp (st-revcomp crispr-seed) ≡ crispr-seed
bio-thm-revcomp-invol = refl

bio-thm-canon-strand-invariant : kmer-canon crispr-seed ≡ kmer-canon (st-revcomp crispr-seed)
bio-thm-canon-strand-invariant = refl

bio-thm-minimizer-sym : kmer-minimizer2 ecori-site crispr-seed ≡ kmer-minimizer2 crispr-seed ecori-site
bio-thm-minimizer-sym = refl

-- ── 3. Exact Sequence Alignment: Hamming Distance & Smith-Waterman Local DP ──
-- Exact base-by-base Hamming mismatch count:
dna-hamming : Strand → Strand → Word
dna-hamming st-nil _ = #0
dna-hamming _ st-nil = #0
dna-hamming (st-cons a ra) (st-cons b rb) =
  %wadd (if base-eq a b then #0 else #1) (dna-hamming ra rb)

bio-thm-hamming-self-zero : dna-hamming crispr-seed crispr-seed ≡ #0
bio-thm-hamming-self-zero = refl

bio-thm-hamming-sym : dna-hamming crispr-seed crispr-seed-mut ≡ dna-hamming crispr-seed-mut crispr-seed
bio-thm-hamming-sym = refl

bio-thm-hamming-exact2 : dna-hamming crispr-seed crispr-seed-mut ≡ #2
bio-thm-hamming-exact2 = refl

-- Exact Smith-Waterman Local Alignment DP cell recurrence (match +2, mismatch -1, gap -2, clamped >= 0):
-- Note: %wsub saturates at #0, which IS the exact Smith-Waterman local-alignment zero floor!
sw-cell : Word → Word → Word → Base → Base → Word
sw-cell diag up left a b =
  let d-score = if base-eq a b then %wadd diag #2 else %wsub diag #1
      u-score = %wsub up #2
      l-score = %wsub left #2
  in bio-max d-score (bio-max u-score l-score)

-- Exact SW match extension (diag=4, A==A -> 6):
bio-thm-sw-match : sw-cell #4 #3 #3 bA bA ≡ #6
bio-thm-sw-match = refl

-- Exact SW mismatch floor (diag=0, A!=G -> 0, local alignment resets cleanly!):
bio-thm-sw-zero-floor : sw-cell #0 #1 #1 bA bG ≡ #0
bio-thm-sw-zero-floor = refl

-- Exact SW gap selection (diag=2 mismatch->1, up=6 gap->4 => chooses up-gap 4!):
bio-thm-sw-gap-wins : sw-cell #2 #6 #2 bA bT ≡ #4
bio-thm-sw-gap-wins = refl

-- ── 4. Variant Calling & Pileup Zygosity (Supersedes GATK / bcftools) ────────
data Genotype = gt-low-depth | gt-hom-ref | gt-het | gt-hom-alt

-- Exact integer allele-fraction caller:
--   depth < min_dp        => gt-low-depth
--   alt * 100 < 20 * dp   => gt-hom-ref  (0/0)
--   alt * 100 >= 80 * dp  => gt-hom-alt  (1/1)
--   otherwise             => gt-het      (0/1)
call-genotype : Word → Word → Word → Genotype
call-genotype ref-dp alt-dp min-dp =
  let tot = %wadd ref-dp alt-dp
      alt100 = %wmul alt-dp #100
  in if %wlt tot min-dp then gt-low-depth
     else if %wlt alt100 (%wmul #20 tot) then gt-hom-ref
     else if bio-le (%wmul #80 tot) alt100 then gt-hom-alt
     else gt-het

bio-thm-var-hom-ref : call-genotype #95 #2 #20 ≡ gt-hom-ref
bio-thm-var-hom-ref = refl

bio-thm-var-het : call-genotype #48 #52 #20 ≡ gt-het
bio-thm-var-het = refl

bio-thm-var-hom-alt : call-genotype #3 #97 #20 ≡ gt-hom-alt
bio-thm-var-hom-alt = refl

bio-thm-var-lowdp : call-genotype #5 #4 #20 ≡ gt-low-depth
bio-thm-var-lowdp = refl

-- ── 5. Bulk RNA-seq DE, scRNA-seq Exact QC & Integer Cosine Clustering ───────
data DeCall = de-low-expr | de-up | de-down | de-unchanged

-- Exact integer 2x fold-change differential expression gate (zero log2 float drift!):
rnaseq-de-call : Word → Word → Word → DeCall
rnaseq-de-call ctrl treat min-reads =
  if %wlt (%wadd ctrl treat) min-reads then de-low-expr
  else if bio-le (%wmul #2 ctrl) treat then de-up
  else if bio-le (%wmul #2 treat) ctrl then de-down
  else de-unchanged

