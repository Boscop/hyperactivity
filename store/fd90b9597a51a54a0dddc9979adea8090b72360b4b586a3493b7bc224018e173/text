-- ── 8. Protein Translation (64-Codon Genetic Code) & 3D Contact-Map Folding ──
data AminoAcid
  = aaMet | aaTrp | aaPhe | aaLeu | aaIle | aaVal | aaSer | aaPro
  | aaThr | aaAla | aaTyr | aaHis | aaGln | aaAsn | aaLys | aaAsp
  | aaGlu | aaCys | aaArg | aaGly | aaStop

-- Pack 3 bases into 6-bit codon index (0..63): b1*16 + b2*4 + b3
codon-id : Base → Base → Base → Word
codon-id b1 b2 b3 = %wor (%wshl (base-to-2b b1) #4) (%wor (%wshl (base-to-2b b2) #2) (base-to-2b b3))

-- Standard Nuclear Genetic Code (A=0, C=1, G=2, T=3):
--   ATG = 0*16+3*4+2 = 14 (Met/Start), TGG = 3*16+2*4+2 = 58 (Trp),
--   TAA = 48 / TAG = 50 / TGA = 56 (Stop), GGG = 42 (Gly), GCT = 39 (Ala), TTT = 63 (Phe)
translate-codon : Base → Base → Base → AminoAcid
translate-codon b1 b2 b3 =
  let c = codon-id b1 b2 b3
  in if %weq c #14 then aaMet
     else if %weq c #58 then aaTrp
     else if orB (%weq c #48) (orB (%weq c #50) (%weq c #56)) then aaStop
     else if orB (%weq c #40) (orB (%weq c #41) (orB (%weq c #42) (%weq c #43))) then aaGly
     else if orB (%weq c #36) (orB (%weq c #37) (orB (%weq c #38) (%weq c #39))) then aaAla
     else if orB (%weq c #61) (%weq c #63) then aaPhe
     else if orB (%weq c #57) (%weq c #59) then aaCys
     else if orB (%weq c #0) (%weq c #2) then aaLys
     else if orB (%weq c #32) (%weq c #34) then aaGlu
     else if orB (%weq c #33) (%weq c #35) then aaAsp
     else if orB (%weq c #12) (orB (%weq c #13) (%weq c #15)) then aaIle
     else if orB (%weq c #44) (orB (%weq c #45) (orB (%weq c #46) (%weq c #47))) then aaVal
     else if orB (%weq c #20) (orB (%weq c #21) (orB (%weq c #22) (%weq c #23))) then aaPro
     else if orB (%weq c #4) (orB (%weq c #5) (orB (%weq c #6) (%weq c #7))) then aaThr
     else if orB (%weq c #49) (%weq c #51) then aaTyr
     else if orB (%weq c #17) (%weq c #19) then aaHis
     else if orB (%weq c #16) (%weq c #18) then aaGln
     else if orB (%weq c #1) (%weq c #3) then aaAsn
     else if orB (%weq c #52) (orB (%weq c #53) (orB (%weq c #54) (orB (%weq c #55) (orB (%weq c #9) (%weq c #11))))) then aaSer
     else if orB (%weq c #24) (orB (%weq c #25) (orB (%weq c #26) (orB (%weq c #27) (orB (%weq c #8) (%weq c #10))))) then aaArg
     else aaLeu

bio-thm-codon-start-met : translate-codon bA bT bG ≡ aaMet
bio-thm-codon-start-met = refl

bio-thm-codon-stop-taa : translate-codon bT bA bA ≡ aaStop
