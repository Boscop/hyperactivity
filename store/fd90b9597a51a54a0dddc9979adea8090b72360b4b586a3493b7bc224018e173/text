-- ── Shared Exact Integer Order Helpers ───────────────────────────────────────
bio-le : Word → Word → Bool
bio-le a b = if %wlt b a then false else true

bio-max : Word → Word → Word
bio-max a b = if %wlt a b then b else a

bio-min : Word → Word → Word
bio-min a b = if %wlt a b then a else b

bio-abs-diff : Word → Word → Word
bio-abs-diff a b = if %wlt a b then %wsub b a else %wsub a b

-- ── 1. FASTQ Quality Control (Supersedes FastQC / Cutadapt / Trimmomatic) ────
-- Phred Q30 = 99.9% base call accuracy. Exact integer mean Q-score gate (sum_q >= min_q * len).
fastq-qc-pass : Word → Word → Word → Word → Bool
fastq-qc-pass read-len sum-phred min-len min-mean-q =
  andB (bio-le min-len read-len)
       (bio-le (%wmul min-mean-q read-len) sum-phred)

bio-thm-fastq-q30-pass : fastq-qc-pass #150 #4800 #100 #30 ≡ true
bio-thm-fastq-q30-pass = refl

bio-thm-fastq-lowq-reject : fastq-qc-pass #150 #3000 #100 #30 ≡ false
bio-thm-fastq-lowq-reject = refl

