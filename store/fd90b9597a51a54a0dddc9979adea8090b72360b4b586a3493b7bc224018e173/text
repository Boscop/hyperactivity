  bf-pipe "FASTQ_Q30_QC" (fastq-qc-pass #150 #4800 #100 #30)
  (bf-pipe "KMER_2BIT_MINIMIZER" (%weq (kmer-canon crispr-seed) (kmer-canon (st-revcomp crispr-seed)))
  (bf-pipe "SMITH_WATERMAN_EXACT" (%weq (sw-cell #4 #3 #3 bA bA) #6)
  (bf-pipe "VARIANT_CALL_HET" (is-gt-het (call-genotype #48 #52 #20))
  (bf-pipe "BULK_RNASEQ_DE" (is-de-up (rnaseq-de-call #120 #380 #50))
  (bf-pipe "SCRNA_UMI_COSINE" (andB (sc-qc-pass #4200 #120 #500 #10) (sc-cos2-edge #10 #20 #30 #20 #40 #60 #80))
  (bf-pipe "SPATIAL_COLOC" (spatial-coloc #100 #120 #103 #124 #25 #15 #12 #5)
  (bf-pipe "CRISPR_PAM_GC" (andB (is-pam-ngg bA bG bG) (crispr-gc-ok crispr-seed #40 #60))
  (bf-pipe "PROTEIN_CONTACT_FOLD" (prot-valid-contact #10 #10 #10 #16 #10 #10)
  (bf-pipe "STOICH_PCR_DILUTION" (andB (rxn-conserved rxn-atp-hydrolysis) (dilution-valid #100 #5 #10 #50))
  bf-nil)))))))))

