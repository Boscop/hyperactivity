bio-thm-de-flat = refl

-- scRNA-seq exact integer UMI & mitochondrial % QC gate (total_umi >= min_umi & 100*mito <= max_pct*total):
sc-qc-pass : Word → Word → Word → Word → Bool
sc-qc-pass total-umi mito-umi min-umi max-mito-pct =
  andB (bio-le min-umi total-umi)
       (bio-le (%wmul #100 mito-umi) (%wmul max-mito-pct total-umi))

bio-thm-sc-healthy-pass : sc-qc-pass #4200 #120 #500 #10 ≡ true
