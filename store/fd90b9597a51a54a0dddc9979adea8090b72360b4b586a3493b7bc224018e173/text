bio-thm-sc-empty-reject = refl

-- Exact integer scRNA-seq kNN cosine-similarity edge predicate (ZERO sqrt, ZERO float!):
-- cos^2(u, v) >= thresh_pct / 100  <=>  100 * (u.v)^2 >= thresh_pct * ||u||^2 * ||v||^2
sc-cos2-edge : Word → Word → Word → Word → Word → Word → Word → Bool
sc-cos2-edge u1 u2 u3 v1 v2 v3 thresh-pct =
  let dot = %wadd (%wmul u1 v1) (%wadd (%wmul u2 v2) (%wmul u3 v3))
      nu2 = %wadd (%wmul u1 u1) (%wadd (%wmul u2 u2) (%wmul u3 u3))
      nv2 = %wadd (%wmul v1 v1) (%wadd (%wmul v2 v2) (%wmul v3 v3))
  in bio-le (%wmul thresh-pct (%wmul nu2 nv2)) (%wmul #100 (%wmul dot dot))

-- Parallel cell expression profiles (10,20,30) & (20,40,60): cos^2 = 1.00 >= 0.80 -> connected!
bio-thm-sc-cos-parallel : sc-cos2-edge #10 #20 #30 #20 #40 #60 #80 ≡ true
bio-thm-sc-cos-parallel = refl

-- Orthogonal cell lineages (10,0,0) & (0,10,0): cos^2 = 0.00 < 0.80 -> separate clusters!
bio-thm-sc-cos-ortho : sc-cos2-edge #10 #0 #0 #0 #10 #0 #80 ≡ false
bio-thm-sc-cos-ortho = refl

-- ── 6. Spatial Transcriptomics Ligand-Receptor Colocalization ────────────────
-- Exact integer spatial neighborhood: (x1-x2)^2 + (y1-y2)^2 <= r^2 AND ligand>=min AND receptor>=min.
spatial-coloc : Word → Word → Word → Word → Word → Word → Word → Word → Bool
spatial-coloc x1 y1 x2 y2 r2 lig rec min-expr =
  let dx = bio-abs-diff x1 x2
      dy = bio-abs-diff y1 y2
      d2 = %wadd (%wmul dx dx) (%wmul dy dy)
  in andB (bio-le d2 r2) (andB (bio-le min-expr lig) (bio-le min-expr rec))

bio-thm-spatial-active : spatial-coloc #100 #120 #103 #124 #25 #15 #12 #5 ≡ true
bio-thm-spatial-active = refl

