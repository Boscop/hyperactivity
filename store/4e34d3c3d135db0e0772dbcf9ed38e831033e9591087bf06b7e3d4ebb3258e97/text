-- one row of Bareiss's step: entry j becomes (a·y_j − c·x_j)/q, a the pivot, x the pivot row's rest, c the row's
-- own first entry, q the previous pivot
in-row : BZ → BZ → BZ → List BZ → List BZ → List BZ
in-row a c q xs ys = case xs of
  nil → nil
  cons x xr → cons (bz-fdiv-z (bz-sub (bz-mul a (in-hd ys)) (bz-mul c x)) q) (in-row a c q xr (in-tl ys))
