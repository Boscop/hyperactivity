-- the last maps, stage 2 to the vertex holding the fermion
last-maps : Nat → Bool → Nat → Bool → Nat → List Nat → Rows → Rows
last-maps k sn n sm m dsP rs = if eqb k 1 then f-map sm m (stage2-ds k sn n sm m dsP) rs
  else (if eqb k 3 then f-map sm m (stage2-ds k sn n sm m dsP) rs
  else r-map sm m (if eqb k 2 then mid-base k sn n dsP else dsP) rs)
