-- transport in a line of function types: a function of an x at the end of the domain line; x is
-- carried back along the domain line, the function applied there, and the result carried forward
-- along the codomain line at x's filler (the paper's Π clause)
nk-transp-pi : NkTm → NkTm → NkTm → NkTm → NkTm
nk-transp-pi aline fline phi f =
  nk-lam (nk-transp
    (nk-lam (nk-app (nk-app fline (nk-var #0)) (nk-transp (nk-lam (nk-app aline (nk-or-i (nk-var #1) (nk-neg (nk-var #0))))) (nk-or-i phi (nk-var #0)) (nk-var #1))))
    phi
    (nk-app f (nk-transp (nk-lam (nk-app aline (nk-neg (nk-var #0)))) phi (nk-var #0))))
