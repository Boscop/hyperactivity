lc-dag-step : Nat → Word → Word → List Word → Bool × List Word
lc-dag-step zero    idx packed ws = (true , ws)
lc-dag-step (suc k) idx packed ws =
  let inA = %wand packed #15
      inB = %wand (%wshr packed #4) #15
  in if eth-not (andB (%wlt inA idx) (%wlt inB idx))
     then (false , ws)
     else
       let wA  = lc-nth-w inA ws
           wB  = lc-nth-w inB ws
           out = lc-nand16 wA wB
       in lc-dag-step k (%wadd idx #1) (%wshr packed #8) (list-append ws (cons out nil))
