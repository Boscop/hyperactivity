ce-cli-wfns : Lst (Word × Word) → Defs → List Word → List Word
ce-cli-wfns ars lnil acc = acc
ce-cli-wfns ars (lcons e r) acc = list-append (ce-head e) (list-append " { return " (ce-cli-wexp (toNat #4096) ars (fst (snd e)) (snd (snd e)) (list-append "; }" (list-append ce-nl (ce-cli-wfns ars r acc)))))
