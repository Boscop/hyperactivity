-- Every placed cell emits a closed 5-vertex Calma GDSII BOUNDARY polygon
AllGdsClosed : List Rect → Type
AllGdsClosed nil = Unit
AllGdsClosed (cons r rs) =
  ((list-length (gds-rect-xy5 r) ≡ toNat #5) ×
   (gds-pt-head (zero , zero) (gds-rect-xy5 r) ≡ gds-pt-last (zero , zero) (gds-rect-xy5 r))) ×
  AllGdsClosed rs
