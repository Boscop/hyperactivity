rf-pend-gs : (conf : List KvWrite) → (idx : Word) → (k : Word) → (pd : KvPend) → RfPend conf (ph-get-send k) idx pd → RfPend conf (ph-get-wait k) idx pd
rf-pend-gs conf idx k kp-none h = unit
rf-pend-gs conf idx k (kp-ack to w2) h = h
rf-pend-gs conf idx k (kp-val to rid v) h = (fst h , (λ e → Empty-rec (snd h e)))
