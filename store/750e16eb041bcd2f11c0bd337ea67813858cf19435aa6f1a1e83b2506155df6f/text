hm-main : List (List Word) → Step W Word
hm-main args =
  let fb = hm-a #0 args
      fo = hm-a #1 args
      ft = hm-a #2 args
      fw = hm-a #3 args
  in scmd w-now (λ t0 →
     scmd (w-file-read-named fb) (λ rb →
     scmd (w-file-read-named fo) (λ ro →
     scmd (w-file-read-named ft) (λ rt →
       let pb = hm-parse (snd rb)
           po = hm-parse (snd ro)
           pt = hm-parse (snd rt)
           ks = hm-dedup (hm-add-keys pt (hm-add-keys po (hm-add-keys pb nil))) nil
           mr = hm-run ks pb po pt #0 #0 nil
           cnt = fst (fst mr)
           conf = snd (fst mr)
       in scmd (w-file-write-named fw (snd mr)) (λ _ →
          scmd w-now (λ t1 →
          cli-say (list-append "HX-Merge paths=" (list-append (ce-dec cnt) (list-append " conflicts=" (list-append (ce-dec conf) (list-append " (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)")))))) (sdone conf)))))))
