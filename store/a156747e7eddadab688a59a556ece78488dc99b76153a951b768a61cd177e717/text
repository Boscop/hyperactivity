opt-2-le : {V : Type} → (b : B2) → (x y : Circ B0 B1 B2 V) →
  leB (circ-gates (opt-2 b x y)) (suc (plus (circ-gates x) (circ-gates y))) ≡ true
opt-2-le {V} b x y =
  case x return (λ w →
    Path Bool
      (leB (circ-gates {B0} {B1} {B2} {V} (opt-2 {V} b w y))
           (suc (plus (circ-gates {B0} {B1} {B2} {V} w) (circ-gates {B0} {B1} {B2} {V} y))))
      true) of
    cwire v → leB-refl (suc (circ-gates y))
    cop0 c → opt-2-l0-le b c y
    cop1 u a → leB-refl (suc (suc (plus (circ-gates a) (circ-gates y))))
    cop2 b2 x1 x2 → leB-refl (suc (suc (plus (plus (circ-gates x1) (circ-gates x2)) (circ-gates y))))
