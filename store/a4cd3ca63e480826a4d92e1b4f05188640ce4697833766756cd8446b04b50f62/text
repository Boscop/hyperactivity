c-after : (n : Nat) → Bytes n → (k : Nat) → Bytes k → Word → Word → Word → List (List Word × Word) → Proc W (Word × List (List Word))
c-after n q k f e best r nil = ret (#0 , nil)
c-after n q k f e best r (cons x rs) = bind (c-after-one n q k f e best r x) (λ one →
  bind (c-after n q k f e best (wsub r (m-len #0 (list-map (λ l → #0) (snd one)))) rs) (λ rest →
  ret (wadd (fst one) (fst rest) , list-append (snd one) (snd rest))))
