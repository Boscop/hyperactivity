record WitnessBoundary (In Out Wit : Type) =
  { wb-spec   : In → Out → Bool
  ; wb-verify : In → Out → Wit → Bool
  ; wb-sound  : (x : In) → (y : Out) → (w : Wit) → wb-verify x y w ≡ true → wb-spec x y ≡ true
  }

fio-thm-witness-certifies :
  {A B C : Type} → (wb : WitnessBoundary A B C) →
  (x : A) → (y : B) → (w : C) →
  wb-verify wb x y w ≡ true → wb-spec wb x y ≡ true
fio-thm-witness-certifies wb x y w pf = wb-sound wb x y w pf
