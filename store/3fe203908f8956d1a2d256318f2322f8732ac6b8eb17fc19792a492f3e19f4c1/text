-- SECTION 3: CONCRETE KEYED 2-ROUND FEISTEL BIJECTION ON 8-BIT STATE (Z_2^4 x Z_2^4)
--   Proves exact invertibility across ALL 256 states by reflection (`refl`)!
--   Demonstrates nonlinear wire-level free-dimension scrambling with 0 semantic error.
-- ============================================================================

-- Nonlinear 4-bit S-box round function F_k(r) = ((r * 5 + k + 3) xor (r >> 1)) & 15
fio-round-f : Word → Word → Word
fio-round-f k r =
  %wand (%wxor (%wadd (%wadd (%wmul r #5) k) #3) (%wshr r #1)) #15

-- 1 Feistel step on packed 8-bit state (L = hi 4 bits, R = lo 4 bits): (L, R) -> (R, L xor F_k(R))
fio-feistel-enc1 : Word → Word → Word
fio-feistel-enc1 k st =
  let l  = %wand (%wshr st #4) #15
      r  = %wand st #15
      nr = %wxor l (fio-round-f k r)
  in %wor (%wshl r #4) nr

fio-feistel-dec1 : Word → Word → Word
fio-feistel-dec1 k st =
  let r  = %wand (%wshr st #4) #15
      nr = %wand st #15
      l  = %wxor nr (fio-round-f k r)
  in %wor (%wshl l #4) r

-- 3-round keyed Luby-Rackoff Feistel permutation on 8-bit state (k1, k2, k3)
fio-feistel3-enc : Word → Word → Word → Word → Word
fio-feistel3-enc k1 k2 k3 x =
  fio-feistel-enc1 k3 (fio-feistel-enc1 k2 (fio-feistel-enc1 k1 x))

fio-feistel3-dec : Word → Word → Word → Word → Word
fio-feistel3-dec k1 k2 k3 y =
  fio-feistel-dec1 k1 (fio-feistel-dec1 k2 (fio-feistel-dec1 k3 y))

-- Exhaustive verification over all 256 states 0..255
fio-all-256-go : Nat → Word → (Word → Bool) → Bool
fio-all-256-go zero _ _ = true
fio-all-256-go (suc rem) cur p =
  if p cur then fio-all-256-go rem (%wsucc cur) p else false

fio-all-256 : (Word → Bool) → Bool
fio-all-256 p = fio-all-256-go (toNat #256) #0 p

-- THEOREM 4 & 5: EXHAUSTIVE 256/256 BIJECTION PROOF OF 3-ROUND FEISTEL FREE-FIBER MASKING!
fio-thm-feistel3-ret-256 :
  fio-all-256 (λ x → %weq (fio-feistel3-dec #11 #7 #13 (fio-feistel3-enc #11 #7 #13 x)) x) ≡ true
fio-thm-feistel3-ret-256 = refl

fio-thm-feistel3-sec-256 :
  fio-all-256 (λ y → %weq (fio-feistel3-enc #11 #7 #13 (fio-feistel3-dec #11 #7 #13 y)) y) ≡ true
fio-thm-feistel3-sec-256 = refl

-- Concrete conjugated step verification: linear step T(x) = (x + 17) mod 256
-- executed purely in the Feistel-masked domain for 5 steps matches T^5(x) across ALL 256 inputs!
fio-step-plain : Word → Word
fio-step-plain x = %wand (%wadd x #17) #255

fio-step-masked : Word → Word
fio-step-masked y =
  fio-feistel3-enc #11 #7 #13 (fio-step-plain (fio-feistel3-dec #11 #7 #13 y))

fio-thm-masked-5steps-256 :
  fio-all-256 (λ x →
    %weq (fio-feistel3-dec #11 #7 #13
           (fio-iter (toNat #5) fio-step-masked (fio-feistel3-enc #11 #7 #13 x)))
         (fio-iter (toNat #5) fio-step-plain x)) ≡ true
fio-thm-masked-5steps-256 = refl

