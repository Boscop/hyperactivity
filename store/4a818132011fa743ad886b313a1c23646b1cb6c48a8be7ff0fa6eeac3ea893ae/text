hvec-add-swap4 : (k : Nat) → (a b c d : HVec k) →
  hvec-add k (hvec-add k a b) (hvec-add k c d) ≡ hvec-add k (hvec-add k a c) (hvec-add k b d)
hvec-add-swap4 zero a b c d =
  λ i → (plusw-swap4 (fst a) (fst b) (fst c) (fst d) i , plusw-swap4 (snd a) (snd b) (snd c) (snd d) i)
hvec-add-swap4 (suc k) a b c d =
  λ i → (hvec-add-swap4 k (fst a) (fst b) (fst c) (fst d) i , hvec-add-swap4 k (snd a) (snd b) (snd c) (snd d) i)
