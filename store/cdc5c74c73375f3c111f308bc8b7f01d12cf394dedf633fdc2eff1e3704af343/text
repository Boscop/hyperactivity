lc-pouw-runtime : List Word → List Word
lc-pouw-runtime vault20 =
  let f20 = eth-founder-coinbase-addr20
  in evm-assemble
       (lc-inst-concat
         (cons (lc-evm-dispatch f20)
         (cons lc-evm-verifier-entry
         (cons (lc-evm-verifier-loop f20)
         (cons (lc-evm-anchor-and-revert f20 vault20) nil)))))
