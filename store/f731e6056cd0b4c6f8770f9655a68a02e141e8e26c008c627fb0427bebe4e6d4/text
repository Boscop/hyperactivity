bn-encode-eth-to-usdc recip20 ethWei minUsdc6 =
  h-concat
    (cons bn-uni3-sel4
    (cons (bn-abi-addr20 bn-weth-base20)
    (cons (bn-abi-addr20 bn-usdc-base20)
    (cons (eth-word-be32 #500)
