-- the kind of a C type at a Target
ct-sk : Target → CTy → MRes SK
ct-sk t c = case c of
  ct-bool → mok sk-bool
  ct-float → (case weq (ct-size t c) #4 of
    true → mok sk-f32
    false → mstop st-unsupported)
  ct-double → (case weq (ct-size t c) #8 of
    true → mok sk-f64
    false → mstop st-unsupported)
  ct-ptr → mok sk-ptr
  _ → mr-map (sk-int (ct-signed t c)) (iw-of-size (ct-size t c))
