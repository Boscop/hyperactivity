go-below : (n : Nat) → (f : Fin n → Int64) → (m j : Nat) → (h : le m n) → (hj : le (suc j) n) → (a : Array n) → le (suc j) m → index n (tabF-go n f m h a) j hj ≡ f (j , hj)
go-below n f zero j h hj a l = Empty-rec (le-suc-zero j l)
go-below n f (suc m) j h hj a l =
  case le-split j m l of
    inl l2 → go-below n f m j (le-pred m n h) hj (update n a m h (f (m , h))) l2
    inr e → concat (go-above n f m j (le-pred m n h) hj (update n a m h (f (m , h))) (subst {lzero} {lzero} {Nat} {λ x → le m x} {m} {j} (sym {lzero} {Nat} {j} {m} e) (le-refl m)))
                   (go-below-last n f m j h hj a e)
