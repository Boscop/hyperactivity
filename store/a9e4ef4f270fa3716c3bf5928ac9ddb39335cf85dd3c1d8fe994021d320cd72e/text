-- the rows of the interval. Eliminators: 5 reversal, 6 meet, 7 join, each on an interval point;
-- meet and join, having met their first point, wait on the second carrying the first (16, 17)
nk-is-iop : Word → Bool
nk-is-iop h = if %weq h #5 then true else (if %weq h #6 then true else (if %weq h #7 then true else (if %weq h #16 then true else %weq h #17)))
