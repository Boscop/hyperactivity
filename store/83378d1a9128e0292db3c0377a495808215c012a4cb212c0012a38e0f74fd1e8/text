-- a published work on the front page: its title, read from it, linking to its public name
s-work-li : Work → Proc W (List Word)
s-work-li (work n k p) = bind (s-work-text (work n k p)) (λ t → ret {lzero} {W} (h-concat (cons "<li><a href='/" (cons n (cons "'>" (cons (s-esc (s-title-or n t)) (cons "</a></li>" nil)))))))
