-- Template: cwlit
cs-wlit-template-sound : (k j : Nat) (fns : CsFns) (ars : Lst (Word × Word)) (hp : CsHeap) (env : CsEnv) (d n : Word) →
  (cs-w64 n ≡ true) →
  cs-eval (suc k) fns hp env (cs-compile (suc j) ars d (cwlit n)) ≡ cs-ok hp (csv-word n)
cs-wlit-template-sound k j fns ars hp env d n h64 =
  cong (λ z → if z then cs-ok hp (csv-word n) else cs-ub) h64
