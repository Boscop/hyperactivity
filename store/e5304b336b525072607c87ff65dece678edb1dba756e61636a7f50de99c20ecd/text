-- UNIVERSAL RECURSIVE HYPER-HYPERFACTORING (NESTED FUTAMURA-ON-FUTAMURA, 1-CELL)
fut-thm-fut2-sound : (s1 s2 : Word → Opt Bool) → (d : Word → Bool) → (e : FExpr) →
  feval d (f-mix s2 (f-mix s1 e)) ≡ feval (f-merge s1 (f-merge s2 d)) e
fut-thm-fut2-sound s1 s2 d e =
  web-trans-b
    (fut-thm-mix-sound s2 d (f-mix s1 e))
    (fut-thm-mix-sound s1 (f-merge s2 d) e)
