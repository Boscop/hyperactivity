-- Public Hyperactivity-computed SVG #2: Sculpted Self-Similar Hyperbolic H Emblem (depth-1 cavity recursion)
logo-sculpted-emblem-svg : List Word
logo-sculpted-emblem-svg =
  let cx = sp #1280
      cy = sp #1280
      W0 = sp #800
      H0 = sp #880
      T0 = sp #190
      B0 = sp #238
      F0 = sp #258
      mainH = h-glyph-d cx cy W0 H0 T0 B0 F0
      slit = lens-d cx cy (fx-mul (si-sub W0 F0) (sp #7200)) (fx-mul B0 (sp #3400))
      -- Strictly internal self-similar child H-portals at 0.31 scale inside upper & lower cavities
      cW = fx-mul W0 (sp #3100)
      cH = fx-mul H0 (sp #3100)
      cT = fx-mul T0 (sp #3500)
      cB = fx-mul cH (sp #2700)
      cF = fx-mul F0 (sp #3100)
      yOff = fx-mul H0 (sp #6900)
      topH = h-glyph-d cx (si-sub cy yOff) cW cH cT cB cF
      botH = h-glyph-d cx (si-add cy yOff) cW cH cT cB cF
  in lg-concat (cons "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 256 256' width='256' height='256'><rect width='256' height='256' fill='#ff0a94'/><path d='"
       (cons mainH (cons "' fill='#fff'/><path d='" (cons slit (cons "' fill='#ff0a94'/><path d='" (cons topH (cons " " (cons botH (cons "' fill='#fff'/></svg>" nil)))))))))
