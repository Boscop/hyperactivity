evm-vault-part2 : List Word → List Word → List EvmInst
evm-vault-part2 founder20 relayer20 =
  -- Lbl #20: sweepToken(address token) -> 100% of `token.balanceOf(this)` to `founder20`!
  list-append
    (cons (ev-lbl #20)
    (cons (ev-op #80)                   -- POP sel
    (cons (ev-push (cons #4 nil))
    (cons (ev-op #53) nil))))           -- CALLDATALOAD(4) = token
  (list-append (evm-bal-of-this #99)    -- stack: [bal]
  (list-append
    (cons (ev-push (cons #4 nil))
    (cons (ev-op #53)                   -- stack: [token, bal]
    (cons (ev-op #144) nil)))           -- SWAP1 -> [bal, token]
  (list-append (evm-transfer-to-founder founder20 #99)
    (cons (ev-op #0) nil))))            -- STOP
