nat-eq-trans-false : (q e1 e2 : Nat) → nat-eq e1 e2 ≡ false →
  andB (nat-eq q e1) (nat-eq q e2) ≡ false
nat-eq-trans-false zero zero zero h = Empty-rec {lzero} {true ≡ false} (false≢true (sym h))
nat-eq-trans-false zero zero (suc e2) _ = λ _ → false
nat-eq-trans-false zero (suc e1) e2 _ = λ _ → false
nat-eq-trans-false (suc q) zero e2 _ = λ _ → false
nat-eq-trans-false (suc q) (suc e1) zero _ = andB-false-r (nat-eq q e1)
nat-eq-trans-false (suc q) (suc e1) (suc e2) h = nat-eq-trans-false q e1 e2 h
