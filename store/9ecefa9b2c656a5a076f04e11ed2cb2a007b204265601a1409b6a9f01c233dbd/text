bac-false : {o : Ord} → (b : List (El o) → RTree (El o)) →
            ((l : List (El o)) → Sorted l → (k : El o) → cnt-tree k (b l) ≡ fromNat (count-lt k l)) →
            (k x : El o) → (a r : List (El o)) → Sorted (list-append a (cons x r)) → leq k x ≡ false →
            wadd (%wsucc (fromNat (list-length a))) (cnt-tree k (b r)) ≡ fromNat (plus (count-lt k a) (plus (one-if (not false)) (count-lt k r)))
bac-false b ih k x a r s2 e =
  let la = count-lt-all {o} k x a r s2 (isTrue-not e)
      sr = sorted-app-r {o} a (cons x r) s2
  in tr (wadd (fromNat (suc (list-length a))) (fromNat (count-lt k r))) (λ i → wadd (fromNat (suc (list-length a))) (ih r (snd sr) k i))
       (tr (fromNat (plus (suc (list-length a)) (count-lt k r))) (sym (fromNat-wadd (suc (list-length a)) (count-lt k r)))
          (λ i → fromNat (tr (plus (list-length a) (suc (count-lt k r))) (sym (plus-suc (list-length a) (count-lt k r))) (λ j → plus (la (~ j)) (suc (count-lt k r))) i)))
