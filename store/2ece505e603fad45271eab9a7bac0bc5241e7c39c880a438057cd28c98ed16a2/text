arm64-encode-prog : Word → Defs → Lst Word
arm64-encode-prog m defs =
  let n = opt-or (x-arity defs m) #0
      slen = l-count (a64-stub n #0)
      ars = x-arities defs
      ap = if x-needs-apply ars defs then a64-apply else lnil
      offs = lcons (x-apply-key , slen) (a64-layout ars defs (%wadd slen (l-count ap)))
      tbl = the Tbl (ars , offs)
  in l-app (a64-stub n (x-tbl tbl m)) (l-app ap (a64-fns tbl defs))
