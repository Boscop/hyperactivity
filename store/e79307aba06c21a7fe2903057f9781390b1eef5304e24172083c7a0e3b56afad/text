-- Exact table of hardware active-pair rules (mirrors `hyperinet_core.fire_pair`):
-- returns `(new-a, new-b, (rewire-dst, rewire-ref))`
inet-pair-act : INetSlot → INetSlot → (INetSlot × INetSlot) × (Word × Word)
inet-pair-act (islot ia ik-num _ _ vx) (islot ib ik-add _ p1b _) =
  ((islot ia ik-free #3 #3 #0 , islot ib ik-add1 p1b #3 vx) , (p1b , %wmul ib #4))
inet-pair-act (islot ia ik-add1 _ p1a vx) (islot ib ik-num _ _ vy) =
  ((islot ia ik-free #3 #3 #0 , islot ib ik-num p1a #3 (%wmod (%wadd vx vy) #256)) , (p1a , %wmul ib #4))
inet-pair-act (islot ia ik-num _ _ vx) (islot ib ik-dup _ p1b _) =
  ((islot ia ik-num p1b #3 (%wmod vx #256) , islot ib ik-num #3 #3 (%wmod vx #256)) , (#3 , #3))
inet-pair-act a b = ((a , b) , (#3 , #3))
