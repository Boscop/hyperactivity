-- the text s, read, as text: seg is the run of ordinary bytes read so far; at a quote or a newline the
-- run's literal is joined to that byte and to the rest
raw-as-literals : List Word → List Word → List Word
raw-as-literals seg nil = raw-literal seg
raw-as-literals seg (cons b r) = if orB (weq b #34) (weq b #10) then list-append "(list-append " (list-append (raw-literal seg) (list-append " (cons #" (list-append (if weq b #34 then "34" else "10") (list-append " " (list-append (raw-as-literals nil r) "))"))))) else raw-as-literals (list-append seg (cons b nil)) r
