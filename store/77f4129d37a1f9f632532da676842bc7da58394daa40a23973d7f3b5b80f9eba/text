xp-ty-eq : (a b : XpTy) → Dec (a ≡ b)
xp-ty-eq xt-nat xt-nat = yes (λ k → xt-nat)
xp-ty-eq xt-nat (xt-prod c d) = no (λ r → true≢false (λ k → xp-is-nat (r k)))
xp-ty-eq (xt-prod a b) xt-nat = no (λ r → true≢false (λ k → xp-is-nat (r (~ k))))
xp-ty-eq (xt-prod a b) (xt-prod c d) = xp-prod-dec a b c d (xp-ty-eq a c) (xp-ty-eq b d)
