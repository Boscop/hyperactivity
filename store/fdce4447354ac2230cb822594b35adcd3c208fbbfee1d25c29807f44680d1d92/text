s-wasm-resp : Sum Unit (List Word) → List Word
s-wasm-resp (inl u) = s-respond "503 Service Unavailable" "text/plain" "cubical.wasm is not built yet"
s-wasm-resp (inr hx) = list-append (h-concat (cons "HTTP/1.1 200 OK" (cons h-crlf (cons "Content-Type: application/wasm" (cons h-crlf (cons "Content-Length: " (cons (h-decimal (wshr (fromNat (list-length hx)) #1)) (cons h-crlf (cons "Cache-Control: public, max-age=3600" (cons h-crlf (cons "Connection: close" (cons h-crlf (cons h-crlf nil))))))))))))) (h-unhex hx)
