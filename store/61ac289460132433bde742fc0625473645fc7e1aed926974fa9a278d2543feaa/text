pos-div-node E a b v pa pb h = zpos-factor (fst v) (fst (fst (snd h)))
  (posn-qeq (zmul (fst v) (fst (fst (snd h))) , times (snd v) (snd (fst (snd h)))) (fst h) (snd (snd (snd (snd h))))
     (le1-times (snd v) (snd (fst (snd h))) (fst (snd (snd (snd h)))) (isval-pos E b (fst (snd h)) (snd (fst (snd (snd h))))))
     (pa (fst h) (fst (fst (snd (snd h))))))
  (pb (fst (snd h)) (snd (fst (snd (snd h)))))
