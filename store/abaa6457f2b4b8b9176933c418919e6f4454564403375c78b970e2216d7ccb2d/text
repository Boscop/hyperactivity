-- General Hash-Consed Gate-Table CSE: if wire `wExisting` already computes `nand2 (val u) (val v)`,
-- reusing `wExisting` adds ZERO gates while preserving exact Boolean evaluation!
cse-reuse-sound : (val : Word → Bool) → (u v wExisting : Word) →
  val wExisting ≡ nand2 (val u) (val v) →
  val wExisting ≡ fold {B0} {Empty} {Unit} {Word} {Bool} nand-alg val (sc-nand (cwire u) (cwire v))
cse-reuse-sound val u v wExisting h = h
