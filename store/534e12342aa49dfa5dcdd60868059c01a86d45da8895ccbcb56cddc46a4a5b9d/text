-- one request: similar rests give similar steps, for each request
oc-sim-on : (p1 : Proc {lzero} oc-S1 Unit) → (p2 : Proc {lzero} oc-S2 Unit) → oc-Sim p1 p2 → (q : oc-Req) → oc-Sim (oc-on1 p1 q) (oc-on2 p2 q)
oc-sim-on p1 p2 ih q =
  case q return (λ z → oc-Sim (oc-on1 p1 z) (oc-on2 p2 z)) of
    oc-inc → λ x y e → ih (suc x) (suc y) (λ i → suc (e i))
    oc-get → λ x y e → ((λ i → oc-reply (e i)) , λ u u2 pu → ih x y e)
    oc-stop → λ x y e → ((λ i → unit) , e)
