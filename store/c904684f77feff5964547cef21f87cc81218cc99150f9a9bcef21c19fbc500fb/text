-- Peres–Mermin Kochen–Specker Impossibility Theorem:
-- No non-contextual assignment (a..z : Bool) can make all 3 rows even (+1 = false),
-- cols 1 & 2 even (+1 = false), and col 3 odd (-1 = true).
rqm-peres-mermin-impossible :
  (a b c d e f g h z : Bool) →
  pm-xor3 a b c ≡ false →
  pm-xor3 d e f ≡ false →
  pm-xor3 g h z ≡ false →
  pm-xor3 a d g ≡ false →
  pm-xor3 b e h ≡ false →
  pm-xor3 c f z ≡ true →
  Empty
rqm-peres-mermin-impossible a b c d e f g h z r1 r2 r3 c1 c2 c3 =
  let lhs = λ i → pm-xor3 (r1 i) (r2 i) (r3 i)
      rhs = λ i → pm-xor3 (c1 i) (c2 i) (c3 i)
  in pm-false-ne-true (concat (sym lhs) (concat (pm-row-col-parity a b c d e f g h z) rhs))
