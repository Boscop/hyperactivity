-- one place of the subtraction
sub-step : (x : Bool) → (xs b : List Bool) → (c : Bool) → ((c2 : Bool) → (b2 : List Bool) → le (plus (bitn c2) (bin-to-nat b2)) (bin-to-nat xs) → plus (bin-to-nat (bin-subb c2 xs b2)) (plus (bitn c2) (bin-to-nat b2)) ≡ bin-to-nat xs) → le (plus (bitn c) (bin-to-nat b)) (bin-to-nat (cons x xs)) → plus (bin-to-nat (bin-subb c (cons x xs) b)) (plus (bitn c) (bin-to-nat b)) ≡ bin-to-nat (cons x xs)
sub-step x xs b c ih h =
  transN (cong2plus (bin-to-nat (bin-cons (bit-eq (bit-eq x (bin-head b)) c) (bin-subb (borrow3 x (bin-head b) c) xs (bin-tail b))))
                    (plus (bitn (bit-eq (bit-eq x (bin-head b)) c)) (times 2 (bin-to-nat (bin-subb (borrow3 x (bin-head b) c) xs (bin-tail b)))))
                    (plus (bitn c) (bin-to-nat b)) (plus (bitn c) (plus (bitn (bin-head b)) (times 2 (bin-to-nat (bin-tail b)))))
                    (transN (bin-cons-sound (bit-eq (bit-eq x (bin-head b)) c) (bin-subb (borrow3 x (bin-head b) c) xs (bin-tail b)))
                            (cons-val (bit-eq (bit-eq x (bin-head b)) c) (bin-subb (borrow3 x (bin-head b) c) xs (bin-tail b))))
                    (congN (plus (bitn c)) (bin-split b)))
  (transN (sub-goal-alg (bitn (bit-eq (bit-eq x (bin-head b)) c)) (bitn c) (bitn (bin-head b)) (bitn x) (bitn (borrow3 x (bin-head b) c))
            (bin-to-nat (bin-subb (borrow3 x (bin-head b) c) xs (bin-tail b))) (bin-to-nat (bin-tail b)) (bin-to-nat xs)
            (sub-bit x (bin-head b) c)
            (ih (borrow3 x (bin-head b) c) (bin-tail b)
              (fst (snd (bsplit (fst h))) ,
               sub-hyp-alg (fst (bsplit (fst h))) (bit-eq (bit-eq x (bin-head b)) c) (fst h) (fst (snd (bsplit (fst h))))
                 (bitn c) (bitn (bin-head b)) (bin-to-nat (bin-tail b)) (bitn x) (bin-to-nat xs) (bitn (borrow3 x (bin-head b) c))
                 (transN (congN (λ z → plus (fst h) (plus (bitn c) z)) (symN (bin-split b))) (transN (snd h) (cons-val x xs)))
                 (sub-bit x (bin-head b) c)
                 (snd (snd (bsplit (fst h)))))))
          (symN (cons-val x xs)))
