-- lengths and tests that do not see the vectors
sy-len-map : (X Y : Type) → (g : X → Y) → (xs : List X) → sy-len Y (ln-map X Y g xs) ≡ sy-len X xs
sy-len-map X Y g xs = case xs return λ w → sy-len Y (ln-map X Y g w) ≡ sy-len X w of
  nil → λ i → zero
  cons x xr → λ i → suc (sy-len-map X Y g xr i)
