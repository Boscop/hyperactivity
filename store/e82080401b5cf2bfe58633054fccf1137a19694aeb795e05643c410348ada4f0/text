factor-motif-go : Nat → List MTerm → List MTerm → List MTerm
factor-motif-go zero pat xs = list-map mterm-shift-ref xs
factor-motif-go (suc fuel) pat nil = nil
factor-motif-go (suc fuel) pat (cons x xs) =
  case split-prefix mterm-eq pat (cons x xs) of
    some rest → cons (mref #0) (factor-motif-go fuel pat rest)
    none → cons (mterm-shift-ref x) (factor-motif-go fuel pat xs)
