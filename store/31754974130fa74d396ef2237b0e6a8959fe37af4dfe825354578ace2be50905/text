-- 2. Exact Spin–Orbit Coupling & Center-of-Gravity Conservation
-- ============================================================================
-- Vector identity 2 L · S = ‖L + S‖² - ‖L‖² - ‖S‖² (6 variables: Lx,Ly,Lz, Sx,Sy,Sz).
phys-spin-orbit-vec-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
phys-spin-orbit-vec-poly A ad mu q vs =
  (λ g sub sq →
    let lx = g 0; ly = g 1; lz = g 2
        sx = g 3; sy = g 4; sz = g 5
        q2 = q (fn-q 2 1)
        j2 = ad (ad (sq (ad lx sx)) (sq (ad ly sy))) (sq (ad lz sz))
        l2 = ad (ad (sq lx) (sq ly)) (sq lz)
        s2 = ad (ad (sq sx) (sq sy)) (sq sz)
        ls = ad (ad (mu lx sx) (mu ly sy)) (mu lz sz)
    in (sub (sub j2 l2) s2 , mu q2 ls))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
