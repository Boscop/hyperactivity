-- Verify founder Coinbase address `0x4A50FBF0128E2679C42466A8cC1A9D230b08A26f` is embedded in runtime
-- bytecode AND Ethereum Yellow Paper CREATE address vector passes by `refl`!
evm-thm-founder-hardcoded-and-create-exact :
  let sampleRelayer = eth-priv-to-addr20 #1
      rtHex         = h-hex (evm-vault-runtime sampleRelayer)
      ypSender      = eth-from-hex "6ac7ea33f8831ea9dcc53393aaa88b25a785dbf0"
  in andB (h-infix "4a50fbf0128e2679c42466a8cc1a9d230b08a26f" rtHex)
          (h-eq (h-hex (eth-create-addr20 ypSender #0)) "cd234a471b72ba2f1ccf0a70fcaba648a5eecd8d") ≡ true
evm-thm-founder-hardcoded-and-create-exact = refl
