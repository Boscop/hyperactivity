zz-delta-go-ok : (p : Word) → (xs : List Word) → zz-undelta-go p (zz-delta-go p xs) ≡ xs
zz-delta-go-ok p xs =
  (case xs return (λ u → (prev : Word) → zz-undelta-go prev (zz-delta-go prev u) ≡ u) of
     nil → λ prev i → nil
     cons x r → λ prev →
       let px : zz-dec prev (zz-enc prev x) ≡ x
           px = zz-dec-enc prev x
       in λ i → cons (px i) (concat {lzero} {List Word}
                               {zz-undelta-go (zz-dec prev (zz-enc prev x)) (zz-delta-go x r)}
                               {zz-undelta-go x (zz-delta-go x r)} {r}
                               (λ j → zz-undelta-go (px j) (zz-delta-go x r))
                               (rec r x) i)) p
