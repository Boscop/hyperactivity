-- a positive verdict means value > 0
bz-nonpos-false : (s : Bool) → (m : List Bool) → bcanon m ≡ true → bz-nonpos (s , m) ≡ false → le (suc (plus zero (snd (zv (s , m))))) (plus (fst (zv (s , m))) zero)
bz-nonpos-false s m c = case s return λ u → bz-nonpos (u , m) ≡ false → le (suc (plus zero (snd (zv (u , m))))) (plus (fst (zv (u , m))) zero) of
  true → λ h → nonpos-fv m (bin-null m) (symB (bin-null-sound m c)) h
  false → λ h → nonpos-ff m (bin-null m) h
