bn-parse-le32s : Nat → List Word → List Word
bn-parse-le32s zero    bs = nil
bn-parse-le32s (suc k) bs =
  let b0 = bn-nth-w #0 bs
      b1 = bn-nth-w #1 bs
      b2 = bn-nth-w #2 bs
      b3 = bn-nth-w #3 bs
      w  = %wor b0 (%wor (%wshl b1 #8) (%wor (%wshl b2 #16) (%wshl b3 #24)))
  in cons w (bn-parse-le32s k (kc-drop (toNat #4) bs))
