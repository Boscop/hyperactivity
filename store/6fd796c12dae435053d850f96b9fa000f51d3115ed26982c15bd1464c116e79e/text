-- Standard Clifford+T Toffoli gate decomposition (7 T-gates, Amy et al. 2013):
--   Toffoli(a, b, c) = H c; CNOT b c; Tdg c; CNOT a c; T c; CNOT b c; Tdg c; CNOT a c;
--                      T b; T c; CNOT a b; H c; T a; Tdg b; CNOT a b
q-toffoli : Word → Word → Word → List QGate
q-toffoli a b c =
  cons (qg-h c)
  (cons (qg-cnot b c)
  (cons (qg-rz c #7)
  (cons (qg-cnot a c)
  (cons (qg-rz c #1)
  (cons (qg-cnot b c)
  (cons (qg-rz c #7)
  (cons (qg-cnot a c)
  (cons (qg-rz b #1)
  (cons (qg-rz c #1)
  (cons (qg-cnot a b)
  (cons (qg-h c)
  (cons (qg-rz a #1)
  (cons (qg-rz b #7)
  (cons (qg-cnot a b) nil))))))))))))))
