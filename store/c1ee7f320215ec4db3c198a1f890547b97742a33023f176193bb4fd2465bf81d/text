-- ⟨j1 m1, j2 m2 | J M⟩ from the doubled spins and the projections x1 = j1+m1, x2 = j2+m2, X = J+M
cg : Nat → Nat → Nat → Nat → Nat → Nat → CG
cg tj1 tj2 tJ x1 x2 X =
  cg-from (half (monus (plus tj1 tj2) tJ)) (half (monus (plus tj1 tJ) tj2)) (half (monus (plus tj2 tJ) tj1))
    (half (plus (plus tj1 tj2) tJ)) tJ x1 (monus tj1 x1) x2 (monus tj2 x2) X (monus tJ X)
    (if triangle tj1 tj2 tJ then eqb (plus (plus X X) (plus tj1 tj2)) (plus (plus (plus x1 x1) (plus x2 x2)) tJ) else false)
