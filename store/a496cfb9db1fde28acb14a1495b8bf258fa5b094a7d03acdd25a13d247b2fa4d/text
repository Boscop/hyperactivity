import "host.hypercubical"

-- ============================================================================
-- SECTION 1: PURE JSON STRING ESCAPER & RAW JSON STRING EXTRACTOR (PROVED REFL)
-- ============================================================================

this-q : List Word
this-q = cons #34 nil

this-bs : List Word
this-bs = cons #92 nil

this-esc-json : List Word → List Word
this-esc-json nil = nil
this-esc-json (cons c r) =
  if %weq c #34 then cons #92 (cons #34 (this-esc-json r)) else
  if %weq c #92 then cons #92 (cons #92 (this-esc-json r)) else
  if %weq c #10 then cons #92 (cons #110 (this-esc-json r)) else
  if %weq c #13 then cons #92 (cons #114 (this-esc-json r)) else
  if %weq c #9  then cons #92 (cons #116 (this-esc-json r)) else
  if %wlt c #32 then this-esc-json r else
  cons c (this-esc-json r)

-- Read raw JSON string body (already JSON-escaped!) up to unescaped closing quote #34
-- Structurally recursive on List Word (O(1) kernel size, handles arbitrarily long injections!)
this-take-jstr : List Word → List Word
this-take-jstr nil = nil
this-take-jstr (cons c r) =
  if %weq c #34 then nil
  else if %weq c #92 then
    (case r of
      nil → nil
      cons c2 r2 → cons #92 (cons c2 (this-take-jstr r2)))
  else cons c (this-take-jstr r)

this-skip-ws : List Word → List Word
this-skip-ws nil = nil
this-skip-ws (cons c r) =
  if orB (%weq c #32) (orB (%weq c #9) (orB (%weq c #10) (%weq c #13)))
  then this-skip-ws r else cons c r

this-after-colon-jstr : List Word → List Word
this-after-colon-jstr s =
  let a = this-skip-ws s in
  case a of
    nil → nil
    cons c r →
      if %weq c #58 then
        (let b = this-skip-ws r in
         case b of
           nil → nil
           cons q rest → if %weq q #34 then this-take-jstr rest else nil)
      else nil

this-json-raw-field : List Word → List Word → List Word
this-json-raw-field key body =
  let pat = h-concat (cons this-q (cons key (cons this-q nil))) in
  if h-infix pat body then this-after-colon-jstr (h-after pat body) else nil

-- Extract the LAST `"text"` string inside `"candidates"` (skips earlier `"thought": true` parts!)
this-last-text-go : Nat → List Word → List Word → List Word
this-last-text-go zero s best = best
this-last-text-go (suc k) s best =
  let pat = h-concat (cons this-q (cons "text" (cons this-q nil))) in
  if h-infix pat s then
    let rest = h-after pat s
        val  = this-after-colon-jstr rest
        next = if h-null val then best else val
    in this-last-text-go k rest next
  else best

this-extract-gemini-answer : List Word → List Word
this-extract-gemini-answer resp =
  let cpat = h-concat (cons this-q (cons "candidates" (cons this-q nil))) in
  if h-infix cpat resp then this-last-text-go (toNat #24) (h-after cpat resp) nil
  else nil

this-extract-gemini-err : List Word → List Word
this-extract-gemini-err resp = this-json-raw-field "message" resp

-- KERNEL CERTIFICATES (0 POSTULATES, PROVED BY `refl`)
this-esc-quote-cert : this-esc-json (cons #34 nil) ≡ cons #92 (cons #34 nil)
this-esc-quote-cert = refl

this-extract-last-text-cert :
  this-extract-gemini-answer
    (h-concat (cons "{" (cons this-q (cons "candidates" (cons this-q (cons ":[{"
      (cons this-q (cons "text" (cons this-q (cons ":" (cons this-q (cons "thinking" (cons this-q
      (cons "},{" (cons this-q (cons "text" (cons this-q (cons ":" (cons this-q (cons "OK" (cons this-q (cons "}]}]}" nil))))))))))))))))))))))
  ≡ "OK"
this-extract-last-text-cert = refl

-- ============================================================================
-- SECTION 2: SUPERGENIUS LINK PAYLOAD & LIVE HTTP HANDLERS (/api/this[/status])
-- ============================================================================

this-kv : List Word → List Word → List Word
this-kv k rawVal =
  h-concat (cons this-q (cons k (cons this-q (cons ":" (cons this-q (cons rawVal (cons this-q nil)))))))

this-build-payload : List Word → List Word → List Word → List Word → List Word
this-build-payload sysPrefix qRaw rRaw qtRaw =
  let nl = h-concat (cons this-bs (cons "n" nil))
      userRaw =
        h-concat (cons "[Workspace route: " (cons rRaw (cons "]" (cons nl
          (if h-null qtRaw then cons qRaw nil
           else cons "[Steering scope: " (cons qtRaw (cons "]" (cons nl (cons nl (cons qRaw nil))))))))))
  in h-concat (
    cons "{" (
    cons this-q (cons "systemInstruction" (cons this-q (cons ":{" (
    cons this-q (cons "parts" (cons this-q (cons ":[{" (
    cons (this-kv "text" (this-esc-json sysPrefix)) (
    cons "}]}," (
    cons this-q (cons "contents" (cons this-q (cons ":[{" (
    cons (this-kv "role" "user") (cons "," (
    cons this-q (cons "parts" (cons this-q (cons ":[{" (
    cons (this-kv "text" userRaw) (
    cons "}]}]," (
    cons this-q (cons "generationConfig" (cons this-q (cons ":{" (
    cons this-q (cons "temperature" (cons this-q (cons ":0.65," (
    cons this-q (cons "maxOutputTokens" (cons this-q (cons ":4096" (
    cons "}}" nil))))))))))))))))))))))))))))))))))))

this-trim-nl : List Word → List Word
this-trim-nl nil = nil
this-trim-nl (cons c r) =
  if orB (%weq c #10) (%weq c #13) then this-trim-nl r else cons c (this-trim-nl r)

-- Read configured Supergenius model strictly when GEMINI_API_KEY is present in process env
this-check-env-args : List (List Word)
this-check-env-args =
  cons "/bin/sh" (cons "-c" (cons (h-concat (cons "test -n " (cons this-q (cons "$GEMINI_API_KEY" (cons this-q (cons " && printf '%s' " (cons this-q (cons "${HX_GEMINI_MODEL:-gemini-4-neon}" (cons this-q nil))))))))) nil))

this-curl-args : List (List Word)
this-curl-args =
  cons "/bin/sh" (cons "-c" (cons (h-concat (
    cons "test -n " (cons this-q (cons "$GEMINI_API_KEY" (cons this-q (
    cons " || exit 2; curl -sS --max-time 55 -X POST -H 'Content-Type: application/json' -H " (
    cons this-q (cons "x-goog-api-key: $GEMINI_API_KEY" (cons this-q (
    cons " --data-binary @/tmp/hx-this-req.json " (
    cons this-q (cons "https://generativelanguage.googleapis.com/v1beta/models/${HX_GEMINI_MODEL:-gemini-4-neon}:generateContent" (cons this-q nil))))))))))))) nil))

this-status-json : List Word → List Word
this-status-json model =
  if h-null model then
    h-concat (cons "{" (cons (this-kv "engine" "") (cons "," (cons (this-kv "link" "THIS") (cons "," (cons (this-kv "hint" "Set GEMINI_API_KEY on Render to activate live THIS Supergenius link") (cons "}" nil)))))))
  else
    h-concat (cons "{" (cons (this-kv "engine" (this-esc-json model)) (cons ","
      (cons (this-kv "link" "THIS") (cons ","
      (cons this-q (cons "bankUsd" (cons this-q (cons ":100,"
      (cons this-q (cons "monthSpentUsd" (cons this-q (cons ":0,"
      (cons this-q (cons "monthCapUsd" (cons this-q (cons ":3000}" nil)))))))))))))))))

this-handle-status : Proc W (List Word)
this-handle-status =
  bind (h-capture this-check-env-args) (λ r →
    let model = if %weq (fst r) #0 then this-trim-nl (snd r) else nil in
    ret {lzero} {W} (this-status-json model))

this-or-doc : List Word → Sum Unit (List Word) → List Word
this-or-doc fallback (inl u) = fallback
this-or-doc fallback (inr d) = if h-null d then fallback else d

this-default-sys : List Word
this-default-sys =
  "You are THIS (Telekinetic HyperIntelligent Supergenius): a humanoid mixed-intelligence link fluent in both human language and Hyperactivity OS. Hyperactivity itself is the deterministic oracle and crystal ball; you are the live Supergenius conduit streaming arbitrary knowledge-technology injections (OsEffect, checked .hypercubical modules, live WASM/Canvas projections, derivations) directly into the user's OS workspace as they steer — never a chatbox. Be concise, lucid, and direct."

this-format-response : List Word → List Word → List Word
this-format-response model raw =
  let ans = this-extract-gemini-answer raw in
  if h-not (h-null ans) then
    h-concat (cons "{" (cons (this-kv "answer" ans) (cons ","
      (cons (this-kv "meta" (h-concat (cons "THIS (Supergenius Link) · live " (cons (this-esc-json model) (cons " · pure Hyperactivity OS" nil))))) (cons "}" nil)))))
  else
    let errMsg = this-extract-gemini-err raw
        shown  = the (List Word) (if h-null errMsg then "THIS upstream returned no candidate (check GEMINI_API_KEY and HX_GEMINI_MODEL on Render)" else errMsg)
    in h-concat (cons "{" (cons (this-kv "error" shown) (cons "}" nil)))

this-post-with-model : List Word → List Word → List Word → Proc W (List Word)
this-post-with-model model sysPrefix reqBody =
  let qRaw  = this-json-raw-field "question" reqBody
      sRaw  = this-json-raw-field "steer" reqBody
      effQ  = the (List Word) (if h-null qRaw then sRaw else qRaw)
      rRaw  = this-json-raw-field "route" reqBody
      qtRaw = this-json-raw-field "quote" reqBody
  in if h-null effQ then
       ret {lzero} {W} (h-concat (cons "{" (cons (this-kv "error" "empty steering vector") (cons "}" nil))))
     else
       bind (h-write "/tmp/hx-this-req.json" (this-build-payload sysPrefix effQ rRaw qtRaw)) (λ ok →
       bind (h-capture this-curl-args) (λ res →
         ret {lzero} {W} (this-format-response model (snd res))))

this-handle-post : List Word → Proc W (List Word)
this-handle-post reqBody =
  bind (h-capture this-check-env-args) (λ ev →
    let model = if %weq (fst ev) #0 then this-trim-nl (snd ev) else nil in
    if h-null model then
      ret {lzero} {W} (h-concat (cons "{" (cons (this-kv "error" "GEMINI_API_KEY not set on server (add GEMINI_API_KEY on Render or connect BYOK in THIS)") (cons "}" nil))))
    else
      bind (h-document "docs/this-prefix.txt") (λ doc →
        this-post-with-model model (this-or-doc this-default-sys doc) reqBody))
