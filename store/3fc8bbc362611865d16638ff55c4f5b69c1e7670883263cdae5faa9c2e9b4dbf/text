-- a zero sum of two nonnegatives: the positive parts sum to zero
zr-ps : (x y : ZrC) → zr-nn x ≡ true → zr-nn y ≡ true → zr-ad x y ≡ zrz → plus (fst (zr-val x)) (fst (zr-val y)) ≡ zero
zr-ps x y hx hy e = cl-tr Nat (plus (fst (zr-val x)) (fst (zr-val y))) (plus (plus (fst (zr-val x)) (fst (zr-val y))) zero) zero
  (λ i → plus-zero (plus (fst (zr-val x)) (fst (zr-val y))) (~ i))
  (cl-tr Nat (plus (plus (fst (zr-val x)) (fst (zr-val y))) zero) (plus (snd (zr-val x)) (snd (zr-val y))) zero (λ i → zr-sumz x y e (~ i))
    (λ i → plus (zr-nnv x hx i) (zr-nnv y hy i)))
