-- an exact chain: rv is reached from tv by exact values of the step at n, …, 1
echain : (Nat → ZQ → Nat → ZQ) → IE → Nat → ZQ → ZQ → Type
echain Et step n = case n return λ w → ZQ → ZQ → Type of
  zero → λ tv rv → le (suc zero) (snd rv) × qeq rv tv
  suc g → λ tv rv → (w : ZQ) × (isval (Et (suc g) tv) step w × rec g w rv)
