-- UNIVERSAL THEOREM 1 (`S + K < K * S` STRICT ECONOMIC HYPERFACTORIZATION GAIN, 0 POSTULATES):
-- For EVERY shared trunk cost `S = 3 + s` (`s : Nat`) and EVERY fiber count `K = 2 + k` (`k : Nat`),
-- `S + K + 1 <= K * S` (i.e. strict inequality `S + K < K * S`) holds universally!
ms-thm-hyperfactor-strict-gain :
  (s k : Nat) →
  let bigS = suc (suc (suc s))
      bigK = suc (suc k)
  in bn-le-nat (plus bigS (suc bigK)) (bn-mul-nat bigK bigS) ≡ true
ms-thm-hyperfactor-strict-gain s k =
  ms-le-add-l (suc (suc (suc s))) (suc (suc (suc k)))
    (bn-mul-nat (suc k) (suc (suc (suc s))))
    (ms-lem-hyper-tail s k)
