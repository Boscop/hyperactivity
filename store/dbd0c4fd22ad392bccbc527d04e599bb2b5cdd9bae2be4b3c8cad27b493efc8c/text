step-eq : {a b r : Bool} → isTrue a → isTrue b → isTrue r → isTrue (lex-step a b r)
step-eq ha hb hr =
  (case a return λ y → isTrue y → isTrue (lex-step y b r) of
     true → λ ha → (case b return λ z → isTrue z → isTrue (if z then r else true) of true → λ hb → hr; false → λ hb → Empty-rec hb) hb
     false → λ ha → Empty-rec ha) ha
