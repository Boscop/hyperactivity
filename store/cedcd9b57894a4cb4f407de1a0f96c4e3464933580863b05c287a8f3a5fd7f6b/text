zz-dec-enc : (p x : Word) → zz-dec p (zz-enc p x) ≡ x
zz-dec-enc p x =
  ifP {λ b → zz-dec p (if b then wadd (wmul (wsub p (%wsucc x)) #2) #1 else wadd (wmul (wsub x p) #2) #0) ≡ x} {wlt x p}
    (λ e →
       let q = wsub p (%wsucc x)
           d = wadd (wmul q #2) #1
           er : wrem d #2 ≡ #1
           er = wmod-unique q #1 #2 refl
           eq : wquot d #2 ≡ q
           eq = wdiv-unique q #1 #2 refl
           eb : weq (wrem d #2) #0 ≡ false
           eb = cm-congb (λ z → weq z #0) er
           ep : wadd x (%wsucc q) ≡ p
           ep = catw (symw (cm-wadd-suc-l x q)) (cm-wadd-sub-le p (%wsucc x) (cm-lt-suc-le x p e))
       in catw (cm-ifw (wadd p (wquot d #2)) (wsub p (%wsucc (wquot d #2))) eb)
            (catw (congw (λ z → wsub p (%wsucc z)) eq)
              (catw (congw (λ z → wsub z (%wsucc q)) (symw ep)) (cm-wsub-add-r (%wsucc q) x))))
    (λ e →
       let q = wsub x p
           d = wadd (wmul q #2) #0
           er : wrem d #2 ≡ #0
           er = wmod-unique q #0 #2 refl
           eq : wquot d #2 ≡ q
           eq = wdiv-unique q #0 #2 refl
           eb : weq (wrem d #2) #0 ≡ true
           eb = cm-congb (λ z → weq z #0) er
       in catw (cm-ifw (wadd p (wquot d #2)) (wsub p (%wsucc (wquot d #2))) eb)
            (catw (congw (λ z → wadd p z) eq) (cm-wadd-sub-le x p e)))
