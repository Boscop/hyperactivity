-- tr(M_e M_e′) on the branch through e′ (+ if sp) and e (+ if spp), with ds3, ds4 named
pair-branch-at : Nat → Nat → Bool → Bool → List Nat → List Triple → List Nat → List Nat → Term
pair-branch-at e e1 sp spp ds ts ds3 ds4 = pair-with ds ts ds3 ds4 (if spp then ds-plus e ds4 else ds-minus e ds4) (exp-init (exp-init (if spp then ds-plus e ds4 else ds-minus e ds4)))
  (pair-weight (exp-at e1 ds3) (exp-at e1 ds) (exp-at e (if spp then ds-plus e ds4 else ds-minus e ds4)) (exp-at e ds))
  (if sp then eplus-entry e1 ds else eminus-entry e1 ds)
  (if sp then scaled-entry ((exp-at e1 ds3 , suc (exp-at e1 ds3)) , (zero , suc zero)) (eminus-entry e1 ds3) else scaled-entry (sq-neg sq-one) (eplus-entry e1 ds3))
  (if spp then eplus-entry e ds4 else eminus-entry e ds4)
  (if spp then rplus-entry e (exp-init (exp-init (ds-plus e ds4))) else rminus-entry e (exp-init (exp-init (ds-minus e ds4))))
