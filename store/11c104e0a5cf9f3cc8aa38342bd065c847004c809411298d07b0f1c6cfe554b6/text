fs-f : (y c : Bool) → plus (bitn false) (times 2 (bitn (borrow3 false y c))) ≡ plus (bitn (bit-eq (bit-eq false y) c)) (plus (bitn y) (bitn c))
fs-f y c = case y return λ v → plus (bitn false) (times 2 (bitn (borrow3 false v c))) ≡ plus (bitn (bit-eq (bit-eq false v) c)) (plus (bitn v) (bitn c)) of
  true → fs-ft c
  false → fs-ff c
