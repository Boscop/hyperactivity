nk-ebound-up : (n1 n2 : NkW) (e : NkEnv) → (nk-wire-le n1 n2 ≡ true) → (nk-ebound e n1 ≡ true) → nk-ebound e n2 ≡ true
nk-ebound-up n1 n2 nke-nil p h = refl
nk-ebound-up n1 n2 (nke-cons w r) p h =
  nk-and-intro (nk-wire-lt w n2) (nk-ebound r n2)
    (nk-wire-lt-wle-trans w n1 n2 (nk-and-l (nk-wire-lt w n1) (nk-ebound r n1) h) p)
    (nk-ebound-up n1 n2 r p (nk-and-r (nk-wire-lt w n1) (nk-ebound r n1) h))
