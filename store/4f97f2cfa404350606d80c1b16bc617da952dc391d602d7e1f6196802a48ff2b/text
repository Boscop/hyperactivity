-- the state: memory; per address the id of the write last flushed to it; per thread its buffer,
-- newest first, each entry the cell writes of one store (they reach memory together); the
-- next event id; the trace, latest first
data TsoSt = tso-st (mem : Memory) (last : Word → Word) (buf : Word → List (List TsoB)) (next : Word) (log : List TsoL)
