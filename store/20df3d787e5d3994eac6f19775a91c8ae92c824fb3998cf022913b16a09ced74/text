-- a body built in an environment, its result to arrive on out
k-build : KTm → KEnv → Word → KOut → KOut
k-build (k-var i) e out (k-out fx n) = k-out (k-pick e i out fx) n
k-build (k-num m) e out (k-out fx n) = k-out (fx-val out (kv-num m) (k-era-env e fx)) n
k-build (k-lam b) e out (k-out fx n) = k-out (fx-val out (kv-lam b e) fx) n
k-build (k-inc a) e out (k-out fx n) = k-build a e n (k-out (fx-op n (ko-inc out) fx) (%wsucc n))
k-build (k-app f a) e out o =
  let s = k-split e o
      n = k-n (k-so s)
  in k-build f (k-sa s) n (k-build a (k-sb s) (%wsucc n) (k-out (fx-op n (ko-app (%wsucc n) out) (k-fx (k-so s))) (%wadd n #2)))
