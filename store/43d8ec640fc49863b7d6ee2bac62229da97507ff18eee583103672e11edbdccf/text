-- the verdict on a file, kept in the store (verdicts/<file>: the stamp of the latest change under
-- the repository when it was given, whether the machine read to the end, the names that failed), so
-- a file nothing has changed since is not given to the machine again
hy-verdict-run : List Word → List Word → List Word → Word → Proc W (Bool × List (List Word))
hy-verdict-run st m root stamp = bind (h-capture (cons m (cons "--read" (cons root nil)))) (λ r →
  bind (h-mkdir (list-append st "/verdicts")) (λ u →
  bind (h-write (list-append st (list-append "/verdicts/" (h-hex root))) (h-concat (list-map h-line (cons (h-decimal stamp) (cons (if hy-complete (h-lines (snd r)) then "1" else "0") (hy-fails (h-lines (snd r)))))))) (λ b →
  ret (hy-complete (h-lines (snd r)) , hy-fails (h-lines (snd r))))))
