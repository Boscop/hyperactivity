-- k + (c + (y + 2Y)) + 2c' = (y + c) + (k + (2Y + 2c'))
sub-lhs-alg : (k c y Y c2 : Nat) → plus (plus k (plus c (plus y (times 2 Y)))) (times 2 c2) ≡ plus (plus y c) (plus k (plus (times 2 Y) (times 2 c2)))
sub-lhs-alg k c y Y c2 =
  transN (congN (λ z → plus z (times 2 c2))
           (transN (plus-comm-mid k c (plus y (times 2 Y)))
           (transN (congN (plus c) (plus-comm-mid k y (times 2 Y)))
           (transN (symN (plus-assoc c y (plus k (times 2 Y))))
           (congN (λ z → plus z (plus k (times 2 Y))) (plus-comm c y))))))
  (transN (plus-assoc (plus y c) (plus k (times 2 Y)) (times 2 c2))
  (congN (plus (plus y c)) (plus-assoc k (times 2 Y) (times 2 c2))))
