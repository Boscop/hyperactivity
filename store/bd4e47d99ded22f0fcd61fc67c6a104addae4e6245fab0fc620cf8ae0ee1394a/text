diag-nondim : (sk : Lst Entry) (j : Word) (X : Type 1) (c : Cube (suc (dims sk)) X) → isdim sk j ≡ false →
  PathP (λ i → Cube (dims sk) X) (diag-sk sk j X c) (cube-map (dims sk) (Line X) X (face0-l X) c)
diag-nondim lnil j X c hp = λ i → face0-l X c
diag-nondim (lcons (e-ty s) sk) j X c hp =
  bool-elim1 (λ b → (if b then false else isdim sk (%wsub j #1)) ≡ false → PathP (λ i → (Cube (dims sk) X)) (if b then (cube-map (dims sk) (Line X) X (face0-l X) c) else (diag-sk sk (%wsub j #1) X c)) (cube-map (dims sk) (Line X) X (face0-l X) c)) (λ hq i → (cube-map (dims sk) (Line X) X (face0-l X) c)) (λ hq → diag-nondim sk (%wsub j #1) X c hq) (weq j #0) hp
diag-nondim (lcons e-dim sk) j X c hp =
  bool-elim1 (λ b → (if b then true else isdim sk (%wsub j #1)) ≡ false → PathP (λ i → (Cube (suc (dims sk)) X)) (if b then (cube-map (dims sk) (Line (Line X)) (Line X) (diag-l X) c) else (diag-sk sk (%wsub j #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c))) (cube-map (dims sk) (Line (Line X)) (Line X) (line-map (Line X) X (face0-l X)) c)) (λ hq → Empty-rec {lsuc lzero} (tf-empty hq))
    (λ hq → (pcat (Cube (suc (dims sk)) X) (diag-sk sk (%wsub j #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)) (cube-map (dims sk) (Line (Line X)) (Line X) (face0-l (Line X)) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)) (cube-map (dims sk) (Line (Line X)) (Line X) (line-map (Line X) X (face0-l X)) c) (diag-nondim sk (%wsub j #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c) hq) (cube-comp (dims sk) (Line (Line X)) (Line (Line X)) (Line X) (face0-l (Line X)) (exch-l X) c)))
    (weq j #0) hp
