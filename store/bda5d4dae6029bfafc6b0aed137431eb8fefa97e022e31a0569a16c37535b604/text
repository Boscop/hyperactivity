-- dimension at most n: every family of more than n vectors has a dependence with a nonzero coefficient
sy-Dim : (A V : Type) → (z : A) → (vz : V) → (va : V → V → V) → (vs : A → V → V) → (isz : A → Bool) → Nat → Type
sy-Dim A V z vz va vs isz n = (dc : List V → List A) × (((ws : List V) → le (suc n) (sy-len V ws) → sy-comb A V vz va vs z (dc ws) ws ≡ vz) × ((ws : List V) → le (suc n) (sy-len V ws) → sy-nzc A V z isz (dc ws) ws ≡ true))
