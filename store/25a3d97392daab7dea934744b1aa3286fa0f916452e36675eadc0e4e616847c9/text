-- and the order of that bond: the carbonyl oxygen double, everything else single, the root none
il-ord : Ile → Bond
il-ord x = case x of
  il-c1 → bond-none
  il-o1 → bond-double
  il-o2 → bond-single
  il-ho → bond-single
  il-ca → bond-single
  il-ha → bond-single
  il-n → bond-single
  il-hn1 → bond-single
  il-hn2 → bond-single
  il-cb → bond-single
  il-hb → bond-single
  il-cg1 → bond-single
  il-g11 → bond-single
  il-g12 → bond-single
  il-cd1 → bond-single
  il-d11 → bond-single
  il-d12 → bond-single
  il-d13 → bond-single
  il-cg2 → bond-single
  il-g21 → bond-single
  il-g22 → bond-single
  il-g23 → bond-single
