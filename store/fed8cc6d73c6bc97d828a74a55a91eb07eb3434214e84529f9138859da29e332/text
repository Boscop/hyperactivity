max-cmp-tree : List Word → List Word → List Word → List Word
max-cmp-tree pfx pa pb =
  sv-concat
    (cons (max-cmp-init  (toNat #128) pfx pa pb #0)
    (cons (max-cmp-stage (toNat #64)  pfx #1 #0)
    (cons (max-cmp-stage (toNat #32)  pfx #2 #0)
    (cons (max-cmp-stage (toNat #16)  pfx #3 #0)
    (cons (max-cmp-stage (toNat #8)   pfx #4 #0)
    (cons (max-cmp-stage (toNat #4)   pfx #5 #0)
    (cons (max-cmp-stage (toNat #2)   pfx #6 #0)
    (cons (max-cmp-stage (toNat #1)   pfx #7 #0)
    (cons (epfl-or2-blif (max-gname pfx #7 #0) (max-pname pfx #7 #0) (list-append pfx "_ge")) nil)))))))))
