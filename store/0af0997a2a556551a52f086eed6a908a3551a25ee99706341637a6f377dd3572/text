-- x < y and y ≤ z implies x < z
cm-lt-le-step : (x : Word) → ((y z : Word) → ltw x y ≡ true → ltw z y ≡ false → ltw x z ≡ true) →
                (y z : Word) → ltw (%wsucc x) y ≡ true → ltw z y ≡ false → ltw (%wsucc x) z ≡ true
cm-lt-le-step x ih y =
  %welimP (λ v → (z : Word) → ltw (%wsucc x) v ≡ true → ltw z v ≡ false → ltw (%wsucc x) z ≡ true) y
    (λ z h1 h2 → cm-ft-absurd h1)
    (λ y1 gy z →
       %welimP (λ v → ltw (%wsucc x) (%wsucc y1) ≡ true → ltw v (%wsucc y1) ≡ false → ltw (%wsucc x) v ≡ true) z
         (λ h1 h2 → cm-tf-absurd h2)
         (λ z1 gz h1 h2 → ih y1 z1 h1 h2))
