-- the contact map of a walk: bits for (0,3), (0,5), (1,4), (2,5)
sl-code : List (Nat × Nat) → Nat
sl-code ps = plus (plus (sl-b (sl-adj (sl-nth ps 0) (sl-nth ps 3)) 1) (sl-b (sl-adj (sl-nth ps 0) (sl-nth ps 5)) 2)) (plus (sl-b (sl-adj (sl-nth ps 1) (sl-nth ps 4)) 4) (sl-b (sl-adj (sl-nth ps 2) (sl-nth ps 5)) 8))
