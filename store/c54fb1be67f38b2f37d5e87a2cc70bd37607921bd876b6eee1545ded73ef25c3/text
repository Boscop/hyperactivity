sm-xor-last : (u v : Expr) → (B : List Byte) → (a : Nat) → (S : List Byte) → (x : Byte) →
  sm-run B (sm-size (Xor u v)) (a , S , x , sm-running)
  ≡ (suc (plus (list-length (sm-code v)) (plus (list-length (sm-code u)) a)) , cons (xorB 8 (denote u x) (denote v x)) S , x , sm-running) →
  sm-run B (sm-size (Xor u v)) (a , S , x , sm-running)
  ≡ (plus (list-length (sm-code (Xor u v))) a , cons (denote (Xor u v) x) S , x , sm-running)
sm-xor-last u v B a S x h = sm-trans
  (sm-run B (sm-size (Xor u v)) (a , S , x , sm-running))
  (suc (plus (list-length (sm-code v)) (plus (list-length (sm-code u)) a)) , cons (xorB 8 (denote u x) (denote v x)) S , x , sm-running)
  (plus (list-length (sm-code (Xor u v))) a , cons (denote (Xor u v) x) S , x , sm-running)
  h
  (λ i → (sym (transN (congN (λ n → plus n a) (sm-len-xor u v)) (sm-pos-xor (list-length (sm-code u)) (list-length (sm-code v)) a)) i
          , cons (xorB 8 (denote u x) (denote v x)) S , x , sm-running))
