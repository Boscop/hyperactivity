hm-thm-dist2-sym : (x1 y1 z1 x2 y2 z2 : Nat) →
  hm-dist2-3d x1 y1 z1 x2 y2 z2 ≡ hm-dist2-3d x2 y2 z2 x1 y1 z1
hm-thm-dist2-sym x1 y1 z1 x2 y2 z2 =
  λ i → hm-add (hm-sq (hm-absdiff-sym x1 x2 i))
               (hm-add (hm-sq (hm-absdiff-sym y1 y2 i))
                       (hm-sq (hm-absdiff-sym z1 z2 i)))
