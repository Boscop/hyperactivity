-- a search with no path searches where the call is made; a relative path is under it
l-grep-in-repo : List Word → Bool
l-grep-in-repo call = orB (h-null (l-field "path" call)) (orB (h-not (h-prefix "/" (l-field "path" call))) (orB (h-infix "hyperactivity" (l-field "path" call)) (l-home-in-path (l-field "path" call))))
