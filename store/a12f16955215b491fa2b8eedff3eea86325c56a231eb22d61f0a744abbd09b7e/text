-- a written gesture: kept when its kind is one of the four and it says something; the reader is sent back to the focus
hi-write : List Word → List Word → List Word → Proc W (List Word)
hi-write st m q = if orB (h-not (h-has (s-param "kind" q) hi-kinds)) (h-null (h-trim (s-param "text" q))) then ret {lzero} {W} (hi-see (hi-href (hi-reader q) (hi-focus q)))
  else bind (hi-record st m (hi-reader q) (hi-focus q) (s-param "kind" q) (s-param "text" q)) (λ r → ret {lzero} {W} (hi-see (hi-href (hi-reader q) (hi-focus q))))
