-- (part of language-support)
two_byte_opcode_modr_m_p : (proc_mode' : proc_mode) → (mandatory_prefix : Bits #8) → (opcode : Bits #8) → Bool
two_byte_opcode_modr_m_p proc_mode' mandatory_prefix opcode =
  let t'1 : Bool
      t'1 =
        if (in_64bit_mode proc_mode') then
          (n64_bit_mode_two_byte_opcode_modr_m_p mandatory_prefix opcode)
        else
          (n32_bit_mode_two_byte_opcode_modr_m_p mandatory_prefix opcode)
  in t'1
