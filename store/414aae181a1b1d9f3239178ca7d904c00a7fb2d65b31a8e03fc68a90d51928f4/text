hs-fmt-net : Nat → Word → Word → List Word
hs-fmt-net zero _ _ = nil
hs-fmt-net (suc k) nw prog =
  let g = %wand prog #63
      i = %wshr g #3
      j = %wand g #7
  in list-append " w" (list-append (ce-dec nw) (list-append "=NAND(w" (list-append (ce-dec i) (list-append ",w" (list-append (ce-dec j) (list-append ")" (hs-fmt-net k (%wsucc nw) (%wshr prog #6))))))))
