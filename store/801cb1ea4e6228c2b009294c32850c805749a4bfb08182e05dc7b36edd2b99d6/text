push-fst-d : (n : Nat) (X : Type 1) (Y F : X → Type 1) (c : Cube n X) (d : DCube n X Y c) (e : DCube n X F c) →
  PathP (λ i → DCube n X F (dmap-fst n X Y c d i)) (dcube-push n X X Y F F (λ x y → x) (λ x y z → z) c d e) e
push-fst-d zero X Y F c d e = λ i → e
push-fst-d (suc n) X Y F c d e = push-fst-d n (Line X) (LineO X Y) (LineO X F) c d e
