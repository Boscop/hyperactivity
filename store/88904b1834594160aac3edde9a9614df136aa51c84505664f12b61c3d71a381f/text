ce-full-of : Code → List Word
ce-full-of (cglob g) =
  (case unfold g return (λ _ → List Word) of
     none → "/* no code */"
     some c → ce2-prog g (x-erase g (x-forms-all (snd (program-of-at unfold g (fst (specialize (opt-or (def-type-code g) cword) sched-default lnil c)) #256)))))
ce-full-of c = "/* not a definition */"
