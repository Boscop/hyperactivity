-- ---------------------------------------------------------------- 2. Framing-effect invariance
-- De Martino et al. (2006, 2008); docs/exposition-language-inhibition.cub §II:
-- A decision input is (frame , content) : Bool × C, where `frame` is gain/loss presentation.
FramingInvariant : {C Choice : Type} → ((Bool × C) → Choice) → Type
FramingInvariant {C} eval = (c : C) → eval (true , c) ≡ eval (false , c)
