mlt : Mono → Mono → Bool
mlt a b =
  case a return (λ w → Mono → Bool) of
    mone → λ b → (case b return (λ w → Bool) of mone → false; mvar v2 r2 → true)
    mvar v r → λ b →
      (case b return (λ w → Bool) of
         mone → false
         mvar v2 r2 → (case %wlt v v2 return (λ w → Bool) of true → true; false → (case weq v v2 return (λ w → Bool) of true → rec r r2; false → false)))
  b
