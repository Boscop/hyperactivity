-- Signed multiply-shift (a * b) >> 16 in 64-bit intermediate, wrapped to 32-bit signed
s32-mul16 : Word → Word → Word
s32-mul16 a b =
  let ua = w32 a
      ub = w32 b
      na = %wlt #2147483647 ua
      nb = %wlt #2147483647 ub
      ma = if na then s32-neg ua else ua
      mb = if nb then s32-neg ub else ub
      pr = %wshr (%wmul ma mb) #16
      neg = if na then not nb else nb
  in if neg then s32-neg pr else w32 pr
