-- coefficient lists: Lst of (variable , coefficient), sorted by variable, coefficients nonzero
coef-add cs ds =
  case cs of
    lnil → ds
    lcons p cr →
      (case ds of
         lnil → cs
         lcons q dr →
           if %wlt (fst p) (fst q) then lcons p (coef-add cr ds)
           else if %wlt (fst q) (fst p) then lcons q (coef-add cs dr)
           else lcons (fst p , %wadd (snd p) (snd q)) (coef-add cr dr))
