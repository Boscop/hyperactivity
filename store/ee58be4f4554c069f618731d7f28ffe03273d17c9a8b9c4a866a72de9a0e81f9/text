-- a plan reads the memory at that one wire only: two memories that agree there give the same plan
nk-plan-at : (s : NkSlot) (u n : Word) (a c : NkSlots) → (nk-get a (nk-rw s u) ≡ nk-get c (nk-rw s u)) → nk-plan s u n a ≡ nk-plan s u n c
nk-plan-at (nks-pair o v) u n a c h = nk-plan-pair-at (nk-reads o) v o u n a c h
nk-plan-at nks-none u n a c h = refl
nk-plan-at (nks-val v) u n a c h = refl
nk-plan-at (nks-op o) u n a c h = refl
