stree-rearr : (a b c d : Nat) → plus (plus (plus a b) c) d ≡ plus (plus c a) (plus d b)
stree-rearr a b c d = transN (plus-assoc (plus a b) c d) (transN (plus-assoc a b (plus c d))
  (transN (congN (plus a) (plus-comm-mid b c d)) (transN (plus-comm-mid a c (plus b d))
  (transN (sym (plus-assoc c a (plus b d))) (congN (plus (plus c a)) (plus-comm b d))))))
