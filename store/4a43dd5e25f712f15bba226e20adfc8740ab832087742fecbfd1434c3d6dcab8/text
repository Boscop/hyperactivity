nk-plan-by-wf : (held : NkHeld) (o : NkOp) (v : NkVal) (u n : NkW) (sl : NkSlots) →
  nk-and (nk-wire-le n (nk-n (nk-plan-by held o v u n sl)))
         (nk-step-fx-wf u (nk-op-ins o v) (nk-op-outs o) n (nk-n (nk-plan-by held o v u n sl)) (nk-fx (nk-plan-by held o v u n sl))) ≡ true
nk-plan-by-wf (nkh-wire w) o v u n sl = nk-plan-read-wf (nk-get sl w) o u n (nk-op-ins o v) (nk-op-outs o)
nk-plan-by-wf nkh-none o v u n sl =
  let hr = nk-rule-wf o v n
      mr = nk-n (nk-rule o v n)
  in nk-and-intro (nk-wire-le n mr) (nk-and (nk-weq u u) (nk-fx-wf (nk-op-ins o v) (nk-op-outs o) n mr (nk-fx (nk-rule o v n))))
       (nk-out-ok-le (nk-op-ins o v) (nk-op-outs o) n n (nk-rule o v n) hr)
       (nk-and-intro (nk-weq u u) (nk-fx-wf (nk-op-ins o v) (nk-op-outs o) n mr (nk-fx (nk-rule o v n)))
         (nk-weq-refl u)
         (nk-out-ok-fx (nk-op-ins o v) (nk-op-outs o) n n (nk-rule o v n) hr))
