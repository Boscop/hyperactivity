-- j respects the form's first-argument laws
bw-ja : (A : Type) → (z : A) → (ad : A → A → A) → ((x : A) → ad x z ≡ x) → (m : Nat) → (f : sy-vn A (suc m) → sy-vn A (suc m) → A) → ((p q x : sy-vn A (suc m)) → f (sy-va A ad (suc m) p q) x ≡ ad (f p x) (f q x)) →
  (p q : sy-vn A m) → (y : sy-vn A (suc m)) → f (bw-j A z m (sy-va A ad m p q)) y ≡ ad (f (bw-j A z m p) y) (f (bw-j A z m q) y)
bw-ja A z ad a0r m f fa p q y = cl-tr A (f (bw-j A z m (sy-va A ad m p q)) y) (f (sy-va A ad (suc m) (bw-j A z m p) (bw-j A z m q)) y) (ad (f (bw-j A z m p) y) (f (bw-j A z m q) y))
  (λ i → f (bw-pr A m (a0r z (~ i)) (sy-va A ad m p q)) y) (fa (bw-j A z m p) (bw-j A z m q) y)
