cm-ltw-le-chain : (a b c : Word) → ltw b a ≡ false → ltw c b ≡ false → ltw c a ≡ false
cm-ltw-le-chain a =
  %welimP (λ v → (b c : Word) → ltw b v ≡ false → ltw c b ≡ false → ltw c v ≡ false) a
    (λ b c h1 h2 → %welimP (λ v → ltw v #0 ≡ false) c (λ i → false) (λ n h i → false))
    (λ a1 ih → cm-le-trans-step a1 ih)
