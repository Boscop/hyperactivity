int-to-f32 : Bool → IW → SV → MRes Float32
int-to-f32 sg w v = case w of
  iw128 → mr-map (λ a → f32-of-bits (fp-pack ff32 (m-and sg (dq-isneg a)) (dq-mag sg a) uq0)) (sv-as-w v)
  iw64 → mr-map (λ x → f32-of-bits (fp-pack ff32 (m-and sg (uq-isneg x))
                                      (case m-and sg (uq-isneg x) of
                                         true → (uq-neg x , uq0)
                                         false → (x , uq0)) uq0)) (sv-as-i v)
  _ → mr-map f64-narrow (int-to-f64 sg w v)
