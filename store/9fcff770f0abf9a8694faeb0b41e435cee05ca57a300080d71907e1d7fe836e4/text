-- a closure cell: the arguments pushed, a cell of 3 + n words, [offset][arity][n], the arguments
x-clo : Enc → Tbl → XEnv → Word → Word → Word → Lst Code → Lst Word
x-clo ce tbl env d g a args =
  let n = l-count args
  in xcat6 (x-push-all ce env d args) i-mov-rax-r15 (i-add-r15 (xmul8 (%wadd n #3))) (l-app i-cmp-r15-r12 i-over-if-above)
           (xcat3 (i-st-rax-imm (x-tbl tbl g)) (i-st-rax-d-imm #8 a) (i-st-rax-d-imm #16 n)) (x-pop-at n)
