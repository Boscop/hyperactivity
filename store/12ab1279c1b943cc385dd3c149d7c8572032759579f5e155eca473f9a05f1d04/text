gir-q : List Word
gir-q = cons #34 nil

gir-esc-n : List Word
gir-esc-n = cons #92 (cons #110 nil)

gir-esc-q : List Word
gir-esc-q = cons #92 (cons #34 nil)

gir-qq : List Word → List Word
gir-qq s = list-append gir-q (list-append s gir-q)

gir-s3 : List Word → List Word → List Word → List Word
gir-s3 a b c = list-append a (list-append b c)

gir-s5 : List Word → List Word → List Word → List Word → List Word → List Word
gir-s5 a b c d e = list-append a (list-append b (list-append c (list-append d e)))

-- Emits: <pre>"<body_fmt>\n"<suf>
gir-cstmt : List Word → List Word → List Word → List Word
gir-cstmt pre fmt suf =
  list-append pre (list-append gir-q (list-append fmt (list-append gir-esc-n (list-append gir-q suf))))

-- Escaped C-string JSON field builders: \"k\":v and \"k\":\"v\"
gir-jf : List Word → List Word → List Word
gir-jf k v = list-append gir-esc-q (list-append k (list-append gir-esc-q (list-append ":" v)))

gir-jfs : List Word → List Word → List Word
gir-jfs k v = gir-jf k (list-append gir-esc-q (list-append v gir-esc-q))

gir-jjoin : List (List Word) → List Word
gir-jjoin nil = nil
gir-jjoin (cons x nil) = x
gir-jjoin (cons x (cons y r)) = list-append x (list-append "," (gir-jjoin (cons y r)))

gir-jobj : List (List Word) → List Word
gir-jobj fs = list-append "{" (list-append (gir-jjoin fs) "}")

gir-qjoin : List (List Word) → List Word
gir-qjoin nil = nil
gir-qjoin (cons x nil) = gir-qq x
gir-qjoin (cons x (cons y r)) = list-append (gir-qq x) (list-append "," (gir-qjoin (cons y r)))

gir-lines : List (List Word) → List Word → List Word
gir-lines nil tl = tl
gir-lines (cons s ss) tl = list-append s (cons #10 (gir-lines ss tl))

gir-l4 : List Word → List Word → List Word → List Word → List (List Word)
gir-l4 a b c d = cons a (cons b (cons c (cons d nil)))

gir-l6 : List Word → List Word → List Word → List Word → List Word → List Word → List (List Word)
gir-l6 a b c d e f = cons a (cons b (cons c (cons d (cons e (cons f nil)))))

gir-l8 : List Word → List Word → List Word → List Word → List Word → List Word → List Word → List Word → List (List Word)
gir-l8 a b c d e f g h = cons a (cons b (cons c (cons d (cons e (cons f (cons g (cons h nil)))))))

