nk-rho-trim-step-below : (used : Bool) (rho : NkW → NkEv) (o2 : NkOut) (x : NkW) →
  (nk-wire-lt x (nk-n o2) ≡ true) → nk-rho-trim-step used rho o2 x ≡ rho x
nk-rho-trim-step-below true rho o2 x lt = refl
nk-rho-trim-step-below false rho o2 x lt =
  nk-rho-set-other rho (nk-n o2) x (nkev (hd-num #0) nkev-nil) (nk-wgt-neq x (nk-n o2) lt)
