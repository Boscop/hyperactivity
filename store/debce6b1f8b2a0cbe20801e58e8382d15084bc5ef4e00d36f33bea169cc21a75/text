cs-sim-shr-at : (lt : Bool) (hp : CsHeap) (a b : Word) → (%wlt b #64 ≡ lt) →
  cs-res-rel (cmv-word (if lt then %wshr a b else #0))
    (if lt then cs-prim-res hp (cs-c11-shr64 a b) else cso-ok hp (csv-word #0)) ≡ true
cs-sim-shr-at true hp a b hlt =
  cong (λ z → cs-res-rel (cmv-word (%wshr a b)) (cs-prim-res hp (if z then csp-ok (%wshr a b) else csp-ub))) hlt
  ∙ cs-weq-self (%wshr a b)
cs-sim-shr-at false hp a b hlt = refl
