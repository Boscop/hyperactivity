-- in any carrier with a neutral element on both sides and the interchange (p + q) + (r + s) = (p + r) + (q + s):
-- x + (h + c) = (h + x) + c, and (p + r) + s = p + (r + s)
sy-mid : (X : Type) → (e : X) → (op : X → X → X) → ((x : X) → op e x ≡ x) → ((x : X) → op x e ≡ x) → ((p q r s : X) → op (op p q) (op r s) ≡ op (op p r) (op q s)) →
  (x h c : X) → op x (op h c) ≡ op (op h x) c
sy-mid X e op l0 r0 sw x h c = cl-tr X (op x (op h c)) (op (op h x) (op e c)) (op (op h x) c)
  (sy-tr5 X (op x (op h c)) (op (op e x) (op h c)) (op (op e h) (op x c)) (op h (op x c)) (op (op h e) (op x c)) (op (op h x) (op e c))
    (λ i → op (l0 x (~ i)) (op h c)) (sw e x h c) (λ i → op (l0 h i) (op x c)) (λ i → op (r0 h (~ i)) (op x c)) (sw h e x c))
  (λ i → op (op h x) (l0 c i))
