pl-t-rows : BQ → BQ → BQ → BQ → List (List BQ) → List (List BQ) → List (List (BQ × (BQ × BQ))) → List (List BQ)
pl-t-rows sm pr l p hs ss ws = case hs of
  nil → nil
  cons h hr → (case ss of
    nil → nil
    cons s sr → (case ws of
      nil → nil
      cons w wr → cons (pl-t-row sm pr l p h s w) (pl-t-rows sm pr l p hr sr wr)))
