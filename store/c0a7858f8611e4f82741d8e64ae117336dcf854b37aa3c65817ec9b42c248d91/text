    (cons (ev-op #81)                   -- preBal; stack: [preBal, minProfit, postBal]
    (cons (ev-op #1)                    -- reqBal = preBal + minProfit; stack: [reqBal, postBal]
    (cons (ev-op #129)                  -- DUP2 -> [postBal, reqBal, postBal]
    (cons (ev-op #16)                   -- LT(postBal, reqBal) -> 1 if postBal < reqBal!
    (cons (ev-jmpi #99)                 -- ATOMIC REVERT IF UNPROFITABLE!
