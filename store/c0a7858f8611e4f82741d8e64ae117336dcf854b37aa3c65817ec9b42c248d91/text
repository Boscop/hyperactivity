    (cons (ev-push (cons #160 nil))
    (cons (ev-op #81)                   -- [preBal, postBal]
    (cons (ev-op #144)                  -- SWAP1 -> [postBal, preBal]
    (cons (ev-op #3)                    -- SUB -> [postBal - preBal]
    (cons (ev-push (cons #36 nil))
    (cons (ev-op #53)                   -- [repayToken, netProfit]
    (cons (ev-op #144) nil)))))))))))))))))) -- SWAP1 -> [netProfit, repayToken]
