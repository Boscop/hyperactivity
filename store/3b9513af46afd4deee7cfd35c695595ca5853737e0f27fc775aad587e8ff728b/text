rans-rate-upper-gen :
  (q r f C d M : Nat) → M ≡ plus f d →
  let s  = plus (times q f) r
      s' = plus (plus (times q M) C) r
  in leB (times f s') (plus (times M s) (times f C)) ≡ true
rans-rate-upper-gen q r f C d M hM =
  let s  = plus (times q f) r
      s' = plus (plus (times q M) C) r
      h0 : leB (times f s') (plus (times f s') (times r d)) ≡ true
      h0 = opt-le-add-r (times f s') (times r d)
  in transport {lzero} (λ i → leB (times f s') (rans-rate-id-gen q r f C d M hM i) ≡ true) h0
