bn-polymod-step : Word → Word → Word
bn-polymod-step chk v =
  let top = %wshr chk #25
      c0  = %wxor (%wshl (%wand chk #33554431) #5) (%wand v #31)
      g0  = %wmul (%wand top #1) #996825010
      g1  = %wmul (%wand (%wshr top #1) #1) #642813549
      g2  = %wmul (%wand (%wshr top #2) #1) #513874426
      g3  = %wmul (%wand (%wshr top #3) #1) #1027748829
      g4  = %wmul (%wand (%wshr top #4) #1) #705979059
  in %wxor c0 (%wxor g0 (%wxor g1 (%wxor g2 (%wxor g3 g4))))
