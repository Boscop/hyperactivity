-- one pass over a normal form: every side of a system restricted to its face, then, inside out,
-- every transport and composition whose head is known, and every Glue type, element and way back
-- whose face is known, taken a step
nk-kan : NkTm → NkTm
nk-kan (nk-lam b) = nk-lam (nk-kan b)
nk-kan (nk-con c as) = nk-kan-con c (nk-kan (nk-kan-pre c as))
nk-kan (nk-op h p as) = nk-kan-node h (nk-kan p) (nk-kan as)
nk-kan (nk-match h p cs) = nk-match h (nk-kan p) (nk-kan cs)
nk-kan (nk-cons t r) = nk-cons (nk-kan t) (nk-kan r)
nk-kan t = t
