-- the least-energy assignment among ns obeying Gauss's law, with its energy, against the best so far
bground-pick : List SQ → List BRad → List SQ × List BRad → List SQ × List BRad
bground-pick n e best = if labels-none (fst best) then (n , e) else (if bform-leb (snd best) e then best else (n , e))
