-- ============================================================================
-- 4. Quantum Tetrahedron Closure: Gram-Matrix Identity & Volume Triple Reduction
-- ============================================================================
-- For four 3-vectors J1, J2, J3, J4 ∈ R^3 (12 variables: 0..2 = J1, 3..5 = J2, 6..8 = J3, 9..11 = J4):
--   ‖J1 + J2 + J3 + J4‖² = Σ_a ‖J_a‖² + 2 Σ_{a<b} J_a · J_b.
-- On the SU(2) Gauss-invariant subspace Σ J_a = 0, the sum of all 6 dihedral dot products
-- is locked to -½ Σ ‖J_a‖².
lqg-dot3 : (A : Type) → (A → A → A) → (A → A → A) → (Nat → A) → Nat → Nat → A
lqg-dot3 A ad mu g a b =
  ad (ad (mu (g a) (g b)) (mu (g (suc a)) (g (suc b))))
     (mu (g (suc (suc a))) (g (suc (suc b))))
