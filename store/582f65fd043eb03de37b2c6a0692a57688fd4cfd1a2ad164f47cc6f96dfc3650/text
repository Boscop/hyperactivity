-- the r < 8 bytes past the last whole word (the string has at least 4 bytes): their 4-byte words
-- at n - r and n - 4 (overlapping is harmless: the contents agree)
q-bytes-tail v n r acc =
  if %weq r #0 then acc
  else q-st32 v n (%wsub n #4) (if %wlt r #5 then acc else q-st32 v n (%wsub n r) acc)
