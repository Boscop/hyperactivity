env-w : (Γ Δ : CCtx) (σ : Sub Δ Γ) → CompEnv Γ Δ σ → (Δ' : CCtx) (w : World Δ' Δ) → CompEnv Γ Δ' (sub-wcomp Δ' Δ Γ w σ)
env-w Γ Δ σ e Δ' w =
  (canonCM-r (fst Δ') (fst Δ) (fst Γ) (fst w) (fst (snd w)) (fst σ) (fst e) ,
   λ v → jc-tr j-tm (var-shape (fst Γ) v) Δ' (wact Δ' Δ w (TV (var-shape (fst Γ) v)) (subM Δ Γ (TV (var-shape (fst Γ) v)) σ (varCube Γ v)))
           (subM Δ' Γ (TV (var-shape (fst Γ) v)) (sub-wcomp Δ' Δ Γ w σ) (varCube Γ v))
           (psym (Mean Δ' (TV (var-shape (fst Γ) v))) (subM Δ' Γ (TV (var-shape (fst Γ) v)) (sub-wcomp Δ' Δ Γ w σ) (varCube Γ v))
              (wact Δ' Δ w (TV (var-shape (fst Γ) v)) (subM Δ Γ (TV (var-shape (fst Γ) v)) σ (varCube Γ v)))
              (subM-wcomp Δ' Δ Γ w σ (TV (var-shape (fst Γ) v)) (varCube Γ v)))
           (comp-ren (var-shape (fst Γ) v) Δ (subM Δ Γ (TV (var-shape (fst Γ) v)) σ (varCube Γ v)) (snd e v) Δ' w))
