-- Precomposition equivalence (I ≃ J) → ((J → A) ≃ (I → A)) and univalent Package transport
dom-equiv : {I J A : Type} → Equiv I J → Equiv (J → A) (I → A)
dom-equiv {I} {J} {A} e =
  transport {lzero} {Equiv (I → A) (I → A)} {Equiv (J → A) (I → A)}
    (λ i → Equiv (ua {lzero} {I} {J} e i → A) (I → A))
    (idEquiv {lzero} {I → A})
