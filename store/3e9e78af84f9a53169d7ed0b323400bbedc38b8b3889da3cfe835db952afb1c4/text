map-lift : (n : Nat) (X X' : Type 1) (Y : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y))
  (Z : Type 1) (k : (x' : X') → F' x' → Z) (c : Cube n X) (d : DCube n X Y c) →
  PathP (λ i → Cube n Z) (dcube-map n X' F' Z k (dcube-map n X Y X' f c d) (dcube-lift n X X' Y F' f g c d)) (dcube-map n X Y Z (λ x y → k (f x y) (g x y)) c d)
map-lift zero X X' Y F' f g Z k c d = λ i → k (f c d) (g c d)
map-lift (suc n) X X' Y F' f g Z k c d =
  map-lift n (Line X) (Line X') (LineO X Y) (LineO X' F') (lineo-map X Y X' f) (lineo-lift X X' Y F' f g) (Line Z) (lineo-map X' F' Z k) c d
