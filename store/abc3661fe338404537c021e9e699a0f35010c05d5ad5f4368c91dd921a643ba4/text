bw-allz-e : (A V W : Type) → (isz : A → Bool) → (f : V → V → A) → (t : W → V) → (e : V) → (z : A) → isz z ≡ true → ((w : W) → f (t w) e ≡ z) → (ws : List W) → it-allz A V isz f e (bw-map V W t ws) ≡ true
bw-allz-e A V W isz f t e z hz h ws = case ws return λ l → it-allz A V isz f e (bw-map V W t l) ≡ true of
  nil → λ i → true
  cons x xr → cl-tr Bool (if isz (f (t x) e) then it-allz A V isz f e (bw-map V W t xr) else false) (if isz z then true else false) true
    (λ i → if isz (h x i) then bw-allz-e A V W isz f t e z hz h xr i else false) (λ i → if hz i then true else false)
