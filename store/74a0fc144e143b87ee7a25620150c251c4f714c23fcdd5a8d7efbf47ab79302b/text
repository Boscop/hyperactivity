mask-select-paint-false : (l : List Word) → (r : List Bool) → (s : List Word) →
                          mask-select (list-append l s) (paint-onto false l r) ≡ mask-select s r
mask-select-paint-false nil r s = λ i → mask-select s r
mask-select-paint-false (cons x l) r s = mask-select-paint-false l r s
