-- THEOREM 2 (`$5,000` STRIKE ALLOCATION SUMS TO EXACT `#5000000000` uUSDC WITH ZERO DUST BY `refl`):
ms-thm-5k-strike-conserved :
  let a = ms-split-budget ms-target-5k-usdc6
  in andB (%weq (ms-alloc-sum a) #5000000000)
          (case a of
             mk-strike-alloc g b c x →
               andB (%weq g #500000000)
               (andB (%weq b #2500000000)
               (andB (%weq c #1500000000)
                     (%weq x #500000000)))) ≡ true
ms-thm-5k-strike-conserved = refl
