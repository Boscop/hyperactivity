-- ---------------------------------------------------------------- Glue
-- the Glue type: constructor 7, a base type and a system whose sides each carry, on a face, the
-- pair of a type and an equivalence from it to the base; where a face is the end 1 it is that type
nk-glue-ty : NkTm → NkTm → NkTm
nk-glue-ty a sys = nk-con #7 (nk-cons a (nk-cons sys nk-nil))
