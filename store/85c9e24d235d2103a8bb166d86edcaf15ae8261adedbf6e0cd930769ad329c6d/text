s-answer-views : List Word → List Word → List Word → List Word → Proc W (List Word) → Proc W (List Word)
s-answer-views st m path p next =
  if h-eq p "/graph" then s-workflow-graph else
  if h-prefix "/source/changes" path then s-changes st (s-query path) else
  if h-prefix "/source/text" path then s-text (s-query path) else
  if h-prefix "/source/object" path then s-object (s-query path) else
  if h-prefix "/source/entries" path then s-entries else
  if h-prefix "/api/graph" path then s-graph st m else
  if h-prefix "/api/history" path then s-history st (s-param "name" (s-query path)) else
  if h-eq p "/history" then s-file s-html "tools/history-view.html" else
  if h-prefix "/doc?" path then (if andB (h-prefix "docs/" (s-param "path" (s-query path))) (orB (h-ends ".hypercubical" (s-param "path" (s-query path))) (h-ends ".cub" (s-param "path" (s-query path)))) then s-essay (s-param "path" (s-query path)) else s-doc (s-param "path" (s-query path))) else
  next
