                muFloor = ue-max-w #1 (%wdiv ySteps #10)
                muCong  = if %wlt #70 loadPct then %wdiv (%wmul surp0 (%wsub loadPct #70)) #40 else #0
                muTau   = %wadd muFloor muCong
                chP     = ue-channel-params mode0
                pEl     = fst chP
                qEl     = fst (snd chP)
                chLbl   = snd (snd chP)
                split   = ue-settle-split pEl qEl xSteps ySteps muTau
                pStar   = ue-kkt-price pEl qEl xSteps ySteps muTau
                profW   = fst (snd split)
                saveW   = snd (snd split)
                tpPass  = ue-twopart-fee #100 xSteps (ue-y-eff xSteps ySteps muTau) #85
                certHc  = ue-ln "-- ============================================================================" (
