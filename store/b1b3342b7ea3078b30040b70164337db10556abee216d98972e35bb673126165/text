ue-contract-iter : Nat → UeExpr → UeExpr
ue-contract-iter zero    e = e
ue-contract-iter (suc n) e = ue-guarded-step (ue-contract-iter n e)

-- UNIVERSAL THEOREM 2 (ALL-`n` SEMANTIC SOUNDNESS + MONOTONE COST CONTRACTION = `CanonStep`):
ue-thm-contract-iter-sound : (n : Nat) → (env : Nat → Nat) → (e : UeExpr) →
  ue-eval-nat env (ue-contract-iter n e) ≡ ue-eval-nat env e
ue-thm-contract-iter-sound zero    env e = refl
ue-thm-contract-iter-sound (suc n) env e =
  let mid = ue-contract-iter n e
      c   = ue-contract1 mid
      s1  = ue-step-sound-at env mid c (ue-le (ue-cost-nat c) (ue-cost-nat mid)) (ue-thm-contract1-sound env mid)
  in ue-trans s1 (ue-thm-contract-iter-sound n env e)

ue-thm-contract-iter-monotone : (n : Nat) → (e : UeExpr) →
  ue-le (ue-cost-nat (ue-contract-iter n e)) (ue-cost-nat e) ≡ true
ue-thm-contract-iter-monotone zero    e = ue-le-refl (ue-cost-nat e)
ue-thm-contract-iter-monotone (suc n) e =
  let mid = ue-contract-iter n e
      c   = ue-contract1 mid
      s1  = ue-step-cost-at mid c (ue-le (ue-cost-nat c) (ue-cost-nat mid)) refl
      ih  = ue-thm-contract-iter-monotone n e
