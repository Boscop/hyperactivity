ue-trans : {A : Type} → {x y z : A} → x ≡ y → y ≡ z → x ≡ z
ue-trans {A} {x} p q = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

ue-sym : {A : Type} → {x y : A} → x ≡ y → y ≡ x
ue-sym p = λ i → p (~ i)

ue-cong2 : {A B C : Type} → (f : A → B → C) → {a1 a2 : A} → {b1 b2 : B} → a1 ≡ a2 → b1 ≡ b2 → f a1 b1 ≡ f a2 b2
ue-cong2 f p q = λ i → f (p i) (q i)

ue-add : Nat → Nat → Nat
ue-add zero    m = m
ue-add (suc n) m = suc (ue-add n m)

ue-mul : Nat → Nat → Nat
ue-mul zero    m = zero
ue-mul (suc n) m = ue-add m (ue-mul n m)

ue-le : Nat → Nat → Bool
ue-le zero    m       = true
ue-le (suc n) zero    = false
ue-le (suc n) (suc m) = ue-le n m

ue-le-refl : (n : Nat) → ue-le n n ≡ true
ue-le-refl zero    = refl
ue-le-refl (suc n) = ue-le-refl n

ue-false-imp : (b : Bool) → false ≡ true → b ≡ true
ue-false-imp true  h = refl
ue-false-imp false h = h

ue-le-trans : (a b c : Nat) → ue-le a b ≡ true → ue-le b c ≡ true → ue-le a c ≡ true
ue-le-trans zero    b       c       hab hbc = refl
ue-le-trans (suc a) zero    c       hab hbc = ue-false-imp (ue-le (suc a) c) hab
ue-le-trans (suc a) (suc b) zero    hab hbc = hbc
ue-le-trans (suc a) (suc b) (suc c) hab hbc = ue-le-trans a b c hab hbc

ue-add-zero-r : (n : Nat) → ue-add n zero ≡ n
ue-add-zero-r zero    = refl
ue-add-zero-r (suc n) = cong suc (ue-add-zero-r n)

ue-add-assoc : (a b c : Nat) → ue-add (ue-add a b) c ≡ ue-add a (ue-add b c)
ue-add-assoc zero    b c = refl
ue-add-assoc (suc a) b c = cong suc (ue-add-assoc a b c)

ue-mul-zero-r : (n : Nat) → ue-mul n zero ≡ zero
ue-mul-zero-r zero    = refl
ue-mul-zero-r (suc n) = ue-mul-zero-r n

ue-mul-one-r : (n : Nat) → ue-mul n (suc zero) ≡ n
ue-mul-one-r zero    = refl
ue-mul-one-r (suc n) = cong suc (ue-mul-one-r n)

ue-mul-dist-r : (a b x : Nat) → ue-mul (ue-add a b) x ≡ ue-add (ue-mul a x) (ue-mul b x)
ue-mul-dist-r zero    b x = refl
ue-mul-dist-r (suc a) b x =
  ue-trans (cong (ue-add x) (ue-mul-dist-r a b x))
           (ue-sym (ue-add-assoc x (ue-mul a x) (ue-mul b x)))

ue-n4 : Nat
ue-n4 = suc (suc (suc (suc zero)))

ue-cournot-4flow : Nat → Nat → Nat
ue-cournot-4flow b d = ue-mul ue-n4 (ue-mul b (ue-add b d))

ue-surplus-sq : Nat → Nat → Nat
ue-surplus-sq b d =
  let s = ue-add (ue-add b d) b
  in ue-mul s s

-- THEOREM 1A (EXACT COURNOT QUADRATIC IDENTITY `4*b*(b+d) + d^2 === (2b+d)^2` & MIDPOINT OPTIMALITY):
ue-thm-cournot-exact-identity :
  andB (%weq (fromNat (ue-add (ue-cournot-4flow (toNat #50) (toNat #0)) (ue-mul (toNat #0) (toNat #0))))
             (fromNat (ue-surplus-sq (toNat #50) (toNat #0))))
  (andB (%weq (fromNat (ue-add (ue-cournot-4flow (toNat #35) (toNat #30)) (ue-mul (toNat #30) (toNat #30))))
              (fromNat (ue-surplus-sq (toNat #35) (toNat #30))))
        (%wlt (fromNat (ue-cournot-4flow (toNat #35) (toNat #30)))
              (fromNat (ue-cournot-4flow (toNat #50) (toNat #0))))) ≡ true
ue-thm-cournot-exact-identity = refl

-- CLOSED-FORM ELASTICITY + KKT SHADOW PRICING KERNEL:
-- `P*(p, q, X, Y, muTau) = Y_eff + (q / (p + q)) * (X - Y_eff)` where `Y_eff = min(X, Y + muTau)`
ue-min-w : Word → Word → Word
ue-min-w a b = if %wlt a b then a else b

ue-max-w : Word → Word → Word
ue-max-w a b = if %wlt a b then b else a

ue-y-eff : Word → Word → Word → Word
ue-y-eff xBase yPhys muTau = ue-min-w xBase (%wadd yPhys muTau)

ue-kkt-price : Word → Word → Word → Word → Word → Word
ue-kkt-price pElast qElast xBase yPhys muTau =
  if %wlt xBase yPhys then yPhys
  else
    let yEff  = ue-y-eff xBase yPhys muTau
        surp  = %wsub xBase yEff
        denom = ue-max-w #1 (%wadd pElast qElast)
        capt  = %wdiv (%wmul qElast surp) denom
    in %wadd yEff capt

ue-settle-split : Word → Word → Word → Word → Word → Word × (Word × Word)
ue-settle-split pElast qElast xBase yPhys muTau =
  if %wlt xBase yPhys
  then (yPhys , (#0 , #0))
  else
    let pStar = ue-kkt-price pElast qElast xBase yPhys muTau
        prof  = %wsub pStar yPhys
        saved = %wsub xBase pStar
    in (yPhys , (prof , saved))

-- THEOREM 1B (`gamma = 1/9 -> alpha* = 90%` MAXIMIZES ROUTER CASHFLOW + ZERO-DUST CONSERVATION):
ue-thm-agent-x402-90pct-dominates-50pct :
  let s90  = ue-settle-split #1 #9 #1000000 #50000 #0
      s50  = ue-settle-split #1 #1 #1000000 #50000 #0
      cf90 = %wdiv (%wmul (fst (snd s90)) #95) #100
      cf50 = %wdiv (%wmul (fst (snd s50)) #99) #100
  in andB (%wlt cf50 cf90)
     (andB (%weq (%wadd (fst s90) (%wadd (fst (snd s90)) (snd (snd s90)))) #1000000)
           (%wlt #0 (snd (snd s90)))) ≡ true
ue-thm-agent-x402-90pct-dominates-50pct = refl

-- THEOREM 1C (NONLINEAR TWO-PART STREAM PASS ELIMINATES DEADWEIGHT LOSS & DOMINATES LINEAR PRICING):
ue-twopart-fee : Word → Word → Word → Word → Word
ue-twopart-fee nJobs xBase yEff capturePct =
  if %wlt xBase yEff then #0
  else %wdiv (%wmul nJobs (%wmul (%wsub xBase yEff) capturePct)) #100

ue-thm-twopart-dominates-linear :
  let linCash = %wmul #50 (fst (snd (ue-settle-split #1 #1 #10000 #1000 #0)))
      tpCash  = ue-twopart-fee #100 #10000 #1000 #75
  in %wlt linCash tpCash ≡ true
ue-thm-twopart-dominates-linear = refl

-- THEOREM 1D (KKT SHADOW PRICE `mu*` KNAPSACK ADMISSION DOMINATES FIFO UNDER SCARCE CAPACITY):
ue-kkt-admit : Word → Word → Word → Word → Bool
ue-kkt-admit xBase yPhys tauMs muPerMs =
  %wlt (%wadd yPhys (%wmul tauMs muPerMs)) xBase

ue-thm-kkt-knapsack-beats-fifo :
  andB (h-not (ue-kkt-admit #1200 #1000 #100 #45))
  (andB (ue-kkt-admit #5000 #100 #50 #45)
  (andB (ue-kkt-admit #2500 #100 #50 #45)
        (%wlt #200 (%wadd (fst (snd (ue-settle-split #1 #9 #5000 #100 #2250)))
                          (fst (snd (ue-settle-split #1 #9 #2500 #100 #2250))))))) ≡ true
ue-thm-kkt-knapsack-beats-fifo = refl

