  else nil

ue-rev : List Word → List Word → List Word
ue-rev acc nil = acc
ue-rev acc (cons x xs) = ue-rev (cons x acc) xs

ue-num-before : List Word → List Word → Word
ue-num-before tag txt =
  if h-not (h-infix tag txt) then #0
  else let pre = h-before tag txt
           r   = ue-rev nil pre
           ds  = ue-rev nil (ue-last-digits-rev r)
       in ue-parse-num #0 ds

ue-comment-lines : List (List Word) → List Word
