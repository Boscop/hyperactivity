data UeExpr : Type where
  ue-lit : Nat → UeExpr
  ue-var : Nat → UeExpr
  ue-pls : UeExpr → UeExpr → UeExpr
  ue-tim : UeExpr → UeExpr → UeExpr
  ue-d01 : UeExpr → UeExpr

ue-eval-nat : (Nat → Nat) → UeExpr → Nat
ue-eval-nat env (ue-lit v)   = v
ue-eval-nat env (ue-var k)   = env k
ue-eval-nat env (ue-pls a b) = ue-add (ue-eval-nat env a) (ue-eval-nat env b)
ue-eval-nat env (ue-tim a b) = ue-mul (ue-eval-nat env a) (ue-eval-nat env b)
ue-eval-nat env (ue-d01 x)   = zero

ue-cost-nat : UeExpr → Nat
ue-cost-nat (ue-lit v)   = suc zero
ue-cost-nat (ue-var k)   = suc zero
ue-cost-nat (ue-pls a b) = suc (ue-add (ue-cost-nat a) (ue-cost-nat b))
ue-cost-nat (ue-tim a b) = suc (suc (ue-add (ue-cost-nat a) (ue-cost-nat b)))
ue-cost-nat (ue-d01 x)   = suc (ue-cost-nat x)

ue-nat-eq : Nat → Nat → Bool
ue-nat-eq zero    zero    = true
ue-nat-eq zero    (suc m) = false
ue-nat-eq (suc n) zero    = false
ue-nat-eq (suc n) (suc m) = ue-nat-eq n m

ue-true-ne-false : true ≡ false → Empty
ue-true-ne-false p = transport (λ i → if p i then Unit else Empty) unit

ue-nat-eq-sound : (a b : Nat) → ue-nat-eq a b ≡ true → a ≡ b
ue-nat-eq-sound zero    zero    h = refl
ue-nat-eq-sound zero    (suc m) h = Empty-rec (ue-true-ne-false (ue-sym h))
ue-nat-eq-sound (suc n) zero    h = Empty-rec (ue-true-ne-false (ue-sym h))
ue-nat-eq-sound (suc n) (suc m) h = cong suc (ue-nat-eq-sound n m h)

ue-peep-pls : UeExpr → UeExpr → UeExpr
ue-peep-pls (ue-lit zero) b = b
ue-peep-pls a (ue-lit zero) = a
ue-peep-pls (ue-tim a1 (ue-var k1)) (ue-tim a2 (ue-var k2)) =
  if ue-nat-eq k1 k2
  then ue-tim (ue-pls a1 a2) (ue-var k1)
  else ue-pls (ue-tim a1 (ue-var k1)) (ue-tim a2 (ue-var k2))
ue-peep-pls a b = ue-pls a b

ue-peep-pls-At : (env : Nat → Nat) → (a1 a2 : UeExpr) → (k1 k2 : Nat) → (fl : Bool) →
  ue-nat-eq k1 k2 ≡ fl →
  ue-eval-nat env (if fl then ue-tim (ue-pls a1 a2) (ue-var k1) else ue-pls (ue-tim a1 (ue-var k1)) (ue-tim a2 (ue-var k2))) ≡
  ue-add (ue-mul (ue-eval-nat env a1) (env k1)) (ue-mul (ue-eval-nat env a2) (env k2))
ue-peep-pls-At env a1 a2 k1 k2 false h = refl
ue-peep-pls-At env a1 a2 k1 k2 true  h =
  let kp = ue-nat-eq-sound k1 k2 h
  in ue-trans
       (ue-mul-dist-r (ue-eval-nat env a1) (ue-eval-nat env a2) (env k1))
       (cong (λ z → ue-add (ue-mul (ue-eval-nat env a1) (env k1)) (ue-mul (ue-eval-nat env a2) (env z))) kp)

ue-lem-peep-pls-sound : (env : Nat → Nat) → (a b : UeExpr) →
  ue-eval-nat env (ue-peep-pls a b) ≡ ue-add (ue-eval-nat env a) (ue-eval-nat env b)
ue-lem-peep-pls-sound env (ue-lit zero) b = refl
ue-lem-peep-pls-sound env (ue-lit (suc n)) (ue-lit zero) = ue-sym (ue-add-zero-r (suc n))
ue-lem-peep-pls-sound env (ue-lit (suc n)) (ue-lit (suc m)) = refl
ue-lem-peep-pls-sound env (ue-lit (suc n)) (ue-var k) = refl
ue-lem-peep-pls-sound env (ue-lit (suc n)) (ue-pls c d) = refl
ue-lem-peep-pls-sound env (ue-lit (suc n)) (ue-tim c d) = refl
ue-lem-peep-pls-sound env (ue-lit (suc n)) (ue-d01 c) = refl
ue-lem-peep-pls-sound env (ue-var k) (ue-lit zero) = ue-sym (ue-add-zero-r (env k))
ue-lem-peep-pls-sound env (ue-var k) (ue-lit (suc m)) = refl
ue-lem-peep-pls-sound env (ue-var k) (ue-var j) = refl
ue-lem-peep-pls-sound env (ue-var k) (ue-pls c d) = refl
ue-lem-peep-pls-sound env (ue-var k) (ue-tim c d) = refl
ue-lem-peep-pls-sound env (ue-var k) (ue-d01 c) = refl
ue-lem-peep-pls-sound env (ue-pls x y) (ue-lit zero) = ue-sym (ue-add-zero-r (ue-eval-nat env (ue-pls x y)))
ue-lem-peep-pls-sound env (ue-pls x y) (ue-lit (suc m)) = refl
ue-lem-peep-pls-sound env (ue-pls x y) (ue-var j) = refl
ue-lem-peep-pls-sound env (ue-pls x y) (ue-pls c d) = refl
ue-lem-peep-pls-sound env (ue-pls x y) (ue-tim c d) = refl
ue-lem-peep-pls-sound env (ue-pls x y) (ue-d01 c) = refl
ue-lem-peep-pls-sound env (ue-d01 x) (ue-lit zero) = refl
ue-lem-peep-pls-sound env (ue-d01 x) (ue-lit (suc m)) = refl
ue-lem-peep-pls-sound env (ue-d01 x) (ue-var j) = refl
ue-lem-peep-pls-sound env (ue-d01 x) (ue-pls c d) = refl
ue-lem-peep-pls-sound env (ue-d01 x) (ue-tim c d) = refl
ue-lem-peep-pls-sound env (ue-d01 x) (ue-d01 c) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-lit v)) (ue-lit zero) = ue-sym (ue-add-zero-r (ue-eval-nat env (ue-tim a1 (ue-lit v))))
ue-lem-peep-pls-sound env (ue-tim a1 (ue-lit v)) (ue-lit (suc m)) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-lit v)) (ue-var j) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-lit v)) (ue-pls c d) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-lit v)) (ue-tim c d) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-lit v)) (ue-d01 c) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-pls x y)) (ue-lit zero) = ue-sym (ue-add-zero-r (ue-eval-nat env (ue-tim a1 (ue-pls x y))))
ue-lem-peep-pls-sound env (ue-tim a1 (ue-pls x y)) (ue-lit (suc m)) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-pls x y)) (ue-var j) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-pls x y)) (ue-pls c d) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-pls x y)) (ue-tim c d) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-pls x y)) (ue-d01 c) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-tim x y)) (ue-lit zero) = ue-sym (ue-add-zero-r (ue-eval-nat env (ue-tim a1 (ue-tim x y))))
ue-lem-peep-pls-sound env (ue-tim a1 (ue-tim x y)) (ue-lit (suc m)) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-tim x y)) (ue-var j) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-tim x y)) (ue-pls c d) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-tim x y)) (ue-tim c d) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-tim x y)) (ue-d01 c) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-d01 x)) (ue-lit zero) = ue-sym (ue-add-zero-r (ue-eval-nat env (ue-tim a1 (ue-d01 x))))
ue-lem-peep-pls-sound env (ue-tim a1 (ue-d01 x)) (ue-lit (suc m)) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-d01 x)) (ue-var j) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-d01 x)) (ue-pls c d) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-d01 x)) (ue-tim c d) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-d01 x)) (ue-d01 c) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-var k1)) (ue-lit zero) = ue-sym (ue-add-zero-r (ue-mul (ue-eval-nat env a1) (env k1)))
ue-lem-peep-pls-sound env (ue-tim a1 (ue-var k1)) (ue-lit (suc m)) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-var k1)) (ue-var j) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-var k1)) (ue-pls c d) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-var k1)) (ue-d01 c) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-var k1)) (ue-tim a2 (ue-lit v)) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-var k1)) (ue-tim a2 (ue-pls c d)) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-var k1)) (ue-tim a2 (ue-tim c d)) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-var k1)) (ue-tim a2 (ue-d01 c)) = refl
ue-lem-peep-pls-sound env (ue-tim a1 (ue-var k1)) (ue-tim a2 (ue-var k2)) =
  ue-peep-pls-At env a1 a2 k1 k2 (ue-nat-eq k1 k2) refl

ue-peep-tim : UeExpr → UeExpr → UeExpr
ue-peep-tim (ue-lit zero)       b = ue-lit zero
ue-peep-tim (ue-lit (suc zero)) b = b
ue-peep-tim a                   b = ue-tim a b

ue-lem-peep-tim-sound : (env : Nat → Nat) → (a b : UeExpr) →
  ue-eval-nat env (ue-peep-tim a b) ≡ ue-mul (ue-eval-nat env a) (ue-eval-nat env b)
ue-lem-peep-tim-sound env (ue-lit zero)          b = refl
ue-lem-peep-tim-sound env (ue-lit (suc zero))    b = ue-sym (ue-add-zero-r (ue-eval-nat env b))
ue-lem-peep-tim-sound env (ue-lit (suc (suc n))) b = refl
ue-lem-peep-tim-sound env (ue-var k)             b = refl
ue-lem-peep-tim-sound env (ue-pls x y)           b = refl
ue-lem-peep-tim-sound env (ue-tim x y)           b = refl
ue-lem-peep-tim-sound env (ue-d01 x)             b = refl

ue-contract1 : UeExpr → UeExpr
ue-contract1 (ue-lit v)   = ue-lit v
ue-contract1 (ue-var k)   = ue-var k
ue-contract1 (ue-pls a b) = ue-peep-pls (ue-contract1 a) (ue-contract1 b)
ue-contract1 (ue-tim a b) = ue-peep-tim (ue-contract1 a) (ue-contract1 b)
ue-contract1 (ue-d01 x)   = ue-lit zero

ue-thm-contract1-sound : (env : Nat → Nat) → (e : UeExpr) →
  ue-eval-nat env (ue-contract1 e) ≡ ue-eval-nat env e
ue-thm-contract1-sound env (ue-lit v)   = refl
ue-thm-contract1-sound env (ue-var k)   = refl
ue-thm-contract1-sound env (ue-pls a b) =
  ue-trans
    (ue-lem-peep-pls-sound env (ue-contract1 a) (ue-contract1 b))
    (ue-cong2 ue-add (ue-thm-contract1-sound env a) (ue-thm-contract1-sound env b))
ue-thm-contract1-sound env (ue-tim a b) =
  ue-trans
    (ue-lem-peep-tim-sound env (ue-contract1 a) (ue-contract1 b))
    (ue-cong2 ue-mul (ue-thm-contract1-sound env a) (ue-thm-contract1-sound env b))
ue-thm-contract1-sound env (ue-d01 x)   = refl

ue-guarded-step : UeExpr → UeExpr
ue-guarded-step e =
  let c = ue-contract1 e
  in if ue-le (ue-cost-nat c) (ue-cost-nat e) then c else e

ue-step-sound-at : (env : Nat → Nat) → (e c : UeExpr) → (fl : Bool) →
  ue-eval-nat env c ≡ ue-eval-nat env e →
  ue-eval-nat env (if fl then c else e) ≡ ue-eval-nat env e
ue-step-sound-at env e c true  p = p
ue-step-sound-at env e c false p = refl

ue-step-cost-at : (e c : UeExpr) → (fl : Bool) →
  ue-le (ue-cost-nat c) (ue-cost-nat e) ≡ fl →
  ue-le (ue-cost-nat (if fl then c else e)) (ue-cost-nat e) ≡ true
ue-step-cost-at e c true  h = h
