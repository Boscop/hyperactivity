UeRunRes = Bool × (Word × (Word × List Word))

ue-run-or-cache : List Word → List Word → List Word → List Word → List Word → Sum Unit (List Word) → Sum Unit (List Word) → Proc W UeRunRes
ue-run-or-cache binPath cDir fOut fBaseX fullSrc (inr cOut) mCachedX =
  ret {lzero} {W} (the UeRunRes (true , (ue-cached-x mCachedX , (#1 , cOut))))
ue-run-or-cache binPath cDir fOut fBaseX fullSrc (inl u) mCachedX =
  bind (sys-call #39 #0 #0 #0 #0 #0 #0) (λ pid →
  let tmpF = list-append cDir (list-append "/eval_" (list-append (h-decimal pid) ".hypercubical"))
      cub  = if h-null binPath then the (List Word) "./build/cubical" else binPath
  in bind (h-write tmpF (h-take (toNat #65536) fullSrc)) (λ wr →
     bind (h-capture (cons "/bin/sh" (cons "-c" (cons "IFS=; CUBICAL_WORKERS=1; export CUBICAL_WORKERS; ulimit -t 6 2>/dev/null; exec $1 --read --with hx_eval_task.hypercubical $2 hx_eval_task.hypercubical" (cons "_" (cons cub (cons tmpF nil))))))) (λ res →
     bind (h-unlink tmpF) (λ ul →
       let outTxt  = snd res
           passedN = ue-max-w #1 (ue-num-before " passed," outTxt)
           stepsY0 = ue-max-w #1 (ue-num-before " interaction steps performed" outTxt)
           cellsN  = ue-num-before " cells live" outTxt
           baseX   = ue-max-w (%wadd stepsY0 #100) (%wadd (%wmul passedN #1400) (%wadd (%wmul stepsY0 #4) cellsN))
           okRun   = weq (fst res) #0
       in bind (if okRun then h-write fOut outTxt else ret {lzero} {W} false) (λ w1 →
          bind (if okRun then h-write fBaseX (h-decimal baseX) else ret {lzero} {W} false) (λ w2 →
          ret {lzero} {W} (the UeRunRes (false , (baseX , (stepsY0 , outTxt))))))))))

-- Execute `.hypercubical` on `./build/cubical --read`, memoize in `/tmp/hx_hyperreactor`, & emit pure `.hypercubical`:
ue-eval-hypercubical : List Word → List Word → List Word → Proc W (List Word)
ue-eval-hypercubical binPath qs body =
  let qCode   = ue-qparam "code" qs
      mode0   = ue-qparam "mode" qs
      loadS   = ue-qparam "load" qs
      loadPct = if h-null loadS then #35 else ue-min-w #100 (ue-parse-num #0 loadS)
      rawCode = if h-not (h-null qCode) then qCode
                else if h-not (h-null (h-trim body)) then body
                else ue-default-program
      lns     = h-lines rawCode
  in if h-not (ue-all-imports-safe lns)
     then ret {lzero} {W} (ue-ln "-- refused: import path must name a module inside the repository store/" nil)
     else
       let fullSrc = if ue-has-import lns then rawCode
                     else list-append "import " (list-append ue-q (list-append "lib/core.hypercubical" (list-append ue-q (cons #10 rawCode))))
           h64     = ue-fnv64 #14695981039346656037 fullSrc
           hHex    = ue-hex-n (toNat #16) h64
           cDir    = the (List Word) "/tmp/hx_hyperreactor"
           fOut    = list-append cDir (list-append "/" (list-append hHex ".out"))
           fBaseX  = list-append cDir (list-append "/" (list-append hHex ".x"))
       in bind (h-mkdir cDir) (λ u0 →
          bind (h-read fOut) (λ mCachedOut →
          bind (h-read fBaseX) (λ mCachedX →
          bind (ue-run-or-cache binPath cDir fOut fBaseX fullSrc mCachedOut mCachedX) (λ runInfo →
            let isHit   = fst runInfo
