ue-hex-val : Word → Word
ue-hex-val c =
  if andB (%wlt #47 c) (%wlt c #58) then %wsub c #48
  else if andB (%wlt #64 c) (%wlt c #71) then %wadd (%wsub c #65) #10
  else if andB (%wlt #96 c) (%wlt c #103) then %wadd (%wsub c #97) #10
  else #0

ue-url-decode : List Word → List Word
ue-url-decode nil = nil
ue-url-decode (cons c cs) =
  if weq c #43 then cons #32 (ue-url-decode cs)
  else if weq c #37 then
    case cs of
      nil → nil
      cons h1 rs1 →
        case rs1 of
          nil → nil
          cons h2 rs2 → cons (%wor (%wshl (ue-hex-val h1) #4) (ue-hex-val h2)) (ue-url-decode rs2)
  else cons c (ue-url-decode cs)

ue-qparam : List Word → List Word → List Word
ue-qparam key qs =
  let pat1 = list-append key "="
      pat2 = list-append "&" pat1
  in if h-prefix pat1 qs then ue-url-decode (h-before "&" (h-drop pat1 qs))
     else if h-infix pat2 qs then ue-url-decode (h-before "&" (h-after pat2 qs))
     else nil

ue-parse-num : Word → List Word → Word
ue-parse-num acc nil = acc
ue-parse-num acc (cons c cs) =
  if andB (%wlt #47 c) (%wlt c #58)
  then ue-parse-num (%wadd (%wmul acc #10) (%wsub c #48)) cs
  else acc

ue-fnv64 : Word → List Word → Word
ue-fnv64 h nil = h
ue-fnv64 h (cons c cs) = ue-fnv64 (%wmul (%wxor h (%wand c #255)) #1099511628211) cs

ue-hex-digit : Word → Word
ue-hex-digit n =
  let v = %wand n #15
  in if %wlt v #10 then %wadd #48 v else %wadd #87 v

ue-hex-n : Nat → Word → List Word
ue-hex-n zero    w = nil
ue-hex-n (suc k) w = list-append (ue-hex-n k (%wshr w #4)) (cons (ue-hex-digit w) nil)

-- Sanitize `import` lines so untrusted `.hypercubical` code can only import repo `store/` modules:
