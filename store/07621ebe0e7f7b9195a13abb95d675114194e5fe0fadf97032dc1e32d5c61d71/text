inet-hw-fire : InetHwState → InetActPair → Bool → InetHwState
inet-hw-fire (ihw a c p fp g) (iapair kA tA cA kB tB cB) false =
  ihw a c (suc p) fp g
inet-hw-fire (ihw a c p fp g) (iapair kA tA cA kB tB cB) true =
  if andB (inet-kind-eq kA kB) (weq tA tB)
  then ihw (suc a) c p fp g
  else ihw a (suc c) p (plus (toNat #4) fp) g
