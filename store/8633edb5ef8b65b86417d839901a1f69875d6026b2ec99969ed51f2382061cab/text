msort-fuel-sorted : {o : Ord} → (f : Nat) → (l : List (El o)) → Sorted (msort-fuel f l)
msort-fuel-sorted f =
  case f return λ w → (l : List (El o)) → Sorted {o} (msort-fuel w l) of
    zero → λ l → ins-sort-sorted l
    suc f1 →
      λ l →
        case l return λ v → Sorted {o} (msort-fuel (suc f1) v) of
          nil → unit
          cons x r →
            case r return λ u → Sorted {o} (msort-fuel (suc f1) (cons x u)) of
              nil → (unit , unit)
              cons y r2 →
                merge-sorted {o} {msort-fuel f1 (fst (halves (cons x (cons y r2))))} {msort-fuel f1 (snd (halves (cons x (cons y r2))))}
                  (rec f1 (fst (halves (cons x (cons y r2))))) (rec f1 (snd (halves (cons x (cons y r2)))))
