ev-obj-alloc : {l : Level} {S : Sig} {V : Type} → Target → LayEnv → AKind → Bool → MTy → Ev {l} S V MPtr
ev-obj-alloc {l} {S} {V} t env kd z ty =
  ev-bind {l} {S} {V} {Word} {MPtr} (ev-res {l} {S} {V} {Word} (ty-size t env ty)) (λ sz →
  ev-bind {l} {S} {V} {Word} {MPtr} (ev-res {l} {S} {V} {Word} (ty-align t env ty)) (λ al → ev-alloc {l} {S} {V} kd z sz al))
