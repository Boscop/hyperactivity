wp-joint-agent-assoc : (ver : Word → Word → Bool) → (claim : Word) →
  (a b c : WarrantPolicy) →
  wp-satisfies ver claim (wp-and (wp-and a b) c) ≡ wp-satisfies ver claim (wp-and a (wp-and b c))
wp-joint-agent-assoc ver claim a b c =
  andB-assoc-s (wp-satisfies ver claim a) (wp-satisfies ver claim b) (wp-satisfies ver claim c)
