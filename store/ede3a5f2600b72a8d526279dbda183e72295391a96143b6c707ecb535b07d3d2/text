-- ---------------------------------------------------------------- statements the checker computes
-- two bodies the same, symbol for symbol
nk-tm-eq : NkTm → NkTm → Bool
nk-tm-eq (nk-var i) (nk-var j) = %weq i j
nk-tm-eq (nk-free x) (nk-free y) = %weq x y
nk-tm-eq (nk-num m) (nk-num k) = %weq m k
nk-tm-eq (nk-lam b) (nk-lam c) = nk-tm-eq b c
nk-tm-eq (nk-susp b) (nk-susp c) = nk-tm-eq b c
nk-tm-eq (nk-con c as) (nk-con d bs) = nk-and (%weq c d) (nk-tm-eq as bs)
nk-tm-eq (nk-op h p as) (nk-op g q bs) = nk-and (%weq h g) (nk-and (nk-tm-eq p q) (nk-tm-eq as bs))
nk-tm-eq (nk-match h p as) (nk-match g q bs) = nk-and (%weq h g) (nk-and (nk-tm-eq p q) (nk-tm-eq as bs))
nk-tm-eq nk-nil nk-nil = true
nk-tm-eq (nk-cons t r) (nk-cons u s) = nk-and (nk-tm-eq t u) (nk-tm-eq r s)
nk-tm-eq a c = false
