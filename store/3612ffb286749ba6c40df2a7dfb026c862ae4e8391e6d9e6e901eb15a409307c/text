nk-nf-start-s : NkTm → NkTm → NkExec
nk-nf-start-s kdefs t =
  let useG = nk-has-gref t
      sl0 = if useG then nk-init-defs kdefs #2 nksl-nil else nksl-nil
      w0 = if useG then nk-bw-of (%wadd (nk-el-len kdefs) #2) else nk-bw-of #2
  in nk-start-with sl0
       (nk-build t nke-nil nk-w1 (nk-plan-of (nkf-op nk-w1 (nko-quote #0 nk-w0) nkf-nil) w0))
