-- D itself, D some ticks later (a guarded field), or a path in D (a truncation's argument, of any
-- dimension): at level lzero in D's own level
later-rec d c =
  case c of
    tdata d2 ps V → %weq d d2
    tpi B nm b V → (case B of ttick k V2 → later-rec d (b (%var Uw) Uw); _ → false)
    tpathp L x y V → later-rec-line d L
    _ → false
