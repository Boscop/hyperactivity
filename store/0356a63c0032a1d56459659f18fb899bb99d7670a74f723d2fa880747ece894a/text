steal-fifo-conserves : (old : Word) → (donorRest thiefDq : List Word) →
  plus (list-length {Word} (fst (steal-fifo-step (cons old donorRest) thiefDq)))
       (list-length {Word} (snd (steal-fifo-step (cons old donorRest) thiefDq)))
  ≡
  plus (list-length {Word} (cons old donorRest))
       (list-length {Word} thiefDq)
steal-fifo-conserves old donorRest thiefDq =
  plus-suc-r-nat (list-length {Word} donorRest) (list-length {Word} thiefDq)
