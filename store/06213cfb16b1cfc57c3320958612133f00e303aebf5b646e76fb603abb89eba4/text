-- the spectrum of q_123 at doubled spins j1 … j4, every eigenvalue in an interval of width 1/2^s inside (−2^t, 2^t]
spectrum : List Bool → List Bool → List Bool → List Bool → Nat → Nat → List (BZ × (BZ × Nat))
spectrum j1 j2 j3 j4 t s = isolate j1 j2 j3 j4 (bin-pow2 s) (bin-pow2 (plus s s)) (plus t s)
  (false , bin-pow2 (plus t s)) (true , bin-pow2 (plus t s))
  (eig-above j1 j2 j3 j4 (false , bin-pow2 (plus t s)) (bin-pow2 s) (bin-pow2 (plus s s))) (eig-above j1 j2 j3 j4 (true , bin-pow2 (plus t s)) (bin-pow2 s) (bin-pow2 (plus s s)))
