-- Clear all 8 slots to K_FREE (0), resetting rcnt (bit 7 = 128) on slot 0
ic-clear-all : List Word
ic-clear-all =
  sv-concat
    (cons (ic-load #0 #0 #128)
    (cons (ic-load #1 #0 #0)
    (cons (ic-load #2 #0 #0)
    (cons (ic-load #3 #0 #0)
    (cons (ic-load #4 #0 #0)
    (cons (ic-load #5 #0 #0)
    (cons (ic-load #6 #0 #0)
    (cons (ic-load #7 #0 #0) nil))))))))
