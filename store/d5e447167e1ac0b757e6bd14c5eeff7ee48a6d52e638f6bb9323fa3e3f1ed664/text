-- Exact Calma GDSII v6.0 header + library + units + structure framing:
--   HEADER  (0x0002,  6 bytes): version 600 (v6.0)
--   BGNLIB  (0x0102, 28 bytes): 12 x int16 timestamps
--   LIBNAME (0x0206, 14 bytes): "HYPERCORE\0" (10 bytes, even-padded)
--   UNITS   (0x0305, 20 bytes): IBM excess-64 64-bit floats:
--             user_unit = 1e-3 (0x3E4189374BC6A7F0) [1 dbu = 1 nm when 1 uu = 1 um]
--             dbu_m     = 1e-9 (0x3944B82FA09B5A53) [1 dbu = 1 nm in meters]
--   BGNSTR  (0x0502, 28 bytes): 12 x int16 timestamps
--   STRNAME (0x0606, 16 bytes): "XOR4_GAA3NM\0" (12 bytes, even-padded)
gds-v6-preamble : List Word
gds-v6-preamble =
  sv-concat
    (cons (gds-u16s (cons #6 (cons gds-rec-header (cons #600 nil))))
    (cons (gds-u16s (cons #28 (cons gds-rec-bgnlib nil)))
    (cons gds-timestamp-bytes
    (cons (gds-u16s (cons #14 (cons #518 nil)))
    (cons (list-append "HYPERCORE" (cons #0 nil))
    (cons (gds-u16s (cons #20 (cons #773 nil)))
    (cons (cons #62 (cons #65 (cons #137 (cons #55 (cons #75 (cons #198 (cons #167 (cons #240 nil))))))))
    (cons (cons #57 (cons #68 (cons #184 (cons #47 (cons #160 (cons #155 (cons #90 (cons #83 nil))))))))
    (cons (gds-u16s (cons #28 (cons gds-rec-bgnstr nil)))
    (cons gds-timestamp-bytes
    (cons (gds-u16s (cons #16 (cons #1542 nil)))
    (cons (list-append "XOR4_GAA3NM" (cons #0 nil)) nil))))))))))))
