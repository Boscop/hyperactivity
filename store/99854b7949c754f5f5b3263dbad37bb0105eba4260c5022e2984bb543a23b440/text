s-bold-at : (List Word → List Word) → List Word → Sum Unit (List Word × List Word) → List Word
s-bold-at k r (inl u) = cons #42 (k r)
s-bold-at k r (inr p) = if andB (h-not (h-null (fst p))) (andB (s-no-star (fst p)) (h-prefix "*" (snd p)))
  then list-append "<b>" (list-append (fst p) (list-append "</b>" (k (h-drop "*" (snd p))))) else cons #42 (k r)
