<script>
// Lab 1: Driven FitzHugh-Nagumo + SOS Trapping Region
(function() {
  const stage = document.getElementById('fhnStage');
  const canvas = document.getElementById('fhnCanvas');
  const ctx = canvas.getContext('2d');
  const slI = document.getElementById('fhnI'), slB = document.getElementById('fhnB');
  const valI = document.getElementById('fhnIVal'), valB = document.getElementById('fhnBVal');
  const statusEl = document.getElementById('fhnStatus');

  let v = -1.0, w = -0.5, trail = [];
  function resize() {
    const r = stage.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.floor(r.width * dpr));
    canvas.height = Math.max(1, Math.floor(r.height * dpr));
  }
  new ResizeObserver(resize).observe(stage); resize();

  document.getElementById('fhnPerturb').onclick = () => { v = Math.max(-2.4, Math.min(2.4, v + 1.3)); w -= 0.4; };
  document.getElementById('fhnReset').onclick = () => { v = -1.0; w = -0.5; trail = []; };

  function step() {
    const I = parseFloat(slI.value), b = parseFloat(slB.value), a = 0.7, eps = 0.08;
    valI.textContent = I.toFixed(2); valB.textContent = b.toFixed(2);
    for (let k = 0; k < 4; k++) {
      const dt = 0.04;
      const dv = v - (v*v*v)/3 - w + I;
      const dw = eps * (v + a - b * w);
      v += dv * dt; w += dw * dt;
    }
    trail.push([v, w]);
    if (trail.length > 260) trail.shift();

    const dark = document.documentElement.classList.contains('dark');
    const bg = dark ? '#000' : '#fff', ink = dark ? '#fff' : '#000';
    const pink = '#ff0a94', blue = dark ? '#4da3ff' : '#1a73e8';
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const W = canvas.width / dpr, H = canvas.height / dpr;

    ctx.setTransform(1,0,0,1,0,0); ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.fillStyle = bg; ctx.fillRect(0,0,canvas.width,canvas.height);
    ctx.scale(dpr, dpr);

    // Left 62%: phase plane (v,w); Right 38%: live spike waveform v(t)
    const pw = W * 0.60, ox = pw * 0.5, oy = H * 0.52;
    const sx = pw / 6.2, sy = H / 4.2;
    const toX = x => ox + x * sx, toY = y => oy - y * sy;

    // Axes
    ctx.strokeStyle = dark ? 'rgba(255,255,255,0.16)' : 'rgba(0,0,0,0.15)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(16, oy); ctx.lineTo(pw - 12, oy); ctx.moveTo(ox, 16); ctx.lineTo(ox, H - 16); ctx.stroke();

    // Certified SOS Trapping Ellipse (v^2 + (w/eps)^2 <= R^2 scaled visually)
    ctx.save();
    ctx.setLineDash([5, 4]);
    ctx.strokeStyle = pink; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.ellipse(ox, oy - 0.15 * sy, 2.55 * sx, 1.55 * sy, 0, 0, Math.PI * 2); ctx.stroke();
    ctx.restore();

    // Cubic nullcline w = v - v^3/3 + I (Gemini blue)
    ctx.strokeStyle = blue; ctx.lineWidth = 1.4; ctx.beginPath();
    for (let x = -2.6; x <= 2.6; x += 0.05) {
      const y = x - (x*x*x)/3 + I;
      if (x === -2.6) ctx.moveTo(toX(x), toY(y)); else ctx.lineTo(toX(x), toY(y));
    }
    ctx.stroke();

    // Linear nullcline w = (v + a)/b
    ctx.strokeStyle = dark ? 'rgba(255,255,255,0.45)' : 'rgba(0,0,0,0.45)';
    ctx.lineWidth = 1.2; ctx.beginPath();
    ctx.moveTo(toX(-2.5), toY((-2.5 + a)/b)); ctx.lineTo(toX(2.5), toY((2.5 + a)/b)); ctx.stroke();

    // Trajectory
    if (trail.length > 1) {
      ctx.strokeStyle = pink; ctx.lineWidth = 2; ctx.beginPath();
      trail.forEach((p, idx) => { const x = toX(p[0]), y = toY(p[1]); if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y); });
      ctx.stroke();
    }
    ctx.beginPath(); ctx.arc(toX(v), toY(w), 5, 0, Math.PI * 2); ctx.fillStyle = pink; ctx.fill();

    // Labels
    ctx.font = '600 11px ui-monospace, Menlo, monospace';
    ctx.fillStyle = ink; ctx.fillText('Phase Plane (v, w)', 16, 20);
    ctx.fillStyle = pink; ctx.fillText('SOS Trapping Set', 16, H - 14);
    ctx.fillStyle = blue; ctx.fillText('dv/dt = 0', pw - 74, 20);

    // Right panel: v(t) spike train
    const rx0 = pw + 18, rw = W - rx0 - 16;
    ctx.strokeStyle = dark ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.2)';
    ctx.beginPath(); ctx.moveTo(rx0 - 8, 14); ctx.lineTo(rx0 - 8, H - 14); ctx.stroke();
    ctx.fillStyle = ink; ctx.fillText('Membrane Potential v(t)', rx0, 20);
    if (trail.length > 1) {
      ctx.strokeStyle = pink; ctx.lineWidth = 1.8; ctx.beginPath();
      trail.forEach((p, i) => {
        const tx = rx0 + (i / 260) * rw;
        const ty = H * 0.54 - (p[0] / 2.6) * (H * 0.34);
        if (i === 0) ctx.moveTo(tx, ty); else ctx.lineTo(tx, ty);
      });
      ctx.stroke();
    }
    const Venergy = (0.5 * v * v + 0.5 * w * w).toFixed(2);
    statusEl.textContent = `v=${v.toFixed(2)}  w=${w.toFixed(2)}  V=${Venergy}  (trapped inside certified SOS envelope)`;
    requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
})();

