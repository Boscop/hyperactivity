(function() {
  const stage = document.getElementById('tlStage');
  const canvas = document.getElementById('tlCanvas');
  const ctx = canvas.getContext('2d');
  const slEb = document.getElementById('tlEb'), slEc = document.getElementById('tlEc'), slGm = document.getElementById('tlGm');
  const vEb = document.getElementById('tlEbV'), vEc = document.getElementById('tlEcV'), vGm = document.getElementById('tlGmV');
  const st = document.getElementById('tlStatus');

  let eB = 1.2, eC = -0.8, hist = [], t = 0;
  function resize() {
    const r = stage.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.floor(r.width * dpr));
    canvas.height = Math.max(1, Math.floor(r.height * dpr));
  }
  new ResizeObserver(resize).observe(stage); resize();
  document.getElementById('tlKick').onclick = () => { eB = 1.4; eC = 1.1; hist = []; };

  function step() {
    t += 0.04;
    const eb = parseFloat(slEb.value), ec = parseFloat(slEc.value), gm = parseFloat(slGm.value);
    vEb.textContent = eb.toFixed(2); vEc.textContent = ec.toFixed(2); vGm.textContent = gm.toFixed(2);
    const delta = eb * ec - gm * gm;
    const dt = 0.03;
    const deB = -eb * eB + gm * eC;
    const deC = gm * eB - ec * eC;
    eB = Math.max(-4, Math.min(4, eB + deB * dt));
    eC = Math.max(-4, Math.min(4, eC + deC * dt));
    if (Math.hypot(eB, eC) < 0.04 && delta > 0) { eB = 1.2; eC = -0.8; }
    const V = 0.5 * (eB * eB + eC * eC);
    hist.push(V);
    if (hist.length > 220) hist.shift();

    const dark = document.documentElement.classList.contains('dark');
    const bg = dark ? '#000' : '#fff', ink = dark ? '#fff' : '#000';
    const pink = '#ff0a94', blue = dark ? '#4da3ff' : '#1a73e8';
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const W = canvas.width / dpr, H = canvas.height / dpr;

    ctx.setTransform(1,0,0,1,0,0); ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.fillStyle = bg; ctx.fillRect(0,0,canvas.width,canvas.height);
    ctx.scale(dpr, dpr);

    // Left 54%: 2-Node Interaction Network (Brain B <-> Co-Processor C)
    const nw = W * 0.54, cy = H * 0.52;
    const bx = nw * 0.28, cx = nw * 0.72;
    const stable = delta > 0;

    // Cross-coupling arcs (gamma)
    ctx.strokeStyle = stable ? blue : pink; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(bx + 32, cy - 14); ctx.quadraticCurveTo(nw * 0.5, cy - 68, cx - 32, cy - 14); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(cx - 32, cy + 14); ctx.quadraticCurveTo(nw * 0.5, cy + 68, bx + 32, cy + 14); ctx.stroke();

    // Animated signal pulses along active pair
    const u = (t * 0.6) % 1;
    const p1x = (1-u)*(1-u)*(bx+32) + 2*(1-u)*u*(nw*0.5) + u*u*(cx-32);
    const p1y = (1-u)*(1-u)*(cy-14) + 2*(1-u)*u*(cy-68) + u*u*(cy-14);
    ctx.beginPath(); ctx.arc(p1x, p1y, 4, 0, Math.PI*2); ctx.fillStyle = pink; ctx.fill();
    const p2x = (1-u)*(1-u)*(cx-32) + 2*(1-u)*u*(nw*0.5) + u*u*(bx+32);
    const p2y = (1-u)*(1-u)*(cy+14) + 2*(1-u)*u*(cy+68) + u*u*(cy+14);
    ctx.beginPath(); ctx.arc(p2x, p2y, 4, 0, Math.PI*2); ctx.fillStyle = blue; ctx.fill();

    // Brain node
    ctx.beginPath(); ctx.arc(bx, cy, 34, 0, Math.PI*2);
    ctx.fillStyle = bg; ctx.fill(); ctx.strokeStyle = pink; ctx.lineWidth = 2.5; ctx.stroke();
    ctx.font = '700 12px ui-monospace, Menlo, monospace'; ctx.textAlign = 'center'; ctx.fillStyle = ink;
    ctx.fillText('BRAIN (B)', bx, cy - 4);
    ctx.fillStyle = pink; ctx.fillText(`e=${eB.toFixed(2)}`, bx, cy + 12);

    // Co-Processor node
    ctx.beginPath(); ctx.arc(cx, cy, 34, 0, Math.PI*2);
    ctx.fillStyle = bg; ctx.fill(); ctx.strokeStyle = blue; ctx.lineWidth = 2.5; ctx.stroke();
    ctx.fillStyle = ink; ctx.fillText('COPROC (C)', cx, cy - 4);
    ctx.fillStyle = blue; ctx.fillText(`e=${eC.toFixed(2)}`, cx, cy + 12);

    ctx.textAlign = 'left'; ctx.fillStyle = ink;
    ctx.fillText(`-η_B = -${eb.toFixed(2)}`, bx - 36, cy + 54);
    ctx.fillText(`-η_C = -${ec.toFixed(2)}`, cx - 36, cy + 54);
    ctx.fillStyle = stable ? blue : pink;
    ctx.fillText(`γ = ${gm.toFixed(2)}`, nw * 0.5 - 24, cy - 52);

    // Right 46%: Lyapunov energy V(t)
    const rx0 = nw + 18, rw = W - rx0 - 16;
    ctx.strokeStyle = dark ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.2)'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(rx0 - 8, 14); ctx.lineTo(rx0 - 8, H - 14); ctx.stroke();
    ctx.fillStyle = ink; ctx.fillText('Lyapunov Energy V(t) = ½(e_B² + e_C²)', rx0, 20);
    if (hist.length > 1) {
      const vmax = Math.max(2.0, ...hist);
      ctx.strokeStyle = stable ? pink : blue; ctx.lineWidth = 2; ctx.beginPath();
      hist.forEach((val, i) => {
        const x = rx0 + (i / 220) * rw;
        const y = H - 24 - (val / vmax) * (H - 64);
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke();
    }
    st.textContent = `Δ = η_B·η_C − γ² = ${delta >= 0 ? '+' : ''}${delta.toFixed(2)} · ${stable ? 'SOS CERTIFIED STABLE (dV/dt < 0)' : 'UNSTABLE DIVERGENCE (Δ ≤ 0)'}`;
    st.style.color = stable ? pink : blue;
    requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
})();
</script>
</body>
</html>
