-- the member f of the object at p ([expr.ref]): a bit-field, a reference member's referent,
-- or the member subobject
cx-field-lv : CxU → CRecord → CField → MPtr → Word → CxEv CxR
cx-field-lv u r f p al = case cx-fld-width f of
  cbw-bits w → cx-bind {MPtr} {CxR} (cx-sub p (wquot (cx-fld-bits f) #8)) (λ q → cx-ret {CxR} (cxr-bf q (wrem (cx-fld-bits f) #8) w))
  cbw-none → cx-bind {MPtr} {CxR} (cx-sub p (wquot (cx-fld-bits f) #8)) (λ q → case cx-tc (cx-fld-type f) of
    cxtc-ref t → cx-bind-lv u (cxb-ref q)
    _ → cx-bind {Word} {CxR} (cx-res {Word} (cx-fld-al u r f al)) (λ a → cx-ret {CxR} (cxr-lv q a)))
