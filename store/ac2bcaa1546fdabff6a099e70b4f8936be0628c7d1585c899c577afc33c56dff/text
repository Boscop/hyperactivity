-- wm_low_32: from physical_memory.sail (it calls what is defined after it there)
-- (part of language-support)
wm_low_32 : (addr : Bits #52) → (sailval : Bits #32) → MS Unit
wm_low_32 addr sailval =
  bindS {Bool} {Unit} (getS {Bool} x86-app_view) (λ app_view'1 →
    onS {Unit} {Unit} (fl-assert {exception} (b-not app_view'1) #10766557306235811165391993617916461646257293381573685814) (λ _ →
      let addr : ZI
          addr = (bv-unsigned #52 addr)
          byte0 : Bits #8
          byte0 = (bv-slice #32 sailval #7 #0)
          byte1 : Bits #8
          byte1 = (bv-slice #32 sailval #15 #8)
          byte2 : Bits #8
          byte2 = (bv-slice #32 sailval #23 #16)
          byte3 : Bits #8
          byte3 = (bv-slice #32 sailval #31 #24)
      in bindS {Unit} {Unit} (bang_memi #64 (bits_of_int addr (zpos #64)) byte0) (λ t'3 →
           bindS {Unit} {Unit} (bang_memi #64 (bits_of_int (z-add (zpos #1) addr) (zpos #64)) byte1) (λ t'4 →
             bindS {Unit} {Unit} (bang_memi #64 (bits_of_int (z-add (zpos #2) addr) (zpos #64)) byte2) (λ t'5 →
               bang_memi #64 (bits_of_int (z-add (zpos #3) addr) (zpos #64)) byte3)))))
