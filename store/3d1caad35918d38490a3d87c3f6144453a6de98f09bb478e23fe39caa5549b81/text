-- cs-compile-by-prints-eq: for every field-count table nf_of and every Code construct (all 62
-- constructors, including ccase, cwelim, capp, cglob, ccon, cpair, cfst, csnd, clet, cwop),
-- cs-print of cs-compile-by produces the exact C byte sequence of cs-exp-by
cs-compile-by-prints-eq : (nf_of : Word → Word → Word) (k : Nat) (ars : Lst (Word × Word)) (d : Word) (c : Code) (acc : List Word) →
  cs-print (cs-compile-by nf_of k ars d c) acc ≡ cs-exp-by nf_of k ars d c acc
cs-compile-by-prints-eq nf_of zero ars d c acc = refl
cs-compile-by-prints-eq nf_of (suc k) ars d (cvar n) acc = refl
cs-compile-by-prints-eq nf_of (suc k) ars d (cwlit n) acc = refl
cs-compile-by-prints-eq nf_of (suc k) ars d (cwsucc a) acc =
  cong (list-append "hy_add(") (cs-compile-by-prints-eq nf_of k ars d a (list-append ", 1ull)" acc))
cs-compile-by-prints-eq nf_of (suc k) ars d (cwop j a b) acc =
  cong (λ z → list-append (ce-opname j) (list-append "(" z))
    (cs-compile-by-prints-eq nf_of k ars d a (list-append ", " (cs-print (cs-compile-by nf_of k ars d b) (list-append ")" acc)))
     ∙ cong (cs-exp-by nf_of k ars d a) (cong (list-append ", ") (cs-compile-by-prints-eq nf_of k ars d b (list-append ")" acc))))
cs-compile-by-prints-eq nf_of (suc k) ars d (clet t b) acc =
  cong (λ z → list-append "({ uint64_t v" (list-append (ce-dec d) (list-append " = " z)))
    (cs-compile-by-prints-eq nf_of k ars d t (list-append "; " (cs-print (cs-compile-by nf_of k ars (%wsucc d) b) (list-append "; })" acc)))
     ∙ cong (cs-exp-by nf_of k ars d t) (cong (list-append "; ") (cs-compile-by-prints-eq nf_of k ars (%wsucc d) b (list-append "; })" acc))))
cs-compile-by-prints-eq nf_of (suc k) ars d (capp f a) acc =
  cs-print-apply-eq ars (λ x → cs-compile-by nf_of k ars d x) (λ x tl → cs-exp-by nf_of k ars d x tl)
    (λ x tl → cs-compile-by-prints-eq nf_of k ars d x tl)
    (fst (x-spine (capp f a))) (snd (x-spine (capp f a))) acc
cs-compile-by-prints-eq nf_of (suc k) ars d (cglob g) acc =
  cs-print-gcall-eq (λ x → cs-compile-by nf_of k ars d x) (λ x tl → cs-exp-by nf_of k ars d x tl)
    (λ x tl → cs-compile-by-prints-eq nf_of k ars d x tl)
    g (x-look ars g) #0 lnil acc
cs-compile-by-prints-eq nf_of (suc k) ars d (cpair a b) acc =
  cong (list-append "hy_con(0, 2, (uint64_t[]){0, ")
    (cs-compile-by-prints-eq nf_of k ars d a (list-append ", " (cs-print (cs-compile-by nf_of k ars d b) (list-append "})" acc)))
     ∙ cong (cs-exp-by nf_of k ars d a) (cong (list-append ", ") (cs-compile-by-prints-eq nf_of k ars d b (list-append "})" acc))))
cs-compile-by-prints-eq nf_of (suc k) ars d (cfst p) acc =
  cong (list-append "((uint64_t *)") (cs-compile-by-prints-eq nf_of k ars d p (list-append ")[1]" acc))
cs-compile-by-prints-eq nf_of (suc k) ars d (csnd p) acc =
  cong (list-append "((uint64_t *)") (cs-compile-by-prints-eq nf_of k ars d p (list-append ")[2]" acc))
cs-compile-by-prints-eq nf_of (suc k) ars d (ccon dd j fs lnil) acc =
  cong (λ z → list-append "hy_con(" (list-append (ce-dec j) (list-append ", " (list-append (ce-dec (l-count fs)) (list-append ", (uint64_t[]){0" z)))))
    (cs-print-args-eq (λ x → cs-compile-by nf_of k ars d x) (λ x tl → cs-exp-by nf_of k ars d x tl)
      (λ x tl → cs-compile-by-prints-eq nf_of k ars d x tl) fs false (list-append "})" acc))
cs-compile-by-prints-eq nf_of (suc k) ars d (ccon dd j fs (lcons d0 dr)) acc = refl
cs-compile-by-prints-eq nf_of (suc k) ars d (ccase dd B x) acc =
  let tail = cs-switch-tail d acc
      brs_c = cs-print (cs-comp-brs-by nf_of B (λ e c → cs-compile-by nf_of k ars e c) dd d #0) tail
      eq_brs = cs-print-brs-eq nf_of B (λ e c → cs-compile-by nf_of k ars e c) (λ e c tl → cs-exp-by nf_of k ars e c tl)
                 (λ e c tl → cs-compile-by-prints-eq nf_of k ars e c tl) dd d #0 tail
  in cong (cs-switch-pre d)
       (cs-compile-by-prints-eq nf_of k ars d x (cs-switch-mid d brs_c)
        ∙ cong (cs-exp-by nf_of k ars d x) (cong (cs-switch-mid d) eq_brs))
cs-compile-by-prints-eq nf_of (suc k) ars d (cwelim w z s mo) acc =
  cs-prints-welim nf_of k ars d w z s mo acc (λ e c tl → cs-compile-by-prints-eq nf_of k ars e c tl)
cs-compile-by-prints-eq nf_of (suc k) ars d (clam b) acc = refl
