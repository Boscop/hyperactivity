-- (part of language-support)
floor2 : (i' : ZI) → (j' : ZI) → ZI
floor2 i' j' =
  let tdiv : ZI
      tdiv = (z-tdiv i' j')
      tmod : ZI
      tmod = (z-tmod i' j')
      t'1 : ZI
      t'1 =
        if (b-or (b-and (z-lt (zpos #0) j') (z-le (zpos #0) tmod)) (b-and (z-lt j' (zpos #0)) (z-le tmod (zpos #0)))) then
          tdiv
        else
          (z-sub tdiv (zpos #1))
  in t'1
