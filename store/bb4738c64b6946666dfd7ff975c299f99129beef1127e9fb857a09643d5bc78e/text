-- and its soundness: where the alignment identifies both ends, the verdict is the template's
transport-pairs-sound : (X : Type 0) → (Y : Type 0) → (al : X → Al Y) → (t : Y → Y → Bool) → (x : X) → (x' : X) → (y : Y) → (y' : Y) → al x ≡ al-at y → al x' ≡ al-at y' → transport-pairs X Y al t x x' ≡ bool-tri (t y y')
transport-pairs-sound X Y al t x x' y y' p q = λ i → tri-of Y t (p i) (q i)
