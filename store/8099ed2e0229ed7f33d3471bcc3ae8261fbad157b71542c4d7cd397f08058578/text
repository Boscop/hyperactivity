rfl-path : (a : TyShape) → RRT a → RflT (s-path a)
rfl-path a Ra Δ X ct c n =
  (ct , λ Δ' w f cf nc →
     snd (snd Ra) Δ' (papp-mean Δ' a f (wact Δ' Δ w (TV (s-path a)) X))
       (jc-tr j-ty a Δ' (papp-line Δ' (Sem (s-path a)) (Sem a) (ty-line a) f (wact Δ' Δ w (Sem (s-path a)) (fmapM Δ (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) X)))
          (fmapM Δ' (TV a) (Sem a) (λ q → fst q) (papp-mean Δ' a f (wact Δ' Δ w (TV (s-path a)) X)))
          (rfl-path-ty a Δ' f (wact Δ' Δ w (TV (s-path a)) X) (wact Δ' Δ w (Sem (s-path a)) (fmapM Δ (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) X))
             (subM-fmap Δ' Δ (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) (world-sub Δ' Δ w) X))
          (fst ct Δ' w f cf nc))
       (cpapp (fst (ren-ne {(j-tm , Δ , s-path a , c , X)} n Δ' w)) (dnf-code f))
       (npapp Δ' a (wact Δ' Δ w (TV (s-path a)) X) (fst (ren-ne {(j-tm , Δ , s-path a , c , X)} n Δ' w)) f cf nc (papp-mean Δ' a f (wact Δ' Δ w (TV (s-path a)) X))
          (λ i → papp-mean Δ' a f (wact Δ' Δ w (TV (s-path a)) X)) (snd (ren-ne {(j-tm , Δ , s-path a , c , X)} n Δ' w))))
