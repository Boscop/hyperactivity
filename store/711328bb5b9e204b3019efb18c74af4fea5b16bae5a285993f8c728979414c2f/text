-- Stream lifting over sample pairs (low-pass coarse band + high-pass detail band)
haar-lift-list : List Word → List Word × List Word
haar-lift-list nil = (nil , nil)
haar-lift-list (cons a nil) = (cons (w32 a) nil , nil)
haar-lift-list (cons a (cons b r)) =
  let p   = haar-lift-pair (a , b)
      res = haar-lift-list r
  in (cons (fst p) (fst res) , cons (snd p) (snd res))
