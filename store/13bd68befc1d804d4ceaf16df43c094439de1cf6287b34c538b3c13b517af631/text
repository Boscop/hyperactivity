gds-decode-library : Nat → List Word → Sum Unit (List Rect)
gds-decode-library nCells s0 =
  bind-res (expect-w #6 s0) (λ s1 →
  bind-res (expect-w gds-rec-header s1) (λ s2 →
  bind-res (expect-w #600 s2) (λ s3 →
  bind-res (expect-w #4 s3) (λ s4 →
  bind-res (expect-w gds-rec-bgnlib s4) (λ s5 →
  bind-res (expect-w #4 s5) (λ s6 →
  bind-res (expect-w gds-rec-bgnstr s6) (λ body →
    gds-decode-body nCells body)))))))
