-- Exact 1-bit evaluator on (a, b, c, d : Word in {0,1})
ms-eval1-go : List Word → List (Word × Word) → Word
ms-eval1-go ws nil = ms-last ws
ms-eval1-go ws (cons g gs) =
  let va = ms-nth (fst g) ws
      vb = ms-nth (snd g) ws
      vo = %wxor (%wand va vb) #1
  in ms-eval1-go (ms-append1 ws vo) gs
