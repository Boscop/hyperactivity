-- a permutation: every suffix with its point exactly as often as in the text
suffix-array-permutation : (t : List (List Word)) → (a : El entry-ord) → count {entry-ord} a (suffix-array t) ≡ count {entry-ord} a (entries t #0)
suffix-array-permutation t a = msort-fuel-count {entry-ord} a (list-length (entries t #0)) (entries t #0)
