-- ============================================================================
-- SECTION 3: EXECUTABLE PURE .hypercubical COLLABORATION LOOP (Proc W)
-- ============================================================================

am-signal-url : List Word → List Word
am-signal-url id = h-concat (cons "https://hyperactivity.ai/api/p2p/signal?id=" (cons id nil))

am-pulse-url : List Word → List Word
am-pulse-url id = h-concat (cons "https://hyperactivity.ai/api/live/pulse?id=" (cons id (cons "&node=/supercomputer:pure_cubical" nil)))

am-curl-post-args : List Word → List Word → List (List Word)
am-curl-post-args url file =
  cons "/usr/bin/env" (cons "curl" (cons "-sS" (cons "--max-time" (cons "10" (cons "-X" (cons "POST"
    (cons "-H" (cons "Content-Type: application/json"
    (cons "--data-binary" (cons (list-append "@" file) (cons url nil)))))))))))

am-curl-get-args : List Word → List (List Word)
am-curl-get-args url =
  cons "/usr/bin/env" (cons "curl" (cons "-sS" (cons "--max-time" (cons "6" (cons url nil)))))

-- One pure-Hypercubical collaboration tick: serialize AgentCard -> write local bus -> POST global rendezvous -> record live peers -> pulse
am-tick : AgentCard → Proc W (List Word)
am-tick card =
  bind time-now (λ now →
  let payload  = am-emit-card card now
      cardPath = the (List Word) "/tmp/hx_agent_bus/agent_7b923ddb.json"
      peerPath = the (List Word) "/tmp/hx_agent_bus/peers_cubical.json"
  in bind (h-mkdir "/tmp/hx_agent_bus") (λ u0 →
     bind (h-write cardPath payload) (λ w1 →
     bind (h-capture (am-curl-post-args (am-signal-url (am-id card)) cardPath)) (λ rx →
     bind (h-write peerPath (snd rx)) (λ w2 →
     bind (h-capture (am-curl-get-args (am-pulse-url (am-id card)))) (λ pu →
     ret {lzero} {W} (snd rx)))))))

-- Bounded continuous collaboration loop (runs natively in ./build/cubical!)
am-loop : Nat → Word → AgentCard → Proc W Unit
am-loop zero ns card = ret {lzero} {W} unit
am-loop (suc k) ns card =
  bind (am-tick card) (λ rx →
  bind (sleep ns) (λ u →
  am-loop k ns card))

am-once-step : Step W (List Word)
am-once-step = to-step (am-tick am-self-card)
