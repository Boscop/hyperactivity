-- every value of an exact chain positive
posalong : (Et : Nat → ZQ → Nat → ZQ) → (st : IE) → List Bool → (n : Nat) → (tv rv : ZQ) → echain Et st n tv rv → Type
posalong Et st S n = case n return λ w → (tv rv : ZQ) → echain Et st w tv rv → Type of
  zero → λ tv rv ch → Unit
  suc g → λ tv rv ch → zposq S (fst ch) × rec g (fst ch) rv (snd (snd ch))
