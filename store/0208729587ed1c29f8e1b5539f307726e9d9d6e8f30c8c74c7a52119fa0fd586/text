pf→codec : {A : Type} → PFCodec A → Codec A (List Word)
pf→codec {A} c =
  iso→codec (pf-enc c) (λ bs → fst (pf-dec c bs))
    (λ a → concat {lzero} {A} {fst (pf-dec c (pf-enc c a))} {fst (pf-dec c (list-append (pf-enc c a) nil))} {a}
             (cong {lzero} {lzero} {List Word} {A} (λ bs → fst (pf-dec c bs)) (sym (cm-append-nil (pf-enc c a))))
             (cong {lzero} {lzero} {A × List Word} {A} (λ p → fst p) (pf-ok c a nil)))
