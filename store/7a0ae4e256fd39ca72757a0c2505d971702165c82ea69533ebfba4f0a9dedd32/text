e-pieces : List Word → List Word → Proc W (List (List Word))
e-pieces dir file = bind (e-cmd (cons "split" (cons "-b" (cons "65536" (cons "-a" (cons "6" (cons "-d" (cons file (cons (list-append dir "/p-") nil))))))))) (λ s →
  bind (h-list dir) (λ fs → ret (list-map (λ f → list-append dir (list-append "/" f)) (h-msort (e-filter (λ f → h-prefix "p-" f) fs)))))
