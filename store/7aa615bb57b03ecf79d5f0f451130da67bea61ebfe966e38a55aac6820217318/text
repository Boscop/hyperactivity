nested-args d pvs d2 pc ps j =
  case ps of
    lnil → true
    lcons q rest →
      andb (if cany (is-data-d d) q
              then andb (positive d pvs q) (case lnth (fst pc) j of some v → lall (tel-pos-var d2 (fst pc) v) (snd pc); none → false)
              else true)
           (nested-args d pvs d2 pc rest (%wsucc j))
