std-bwd-from-tape : List Word → List RevPair → RevPair → GradOut
std-bwd-from-tape nil _ g = gout nil g
std-bwd-from-tape (cons _ _) nil g = gout nil g
std-bwd-from-tape (cons w ws) (cons rp tape) gAfter =
  case rp of
    rpair u v →
      case std-bwd-from-tape ws tape gAfter of
        gout dws gNext →
          case gNext of
            rpair gy1 gy2 →
              gout (cons (%wmul v gy2) dws) (rpair gy2 (%wadd gy1 (%wmul w gy2)))
