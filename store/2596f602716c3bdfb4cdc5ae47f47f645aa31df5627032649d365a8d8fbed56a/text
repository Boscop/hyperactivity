sc-le-add-mono : (a b c d : Nat) → hm-le a b ≡ true → hm-le c d ≡ true → hm-le (hm-add a c) (hm-add b d) ≡ true
sc-le-add-mono zero    b c d _   hcd = hm-le-trans c d (hm-add b d) hcd (hm-le-add-l b d)
sc-le-add-mono (suc _) zero _ _ hab _ = Empty-rec (true≢false (web-sym-b hab))
sc-le-add-mono (suc a) (suc b) c d hab hcd = sc-le-add-mono a b c d hab hcd
