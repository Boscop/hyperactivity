-- Out-of-Order Parallel WAW Commutation Theorem: two instructions writing the SAME architectural
-- register `rd` at distinct rename epochs `e1 ≠ e2` commute in physical register execution!
waw-branch : (rd : Word) → (v1 v2 : Nat) → (prf : PRF) → (q : PhysTag) →
  (b1 b2 : Bool) → (andB b1 b2 ≡ false) →
  (if b1 then v1 else (if b2 then v2 else prf q)) ≡
  (if b2 then v2 else (if b1 then v1 else prf q))
waw-branch rd v1 v2 prf q false false _ = λ _ → prf q
waw-branch rd v1 v2 prf q false true  _ = λ _ → v2
waw-branch rd v1 v2 prf q true  false _ = λ _ → v1
waw-branch rd v1 v2 prf q true  true  h =
  Empty-rec {lzero} {v1 ≡ v2} (false≢true (sym h))
