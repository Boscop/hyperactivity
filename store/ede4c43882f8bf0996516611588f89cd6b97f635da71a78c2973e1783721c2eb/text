zpos-or-np-at : (X : Nat × Nat) → (G : Type) → (zpos X → G) → (zle X (the (Nat × Nat) (zero , zero)) → G) → (b : Bool) → cmpN true (suc (snd X)) (fst X) ≡ b → G
zpos-or-np-at X G f g b = case b return λ u → cmpN true (suc (snd X)) (fst X) ≡ u → G of
  true → λ h → f (le-cong-r (suc (snd X)) (fst X) (plus (fst X) zero) (cmp-true-le (suc (snd X)) (fst X) h) (symN (plus-zero (fst X))))
  false → λ h → g (le-cong-r (plus (fst X) zero) (snd X) (snd X) (le-pred-both (plus (fst X) zero) (snd X) (transport (λ i → le (suc (plus-zero (fst X) (~ i))) (suc (snd X))) (cmp-false-lt (suc (snd X)) (fst X) h))) (λ i → snd X))
