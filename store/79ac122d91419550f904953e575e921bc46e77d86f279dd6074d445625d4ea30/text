cm-ltw-suc-le : (x p : Word) → ltw x p ≡ true → ltw p (%wsucc x) ≡ false
cm-ltw-suc-le x =
  %welimP (λ v → (p : Word) → ltw v p ≡ true → ltw p (%wsucc v) ≡ false) x
    (λ p → %welimP (λ v → ltw #0 v ≡ true → ltw v #1 ≡ false) p
             (λ h → cm-ft-absurd h)
             (λ p1 gp h → %welimP (λ u → ltw u #0 ≡ false) p1 (λ i → false) (λ k gk i → false)))
    (λ x1 ih → cm-lt-suc-le-step x1 ih)
