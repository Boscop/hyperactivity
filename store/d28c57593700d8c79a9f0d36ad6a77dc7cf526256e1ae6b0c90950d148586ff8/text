-- the build: every public page made and kept (the paper's page, the front page, every published work
-- and its search item, the paper's search item, the synesthesia page), one after another, and the state of the source they were made for recorded
-- (STORE/site-stamp), which the public server reads them under (s-kept-public); then the machine stops
-- (the file's arguments after it are not files to read)
s-make-site : List Word → List Word → Proc W Unit
s-make-site st m = bind (s-paper st m) (λ p → bind (s-site-all st s-published) (λ u → bind (s-corpus-kept-one st "/paper") (λ c → bind (s-site-kept st "synesthesia" (ret {lzero} {W} (sy-answer nil))) (λ y → bind (h-read (list-append st "/index/meta/stamp")) (λ s → bind (h-write (list-append st "/site-stamp") (s-or nil s)) (λ w → if w then exit #0 else exit #1))))))
