-- (part of language-support)
read_sptr : (proc_mode' : proc_mode) → MS (Bits #64)
read_sptr proc_mode' =
  bindS {Bits #64} {Bits #64} (rgfi (zpos #4)) (λ sptr →
    λ σ →
      if (in_64bit_mode proc_mode') then
        the (MS (Bits #64))
          (retS {Bits #64} sptr) σ
      else if (in_compatibility_mode proc_mode') then
        the (MS (Bits #64))
          (bindS {List (Bits #16)} {Bits #64} (getS {List (Bits #16)} x86-seg_hidden_attrs) (λ seg_hidden_attrs'2 →
             let ss_attr : Bits #16
                 ss_attr = (vec-get {Bits #16} #0 seg_hidden_attrs'2 #2)
                 ss_b : Bits #1
                 ss_b = (data_segment_descriptor_attributesbits-d_b ss_attr)
                 t'3 : Bits #64
                 t'3 =
                   if (weq ss_b #1) then
                     (bv-zext #32 #64 (bv-trunc #64 #32 sptr))
                   else
                     (bv-zext #32 #64 (bv-zext #16 #32 (bv-trunc #64 #16 sptr)))
             in retS {Bits #64} t'3)) σ
      else
        the (MS (Bits #64))
          (retS {Bits #64} #0) σ)
