hy-working-after : List Word → List Word → Nat → List (List Word) → HyState → Proc W Unit
hy-working-after st m n a (hy-reading f) = hy-finish st m f
hy-working-after st m n a (hy-walking k) = if h-has (hy-head a) (cons "next" (cons "prev" nil)) then hy-show st m n hy-working else hy-act st m a
hy-working-after st m n a hy-working = if h-has (hy-head a) (cons "next" (cons "prev" nil)) then hy-show st m n hy-working else hy-act st m a
hy-working-after st m n a (hy-decomposing f xy) = hy-act st m a
