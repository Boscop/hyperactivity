fi-lo-ok : Bool → IW → Float64 → Bool
fi-lo-ok sg w x = case sg of
  false → f64lt (f64-neg-of #1) x
  true → (case w of
    iw8 → f64lt (f64-neg-of #129) x
    iw16 → f64lt (f64-neg-of #32769) x
    iw32 → f64lt (f64-neg-of #2147483649) x
    _ → m-or (f64lt (f64-neg-of #9223372036854775808) x) (f64eq (f64-neg-of #9223372036854775808) x))
