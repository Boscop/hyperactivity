-- Proves that rippling cir-fa1-net across ANY bit-width N matches exact arithmetic ripple-carry for ALL inputs!
cir-thm-ripple-universal : (as bs : List Bool) → (cin : Bool) → cir-ripple-net cin as bs ≡ cir-ripple-spec cin as bs
cir-thm-ripple-universal nil nil cin = refl
cir-thm-ripple-universal nil (cons _ _) cin = refl
cir-thm-ripple-universal (cons _ _) nil cin = refl
cir-thm-ripple-universal (cons true  as) (cons true  bs) true  = λ i → cons true  (cir-thm-ripple-universal as bs true  i)
cir-thm-ripple-universal (cons true  as) (cons true  bs) false = λ i → cons false (cir-thm-ripple-universal as bs true  i)
cir-thm-ripple-universal (cons true  as) (cons false bs) true  = λ i → cons false (cir-thm-ripple-universal as bs true  i)
cir-thm-ripple-universal (cons true  as) (cons false bs) false = λ i → cons true  (cir-thm-ripple-universal as bs false i)
cir-thm-ripple-universal (cons false as) (cons true  bs) true  = λ i → cons false (cir-thm-ripple-universal as bs true  i)
cir-thm-ripple-universal (cons false as) (cons true  bs) false = λ i → cons true  (cir-thm-ripple-universal as bs false i)
cir-thm-ripple-universal (cons false as) (cons false bs) true  = λ i → cons true  (cir-thm-ripple-universal as bs false i)
cir-thm-ripple-universal (cons false as) (cons false bs) false = λ i → cons false (cir-thm-ripple-universal as bs false i)
