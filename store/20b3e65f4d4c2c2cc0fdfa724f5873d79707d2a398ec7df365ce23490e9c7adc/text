nk-era-env-apart : (e : NkEnv) (fx : NkFx) (u : NkW) → (nk-emem u e ≡ false) → nk-apart u fx → nk-apart u (nk-era-env e fx)
nk-era-env-apart nke-nil fx u hm ap = ap
nk-era-env-apart (nke-cons w r) fx u hm ap =
  let neq = nk-emem-not-eq u w (nke-cons w r) hm (nk-emem-hd w r)
  in (neq , (nk-weq-sym-f u w neq , nk-era-env-apart r fx u (nk-emem-false-tl u w r hm) ap))
