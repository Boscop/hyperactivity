nk-do-upd-ok : (fx : NkFx) (sl : NkSlots) (w : Word) (f : NkSlot → NkSlot) → nk-ok w f fx → nk-same (nk-do fx (nk-upd sl w f)) (nk-upd (nk-do fx sl) w f)
nk-do-upd-ok nkf-nil sl w f ap x = refl
nk-do-upd-ok (nkf-at k d r) sl w f ap x =
  nk-do-same r (nk-upd (nk-upd sl w f) k (nk-ch d)) (nk-upd (nk-upd sl k (nk-ch d)) w f) (nk-upd-swap-ok sl w k f (nk-ch d) (fst ap)) x
  ∙ nk-do-upd-ok r (nk-upd sl k (nk-ch d)) w f (snd ap) x
