zr-nzd : (c a : ZrC) → zr-isz c ≡ false → zr-isz a ≡ false → zr-isz (zr-mu c a) ≡ false
zr-nzd c = case c return λ u → (a : ZrC) → zr-isz u ≡ false → zr-isz a ≡ false → zr-isz (zr-mu u a) ≡ false of
  zrz → λ a hc ha → absurd-tf (zr-isz (zr-mu zrz a) ≡ false) hc
  zrp p → λ a → (case a return λ w → zr-isz (zrp p) ≡ false → zr-isz w ≡ false → zr-isz (zr-mu (zrp p) w) ≡ false of
    zrz → λ hc ha → absurd-tf (zr-isz (zr-mu (zrp p) zrz) ≡ false) ha
    zrp q → λ hc ha → zr-nzpp p q
    zrn q → λ hc ha → zr-nzpn p q)
  zrn p → λ a → (case a return λ w → zr-isz (zrn p) ≡ false → zr-isz w ≡ false → zr-isz (zr-mu (zrn p) w) ≡ false of
    zrz → λ hc ha → absurd-tf (zr-isz (zr-mu (zrn p) zrz) ≡ false) ha
    zrp q → λ hc ha → zr-nznp p q
    zrn q → λ hc ha → zr-nznn p q)
