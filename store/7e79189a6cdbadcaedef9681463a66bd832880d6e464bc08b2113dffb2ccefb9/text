gdiag : (I : Lst Entry → Type 2) (Ln : (sq : Lst Entry) → I sq → I sq) (K : (sq : Lst Entry) → I sq → Type 1)
  (pd : (sq : Lst Entry) → I (lcons e-dim sq) → I sq) (pt : (s : TyShape) (sq : Lst Entry) → I (lcons (e-ty s) sq) → I sq) →
  DgOps I Ln K pd pt → (sk : Lst Entry) (k : Word) (i : I sk) → K sk (Ln sk i) → K sk i
gdiag I Ln K pd pt O lnil k i x = fst O i x
gdiag I Ln K pd pt O (lcons (e-ty s) sk) k i x =
  if weq k #0 then fst (snd O) s sk i x
  else fst (snd (snd (snd O))) s sk i (gdiag I Ln K pd pt O sk (%wsub k #1) (pt s sk i) (fst (snd (snd O)) s sk i x))
gdiag I Ln K pd pt O (lcons e-dim sk) k i x =
  if weq k #0 then fst (snd (snd (snd (snd O)))) sk i x
  else snd (snd (snd (snd (snd (snd O))))) sk i (gdiag I Ln K pd pt O sk (%wsub k #1) (pd sk i) (fst (snd (snd (snd (snd (snd O))))) sk i x))
