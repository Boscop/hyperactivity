-- the value of a canonical binary integer read into the carrier is its value
zr-v1 : (m : List Bool) → (s : Bool) → bcanon m ≡ true → zr-val (zr-ofbz (s , m)) ≡ zv (s , m)
zr-v1 m = case m return λ w → (s : Bool) → bcanon w ≡ true → zr-val (zr-ofbz (s , w)) ≡ zv (s , w) of
  nil → λ s → (case s return λ u → bcanon nil ≡ true → zr-val (zr-ofbz (u , nil)) ≡ zv (u , nil) of
    true → λ h → λ i → (zero , zero)
    false → λ h → λ i → (zero , zero))
  cons b rest → λ s → (case s return λ u → bcanon (cons b rest) ≡ true → zr-val (zr-ofbz (u , cons b rest)) ≡ zv (u , cons b rest) of
    true → λ h → λ i → (bin-to-nat (zr-ob rest b h i) , zero)
    false → λ h → λ i → (zero , bin-to-nat (zr-ob rest b h i)))
