-- STRICT FOUNDRY GRADUATION GATE:
--   A circuit CANNOT graduate to Sky130A / GF180MCU / wafer.space / TSMC N3E until:
--     (1) 100% of multi-cloud shards are exhausted (`done-mask == full-mask` and `full-mask > 0`)
--     (2) Cubical normal-form / equivalence proof holds (`cubical-cert == true`)
--     (3) Physical DRC == 0 AND LVS == 0!
sov-ready-for-foundry : SovTarget → Bool
sov-ready-for-foundry (sov-target _ _ dm fm cert drc lvs) =
  andB (%wlt #0 fm)
  (andB (%weq dm fm)
  (andB cert
  (andB (%weq drc #0) (%weq lvs #0))))
