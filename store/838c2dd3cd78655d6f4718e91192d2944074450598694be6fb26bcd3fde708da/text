factor-lam-auto-ok : (ts : List MTerm) → expand-lam-auto (factor-lam-auto ts) ≡ ts
factor-lam-auto-ok ts =
  case best-lam ts return
    (λ o → expand-lam-auto (case o of none → (none , ts); some ps → (some ps , factor-lam 2 (fst ps) (snd ps) ts)) ≡ ts) of
    none → λ i → ts
    some ps → factor-lam-ok 2 (fst ps) (snd ps) ts
