-- read up to n active entries from dir/<id> into JSON [id,val] pairs
s-live-read : Nat → List Word → List (List Word) → Proc W (List (List Word))
s-live-read zero dir xs = ret {lzero} {W} nil
s-live-read (suc n) dir nil = ret {lzero} {W} nil
s-live-read (suc n) dir (cons id rest) =
  bind (h-read (list-append dir (list-append "/" id))) (λ v →
  bind (s-live-read n dir rest) (λ more →
    if h-null (s-or nil v) then ret {lzero} {W} more
    else ret {lzero} {W} (cons (h-concat (cons "[" (cons (s-cj-str id) (cons "," (cons (s-cj-str (s-or nil v)) (cons "]" nil)))))) more)))
