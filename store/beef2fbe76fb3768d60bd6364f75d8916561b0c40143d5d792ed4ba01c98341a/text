lam-score : List MTerm → List MTerm → List MTerm → Word
lam-score pre suf xs =
  let plen = fromNat (list-length pre)
      slen = fromNat (list-length suf)
      frame = wadd plen slen
      cnt = count-lam-go (list-length xs) 2 pre suf xs
  in if wlt cnt #3 then #0
     else if wlt frame #2 then #0
     else let saved = wmul (wsub cnt #1) (wsub frame #1)
              cost = wadd frame #3
          in if wlt cost saved then wsub saved cost else #0
