-- 2J_z^{(e)} on a vector over the weight-zero monomials of ds: (2k_e − d_e) on z_e^{k_e}
jz-row : Nat → List Nat → Mons → List SQ → List SQ
jz-row e ds ms v = case ms of
  nil → nil
  cons s rest → (case v of nil → nil; cons x vrest → cons (sq-mul (sq-plus (sq-nat (times 2 (exp-at e s))) (sq-neg (sq-nat (exp-at e ds)))) x) (jz-row e ds rest vrest))
