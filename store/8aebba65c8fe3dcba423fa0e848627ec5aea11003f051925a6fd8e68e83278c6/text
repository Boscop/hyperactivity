-- after the run node 1 is at a receive, and after a timeout it is at a command again (#1): the
-- guarded process is unfolded only as far as the run observes it
ping-gsum : NView Word (GNode Word Word) → Word
ping-gsum v = case v of
  v-recv k → (case k r-timeout κ0 of gret a → #0; gcmd c k2 → #1; gtau t → #2)
  _ → #3
