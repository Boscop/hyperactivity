-- ============================================================================
-- 2. Discrete Graph Laplacian → Continuum Schrödinger Kinetic Dispersion
-- ============================================================================
-- On a 1D/3D lattice with rational momentum parameter τ = tan(ka/2),
-- Re(z) = Re(z⁻¹) = (1 - τ²)/(1 + τ²).
-- Clearing (1 + τ²) in the discrete Laplacian eigenvalue 2 - Re(z) - Re(z⁻¹):
--   2(1 + τ²) - (1 - τ²) - (1 - τ²) = 4 τ².
-- Dividing by a²(1 + τ²) gives 4 τ² / (a²(1 + τ²)) = (2/a)² sin²(ka/2) → k² as a → 0!
-- Variable (0): τ.
lqg-lattice-schrod-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-lattice-schrod-poly A ad mu q vs =
  (λ g sub sq →
    let tau = g 0
        q1 = q (fn-q 1 1)
        q2 = q (fn-q 2 1)
        q4 = q (fn-q 4 1)
        den = ad q1 (sq tau)
        reN = sub q1 (sq tau)
        lhs = sub (sub (mu q2 den) reN) reN
        rhs = mu q4 (sq tau)
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
