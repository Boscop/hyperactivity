-- every statement the checker computes, by number, each true exactly when it holds: the term of
-- each is written here once, the statements below name their case, and the native program is
-- compared with the checker on every one (part of machine-in-hyperactive)
nk-case-at : Word → Bool
nk-case-at n =
  if %wlt n #42 then nk-case-core n
  else (if %wlt n #55 then nk-case-ext-ks nk-ks-core n
  else (if %wlt n #63 then nk-case-ext-ks nk-ks-mem n
  else (if %wlt n #65 then nk-case-ext-ks nk-ks-mach n
  else (if %wlt n #67 then nk-case-ext-ks nk-ks-chk n
  else false))))
