-- 1. Pure translation invariance of internal segment distances (9 variables: p, q, T ∈ R³).
se3-trans-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
se3-trans-poly A ad mu q vs =
  (λ g sub sq →
    let px = g 0; py = g 1; pz = g 2
        qx = g 3; qy = g 4; qz = g 5
        tx = g 6; ty = g 7; tz = g 8
        d1 = ad (ad (sq (sub (ad px tx) (ad qx tx)))
                    (sq (sub (ad py ty) (ad qy ty))))
                (sq (sub (ad pz tz) (ad qz tz)))
        d0 = ad (ad (sq (sub px qx)) (sq (sub py qy))) (sq (sub pz qz))
    in (d1 , d0))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
