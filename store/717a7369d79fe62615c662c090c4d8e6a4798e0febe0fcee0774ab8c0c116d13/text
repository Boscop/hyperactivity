v-questions : List Word → List (List Word)
v-questions nil = nil
v-questions (cons x r) =
  if weq x #81 then (if andB (h-prefix "uestion for Avik (" r) (h-infix "):" (h-take (toNat #33) r))
    then cons (v-to-question (h-trim (h-drop "):" (h-drop-to-paren r)))) (v-questions r) else v-questions r)
  else v-questions r
