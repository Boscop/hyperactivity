-- the global-happens-before relation of TSO: program order except plain write to plain read
-- (pairs through an mfence or a locked event stay ordered, since those are nodes and their
-- program-order edges are kept), reads-from across threads, the order on writes, from-read
tso-ghb : TsoN → TsoN → Bool
tso-ghb e1 e2 =
  orB (andB (tso-po e1 e2) (tso-not (tso-wr e1 e2)))
      (orB (andB (tso-rf e1 e2) (tso-not (tso-same-thread e1 e2)))
           (orB (tso-co e1 e2) (tso-fr e1 e2)))
