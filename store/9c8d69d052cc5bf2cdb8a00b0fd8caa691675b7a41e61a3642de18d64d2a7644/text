hh-main : List (List Word) → Step W Word
hh-main args =
  let port = hh-a1 args
      maxr = hh-a2 args
  in scmd (w-file-read-named "store/ROOT/root") (λ rr →
     let rh = hh-trim (snd rr)
     in scmd (w-file-read-named (list-append "store/" (list-append rh "/root"))) (λ rt →
        let rmap = hm-parse (snd rt)
        in scmd (w-sys #41 #2 #1 #0 #0 #0 #0) (λ fd →
           scmd (w-alloc #16) (λ sa →
           cli-poke sa (cli-sa-lo port) (λ _ →
           scmd (w-sys #49 fd sa #16 #0 #0 #0) (λ _ →
           scmd (w-sys #50 fd #128 #0 #0 #0 #0) (λ _ →
           scmd (w-alloc #2048) (λ buf →
           cli-say (list-append "HX-HTTPD native-c11 listening on http://127.0.0.1:" (list-append (ce-dec port) (list-append " root=" rh)))
             (hh-loop (toNat maxr) fd buf rmap)))))))))
