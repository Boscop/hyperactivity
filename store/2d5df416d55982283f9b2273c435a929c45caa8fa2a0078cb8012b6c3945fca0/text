-- an interrupted change put back, a path at a time: its old text recorded again, or, if it held
-- nothing before, the path dropped
hy-put-one : List Word → List Word → Sum Unit (List Word) → Proc W Unit
hy-put-one m path (inl u) = bind (h-unrecord path) (λ w → h-say (h-line (list-append "an interrupted change was put back (a new module dropped): " path)))
hy-put-one m path (inr old) = bind (h-record m path old) (λ w → h-say (h-line (list-append "an interrupted change was put back: " path)))
