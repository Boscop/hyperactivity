-- every integer is ≥ 0 or ≤ 0
zsplit-v : (v : Nat × Nat) → (G : Type) → (zle (zero , zero) v → G) → (zle v (zero , zero) → G) → (b : Bool) → cmpN true (snd v) (fst v) ≡ b → G
zsplit-v v G f g b = case b return λ u → cmpN true (snd v) (fst v) ≡ u → G of
  true → λ e → f (le-cong-r (snd v) (fst v) (plus (fst v) zero) (cmp-true-le (snd v) (fst v) e) (symN (plus-zero (fst v))))
  false → λ e → g (le-cong-l (fst v) (plus (fst v) zero) (snd v) (le-of-lt (fst v) (snd v) (cmp-false-lt (snd v) (fst v) e)) (symN (plus-zero (fst v))))
