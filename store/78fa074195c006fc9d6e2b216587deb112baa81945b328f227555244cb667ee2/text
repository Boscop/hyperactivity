-- a computed corner L1·L2, scaled by q1 q2, is the product of the scaled ends
corner-eq : (L1 L2 : BZ) → (q1 q2 : Nat) → zeq (zsc (zv (bz-mul L1 L2)) (times q1 q2)) (zmul (zsc (zv L1) q1) (zsc (zv L2) q2))
corner-eq L1 L2 q1 q2 = transport (λ i → zeq (zsc (zv (bz-mul L1 L2)) (times q1 q2)) (zmul-zsc2 (zv L1) (zv L2) q1 q2 (~ i)))
  (zeq-zsc (zv (bz-mul L1 L2)) (zmul (zv L1) (zv L2)) (times q1 q2) (bz-mul-sound (fst L1) (snd L1) (fst L2) (snd L2)))
