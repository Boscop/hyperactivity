-- the lowest level of the pencil (H, S) between lo and hi, by halving: each step is certified either way (no level
-- below the middle, or exactly one), and where neither count is certified at this precision the search stops there
dy-find : List (List BQ) → List (List BQ) → Nat → Nat → BQ → BQ → BQ × BQ
dy-find h s k n lo hi = case n of
  zero → (lo , hi)
  suc m → if dy-count 0 k (df-pen (bq-mul (fn-q 1 2) (bq-add lo hi)) h s) then dy-find h s k m (bq-mul (fn-q 1 2) (bq-add lo hi)) hi else (if dy-count 1 k (df-pen (bq-mul (fn-q 1 2) (bq-add lo hi)) h s) then dy-find h s k m lo (bq-mul (fn-q 1 2) (bq-add lo hi)) else (lo , hi))
