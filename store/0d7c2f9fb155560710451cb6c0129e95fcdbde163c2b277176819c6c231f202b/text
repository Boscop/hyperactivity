-- Exact Sommerfeld relativistic energy-squared identity:
-- With E_rel² / (mc²)² = (n_r + γ)² / ((n_r + γ)² + (Zα)²), cross-multiplying gives:
--   ((n_r + γ)² + (Zα)²) - (n_r + γ)² = (Zα)² (relativistic binding defect > 0).
-- Variables (0..2): n_r, γ, zα.
phys-sommerfeld-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
phys-sommerfeld-poly A ad mu q vs =
  (λ g sub sq →
    let nr = g 0; gam = g 1; za = g 2
        s = ad nr gam
        denom = ad (sq s) (sq za)
    in (sub denom (sq s) , sq za))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
