-- (5.4) the let case by the semantic substitution lemma; the others from (5.2) and the hypotheses
lx-D-sound : (e : LetExpr) → (rho : Nat → Nat) → dx-eval (lx-D e) rho ≡ lx-eval e rho
lx-D-sound (lx-var i) rho = λ k → rho i
lx-D-sound (lx-num n) rho = λ k → n
lx-D-sound (lx-plus u v) rho = λ k → plus (lx-D-sound u rho k) (lx-D-sound v rho k)
lx-D-sound (lx-let u v) rho =
  transN {dx-eval (dx-subst (dx-newest (lx-D u)) (lx-D v)) rho} {dx-eval (lx-D v) (λ i → dx-eval (dx-newest (lx-D u) i) rho)} {lx-eval v (lx-ext rho (lx-eval u rho))}
  (dx-subst-eval (dx-newest (lx-D u)) (lx-D v) rho)
  (transN {dx-eval (lx-D v) (λ i → dx-eval (dx-newest (lx-D u) i) rho)} {dx-eval (lx-D v) (lx-ext rho (dx-eval (lx-D u) rho))} {lx-eval v (lx-ext rho (lx-eval u rho))}
  (λ k → dx-eval (lx-D v) (λ i → dx-newest-env (lx-D u) rho i k))
  (transN {dx-eval (lx-D v) (lx-ext rho (dx-eval (lx-D u) rho))} {dx-eval (lx-D v) (lx-ext rho (lx-eval u rho))} {lx-eval v (lx-ext rho (lx-eval u rho))}
  (λ k → dx-eval (lx-D v) (lx-ext rho (lx-D-sound u rho k)))
  (lx-D-sound v (lx-ext rho (lx-eval u rho)))))
