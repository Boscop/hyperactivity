-- Parameterized over ANY cryptographic verifier `ver : pk -> claimHash -> Bool`
-- (Ed25519, ECDSA, ChaCha20-Poly1305, or post-quantum signatures).
wp-satisfies : (Word → Word → Bool) → Word → WarrantPolicy → Bool
wp-satisfies _ _ wp-open = true
wp-satisfies ver claim (wp-key pk) = ver pk claim
wp-satisfies ver claim (wp-and a b) = andB (wp-satisfies ver claim a) (wp-satisfies ver claim b)
wp-satisfies ver claim (wp-or a b) = orB (wp-satisfies ver claim a) (wp-satisfies ver claim b)
wp-satisfies ver claim (wp-deleg issuer delegate scope) =
  andB (ver issuer (%wxor delegate scope)) (ver delegate claim)
