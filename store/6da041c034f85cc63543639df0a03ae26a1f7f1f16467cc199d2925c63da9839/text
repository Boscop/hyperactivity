-- strict public allowlist for Web Knowledge Graph: ONLY checked formal .cub modules
-- under lib/, neuro/, chem/, phys/, fold/, lqg/ (never private/, workflow/, notes/, etc.)
s-kg-public-path : List Word → Bool
s-kg-public-path p =
  andB (h-ends ".cub" p) (
  andB (h-not (h-infix ".." p)) (
    orB (h-prefix "lib/" p) (
    orB (h-prefix "neuro/" p) (
    orB (h-prefix "chem/" p) (
    orB (h-prefix "phys/" p) (
    orB (h-prefix "fold/" p) (
        (h-prefix "lqg/" p))))))))
