rfy-path-body : (a : TyShape) (Δ : CCtx) (X : Mean Δ (TV (s-path a))) → CompS (s-path a) Δ X → CompS a (dext Δ) (plam-body Δ a X)
rfy-path-body a Δ X cx =
  comp-tr a (dext Δ) (papp-mean (dext Δ) a dnf-v0 (wact (dext Δ) Δ (world-dwk Δ) (TV (s-path a)) X)) (plam-body Δ a X)
    (pcat (Mean (dext Δ) (TV a)) (papp-mean (dext Δ) a dnf-v0 (wact (dext Δ) Δ (world-dwk Δ) (TV (s-path a)) X))
       (papp-mean (dext Δ) a dnf-v0 (dwkM Δ (TV (s-path a)) X)) (plam-body Δ a X)
       (λ i → papp-mean (dext Δ) a dnf-v0 (subM-dwk Δ (TV (s-path a)) X i))
       (papp-dwk Δ (TV (s-path a)) (TV a) (path-pt a) X))
    (snd cx (dext Δ) (world-dwk Δ) dnf-v0 unit unit)
