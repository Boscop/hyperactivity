-- GDSII Closed-Boundary Signoff Theorem: every emitted BOUNDARY record has exactly 5 vertices AND
-- its closing vertex equals its origin vertex (zero open-polygon foundry stream errors)!
gds-boundary-closed : (r : Rect) →
  (list-length (gds-rect-xy5 r) ≡ toNat #5) ×
  (gds-pt-head (zero , zero) (gds-rect-xy5 r) ≡ gds-pt-last (zero , zero) (gds-rect-xy5 r))
gds-boundary-closed r = ( (λ _ → toNat #5) , (λ _ → (rx0 r , ry0 r)) )
