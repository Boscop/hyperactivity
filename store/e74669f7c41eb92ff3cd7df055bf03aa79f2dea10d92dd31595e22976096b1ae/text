-- an operand of a register class. A move reads as a copy: what a move leaves behind is not
-- read again by rustc's MIR, and this machine does not mark it.
rm-opd-rv : RCx → ROperand → RFrame → REv RV
rm-opd-rv cx op = case op of
  rop-copy p → rm-place-rv cx p
  rop-move p → rm-place-rv cx p
  rop-const c → (case c of
    rc-static i ty → λ fr → rm-image-rv fr (cx-static-slot cx i)
    _ → sr-on (rm-const-rv cx c) (λ e fr → rm-throw e) (λ v → λ fr → rm-ret v))
