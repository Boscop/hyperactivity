-- the most of p any position of the reversed text matches: the longest end of the turn the text holds.
-- Each step computes the next state once and folds in the one before it (the elimination's code holds
-- the automaton once)
m-best : (n : Nat) → Bytes n → (k : Nat) → Bytes k → Word → (s : Nat) → Bytes s → Word
m-best n p k f m s b = m-best-end (%welimP (λ _ → Word) (bytes-length s b) #0
  (λ i a → m-with (wmax (wshr a #32) (m-lo a)) (m-next n p k f m (m-lo a) (m-back s b i))))
