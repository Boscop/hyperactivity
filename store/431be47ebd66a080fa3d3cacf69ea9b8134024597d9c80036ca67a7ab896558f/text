-- s starts with the query: its tokens are the query's, the last a prefix
sq-starts-c : {A : Type} → (A → A → Bool) → List (List A) → List A → List (List A) → Bool
sq-starts-c le r = case r return λ w → List A → List (List A) → Bool of
  nil → λ x s → case s return λ v → Bool of
    nil → false
    cons y t → sq-pre le x y
  cons z r2 → λ x s → case s return λ v → Bool of
    nil → false
    cons y t → andB (andB (lexle le x y) (lexle le y x)) (rec r2 z t)
