nk-uses-bcadr : (i : Word) (as : NkTm) → (nk-uses-var #0 i (nk-bcadr as) ≡ true) → nk-uses-var #0 i as ≡ true
nk-uses-bcadr i (nk-cons a tl) hu = nk-uses-bcadr-tl i a tl hu
nk-uses-bcadr i (nk-var x) hu = nk-no hu
nk-uses-bcadr i (nk-free x) hu = nk-no hu
nk-uses-bcadr i (nk-num m) hu = nk-no hu
nk-uses-bcadr i (nk-lam b) hu = nk-no hu
nk-uses-bcadr i (nk-susp b) hu = nk-no hu
nk-uses-bcadr i (nk-con c as) hu = nk-no hu
nk-uses-bcadr i (nk-op op p as) hu = nk-no hu
nk-uses-bcadr i (nk-match op p cs) hu = nk-no hu
nk-uses-bcadr i nk-nil hu = nk-no hu
