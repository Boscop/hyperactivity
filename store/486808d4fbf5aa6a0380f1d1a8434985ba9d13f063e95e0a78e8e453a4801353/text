nk-pick-apart-at : (z : Bool) (w : NkW) (r : NkEnv) (i : Word) (out : NkW) (fx : NkFx) (u : NkW) →
  (nk-weq u w ≡ false) → (nk-apart u (nk-era-env r fx)) → (nk-apart u (nk-pick r (%wsub i #1) out fx)) →
  nk-apart u (if z then nkf-op w (nko-fwd out) (nk-era-env r fx) else nkf-op w nko-era (nk-pick r (%wsub i #1) out fx))
nk-pick-apart-at true w r i out fx u neq ape app = (neq , (nk-weq-sym-f u w neq , ape))
nk-pick-apart-at false w r i out fx u neq ape app = (neq , (nk-weq-sym-f u w neq , app))
