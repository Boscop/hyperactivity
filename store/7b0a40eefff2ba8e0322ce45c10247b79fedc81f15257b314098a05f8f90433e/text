-- ---------------------------------------------------------------- 2. Euler Diffusion-Strip LVS Extraction
-- Physical conduction of a continuous NMOS active diffusion strip crossed by poly gates (g0 :: gs)
strip-conducts : {V : Type} → (V → Bool) → V → List V → Bool
strip-conducts env g0 nil = env g0
strip-conducts env g0 (cons g gs) = andB (env g0) (strip-conducts env g gs)
