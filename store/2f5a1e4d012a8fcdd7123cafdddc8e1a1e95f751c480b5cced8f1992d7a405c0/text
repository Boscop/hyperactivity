-- the group's text placed after OTHER's piece in its file, and the file checked once
hy-group-in : List Word → List Word → List (List Word) → List Word → List (List Word) → List Word → Sum Unit (List Word × List (List Word)) → Proc W Unit
hy-group-in st m names t ts h (inl u) = h-fail "hyperactive: no file holds the piece written after"
hy-group-in st m names t ts h (inr mo) =
  bind (hy-render st (snd mo) nil nil false) (λ was →
  bind (hy-render st (snd mo) h t true) (λ new →
  bind (hy-root-of st (fst mo)) (λ root →
  bind (hy-intend st (h-unhex (fst mo)) was) (λ i →
  bind (h-record m (h-unhex (fst mo)) new) (λ w1 →
  bind (hy-verdicts st m (cons root nil)) (λ after →
  bind (hy-read-backs st names ts) (λ rb →
  hy-keep-group st m names (h-unhex (fst mo)) was (cons root nil) (list-append (hy-wrong after) rb))))))))
