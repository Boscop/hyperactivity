-- the rows. Eliminators: 0 apply, 1 increment, 2 case, 5 the reversal of an interval point, 8 a
-- path at a point, its arguments the path and its two ends. Constructors 10 and 11 are the ends
-- of the interval.
-- apply meets a closure: its body, the argument first. Increment meets a number: the next number.
-- Case meets constructor c: the body of branch c, the fields bound. Reversal meets an end: the
-- other end. A path at an end of the interval: that end of the path, the path not read. A path at
-- a point that is blocked: the path applied to it. First (9) and second (10) meet a pair: that part
nk-act0 : Word → NkTm → NkHd → NkEnv → NkAct
nk-act0 h cs (hd-clo b) parts = if %weq h #0 then act-ap b else act-none
nk-act0 h cs (hd-num m) parts = if %weq h #1 then act-hd (hd-num (%wsucc m)) else act-none
nk-act0 h cs (hd-con c) parts =
  if %weq h #2 then act-rp (nk-strip (nk-branch cs c) parts)
  else (if %weq h #9 then act-rp (nk-var #1)
  else (if %weq h #10 then act-rp (nk-var #0)
  else (if %weq h #8 then act-ap (nk-var (if %weq c #10 then #1 else #2))
  else act-none)))
nk-act0 h cs hd parts = if %weq h #8 then (if nk-blocked hd then act-self (nk-app (nk-var #1) (nk-var #0)) else act-none) else act-none
