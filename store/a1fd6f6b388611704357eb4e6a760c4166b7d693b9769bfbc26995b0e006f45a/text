-- write NAME NAME ... < DECLARATIONS: several definitions changed as one change. The text holds their
-- declarations in the order named, each beginning at the comment directly above its first line (where
-- the store cuts pieces); every file they are in is written, every root any of them touches (through
-- its file or its users) is checked once, and all is kept or all is put back.
-- A line that begins a name's declaration: its signature, a clause, or its data, record or codata line
hy-decl-line : List Word → List Word → Bool
hy-decl-line n l = orB (h-prefix (list-append n " ") l) (orB (h-prefix (list-append "data " (list-append n " ")) l)
  (orB (h-prefix (list-append "record " (list-append n " ")) l) (h-prefix (list-append "codata " (list-append n " ")) l)))
