-- an operation: apply, increment, duplicate, erase, forward; and quotation at a depth, with the
-- operations that put a quoted body back together
data NkOp = nko-app (arg : Word) (out : Word) | nko-inc (out : Word) | nko-dup (a : Word) (b : Word) | nko-era | nko-fwd (out : Word) | nko-quote (d : Word) (out : Word) | nko-qlam (out : Word) | nko-qinc (out : Word) | nko-qapp1 (qa : Word) (out : Word) | nko-qapp2 (t : NkTm) (out : Word)
