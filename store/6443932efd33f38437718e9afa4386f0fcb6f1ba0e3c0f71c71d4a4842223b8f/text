kv-rep-go : KvRep → KvPend → NView KvMsg KvRep
kv-rep-go st pd = case pd of
  kp-none → v-recv (λ r → kv-rep-recv st r)
  kp-ack to w → v-send to (m-ack w) (KvRep { r-log = r-log st ; r-app = cons w (r-app st) ; r-pend = kp-none })
  kp-val to rid v → v-send to (m-val rid v) (KvRep { r-log = r-log st ; r-app = r-app st ; r-pend = kp-none })
