        "  assign antipode_fold = (hw > 4'd5);"
        "  assign hop_dist_ub = antipode_fold ? (4'd11 - hw) : hw;"))
    (lir-lines
      (lir-l4
        "endmodule"
        ""
        "module hx_lux_cryptic_plaquette ("
        "  input  wire [63:0] edge_n, input wire [63:0] edge_e, input wire [63:0] edge_s, input wire [63:0] edge_w,")
      tl)
