dd-nondim : (sk : Lst Entry) (j : Word) (X : Type 1) (F : X → Type 1) (G : Cube (dims sk) X) (Q : DCube (dims sk) X (DL X F) G) → isdim sk j ≡ false →
  PathP (λ i → DCube (dims sk) X F G) (diag-dd sk j X F G Q) (dcube-fmap (dims sk) X (DL X F) F (λ x q → fst q) G Q)
dd-nondim lnil j X F G Q hp = λ i → fst Q
dd-nondim (lcons (e-ty s) sk) j X F G Q hp =
  bool-elim1 (λ b → (if b then false else isdim sk (%wsub j #1)) ≡ false → PathP (λ i → DCube (dims sk) X F G)
                 (bool-elim1 (λ b' → DCube (dims sk) X F G) (dcube-fmap (dims sk) X (DL X F) F (λ x q → fst q) G Q) (diag-dd sk (%wsub j #1) X F G Q) b) (dcube-fmap (dims sk) X (DL X F) F (λ x q → fst q) G Q))
    (λ hq i → (dcube-fmap (dims sk) X (DL X F) F (λ x q → fst q) G Q)) (λ hq → dd-nondim sk (%wsub j #1) X F G Q hq) (weq j #0) hp
dd-nondim (lcons e-dim sk) j X F G Q hp =
  bool-elim1 (λ b → (if b then true else isdim sk (%wsub j #1)) ≡ false → PathP (λ i → (DCube (dims sk) (Line X) (LineO X F) G))
                 (bool-elim1 (λ b' → (DCube (dims sk) (Line X) (LineO X F) G)) (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (LineO X F) (λ L q → diag-o X F (line-map X (Line X) (degen-l X) L) q) G Q)
                    (diag-dd sk (%wsub j #1) (Line X) (LineO X F) G (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) G Q)) b) (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (LineO X F) (lineo-fmap X (DL X F) F (λ x q → fst q)) G Q))
    (λ hq → Empty-rec {lsuc lzero} (tf-empty hq))
    (λ hq → (pcat (DCube (dims sk) (Line X) (LineO X F) G) (diag-dd sk (%wsub j #1) (Line X) (LineO X F) G (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) G Q)) (dcube-fmap (dims sk) (Line X) (DL (Line X) (LineO X F)) (LineO X F) (λ x q → fst q) G (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) G Q)) (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (LineO X F) (lineo-fmap X (DL X F) F (λ x q → fst q)) G Q) (dd-nondim sk (%wsub j #1) (Line X) (LineO X F) G (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) G Q) hq) (fmap-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (LineO X F) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) (λ x q → fst q) G Q)))
    (weq j #0) hp
