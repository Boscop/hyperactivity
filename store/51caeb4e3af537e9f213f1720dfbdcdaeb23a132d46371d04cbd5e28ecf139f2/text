dm-mk-rpc-tx-item : Word → Word → Word → Word → Word → Word → List Word → List Word → List Word
dm-mk-rpc-tx-item rpcId priv nc prio mfee gasL pouw20 cdPayload =
  let tx  = mk-tx1559 #8453 nc prio mfee gasL pouw20 #0 cdPayload
      ok  = eth-tx1559-selfcheck priv tx
      raw = fst (eth-tx1559-sign-raw priv tx)
      rHx = list-append "0x" (h-hex raw)
  in if eth-not ok
     then nil
     else h-concat
            (cons "{" (cons (h-quote "jsonrpc") (cons ":" (cons (h-quote "2.0")
            (cons "," (cons (h-quote "id") (cons ":" (cons (h-decimal rpcId)
            (cons "," (cons (h-quote "method") (cons ":" (cons (h-quote "eth_sendRawTransaction")
            (cons "," (cons (h-quote "params") (cons ":[" (cons (h-quote rHx) (cons "]}" nil)))))))))))))))))
