-- under one binder i: the element of the exchange's line at i that is (1, 2) at the start and
-- (2, 1) at the end, over the base (2, 1) (part of machine-in-hyperactive)
nk-glue-12 : NkTm
nk-glue-12 = nk-glue (nk-sys (nk-cons (nk-br (nk-neg (nk-var #0)) (nk-mkpair (nk-num #1) (nk-num #2))) (nk-cons (nk-br (nk-var #0) (nk-mkpair (nk-num #2) (nk-num #1))) nk-nil))) (nk-mkpair (nk-num #2) (nk-num #1))
