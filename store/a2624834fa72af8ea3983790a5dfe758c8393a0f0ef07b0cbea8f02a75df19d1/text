-- the necklace of n vertices: vertex v joined to v+1 (mod n) by two edges 2v, 2v+1, which leave v at its slots 2, 3
-- and enter v+1 at its slots 0, 1; every vertex carries the form w
necklace-slots : Nat → Nat → List (Nat × Bool)
necklace-slots n v = cons (times 2 (prev-mod n v) , false) (cons (suc (times 2 (prev-mod n v)) , false) (cons (times 2 v , true) (cons (suc (times 2 v) , true) nil)))
