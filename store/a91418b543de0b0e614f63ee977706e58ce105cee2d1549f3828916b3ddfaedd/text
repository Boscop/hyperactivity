hy-machine-text : List Word → Word × List Word → List Word
hy-machine-text f r = if hy-complete (h-lines (snd r))
  then list-append (h-line (list-append f (list-append ": " (hy-last (h-lines (snd r)))))) (hy-fail-lines (h-lines (snd r)))
  else list-append (h-line (list-append f (list-append ": the machine ended without its verdict (exit status " (list-append (h-decimal (fst r)) ")"))))
    (h-indented "  " (h-lines (snd r)))
