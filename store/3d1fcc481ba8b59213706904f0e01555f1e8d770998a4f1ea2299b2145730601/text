chem-gb-dipole-cancel-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-gb-dipole-cancel-poly A ad mu q vs =
  (λ g sub →
    let chg = g 0
        z0 = q (fn-q 0 1)
        two = q (fn-q 2 1)
        nchg = sub z0 chg
        lhs = ad (ad (mu chg chg) (mu nchg nchg)) (mu two (mu chg nchg))
    in (lhs , z0))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
