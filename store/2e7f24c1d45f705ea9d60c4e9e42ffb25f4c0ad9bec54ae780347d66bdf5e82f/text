opt-not-1-sound : {V : Type} → (env : V → Bool) → (u : B1) → (a : Circ B0 B1 B2 V) →
  fold {B0} {B1} {B2} {V} {Bool} bool-alg env (opt-not-1 {V} u a) ≡
  not (fold {B0} {B1} {B2} {V} {Bool} bool-alg env (cop1 u a))
opt-not-1-sound {V} env b1-not a =
  sym (not-invol (fold {B0} {B1} {B2} {V} {Bool} bool-alg env a))
opt-not-1-sound {V} env b1-buf a = refl
