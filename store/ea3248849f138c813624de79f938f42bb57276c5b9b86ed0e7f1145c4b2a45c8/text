v-rename : List Word → List Word → Proc W Unit
v-rename old nw =
  with-bytes {Unit} (wadd (fromNat (list-length old)) #1) (λ p1 → bind (h-poke p1 old) (λ u1 →
  with-bytes {Unit} (wadd (fromNat (list-length nw)) #1) (λ p2 → bind (h-poke p2 nw) (λ u2 →
  bind (sys-call #82 p1 p2 #0 #0 #0 #0) (λ r → ret unit)))))
