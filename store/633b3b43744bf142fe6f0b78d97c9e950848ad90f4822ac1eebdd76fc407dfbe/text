ha-lem-mk-and : (env : Word → Bool) → (a b : WExpr) → web-andB (weval env a) (weval env b) ≡ weval env (ha-mk-and a b)
ha-lem-mk-and env (we-k false) _ = refl
ha-lem-mk-and env (we-k true)  _ = refl
ha-lem-mk-and env (we-v _)     _ = refl
ha-lem-mk-and env (we-not _)   _ = refl
ha-lem-mk-and env (we-xor _ _) _ = refl
ha-lem-mk-and env (we-and _ _) _ = refl
ha-lem-mk-and env (we-or  _ _) _ = refl
ha-lem-mk-and env (we-ch _ _ _) _ = refl
ha-lem-mk-and env (we-maj _ _ _) _ = refl
