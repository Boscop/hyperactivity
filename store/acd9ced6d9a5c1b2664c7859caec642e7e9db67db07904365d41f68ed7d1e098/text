-- Φ(m,n) on xs0, scaled by s: the five kinds, four branches each
hop-kinds : SQ → List Triple → VM → Nat → Nat → Nat → List Nat → Rows → List Term
hop-kinds s ts aP k n m dsP xs0 = case k of
  zero → nil
  suc j → terms-append (terms-scale s (cons (hop-term ts aP k true n true m dsP xs0) (cons (hop-term ts aP k true n false m dsP xs0)
      (cons (hop-term ts aP k false n true m dsP xs0) (cons (hop-term ts aP k false n false m dsP xs0) nil)))))
    (hop-kinds s ts aP j n m dsP xs0)
