-- wm_low_64: from physical_memory.sail (it calls what is defined after it there)
-- (part of language-support)
wm_low_64 : (addr : Bits #52) → (sailval : Bits #64) → MS Unit
wm_low_64 addr sailval =
  bindS {Bool} {Unit} (getS {Bool} x86-app_view) (λ app_view'1 →
    onS {Unit} {Unit} (fl-assert {exception} (b-not app_view'1) #10766557306235811165391993617916461646257293381573686577) (λ _ →
      let addr : ZI
          addr = (bv-unsigned #52 addr)
          dword0 : Bits #32
          dword0 = (bv-slice #64 sailval #31 #0)
          dword1 : Bits #32
          dword1 = (bv-slice #64 sailval #63 #32)
      in bindS {Unit} {Unit} (wm_low_32 (bits_of_int addr (zpos #52)) dword0) (λ t'3 →
           wm_low_32 (bits_of_int (z-add (zpos #4) addr) (zpos #52)) dword1)))
