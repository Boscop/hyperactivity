-- the leading principal minors D_1 … D_n, one per row of f (a list of the matrix's length, which the recursion
-- descends), q the previous pivot (1 at the start)
in-minors : List (List BZ) → BZ → List (List BZ) → List BZ
in-minors f q m = case f of
  nil → nil
  cons g frest → (case m of
    nil → nil
    cons r rest → cons (in-hd r) (in-minors frest (in-hd r) (in-rows (in-hd r) q (in-tl r) rest)))
