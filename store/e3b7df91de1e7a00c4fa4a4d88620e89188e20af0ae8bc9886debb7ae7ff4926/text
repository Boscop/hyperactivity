si-div : SInt → SInt → SInt
si-div a b =
  let db = si-abs b
      da = si-abs a
  in if weq db #0 then sp #0
     else let q = wquot da db
          in case a of
               sp _ → (case b of sp _ → sp q; sn _ → si-norm (sn q))
               sn _ → (case b of sp _ → si-norm (sn q); sn _ → sp q)
