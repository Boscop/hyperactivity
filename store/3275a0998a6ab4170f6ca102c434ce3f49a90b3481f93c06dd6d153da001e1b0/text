-- the change made, checked, and kept or put back
hy-keep : List Word → List Word → List Word → List Word → List Word → List (List Word) → Bool → List (List Word) → Proc W Unit
hy-keep st m name path old roots removing nil = bind (hy-forget st) (λ f →
  if removing then bind (h-unlink (list-append h-index (list-append "/written/" (h-hex name)))) (λ u →
    bind (h-unlink (list-append st (list-append "/bound/" (h-hex name)))) (λ u2 → h-out (h-line (list-append "removed " name))))
  else if h-ends ".cub" name then h-out (h-line (list-append name "   (its head)"))
  else bind (hy-version "written" (h-hex name)) (λ vu → bind (hy-get st (list-append "bound/" (h-hex name))) (λ k → h-out (h-line (list-append name (list-append "   (" (list-append (hy-key-label k) ")")))))))
hy-keep st m name path old roots removing (cons p ps) =
  bind (h-record m path old) (λ w → bind (hy-forget st) (λ f → bind (hy-verdicts st m roots) (λ v →
  bind (h-say (list-append (h-line "nothing written: it does not check") (h-indented "  " (cons p ps)))) (λ u → exit #1))))
