-- V = Q'·(256·P) + (D·P + R), Q and R V's quotient and remainder by P, Q' and D Q's by 256
digit-split : (V P : Word) →
  V ≡ wadd (wmul (wquot (wquot V P) #256) (wmul #256 P)) (wadd (wmul (wrem (wquot V P) #256) P) (wrem V P))
digit-split V P =
  catw (wdiv-mod V P)
    (catw (congw (λ z → wadd (wmul z P) (wrem V P)) (wdiv-mod (wquot V P) #256))
      (catw (congw (λ z → wadd z (wrem V P)) (wmul-distr (wmul (wquot (wquot V P) #256) #256) (wrem (wquot V P) #256) P))
        (catw (wadd-assoc (wmul (wmul (wquot (wquot V P) #256) #256) P) (wmul (wrem (wquot V P) #256) P) (wrem V P))
          (congw (λ z → wadd z (wadd (wmul (wrem (wquot V P) #256) P) (wrem V P))) (wmul-assoc (wquot (wquot V P) #256) #256 P)))))
