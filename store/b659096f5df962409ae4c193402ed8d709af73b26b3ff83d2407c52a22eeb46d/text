dsf-nat-sub : Nat → Nat → Nat
dsf-nat-sub zero    _       = zero
dsf-nat-sub (suc a) zero    = suc a
dsf-nat-sub (suc a) (suc b) = dsf-nat-sub a b

-- UNIVERSAL THEOREM 3A (ALL CYCLE SIZES `sz : Nat` — ZERO DELTA IS KIRCHHOFF PORT CONSERVATION):
--   Every closed spot+perp or multi-DEX cycle entering interior token vertex `v` with `+sz` and
