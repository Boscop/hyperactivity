-- Assumed non-involutive stride `(+1, +3)` from `HX-DIAMOND-1` on `4x4` (`v = x | (y << 2)`):
dsf-d1-assumed-chord : Word → Word
dsf-d1-assumed-chord v =
  let gx = %wand v #3
      gy = %wand (%wshr v #2) #3
      nx = %wand (%wadd gx #1) #3
      ny = %wand (%wadd gy #3) #3
  in %wor nx (%wshl ny #2)

-- Exact De Morgan antipodal involution `v ^ 10` (`CX = gx ^ 2, CY = gy ^ 2`) -> Clebsch `srg(16,5,0,2)`:
dsf-clebsch-chord : Word → Word
dsf-clebsch-chord v = %wxor v #10

dsf-check-inv16 : Nat → Word → Bool
dsf-check-inv16 zero    v = true
dsf-check-inv16 (suc k) v =
  andB (%weq (dsf-clebsch-chord (dsf-clebsch-chord v)) v)
       (dsf-check-inv16 k (%wadd v #1))

-- THEOREM 1 (`refl`):
--   1. `HX-DIAMOND-1`'s assumed `(+1,+3)` chord is NOT reciprocal (`C(C(0)) = 10 != 0`), doubling wire count!
--   2. `Clebsch` De Morgan involution `v ^ 10` is 100% reciprocal across all 16 nodes (`C(C(v)) == v`)!
--   3. `Golay-23` (`0xAE3`) hits exact Hamming sphere-packing `1 + 23 + 253 + 1771 == 2048` (`0` wasted states)!
dsf-thm-diamond1-refuted-by-clebsch-and-golay23 :
  let d1FailRecip = eth-not (%weq (dsf-d1-assumed-chord (dsf-d1-assumed-chord #0)) #0)
      clebschOk   = dsf-check-inv16 (toNat #16) #0
      golaySphere = %weq (%wadd #1 (%wadd #23 (%wadd #253 #1771))) #2048
  in andB d1FailRecip (andB clebschOk golaySphere) ≡ true
dsf-thm-diamond1-refuted-by-clebsch-and-golay23 = refl

-- ============================================================================
-- SECTION 2: ENDOGENOUS MULTI-CHANNEL KKT CONCAVE WATER-FILLING SUPEROPTIMIZER
--   Replaces hardcoded `45% / 35% / 20%` and `80% / 20%` assumptions!
--   Each live channel `mk-dchan id grossSlope depthUsd capUsd` has concave net flux:
--     R_i(x) = x * grossSlope - (x^2 * 1000) / depthUsd
--   Marginal flux: dR_i/dx = grossSlope - (2000 * x) / depthUsd.
--   Setting dR_i/dx = mu (shadow marginal rate) yields exact optimal size:
--     x_i(mu) = min(capUsd, ((grossSlope - mu) * depthUsd) / 2000)  for grossSlope > mu, else 0.
-- ============================================================================

data DsfChan : Type where
  mk-dchan : Word → Word → Word → Word → DsfChan

dsf-min-w : Word → Word → Word
dsf-min-w a b = if %wlt a b then a else b

dsf-sub-pos : Word → Word → Word
dsf-sub-pos a b = if %wlt b a then %wsub a b else #0

dsf-chan-x : Word → DsfChan → Word
dsf-chan-x mu (mk-dchan cid g dep cap) =
  if eth-le g mu then #0
  else if %weq dep #0 then #0
  else dsf-min-w cap (%wdiv (%wmul (%wsub g mu) dep) #2000)

dsf-chan-flux : Word → DsfChan → Word
dsf-chan-flux x (mk-dchan cid g dep cap) =
  if %weq dep #0 then #0
  else dsf-sub-pos (%wmul x g) (%wdiv (%wmul (%wmul x x) #1000) dep)

dsf-sum-x : Word → List DsfChan → Word
dsf-sum-x mu nil         = #0
dsf-sum-x mu (cons c cs) = %wadd (dsf-chan-x mu c) (dsf-sum-x mu cs)

dsf-alloc-list : Word → Word → List DsfChan → List Word
dsf-alloc-list mu rem nil = nil
dsf-alloc-list mu rem (cons c cs) =
  let xi = dsf-min-w rem (dsf-chan-x mu c)
  in cons xi (dsf-alloc-list mu (dsf-sub-pos rem xi) cs)

dsf-total-flux : List Word → List DsfChan → Word
dsf-total-flux nil         _           = #0
dsf-total-flux _           nil         = #0
dsf-total-flux (cons x xs) (cons c cs) = %wadd (dsf-chan-flux x c) (dsf-total-flux xs cs)

-- Exact O(log2 g_max) Binary Search for KKT Shadow Marginal Rate `mu*`:
-- Finds minimal `mu` such that `sum_i x_i(mu) <= budget`!
dsf-solve-mu : Nat → Word → Word → Word → List DsfChan → Word
dsf-solve-mu zero    lo hi budget cs = hi
dsf-solve-mu (suc k) lo hi budget cs =
  if eth-le hi lo then lo
  else
    let mid = %wshr (%wadd lo hi) #1
        tot = dsf-sum-x mid cs
    in if %wlt budget tot
       then dsf-solve-mu k (%wadd mid #1) hi budget cs
       else dsf-solve-mu k lo mid budget cs

dsf-kkt-solve : Word → List DsfChan → (Word × List Word)
dsf-kkt-solve budget cs =
  let muStar = dsf-solve-mu (toNat #16) #0 #10000 budget cs
  in (muStar , dsf-alloc-list muStar budget cs)

