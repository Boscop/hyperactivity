-- Endogenous Hurdle-Saturation Waterfall (Replaces Hardcoded `80% / 20%`):
--   Given hurdle rate `muHurdle`, productive network capacity is `cSat = dsf-sum-x muHurdle cs`.
--   Unsaturated capacity gap `capGap = max(0, cSat - curCap)` absorbs surplus up to `cSat`;
--   100% of excess flux streams directly to Founder Coinbase (`0x4A50FBF0128E2679C42466A8cC1A9D230b08A26f`)!
dsf-endogenous-waterfall : Word → Word → Word → List DsfChan → (Word × Word)
dsf-endogenous-waterfall muHurdle curCap surplus cs =
  let cSat   = dsf-sum-x muHurdle cs
      capGap = dsf-sub-pos cSat curCap
      reinv  = dsf-min-w surplus capGap
      fndOut = %wsub surplus reinv
  in (reinv , fndOut)

