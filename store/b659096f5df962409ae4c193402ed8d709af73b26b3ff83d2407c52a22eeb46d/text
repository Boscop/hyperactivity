dsf-sum-words : List Word → Word
dsf-sum-words nil         = #0
dsf-sum-words (cons x xs) = %wadd x (dsf-sum-words xs)

-- THEOREM 2 (`refl` — ENDOGENOUS KKT SUPEROPTIMIZER STRICTLY DOMINATES ASSUMED `45/35/20` & `50/50` SPLITS):
--   * Budget = $200,000 (represented in $1,000 units -> `#200` for exact integer proof speed):
