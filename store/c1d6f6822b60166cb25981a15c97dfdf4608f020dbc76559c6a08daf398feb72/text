-- enforce canonical <title> on standalone HTML pages wrapped by s-chrome-html
s-set-title : List Word → List Word → List Word
s-set-title title doc =
  if andB (h-infix "<title>" doc) (h-infix "</title>" doc) then
    h-concat (cons (h-before "<title>" doc) (cons "<title>" (cons title (cons "</title>" (cons (h-after "</title>" doc) nil)))))
  else doc
