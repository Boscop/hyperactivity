pinsert-sound : (e : Val) (c : Nat) (m : Mono) (p : Poly) → pev e (pinsert c m p) ≡ plus (times c (mev e m)) (pev e p)
pinsert-sound e c m p =
  case p return (λ w → pev e (pinsert c m w) ≡ plus (times c (mev e m)) (pev e w)) of
    pzero → λ i → plus (times c (mev e m)) zero
    pterm c2 m2 r2 → pins-case-sound e (msame m m2) (mlt m m2) c m c2 m2 r2 (pinsert c m r2) (λ i → msame m m2) (rec r2)
