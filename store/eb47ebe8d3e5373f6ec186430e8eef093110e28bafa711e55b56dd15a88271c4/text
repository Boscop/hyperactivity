rm-init-statics : List RStatic → Target → REv (List RSlot)
rm-init-statics nil t = rm-ret nil
rm-init-statics (cons s ss) t = case s of
  rstatic nm ty mu size al init →
    rm-bind (rm-alloc-static size al) (λ p →
    rm-then (rm-init-runs init t p #0)
   (rm-bind (rm-init-statics ss t) (λ r → rm-ret (cons (sl-reg (rv-s (sv-p p))) r))))
