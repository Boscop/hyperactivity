-- Single-source combined Apple Metal shader emitter for hx-gpu (GEMM + FlashAttention-2)
tir-emit-gpu-metal : TKernelSpec → TKernelSpec → List Word
tir-emit-gpu-metal (tk-gemm m n k tm tn tk) (tk-flash-attn an ad tq tkv) =
  tir-line "// Mechanically lowered from verified TensorIR specs (lib/ir/tensor-ir.hypercubical)"
  (tir-line "#include <metal_stdlib>"
  (tir-line "#include <metal_simdgroup_matrix>"
  (tir-line "using namespace metal;"
  (tir-line "struct GemmDims { uint M; uint N; uint K; };"
  (tir-line "struct AttnDims { uint N; uint D; float scale; };"
  (tir-metal-gemm-body m n k tm tn tk (tir-metal-flash-body an ad tq tkv nil)))))))
tir-emit-gpu-metal _ _ = "// invalid TensorIR spec"
