-- a command of a reader's process: the memory's by mem-std, the reader's world's observed
std-step : {S : Sig} → Target → (c : Cmd (MK S)) → AMem → Step (MT S) (MRes (Resp (MK S) c × AMem))
std-step {S} t c s = case c return (λ y → Step (MT S) (MRes (Resp (MK S) y × AMem))) of
  inl m → mem-std {S} t m s
  inr x → scmd (inl x) (λ r → sdone (mok (r , s)))
