ln-join : (A0 A1 : Type 1) (A : PathP (λ i → Type 1) A0 A1) (L : LnF A0 A1 A) →
  LnF (LnF A0 A1 A) (LnF A1 A1 (λ j → A1)) (λ i → LnF (A i) A1 (λ j → A (i ∨ j)))
ln-join A0 A1 A L = (L , (fst (snd L) , fst (snd L) , λ j → fst (snd L)) , λ i → (snd (snd L) i , fst (snd L) , λ j → snd (snd L) (i ∨ j)))
