zsc-plus : (a b : Nat × Nat) → (c : Nat) → zsc (zplus a b) c ≡ zplus (zsc a c) (zsc b c)
zsc-plus a b c = pairNN (times (plus (fst a) (fst b)) c) (times (plus (snd a) (snd b)) c) (plus (times (fst a) c) (times (fst b) c)) (plus (times (snd a) c) (times (snd b) c))
  (times-distr (fst a) (fst b) c) (times-distr (snd a) (snd b) c)
