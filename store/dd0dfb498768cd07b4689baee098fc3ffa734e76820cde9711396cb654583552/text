-- B_kl for one k from data: ys are coordinates in the space 6, lifted, closed by R, read at the vertex
b2-row-vw : Nat → VW → VM → (List Nat → List Nat → SQ) → Rows → List Rows
b2-row-vw n w a6 rent ys = case n of
  zero → nil
  suc g → cons (restrict (vw-frs w) (rows-map-entry rent (vw-ms w) (vw-ms (fst a6)) (lift-all (mons-count (vw-ms (fst a6))) (vw-bs (fst a6)) ys))) (b2-row-vw g w a6 rent (rows-apply-all (snd a6) ys))
