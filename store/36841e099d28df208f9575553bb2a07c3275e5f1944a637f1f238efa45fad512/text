-- a call: the arguments pushed in order, the call, the arguments dropped
x-call : Enc → Tbl → XEnv → Word → Word → Lst Code → Lst Word
x-call ce tbl env d g args =
  xcat3 (x-push-all ce env d args) (i-call-off (x-tbl tbl g)) (if %weq (l-count args) #0 then lnil else i-add-rsp (xmul8 (l-count args)))
