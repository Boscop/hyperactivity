-- coupled product flow: independent local steps plus a cross-system coupling transition c
-- (e.g. gap-junction voltage exchange between cells, or ligand/field coupling on a protein fold)
coupled-step : {S1 S2 : Type 0}
             → (eq1 : S1 → S1 → Bool) → (eq2 : S2 → S2 → Bool)
             → (S1 → S1 → Bool) → (S2 → S2 → Bool)
             → ((S1 × S2) → (S1 × S2) → Bool)
             → (S1 × S2) → (S1 × S2) → Bool
coupled-step eq1 eq2 s1 s2 c = step-or (prod-step eq1 eq2 s1 s2) c
