-- the elements: carbon 6, oxygen 8, nitrogen 7, hydrogen 1
il-el : Ile → Nat
il-el x = case x of
  il-c1 → 6
  il-o1 → 8
  il-o2 → 8
  il-ho → 1
  il-ca → 6
  il-ha → 1
  il-n → 7
  il-hn1 → 1
  il-hn2 → 1
  il-cb → 6
  il-hb → 1
  il-cg1 → 6
  il-g11 → 1
  il-g12 → 1
  il-cd1 → 6
  il-d11 → 1
  il-d12 → 1
  il-d13 → 1
  il-cg2 → 6
  il-g21 → 1
  il-g22 → 1
  il-g23 → 1
