hi-verdict-of : List Word → Sum Unit (List Word) → Nat → Proc W (List Word)
hi-verdict-of st (inl u) k = ret nil
hi-verdict-of st (inr key) k = if orB (h-null (h-trim key)) (h-eq (h-trim key) "-") then ret {lzero} {W} nil else
  bind (h-read (list-append st (cons #47 (list-append (h-trim key) "/check")))) (λ c → ret (hi-checked c k))
