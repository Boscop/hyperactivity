-- every term of every operator built from loops lies in the fiber of its input: the operator acts within sectors
op-keeps : (op : List (SQ × List Loop)) → (es : Ends) → op-beyonds (op-act op es) ≡ same-beyonds op es
op-keeps nil es = λ k → nil
op-keeps (cons t rest) es = λ k → cons (word-keeps (snd t) es k) (op-keeps rest es k)
