-- /chat?q=TURN: the reply lib/chat.cub computes from the record, on a page with the form that asks
ch-page : List Word → List Word → List Word
ch-page q reply = h-concat (cons "<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>chat</title><style>body{margin:0;background:#000;color:#eee;font:18px/1.5 Georgia,serif;padding:16px}textarea{width:100%;box-sizing:border-box;font:inherit;background:#111;color:#eee}p{white-space:pre-wrap}</style></head><body><form method='get' action='/chat'><textarea name='q' rows='3'>" (cons (s-esc q) (cons "</textarea><br><button>ask the record</button></form><p>" (cons (s-esc reply) (cons "</p></body></html>" nil)))))
