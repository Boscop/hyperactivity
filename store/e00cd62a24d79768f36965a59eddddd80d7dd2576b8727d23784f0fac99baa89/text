nk-nlt-nle-trans : (a b c : Nat) → (nk-nlt a b ≡ true) → (nk-nle b c ≡ true) → nk-nlt a c ≡ true
nk-nlt-nle-trans zero zero c p q = nk-no p
nk-nlt-nle-trans zero (suc b) zero p q = nk-no q
nk-nlt-nle-trans zero (suc b) (suc c) p q = refl
nk-nlt-nle-trans (suc a) zero c p q = nk-no p
nk-nlt-nle-trans (suc a) (suc b) zero p q = nk-no q
nk-nlt-nle-trans (suc a) (suc b) (suc c) p q = nk-nlt-nle-trans a b c p q
