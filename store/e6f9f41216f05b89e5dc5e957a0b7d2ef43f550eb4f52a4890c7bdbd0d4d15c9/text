-- a value below a computed corner is, scaled, below the product of the scaled ends
corner-le : (m L1 L2 : BZ) → (q1 q2 : Nat) → zle (zv m) (zv (bz-mul L1 L2)) → zle (zsc (zv m) (times q1 q2)) (zmul (zsc (zv L1) q1) (zsc (zv L2) q2))
corner-le m L1 L2 q1 q2 h = zle-zeq-r (zsc (zv m) (times q1 q2)) (zsc (zv (bz-mul L1 L2)) (times q1 q2)) (zmul (zsc (zv L1) q1) (zsc (zv L2) q2))
  (corner-eq L1 L2 q1 q2) (zle-scale (zv m) (zv (bz-mul L1 L2)) (times q1 q2) h)
