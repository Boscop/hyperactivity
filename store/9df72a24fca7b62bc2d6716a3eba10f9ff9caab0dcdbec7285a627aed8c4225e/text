cs-sim-pair-con : (hp2 : CsHeap) (mva mvb : CsMVal) (va vb : CsVal) →
  (cs-val-rel hp2 mva va ≡ true) →
  (cs-val-rel hp2 mvb vb ≡ true) →
  cs-res-rel (cmv-pair mva mvb) (cs-hy-con hp2 #0 (lcons va (lcons vb lnil))) ≡ true
cs-sim-pair-con hp2 mva mvb va vb ha2 hb2 =
  let blk = lcons (csv-word #0) (lcons va (lcons vb lnil))
      hp3 = fst (cs-alloc hp2 blk)
      ptr = snd (cs-alloc hp2 blk)
      ext3 = cs-alloc-ext hp2 blk
      ha3 = cs-val-rel-mono hp2 hp3 mva va ext3 ha2
      hb3 = cs-val-rel-mono hp2 hp3 mvb vb ext3 hb2
      ld1 = cong cs-optv (cs-alloc-load-self hp2 blk (suc zero))
      ld2 = cong cs-optv (cs-alloc-load-self hp2 blk (suc (suc zero)))
  in cong (λ o → cs-pair-rel-ov (cs-val-rel hp3 mva) (cs-val-rel hp3 mvb) o (cs-loadv hp3 ptr (suc (suc zero)))) ld1
     ∙ (cong (cs-pair-rel-ov (cs-val-rel hp3 mva) (cs-val-rel hp3 mvb) (csov-some va)) ld2
        ∙ cs-c-and-true (cs-val-rel hp3 mva va) (cs-val-rel hp3 mvb vb) ha3 hb3)
