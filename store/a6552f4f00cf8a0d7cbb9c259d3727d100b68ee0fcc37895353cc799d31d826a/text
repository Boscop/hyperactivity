-- ---------------------------------------------------------------- the environment of a reading
-- what a declaration id denotes while a function runs. A variable (a local, a parameter, a
-- variable of static storage) is the object at an address; a reference is bound to its
-- referent's address directly and has no object of its own (cxb-obj), except a reference of
-- static storage, which is initialized when control first passes its declaration and so has a
-- pointer-sized object holding the referent's address (cxb-ref).
data CxBind = cxb-obj (p : MPtr) (al : Word) | cxb-ref (p : MPtr)
