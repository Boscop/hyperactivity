-- a work's text: an essay of the source its lines (s-essay-lines), any other document as the source holds it
s-text-of : List Word → List (List Word) → Proc W (List Word)
s-text-of p ls = if s-no-runs ls then bind (h-document p) (λ t → ret {lzero} {W} (s-or nil t)) else ret {lzero} {W} (h-concat (list-map h-line ls))
