cs-bind-args-mono : (hp : CsHeap) (ar : CsArgsRes) (k : CsHeap → Lst CsVal → CsRes) →
  cs-args-mono hp ar →
  ((hp1 : CsHeap) (vs : Lst CsVal) → cs-res-mono hp1 (k hp1 vs)) →
  cs-res-mono hp (cs-bind-args ar k)
cs-bind-args-mono hp csa-abort k mar mk = unit
cs-bind-args-mono hp csa-ub k mar mk = unit
cs-bind-args-mono hp (csa-ok hp1 vs) k mar mk = cs-res-mono-trans hp hp1 (k hp1 vs) mar (mk hp1 vs)
