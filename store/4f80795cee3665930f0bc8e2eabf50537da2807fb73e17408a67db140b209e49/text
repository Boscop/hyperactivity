-- ---------------------------------------------------------------- the sequential client
-- one request at a time: a put is sent to replicas 0, 1, 2 and is answered when replica 0
-- acknowledges it; a get is sent to replica 0 with the request's number and is answered by the
-- value carrying that number from replica 0. Anything else received is ignored
kv-start : List KvCmd → KvPhase × List KvCmd
kv-start todo = case todo of
  nil → (ph-done , nil)
  cons c r → (case c of kc-put w → (ph-put w zero , r); kc-get k → (ph-get-send k , r))
