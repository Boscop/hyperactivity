lead-paragraphs-split : (n : Nat) → (ls : List (List Word)) → list-append (lead-paragraphs n ls) (lead-paragraphs-rest n ls) ≡ ls
lead-paragraphs-split zero ls = λ i → ls
lead-paragraphs-split (suc n) nil = λ i → nil
lead-paragraphs-split (suc zero) (cons nil ls) = λ i → cons nil ls
lead-paragraphs-split (suc (suc m)) (cons nil ls) = λ i → cons nil (lead-paragraphs-split (suc m) ls i)
lead-paragraphs-split (suc n) (cons (cons x l) ls) = λ i → cons (cons x l) (lead-paragraphs-split (suc n) ls i)
