-- GET /hi/scene: the scene of the focus as data; with walk=1 and write permission the focus is also walked to
hi-scene-get-as : Bool → List Word → List Word → Proc W (List Word)
hi-scene-get-as wr st q = bind (h-read (list-append st "/views/nodes")) (λ nv → bind (h-read (list-append st "/views/open")) (λ ov →
  bind (hi-walk-if (andB wr (h-eq (s-param "walk" q) "1")) st (hi-reader q) (hi-focus q)) (λ path → bind (h-list (list-append st "/hi")) (λ es → bind (hi-lasts st (hi-reader q) es) (λ la →
  ret (s-response "application/json" (hi-scene-json (hi-rows (s-or nil nv)) (hi-focus q) (h-not (h-eq (s-param "radius" q) "1")) la (list-map hi-first (hi-rows (s-or nil ov))))))))))
