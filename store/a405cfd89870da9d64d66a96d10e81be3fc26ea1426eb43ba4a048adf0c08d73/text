  (hw-ln "    last_f.crc = crc16_ccitt((const uint8_t*)&last_f, 10);"
  (hw-ln "  }"
  (hw-ln "  double dt_ns = (now_ns() - t0) / (double)STEPS;"
  (hw-ln (list-append "  printf(" (list-append hw-q (list-append "[CBF RT-ACTUATOR] 100,000 CAN-FD/EtherCAT frames | viol=%d (0=provably safe!) | clamps=%d | %.1f ns/frame (%.1f MHz) | last_crc=0x%04x" (list-append hw-esc-n (list-append hw-q ", viol, clamped, dt_ns, 1000.0/dt_ns, last_f.crc);")))))
