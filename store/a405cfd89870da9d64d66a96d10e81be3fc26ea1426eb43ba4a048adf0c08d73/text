  (hw-ln "#include <sys/time.h>"
  (hw-ln "static double now_ns(void){ struct timeval tv; gettimeofday(&tv,NULL); return tv.tv_sec*1e9 + tv.tv_usec*1e3; }"
  (hw-ln "typedef struct { uint32_t can_id; uint8_t dlc; uint8_t safe_flag; uint16_t u_q12; uint16_t h_q12; uint16_t crc; } CanFdCbfFrame;"
  (hw-ln "// Exact 1-cycle fixed-point mirror of hx_cbf_hw_interlock (SAFE_MIN=256, EPS_TOTAL=32, D_MAX=64 -> FLOOR=352)"
  (hw-ln "static inline uint16_t cbf_hw_mirror(uint16_t h_pred, uint16_t u_cmd, uint16_t u_safe, uint8_t* is_safe) {"
  (hw-ln "  const uint16_t FLOOR = 256u + 32u + 64u;"
  (hw-ln "  uint8_t ok = (h_pred >= FLOOR) ? 1u : 0u;"
  (hw-ln "  *is_safe = ok;"
  (hw-ln "  return ok ? u_cmd : u_safe;"
  (hw-ln "}"
  (hw-ln "static inline uint16_t crc16_ccitt(const uint8_t* p, int n) {"
  (hw-ln "  uint16_t c = 0xFFFFu;"
  (hw-ln "  for (int i = 0; i < n; i++) { c ^= (uint16_t)p[i] << 8; for (int b=0;b<8;b++) c = (c&0x8000u)?((c<<1)^0x1021u):(c<<1); }"
  (hw-ln "  return c;"
  (hw-ln "}"
  (hw-ln "int main(void) {"
  (hw-ln "  const int STEPS = 100000;"
  (hw-ln "  int clamped = 0, viol = 0;"
  (hw-ln "  uint16_t h = 500u;"
  (hw-ln "  double t0 = now_ns();"
