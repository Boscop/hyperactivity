bk-bit-asym : (a b t1 t2 : Bool) → (t1 ≡ true → t2 ≡ false) → bk-bit-lt a b t1 ≡ true → bk-bit-lt b a t2 ≡ false
bk-bit-asym false true t1 t2 ih h = refl
bk-bit-asym true false t1 t2 ih h = Empty-rec (dht-false≠true h)
bk-bit-asym false false t1 t2 ih h = ih h
bk-bit-asym true true t1 t2 ih h = ih h
