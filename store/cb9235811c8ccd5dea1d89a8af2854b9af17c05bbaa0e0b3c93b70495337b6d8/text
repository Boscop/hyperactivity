cs-for-t0-dl : (d : Word) (tl : List Word) → cs-for-t0 d tl ≡ list-append (cs-for-t0 d nil) tl
cs-for-t0-dl d tl =
  cs-dl-comp (list-append "({ uint64_t w") (λ x → list-append (ce-dec d) (list-append " = " x))
    (cs-dl-lit "({ uint64_t w")
    (cs-dl-comp (list-append (ce-dec d)) (list-append " = ")
      (cs-dl-lit (ce-dec d)) (cs-dl-lit " = ")) tl
