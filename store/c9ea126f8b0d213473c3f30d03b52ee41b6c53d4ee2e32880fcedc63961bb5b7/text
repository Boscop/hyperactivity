cfh-has-flag : List Word → List (List Word) → Bool
cfh-has-flag fl nil         = false
cfh-has-flag fl (cons a rs) = if h-eq fl a then true else cfh-has-flag fl rs

cfh-loop : Nat → Word → Proc W Unit
cfh-loop zero    ep = exit #0
cfh-loop (suc k) ep =
  bind (cfh-cycle ep true) (λ u0 →
  bind cfh-sleep-1s (λ s0 →
  cfh-loop k (%wadd ep #1)))

cfh-main : Proc W Unit
cfh-main =
  bind h-args (λ av →
    if cfh-has-flag "--audit" av
    then bind (cfh-cycle #1 false) (λ u → exit #0)
    else if cfh-has-flag "--execute" av
    then bind (cfh-cycle #1 true) (λ u → exit #0)
    else if cfh-has-flag "--daemon" av
    then cfh-loop (toNat #50000) #1
    else ret {lzero} {W} unit)

cfh-run : Step W Unit
cfh-run = to-step cfh-main

#run cfh-run
