grid-diff-equiv : (B : Word) → wlt #0 B ≡ true → Equiv (List (List (Bounded B))) (List (List (Bounded B)))
grid-diff-equiv B hB =
  isoToEquiv (grid-diff-mod B hB) (grid-undiff-mod B hB)
    (λ g → concat {lzero} {List (List (Bounded B))}
             {col-diff-mod-go B nil (list-map (diff-mod-go B (#0 , hB)) (list-map (undiff-mod-go B (#0 , hB)) (col-undiff-mod-go B nil g)))}
             {col-diff-mod-go B nil (col-undiff-mod-go B nil g)} {g}
             (cong {lzero} {lzero} {List (List (Bounded B))} {List (List (Bounded B))} (col-diff-mod-go B nil)
               (concat {lzero} {List (List (Bounded B))}
                 {list-map (diff-mod-go B (#0 , hB)) (list-map (undiff-mod-go B (#0 , hB)) (col-undiff-mod-go B nil g))}
                 {list-map (λ r → diff-mod-go B (#0 , hB) (undiff-mod-go B (#0 , hB) r)) (col-undiff-mod-go B nil g)}
                 {col-undiff-mod-go B nil g}
                 (cm-map-comp (diff-mod-go B (#0 , hB)) (undiff-mod-go B (#0 , hB)) (col-undiff-mod-go B nil g))
                 (cm-map-id (λ r → diff-mod-go B (#0 , hB) (undiff-mod-go B (#0 , hB) r)) (diff-undiff-mod-go B (#0 , hB)) (col-undiff-mod-go B nil g))))
             (col-diff-undiff-go B nil g))
    (λ g → concat {lzero} {List (List (Bounded B))}
             {list-map (undiff-mod-go B (#0 , hB)) (col-undiff-mod-go B nil (col-diff-mod-go B nil (list-map (diff-mod-go B (#0 , hB)) g)))}
             {list-map (undiff-mod-go B (#0 , hB)) (list-map (diff-mod-go B (#0 , hB)) g)} {g}
             (cong {lzero} {lzero} {List (List (Bounded B))} {List (List (Bounded B))} (list-map (undiff-mod-go B (#0 , hB)))
               (col-undiff-diff-go B nil (list-map (diff-mod-go B (#0 , hB)) g)))
             (concat {lzero} {List (List (Bounded B))}
               {list-map (undiff-mod-go B (#0 , hB)) (list-map (diff-mod-go B (#0 , hB)) g)}
               {list-map (λ r → undiff-mod-go B (#0 , hB) (diff-mod-go B (#0 , hB) r)) g} {g}
               (cm-map-comp (undiff-mod-go B (#0 , hB)) (diff-mod-go B (#0 , hB)) g)
               (cm-map-id (λ r → undiff-mod-go B (#0 , hB) (diff-mod-go B (#0 , hB) r)) (undiff-diff-mod-go B (#0 , hB)) g)))
