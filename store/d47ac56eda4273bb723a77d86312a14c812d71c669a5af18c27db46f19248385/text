-- a rank on the atoms, used to tell them apart and to choose representatives
vln-rank : Vln → Nat
vln-rank x = case x of
  vl-c1 → 0
  vl-o1 → 1
  vl-o2 → 2
  vl-ho → 3
  vl-ca → 4
  vl-ha → 5
  vl-n → 6
  vl-hn1 → 7
  vl-hn2 → 8
  vl-cb → 9
  vl-hb → 10
  vl-cg1 → 11
  vl-g11 → 12
  vl-g12 → 13
  vl-g13 → 14
  vl-cg2 → 15
  vl-g21 → 16
  vl-g22 → 17
  vl-g23 → 18
