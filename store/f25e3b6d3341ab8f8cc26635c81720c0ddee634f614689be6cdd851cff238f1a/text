ftbl-inc-all : (tbl : FTbl) → (x : Word) → (ys : List Word) → AllInFTbl tbl ys → AllInFTbl (ftbl-inc x tbl) ys
ftbl-inc-all tbl x ys =
  case ys return (λ u → AllInFTbl tbl u → AllInFTbl (ftbl-inc x tbl) u) of
    nil → λ _ → unit
    cons y r → λ h →
      let hy = fst h
          C = fst hy
          f = fst (snd hy)
          hf = fst (snd (snd hy))
          hp = snd (snd (snd hy))
      in (ftbl-inc-keep tbl #0 x y C f hf hp , rec r (snd h))
