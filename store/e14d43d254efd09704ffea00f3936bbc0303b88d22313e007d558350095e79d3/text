-- (part of language-support)
mul_spec_32 : (dst' : Bits #32) → (src : Bits #32) → ((Bits #32) × (Bits #32) × (Bits #64))
mul_spec_32 dst' src =
  let product : Bits #64
      product = (bits_of_int (z-mul (bv-unsigned #32 dst') (bv-unsigned #32 src)) (zpos #64))
      product_high : Bits #32
      product_high = (bv-slice #64 product #63 #32)
      product_low : Bits #32
      product_low = (bv-slice #64 product #31 #0)
  in (product_high , product_low , product)
