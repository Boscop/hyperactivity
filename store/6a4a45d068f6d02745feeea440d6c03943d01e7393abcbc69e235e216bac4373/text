-- swapping the parts reverses order
zle-swap : (a b : Nat × Nat) → zle b a → zle (snd a , fst a) (snd b , fst b)
zle-swap a b h = le-cong-r (plus (snd a) (fst b)) (plus (fst a) (snd b)) (plus (snd b) (fst a))
  (le-cong-l (plus (fst b) (snd a)) (plus (snd a) (fst b)) (plus (fst a) (snd b)) h (plus-comm (fst b) (snd a)))
  (plus-comm (fst a) (snd b))
