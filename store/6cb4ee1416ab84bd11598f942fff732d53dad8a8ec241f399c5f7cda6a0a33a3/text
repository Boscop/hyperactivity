-- Distance of a zero's real part from the critical line Re(s) = 1/2 (in rational grid units 1/20,
-- so 0 means EXACTLY Re(rho) = 1/2, and d > 0 means off-line deviation d/20!)
ms-on-critical-line : Nat → Bool
ms-on-critical-line zero = true
ms-on-critical-line (suc _) = false

-- Exterior-zero indicator for half-width alpha >= 1: zero lies OUTSIDE |Re(rho) - 1/2| < alpha iff alpha <= dev
ms-is-exterior : Nat → Nat → Bool
ms-is-exterior alpha dev = rh-le alpha dev

-- Universal check: a zero has deviation `dev` with NO exterior witness at alpha = 1 iff `dev == 0` (on Re=1/2!)
ms-thm-no-exterior-iff-critical-fwd : (dev : Nat) →
  ms-is-exterior (suc zero) dev ≡ false → dev ≡ zero
ms-thm-no-exterior-iff-critical-fwd zero _ = refl
ms-thm-no-exterior-iff-critical-fwd (suc d) h = Empty-rec (true≢false h)

ms-thm-no-exterior-iff-critical-bwd : (dev : Nat) →
  dev ≡ zero → ms-is-exterior (suc zero) dev ≡ false
ms-thm-no-exterior-iff-critical-bwd dev h = λ i → ms-is-exterior (suc zero) (h i)

-- List of all nontrivial zeros in a finite spectral window, represented by their critical-line deviations
ms-all-on-line : List Nat → Bool
ms-all-on-line nil = true
ms-all-on-line (cons d ds) = andB (ms-on-critical-line d) (ms-all-on-line ds)

ms-exterior-count : Nat → List Nat → Nat
ms-exterior-count _ nil = zero
ms-exterior-count alpha (cons d ds) =
  if ms-is-exterior alpha d then suc (ms-exterior-count alpha ds)
  else ms-exterior-count alpha ds

-- Helper: suc k == zero is absurd
ms-suc-ne-zero : {A : Type} → {k : Nat} → suc k ≡ zero → A
ms-suc-ne-zero {A} {k} h =
  Empty-rec (true≢false (λ i → ms-on-critical-line (h (~ i))))

