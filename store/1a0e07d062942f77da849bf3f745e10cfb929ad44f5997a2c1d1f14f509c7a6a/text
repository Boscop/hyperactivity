pl-bot : BQ → BQ → BQ → BQ → List (List BQ) → List (List BQ) → List (List (BQ × (BQ × BQ))) → List (List BQ)
pl-bot c lam l p hs ss ws = case hs of
  nil → nil
  cons h hr → (case ss of
    nil → nil
    cons s sr → (case ws of
      nil → nil
      cons w wr → cons (pl-app h (pl-g-row c lam l p h s w)) (pl-bot c lam l p hr sr wr)))
