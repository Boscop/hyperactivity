-- every system of a body with its sides restricted
nk-rall : NkTm → NkTm
nk-rall (nk-lam b) = nk-lam (nk-rall b)
nk-rall (nk-susp b) = nk-susp (nk-rall b)
nk-rall (nk-con c as) = if %weq c #30 then nk-con c (nk-sys-restrict (nk-rall as)) else nk-con c (nk-rall as)
nk-rall (nk-op h p as) = nk-op h (nk-rall p) (nk-rall as)
nk-rall (nk-match h p cs) = nk-match h (nk-rall p) (nk-rall cs)
nk-rall (nk-cons t r) = nk-cons (nk-rall t) (nk-rall r)
nk-rall t = t
