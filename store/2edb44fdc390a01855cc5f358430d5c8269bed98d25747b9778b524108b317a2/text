omni-cuda-gates : Word → List (Word × Word) → List Word → List Word
omni-cuda-gates idx nil tail =
  hw-ln (list-append "  return w" (list-append (ce-dec (%wsub idx #1)) ";"))
  (hw-ln "}" (hw-ln nil tail))
omni-cuda-gates idx (cons g gs) tail =
  hw-ln (list-append "  uint32_t w" (list-append (ce-dec idx)
        (list-append " = ~(w" (list-append (ce-dec (fst g))
        (list-append " & w" (list-append (ce-dec (snd g)) ");"))))))
        (omni-cuda-gates (%wadd idx #1) gs tail)
