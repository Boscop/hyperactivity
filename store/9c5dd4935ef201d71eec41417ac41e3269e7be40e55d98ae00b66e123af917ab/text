sg-decl-ctors : Nat → Word → List Word → Word → Lst (List Word) → Lst Code → Lst NkSexp → Lst Code
sg-decl-ctors _ _ _ _ _ _ lnil = lnil
sg-decl-ctors cf d dsym np ds pcts (lcons ct rest) =
  let flds = sg-sx-tl (sg-sx-tl (sg-sx-items ct))
      cbody = sg-decl-fields cf d dsym np #0 ds flds
  in lcons (sg-wrap-pis pcts cbody) (sg-decl-ctors cf d dsym np ds pcts rest)
