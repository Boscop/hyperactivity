hy-stated-kept : List Word → List Word → List Word → Sum Unit (List Word) → Proc W (Sum Unit (List Word × List Word))
hy-stated-kept st h path (inr c) = ret (hy-stated-read (h-lines c))
hy-stated-kept st h path (inl u) = bind (hy-get st (list-append h "/text")) (λ t → hy-stated-keep st path (hy-stated-of (hy-or nil t)))
