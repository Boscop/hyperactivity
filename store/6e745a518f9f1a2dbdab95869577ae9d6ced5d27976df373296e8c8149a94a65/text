secSigProp : {l : Level} {A : Type l} (B : A → Type) (pB : (a : A) → isProp (B a)) (u v : (a : A) × B a) (p : u ≡ v) → SigProp B pB u v (congFst p) ≡ p
secSigProp B pB u v p =
  let sg = λ i → snd (SigProp B pB u v (congFst p) i)
  in λ j i →
       (fst (p i)
       , isPropToPathP (λ m → Path (B (fst (p m))) (sg m) (snd (p m)))
           (propPathProp (pB (fst u)) (snd u) (snd u)) (propPathProp (pB (fst v)) (snd v) (snd v))
           (λ m → propPathProp (pB (fst (p m))) (sg m) (snd (p m)))
           (λ m → snd u) (λ m → snd v) i j)
