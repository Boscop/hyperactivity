-- over the folds c from k to 15 with their counts h: the most contacts among realized folds, and how many folds reach it
sl-max : Nat → Nat → List Nat → Nat
sl-max s k h = case h of
  nil → 0
  cons n rest → (if eqb n 0 then sl-max s (suc k) rest else (if leb (sl-max s (suc k) rest) (sl-hh s k) then sl-hh s k else sl-max s (suc k) rest))
