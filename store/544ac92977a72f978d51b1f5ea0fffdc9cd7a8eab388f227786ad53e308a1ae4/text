a64-applies : Enc → Tbl → XEnv → Word → Lst Word → Lst Code → Lst Word
a64-applies ce tbl env d bs lnil = bs
a64-applies ce tbl env d bs (lcons a r) =
  a64-applies ce tbl env d
    (xcat5 bs a64-push-x0 (ce env (%wsucc d) a) a64-push-x0 (l-app (a64-call-off (x-tbl tbl x-apply-key)) (a64-drop-slots #2))) r
