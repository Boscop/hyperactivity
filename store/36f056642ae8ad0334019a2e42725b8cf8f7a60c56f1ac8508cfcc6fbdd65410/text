-- an automorphism of the left molecule composed into an atom map is again an atom map: relabel the
-- reactant first, then map. So no atom map is distinguished — the symmetric hydrogens of a methyl
-- group can be sent to the product's in any of the ways the automorphism group allows.
am-after-auto : (L : Mol) → (R : Mol) → AtomMap L R → Auto L → AtomMap L R
am-after-auto L R m a =
  ( (λ x → am-fun L R m (auto-fun L a x))
  , (λ y → auto-inv-fun L a (am-inv-fun L R m y))
  , (λ x → concat (cong (auto-inv-fun L a) (am-gf L R m (auto-fun L a x))) (auto-gf L a x))
  , (λ y → concat (cong (am-fun L R m) (auto-fg L a (am-inv-fun L R m y))) (am-fg L R m y))
  , (λ x → concat (am-el L R m (auto-fun L a x)) (auto-el L a x)) )
