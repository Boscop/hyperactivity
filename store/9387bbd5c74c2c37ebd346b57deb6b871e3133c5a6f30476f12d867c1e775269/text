nk-answer : NkSlot → Word
nk-answer (nks-val (nkv-num m)) = m
nk-answer (nks-val (nkv-lam b e)) = #999999
nk-answer (nks-val (nkv-ref w)) = #999998
nk-answer (nks-val (nkv-var x)) = #999991
nk-answer (nks-val (nkv-napp f a)) = #999991
nk-answer (nks-val (nkv-ninc a)) = #999991
nk-answer nks-none = #999997
nk-answer (nks-op o) = #999996
nk-answer (nks-pair o v) = #999995
