-- a word as decimal digits, the emitter's own: the library holds no decimal printer at this point
ce-digits : Nat → Word → List Word → List Word
ce-digits zero w acc = acc
ce-digits (suc k) w acc = if %wlt w #10 then cons (%wadd w #48) acc else ce-digits k (%wdiv w #10) (cons (%wadd (%wsub w (%wmul (%wdiv w #10) #10)) #48) acc)
