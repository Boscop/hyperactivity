eqBits-sound : (n : Nat) → (a b : BitVec n) → isTrue (eqBits n a b) → a ≡ b
eqBits-sound zero a b e = unit-eq a b
eqBits-sound (suc n) a b e = λ i → (beq-sound (fst a) (fst b) (and-fst {beq (fst a) (fst b)} {eqBits n (snd a) (snd b)} e) i , eqBits-sound n (snd a) (snd b) (and-snd {beq (fst a) (fst b)} {eqBits n (snd a) (snd b)} e) i)
