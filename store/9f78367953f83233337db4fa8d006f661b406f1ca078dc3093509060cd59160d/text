cm-add-subw-le : (a b : Word) → ltw a b ≡ false → wadd b (subw a b) ≡ a
cm-add-subw-le a =
  %welimP (λ v → (b : Word) → ltw v b ≡ false → wadd b (subw v b) ≡ v) a
    (λ b → %welimP (λ v → ltw #0 v ≡ false → wadd v (subw #0 v) ≡ #0) b
             (λ h i → #0)
             (λ m g h → cm-tf-absurd h))
    (λ n ih → cm-add-sub-step n ih)
