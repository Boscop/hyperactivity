-- 2. §4.5 Cubical Contradiction 1-Cycle Prune & Zero-Allocation Theorem:
--    Any active pair whose merged face clause contradicts (`clause-ok 4 (clause-meet 4 cA cB) ≡ false`,
--    which by `clause-conflict-unsat` in `inet.cub` has NO satisfying interval assignment) is pruned
--    in 1 cycle with ZERO local SRAM node allocations (`freePtr` invariant).
inet-hw-conflict-prunes-zero-alloc :
  (a c p fp g : Nat) →
  (kA : InetNodeKind) → (tA : Word) → (cA : ClauseVec (toNat #4)) →
  (kB : InetNodeKind) → (tB : Word) → (cB : ClauseVec (toNat #4)) →
  clause-ok (toNat #4) (clause-meet (toNat #4) cA cB) ≡ false →
  (ihw-prune-count (inet-hw-step (ihw a c p fp g) true (iapair kA tA cA kB tB cB)) ≡ suc p) ×
  (ihw-free-ptr    (inet-hw-step (ihw a c p fp g) true (iapair kA tA cA kB tB cB)) ≡ fp)
inet-hw-conflict-prunes-zero-alloc a c p fp g kA tA cA kB tB cB hBad =
  ( (λ i → ihw-prune-count (inet-hw-fire (ihw a c p fp g) (iapair kA tA cA kB tB cB) (hBad i)))
  , (λ i → ihw-free-ptr    (inet-hw-fire (ihw a c p fp g) (iapair kA tA cA kB tB cB) (hBad i))) )
