-- a path's meaning from the meaning of its body under a new dimension
uirx : (n : Nat) (X X' : Type 1) (F : X → Type 1) (F' : X' → Type 1) (f : X → X') (g : (x : X) → F x → F' (f x)) (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → DCube n X (λ x → F' (f x)) c) (dcube-unreidx n X X' F' f c (dcube-reidx n X X' F F' f g c d)) (dcube-fmap n X F (λ x → F' (f x)) g c d)
uirx zero X X' F F' f g c d = λ i → g c d
uirx (suc n) X X' F F' f g c d = uirx n (Line X) (Line X') (LineO X F) (LineO X' F') (line-map X X' f) (lineo-reidx X X' F F' f g) c d
