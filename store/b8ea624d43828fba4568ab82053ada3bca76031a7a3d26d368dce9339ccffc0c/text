s256-expand-go : Nat → Word → List Word → List Word
s256-expand-go zero _ revw = cli-rev revw nil
s256-expand-go (suc rem) i revw =
  let w2  = s256-nth #1 revw
      w7  = s256-nth #6 revw
      w15 = s256-nth #14 revw
      w16 = s256-nth #15 revw
      wn  = s256-add (s256-add (s256-s1 w2) w7) (s256-add (s256-s0 w15) w16)
  in s256-expand-go rem (%wsucc i) (cons wn revw)
