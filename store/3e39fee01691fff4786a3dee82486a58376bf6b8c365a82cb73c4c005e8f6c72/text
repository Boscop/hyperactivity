-- ============================================================================
-- 2. Exact Classical Bell–CHSH Bound (|S| ≤ 2) & Quantum Tsirelson SOS Bound (S² ≤ 8)
-- ============================================================================
-- Classical CHSH identity: for S = a0(b0 + b1) + a1(b0 - b1),
--   4 - S² = 4 - (a0²(b0+b1)² + a1²(b0-b1)² + 2 a0 a1 (b0² - b1²)).
-- Setting a0² = a1² = b0² = b1² = 1 gives (b0+b1)² + (b0-b1)² = 2(b0² + b1²) = 4 and b0²-b1² = 0!
-- Universal algebraic certificate over `al-id` (4 variables: a0, a1, b0, b1):
--   (a0(b0+b1) + a1(b0-b1))² = a0²(b0+b1)² + a1²(b0-b1)² + 2 a0 a1 (b0² - b1²),
--   and (b0+b1)² + (b0-b1)² = 2(b0² + b1²).
rqm-chsh-square-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
rqm-chsh-square-poly A ad mu q vs =
  (λ g sub sq →
    let a0 = g 0; a1 = g 1; b0 = g 2; b1 = g 3
        q2 = q (fn-q 2 1)
        bp = ad b0 b1
        bm = sub b0 b1
        S = ad (mu a0 bp) (mu a1 bm)
        lhs = sq S
        rhs = ad (ad (mu (sq a0) (sq bp)) (mu (sq a1) (sq bm)))
                 (mu q2 (mu a0 (mu a1 (sub (sq b0) (sq b1)))))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
