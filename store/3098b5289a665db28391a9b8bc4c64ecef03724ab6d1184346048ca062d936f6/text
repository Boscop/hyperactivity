-- (2k + (1 − x)) + (R1 + 1) + D = 2D, the step behind the remainder's bound
rem-alg : (x : Bool) → (k1 R R1 D T : Nat) → plus k1 (suc R) ≡ D → plus R1 D ≡ T → T ≡ plus (bitn x) (times 2 R) → plus D (plus (plus (times 2 k1) (bitn (not x))) (suc R1)) ≡ plus D D
rem-alg x k1 R R1 D T h1 h2 h3 =
  transN (plus-comm D (plus (plus (times 2 k1) (bitn (not x))) (suc R1)))
  (transN (plus-assoc (plus (times 2 k1) (bitn (not x))) (suc R1) D)
  (transN (congN (λ z → plus (plus (times 2 k1) (bitn (not x))) (suc z)) (transN h2 h3))
  (transN (plus-assoc (times 2 k1) (bitn (not x)) (suc (plus (bitn x) (times 2 R))))
  (transN (congN (plus (times 2 k1)) (transN (plus-suc (bitn (not x)) (plus (bitn x) (times 2 R)))
            (congN suc (transN (symN (plus-assoc (bitn (not x)) (bitn x) (times 2 R))) (congN (λ z → plus z (times 2 R)) (notx-x x))))))
  (transN (congN (plus (times 2 k1)) (symN (times2-suc R)))
  (transN (symN (times2-plus k1 (suc R)))
  (transN (congN (times 2) h1)
  (congN (plus D) (plus-zero D)))))))))
