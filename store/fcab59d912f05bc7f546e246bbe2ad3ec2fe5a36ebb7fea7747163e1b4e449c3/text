nk-fo-bcar : (as : NkTm) → (nk-fo-tm as ≡ true) → nk-fo-tm (nk-bcar as) ≡ true
nk-fo-bcar (nk-cons a d) h = nk-and-l (nk-fo-tm a) (nk-fo-tm d) h
nk-fo-bcar (nk-var i) h = refl
nk-fo-bcar (nk-free x) h = refl
nk-fo-bcar (nk-num m) h = refl
nk-fo-bcar (nk-lam b) h = refl
nk-fo-bcar (nk-susp b) h = refl
nk-fo-bcar (nk-con c as) h = refl
nk-fo-bcar (nk-op op p as) h = refl
nk-fo-bcar (nk-match op p cs) h = refl
nk-fo-bcar nk-nil h = refl
