-- Constant-Time Non-Interference Theorem: hardened pipeline leaks ZERO secret bits for all idx and bounds!
slh-noninterference : (idx bound : Nat) → (s1 s2 : Nat → Nat) →
  ((i : Nat) → fd-ltb i bound ≡ true → s1 i ≡ s2 i) →
  spec-slh-obs idx bound s1 ≡ spec-slh-obs idx bound s2
slh-noninterference idx bound s1 s2 pub = slh-branch idx bound s1 s2 pub (fd-ltb idx bound) refl
