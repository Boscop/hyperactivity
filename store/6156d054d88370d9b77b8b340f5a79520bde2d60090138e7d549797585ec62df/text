-- ∪ is merge
munion : {o : Ord} {x y : Bag (El o)} → Fs x → Fs y → Fs {o} (un x y)
munion hx hy =
  (merge (fst hx) (fst hy)
  , λ a →
      eqb-complete
        (transN (merge-count a (fst hx) (fst hy))
           (cong2N plus (eqb-sound {count a (fst hx)} {countB a x} (fst (snd hx) a))
              (eqb-sound {count a (fst hy)} {countB a y} (fst (snd hy) a))))
  , merge-sorted {o} {fst hx} {fst hy} (snd (snd hx)) (snd (snd hy)))
