-- ── 4. Exact Orthogonal 4x4 Hadamard Mixing (Lossless Multi-Channel / FDN) ──
-- ||H4 x||^2 = 4 * ||x||^2 identically over Q (energy-preserving acoustic diffusion).
-- Variables (0..3): x0, x1, x2, x3.
wave-hadamard4-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wave-hadamard4-poly A ad mu q vs =
  (λ g sub sq →
    let x0 = g 0; x1 = g 1; x2 = g 2; x3 = g 3
        y0 = ad (ad x0 x1) (ad x2 x3)
        y1 = ad (sub x0 x1) (sub x2 x3)
        y2 = sub (ad x0 x1) (ad x2 x3)
        y3 = sub (sub x0 x1) (sub x2 x3)
        lhs = ad (ad (sq y0) (sq y1)) (ad (sq y2) (sq y3))
        rhs = mu (q (fn-q 4 1)) (ad (ad (sq x0) (sq x1)) (ad (sq x2) (sq x3)))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
