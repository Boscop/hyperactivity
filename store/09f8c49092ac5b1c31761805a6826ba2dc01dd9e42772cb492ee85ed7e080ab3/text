-- GET /peer/manifest : this sovereign peer node's publicly curated works, root hash, and P2P/DHT port routes
s-peer-manifest : List Word → Proc W (List Word)
s-peer-manifest m =
  bind (h-read "root") (λ r0 →
  bind (s-peer-root-1 m r0) (λ rt →
  ret {lzero} {W} (s-response "application/json" (h-concat (cons "{" (
    cons (s-cj-str "root") (cons ":" (cons (s-cj-str rt) (cons "," (
    cons (s-cj-str "works") (cons ":[" (cons (s-commas (list-map s-work-manifest-entry s-published)) (cons "]," (
    cons (s-cj-str "kg") (cons ":" (cons (s-cj-str "/api/kg/index") (cons "," (
    cons (s-cj-str "source") (cons ":" (cons (s-cj-str "/source/text") (cons "," (
    cons (s-cj-str "packs") (cons ":" (cons (s-cj-str "/packs/") (cons "," (
    cons (s-cj-str "roots") (cons ":" (cons (s-cj-str "/roots/") (cons "," (
    cons (s-cj-str "peers") (cons ":" (cons (s-cj-str "/dht/peers") (cons "," (
    cons (s-cj-str "dht") (cons ":" (cons (s-cj-str "/dht/find/") (cons "," (
    cons (s-cj-str "reduce") (cons ":" (cons (s-cj-str "/peer/reduce") (cons "}" nil)))))))))))))))))))))))))))))))))))))))))
