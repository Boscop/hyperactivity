-- ---------------------------------------------------------------- a message with a type tag
-- a 32-byte message: a 4-byte type at 0; type 1 carries a 64-bit price at 8, type 2 a 64-bit
-- quantity at 16; the field read depends on the tag. Every bound is at a literal offset
decode-msg : Bytes 32 → Word
decode-msg b =
  case weq (u32toWord (load32 32 b 0 (28 , λ i → 32))) #1 of
    true → i64toWord (load64 32 b 8 (16 , λ i → 32))
    false → i64toWord (load64 32 b 16 (8 , λ i → 32))
