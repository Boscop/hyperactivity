lqg-pachner-23-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-pachner-23-poly A ad mu q vs =
  (λ g sub →
    let V = g 0; E = g 1; F = g 2; T = g 3
        chi0 = sub (ad V F) (ad E T)
        chi1 = sub (ad V (ad F (q (fn-q 2 1))))
                   (ad (ad E (q (fn-q 1 1))) (ad T (q (fn-q 1 1))))
    in (chi1 , chi0))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
