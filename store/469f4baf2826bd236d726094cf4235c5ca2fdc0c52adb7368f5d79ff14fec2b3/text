-- Theorem (cs-hy-bop-no-ub): EVERY binary Word helper 0..12 (and fallback hy_bad2) emitted by
-- lib/emit-c.cub is completely free of C11 Undefined Behaviour on all 64-bit unsigned words
cs-hy-bop-no-ub : (j : Word) (hp : CsHeap) (a b : Word) →
  cs-no-ub (cs-hy-bop j hp (csv-word a) (csv-word b)) ≡ true
cs-hy-bop-no-ub j hp a b =
  let e12 = cs-hy-shr hp a b
      r12 = if %weq j #12 then e12 else cso-abort
      e11 = cs-hy-shl hp a b
      r11 = if %weq j #11 then e11 else r12
      e10 = cso-ok hp (csv-word (%wxor a b))
      r10 = if %weq j #10 then e10 else r11
      e9 = cso-ok hp (csv-word (%wor a b))
      r9 = if %weq j #9 then e9 else r10
      e8 = cso-ok hp (csv-word (%wand a b))
      r8 = if %weq j #8 then e8 else r9
      e7 = cs-hy-mod hp a b
      r7 = if %weq j #7 then e7 else r8
      e6 = cs-hy-div hp a b
      r6 = if %weq j #6 then e6 else r7
      e5 = cs-hy-mul hp a b
      r5 = if %weq j #5 then e5 else r6
      e4 = cs-hy-sub hp a b
      r4 = if %weq j #4 then e4 else r5
      e3 = cs-hy-max hp a b
      r3 = if %weq j #3 then e3 else r4
      e2 = cs-hy-add hp a b
      r2 = if %weq j #2 then e2 else r3
      e1 = cs-hy-con hp (if %wlt a b then #0 else #1) lnil
      r1 = if %weq j #1 then e1 else r2
      e0 = cs-hy-con hp (if %weq a b then #0 else #1) lnil
      p12 = cs-no-ub-ite (%weq j #12) e12 cso-abort (cs-hy-shr-no-ub hp a b) refl
      p11 = cs-no-ub-ite (%weq j #11) e11 r12 (cs-hy-shl-no-ub hp a b) p12
      p10 = cs-no-ub-ite (%weq j #10) e10 r11 refl p11
      p9 = cs-no-ub-ite (%weq j #9) e9 r10 refl p10
      p8 = cs-no-ub-ite (%weq j #8) e8 r9 refl p9
      p7 = cs-no-ub-ite (%weq j #7) e7 r8 (cs-hy-mod-no-ub hp a b) p8
      p6 = cs-no-ub-ite (%weq j #6) e6 r7 (cs-hy-div-no-ub hp a b) p7
      p5 = cs-no-ub-ite (%weq j #5) e5 r6 (cs-no-ub-ite (cs-w64 (%wmul a b)) (cso-ok hp (csv-word (%wmul a b))) cso-abort refl refl) p6
      p4 = cs-no-ub-ite (%weq j #4) e4 r5 refl p5
      p3 = cs-no-ub-ite (%weq j #3) e3 r4 refl p4
      p2 = cs-no-ub-ite (%weq j #2) e2 r3 (cs-no-ub-ite (cs-w64 (%wadd a b)) (cso-ok hp (csv-word (%wadd a b))) cso-abort refl refl) p3
      p1 = cs-no-ub-ite (%weq j #1) e1 r2 refl p2
  in cs-no-ub-ite (%weq j #0) e0 r1 refl p1
