-- Higher-Order λ-Application (`APP` meeting `LAM`, both `CON` tag `#0`) IS 1-Step `CON–CON` Annihilation:
beta-is-con-annihilate :
  (varP bodyP argP retP : Word) → (l : Nat) → (f0 f1 : Word) → (rest : List Word) →
  urewrite-pair (ucell uc-con #0 clause4-top varP bodyP)
                (ucell uc-con #0 clause4-top argP retP) l f0 f1 rest
  ≡ urw-annihilate (varP , argP) (bodyP , retP)
beta-is-con-annihilate varP bodyP argP retP l f0 f1 rest = refl
