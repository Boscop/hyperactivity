-- runp p w st: the process interpreted in the state monad over St with refusal
runp : {S : Sig} {A : Type} {St : Type} → Proc S A → World S St → St → Outcome A × St
runp p w st =
  p (St → Outcome A × St) (λ a s → (done a , s))
    (λ c k s → case w c s of inl r → k (fst r) (snd r); inr s2 → (stopped , s2))
    st
