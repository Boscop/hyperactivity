acm-main args =
  let frag    = acm-fragment-html
      hxFrame = sov-pack-pkt sov-test-secret (sov-pkt pk-witness #401 #2800 #42 #60 #8080)
  in scmd (w-file-read-named "/tmp/hy_out/hx_live_human_node.html") (λ rNode →
     scmd (w-file-read-named "/tmp/hy_out/hx_universal_launch.html") (λ rPrev →
     let mergedNode   = acm-splice-between acm-start-tag acm-end-tag frag (snd rNode)
         mergedLaunch = acm-splice-between acm-start-tag acm-end-tag frag (snd rPrev)
     in scmd (w-file-write-named "/tmp/hy_out/hx_live_human_node.html" mergedNode) (λ bNode →
        scmd (w-file-write-named "/tmp/hy_out/hx_universal_launch.html" mergedLaunch) (λ bLaunch →
        scmd (w-file-write-named "/tmp/hy_out/hx_all_crypto_fragment.html" frag) (λ bFrag →
        scmd (w-file-write-named "/tmp/hx_agent_bus/all_crypto_matrix.hxsv" hxFrame) (λ bHx →
        tmc-broadcast-cps acm-self-slice "LIVE_ALL_CRYPTO_MATRIX_MOUNTED_8080"
          "eff-mount-ui(02E_ALL_PUBLIC_CRYPTO_2800_COINS * BINANCE_WSS * HL_WSS * CB_WSS * 60FPS_LAFONT_FLOW_CANVAS * 1CLICK_COLLAB_STEER) -> http://localhost:8080/ + /launch"
          (cli-say (list-append "[HX-ALL-CRYPTO-MATRIX] Hot-streamed 02E All-Crypto Visual Flow Matrix into http://localhost:8080/ (node="
                     (list-append (ce-dec bNode) (list-append "B, launch=" (list-append (ce-dec bLaunch) "B)"))))
