ms-emit-sv-list : List MetaCircuit → List Word → List Word
ms-emit-sv-list nil tl = tl
ms-emit-sv-list (cons (mcirc nm _ _ gs) rest) tl =
  let ng = ms-count-gates gs
  in ms-cat
       (cons "module hx_meta_" (cons nm (cons "(input logic w0, input logic w1, input logic w2, input logic w3, output logic y);" (cons ce-nl
       (cons (ms-sv-gates #4 gs
         (ms-cat (cons "  assign y = w" (cons (ce-dec (%wadd #3 ng)) (cons ";" (cons ce-nl
                 (cons "endmodule" (cons ce-nl (cons (ms-emit-sv-list rest tl) nil))))))))) nil)))))
