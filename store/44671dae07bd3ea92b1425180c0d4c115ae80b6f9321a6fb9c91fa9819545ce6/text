kv-rep-recv : KvRep → Rcv KvMsg → KvRep
kv-rep-recv st r = case r of
  r-timeout → st
  r-msg from m → (case m of
     m-put w → KvRep { r-log = cons w (r-log st) ; r-app = r-app st ; r-pend = kp-ack from w }
     m-ack w → st
     m-get k rid → KvRep { r-log = r-log st ; r-app = r-app st ; r-pend = kp-val from rid (kv-store (r-app st) k) }
     m-val rid v → st)
