sg-decl-fields : Nat → Word → List Word → Word → Word → Lst (List Word) → Lst NkSexp → Code
sg-decl-fields _ d _ np nf _ lnil = cdata d (sg-decl-ret-args nf np)
sg-decl-fields cf d dsym np nf ds (lcons fld rest) =
  let it = sg-sx-items fld
      nm = sg-dc-bname #0 (sg-sx0 it)
      f0 = fst (sg-subst-self cf #0 dsym (sg-sx1 it) lnil)
      df = fst (snd (sg-dc cf #0 #0 ds #0 f0 lnil))
      cfld = fst (sg-tc cf #0 nk-nil ds #0 #0 #0 df lnil)
  in cpi #2 cfld (sg-decl-fields cf d dsym np (%wsucc nf) (lcons nm ds) rest)
