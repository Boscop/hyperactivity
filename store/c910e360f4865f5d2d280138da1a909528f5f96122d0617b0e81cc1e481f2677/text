si-cmp-ok : (n : Nat) → (B : Bytes n) → (c : List (List Word)) → (o : Word) → (L : List (List Word)) → si-rep n B o L → si-cmp n B c o ≡ lexle (lexle word-le) c L
si-cmp-ok n B c = case c return λ w → (o : Word) → (L : List (List Word)) → si-rep n B o L → si-cmp n B w o ≡ lexle (lexle word-le) w L of
  nil → λ o L h i → true
  cons x r → λ o L → case L return λ v → si-rep n B o v → si-cmp n B (cons x r) o ≡ lexle (lexle word-le) (cons x r) v of
    nil → λ h i → if weq (h i) #1 then lex-step (lexle word-le x (si-tok n B o)) (lexle word-le (si-tok n B o) x) (si-cmp n B r (si-next n B o)) else false
    cons y L2 → λ h → concat
      (λ i → if weq (fst h i) #1 then lex-step (lexle word-le x (si-tok n B o)) (lexle word-le (si-tok n B o) x) (si-cmp n B r (si-next n B o)) else false)
      (λ i → lex-step (lexle word-le x (fst (snd h) i)) (lexle word-le (fst (snd h) i) x) (rec r (si-next n B o) L2 (snd (snd h)) i))
