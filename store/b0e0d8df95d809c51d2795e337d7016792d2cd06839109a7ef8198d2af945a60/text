-- a file's records indexed into out (its lines appended), the file cut into pieces of 64 KiB (a
-- larger chunk's process outgrew the machine's memory) in a directory of this run's own
e-index-file : List Word → List Word → List Word → Proc W Bool
e-index-file file syn out = bind h-args (λ a → bind (e-tmp "index") (λ dir → bind (h-mkdir dir) (λ u → bind (h-write (list-append dir "/carry") nil) (λ w →
  bind (e-pieces dir file) (λ ps → bind (e-run-chunks (e-nth zero a) (e-nth (toNat #1) a) syn out dir ps) (λ ok →
  bind (e-cmd (cons "rm" (cons "-rf" (cons dir nil)))) (λ x → ret {lzero} {W} ok)))))))
