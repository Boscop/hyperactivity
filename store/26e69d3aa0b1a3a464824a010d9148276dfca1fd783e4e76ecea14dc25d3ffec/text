bp-rem-fst : (B : Word) → (hB : wlt #0 B ≡ true) → (w : Word) → fst (bp-rem B hB w) ≡ wrem w B
bp-rem-fst B hB w =
  (case wlt (wrem w B) B return (λ b → (e : wlt (wrem w B) B ≡ b) → fst (bp-rem-go B hB w b e) ≡ wrem w B) of
     true → λ e i → wrem w B
     false → λ e → cm-ft-absurd (cm-catb (cm-symb e) (wrem-lt w B hB))) (λ i → wlt (wrem w B) B)
