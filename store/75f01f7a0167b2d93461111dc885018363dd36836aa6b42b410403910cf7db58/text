-- Exact soundness proofs for each local active-pair rewrite rule
tw-lem-mk-xor : (env : Word → Bool) → (a b : INet) → (eq : Bool) → in-eq a b ≡ eq →
  in-eval env (in-mk-xor-c eq a b) ≡ web-xorB (in-eval env a) (in-eval env b)
tw-lem-mk-xor env a b true h =
  web-trans-b (web-sym-b (tw-lem-xor-self (in-eval env a)))
              (λ i → web-xorB (in-eval env a) (tw-thm-eq-sound env a b h i))
tw-lem-mk-xor env in-era b false _ = web-sym-b (tw-lem-xor-false-l (in-eval env b))
tw-lem-mk-xor env (in-wire k) in-era false _ = web-sym-b (tw-lem-xor-false-r (env k))
tw-lem-mk-xor env (in-wire _) (in-wire _) false _ = refl
tw-lem-mk-xor env (in-wire _) (in-con _ _ _) false _ = refl
tw-lem-mk-xor env (in-wire _) (in-dup _ _ _) false _ = refl
tw-lem-mk-xor env (in-con t x y) in-era false _ = web-sym-b (tw-lem-xor-false-r (in-opB t (in-eval env x) (in-eval env y)))
tw-lem-mk-xor env (in-con _ _ _) (in-wire _) false _ = refl
tw-lem-mk-xor env (in-con _ _ _) (in-con _ _ _) false _ = refl
tw-lem-mk-xor env (in-con _ _ _) (in-dup _ _ _) false _ = refl
tw-lem-mk-xor env (in-dup l x y) in-era false _ = web-sym-b (tw-lem-xor-false-r (in-dupB l (in-eval env x) (in-eval env y)))
tw-lem-mk-xor env (in-dup _ _ _) (in-wire _) false _ = refl
tw-lem-mk-xor env (in-dup _ _ _) (in-con _ _ _) false _ = refl
tw-lem-mk-xor env (in-dup _ _ _) (in-dup _ _ _) false _ = refl
