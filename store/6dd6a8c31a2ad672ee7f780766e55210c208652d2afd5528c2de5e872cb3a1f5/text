cx-layout : Target → List CDecl → CRecord → MRes Layout
cx-layout t ds r = case cx-rec-layout r of
  clayout size align dsize nvsize nvalign vptr → mr-map (λ fs →
    Layout { ly-id = cx-rec-id r ; ly-size = size ; ly-align = align ; ly-union = cx-rec-union r
           ; ly-fields = fs ; ly-bases = cx-lay-bases (cx-rec-bases r)
           ; ly-has-vptr = (case vptr of
               cvp-none → false
               cvp-at o → true)
           ; ly-vptr = (case vptr of
               cvp-none → #0
               cvp-at o → o) }) (cx-lay-fields (cx-rec-fields r) t ds)
