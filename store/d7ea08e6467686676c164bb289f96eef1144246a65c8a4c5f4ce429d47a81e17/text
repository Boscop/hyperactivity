inet-eval : Word → INetExpr → Word
inet-eval _   (in-lit w)         = w
inet-eval env in-var0            = bn-w64 env
inet-eval env (in-dup-add x)     = let v = the Word (inet-eval env x) in bn-add64 v v
inet-eval env (in-add a b)       = bn-add64 (inet-eval env a) (inet-eval env b)
inet-eval env (in-xor a b)       = bn-xor64 (inet-eval env a) (inet-eval env b)
inet-eval env (in-era-l _ live)  = inet-eval env live
inet-eval env (in-lut3 m a b c)  = bn-lut3-w64 m (inet-eval env a) (inet-eval env b) (inet-eval env c)
