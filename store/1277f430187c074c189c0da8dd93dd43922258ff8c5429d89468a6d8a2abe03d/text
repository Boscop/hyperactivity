nk-umax : NkTm → NkTm → NkTm
nk-umax la lb =
  let ua = nk-u-lvl-tm la
      ub = nk-u-lvl-tm lb
  in if (if nk-con-is ua #48 then true else nk-con-is ub #48)
       then nk-con #2 (nk-cons (nk-con #48 nk-nil) nk-nil)
       else nk-con #2 (nk-cons (nk-con #47 (nk-cons ua (nk-cons ub nk-nil))) nk-nil)
