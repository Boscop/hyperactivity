-- Proof-projected pin readout check: slot & expected byte come from `ic-out-slots` and `hexpr-eval-hi`/`lo`
ic-expect-slot : Word → Word → List Word
ic-expect-slot slot val =
  sv-concat
    (cons "    uio_in = {1'b1, 3'b000, 3'd" (cons (ic-dec slot)
    (cons ", 1'b0}; #1;" (cons sv-nl
    (cons "    if (uo_out !== 8'd" (cons (ic-dec val)
    (cons ") $fatal(1);" (cons sv-nl nil))))))))
