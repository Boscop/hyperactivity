cx-unit : Target → CTU → Bool → Bool → Word → Word → MRes CxU
cx-unit t tu ltr pf lf cf = mr-map (λ le →
  CxU { cxu-t = t ; cxu-ds = cx-tu-decls tu ; cxu-lay = le ; cxu-ltr = ltr ; cxu-parm-full = pf
      ; cxu-loop-fuel = lf ; cxu-call-fuel = cf }) (cx-layenv (cx-tu-decls tu) t (cx-tu-decls tu))
