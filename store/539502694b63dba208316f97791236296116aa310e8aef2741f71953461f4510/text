-- Negative-space DNA/wormhole lens slit inside the bridge: y = cy ± slitH * (1 - s²)
lens-edge : Nat → Word → Word → SInt → SInt → SInt → SInt → SInt → List Pt2
lens-edge zero n idx ySign cx cy slitW slitH = nil
lens-edge (suc rem) n idx ySign cx cy slitW slitH =
  let s = si-sub (si-div-w (si-mul (sp #20000) (sp idx)) n) (sp #10000)
      s2 = fx-mul s s
      px = si-add cx (fx-mul slitW s)
      py = si-add cy (si-mul ySign (fx-mul slitH (si-sub (sp fx-S) s2)))
  in cons (px , py) (lens-edge rem n (%wsucc idx) ySign cx cy slitW slitH)
