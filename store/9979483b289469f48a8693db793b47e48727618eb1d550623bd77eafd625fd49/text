bn-x86-emit-expr : INetExpr → List Word
bn-x86-emit-expr (in-lit w) =
  list-append (cons #72 (cons #184 nil)) (bn-u64-le (bn-w64 w))
bn-x86-emit-expr in-var0 =
  cons #76 (cons #137 (cons #192 nil))
bn-x86-emit-expr (in-dup-add x) =
  list-append (bn-x86-emit-expr x) (cons #72 (cons #1 (cons #192 nil)))
bn-x86-emit-expr (in-add a b) =
  h-concat
    (cons (bn-x86-emit-expr a)
    (cons (cons #80 nil)
    (cons (bn-x86-emit-expr b)
    (cons (cons #89 (cons #72 (cons #1 (cons #200 nil)))) nil))))
bn-x86-emit-expr (in-xor a b) =
  h-concat
    (cons (bn-x86-emit-expr a)
    (cons (cons #80 nil)
    (cons (bn-x86-emit-expr b)
    (cons (cons #89 (cons #72 (cons #49 (cons #200 nil)))) nil))))
bn-x86-emit-expr (in-era-l _ live) =
  bn-x86-emit-expr live
bn-x86-emit-expr (in-lut3 m a b c) =
  let imm = the Word (%wand m #255)
  in h-concat
       (cons (bn-x86-emit-expr a) (cons (cons #80 nil)
       (cons (bn-x86-emit-expr b) (cons (cons #80 nil)
       (cons (bn-x86-emit-expr c)
       (cons (cons #73 (cons #137 (cons #194 (cons #65 (cons #89 (cons #65 (cons #91 (cons #49 (cons #192 nil)))))))))
       (cons (bn-x86-lut-minterm imm #0)
       (cons (bn-x86-lut-minterm imm #1)
       (cons (bn-x86-lut-minterm imm #2)
       (cons (bn-x86-lut-minterm imm #3)
       (cons (bn-x86-lut-minterm imm #4)
       (cons (bn-x86-lut-minterm imm #5)
       (cons (bn-x86-lut-minterm imm #6)
       (cons (bn-x86-lut-minterm imm #7) nil))))))))))))))
