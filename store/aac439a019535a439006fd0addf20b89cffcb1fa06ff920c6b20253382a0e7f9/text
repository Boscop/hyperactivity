-- valine again, as data. The atoms are numbered in the order of the worked encoding: 0 the carboxyl
-- carbon, 3 the hydroxyl hydrogen, 5 the alpha hydrogen, 7 and 8 the amine hydrogens, 10 the beta
-- hydrogen, 11 to 14 the first methyl with its hydrogens, 15 to 18 the second.
num-val-h : List Nat
num-val-h = cons 3 (cons 5 (cons 7 (cons 8 (cons 10 (cons 12 (cons 13 (cons 14 (cons 16 (cons 17 (cons 18 nil))))))))))
