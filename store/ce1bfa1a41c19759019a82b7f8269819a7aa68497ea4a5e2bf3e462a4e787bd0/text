-- ── 11. Universal Cubical Homotopy Passivity Theorem (I x I Instrument Morph) ─
-- Along ANY cubical path t in [0,1] interpolating two Port-Hamiltonian edge
-- stiffnesses w0 and w1 via w(t) = (1-t)*w0 + t*w1 (or bilinearly on I x I):
--   x0 * w(t)*(x0 - x1) + x1 * w(t)*(x1 - x0) = (1-t)*w0*(x0-x1)^2 + t*w1*(x0-x1)^2 >= 0!
-- Proves EVERY intermediate instrument inside a 2D Cubical Homotopy Square I x I
-- is unconditionally passive and energy-bounded (zero instability while morphing!).
-- Variables (0..4): t, w0, w1, x0, x1.
wave-homotopy-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wave-homotopy-poly A ad mu q vs =
  (λ g sub sq →
    let t  = g 0; w0 = g 1; w1 = g 2; x0 = g 3; x1 = g 4
        om = sub (q (fn-q 1 1)) t
        wt = ad (mu om w0) (mu t w1)
        lhs = ad (mu x0 (mu wt (sub x0 x1))) (mu x1 (mu wt (sub x1 x0)))
        rhs = ad (mu (mu om w0) (sq (sub x0 x1))) (mu (mu t w1) (sq (sub x0 x1)))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
