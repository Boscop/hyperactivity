nk-op-ins : NkOp → NkVal → NkEnv
nk-op-ins (nko-el h cs aux out) (nkv hd parts) = nk-eapp aux parts
nk-op-ins (nko-dup a b) v = nke-nil
nk-op-ins nko-era v = nk-parts v
nk-op-ins (nko-fwd out) v = nke-nil
nk-op-ins (nko-quote d out) (nkv hd parts) = parts
nk-op-ins (nko-gather d k done todo out) (nkv (hd-q t) e) = todo
nk-op-ins o v = nke-nil
