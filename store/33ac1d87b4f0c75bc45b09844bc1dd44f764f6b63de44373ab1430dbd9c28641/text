-- 2. UNIVERSAL N-BIT STRUCTURAL INDUCTION over ALL bit-widths (arbitrary-length LSB-first List Bool)
cir-ripple-net : Bool → List Bool → List Bool → List Bool
cir-ripple-net cin nil nil = cons cin nil
cir-ripple-net cin (cons a as) (cons b bs) =
  let sc = cir-fa1-eval-bool a b cin
  in cons (fst sc) (cir-ripple-net (snd sc) as bs)
cir-ripple-net cin _ _ = cons cin nil
