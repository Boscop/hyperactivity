s256-fin : Word → Word → Word → Word → List Word
s256-fin ab cd ef gh =
  let a = %wand ab s256-m32
      b = %wshr ab #32
      c = %wand cd s256-m32
      d = %wshr cd #32
      e = %wand ef s256-m32
      f = %wshr ef #32
      g = %wand gh s256-m32
      h = %wshr gh #32
  in cons (s256-add #1779033703 a) (cons (s256-add #3144134277 b) (cons (s256-add #1013904242 c) (cons (s256-add #2773480762 d)
     (cons (s256-add #1359893119 e) (cons (s256-add #2600822924 f) (cons (s256-add #528734635 g) (cons (s256-add #1541459225 h) nil)))))))
