ossc-cv-to-svg : CanvasOp → List Word
ossc-cv-to-svg cv-nil = nil
ossc-cv-to-svg (cv-clear hex) =
  h-concat (cons "<rect x='0' y='0' width='100%' height='100%' fill='" (cons hex (cons "'/>" nil)))
ossc-cv-to-svg (cv-line x1 y1 x2 y2 hex) =
  h-concat (cons "<line x1='" (cons (ce-dec x1) (cons "' y1='" (cons (ce-dec y1)
           (cons "' x2='" (cons (ce-dec x2) (cons "' y2='" (cons (ce-dec y2)
           (cons "' stroke='" (cons hex (cons "' stroke-width='2'/>" nil)))))))))))
ossc-cv-to-svg (cv-circle cx cy r hex) =
  h-concat (cons "<circle cx='" (cons (ce-dec cx) (cons "' cy='" (cons (ce-dec cy)
           (cons "' r='" (cons (ce-dec r) (cons "' fill='" (cons hex (cons "'/>" nil)))))))))
ossc-cv-to-svg (cv-rect x y w h hex) =
  h-concat (cons "<rect x='" (cons (ce-dec x) (cons "' y='" (cons (ce-dec y)
           (cons "' width='" (cons (ce-dec w) (cons "' height='" (cons (ce-dec h)
           (cons "' fill='" (cons hex (cons "'/>" nil)))))))))))
ossc-cv-to-svg (cv-label x y txt hex) =
  h-concat (cons "<text x='" (cons (ce-dec x) (cons "' y='" (cons (ce-dec y)
           (cons "' fill='" (cons hex (cons "' font-family='ui-monospace,Menlo,monospace' font-size='10.5' font-weight='600'>"
           (cons (ossc-esc txt) (cons "</text>" nil)))))))))
ossc-cv-to-svg (cv-seq a b) = list-append (ossc-cv-to-svg a) (ossc-cv-to-svg b)
