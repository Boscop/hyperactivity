-- ============================================================================
-- 1. Plücker / Diagonal Simplicity Constraint: (u ∧ v) ∧ (u ∧ v) = 0 in R⁴
-- ============================================================================
-- For u = (u0, u1, u2, u3) and v = (v0, v1, v2, v3) (8 variables: 0..3 = u, 4..7 = v),
-- the 6 bivector components are B_ij = u_i v_j - u_j v_i.
-- Diagonal simplicity: B01·B23 - B02·B13 + B03·B12 = 0.
lqg-plucker-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-plucker-poly A ad mu q vs =
  (λ g sub →
    let u0 = g 0; u1 = g 1; u2 = g 2; u3 = g 3
        v0 = g 4; v1 = g 5; v2 = g 6; v3 = g 7
        b01 = sub (mu u0 v1) (mu u1 v0)
        b02 = sub (mu u0 v2) (mu u2 v0)
        b03 = sub (mu u0 v3) (mu u3 v0)
        b12 = sub (mu u1 v2) (mu u2 v1)
        b13 = sub (mu u1 v3) (mu u3 v1)
        b23 = sub (mu u2 v3) (mu u3 v2)
        pfaff = ad (sub (mu b01 b23) (mu b02 b13)) (mu b03 b12)
    in (pfaff , q (fn-q 0 1)))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
