-- THEOREM 1: UNIVERSAL 5-AXIS COMPONENTWISE DOMINANCE IMPLIES TOTAL ENERGY DOMINANCE!
-- Improving ANY subset of the 5 axes (without regressing any axis) strictly improves total system Joules/op!
str-thm-5axis-dom : (g1 g2 w1 w2 c1 c2 f1 f2 b1 b2 : Nat) →
  hm-le g2 g1 ≡ true → hm-le w2 w1 ≡ true → hm-le c2 c1 ≡ true → hm-le f2 f1 ≡ true → hm-le b2 b1 ≡ true →
  hm-le (str-total-cost (scost g2 w2 c2 f2 b2)) (str-total-cost (scost g1 w1 c1 f1 b1)) ≡ true
str-thm-5axis-dom g1 g2 w1 w2 c1 c2 f1 f2 b1 b2 hg hw hc hf hb =
  sc-le-add-mono g2 g1 (hm-add w2 (hm-add c2 (hm-add f2 b2))) (hm-add w1 (hm-add c1 (hm-add f1 b1))) hg
    (sc-le-add-mono w2 w1 (hm-add c2 (hm-add f2 b2)) (hm-add c1 (hm-add f1 b1)) hw
      (sc-le-add-mono c2 c1 (hm-add f2 b2) (hm-add f1 b1) hc
        (sc-le-add-mono f2 f1 b2 b1 hf hb)))
