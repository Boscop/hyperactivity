-- the faces of two systems are the same, in order; and two systems side by side: on each face the
-- pair of the two sides
nk-faces-eq : NkTm → Word → NkTm → NkTm → Bool
nk-faces-eq ctx n (nk-cons b r) ss = if nk-tm-eq (nk-norm-in ctx n (nk-bf b)) (nk-norm-in ctx n (nk-bf (nk-nth ss #0))) then nk-faces-eq ctx n r (nk-tail ss) else false
nk-faces-eq ctx n t ss = nk-tm-eq ss nk-nil
