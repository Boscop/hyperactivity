s-pump-all : Nat → Word → Word → Word → Proc W Bool
s-pump-all zero src dst buf = ret true
s-pump-all (suc k) src dst buf =
  bind (sys-call #0 src buf #65536 #0 #0 #0) (λ n →
  if weq n #0 then ret {lzero} {W} true
  else if wlt #9223372036854775807 n then ret {lzero} {W} false
  else bind (s-write-all-buf (toNat #64) dst buf n) (λ ok →
    if ok then s-pump-all k src dst buf else ret {lzero} {W} false))
