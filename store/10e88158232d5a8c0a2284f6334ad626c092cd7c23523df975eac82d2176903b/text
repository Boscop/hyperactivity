ic-interact : {K : Type} → ICAgent K → ICAgent K → CutOutcome K
ic-interact ic-era ic-era = co-empty
ic-interact ic-era (ic-con t b1 b2) = co-erase2 b1 b2
ic-interact ic-era (ic-ref k arg) = co-expand k arg ic-era
ic-interact (ic-con t a1 a2) ic-era = co-erase2 a1 a2
ic-interact (ic-con t1 a1 a2) (ic-con t2 b1 b2) = ic-con-con (eqb t1 t2) t1 a1 a2 t2 b1 b2
ic-interact (ic-con t a1 a2) (ic-ref k arg) = co-expand k arg (ic-con t a1 a2)
ic-interact (ic-ref k arg) ic-era = co-expand k arg ic-era
ic-interact (ic-ref k arg) (ic-con t b1 b2) = co-expand k arg (ic-con t b1 b2)
ic-interact (ic-ref k1 a1) (ic-ref k2 a2) = co-expand k1 a1 (ic-ref k2 a2)
