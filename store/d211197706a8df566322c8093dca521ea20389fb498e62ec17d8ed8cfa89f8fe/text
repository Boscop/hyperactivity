dm-decode-atlas : List Word → DmMaybe GlobalCryptoAtlas
dm-decode-atlas (cons bArb (cons bOp (cons sSlot (cons btcM (cons solM (cons sRoot (cons cRoot rest))))))) =
  case ch-decode-hs rest of
    ch-nothing → dm-nothing
    ch-just hs → dm-just (mk-global-atlas hs bArb bOp sSlot btcM solM sRoot cRoot)
dm-decode-atlas _ = dm-nothing
