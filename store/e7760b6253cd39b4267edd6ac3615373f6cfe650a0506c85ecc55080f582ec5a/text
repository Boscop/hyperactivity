-- Collapse any n-hop chain of demonstrated identities into a single direct path A ≡ B.
portal-collapse : (n : Nat) → (A B : Type 0) → IdChain n A B → PathP (λ i → Type 0) A B
portal-collapse zero A B p = p
portal-collapse (suc n) A B ch = portal-concat {A} {fst ch} {B} (fst (snd ch)) (portal-collapse n (fst ch) B (snd (snd ch)))
