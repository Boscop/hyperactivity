    (cons (re-mul (re-add (re-mul (re-v #0) (re-v #0)) (re-mul (re-v #1) (re-v #1)))
                  (re-add (re-mul (re-v #2) (re-v #2)) (re-mul (re-v #3) (re-v #3)))) nil)

cert-brahmagupta : PolyOptCert
cert-brahmagupta = mk-poly-cert "brahmagupta_norm" po-brahma-spec po-brahma-cand refl refl

-- ============================================================================
-- SECTION 4: EXACT ZHEGALKIN / ANF NORMAL FORM OVER F_2[x_0..x_63]/(x_i^2 - x_i)
--   Monomial = 64-bit bitmask (`Word`), #0 = constant 1, (1 << i) = x_i.
--   Multiplication = bitwise OR (`%wor`); addition = symmetric difference!
-- ============================================================================

PolyF2 : Type
PolyF2 = List Word

f2-zero : PolyF2
f2-zero = nil

f2-one : PolyF2
f2-one = cons #0 nil

f2-var : Word → PolyF2
f2-var i = cons (%wshl #1 i) nil

f2-toggle : Word → PolyF2 → PolyF2
f2-toggle m nil = cons m nil
f2-toggle m (cons x xs) = if %weq m x then xs else cons x (f2-toggle m xs)

f2-add : PolyF2 → PolyF2 → PolyF2
f2-add nil q = q
f2-add (cons m ms) q = f2-toggle m (f2-add ms q)

f2-scale : Word → PolyF2 → PolyF2
f2-scale _ nil = nil
f2-scale m (cons x xs) = f2-toggle (%wor m x) (f2-scale m xs)

f2-mul : PolyF2 → PolyF2 → PolyF2
f2-mul nil _ = nil
f2-mul (cons m ms) q = f2-add (f2-scale m q) (f2-mul ms q)

f2-is-zero : PolyF2 → Bool
f2-is-zero nil = true
f2-is-zero (cons _ _) = false

f2-eq : PolyF2 → PolyF2 → Bool
f2-eq p q = f2-is-zero (f2-add p q)

f2-list-eq : List PolyF2 → List PolyF2 → Bool
f2-list-eq nil nil = true
f2-list-eq (cons a as) (cons b bs) = web-andB (f2-eq a b) (f2-list-eq as bs)
f2-list-eq _ _ = false

data F2Expr : Type where
  f2-k   : Bool → F2Expr
  f2-v   : Word → F2Expr
  f2-not : F2Expr → F2Expr
  f2-xor : F2Expr → F2Expr → F2Expr
  f2-and : F2Expr → F2Expr → F2Expr
  f2-or  : F2Expr → F2Expr → F2Expr

data F2Prog : Type where
  f2prog : Word → List (Word × F2Expr) → List F2Expr → F2Prog

fe-to-anf : (Word → PolyF2) → F2Expr → PolyF2
fe-to-anf _   (f2-k false) = f2-zero
fe-to-anf _   (f2-k true)  = f2-one
fe-to-anf env (f2-v i)     = env i
fe-to-anf env (f2-not a)   = f2-add f2-one (fe-to-anf env a)
fe-to-anf env (f2-xor a b) = f2-add (fe-to-anf env a) (fe-to-anf env b)
fe-to-anf env (f2-and a b) = f2-mul (fe-to-anf env a) (fe-to-anf env b)
fe-to-anf env (f2-or  a b) =
  let pa = fe-to-anf env a
      pb = fe-to-anf env b
  in f2-add (f2-add pa pb) (f2-mul pa pb)

f2-env-ext : Word → PolyF2 → (Word → PolyF2) → Word → PolyF2
f2-env-ext id p env k = if %weq k id then p else env k

fp-eval-lets : (Word → PolyF2) → List (Word × F2Expr) → (Word → PolyF2)
fp-eval-lets env nil = env
fp-eval-lets env (cons b bs) =
  fp-eval-lets (f2-env-ext (fst b) (fe-to-anf env (snd b)) env) bs

fp-map-anf : (Word → PolyF2) → List F2Expr → List PolyF2
fp-map-anf _   nil = nil
fp-map-anf env (cons e es) = cons (fe-to-anf env e) (fp-map-anf env es)

fp-to-anf : F2Prog → List PolyF2
fp-to-anf (f2prog _ lets outs) = fp-map-anf (fp-eval-lets f2-var lets) outs

fe-ands : F2Expr → Word
fe-ands (f2-k _)     = #0
fe-ands (f2-v _)     = #0
fe-ands (f2-not a)   = fe-ands a
fe-ands (f2-xor a b) = %wadd (fe-ands a) (fe-ands b)
fe-ands (f2-and a b) = %wadd #1 (%wadd (fe-ands a) (fe-ands b))
fe-ands (f2-or  a b) = %wadd #1 (%wadd (fe-ands a) (fe-ands b))

fp-lets-ands : List (Word × F2Expr) → Word
fp-lets-ands nil = #0
fp-lets-ands (cons b bs) = %wadd (fe-ands (snd b)) (fp-lets-ands bs)

fp-outs-ands : List F2Expr → Word
fp-outs-ands nil = #0
fp-outs-ands (cons e es) = %wadd (fe-ands e) (fp-outs-ands es)

fp-ands : F2Prog → Word
fp-ands (f2prog _ lets outs) = %wadd (fp-lets-ands lets) (fp-outs-ands outs)

data F2OptCert : Type where
  mk-f2-cert : (name : List Word) → (spec : F2Prog) → (cand : F2Prog) →
    PathP (λ i → Bool) (f2-list-eq (fp-to-anf spec) (fp-to-anf cand)) true →
    PathP (λ i → Bool) (po-le (fp-ands cand) (fp-ands spec)) true → F2OptCert

-- 6. SHA-256 Ch(e,f,g): (e & f) ^ (~e & g) -> g ^ (e & (f ^ g)) [2 ANDs -> 1 AND, -50%]
cert-sha256-ch : F2OptCert
cert-sha256-ch =
  mk-f2-cert "sha256_ch"
    (f2prog #3 nil (cons (f2-xor (f2-and (f2-v #0) (f2-v #1)) (f2-and (f2-not (f2-v #0)) (f2-v #2))) nil))
    (f2prog #3 nil (cons (f2-xor (f2-v #2) (f2-and (f2-v #0) (f2-xor (f2-v #1) (f2-v #2)))) nil))
    refl refl

-- 7. SHA-256 Maj(a,b,c): (a & b) ^ (a & c) ^ (b & c) -> a ^ ((a ^ b) & (a ^ c)) [3 ANDs -> 1 AND, -66.7%]
cert-sha256-maj : F2OptCert
cert-sha256-maj =
  mk-f2-cert "sha256_maj"
    (f2prog #3 nil (cons (f2-xor (f2-xor (f2-and (f2-v #0) (f2-v #1)) (f2-and (f2-v #0) (f2-v #2))) (f2-and (f2-v #1) (f2-v #2))) nil))
    (f2prog #3 nil (cons (f2-xor (f2-v #0) (f2-and (f2-xor (f2-v #0) (f2-v #1)) (f2-xor (f2-v #0) (f2-v #2)))) nil))
    refl refl

-- 8. Full Adder (SUM, CARRY): 4 ANDs/ORs -> 1 AND (-75% MC!) via shared SSA DAG
cert-full-adder : F2OptCert
cert-full-adder =
  mk-f2-cert "full_adder"
    (f2prog #3 nil
      (cons (f2-xor (f2-xor (f2-v #0) (f2-v #1)) (f2-v #2))
      (cons (f2-or (f2-or (f2-and (f2-v #0) (f2-v #1)) (f2-and (f2-v #0) (f2-v #2))) (f2-and (f2-v #1) (f2-v #2))) nil)))
    (f2prog #3
      (cons (#3 , f2-xor (f2-v #0) (f2-v #2))
      (cons (#4 , f2-xor (f2-v #1) (f2-v #2)) nil))
      (cons (f2-xor (f2-v #3) (f2-v #1))
      (cons (f2-xor (f2-v #2) (f2-and (f2-v #3) (f2-v #4))) nil)))
    refl refl

-- ============================================================================
-- SECTION 5: ONE MECHANICAL 5-TARGET LOWERING FUNCTOR ON CERTIFIED ASTS ONLY!
