-- ============================================================================

po-emit-zint : KTarget → ZInt → List Word
po-emit-zint kt-sv (zi p n) =
  if %weq n #0 then list-append "32'd" (ce-dec p)
  else list-append "(32'd" (list-append (ce-dec p) (list-append " - 32'd" (list-append (ce-dec n) ")")))
po-emit-zint _ (zi p n) =
  if %weq n #0 then list-append (ce-dec p) "u"
  else list-append "(" (list-append (ce-dec p) (list-append "u - " (list-append (ce-dec n) "u)")))

po-emit-re : KTarget → RExpr → List Word
po-emit-re t (re-k c)     = po-emit-zint t c
po-emit-re _ (re-v i)     = list-append "v" (ce-dec i)
po-emit-re t (re-add a b) = list-append "(" (list-append (po-emit-re t a) (list-append " + " (list-append (po-emit-re t b) ")")))
po-emit-re t (re-sub a b) = list-append "(" (list-append (po-emit-re t a) (list-append " - " (list-append (po-emit-re t b) ")")))
po-emit-re t (re-mul a b) = list-append "(" (list-append (po-emit-re t a) (list-append " * " (list-append (po-emit-re t b) ")")))

po-emit-fe : KTarget → F2Expr → List Word
po-emit-fe kt-sv (f2-k false) = "32'h0"
po-emit-fe kt-sv (f2-k true)  = "32'hFFFFFFFF"
po-emit-fe _     (f2-k false) = "0u"
po-emit-fe _     (f2-k true)  = "0xFFFFFFFFu"
po-emit-fe _     (f2-v i)     = list-append "v" (ce-dec i)
po-emit-fe t     (f2-not a)   = list-append "(~" (list-append (po-emit-fe t a) ")")
po-emit-fe t     (f2-xor a b) = list-append "(" (list-append (po-emit-fe t a) (list-append " ^ " (list-append (po-emit-fe t b) ")")))
po-emit-fe t     (f2-and a b) = list-append "(" (list-append (po-emit-fe t a) (list-append " & " (list-append (po-emit-fe t b) ")")))
po-emit-fe t     (f2-or  a b) = list-append "(" (list-append (po-emit-fe t a) (list-append " | " (list-append (po-emit-fe t b) ")")))

-- Shared C-family parameter/let/output emitters (ONE printer for C11, Metal, AND CUDA!)
po-ty : KTarget → List Word
po-ty kt-metal = "uint"
po-ty _        = "uint32_t"

po-fn-qual : KTarget → List Word
po-fn-qual kt-c11   = "static inline void "
po-fn-qual kt-metal = "inline void "
po-fn-qual kt-cuda  = "__device__ __forceinline__ void "
po-fn-qual kt-sv    = ""

po-out-ptr : KTarget → List Word
po-out-ptr kt-metal = "thread uint* out"
po-out-ptr _        = "uint32_t* out"

po-params-go : KTarget → Nat → Word → List Word
po-params-go _ zero    _ = nil
po-params-go t (suc k) i =
  list-append (po-ty t) (list-append " v" (list-append (ce-dec i) (list-append ", " (po-params-go t k (%wadd i #1)))))

po-emit-rlets : KTarget → List (Word × RExpr) → List Word → List Word
po-emit-rlets _ nil tail = tail
po-emit-rlets t (cons b bs) tail =
  hw-ln (list-append "  " (list-append (po-ty t) (list-append " v" (list-append (ce-dec (fst b))
        (list-append " = " (list-append (po-emit-re t (snd b)) ";"))))))
        (po-emit-rlets t bs tail)

po-emit-routs : KTarget → Word → List RExpr → List Word → List Word
po-emit-routs _ _ nil tail = tail
po-emit-routs t idx (cons e es) tail =
  hw-ln (list-append "  out[" (list-append (ce-dec idx) (list-append "] = " (list-append (po-emit-re t e) ";"))))
        (po-emit-routs t (%wadd idx #1) es tail)

po-void-go : Nat → Word → List Word
po-void-go zero    _ = nil
po-void-go (suc k) i = list-append " (void)v" (list-append (ce-dec i) (list-append ";" (po-void-go k (%wadd i #1))))

po-emit-rprog-cfam : KTarget → List Word → RProg → List Word → List Word
po-emit-rprog-cfam t fname (rprog nin lets outs) tail =
  hw-ln (list-append (po-fn-qual t) (list-append fname (list-append "("
        (list-append (po-params-go t (toNat nin) #0) (list-append (po-out-ptr t) ") {")))))
        (hw-ln (list-append " " (po-void-go (toNat nin) #0))
        (po-emit-rlets t lets (po-emit-routs t #0 outs (hw-ln "}" tail))))

po-emit-flets : KTarget → List (Word × F2Expr) → List Word → List Word
po-emit-flets _ nil tail = tail
po-emit-flets t (cons b bs) tail =
  hw-ln (list-append "  " (list-append (po-ty t) (list-append " v" (list-append (ce-dec (fst b))
        (list-append " = " (list-append (po-emit-fe t (snd b)) ";"))))))
        (po-emit-flets t bs tail)

po-emit-fouts : KTarget → Word → List F2Expr → List Word → List Word
po-emit-fouts _ _ nil tail = tail
po-emit-fouts t idx (cons e es) tail =
  hw-ln (list-append "  out[" (list-append (ce-dec idx) (list-append "] = " (list-append (po-emit-fe t e) ";"))))
        (po-emit-fouts t (%wadd idx #1) es tail)

po-emit-fprog-cfam : KTarget → List Word → F2Prog → List Word → List Word
po-emit-fprog-cfam t fname (f2prog nin lets outs) tail =
  hw-ln (list-append (po-fn-qual t) (list-append fname (list-append "("
        (list-append (po-params-go t (toNat nin) #0) (list-append (po-out-ptr t) ") {")))))
        (po-emit-flets t lets (po-emit-fouts t #0 outs (hw-ln "}" tail)))

-- CERTIFIED-ONLY LOWERING ENTRYPOINTS (ONLY ACCEPT `PolyOptCert` / `F2OptCert`!)
po-lower-ring-cand : KTarget → PolyOptCert → List Word → List Word
po-lower-ring-cand t (mk-poly-cert nm _ cand _ _) tail =
  po-emit-rprog-cfam t (list-append "opt_" nm) cand tail

po-lower-ring-both : KTarget → PolyOptCert → List Word → List Word
po-lower-ring-both t (mk-poly-cert nm spec cand _ _) tail =
  po-emit-rprog-cfam t (list-append "spec_" nm) spec
    (po-emit-rprog-cfam t (list-append "opt_" nm) cand tail)

po-lower-f2-cand : KTarget → F2OptCert → List Word → List Word
po-lower-f2-cand t (mk-f2-cert nm _ cand _ _) tail =
  po-emit-fprog-cfam t (list-append "opt_" nm) cand tail

po-lower-f2-both : KTarget → F2OptCert → List Word → List Word
po-lower-f2-both t (mk-f2-cert nm spec cand _ _) tail =
  po-emit-fprog-cfam t (list-append "spec_" nm) spec
    (po-emit-fprog-cfam t (list-append "opt_" nm) cand tail)

-- SystemVerilog RTL lowering (EXACT SAME certified `cand` DAG!)
po-sv-ins : Nat → Word → List Word
po-sv-ins zero    _ = nil
po-sv-ins (suc k) i = list-append "input logic [31:0] v" (list-append (ce-dec i) (list-append ", " (po-sv-ins k (%wadd i #1))))

po-sv-outs : Word → List RExpr → List Word
po-sv-outs _ nil = nil
po-sv-outs i (cons _ nil) = list-append "output logic [31:0] y" (ce-dec i)
po-sv-outs i (cons _ es)  = list-append "output logic [31:0] y" (list-append (ce-dec i) (list-append ", " (po-sv-outs (%wadd i #1) es)))

po-sv-rlets : List (Word × RExpr) → List Word → List Word
po-sv-rlets nil tail = tail
po-sv-rlets (cons b bs) tail =
  hw-ln (list-append "  logic [31:0] v" (list-append (ce-dec (fst b)) (list-append "; assign v"
        (list-append (ce-dec (fst b)) (list-append " = " (list-append (po-emit-re kt-sv (snd b)) ";"))))))
        (po-sv-rlets bs tail)

po-sv-routs : Word → List RExpr → List Word → List Word
po-sv-routs _ nil tail = tail
po-sv-routs i (cons e es) tail =
  hw-ln (list-append "  assign y" (list-append (ce-dec i) (list-append " = " (list-append (po-emit-re kt-sv e) ";"))))
        (po-sv-routs (%wadd i #1) es tail)

po-lower-ring-sv : PolyOptCert → List Word → List Word
po-lower-ring-sv (mk-poly-cert nm _ (rprog nin lets outs) _ _) tail =
  hw-ln (list-append "module hx_poly_" (list-append nm (list-append " ("
        (list-append (po-sv-ins (toNat nin) #0) (list-append (po-sv-outs #0 outs) ");")))))
        (po-sv-rlets lets (po-sv-routs #0 outs (hw-ln "endmodule" (hw-ln nil tail))))

po-sv-fouts-decl : Word → List F2Expr → List Word
po-sv-fouts-decl _ nil = nil
po-sv-fouts-decl i (cons _ nil) = list-append "output logic [31:0] y" (ce-dec i)
po-sv-fouts-decl i (cons _ es)  = list-append "output logic [31:0] y" (list-append (ce-dec i) (list-append ", " (po-sv-fouts-decl (%wadd i #1) es)))

po-sv-flets : List (Word × F2Expr) → List Word → List Word
po-sv-flets nil tail = tail
po-sv-flets (cons b bs) tail =
  hw-ln (list-append "  logic [31:0] v" (list-append (ce-dec (fst b)) (list-append "; assign v"
        (list-append (ce-dec (fst b)) (list-append " = " (list-append (po-emit-fe kt-sv (snd b)) ";"))))))
        (po-sv-flets bs tail)

po-sv-fouts : Word → List F2Expr → List Word → List Word
po-sv-fouts _ nil tail = tail
po-sv-fouts i (cons e es) tail =
  hw-ln (list-append "  assign y" (list-append (ce-dec i) (list-append " = " (list-append (po-emit-fe kt-sv e) ";"))))
        (po-sv-fouts (%wadd i #1) es tail)

po-lower-f2-sv : F2OptCert → List Word → List Word
po-lower-f2-sv (mk-f2-cert nm _ (f2prog nin lets outs) _ _) tail =
  hw-ln (list-append "module hx_poly_" (list-append nm (list-append " ("
        (list-append (po-sv-ins (toNat nin) #0) (list-append (po-sv-fouts-decl #0 outs) ");")))))
        (po-sv-flets lets (po-sv-fouts #0 outs (hw-ln "endmodule" (hw-ln nil tail))))

