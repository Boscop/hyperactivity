-- 1. Karatsuba 2-Limb Multiply: (a0 + a1*X)(b0 + b1*X) -> (c0, c1, c2) [4 muls -> 3 muls, -25%]
po-karatsuba-spec : RProg
po-karatsuba-spec =
  rprog #4 nil
    (cons (re-mul (re-v #0) (re-v #2))
    (cons (re-add (re-mul (re-v #0) (re-v #3)) (re-mul (re-v #1) (re-v #2)))
    (cons (re-mul (re-v #1) (re-v #3)) nil)))

po-karatsuba-cand : RProg
po-karatsuba-cand =
  rprog #4
    (cons (#4 , re-mul (re-v #0) (re-v #2))
    (cons (#5 , re-mul (re-v #1) (re-v #3))
    (cons (#6 , re-mul (re-add (re-v #0) (re-v #1)) (re-add (re-v #2) (re-v #3))) nil)))
    (cons (re-v #4)
    (cons (re-sub (re-sub (re-v #6) (re-v #4)) (re-v #5))
    (cons (re-v #5) nil)))

cert-karatsuba : PolyOptCert
cert-karatsuba = mk-poly-cert "karatsuba" po-karatsuba-spec po-karatsuba-cand refl refl

-- 2. Gauss 3-Mul Complex Multiply: (a + b*i)(c + d*i) -> (ac - bd, ad + bc) [4 muls -> 3 muls, -25%]
po-gauss-spec : RProg
po-gauss-spec =
  rprog #4 nil
    (cons (re-sub (re-mul (re-v #0) (re-v #2)) (re-mul (re-v #1) (re-v #3)))
    (cons (re-add (re-mul (re-v #0) (re-v #3)) (re-mul (re-v #1) (re-v #2))) nil))

po-gauss-cand : RProg
po-gauss-cand =
  rprog #4
    (cons (#4 , re-mul (re-v #0) (re-add (re-v #2) (re-v #3)))
    (cons (#5 , re-mul (re-v #3) (re-add (re-v #0) (re-v #1)))
    (cons (#6 , re-mul (re-v #2) (re-sub (re-v #1) (re-v #0))) nil)))
    (cons (re-sub (re-v #4) (re-v #5))
    (cons (re-add (re-v #4) (re-v #6)) nil))

cert-gauss-complex : PolyOptCert
cert-gauss-complex = mk-poly-cert "gauss_complex" po-gauss-spec po-gauss-cand refl refl

-- 3. Horner Cubic Evaluation: c0 + c1*x + c2*x^2 + c3*x^3 [6 muls -> 3 muls, -50%]
--    inputs: 0=x, 1=c0, 2=c1, 3=c2, 4=c3
po-horner-spec : RProg
po-horner-spec =
  rprog #5 nil
    (cons (re-add (re-v #1)
          (re-add (re-mul (re-v #2) (re-v #0))
          (re-add (re-mul (re-v #3) (re-mul (re-v #0) (re-v #0)))
                  (re-mul (re-v #4) (re-mul (re-v #0) (re-mul (re-v #0) (re-v #0))))))) nil)

po-horner-cand : RProg
po-horner-cand =
  rprog #5 nil
    (cons (re-add (re-v #1)
            (re-mul (re-v #0)
              (re-add (re-v #2)
                (re-mul (re-v #0)
                  (re-add (re-v #3) (re-mul (re-v #0) (re-v #4))))))) nil)

cert-horner-cubic : PolyOptCert
cert-horner-cubic = mk-poly-cert "horner_cubic" po-horner-spec po-horner-cand refl refl

-- 4. Exact SU(2) Cayley Unitarity Residual: (1 - s)^2 + 4s - (1 + s)^2 == 0, s = t^2*(d^2 + h^2) [6 muls -> 0 muls!]
--    inputs: 0=t, 1=d, 2=h
po-cayley-spec : RProg
po-cayley-spec =
  rprog #3
    (cons (#3 , re-mul (re-mul (re-v #0) (re-v #0))
                       (re-add (re-mul (re-v #1) (re-v #1)) (re-mul (re-v #2) (re-v #2))))
    (cons (#4 , re-sub (re-k zi-one) (re-v #3))
