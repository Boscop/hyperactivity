    (cons (re-sub (re-add (re-mul (re-v #4) (re-v #4)) (re-mul (re-k zi-four) (re-v #3)))
                  (re-mul (re-v #5) (re-v #5))) nil)

po-cayley-cand : RProg
po-cayley-cand = rprog #3 nil (cons (re-k zi-zero) nil)

cert-cayley-su2 : PolyOptCert
cert-cayley-su2 = mk-poly-cert "cayley_su2_err" po-cayley-spec po-cayley-cand refl refl

-- 5. Brahmagupta-Fibonacci 2-Square Norm Identity: (a^2+b^2)(c^2+d^2) == (ac-bd)^2 + (ad+bc)^2 [6 muls -> 5 muls!]
po-brahma-spec : RProg
po-brahma-spec =
  rprog #4
    (cons (#4 , re-sub (re-mul (re-v #0) (re-v #2)) (re-mul (re-v #1) (re-v #3)))
    (cons (#5 , re-add (re-mul (re-v #0) (re-v #3)) (re-mul (re-v #1) (re-v #2))) nil))
    (cons (re-add (re-mul (re-v #4) (re-v #4)) (re-mul (re-v #5) (re-v #5))) nil)

po-brahma-cand : RProg
po-brahma-cand =
