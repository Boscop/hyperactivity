-- ============================================================================
-- SECTION 1: EXACT MULTIVARIATE POLYNOMIAL NORMAL FORM OVER Z[x_0..x_{n-1}]
--   Coefficients are exact Grothendieck integers `ZInt` (from lib/ir/kexpr).
--   Monomials are exponent lists `List Word`; trailing zeros are stripped.
-- ============================================================================

po-le : Word → Word → Bool
po-le a b = web-notB (%wlt b a)

po-all-zero : List Word → Bool
po-all-zero nil = true
po-all-zero (cons e es) = if %weq e #0 then po-all-zero es else false

po-meq : List Word → List Word → Bool
po-meq nil b = po-all-zero b
po-meq a nil = po-all-zero a
po-meq (cons x xs) (cons y ys) = if %weq x y then po-meq xs ys else false

po-mmul : List Word → List Word → List Word
po-mmul nil b = b
po-mmul a nil = a
po-mmul (cons x xs) (cons y ys) = cons (%wadd x y) (po-mmul xs ys)

po-mvar : Nat → List Word
po-mvar zero    = cons #1 nil
po-mvar (suc k) = cons #0 (po-mvar k)

PolyZ : Type
PolyZ = List (List Word × ZInt)

pz-zero : PolyZ
pz-zero = nil

pz-const : ZInt → PolyZ
pz-const c = if zi-eq c zi-zero then nil else cons (nil , c) nil

pz-var : Word → PolyZ
pz-var i = cons (po-mvar (toNat i) , zi-one) nil

pz-ins : List Word → ZInt → PolyZ → PolyZ
pz-ins m c nil = if zi-eq c zi-zero then nil else cons (m , c) nil
pz-ins m c (cons t ts) =
  if po-meq m (fst t) then
    let nc = zi-add (snd t) c
    in if zi-eq nc zi-zero then ts else cons (fst t , nc) ts
  else cons t (pz-ins m c ts)

pz-add : PolyZ → PolyZ → PolyZ
pz-add nil q = q
pz-add (cons t ts) q = pz-ins (fst t) (snd t) (pz-add ts q)

pz-neg : PolyZ → PolyZ
pz-neg nil = nil
pz-neg (cons t ts) = cons (fst t , zi-neg (snd t)) (pz-neg ts)

pz-sub : PolyZ → PolyZ → PolyZ
pz-sub p q = pz-add p (pz-neg q)

pz-scale : List Word → ZInt → PolyZ → PolyZ
pz-scale _ _ nil = nil
pz-scale m c (cons t ts) = pz-ins (po-mmul m (fst t)) (zi-mul c (snd t)) (pz-scale m c ts)

pz-mul : PolyZ → PolyZ → PolyZ
pz-mul nil _ = nil
pz-mul (cons t ts) q = pz-add (pz-scale (fst t) (snd t) q) (pz-mul ts q)

pz-is-zero : PolyZ → Bool
pz-is-zero nil = true
pz-is-zero (cons t ts) = if zi-eq (snd t) zi-zero then pz-is-zero ts else false

pz-eq : PolyZ → PolyZ → Bool
pz-eq p q = pz-is-zero (pz-sub p q)

pz-list-eq : List PolyZ → List PolyZ → Bool
pz-list-eq nil nil = true
pz-list-eq (cons a as) (cons b bs) = web-andB (pz-eq a b) (pz-list-eq as bs)
pz-list-eq _ _ = false

-- ============================================================================
-- SECTION 2: SHARED ALGEBRAIC DAG `RExpr` / `RProg` & `PolyOptCert`
-- ============================================================================

data RExpr : Type where
  re-k   : ZInt → RExpr
  re-v   : Word → RExpr
  re-add : RExpr → RExpr → RExpr
  re-sub : RExpr → RExpr → RExpr
  re-mul : RExpr → RExpr → RExpr

data RProg : Type where
  rprog : Word → List (Word × RExpr) → List RExpr → RProg

re-to-poly : (Word → PolyZ) → RExpr → PolyZ
re-to-poly _   (re-k c)     = pz-const c
re-to-poly env (re-v i)     = env i
re-to-poly env (re-add a b) = pz-add (re-to-poly env a) (re-to-poly env b)
re-to-poly env (re-sub a b) = pz-sub (re-to-poly env a) (re-to-poly env b)
re-to-poly env (re-mul a b) = pz-mul (re-to-poly env a) (re-to-poly env b)

re-env-ext : Word → PolyZ → (Word → PolyZ) → Word → PolyZ
re-env-ext id p env k = if %weq k id then p else env k

rp-eval-lets : (Word → PolyZ) → List (Word × RExpr) → (Word → PolyZ)
rp-eval-lets env nil = env
rp-eval-lets env (cons b bs) =
  rp-eval-lets (re-env-ext (fst b) (re-to-poly env (snd b)) env) bs

rp-map-poly : (Word → PolyZ) → List RExpr → List PolyZ
rp-map-poly _   nil = nil
rp-map-poly env (cons e es) = cons (re-to-poly env e) (rp-map-poly env es)

rp-to-polys : RProg → List PolyZ
rp-to-polys (rprog _ lets outs) = rp-map-poly (rp-eval-lets pz-var lets) outs

re-muls : RExpr → Word
re-muls (re-k _)     = #0
re-muls (re-v _)     = #0
re-muls (re-add a b) = %wadd (re-muls a) (re-muls b)
re-muls (re-sub a b) = %wadd (re-muls a) (re-muls b)
re-muls (re-mul a b) = %wadd #1 (%wadd (re-muls a) (re-muls b))

rp-lets-muls : List (Word × RExpr) → Word
rp-lets-muls nil = #0
rp-lets-muls (cons b bs) = %wadd (re-muls (snd b)) (rp-lets-muls bs)

rp-outs-muls : List RExpr → Word
rp-outs-muls nil = #0
rp-outs-muls (cons e es) = %wadd (re-muls e) (rp-outs-muls es)

rp-muls : RProg → Word
rp-muls (rprog _ lets outs) = %wadd (rp-lets-muls lets) (rp-outs-muls outs)

-- PROOF-CARRYING RING SUPEROPTIMIZATION CERTIFICATE:
-- Physically impossible to construct unless `spec == cand` in Z[x_0..x_{n-1}] AND `muls(cand) <= muls(spec)`!
data PolyOptCert : Type where
  mk-poly-cert : (name : List Word) → (spec : RProg) → (cand : RProg) →
    PathP (λ i → Bool) (pz-list-eq (rp-to-polys spec) (rp-to-polys cand)) true →
    PathP (λ i → Bool) (po-le (rp-muls cand) (rp-muls spec)) true → PolyOptCert

