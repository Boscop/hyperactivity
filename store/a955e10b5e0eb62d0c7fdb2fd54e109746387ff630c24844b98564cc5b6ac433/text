-- ── 2. Minimal Verified De Bruijn Cubical Term & Conversion Checker ──────────
-- Self-contained zero-C core term algebra (Type, Var, Lam, App, WordLit, Eq, Refl):
data CoreTerm
  = ct-type (lvl : Word)
  | ct-var  (idx : Word)
  | ct-lam  (body : CoreTerm)
  | ct-app  (fn : CoreTerm) (arg : CoreTerm)
  | ct-w    (val : Word)
  | ct-eq   (lhs : CoreTerm) (rhs : CoreTerm)
  | ct-refl

-- Exact structural equality on normal forms (no C pointer hacks, 100% pure):
ct-eq-bool : CoreTerm → CoreTerm → Bool
ct-eq-bool (ct-type la)   (ct-type lb)   = %weq la lb
ct-eq-bool (ct-var ia)    (ct-var ib)    = %weq ia ib
ct-eq-bool (ct-lam ba)    (ct-lam bb)    = ct-eq-bool ba bb
ct-eq-bool (ct-app fa aa) (ct-app fb ab) = andB (ct-eq-bool fa fb) (ct-eq-bool aa ab)
ct-eq-bool (ct-w wa)      (ct-w wb)      = %weq wa wb
ct-eq-bool (ct-eq xa ya)  (ct-eq xb yb)  = andB (ct-eq-bool xa xb) (ct-eq-bool ya yb)
ct-eq-bool ct-refl        ct-refl        = true
ct-eq-bool _              _              = false

-- Capture-avoiding De Bruijn substitution [0 := v] (core of β-reduction!):
ct-subst : Word → CoreTerm → CoreTerm → CoreTerm
ct-subst _ _ (ct-type l)   = ct-type l
ct-subst k v (ct-var i)    = if %weq i k then v else (if %wlt k i then ct-var (%wsub i #1) else ct-var i)
ct-subst k v (ct-lam b)    = ct-lam (ct-subst (%wadd k #1) v b)
ct-subst k v (ct-app f a)  = ct-app (ct-subst k v f) (ct-subst k v a)
ct-subst _ _ (ct-w w)      = ct-w w
ct-subst k v (ct-eq a b)   = ct-eq (ct-subst k v a) (ct-subst k v b)
ct-subst _ _ ct-refl       = ct-refl

-- Single-step pure De Bruijn beta-reduction (1-level pattern match, zero mutual recursion, zero C stack!):
ct-beta : CoreTerm → CoreTerm → CoreTerm
ct-beta (ct-lam b) arg = ct-subst #0 arg b
ct-beta f          arg = ct-app f arg

ct-step : CoreTerm → CoreTerm
ct-step (ct-app f a) = ct-beta (ct-step f) (ct-step a)
ct-step (ct-lam b)   = ct-lam (ct-step b)
ct-step (ct-eq a b)  = ct-eq (ct-step a) (ct-step b)
ct-step t            = t

-- Bounded fuel-indexed normalizer (total, terminating, zero C stack!):
ct-eval : Nat → CoreTerm → CoreTerm
ct-eval zero    t = t
ct-eval (suc n) t = ct-eval n (ct-step t)

-- Pure zero-C conversion checker (checks `refl : lhs ≡ rhs` by normalizing both sides!):
fuel8 : Nat
fuel8 = suc (suc (suc (suc (suc (suc (suc (suc zero)))))))

ct-check-refl : CoreTerm → CoreTerm → Bool
ct-check-refl lhs rhs = ct-eq-bool (ct-eval fuel8 lhs) (ct-eval fuel8 rhs)

