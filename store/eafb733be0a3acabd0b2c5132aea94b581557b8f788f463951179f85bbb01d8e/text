-- the search, outside every proof: n halvings of [lo, hi]/2^20 by the witness's count of B at the middle
pb-find : BQ → Nat → BZ → BZ → BZ × BZ
pb-find z n lo hi = case n of
  zero → (lo , hi)
  suc m → if eqb (fst (wt-crt (pb-blk z (pb-q (bz-half (bz-add lo hi)))))) 3 then pb-find z m (bz-half (bz-add lo hi)) hi else pb-find z m lo (bz-half (bz-add lo hi))
