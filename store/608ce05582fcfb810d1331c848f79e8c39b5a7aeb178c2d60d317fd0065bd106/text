os-twice : List Word → List Word → List (List Word × List Word) → List (List Word)
os-twice k p nil = nil
os-twice k p (cons e r) = if h-eq k (fst e)
  then (if h-eq p (snd e) then os-twice k p r else cons (list-append (snd e) (list-append " and " (list-append p (list-append " both hold: " (list-append (os-cut #80 k) "…"))))) (os-twice k p r))
  else os-twice (fst e) (snd e) r
