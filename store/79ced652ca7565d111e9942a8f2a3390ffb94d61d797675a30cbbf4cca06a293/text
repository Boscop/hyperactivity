-- nk-emit: the C for the machine itself, entered with the count of applications and a number
-- (part of machine-in-hyperactive)
nk-emit : List Word
nk-emit = ce-prog (nk-gix (code nk-demo-m)) (x-erase (nk-gix (code nk-demo-m)) (x-forms-all (snd (program-of-at unfold (nk-gix (code nk-demo-m)) nk-entry-spec #256))))
