hcm-upd-w : Word → Word → Word → Word → Word
hcm-upd-w w u bit err =
  let upos = %wlt #2047 u
      sm   = if upos then %wsub u #2048 else %wsub #2048 u
      dw   = %wshr (%wmul err sm) #16
      same = if %weq bit #1 then upos else (if upos then false else true)
  in if same then (if %wlt #4095 (%wadd w dw) then #4095 else %wadd w dw)
     else %wsub w dw
