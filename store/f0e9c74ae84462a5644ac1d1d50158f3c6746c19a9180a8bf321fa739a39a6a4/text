-- THEOREM 5: UNIVERSAL EXPONENTIAL HYPER-TOWER SOUNDNESS (2^m META-LEVELS FOR ALL m : Nat!)
tw-thm-hyper-tower-sound : (m : Nat) → (f : INet → INet) →
  ((env : Word → Bool) → (n : INet) → in-eval env (f n) ≡ in-eval env n) →
  (env : Word → Bool) → (n : INet) → in-eval env (in-hyper-tower m f n) ≡ in-eval env n
tw-thm-hyper-tower-sound zero    f pf env n = pf env n
tw-thm-hyper-tower-sound (suc m) f pf env n =
  tw-thm-compose-sound (in-hyper-tower m f) (in-hyper-tower m f)
    (tw-thm-hyper-tower-sound m f pf) (tw-thm-hyper-tower-sound m f pf) env n
