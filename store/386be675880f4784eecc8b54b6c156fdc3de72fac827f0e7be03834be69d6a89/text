-- every request of the first plan may be done in either order with every request of the second
nk-oks : NkFx → NkFx → Type
nk-oks nkf-nil fx2 = Unit
nk-oks (nkf-val w v r) fx2 = nk-ok w (nk-arrive-val v) fx2 × nk-oks r fx2
nk-oks (nkf-op w o r) fx2 = nk-ok w (nk-arrive-op o) fx2 × nk-oks r fx2
nk-oks (nkf-put w s r) fx2 = nk-ok w (λ s0 → s) fx2 × nk-oks r fx2
