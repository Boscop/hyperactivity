boc-trans : {A : Type} → {x y z : A} → x ≡ y → y ≡ z → x ≡ z
boc-trans {A} {x} p q = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

boc-sym : {A : Type} → {x y : A} → x ≡ y → y ≡ x
boc-sym {A} {x} p = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ p j , i = 1 ↦ x ]) x

boc-cong : {A B : Type} → (f : A → B) → {x y : A} → x ≡ y → f x ≡ f y
boc-cong f p = λ i → f (p i)

record BocCodec (X : Type) =
  { bc-enc : X → X
  ; bc-dec : X → X
  ; bc-ret : (x : X) → bc-dec (bc-enc x) ≡ x
  ; bc-sec : (y : X) → bc-enc (bc-dec y) ≡ y
  }

boc-iter : {X : Type} → Nat → (X → X) → X → X
boc-iter zero    _ x = x
boc-iter (suc n) f x = f (boc-iter n f x)

boc-conj : {X : Type} → BocCodec X → (X → X) → X → X
boc-conj c f y = bc-enc c (f (bc-dec c y))

