-- one bracket of eq. 61 from doubled spins, each factor halved (even by the triangle rule)
btri4 : List Bool → List Bool → List Bool → List Bool
btri4 x y a = bin-mul (bin-mul (bin-half (bin-add (bin-add x y) (bin-add a bin-two))) (bin-half (bin-sub (bin-add y a) x)))
  (bin-mul (bin-half (bin-sub (bin-add x a) y)) (bin-half (bin-sub (bin-add (bin-add x y) bin-two) a)))
