-- wb's k iterations from offset i: the bytes written, and the checks they need
wb-mem : Word → ZI → Word → Word → Word → ZI → ByteMap → ByteMap
wb-mem w n addr value k =
  %welimP (λ _ → ZI → ByteMap → ByteMap) k (λ i m → m)
    (λ j h i m → h (z-add i (zpos #1)) (mem-store-n m #1 (bv-mask #64 (wb-phys w addr i)) (wb-byte n value i)))
