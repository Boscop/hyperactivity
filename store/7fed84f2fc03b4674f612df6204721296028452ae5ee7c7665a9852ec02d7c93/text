-- Single-Instruction 64-Row Supergate Equivalence Certificates (ABC 6-cut matching in 1 Word op!):
-- 1. `(x0 & x1) | x2 ≡ INV(AOI21(x0, x1, x2))` across all 2^6 = 64 cut rows!
-- 2. `(x0 | x1) & x2 ≡ INV(OAI21(x0, x1, x2))` across all 2^6 = 64 cut rows!
-- 3. Full-adder carry `(x0 & x1) | ((x0 ^ x1) & x2) ≡ MAJ3(x0, x1, x2)` across all 64 cut rows!
-- 4. 4-NAND2 XOR macro ≡ `x3 ^ x4` across all 64 cut rows!
supergate-6cut-certs :
  (%wor (%wand w64-x0 w64-x1) w64-x2 ≡ w64-not (sg-aoi21 w64-x0 w64-x1 w64-x2)) ×
  (%wand (%wor w64-x0 w64-x1) w64-x2 ≡ w64-not (sg-oai21 w64-x0 w64-x1 w64-x2)) ×
  (%wor (%wand w64-x0 w64-x1) (%wand (%wxor w64-x0 w64-x1) w64-x2) ≡ sg-maj3 w64-x0 w64-x1 w64-x2) ×
  (let m = sg-nand2 w64-x3 w64-x4 in sg-nand2 (sg-nand2 w64-x3 m) (sg-nand2 m w64-x4) ≡ %wxor w64-x3 w64-x4)
supergate-6cut-certs =
  ( (λ _ → %wor (%wand w64-x0 w64-x1) w64-x2)
  , ((λ _ → %wand (%wor w64-x0 w64-x1) w64-x2)
  , ((λ _ → sg-maj3 w64-x0 w64-x1 w64-x2)
  , (λ _ → %wxor w64-x3 w64-x4))) )
