-- n applications of one step, at n, n − 1, …, 1, each reading the previous interval as input 0 and its
-- index through the inputs envt gives it
irun : List Bool → List Bool → (Nat → IV → Nat → IV) → IE → Nat → IV × Bool → IV × Bool
irun S S2 envt step n = case n return λ w → IV × Bool → IV × Bool of
  zero → λ st → st
  suc g → λ st → rec g (istep st (ieval S S2 (envt (suc g) (fst st)) step))
