drop-map : {A B : Type} → (f : A → B) → (h : Nat) → (l : List A) → drop-n h (list-map f l) ≡ list-map f (drop-n h l)
drop-map f h =
  case h return λ w → (l : List A) → drop-n w (list-map f l) ≡ list-map f (drop-n w l) of
    zero → λ l i → list-map f l
    suc h1 → λ l → (case l return λ v → drop-n (suc h1) (list-map f v) ≡ list-map f (drop-n (suc h1) v) of nil → λ i → nil; cons x r → rec h1 r)
