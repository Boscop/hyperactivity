-- ── 3. Max-Compressed Shared 4-Byte Wire Language (32-Bit Cell Packet) ───────
-- Bit layout: [kind:3 (bits 0..2) | label:5 (bits 3..7) | prin:8 (bits 8..15) | aux1:8 (bits 16..23) | aux2:8 (bits 24..31)]
data INetCell = icell (kind : CellKind) (label : Word) (prin : Word) (aux1 : Word) (aux2 : Word)
