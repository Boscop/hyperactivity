-- over the texts: how many occurrences, and what followed the first q met
c-after : (n : Nat) → Bytes n → (k : Nat) → Bytes k → Word → Word → Word → List (List Word × Word) → Proc W (Word × List (List Word))
c-after n p k f m e q nil = ret (#0 , nil)
c-after n p k f m e q (cons x r) = bind (c-after-one n p k f m e q x) (λ one →
  bind (c-after n p k f m e (wsub q (m-len #0 (list-map (λ l → #0) (snd one)))) r) (λ rest → ret (wadd (fst one) (fst rest) , list-append (snd one) (snd rest))))
