-- the witness of a symmetric integer matrix given by its rows: the unit vectors made orthogonal for its form over
-- the rationals (untrusted), each scaled to integers
hc-wit : (m : List (List BZ)) → List (sy-vn ZrC (cq-len m))
hc-wit m = ln-map (List BQ) (sy-vn ZrC (cq-len m)) (λ v → zr-tup (cq-len m) (zr-scl v)) (cq-gs (ln-mform (cq-qm m)) (cq-up (cq-len m) zero (cq-len m)) nil)
