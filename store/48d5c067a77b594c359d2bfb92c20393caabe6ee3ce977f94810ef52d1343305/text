-- the value of a bit-field at its declared type: the bits, extended by the type's sign
cx-bf-val : SK → Word → UInt64 → MRes SV
cx-bf-val k w x = case k of
  sk-int sg iw → (case sg of
    false → mok (sv-i x)
    true → (case weq w #64 of
      true → mok (sv-i x)
      false → mok (sv-i (uq-sar (u64shl x (u64 (wsub #64 w))) (u64 (wsub #64 w))))))
  sk-bool → mok (sv-b (not (uq-iszero x)))
  sk-f32 → mstop st-ill-typed
  sk-f64 → mstop st-ill-typed
  sk-ptr → mstop st-ill-typed
