dm-collect-missing-kg : List Word → List (List Word) → List Word
dm-collect-missing-kg kgTxt nil = nil
dm-collect-missing-kg kgTxt (cons ln lns) =
  let ws = h-split #32 ln
  in case ws of
       nil → dm-collect-missing-kg kgTxt lns
       cons hx rest →
         case rest of
           nil → dm-collect-missing-kg kgTxt lns
           cons mh rs →
             if h-eq hx "names"
             then dm-collect-missing-kg kgTxt lns
             else
               let p = h-unhex hx
               in if andB (dm-is-kg-domain p) (eth-not (h-infix (h-quote p) kgTxt))
                  then
                    let m16  = h-take (toNat #16) mh
                        dom  = h-before "/" p
                        desc = list-append p " - Pure Checked .hypercubical Module (0 postulates, guard rc=0)"
                        item = h-concat
                                 (cons ",[" (cons (h-quote p)
                                 (cons "," (cons (h-quote m16)
                                 (cons "," (cons (h-quote dom)
                                 (cons "," (cons (h-quote desc)
                                 (cons ",[],[],36,24000]" nil)))))))))
                    in list-append item (dm-collect-missing-kg kgTxt lns)
                  else dm-collect-missing-kg kgTxt lns
