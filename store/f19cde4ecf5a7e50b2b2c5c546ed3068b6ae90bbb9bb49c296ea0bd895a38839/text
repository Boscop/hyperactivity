rat-write-bounded : (ep : Nat) → (rat : RAT) → RatBounded ep rat → (rd : Word) →
  RatBounded (suc ep) (rat-write rd (suc ep , rd) rat)
rat-write-bounded ep rat hb rd r =
  case (weq r rd) return (λ b → Path Bool (leB (fst (the PhysTag (if b then (suc ep , rd) else rat r))) (suc ep)) true) of
    true  → leB-refl (suc ep)
    false → leB-suc-r (fst (rat r)) ep (hb r)
