rm-class : Target → RTy → RSt RClass
rm-class t rty-bool = sr-ok (cl-scalar sk-bool)
rm-class t (rty-int k) = sr-ok (cl-scalar (rm-ik t k))
rm-class t rty-never = sr-ok cl-unit
rm-class t (rty-ref m p) = case rm-unsized p of
  true → sr-ok (cl-fat (rm-meta-sk t p))
  false → sr-ok (cl-scalar sk-ptr)
rm-class t (rty-ptr m p) = case rm-unsized p of
  true → sr-ok (cl-fat (rm-meta-sk t p))
  false → sr-ok (cl-scalar sk-ptr)
rm-class t (rty-array e n) = sr-ok cl-mem
rm-class t (rty-tuple ts) = case ts of
  rtys-nil → sr-ok cl-unit
  _ → sr-ok cl-mem
rm-class t (rty-adt i ts) = sr-ok cl-mem
rm-class t (rty-fn-ptr ps r) = sr-ok (cl-scalar sk-ptr)
rm-class t ty = sr-ill (ri-class ty)
