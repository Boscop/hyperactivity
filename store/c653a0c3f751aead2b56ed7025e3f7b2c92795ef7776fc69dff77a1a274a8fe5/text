-- an operation arrives at a wire
k-put-op : KSlot → Word → KOp → KState → KState
k-put-op ks-none w o (k-state sl rd n) = k-state (ksl-cons w (ks-op o) sl) rd n
k-put-op (ks-val v) w o (k-state sl rd n) = k-state (k-del sl w) (kp-cons o v rd) n
k-put-op (ks-op p) w o st = st
k-put-op (ks-readers os) w o st = st
