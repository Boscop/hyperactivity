-- security headers sent on every HTTP response (same-origin iframes permitted for live /nets & /pdf embeds)
s-sec-headers : List Word
s-sec-headers = h-concat (cons "Strict-Transport-Security: max-age=31536000; includeSubDomains" (cons h-crlf (cons "X-Content-Type-Options: nosniff" (cons h-crlf (cons "Referrer-Policy: strict-origin-when-cross-origin" (cons h-crlf (cons "X-Frame-Options: SAMEORIGIN" (cons h-crlf nil))))))))
