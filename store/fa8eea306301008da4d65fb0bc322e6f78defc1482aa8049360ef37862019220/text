-- The 3 Exact Benchmark Programs Compiled to Both `hypernet_mesh_4tile` and `riscv32_pipe`:
hn-tree-8leaf : Nat → HNode
hn-tree-8leaf b =
  hn-add
    (hn-add (hn-add (hn-lit b) (hn-lit (suc b)))
            (hn-add (hn-lit (plus (toNat #2) b)) (hn-lit (plus (toNat #3) b))))
    (hn-add (hn-add (hn-lit (plus (toNat #4) b)) (hn-lit (plus (toNat #5) b)))
            (hn-add (hn-lit (plus (toNat #6) b)) (hn-lit (plus (toNat #7) b))))
