b_xor i' j' =
  bindF {Unit} {ZI} (fl-assert {exception} (b-and (z-le (zpos #0) i') (b-and (z-le i' (zpos #1)) (b-and (z-le (zpos #0) j') (z-le j' (zpos #1))))) #149467514486126185021078021591788501297) (λ _ →
    let t'2 : ZI
        t'2 =
          if (z-eq i' (zpos #0)) then
            (if (z-eq j' (zpos #0)) then (zpos #0) else (zpos #1))
          else
            (if (z-eq j' (zpos #0)) then (zpos #1) else (zpos #0))
    in retF {ZI} t'2)
