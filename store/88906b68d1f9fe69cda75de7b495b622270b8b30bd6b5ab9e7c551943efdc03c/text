-- and the consequence: for a meso compound, every observation of the orientation that is invariant
-- under relabelling reads the same on the molecule and on its mirror image. The two are one
-- substance, and no amount of care with the digest recovers that — it is the automorphism that
-- carries it.
meso-self-mirror : (S : Oriented) → Meso S → (B : Type 0) → (f : (mol-atoms (or-mol S) → Hand) → B) → ((a : Auto (or-mol S)) → (h : mol-atoms (or-mol S) → Hand) → f (λ x → h (auto-fun (or-mol S) a x)) ≡ f h) → f (or-hand (or-mirror S)) ≡ f (or-hand S)
meso-self-mirror S m B f inv = concat (cong f (λ i → λ x → sym (snd m x) i)) (inv (fst m) (or-hand S))
