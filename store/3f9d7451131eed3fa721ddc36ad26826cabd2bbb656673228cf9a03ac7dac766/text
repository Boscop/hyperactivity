sg-take-sym : List Word → List Word → List Word × List Word
sg-take-sym nil acc = (sg-rev-w acc nil , nil)
sg-take-sym (cons c r) acc =
  if nk-is-ws c then (sg-rev-w acc nil , cons c r)
  else if %weq c #40 then (sg-rev-w acc nil , cons c r)
  else if %weq c #41 then (sg-rev-w acc nil , cons c r)
  else sg-take-sym r (cons c acc)
