sg-bname-raw : Nat → Word → NkSexp → List Word
sg-bname-raw zero fr _ = sg-fresh-nm fr
sg-bname-raw (suc _) fr (nks-sym s) =
  case nk-after-eq s return (λ _ → List Word) of
    some nm → nm
    none → sg-fresh-nm fr
sg-bname-raw (suc k) fr (nks-lst xs) =
  if %weq (sg-sx-len xs) #0 then sg-fresh-nm fr else sg-bname-raw k fr (sg-sx0 xs)
