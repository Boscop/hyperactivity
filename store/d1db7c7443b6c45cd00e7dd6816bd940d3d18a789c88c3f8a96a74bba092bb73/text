nk-env-ev-nth-at : (z : Bool) (rho : NkW → NkEv) (w : NkW) (r : NkEnv) (i : Word) →
  (nk-opt-ev rho (nk-env-nth-w r (%wsub i #1)) ≡ nk-ev-nth (nk-env-ev rho r) (%wsub i #1)) →
  nk-opt-ev rho (if z then some w else nk-env-nth-w r (%wsub i #1))
  ≡ (if z then rho w else nk-ev-nth (nk-env-ev rho r) (%wsub i #1))
nk-env-ev-nth-at true rho w r i ih = refl
nk-env-ev-nth-at false rho w r i ih = ih
