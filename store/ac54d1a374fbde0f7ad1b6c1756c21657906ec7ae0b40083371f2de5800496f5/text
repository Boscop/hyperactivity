-- angular (inputs 0 t = s_{l+2}, 1 p², 2 A, 3 m = 1/l): s_l = p² α_{l−2}/(l(l+1) − A − p² β_l − p² γ_{l+2} t)
-- divided through by l², with α_{l−2} = (1−m)/((2−3m)(2−m)), β_l = (2+2m−m²)/((2−m)(2+3m)),
-- γ_{l+2} = (1+2m)(1+m)/((2+3m)(2+5m))
ang-alpha : IE
ang-alpha = ie-div (ie-sub (ie-int 1) (ie-var 3)) (ie-mul (ie-sub (ie-int 2) (ie-mul (ie-int 3) (ie-var 3))) (ie-sub (ie-int 2) (ie-var 3)))
