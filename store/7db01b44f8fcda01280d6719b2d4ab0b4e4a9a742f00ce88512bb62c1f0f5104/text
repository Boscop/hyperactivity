place-row-after : (y0 h gap : Nat) → (ws : List Nat) → (bound xCur : Nat) →
  leB bound xCur ≡ true → AllAfter bound (place-row xCur y0 h gap ws)
place-row-after y0 h gap nil = λ bound xCur hb → unit
place-row-after y0 h gap (cons w ws) = λ bound xCur hb →
  ( hb
  , place-row-after y0 h gap ws bound (plus gap (plus w xCur))
      (leB-trans bound xCur (plus gap (plus w xCur)) hb (place-step-mono xCur w gap)) )
