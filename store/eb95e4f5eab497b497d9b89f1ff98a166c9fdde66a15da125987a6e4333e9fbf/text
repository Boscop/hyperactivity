sg-parse-decl : Nat → Nat → Word → List Word → List Word → Opt (Code × Lst Code)
sg-parse-decl pf cf d dhex txt =
  case sg-parse-sexp pf false txt return (λ _ → Opt (Code × Lst Code)) of
    none → none
    some p →
      let xs = sg-sx-items (fst (fst p))
          tl3 = sg-sx-tl (sg-sx-tl (sg-sx-tl xs))
          ps = sg-sx-tl (sg-sx-items (sg-sx0 tl3))
          cs = sg-sx-tl tl3
          dsym = cons #68 dhex
          pr = sg-decl-cf cf dsym lnil ps
          cform = fst (fst pr)
          np = snd (fst pr)
          pds = fst (snd pr)
          pcts = snd (snd pr)
      in some (cform , sg-decl-ctors cf d dsym np pds pcts cs)
