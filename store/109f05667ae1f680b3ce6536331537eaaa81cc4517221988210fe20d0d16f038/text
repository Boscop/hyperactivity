-- the query is at most its upper bound
si-up-ge-c : (r : List (List Word)) → (x : List Word) → isTrue (lexle (lexle word-le) (cons x r) (sq-up-c #256 r x))
si-up-ge-c r = case r return λ w → (x : List Word) → isTrue (lexle (lexle word-le) (cons x w) (sq-up-c #256 w x)) of
  nil → λ x → si-step-ge (lexle word-le x (list-append x (cons #256 nil))) (lexle word-le (list-append x (cons #256 nil)) x)
    (si-app-ge word-le (fst word-order) x (cons #256 nil))
  cons z r2 → λ x → step-eq {lexle word-le x x} {lexle word-le x x} {lexle (lexle word-le) (cons z r2) (sq-up-c #256 r2 z)}
    (lex-refl word-order x) (lex-refl word-order x) (rec r2 z)
