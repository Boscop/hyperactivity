-- hydrogen: 1s at −Z²/2, 2s at −Z²/8, orthogonal
oc-hyd : oc-all (λ z → if fn-eq (oc-e z (oc-1s z)) (bq-mul (fn-nq 1 2) (oc-sq z)) then (if fn-eq (oc-e z (oc-2s z)) (bq-mul (fn-nq 1 8) (oc-sq z)) then fn-eq (oc-s (oc-1s z) (oc-2s z)) (fn-q 0 1) else false) else false) oc-zs ≡ true
oc-hyd = λ i → true
