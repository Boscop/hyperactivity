tw-lem-opB-dispatch : (t : Word) → (x y : Bool) →
  (if %weq t #0 then web-xorB x y else if %weq t #1 then web-andB x y else if %weq t #3 then web-notB x else in-opB t x y) ≡ in-opB t x y
tw-lem-opB-dispatch t x y = tw-lem-opB-go t x y (%weq t #0) (%weq t #1) (%weq t #2) (%weq t #3) refl refl refl refl
