best-lam-scan : List MTerm → List MTerm → (List MTerm × List MTerm) × Word → (List MTerm × List MTerm) × Word
best-lam-scan full nil best = best
best-lam-scan full (cons a nil) best = best
best-lam-scan full (cons a (cons b nil)) best = best
best-lam-scan full (cons a (cons b (cons c r))) best =
  let pre = cons a nil
      suf = cons c nil
      sc = lam-score pre suf full
      best2 : (List MTerm × List MTerm) × Word
      best2 = if wlt (snd best) sc then ((pre , suf) , sc) else best
  in best-lam-scan full (cons b (cons c r)) best2
