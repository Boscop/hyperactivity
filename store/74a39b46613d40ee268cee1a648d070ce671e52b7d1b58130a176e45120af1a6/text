dmap-fmap : (n : Nat) (X : Type 1) (F F' : X → Type 1) (Z : Type 1) (h : (x : X) → F x → F' x) (k : (x : X) → F' x → Z) (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → Cube n Z) (dcube-map n X F' Z k c (dcube-fmap n X F F' h c d)) (dcube-map n X F Z (λ x y → k x (h x y)) c d)
dmap-fmap zero X F F' Z h k c d = λ i → k c (h c d)
dmap-fmap (suc n) X F F' Z h k c d = dmap-fmap n (Line X) (LineO X F) (LineO X F') (Line Z) (lineo-fmap X F F' h) (lineo-map X F' Z k) c d
