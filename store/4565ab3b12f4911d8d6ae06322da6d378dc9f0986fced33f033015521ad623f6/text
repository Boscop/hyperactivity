-- Key C11 shift-safety lemma: when b != 0, 64 - b < 64 strictly, so hy_shl's overflow check
-- a >> (64 - b) never shifts by >= 64 bits (catching the b == 0 UB in unguarded 64 - b!)
cs-shl-guard : (b : Word) → (%weq b #0 ≡ false) → %wlt (%wsub #64 b) #64 ≡ true
cs-shl-guard b h =
  %welimP (λ v → (%weq v #0 ≡ false) → %wlt (%wsub #64 v) #64 ≡ true) b
    (λ h0 → cs-no (sym h0))
    (λ n hn hnz →
       sym (ltw≡wlt (%wsub #64 (%wsucc n)) #64)
       ∙ (cong (λ z → ltw z #64) (sym (subw≡wsub #64 (%wsucc n)))
          ∙ cs-subw-lt-succ #63 n))
    h
