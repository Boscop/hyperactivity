-- Exact Domain Gluing Theorem:
-- If c1* is locally frustration-free (d1 c1* ≡ 0), c2* is locally frustration-free (d2 c2* ≡ 0),
-- they glue on the interface (r1 c1* ≡ r2 c2*), and their interface is frustration-free
-- (d12 c1* c2* ≡ 0), then the glued global conformation has exact total defect 0
-- (provably a global native minimum over the entire product space without searching C1 × C2).
fold-domain-glues-native :
  (C1 C2 I : Type 0) → (r1 : C1 → I) → (r2 : C2 → I) →
  (d1 : C1 → Nat) → (d2 : C2 → Nat) → (d12 : C1 → C2 → Nat) →
  (c1 : C1) → (c2 : C2) →
  (agree : r1 c1 ≡ r2 c2) →
  d1 c1 ≡ zero → d2 c2 ≡ zero → d12 c1 c2 ≡ zero →
  glued-defect {C1} {C2} {I} {r1} {r2} d1 d2 d12 ((c1 , c2) , agree) ≡ zero
fold-domain-glues-native C1 C2 I r1 r2 d1 d2 d12 c1 c2 agree z1 z2 z12 =
  λ i → plus (z1 i) (plus (z2 i) (z12 i))
