-- ---------------------------------------------------------------- every rule and nk-build obeys the two-ended wire discipline
nk-out-ok : NkEnv → NkEnv → NkW → NkW → NkOut → Bool
nk-out-ok ins outs n0 nst (nk-out fx n ws) =
  nk-and (nk-wire-le nst n)
    (nk-and (nk-fx-wf ins outs n0 n fx)
      (nk-env-in-range n0 n ws))
