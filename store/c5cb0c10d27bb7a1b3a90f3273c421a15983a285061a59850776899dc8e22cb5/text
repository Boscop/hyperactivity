conj-has-sound : (sk : Lst Entry) (l : Lit) (c : Conj) → conj-has l c ≡ true → IEq sk (conj-ix c) (ixmeet (lit-ix l) (conj-ix c))
conj-has-sound sk l lnil e = false-true2 (IEq sk (conj-ix lnil) (ixmeet (lit-ix l) (conj-ix lnil))) e
conj-has-sound sk l (lcons m ms) hm =
  bool-case2 (λ b → (if b then true else conj-has l ms) ≡ true → IEq sk (conj-ix (lcons m ms)) (ixmeet (lit-ix l) (conj-ix (lcons m ms)))) (lit-eq l m)
    (λ e h → absorb-lit sk l m ms e)
    (λ e h → (ieq-trans sk (conj-ix (lcons m ms)) (ixmeet (lit-ix m) (conj-ix ms)) (ixmeet (lit-ix l) (conj-ix (lcons m ms)))
    (conj-ix-cons sk m ms)
    (ieq-trans sk (ixmeet (lit-ix m) (conj-ix ms)) (ixmeet (lit-ix m) (ixmeet (lit-ix l) (conj-ix ms))) (ixmeet (lit-ix l) (conj-ix (lcons m ms)))
    (ieq-meet sk (lit-ix m) (lit-ix m) (conj-ix ms) (ixmeet (lit-ix l) (conj-ix ms)) (ieq-refl sk (lit-ix m)) (conj-has-sound sk l ms h))
    (ieq-trans sk (ixmeet (lit-ix m) (ixmeet (lit-ix l) (conj-ix ms))) (ixmeet (lit-ix l) (ixmeet (lit-ix m) (conj-ix ms))) (ixmeet (lit-ix l) (conj-ix (lcons m ms)))
    (meet-rot sk (lit-ix m) (lit-ix l) (conj-ix ms))
    (ieq-meet sk (lit-ix l) (lit-ix l) (ixmeet (lit-ix m) (conj-ix ms)) (conj-ix (lcons m ms)) (ieq-refl sk (lit-ix l)) (ieq-sym sk (conj-ix (lcons m ms)) (ixmeet (lit-ix m) (conj-ix ms)) (conj-ix-cons sk m ms))))))) hm
