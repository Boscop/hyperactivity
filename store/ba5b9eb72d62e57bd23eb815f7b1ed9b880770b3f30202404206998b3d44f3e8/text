cs-ext-loadv : (hp1 hp2 : CsHeap) (addr idx : Nat) (v : CsVal) →
  cs-heap-ext hp1 hp2 →
  (cs-loadv hp1 (csv-ptr addr) idx ≡ csov-some v) →
  cs-loadv hp2 (csv-ptr addr) idx ≡ csov-some v
cs-ext-loadv hp1 hp2 addr idx v ext h =
  cong cs-optv (ext addr idx v (cs-loadv-inv (cs-load hp1 (csv-ptr addr) idx) v h))
