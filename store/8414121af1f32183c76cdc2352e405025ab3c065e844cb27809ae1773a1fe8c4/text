dm-start-daemon : Proc W Unit
dm-start-daemon =
  bind (bn-load-funded-key true) (λ priv →
  bind (h-mkdir dm-out-dir) (λ m0 →
  bind (h-mkdir "/tmp/hx_agent_bus") (λ m1 →
  bind (dm-seed-hxsv-if-missing "/tmp/hx_agent_bus/treasury_live.hxsv" #1 #8453) (λ s0 →
  bind (dm-seed-hxsv-if-missing "/tmp/hx_agent_bus/p2p_reactor.hxsv" #1 #1656) (λ s1 →
  bind (dm-seed-hxsv-if-missing "/tmp/hx_agent_bus/phys_collider_live.hxsv" #1 #940) (λ s2 →
  bind (dm-seed-hxsv-if-missing "/tmp/hx_agent_bus/physical_datatypes.hxsv" #1 #40) (λ s3 →
  bind (dm-seed-hxsv-if-missing "/tmp/hx_agent_bus/hfke_swarm_exchange.hxsv" #1 #100) (λ s4 →
  bind (h-out (bn-ln "[HX-DIAMOND-HFKE | REALTIME SWARM HIGH-FREQUENCY KNOWLEDGE EXCHANGE + ACTUATOR ONLINE]")) (λ m2 →
    dm-daemon-loop (toNat #1000000000) priv (eth-priv-to-addr20 priv) #1 #0 "ARMED_HFKE_SWARM")))))))))
