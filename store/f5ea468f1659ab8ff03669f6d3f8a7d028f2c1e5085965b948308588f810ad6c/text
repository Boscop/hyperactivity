-- the enclosing type depends on the hole only through the hole's type
xp-plug-infer : (g : List XpTy) → (k : XpK) → (t t2 : XpExpr) → xp-infer g t ≡ xp-infer g t2 → xp-infer g (xp-plug k t) ≡ xp-infer g (xp-plug k t2)
xp-plug-infer g xk-hole t t2 h = h
xp-plug-infer g (xk-plus-l k b) t t2 h = λ i → xp-plus-ty (xp-plug-infer g k t t2 h i) (xp-infer g b)
xp-plug-infer g (xk-plus-r a k) t t2 h = λ i → xp-plus-ty (xp-infer g a) (xp-plug-infer g k t t2 h i)
xp-plug-infer g (xk-pair-l k b) t t2 h = λ i → xp-pair-ty (xp-plug-infer g k t t2 h i) (xp-infer g b)
xp-plug-infer g (xk-pair-r a k) t t2 h = λ i → xp-pair-ty (xp-infer g a) (xp-plug-infer g k t t2 h i)
xp-plug-infer g (xk-fst k) t t2 h = λ i → xp-fst-ty (xp-plug-infer g k t t2 h i)
xp-plug-infer g (xk-snd k) t t2 h = λ i → xp-snd-ty (xp-plug-infer g k t t2 h i)
