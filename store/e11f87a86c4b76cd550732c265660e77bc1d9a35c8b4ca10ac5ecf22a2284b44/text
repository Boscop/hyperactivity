opt-not-sound : {V : Type} → (env : V → Bool) → (x : Circ B0 B1 B2 V) →
  fold {B0} {B1} {B2} {V} {Bool} bool-alg env (opt-not x) ≡
  not (fold {B0} {B1} {B2} {V} {Bool} bool-alg env x)
opt-not-sound env (cwire v) = refl
opt-not-sound env (cop0 c) = opt-not-0-sound env c
opt-not-sound env (cop1 u a) = opt-not-1-sound env u a
opt-not-sound env (cop2 b x y) = refl
