-- (2026-11-12) matches CCHM §4.5 “Equality judgments for composition” (paths), for dependent paths: at each j, composition with the
-- tube applied at j and the endpoint lines on the faces j = 0 and j = 1.
%comp-path P l r u p0 =
  λ (j : I) →
    comp (λ (i : I) → P @ i @ j)
      (sys+ (j = 0) l
         (sys+ (j = 1) r (sysmap (λ w (i : I) → %@ (w @ i) j (l @ i) (r @ i)) u)))
      (%@ p0 j (l @ 0) (r @ 0))
