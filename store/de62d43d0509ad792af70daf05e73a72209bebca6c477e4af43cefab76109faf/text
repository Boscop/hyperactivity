-- THEOREM 4: UNIVERSAL ARBITRARY-DEPTH TOWER SOUNDNESS FOR ALL DEPTHS k : Nat!
tw-thm-tower-sound : (k : Nat) → (f : INet → INet) →
  ((env : Word → Bool) → (n : INet) → in-eval env (f n) ≡ in-eval env n) →
  (env : Word → Bool) → (n : INet) → in-eval env (in-tower k f n) ≡ in-eval env n
tw-thm-tower-sound zero    _ _  _   _ = refl
tw-thm-tower-sound (suc k) f pf env n = web-trans-b (pf env (in-tower k f n)) (tw-thm-tower-sound k f pf env n)
