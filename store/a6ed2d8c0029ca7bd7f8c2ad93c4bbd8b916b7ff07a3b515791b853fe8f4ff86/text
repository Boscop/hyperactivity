cs-app-cont : (CsHeap → CsEnv → CsExp → CsRes) → CsFns → CsHeap → CsVal → Word → Word → Word → Lst CsVal → CsRes
cs-app-cont ev fns hp1 vx fn0 ar0 n0 held =
  let all = cs-snoc CsVal held vx
  in if %weq (%wadd n0 #1) ar0 then cs-call-fn ev fns hp1 fn0 all else cs-hy-clo hp1 fn0 ar0 (%wadd n0 #1) all
