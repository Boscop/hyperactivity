-- Energy accounting: synchronous clock tree burns eClk on EVERY tick; GALS burns 0 on idle ticks!
sync-energy : {Ev : Type} → Nat → Nat → List (Sum Ev Unit) → Nat
sync-energy eClk eAct nil = zero
sync-energy eClk eAct (cons tk rest) =
  case tk of
    inl ev → plus (plus eClk eAct) (sync-energy eClk eAct rest)
    inr u  → plus eClk (sync-energy eClk eAct rest)
