cs-sim-mod-at : (zb : Bool) (hp : CsHeap) (a b : Word) → (%weq b #0 ≡ zb) →
  cs-res-rel (cmv-word (if zb then a else %wmod a b))
    (if zb then cso-ok hp (csv-word a) else cs-prim-res hp (cs-c11-mod a b)) ≡ true
cs-sim-mod-at true hp a b hzb = cs-weq-self a
cs-sim-mod-at false hp a b hzb =
  cong (λ z → cs-res-rel (cmv-word (%wmod a b)) (cs-prim-res hp (if z then csp-ub else csp-ok (%wmod a b)))) hzb
  ∙ cs-weq-self (%wmod a b)
