-- a line of types is an equivalence from its start to its end: the identity equivalence of the
-- start carried along the line of equivalences from the start to each point
nk-line-equiv : NkTm → NkTm
nk-line-equiv line = nk-transp (nk-lam (nk-equiv (nk-app (nk-up line) nk-i0) (nk-app (nk-up line) (nk-var #0)))) nk-i0 nk-ideq
