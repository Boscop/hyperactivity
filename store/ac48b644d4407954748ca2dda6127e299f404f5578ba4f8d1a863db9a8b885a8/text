-- the certificate: s > 0, ⟨H⟩ < −5/2, the variance bound nonnegative, and lo ≤ L, ⟨H⟩ ≤ hi
ht-cert3 : BQ → BQ → BQ → BQ → BQ → Bool
ht-cert3 s e v lo hi = if bq-pos s then (if bq-pos (fn-sub (fn-nq 5 2) e) then (if fst v then (if ht-le lo (ht-low e v) then ht-le e hi else false) else false) else false) else false
