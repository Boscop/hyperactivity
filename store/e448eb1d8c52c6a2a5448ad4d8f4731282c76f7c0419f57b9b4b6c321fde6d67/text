-- the operations return canonical numbers
bin-cons-canon : (b : Bool) → (n : List Bool) → bcanon n ≡ true → bcanon (bin-cons b n) ≡ true
bin-cons-canon b n = case b return λ u → bcanon n ≡ true → bcanon (bin-cons u n) ≡ true of
  true → (case n return λ m → bcanon m ≡ true → bcanon (bin-cons true m) ≡ true of
    nil → λ h → λ i → true
    cons x r → λ h → h)
  false → (case n return λ m → bcanon m ≡ true → bcanon (bin-cons false m) ≡ true of
    nil → λ h → λ i → true
    cons x r → λ h → h)
