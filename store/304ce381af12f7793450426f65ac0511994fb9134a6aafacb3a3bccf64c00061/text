c-pack-write : List Word → List Word → Proc W Unit
c-pack-write d mods = bind (h-cstr (list-append c-dir (list-append d ".text"))) (λ p → bind (sys-call #2 p #577 #420 #0 #0 #0) (λ fd →
  if wlt fd #9223372036854775808 then bind (c-put-modules fd (h-lines mods)) (λ u → bind (sys-call #3 fd #0 #0 #0 #0 #0) (λ c →
    bind (h-write (list-append c-dir (list-append d ".mods")) mods) (λ ok → ret unit)))
  else h-fail "chat: a pack could not be written"))
