bl-eth-call : List Word → List Word → Proc W (List Word)
bl-eth-call toAddr callData =
  let param = h-concat
                (cons "[{" (cons (h-quote "to") (cons ":" (cons (h-quote toAddr)
                (cons "," (cons (h-quote "data") (cons ":" (cons (h-quote callData)
                (cons "}," (cons (h-quote "latest") (cons "]" nil)))))))))))
  in bind (bl-rpc-call "eth_call" param) (λ r → ret {lzero} {W} (bl-extract-json-hex r))
