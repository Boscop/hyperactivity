-- the pieces between a row's pipes: the text before its first pipe and after its last are not cells
s-cells-inner : List (List Word) → List (List Word)
s-cells-inner nil = nil
s-cells-inner (cons x nil) = if h-null (h-trim x) then nil else cons x nil
s-cells-inner (cons x (cons y r)) = cons x (s-cells-inner (cons y r))
