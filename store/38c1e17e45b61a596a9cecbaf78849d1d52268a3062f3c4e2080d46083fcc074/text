lut-lookup-tab : (k : Nat) → (f : Vec Bool k → Bool) → (v : Vec Bool k) →
  lut-lookup k (lut-tabulate k f) v ≡ f v
lut-lookup-tab zero f v = λ i → f (unit-eta v i)
lut-lookup-tab (suc k) f v =
  case (fst v) return (λ b →
    Path Bool
      (if b then lut-lookup k (lut-tabulate k (λ ys → f (true , ys))) (snd v)
            else lut-lookup k (lut-tabulate k (λ ys → f (false , ys))) (snd v))
      (f (b , snd v))) of
    false → lut-lookup-tab k (λ ys → f (false , ys)) (snd v)
    true  → lut-lookup-tab k (λ ys → f (true  , ys)) (snd v)
