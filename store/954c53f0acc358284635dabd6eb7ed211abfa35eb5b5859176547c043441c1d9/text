-- ---------------------------------------------------------------- wire-shared evaluation over a signature
nk-init-defs : NkTm → Word → NkSlots → NkSlots
nk-init-defs (nk-cons (nk-con c (nk-cons body r1)) rest) idx sl =
  nk-init-defs rest (%wsucc idx) (nk-set sl (nk-bw-of idx) (nks-val (nkv (hd-susp body) nke-nil)))
nk-init-defs d idx sl = sl
