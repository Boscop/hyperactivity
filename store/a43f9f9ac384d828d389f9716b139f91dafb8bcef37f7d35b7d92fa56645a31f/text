nk-trim-susp-fo-sound : (k : Nat) (rho : NkW → NkEv) (b : NkTm) (e : NkEnv) (o : NkOut) →
  (nk-fo-tm b ≡ true) → (nk-ebound e (nk-n o) ≡ true) →
  nk-ev-go k (nkevj-tm b (nk-env-ev (nk-rho-trim rho b #0 e o) (nk-ws (nk-trim-susp b #0 e o))))
  ≡ nk-ev-go k (nkevj-tm b (nk-env-ev rho e))
nk-trim-susp-fo-sound k rho b e o hfo hb =
  cong (λ z → nk-ev-go k (nkevj-tm b z)) (nk-trim-susp-denotes rho b #0 e o hb)
  ∙ nk-uses-var-fo-sound k b (nk-trim-ev b #0 (nk-env-ev rho e)) (nk-env-ev rho e) hfo
      (λ i hu → nk-trim-ev-nth-zero b (nk-env-ev rho e) i hu)
