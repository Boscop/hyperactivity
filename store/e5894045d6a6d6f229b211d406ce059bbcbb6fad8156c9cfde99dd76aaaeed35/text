-- a range of lines: from the first line on, not ending before it begins
-- the lines of a pull: ranges FROM TO, in order, each beginning after the last ended (a subsequence of
-- the document's lines)
hy-ranges-ok-after : Word → List Word → Bool
hy-ranges-ok-after prev nil = true
hy-ranges-ok-after prev (cons x nil) = false
hy-ranges-ok-after prev (cons x (cons y r)) = if wlt prev x then (if wlt y x then false else hy-ranges-ok-after y r) else false
