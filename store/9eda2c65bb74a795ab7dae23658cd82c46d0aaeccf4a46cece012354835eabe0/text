-- two codes the same, for the constructs a neutral's spine is made of (variables, globals, words,
-- applications, projections, pairs, λs, word operations, primitives, constructors, word eliminations);
-- any other construct answers false, which only leaves a pair unshared
c-same : Nat → Code → Code → Bool
c-same zero a b = false
c-same (suc n) (cvar i) (cvar j) = %weq i j
c-same (suc n) (cglob i) (cglob j) = %weq i j
c-same (suc n) (cwlit i) (cwlit j) = %weq i j
c-same (suc n) (capp f a) (capp g b) = andB (c-same n f g) (c-same n a b)
c-same (suc n) (cfst a) (cfst b) = c-same n a b
c-same (suc n) (csnd a) (csnd b) = c-same n a b
c-same (suc n) (cpair a b) (cpair c d) = andB (c-same n a c) (c-same n b d)
c-same (suc n) (clam a) (clam b) = c-same n a b
c-same (suc n) (cwop k a b) (cwop l c d) = andB (%weq k l) (andB (c-same n a c) (c-same n b d))
c-same (suc n) (cprim k as) (cprim l bs) = andB (%weq k l) (l-same (c-same n) as bs)
c-same (suc n) (ccon d k fs ds) (ccon d2 k2 fs2 ds2) = andB (%weq d d2) (andB (%weq k k2) (andB (l-same (c-same n) fs fs2) (l-same (c-same n) ds ds2)))
c-same (suc n) (cwelim w z s mo) (cwelim w2 z2 s2 mo2) = andB (c-same n w w2) (andB (c-same n z z2) (c-same n s s2))
c-same (suc n) a b = false
