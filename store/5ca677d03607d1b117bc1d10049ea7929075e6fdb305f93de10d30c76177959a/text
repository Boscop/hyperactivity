nk-edisj-not-mem : (w : NkW) (e1 e2 : NkEnv) → (nk-edisj e1 e2 ≡ true) → (nk-emem w e1 ≡ true) → nk-emem w e2 ≡ false
nk-edisj-not-mem w nke-nil e2 hd hm = nk-no hm
nk-edisj-not-mem w (nke-cons x r) e2 hd hm =
  nk-edisj-not-mem-at (nk-weq w x) (nk-emem x e2) w x r e2 refl refl hm hd (λ d m → nk-edisj-not-mem w r e2 d m)
