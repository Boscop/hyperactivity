-- ---------------------------------------------------------------- x86-64 Linux
-- the numbers of arch/x86/entry/syscalls/syscall_64.tbl
x86-64-sysnr : Sys → Word
x86-64-sysnr s = case s of
  sys-read → #0
  sys-write → #1
  sys-open → #2
  sys-close → #3
  sys-mmap → #9
  sys-mprotect → #10
  sys-munmap → #11
  sys-nanosleep → #35
  sys-getpid → #39
  sys-socket → #41
  sys-connect → #42
  sys-sendto → #44
  sys-recvfrom → #45
  sys-bind → #49
  sys-listen → #50
  sys-setsockopt → #54
  sys-futex → #202
  sys-clock-gettime → #228
  sys-exit-group → #231
  sys-epoll-wait → #232
  sys-epoll-ctl → #233
  sys-accept4 → #288
  sys-epoll-create1 → #291
