count-phi-f : (f : List (List Word) → Word) → (a : El PO) → (l : List (El entry-ord)) → eqo {PO} a (phi f (snd a)) ≡ false →
              count {PO} a (list-map (phi f) l) ≡ zero
count-phi-f f a l c =
  case l return λ w → count {PO} a (list-map (phi f) w) ≡ zero of
    nil → λ i → zero
    cons e q → λ i → plus (one-if (eqo-phi-c f a e c i)) (rec q i)
