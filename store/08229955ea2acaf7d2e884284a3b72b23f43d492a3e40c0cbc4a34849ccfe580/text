all-f4-sound : (p : Fin4 → Bool) → all-f4 p ≡ true → (x : Fin4) → p x ≡ true
all-f4-sound p h f4-0 = andB-l (p f4-0) (andB (p f4-1) (andB (p f4-2) (p f4-3))) h
all-f4-sound p h f4-1 =
  andB-l (p f4-1) (andB (p f4-2) (p f4-3))
    (andB-r (p f4-0) (andB (p f4-1) (andB (p f4-2) (p f4-3))) h)
all-f4-sound p h f4-2 =
  andB-l (p f4-2) (p f4-3)
    (andB-r (p f4-1) (andB (p f4-2) (p f4-3))
      (andB-r (p f4-0) (andB (p f4-1) (andB (p f4-2) (p f4-3))) h))
all-f4-sound p h f4-3 =
  andB-r (p f4-2) (p f4-3)
    (andB-r (p f4-1) (andB (p f4-2) (p f4-3))
      (andB-r (p f4-0) (andB (p f4-1) (andB (p f4-2) (p f4-3))) h))
