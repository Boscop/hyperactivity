-- Bonnet's recurrence and the Legendre equation at one (l, m), divided by c(l, m)
lg-at : BQ → BQ → Bool
lg-at l m = if fn-eq (bq-add (bq-mul (bq-add l (fn-q 1 1)) (lg-rb l m)) (bq-mul l (lg-rd l m))) (bq-add (bq-mul (fn-q 2 1) l) (fn-q 1 1))
  then fn-eq (bq-add (bq-mul (bq-mul (bq-add (fn-sub l (bq-mul (fn-q 2 1) m)) (fn-q 2 1)) (bq-add (fn-sub l (bq-mul (fn-q 2 1) m)) (fn-q 1 1))) (lg-ro l m))
                     (bq-mul l (bq-add l (fn-q 1 1))))
             (bq-mul (fn-sub l (bq-mul (fn-q 2 1) m)) (bq-add (fn-sub l (bq-mul (fn-q 2 1) m)) (fn-q 1 1)))
  else false
