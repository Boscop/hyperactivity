-- /api/kg/module?path=<mod.cub> : live checked .cub source directly from content-addressed store
s-kg-module : List Word → Proc W (List Word)
s-kg-module q =
  if s-kg-public-path (s-unescape (s-param "path" q)) then
    bind (h-source-text (s-unescape (s-param "path" q))) (λ t → ret {lzero} {W} (s-response "text/plain; charset=utf-8" (s-or nil t)))
  else
    ret {lzero} {W} (s-respond "403 Forbidden" "text/plain" "not in public knowledge graph")
