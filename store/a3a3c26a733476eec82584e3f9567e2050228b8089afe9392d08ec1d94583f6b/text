expand-motif-map-shift : (pat xs : List MTerm) → expand-motif-list pat (list-map mterm-shift-ref xs) ≡ xs
expand-motif-map-shift pat xs =
  case xs return (λ u → expand-motif-list pat (list-map mterm-shift-ref u) ≡ u) of
    nil → λ i → nil
    cons t r →
      concat {lzero} {List MTerm}
        {list-append (expand-motif-cell pat (mterm-shift-ref t)) (expand-motif-list pat (list-map mterm-shift-ref r))}
        {list-append (cons t nil) r} {cons t r}
        (λ i → list-append (expand-motif-cell-shift pat t i) (rec r i))
        (λ i → cons t r)
