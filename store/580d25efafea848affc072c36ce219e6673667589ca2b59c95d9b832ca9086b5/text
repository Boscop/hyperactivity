hypercore-sv-tb-part2 : List Word
hypercore-sv-tb-part2 =
  sv-lines
    (cons "  task automatic tick;"
    (cons "    begin #5 clk = 1'b1; #5 clk = 1'b0; end"
    (cons "  endtask"
    (cons ""
    (cons "  integer m, b1, b2, cyc;"
    (cons "  initial begin"
    (cons "    // Check 1: 4-NAND2 XOR == Behavioral ALU Sum"
    (cons "    for (m = 0; m < 4; m = m + 1) begin"
    (cons "      xa = m[1]; xb = m[0]; #1;"
    (cons (list-append "      if (y_nand !== (xa ^ xb) || y_beh !== y_nand)" (sv-fatal "XOR4 mismatch"))
    (cons "    end"
    (cons "    // Check 2: Exhaustive [8,4,4] SECDED (16 msgs x (1 clean + 8 1-bit + 28 2-bit) = 592 cases)"
    (cons "    for (m = 0; m < 16; m = m + 1) begin"
    (cons "      msg_in = m[3:0]; err_mask = 8'd0; #1;"
    (cons (list-append "      if (healed_msg !== msg_in || s_heal !== 1'b0 || d_det !== 1'b0)" (sv-fatal "ECC clean fail"))
    (cons "      for (b1 = 0; b1 < 8; b1 = b1 + 1) begin"
    (cons "        err_mask = (8'd1 << b1); #1;"
    (cons (list-append "        if (healed_msg !== msg_in || s_heal !== 1'b1 || d_det !== 1'b0)" (sv-fatal "ECC 1bit fail"))
    (cons "        for (b2 = b1 + 1; b2 < 8; b2 = b2 + 1) begin"
    (cons "          err_mask = (8'd1 << b1) | (8'd1 << b2); #1;"
    (cons (list-append "          if (d_det !== 1'b1 || s_heal !== 1'b0)" (sv-fatal "ECC 2bit fail"))
    (cons "        end"
    (cons "      end"
    (cons "    end"
    (cons "    // Check 3 & 4: Synchronous reset + 12 SoC cycles & 5 GALS Cubical Inet-Tile cycles"
    (cons "    rst = 1'b1; tick(); rst = 1'b0;"
    (cons "    it_valid = 1'b0; tick();"
    (cons "    it_valid = 1'b1; it_op_a = 1'b0; it_tag_a = 4'd0; it_pa = 4'b0001; it_na = 4'b0000;"
    (cons "                     it_op_b = 1'b0; it_tag_b = 4'd0; it_pb = 4'b0000; it_nb = 4'b0000; tick();"
    (cons "    it_valid = 1'b1; it_op_a = 1'b0; it_tag_a = 4'd0; it_pa = 4'b0001; it_na = 4'b0000;"
    (cons "                     it_op_b = 1'b1; it_tag_b = 4'd1; it_pb = 4'b0000; it_nb = 4'b0000; tick();"
    (cons "    it_valid = 1'b1; it_op_a = 1'b0; it_tag_a = 4'd0; it_pa = 4'b0001; it_na = 4'b0000;"
    (cons "                     it_op_b = 1'b1; it_tag_b = 4'd1; it_pb = 4'b0000; it_nb = 4'b0001; tick();"
    (cons "    it_valid = 1'b0; tick();"
    (cons "    if (it_ann !== 16'd1 || it_comm !== 16'd1 || it_prune !== 16'd1 || it_fp !== 16'd4 || it_gated !== 16'd2)"
    (cons (sv-fatal "Inet tile mismatch")
    (cons "    for (cyc = 0; cyc < 7; cyc = cyc + 1) tick();"
    (cons "    if (pc_out !== 8'd11 || r3_out !== 16'd15 || r6_out !== 16'd15 || r7_out !== 16'd15 || dmem1_out !== 16'd15)"
    (cons (sv-fatal "SoC hart state mismatch")
    (cons "    if (c00_out !== 32'd40 || c01_out !== 32'd60 || c10_out !== 32'd60 || c11_out !== 32'd90)"
    (cons (sv-fatal "Systolic GEMM mismatch")
    (cons (list-append "    $display("
            (list-append (sv-q "HYPERCORE_VERILATOR_PASS: xor4=4/4 secded=592/592 inet=(ann=%0d,comm=%0d,prune=%0d,fp=%0d,gated=%0d) soc=(pc=%0d,r3=%0d,r6=%0d,r7=%0d,dmem1=%0d,C=[[%0d,%0d],[%0d,%0d]])")
              ", it_ann, it_comm, it_prune, it_fp, it_gated, pc_out, r3_out, r6_out, r7_out, dmem1_out, c00_out, c01_out, c10_out, c11_out);"))
    (cons "    $finish;"
    (cons "  end"
    (cons "endmodule" nil)))))))))))))))))))))))))))))))))))))))))))))
