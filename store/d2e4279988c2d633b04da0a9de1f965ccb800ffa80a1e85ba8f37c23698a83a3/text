cube-comp2 : (n : Nat) (X Y Y' Z : Type 1) (f : Y → Z) (g : X → Y) (f' : Y' → Z) (g' : X → Y') (c : Cube n X) →
  PathP (λ i → Cube n Z) (cube-map n X Z (λ x → f (g x)) c) (cube-map n X Z (λ x → f' (g' x)) c) →
  PathP (λ i → Cube n Z) (cube-map n Y Z f (cube-map n X Y g c)) (cube-map n Y' Z f' (cube-map n X Y' g' c))
cube-comp2 n X Y Y' Z f g f' g' c p =
  pcat (Cube n Z) (cube-map n Y Z f (cube-map n X Y g c)) (cube-map n X Z (λ x → f' (g' x)) c) (cube-map n Y' Z f' (cube-map n X Y' g' c))
    (pcat (Cube n Z) (cube-map n Y Z f (cube-map n X Y g c)) (cube-map n X Z (λ x → f (g x)) c) (cube-map n X Z (λ x → f' (g' x)) c)
       (cube-comp n X Y Z f g c) p)
    (psym (Cube n Z) (cube-map n Y' Z f' (cube-map n X Y' g' c)) (cube-map n X Z (λ x → f' (g' x)) c) (cube-comp n X Y' Z f' g' c))
