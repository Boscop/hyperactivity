nk-split-wf : (ins outs : NkEnv) (n0 : NkW) (e : NkEnv) (o : NkOut) →
  (nk-wire-le n0 (nk-n o) ≡ true) → (nk-env-in-set ins n0 (nk-n o) e ≡ true) →
  (nk-out-ok ins outs n0 (nk-n o) o ≡ true) →
  nk-split-ok ins outs n0 (nk-n o) (nk-split e o) ≡ true
nk-split-wf ins outs n0 nke-nil o p0 he ho =
  nk-and-intro (nk-out-ok ins outs n0 (nk-n o) o) (nk-and true true) ho refl
nk-split-wf ins outs n0 (nke-cons w r) o p0 he ho =
  nk-split-cons-wf ins outs n0 (nk-n o) w (nk-split r o) p0
    (nk-and-l (nk-in-set ins n0 (nk-n o) w) (nk-env-in-set ins n0 (nk-n o) r) he)
    (nk-split-wf ins outs n0 r o p0 (nk-and-r (nk-in-set ins n0 (nk-n o) w) (nk-env-in-set ins n0 (nk-n o) r) he) ho)
