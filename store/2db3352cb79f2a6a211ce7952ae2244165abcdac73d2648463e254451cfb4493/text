bn-b64-alpha : List Word
bn-b64-alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

bn-nth-byte : Nat → List Word → Word
bn-nth-byte zero    nil         = #65
bn-nth-byte zero    (cons b bs) = b
bn-nth-byte (suc k) nil         = #65
bn-nth-byte (suc k) (cons b bs) = bn-nth-byte k bs

bn-b64-ch : Word → Word
bn-b64-ch idx = bn-nth-byte (toNat (%wand idx #63)) bn-b64-alpha

bn-base64-enc : List Word → List Word
bn-base64-enc nil = nil
bn-base64-enc (cons b0 nil) =
  let c0 = bn-b64-ch (%wshr b0 #2)
      c1 = bn-b64-ch (%wshl (%wand b0 #3) #4)
  in cons c0 (cons c1 (cons #61 (cons #61 nil)))
bn-base64-enc (cons b0 (cons b1 nil)) =
  let c0 = bn-b64-ch (%wshr b0 #2)
      c1 = bn-b64-ch (%wor (%wshl (%wand b0 #3) #4) (%wshr b1 #4))
      c2 = bn-b64-ch (%wshl (%wand b1 #15) #2)
  in cons c0 (cons c1 (cons c2 (cons #61 nil)))
bn-base64-enc (cons b0 (cons b1 (cons b2 rest))) =
  let c0 = bn-b64-ch (%wshr b0 #2)
      c1 = bn-b64-ch (%wor (%wshl (%wand b0 #3) #4) (%wshr b1 #4))
      c2 = bn-b64-ch (%wor (%wshl (%wand b1 #15) #2) (%wshr b2 #6))
      c3 = bn-b64-ch (%wand b2 #63)
  in cons c0 (cons c1 (cons c2 (cons c3 (bn-base64-enc rest))))

-- THEOREM 4 (RFC 4648 §10 BASE64 TEST VECTORS EXACT BY `refl`):
bn-thm-rfc4648-base64 :
  andB (h-eq (bn-base64-enc "f") "Zg==")
  (andB (h-eq (bn-base64-enc "fo") "Zm8=")
  (andB (h-eq (bn-base64-enc "foo") "Zm9v")
        (h-eq (bn-base64-enc "foobar") "Zm9vYmFy"))) ≡ true
bn-thm-rfc4648-base64 = refl

