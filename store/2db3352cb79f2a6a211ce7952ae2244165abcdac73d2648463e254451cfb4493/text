bn-query-usdc6 : List Word → Proc W Word
bn-query-usdc6 owner20 =
  let cdHex  = list-append "0x" (h-hex (bn-encode-balance-of owner20))
      usdc55 = eth-eip55-from-bytes20 bn-usdc-base20
      pJson  = h-concat
                 (cons "[{" (cons (h-quote "to") (cons ":" (cons (h-quote usdc55)
                 (cons "," (cons (h-quote "data") (cons ":" (cons (h-quote cdHex)
                 (cons "}," (cons (h-quote "latest") (cons "]" nil)))))))))))
  in bind (bl-rpc-call "eth_call" pJson) (λ resp →
     ret {lzero} {W} (bl-hex-to-word (bl-extract-json-hex resp)))

-- Provision / Tunnel SSH Mesh Nodes when `up` is invoked:
bn-up-ssh-nodes : Word → List BnNodeSpec → Proc W Word
bn-up-ssh-nodes idx nil = ret {lzero} {W} #0
bn-up-ssh-nodes idx (cons (mk-bn-node nid prov tr gpus rl ep sp rate) rest) =
  case prov of
    bp-ssh-mesh minOk →
      if h-eq ep "127.0.0.1"
      then bn-up-ssh-nodes (%wadd idx #1) rest
      else
        bind (h-capture
          (cons "/usr/bin/ssh"
          (cons "-o" (cons "BatchMode=yes"
          (cons "-o" (cons "ConnectTimeout=6"
          (cons "-o" (cons "StrictHostKeyChecking=no"
          (cons "-p" (cons (h-decimal sp)
          (cons (list-append "root@" ep)
          (cons "/tmp/hx_tig_submission/hx_value_hyperfactor >/tmp/hx_brainnet_heartbeat.log 2>&1 && uname -n" nil)))))))))))) (λ r →
          bind (bn-up-ssh-nodes (%wadd idx #1) rest) (λ cnt →
            ret {lzero} {W} (if %weq (fst r) #0 then %wadd cnt #1 else cnt)))
    bp-akash → bn-up-ssh-nodes (%wadd idx #1) rest
    bp-clore →
      bind (h-env "CLORE_API_KEY") (λ eKey →
        case eKey of
          inl u → bn-up-ssh-nodes (%wadd idx #1) rest
          inr k →
            bind (h-capture
              (cons "/usr/bin/curl"
              (cons "-sS" (cons "--max-time" (cons "10"
              (cons "-H" (cons (list-append "auth: " k)
              (cons "-H" (cons "Content-Type: application/json"
              (cons "-d" (cons (list-append "@" (list-append bn-out-dir "/clore_create_order.json"))
              (cons "https://api.clore.ai/v1/create_order" nil)))))))))))) (λ rc →
              bind (h-write (list-append bn-out-dir "/clore_live_resp.json") (snd rc)) (λ w0 →
              bn-up-ssh-nodes (%wadd idx #1) rest)))
    bp-x402 →
      bind (h-env "HX_X402_URL") (λ eUrl →
        case eUrl of
          inl u → bn-up-ssh-nodes (%wadd idx #1) rest
          inr url →
            bind (h-read (list-append bn-out-dir "/x402_payment_header.txt")) (λ mHdr →
              case mHdr of
                inl u2 → bn-up-ssh-nodes (%wadd idx #1) rest
                inr hdr →
                  bind (h-capture
                    (cons "/usr/bin/curl"
                    (cons "-sS" (cons "--max-time" (cons "10"
                    (cons "-H" (cons (list-append "PAYMENT-SIGNATURE: " hdr)
                    (cons "-H" (cons (list-append "X-PAYMENT: " hdr)
                    (cons url nil)))))))))) (λ rx →
                    bind (h-write (list-append bn-out-dir "/x402_live_resp.json") (snd rx)) (λ w1 →
                    bn-up-ssh-nodes (%wadd idx #1) rest))))

-- Flexible Funded-Key Loader:
--   1. `HX_PRIVATE_KEY_HEX` env (64-hex raw scalar)
--   2. `HX_KEY_FILE` env (path to 64-hex keyfile)
--   3. Default local `0600` sovereign vault (`0x7DC37C6C522C24eD965cE5bc4ce5e2ae5b2b48a2`)
--   4. In read-only `plan` mode inside isolated CI sandboxes, falls back cleanly to test vector `#3`
--      (NEVER allowed in live `up` or `fund-usdc`!).
bn-parse-priv-hex : List Word → Word
bn-parse-priv-hex raw = h-be (eth-from-hex (h-take (toNat #64) raw))

bn-load-key-path : List Word → Bool → Proc W Word
bn-load-key-path kp requireLive =
  bind (h-read kp) (λ mr →
    case mr of
      inr kh →
        let priv = bn-parse-priv-hex kh
        in if andB (%wlt #0 priv) (%wlt priv secp-n)
           then ret {lzero} {W} priv
           else bind (h-fail "Invalid secp256k1 scalar in keyfile") (λ u → ret {lzero} {W} #0)
      inl u →
        if requireLive
        then bind (h-fail (list-append "Funded keyfile unreadable: " kp)) (λ u2 → ret {lzero} {W} #0)
        else ret {lzero} {W} #3)

bn-load-funded-key : Bool → Proc W Word
bn-load-funded-key requireLive =
  bind (h-env "HX_PRIVATE_KEY_HEX") (λ eHex →
    case eHex of
      inr hx →
        let priv = bn-parse-priv-hex hx
        in if andB (%wlt #0 priv) (%wlt priv secp-n)
           then ret {lzero} {W} priv
           else bind (h-fail "Invalid HX_PRIVATE_KEY_HEX") (λ u → ret {lzero} {W} #0)
      inl u0 →
        bind (h-env "HX_KEY_FILE") (λ eFile →
          case eFile of
            inr kf → bn-load-key-path kf requireLive
            inl u1 → bn-load-key-path bl-key-path requireLive))

bn-cmd-plan-or-up : Bool → Proc W Unit
bn-cmd-plan-or-up isUp =
  bind (bn-load-funded-key isUp) (λ priv →
  bind (h-mkdir bn-out-dir) (λ m0 →
    let rel20     = eth-priv-to-addr20 priv
        relEip55  = eth-eip55-from-bytes20 rel20
        vltEip55  = eth-eip55-from-bytes20 (eth-create-addr20 rel20 #0)
        fndEip55  = eth-eip55-from-bytes20 eth-founder-coinbase-addr20
        bootTok   = h-hex (keccak256 (list-append (eth-word-be32 priv) "HX-BRAINNET-BOOT-V1"))
        clorePass = h-take (toNat #24) (h-hex (keccak256 (list-append (eth-word-be32 priv) "HX-CLORE-SSH")))
        akashSdl  = bn-emit-akash-sdl (mk-bn-node "akash-h100-03" bp-akash bt-h100-sxm #2 br-zk-pouw-miner "akash" #22 #3900000) bootTok
        cloreJson = bn-emit-clore-order #10001 clorePass
        x402Hdr   = bn-sign-x402-header priv eth-founder-coinbase-addr20 #900000 #1893456000 "hx-brainnet-x402-0"
        rateUsdc6 = bn-cluster-rate bn-default-cluster
        aupOk     = bn-cluster-aup-ok bn-default-cluster
        cbfOk     = %wlt rateUsdc6 #25000000
    in bind (h-write (list-append bn-out-dir "/brainnet_akash_sdl.yaml") akashSdl) (λ w1 →
       bind (h-write (list-append bn-out-dir "/clore_create_order.json") cloreJson) (λ w2 →
       bind (h-write (list-append bn-out-dir "/x402_payment_header.txt") x402Hdr) (λ w3 →
       bind (bl-rpc-call "eth_chainId" "[]") (λ rCid →
       bind (bl-rpc-call "eth_getBalance" (h-concat (cons "[" (cons (h-quote relEip55) (cons "," (cons (h-quote "latest") (cons "]" nil))))))) (λ rBal →
       bind (bn-query-usdc6 rel20) (λ usdc6 →
       bind (if andB isUp (andB aupOk cbfOk) then bn-up-ssh-nodes #0 bn-default-cluster else ret {lzero} {W} #0) (λ liveSsh →
         let cidW  = bl-hex-to-word (bl-extract-json-hex rCid)
             balW  = bl-hex-to-word (bl-extract-json-hex rBal)
             line1 = bn-ln "[HX-BRAINNET-IAC | ONE-SHOT HETEROGENEOUS CLUSTER ENGINE]"
             line2 = bn-ln (list-append "  1. Funded Key & Vault   : relayer=" (list-append relEip55 (list-append " | vault=" (list-append vltEip55 (list-append " | founder=" fndEip55)))))
             line3 = bn-ln (list-append "  2. Live Base 8453 Funds : chain_id=" (list-append (h-decimal cidW) (list-append " | eth_wei=" (list-append (h-decimal balW) (list-append " | usdc_micro=" (h-decimal usdc6))))))
             line4 = bn-ln (list-append "  3. Cluster Safety Gates : nodes=5 (H200+H100+4090+EPYC+ARM) | AUP_Safe=" (list-append (if aupOk then "PASS" else "FAIL") (list-append " | Budget_CBF=" (list-append (if cbfOk then "PASS (" else "FAIL (") (list-append (h-decimal rateUsdc6) " / 25000000 uUSDC/hr)")))))
             line5 = bn-ln (list-append "  4. Emitted IaC Bundle   : " (list-append bn-out-dir "/{brainnet_akash_sdl.yaml, clore_create_order.json, x402_payment_header.txt}"))
             modeS = if isUp then list-append "LIVE_UP (verified_ssh_heartbeats=" (list-append (h-decimal liveSsh) ")")
                             else "PLAN_READY (run with 'up' or 'fund-usdc <wei>' to execute live)"
             line6 = bn-ln (list-append "  5. Execution Mode       : " modeS)
         in h-out (h-concat (cons line1 (cons line2 (cons line3 (cons line4 (cons line5 (cons line6 nil))))))))))))))))

-- Autonomous On-Chain `ETH -> Base USDC` Swap (`SwapRouter02` `0x2626...e481`, keeps `0.002 ETH` gas reserve!):
bn-cmd-fund-usdc : List (List Word) → Proc W Unit
bn-cmd-fund-usdc args =
  let swapWei = case args of
                  nil       → #20000000000000000
                  cons a rs → h-number a
  in bind (bn-load-funded-key true) (λ priv →
       let rel20    = eth-priv-to-addr20 priv
           relEip55 = eth-eip55-from-bytes20 rel20
       in bind (bl-rpc-call "eth_getBalance" (h-concat (cons "[" (cons (h-quote relEip55) (cons "," (cons (h-quote "latest") (cons "]" nil))))))) (λ rBal →
          bind (bl-rpc-call "eth_getTransactionCount" (h-concat (cons "[" (cons (h-quote relEip55) (cons "," (cons (h-quote "latest") (cons "]" nil))))))) (λ rNc →
          bind (bl-rpc-call "eth_gasPrice" "[]") (λ rGp →
            let balW    = bl-hex-to-word (bl-extract-json-hex rBal)
                ncW     = bl-hex-to-word (bl-extract-json-hex rNc)
                gpW     = bl-hex-to-word (bl-extract-json-hex rGp)
                mfee    = %wadd (%wmul gpW #2) #2000000
                reserve = #2000000000000000
                needWei = %wadd swapWei reserve
                -- Conservative minOut floor: 1500 USDC/ETH (`swapWei * 1500 / 10^12` micro-USDC)
                minUsdc = %wdiv (%wmul swapWei #1500) #1000000000000
                cd      = bn-encode-eth-to-usdc rel20 swapWei minUsdc
            in if %wlt balW needWei
               then h-fail (list-append "INSUFFICIENT_BASE_ETH_FOR_SWAP_PLUS_RESERVE_AT_" relEip55)
               else
                 let tx  = mk-tx1559 #8453 ncW #1000000 mfee #220000 bn-uni3-router20 swapWei cd
                     ok  = eth-tx1559-selfcheck priv tx
                     raw = fst (eth-tx1559-sign-raw priv tx)
                     rHx = list-append "0x" (h-hex raw)
                 in if eth-not ok then h-fail "Swap EIP-1559 ecrecover self-check failed"
                    else bind (bl-rpc-call "eth_sendRawTransaction" (h-concat (cons "[" (cons (h-quote rHx) (cons "]" nil))))) (λ rTx →
                         h-out (h-concat (cons "[HX-BRAINNET-IAC | ETH->USDC SWAP TX] " (cons rTx (cons bn-nl nil)))))))))

bn-dispatch : List (List Word) → Proc W Unit
bn-dispatch nil         = bn-cmd-plan-or-up false
bn-dispatch (cons c rs) =
  if h-eq c "up" then bn-cmd-plan-or-up true
  else if h-eq c "fund-usdc" then bn-cmd-fund-usdc rs
  else bn-cmd-plan-or-up false

bn-find-cmd : List (List Word) → List (List Word)
bn-find-cmd nil         = nil
bn-find-cmd (cons a rs) =
  if orB (h-eq a "up") (orB (h-eq a "plan") (h-eq a "fund-usdc"))
  then cons a rs
  else bn-find-cmd rs

bn-entry : Proc W Unit
bn-entry =
  bind h-args (λ argv →
  bind (bn-dispatch (bn-find-cmd (h-tail-lists argv))) (λ u →
  exit #0))

bn-run : Step W Unit
bn-run = to-step bn-entry

#run bn-run
