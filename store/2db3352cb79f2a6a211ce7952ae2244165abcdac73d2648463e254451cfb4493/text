-- EIP-712 + EIP-3009 Gasless Base `USDC` `TransferWithAuthorization` Digest & `x402` Header Signer:
bn-eip712-dom-th : List Word
bn-eip712-dom-th =
  keccak256 "EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)"

bn-usdc-domain-sep : List Word
bn-usdc-domain-sep =
  keccak256
    (h-concat
      (cons bn-eip712-dom-th
      (cons (keccak256 "USD Coin")
      (cons (keccak256 "2")
      (cons (eth-word-be32 #8453)
      (cons (bn-abi-addr20 bn-usdc-base20) nil))))))

bn-eip3009-th : List Word
bn-eip3009-th =
  keccak256 "TransferWithAuthorization(address from,address to,uint256 value,uint256 validAfter,uint256 validBefore,bytes32 nonce)"

bn-eip3009-digest : List Word → List Word → Word → Word → Word → List Word → List Word
bn-eip3009-digest from20 to20 val6 vAfter vBefore nonce32 =
  let structH = keccak256
                  (h-concat
                    (cons bn-eip3009-th
                    (cons (bn-abi-addr20 from20)
                    (cons (bn-abi-addr20 to20)
                    (cons (eth-word-be32 val6)
                    (cons (eth-word-be32 vAfter)
                    (cons (eth-word-be32 vBefore)
                    (cons (h-take (toNat #32) nonce32) nil))))))))
  in keccak256 (h-concat (cons (cons #25 (cons #1 nil)) (cons bn-usdc-domain-sep (cons structH nil))))

bn-sig65-hex : Word × (Word × Word) → List Word
bn-sig65-hex sig =
  let yp  = fst sig
      r   = fst (snd sig)
      s   = snd (snd sig)
      raw = h-concat (cons (eth-word-be32 r) (cons (eth-word-be32 s) (cons (cons (%wadd #27 yp) nil) nil)))
  in list-append "0x" (h-hex raw)

bn-jkv : List Word → List Word → List Word → List Word
bn-jkv k v sep = list-append (h-quote k) (list-append ":" (list-append (h-quote v) sep))

bn-jraw : List Word → List Word → List Word → List Word
bn-jraw k v sep = list-append (h-quote k) (list-append ":" (list-append v sep))

-- Build complete Base64 `x402` v2 `PAYMENT-SIGNATURE` payload signed by `priv`:
bn-sign-x402-header : Word → List Word → Word → Word → List Word → List Word
bn-sign-x402-header priv payTo20 val6 validBefore nonceSeed =
  let from20    = eth-priv-to-addr20 priv
      fromEip55 = eth-eip55-from-bytes20 from20
      toEip55   = eth-eip55-from-bytes20 payTo20
      nonce32   = keccak256 (list-append (eth-word-be32 priv) nonceSeed)
      dig32     = bn-eip3009-digest from20 payTo20 val6 #0 validBefore nonce32
      sig       = secp-ecdsa-sign priv dig32
      sigHex    = bn-sig65-hex sig
      nonceHex  = list-append "0x" (h-hex nonce32)
      authObj   = h-concat
        (cons "{"
        (cons (bn-jkv "from" fromEip55 ",")
        (cons (bn-jkv "to" toEip55 ",")
        (cons (bn-jkv "value" (h-decimal val6) ",")
        (cons (bn-jkv "validAfter" "0" ",")
        (cons (bn-jkv "validBefore" (h-decimal validBefore) ",")
        (cons (bn-jkv "nonce" nonceHex "}") nil)))))))
      payObj    = h-concat
        (cons "{"
        (cons (bn-jkv "signature" sigHex ",")
        (cons (bn-jraw "authorization" authObj "}") nil)))
      jsonPay   = h-concat
        (cons "{"
        (cons (bn-jraw "x402Version" "2" ",")
        (cons (bn-jkv "scheme" "exact" ",")
        (cons (bn-jkv "network" "eip155:8453" ",")
        (cons (bn-jraw "payload" payObj "}") nil)))))
  in bn-base64-enc jsonPay

-- THEOREM 5 (UNISWAP V3 SELECTOR `0x04e45aaf` + 228B CALLDATA + EIP-3009 ECRECOVER ROUNDTRIP BY `refl`!):
bn-thm-uni3-and-eip3009-ecrecover :
  let cd      = bn-encode-eth-to-usdc eth-founder-coinbase-addr20 #10000000000000000 #16000000
      from20  = eth-priv-to-addr20 #3
      nonce32 = keccak256 "hx-x402-test-0"
      dig32   = bn-eip3009-digest from20 eth-founder-coinbase-addr20 #2500000 #0 #1800000000 nonce32
      sig     = secp-ecdsa-sign #3 dig32
      rec20   = secp-ecrecover-addr20 (fst sig) (fst (snd sig)) (snd (snd sig)) dig32
  in andB (h-eq (h-hex bn-uni3-sel4) "04e45aaf")
     (andB (%weq (fromNat (list-length cd)) #228)
           (h-eq rec20 from20)) ≡ true
bn-thm-uni3-and-eip3009-ecrecover = refl

