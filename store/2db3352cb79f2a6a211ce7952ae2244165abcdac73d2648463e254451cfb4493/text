bn-abi-addr20 : List Word → List Word
bn-abi-addr20 a20 = list-append (bn-zeros (toNat #12)) (h-take (toNat #20) a20)

-- Uniswap V3 `SwapRouter02.exactInputSingle` (`0x04e45aaf`) 228-byte ABI encoder (`ETH -> USDC`, 5 bps pool):
bn-uni3-sel4 : List Word
bn-uni3-sel4 =
  h-take (toNat #4) (keccak256 "exactInputSingle((address,address,uint24,address,uint256,uint256,uint160))")

bn-encode-eth-to-usdc : List Word → Word → Word → List Word
bn-encode-eth-to-usdc recip20 ethWei minUsdc6 =
  h-concat
    (cons bn-uni3-sel4
    (cons (bn-abi-addr20 bn-weth-base20)
    (cons (bn-abi-addr20 bn-usdc-base20)
    (cons (eth-word-be32 #500)
    (cons (bn-abi-addr20 recip20)
    (cons (eth-word-be32 ethWei)
    (cons (eth-word-be32 minUsdc6)
    (cons (eth-word-be32 #0) nil))))))))

