-- a module published as the session holds it now: its text, or its removal (repeating a publication
-- changes nothing); unpublished when the server cannot be reached, for the next command
h-published : List Word → Sum Unit (List Word) → Proc W Bool
h-published path r = if weq (h-status r) #200 then ret {lzero} {W} true
  else bind (h-say (h-line (list-append path " is not published yet: the served source cannot be reached or refused it; the next command publishes it"))) (λ u → ret {lzero} {W} false)
