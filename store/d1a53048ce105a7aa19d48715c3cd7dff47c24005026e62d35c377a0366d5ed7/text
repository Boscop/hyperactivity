-- the off-diagonal test with both indices moved by one
cl-offz-shift : (A : Type) → (isz : A → Bool) → (k : Nat) → (r : List A) → (j : Nat) → cl-offz A isz (suc k) (suc j) r ≡ cl-offz A isz k j r
cl-offz-shift A isz k r j = (case r return λ w → (j2 : Nat) → cl-offz A isz (suc k) (suc j2) w ≡ cl-offz A isz k j2 w of
  nil → λ j2 → λ i → true
  cons x rest → λ j2 → λ i → if (if eqb j2 k then true else isz x) then cl-offz-shift A isz k rest (suc j2) i else false) j
