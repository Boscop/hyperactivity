lcp-stops : (xs ys : List (List Word)) → Stops (drop-n (lcp xs ys) xs) (drop-n (lcp xs ys) ys)
lcp-stops xs =
  case xs return λ w → (ys : List (List Word)) → Stops (drop-n (lcp w ys) w) (drop-n (lcp w ys) ys) of
    nil → λ ys → unit
    cons a r →
      λ ys →
        case ys return λ v → Stops (drop-n (lcp (cons a r) v) (cons a r)) (drop-n (lcp (cons a r) v) v) of
          nil → unit
          cons b s →
            ifP {λ c →
                   Stops (drop-n (if c then suc (lcp r s) else zero) (cons a r)) (drop-n (if c then suc (lcp r s) else zero) (cons b s))} {tok-eq a b}
              (λ e → rec r s)
              (λ e p →
                 true-not {tok-eq a b}
                   (subst {_} {_} {_} {λ u → isTrue (tok-eq a u)} p (tok-eq-refl a)) (isTrue-not e))
