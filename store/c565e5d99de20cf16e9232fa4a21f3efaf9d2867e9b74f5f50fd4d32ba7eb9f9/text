s-corpus-essays : List (List Word × List Word) → Proc W (List (List Word))
s-corpus-essays nil = ret nil
s-corpus-essays (cons x r) = bind (hi-code (list-append (h-before ".cub" (h-drop "docs/" (fst x))) "-source")) (λ c → bind (s-corpus-essays r) (λ rest → ret {lzero} {W} (cons (s-corpus-item (list-append "/doc?path=" (fst x)) (snd x) (s-essay-text c)) rest)))
