-- (part of language-support)
__SetConfig-case19 : (m'3 : (Text × ZI)) → MS Unit
__SetConfig-case19 m'3 =
  let value : ZI
      value = (snd m'3)
  in bindS {List (Bits #64)} {Unit} (getS {List (Bits #64)} x86-ctrs) (λ ctrs'25 →
       bindS {Unit} {Unit} (putS (x86-set-ctrs (vec-set {Bits #64} ctrs'25 #4 (bv-of-int #64 value #0)))) (λ _ →
         retS {Unit} unit))
