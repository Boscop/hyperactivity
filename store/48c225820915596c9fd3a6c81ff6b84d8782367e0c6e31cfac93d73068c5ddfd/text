-- ---------------------------------------------------------------- frame states
-- the state of a running compiled program: memory, rip, flags and the sixteen registers are
-- variables; the rest is the user-mode 64-bit state (app view, segments, control registers)
record FR = { f-mem : ByteMap ; f-rip : Word ; f-flags : Word
            ; f-rax : Word ; f-rcx : Word ; f-rdx : Word ; f-rbx : Word ; f-rsp : Word ; f-rbp : Word ; f-rsi : Word ; f-rdi : Word
            ; f-r8 : Word ; f-r9 : Word ; f-r10 : Word ; f-r11 : Word ; f-r12 : Word ; f-r13 : Word ; f-r14 : Word ; f-r15 : Word }
