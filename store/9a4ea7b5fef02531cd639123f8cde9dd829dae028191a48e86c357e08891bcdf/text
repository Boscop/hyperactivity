kvl-deliver-k : (chs : AdvSeq) → (g0 : KvG) → (r : Nat) → r < 3 → (w : KvWrite) → (s0 : Nat) →
                Sum (Took {KvMsg} {KvSt} kv-bc-beh chs g0 s0 (kv-pkt r w)) (Gone {KvMsg} {KvSt} kv-bc-beh chs g0 s0 r) → (s : Nat) × KvOwes r w (fleet-at {KvMsg} {KvSt} kv-bc-beh chs g0 s)
kvl-deliver-k chs g0 r h w s0 (inl tk) = (suc s0 , kvl-took r h w (fleet-at {KvMsg} {KvSt} kv-bc-beh chs g0 s0) (resolve {KvMsg} (chs s0) (snd (fleet-at {KvMsg} {KvSt} kv-bc-beh chs g0 s0))) tk)
kvl-deliver-k chs g0 r h w s0 (inr gn) = Empty-rec (kvl-rep-nohalt r h (fst (fleet-at {KvMsg} {KvSt} kv-bc-beh chs g0 s0) r) gn)
