-- the layers in turn; a labelling's record is its numbers of contacts (0,3), (0,5), (1,4), (2,5)
fq-l5 : List (Nat × Nat) → Nat → Nat → List (List (Nat × Nat)) → List (Nat × (Nat × (Nat × Nat))) → List (Nat × (Nat × (Nat × Nat)))
fq-l5 l2 n03 n14 cs acc = case cs of
  nil → acc
  cons l5 rest → fq-l5 l2 n03 n14 rest (cons (n03 , (fq-adjn l5 (cons fq-o nil) , (n14 , fq-adjn l5 l2))) acc)
