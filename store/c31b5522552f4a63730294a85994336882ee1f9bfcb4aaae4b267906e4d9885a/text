nk-out-ok-intro : (ins outs : NkEnv) (n0 nst : NkW) (fx : NkFx) (n : NkW) (ws : NkEnv) →
  (nk-wire-le nst n ≡ true) → (nk-fx-wf ins outs n0 n fx ≡ true) → (nk-env-in-range n0 n ws ≡ true) →
  nk-out-ok ins outs n0 nst (nk-out fx n ws) ≡ true
nk-out-ok-intro ins outs n0 nst fx n ws ple pfx pws =
  nk-and-intro (nk-wire-le nst n) (nk-and (nk-fx-wf ins outs n0 n fx) (nk-env-in-range n0 n ws))
    ple (nk-and-intro (nk-fx-wf ins outs n0 n fx) (nk-env-in-range n0 n ws) pfx pws)
