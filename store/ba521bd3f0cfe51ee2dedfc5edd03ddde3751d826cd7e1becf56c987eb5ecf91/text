undiff-diff-mod-go : (B : Word) → (prev : Bounded B) → (xs : List (Bounded B)) →
                     undiff-mod-go B prev (diff-mod-go B prev xs) ≡ xs
undiff-diff-mod-go B prev xs =
  (case xs return (λ u → (p : Bounded B) → undiff-mod-go B p (diff-mod-go B p u) ≡ u) of
     nil → λ p i → nil
     cons x r → λ p →
       let q : Bounded B
           q = (mundiff-val B (fst p) (mdiff-val B (fst p) (fst x)) ,
                mundiff-lt B (fst p) (mdiff-val B (fst p) (fst x)) (snd p) (mdiff-lt B (fst p) (fst x) (snd p) (snd x)))
           pq : q ≡ x
           pq = bounded-eq B q x (mundiff-mdiff B (fst p) (fst x) (snd p) (snd x))
       in λ i → cons (pq i) (concat {lzero} {List (Bounded B)}
                               {undiff-mod-go B q (diff-mod-go B x r)}
                               {undiff-mod-go B x (diff-mod-go B x r)} {r}
                               (λ j → undiff-mod-go B (pq j) (diff-mod-go B x r))
                               (rec r x) i)) prev
