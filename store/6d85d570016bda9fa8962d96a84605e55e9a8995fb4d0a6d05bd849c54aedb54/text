-- the midpoint m = lo + hi at scale 2sc, read, or else the point beside it
iq-try1 : (BZ → BZ → Nat × Bool) → Nat → BZ → BZ → BZ → BZ → Nat × Bool → ((BZ × BZ) × BZ) × Bool
iq-try1 c j lo hi m sc r = if snd r then (iq-pick j r (iq-dbl lo) (iq-dbl hi) m (iq-dbl sc) , true)
  else iq-try2 j (iq-dbl (iq-dbl lo)) (iq-dbl (iq-dbl hi)) (bz-add (iq-dbl m) bz-one) (iq-dbl (iq-dbl sc)) (c (bz-add (iq-dbl m) bz-one) (iq-dbl (iq-dbl sc)))
