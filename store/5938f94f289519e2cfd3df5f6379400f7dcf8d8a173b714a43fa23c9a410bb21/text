hxtp-synth-fa-sv : List Word
hxtp-synth-fa-sv =
  let rx = hs-id #102 #6
      rc = hs-id #232 #6
      gx = fst rx
      px = fst (snd rx)
      gc = fst rc
      pc = fst (snd rc)
  in list-append "// Synthesized optimal NAND2 Full-Adder cells directly from lib/hx-synth.hypercubical" (list-append ce-nl
     (list-append "module hx_synth_xor2(input logic w0, input logic w1, output logic y);" (list-append ce-nl
     (hxtp-sv-gates (toNat gx) #3 px
       (list-append "  assign y = w" (list-append (ce-dec (%wadd #2 gx)) (list-append ";" (list-append ce-nl
       (list-append "endmodule" (list-append ce-nl
       (list-append "module hx_synth_maj3_carry(input logic w0, input logic w1, input logic w2, output logic cout);" (list-append ce-nl
       (hxtp-sv-gates (toNat gc) #3 pc
         (list-append "  assign cout = w" (list-append (ce-dec (%wadd #2 gc)) (list-append ";" (list-append ce-nl
         (list-append "endmodule" ce-nl))))))))))))))))))
