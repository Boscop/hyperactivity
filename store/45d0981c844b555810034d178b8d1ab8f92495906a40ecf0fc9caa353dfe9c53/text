-- Quantum Tsirelson SOS Certificate (exact rational form of 2√2 - S ≥ 0):
-- For any real/expectation numbers a0, a1, b0, b1 (or unit-norm vectors in a Hilbert space):
--   2(a0² + a1² + b0² + b1²) - 2(a0(b0 + b1) + a1(b0 - b1)) ... wait:
-- Exact Tsirelson SOS with factor √2 cleared (using r = √2, r² = 2):
--   r(a0² + a1² + b0² + b1²) - 2 S = (r a0 - (b0+b1))² / r + (r a1 - (b0-b1))² / r
-- Clearing r (multiplying by 2, with r² = 2):
--   (2 a0 - r(b0+b1))² + (2 a1 - r(b0-b1))² = 4(a0² + a1²) + 2 r²(b0² + b1²) - 4 r S.
-- Evaluated with r² = 2: 4(a0² + a1² + b0² + b1²) - 4 r S ≥ 0 ⇒ S ≤ (a0²+a1²+b0²+b1²)/r = 4/√2 = 2√2!
-- Proved universally over `al-id` (5 variables: a0, a1, b0, b1, r)!
rqm-tsirelson-sos-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
rqm-tsirelson-sos-poly A ad mu q vs =
  (λ g sub sq →
    let a0 = g 0; a1 = g 1; b0 = g 2; b1 = g 3; r = g 4
        q2 = q (fn-q 2 1)
        q4 = q (fn-q 4 1)
        bp = ad b0 b1
        bm = sub b0 b1
        S  = ad (mu a0 bp) (mu a1 bm)
        lhs = ad (sq (sub (mu q2 a0) (mu r bp))) (sq (sub (mu q2 a1) (mu r bm)))
        rhs = sub (ad (mu q4 (ad (sq a0) (sq a1))) (mu (mu q2 (sq r)) (ad (sq b0) (sq b1))))
                  (mu q4 (mu r S))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
