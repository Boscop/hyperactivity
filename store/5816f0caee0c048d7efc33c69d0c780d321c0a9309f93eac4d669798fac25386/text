-- Parameterized catenoid projection with custom ribbon width (tenths)
cat-proj-w : SInt → SInt → SInt → SInt → SInt → RPt
cat-proj-w ribBase x y z rad =
  let den = si-sub (sp #4800) z
      sx = si-div (si-mul x (sp #4800)) den
      sy = si-div (si-mul y (sp #4800)) den
      px = si-add (sp #1280) sx
      py = si-sub (sp #1280) sy
      rSafe = if si-lt rad (sp #200) then sp #200 else rad
      zNorm = fx-div z rSafe
      tHalf = si-div-w (si-add zNorm (sp fx-S)) #2
      modW = si-add (sp #6400) (fx-mul (sp #4200) tHalf)
      persp = fx-div (sp #4800) den
      w = fx-mul (fx-mul ribBase persp) modW
  in rpt px py z w
