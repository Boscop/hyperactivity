-- Σ_e′ n_e n_e′ O_ee′ over the edges from e1, for one e, from the vertex's data w and the edges' traces ss
energy-row : Nat → SQ → Nat → List SQ → List Nat → List Triple → VW → List (List Side) → List Term
energy-row e ne e1 ns ds ts w ss = case ns of
  nil → nil
  cons n rest → terms-append (if sq-nz (sq-mul ne n) then terms-scale (sq-mul ne n) (o-terms-vw e e1 ds ts w (sides-nth e ss) (sides-nth e1 ss)) else nil) (energy-row e ne (suc e1) rest ds ts w ss)
