-- Exact executable {15j} symbol evaluator for any 4-simplex (10 faces + 5 intertwiners).
-- Upper bound on auxiliary doubled spin x is i1 + i2.
fifteenj :
  Nat → Nat → Nat → Nat → Nat →
  Nat → Nat → Nat → Nat → Nat →
  Nat → Nat → Nat → Nat → Nat →
  List (Nat × CG)
fifteenj j1 j2 j3 j4 j5 j6 j7 j8 j9 j10 i1 i2 i3 i4 i5 =
  fifteenj-terms-le (plus i1 i2) j1 j2 j3 j4 j5 j6 j7 j8 j9 j10 i1 i2 i3 i4 i5
