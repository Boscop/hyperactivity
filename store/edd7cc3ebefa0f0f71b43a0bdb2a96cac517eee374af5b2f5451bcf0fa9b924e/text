-- decode(b, n, out) with the buffer at address bp
fd-decode : (Nat → Nat) → Nat → Nat → FdFrame → Bool × FdFrame
fd-decode b n bp out =
  if fd-ltb n fd-four then (false , out)
  else (if fd-ltb (fd-monus n fd-four) (fd-len b) then (false , out)
  else (true , (fd-tag b , fd-len b , plus bp fd-four)))
