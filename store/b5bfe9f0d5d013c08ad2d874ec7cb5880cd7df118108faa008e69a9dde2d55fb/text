-- an operation arrives at a wire
nk-put-op : NkSlot → Word → NkOp → NkState → NkState
nk-put-op nks-none w o (nk-state sl rd n) = nk-state (nksl-cons w (nks-op o) sl) rd n
nk-put-op (nks-val v) w o (nk-state sl rd n) = nk-state (nk-del sl w) (nkp-cons o v rd) n
nk-put-op (nks-op p) w o st = st
nk-put-op (nks-readers os) w o st = st
