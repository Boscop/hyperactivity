bn-lem-dup-add : (env : Word) → (x : INetExpr) →
  inet-eval env (bn-mk-dup-add x) ≡ bn-add64 (inet-eval env x) (inet-eval env x)
bn-lem-dup-add _ (in-lit _)        = refl
bn-lem-dup-add _ in-var0           = refl
bn-lem-dup-add _ (in-dup-add _)    = refl
bn-lem-dup-add _ (in-add _ _)      = refl
bn-lem-dup-add _ (in-xor _ _)      = refl
bn-lem-dup-add _ (in-era-l _ _)    = refl
bn-lem-dup-add _ (in-lut3 _ _ _ _) = refl
