fs-ft : (c : Bool) → plus (bitn false) (times 2 (bitn true)) ≡ plus (bitn (bit-eq false c)) (plus (bitn true) (bitn c))
fs-ft c = case c return λ w → plus (bitn false) (times 2 (bitn true)) ≡ plus (bitn (bit-eq false w)) (plus (bitn true) (bitn w)) of
  true → λ i → suc (suc zero)
  false → λ i → suc (suc zero)
