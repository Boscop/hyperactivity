syn3-linear : (x y : Code8) →
  syn3 (bv-xor (toNat #8) x y) ≡ syn3-xor (syn3 x) (syn3 y)
syn3-linear x y =
  let p1 = xor4-linear (c8-1 x) (c8-3 x) (c8-5 x) (c8-7 x) (c8-1 y) (c8-3 y) (c8-5 y) (c8-7 y)
      p2 = xor4-linear (c8-2 x) (c8-3 x) (c8-6 x) (c8-7 x) (c8-2 y) (c8-3 y) (c8-6 y) (c8-7 y)
      p4 = xor4-linear (c8-4 x) (c8-5 x) (c8-6 x) (c8-7 x) (c8-4 y) (c8-5 y) (c8-6 y) (c8-7 y)
  in λ i → (p1 i , (p2 i , p4 i))
