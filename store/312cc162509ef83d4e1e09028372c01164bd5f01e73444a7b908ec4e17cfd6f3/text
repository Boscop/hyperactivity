gds-decode-body : Nat → List Word → Sum Unit (List Rect)
gds-decode-body zero s =
  bind-res (expect-w #4 s) (λ s1 →
  bind-res (expect-w gds-rec-endstr s1) (λ s2 →
  bind-res (expect-w #4 s2) (λ s3 →
  bind-res (expect-w gds-rec-endlib s3) (λ _ → inr nil))))
gds-decode-body (suc n) s =
  bind-res (gds-decode-one s) (λ item →
  bind-res (gds-decode-body n (snd item)) (λ rs →
    inr (cons (snd (snd (fst item))) rs)))
