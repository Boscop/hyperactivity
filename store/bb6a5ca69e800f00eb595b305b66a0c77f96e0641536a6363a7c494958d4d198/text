-- a member kept by a filter it passes
tso-in-keep : {A : Type} → (p : A → Bool) → (x : A) → (ns : List A) → TsoIn x ns → isTrue (p x) → TsoIn x (tso-keep p ns)
tso-in-keep p x nil m h = Empty-rec m
tso-in-keep p x (cons y r) m h =
  (case m of
     inl e → (case p y return (λ b → isTrue b → TsoIn x (if b then cons y (tso-keep p r) else tso-keep p r)) of
                true → λ u → inl e
                false → λ f → Empty-rec f) (subst {_} {_} {_} {λ z → isTrue (p z)} e h)
     inr m2 → (case p y return (λ b → TsoIn x (if b then cons y (tso-keep p r) else tso-keep p r)) of
                 true → inr (tso-in-keep p x r m2 h)
                 false → tso-in-keep p x r m2 h))
