k-comb-p : {o : Ord} → (k x : El o) → (r : List (El o)) → (m : Sum Unit (El o)) → isTrue (not (leq k x)) → k-LastP k r m → k-LastP k (cons x r) (k-comb x m)
k-comb-p k x r m nx =
  case m return λ w → k-LastP k r w → k-LastP k (cons x r) (k-comb x w) of
    inl u → λ p → (mem-head x r , nx)
    inr y → λ p → (mem-cons-r y x r (fst p) , snd p)
