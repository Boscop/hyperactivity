xp-prod-dec : (a b c d : XpTy) → Dec (a ≡ c) → Dec (b ≡ d) → Dec (xt-prod a b ≡ xt-prod c d)
xp-prod-dec a b c d (yes p) (yes q) = yes (λ k → xt-prod (p k) (q k))
xp-prod-dec a b c d (yes p) (no n) = no (λ r → n (λ k → xp-psnd (r k)))
xp-prod-dec a b c d (no n) e = no (λ r → n (λ k → xp-pfst (r k)))
