-- a body with its variable d replaced by a body
nk-subst : NkTm → Word → NkTm → NkTm
nk-subst (nk-var i) d v = if %weq i d then v else (if %wlt d i then nk-var (%wsub i #1) else nk-var i)
nk-subst (nk-lam b) d v = nk-lam (nk-subst b (%wsucc d) (nk-el-sh #0 v))
nk-subst (nk-susp b) d v = nk-susp (nk-subst b d v)
nk-subst (nk-con c as) d v = nk-con c (nk-subst as d v)
nk-subst (nk-op h p as) d v = nk-op h (nk-subst p d v) (nk-subst as d v)
nk-subst (nk-match h p cs) d v = nk-match h (nk-subst p d v) (nk-subst cs d v)
nk-subst (nk-cons t r) d v = nk-cons (nk-subst t d v) (nk-subst r d v)
nk-subst t d v = t
