-- the query, proved: the match is no shorter than at any earlier point, and is found at one
earlier-match-max : (ts : List (List Word)) → (p j : Nat) → isTrue (ltn j p) →
                    ltn (fst (earlier-match ts p)) (lcp (drop-n j ts) (drop-n p ts)) ≡ false
earlier-match-max ts p j h = best-match-max (drop-n p ts) ts p zero ts (λ i → ts) j h
