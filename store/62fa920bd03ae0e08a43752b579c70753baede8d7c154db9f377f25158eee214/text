chain-transports : (s : BScope) → (t : BScope) → (a : Mol → Nat) → (h : Mol → Nat) → TransfersOn s a h → HazardDetermined t a → (M : Mol) → (N : Mol) → t M ≡ t N → isTrue (s N) → a M ≡ h N
chain-transports s t a h tr det M N p q = concat (det M N p) (tr N q)
