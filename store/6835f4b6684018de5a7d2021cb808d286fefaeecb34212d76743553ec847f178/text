carried-deeper : Bool → List (List Word) → List (List Word)
carried-deeper inside nil = nil
carried-deeper inside (cons l ls) = if begins "```" l then cons l (carried-deeper (if inside then false else true) ls)
  else if inside then cons l (carried-deeper inside ls)
  else if carried-heading l then cons (cons #35 l) (carried-deeper inside ls) else cons l (carried-deeper inside ls)
