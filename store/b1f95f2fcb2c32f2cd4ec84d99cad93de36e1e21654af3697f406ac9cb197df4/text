sk-align : Target → SK → Word
sk-align t k = case k of
  sk-int sg w → (case w of
    iw8 → tg-align t ck-char
    iw16 → tg-align t ck-short
    iw32 → tg-align t ck-int
    iw64 → tg-align t ck-llong
    iw128 → tg-align t ck-int128)
  sk-bool → tg-align t ck-bool
  sk-f32 → tg-align t ck-float
  sk-f64 → tg-align t ck-double
  sk-ptr → tg-align t ck-ptr
