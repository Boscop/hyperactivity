-- Compact flat symbol encoding of MTerm so factored DAG/λ streams feed directly into rANS
-- 0..3 = mref 0..3 (1 symbol!), 4 = mref k, 5 = mapp tid arg, 6 = mempty, 7 = mcat l r, >=8 = mlit (w - 8)
mterm-nodes : MTerm → Nat
mterm-nodes mempty = suc zero
mterm-nodes (mlit _) = suc zero
mterm-nodes (mref _) = suc zero
mterm-nodes (mapp _ arg) = suc (mterm-nodes arg)
mterm-nodes (mcat l r) = suc (plus (mterm-nodes l) (mterm-nodes r))
