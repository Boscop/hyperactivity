-- §4.5 Cubical Face-Guarded `5-Queens` (`Live [r0=1] + Contradicted [r0=1 ∧ r0=0] = 10`):
hn16-cubical-nq5 : Word
hn16-cubical-nq5 =
  let liveBranch = if clause-ok (toNat #4) (clause-meet (toNat #4) clause4-r0-1 clause4-top)  then nqueens-count #5 else #0
      deadBranch = if clause-ok (toNat #4) (clause-meet (toNat #4) clause4-r0-1 clause4-r0-0) then nqueens-count #5 else #0
  in %wadd liveBranch deadBranch
