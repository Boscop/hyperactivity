-- ---------------------------------------------------------------- 3. Cryptographic DPA Masking (`ua` + ISW Gadget)
-- First-Order Boolean Masking `(s ⊕ r, r)`: for EVERY secret `s`, `r ↦ s ⊕ r` is a bijection on `Bool`,
-- proving any single physical wire/EM probe sees an identical `Bool ≃ Bool` space independent of `s`!
MaskShareEquiv : (s : Bool) → Equiv Bool Bool
MaskShareEquiv s =
  isoToEquiv {lzero} {Bool} {Bool}
    (b-xor2 s) (b-xor2 s) (b-xor2-inv s) (b-xor2-inv s)
