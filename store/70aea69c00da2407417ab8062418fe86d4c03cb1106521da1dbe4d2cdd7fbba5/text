-- a wire u < n0 outside ins and outs is untouched (nk-clear?) by any well-formed sub-plan over [n0, n1)
nk-not-in-set-neq-at : (m : Bool) (u k n0 n1 : NkW) (al : NkEnv) → (nk-wire-lt u n0 ≡ true) → (nk-emem u al ≡ false) → (nk-emem k al ≡ m) → ((if m then true else nk-in-range n0 n1 k) ≡ true) → nk-weq u k ≡ false
nk-not-in-set-neq-at true u k n0 n1 al lt hu mk hk = nk-emem-not-eq u k al hu mk
nk-not-in-set-neq-at false u k n0 n1 al lt hu mk hk = nk-lt-range-neq u n0 n1 k lt hk
