-- UNIVERSAL THEOREM 4 (MORPHO 0-BPS FLASH SHOT NEVER LOSES PRINCIPAL OR SKIPS FOUNDER FLOOR, 0 POSTULATES):
ms-thm-morpho-zero-loss-guard :
  (borrow minProfit grossOut : Nat) →
  ms-admit-flash-shot borrow minProfit grossOut ≡ true →
  bn-le-nat (plus borrow minProfit) grossOut ≡ true
ms-thm-morpho-zero-loss-guard _ _ _ h = h
