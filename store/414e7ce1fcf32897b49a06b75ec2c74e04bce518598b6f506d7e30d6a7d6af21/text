nk-ranges-disj a0 a1 b0 b1 w k p hw hk =
  nk-lt-range-neq w b0 b1 k (nk-wire-lt-wle-trans w a1 b0 (nk-and-r (nk-wire-le a0 w) (nk-wire-lt w a1) hw) p) hk
