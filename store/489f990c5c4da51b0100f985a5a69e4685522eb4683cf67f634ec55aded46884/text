-- the bonds, as a tree toward the carboxyl carbon: each atom names the atom it hangs from
il-par : Ile → Ile
il-par x = case x of
  il-c1 → il-c1
  il-o1 → il-c1
  il-o2 → il-c1
  il-ho → il-o2
  il-ca → il-c1
  il-ha → il-ca
  il-n → il-ca
  il-hn1 → il-n
  il-hn2 → il-n
  il-cb → il-ca
  il-hb → il-cb
  il-cg1 → il-cb
  il-g11 → il-cg1
  il-g12 → il-cg1
  il-cd1 → il-cg1
  il-d11 → il-cd1
  il-d12 → il-cd1
  il-d13 → il-cd1
  il-cg2 → il-cb
  il-g21 → il-cg2
  il-g22 → il-cg2
  il-g23 → il-cg2
