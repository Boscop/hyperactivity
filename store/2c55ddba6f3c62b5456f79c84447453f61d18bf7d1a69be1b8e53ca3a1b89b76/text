-- the machine's normal form, a pass of transport steps, and again until nothing changes
nk-norm-it : Nat → NkTm → NkTm
nk-norm-it zero t = nk-nf (toNat #2000) t
nk-norm-it (suc k) t = if nk-tm-eq (nk-kan (nk-nf (toNat #2000) t)) (nk-nf (toNat #2000) t) then nk-nf (toNat #2000) t else nk-norm-it k (nk-kan (nk-nf (toNat #2000) t))
