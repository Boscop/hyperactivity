bn-rmd-blocks : Nat → List Word → List Word → List Word
bn-rmd-blocks zero    bs st = st
bn-rmd-blocks (suc k) bs st =
  let x16 = bn-parse-le32s (toNat #16) (h-take (toNat #64) bs)
      h0  = bn-nth-w #0 st
      h1  = bn-nth-w #1 st
      h2  = bn-nth-w #2 st
      h3  = bn-nth-w #3 st
      h4  = bn-nth-w #4 st
      ini = list-append st st
      out = bn-rmd-rounds (toNat #80) #0 x16 ini
      al  = bn-nth-w #0 out
      bl  = bn-nth-w #1 out
      cl  = bn-nth-w #2 out
      dl  = bn-nth-w #3 out
      el  = bn-nth-w #4 out
      ar  = bn-nth-w #5 out
      br  = bn-nth-w #6 out
      cr  = bn-nth-w #7 out
      dr  = bn-nth-w #8 out
      er  = bn-nth-w #9 out
      nh0 = bn-add32 h1 (bn-add32 cl dr)
      nh1 = bn-add32 h2 (bn-add32 dl er)
      nh2 = bn-add32 h3 (bn-add32 el ar)
      nh3 = bn-add32 h4 (bn-add32 al br)
      nh4 = bn-add32 h0 (bn-add32 bl cr)
      nx  = cons nh0 (cons nh1 (cons nh2 (cons nh3 (cons nh4 nil))))
  in bn-rmd-blocks k (kc-drop (toNat #64) bs) nx
