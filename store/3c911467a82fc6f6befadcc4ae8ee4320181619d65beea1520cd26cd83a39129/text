zr-dr : (p q a : ZrC) → zr-mu (zr-ad p q) a ≡ zr-ad (zr-mu p a) (zr-mu q a)
zr-dr p q a = zr-law (zr-mu (zr-ad p q) a) (zr-ad (zr-mu p a) (zr-mu q a)) (zmul (zplus (zr-val p) (zr-val q)) (zr-val a)) (zplus (zmul (zr-val p) (zr-val a)) (zmul (zr-val q) (zr-val a)))
  (zr-tamr p q a) (zr-pdr (zr-val p) (zr-val q) (zr-val a)) (zr-tam p a q a)
