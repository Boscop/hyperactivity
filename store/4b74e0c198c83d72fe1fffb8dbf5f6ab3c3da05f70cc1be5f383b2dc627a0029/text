zle-trans : (x y z : Nat × Nat) → zle x y → zle y z → zle x z
zle-trans x y z h k = nle-cancel (plus (fst x) (snd z)) (plus (fst z) (snd x)) (plus (fst y) (snd y))
  (le-cong-r (plus (plus (fst x) (snd z)) (plus (fst y) (snd y))) (plus (plus (fst y) (snd x)) (plus (fst z) (snd y))) (plus (plus (fst z) (snd x)) (plus (fst y) (snd y)))
    (le-cong-l (plus (plus (fst x) (snd y)) (plus (fst y) (snd z))) (plus (plus (fst x) (snd z)) (plus (fst y) (snd y))) (plus (plus (fst y) (snd x)) (plus (fst z) (snd y)))
      (nle-add (plus (fst x) (snd y)) (plus (fst y) (snd x)) (plus (fst y) (snd z)) (plus (fst z) (snd y)) h k)
      (swap-mid (fst x) (snd y) (fst y) (snd z)))
    (transN (congN (λ w → plus w (plus (fst z) (snd y))) (plus-comm (fst y) (snd x)))
      (transN (plus-mid4 (snd x) (fst y) (fst z) (snd y))
        (congN (λ w → plus w (plus (fst y) (snd y))) (plus-comm (snd x) (fst z))))))
