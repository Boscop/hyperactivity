  λ i →
    ( hxp-bxor-zero (fst h) i
    , ( hxp-bxor-zero (fst (snd h)) i
      , ( hxp-bxor-zero (fst (snd (snd h))) i
        , ( hxp-bxor-zero (fst (snd (snd (snd h)))) i
          , ( hxp-bxor-zero (fst (snd (snd (snd (snd h))))) i
            , hxp-bxor-zero (snd (snd (snd (snd (snd h))))) i )))))

hxp-hex6-xor-cancel : (h m : Hex6) → hxp-hex6-xor (hxp-hex6-xor h m) m ≡ h
hxp-hex6-xor-cancel h m =
  λ i →
    ( hxp-bxor-cancel (fst h) (fst m) i
    , ( hxp-bxor-cancel (fst (snd h)) (fst (snd m)) i
      , ( hxp-bxor-cancel (fst (snd (snd h))) (fst (snd (snd m))) i
        , ( hxp-bxor-cancel (fst (snd (snd (snd h)))) (fst (snd (snd (snd m)))) i
          , ( hxp-bxor-cancel (fst (snd (snd (snd (snd h))))) (fst (snd (snd (snd (snd m))))) i
            , hxp-bxor-cancel (snd (snd (snd (snd (snd h))))) (snd (snd (snd (snd (snd m))))) i )))))

data CuTerm : Type where
  cu-atom       : Hex6 → CuTerm
  cu-zero-shift : CuTerm → CuTerm
  cu-dbl-change : CuTerm → Hex6 → CuTerm
  cu-cut        : CuTerm → CuTerm → CuTerm

cu-eval : CuTerm → Hex6
cu-eval (cu-atom h)         = h
cu-eval (cu-zero-shift e)   = hxp-hex6-xor (cu-eval e) hxp-hex6-zero
cu-eval (cu-dbl-change e m) = hxp-hex6-xor (hxp-hex6-xor (cu-eval e) m) m
cu-eval (cu-cut a b)        = hxp-hex6-xor (cu-eval a) (cu-eval b)

cu-superopt : CuTerm → CuTerm
cu-superopt (cu-atom h)         = cu-atom h
cu-superopt (cu-zero-shift e)   = cu-superopt e
cu-superopt (cu-dbl-change e m) = cu-superopt e
cu-superopt (cu-cut a b)        = cu-cut (cu-superopt a) (cu-superopt b)

-- THEOREM 15 (Characteristica Universalis — Calculus Ratiocinator Superoptimizer Soundness):
-- Eliminates arbitrary nested zero-flux shifts and involutive moving-line pairs with 0 semantic loss!
hxp-thm-characteristica-superopt-sound :
  (e : CuTerm) → cu-eval (cu-superopt e) ≡ cu-eval e
hxp-thm-characteristica-superopt-sound (cu-atom h) = refl
hxp-thm-characteristica-superopt-sound (cu-zero-shift e) =
  let ih = hxp-thm-characteristica-superopt-sound e
  in hxp-trans ih (hxp-sym (hxp-hex6-xor-zero (cu-eval e)))
hxp-thm-characteristica-superopt-sound (cu-dbl-change e m) =
  let ih = hxp-thm-characteristica-superopt-sound e
  in hxp-trans ih (hxp-sym (hxp-hex6-xor-cancel (cu-eval e) m))
hxp-thm-characteristica-superopt-sound (cu-cut a b) =
  let iha = hxp-thm-characteristica-superopt-sound a
      ihb = hxp-thm-characteristica-superopt-sound b
  in λ i → hxp-hex6-xor (iha i) (ihb i)

