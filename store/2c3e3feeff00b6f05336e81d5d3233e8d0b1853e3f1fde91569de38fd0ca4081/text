-- the contributions of one term over its root pairs
term-rads-y : SQ → STerm → Cand → List Cand → List Rad
term-rads-y w t x ys = case ys of
  nil → nil
  cons y rest → cons (rad-of (sq-mul w (sq-mul (s-eval (snd (snd (snd t))) (fst x) (fst y)) (sq-inv (sq-mul (poly-eval (poly-deriv (fst (fst (snd t)))) (fst x)) (poly-eval (poly-deriv (fst (fst (snd (snd t))))) (fst y))))))
      (plus (times (snd (fst (snd t))) (fst (snd x))) (times (snd (fst (snd (snd t)))) (fst (snd y))))
      (plus (times (snd (fst (snd t))) (snd (snd x))) (times (snd (fst (snd (snd t)))) (snd (snd y)))))
    (term-rads-y w t x rest)
