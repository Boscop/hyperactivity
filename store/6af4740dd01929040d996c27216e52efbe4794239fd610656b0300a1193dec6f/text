pins-same : (e : Val) (c : Nat) (m : Mono) (c2 : Nat) (m2 : Mono) (r2 : Poly) → m ≡ m2 →
            plus (times (plus c c2) (mev e m2)) (pev e r2) ≡ plus (times c (mev e m)) (plus (times c2 (mev e m2)) (pev e r2))
pins-same e c m c2 m2 r2 q =
  transN (congN (λ z → plus z (pev e r2)) (times-distr c c2 (mev e m2)))
    (transN (plus-assoc (times c (mev e m2)) (times c2 (mev e m2)) (pev e r2))
      (congN (λ z → plus (times c z) (plus (times c2 (mev e m2)) (pev e r2))) (symN (congm e q))))
