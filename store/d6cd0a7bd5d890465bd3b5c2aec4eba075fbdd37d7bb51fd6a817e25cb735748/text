s-link-to : (List Word → List Word) → List Word → List Word → Sum Unit (List Word × List Word) → List Word
s-link-to k r txt (inl u) = cons #91 (k r)
s-link-to k r txt (inr q) = if h-null (fst q) then cons #91 (k r) else list-append "<a href='" (list-append (fst q) (list-append "'>" (list-append txt (list-append "</a>" (k (snd q))))))
