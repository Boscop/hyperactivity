-- struct timespec, 16 bytes: tv_sec then tv_nsec, a word each.
-- struct epoll_event: events (4 bytes) at 0, data (8 bytes) at the platform's offset.
-- The scratch area (4096 bytes, lx-scratch): the sockaddr at 0, its length (a word, 4 bytes used)
-- at 16, a timespec at 24, an int option value at 40, one epoll_event at 48, the events
-- epoll_wait fills from 64 (at most lx-max-events of them: 64 × 16 bytes fit)
lx-scratch : Word
lx-scratch = #4096
