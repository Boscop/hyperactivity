conj-sub-sound : (sk : Lst Entry) (c d : Conj) → conj-sub c d ≡ true → IEq sk (conj-ix d) (ixmeet (conj-ix c) (conj-ix d))
conj-sub-sound sk lnil d e = ieq-sym sk (ixmeet ix1 (conj-ix d)) (conj-ix d) (law-unit-m-l sk (conj-ix d))
conj-sub-sound sk (lcons l ls) d e =
  (ieq-trans sk (conj-ix d) (ixmeet (lit-ix l) (conj-ix d)) (ixmeet (conj-ix (lcons l ls)) (conj-ix d))
    (conj-has-sound sk l d (andB-l (conj-has l d) (conj-sub ls d) e))
    (ieq-trans sk (ixmeet (lit-ix l) (conj-ix d)) (ixmeet (lit-ix l) (ixmeet (conj-ix ls) (conj-ix d))) (ixmeet (conj-ix (lcons l ls)) (conj-ix d))
    (ieq-meet sk (lit-ix l) (lit-ix l) (conj-ix d) (ixmeet (conj-ix ls) (conj-ix d)) (ieq-refl sk (lit-ix l)) (conj-sub-sound sk ls d (andB-r (conj-has l d) (conj-sub ls d) e)))
    (ieq-trans sk (ixmeet (lit-ix l) (ixmeet (conj-ix ls) (conj-ix d))) (ixmeet (ixmeet (lit-ix l) (conj-ix ls)) (conj-ix d)) (ixmeet (conj-ix (lcons l ls)) (conj-ix d))
    (ieq-sym sk (ixmeet (ixmeet (lit-ix l) (conj-ix ls)) (conj-ix d)) (ixmeet (lit-ix l) (ixmeet (conj-ix ls) (conj-ix d))) (law-assoc-m sk (lit-ix l) (conj-ix ls) (conj-ix d)))
    (ieq-meet sk (ixmeet (lit-ix l) (conj-ix ls)) (conj-ix (lcons l ls)) (conj-ix d) (conj-ix d) (ieq-sym sk (conj-ix (lcons l ls)) (ixmeet (lit-ix l) (conj-ix ls)) (conj-ix-cons sk l ls)) (ieq-refl sk (conj-ix d))))))
