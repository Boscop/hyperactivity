s-write-all-buf : Nat → Word → Word → Word → Proc W Bool
s-write-all-buf zero fd ptr rem = ret (weq rem #0)
s-write-all-buf (suc k) fd ptr rem =
  if weq rem #0 then ret {lzero} {W} true
  else bind (sys-call #1 fd ptr rem #0 #0 #0) (λ w →
    if orB (weq w #0) (wlt #9223372036854775807 w) then ret {lzero} {W} false
    else s-write-all-buf k fd (wadd ptr w) (wsub rem w))
