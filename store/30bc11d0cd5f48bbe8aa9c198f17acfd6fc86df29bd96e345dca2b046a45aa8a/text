-- `hyperactive apply PATH BASE OTHER`: the changes another machine made to a module (from BASE to
-- OTHER, two modules of the pool) applied to what PATH holds here: a construction this machine makes
-- from another's work. The names both changed differently are said; `apply PATH BASE OTHER dry`
-- says them and records nothing
hy-apply : List Word → List (List Word) → Proc W Unit
hy-apply m (cons path (cons base (cons other (cons d ds)))) = bind (h-capture (cons m (cons "--apply" (cons path (cons base (cons other (cons "--dry" nil))))))) (λ r → h-out (snd r))
hy-apply m (cons path (cons base (cons other nil))) = bind (h-capture (cons m (cons "--apply" (cons path (cons base (cons other nil)))))) (λ r → h-out (snd r))
hy-apply m l = h-fail "hyperactive apply PATH BASE OTHER [dry]"
