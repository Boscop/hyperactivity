-- a body with a free variable replaced by a closed body; a body on a case of a face
nk-sub-free : Word → NkTm → NkTm → NkTm
nk-sub-free x e (nk-free y) = if %weq x y then e else nk-free y
nk-sub-free x e (nk-lam b) = nk-lam (nk-sub-free x e b)
nk-sub-free x e (nk-con c as) = nk-con c (nk-sub-free x e as)
nk-sub-free x e (nk-op h p as) = nk-op h (nk-sub-free x e p) (nk-sub-free x e as)
nk-sub-free x e (nk-match h p cs) = nk-match h (nk-sub-free x e p) (nk-sub-free x e cs)
nk-sub-free x e (nk-cons t r) = nk-cons (nk-sub-free x e t) (nk-sub-free x e r)
nk-sub-free x e t = t
