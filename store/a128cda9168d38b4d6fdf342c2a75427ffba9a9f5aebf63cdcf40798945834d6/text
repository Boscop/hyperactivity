-- (part of language-support)
select_segment_register : (proc_mode' : proc_mode) → (prefixes' : prefixes) → (mod_var : Bits #2) → (r_m : Bits #3) → (sib' : sib) → MS ZI
select_segment_register proc_mode' prefixes' mod_var r_m sib' =
  let m'1 : Bits #8
      m'1 = (prefixes-seg prefixes')
  in λ σ →
       if (weq m'1 #46) then
         the (MS ZI)
           (retS {ZI} (zpos #1)) σ
       else if (weq m'1 #54) then
         the (MS ZI)
           (retS {ZI} (zpos #2)) σ
       else if (weq m'1 #62) then
         the (MS ZI)
           (retS {ZI} (zpos #3)) σ
       else if (weq m'1 #38) then
         the (MS ZI)
           (retS {ZI} (zpos #0)) σ
       else if (weq m'1 #100) then
         the (MS ZI)
           (retS {ZI} (zpos #4)) σ
       else if (weq m'1 #101) then
         the (MS ZI)
           (retS {ZI} (zpos #5)) σ
       else
         the (MS ZI)
           (bindS {ZI} {ZI} (select_address_size proc_mode' (Some prefixes')) (λ addr_size →
              let t'4 : ZI
                  t'4 =
                    if (z-eq addr_size (zpos #2)) then
                      (if (b-and (b-not (weq mod_var #3)) (b-or (weq r_m #2) (weq r_m #3))) then (zpos #2) else (zpos #3))
                    else
                      (let t'3 : ZI
                           t'3 =
                             if (b-or (b-and (b-or (weq mod_var #1) (weq mod_var #2)) (weq r_m #5)) (b-and (b-not (weq mod_var #3)) (b-and (weq r_m #4) (weq (sib-base sib') #4)))) then
                               (zpos #2)
                             else
                               (zpos #3)
                       in t'3)
              in retS {ZI} t'4)) σ
