v-build-s1 : Nat → List (List Word) → List (List Word × List Word) → List (List Word × List (List Word)) → List (List Word × List (List Word)) → List (List Word) → List (List Word) → List (List Word × List Word) → List (List Word) → List (List Word) → List (List Word × List (List Word)) → List (List Word × List (List Word)) → List (List Word × List (List Word)) → List (List Word × List (List Word)) → VEnv
v-build-s1 rounds names sents ptab ktab roots ip res res-ids done-set aft ctx anc und =
  let need = v-close rounds (λ i → v-filter (λ c → h-not (h-has c done-set)) (v-look-list i ktab)) (v-filter (λ r → h-not (h-has r done-set)) roots) in
  let leaves = v-filter (λ x → andB (v-empty (v-look-list x ktab)) (h-has x need)) names in
  v-build-s2 rounds names sents ptab ktab roots ip res res-ids done-set leaves aft ctx anc und (v-mk-wtab done-set leaves aft anc und)
