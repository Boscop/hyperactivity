dnf-insert-sound : (sk : Lst Entry) (c : Conj) (f : DNF) → IEq sk (dnf-ix (dnf-insert c f)) (ixjoin (conj-ix c) (dnf-ix f))
dnf-insert-sound sk c lnil = ieq-sym sk (ixjoin (conj-ix c) ix0) (conj-ix c) (law-unit-j-r sk (conj-ix c))
dnf-insert-sound sk c (lcons d ds) =
  bool-case2 (λ b → IEq sk (dnf-ix (if b then lcons c (lcons d ds) else lcons d (dnf-insert c ds))) (ixjoin (conj-ix c) (dnf-ix (lcons d ds)))) (conj-lt c d)
    (λ e → ieq-refl sk (ixjoin (conj-ix c) (dnf-ix (lcons d ds))))
    (λ e → (ieq-trans sk (dnf-ix (lcons d (dnf-insert c ds))) (ixjoin (conj-ix d) (dnf-ix (dnf-insert c ds))) (ixjoin (conj-ix c) (dnf-ix (lcons d ds)))
    (dnf-ix-cons sk d (dnf-insert c ds))
    (ieq-trans sk (ixjoin (conj-ix d) (dnf-ix (dnf-insert c ds))) (ixjoin (conj-ix d) (ixjoin (conj-ix c) (dnf-ix ds))) (ixjoin (conj-ix c) (dnf-ix (lcons d ds)))
    (ieq-join sk (conj-ix d) (conj-ix d) (dnf-ix (dnf-insert c ds)) (ixjoin (conj-ix c) (dnf-ix ds)) (ieq-refl sk (conj-ix d)) (dnf-insert-sound sk c ds))
    (ieq-trans sk (ixjoin (conj-ix d) (ixjoin (conj-ix c) (dnf-ix ds))) (ixjoin (conj-ix c) (ixjoin (conj-ix d) (dnf-ix ds))) (ixjoin (conj-ix c) (dnf-ix (lcons d ds)))
    (join-rot sk (conj-ix d) (conj-ix c) (dnf-ix ds))
    (ieq-join sk (conj-ix c) (conj-ix c) (ixjoin (conj-ix d) (dnf-ix ds)) (dnf-ix (lcons d ds)) (ieq-refl sk (conj-ix c)) (ieq-sym sk (dnf-ix (lcons d ds)) (ixjoin (conj-ix d) (dnf-ix ds)) (dnf-ix-cons sk d ds)))))))
