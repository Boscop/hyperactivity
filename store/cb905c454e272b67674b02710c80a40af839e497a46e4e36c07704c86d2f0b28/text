-- rm_low_64: from physical_memory.sail (it calls what is defined after it there)
-- (part of language-support)
rm_low_64 : (addr : ZI) → MS (Bits #64)
rm_low_64 addr =
  bindS {Bool} {Bits #64} (getS {Bool} x86-app_view) (λ app_view'1 →
    onS {Unit} {Bits #64} (fl-assert {exception} (b-not app_view'1) #10766557306235811165391993617916461646257293381573686321) (λ _ →
      bindS {Bits #32} {Bits #64} (rm_low_32 addr) (λ dword0 →
        bindS {Bits #32} {Bits #64} (rm_low_32 (z-add (zpos #4) addr)) (λ dword1 →
          let qword : Bits #64
              qword = (bv-or #64 (bits_of_int (ash_left_int (bv-unsigned #32 dword1) (zpos #32)) (zpos #64)) (bv-zext #32 #64 dword0))
          in retS {Bits #64} qword))))
