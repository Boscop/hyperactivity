-- Project catenoid point (x, y, z) in tenths (dist = 4800 = 480.0px)
cat-proj : SInt → SInt → SInt → SInt → RPt
cat-proj x y z rad =
  let den = si-sub (sp #4800) z
      sx = si-div (si-mul x (sp #4800)) den
      sy = si-div (si-mul y (sp #4800)) den
      px = si-add (sp #1280) sx
      py = si-sub (sp #1280) sy
      -- Smooth optical ribbon width in tenths: thicker in front (z > 0), sleeker behind (z < 0)
      rSafe = if si-lt rad (sp #200) then sp #200 else rad
      zNorm = fx-div z rSafe
      tHalf = si-div-w (si-add zNorm (sp fx-S)) #2
      modW = si-add (sp #5600) (fx-mul (sp #5200) tHalf)
      persp = fx-div (sp #4800) den
      w = fx-mul (fx-mul (sp #145) persp) modW
  in rpt px py z w
