-- j halvings of the bracket of p
h2p-bisect : List Bool → List Bool → Nat → Nat → Nat → Nat → Bool × (BZ × BZ) → Bool × (BZ × BZ)
h2p-bisect S S2 M K N j st = case j of
  zero → st
  suc g → h2p-bisect S S2 M K N g (h2p-pick (fst st) (fst (snd st)) (snd (snd st)) (bz-fdiv (bz-add (fst (snd st)) (snd (snd st))) bin-two)
    (h2p-at S S2 (bz-fdiv (bz-add (fst (snd st)) (snd (snd st))) bin-two) M K N))
