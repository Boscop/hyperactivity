-- B(λ) at the tail constant μ and the values (l, p) of (ln 2, π²), as integers (a positive common factor)
pl-blk : BQ → BQ → BQ → BQ → (List (List BQ) × List (List BQ)) × List (List (BQ × (BQ × BQ))) → List (List BZ)
pl-blk mu lam l p m = fst (he-int (pl-appm (pl-top (fst (fst m)) (snd (fst m))) (pl-bot (fn-sub mu lam) lam l p (snd (fst m)) (fst (fst m)) (snd m))))
