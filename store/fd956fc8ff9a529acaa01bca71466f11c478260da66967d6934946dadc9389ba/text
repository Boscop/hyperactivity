-- 1. Exact 1s² Core Screening & Variational Minimum SOS Identity:
--    Schrödinger expectation value of H(Z) on ψ_1s²(ζ) = (ζ³/π) exp(-ζ(r1+r2)):
--      ⟨T⟩ = ζ²,  ⟨V_ne⟩ = -2 Z ζ,  ⟨1/r₁₂⟩ = (5/8) ζ
--      E(ζ) = ζ² - 2(Z - 5/16) ζ.
--    Exact SOS completion of the square:
--      E(ζ) + (Z - 5/16)² = (ζ - (Z - 5/16))² ≥ 0.
--    Variables (0..1): Z, ζ.
chem-core-1s2-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-core-1s2-poly A ad mu q vs =
  (λ g sub sq →
    let Z = g 0; zet = g 1
        q2 = q (fn-q 2 1)
        q58 = q (fn-q 5 8)
        q516 = q (fn-q 5 16)
        E = ad (sub (sq zet) (mu q2 (mu Z zet))) (mu q58 zet)
        zopt = sub Z q516
        lhs = ad E (sq zopt)
        rhs = sq (sub zet zopt)
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
