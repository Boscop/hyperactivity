sv-dnf-module : List Word
sv-dnf-module =
  sv-lines
    (cons "// O(1)-Depth Section 4.5 Cubical Face Clause Meet & Conflict Unit (lib/silicon/inet.hypercubical)"
    (cons "module hypercore_dnf_unit ("
    (cons "  input  logic [3:0] pos_a,"
    (cons "  input  logic [3:0] neg_a,"
    (cons "  input  logic [3:0] pos_b,"
    (cons "  input  logic [3:0] neg_b,"
    (cons "  output logic [3:0] pos_out,"
    (cons "  output logic [3:0] neg_out,"
    (cons "  output logic       conflict"
    (cons ");"
    (cons "  assign pos_out  = pos_a | pos_b;"
    (cons "  assign neg_out  = neg_a | neg_b;"
    (cons "  assign conflict = |(pos_out & neg_out);"
    (cons "endmodule"
    (cons "" nil)))))))))))))))
