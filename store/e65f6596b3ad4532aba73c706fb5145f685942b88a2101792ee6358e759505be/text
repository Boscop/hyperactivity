wav-header-ch : Word → Word → List Word → List Word
wav-header-ch nCh nFrames body =
  let blkAlign  = %wmul nCh #2
      byteRate  = %wmul #48000 blkAlign
      dataBytes = %wmul nFrames blkAlign
      riffSize  = %wadd #36 dataBytes
  in list-append "RIFF" (le32 riffSize
     (list-append "WAVEfmt " (le32 #16
     (le16 #1 (le16 nCh (le32 #48000 (le32 byteRate (le16 blkAlign (le16 #16
     (list-append "data" (le32 dataBytes body)))))))))))
