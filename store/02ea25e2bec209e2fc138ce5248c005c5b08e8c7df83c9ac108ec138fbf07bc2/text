nk-faces-eq-s : NkTm → NkTm → Word → NkTm → NkTm → Bool
nk-faces-eq-s kdefs ctx n (nk-cons b r) ss =
  if nk-eq-s kdefs ctx n (nk-norm-in-s kdefs ctx n (nk-bf b)) (nk-norm-in-s kdefs ctx n (nk-bf (nk-nth ss #0)))
    then nk-faces-eq-s kdefs ctx n r (nk-tail ss) else false
nk-faces-eq-s kdefs ctx n t ss = nk-tm-eq ss nk-nil
