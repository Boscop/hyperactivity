nonpos-tv : (m : List Bool) → (v : Bool) → cmpN true (bin-to-nat m) zero ≡ v → (if v then true else not true) ≡ true → le (plus (bin-to-nat m) zero) zero
nonpos-tv m v = case v return λ u → cmpN true (bin-to-nat m) zero ≡ u → (if u then true else not true) ≡ true → le (plus (bin-to-nat m) zero) zero of
  true → λ e h → le-pz (bin-to-nat m) (cmp-true-le (bin-to-nat m) zero e)
  false → λ e h → absurd-ft (le (plus (bin-to-nat m) zero) zero) h
