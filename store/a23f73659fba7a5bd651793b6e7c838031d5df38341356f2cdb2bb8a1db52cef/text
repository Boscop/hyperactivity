-- Monotonicity under observation refinement (o = g ∘ o'): finer neural/sensory readings preserve
-- every previously established safety proof by precomposition.
safe-refine : {S O O' : Type} → (o' : S → O') → (g : O' → O) → (y' : O') → (P : S → Type) →
  SafeAt (λ s → g (o' s)) (g y') P → SafeAt o' y' P
safe-refine = warrants-refine
