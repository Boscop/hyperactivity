index-tabulateV32 : (A : Type) → (to : A → UInt32) → (from : UInt32 → A) → ((v : A) → from (to v) ≡ v) → (n : Nat) → (f : Fin n → A) → (p : Fin n) → aindexV32 A from n (atabV32 A to n f) p ≡ f p
index-tabulateV32 A to from ft n f p =
  concat {lzero} {A} {from (aindex32 n (atab32 n (λ q → to (f q))) p)} {from (to (f p))} {f p}
    (cong {lzero} {lzero} {UInt32} {A} from {aindex32 n (atab32 n (λ q → to (f q))) p} {to (f p)} (index-tabulate32 n (λ q → to (f q)) p)) (ft (f p))
