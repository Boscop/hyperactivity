-- one connection answered: the request read, its answer written, the connection closed
s-handle : Bool → List Word → List Word → Sum Unit (List Word) → Word → Proc W Unit
s-handle pub st m tok c = bind (s-read (toNat #100000) c nil) (λ req →
  bind (s-request pub st m tok req) (λ resp →
  bind (fd-write c resp) (λ w → bind (sys-call #3 c #0 #0 #0 #0 #0) (λ cl → ret unit))))
