-- of the pairs sorted by module, one entry's file for each module bound (none for the entries binding none)
os-first-each : List Word → List (List Word × List Word) → List (List Word)
os-first-each p nil = nil
os-first-each p (cons x r) = if h-eq p (fst x) then os-first-each p r else cons (snd x) (os-first-each (fst x) r)
