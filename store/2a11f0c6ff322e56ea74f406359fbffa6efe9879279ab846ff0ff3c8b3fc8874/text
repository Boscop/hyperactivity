si-all-take : {A : Type} → (P : A → Type) → (k : Nat) → (l : List A) → si-all P l → si-all P (take-n k l)
si-all-take P k = case k return λ w → (l : List A) → si-all P l → si-all P (take-n w l) of
  zero → λ l h → unit
  suc g → λ l → case l return λ v → si-all P v → si-all P (take-n (suc g) v) of
    nil → λ h → unit
    cons x r → λ h → (fst h , rec g r (snd h))
