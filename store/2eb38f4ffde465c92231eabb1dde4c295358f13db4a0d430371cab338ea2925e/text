-- Single-qubit anti-commutation indicator (`true` iff `a b = -b a`)
p1-anticomm : Pauli1 → Pauli1 → Bool
p1-anticomm p-I _   = false
p1-anticomm p-X p-I = false
p1-anticomm p-X p-X = false
p1-anticomm p-X p-Y = true
p1-anticomm p-X p-Z = true
p1-anticomm p-Y p-I = false
p1-anticomm p-Y p-X = true
p1-anticomm p-Y p-Y = false
p1-anticomm p-Y p-Z = true
p1-anticomm p-Z p-I = false
p1-anticomm p-Z p-X = true
p1-anticomm p-Z p-Y = true
p1-anticomm p-Z p-Z = false
