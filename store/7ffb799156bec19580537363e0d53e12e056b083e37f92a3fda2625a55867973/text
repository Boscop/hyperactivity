-- Exact 22-halfword Calma GDSII v6.0 BOUNDARY binary record sequence:
--   [#4, #2048]                     BOUNDARY (4 bytes, 0x0800)
--   [#6, #3330, layer]              LAYER    (6 bytes, 0x0D02)
--   [#6, #3586, dtype]              DATATYPE (6 bytes, 0x0E02)
--   [#44, #4099, x0,y0..x0,y0]      XY       (44 bytes, 0x1003, 5 closed vertices)
--   [#4, #4352]                     ENDEL    (4 bytes, 0x1100)
gds-encode-one : Word → Word → Rect → List Word
gds-encode-one layer dtype r =
  let wx0 = w-of-nat (rx0 r)
      wy0 = w-of-nat (ry0 r)
      wx1 = w-of-nat (rx1 r)
      wy1 = w-of-nat (ry1 r)
  in cons #4 (cons gds-rec-boundary
     (cons #6 (cons gds-rec-layer (cons layer
     (cons #6 (cons gds-rec-datatype (cons dtype
     (cons #44 (cons gds-rec-xy
       (cons wx0 (cons wy0
       (cons wx1 (cons wy0
       (cons wx1 (cons wy1
       (cons wx0 (cons wy1
       (cons wx0 (cons wy0
       (cons #4 (cons gds-rec-endel nil)))))))))))))))))))))
