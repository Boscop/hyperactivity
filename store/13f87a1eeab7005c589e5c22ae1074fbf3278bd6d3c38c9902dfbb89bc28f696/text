-- one step: the next definition to do that is not seen
prog-step : Prog → Prog
prog-step st =
  case drop-seen (fst (snd st)) (fst st) return (λ _ → Prog) of
    lnil → (lnil , snd st)
    lcons g rest →
      (let st1 = the Prog (rest , snd st)
       in case unfold g return (λ _ → Prog) of
            none → prog-bad g (not-fo reflect (cglob g)) st1
            some cd → prog-def g cd st1)
