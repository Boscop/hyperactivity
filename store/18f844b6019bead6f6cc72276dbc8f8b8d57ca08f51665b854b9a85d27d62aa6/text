tom-step : TomState → IsaInst → TomState
tom-step (tstate ep rat prf) i-nop = tstate ep rat prf
tom-step (tstate ep rat prf) (i-imm rd imm) =
  tom-write-rd ep rat prf rd imm
tom-step (tstate ep rat prf) (i-addi rd rs1 imm) =
  tom-write-rd ep rat prf rd (plus (prf (rat rs1)) imm)
tom-step (tstate ep rat prf) (i-alu op rd rs1 rs2) =
  tom-write-rd ep rat prf rd (alu-eval op (prf (rat rs1)) (prf (rat rs2)))
