cliff-S-ret-raw : (s : Bool) → (p : Pauli1) → cliff-Sdg (cliff-S (s , p)) ≡ (s , p)
cliff-S-ret-raw false p-I = λ _ → (false , p-I)
cliff-S-ret-raw false p-X = λ _ → (false , p-X)
cliff-S-ret-raw false p-Y = λ _ → (false , p-Y)
cliff-S-ret-raw false p-Z = λ _ → (false , p-Z)
cliff-S-ret-raw true  p-I = λ _ → (true  , p-I)
cliff-S-ret-raw true  p-X = λ _ → (true  , p-X)
cliff-S-ret-raw true  p-Y = λ _ → (true  , p-Y)
cliff-S-ret-raw true  p-Z = λ _ → (true  , p-Z)
