-- `code`: its text escaped and nothing more read in it
md-code : (Bool → Word → List Word → List Word) → Bool → MdTo → List Word
md-code k lk (to-none t) = cons #96 (k lk #96 t)
md-code k lk (to-at nil c) = cons #96 (k lk #96 (cons #96 c))
md-code k lk (to-at (cons z a) c) = list-append "<code>" (list-append (s-esc (cons z a)) (list-append "</code>" (k lk #96 c)))
