-- a value applied to arguments one at a time
ce-apps : (Code → List Word → List Word) → (List Word → List Word) → Lst Code → List Word → List Word
ce-apps pr hd lnil acc = hd acc
ce-apps pr hd (lcons a r) acc =
  ce-apps pr (λ tl → list-append "hy_app(" (hd (list-append ", " (pr a (list-append ")" tl))))) r acc
