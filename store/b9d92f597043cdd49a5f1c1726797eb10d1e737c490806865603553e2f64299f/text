c-exp : Nat → Word → Code → List Word
c-exp zero d c = "hy_bad()"
c-exp (suc k) d (cvar n) = list-append "v" (h-decimal (%wsub (%wsub d #1) n))
c-exp (suc k) d (cwlit n) = list-append (h-decimal n) "ull"
c-exp (suc k) d (cwop j a b) = list-append (c-opname j) (list-append "(" (list-append (c-exp k d a) (list-append ", " (list-append (c-exp k d b) ")"))))
c-exp (suc k) d (clet t b) = list-append "({ uint64_t v" (list-append (h-decimal d) (list-append " = " (list-append (c-exp k d t) (list-append "; " (list-append (c-exp k (%wsucc d) b) "; })")))))
c-exp (suc k) d (capp f a) =
  (case fst (x-spine (capp f a)) return (λ _ → List Word) of
     cglob g → list-append "g" (list-append (h-decimal g) (list-append "(" (list-append (c-args-n (λ x → c-exp k d x) (snd (x-spine (capp f a))) true) ")")))
     h → "hy_bad()")
c-exp (suc k) d (cglob g) = list-append "g" (list-append (h-decimal g) "()")
c-exp (suc k) d c = "hy_bad()"
