max-cmp-init : Nat → List Word → List Word → List Word → Word → List Word
max-cmp-init zero _ _ _ _ = nil
max-cmp-init (suc k) pfx pa pb i =
  let ai  = epfl-indexed pa i
      bi  = epfl-indexed pb i
      gi  = max-gname pfx #0 i
      pi  = max-pname pfx #0 i
      pat = the (List Word) (if %weq i #127 then "01" else "10")
  in sv-concat
       (cons (epfl-gate2 ai bi gi pat)
       (cons (epfl-xnor-blif ai bi pi)
       (cons (max-cmp-init k pfx pa pb (%wsucc i)) nil)))
