-- build/etym/key.sed, made once from UnicodeData.txt
e-key-sed-ready : Proc W Unit
e-key-sed-ready = bind (e-exists "build/etym/key.sed") (λ have → if have then ret {lzero} {W} unit else
  bind e-ucd-ready (λ ok → if h-not ok then h-fail "etym: UnicodeData.txt could not be had" else
  bind (e-out (cons "grep" (cons "-aE" (cons "^[0-9A-F]+;[^;]*;[^;]*;[^;]*;[^;]*;[0-9A-F]" (cons e-ucd-path nil))))) (λ ds →
  bind (e-out (cons "grep" (cons "-aE" (cons "^([^;]*;){13}[0-9A-F]" (cons e-ucd-path nil))))) (λ ls →
  bind (h-write "build/etym/key.sed.tmp" (e-key-sed (h-lines ds) (h-lines ls))) (λ w →
  bind (e-rename "build/etym/key.sed.tmp" "build/etym/key.sed") (λ r → ret {lzero} {W} unit))))))
