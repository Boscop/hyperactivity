-- ---------------------------------------------------------------- wire-shared evaluation over a signature
nk-has-gref : NkTm → Bool
nk-has-gref (nk-lam b) = nk-has-gref b
nk-has-gref (nk-susp b) = nk-has-gref b
nk-has-gref (nk-con c as) = if %weq c #54 then true else nk-has-gref as
nk-has-gref (nk-op h p as) = if nk-has-gref p then true else nk-has-gref as
nk-has-gref (nk-match h p cs) = if nk-has-gref p then true else nk-has-gref cs
nk-has-gref (nk-cons t r) = if nk-has-gref t then true else nk-has-gref r
nk-has-gref t = false
