-- at p (a dyadic m/2^s, given as m): A to k halvings from [−p², 0], where G is increasing, after checking
-- G(−p²) < 0 < G(0); then F = c − r_1; the flag holds when the bracket and both starts are sound
h2p-at : List Bool → List Bool → BZ → Nat → Nat → Nat → Bool × IV
h2p-at S S2 m M K N = h2p-at-flag
  (both (iv-neg-sure (ang-g S S2 (iv-mul S (m , m) (m , m)) (bz-neg (snd (iv-mul S (m , m) (m , m))) , bz-neg (snd (iv-mul S (m , m) (m , m)))) M))
        (iv-pos-sure (ang-g S S2 (iv-mul S (m , m) (m , m)) iv-zero M)))
  (h2p-at-a S S2 (m , m) (rad-sigma S S2 (m , m)) M N
    (ang-a S S2 (iv-mul S (m , m) (m , m)) M K (bz-neg (snd (iv-mul S (m , m) (m , m))) , bz-zero)))
