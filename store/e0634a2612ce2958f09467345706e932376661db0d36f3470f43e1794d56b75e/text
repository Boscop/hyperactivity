-- (part of language-support)
imul_spec_16 : (dst' : Bits #16) → (src : Bits #16) → ((Bits #16) × (Bits #16) × (Bits #32) × (Bits #1))
imul_spec_16 dst' src =
  let dst_int : Bits #16
      dst_int = dst'
      src_int : Bits #16
      src_int = src
      product_int : Bits #32
      product_int = (bits_of_int (z-mul (bv-signed #16 dst_int) (bv-signed #16 src_int)) (zpos #32))
      product : Bits #32
      product = product_int
      product_high : Bits #16
      product_high = (bv-slice #32 product #31 #16)
      product_low : Bits #16
      product_low = (bv-slice #32 product #15 #0)
      product_low_int : Bits #16
      product_low_int = product_low
      cf_and_of : Bits #1
      cf_and_of = (bool_to_bits (b-not (weq (bv-sext #16 #32 product_low_int) product_int)))
  in (product_high , product_low , product , cf_and_of)
