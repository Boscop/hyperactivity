xor-eq-from-false : (a b : Bool) → b-xor2 a b ≡ false → a ≡ b
xor-eq-from-false false false _ = λ _ → false
xor-eq-from-false false true  h = Empty-rec {lzero} {false ≡ true} (false≢true (sym h))
xor-eq-from-false true  false h = Empty-rec {lzero} {true ≡ false} (false≢true (sym h))
xor-eq-from-false true  true  _ = λ _ → true
