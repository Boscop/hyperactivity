wslot-ch : {Val Op : Type} → WCh Val Op → WSlot Val Op → WSlot Val Op
wslot-ch (wc-val v) ws-none = ws-val v
wslot-ch (wc-val v) (ws-op o) = ws-pair o v
wslot-ch (wc-val v) (ws-val v0) = ws-val v0
wslot-ch (wc-val v) (ws-pair o v0) = ws-pair o v0
wslot-ch (wc-op o) ws-none = ws-op o
wslot-ch (wc-op o) (ws-val v) = ws-pair o v
wslot-ch (wc-op o) (ws-op o0) = ws-op o0
wslot-ch (wc-op o) (ws-pair o0 v) = ws-pair o0 v
wslot-ch (wc-put s) t = s
