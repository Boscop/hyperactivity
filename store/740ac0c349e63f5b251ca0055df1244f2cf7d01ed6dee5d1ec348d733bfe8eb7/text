-- w(e, e′) for e′ over the edges from e1: the closed form of ⟨O_ee′⟩ in the state c, from the vertex's data w, the
-- edges' traces ss and the Gram matrix g, each computed once
form-row : List Cand → List Nat → List Triple → List SQ → VW → List (List Side) → Rows → Nat → Nat → Nat → List (List Rad)
form-row cs ds ts c w ss g e e1 n = case n of
  zero → nil
  suc k → cons (closed-form cs (terms-expect (vw-d w) g c (o-terms-vw e e1 ds ts w (sides-nth e ss) (sides-nth e1 ss)))) (form-row cs ds ts c w ss g e (suc e1) k)
