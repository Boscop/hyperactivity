-- two private stores agreeing on the curated subset expose the exact same public CAStore
curate-agree-at : {V : Type} → (b : Bool) → (x1 x2 : Sum Unit V) → (b ≡ true → x1 ≡ x2) →
  (if b then x1 else inl unit) ≡ (if b then x2 else inl unit)
curate-agree-at true x1 x2 h = h refl
curate-agree-at false x1 x2 h = refl
