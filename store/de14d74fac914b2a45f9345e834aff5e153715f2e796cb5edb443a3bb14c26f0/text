conj-proof : {V F : Type} → (e : V → F) → (einv : F → V) → ((v : V) → einv (e v) ≡ v) → (h : V → V) → (P : V → Type) →
  Preserves h P → Preserves (conj-op e einv h) (conj-pred einv P)
conj-proof {V} {F} e einv ret h P q w p =
  subst {lzero} {lzero} {V} {P} {h (einv w)} {einv (e (h (einv w)))} (sym (ret (h (einv w)))) (q (einv w) p)
