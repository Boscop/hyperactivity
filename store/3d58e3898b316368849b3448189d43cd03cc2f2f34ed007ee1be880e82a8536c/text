rect-recover-eq : (x0 y0 w h : Nat) →
  rect (nat-of-w (w-of-nat x0))
       (nat-of-w (w-of-nat y0))
       (sub-by (nat-of-w (w-of-nat x0)) (nat-of-w (w-of-nat (plus w x0))))
       (sub-by (nat-of-w (w-of-nat y0)) (nat-of-w (w-of-nat (plus h y0))))
  ≡ rect x0 y0 w h
rect-recover-eq x0 y0 w h =
  let px0 = nat-w-id x0
      py0 = nat-w-id y0
      pw  = transN (cong2N sub-by (nat-w-id x0) (nat-w-id (plus w x0))) (sub-by-rx1 w x0)
      ph  = transN (cong2N sub-by (nat-w-id y0) (nat-w-id (plus h y0))) (sub-by-rx1 h y0)
  in λ i → rect (px0 i) (py0 i) (pw i) (ph i)
