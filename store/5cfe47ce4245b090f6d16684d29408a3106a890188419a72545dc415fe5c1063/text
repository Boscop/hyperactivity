nk-has-s : NkTm → NkTm → NkTm → Bool
nk-has-s ksig t ty =
  let kdefs = nk-nth (nk-args ksig) #1
  in if nk-failed ksig then false
     else (if (if nk-has-fail t then true else nk-has-fail ty) then false
           else (if nk-con-is (nk-ty-s (toNat #600) ksig nk-nil #0 ty nk-nil) #2
                   then (if nk-failed (nk-ty-s (toNat #600) ksig nk-nil #0 t (nk-norm-s kdefs ty)) then false else true)
                   else false))
