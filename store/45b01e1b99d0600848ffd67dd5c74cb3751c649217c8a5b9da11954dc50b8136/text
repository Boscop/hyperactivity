-- a context with one more variable, of a type: its form at that type, with the forms of the variables before it put in
nk-ext : NkTm → Word → NkTm → NkTm
nk-ext ctx n a = nk-cons (nk-ent a (nk-sub-forms (nk-cons (nk-ent a (nk-free n)) ctx) (%wsucc n) (nk-rfl (toNat #60) (nk-cons (nk-ent a (nk-free n)) ctx) (%wsucc n) a (nk-free n)))) ctx
