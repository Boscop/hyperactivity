nk-norm-in-it-s : Nat → NkTm → NkTm → Word → NkTm → NkTm
nk-norm-in-it-s zero kdefs ctx n t =
  let t0 = nk-sub-forms ctx n t
  in if nk-plain-nf t0 then t0 else nk-nf-s (toNat #30000) kdefs t0
nk-norm-in-it-s (suc k) kdefs ctx n t =
  let t0 = nk-sub-forms ctx n t
  in if nk-plain-nf t0
       then t0
       else let nf = nk-nf-s (toNat #30000) kdefs t0
                kn = nk-pass nf
            in if nk-tm-eq kn nf then nf else nk-norm-in-it-s k kdefs ctx n kn
