-- (6.9) substStep(θ, r) : subst(θ, t) ⟶ subst(θ, u), by induction on the reduction constructor
xp-subst-step : {tu : XpExpr × XpExpr} → XpStep tu → (th : Nat → XpExpr) → XpStep (xp-subst th (fst tu) , xp-subst th (snd tu))
xp-subst-step (xs-fst a b) th = xs-fst (xp-subst th a) (xp-subst th b)
xp-subst-step (xs-snd a b) th = xs-snd (xp-subst th a) (xp-subst th b)
xp-subst-step (xs-plus m n) th = xs-plus m n
xp-subst-step (xs-plus-l a a2 b r) th = xs-plus-l (xp-subst th a) (xp-subst th a2) (xp-subst th b) (xp-subst-step r th)
xp-subst-step (xs-plus-r a b b2 r) th = xs-plus-r (xp-subst th a) (xp-subst th b) (xp-subst th b2) (xp-subst-step r th)
xp-subst-step (xs-pair-l a a2 b r) th = xs-pair-l (xp-subst th a) (xp-subst th a2) (xp-subst th b) (xp-subst-step r th)
xp-subst-step (xs-pair-r a b b2 r) th = xs-pair-r (xp-subst th a) (xp-subst th b) (xp-subst th b2) (xp-subst-step r th)
xp-subst-step (xs-fst-c p p2 r) th = xs-fst-c (xp-subst th p) (xp-subst th p2) (xp-subst-step r th)
xp-subst-step (xs-snd-c p p2 r) th = xs-snd-c (xp-subst th p) (xp-subst th p2) (xp-subst-step r th)
