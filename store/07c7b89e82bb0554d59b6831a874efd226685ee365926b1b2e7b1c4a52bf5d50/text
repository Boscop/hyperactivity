csa32-weight-ok : (a b c : Bool) →
  Path Word
    (%wadd (%wadd (b2w a) (b2w b)) (b2w c))
    (%wadd (b2w (aig-fa-sum a b c)) (%wmul #2 (b2w (aig-fa-cout a b c))))
csa32-weight-ok false false false = refl
csa32-weight-ok false false true  = refl
csa32-weight-ok false true  false = refl
csa32-weight-ok false true  true  = refl
csa32-weight-ok true  false false = refl
csa32-weight-ok true  false true  = refl
csa32-weight-ok true  true  false = refl
csa32-weight-ok true  true  true  = refl
