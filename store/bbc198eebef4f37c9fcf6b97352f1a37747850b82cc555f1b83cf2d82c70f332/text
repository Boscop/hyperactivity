fwd-fst : {V : Type} → (x dx : V → Nat) → (c : Circ A0 A1 A2 V) →
  fst (fold fwd-alg (fwd-env x dx) c) ≡ fold val-alg x c
fwd-fst x dx (cwire v) = refl
fwd-fst x dx (cop0 c) = fwd-fst-0 c
fwd-fst x dx (cop1 u a) = fwd-fst x dx a
fwd-fst x dx (cop2 b a d) =
  fwd-fst-2 b (fold fwd-alg (fwd-env x dx) a) (fold fwd-alg (fwd-env x dx) d)
    (fold val-alg x a) (fold val-alg x d) (fwd-fst x dx a) (fwd-fst x dx d)
