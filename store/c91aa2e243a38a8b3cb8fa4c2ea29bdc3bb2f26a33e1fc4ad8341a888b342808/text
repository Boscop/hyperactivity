nk-infer-br-fields : (NkTm → Word → NkTm → NkTm → NkTm) → NkTm → NkTm → Word → Word → NkTm → NkTm → NkTm → NkTm → NkTm → NkTm
nk-infer-br-fields chk kdefs curCtx curN n0 dummyTy recsOrig (nk-cons rf rr) curCtorTy br =
  if nk-is-lam br
    then let cnf = nk-norm-in-s kdefs curCtx curN curCtorTy
         in if nk-con-is cnf #1
              then let dom = nk-nth (nk-args cnf) #0
                       cod = nk-nth (nk-args cnf) #1
                       c2 = nk-ext-s kdefs curCtx curN dom
                       v = nk-free curN
                   in nk-infer-br-fields chk kdefs c2 (%wsucc curN) n0 dummyTy recsOrig rr (nk-app cod v) (nk-subst (nk-lam-body br) #0 v)
              else nk-fail
    else nk-fail
nk-infer-br-fields chk kdefs curCtx curN n0 dummyTy recsOrig rrem curCtorTy br =
  nk-infer-skip-ihs chk kdefs curCtx curN n0 dummyTy recsOrig br
