nk-plan-pair : Bool → NkVal → NkOp → Word → Word → NkSlots → NkOut
nk-plan-pair true (nkv-ref w) o u n sl = nk-plan-read (nk-get sl w) o u n
nk-plan-pair true (nkv-lam b e) o u n sl = nk-plan-rule o (nkv-lam b e) u n
nk-plan-pair true (nkv-num m) o u n sl = nk-plan-rule o (nkv-num m) u n
nk-plan-pair true (nkv-var x) o u n sl = nk-plan-rule o (nkv-var x) u n
nk-plan-pair true (nkv-napp f a) o u n sl = nk-plan-rule o (nkv-napp f a) u n
nk-plan-pair true (nkv-ninc a) o u n sl = nk-plan-rule o (nkv-ninc a) u n
nk-plan-pair false v o u n sl = nk-plan-rule o v u n
