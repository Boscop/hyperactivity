-- THEOREM 3 (FOUNDER COINBASE `0x4A50...A26f` & WORLD-RECORD HASH HARDCODED IN RUNTIME BY `refl`):
lc-thm-founder-immutable-in-pouw :
  let v20 = eth-from-hex "d480610563fcd40334d1b7587842bcff60f17f18"
      rt  = lc-pouw-runtime v20
  in andB (h-infix eth-founder-coinbase-addr20 rt)
     (andB (h-infix lc-world-record-commit32 rt)
           (%wlt #200 (fromNat (list-length rt)))) ≡ true
lc-thm-founder-immutable-in-pouw = refl
