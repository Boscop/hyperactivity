-- scores: (line, score) ascending by line; a word's lines added at its weight, by merging
c-merge-f : Nat → Word → List (Word × Word) → List Word → List (Word × Word)
c-merge-f zero wt acc ls = acc
c-merge-f (suc f) wt nil nil = nil
c-merge-f (suc f) wt nil (cons l r) = cons (l , wt) (c-merge-f f wt nil r)
c-merge-f (suc f) wt (cons a as) nil = cons a as
c-merge-f (suc f) wt (cons a as) (cons l r) =
  if weq (fst a) l then cons (l , wadd (snd a) wt) (c-merge-f f wt as r)
  else if wlt (fst a) l then cons a (c-merge-f f wt as (cons l r))
  else cons (l , wt) (c-merge-f f wt (cons a as) r)
