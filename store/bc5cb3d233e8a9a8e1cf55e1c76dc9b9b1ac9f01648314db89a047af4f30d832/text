-- the start is sound: 4pN + c − 1 − (1+σ)² ≥ 0
rad-start-ok : List Bool → IV → IV → IV → Nat → Bool
rad-start-ok S p sig c N = bz-nonpos (bz-neg (fst (iv-sub (iv-add (iv-mul S (iv-add (iv-add p p) (iv-add p p)) (iv-int S N)) (iv-sub c (iv-int S 1)))
  (iv-mul S (iv-add (iv-int S 1) sig) (iv-add (iv-int S 1) sig)))))
