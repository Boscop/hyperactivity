-- the closed form against Racah's sum: same sign, same square
amp-is : Amp → CG → Bool
amp-is x k = if bin-null (fst (snd x)) then bin-null (bin-of-nat (fst (snd k)))
  else (if bit-eq (fst x) (fst k) then bin-eq (bin-mul (fst (snd x)) (bin-of-nat (snd (snd k)))) (bin-mul (bin-of-nat (fst (snd k))) (snd (snd x))) else false)
