-- riml_size: from linear_memory.sail (it calls what is defined after it there)
-- (part of language-support)
riml_size : (nbytes : ZI) → (addr : Bits #48) → (r_x : Text) → MS (Bits #64)
riml_size nbytes addr r_x =
  λ σ →
    if (z-eq nbytes (zpos #1)) then
      the (MS (Bits #64))
        (bindS {Bits #8} {Bits #64} (riml08 addr r_x) (λ t'1 →
           retS {Bits #64} (bv-sext #8 #64 t'1))) σ
    else if (z-eq nbytes (zpos #2)) then
      the (MS (Bits #64))
        (bindS {Bits #16} {Bits #64} (riml16 addr r_x) (λ t'2 →
           retS {Bits #64} (bv-sext #16 #64 t'2))) σ
    else if (z-eq nbytes (zpos #4)) then
      the (MS (Bits #64))
        (bindS {Bits #32} {Bits #64} (riml32 addr r_x) (λ t'3 →
           retS {Bits #64} (bv-sext #32 #64 t'3))) σ
    else if (z-eq nbytes (zpos #8)) then
      the (MS (Bits #64))
        (riml64 addr r_x) σ
    else
      the (MS (Bits #64))
        (liftS {Bits #64} (x86_model_error {Bits #64} #2110525671491798399589)) σ
