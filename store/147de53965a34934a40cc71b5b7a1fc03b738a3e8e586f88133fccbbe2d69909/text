sg-head-app : Lst (List Word) → Code → NkSexp → Lst Code → Code
sg-head-app env hc h ac =
  let s = sg-sym-str h
      c = sg-whd s
      r = sg-wtl s
      dp = nk-split-dot r
  in if sg-in-env s env then nk-capp-all hc ac
     else if andB (sg-is-sym h) (andB (%weq c #68) (%weq (nk-wlist-len r) #64)) then cdata (nk-key60 r) ac
     else if andB (sg-is-sym h) (andB (%weq c #67) (%weq (nk-wlist-len (fst dp)) #64))
       then ccon (nk-key60 (fst dp)) (nk-dec-val #0 (snd dp)) ac lnil
       else nk-capp-all hc ac
