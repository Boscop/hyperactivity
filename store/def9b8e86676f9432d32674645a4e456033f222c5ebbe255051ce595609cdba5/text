-- Universal Pass 1a: motif factoring (de Bruijn DAG)
expand-motif-cell : List MTerm → MTerm → List MTerm
expand-motif-cell pat mempty = cons mempty nil
expand-motif-cell pat (mlit a) = cons (mlit a) nil
expand-motif-cell pat (mref k) = %welimP (λ _ → List MTerm) k pat (λ n _ → cons (mref n) nil)
expand-motif-cell pat (mapp tid arg) = cons (mapp tid (mterm-subst-ref (mterm-pack-list pat) arg)) nil
expand-motif-cell pat (mcat l r) = cons (mcat (mterm-subst-ref (mterm-pack-list pat) l) (mterm-subst-ref (mterm-pack-list pat) r)) nil
