po-karatsuba-cand : RProg
po-karatsuba-cand =
  rprog #4
    (cons (#4 , re-mul (re-v #0) (re-v #2))
    (cons (#5 , re-mul (re-v #1) (re-v #3))
    (cons (#6 , re-mul (re-add (re-v #0) (re-v #1)) (re-add (re-v #2) (re-v #3))) nil)))
    (cons (re-v #4)
    (cons (re-sub (re-sub (re-v #6) (re-v #4)) (re-v #5))
    (cons (re-v #5) nil)))
