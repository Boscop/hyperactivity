cmp-00-t : (t y : Bool) → cmpN t (plus (bitn true) (times 2 zero)) (plus (bitn y) (times 2 zero)) ≡ (if bit-eq true y then t else y)
cmp-00-t t y = case y return λ v → cmpN t (plus (bitn true) (times 2 zero)) (plus (bitn v) (times 2 zero)) ≡ (if bit-eq true v then t else v) of
  true → λ i → t
  false → λ i → false
