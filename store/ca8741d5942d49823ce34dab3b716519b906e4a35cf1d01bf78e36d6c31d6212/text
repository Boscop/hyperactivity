hh-doc-of : List Word → List Word
hh-doc-of p =
  if cli-eq p "/" then "docs/home.html"
  else if cli-eq p "/learn" then "docs/learn.html"
  else if cli-eq p "/hyperfactor" then "docs/hyperfactor.html"
  else if cli-eq p "/decentralized" then "docs/decentralized.html"
  else if cli-eq p "/pouw" then "docs/decentralized.html"
  else if cli-eq p "/silicon" then "docs/silicon.html"
  else if cli-eq p "/ai" then "docs/ai.html"
  else if cli-eq p "/physics" then "docs/physics.html"
  else if cli-eq p "/neuro" then "docs/neuro.html"
  else if cli-eq p "/ide" then "docs/kernel.html"
  else if cli-eq p "/kg" then "docs/kg.html"
  else if cli-eq p "/nets" then "docs/nets.html"
  else if cli-eq p "/pdf" then "docs/pdf-viewer.html"
  else if cli-eq p "/monograph" then "docs/pdf-viewer.html"
  else if cli-eq p "/api/kg/index" then "docs/kg-index.json"
  else nil
