-- exponents of μ over rad-primes, for the values the hop meets
mu-exps : SQ → List Nat
mu-exps mu = if sq-eq mu (sq-nat 3) then cons 0 (cons 1 (cons 0 nil)) else (if sq-eq mu (sq-nat 8) then cons 3 (cons 0 (cons 0 nil))
  else (if sq-eq mu (sq-nat 48) then cons 4 (cons 1 (cons 0 nil)) else (if sq-eq mu (sq-nat 75) then cons 0 (cons 1 (cons 2 nil))
  else (if sq-eq mu (sq-nat 128) then cons 7 (cons 0 (cons 0 nil)) else cons 99 (cons 99 (cons 99 nil))))))
