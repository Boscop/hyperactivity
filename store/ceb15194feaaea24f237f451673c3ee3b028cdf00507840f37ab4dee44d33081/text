nk-get-del-at : (b : Bool) (y w x : Word) (t : NkSlot) (r : NkSlots) → (%weq y w ≡ b) → (%weq w x ≡ false) → (nk-get (nk-del r w) x ≡ nk-get r x) → nk-get (if b then r else nksl-cons y t (nk-del r w)) x ≡ nk-get (nksl-cons y t r) x
nk-get-del-at true y w x t r p q ih = sym (cong (λ c → if c then t else nk-get r x) (cong (λ z → %weq z x) (weq-sound y w p) ∙ q))
nk-get-del-at false y w x t r p q ih = cong (λ z → if %weq y x then t else z) ih
