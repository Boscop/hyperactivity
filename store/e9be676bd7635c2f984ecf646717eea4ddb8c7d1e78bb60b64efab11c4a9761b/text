times-suc-r : (a b : Nat) → times a (suc b) ≡ plus a (times a b)
times-suc-r zero b = refl
times-suc-r (suc a) b =
  congN suc
    (transN (congN (plus b) (times-suc-r a b))
      (transN (sym (plus-assoc b a (times a b)))
        (transN (congN (λ u → plus u (times a b)) (plus-comm b a))
          (plus-assoc a b (times a b)))))
