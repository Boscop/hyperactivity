cs-eval-args-mono : (ev : CsHeap → CsEnv → CsExp → CsRes) →
  ((hp1 : CsHeap) (env1 : CsEnv) (e : CsExp) → cs-res-mono hp1 (ev hp1 env1 e)) →
  (args : CsExp) (hp : CsHeap) (env : CsEnv) →
  cs-args-mono hp (cs-eval-args ev hp env args)
cs-eval-args-mono ev hev cse-args-nil hp env = cs-heap-ext-refl hp
cs-eval-args-mono ev hev (cse-fargs hd tl) hp env =
  cs-args-step-mono ev hp env (ev hp env hd) tl (hev hp env hd)
    (λ hp1 → cs-eval-args-mono ev hev tl hp1 env)
cs-eval-args-mono ev hev (cse-cargs hd tl) hp env =
  cs-args-step-mono ev hp env (ev hp env hd) tl (hev hp env hd)
    (λ hp1 → cs-eval-args-mono ev hev tl hp1 env)
cs-eval-args-mono ev hev cse-bad hp env = unit
cs-eval-args-mono ev hev (cse-var vid) hp env = unit
cs-eval-args-mono ev hev (cse-ull n) hp env = unit
cs-eval-args-mono ev hev (cse-add1 a) hp env = unit
cs-eval-args-mono ev hev (cse-bop j a b) hp env = unit
cs-eval-args-mono ev hev (cse-let d t b) hp env = unit
cs-eval-args-mono ev hev (cse-call fn args) hp env = unit
cs-eval-args-mono ev hev (cse-clo fn ar n args) hp env = unit
cs-eval-args-mono ev hev (cse-app f a) hp env = unit
cs-eval-args-mono ev hev (cse-pair a b) hp env = unit
cs-eval-args-mono ev hev (cse-fst p) hp env = unit
cs-eval-args-mono ev hev (cse-snd p) hp env = unit
cs-eval-args-mono ev hev (cse-con tag nf args) hp env = unit
cs-eval-args-mono ev hev (cse-switch d scrut brs) hp env = unit
cs-eval-args-mono ev hev (cse-for d bound init step) hp env = unit
cs-eval-args-mono ev hev cse-br-nil hp env = unit
cs-eval-args-mono ev hev (cse-br-cons tag d nf body rest) hp env = unit
