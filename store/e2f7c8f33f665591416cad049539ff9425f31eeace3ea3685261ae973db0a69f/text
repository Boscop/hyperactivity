nk-pick-apart : (e : NkEnv) (i : Word) (out : NkW) (fx : NkFx) (u : NkW) →
  (nk-emem u e ≡ false) → nk-apart u fx → nk-apart u (nk-pick e i out fx)
nk-pick-apart nke-nil i out fx u hm ap = ap
nk-pick-apart (nke-cons w r) i out fx u hm ap =
  let neq = nk-emem-not-eq u w (nke-cons w r) hm (nk-emem-hd w r)
      hmr = nk-emem-false-tl u w r hm
  in nk-pick-apart-at (%weq i #0) w r i out fx u neq
       (nk-era-env-apart r fx u hmr ap)
       (nk-pick-apart r (%wsub i #1) out fx u hmr ap)
