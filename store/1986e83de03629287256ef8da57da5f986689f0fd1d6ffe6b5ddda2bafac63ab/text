secp-det-nonce : Word → List Word → Word → Word
secp-det-nonce priv msgHash32 ctr =
  let material = list-append (eth-word-be32 priv)
                 (list-append msgHash32 (cons #69 (cons #84 (cons #72 (cons ctr nil)))))
      rawK     = h-be (keccak256 material)
  in %wadd #1 (%wmod rawK (%wsub secp-n #1))
