-- through the table, the records of token k on are the tokens from k
si-tab-at : (n : Nat) → (B : Bytes n) → (L : List (List Word)) → (p : Word) → (o : Word) → si-rep n B o L → si-tab n B p o L →
  (k : Word) → si-cons (si-drop k L) → si-rep n B (si-rd4 n B (si-slot p k)) (si-drop k L)
si-tab-at n B L = case L return λ w → (p : Word) → (o : Word) → si-rep n B o w → si-tab n B p o w → (k : Word) → si-cons (si-drop k w) → si-rep n B (si-rd4 n B (si-slot p k)) (si-drop k w) of
  nil → λ p o hr ht k hc → Empty-rec (subst {_} {_} {List (List Word)} {si-cons} (si-drop-nil {List Word} k) hc)
  cons y r → λ p o hr ht k → %welimP (λ v → si-cons (si-drop v (cons y r)) → si-rep n B (si-rd4 n B (si-slot p v)) (si-drop v (cons y r))) k
    (λ hc → si-tab-zero n B y r p o hr (fst ht))
    (λ m h hc → si-tab-suc n B y r p m (rec r (wadd p #4) (si-next n B o) (snd (snd hr)) (snd ht) m hc))
