kc-chi-loop : Nat → Word → List UInt64 → List UInt64
kc-chi-loop zero    idx b = nil
kc-chi-loop (suc n) idx b =
  let x   = %wmod idx #5
      row = %wmul #5 (%wdiv idx #5)
      b0  = kc-nth64 idx b
      b1  = kc-nth64 (%wadd row (%wmod (%wadd x #1) #5)) b
      b2  = kc-nth64 (%wadd row (%wmod (%wadd x #2) #5)) b
      v   = u64xor b0 (u64and (kc-not64 b1) b2)
  in cons v (kc-chi-loop n (%wadd idx #1) b)
