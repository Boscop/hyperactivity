-- ---------------------------------------------------------------- a run computed, as a run
-- k steps of stp from s each end in a value and start away from stop (decided by computing them)
run-ok : X86Step → Word → Word → X86 → Bool
run-ok stp stop k =
  %welimP (λ _ → X86 → Bool) k (λ s → true)
    (λ j h s → if weq (x86-rip s) stop then false else
       (case fst (stp s) return (λ _ → Bool) of
          out-val u → h (snd (stp s))
          out-throw e → false
          out-abort w → false))
