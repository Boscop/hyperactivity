os-sort : Nat → List (List Word × List Word) → List (List Word × List Word)
os-sort zero xs = xs
os-sort (suc f) nil = nil
os-sort (suc f) (cons x nil) = cons x nil
os-sort (suc f) (cons x (cons y r)) = os-merge (plus (list-length (cons x (cons y r))) (list-length (cons x (cons y r)))) (os-sort f (fst (os-halves (cons x (cons y r))))) (os-sort f (snd (os-halves (cons x (cons y r)))))
