sg-pat-sym : List Word → Lst NkSexp → Opt ((Word × Word) × Lst NkSexp)
sg-pat-sym nil _ = none
sg-pat-sym (cons c r) flds =
  if %weq c #67
    then (let sp = nk-split-dot r in
          if %weq (nk-wlist-len (fst sp)) #64
            then some ((nk-key60 (fst sp) , nk-dec-val #0 (snd sp)) , flds)
            else none)
    else none
