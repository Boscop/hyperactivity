si-tokens-below : (s : List (List Word)) → isTrue (si-tokens-ok s) → sq-below-all word-le #256 s
si-tokens-below s = case s return λ w → isTrue (si-tokens-ok w) → sq-below-all word-le #256 w of
  nil → λ h → unit
  cons y r → λ h → (si-bytes-below y (and-fst {si-bytes-ok y} {si-tokens-ok r} h) , rec r (and-snd {si-bytes-ok y} {si-tokens-ok r} h))
