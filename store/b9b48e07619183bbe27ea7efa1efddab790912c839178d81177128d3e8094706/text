-- a body. Variables by index into the environment, innermost first; nk-free a variable of an open
-- body; a constructor with its arguments; an eliminator, numbered, with the body it eliminates and
-- its other arguments; nk-nil and nk-cons the lists of arguments
data NkTm = nk-var (i : Word) | nk-free (x : Word) | nk-num (m : Word) | nk-lam (b : NkTm) | nk-con (c : Word) (as : NkTm) | nk-op (h : Word) (p : NkTm) (as : NkTm) | nk-nil | nk-cons (t : NkTm) (r : NkTm)
