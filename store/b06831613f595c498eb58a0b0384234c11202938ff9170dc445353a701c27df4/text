hy-piece-body : List Word → List (List Word) → List (List Word) → Sum Unit (List Word) → List Word
hy-piece-body stem ls p (inr t) = if h-eq (hy-last p) "r" then list-append "unlines " (hy-lines-term (hy-dt (h-split #10 t))) else hy-selection stem ls p
hy-piece-body stem ls p (inl u) = hy-selection stem ls p
