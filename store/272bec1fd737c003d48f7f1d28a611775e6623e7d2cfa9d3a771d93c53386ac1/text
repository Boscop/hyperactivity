it-all-fn : (A V : Type) → (neg : A → Bool) → (f : V → V → A) → (P : V → Type) → (ws : List V) → sy-all V P ws → sy-all V P (it-fn A V neg f ws)
it-all-fn A V neg f P ws = case ws return λ w → sy-all V P w → sy-all V P (it-fn A V neg f w) of
  nil → λ h → unit
  cons u ur → λ h → it-ifc V (neg (f u u)) u (it-fn A V neg f ur) (λ l → sy-all V P l) (λ e → (fst h , it-all-fn A V neg f P ur (snd h))) (it-all-fn A V neg f P ur (snd h))
