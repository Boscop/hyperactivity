toffoli-invol-raw : (a b c : Bool) → toffoli (toffoli (a , (b , c))) ≡ (a , (b , c))
toffoli-invol-raw false false false = λ _ → (false , (false , false))
toffoli-invol-raw false false true  = λ _ → (false , (false , true))
toffoli-invol-raw false true  false = λ _ → (false , (true  , false))
toffoli-invol-raw false true  true  = λ _ → (false , (true  , true))
toffoli-invol-raw true  false false = λ _ → (true  , (false , false))
toffoli-invol-raw true  false true  = λ _ → (true  , (false , true))
toffoli-invol-raw true  true  false = λ _ → (true  , (true  , false))
toffoli-invol-raw true  true  true  = λ _ → (true  , (true  , true))
