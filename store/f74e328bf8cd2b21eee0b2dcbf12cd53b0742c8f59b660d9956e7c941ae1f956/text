nk-pick-wf : (ins outs : NkEnv) (n0 n1 : NkW) (e : NkEnv) (i : Word) (out : NkW) (fx : NkFx) →
  (nk-env-in-set ins n0 n1 e ≡ true) → (nk-fx-wf ins outs n0 n1 fx ≡ true) →
  nk-fx-wf ins outs n0 n1 (nk-pick e i out fx) ≡ true
nk-pick-wf ins outs n0 n1 nke-nil i out fx he hf = hf
nk-pick-wf ins outs n0 n1 (nke-cons w r) i out fx he hf =
  let hw = nk-and-l (nk-in-set ins n0 n1 w) (nk-env-in-set ins n0 n1 r) he
      hr = nk-and-r (nk-in-set ins n0 n1 w) (nk-env-in-set ins n0 n1 r) he
  in nk-pick-wf-at (%weq i #0) ins outs n0 n1 w r i out fx hw
       (nk-era-env-wf ins outs n0 n1 r fx hr hf)
       (nk-pick-wf ins outs n0 n1 r (%wsub i #1) out fx hr hf)
