-- which forms an observation may identify: those that interconvert, and do so faster than the window
-- the observation takes. The window is data, so the identification is declared rather than
-- conventional — this is what InChI does to tautomers by fiat, and what the record cannot state when
-- it does.
ic-within : (A : Type 0) → Interconv A → Nat → A → A → Bool
ic-within A r w a b = case eqb (r a b) 0 of
  true → false
  false → leb (r a b) w
