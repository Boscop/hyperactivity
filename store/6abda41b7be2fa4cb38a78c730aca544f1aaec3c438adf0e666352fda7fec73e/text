-- (part of language-support)
rvm08 : (addr : Bits #48) → MS (Bits #8)
rvm08 addr =
  onS {Bool} {Bits #8} (canonical_address_p (bv-signed #48 addr)) (λ t'1 →
    λ σ →
      if t'1 then
        the (MS (Bits #8))
          (memi #64 (bv-zext #48 #64 addr)) σ
      else
        the (MS (Bits #8))
          (liftS {Bits #8} (x86_model_error {Bits #8} #491613139000)) σ)
