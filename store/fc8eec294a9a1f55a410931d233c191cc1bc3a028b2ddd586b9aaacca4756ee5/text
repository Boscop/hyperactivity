-- at one sequence: Z ≤ Z_2 and Z_3 = Z
fq-ok : Nat → Nat → List ((Nat × (Nat × (Nat × Nat))) × List Bool) → List ((Nat × (Nat × (Nat × Nat))) × List Bool) → List Nat → Bool
fq-ok s x h2 h3 h = if bin-leb (bin-of-nat (fd-ref s x 0 h)) (fq-z s x h2) then (if bin-leb (bin-of-nat (fd-ref s x 0 h)) (fq-z s x h3) then bin-leb (fq-z s x h3) (bin-of-nat (fd-ref s x 0 h)) else false) else false
