-- what a record is told its text was made from: the entries and the module, as hy-tip read them
-- (one word, the two separated by a space)
hy-follows-args : List (List Word) → List (List Word)
hy-follows-args (cons a (cons b r)) = cons "--follows" (cons a (cons "--base" (cons b nil)))
hy-follows-args (cons a nil) = cons "--follows" (cons a nil)
hy-follows-args nil = nil
