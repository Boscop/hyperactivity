-- ---------------------------------------------------------------- types
-- a type without its top-level qualifiers
cx-strip : CType → CType
cx-strip (ct-builtin b) = ct-builtin b
cx-strip (ct-pointer u) = ct-pointer u
cx-strip (ct-lref u) = ct-lref u
cx-strip (ct-rref u) = ct-rref u
cx-strip (ct-array u n) = ct-array u n
cx-strip (ct-record id) = ct-record id
cx-strip (ct-enum id) = ct-enum id
cx-strip (ct-function ret ps va cn vo rf ne) = ct-function ret ps va cn vo rf ne
cx-strip (ct-member-pointer cls u) = ct-member-pointer cls u
cx-strip (ct-qual cn vo rs u) = cx-strip u
cx-strip ct-nil = ct-nil
cx-strip (ct-cons x xs) = ct-cons x xs
