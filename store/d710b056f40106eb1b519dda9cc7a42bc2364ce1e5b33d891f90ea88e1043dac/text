-- every state the scheduler can reach within n transitions, and every end, is tso-state-ok
tso-sound-upto : Nat → List TsoThread → Bool
tso-sound-upto n ths =
  tso-fold (tso-choices ths #0)
    (λ c b → case c of sched-pick ths2 s → andB (tso-state-ok ths2 s) b)
    (λ e b → case e of
               tso-finished out s → andB (tso-state-ok ths s) b
               tso-blocked → b
               tso-nofuel s → andB (tso-state-ok ths s) b)
    (tso-sys n ths tso-init) true
