cs-switch-pre-dl : (d : Word) (tl : List Word) → cs-switch-pre d tl ≡ list-append (cs-switch-pre d nil) tl
cs-switch-pre-dl d tl =
  cs-dl-comp (list-append "({ uint64_t *p") (λ x → list-append (ce-dec d) (list-append " = (uint64_t *)" x))
    (cs-dl-lit "({ uint64_t *p")
    (cs-dl-comp (list-append (ce-dec d)) (list-append " = (uint64_t *)")
      (cs-dl-lit (ce-dec d)) (cs-dl-lit " = (uint64_t *)")) tl
