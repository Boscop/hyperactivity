-- (part of language-support)
vex_get_pp : (vex_prefixes' : vex_prefixes) → Bits #3
vex_get_pp vex_prefixes' =
  let m'1 : Bits #8
      m'1 = (vex_prefixes-byte0 vex_prefixes')
      t'2 : Bits #3
      t'2 =
        if (weq m'1 #197) then
          (bv-zext #2 #3 (vex2_byte1-pp (vex_prefixes-byte1 vex_prefixes')))
        else if (weq m'1 #196) then
          (bv-zext #2 #3 (vex3_byte2-pp (vex_prefixes-byte2 vex_prefixes')))
        else
          #7
  in t'2
