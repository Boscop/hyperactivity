grid-flatten-ok : (g : List (List Word)) → grid-unflatten (grid-flatten g) ≡ g
grid-flatten-ok g =
  case g return (λ u → grid-unflatten (grid-flatten u) ≡ u) of
    nil → λ i → nil
    cons row r →
      let sp : split-at-n (list-length row) (list-append row (snd (grid-flatten r))) ≡ (row , snd (grid-flatten r))
          sp = split-at-append row (snd (grid-flatten r))
      in concat {lzero} {List (List Word)}
           {let p = split-at-n (list-length row) (list-append row (snd (grid-flatten r))) in cons (fst p) (grid-unflatten-go (fst (grid-flatten r)) (snd p))}
           {cons row (grid-unflatten (grid-flatten r))} {cons row r}
           (λ i → cons (fst (sp i)) (grid-unflatten-go (fst (grid-flatten r)) (snd (sp i))))
           (λ i → cons row (rec r i))
