-- (quotient, remainder) of a by a non-zero b, at most f steps
poly-divmod : Nat → List SQ → List SQ → List SQ → List SQ × List SQ
poly-divmod f a b q = case f of
  zero → (q , a)
  suc g → (if leb (poly-len b) (poly-len a) then divmod-step a b q (sq-mul (poly-lead a) (sq-inv (poly-lead b))) (monus (poly-len a) (poly-len b)) (poly-divmod g) else (q , a))
