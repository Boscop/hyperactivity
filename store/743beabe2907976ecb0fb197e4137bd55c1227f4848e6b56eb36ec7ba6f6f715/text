-- Exact Kraft Equality for every complete binary prefix-free code tree: sum_i 2^(D - l_i) == 2^D
kraft-complete-eq : (D : Nat) → (t : PTree) → DepthOk D t → kraft-sum D t ≡ opt-pow2 D
kraft-complete-eq D pleaf _ = refl
kraft-complete-eq zero (pnode l r) e = Empty-rec e
kraft-complete-eq (suc k) (pnode l r) h =
  λ i → plus (kraft-complete-eq k l (fst h) i) (kraft-complete-eq k r (snd h) i)
