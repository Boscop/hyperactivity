-- in one text: how many places hold the selected context (q, e bytes), and what followed the first r of them
c-after-one : (n : Nat) → Bytes n → (k : Nat) → Bytes k → Word → Word → Word → List Word × Word → Proc W (Word × List (List Word))
c-after-one n q k f e best r x = if weq (snd x) best then bind (c-file (fst x) ".key") (λ t →
  c-after-places (fst x) (m-count n q k f e (list-length t) (text-bytes t)) (m-occ n q k f e r (list-length t) (text-bytes t)))
  else ret {lzero} {W} (#0 , nil)
