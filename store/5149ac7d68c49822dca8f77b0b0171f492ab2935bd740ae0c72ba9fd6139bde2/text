-- Tag classification: #1..#8 binding/special forms, #10..#37 pure value/op forms, #0 ordinary application
sg-tc-tag : List Word → Word
sg-tc-tag tag =
  if nk-wlist-eq tag "Pi" then #1
  else if nk-wlist-eq tag "Sigma" then #2
  else if nk-wlist-eq tag "lam" then #3
  else if nk-wlist-eq tag "plam" then #4
  else if nk-wlist-eq tag "forall" then #5
  else if nk-wlist-eq tag "let" then #6
  else if nk-wlist-eq tag "elim" then #7
  else if nk-wlist-eq tag "rec" then #8
  else if nk-wlist-eq tag "if" then #10
  else if nk-wlist-eq tag "%welimP" then #11
  else if nk-wlist-eq tag "U" then #12
  else if nk-wlist-eq tag "lsuc" then #13
  else if nk-wlist-eq tag "lmax" then #14
  else if nk-wlist-eq tag "PathP" then #15
  else if nk-wlist-eq tag "@" then #16
  else if nk-wlist-eq tag "~" then #17
  else if nk-wlist-eq tag "/\\" then #18
  else if nk-wlist-eq tag "\\/" then #19
  else if nk-wlist-eq tag "pair" then #20
  else if nk-wlist-eq tag "fst" then #21
  else if nk-wlist-eq tag "snd" then #22
  else if nk-wlist-eq tag "the" then #23
  else if nk-wlist-eq tag "%wsucc" then #24
  else if nk-wlist-eq tag "%weq" then #25
  else if nk-wlist-eq tag "%wlt" then #26
  else if nk-wlist-eq tag "%wadd" then #27
  else if nk-wlist-eq tag "%wmax" then #28
  else if nk-wlist-eq tag "%wsub" then #29
  else if nk-wlist-eq tag "%wmul" then #30
  else if nk-wlist-eq tag "%wdiv" then #31
  else if nk-wlist-eq tag "%wmod" then #32
  else if nk-wlist-eq tag "%wand" then #33
  else if nk-wlist-eq tag "%wor" then #34
  else if nk-wlist-eq tag "%wxor" then #35
  else if nk-wlist-eq tag "%wshl" then #36
  else if nk-wlist-eq tag "%wshr" then #37
  else #0
