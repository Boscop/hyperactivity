-- a map over padded vectors, given what it does to one
cl-map-pad : (A C : Type) → (z : A) → (g g2 : List A → C) → ((w : List A) → g (cons z w) ≡ g2 w) → (ws : List (List A)) →
  ln-map (List A) C g (ln-map (List A) (List A) (λ w → cons z w) ws) ≡ ln-map (List A) C g2 ws
cl-map-pad A C z g g2 h ws = case ws return λ xs → ln-map (List A) C g (ln-map (List A) (List A) (λ w → cons z w) xs) ≡ ln-map (List A) C g2 xs of
  nil → λ i → nil
  cons w rest → λ i → cons (h w i) (cl-map-pad A C z g g2 h rest i)
