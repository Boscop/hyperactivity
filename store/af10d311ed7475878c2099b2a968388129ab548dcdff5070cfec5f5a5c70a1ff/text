-- a module published: its text when the source holds it, else its removal, from the pointer kept.
-- Refused (changed on the server since, or not taken), the session takes the server's module instead
h-take-served : List Word → List Word → List Word → Sum Unit (List Word) → Proc W Unit
h-take-served m path refused r = bind (h-say (h-line (list-append path refused))) (λ u →
  if weq (h-status r) #200 then h-record-raw m path (h-body r) else h-unrecord-raw path)
