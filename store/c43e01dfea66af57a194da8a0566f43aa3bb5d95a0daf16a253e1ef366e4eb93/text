haar-unlift-tr : List Word → List Word → List Word → List Word
haar-unlift-tr nil _ acc = dw-rev acc nil
haar-unlift-tr (cons s sr) nil acc = haar-unlift-tr sr nil (cons (w32 s) acc)
haar-unlift-tr (cons s sr) (cons d dr) acc =
  let p = haar-unlift-pair (s , d)
  in haar-unlift-tr sr dr (cons (snd p) (cons (fst p) acc))
