-- Full 32-bit RV32I ALU (op: 0=ADD, 1=SUB, 2=AND, 3=OR, 4=XOR, 5=SLTU)
cir-alu32 : Word → Word → Word → Word
cir-alu32 op a b =
  if %weq op #0 then cir-add32 a b
  else if %weq op #1 then cir-sub32 a b
  else if %weq op #2 then %wand a b
  else if %weq op #3 then %wor a b
  else if %weq op #4 then %wxor a b
  else if %wlt (%wand a #4294967295) (%wand b #4294967295) then #1 else #0
