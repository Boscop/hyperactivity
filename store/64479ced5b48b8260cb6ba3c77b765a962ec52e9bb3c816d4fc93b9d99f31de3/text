rf-msg-gs : (conf : List KvWrite) → (idx : Word) → (app0 : List KvWrite) → (k : Word) → (from : Nat) → (m : KvMsg) →
            RfMsg conf (ph-get-send k) idx app0 from m → RfMsg conf (ph-get-wait k) idx app0 from m
rf-msg-gs conf idx app0 k from (m-put w2) h = h
rf-msg-gs conf idx app0 k from (m-ack w2) h = h
rf-msg-gs conf idx app0 k from (m-get k2 rid) h = (fst h , (λ e → Empty-rec (snd h e)))
rf-msg-gs conf idx app0 k from (m-val rid v) h =
  rf-from0-map (eqb from zero) (RfValOk conf (ph-get-send k) idx rid v) (RfValOk conf (ph-get-wait k) idx rid v) (λ x → (fst x , (λ e → Empty-rec (snd x e)))) h
