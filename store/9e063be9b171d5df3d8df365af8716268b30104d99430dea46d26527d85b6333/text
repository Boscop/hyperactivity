-- B_k for k from 0, n of them: cs are the coordinates of T^k E b_g in the attached vertex's kernel basis, tm
-- is T there; each is lifted, mapped back by R, and read at ds's free coordinates
b-mats : Nat → List Nat → List Nat → Rows → (List Nat → List Nat → SQ) → Rows → List Rows
b-mats n ds ds2 tm rent cs = case n of
  zero → nil
  suc g → cons (restrict (inv-free ds) (rows-map-entry rent (mons0 ds) (mons0 ds2) (lift-all (mons-count (mons0 ds2)) (inv-basis ds2) cs))) (b-mats g ds ds2 tm rent (rows-apply-all tm cs))
