-- THEOREM 3 (ALL 6 ISA MAGIC HEADERS & `lop3.b32` OPCODES VERIFIED COLD BY `refl`):
bn-thm-6isa-headers-valid :
  let elfX86  = the (List Word) (emit-elf64-x86 #11 bn-demo-inet)
      elfArm  = the (List Word) (emit-elf64-arm64 #11 bn-demo-inet)
      ptxUnop = the (List Word) (emit-ptx-sm90a false bn-demo-inet)
      wasmBin = the (List Word) (emit-wasm-inet bn-demo-inet)
      evmInit = the (List Word) (emit-evm-inet-initcode bn-demo-inet)
  in andB (h-eq (h-take (toNat #4) elfX86) (cons #127 (cons #69 (cons #76 (cons #70 nil)))))
     (andB (h-eq (h-take (toNat #4) elfArm) (cons #127 (cons #69 (cons #76 (cons #70 nil)))))
     (andB (h-infix "lop3.b32" ptxUnop)
     (andB (h-eq (h-take (toNat #4) wasmBin) (cons #0 (cons #97 (cons #115 (cons #109 nil)))))
           (%wlt #20 (fromNat (list-length evmInit)))))) ≡ true
bn-thm-6isa-headers-valid = refl
