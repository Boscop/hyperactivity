-- Σ over m2 = m ± 1 of the hop's squared amplitudes along branch x2, added to q
hop-branch-sq : List Bool × List Bool → List Bool → List Bool → List Bool → List Bool → List Bool → List Bool → List Bool → List Bool × List Bool
hop-branch-sq q x x2 v2 k kt w2 m = amp-sq-add (amp-sq-add q (hop-amp x x2 v2 k kt w2 m (bin-add m bin-one)))
  (if bin-null m then amp-zero else hop-amp x x2 v2 k kt w2 m (bin-sub m bin-one))
