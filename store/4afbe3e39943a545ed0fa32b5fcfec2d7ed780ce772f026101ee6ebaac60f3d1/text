-- a side of a system is its body on its face: the body with each variable the face fixes
-- replaced by the end it is fixed at; a face that is a join is one side for each of its cases
nk-sub-var : Word → Word → NkTm → NkTm → NkTm
nk-sub-var d i e (nk-var j) = if %weq j (%wadd i d) then e else nk-var j
nk-sub-var d i e (nk-lam b) = nk-lam (nk-sub-var (%wsucc d) i e b)
nk-sub-var d i e (nk-con c as) = nk-con c (nk-sub-var d i e as)
nk-sub-var d i e (nk-op h p as) = nk-op h (nk-sub-var d i e p) (nk-sub-var d i e as)
nk-sub-var d i e (nk-match h p cs) = nk-match h (nk-sub-var d i e p) (nk-sub-var d i e cs)
nk-sub-var d i e (nk-cons t r) = nk-cons (nk-sub-var d i e t) (nk-sub-var d i e r)
nk-sub-var d i e t = t
