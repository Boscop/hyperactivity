-- Exact Inverse Spectral Theorem for ALL dimensions N = 2^k: fwht(fwht(x)) = 2^k · x!
fwht-inv : (k : Nat) → (x : HVec k) → hvec-eq k (fwht k (fwht k x)) (hvec-scale-diag k x)
fwht-inv zero x = z-refl x
fwht-inv (suc k) x =
  let fu = fwht k (fst x)
      fv = fwht k (snd x)
      ffu = fwht k fu
      ffv = fwht k fv
      lin0 = fwht-add k fu fv
      lin1 = fwht-sub k fu fv
      stepL : hvec-eq k (hvec-add k (fwht k (hvec-add k fu fv)) (fwht k (hvec-sub k fu fv)))
                        (hvec-double k (hvec-scale-diag k (fst x)))
      stepL = hvec-eq-trans k
                (hvec-add k (fwht k (hvec-add k fu fv)) (fwht k (hvec-sub k fu fv)))
                (hvec-add k (hvec-add k ffu ffv) (hvec-sub k ffu ffv))
                (hvec-double k (hvec-scale-diag k (fst x)))
                (hvec-eq-path k
                  (hvec-add k (fwht k (hvec-add k fu fv)) (fwht k (hvec-sub k fu fv)))
                  (hvec-add k (hvec-add k ffu ffv) (hvec-sub k ffu ffv))
                  (λ i → hvec-add k (lin0 i) (lin1 i)))
                (hvec-eq-trans k
                  (hvec-add k (hvec-add k ffu ffv) (hvec-sub k ffu ffv))
                  (hvec-double k ffu)
                  (hvec-double k (hvec-scale-diag k (fst x)))
                  (hvec-b2-fst k ffu ffv)
                  (hvec-double-cong k ffu (hvec-scale-diag k (fst x)) (fwht-inv k (fst x))))
      stepR : hvec-eq k (hvec-sub k (fwht k (hvec-add k fu fv)) (fwht k (hvec-sub k fu fv)))
                        (hvec-double k (hvec-scale-diag k (snd x)))
      stepR = hvec-eq-trans k
                (hvec-sub k (fwht k (hvec-add k fu fv)) (fwht k (hvec-sub k fu fv)))
                (hvec-sub k (hvec-add k ffu ffv) (hvec-sub k ffu ffv))
                (hvec-double k (hvec-scale-diag k (snd x)))
                (hvec-eq-path k
                  (hvec-sub k (fwht k (hvec-add k fu fv)) (fwht k (hvec-sub k fu fv)))
                  (hvec-sub k (hvec-add k ffu ffv) (hvec-sub k ffu ffv))
                  (λ i → hvec-sub k (lin0 i) (lin1 i)))
                (hvec-eq-trans k
                  (hvec-sub k (hvec-add k ffu ffv) (hvec-sub k ffu ffv))
                  (hvec-double k ffv)
                  (hvec-double k (hvec-scale-diag k (snd x)))
                  (hvec-b2-snd k ffu ffv)
                  (hvec-double-cong k ffv (hvec-scale-diag k (snd x)) (fwht-inv k (snd x))))
  in (stepL , stepR)
