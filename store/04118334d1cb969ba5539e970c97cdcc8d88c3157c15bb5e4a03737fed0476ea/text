-- Lift 1-cell boundary Δ_x to List (Bounded B)
diff-mod-go : (B : Word) → Bounded B → List (Bounded B) → List (Bounded B)
diff-mod-go B prev nil = nil
diff-mod-go B prev (cons x r) =
  cons (mdiff-val B (fst prev) (fst x) , mdiff-lt B (fst prev) (fst x) (snd prev) (snd x))
       (diff-mod-go B x r)
