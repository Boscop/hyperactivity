-- Float64 equality and order: true (0) when the condition holds and the operands are ordered
-- (ucomisd sets the parity flag for a NaN): set the condition and "not parity", and them, negate
x-fcmp : Word → Lst Word
x-fcmp cc = xcat6 i-movq-x0-rax i-movq-x1-rcx i-ucomisd (xb3 #15 cc #192) (l-app i-mov-cl-al (xb3 #15 cc-np #192)) (xcat3 i-and-al-cl (xb3 #15 #182 #192) (xb3 #131 #240 #1))
