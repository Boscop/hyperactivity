rr : (s : TyShape) → RRT s
rr s-bool = (rty-bool , rfy-bool , rfl-bool)
rr (s-fam f-pi a b) = (rty-fam f-pi a b (rr a) (rr b) , rfy-pi a b (rr a) (rr b) , rfl-pi a b (rr a) (rr b))
rr (s-fam f-sig a b) = (rty-fam f-sig a b (rr a) (rr b) , rfy-sig a b (rr a) (rr b) , rfl-sig a b (rr a) (rr b))
rr (s-path a) = (rty-path a (rr a) , rfy-path a (rr a) , rfl-path a (rr a))
