-- Master Constraint kernel theorem (converse): every H_v ψ = 0 implies M(ψ) = 0.
lqg-all-zero-implies-master : (xs : List Nat) → lqg-all-zero xs → lqg-sum xs ≡ zero
lqg-all-zero-implies-master nil u = λ i → zero
lqg-all-zero-implies-master (cons x rest) h =
  concat (λ i → plus (fst h i) (lqg-sum rest))
         (lqg-all-zero-implies-master rest (snd h))
