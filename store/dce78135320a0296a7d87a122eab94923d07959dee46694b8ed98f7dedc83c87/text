-- ---------------------------------------------------------------- 2. multi-hop greedy routing & soundness
-- Pick first neighbor in k-bucket strictly closer (under comparator closer : N → N → Bool) to target key
dht-closer-hop : {N : Type} → (N → Bool) → List N → Sum Unit N
dht-closer-hop isCloser nil = inl unit
dht-closer-hop isCloser (cons nb rest) =
  if isCloser nb then inr nb else dht-closer-hop isCloser rest
