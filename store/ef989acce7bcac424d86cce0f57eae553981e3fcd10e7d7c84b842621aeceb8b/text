-- (part of language-support)
rotate_left_int : (x' : ZI) → (width : ZI) → (places : ZI) → MF ZI
rotate_left_int x' width places =
  bindF {Unit} {ZI} (fl-assert {exception} (z-le (zpos #0) places) #149467514486126185021078021591788761400) (λ _ →
    let placesMod : ZI
        placesMod = (mod places width)
        low_num : ZI
        low_num = (z-sub width placesMod)
        xl : Bits (z-nat low_num)
        xl = (bv-of-int (z-nat low_num) x' #0)
        xh : Bits (z-nat placesMod)
        xh = (bv-of-int (z-nat placesMod) x' (z-nat low_num))
    in retF {ZI} (bv-unsigned (wadd (z-nat low_num) (z-nat placesMod)) (bv-append (z-nat low_num) (z-nat placesMod) xl xh)))
