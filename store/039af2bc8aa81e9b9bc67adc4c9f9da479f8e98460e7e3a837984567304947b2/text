-- may this request change the source: with a token, only a request carrying it via X-Token or
-- Authorization: Bearer (case-insensitive header names); with none, only when the server is not public
s-allowed : Bool → Sum Unit (List Word) → List Word → Bool
s-allowed pub (inl u) req = h-not pub
s-allowed pub (inr tok) req =
  andB (h-not (h-null tok))
    (orB (h-eq (um-header "x-token" req) tok)
         (h-eq (s-bearer-tok (um-header "authorization" req)) tok))
