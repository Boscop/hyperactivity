-- a paragraph longer than a chunk: its lines, packed up to a chunk each
w-pack-lines : List Word → List (List Word) → List (List Word)
w-pack-lines cur nil = if h-null cur then nil else cons cur nil
w-pack-lines cur (cons l r) =
  if h-null cur then w-pack-lines l r else
  if wlt w-chunk (wadd (w-len cur) (wadd #1 (w-len l))) then cons cur (w-pack-lines l r)
  else w-pack-lines (list-append cur (cons #10 l)) r
