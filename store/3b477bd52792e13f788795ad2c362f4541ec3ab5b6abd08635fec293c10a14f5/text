v-show-text : VEnv → List Word → List (List Word) → List Word
v-show-text env i stmt =
  let ks = v-look-list i (ve-ktab env) in
  let leaf = v-empty ks in
  let done = h-has i (ve-comp env) in
  let af = v-collect-list i (ve-aft env) in
  let bf = v-before-of env i in
  list-append (h-line (list-append i (list-append "  " (v-rels env i))))
  (list-append (h-line (list-append "  " (v-look-word i (ve-sents env))))
  (list-append (if leaf then h-line (list-append "  state: " (v-state-str env i)) else list-append (h-line (list-append "  served by: " (v-joined " " ks))) (if done then h-line "  state: resolved" else nil))
  (list-append (if done then h-line (v-witness-str env i) else nil)
  (list-append (v-context-lines env i (v-look-list i (ve-anc env)))
  (list-append (if v-empty af then nil else h-line (list-append "  after: " (v-joined " " af)))
  (list-append (if v-empty bf then nil else h-line (list-append "  before: " (v-joined " " bf)))
  (list-append (if v-empty stmt then h-line "  (no statement)" else v-wrap nil (v-words stmt)) (cons #10 nil))))))))
