-- `hyperactive delegate PEER_URL FILE.hypercubical`: dispatch an interaction-net reduction cut to a live peer
hy-delegate : List Word → List (List Word) → Proc W Unit
hy-delegate m (cons url (cons file rs)) =
  bind (h-env "HYPERACTIVE_TOKEN") (λ tok →
  bind (h-capture (cons "/usr/bin/env" (cons "curl" (cons "-fsS" (hy-tok-args tok (cons "-X" (cons "POST" (cons "--data-binary" (cons (list-append "@" file) (cons (list-append url "/peer/reduce") nil)))))))))) (λ r →
  if weq (fst r) #0 then h-out (h-line (snd r))
  else h-fail (list-append "hyperactive delegate: remote cut failed on " url)))
hy-delegate m l = h-fail "hyperactive delegate PEER_URL FILE.hypercubical"
