v-tree-from : VEnv → Nat → Nat → List Word → List Word → List Word
v-tree-from env zero d via n = nil
v-tree-from env (suc k) d via n =
  list-append (v-tree-line env d via n)
    (h-concat (list-map (λ c → v-tree-from env k (suc d) n c)
      (v-filter (λ c → h-eq (v-head (v-look-list c (ve-ptab env))) n) (v-look-list n (ve-ktab env)))))
