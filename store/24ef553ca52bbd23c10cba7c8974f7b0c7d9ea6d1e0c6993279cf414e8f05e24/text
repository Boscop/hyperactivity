drop-keys : (f : List (List Word) → Word) → (h : Nat) → (t : List (List Word)) → (r : List Word) → r ≡ list-map f (sufs t) → drop-n h r ≡ list-map f (sufs (drop-n h t))
drop-keys f h t r e = tr (drop-n h (list-map f (sufs t))) (λ i → drop-n h (e i)) (tr (list-map f (drop-n h (sufs t))) (drop-map f h (sufs t)) (λ i → list-map f (drop-sufs h t i)))
