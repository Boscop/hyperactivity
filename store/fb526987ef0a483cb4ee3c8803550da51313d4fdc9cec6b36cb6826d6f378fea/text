runs-cat : (stp : X86Step) → (stop k1 k2 : Word) → (s s1 s2 : X86) → Runs stp stop k1 s s1 → Runs stp stop k2 s1 s2 → Runs stp stop (%wadd k2 k1) s s2
runs-cat stp stop k1 k2 =
  %welimP (λ v → (s s1 s2 : X86) → Runs stp stop v s s1 → Runs stp stop k2 s1 s2 → Runs stp stop (%wadd k2 v) s s2) k1
    (λ s s1 s2 p r2 → subst {lzero} {lzero} {X86} {λ x → Runs stp stop k2 x s2} (sym p) r2)
    (λ j ih → runs-cat-step stp stop k2 j ih)
