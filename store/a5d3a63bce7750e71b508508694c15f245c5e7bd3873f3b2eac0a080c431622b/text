opt-le-trans : (a b c : Nat) → leB a b ≡ true → leB b c ≡ true → leB a c ≡ true
opt-le-trans zero b c _ _ = refl
opt-le-trans (suc a') zero c hab _ = Empty-rec (opt-true-neq-false (sym hab))
opt-le-trans (suc a') (suc b') zero _ hbc = Empty-rec (opt-true-neq-false (sym hbc))
opt-le-trans (suc a') (suc b') (suc c') hab hbc = opt-le-trans a' b' c' hab hbc
