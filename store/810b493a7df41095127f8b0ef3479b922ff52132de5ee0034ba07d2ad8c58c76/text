-- the alignment of two texts along their longest common subsequence: each word kept (=), only in the
-- first (-) or only in the second (+)
hi-align : List (List Word) → List (List Word) → List (List Nat) → List (List Word × List Word)
hi-align nil b t = list-map (λ w → ("+" , w)) b
hi-align (cons x as) nil t = list-map (λ w → ("-" , w)) (cons x as)
hi-align (cons x as) (cons y bs) t = if h-eq x y then cons ("=" , x) (hi-align as bs (list-map hi-tl (hi-tl-rows t)))
  else if wlt (fromNat (hi-hd (hi-hd-row (hi-tl-rows t)))) (fromNat (hi-hd (hi-tl (hi-hd-row t)))) then cons ("+" , y) (hi-align (cons x as) bs (list-map hi-tl t))
  else cons ("-" , x) (hi-align as (cons y bs) (hi-tl-rows t))
