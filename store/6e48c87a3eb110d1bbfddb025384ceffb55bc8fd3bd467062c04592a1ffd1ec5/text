-- (typed: the solutions so far, added to; a guess to redo or an elaboration passes up)
lam-arg hs A B a sg =
  case a of
    tlam nm b V →
      (case %view A of
         wpi A1 B1 →
           (case hole-of hs A1 of
              some k → typed sg
              none →
                let x = %var nm A1
                in case infer (b x A1) of
                     typed Tb → typed (vmatch hs (B1 x) Tb sg)
                     elab ds → elab ds
                     redo k → redo k
                     _ → typed sg)
         _ → typed sg)
    -- a line where a path is due: its ends against the path type's
    tplam nm b V →
      (case %view A of
         wpath L a0 a1 → typed (vmatch hs a1 (V @ 1) (vmatch hs a0 (V @ 0) sg))
         _ → typed sg)
    _ → typed sg
