-- ============================================================================
-- SECTION 1: STRING / INVARIANT PRIMITIVES (0 POSTULATES)
-- ============================================================================

usf-ln : List Word → List Word → List Word
usf-ln s rest = list-append s (cons #10 rest)

usf-syn-pairs : List (List Word × List Word) → List Word
usf-syn-pairs nil = nil
usf-syn-pairs (cons kv rest) =
  let entry = h-concat (cons "'" (cons (fst kv) (cons "':'" (cons (snd kv) (cons "'" nil)))))
  in case rest of
       nil → entry
       cons y ys → h-concat (cons entry (cons "," (cons (usf-syn-pairs rest) nil)))

usf-has-backslash : List Word → Bool
usf-has-backslash nil = false
usf-has-backslash (cons c cs) = if weq c #92 then true else usf-has-backslash cs

usf-contains : List Word → List Word → Bool
usf-contains pat nil = h-null pat
usf-contains pat (cons x xs) =
  if h-prefix pat (cons x xs) then true else usf-contains pat xs

