nk-trim-susp-step-at : (used : Bool) (ins outs : NkEnv) (n0 nst w : NkW) (o2 : NkOut) →
  (nk-wire-le n0 nst ≡ true) → (nk-in-set ins n0 nst w ≡ true) →
  (nk-trim-susp-ok ins outs n0 nst o2 ≡ true) →
  nk-trim-susp-ok ins outs n0 nst
    (if used then nk-out (nk-fx o2) (nk-n o2) (nke-cons w (nk-ws o2))
     else nk-out (nkf-op w nko-era (nkf-val (nk-n o2) (nkv (hd-num #0) nke-nil) (nk-fx o2))) (nk-s (nk-n o2)) (nke-cons (nk-n o2) (nk-ws o2))) ≡ true
nk-trim-susp-step-at true ins outs n0 nst w o2 p0 hw ho2 = ho2
nk-trim-susp-step-at false ins outs n0 nst w o2 p0 hw ho2 =
  let n2 = nk-n o2
      sn2 = nk-s n2
      ple = nk-and-l (nk-wire-le nst n2) (nk-fx-wf ins outs n0 n2 (nk-fx o2)) ho2
      pfx = nk-and-r (nk-wire-le nst n2) (nk-fx-wf ins outs n0 n2 (nk-fx o2)) ho2
      ple_s = nk-wire-le-trans nst n2 sn2 ple (nk-wire-le-s n2)
      n0n2 = nk-wire-le-trans n0 nst n2 p0 ple
      hw_s = nk-in-set-up ins n0 nst sn2 w ple_s hw
      hn2 = nk-in-set-range outs n0 sn2 n2 (nk-in-range-self n0 n2 n0n2)
      pfx_s = nk-fx-wf-up ins outs n0 n2 sn2 (nk-fx o2) (nk-wire-le-s n2) pfx
  in nk-and-intro (nk-wire-le nst sn2) (nk-fx-wf ins outs n0 sn2 (nkf-op w nko-era (nkf-val n2 (nkv (hd-num #0) nke-nil) (nk-fx o2))))
       ple_s
       (nk-and-intro (nk-in-set ins n0 sn2 w) (nk-fx-wf ins outs n0 sn2 (nkf-val n2 (nkv (hd-num #0) nke-nil) (nk-fx o2)))
         hw_s
         (nk-and-intro (nk-in-set outs n0 sn2 n2) (nk-fx-wf ins outs n0 sn2 (nk-fx o2)) hn2 pfx_s))
