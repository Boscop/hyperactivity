v-tree-line : Nat → List Word → List Word → List Word
v-tree-line d via n =
  list-append (v-indent d) (list-append (v-sentence n) (list-append "  [" (list-append n
  (list-append (if v-leaf n then (if h-has n v-in-progress then ", in progress]" else if v-done n then ", resolved]" else if v-open-leaf n then "]" else ", not needed]")
               else if v-done n then ", resolved]" else list-append "; " (list-append (h-decimal (fromNat (list-length (v-filter v-open-leaf (v-under n))))) " open tasks under it]"))
  (h-line (if andB (h-not (h-null via)) (h-not (h-null (h-concat (v-also n via))))
           then list-append "  (also " (list-append (v-joined ", " (v-also n via)) ")") else nil))))))
