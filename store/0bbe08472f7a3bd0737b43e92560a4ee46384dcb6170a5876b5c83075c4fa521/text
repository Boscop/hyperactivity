bn-extract-x402-json : List Word → List Word
bn-extract-x402-json httpRaw =
  let h1 = h-after "payment-required: " httpRaw
      h2 = if h-null h1 then h-after "PAYMENT-REQUIRED: " httpRaw else h1
      ln = h-before (cons #13 nil) (h-before bn-nl h2)
      dc = bn-base64-dec ln
  in if h-null dc then httpRaw else dc
