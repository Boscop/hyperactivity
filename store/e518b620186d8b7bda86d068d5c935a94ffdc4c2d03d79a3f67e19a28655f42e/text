-- Symplectic inner product on 2-qubit Paulis: `<(x1,z1,x2,z2), (x1',z1',x2',z2')> = x1 z1' ⊕ z1 x1' ⊕ x2 z2' ⊕ z2 x2'`
symp2-ip : Symp2 → Symp2 → Bool
symp2-ip a b =
  xor4 (andB (fst a) (fst (snd b)))
       (andB (fst (snd a)) (fst b))
       (andB (fst (snd (snd a))) (snd (snd (snd b))))
       (andB (snd (snd (snd a))) (fst (snd (snd b))))
