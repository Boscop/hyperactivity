hmat-h5 : List Word → List Word
hmat-h5 tail =
  hw-ln "  [eB setComputePipelineState:pBnB];"
  (hw-ln "  [eB setBuffer:bSE offset:0 atIndex:0]; [eB setBuffer:bPE offset:0 atIndex:1]; [eB setBuffer:bLB offset:0 atIndex:2];"
  (hw-ln "  [eB setBuffer:bBE offset:0 atIndex:3]; [eB setBuffer:bST offset:0 atIndex:4];"
  (hw-ln "  [eB dispatchThreads:MTLSizeMake(65536,1,1) threadsPerThreadgroup:MTLSizeMake(256,1,1)];"
  (hw-ln "  [eB endEncoding]; [cbB commit]; [cbB waitUntilCompleted];"
  (hw-ln "  double dtB = now_sec() - tb0;"
  (hw-ln "  int bestE = ((int*)bBE.contents)[0]; uint32_t* st = (uint32_t*)bST.contents;"
  (hw-ln (list-append "  printf(" (list-append hw-q (list-append "  Searched 16,777,216 conformations in %.2f ms (%.2f G-confs/s) | pruned=%u (%.1f%%) | eval=%u" (list-append hw-esc-n (list-append hw-q ",")))))
  (hw-ln "         dtB * 1e3, 16777216.0 / (dtB * 1e9), st[0], 100.0 * st[0] / 16777216.0, st[1]);"
  (hw-ln (list-append "  printf(" (list-append hw-q (list-append "  Certified Global Optimum: dG = %.3f kcal/mol | optimal 6-subsite code = 0x%06x" (list-append hw-esc-n (list-append hw-q ", bestE * 0.001, st[2]);")))))
  (hw-ln nil
  (hw-ln "  // 3. 32,768 PARALLEL GPU SE(3) PROTEIN BACKBONE FOLDING TRAJECTORIES (TRP-CAGE 1L2Y)"
  (hw-ln (list-append "  printf(" (list-append hw-q (list-append hw-esc-n (list-append "=== 3. GPU SE(3) BACKBONE FOLDER: 32,768 TRAJECTORIES OF TRP-CAGE (PDB 1L2Y, 20 RES) ===" (list-append hw-esc-n (list-append hw-q ");"))))))
  (hw-ln "  const uint32_t NT = 32768u, STEPS = 200u;"
  (hw-ln "  id<MTLBuffer> bOE = [dev newBufferWithLength:NT*4 options:MTLResourceStorageModeShared];"
  (hw-ln "  id<MTLBuffer> bOR = [dev newBufferWithLength:NT*4 options:MTLResourceStorageModeShared];"
  (hw-ln "  double tf0 = now_sec();"
  (hw-ln "  id<MTLCommandBuffer> cbF = [q commandBuffer]; id<MTLComputeCommandEncoder> eF = [cbF computeCommandEncoder];"
  (hw-ln "  [eF setComputePipelineState:pFld];"
  (hw-ln "  [eF setBuffer:bOE offset:0 atIndex:0]; [eF setBuffer:bOR offset:0 atIndex:1]; [eF setBytes:&STEPS length:4 atIndex:2];"
  (hw-ln "  [eF dispatchThreads:MTLSizeMake(NT,1,1) threadsPerThreadgroup:MTLSizeMake(256,1,1)];"
  (hw-ln "  [eF endEncoding]; [cbF commit]; [cbF waitUntilCompleted];"
  (hw-ln "  double dtF = now_sec() - tf0;"
  (hw-ln "  float* oe = (float*)bOE.contents; float* org = (float*)bOR.contents;"
  (hw-ln "  float minE = 1e9f, minRg = 99.0f; double avgE = 0.0;"
  (hw-ln "  for (uint32_t i = 0; i < NT; i++) { avgE += oe[i]; if (oe[i] < minE) { minE = oe[i]; minRg = org[i]; } }"
  (hw-ln "  double gpairs = ((double)NT * (double)STEPS * 171.0) / (dtF * 1e9);"
  (hw-ln (list-append "  printf(" (list-append hw-q (list-append "  32,768 SE(3) trajectories x 200 MC steps in %.2f ms (%.2f G-residue-pairs/s)" (list-append hw-esc-n (list-append hw-q ", dtF * 1e3, gpairs);")))))
  (hw-ln (list-append "  printf(" (list-append hw-q (list-append "  Best folded Trp-cage (1L2Y): E = %.2f kcal/mol | Rg = %.2f A (native ~7.0 A) | mean E = %.2f" (list-append hw-esc-n (list-append hw-q ", minE, minRg, avgE / NT);")))))
  (hw-ln "  return 0;"
  (hw-ln "} }" tail))))))))))))))))))))))))))))))
