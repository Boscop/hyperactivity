hxwav-unpack : List Word → List Word
hxwav-unpack blob =
  let rest = list-drop #4 blob
      hdr  = list-take-rev #44 rest nil
      body = list-drop #44 rest
      sLen = read-le32 body
      pay  = list-drop #4 body
      sEnc = list-take-rev sLen pay nil
      dEnc = list-drop sLen pay
      sDec = pcm-bytes-to-s16 (hxz-dec sEnc)
      dDec = pcm-bytes-to-s16 (hxz-dec dEnc)
      pcm  = s16-to-pcm-bytes (haar-unlift-list sDec dDec)
  in list-append hdr pcm
