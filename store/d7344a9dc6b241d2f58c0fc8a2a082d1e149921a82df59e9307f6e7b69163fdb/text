nk-rfl-s : Nat → NkTm → NkTm → Word → NkTm → NkTm → NkTm
nk-rfl-s zero kdefs ctx n t e = e
nk-rfl-s (suc k) kdefs ctx n (nk-con c (nk-cons a (nk-cons f r))) e =
  if %weq c #1
  then (let c2 = nk-cons (nk-ent a (nk-sub-forms (nk-cons (nk-ent a (nk-free n)) ctx) (%wsucc n) (nk-rfl-s k kdefs (nk-cons (nk-ent a (nk-free n)) ctx) (%wsucc n) a (nk-free n)))) ctx
        in nk-lam (nk-abs n #0 (nk-rfl-s k kdefs c2 (%wsucc n) (nk-norm-in-s kdefs c2 (%wsucc n) (nk-ap1 f (nk-free n))) (nk-app e (nk-free n)))))
  else (if %weq c #6 then nk-con #0 (nk-cons (nk-rfl-s k kdefs ctx n a (nk-op #9 e nk-nil)) (nk-cons (nk-rfl-s k kdefs ctx n (nk-norm-in-s kdefs ctx n (nk-ap1 f (nk-op #9 e nk-nil))) (nk-op #10 e nk-nil)) nk-nil))
  else (if %weq c #4
        then (let c2 = nk-cons (nk-ent (nk-con #5 nk-nil) (nk-free n)) ctx
              in nk-lam (nk-abs n #0 (nk-rfl-s k kdefs c2 (%wsucc n) (nk-norm-in-s kdefs c2 (%wsucc n) (nk-ap1 a (nk-free n))) (nk-op #8 (nk-free n) (nk-cons e (nk-cons f (nk-cons (nk-nth r #0) nk-nil)))))))
        else (if %weq c #7 then nk-glue (nk-sys (nk-eta-sides e (nk-args f))) (nk-rfl-s k kdefs ctx n a (nk-unglue f e)) else e)))
nk-rfl-s (suc k) kdefs ctx n t e = e
