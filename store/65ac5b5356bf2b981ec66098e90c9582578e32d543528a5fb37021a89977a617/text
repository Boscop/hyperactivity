dht-check-sound-res : {K V : Type} → (chk : K → V → Bool) → (k : K) → (r : Sum Unit V) → (v : V) →
  ca-check chk k r ≡ inr v → chk k v ≡ true
dht-check-sound-res chk k (inl u) v eq = Empty-rec (dn-inl≠inr eq)
dht-check-sound-res chk k (inr v0) v eq =
  dht-check-sound-bool chk (chk k v0) k v0 v (λ i → chk k v0) eq
