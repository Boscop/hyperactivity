rcpt-no-redelivery : (u : Nat) → (mvs : List RcptMove) → (s : RcptState) → cr-mem u (rcpt-delivered s) → rcpt-allowed-run mvs s → rcpt-delivers u mvs → Empty
rcpt-no-redelivery u nil s m h d = d
rcpt-no-redelivery u (cons mv r) s m h d = case d of
  inl e → rcpt-not-again u mv s m (fst h) e
  inr d2 → rcpt-no-redelivery u r (rcpt-move mv s) (rcpt-keeps u mv s m) (snd h) d2
