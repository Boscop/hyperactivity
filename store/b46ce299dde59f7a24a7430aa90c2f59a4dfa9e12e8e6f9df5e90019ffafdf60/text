nk-compile-datas : NkRawSig → Lst (Word × (Code × Lst Code)) → NkTm
nk-compile-datas rsig lnil = nk-nil
nk-compile-datas rsig (lcons e r) =
  let d = fst e
      cf = fst (snd e)
      cs = snd (snd e)
      np = nk-cpi-len cf
      go = nk-of-code-s (toNat #400) rsig
  in nk-cons (nk-con #57 (nk-cons (nk-num np) (nk-cons (go cf) (nk-cons (nk-data-hyps d np cs) (nk-cons (nk-map-tm go cs) nk-nil)))))
       (nk-compile-datas rsig r)
