hy-def : List Word → List (List Word) → Proc W Unit
hy-def st nil = ret unit
hy-def st (cons name r) = if h-ends ".cub" name
  then bind (h-source-text name) (λ s → if hy-held s
    then bind (hy-head-text st name) (λ t → bind (h-out (list-append (h-line (list-append name "   (its head)")) (cons #10 t))) (λ u → hy-def st r))
    else bind (h-read (list-append h-index (list-append "/alternatives/" (h-hex name)))) (λ a → bind (hy-def-alternatives name (h-lines (hy-or nil a))) (λ u → hy-def st r)))
  else if hy-document name then bind (h-source-text name) (λ t → if hy-held t
    then bind (hy-def-document name t) (λ u → hy-def st r)
    else bind (h-read (list-append h-index (list-append "/alternatives/" (h-hex name)))) (λ a → bind (hy-def-alternatives name (h-lines (hy-or nil a))) (λ u → hy-def st r)))
  else bind (hy-get st (list-append "written/" (h-hex name))) (λ w → bind (hy-def-written st name w) (λ u → hy-def st r))
