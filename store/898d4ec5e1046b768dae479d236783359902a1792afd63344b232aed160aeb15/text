sv-cmp : CmpOp → SK → SV → SV → MRes Bool
sv-cmp o k a b = case k of
  sk-int sg w → int-cmp o sg w a b
  sk-bool → mr-bind (sv-as-b a) (λ x → mr-bind (sv-as-b b) (λ y →
    mok (cmp-by o (u64eq (uq-b x) (uq-b y)) (u64lt (uq-b x) (uq-b y)) (u64lt (uq-b y) (uq-b x)))))
  sk-f32 → mr-bind (sv-as-f a) (λ x → mr-bind (sv-as-f b) (λ y → mok (f64-cmp o (f32-widen x) (f32-widen y))))
  sk-f64 → mr-bind (sv-as-d a) (λ x → mr-bind (sv-as-d b) (λ y → mok (f64-cmp o x y)))
  sk-ptr → mr-bind (sv-as-p a) (λ x → mr-bind (sv-as-p b) (λ y → ptr-cmp o x y))
