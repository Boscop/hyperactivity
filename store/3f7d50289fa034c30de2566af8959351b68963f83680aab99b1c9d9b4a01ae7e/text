rm-switch : RCx → ROperand → List RSwitchArm → Word → RFrame → REv RNext
rm-switch cx op arms other =
  sr-on (rm-opd-ty cx op) (λ e fr → rm-throw e) (λ ty →
  sr-on (cx-class cx ty) (λ e fr → rm-throw e) (λ c → case c of
    cl-scalar k →
      (let ev = rm-opd-rv cx op
           ch = rm-arms arms k other
       in λ fr → rm-bind (ev fr) (λ v → rm-bind (rm-as-s v) (λ x →
                 rm-bind (ch x) (λ bb → rm-ret (rn-goto fr bb)))))
    _ → λ fr → rm-throw (rx-unsupported (rz-switch-on ty))))
