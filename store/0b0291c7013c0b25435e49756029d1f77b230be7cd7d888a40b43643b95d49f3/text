-- curation preserves ValidCAStore: if a peer's local store is valid, its curated public port is valid
curate-valid-at : {K V : Type} → (chk : K → V → Bool) → (b : Bool) → (k : K) → (x : Sum Unit V) →
  ((v : V) → x ≡ inr v → chk k v ≡ true) → (v : V) → (if b then x else inl unit) ≡ inr v → chk k v ≡ true
curate-valid-at chk true k x hx v eq = hx v eq
curate-valid-at chk false k x hx v eq = Empty-rec (dn-inl≠inr eq)
