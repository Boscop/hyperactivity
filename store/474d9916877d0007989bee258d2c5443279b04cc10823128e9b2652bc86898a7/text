fs-tf : (c : Bool) → plus (bitn true) (times 2 (bitn false)) ≡ plus (bitn (bit-eq false c)) (plus (bitn false) (bitn c))
fs-tf c = case c return λ w → plus (bitn true) (times 2 (bitn false)) ≡ plus (bitn (bit-eq false w)) (plus (bitn false) (bitn w)) of
  true → λ i → suc zero
  false → λ i → suc zero
