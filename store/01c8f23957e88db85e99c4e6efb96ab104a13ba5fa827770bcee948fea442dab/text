-- THEOREM 1C (ACHROMATIC MULTI-WAVELENGTH DIAMOND TIR + `F_2` HYPERREFLECTION + KULISCH `Q24.24` BY `refl`):
dm-thm-achromatic-tir-and-hyperreflect :
  let u   = #5
      v   = #3
      w1  = #11
      w2  = #14
      lhs = %wxor (dm-f2-eval1 #0 #1 u v w1) (dm-f2-eval1 #0 #1 u v w2)
      rhs = dm-f2-eval1 #0 #1 u v (%wxor w1 w2)
      qA  = #16777216000001
      qB  = #1
      qC  = #99999999999999
  in andB (dm-tir-45deg #2380)
     (andB (dm-tir-45deg #2407)
     (andB (dm-tir-45deg #2465)
     (andB (%weq lhs rhs)
           (%weq (%wadd (%wadd qA qB) qC) (%wadd qA (%wadd qB qC)))))) ≡ true
dm-thm-achromatic-tir-and-hyperreflect = refl
