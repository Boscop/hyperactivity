hi-checked : Sum Unit (List Word) → Nat → List Word
hi-checked (inl u) k = nil
hi-checked (inr c) k = h-concat (cons " <span class='" (cons (if h-prefix "ok" c then "ok" else "no") (cons "'>" (cons (if h-prefix "ok" c then "checked" else s-esc (h-before (cons #10 nil) c)) (cons "</span> <span class='who'>bound " (cons (h-decimal (fromNat k)) (cons " times</span>" nil)))))))
