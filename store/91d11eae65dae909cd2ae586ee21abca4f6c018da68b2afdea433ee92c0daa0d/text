-- a ≤ b implies a + k ≤ b + k
cm-le-add-mono : (a b k : Word) → wlt b a ≡ false → wlt (wadd b k) (wadd a k) ≡ false
cm-le-add-mono a b k h =
  cm-catb (cm-symb (ltw≡wlt (wadd b k) (wadd a k)))
    (%welimP (λ v → ltw (wadd b v) (wadd a v) ≡ false) k
       (cm-catb (ltw≡wlt b a) h)
       (λ n ih → ih))
