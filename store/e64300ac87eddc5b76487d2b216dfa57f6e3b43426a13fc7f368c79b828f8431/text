-- D(z) as observed: n := read16le(b, 2) and t := read16le(b, 0) are the buffer's second and first
-- 16-bit fields; the three rows of appc-D (lib/frame-decoder.cub) on the observation
appcx-D : ByteMap → Word → Word → Bits #64 × Bits #64 × Bits #64 × Bits #64 × Bits #64
appcx-D mu buf s =
  if fd-ltb (toNat s) fd-four then (#0 , fst (appcx-frame0 mu buf s) , fst (snd (appcx-frame0 mu buf s)) , snd (snd (appcx-frame0 mu buf s)) , #4198400)
  else (if fd-ltb (fd-monus (toNat s) fd-four) (toNat (wand (wshr buf #16) #65535)) then (#0 , fst (appcx-frame0 mu buf s) , fst (snd (appcx-frame0 mu buf s)) , snd (snd (appcx-frame0 mu buf s)) , #4198400)
  else (#1 , wand buf #65535 , wand (wshr buf #16) #65535 , #5242884 , #4198400))
