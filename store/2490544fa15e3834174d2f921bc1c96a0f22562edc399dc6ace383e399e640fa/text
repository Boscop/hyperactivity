drop-sufs : (h : Nat) → (t : List (List Word)) → drop-n h (sufs t) ≡ sufs (drop-n h t)
drop-sufs h =
  case h return λ w → (t : List (List Word)) → drop-n w (sufs t) ≡ sufs (drop-n w t) of
    zero → λ t i → sufs t
    suc h1 → λ t → (case t return λ v → drop-n (suc h1) (sufs v) ≡ sufs (drop-n (suc h1) v) of nil → λ i → nil; cons x r → rec h1 r)
