-- bytes whose four checks hold (si-made-ok, decided when they are made) answer every query with the number
-- of the suffixes that start with it
si-query-ok : (T : List (List Word)) → (L : List Word) →
  isTrue (si-chk-chain (list-length L) (text-bytes L) #8 (si-o0 T) T) →
  isTrue (si-chk-tree (list-length L) (text-bytes L) (build (list-length (suffix-array-fast T)) (suffix-array-fast T)) (si-rd4 (list-length L) (text-bytes L) #0)) →
  isTrue (si-fuel (build (list-length (suffix-array-fast T)) (suffix-array-fast T)) (toNat (si-rd4 (list-length L) (text-bytes L) #4))) → isTrue (si-tokens-ok T) → (q : List (List Word)) → si-query L q ≡ fromNat (si-nstarts q (suffix-array T))
si-query-ok T L h1 h2 h3 h4 q =
  si-index-ok T (list-length L) (text-bytes L) #8 (si-o0 T) (si-rd4 (list-length L) (text-bytes L) #0) (list-length (suffix-array-fast T)) (toNat (si-rd4 (list-length L) (text-bytes L) #4))
    h1 h2 h3 h4 q
