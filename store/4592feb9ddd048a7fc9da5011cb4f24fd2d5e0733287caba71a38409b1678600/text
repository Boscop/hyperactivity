-- THEOREM 4: UNBOUNDED-HORIZON CBF FORWARD INVARIANCE OVER ALL TIME STEPS t : Nat!
-- If initial state is safe (safe_min <= h 0) and the CBF actuator filter enforces
-- non-degradation of the barrier floor at every transition, the system NEVER leaves the safe set!
cos-thm-cbf-forward-invariant : (safe-min : Nat) → (h : Nat → Nat) →
  hm-le safe-min (h zero) ≡ true →
  ((t : Nat) → hm-le (h t) (h (suc t)) ≡ true) →
  (t : Nat) → hm-le safe-min (h t) ≡ true
cos-thm-cbf-forward-invariant smin h h0 _    zero    = h0
cos-thm-cbf-forward-invariant smin h h0 step (suc t) =
  hm-le-trans smin (h t) (h (suc t)) (cos-thm-cbf-forward-invariant smin h h0 step t) (step t)
