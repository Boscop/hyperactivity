v-waiting-text : VEnv → List Word
v-waiting-text env =
  let ws = v-filter (λ x → h-not (v-empty (v-look-list x (ve-wtab env)))) (ve-leaves env) in
  if v-empty ws then nil else
  list-append (h-line "waiting:")
    (h-concat (list-map (λ x → list-append (v-line env x) (h-line (list-append "        waits on: " (v-joined " " (h-sort (v-look-list x (ve-wtab env))))))) ws))
