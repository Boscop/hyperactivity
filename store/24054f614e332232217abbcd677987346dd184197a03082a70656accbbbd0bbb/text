dn-ca-check-idem : {K V : Type} → (chk : K → V → Bool) → (k : K) → (x : Sum Unit V) →
  ((v : V) → x ≡ inr v → chk k v ≡ true) → ca-check chk k (ca-check chk k x) ≡ x
dn-ca-check-idem {K} {V} chk k (inl u) hx = cong inl (unit-eq-ca unit u)
dn-ca-check-idem {K} {V} chk k (inr v) hx =
  (λ j → ca-check {K} {V} chk k (if hx v (λ i → inr v) j then inr v else inl unit))
  ∙ ca-check-valid-at {K} {V} chk k (inr v) hx
