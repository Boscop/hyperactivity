-- 2. Ginzburg–Landau Free Energy & Spontaneous Symmetry Breaking SOS Certificate
-- ============================================================================
-- Free energy F(ψ) = -a |ψ|² + (β/2)|ψ|⁴ with |ψ|² = r² + i² (a > 0, β > 0).
-- Exact universal SOS identity:
--   2 β · (F(ψ) + a²/(2β)) = 2 β (-a p + (β/2) p²) + a² = (β p - a)² ≥ 0,  where p = r² + i².
-- Certifies exact global minimum at |ψ|² = a/β and condensation energy -a²/(2β).
-- Variables (0..3): a, β, r, im.
phys-gl-sos-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
phys-gl-sos-poly A ad mu q vs =
  (λ g sub sq →
    let a = g 0; bet = g 1; r = g 2; im = g 3
        q2 = q (fn-q 2 1)
        qhalf = q (fn-q 1 2)
        p = ad (sq r) (sq im)
        F = ad (sub (q (fn-q 0 1)) (mu a p)) (mu qhalf (mu bet (sq p)))
        lhs = ad (mu q2 (mu bet F)) (sq a)
        rhs = sq (sub (mu bet p) a)
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
