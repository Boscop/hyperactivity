ossc-tx-comp : OsTx → OsTx → OsTx
ossc-tx-comp f g e = f (g e)

ossc-tx-assoc : (f g h : OsTx) → (e : OsEffect) →
  ossc-tx-comp (ossc-tx-comp f g) h e ≡ ossc-tx-comp f (ossc-tx-comp g h) e
ossc-tx-assoc f g h e = refl

UiTx : Type
UiTx = UiNode → UiNode

ossc-ui-comp : UiTx → UiTx → UiTx
ossc-ui-comp f g u = f (g u)

