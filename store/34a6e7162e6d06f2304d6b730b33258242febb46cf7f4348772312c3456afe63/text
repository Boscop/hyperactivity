--     5: allreduce_gain(d) -> i32
-- ============================================================================

ossc-wf0 : List Word
ossc-wf0 =
  let locHdr = the (List Word) (cons #1 (cons #1 (cons #127 nil)))
      setDif = list-append (pw-bin #115 (pw-get #0) (pw-get #1)) (pw-set #2)
      negDif = pw-bin #107 (pw-c #0) (pw-get #2)
      lsb    = pw-bin #113 (pw-get #2) negDif
      res    = pw-bin #115 (pw-get #0) lsb
  in pw-cat (cons locHdr (cons setDif (cons res (cons (pw-op #11) nil))))

ossc-wf1 : List Word
ossc-wf1 =
  pw-cat (cons (cons #0 nil)
         (cons (pw-bin #115 (pw-get #0) (pw-get #1))
         (cons (pw-op #105)
         (cons (pw-op #11) nil))))

ossc-wf2 : List Word
ossc-wf2 =
  pw-cat (cons (cons #0 nil)
         (cons (pw-bin #116 (pw-c #1) (pw-get #0))
         (cons (pw-op #11) nil)))

ossc-wf3 : List Word
ossc-wf3 =
  pw-cat (cons (cons #0 nil)
         (cons (pw-bin #118 (pw-bin #108 (pw-get #0) (pw-c #3)) (pw-c #2))
         (cons (pw-op #11) nil)))

ossc-wf4 : List Word
ossc-wf4 =
  let locHdr = the (List Word) (cons #1 (cons #5 (cons #127 nil)))
      setA2  = list-append (pw-bin #108 (pw-get #0) (pw-get #0)) (pw-set #2)
      setB2  = list-append (pw-bin #108 (pw-get #1) (pw-get #1)) (pw-set #3)
      setC   = list-append (pw-bin #107 (pw-get #2) (pw-get #3)) (pw-set #4)
      setS   = list-append (pw-bin #108 (pw-c #2) (pw-bin #108 (pw-get #0) (pw-get #1))) (pw-set #5)
      setD   = list-append (pw-bin #106 (pw-get #2) (pw-get #3)) (pw-set #6)
      lhs    = pw-bin #106 (pw-bin #108 (pw-get #4) (pw-get #4)) (pw-bin #108 (pw-get #5) (pw-get #5))
      rhs    = pw-bin #108 (pw-get #6) (pw-get #6)
      diff   = pw-bin #107 lhs rhs
  in pw-cat (cons locHdr (cons setA2 (cons setB2 (cons setC (cons setS (cons setD (cons diff (cons (pw-op #11) nil))))))))

ossc-wf5 : List Word
ossc-wf5 =
  let num  = pw-bin #108 (pw-bin #116 (pw-c #1) (pw-get #0)) (pw-c #2)
      isZ  = list-append (pw-get #0) (pw-op #69)
      den  = pw-bin #114 (pw-get #0) isZ
      quot = pw-bin #110 num den
  in pw-cat (cons (cons #0 nil) (cons quot (cons (pw-op #11) nil)))

ossc-wasm-bytes : List Word
ossc-wasm-bytes =
  let hdr  = the (List Word) (cons #0 (cons #97 (cons #115 (cons #109 (cons #1 (cons #0 (cons #0 (cons #0 nil))))))))
      tSec = pw-sec #1 (the (List Word)
               (cons #2
               (cons #96 (cons #2 (cons #127 (cons #127 (cons #1 (cons #127
               (cons #96 (cons #1 (cons #127 (cons #1 (cons #127 nil)))))))))))))
      fSec = pw-sec #3 (the (List Word) (cons #6 (cons #0 (cons #0 (cons #1 (cons #1 (cons #0 (cons #1 nil))))))))
      eSec = pw-sec #7 (cons #6 (pw-cat (cons (pw-exp "dor_next" #0)
                                        (cons (pw-exp "dor_hamming" #1)
                                        (cons (pw-exp "cluster_nodes" #2)
                                        (cons (pw-exp "wire_48b_cost" #3)
                                        (cons (pw-exp "cayley_unitary_err" #4)
                                        (cons (pw-exp "allreduce_gain" #5) nil))))))))
      cSec = pw-sec #10 (cons #6 (pw-cat (cons (pw-wrap-fn ossc-wf0)
                                         (cons (pw-wrap-fn ossc-wf1)
                                         (cons (pw-wrap-fn ossc-wf2)
                                         (cons (pw-wrap-fn ossc-wf3)
                                         (cons (pw-wrap-fn ossc-wf4)
                                         (cons (pw-wrap-fn ossc-wf5) nil))))))))
  in pw-cat (cons hdr (cons tSec (cons fSec (cons eSec (cons cSec nil)))))

ossc-wasm-magic-cert : psc-wasm-magic-ok ossc-wasm-bytes ≡ true
ossc-wasm-magic-cert = refl

ossc-wasm-bytes-valid : all-byte-lt256 ossc-wasm-bytes ≡ true
