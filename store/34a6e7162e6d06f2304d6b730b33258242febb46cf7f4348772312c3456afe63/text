ossc-esc : List Word → List Word
ossc-esc nil = nil
ossc-esc (cons x r) =
  if %weq x #38 then list-append "&amp;" (ossc-esc r) else
  if %weq x #60 then list-append "&lt;" (ossc-esc r) else
  if %weq x #62 then list-append "&gt;" (ossc-esc r) else
  if %weq x #34 then list-append "&quot;" (ossc-esc r) else
  cons x (ossc-esc r)

