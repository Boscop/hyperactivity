-- ---------------------------------------------------------------- 8. self-delimiting byte framing, automatic discovery & end-to-end codecs
PFCodec : Type → Type
PFCodec A = (enc : A → List Word) × (dec : List Word → A × List Word) ×
            ((a : A) → (tail : List Word) → dec (list-append (enc a) tail) ≡ (a , tail))
