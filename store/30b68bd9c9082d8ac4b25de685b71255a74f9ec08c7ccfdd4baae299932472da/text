take-full : (h : Nat) → (s : List (List Word)) → ltn h (list-length s) ≡ false → take-n h s ≡ s
take-full h =
  case h return λ w → (s : List (List Word)) → ltn w (list-length s) ≡ false → take-n w s ≡ s of
    zero → λ s → (case s return λ v → ltn zero (list-length v) ≡ false → take-n zero v ≡ v of nil → λ e i → nil; cons x r → λ e → Empty-rec (true≢false e))
    suc h1 → λ s → (case s return λ v → ltn (suc h1) (list-length v) ≡ false → take-n (suc h1) v ≡ v of nil → λ e i → nil; cons x r → λ e i → cons x (rec h1 r e i))
