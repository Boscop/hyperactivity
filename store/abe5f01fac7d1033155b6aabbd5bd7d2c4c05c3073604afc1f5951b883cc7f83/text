cm-pos-w-gt0 : (c : Word) → wlt #0 (cm-pos-w c) ≡ true
cm-pos-w-gt0 c =
  ifP {λ b → wlt #0 (if b then #1 else c) ≡ true} {weq c #0}
    (λ _ i → true)
    (λ neq →
       %welimP (λ v → weq v #0 ≡ false → wlt #0 v ≡ true) c
         (λ h → cm-tf-absurd h)
         (λ n _ _ → cm-catb (cm-symb (ltw≡wlt #0 (%wsucc n))) (λ i → true))
         neq)
