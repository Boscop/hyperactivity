-- and the order of the bond to it: the carbonyl oxygen is double, the rest single, and the root has none
vln-ord : Vln → Bond
vln-ord x = case x of
  vl-c1 → bond-none
  vl-o1 → bond-double
  vl-o2 → bond-single
  vl-ho → bond-single
  vl-ca → bond-single
  vl-ha → bond-single
  vl-n → bond-single
  vl-hn1 → bond-single
  vl-hn2 → bond-single
  vl-cb → bond-single
  vl-hb → bond-single
  vl-cg1 → bond-single
  vl-g11 → bond-single
  vl-g12 → bond-single
  vl-g13 → bond-single
  vl-cg2 → bond-single
  vl-g21 → bond-single
  vl-g22 → bond-single
  vl-g23 → bond-single
