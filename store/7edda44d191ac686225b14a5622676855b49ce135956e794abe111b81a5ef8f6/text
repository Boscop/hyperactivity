xor4-linear : (a1 b1 c1 d1 a2 b2 c2 d2 : Bool) →
  xor4 (b-xor2 a1 a2) (b-xor2 b1 b2) (b-xor2 c1 c2) (b-xor2 d1 d2) ≡
  b-xor2 (xor4 a1 b1 c1 d1) (xor4 a2 b2 c2 d2)
xor4-linear a1 b1 c1 d1 a2 b2 c2 d2 =
  let pL = xor-swap4 a1 a2 b1 b2
      pR = xor-swap4 c1 c2 d1 d2
  in catB
       (b-xor2 (b-xor2 (b-xor2 a1 a2) (b-xor2 b1 b2)) (b-xor2 (b-xor2 c1 c2) (b-xor2 d1 d2)))
       (b-xor2 (b-xor2 (b-xor2 a1 b1) (b-xor2 a2 b2)) (b-xor2 (b-xor2 c1 d1) (b-xor2 c2 d2)))
       (b-xor2 (xor4 a1 b1 c1 d1) (xor4 a2 b2 c2 d2))
       (λ i → b-xor2 (pL i) (pR i))
       (xor-swap4 (b-xor2 a1 b1) (b-xor2 a2 b2) (b-xor2 c1 d1) (b-xor2 c2 d2))
