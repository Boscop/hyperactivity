-- Pack a 44-byte-header WAV into HXW1: "HXW1" + 44B header + u32(len(sEnc)) + sEnc + dEnc
hxwav-pack : List Word → List Word
hxwav-pack wav =
  let hdr    = list-take-rev #44 wav nil
      pcm    = list-drop #44 wav
      sams   = pcm-bytes-to-s16 pcm
      lifted = haar-lift-list sams
      sEnc   = hxz-enc (s16-to-pcm-bytes (fst lifted))
      dEnc   = hxz-enc (s16-to-pcm-bytes (snd lifted))
      sLen   = cli-len sEnc
  in list-append "HXW1" (list-append hdr (le32 sLen (list-append sEnc dEnc)))
