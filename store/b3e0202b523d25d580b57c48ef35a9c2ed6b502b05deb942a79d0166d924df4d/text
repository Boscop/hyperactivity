-- every term's roots are all candidates
terms-covered : List Cand → List STerm → Bool
terms-covered cs ts = case ts of
  nil → true
  cons t rest → (if eqb (cand-count (fst (fst (snd t))) cs) (m-deg (fst (fst (snd t)))) then (if eqb (cand-count (fst (fst (snd (snd t)))) cs) (m-deg (fst (fst (snd (snd t))))) then terms-covered cs rest else false) else false)
