-- the shapes of every constructor in order, or none when one is not covered
all-shapes : Word → Opt (Lst (Lst (Word × Word)))
all-shapes d =
  %welimP (λ _ → Opt (Lst (Lst (Word × Word)))) (data-nctors d) (some lnil)
    (λ i r → case data-shape d (%wsub (%wsub (data-nctors d) i) #1) return (λ _ → Opt (Lst (Lst (Word × Word)))) of
       none → none
       some ks → d-omap (λ rest → lcons ks rest) r)
