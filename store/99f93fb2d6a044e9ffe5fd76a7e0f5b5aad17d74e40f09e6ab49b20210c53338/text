rp-report : Word → List (List Word) → Proc W Unit
rp-report t0 ts =
  bind (h-out (h-line (list-append "tokens: " (h-decimal (fromNat (list-length ts)))))) (λ u →
  bind time-now (λ t1 →
  bind (h-out (h-line (list-append "read and tokenized: " (rp-ms t0 t1)))) (λ u1 →
  bind (ret (suffix-array-fast ts)) (λ sa →
  bind (h-out (h-line (list-append "suffixes in the array: " (h-decimal (fromNat (list-length sa)))))) (λ u2 →
  bind time-now (λ t2 →
  bind (h-out (h-line (list-append "suffix array by prefix doubling: " (rp-ms t1 t2)))) (λ u3 →
  bind (h-out (h-line (list-append "positions in a repeat (a common prefix with the next suffix): " (h-decimal (rp-nonzero (lcp-array sa)))))) (λ u4 →
  bind time-now (λ t3 →
  bind (h-out (h-line (list-append "LCP array: " (rp-ms t2 t3)))) (λ u5 → exit #0))))))))))
