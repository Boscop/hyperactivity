-- the paper's markdown as a page reads it: its front matter (between the first two "---" lines) and its HTML
-- comments left out; a heading keeps its anchor ({#id}), which s-h makes its id
s-after-front : List (List Word) → List (List Word)
s-after-front nil = nil
s-after-front (cons l r) = if h-eq l "---" then r else s-after-front r
