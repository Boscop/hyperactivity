hlz-main : List (List Word) → Step W Word
hlz-main args =
  let p = hlz-pref args
      mf = list-append p ".metal"
      cf = list-append p ".cu"
      hf = list-append p "_bench.m"
  in scmd w-now (λ t0 →
     scmd (w-file-write-named mf hlz-metal-src) (λ bm →
     scmd (w-file-write-named cf hlz-cuda-src) (λ bc →
     scmd (w-file-write-named hf (hlz-host-src mf)) (λ bh →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-LLMZip (TensorIR) emitted Metal=" (list-append (ce-dec bm) (list-append "B CUDA=" (list-append (ce-dec bc) (list-append "B Host=" (list-append (ce-dec bh) (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))))
       (sdone #0))))))
