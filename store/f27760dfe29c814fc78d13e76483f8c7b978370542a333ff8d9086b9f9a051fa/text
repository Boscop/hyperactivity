cf-dec-cons : Nat → List Word → CtxState → Word × Word → FTbl → (Word × List Word) → Word × (Word × List Word)
cf-dec-cons k excl st e r st0 =
  let ft = fiber-with-esc e r
      p = rans-dec-step ft (fst st0)
      tag = fst p
      s1 = snd p
  in if weq tag #0 then cf-dec-sym k (ftbl-add-syms (cons e r) excl) st (s1 , snd st0)
     else (wsub tag #1 , (s1 , snd st0))
