-- a·(b + c) = a·b + a·c
wmul-distl-step : (a b n : Word) → wmul a (wadd b n) ≡ wadd (wmul a b) (wmul a n) →
                  wmul a (wadd b (%wsucc n)) ≡ wadd (wmul a b) (wmul a (%wsucc n))
wmul-distl-step a b n h =
  catw (wmul-suc a (wadd b n))
    (catw (congw (λ z → wadd z a) h)
      (catw (wadd-assoc (wmul a b) (wmul a n) a) (congw (λ z → wadd (wmul a b) z) (symw (wmul-suc a n)))))
