-- an entry for the checker as a program: a number chooses a statement, the result is 1 if it
-- holds. 0: the univalence path is typed; 1: transport of (1, 2) along the path of the exchange
-- is (2, 1); 2: the exchange is an equivalence; 3: a line by composition in the universe is a
-- path to U (it is not: 0); otherwise (1, 2) and (2, 1) equal over the path of the exchange (part of machine-in-hyperactive)
nk-e-chk : Word → Word
nk-e-chk n =
  if %weq n #0 then nk-b2w (nk-has (nk-lam (nk-lam (nk-lam (nk-ua (nk-var #2) (nk-var #1) (nk-var #0))))) (nk-pi nk-U (nk-lam (nk-pi nk-U (nk-lam (nk-pi (nk-equiv (nk-var #1) (nk-var #0)) (nk-lam (nk-pathp (nk-lam nk-U) (nk-var #2) (nk-var #1)))))))))
  else (if %weq n #1 then nk-b2w (nk-tm-eq (nk-norm (nk-transp (nk-ua nk-NN nk-NN nk-swape) nk-i0 (nk-mkpair (nk-num #1) (nk-num #2)))) (nk-mkpair (nk-num #2) (nk-num #1)))
  else (if %weq n #2 then nk-b2w (nk-has nk-swape (nk-equiv nk-NN nk-NN))
  else (if %weq n #3 then nk-b2w (nk-has nk-hcu-line (nk-pathp (nk-lam nk-U) nk-N nk-U))
  else nk-b2w (nk-has (nk-lam nk-glue-12) (nk-pathp (nk-ua nk-NN nk-NN nk-swape) (nk-mkpair (nk-num #1) (nk-num #2)) (nk-mkpair (nk-num #2) (nk-num #1)))))))
