flash-step-1pass : FlashState → Word × Word → FlashState
flash-step-1pass (fstate false _ _ _) kv =
  fstate true (fst kv) #64 (%wmul #64 (snd kv))
flash-step-1pass (fstate true m d n) kv =
  let s     = fst kv
      v     = snd kv
      mNew  = if %wlt m s then s else m
      shOld = if %wlt m s then %wsub s m else #0
      shNew = if %wlt s m then %wsub m s else #0
      wNew  = %wshr #64 shNew
      dNext = %wadd (%wshr d shOld) wNew
      nNext = %wadd (%wshr n shOld) (%wmul wNew v)
  in fstate true mNew dNext nNext
