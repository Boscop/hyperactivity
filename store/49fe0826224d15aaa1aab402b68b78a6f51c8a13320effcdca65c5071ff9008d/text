guess-infer k g t =
  -- a λ guessed a function's has no inferable type: a line's may
  if %weq g #0 then redo k
  else if %weq g #2 then
    (case t of
       tapp f a V → (case infer f of typed T → (case %view T of wpath L a0 a1 → redo k; _ → infer t); r → r)
       _ → infer t)
  else if %weq g #3 then
    (case t of
       tpapp p r V → (case infer p of typed T → (case %view T of wpi A B → redo k; _ → infer t); r2 → r2)
       _ → infer t)
  else infer t
