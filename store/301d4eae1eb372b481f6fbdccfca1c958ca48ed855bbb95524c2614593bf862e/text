-- m · 2^e truncated: shifted right when e is negative (to 0 at 64 or more), left otherwise
-- (m has at most 53 bits: beyond 75 the value is 2^128 or more)
f64-mag-trunc : UInt64 → UInt64 → MRes DQ
f64-mag-trunc m e = case uq-slt e uq0 of
  true → (case u64lt (uq-neg e) (u64 #64) of
    true → mok (u64shr m (uq-neg e) , uq0)
    false → mok dq0)
  false → (case u64lt (u64 #75) e of
    true → mub ub-float-int-range
    false → mok (dq-shl (m , uq0) e))
