-- nk-probe-t: a probe of the checker, to be removed: a step unfolded equals itself (part of machine-in-hyperactive)
nk-probe-t : (sl : NkSlots) (u1 n1 u2 n2 x : Word) → nk-get (nk-step-at u2 n2 (nk-step-at u1 n1 sl)) x ≡ nk-get (nk-do (nk-fx (nk-plan (nk-get (nk-step-at u1 n1 sl) u2) u2 n2 (nk-step-at u1 n1 sl))) (nk-step-at u1 n1 sl)) x
nk-probe-t sl u1 n1 u2 n2 x = refl
