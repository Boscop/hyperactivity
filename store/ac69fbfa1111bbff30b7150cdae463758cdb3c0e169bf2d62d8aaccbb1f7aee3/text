-- a page at an optional canonical slug (e.g. "/paper", "/alignment-is-standpoint", "/privacy")
s-page-at : Bool → List Word → List Word → List Word → List Word
s-page-at md slug path text =
  list-append
    (h-concat (cons "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>" (cons (s-esc (s-title-of path (inr text))) (cons " · Hyperactive Labs</title><meta name='description' content='" (cons (s-esc (s-excerpt text)) (cons "'>" (cons s-theme-head (cons (s-og-at (s-esc (s-title-of path (inr text))) (s-esc (s-excerpt text)) (if orB (h-null slug) (h-eq slug "/privacy") then "website" else "article") (if h-null slug then nil else list-append "https://hyperactivity.ai" slug)) (cons (if orB (h-null slug) (h-eq slug "/privacy") then nil else s-article-ld (s-title-of path (inr text)) (s-excerpt text) (list-append "https://hyperactivity.ai" slug)) (cons "<style>" (cons s-style (cons s-nav-style (cons "</style>" (cons s-math (cons um-tag (cons "</head><body>" (cons s-nav (cons "<main><div class='path'>" (cons (s-esc path) (cons "</div>" (cons (if h-eq path "paper.md" then "<div class='paper-actions'><a class='primary' href='/pdf'>View PDF</a><a href='/paper.pdf' download='hyperactivity.pdf'>Download PDF</a><button type='button' onclick='window.print()'>Print</button><a href='/nets'>Interaction Net Lab</a><a href='/learn'>Language Tour</a></div>" else nil) nil)))))))))))))))))))))
    (list-append (if md then md-doc text else list-append "<pre>" (list-append (s-esc text) "</pre>")) (list-append s-footer "</main></body></html>"))
