wave-modal-anti-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wave-modal-anti-poly A ad mu q vs =
  (λ g sub →
    let k = g 0; w = g 1; qv = g 2
        nq = sub (q (fn-q 0 1)) qv
    in (ad (mu k qv) (mu w (sub qv nq)) , mu (ad k (ad w w)) qv))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
