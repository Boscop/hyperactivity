-- the essays of the source, each with its title, read as pages (s-essay)
s-in-source : List (List Word × List Word) → List Word
s-in-source nil = nil
s-in-source (cons x r) = list-append (h-concat (cons "<li><a href='/doc?path=" (cons (fst x) (cons "'>" (cons (s-esc (snd x)) (cons "<span class='kind'>" (cons (s-esc (fst x)) (cons "</span></a></li>" nil)))))))) (s-in-source r)
