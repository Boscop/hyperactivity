zle-zeq-r : (x y y2 : Nat × Nat) → zeq y y2 → zle x y → zle x y2
zle-zeq-r x y y2 e h = nle-cancel (plus (fst x) (snd y2)) (plus (fst y2) (snd x)) (snd y)
  (le-cong-r (plus (plus (fst x) (snd y2)) (snd y)) (plus (plus (fst y) (snd x)) (snd y2)) (plus (plus (fst y2) (snd x)) (snd y))
    (le-cong-l (plus (plus (fst x) (snd y)) (snd y2)) (plus (plus (fst x) (snd y2)) (snd y)) (plus (plus (fst y) (snd x)) (snd y2))
      (nle-add (plus (fst x) (snd y)) (plus (fst y) (snd x)) (snd y2) (snd y2) h (le-refl (snd y2)))
      (transN (plus-assoc (fst x) (snd y) (snd y2)) (transN (congN (plus (fst x)) (plus-comm (snd y) (snd y2))) (symN (plus-assoc (fst x) (snd y2) (snd y))))))
    (transN (plus-assoc (fst y) (snd x) (snd y2)) (transN (congN (plus (fst y)) (plus-comm (snd x) (snd y2)))
      (transN (symN (plus-assoc (fst y) (snd y2) (snd x))) (transN (congN (λ z → plus z (snd x)) e)
        (transN (plus-assoc (fst y2) (snd y) (snd x)) (transN (congN (plus (fst y2)) (plus-comm (snd y) (snd x))) (symN (plus-assoc (fst y2) (snd x) (snd y))))))))))
