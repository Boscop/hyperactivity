-- the destructor declared for a class (the importer writes one for every class that has one)
cx-find-dtor : List CDecl → Word → CxFn
cx-find-dtor nil i = cxfn-none
cx-find-dtor (cons d ds) i = case d of
  cd-destructor parent virt f → (case weq parent i of
    true → cxfn cxfk-destructor parent virt nil f
    false → cx-find-dtor ds i)
  _ → cx-find-dtor ds i
