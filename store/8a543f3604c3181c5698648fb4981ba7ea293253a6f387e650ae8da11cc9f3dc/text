type-level v =
  case %view v of
    wu l → lsuc l
    wpi A B → lmax (type-level A) (type-level (B (%var A)))
    wsigma A B → lmax (type-level A) (type-level (B (%var A)))
    wpath L a b → type-level (L @ %dim)
    wdata d ps → dlvl (%dent d)
    wglue A S → type-level A
    whcompu A S → type-level A
    wvar l T → univ-level T
    -- a stuck application, projection, path application or case: its view does not carry its type
    -- (computed from the spine when needed, src/net.c), so it is read off the spine as conversion
    -- does (a type f b, f : Bool → Type 1, was given level lzero)
    wapp f a T → neu-level v
    wfst p T → neu-level v
    wsnd p T → neu-level v
    wpapp p r T → neu-level v
    welim d x f T → (case %motive f of some P → univ-level (P x); none → neu-level v)
    _ → lzero
