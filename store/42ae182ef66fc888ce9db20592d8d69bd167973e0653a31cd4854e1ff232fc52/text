count-motif-go : Nat → List MTerm → List MTerm → Word
count-motif-go zero pat xs = #0
count-motif-go (suc fuel) pat nil = #0
count-motif-go (suc fuel) pat (cons x xs) =
  case split-prefix mterm-eq pat (cons x xs) of
    some rest → %wsucc (count-motif-go fuel pat rest)
    none → count-motif-go fuel pat xs
