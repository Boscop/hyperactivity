-- one step, then a run
runs-step : (stp : X86Step) → (stop k : Word) → (s s1 s2 : X86) → weq (x86-rip s) stop ≡ false →
            stp s ≡ the (Outc exception Unit × X86) (out-val unit , s1) → Runs stp stop k s1 s2 → Runs stp stop (%wsucc k) s s2
runs-step stp stop k s s1 s2 ne e r = (ne , (s1 , (e , r)))
