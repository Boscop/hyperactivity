-- (1) a symmetric matrix's form is a symmetric bilinear form in sy-BL's sense
it-bl : (A : Type) → (z : A) → (ad mu : A → A → A) → (ng : A → A) → (isz : A → Bool) → sy-DL A z ad mu ng isz → (n : Nat) → (s : it-sym A n) →
  sy-BL A (sy-vn A n) z ad mu (sy-vz A z n) (sy-va A ad n) (sy-vs A mu n) (it-fm A z ad mu n s)
it-bl A z ad mu ng isz DL n s = ((λ x → it-f0 A z ad mu (fst DL) (fst (snd DL)) (fst (snd (snd DL))) n s x) ,
  ((λ p q x → it-fa A z ad mu (fst (snd (snd DL))) (fst (snd (snd (snd (snd (snd DL)))))) (fst (snd (snd (snd (snd (snd (snd DL))))))) (fst (snd (snd (snd (snd (snd (snd (snd (snd (snd DL)))))))))) n s p q x) ,
   ((λ c p x → it-fs A z ad mu (fst DL) (fst (snd (snd (snd (snd DL))))) (fst (snd (snd (snd (snd (snd (snd (snd DL)))))))) (fst (snd (snd (snd (snd (snd DL)))))) n s c p x) ,
    (λ u v → it-fy A z ad mu (fst (snd (snd DL))) (fst (snd (snd (snd DL)))) (fst (snd (snd (snd (snd DL))))) (fst (snd (snd (snd (snd (snd (snd (snd DL)))))))) (fst (snd (snd (snd (snd (snd (snd (snd (snd (snd DL)))))))))) n s u v))))
