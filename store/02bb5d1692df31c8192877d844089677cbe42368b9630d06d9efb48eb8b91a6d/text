s-answer-logos : List Word → Proc W (List Word) → Proc W (List Word)
s-answer-logos p next =
  if h-eq p "/logo.svg" then bind (h-document "docs/logo.svg") (λ t → ret (s-response "image/svg+xml" (s-or nil t))) else
  if h-eq p "/logo-wormhole.svg" then bind (h-document "docs/logo-wormhole.svg") (λ t → ret (s-response "image/svg+xml" (s-or nil t))) else
  if h-eq p "/readme-hero.svg" then bind (h-document "docs/readme-hero.svg") (λ t → ret (s-response "image/svg+xml" (s-or nil t))) else
  if h-eq p "/readme-fiber.svg" then bind (h-document "docs/readme-fiber.svg") (λ t → ret (s-response "image/svg+xml" (s-or nil t))) else
  if h-eq p "/readme-kg.svg" then bind (h-document "docs/readme-kg.svg") (λ t → ret (s-response "image/svg+xml" (s-or nil t))) else
  if h-eq p "/logo-lightvirus.svg" then bind (h-document "docs/logo-lightvirus.svg") (λ t → ret (s-response "image/svg+xml" (s-or nil t))) else
  if h-eq p "/logo-light.svg" then bind (h-document "docs/logo-light.svg") (λ t → ret (s-response "image/svg+xml" (s-or nil t))) else
  if h-eq p "/logo-hopf-10.svg" then bind (h-document "docs/logo-hopf-10.svg") (λ t → ret (s-response "image/svg+xml" (s-or nil t))) else
  if h-eq p "/logo-hopf.svg" then bind (h-document "docs/logo-hopf.svg") (λ t → ret (s-response "image/svg+xml" (s-or nil t))) else
  next
