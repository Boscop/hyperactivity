nk-pser : NkTm → Lst Word → Lst Word
nk-pser (nk-var i) acc = lcons #0 (lcons i acc)
nk-pser (nk-free x) acc = lcons #1 (lcons x acc)
nk-pser (nk-num m) acc = lcons #2 (lcons m acc)
nk-pser (nk-lam b) acc = nk-pser b (lcons #3 acc)
nk-pser (nk-susp b) acc = nk-pser b (lcons #4 acc)
nk-pser (nk-con c as) acc = nk-pser as (lcons #5 (lcons c acc))
nk-pser (nk-op h p as) acc = nk-pser p (nk-pser as (lcons #6 (lcons h acc)))
nk-pser (nk-match h p cs) acc = nk-pser p (nk-pser cs (lcons #7 (lcons h acc)))
nk-pser nk-nil acc = lcons #8 acc
nk-pser (nk-cons t r) acc = nk-pser t (nk-pser r (lcons #9 acc))
