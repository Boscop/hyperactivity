nk-norm-it-s : Nat → NkTm → NkTm → NkTm
nk-norm-it-s zero kdefs t =
  let t0 = nk-sub-forms nk-nil #0 t
  in if nk-plain-nf t0 then t0 else nk-nf-s (toNat #30000) kdefs t0
nk-norm-it-s (suc k) kdefs t =
  let t0 = nk-sub-forms nk-nil #0 t
  in if nk-plain-nf t0
       then t0
       else let nf = nk-nf-s (toNat #30000) kdefs t0
                kn = nk-pass nf
            in if nk-tm-eq kn nf then nf else nk-norm-it-s k kdefs kn
