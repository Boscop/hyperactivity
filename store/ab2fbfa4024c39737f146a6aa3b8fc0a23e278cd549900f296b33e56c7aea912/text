paragraphs-rest : Nat → List (List Word) → List (List Word)
paragraphs-rest zero ls = ls
paragraphs-rest (suc n) nil = nil
paragraphs-rest (suc zero) (cons nil ls) = cons nil ls
paragraphs-rest (suc (suc m)) (cons nil ls) = paragraphs-rest (suc m) ls
paragraphs-rest (suc n) (cons (cons x l) ls) = paragraphs-rest (suc n) ls
