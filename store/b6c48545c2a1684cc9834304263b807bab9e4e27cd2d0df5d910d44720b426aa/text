opt-swap4 : (w a s b : Nat) → plus (plus w a) (plus s b) ≡ plus (plus w s) (plus a b)
opt-swap4 w a s b =
  let p1 : plus (plus w a) (plus s b) ≡ plus w (plus a (plus s b))
      p1 = plus-assoc w a (plus s b)
      p2 : plus a (plus s b) ≡ plus s (plus a b)
      p2 = transN (symN (plus-assoc a s b))
             (transN (λ i → plus (plus-comm a s i) b) (plus-assoc s a b))
      p3 : plus w (plus s (plus a b)) ≡ plus (plus w s) (plus a b)
      p3 = symN (plus-assoc w s (plus a b))
  in transN p1 (transN (congN (plus w) p2) p3)
