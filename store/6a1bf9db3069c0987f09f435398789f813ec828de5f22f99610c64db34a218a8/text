-- THEOREM 2: UNIVERSAL N-SCALE CERTIFIED ERROR COMPOSITION OVER ARBITRARY PIPELINES!
-- If every physical/biological coarse-graining layer k satisfies eps_k <= B_k,
-- then the total composed end-to-end error satisfies sum(eps_k) <= sum(B_k) universally!
cos-thm-multiscale-compose : (es bs : List Nat) →
  cos-all-le es bs ≡ true →
  hm-le (cos-sum-nat es) (cos-sum-nat bs) ≡ true
cos-thm-multiscale-compose nil         _           _ = refl
cos-thm-multiscale-compose (cons _ _)  nil         h = Empty-rec (true≢false (web-sym-b h))
cos-thm-multiscale-compose (cons e es) (cons b bs) h =
  sc-le-add-mono e b (cos-sum-nat es) (cos-sum-nat bs)
    (kir-andB-l (hm-le e b) (cos-all-le es bs) h)
    (cos-thm-multiscale-compose es bs (kir-andB-r (hm-le e b) (cos-all-le es bs) h))
