sound-baremetal-isr-c : List Word
sound-baremetal-isr-c = sv-join (
  cons "/* Generated from sound/graph.hypercubical — Zero-Malloc Bare-Metal Audio ISR */" (
  cons "#include <stdint.h>" (
  cons "typedef struct { int32_t q[4], p[4]; } HyperMesh4;" (
  cons "static inline int32_t hx_mul16(int32_t a, int32_t b) { return (int32_t)(((int64_t)a * (int64_t)b) >> 16); }" (
  cons "static inline int16_t hx_lim16(int32_t x) { return x > 32000 ? 32000 : (x < -32000 ? -32000 : (int16_t)x); }" (
  cons "void hyper_audio_isr(HyperMesh4 *m, int16_t *out_stereo, int n_frames, int32_t k, int32_t w, int32_t damp, int32_t impL, int32_t impR) {" (
  cons "  for (int i = 0; i < n_frames; i++) {" (
  cons "    int32_t f[4];" (
  cons "    for (int j = 0; j < 4; j++) {" (
  cons "      int32_t qj = m->q[j], lap = hx_mul16(w, (qj - m->q[(j+1)&3]) + (qj - m->q[(j+3)&3]));" (
  cons "      int32_t ext = (i < 12) ? (j == 0 ? impL : (j == 1 ? impR : 0)) : 0;" (
  cons "      f[j] = hx_mul16(k, qj) + lap - ext;" (
  cons "    }" (
  cons "    for (int j = 0; j < 4; j++) { m->p[j] = hx_mul16(damp, m->p[j] - f[j]); m->q[j] += m->p[j]; }" (
  cons "    int32_t s01 = m->q[0] + m->q[1], d01 = m->q[0] - m->q[1];" (
  cons "    int32_t s23 = m->q[2] + m->q[3], d23 = m->q[2] - m->q[3];" (
  cons "    int32_t h0 = (s01 + s23) >> 1, h1 = (d01 + d23) >> 1, h2 = (s01 - s23) >> 1, h3 = (d01 - d23) >> 1;" (
  cons "    out_stereo[i*2]     = hx_lim16((h0 + h3) >> 1);" (
  cons "    out_stereo[i*2 + 1] = hx_lim16((h1 + h2) >> 1);" (
  cons "  }" (
  cons "}" nil)))))))))))))))))))))
