cs-code-wop : Word → Word → Word → CsOptM
cs-code-wop j a b =
  if %weq j #0 then csom-some (cmv-bool (%weq a b))
  else if %weq j #1 then csom-some (cmv-bool (%wlt a b))
  else if %weq j #2 then (if cs-w64 (%wadd a b) then csom-some (cmv-word (%wadd a b)) else csom-none)
  else if %weq j #3 then csom-some (cmv-word (%wmax a b))
  else if %weq j #4 then csom-some (cmv-word (%wsub a b))
  else if %weq j #5 then (if cs-w64 (%wmul a b) then csom-some (cmv-word (%wmul a b)) else csom-none)
  else if %weq j #6 then csom-some (cmv-word (if %weq b #0 then #0 else %wdiv a b))
  else if %weq j #7 then csom-some (cmv-word (if %weq b #0 then a else %wmod a b))
  else if %weq j #8 then csom-some (cmv-word (%wand a b))
  else if %weq j #9 then csom-some (cmv-word (%wor a b))
  else if %weq j #10 then csom-some (cmv-word (%wxor a b))
  else if %weq j #12 then csom-some (cmv-word (if %wlt b #64 then %wshr a b else #0))
  else csom-none
