opt-2-l0-sound : {V : Type} → (env : V → Bool) → (b : B2) → (c : B0) → (y : Circ B0 B1 B2 V) →
  fold {B0} {B1} {B2} {V} {Bool} bool-alg env (opt-2-l0 b c y) ≡
  snd (snd bool-alg) b (fst bool-alg c) (fold {B0} {B1} {B2} {V} {Bool} bool-alg env y)
opt-2-l0-sound env b2-and b0-false y = refl
opt-2-l0-sound env b2-and b0-true  y = refl
opt-2-l0-sound env b2-or  b0-false y = refl
opt-2-l0-sound env b2-or  b0-true  y = refl
opt-2-l0-sound env b2-xor b0-false y = refl
opt-2-l0-sound env b2-xor b0-true  y = opt-not-sound env y
