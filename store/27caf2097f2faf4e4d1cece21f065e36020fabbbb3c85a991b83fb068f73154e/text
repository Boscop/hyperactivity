ms-wasm-bytes : List Word
ms-wasm-bytes =
  let hdr  = the (List Word) (cons #0 (cons #97 (cons #115 (cons #109 (cons #1 (cons #0 (cons #0 (cons #0 nil))))))))
      -- 1 type: (i32, i32, i32, i32) -> i32
      tSec = mw-sec #1 (the (List Word) (cons #1 (cons #96 (cons #4 (cons #127 (cons #127 (cons #127 (cons #127 (cons #1 (cons #127 nil))))))))))
      fSec = mw-sec #3 (the (List Word) (cons #7 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 nil)))))))))
      eSec = mw-sec #7 (cons #7 (mw-exports #0 ms-all-circuits))
      cSec = mw-sec #10 (cons #7 (mw-bodies ms-all-circuits))
  in ms-cat (cons hdr (cons tSec (cons fSec (cons eSec (cons cSec nil)))))
