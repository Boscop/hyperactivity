dec-word-go : Nat → List Word → Word × List Word
dec-word-go zero nil = (#0 , nil)
dec-word-go zero (cons w r) = (w , r)
dec-word-go (suc k) nil = (#0 , nil)
dec-word-go (suc k) (cons b r) =
  if wlt b #128 then (b , r)
  else let p = dec-word-go k r in (wadd (wmul (fst p) #128) (wsub b #128) , snd p)
