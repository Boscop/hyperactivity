-- ---------------------------------------------------------------- G and F, certified
-- G and F with their steps and expressions as parameters (instantiated only where the numbers are)
g-val-of : List Bool → List Bool → IE → IE → IV → IV → Nat → IV × Bool
g-val-of S S2 st gt p2 a M = istep (irun S S2 (ang-env S p2 a) st (suc M) (iv-unit S , true))
  (ieval S S2 (env3 (fst (irun S S2 (ang-env S p2 a) st (suc M) (iv-unit S , true))) p2 a) gt)
