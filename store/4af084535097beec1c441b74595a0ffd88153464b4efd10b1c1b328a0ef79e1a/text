mterm-subst-ref : MTerm → MTerm → MTerm
mterm-subst-ref pat mempty = mempty
mterm-subst-ref pat (mlit a) = mlit a
mterm-subst-ref pat (mref k) = %welimP (λ _ → MTerm) k pat (λ n _ → mref n)
mterm-subst-ref pat (mapp tid arg) = mapp tid (mterm-subst-ref pat arg)
mterm-subst-ref pat (mcat l r) = mcat (mterm-subst-ref pat l) (mterm-subst-ref pat r)
