quotient-unsplit : List (List Word) → List Word × List Word → List Word
quotient-unsplit qmap p =
  let k = fromNat (list-length qmap)
  in (case fst p return (λ _ → List Word → List Word) of
        nil → λ rks → nil
        cons s qs → λ rks →
          if wlt s k then
            (case rks of
               nil → cons #0 (rec qs nil)
               cons rk rks1 → cons (cm-from-some #0 (nth-class s rk qmap)) (rec qs rks1))
          else cons (wsub s k) (rec qs rks)) (snd p)
