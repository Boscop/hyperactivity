-- the characteristic polynomial of Σ ε q_IJK on the invariants of edges with doubled spins ds (an open
-- spin-½ index is one more entry 1 in ds, named in no triple)
vertex-poly : List Nat → List Triple → List SQ
vertex-poly ds ts = vertex-poly-ms ds ts (mons ds (nat-half (nat-sum ds))) (mons ds (suc (nat-half (nat-sum ds))))
