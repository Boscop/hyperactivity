pm-row-col-parity :
  (a b c d e f g h z : Bool) →
  pm-xor3 (pm-xor3 a b c) (pm-xor3 d e f) (pm-xor3 g h z)
  ≡ pm-xor3 (pm-xor3 a d g) (pm-xor3 b e h) (pm-xor3 c f z)
pm-row-col-parity a b c d e f g h z =
  concat (λ i → pm-xor (pm-xor3 a b c) (pm-row-col-p1 d e f g h z i))
         (pm-row-col-p2 a b c d e f g h z)
