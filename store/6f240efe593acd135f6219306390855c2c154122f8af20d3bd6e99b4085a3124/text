-- F̃ on a vertex where E (of side s) changed edge e: emits h_e's index, restoring e
f-map : Bool → Nat → List Nat → Rows → Rows
f-map s e ds = rows-map-entry (if s then scaled-entry ((exp-at e ds , suc (exp-at e ds)) , (zero , suc zero)) (eminus-entry e ds) else scaled-entry (sq-neg sq-one) (eplus-entry e ds)) (mons0 (sp-ds (not s) e ds)) (mons0 ds)
