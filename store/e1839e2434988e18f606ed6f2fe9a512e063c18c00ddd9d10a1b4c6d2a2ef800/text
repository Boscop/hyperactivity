-- a plan's requests on memories that read the same leave memories that read the same
nk-do-same : (fx : NkFx) (a c : NkSlots) → nk-same a c → nk-same (nk-do fx a) (nk-do fx c)
nk-do-same nkf-nil a c h = h
nk-do-same (nkf-val w v r) a c h = nk-do-same r (nk-upd a w (nk-arrive-val v)) (nk-upd c w (nk-arrive-val v)) (nk-upd-same a c w (nk-arrive-val v) h)
nk-do-same (nkf-op w o r) a c h = nk-do-same r (nk-upd a w (nk-arrive-op o)) (nk-upd c w (nk-arrive-op o)) (nk-upd-same a c w (nk-arrive-op o) h)
nk-do-same (nkf-put w s r) a c h = nk-do-same r (nk-upd a w (λ s0 → s)) (nk-upd c w (λ s0 → s)) (nk-upd-same a c w (λ s0 → s) h)
