-- a request's path and query, its %XX escapes and +s read back
s-hexv : Word → Word
s-hexv c = if wlt c #58 then wsub c #48 else if wlt c #71 then wsub c #55 else wsub c #87
s-pct : (List Word → List Word) → List Word → List Word
s-pct k (cons a (cons b r)) = cons (wadd (wshl (s-hexv a) #4) (s-hexv b)) (k r)
s-pct k r = cons #37 (k r)
s-unescape-f : Nat → List Word → List Word
s-unescape-f zero t = t
s-unescape-f (suc f) nil = nil
s-unescape-f (suc f) (cons x r) = if weq x #43 then cons #32 (s-unescape-f f r) else if weq x #37 then s-pct (s-unescape-f f) r else cons x (s-unescape-f f r)
s-unescape : List Word → List Word
s-unescape t = s-unescape-f (list-length t) t
s-param-in : List Word → List (List Word) → List Word
s-param-in key nil = nil
s-param-in key (cons kv r) = if h-prefix (list-append key "=") kv then s-unescape (h-drop (list-append key "=") kv) else s-param-in key r
s-param : List Word → List Word → List Word
s-param key q = s-param-in key (h-split #38 q)
s-request-path : List Word → List Word
s-request-path req = h-before " " (h-drop "GET " (h-before (cons #13 nil) req))
s-after-q : List Word → List Word
s-after-q nil = nil
s-after-q (cons x r) = if weq x #63 then cons x r else s-after-q r

s-query : List Word → List Word
s-query p = h-drop "?" (s-after-q p)
-- a response; no cache keeps an old page, so a reader always sees what was last deployed
