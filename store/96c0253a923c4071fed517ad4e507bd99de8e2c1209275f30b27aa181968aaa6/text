-- /synesthesia: text drawn as Avik sees it (synthetic-synesthesia): each letter and digit in its color
-- from his table (screen-colors, docs/synesthesia.cub) on a black ground, the letters themselves colored;
-- a letter's color is its lower case's; bytes past ASCII pass through untouched, so any script stays whole
sy-lower : Word → Word
sy-lower x = if andB (wlt #64 x) (wlt x #91) then wadd x #32 else x
sy-letter : Word → Bool
sy-letter x = orB (andB (wlt #96 x) (wlt x #123)) (andB (wlt #64 x) (wlt x #91))
sy-digit : Word → Bool
sy-digit x = andB (wlt #47 x) (wlt x #58)
sy-color-in : List (List Word × List Word) → Word → List Word
sy-color-in nil x = nil
sy-color-in (cons e r) x = if h-eq (fst e) (cons x nil) then snd e else sy-color-in r x
