s-views-path : List Word → Bool
s-views-path p = orB (h-prefix "/graph" p) (orB (h-prefix "/api/" p) (orB (h-prefix "/hi" p) (h-prefix "/history" p)))
-- what the public server withholds: the source under private/, asked for as a document (/doc?path=) or as
-- source text (/source/text?path=, the path in hex). Avik, 2026-11-18 12:20 UTC: "they should all have
-- contact in the repo but it should not be published on the website". The test reads the path exactly as
-- s-answer reads it, so no spelling of a request reaches a private path that this test does not see.
s-withheld : List Word → Bool
s-withheld p = orB (andB (h-prefix "/doc?" p) (h-infix "private/" (s-param "path" (s-query p))))
  (andB (h-prefix "/source/text" p) (h-infix "private/" (h-unhex (s-param "path" (s-query p)))))
