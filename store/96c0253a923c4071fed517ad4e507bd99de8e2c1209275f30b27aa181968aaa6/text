-- a public page made once for each state of the source (the view's stamp) and kept in the store as the
-- response's bytes (STORE/site-STAMP-KEY), so a reader is served bytes and the machine renders nothing
-- (Avik, 2026-11-18: "its mission critical this never goes down again"); the child at start makes every
-- published page this way, one after another, before any reader asks; only a page that was answered (200)
-- is kept
s-site-or : List Word → Proc W (List Word) → Sum Unit (List Word) → Proc W (List Word)
s-site-or f mk (inr r) = ret {lzero} {W} r
s-site-or f mk (inl u) = bind mk (λ r → if h-prefix "HTTP/1.1 200" r then bind (h-write f r) (λ ok → ret {lzero} {W} r) else ret {lzero} {W} r)
s-site-kept : List Word → List Word → Proc W (List Word) → Proc W (List Word)
s-site-kept st key mk = bind (h-read (list-append st "/index/meta/stamp")) (λ s →
  bind (h-read (list-append st (list-append "/site-" (list-append (h-hex (h-before " " (s-or nil s))) (list-append "-" key))))) (s-site-or (list-append st (list-append "/site-" (list-append (h-hex (h-before " " (s-or nil s))) (list-append "-" key)))) mk))
-- one search item, kept as the pages are (s-site-kept)
s-corpus-kept-one : List Word → List Word → Proc W (List Word)
s-corpus-kept-one st q = s-site-kept st (list-append "corpus-" (h-drop "/" q)) (s-corpus-one st q)
-- the work at a public name, its page kept per state of the source (s-site-kept); any other address is not found
s-public : List Word → Sum Unit Work → Proc W (List Word)
s-public st (inl u) = ret {lzero} {W} (s-respond "404 Not Found" s-html s-not-found)
s-public st (inr (work n k p)) = s-site-kept st n (if h-ends ".cub" p then s-essay p else s-doc p)
-- the front page, then every published work's page and search item, made and kept one after another (the child at start)
s-site-all : List Word → List Work → Proc W Unit
s-site-all st nil = bind (s-site-kept st "front" s-front) (λ f → ret {lzero} {W} unit)
s-site-all st (cons (work n k p) r) = bind (s-public st (inr (work n k p))) (λ x → bind (s-corpus-kept-one st (list-append "/" n)) (λ y → s-site-all st r))
