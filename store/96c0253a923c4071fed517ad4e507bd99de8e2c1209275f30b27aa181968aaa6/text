sy-letters : List Word → List Word
sy-letters nil = nil
sy-letters (cons x r) = list-append (if orB (sy-letter x) (sy-digit x) then sy-span (sy-color x) x else sy-plain x) (sy-letters r)
-- units by first letter (Avik: "syn-thetic yellow-green", "semantic yellow content green"): a run of
-- letters takes its first letter's color, any other character ending the run; digits keep their own
-- ("1729 ... black-green-lightblue-purple"). cur is the run's color, nil outside a run
sy-pick : List Word → Word → List Word
sy-pick cur x = if h-null cur then sy-color x else cur
sy-units : List Word → List Word → List Word
sy-units cur nil = nil
sy-units cur (cons x r) =
  if sy-letter x then list-append (sy-span (sy-pick cur x) x) (sy-units (sy-pick cur x) r)
  else if sy-digit x then list-append (sy-span (sy-color x) x) (sy-units nil r)
  else list-append (sy-plain x) (sy-units nil r)
sy-text-or : List Word → List Word
sy-text-or t = if h-null t then "syn-thetic marimba string strength sym-metry vedas semantic content 1729 hyperactive pink purple" else t
sy-page : List Word → Bool → List Word
sy-page t units = h-concat (cons "<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>synthetic synesthesia</title><style>body{margin:0;background:#000;color:#fff;font:500 26px/1.6 ui-sans-serif,-apple-system,system-ui,sans-serif} main{max-width:900px;margin:0 auto;padding:28px 18px 60px} textarea{width:100%;box-sizing:border-box;font:16px ui-sans-serif,-apple-system,system-ui,sans-serif;background:#000;color:#fff;border:1px solid #444;border-radius:8px;padding:8px} button{font:15px ui-sans-serif,-apple-system,system-ui,sans-serif;background:#000;color:#fff;border:1px solid #666;border-radius:8px;padding:6px 12px;margin:8px 8px 20px 0} .t{white-space:pre-wrap;overflow-wrap:break-word}</style></head><body><main><form method='get' action='/synesthesia'><textarea name='text' rows='3'>" (cons (s-esc t) (cons "</textarea><br><button name='units' value='1'>units by first letter</button><button name='units' value='0'>letter by letter</button></form><div class='t'>" (cons (if units then sy-units nil t else sy-letters t) (cons "</div></main></body></html>" nil)))))
sy-answer : List Word → List Word
sy-answer q = s-response s-html (sy-page (sy-text-or (s-param "text" q)) (h-not (h-eq (s-param "units" q) "0")))
-- /chat: a text's meaning in the record shown as it is typed (a pause in typing asks /api/meaning, which
-- leaves the record as it is; an answer to an older text is dropped); "say it" keeps the turn in the
-- record, the conversation
ch-page : List Word → List Word → List Word
ch-page q reply = h-concat (cons "<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>meaning</title><style>body{margin:0;background:#fff;color:#000;font:17px/1.45 Georgia,serif;padding:16px}textarea{width:100%;box-sizing:border-box;font:inherit}pre{white-space:pre-wrap;font:inherit}</style></head><body><form method='get' action='/chat'><textarea id='q' name='q' rows='3' autofocus>" (cons (s-esc q) (cons "</textarea><br><button>say it</button></form><pre id='m'>" (cons (s-esc reply) (cons "</pre><script>var n=0,w=0,q=document.getElementById('q'),m=document.getElementById('m');q.addEventListener('input',function(){var k=++n,v=q.value;clearTimeout(w);if(!v){m.textContent='';return}w=setTimeout(function(){fetch('/api/meaning?q='+encodeURIComponent(v)).then(function(r){return r.text()}).then(function(t){if(k===n)m.textContent=t})},300)});</script></body></html>" nil)))))
-- /api/meaning?q=TEXT: the meaning of TEXT in the record, as text, the record unchanged
ch-api : List Word → Proc W (List Word)
ch-api q = bind (c-meaning-of q) (λ r → ret (s-response "text/plain; charset=utf-8" r))
-- the meaning of the turn computed in this process (lib/meaning.cub), no machine started for it
ch-answer : List Word → List Word → Proc W (List Word)
ch-answer m q = if h-null q then ret {lzero} {W} (s-response s-html (ch-page nil nil))
  else bind (c-answer q) (λ r → ret (s-response s-html (ch-page q r)))
s-or : List Word → Sum Unit (List Word) → List Word
s-or d (inl u) = d
s-or d (inr t) = t
s-graph : List Word → List Word → Proc W (List Word)
s-graph st m = bind (h-read (list-append st "/index/meta/stamp")) (λ s → bind (h-read (list-append st "/views/source-stamp")) (λ k →
  bind (if andB (h-not (h-null (s-or nil s))) (h-eq (s-or nil s) (s-or nil k)) then ret {lzero} {W} #0 else s-graph-make st m (s-or nil s)) (λ u →
  bind (h-read (list-append st "/views/graph.json")) (λ j → ret {lzero} {W} (s-response "application/json" (s-or "{}" j))))))
s-json-esc : List Word → List Word
s-json-esc nil = nil
s-json-esc (cons x r) = if orB (weq x #34) (weq x #92) then cons #92 (cons x (s-json-esc r)) else if wlt x #32 then s-json-esc r else cons x (s-json-esc r)
-- the history of a name: its bindings, each `name key time`, as a JSON list of strings
s-json-str : List Word → List Word
s-json-str s = cons #34 (list-append (s-json-esc s) (cons #34 nil))
s-bindings : List Word → List (List Word) → List (List Word)
s-bindings name nil = nil
s-bindings name (cons l r) = if andB (h-not (h-null name)) (h-eq name (h-before " " l)) then cons l (s-bindings name r) else s-bindings name r
s-commas : List (List Word) → List Word
s-commas nil = nil
s-commas (cons a nil) = a
s-commas (cons a (cons b r)) = list-append a (cons #44 (s-commas (cons b r)))
s-history : List Word → List Word → Proc W (List Word)
s-history st name = bind (h-read (list-append st "/names")) (λ log →
  ret (s-response "application/json" (list-append "[" (list-append (s-commas (list-map s-json-str (s-bindings name (h-lines (s-or nil log))))) "]"))))
s-doc-of : List Word → Sum Unit (List Word) → List Word
s-doc-of p (inl u) = s-response "text/plain" "no such document"
s-doc-of p (inr t) = if h-ends ".pdf" p then s-response "application/pdf" t else s-response s-html (s-page p t)
-- a document of the repository: no path above it or from the root
s-doc : List Word → Proc W (List Word)
s-doc p = if orB (h-prefix ".." p) (orB (h-prefix "/" p) (h-infix "/.." p)) then ret {lzero} {W} (s-response "text/plain" "no such document")
  else bind (h-document p) (λ t → ret (s-doc-of p t))
s-file : List Word → List Word → Proc W (List Word)
s-file ctype p = bind (h-read p) (λ t → ret (s-response ctype (s-or nil t)))
-- a listed document: its title, read from the document, linking to the document
s-entry : List Word → List Word → Proc W (List Word)
s-entry href p = bind (h-document p) (λ t → ret {lzero} {W} (h-concat (cons "<li><a href='" (cons href (cons "'>" (cons (s-esc (s-title-of p t)) (cons "<span class='kind'>" (cons (s-esc p) (cons "</span></a></li>" nil)))))))))
s-home-head : List Word
s-home-head = h-concat (cons "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>Avik Jain · Hyperactive Labs</title><meta name='description' content='hyperactivity: a decentralized operating system language for collective superintelligence'><style>" (cons s-style (cons "</style></head><body>" (cons "<header class='splash'><h1>hyperactivity</h1><div class='sub'>A decentralized operating system language for collective superintelligence.</div><div class='who'>Avik Jain</div></header>" (cons s-nav (cons "<main><div class='section'>The paper</div><div class='feature'><a href='/paper'><div class='t'>hyperactivity</div><div class='s'>A decentralized operating system language for collective superintelligence</div></a></div>" nil))))))
-- the paper's markdown as a page reads it: its front matter (between the first two "---" lines) and its HTML
-- comments left out; a heading keeps its anchor ({#id}), which s-h makes its id
s-after-front : List (List Word) → List (List Word)
s-after-front nil = nil
s-after-front (cons l r) = if h-eq l "---" then r else s-after-front r
s-unfront : List (List Word) → List (List Word)
s-unfront (cons l r) = if h-eq l "---" then s-after-front r else cons l r
s-unfront nil = nil
s-uncomment : Bool → List (List Word) → List (List Word)
s-uncomment c nil = nil
s-uncomment true (cons l r) = s-uncomment (h-not (h-infix "-->" l)) r
s-uncomment false (cons l r) = if h-prefix "<!--" l then s-uncomment (h-not (h-infix "-->" l)) r
  else cons l (s-uncomment false r)
s-paper-text : List Word → List Word
s-paper-text t = h-concat (list-map h-line (s-uncomment false (s-unfront (h-split #10 t))))
s-paper-of : Sum Unit (List Word) → List Word
s-paper-of (inl u) = s-respond "503 Service Unavailable" "text/plain" "the paper is being made; reload in a minute"
s-paper-of (inr t) = s-response s-html (s-page "paper.md" (list-append (h-concat (list-map h-line (cons "# hyperactivity" (cons "" (cons "*A decentralized operating system language for collective superintelligence.* Avik Jain" (cons "" nil)))))) (s-paper-text t)))
s-paper-made : List Word → List Word → Sum Unit (List Word) → Proc W (List Word)
s-paper-made st m (inr t) = ret {lzero} {W} (s-paper-of (inr t))
s-paper-made st m (inl u) = bind (h-run (cons m (cons "lib/paper-view.cub" nil))) (λ r → bind (h-read (list-append st "/paper/text")) (λ t → ret {lzero} {W} (s-paper-of t)))
-- /paper : the paper as it reads (lib/paper-view.cub keeps it in the store, paper/text), made when absent
s-paper-raw : List Word → List Word → Proc W (List Word)
s-paper-raw st m = bind (h-read (list-append st "/paper/text")) (λ t → s-paper-made st m t)
-- the page made once per version of the paper (its stamp) and kept beside it, since making it takes the
-- machine about 15 s; only a page that was answered (200) is kept
s-paper-cached : List Word → List Word → List Word → Sum Unit (List Word) → Proc W (List Word)
s-paper-cached st m pp (inr h) = ret h
s-paper-cached st m pp (inl u) = bind (s-paper-raw st m) (λ r → if h-prefix "HTTP/1.1 200" r then bind (h-write pp r) (λ ok → ret {lzero} {W} r) else ret {lzero} {W} r)
s-paper-at : List Word → List Word → Sum Unit (List Word) → Proc W (List Word)
s-paper-at st m (inl u) = s-paper-raw st m
s-paper-at st m (inr s) = bind (h-read (list-append st (list-append "/paper/page-" (h-hex s)))) (s-paper-cached st m (list-append st (list-append "/paper/page-" (h-hex s))))
s-paper : List Word → List Word → Proc W (List Word)
s-paper st m = bind (h-read (list-append st "/paper/stamp")) (s-paper-at st m)
-- one request answered
-- the served source (lib/host.cub, h-sync): every change it has had, in order, a line `PATH POINTER`
-- of STORE/source-log each (the path in hex, "-" for a module dropped). A session asks for the
-- changes after the last it has and takes a module's text; every change is taken and logged, none
-- compared or refused; HYPERACTIVE_TOKEN, when the server has one, must come with every change
s-log : List Word → Proc W (List (List Word))
s-log st = bind (h-read (list-append st "/source-log")) (λ l → ret (h-lines (s-or nil l)))
s-changes-from : Word → Word → List (List Word) → List Word
s-changes-from since i nil = nil
s-changes-from since i (cons l r) = list-append (if wlt since i then h-line (list-append (h-decimal i) (list-append " " l)) else nil) (s-changes-from since (wadd i #1) r)
s-changes : List Word → List Word → Proc W (List Word)
s-changes st q = bind (s-log st) (λ ls → ret (s-response "text/plain" (s-changes-from (h-number (s-param "since" q)) #1 ls)))
s-text-of : Sum Unit (List Word) → List Word
s-text-of (inl u) = s-respond "404 Not Found" "text/plain" "no such module"
s-text-of (inr t) = s-response "text/plain" t
s-text : List Word → Proc W (List Word)
s-text q = bind (h-source-text (h-unhex (s-param "path" q))) (λ t → ret (s-text-of t))
s-logged : List Word → List Word → List Word → Proc W (List Word)
s-logged st hx p = bind (h-read (list-append st "/source-log")) (λ l →
  bind (h-write (list-append st "/source-log") (list-append (s-or nil l) (h-line (list-append hx (list-append " " p))))) (λ w → ret (s-response "text/plain" p)))
-- a module recorded (the body its text) or dropped, and logged when its pointer moved (the session's
-- `write` checked it; whoever uses it checks it again)
s-changed : List Word → List Word → List Word → List Word → Proc W (List Word)
s-changed st hx p now = if h-eq now p then ret {lzero} {W} (s-response "text/plain" now) else s-logged st hx now
s-change : List Word → List Word → Bool → List Word → List Word → Proc W (List Word)
s-change st m rec q body = bind (h-pointer (h-unhex (s-param "path" q))) (λ p →
  bind (if rec then h-record-raw m (h-unhex (s-param "path" q)) body else h-unrecord-raw (h-unhex (s-param "path" q))) (λ u →
  bind (h-pointer (h-unhex (s-param "path" q))) (s-changed st (s-param "path" q) p)))
-- the human interface (human-interface; built 2026-11-17): the human's peer of the agents' CLI, at
-- /hi. The workflow, the documents, the code and the proofs are one space, explored by focus. A
-- focus is anything the source holds: a node, any definition (code or proof) or a document's path.
-- The scene is the focus's neighbourhood. For a node, that is what it is part of, what serves it
-- and its essential context. For a document, it is the nodes it is essential context of. For any
-- name, it is its code with the machine's verdict on it. In every text, each name the source binds
-- is a way into it. Radius 2 adds the neighbours' neighbours, drawn smaller. Every gesture writes.
-- A focus extends the reader's path walked (STORE/hi/walk-READER, a line each), and the readers
-- whose path ends at the focus are shown there. A question, an asserted equivalence, a warrant or a
-- witness becomes a line of the source's document readers/READER.md, logged like any change, so
-- every session reads it. Every change of focus is one interpolation between two scenes: a CSS
-- view transition in which each node keeps its own name, so the card tapped becomes the focus.
hi-ident-char : Word → Bool
hi-ident-char x = orB (andB (wlt #96 x) (wlt x #123)) (orB (andB (wlt #64 x) (wlt x #91)) (orB (andB (wlt #44 x) (wlt x #58)) (orB (weq x #95) (weq x #39))))
hi-same : Bool → Bool → Bool
hi-same a b = if a then b else h-not b
-- a text cut into runs: the names (and paths) a source can bind, and what lies between them
hi-toks : List Word → List Word → List (List Word)
hi-toks nil nil = nil
hi-toks nil (cons x r) = hi-toks (cons x nil) r
hi-toks (cons c cs) nil = cons (h-rev (cons c cs) nil) nil
hi-toks (cons c cs) (cons x r) = if hi-same (hi-ident-char c) (hi-ident-char x) then hi-toks (cons x (cons c cs)) r else cons (h-rev (cons c cs) nil) (hi-toks (cons x nil) r)
-- cutting loses nothing: the runs, joined, are the text
hi-toks-whole : h-concat (hi-toks nil "part of a-b. (x: docs/c.md)") ≡ "part of a-b. (x: docs/c.md)"
hi-toks-whole = refl
hi-some : Sum Unit (List Word) → Bool
hi-some (inl u) = false
hi-some (inr t) = true
-- the source binds the name, or holds a module or document at the path
hi-bound : List Word → Proc W Bool
hi-bound t = bind (h-read (list-append h-index (list-append "/written/" (h-hex t)))) (λ w →
  bind (h-read (list-append h-index (list-append "/modules/" (h-hex t)))) (λ m → ret (orB (hi-some w) (hi-some m))))
hi-url : List Word → List Word
hi-url nil = nil
hi-url (cons x r) = if hi-ident-char x then cons x (hi-url r) else cons #37 (cons (h-hexd (wshr x #4)) (cons (h-hexd (wand x #15)) (hi-url r)))
-- what a link carries is read back whole
hi-url-back : s-unescape (hi-url "a b&c+d/e.md") ≡ "a b&c+d/e.md"
hi-url-back = refl
hi-href : List Word → List Word → List Word
hi-href rd f = list-append "/hi?reader=" (list-append (hi-url rd) (list-append "&focus=" (hi-url f)))
hi-a : List Word → List Word → List Word → List Word
hi-a rd f label = h-concat (cons "<a href='" (cons (s-esc (hi-href rd f)) (cons "'>" (cons (s-esc label) (cons "</a>" nil)))))
hi-dots : List Word → List Word
hi-dots nil = nil
hi-dots (cons x r) = if orB (weq x #46) (weq x #39) then hi-dots r else cons x r
-- a run without the full stops and quotes that end the sentence it closes
hi-core : List Word → List Word
hi-core t = h-rev (hi-dots (h-rev t nil)) nil
hi-link : List Word → List Word → Proc W (List Word)
hi-link rd nil = ret nil
hi-link rd (cons x r) = if orB (h-not (hi-ident-char x)) (h-null (hi-core (cons x r))) then ret {lzero} {W} (s-esc (cons x r)) else
  bind (hi-bound (hi-core (cons x r))) (λ b → ret (if b then list-append (hi-a rd (hi-core (cons x r)) (hi-core (cons x r))) (s-esc (h-drop-n (list-length (hi-core (cons x r))) (cons x r))) else s-esc (cons x r)))
hi-each : List (List Word) → (List Word → Proc W (List Word)) → Proc W (List Word)
hi-each nil k = ret nil
hi-each (cons x r) k = bind (k x) (λ a → bind (hi-each r k) (λ b → ret (list-append a b)))
-- the names among a text's tokens (each token's core, when the token is made of name characters)
hi-cores : List (List Word) → List (List Word)
hi-cores nil = nil
hi-cores (cons nil r) = hi-cores r
hi-cores (cons (cons c cs) r) = if orB (h-not (hi-ident-char c)) (h-null (hi-core (cons c cs))) then hi-cores r else cons (hi-core (cons c cs)) (hi-cores r)
-- a sorted list with each run of equal entries kept once
hi-uniq : List (List Word) → List (List Word)
hi-uniq nil = nil
hi-uniq (cons x nil) = cons x nil
hi-uniq (cons x (cons y r)) = if h-eq x y then hi-uniq (cons y r) else cons x (hi-uniq (cons y r))
-- of the names, those the source binds (or holds a module or document at)
hi-bound-of : List (List Word) → Proc W (List (List Word))
hi-bound-of nil = ret nil
hi-bound-of (cons n r) = bind (hi-bound n) (λ b → bind (hi-bound-of r) (λ rest → ret (if b then cons n rest else rest)))
-- a token as the page shows it, given the names the source binds
hi-link-in : List Word → List (List Word) → List Word → List Word
hi-link-in rd bs nil = nil
hi-link-in rd bs (cons x r) = if orB (h-not (hi-ident-char x)) (h-null (hi-core (cons x r))) then s-esc (cons x r) else
  if h-has (hi-core (cons x r)) bs then list-append (hi-a rd (hi-core (cons x r)) (hi-core (cons x r))) (s-esc (h-drop-n (list-length (hi-core (cons x r))) (cons x r))) else s-esc (cons x r)
hi-link-in-example : hi-link-in "r" (cons "a-b" nil) "a-b." ≡ list-append (hi-a "r" "a-b" "a-b") "."
hi-link-in-example = refl
hi-uniq-example : hi-uniq (h-msort (cons "b" (cons "a" (cons "b" (cons "a" nil))))) ≡ cons "a" (cons "b" nil)
hi-uniq-example = refl
-- a text with every name the source binds made a way into it: each distinct name looked up once (a text of
-- 531 name tokens is a few dozen distinct names), then every token drawn
hi-linked : List Word → List Word → Proc W (List Word)
hi-linked rd t = bind (hi-bound-of (hi-uniq (h-msort (hi-cores (hi-toks nil t))))) (λ bs → ret (h-concat (list-map (hi-link-in rd bs) (hi-toks nil t))))
hi-pre : List Word → List Word → Proc W (List Word)
hi-pre rd t = bind (hi-linked rd t) (λ x → ret (list-append "<pre>" (list-append x "</pre>")))
-- the workflow's relations, from STORE/views/nodes: each node and what it is part of
hi-rows : List Word → List (List (List Word))
hi-rows t = list-map (h-split #32) (h-lines t)
hi-first : List (List Word) → List Word
hi-first nil = nil
hi-first (cons x r) = x
hi-parents : List (List (List Word)) → List Word → List (List Word)
hi-parents nil f = nil
hi-parents (cons row r) f = if h-eq (hi-first row) f then h-tail-lists row else hi-parents r f
hi-children : List (List (List Word)) → List Word → List (List Word)
hi-children nil f = nil
hi-children (cons row r) f = if h-has f (h-tail-lists row) then cons (hi-first row) (hi-children r f) else hi-children r f
hi-rows-example : List (List (List Word))
hi-rows-example = hi-rows (h-concat (cons (h-line "a") (cons (h-line "b a") (cons (h-line "c a b") nil))))
hi-parents-example : hi-parents hi-rows-example "c" ≡ cons "a" (cons "b" nil)
hi-parents-example = refl
hi-children-example : hi-children hi-rows-example "a" ≡ cons "b" (cons "c" nil)
hi-children-example = refl
hi-around : List (List (List Word)) → List Word → List (List Word)
hi-around rows n = list-append (hi-parents rows n) (hi-children rows n)
hi-outside : List (List Word) → List (List Word) → List (List Word)
hi-outside ex nil = nil
hi-outside ex (cons x r) = if h-has x ex then hi-outside ex r else cons x (hi-outside ex r)
hi-show : List Word → List Word → Proc W (Sum Unit (List Word))
hi-show st n = h-read (list-append st (list-append "/views/show-" (h-hex n)))
hi-sentence : Sum Unit (List Word) → List Word
hi-sentence s = h-trim (hi-first (h-tail-lists (h-lines (s-or nil s))))
-- each value's own transition name, so a value moving between scenes is drawn moving
hi-vt : List Word → List Word
hi-vt n = list-append "view-transition-name:v" (h-hex n)
hi-card : List Word → List Word → List Word → Proc W (List Word)
hi-card st rd n = bind (hi-show st n) (λ s → ret (h-concat (cons "<div class='card' style='" (cons (hi-vt n) (cons "'>" (cons (hi-a rd n n) (cons "<div class='s'>" (cons (s-esc (hi-sentence s)) (cons "</div></div>" nil)))))))))
hi-chip : List Word → List Word → List Word
hi-chip rd n = list-append "<span class='chip'>" (list-append (hi-a rd n n) "</span>")
hi-sect : List Word → List Word → List Word
hi-sect label x = if h-null x then nil else h-concat (cons "<div class='label'>" (cons label (cons "</div><div class='row'>" (cons x (cons "</div>" nil)))))
-- what each node holds as essential context, as lines "DOCUMENT NODE": every essential-context line of a node's
-- view, direct or inherited ("essential context: DOC  (from NODE)")
hi-ctx-lines : List Word → List (List Word) → List (List Word)
hi-ctx-lines n nil = nil
hi-ctx-lines n (cons l r) = if h-infix "essential context: " l then cons (list-append (h-before "  " (h-after "essential context: " l)) (cons #32 n)) (hi-ctx-lines n r) else hi-ctx-lines n r
hi-ctx-lines-example : hi-ctx-lines "a" (cons "  essential context: docs/x.md  (from b)" (cons "  part of b" nil)) ≡ cons "docs/x.md a" nil
hi-ctx-lines-example = refl
hi-ctx-build : List Word → List (List Word) → Proc W (List (List Word))
hi-ctx-build st nil = ret nil
hi-ctx-build st (cons n r) = bind (hi-show st n) (λ s → bind (hi-ctx-build st r) (λ rest → ret (list-append (hi-ctx-lines n (h-lines (s-or nil s))) rest)))
-- the index kept in the store (STORE/hi/context-STAMP), made once for each state of the views (views/stamp) and
-- read whole after
hi-ctx-or : List Word → List (List Word) → List Word → Sum Unit (List Word) → Proc W (List (List Word))
hi-ctx-or st ns s (inr t) = ret (h-lines t)
hi-ctx-or st ns s (inl u) = bind (hi-ctx-build st ns) (λ es → bind (h-mkdir (list-append st "/hi")) (λ m →
  bind (h-write (list-append st (list-append "/hi/context-" (h-hex s))) (h-concat (list-map h-line es))) (λ w → ret es)))
hi-ctx-index : List Word → List (List Word) → Proc W (List (List Word))
hi-ctx-index st ns = bind (h-read (list-append st "/views/stamp")) (λ s → bind (h-read (list-append st (list-append "/hi/context-" (h-hex (s-or nil s))))) (λ ix → hi-ctx-or st ns (s-or nil s) ix))
-- the nodes the index gives a document as essential context of
hi-ctx-nodes : List Word → List (List Word) → List (List Word)
hi-ctx-nodes f nil = nil
hi-ctx-nodes f (cons e r) = if h-eq (h-before " " e) f then cons (h-after " " e) (hi-ctx-nodes f r) else hi-ctx-nodes f r
-- the nodes a document is essential context of, from the index
hi-context-of : List Word → List Word → List Word → List (List Word) → Proc W (List Word)
hi-context-of st rd f ns = bind (hi-ctx-index st ns) (λ ix → hi-each (hi-uniq (h-msort (hi-ctx-nodes f ix))) (hi-card st rd))
hi-piece : Sum Unit (List Word) → Proc W (Sum Unit (List Word))
hi-piece (inl u) = ret (inl unit)
hi-piece (inr h) = h-read (list-append h-source (cons #47 (list-append (h-before (cons #10 nil) h) "/text")))
-- a name's code: the piece the source has written for it (the name index lives in h-index since the view, 2026-11-18)
hi-code : List Word → Proc W (Sum Unit (List Word))
hi-code n = bind (h-read (list-append h-index (list-append "/written/" (h-hex n)))) hi-piece
-- a selection essay (lib/selection.cub) as it reads: the lines of its source piece, NAME-source = lines-of
-- (cons "line" ...), a line holding quotation marks given as (quoted (cons "stretch" ...)), joined by them.
-- The state: outside a quoted line, or inside one with its open parentheses counted and its text so far
s-q-join : Sum Unit (List Word) → List Word → List Word
s-q-join (inl u) s = s
s-q-join (inr a) s = list-append a (cons #34 s)
s-src-str : (Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)) → Sum Unit (Nat × Sum Unit (List Word)) → Sum Unit (List Word × List Word) → List (List Word)
s-src-str k q (inl u) = nil
s-src-str k (inl u) (inr p) = cons (fst p) (k (inl unit) (snd p))
s-src-str k (inr g) (inr p) = k (inr (fst g , inr (s-q-join (snd g) (fst p)))) (snd p)
-- a citation in an essay's source, (cite NAME "words") (lib/selection.cub), as the page draws it: the words,
-- linked to NAME's place in the human interface. The reference is the definition the checker resolved, so
-- the link cannot point at nothing; the words are exactly what every projection of the text shows (cite-shows).
s-cite-md : List Word → List Word → List Word
s-cite-md n w = h-concat (cons "[" (cons w (cons "](" (cons (hi-href nil n) (cons ")" nil)))))
s-src-cite-at : (Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)) → List Word → Sum Unit (List Word × List Word) → List (List Word)
s-src-cite-at k n (inl u) = k (inl unit) nil
s-src-cite-at k n (inr p) = cons (s-cite-md n (fst p)) (k (inl unit) (snd p))
s-src-cite-q : (Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)) → List Word → Sum Unit (List Word × List Word) → List (List Word)
s-src-cite-q k n (inl u) = k (inl unit) nil
s-src-cite-q k n (inr p) = s-src-cite-at k n (s-upto #34 (snd p))
-- after "(cite ": the cited name up to the space, then the quoted words
s-src-cite : (Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)) → Sum Unit (List Word × List Word) → List (List Word)
s-src-cite k (inl u) = k (inl unit) nil
s-src-cite k (inr p) = s-src-cite-q k (fst p) (s-upto #34 (snd p))
s-src-open : (Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)) → Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)
s-src-open k (inl u) r = if h-prefix "quoted" r then k (inr (suc zero , inl unit)) r else if h-prefix "cite " r then s-src-cite k (s-upto #32 (h-drop "cite " r)) else k (inl u) r
s-src-open k (inr g) r = k (inr (suc (fst g) , snd g)) r
s-src-close-at : (Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)) → Nat → Sum Unit (List Word) → List Word → List (List Word)
s-src-close-at k zero a r = k (inl unit) r
s-src-close-at k (suc zero) a r = cons (s-or nil a) (k (inl unit) r)
s-src-close-at k (suc (suc n)) a r = k (inr (suc n , a)) r
s-src-close : (Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)) → Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)
s-src-close k (inl u) r = k (inl u) r
s-src-close k (inr g) r = s-src-close-at k (fst g) (snd g) r
s-src-lines : Nat → Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)
s-src-lines zero q t = nil
s-src-lines (suc f) q nil = nil
s-src-lines (suc f) q (cons x r) = if weq x #34 then s-src-str (s-src-lines f) q (s-upto #34 r)
  else if weq x #40 then s-src-open (s-src-lines f) q r else if weq x #41 then s-src-close (s-src-lines f) q r else s-src-lines f q r
s-src-example-in : List Word
s-src-example-in = h-concat (cons "x = lines-of (cons " (cons (cons #34 nil) (cons "# T" (cons (cons #34 nil) (cons " (cons (quoted (cons " (cons (cons #34 nil) (cons "a " (cons (cons #34 nil) (cons " (cons " (cons (cons #34 nil) (cons "b" (cons (cons #34 nil) (cons " nil))) nil))" nil)))))))))))))
-- the lines are read back exactly, a quoted line with its quotation mark
s-src-lines-example : Path (List (List Word)) (s-src-lines (toNat #400) (inl unit) s-src-example-in) (cons "# T" (cons (list-append "a " (cons #34 "b")) nil))
s-src-lines-example = refl
s-src-cite-example-in : List Word
s-src-cite-example-in = h-concat (cons "x = lines-of (cons " (cons (cons #34 nil) (cons "a" (cons (cons #34 nil) (cons " (cons (cite s10-5-p2 " (cons (cons #34 nil) (cons "the words" (cons (cons #34 nil) (cons ") nil))" nil)))))))))
-- a citation is drawn as its words linked to the cited definition, and the lines around it are kept
s-src-cite-example : Path (List (List Word)) (s-src-lines (toNat #400) (inl unit) s-src-cite-example-in) (cons "a" (cons "[the words](/hi?reader=&focus=s10-5-p2)" nil))
s-src-cite-example = refl
-- an essay's source is either its lines written out (lines-of (cons "line" ...)) or, since the essays were
-- re-cut into runs (2026-11-18), lines-of over its runs NAME-lines-1, NAME-lines-2, ...: the run names are
-- read from the source piece in order, and each run's lines from its own piece
s-unparen : List Word → List Word
s-unparen nil = nil
s-unparen (cons x r) = if orB (weq x #40) (weq x #41) then s-unparen r else cons x (s-unparen r)
s-nl-sp : List Word → List Word
s-nl-sp nil = nil
s-nl-sp (cons x r) = cons (if weq x #10 then #32 else x) (s-nl-sp r)
s-run-names : List Word → List (List Word) → List (List Word)
s-run-names base nil = nil
s-run-names base (cons w r) = if h-prefix (list-append base "-lines-") (s-unparen w) then cons (s-unparen w) (s-run-names base r) else s-run-names base r
s-piece-lines : Sum Unit (List Word) → List (List Word)
s-piece-lines (inl u) = nil
s-piece-lines (inr t) = s-src-lines (list-length t) (inl unit) t
s-runs-lines : List (List Word) → Proc W (List (List Word))
s-runs-lines nil = ret nil
s-runs-lines (cons n r) = bind (hi-code n) (λ c → bind (s-runs-lines r) (λ rest → ret {lzero} {W} (list-append (s-piece-lines c) rest)))
s-no-runs : List (List Word) → Bool
s-no-runs nil = true
s-no-runs (cons x r) = false
s-essay-lines-of : List Word → Sum Unit (List Word) → Proc W (List (List Word))
s-essay-lines-of base (inl u) = ret nil
s-essay-lines-of base (inr t) = if s-no-runs (s-run-names base (h-split #32 (s-nl-sp t))) then ret {lzero} {W} (s-piece-lines (inr t)) else s-runs-lines (s-run-names base (h-split #32 (s-nl-sp t)))
s-essay-lines : List Word → Proc W (List (List Word))
s-essay-lines p = bind (hi-code (list-append (h-before ".cub" (h-drop "docs/" p)) "-source")) (s-essay-lines-of (h-before ".cub" (h-drop "docs/" p)))
-- /doc of a selection essay: its source's lines as a page; any other .cub document as its text
s-essay-of : List Word → List (List Word) → Proc W (List Word)
s-essay-of p ls = if s-no-runs ls then s-doc p else ret {lzero} {W} (s-response s-html (s-page-as true p (h-concat (list-map h-line ls))))
s-essay : List Word → Proc W (List Word)
s-essay p = bind (s-essay-lines p) (s-essay-of p)
-- /corpus: every text the site serves (the writing, the papers in the source, the records, the paper), as one
-- JSON list of {h: where it is read, t: its title, x: its text}, so a reader's browser searches all of it at
-- once, as they type; a line break becomes a space, so no two words run together
s-cj-esc : List Word → List Word
s-cj-esc nil = nil
s-cj-esc (cons x r) = if orB (weq x #34) (weq x #92) then cons #92 (cons x (s-cj-esc r)) else if wlt x #32 then cons #32 (s-cj-esc r) else cons x (s-cj-esc r)
s-cj-str : List Word → List Word
s-cj-str s = cons #34 (list-append (s-cj-esc s) (cons #34 nil))
s-cj-esc-example : Path (List Word) (s-cj-str (h-concat (cons "a" (cons (cons #10 nil) (cons (cons #34 nil) nil))))) (h-concat (cons (cons #34 nil) (cons "a " (cons (cons #92 (cons #34 nil)) (cons (cons #34 nil) nil)))))
s-cj-esc-example = refl
s-corpus-item : List Word → List Word → List Word → List Word
s-corpus-item href title text = h-concat (cons "{" (cons (s-cj-str "h") (cons ":" (cons (s-cj-str href) (cons "," (cons (s-cj-str "t") (cons ":" (cons (s-cj-str title) (cons "," (cons (s-cj-str "x") (cons ":" (cons (s-cj-str text) (cons "}" nil)))))))))))))
