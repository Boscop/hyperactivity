-- Emit a 2:1 mux in BLIF: `.names <sel> <a> <b> <out>\n01- 1\n1-1 1\n`
epfl-mux2-blif : List Word → List Word → List Word → List Word → List Word
epfl-mux2-blif sel a b out =
  sv-concat
    (cons ".names " (cons sel (cons " " (cons a (cons " " (cons b (cons " " (cons out (cons sv-nl
    (cons "01- 1" (cons sv-nl (cons "1-1 1" (cons sv-nl nil)))))))))))))
