-- the normal form of a body in a context: its variables given their types' structure, the
-- machine's normal form, a pass of transport and composition steps, and all three again until
-- nothing changes (a step can leave a variable where its structure is needed again)
nk-norm-in-it : Nat → NkTm → Word → NkTm → NkTm
nk-norm-in-it zero ctx n t = nk-nf (toNat #30000) (nk-rf (toNat #60) false ctx n t nk-nil)
nk-norm-in-it (suc k) ctx n t =
  if nk-tm-eq (nk-kan (nk-nf (toNat #30000) (nk-rf (toNat #60) false ctx n t nk-nil))) (nk-nf (toNat #30000) (nk-rf (toNat #60) false ctx n t nk-nil))
  then nk-nf (toNat #30000) (nk-rf (toNat #60) false ctx n t nk-nil)
  else nk-norm-in-it k ctx n (nk-kan (nk-nf (toNat #30000) (nk-rf (toNat #60) false ctx n t nk-nil)))
