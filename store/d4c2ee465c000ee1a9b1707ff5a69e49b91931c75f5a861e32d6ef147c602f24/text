-- ============================================================================
-- SECTION 1: EXACT ADDITION-COUNT & MULTIPLY-SAVINGS METRICS (0 POSTULATES)
-- ============================================================================

tr-re-adds : RExpr → Word
tr-re-adds (re-k _)     = #0
tr-re-adds (re-v _)     = #0
tr-re-adds (re-add a b) = %wadd #1 (%wadd (tr-re-adds a) (tr-re-adds b))
tr-re-adds (re-sub a b) = %wadd #1 (%wadd (tr-re-adds a) (tr-re-adds b))
tr-re-adds (re-mul a b) = %wadd (tr-re-adds a) (tr-re-adds b)

tr-lets-adds : List (Word × RExpr) → Word
tr-lets-adds nil = #0
tr-lets-adds (cons b bs) = %wadd (tr-re-adds (snd b)) (tr-lets-adds bs)

tr-outs-adds : List RExpr → Word
tr-outs-adds nil = #0
tr-outs-adds (cons e es) = %wadd (tr-re-adds e) (tr-outs-adds es)

tr-rp-adds : RProg → Word
tr-rp-adds (rprog _ lets outs) = %wadd (tr-lets-adds lets) (tr-outs-adds outs)

-- Exact addition-only small-integer scaling helpers (ZERO extra multiplications!)
tr-dbl : RExpr → RExpr
tr-dbl x = re-add x x

tr-x3 : RExpr → RExpr
tr-x3 x = re-add x (re-add x x)

tr-x4 : RExpr → RExpr
tr-x4 x = tr-dbl (tr-dbl x)

tr-x6 : RExpr → RExpr
tr-x6 x = tr-dbl (tr-x3 x)

tr-x12 : RExpr → RExpr
tr-x12 x = tr-dbl (tr-x6 x)

-- ============================================================================
-- SECTION 2: STRASSEN 1969 & WINOGRAD-STRASSEN 2x2 MATRIX MULTIPLY (8 -> 7 MULS)
-- ============================================================================
-- Inputs: A = [[v0, v1], [v2, v3]],  B = [[v4, v5], [v6, v7]]
-- Outputs: C = A * B = [C00, C01, C10, C11]

tr-matmul2-spec : RProg
tr-matmul2-spec =
  rprog #8 nil
    (cons (re-add (re-mul (re-v #0) (re-v #4)) (re-mul (re-v #1) (re-v #6)))
    (cons (re-add (re-mul (re-v #0) (re-v #5)) (re-mul (re-v #1) (re-v #7)))
    (cons (re-add (re-mul (re-v #2) (re-v #4)) (re-mul (re-v #3) (re-v #6)))
    (cons (re-add (re-mul (re-v #2) (re-v #5)) (re-mul (re-v #3) (re-v #7))) nil))))

-- 1. Classic Strassen 1969: 7 muls, 18 adds (v8..v14 = M1..M7)
tr-strassen-cand : RProg
tr-strassen-cand =
  rprog #8
    (cons (#8  , re-mul (re-add (re-v #0) (re-v #3)) (re-add (re-v #4) (re-v #7)))
    (cons (#9  , re-mul (re-add (re-v #2) (re-v #3)) (re-v #4))
    (cons (#10 , re-mul (re-v #0) (re-sub (re-v #5) (re-v #7)))
    (cons (#11 , re-mul (re-v #3) (re-sub (re-v #6) (re-v #4)))
    (cons (#12 , re-mul (re-add (re-v #0) (re-v #1)) (re-v #7))
    (cons (#13 , re-mul (re-sub (re-v #2) (re-v #0)) (re-add (re-v #4) (re-v #5)))
    (cons (#14 , re-mul (re-sub (re-v #1) (re-v #3)) (re-add (re-v #6) (re-v #7))) nil)))))))
    (cons (re-add (re-sub (re-add (re-v #8) (re-v #11)) (re-v #12)) (re-v #14))
    (cons (re-add (re-v #10) (re-v #12))
    (cons (re-add (re-v #9) (re-v #11))
    (cons (re-add (re-add (re-sub (re-v #8) (re-v #9)) (re-v #10)) (re-v #13)) nil))))

-- THEOREM 1: STRASSEN 1969 UNIVERSAL RING EQUIVALENCE & 7 <= 8 MULS BY `refl`!
cert-strassen-2x2 : PolyOptCert
cert-strassen-2x2 = mk-poly-cert "strassen_2x2" tr-matmul2-spec tr-strassen-cand refl refl

