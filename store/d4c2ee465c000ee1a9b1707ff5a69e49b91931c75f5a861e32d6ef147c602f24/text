    (cons (#15 , re-sub (re-v #13) (re-v #6))
    (cons (#16 , re-mul (re-v #0) (re-v #4))
    (cons (#17 , re-mul (re-v #1) (re-v #6))
    (cons (#18 , re-mul (re-v #11) (re-v #7))
    (cons (#19 , re-mul (re-v #3) (re-v #15))
    (cons (#20 , re-mul (re-v #8) (re-v #12))
    (cons (#21 , re-mul (re-v #9) (re-v #13))
    (cons (#22 , re-mul (re-v #10) (re-v #14))
    (cons (#23 , re-add (re-v #16) (re-v #21))
    (cons (#24 , re-add (re-v #23) (re-v #22))
