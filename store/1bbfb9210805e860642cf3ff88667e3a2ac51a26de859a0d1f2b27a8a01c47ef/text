ke-opt-bin-sound : (env : Word → Word) → (op : Word → Word → Word) → (ctor : KExpr → KExpr → KExpr) →
  ((x y : KExpr) → keval env (ctor x y) ≡ op (keval env x) (keval env y)) →
  (a b : KExpr) → op (keval env a) (keval env b) ≡ keval env (ke-opt-bin op ctor a b)
ke-opt-bin-sound _   _  _    _  (ke-k _)       (ke-k _)       = refl
ke-opt-bin-sound env op ctor hc (ke-k a)       (ke-v b)       = ke-sym-w (hc (ke-k a) (ke-v b))
ke-opt-bin-sound env op ctor hc (ke-k a)       (ke-not b)     = ke-sym-w (hc (ke-k a) (ke-not b))
ke-opt-bin-sound env op ctor hc (ke-k a)       (ke-xor b c)   = ke-sym-w (hc (ke-k a) (ke-xor b c))
ke-opt-bin-sound env op ctor hc (ke-k a)       (ke-and b c)   = ke-sym-w (hc (ke-k a) (ke-and b c))
ke-opt-bin-sound env op ctor hc (ke-k a)       (ke-or  b c)   = ke-sym-w (hc (ke-k a) (ke-or b c))
ke-opt-bin-sound env op ctor hc (ke-k a)       (ke-add b c)   = ke-sym-w (hc (ke-k a) (ke-add b c))
ke-opt-bin-sound env op ctor hc (ke-k a)       (ke-sub b c)   = ke-sym-w (hc (ke-k a) (ke-sub b c))
ke-opt-bin-sound env op ctor hc (ke-k a)       (ke-mul b c)   = ke-sym-w (hc (ke-k a) (ke-mul b c))
ke-opt-bin-sound env op ctor hc (ke-k a)       (ke-rotr b n)  = ke-sym-w (hc (ke-k a) (ke-rotr b n))
ke-opt-bin-sound env op ctor hc (ke-k a)       (ke-ch b c d)  = ke-sym-w (hc (ke-k a) (ke-ch b c d))
ke-opt-bin-sound env op ctor hc (ke-k a)       (ke-maj b c d) = ke-sym-w (hc (ke-k a) (ke-maj b c d))
ke-opt-bin-sound env op ctor hc (ke-v i)       b              = ke-sym-w (hc (ke-v i) b)
ke-opt-bin-sound env op ctor hc (ke-not a)     b              = ke-sym-w (hc (ke-not a) b)
ke-opt-bin-sound env op ctor hc (ke-xor a1 a2) b              = ke-sym-w (hc (ke-xor a1 a2) b)
ke-opt-bin-sound env op ctor hc (ke-and a1 a2) b              = ke-sym-w (hc (ke-and a1 a2) b)
ke-opt-bin-sound env op ctor hc (ke-or  a1 a2) b              = ke-sym-w (hc (ke-or a1 a2) b)
ke-opt-bin-sound env op ctor hc (ke-add a1 a2) b              = ke-sym-w (hc (ke-add a1 a2) b)
ke-opt-bin-sound env op ctor hc (ke-sub a1 a2) b              = ke-sym-w (hc (ke-sub a1 a2) b)
ke-opt-bin-sound env op ctor hc (ke-mul a1 a2) b              = ke-sym-w (hc (ke-mul a1 a2) b)
ke-opt-bin-sound env op ctor hc (ke-rotr a n)  b              = ke-sym-w (hc (ke-rotr a n) b)
ke-opt-bin-sound env op ctor hc (ke-ch a1 a2 a3) b            = ke-sym-w (hc (ke-ch a1 a2 a3) b)
ke-opt-bin-sound env op ctor hc (ke-maj a1 a2 a3) b           = ke-sym-w (hc (ke-maj a1 a2 a3) b)
