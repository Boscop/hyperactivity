gmf-thm-bus-bot-left : (x : TIRBusState) → gmf-bus-join gmf-bus-bot x ≡ x
gmf-thm-bus-bot-left (mk-bus-state p e s w) = refl

gmf-thm-bus-bot-right : (x : TIRBusState) → gmf-bus-join x gmf-bus-bot ≡ x
gmf-thm-bus-bot-right (mk-bus-state p e s w) =
  λ i → mk-bus-state (gmf-bits-id-r p i) (gmf-max-id-r e i) (gmf-max-id-r s i) (gmf-max-id-r w i)

gmf-thm-bus-idem : (x : TIRBusState) → gmf-bus-join x x ≡ x
gmf-thm-bus-idem (mk-bus-state p e s w) =
  λ i → mk-bus-state (gmf-bits-idem p i) (ml-thm-max-idem e i) (ml-thm-max-idem s i) (ml-thm-max-idem w i)

gmf-thm-bus-comm : (a b : TIRBusState) → gmf-bus-join a b ≡ gmf-bus-join b a
gmf-thm-bus-comm (mk-bus-state p1 e1 s1 w1) (mk-bus-state p2 e2 s2 w2) =
  λ i → mk-bus-state (gmf-bits-comm p1 p2 i) (ml-thm-max-comm e1 e2 i) (ml-thm-max-comm s1 s2 i) (ml-thm-max-comm w1 w2 i)

gmf-thm-bus-assoc : (a b c : TIRBusState) →
