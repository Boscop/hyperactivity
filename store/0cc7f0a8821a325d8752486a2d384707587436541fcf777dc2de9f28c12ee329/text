-- Pure scanner recognizing BOTH UTF-8 `≡` (`226 137 161`) AND ASCII ` == ` (`32 61 61 32`) equations!
gmf-scan-bytes-pure : Word → Word → Word → Word → Word → Word → Word → List Word → Word × (Word × Word)
gmf-scan-bytes-pure flg b3 b2 b1 eqC rfC fgC nil =
  let eqC2 = if %weq (%wand flg #1) #1 then %wsucc eqC else eqC
      rfC2 = if %weq (%wand flg #2) #2 then %wsucc rfC else rfC
  in (eqC2 , (rfC2 , fgC))
gmf-scan-bytes-pure flg b3 b2 b1 eqC rfC fgC (cons b bs) =
  let isUtfEq = andB (%weq b2 #226) (andB (%weq b1 #137) (%weq b #161))
      isAscEq = andB (%weq b3 #32)  (andB (%weq b2 #61)  (andB (%weq b1 #61) (%weq b #32)))
      isRefl  = andB (%weq b3 #114) (andB (%weq b2 #101) (andB (%weq b1 #102) (%weq b #108)))
      f1      = if orB isUtfEq isAscEq then %wor flg #1 else flg
      f2      = if isRefl then %wor f1 #2 else f1
  in if %weq b #10 then
       let eqC2 = if %weq (%wand f2 #1) #1 then %wsucc eqC else eqC
           rfC2 = if %weq (%wand f2 #2) #2 then %wsucc rfC else rfC
       in gmf-scan-bytes-pure #0 #0 #0 #0 eqC2 rfC2 fgC bs
     else gmf-scan-bytes-pure f2 b2 b1 b eqC rfC fgC bs

