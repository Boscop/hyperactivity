    inr pkt → gmf-pkt-to-bus slot pkt

gmf-fold-bus : List TIRBusState → TIRBusState
gmf-fold-bus nil         = gmf-bus-bot
gmf-fold-bus (cons s ss) = gmf-bus-join s (gmf-fold-bus ss)

