gmf-bus-bot : TIRBusState
gmf-bus-bot = mk-bus-state nil zero zero zero

gmf-bus-join : TIRBusState → TIRBusState → TIRBusState
gmf-bus-join (mk-bus-state p1 e1 s1 w1) (mk-bus-state p2 e2 s2 w2) =
  mk-bus-state (gmf-bits-join p1 p2) (ml-max e1 e2) (ml-max s1 s2) (ml-max w1 w2)

gmf-max-id-r : (a : Nat) → ml-max a zero ≡ a
gmf-max-id-r zero    = refl
gmf-max-id-r (suc a) = refl

