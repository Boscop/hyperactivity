  let tpath = h-concat (cons gmf-brain-root (cons "/" (cons cid (cons "/.system_generated/logs/transcript.jsonl" nil))))
  in bind (h-file-time tpath) (λ mt →
     bind (gmf-harvest-cids nowSec cids acc) (λ rest →
       let recent = andB (%wlt #0 mt) (%wlt (%wsub nowSec mt) #5400)
       in if not recent
          then ret {lzero} {W} rest
          else
            bind (h-read tpath) (λ mr →
              case mr of
                inl u   → ret {lzero} {W} rest
                inr txt →
                  let found  = gmf-scan-ureqs txt false zero zero nil nil
                      merged = h-dedupe (list-append found (fst rest))
                  in ret {lzero} {W} (merged , %wsucc (snd rest)))))

