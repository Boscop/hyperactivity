-- 3A. Checked Metacircular `Code` Evaluator (`gmf-eval-code`), `clet` DAG Hyperfactoring (`S + k < k * S`),
--     & `Code -> Code` Redex Optimizer directly over `lib/code.hypercubical`'s `Code` AST!
gmf-env-at : List Word → Word → Word
gmf-env-at nil         idx = #0
gmf-env-at (cons x xs) idx = if %weq idx #0 then x else gmf-env-at xs (%wsub idx #1)

gmf-eval-wop : Word → Word → Word → Word
gmf-eval-wop k x y =
  if %weq k #2 then %wadd x y
  else if %weq k #4 then %wsub x y
  else if %weq k #5 then %wmul x y
  else if %weq k #10 then %wxor x y
  else #0

-- Typed structural metacircular evaluator over kernel `Code` (`Code` first for strict structural recursion!):
gmf-eval-code2 : Code → (Word → Word) → List Word → Word × Word
gmf-eval-code2 (cwlit n)    vEnv lEnv = (n , #0)
gmf-eval-code2 (cvar idx)   vEnv lEnv = (gmf-env-at lEnv idx , #0)
gmf-eval-code2 (cwsucc a)   vEnv lEnv = (%wsucc (fst (gmf-eval-code2 a vEnv lEnv)) , #0)
gmf-eval-code2 (cwop k a b) vEnv lEnv =
  (gmf-eval-wop k (fst (gmf-eval-code2 a vEnv lEnv)) (fst (gmf-eval-code2 b vEnv lEnv)) , #0)
gmf-eval-code2 (clet t b)   vEnv lEnv =
  gmf-eval-code2 b vEnv (cons (fst (gmf-eval-code2 t vEnv lEnv)) lEnv)
gmf-eval-code2 (cann t ty)  vEnv lEnv = gmf-eval-code2 t vEnv lEnv
gmf-eval-code2 (cpair a b)  vEnv lEnv =
  (fst (gmf-eval-code2 a vEnv lEnv) , fst (gmf-eval-code2 b vEnv lEnv))
gmf-eval-code2 (cfst p)     vEnv lEnv = (fst (gmf-eval-code2 p vEnv lEnv) , #0)
gmf-eval-code2 (csnd p)     vEnv lEnv = (snd (gmf-eval-code2 p vEnv lEnv) , #0)
gmf-eval-code2 (capp f a)   vEnv lEnv = (vEnv (fst (gmf-eval-code2 a vEnv lEnv)) , #0)
gmf-eval-code2 other        vEnv lEnv = (#0 , #0)

gmf-eval-code : (Word → Word) → List Word → Code → Word
gmf-eval-code vEnv lEnv c = fst (gmf-eval-code2 c vEnv lEnv)

gmf-quote-vhterm : VHTerm → Code
gmf-quote-vhterm (vt-var i)   = capp (cglob #0) (cwlit i)
gmf-quote-vhterm (vt-ref r)   = cwlit #0
gmf-quote-vhterm (vt-add a b) = cwop #2  (gmf-quote-vhterm a) (gmf-quote-vhterm b)
gmf-quote-vhterm (vt-mul a b) = cwop #5  (gmf-quote-vhterm a) (gmf-quote-vhterm b)
gmf-quote-vhterm (vt-xor a b) = cwop #10 (gmf-quote-vhterm a) (gmf-quote-vhterm b)

-- UNIVERSAL THEOREM 3A (METACIRCULAR `Code` QUOTATION <-> `gmf-eval-code` EXACTNESS FOR ALL `vEnv` & `VHTerm`):
gmf-thm-metacircular-quote-eval :
  (vEnv : Word → Word) → (t : VHTerm) →
  gmf-eval-code vEnv nil (gmf-quote-vhterm t) ≡ vh-eval-tree vEnv t
gmf-thm-metacircular-quote-eval vEnv (vt-var i)   = refl
gmf-thm-metacircular-quote-eval vEnv (vt-ref r)   = refl
gmf-thm-metacircular-quote-eval vEnv (vt-add a b) =
  λ i → %wadd (gmf-thm-metacircular-quote-eval vEnv a i)
              (gmf-thm-metacircular-quote-eval vEnv b i)
gmf-thm-metacircular-quote-eval vEnv (vt-mul a b) =
  λ i → %wmul (gmf-thm-metacircular-quote-eval vEnv a i)
              (gmf-thm-metacircular-quote-eval vEnv b i)
gmf-thm-metacircular-quote-eval vEnv (vt-xor a b) =
  λ i → %wxor (gmf-thm-metacircular-quote-eval vEnv a i)
              (gmf-thm-metacircular-quote-eval vEnv b i)

gmf-code-unboxed4 : Code → Code
gmf-code-unboxed4 sub = cwop #10 (cwop #2 sub sub) (cwop #5 sub sub)

gmf-code-clet-boxed4 : Code → Code
gmf-code-clet-boxed4 sub =
  clet sub (cwop #10 (cwop #2 (cvar #0) (cvar #0)) (cwop #5 (cvar #0) (cvar #0)))

gmf-code-size : Code → Word
gmf-code-size (capp f a)   = %wsucc (%wadd (gmf-code-size f) (gmf-code-size a))
gmf-code-size (clam b)     = %wsucc (gmf-code-size b)
gmf-code-size (cpair a b)  = %wsucc (%wadd (gmf-code-size a) (gmf-code-size b))
gmf-code-size (cfst p)     = %wsucc (gmf-code-size p)
gmf-code-size (csnd p)     = %wsucc (gmf-code-size p)
gmf-code-size (clet t b)   = %wsucc (%wadd (gmf-code-size t) (gmf-code-size b))
gmf-code-size (cwop k a b) = %wsucc (%wadd (gmf-code-size a) (gmf-code-size b))
gmf-code-size (cwsucc a)   = %wsucc (gmf-code-size a)
gmf-code-size (cann t ty)  = %wsucc (gmf-code-size t)
gmf-code-size c            = #1

-- UNIVERSAL THEOREM 3B (`clet` SHARED-FIBER HYPERFACTORING FOR ALL `Code` ASTs `sub : Code`!):
gmf-thm-metacircular-clet-box :
  (vEnv : Word → Word) → (sub : Code) →
  gmf-eval-code vEnv nil (gmf-code-clet-boxed4 sub)
    ≡ gmf-eval-code vEnv nil (gmf-code-unboxed4 sub)
gmf-thm-metacircular-clet-box vEnv sub = refl

-- Higher-order `Code -> Code` metacircular redex optimizer (`cfst/csnd/cpair/cann`):
gmf-opt-fst : Code → Code
gmf-opt-fst (cpair a b) = a
gmf-opt-fst p           = cfst p

gmf-opt-snd : Code → Code
gmf-opt-snd (cpair a b) = b
gmf-opt-snd p           = csnd p

gmf-code-opt : Code → Code
gmf-code-opt (capp f a)   = capp (gmf-code-opt f) (gmf-code-opt a)
gmf-code-opt (clam b)     = clam (gmf-code-opt b)
gmf-code-opt (cpair a b)  = cpair (gmf-code-opt a) (gmf-code-opt b)
gmf-code-opt (cfst p)     = gmf-opt-fst (gmf-code-opt p)
gmf-code-opt (csnd p)     = gmf-opt-snd (gmf-code-opt p)
gmf-code-opt (cann t ty)  = gmf-code-opt t
gmf-code-opt (cwop k a b) = cwop k (gmf-code-opt a) (gmf-code-opt b)
gmf-code-opt c            = c

gmf-double-w : Word → Word
gmf-double-w x = %wadd x x

gmf-meta3-code : Code
gmf-meta3-code =
  cwop #2
    (cfst (cpair (cann (cwlit #21) cword) (cwlit #99)))
    (csnd (cpair (cwlit #77) (cann (cwlit #21) cword)))

-- THEOREM 3C (`Code` `clet` SHRINKS `63 -> 23` NODES & `gmf-code-opt` SHRINKS `11 -> 3` PRESERVING `42`!):
gmf-thm-metacircular-code-shrink-and-eval :
  let qCone = gmf-quote-vhterm vh-nock-cone7
