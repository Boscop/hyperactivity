gmf-lem-mk-not-sound env (gn-wire k)  = refl
gmf-lem-mk-not-sound env gn-era       = refl
gmf-lem-mk-not-sound env (gn-xor x y) = refl
gmf-lem-mk-not-sound env (gn-and x y) = refl
gmf-lem-mk-not-sound env (gn-not x)   = hn-sym (gmf-lem-bnot-bnot (gmf-net-eval env x))
gmf-lem-mk-not-sound env (gn-dup0 x)  = refl

gmf-thm-net-step-sound : (env : Word → Bool) → (n : GMFNet) →
  gmf-net-eval env (gmf-net-step n) ≡ gmf-net-eval env n
gmf-thm-net-step-sound env (gn-wire k)  = refl
gmf-thm-net-step-sound env gn-era       = refl
gmf-thm-net-step-sound env (gn-xor a b) =
