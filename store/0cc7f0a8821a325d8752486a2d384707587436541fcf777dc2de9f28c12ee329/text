gmf-thm-bus-assoc (mk-bus-state p1 e1 s1 w1) (mk-bus-state p2 e2 s2 w2) (mk-bus-state p3 e3 s3 w3) =
  λ i → mk-bus-state
          (gmf-bits-assoc p1 p2 p3 i)
          (ml-thm-max-assoc e1 e2 e3 i)
          (ml-thm-max-assoc s1 s2 s3 i)
          (ml-thm-max-assoc w1 w2 w3 i)

gmf-onehot-bit : Nat → List Bool
gmf-onehot-bit zero    = cons true nil
gmf-onehot-bit (suc k) = cons false (gmf-onehot-bit k)

gmf-cap-nat : Word → Nat
gmf-cap-nat w = toNat (hn-min-w w #256)

gmf-tb-peers : TIRBusState → List Bool
gmf-tb-peers (mk-bus-state p e s w) = p

gmf-tb-epoch : TIRBusState → Nat
gmf-tb-epoch (mk-bus-state p e s w) = e

gmf-pkt-to-bus : Nat → SovPkt → TIRBusState
gmf-pkt-to-bus slot (sov-pkt k sq tg pa pb pc) =
