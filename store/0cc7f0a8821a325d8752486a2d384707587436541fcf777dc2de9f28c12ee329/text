gmf-lem-mk-and-sound env (gn-not x)    (gn-and u v)  = refl
gmf-lem-mk-and-sound env (gn-not x)    (gn-not u)    = refl
gmf-lem-mk-and-sound env (gn-not x)    (gn-dup0 u)   = refl
gmf-lem-mk-and-sound env (gn-dup0 x)   gn-era = hn-sym (gmf-lem-band-0r (gmf-net-eval env (gn-dup0 x)))
gmf-lem-mk-and-sound env (gn-dup0 x)   (gn-wire j)   = refl
