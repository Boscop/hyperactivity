     (andB (%weq (gmf-code-size gmf-meta3-code) #11)
     (andB (%weq (gmf-code-size (gmf-code-opt gmf-meta3-code)) #3)
     (andB (%weq (gmf-eval-code gmf-double-w nil gmf-meta3-code) #42)
           (%weq (gmf-eval-code gmf-double-w nil (gmf-code-opt gmf-meta3-code)) #42))))) ≡ true
