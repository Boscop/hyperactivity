-- Physical 7nm CMOS Standard-Cell Master Generator (`100nm × 200nm`, `scale = #10` nm per grid unit):
cmos7-cell-boxes : Word → Word → List Gds6Box
cmos7-cell-boxes polyX1 polyX2 =
  cons (rect-to-gbox6 #1  #0 #10 (rect zero       (toNat #10) (toNat #10) (toNat #10)))  -- NWELL (y=100..200nm)
  (cons (rect-to-gbox6 #2  #0 #10 (rect (toNat #1) (toNat #12) (toNat #8)  (toNat #5)))   -- PDIFF (y=120..170nm)
  (cons (rect-to-gbox6 #2  #0 #10 (rect (toNat #1) (toNat #3)  (toNat #8)  (toNat #5)))   -- NDIFF (y=30..80nm)
  (cons (rect-to-gbox6 #3  #0 #10 (rect (toNat polyX1) (toNat #2) (toNat #1) (toNat #16))) -- POLY gate 1
  (cons (rect-to-gbox6 #3  #0 #10 (rect (toNat polyX2) (toNat #2) (toNat #1) (toNat #16))) -- POLY gate 2
  (cons (rect-to-gbox6 #4  #0 #10 (rect (toNat #5) (toNat #9)  (toNat #1)  (toNat #2)))   -- CONT output cut
  (cons (rect-to-gbox6 #11 #0 #10 (rect zero       zero        (toNat #10) (toNat #1)))   -- M1 VSS rail (y=0..10nm)
  (cons (rect-to-gbox6 #11 #0 #10 (rect zero       (toNat #19) (toNat #10) (toNat #1)))   -- M1 VDD rail (y=190..200nm)
  (cons (rect-to-gbox6 #12 #0 #10 (rect (toNat #2) (toNat #9)  (toNat #6)  (toNat #2))) nil)))))))) -- M1 Y pin (y=90..110nm)
