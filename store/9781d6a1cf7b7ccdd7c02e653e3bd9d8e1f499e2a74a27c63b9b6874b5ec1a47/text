export-hypernet16-mpw :
  List Word → List Word → List Word → Step W (Word × (Word × Word))
export-hypernet16-mpw rtlPath tbPath gdsPath =
  to-step {W} {Word × (Word × Word)}
    (bind (file-write-named rtlPath hypernet16-mpw-rtl-sv)      (λ nRtl →
     bind (file-write-named tbPath  sv-hypernet16-vs-rv32-tb)   (λ nTb  →
     bind (file-write-named gdsPath hypernet16-4x4-gds-bytes)   (λ nGds →
       ret {lzero} {W} (nRtl , (nTb , nGds))))))
