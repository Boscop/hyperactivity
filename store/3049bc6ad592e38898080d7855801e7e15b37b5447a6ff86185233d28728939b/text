rme32 : (proc_mode' : proc_mode) → (addr_size : ZI) → (eff_addr : Bits #64) → (base_reg : Option ZI) → (seg_reg : ZI) → (r_x : Text) → (check_alignment? : Bool) → (mem_ptr? : Bool) → MS (Bits #32)
rme32 proc_mode' addr_size eff_addr base_reg seg_reg r_x check_alignment? mem_ptr? =
  load_bytes_from_ea proc_mode' addr_size (zpos #4) eff_addr base_reg seg_reg r_x check_alignment? mem_ptr?
