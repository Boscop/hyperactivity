-- wire-boundary verification: any content-addressed sub-net payload arriving over the wire passes ca-check
wf-verify : {K V : Type} → (K → V → Bool) → WireFrame K V → WireFrame K V
wf-verify chk wf-era = wf-era
wf-verify chk (wf-con t a1 a2) = wf-con t a1 a2
wf-verify chk (wf-ref k arg pay) = wf-ref k arg (ca-check chk k pay)
