-- Σ ε q_IJK applied (Q_v without the constant Z)
qsum-apply : List Nat → List Triple → Mons → List SQ → List SQ
qsum-apply ds ts ms v = case ts of
  nil → vec-scale sq-zero v
  cons t rest → vec-plus (vec-scale (if snd (snd (snd t)) then sq-one else sq-neg sq-one) (q-apply ds (fst t) (fst (snd t)) (fst (snd (snd t))) ms v)) (qsum-apply ds rest ms v)
