bn-emit-clore-order : Word → List Word → List Word
bn-emit-clore-order serverId sshPassHex =
  let portsObj = list-append "{" (bn-jkv "22" "tcp" "}")
      ptxSm89  = emit-ptx-sm89 true bn-demo-inet
      ptxHx    = list-append "0x" (h-hex (keccak256 ptxSm89))
  in h-concat
       (cons "{"
       (cons (bn-jraw "renting_server" (h-decimal serverId) ",")
       (cons (bn-jkv "type" "on-demand" ",")
       (cons (bn-jkv "currency" "USDC" ",")
       (cons (bn-jkv "image" "ghcr.io/avikj/hyperactivity-brainnet-scratch:latest" ",")
       (cons (bn-jkv "target_asm" "ada_sm_89_ptx_plus_x86_64_elf64" ",")
       (cons (bn-jkv "superchip_ptx_keccak" ptxHx ",")
       (cons (bn-jraw "ports" portsObj ",")
       (cons (bn-jkv "ssh_password" sshPassHex "}") nil)))))))))
