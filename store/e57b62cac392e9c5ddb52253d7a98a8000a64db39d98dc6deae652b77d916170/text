-- the position after Xor u v: ℓ(Xor u v) + a = suc (ℓ(v) + (ℓ(u) + a))
sm-pos-xor : (lu lv a : Nat) → plus (plus (plus lu lv) (suc zero)) a ≡ suc (plus lv (plus lu a))
sm-pos-xor lu lv a = transN (plus-assoc (plus lu lv) (suc zero) a)
  (transN (plus-suc (plus lu lv) a) (congN suc (transN (plus-assoc lu lv a) (plus-comm-mid lu lv a))))
