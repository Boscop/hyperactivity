-- ============================================================================
-- 1. Pauli Steric Repulsion from Closed-Shell Orbital Overlap S
-- ============================================================================
-- Two overlapping closed-shell orbitals with on-site energy α, resonance β, overlap S:
--   E_bond = (α + β)/(1 + S),   E_anti = (α - β)/(1 - S).
-- Total 4-electron (2 bonding + 2 antibonding) energy shift relative to 4α:
--   ΔE_Pauli · (1 - S²) = 2[(α + β)(1 - S) + (α - β)(1 + S) - 2 α (1 - S²)]
--                       = 4 S (α S - β).
-- With β = k α S (Wolfsberg–Helmholz, k > 1 and α < 0), α S - β = (1 - k) α S > 0 ⇒ ΔE_Pauli > 0!
-- Variables (0..2): α, β, S.
chem-pauli-steric-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-pauli-steric-poly A ad mu q vs =
  (λ g sub sq →
    let al = g 0; bt = g 1; S = g 2
        q1 = q (fn-q 1 1)
        q2 = q (fn-q 2 1)
        q4 = q (fn-q 4 1)
        t1 = mu (ad al bt) (sub q1 S)
        t2 = mu (sub al bt) (ad q1 S)
        t0 = mu q2 (mu al (sub q1 (sq S)))
        lhs = mu q2 (sub (ad t1 t2) t0)
        rhs = mu q4 (mu S (sub (mu al S) bt))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
