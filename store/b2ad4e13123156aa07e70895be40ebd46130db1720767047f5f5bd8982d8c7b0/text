-- an argv or envp given back: each text's bytes, then the array of addresses. The array is as long as
-- the texts it holds, so the walk is their length and nothing is read past the array (2026-11-18)
h-free-ptrs-at : Word → Nat → Proc W Unit
h-free-ptrs-at a zero = ret unit
h-free-ptrs-at a (suc k) = bind (load-at a) (λ p → bind (free-at p) (λ u → h-free-ptrs-at (wadd a #8) k))
