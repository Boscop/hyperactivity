-- CExpr: an expression; every node has its type and value category. One constructor per Clang Expr kind met; ce-nil/ce-cons build argument and initializer lists
data CExpr =
    ce-integer-literal (t : CType) (vc : CValCat) (v : Word)
  | ce-character-literal (t : CType) (vc : CValCat) (v : Word)
  | ce-bool-literal (t : CType) (vc : CValCat) (v : Bool)
  | ce-floating-literal (t : CType) (vc : CValCat) (bits : Word)
  | ce-string-literal (t : CType) (vc : CValCat) (s : CStr)
  | ce-string-literal-units (t : CType) (vc : CValCat) (units : List Word)
  | ce-nullptr-literal (t : CType) (vc : CValCat)
  | ce-declref (t : CType) (vc : CValCat) (k : CRefKind) (id : Word)
  | ce-member (t : CType) (vc : CValCat) (base : CExpr) (arrow : Bool) (qualified : Bool) (k : CRefKind) (id : Word)
  | ce-call (t : CType) (vc : CValCat) (callee : CExpr) (args : CExpr)
  | ce-member-call (t : CType) (vc : CValCat) (callee : CExpr) (args : CExpr)
  | ce-operator-call (t : CType) (vc : CValCat) (callee : CExpr) (args : CExpr)
  | ce-construct (t : CType) (vc : CValCat) (ctor : Word) (k : CConstructKind) (elidable : Bool) (list : Bool) (zeroing : Bool) (args : CExpr)
  | ce-temporary-object (t : CType) (vc : CValCat) (ctor : Word) (k : CConstructKind) (elidable : Bool) (list : Bool) (zeroing : Bool) (args : CExpr)
  | ce-implicit-cast (t : CType) (vc : CValCat) (k : CCastKind) (path : List Word) (e : CExpr)
  | ce-static-cast (t : CType) (vc : CValCat) (k : CCastKind) (path : List Word) (e : CExpr)
  | ce-reinterpret-cast (t : CType) (vc : CValCat) (k : CCastKind) (path : List Word) (e : CExpr)
  | ce-functional-cast (t : CType) (vc : CValCat) (k : CCastKind) (path : List Word) (e : CExpr)
  | ce-cstyle-cast (t : CType) (vc : CValCat) (k : CCastKind) (path : List Word) (e : CExpr)
  | ce-unary (t : CType) (vc : CValCat) (op : CUnOp) (e : CExpr)
  | ce-binary (t : CType) (vc : CValCat) (op : CBinOp) (l : CExpr) (r : CExpr)
  | ce-compound-assign (t : CType) (vc : CValCat) (op : CBinOp) (lhs-type : CType) (result-type : CType) (l : CExpr) (r : CExpr)
  | ce-conditional (t : CType) (vc : CValCat) (c : CExpr) (a : CExpr) (b : CExpr)
  | ce-paren (t : CType) (vc : CValCat) (e : CExpr)
  | ce-array-subscript (t : CType) (vc : CValCat) (base : CExpr) (index : CExpr)
  | ce-init-list (t : CType) (vc : CValCat) (union-field : COptId) (filler : CExpr) (inits : CExpr)
  | ce-implicit-value-init (t : CType) (vc : CValCat)
  | ce-default-init (t : CType) (vc : CValCat) (field : Word)
  | ce-default-arg (t : CType) (vc : CValCat) (parm : Word)
  | ce-this (t : CType) (vc : CValCat)
  | ce-materialize-temporary (t : CType) (vc : CValCat) (sd : CStorageDuration) (extending : COptId) (e : CExpr)
  | ce-with-cleanups (t : CType) (vc : CValCat) (e : CExpr)
  | ce-constant (t : CType) (vc : CValCat) (v : CInt) (e : CExpr)
  | ce-lambda (t : CType) (vc : CValCat) (closure : Word) (captures : CExpr)
  | ce-unary-or-type-trait (t : CType) (vc : CValCat) (k : CTraitKind) (arg-type : CType) (arg : CExpr)
  | ce-subst-nttp (t : CType) (vc : CValCat) (e : CExpr)
  | ce-rewritten-binary (t : CType) (vc : CValCat) (e : CExpr)
  | ce-coawait (t : CType) (vc : CValCat) (operand : CExpr) (common : CExpr) (ready : CExpr) (suspend : CExpr) (resume : CExpr)
  | ce-coyield (t : CType) (vc : CValCat) (operand : CExpr) (common : CExpr) (ready : CExpr) (suspend : CExpr) (resume : CExpr)
  | ce-opaque-value (t : CType) (vc : CValCat) (id : Word) (source : CExpr)
  | ce-paren-list-init (t : CType) (vc : CValCat) (inits : CExpr)
  | ce-throw (t : CType) (vc : CValCat) (e : CExpr)
  | ce-bind-temporary (t : CType) (vc : CValCat) (dtor : Word) (e : CExpr)
  | ce-dynamic-cast (t : CType) (vc : CValCat) (k : CCastKind) (path : List Word) (e : CExpr)
  | ce-typeid (t : CType) (vc : CValCat) (arg-type : CType) (arg : CExpr)
  | ce-noexcept (t : CType) (vc : CValCat) (e : CExpr)
  | ce-atomic (t : CType) (vc : CValCat) (op : CAtomicOp) (args : CExpr)
  | ce-std-initializer-list (t : CType) (vc : CValCat) (e : CExpr)
  | ce-new (t : CType) (vc : CValCat) (global : Bool) (array : Bool) (operator-new : COptId) (init-style : CNewInit) (array-size : CExpr) (placement : CExpr) (init : CExpr)
  | ce-delete (t : CType) (vc : CValCat) (global : Bool) (array : Bool) (operator-delete : COptId) (e : CExpr)
  | ce-nil
  | ce-cons (x : CExpr) (xs : CExpr)
