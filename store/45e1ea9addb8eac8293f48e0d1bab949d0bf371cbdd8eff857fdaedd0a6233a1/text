-- a new variable of a given type, as a body: a variable of a path type is the path that at a
-- point gives that variable at the point, and at an end of the interval gives the end the type
-- names (so that a path variable at an end computes to its end)
nk-reflect : NkTm → Word → NkTm
nk-reflect (nk-con c (nk-cons line (nk-cons l (nk-cons r z)))) n = if %weq c #4 then nk-lam (nk-op #8 (nk-var #0) (nk-cons (nk-free n) (nk-cons l (nk-cons r nk-nil)))) else nk-free n
nk-reflect t n = nk-free n
