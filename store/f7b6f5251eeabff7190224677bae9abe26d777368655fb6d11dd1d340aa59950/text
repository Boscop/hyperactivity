-- the quotient by 1
quot-one : (V : Word) → wquot V #1 ≡ V
quot-one V = catw (congw (λ z → wquot z #1) (symw (catw (wmul-suc V #0) (catw (congw (λ z → wadd z V) (wmul-zero V)) (wadd-zero-l V)))))
                  (catw (congw (λ z → wquot z #1) (λ i → wadd (wmul V #1) #0)) (wdiv-unique V #0 #1 refl))
