-- ---------------------------------------------------------------- 6. Native OS Foundry Export Process (`lib/world.hypercubical`)
-- Writes raw binary Calma GDSII v6.0 files (`xor4_gaa3nm.gds`, `hypercore_soc_5layer.gds`),
-- the 8-module SystemVerilog RTL suite, and the SystemVerilog testbench directly to OS files via `W`.
export-foundry-bundle :
  List Word → List Word → List Word → List Word →
  Step W (Word × (Word × (Word × Word)))
export-foundry-bundle gdsCellPath gdsSocPath svRtlPath svTbPath =
  to-step {W} {Word × (Word × (Word × Word))}
    (bind (file-write-named gdsCellPath hypercore-gds-bytes)      (λ nGds1 →
     bind (file-write-named gdsSocPath  hypercore-soc-gds6-bytes) (λ nGds2 →
     bind (file-write-named svRtlPath   hypercore-full-rtl-sv)    (λ nSv   →
     bind (file-write-named svTbPath    hypercore-sv-testbench)   (λ nTb   →
       ret {lzero} {W} (nGds1 , (nGds2 , (nSv , nTb))))))))
