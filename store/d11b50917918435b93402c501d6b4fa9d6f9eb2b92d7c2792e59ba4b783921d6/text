bytes-len-code bs b =
  case %view b of
    wvar l T → (case %view T of wpty k n → (if %weq k #4 then qv-un bs n else none); _ → none)
    wbytes n → some (cwlit n)
    wprim j cs → 
      if %wlt j #1024 then none
      else if %wlt j #1280 then (case cs of lcons b2 r → bytes-len-code bs b2; lnil → none)
      else if %wlt j #1536 then none else (case cs of lcons n r → qv-un bs n; lnil → none)
    _ → none
