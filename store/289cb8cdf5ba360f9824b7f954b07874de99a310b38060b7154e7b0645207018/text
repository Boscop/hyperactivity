bw-ifc : (V : Type) → (b : Bool) → (x : V) → (r : List V) → (k : Nat) → sy-len V r ≡ k → sy-len V (if b then cons x r else r) ≡ (if b then suc k else k)
bw-ifc V b x r k = case b return λ w → sy-len V r ≡ k → sy-len V (if w then cons x r else r) ≡ (if w then suc k else k) of
  true → λ h → λ i → suc (h i)
  false → λ h → h
