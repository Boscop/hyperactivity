-- ---------------------------------------------------------------- the matches: the entries between the two bounds
-- a list is at most itself with anything after it
si-app-ge : {A : Type} → (le : A → A → Bool) → ((a : A) → isTrue (le a a)) → (x : List A) → (y : List A) → isTrue (lexle le x (list-append x y))
si-app-ge le rf x y = case x return λ w → isTrue (lexle le w (list-append w y)) of
  nil → unit
  cons c r → step-eq {le c c} {le c c} {lexle le r (list-append r y)} (rf c) (rf c) (rec r)
