-- above every corner product means above u·v
bil-high : (u v a b c d M : Nat × Nat) → zle a u → zle u b → zle c v → zle v d → zle (zmul a c) M → zle (zmul a d) M → zle (zmul b c) M → zle (zmul b d) M → zle (zmul u v) M
bil-high u v a b c d M hau hub hcv hvd acM adM bcM bdM = zsplit v (zle (zmul u v) M)
  (λ hv → zle-trans (zmul u v) (zmul b v) M
     (zle-mul-nonneg u b v hv hub)
     (zsplit b (zle (zmul b v) M)
        (λ hb → zle-trans (zmul b v) (zmul b d) M (zle-comm2 v b d b (zle-mul-nonneg v d b hb hvd)) bdM)
        (λ hb → zle-trans (zmul b v) (zmul b c) M (zle-comm2 v b c b (zle-mul-nonpos c v b hb hcv)) bcM)))
  (λ hv → zle-trans (zmul u v) (zmul a v) M
     (zle-mul-nonpos a u v hv hau)
     (zsplit a (zle (zmul a v) M)
        (λ ha → zle-trans (zmul a v) (zmul a d) M (zle-comm2 v a d a (zle-mul-nonneg v d a ha hvd)) adM)
        (λ ha → zle-trans (zmul a v) (zmul a c) M (zle-comm2 v a c a (zle-mul-nonpos c v a ha hcv)) acM)))
