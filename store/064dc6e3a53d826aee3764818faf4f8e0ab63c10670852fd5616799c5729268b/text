it-fm : (A : Type) → A → (A → A → A) → (A → A → A) → (n : Nat) → it-sym A n → sy-vn A n → sy-vn A n → A
it-fm A z ad mu n = case n return λ k → it-sym A k → sy-vn A k → sy-vn A k → A of
  zero → λ s u v → z
  suc m → λ s u v → ad (ad (mu (mu (fst s) (fst u)) (fst v)) (ad (mu (fst u) (it-dt A z ad mu m (fst (snd s)) (snd v))) (mu (fst v) (it-dt A z ad mu m (fst (snd s)) (snd u))))) (it-fm A z ad mu m (snd (snd s)) (snd u) (snd v))
