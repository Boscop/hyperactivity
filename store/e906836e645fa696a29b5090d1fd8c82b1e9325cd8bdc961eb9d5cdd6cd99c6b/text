-- the sum from t over f further terms, kept as (even-t part, odd-t part)
sixj-sum : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → QP × QP → QP × QP
sixj-sum f a1 a2 a3 a4 b1 b2 b3 t acc = case f of
  zero → acc
  suc g → sixj-sum g a1 a2 a3 a4 b1 b2 b3 (suc t) (if odd t then (fst acc , qp-add (snd acc) (sixj-term a1 a2 a3 a4 b1 b2 b3 t)) else (qp-add (fst acc) (sixj-term a1 a2 a3 a4 b1 b2 b3 t) , snd acc))
