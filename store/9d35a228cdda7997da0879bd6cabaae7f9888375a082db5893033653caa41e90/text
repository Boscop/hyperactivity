-- f(args) ([expr.call]): the function expression first, then the arguments
cx-call : CxH → CxU → CType → List CType → CxSub → CxSub → CxEnv → CxMode → CxK → CxEv CxR
cx-call h u t ats callee args env mode k = callee env cxm-get (λ c → case c of
  cxr-val v → cx-bind {MPtr} {CxR} (cx-res {MPtr} (sv-as-p v)) (λ fp → cx-bind {Word} {CxR} (cx-fn-of fp) (λ fid →
    cx-apply h u t fid cx-null args ats (cxu-ltr u) env mode k))
  cxr-bound this fid virt → cx-apply h u t fid this args ats (cxu-ltr u) env mode k
  _ → cx-stop {CxR} st-ill-typed)
