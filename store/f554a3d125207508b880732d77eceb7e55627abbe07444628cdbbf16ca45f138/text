-- Arrival-Order Confluence & Immediate Slot Recycling Theorem:
-- Two endpoints `a`, `b` arriving at an empty `Var` slot in either order BOTH recycle the slot to
-- `vslot-empty` in 1 exchange and form the exact transposed active pair `(a, b)` vs `(b, a)`.
vxchg-order-sym : (a b : Word) →
  (vxchg-two-party a b ≡ inr ((a , b) , vslot-empty)) ×
  (vxchg-two-party b a ≡ inr (swap-w2 (a , b) , vslot-empty))
vxchg-order-sym a b = (refl , refl)
