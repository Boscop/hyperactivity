w-build : List Word → Proc W Unit
w-build st =
  bind (h-dir-time (toNat #12) ".") (λ stamp →
  bind (w-all onboarding) (λ cs →
  bind (h-mkdir st) (λ u → bind (h-mkdir (list-append st "/walk")) (λ u2 →
  bind (w-keep (list-append st "/walk/") zero cs) (λ u3 →
  bind (h-write (list-append st "/walk/count") (h-decimal (fromNat (list-length cs)))) (λ b →
  bind (h-write (list-append st "/walk/stamp") (h-decimal stamp)) (λ b2 → exit #0)))))))
