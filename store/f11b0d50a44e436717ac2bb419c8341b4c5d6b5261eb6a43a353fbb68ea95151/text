-- write_rip: from register_accessors.sail (it calls what is defined after it there)
-- (part of language-support)
write_rip : (value : Bits #48) → MS Unit
write_rip value =
  bindS {Unit} {Unit} (putS (x86-set-rip (regval_into_reg (bv-sext #48 #64 value)))) (λ _ →
    bindS {Bool} {Unit} (getS {Bool} x86-log_register_writes) (λ log_register_writes'2 →
      λ σ →
        if log_register_writes'2 then
          the (MS Unit)
            log_rip_write σ
        else
          the (MS Unit)
            (retS {Unit} unit) σ))
