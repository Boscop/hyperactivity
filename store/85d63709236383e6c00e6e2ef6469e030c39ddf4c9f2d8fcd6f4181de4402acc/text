-- insertion of a term: merged with the term of the same monomial, else placed in order
pins-case : Bool → Bool → Nat → Mono → Nat → Mono → Poly → Poly → Poly
pins-case eq lt c m c2 m2 r2 ir =
  case eq return (λ w → Poly) of
    true → pterm (plus c c2) m2 r2
    false → (case lt return (λ w → Poly) of true → pterm c m (pterm c2 m2 r2); false → pterm c2 m2 ir)
