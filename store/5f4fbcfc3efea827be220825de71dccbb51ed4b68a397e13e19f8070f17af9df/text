bn-b64-dec-go : List Word → List Word
bn-b64-dec-go nil = nil
bn-b64-dec-go (cons v0 nil) = nil
bn-b64-dec-go (cons v0 (cons v1 nil)) =
  if orB (%weq v0 #64) (%weq v1 #64) then nil
  else cons (%wor (%wshl v0 #2) (%wshr v1 #4)) nil
bn-b64-dec-go (cons v0 (cons v1 (cons v2 nil))) =
  if %weq v2 #64 then cons (%wor (%wshl v0 #2) (%wshr v1 #4)) nil
  else cons (%wor (%wshl v0 #2) (%wshr v1 #4))
       (cons (%wand (%wor (%wshl v1 #4) (%wshr v2 #2)) #255) nil)
bn-b64-dec-go (cons v0 (cons v1 (cons v2 (cons v3 rest)))) =
  let b0 = %wor (%wshl v0 #2) (%wshr v1 #4)
      b1 = %wand (%wor (%wshl v1 #4) (%wshr v2 #2)) #255
      b2 = %wand (%wor (%wshl v2 #6) v3) #255
  in if %weq v2 #64 then cons b0 nil
     else if %weq v3 #64 then cons b0 (cons b1 nil)
     else cons b0 (cons b1 (cons b2 (bn-b64-dec-go rest)))
