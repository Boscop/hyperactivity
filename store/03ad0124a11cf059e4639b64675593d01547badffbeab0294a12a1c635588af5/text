-- the documents of the source that are read in the knowledge base (/hi), each with its title
s-in-source : List (List Word × List Word) → List Word
s-in-source nil = nil
s-in-source (cons x r) = list-append (h-concat (cons "<li><a href='/hi?reader=guest&amp;focus=" (cons (fst x) (cons "'>" (cons (s-esc (snd x)) (cons "<span class='kind'>" (cons (s-esc (fst x)) (cons "</span></a></li>" nil)))))))) (s-in-source r)
