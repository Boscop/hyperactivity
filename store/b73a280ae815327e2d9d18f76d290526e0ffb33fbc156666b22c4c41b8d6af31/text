-- Exact SO(4) quantum shell capacity sum: sum_{l=0}^{n-1} 2*(2*l + 1) == 2*n^2
qcs-shell-sum-go : Nat → Word → Word
qcs-shell-sum-go zero _ = #0
qcs-shell-sum-go (suc k) l =
  %wadd (%wmul #2 (%wadd (%wmul #2 l) #1)) (qcs-shell-sum-go k (%wadd l #1))

qcs-shell-cap : Word → Word
qcs-shell-cap n = qcs-shell-sum-go (toNat n) #0

qcs-check-2n2 : Nat → Word → Bool
qcs-check-2n2 zero _ = true
qcs-check-2n2 (suc k) n =
  andB (%weq (qcs-shell-cap n) (%wmul #2 (%wmul n n)))
       (qcs-check-2n2 k (%wadd n #1))

