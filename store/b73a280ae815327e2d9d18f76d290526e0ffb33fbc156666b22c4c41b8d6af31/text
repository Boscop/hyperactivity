 (cons (ReactionRule { rr-id = #6 ; rr-in = %wor (qcs-bit #5) (qcs-bit #6) ; rr-cat = qcs-bit #2 ; rr-out = qcs-bit #7 ; rr-cost = #16 }) -- Ribose+Adenine -> Adenosine(7)
  nil)))))

-- Optimal shortest-step pathway reachability discovery in chemical interaction space:
-- Returns exact minimum synchronous reaction rounds needed to synthesize `target-bit` from `food`!
qcs-min-steps-go : Nat → Word → Word → Word → List ReactionRule → Word
qcs-min-steps-go zero _ _ _ _ = #999
