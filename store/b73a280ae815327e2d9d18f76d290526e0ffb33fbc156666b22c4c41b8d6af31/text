-- A species set is an exact 64-bit bitmask (bit i = 1 iff species i is present)!

qcs-bit : Word → Word
qcs-bit i = %wshl #1 i

qcs-has-all : Word → Word → Bool
qcs-has-all state need = %weq (%wand state need) need

record ReactionRule =
  { rr-id   : Word
  ; rr-in   : Word   -- required reactant species bitmask
  ; rr-cat  : Word   -- required catalyst species bitmask (must be present for RAF catalysis!)
  ; rr-out  : Word   -- produced species bitmask
  ; rr-cost : Word   -- exact free-energy activation barrier
  }

-- Fire all catalyzed, food/substrate-ready reactions in 1 SYNCHRONOUS parallel chemical-space round
-- (`orig` is read-only snapshot of current species; `acc` accumulates newly synthesized species)
qcs-fire-sync-go : Word → Word → List ReactionRule → Word
qcs-fire-sync-go _ acc nil = acc
qcs-fire-sync-go orig acc (cons r rest) =
  let ready = andB (qcs-has-all orig (rr-in r)) (qcs-has-all orig (rr-cat r))
      acc2  = if ready then %wor acc (rr-out r) else acc
  in qcs-fire-sync-go orig acc2 rest

qcs-fire-rules : Word → List ReactionRule → Word
qcs-fire-rules st rs = qcs-fire-sync-go st st rs

qcs-closure : Nat → Word → List ReactionRule → Word
qcs-closure zero st _ = st
qcs-closure (suc k) st rs =
  let st2 = qcs-fire-rules st rs
  in if %weq st2 st then st else qcs-closure k st2 rs

-- Exact RAF verifier: ALL rules in R are F-generated AND reflexively catalyzed inside closure(F, R)!
qcs-all-rules-active : Word → List ReactionRule → Bool
qcs-all-rules-active _ nil = true
qcs-all-rules-active cl (cons r rest) =
  andB (andB (qcs-has-all cl (rr-in r)) (qcs-has-all cl (rr-cat r)))
       (qcs-all-rules-active cl rest)

qcs-is-raf : Word → List ReactionRule → Bool
qcs-is-raf food rs = qcs-all-rules-active (qcs-closure (toNat #8) food rs) rs

