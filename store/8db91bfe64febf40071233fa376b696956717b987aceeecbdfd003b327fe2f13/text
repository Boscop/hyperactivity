ltn-suc-false : (a b : Nat) → ltn a b ≡ false → ltn (suc a) b ≡ false
ltn-suc-false a =
  case a return λ y → (b : Nat) → ltn y b ≡ false → ltn (suc y) b ≡ false of
    zero → λ b → (case b return λ z → ltn zero z ≡ false → ltn (suc zero) z ≡ false of zero → λ e i → false; suc k → λ e → Empty-rec (true≢false e))
    suc a1 → λ b → (case b return λ z → ltn (suc a1) z ≡ false → ltn (suc (suc a1)) z ≡ false of zero → λ e i → false; suc b1 → λ e → rec a1 b1 e)
