-- some entry among es, held, follows e (follows e' e: e' replaces e, or states it dead)
po-followed : {E : Type} → List E → (E → E → Bool) → Pool E → E → Bool
po-followed {E} nil follows p e = false
po-followed {E} (cons e' r) follows p e = po-or (po-and (p e') (follows e' e)) (po-followed r follows p e)
