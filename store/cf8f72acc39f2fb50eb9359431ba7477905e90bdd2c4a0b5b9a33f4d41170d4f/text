nk-nle-nlt-trans : (a b c : Nat) → (nk-nle a b ≡ true) → (nk-nlt b c ≡ true) → nk-nlt a c ≡ true
nk-nle-nlt-trans zero b zero p q = nk-no (sym (nk-nlt-zero-r b) ∙ q)
nk-nle-nlt-trans zero b (suc c) p q = refl
nk-nle-nlt-trans (suc a) zero c p q = nk-no p
nk-nle-nlt-trans (suc a) (suc b) zero p q = nk-no q
nk-nle-nlt-trans (suc a) (suc b) (suc c) p q = nk-nle-nlt-trans a b c p q
