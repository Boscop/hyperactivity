diag-dd-fmap : (sk : Lst Entry) (k : Word) (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x) (c : Cube (dims sk) X) (d : DCube (dims sk) X (DL X F) c) →
  DDFmap (dims sk) (λ Z H G q → diag-dd sk k Z H G q) X F F' h c d
diag-dd-fmap lnil k X F F' h c d = λ i → h c (fst d)
diag-dd-fmap (lcons (e-ty s) sk) k X F F' h c d =
  bool-elim1 (λ b → DDFmap (dims sk) (λ Z H G q → bool-elim1 (λ b' → DCube (dims sk) Z H G) (dcube-fmap (dims sk) Z (DL Z H) H (λ x q' → fst q') G q) (diag-dd sk (%wsub k #1) Z H G q) b) X F F' h c d)
    (fmap-sw (dims sk) X (DL X F) F (DL X F') F' (λ x q → fst q) h (dlf X F F' h) (λ x q → fst q) (λ i x q → h x (fst q)) c d)
    (diag-dd-fmap sk (%wsub k #1) X F F' h c d) (weq k #0)
diag-dd-fmap (lcons e-dim sk) k X F F' h c d =
  bool-elim1 (λ b → DDFmap (suc (dims sk)) (λ Z H G q → bool-elim1 (λ b' → DCube (dims sk) (Line Z) (LineO Z H) G)
                     (dcube-fmap (dims sk) (Line Z) (LineO Z (DL Z H)) (LineO Z H) (λ L q' → diag-o Z H (line-map Z (Line Z) (degen-l Z) L) q') G q)
                     (diag-dd sk (%wsub k #1) (Line Z) (LineO Z H) G
                        (dcube-fmap (dims sk) (Line Z) (LineO Z (DL Z H)) (DL (Line Z) (LineO Z H)) (λ L q' → exch-o Z H (line-map Z (Line Z) (degen-l Z) L) q') G q)) b)
                   X F F' h c d)
    (fmap-sw (dims sk) (Line X) (LineO X (DL X F)) (LineO X F) (LineO X (DL X F')) (LineO X F')
       (λ L q → diag-o X F (line-map X (Line X) (degen-l X) L) q) (lineo-fmap X F F' h) (lineo-fmap X (DL X F) (DL X F') (dlf X F F' h))
       (λ L q → diag-o X F' (line-map X (Line X) (degen-l X) L) q)
       (λ i L q → diag-o X F' (line-map X (Line X) (degen-l X) L) (lineo-fmap X (DL X F) (DL X F') (dlf X F F' h) L q)) c d)
    (pcat (DCube (dims sk) (Line X) (LineO X F') c)
       (dcube-fmap (dims sk) (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h) c
          (diag-dd sk (%wsub k #1) (Line X) (LineO X F) c
             (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) c d)))
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F') c
          (dcube-fmap (dims sk) (Line X) (DL (Line X) (LineO X F)) (DL (Line X) (LineO X F')) (dlf (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h)) c
             (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) c d)))
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F') c
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X F')) (DL (Line X) (LineO X F')) (λ L q → exch-o X F' (line-map X (Line X) (degen-l X) L) q) c
             (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (LineO X (DL X F')) (lineo-fmap X (DL X F) (DL X F') (dlf X F F' h)) c d)))
       (diag-dd-fmap sk (%wsub k #1) (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h) c
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) c d))
       (λ i → diag-dd sk (%wsub k #1) (Line X) (LineO X F') c
          (fmap-sw (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (LineO X (DL X F')) (DL (Line X) (LineO X F'))
             (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) (dlf (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h))
             (lineo-fmap X (DL X F) (DL X F') (dlf X F F' h)) (λ L q → exch-o X F' (line-map X (Line X) (degen-l X) L) q)
             (λ t L q → exch-o X F' (line-map X (Line X) (degen-l X) L) (lineo-fmap X (DL X F) (DL X F') (dlf X F F' h) L q)) c d i)))
    (weq k #0)
