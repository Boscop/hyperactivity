ossc-eff-to-html : OsEffect → List Word
ossc-eff-to-html (eff-mount-ui title node) =
  h-concat (cons "<section class='os-sec'><div class='os-sec-bar'><span class='os-sec-title'>"
           (cons (ossc-esc title) (cons "</span></div>" (cons (ossc-ui-to-html node) (cons "</section>" nil)))))
ossc-eff-to-html (eff-seq a b) = list-append (ossc-eff-to-html a) (ossc-eff-to-html b)
ossc-eff-to-html _ = nil
