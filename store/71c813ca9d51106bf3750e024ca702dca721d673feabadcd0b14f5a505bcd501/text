canon-of : (sk' sk : Lst Entry) (r : Word → Word) → CanonCM sk' sk (cmap-of sk' sk r)
canon-of sk' lnil r = unit
canon-of sk' (lcons (e-ty a) sk) r = canon-of sk' sk (λ k → r (%wsucc k))
canon-of sk' (lcons e-dim sk) r =
  (canon-of sk' sk (λ k → r (%wsucc k)) ,
   eq→isTrue {dnf-canon (lcons (lcons (r #0 , true) lnil) lnil)} (dnf-eq-refl (lcons (lcons (r #0 , true) lnil) lnil)))
