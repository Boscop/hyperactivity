-- from a state that exists, the hop's squared amplitudes sum to one
hop-norm-at : List Bool → List Bool → List Bool → List Bool → List Bool → List Bool → Bool
hop-norm-at x v2 k kt w2 m = if both (both (btri-ok x v2 k) (btri-ok k bin-one kt)) (btri-ok x w2 m)
  then bin-eq (fst (hop-total-sq x v2 k kt w2 m)) (snd (hop-total-sq x v2 k kt w2 m)) else true
