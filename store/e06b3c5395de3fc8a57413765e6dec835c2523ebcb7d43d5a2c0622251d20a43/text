-- ============================================================================
-- 2. Exact Frank (1953) Autocatalytic Homochirality Amplification Theorem
-- ============================================================================
-- Kinetics: dL/dt = k1 L - k2 L D,   dD/dt = k1 D - k2 L D.
-- Enantiomeric excess y = L - D, total concentration s = L + D.
-- Quotient-rule numerator for d(y/s)/dt:
--   (dy/dt)·s - y·(ds/dt) = 2 k2 y L D.
-- Variables (0..3): k1, k2, L, D.
fold-frank-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
fold-frank-poly A ad mu q vs =
  (λ g sub →
    let k1 = g 0; k2 = g 1; L = g 2; D = g 3
        q2 = q (fn-q 2 1)
        LD = mu L D
        dL = sub (mu k1 L) (mu k2 LD)
        dD = sub (mu k1 D) (mu k2 LD)
        y  = sub L D
        s  = ad L D
        dy = sub dL dD
        ds = ad dL dD
        lhs = sub (mu dy s) (mu y ds)
        rhs = mu q2 (mu k2 (mu y LD))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
