-- write PATH: the module's head replaced, checked the same way
hy-write-head : List Word → List Word → List Word → List Word → Sum Unit (List Word × List (List Word)) → Proc W Unit
hy-write-head st m path t (inl u) = bind (h-source-text path) (hy-write-new-module st m path t)
hy-write-head st m path t (inr hp) = hy-write-at st m path (fst hp) false t (inr (h-hex path , snd hp))
