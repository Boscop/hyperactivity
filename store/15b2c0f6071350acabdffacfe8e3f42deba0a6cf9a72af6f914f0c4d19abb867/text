s-dht-ins-xor : List Word → List Word → List (List Word) → List (List Word)
s-dht-ins-xor key row nil = cons row nil
s-dht-ins-xor key row (cons r rs) =
  if wlt (s-xor-dist (h-before " " row) key) (s-xor-dist (h-before " " r) key)
  then cons row (cons r rs)
  else cons r (s-dht-ins-xor key row rs)
