cmp-double-s : (t x y : Bool) → (k : Nat) → (Y : Nat) → ((Y2 : Nat) → cmpN t (plus (bitn x) (times 2 k)) (plus (bitn y) (times 2 Y2)) ≡ cmpN (if bit-eq x y then t else y) k Y2) → cmpN t (plus (bitn x) (times 2 (suc k))) (plus (bitn y) (times 2 Y)) ≡ cmpN (if bit-eq x y then t else y) (suc k) Y
cmp-double-s t x y k Y h = case Y return λ n → cmpN t (plus (bitn x) (times 2 (suc k))) (plus (bitn y) (times 2 n)) ≡ cmpN (if bit-eq x y then t else y) (suc k) n of
  zero → transB (λ i → cmpN t (dbl-suc x k i) (plus (bitn y) (times 2 zero))) (cmp-s0 t y (plus (bitn x) (times 2 k)))
  suc j → transB (λ i → cmpN t (dbl-suc x k i) (dbl-suc y j i)) (h j)
