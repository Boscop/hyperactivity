-- Exact 1-bit gate-level evaluator for ANY packed NAND2 witness (returns output bit 0/1)
io-eval-bit-go : Word → Word → Word → Word → Nat → Word
io-eval-bit-go last _ _ _ zero = last
io-eval-bit-go _ st nw prog (suc k) =
  let g  = %wand prog #63
      i  = %wshr g #3
      j  = %wand g #7
      vi = %wand (%wshr st i) #1
      vj = %wand (%wshr st j) #1
      vo = %wxor (%wand vi vj) #1
  in io-eval-bit-go vo (%wor st (%wshl vo nw)) (%wsucc nw) (%wshr prog #6) k
