p-term-rads-y : SQ → STerm → PCand → List PCand → List PRad
p-term-rads-y w t x ys = case ys of
  nil → nil
  cons y rest → cons (p-rad-of (sq-mul w (sq-mul (s-eval (snd (snd (snd t))) (fst x) (fst y)) (sq-inv (sq-mul (poly-eval (poly-deriv (fst (fst (snd t)))) (fst x)) (poly-eval (poly-deriv (fst (fst (snd (snd t))))) (fst y))))))
      (nats-comb (snd (fst (snd t))) (snd x) (snd (fst (snd (snd t)))) (snd y))) (p-term-rads-y w t x rest)
