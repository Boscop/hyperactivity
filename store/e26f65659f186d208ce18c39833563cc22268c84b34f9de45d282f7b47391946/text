-- nk-plan-read-wf: reading a held wire u sets only u and writes fresh reference slots in [n, nk-adv n parts)
nk-plan-read-wf : (s : NkSlot) (o : NkOp) (u n : NkW) (ins outs : NkEnv) →
  nk-and (nk-wire-le n (nk-n (nk-plan-read s o u n)))
         (nk-step-fx-wf u ins outs n (nk-n (nk-plan-read s o u n)) (nk-fx (nk-plan-read s o u n))) ≡ true
nk-plan-read-wf (nks-val v) o u n ins outs =
  nk-and-intro (nk-wire-le n (nk-adv n (nk-parts v)))
    (nk-and (nk-weq u u) (nk-fx-wf ins outs n (nk-adv n (nk-parts v)) (nk-copy-fx (nk-parts v) n)))
    (nk-adv-mono n (nk-parts v))
    (nk-and-intro (nk-weq u u) (nk-fx-wf ins outs n (nk-adv n (nk-parts v)) (nk-copy-fx (nk-parts v) n))
      (nk-weq-refl u)
      (nk-copy-fx-wf ins outs n n (nk-parts v) (nk-wire-le-refl n)))
nk-plan-read-wf nks-none o u n ins outs = nk-and-intro (nk-wire-le n n) true (nk-wire-le-refl n) refl
nk-plan-read-wf (nks-op p) o u n ins outs = nk-and-intro (nk-wire-le n n) true (nk-wire-le-refl n) refl
nk-plan-read-wf (nks-pair p v) o u n ins outs = nk-and-intro (nk-wire-le n n) true (nk-wire-le-refl n) refl
