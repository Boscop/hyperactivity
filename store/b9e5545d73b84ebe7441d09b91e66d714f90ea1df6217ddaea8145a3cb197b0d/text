ossc-ui-leaf : UiNode → List Word
ossc-ui-leaf ui-nil = nil
ossc-ui-leaf (ui-heading t) =
  h-concat (cons "<h2 class='os-h3'>" (cons (ossc-esc t) (cons "</h2>" nil)))
ossc-ui-leaf (ui-text t) =
  h-concat (cons "<p class='os-p'>" (cons (ossc-esc t) (cons "</p>" nil)))
ossc-ui-leaf (ui-code s) =
  h-concat (cons "<pre class='os-code'><code>" (cons (ossc-esc s) (cons "</code></pre>" nil)))
ossc-ui-leaf (ui-metric l v) =
  h-concat (cons "<div class='os-metric'><b class='os-ml'>" (cons (ossc-esc l)
           (cons "</b><span class='os-mv'>" (cons (ossc-esc v) (cons "</span></div>" nil)))))
ossc-ui-leaf (ui-canvas w h ops) = nil
ossc-ui-leaf (ui-row a b) = list-append (ossc-ui-leaf a) (ossc-ui-leaf b)
ossc-ui-leaf (ui-col a b) = list-append (ossc-ui-leaf a) (ossc-ui-leaf b)
