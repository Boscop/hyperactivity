-- a data type's level is closed: no field's universe depends on a parameter
-- (2026-11-12) the level is the fields' largest only; a declared universe is never seen here, since
-- src/syntax.c drops it (at the site).
chk-data d ent =
  case ent of
    dent tel l → 
      let lv = data-level d tel
      in and-then (chk (lvl-closed (lvl-of lv)) (refused lv E-openlevel opq opq))
           (and-then (check-ptys tel)
              (let pc = params-fresh tel lnil in check-ctors d (fst pc) (snd pc) #0))
    _ → refused opq E-notdata opq opq
