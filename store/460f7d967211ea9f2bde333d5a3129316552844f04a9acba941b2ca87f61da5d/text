nk-trim-susp-wf : (b : NkTm) (j : Word) (ins outs : NkEnv) (n0 : NkW) (e : NkEnv) (o : NkOut) →
  (nk-wire-le n0 (nk-n o) ≡ true) → (nk-env-in-set ins n0 (nk-n o) e ≡ true) →
  (nk-out-ok ins outs n0 (nk-n o) o ≡ true) →
  nk-trim-susp-ok ins outs n0 (nk-n o) (nk-trim-susp b j e o) ≡ true
nk-trim-susp-wf b j ins outs n0 nke-nil (nk-out fx n ws) p0 he ho =
  nk-and-intro (nk-wire-le n n) (nk-fx-wf ins outs n0 n fx) (nk-wire-le-refl n) (nk-out-ok-fx ins outs n0 n (nk-out fx n ws) ho)
nk-trim-susp-wf b j ins outs n0 (nke-cons w r) o p0 he ho =
  nk-trim-susp-step-at (nk-uses-var #0 j b) ins outs n0 (nk-n o) w (nk-trim-susp b (%wsucc j) r o) p0
    (nk-and-l (nk-in-set ins n0 (nk-n o) w) (nk-env-in-set ins n0 (nk-n o) r) he)
    (nk-trim-susp-wf b (%wsucc j) ins outs n0 r o p0 (nk-and-r (nk-in-set ins n0 (nk-n o) w) (nk-env-in-set ins n0 (nk-n o) r) he) ho)
