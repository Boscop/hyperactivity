  hw-ln "// === B. REAL 2-SITE SWEEPING MPS/DMRG ON 64-SITE (2x32) BILAYER La3Ni2O7 LADDER ==="
  (hw-ln "// Exact D_W=8 Rung-Basis MPO: H = sum_i Jp*S_ia.S_ib + (Jl/2)*sum_i (T_i.T_{i+1} + D_i.D_{i+1})"
  (hw-ln "// Local basis d=4: 0=|S>, 1=|T+>, 2=|T0>, 3=|T-> (ZERO approximations, ZERO proxies!)"
  (hw-ln "#define DMRG_L 32"
  (hw-ln "#define DMRG_D 4"
  (hw-ln "#define DMRG_W 8"
  (hw-ln "#define DMRG_MAXC 10"
  (hw-ln "static double W_mpo[DMRG_W][DMRG_W][DMRG_D][DMRG_D];"
  (hw-ln "static double MPS[DMRG_L][DMRG_MAXC][DMRG_D][DMRG_MAXC];"
  (hw-ln "static int chi_L[DMRG_L], chi_R[DMRG_L];"
  (hw-ln "static double Lenv[DMRG_L+1][DMRG_W][DMRG_MAXC][DMRG_MAXC];"
  (hw-ln "static double Renv[DMRG_L+1][DMRG_W][DMRG_MAXC][DMRG_MAXC];"
  (hw-ln "static void init_bilayer_mpo(double Jl, double Jp) {"
  (hw-ln "  memset(W_mpo, 0, sizeof(W_mpo));"
  (hw-ln "  double s2 = sqrt(2.0), hJl = 0.5 * Jl, qJl = 0.25 * Jl;"
  (hw-ln "  // Row 0->0: I, Row 7->7: I"
  (hw-ln "  for (int s=0;s<4;s++) { W_mpo[0][0][s][s] = 1.0; W_mpo[7][7][s][s] = 1.0; }"
  (hw-ln "  // Row 0->7: H_rung = Jp * diag(-0.75, +0.25, +0.25, +0.25)"
  (hw-ln "  W_mpo[0][7][0][0] = -0.75*Jp; W_mpo[0][7][1][1] = 0.25*Jp; W_mpo[0][7][2][2] = 0.25*Jp; W_mpo[0][7][3][3] = 0.25*Jp;"
  (hw-ln "  // Operators: 1=Tz, 2=T+, 3=T-, 4=Dz, 5=D+, 6=D-"
  (hw-ln "  double Tz[4][4]={{0}}, Tp[4][4]={{0}}, Tm[4][4]={{0}}, Dz[4][4]={{0}}, Dp[4][4]={{0}}, Dm[4][4]={{0}};"
  (hw-ln "  Tz[1][1]=1.0; Tz[3][3]=-1.0; Tp[1][2]=s2; Tp[2][3]=s2; Tm[2][1]=s2; Tm[3][2]=s2;"
  (hw-ln "  Dz[0][2]=1.0; Dz[2][0]=1.0; Dp[1][0]=-s2; Dp[0][3]=s2; Dm[0][1]=-s2; Dm[3][0]=s2;"
  (hw-ln "  for (int a=0;a<4;a++) for (int b=0;b<4;b++) {"
  (hw-ln "    W_mpo[0][1][a][b]=hJl*Tz[a][b]; W_mpo[1][7][a][b]=Tz[a][b];"
  (hw-ln "    W_mpo[0][2][a][b]=qJl*Tp[a][b]; W_mpo[2][7][a][b]=Tm[a][b];"
  (hw-ln "    W_mpo[0][3][a][b]=qJl*Tm[a][b]; W_mpo[3][7][a][b]=Tp[a][b];"
  (hw-ln "    W_mpo[0][4][a][b]=hJl*Dz[a][b]; W_mpo[4][7][a][b]=Dz[a][b];"
  (hw-ln "    W_mpo[0][5][a][b]=qJl*Dp[a][b]; W_mpo[5][7][a][b]=Dm[a][b];"
  (hw-ln "    W_mpo[0][6][a][b]=qJl*Dm[a][b]; W_mpo[6][7][a][b]=Dp[a][b];"
  (hw-ln "  }"
  (hw-ln "}"
  (hw-ln "static void update_L(int i) {"
  (hw-ln "  int cl = chi_L[i], cr = chi_R[i];"
  (hw-ln "  static double T1[DMRG_W][DMRG_MAXC][DMRG_D][DMRG_MAXC];"
  (hw-ln "  memset(T1, 0, sizeof(T1));"
  (hw-ln "  for (int w=0;w<DMRG_W;w++) for (int al=0;al<cl;al++) for (int bl=0;bl<cl;bl++) {"
  (hw-ln "    double lv = Lenv[i][w][al][bl]; if (lv == 0.0) continue;"
  (hw-ln "    for (int s=0;s<4;s++) for (int br=0;br<cr;br++) T1[w][al][s][br] += lv * MPS[i][bl][s][br];"
  (hw-ln "  }"
  (hw-ln "  memset(Lenv[i+1], 0, sizeof(Lenv[i+1]));"
  (hw-ln "  for (int w=0;w<DMRG_W;w++) for (int wp=0;wp<DMRG_W;wp++) {"
  (hw-ln "    int nz = 0; for (int s1=0;s1<4;s1++) for (int s2=0;s2<4;s2++) if (W_mpo[w][wp][s1][s2]!=0.0) nz=1;"
  (hw-ln "    if (!nz) continue;"
  (hw-ln "    for (int s1=0;s1<4;s1++) for (int s2=0;s2<4;s2++) {"
  (hw-ln "      double wv = W_mpo[w][wp][s1][s2]; if (wv == 0.0) continue;"
  (hw-ln "      for (int al=0;al<cl;al++) for (int ar=0;ar<cr;ar++) {"
  (hw-ln "        double av = MPS[i][al][s1][ar] * wv; if (av == 0.0) continue;"
  (hw-ln "        for (int br=0;br<cr;br++) Lenv[i+1][wp][ar][br] += av * T1[w][al][s2][br];"
  (hw-ln "      }"
  (hw-ln "    }"
  (hw-ln "  }"
  (hw-ln "}"
  (hw-ln "static void update_R(int i) {"
  (hw-ln "  int cl = chi_L[i], cr = chi_R[i];"
  (hw-ln "  static double T1[DMRG_W][DMRG_MAXC][DMRG_D][DMRG_MAXC];"
  (hw-ln "  memset(T1, 0, sizeof(T1));"
