  (hw-ln "    double rv = Renv[i+1][wp][ar][br]; if (rv == 0.0) continue;"
  (hw-ln "    for (int bl=0;bl<cl;bl++) for (int s=0;s<4;s++) T1[wp][bl][s][ar] += MPS[i][bl][s][br] * rv;"
  (hw-ln "  }"
  (hw-ln "  memset(Renv[i], 0, sizeof(Renv[i]));"
  (hw-ln "  for (int w=0;w<DMRG_W;w++) for (int wp=0;wp<DMRG_W;wp++) {"
  (hw-ln "    int nz = 0; for (int s1=0;s1<4;s1++) for (int s2=0;s2<4;s2++) if (W_mpo[w][wp][s1][s2]!=0.0) nz=1;"
  (hw-ln "    if (!nz) continue;"
  (hw-ln "    for (int s1=0;s1<4;s1++) for (int s2=0;s2<4;s2++) {"
  (hw-ln "      double wv = W_mpo[w][wp][s1][s2]; if (wv == 0.0) continue;"
  (hw-ln "      for (int al=0;al<cl;al++) for (int ar=0;ar<cr;ar++) {"
  (hw-ln "        double av = MPS[i][al][s1][ar] * wv; if (av == 0.0) continue;"
  (hw-ln "        for (int bl=0;bl<cl;bl++) Renv[i][w][al][bl] += av * T1[wp][bl][s2][ar];"
  (hw-ln "      }"
  (hw-ln "    }"
  (hw-ln "  }"
