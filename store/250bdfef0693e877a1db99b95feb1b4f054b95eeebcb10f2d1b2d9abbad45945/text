place-grid-above-y : (x0 cellH xGap yGap : Nat) → (rows : List (List Nat)) → (yBound yCur : Nat) →
  leB yBound yCur ≡ true → AllAboveY yBound (place-grid-2d x0 yCur cellH xGap yGap rows)
place-grid-above-y x0 cellH xGap yGap nil = λ yBound yCur hy → unit
place-grid-above-y x0 cellH xGap yGap (cons row rows) = λ yBound yCur hy →
  all-above-append yBound
    (place-row x0 yCur cellH xGap row)
    (place-grid-2d x0 (plus yGap (plus cellH yCur)) cellH xGap yGap rows)
    (place-row-above-y yCur cellH xGap row yBound x0 hy)
    (place-grid-above-y x0 cellH xGap yGap rows yBound (plus yGap (plus cellH yCur))
      (leB-trans yBound yCur (plus yGap (plus cellH yCur)) hy (place-step-mono yCur cellH yGap)))
