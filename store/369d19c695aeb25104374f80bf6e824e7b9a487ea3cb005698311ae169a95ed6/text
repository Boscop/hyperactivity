csr-at-hops-le-depth : (t : CsRope) (i : Nat) → csr-nat-le (csr-at-hops t i) (csr-depth t) ≡ true
csr-at-hops-le-depth (csr-leaf bs) i = refl
csr-at-hops-le-depth (csr-cat n l r) i =
  csr-le-ite (csr-nat-lt i n) (csr-at-hops l i) (csr-at-hops r (csr-nat-sub i n)) (csr-nat-max (csr-depth l) (csr-depth r))
    (csr-le-max-l (csr-at-hops l i) (csr-depth l) (csr-depth r) (csr-at-hops-le-depth l i))
    (csr-le-max-r (csr-at-hops r (csr-nat-sub i n)) (csr-depth l) (csr-depth r) (csr-at-hops-le-depth r (csr-nat-sub i n)))
