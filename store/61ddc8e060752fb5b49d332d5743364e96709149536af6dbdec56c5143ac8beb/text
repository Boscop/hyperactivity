-- posed with the bag's identities: the elimination of X. The path branches are the declaration's
-- propositionality and the path over it between any two inhabitants (isProp→PathP). Both are
-- arguments, so checking a branch's boundary reads their types only: as a definition, isProp→PathP
-- at an endpoint is a transport in Fs computed back to the point
msort-at : {o : Ord} →
           ((m : Bag (El o)) → isProp (Fs m)) →
           ((B0 B1 : Type) → (B : B0 ≡ B1) → isProp B1 → (b0 : B0) → (b1 : B1) → PathP B b0 b1) →
           (X : Bag (El o)) → Fs X
msort-at hp pp X =
  case X return (λ w → Fs w) of
    emp → mempty o
    sng b → msng b
    un x y → munion (rec x) (rec y)
    unitl x i → 
      pp (Fs {o} (un emp x)) (Fs x) (λ j → Fs {o} (unitl x j)) (hp x) (munion (mempty o) (rec x))
        (rec x) i
    unitr x i → 
      pp (Fs {o} (un x emp)) (Fs x) (λ j → Fs {o} (unitr x j)) (hp x) (munion (rec x) (mempty o))
        (rec x) i
    assoc x y z i → 
      pp (Fs {o} (un (un x y) z)) (Fs {o} (un x (un y z))) (λ j → Fs {o} (assoc x y z j))
        (hp (un x (un y z))) (munion (munion (rec x) (rec y)) (rec z))
        (munion (rec x) (munion (rec y) (rec z))) i
    comm x y i → 
      pp (Fs {o} (un x y)) (Fs {o} (un y x)) (λ j → Fs {o} (comm x y j)) (hp (un y x))
        (munion (rec x) (rec y)) (munion (rec y) (rec x)) i
