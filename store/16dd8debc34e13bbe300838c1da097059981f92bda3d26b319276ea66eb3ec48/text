tw-lem-not-con-go : (e : Word → Bool) → (tg : Word) → (u v : INet) → (b3 : Bool) → %weq tg #3 ≡ b3 →
  in-eval e (if b3 then u else in-con #3 (in-con tg u v) in-era) ≡ web-notB (in-opB tg (in-eval e u) (in-eval e v))
tw-lem-not-con-go e tg u v true h3 =
  web-trans-b (web-sym-b (tw-lem-not-not (in-eval e u)))
              (λ i → web-notB (in-opB (kir-weq-eq tg #3 h3 (~ i)) (in-eval e u) (in-eval e v)))
tw-lem-not-con-go _ _ _ _ false _ = refl
