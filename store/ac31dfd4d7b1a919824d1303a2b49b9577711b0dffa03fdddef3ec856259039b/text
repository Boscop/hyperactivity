-- ensure views/ and hi/context-<stamp> match workflow/hyperactivity.cub's current pointer
s-ensure-views : List Word → List Word → Proc W Unit
s-ensure-views st m =
  bind (h-pointer "workflow/hyperactivity.cub") (λ wp →
  bind (h-read (list-append st "/views/wf-stamp")) (λ old →
  bind (h-file-time (list-append st "/views/graph.json")) (λ gt →
  if andB (wlt #0 gt) (h-eq wp (h-trim (s-or nil old)))
  then ret {lzero} {W} unit
  else bind (s-isolated (bind (h-run (cons m (cons "lib/views.cub" nil))) (λ rc →
    if weq rc #0 then bind (h-write (list-append st "/views/wf-stamp") wp) (λ w → ret {lzero} {W} unit)
    else ret {lzero} {W} unit))) (λ okv →
    bind (s-isolated (bind (h-read (list-append st "/views/nodes")) (λ nv →
      bind (hi-ctx-index st (list-map hi-first (hi-rows (s-or nil nv)))) (λ ix → ret {lzero} {W} unit)))) (λ okc →
      ret {lzero} {W} unit)))))
