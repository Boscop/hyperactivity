-- a piece as a definition: the selection of the bytes of its lines of the source lines-of ls, which are
-- exactly those lines (lib/selection.cub, lines-pulled), or its re-expression
hy-selection : List Word → List (List Word) → List (List Word) → List Word
hy-selection stem ls p = list-append "mask-select " (list-append stem (list-append "-source (ranges-mask " (list-append (hy-ranges-term (byte-ranges ls (hy-line-ranges (hy-init p)))) ")")))
