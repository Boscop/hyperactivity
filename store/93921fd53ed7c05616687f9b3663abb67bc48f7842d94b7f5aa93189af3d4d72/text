-- Stage 1: exact inverse of src/store.c canon() (dc_node), resolving @k against lam/plam/forall/let binders
sg-dc-list : (Word → Lst (List Word) → NkSexp → Word × NkSexp) → Word → Lst (List Word) → Lst NkSexp → Word × Lst NkSexp
sg-dc-list _ fr _ lnil = (fr , lnil)
sg-dc-list go fr ds (lcons x r) =
  let p1 = go fr ds x
      p2 = sg-dc-list go (fst p1) ds r
  in (fst p2 , lcons (snd p1) (snd p2))
