ltn-pred-false : (h m : Nat) → ltn h (suc m) ≡ false → ltn h m ≡ false
ltn-pred-false h =
  case h return λ y → (m : Nat) → ltn y (suc m) ≡ false → ltn y m ≡ false of
    zero → λ m e → Empty-rec (true≢false e)
    suc h1 → λ m → (case m return λ z → ltn (suc h1) (suc z) ≡ false → ltn (suc h1) z ≡ false of zero → λ e i → false; suc m1 → λ e → rec h1 m1 e)
