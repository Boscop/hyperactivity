ribbon-offset-pt : RPt → RPt → RPt → SInt → Pt2 × Pt2
ribbon-offset-pt (rpt x0 y0 _ _) (rpt x y _ w) (rpt x1 y1 _ _) extraW =
  let dx = si-sub x1 x0
      dy = si-sub y1 y0
      adx = si-abs dx
      ady = si-abs dy
      len = isqrt (wadd (wmul adx adx) (wmul ady ady))
      hw = si-div-w (si-add w extraW) #2
  in if weq len #0 then ((x , y) , (x , y))
     else let ox = si-div-w (si-mul (si-neg dy) hw) len
              oy = si-div-w (si-mul dx hw) len
          in ((si-add x ox , si-add y oy) , (si-sub x ox , si-sub y oy))
