s-roots-get : List Word → Proc W (List Word)
s-roots-get name =
  if orB (h-eq name "latest") (s-hex64 name)
  then bind (h-read (list-append "roots/" name)) (λ r → case r of
    inr t → ret {lzero} {W} (s-response "text/plain" t)
    inl u → ret {lzero} {W} (s-respond "404 Not Found" "text/plain" "no such root"))
  else ret {lzero} {W} (s-respond "400 Bad Request" "text/plain" "invalid root name")
