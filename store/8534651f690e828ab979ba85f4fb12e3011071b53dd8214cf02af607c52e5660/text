-- tr(σ_z M_e) as root-sum sides: Σ_sides weight · Σ_{m(τ)=0} τ^{1/8}(Σ_p τ^p C_p)/m′(τ), over the vertex's
-- weight-zero monomials
edge-sigma-trace-vw : Nat → List Nat → List Triple → VW → List Side
edge-sigma-trace-vw e ds ts w = cons (sigma-side-vw e ds (ds-plus e ds) (eplus-entry e ds) (rplus-entry e (ds-plus e ds)) w (vm-of (ds-plus e ds) ts))
  (if eqb (exp-at e ds) zero then nil else cons (sigma-side-vw e ds (ds-minus e ds) (eminus-entry e ds) (rminus-entry e (ds-minus e ds)) w (vm-of (ds-minus e ds) ts)) nil)
