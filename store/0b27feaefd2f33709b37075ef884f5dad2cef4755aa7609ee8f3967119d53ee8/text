-- ---------------------------------------------------------------- 3. Addiction / engagement attractor collapse
-- docs/preventable-death-at-scale.md (incentive-sensitization & engagement maximization):
-- When a compulsive gradient pulls every state s : S into a single sink attractor a* : S,
-- every point in the HIT `Basins S step` collapses to `basin-of S step a*`, and every
-- flow-invariant observable f : S → O is forced constant across the entire state space.
collapse-to-sink : {S : Type 0} → (step : S → S → Bool) → (sink : S) →
  ((s : S) → isTrue (step s sink)) →
  (s : S) → basin-of S step s ≡ basin-of S step sink
collapse-to-sink {S} step sink pull s = λ i → basin-step s sink (pull s) i
