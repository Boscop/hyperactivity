-- O(1)-depth byte-string literal lowering (3-digit C99 octal escapes for non-printable/quote/backslash/trigraph-safe '?')
ce-esc-byte : Word → List Word → List Word
ce-esc-byte b acc =
  if %wlt #31 b then
    if %wlt b #127 then
      if %weq b #34 then cons #92 (cons #48 (cons #52 (cons #50 acc)))
      else if %weq b #92 then cons #92 (cons #49 (cons #51 (cons #52 acc)))
      else if %weq b #63 then cons #92 (cons #48 (cons #55 (cons #55 acc)))
      else cons b acc
    else cons #92 (cons (%wadd #48 (%wshr b #6)) (cons (%wadd #48 (%wand (%wshr b #3) #7)) (cons (%wadd #48 (%wand b #7)) acc)))
  else cons #92 (cons (%wadd #48 (%wshr b #6)) (cons (%wadd #48 (%wand (%wshr b #3) #7)) (cons (%wadd #48 (%wand b #7)) acc)))
