-- OPC Process-Window Wafer Faithfulness Theorem: any mask whose aerial image clears `thresh + margin`
-- on bright features and stays below `thresh` on dark spaces prints the EXACT target wafer layout!
opc-wafer-faithful : {P : Type} → (margin thresh : Nat) → (aerial : P → Nat) → (target : P → Bool) →
  OpcMargin {P} margin thresh aerial target →
  (p : P) → resist-print thresh (aerial p) ≡ target p
opc-wafer-faithful margin thresh aerial target hm p =
  opc-pixel-eq margin thresh (aerial p) (target p) (hm p)
