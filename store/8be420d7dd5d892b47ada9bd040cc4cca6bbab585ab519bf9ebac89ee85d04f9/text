  il-o2 → il-o2
  il-ho → il-ho
  il-ca → il-ca
  il-ha → il-ha
  il-n → il-n
  il-hn1 → il-hn2
  il-hn2 → il-hn1
  il-cb → il-cb
  il-hb → il-hb
  il-cg1 → il-cg1
  il-g11 → il-g11
  il-g12 → il-g12
  il-cd1 → il-cd1
  il-d11 → il-d11
  il-d12 → il-d12
  il-d13 → il-d13
