sum3-split : (a0 a1 b0 b1 c0 c1 : Nat) →
  plus (plus (plus a0 b0) c0) (plus (plus a1 b1) c1) ≡
  plus (plus (plus a0 a1) (plus b0 b1)) (plus c0 c1)
sum3-split a0 a1 b0 b1 c0 c1 =
  transN (plus-assoc (plus a0 b0) c0 (plus (plus a1 b1) c1))
  (transN (congN (λ u → plus (plus a0 b0) u) (sym (plus-assoc c0 (plus a1 b1) c1)))
  (transN (congN (λ u → plus (plus a0 b0) (plus u c1)) (plus-comm c0 (plus a1 b1)))
  (transN (congN (λ u → plus (plus a0 b0) u) (plus-assoc (plus a1 b1) c0 c1))
  (transN (sym (plus-assoc (plus a0 b0) (plus a1 b1) (plus c0 c1)))
    (congN (λ u → plus u (plus c0 c1)) (swap4 a0 b0 a1 b1))))))
