-- build bootstrap.tgz (~95 KB: Makefile, src/*, hyperactive, README.md, CLAUDE.md) so any bare peer machine can bootstrap without git
s-make-bootstrap : List Word → Proc W Unit
s-make-bootstrap dst =
  bind (h-file-time dst) (λ bt →
  bind (h-file-time "Makefile") (λ mt →
  if andB (weq bt #0) (wlt #0 mt)
  then bind (h-run (cons "/usr/bin/env" (cons "tar" (cons "-czf" (cons dst (cons "Makefile" (cons "src" (cons "hyperactive" (cons "README.md" (cons "CLAUDE.md" nil)))))))))) (λ r → ret {lzero} {W} unit)
  else ret {lzero} {W} unit))
