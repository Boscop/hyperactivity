-- THEOREM 1: UNIVERSAL STRUCTURAL EQUALITY SOUNDNESS OVER ALL INet & ALL env!
tw-thm-eq-sound : (env : Word → Bool) → (a b : INet) → in-eq a b ≡ true → in-eval env a ≡ in-eval env b
tw-thm-eq-sound env (in-wire i) (in-wire j) h = kir-weq-eval env i j h
tw-thm-eq-sound env (in-wire _) in-era h = Empty-rec (true≢false (web-sym-b h))
tw-thm-eq-sound env (in-wire _) (in-con _ _ _) h = Empty-rec (true≢false (web-sym-b h))
tw-thm-eq-sound env (in-wire _) (in-dup _ _ _) h = Empty-rec (true≢false (web-sym-b h))
tw-thm-eq-sound env in-era (in-wire _) h = Empty-rec (true≢false (web-sym-b h))
tw-thm-eq-sound env in-era in-era _ = refl
tw-thm-eq-sound env in-era (in-con _ _ _) h = Empty-rec (true≢false (web-sym-b h))
tw-thm-eq-sound env in-era (in-dup _ _ _) h = Empty-rec (true≢false (web-sym-b h))
tw-thm-eq-sound env (in-con _ _ _) (in-wire _) h = Empty-rec (true≢false (web-sym-b h))
tw-thm-eq-sound env (in-con _ _ _) in-era h = Empty-rec (true≢false (web-sym-b h))
tw-thm-eq-sound env (in-con t1 a1 b1) (in-con t2 a2 b2) h =
  let ht  = kir-weq-eq t1 t2 (kir-andB-l (%weq t1 t2) (web-andB (in-eq a1 a2) (in-eq b1 b2)) h)
      hab = kir-andB-r (%weq t1 t2) (web-andB (in-eq a1 a2) (in-eq b1 b2)) h
      ha  = tw-thm-eq-sound env a1 a2 (kir-andB-l (in-eq a1 a2) (in-eq b1 b2) hab)
      hb  = tw-thm-eq-sound env b1 b2 (kir-andB-r (in-eq a1 a2) (in-eq b1 b2) hab)
  in λ i → in-opB (ht i) (ha i) (hb i)
tw-thm-eq-sound env (in-con _ _ _) (in-dup _ _ _) h = Empty-rec (true≢false (web-sym-b h))
tw-thm-eq-sound env (in-dup _ _ _) (in-wire _) h = Empty-rec (true≢false (web-sym-b h))
tw-thm-eq-sound env (in-dup _ _ _) in-era h = Empty-rec (true≢false (web-sym-b h))
tw-thm-eq-sound env (in-dup _ _ _) (in-con _ _ _) h = Empty-rec (true≢false (web-sym-b h))
tw-thm-eq-sound env (in-dup l1 a1 b1) (in-dup l2 a2 b2) h =
  let hl  = kir-weq-eq l1 l2 (kir-andB-l (%weq l1 l2) (web-andB (in-eq a1 a2) (in-eq b1 b2)) h)
      hab = kir-andB-r (%weq l1 l2) (web-andB (in-eq a1 a2) (in-eq b1 b2)) h
      ha  = tw-thm-eq-sound env a1 a2 (kir-andB-l (in-eq a1 a2) (in-eq b1 b2) hab)
      hb  = tw-thm-eq-sound env b1 b2 (kir-andB-r (in-eq a1 a2) (in-eq b1 b2) hab)
  in λ i → in-dupB (hl i) (ha i) (hb i)
