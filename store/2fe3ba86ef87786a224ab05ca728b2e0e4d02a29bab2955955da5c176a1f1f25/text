omni-mul-add-l : (a b c : Nat) → hm-mul (hm-add a b) c ≡ hm-add (hm-mul a c) (hm-mul b c)
omni-mul-add-l zero    b c = refl
omni-mul-add-l (suc a) b c =
  web-trans-n {hm-add c (hm-mul (hm-add a b) c)}
              {hm-add c (hm-add (hm-mul a c) (hm-mul b c))}
              {hm-add (hm-add c (hm-mul a c)) (hm-mul b c)}
              (λ i → hm-add c (omni-mul-add-l a b c i))
              (web-sym-n (sc-add-assoc c (hm-mul a c) (hm-mul b c)))
