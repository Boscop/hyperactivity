-- a codata value is a stuck call, a neutral or a system (as data), or a record: at a copattern
-- definition's own boundary, compared field by field
conv-data d ps u v =
  case %view u of
    wsys bs → sys-vs (mkdata d ps) bs v
    wrec d2 fs → conv-recv d (cofields-at d ps) fs v #0
    wu → conv-data-ww d ps u wu (%view v)
