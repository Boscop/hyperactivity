-- a fold after a bind is a fold whose leaves are folds
o-fold-bind : {l : Level} {S : Sig} {A B : Type} {R : Type l} → (kr : B → R) → (h : (c : Cmd S) → (Resp S c → R) → R) →
              (t : Step S A) → (f : A → Step S B) →
              o-fold kr h (o-bind t f) ≡ o-fold (λ a → o-fold kr h (f a)) h t
o-fold-bind kr h (sdone a) f = λ i → o-fold kr h (f a)
o-fold-bind kr h (scmd c k) f = λ i → h c (λ r → o-fold-bind kr h (k r) f i)
