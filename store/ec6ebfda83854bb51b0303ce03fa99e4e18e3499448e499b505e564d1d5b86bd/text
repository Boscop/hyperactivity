s-corpus-at : Sum Unit Work → Proc W (List Word)
s-corpus-at (inl u) = ret {lzero} {W} (s-respond "404 Not Found" "text/plain" "")
s-corpus-at (inr (work n k p)) = bind (s-work-text (work n k p)) (λ t → ret {lzero} {W} (s-response "application/json" (s-corpus-item (list-append "/" n) (s-title-or n t) t)))
