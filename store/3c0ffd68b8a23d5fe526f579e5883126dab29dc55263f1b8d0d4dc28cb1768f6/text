-- Optimization shrinks behavioral gates 4 → 1 (`a ^ b`) and mapped NAND2 tree cells 59 → 5 (11.8× area cut)!
alu-sum-opt-shrinks :
  (circ-gates {B0} {B1} {B2} {Bool} alu-sum-rtl ≡ toNat #4) ×
  (circ-gates {B0} {B1} {B2} {Bool} (circ-opt {Bool} alu-sum-rtl) ≡ toNat #1) ×
  (circ-gates {B0} {Empty} {Unit} {Bool} (tech-map {Bool} alu-sum-rtl) ≡ toNat #59) ×
  (circ-gates {B0} {Empty} {Unit} {Bool} (synth-nand2 {Bool} alu-sum-rtl) ≡ toNat #5)
alu-sum-opt-shrinks =
  ( (λ _ → toNat #4)
  , ((λ _ → toNat #1)
  , ((λ _ → toNat #59)
  , (λ _ → toNat #5))) )
