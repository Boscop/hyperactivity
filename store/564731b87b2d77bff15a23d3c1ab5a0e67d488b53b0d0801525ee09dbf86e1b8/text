-- an entry of M: diagonal weights w1, w2 per pair (×±1), off-diagonal weights o1, o2 for an exchange at distance 1, 2
lc-entry : Nat → BZ → BZ → BZ → BZ → List Bool → List Bool → BZ
lc-entry k w1 w2 o1 o2 s t = if ln-beq s t then bz-add (bz-mul w1 (lc-diag 1 k 0 s)) (bz-mul w2 (lc-diag 2 k 0 s))
  else (if lc-swap 1 s t then o1 else (if lc-swap 2 s t then o2 else bz-zero))
