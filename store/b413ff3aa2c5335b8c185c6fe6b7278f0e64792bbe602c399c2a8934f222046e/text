-- T at A = a1 − 1, B = b1 − 1, C = c1 − 1
hq-T : Nat → Nat → Nat → BQ × (BQ × BQ)
hq-T a1 b1 c1 = if eqb a1 0 then (if eqb b1 0 then n3-add (hq-Q c1) (hq-R c1) else hq-mixed (monus b1 1) c1)
  else (if eqb b1 0 then hq-mixed (monus a1 1) c1
  else n3-q (hq-ip c1 0 (u-add (u-mul (hq-pw hq-onep (monus a1 1)) (hq-pw hq-onem (monus b1 1))) (u-mul (hq-pw hq-onem (monus a1 1)) (hq-pw hq-onep (monus b1 1))))))
