var-over : (Γ1 Γ2 : CCtx) (pΓ : PathP (λ i → CCtx) Γ1 Γ2) (v1 : VarP (fst Γ1)) (v2 : VarP (fst Γ2)) → Opt (PathP (λ i → VarP (fst (pΓ i))) v1 v2)
var-over Γ1 Γ2 pΓ v1 v2 =
  opt-1 (λ q → toPathP {lzero} {VarP (fst Γ1)} {VarP (fst Γ2)} {λ i → VarP (fst (pΓ i))} {v1} {v2} q)
    (dec-opt (transport (λ i → VarP (fst (pΓ i))) v1 ≡ v2) (varp-disc (fst Γ2) (transport (λ i → VarP (fst (pΓ i))) v1) v2))
