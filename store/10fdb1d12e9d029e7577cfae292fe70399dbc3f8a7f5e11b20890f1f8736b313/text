-- ---------------------------------------------------------------- float arithmetic and comparison
-- IEEE 754 (IEC 60559): no operation is undefined; a division by zero is an infinity or a NaN
f64-op : BinOp → Float64 → Float64 → MRes Float64
f64-op o a b = case o of
  ao-add → mok (f64add a b)
  ao-sub → mok (f64sub a b)
  ao-mul → mok (f64mul a b)
  ao-div → mok (f64div a b)
  _ → mstop st-ill-typed
