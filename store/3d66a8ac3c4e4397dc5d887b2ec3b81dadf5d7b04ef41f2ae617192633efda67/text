nk-fwd-preserves-ev : (rho : NkW → NkEv) (sl : NkSlots) (u out n : NkW) (v : NkVal) →
  (nk-get sl u ≡ nks-pair (nko-fwd out) v) → (nk-weq u out ≡ false) → (nk-get sl out ≡ nks-none) →
  nk-get (nk-step-at u n sl) out ≡ nks-val v
nk-fwd-preserves-ev rho sl u out n v pu neq pout =
  nk-fwd-step-out sl u out n v pu neq ∙ cong (nk-ch (nkc-val v)) pout
