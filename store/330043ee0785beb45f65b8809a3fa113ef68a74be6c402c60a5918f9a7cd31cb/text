conflict-branch : (w : Nat) → (p n r0 : Bool) → (tail : ClauseVec w) → (rhoTail : Vec Bool w) →
  (ok0 : Bool) → lit-ok p n ≡ ok0 →
  andB ok0 (clause-ok w tail) ≡ false →
  (clause-ok w tail ≡ false → clause-sat w tail rhoTail ≡ false) →
  andB (lit-sat p n r0) (clause-sat w tail rhoTail) ≡ false
conflict-branch w p n r0 tail rhoTail false = λ hok _ _ →
  catB (andB (lit-sat p n r0) (clause-sat w tail rhoTail))
       (andB false (clause-sat w tail rhoTail))
       false
       (λ i → andB (lit-conflict p n r0 hok i) (clause-sat w tail rhoTail))
       refl
conflict-branch w p n r0 tail rhoTail true = λ _ hrest ih →
  catB (andB (lit-sat p n r0) (clause-sat w tail rhoTail))
       (andB (lit-sat p n r0) false)
       false
       (λ i → andB (lit-sat p n r0) (ih hrest i))
       (andB-false-r (lit-sat p n r0))
