-- mathematics typeset in the reader's browser (KaTeX): display between \[ \] or $$ $$, inline between \( \)
s-math : List Word
s-math = "<link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css'><script defer src='https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js'></script><script defer src='https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js' onload='renderMathInElement(document.body,{delimiters:[{left:String.raw`$$`,right:String.raw`$$`,display:true},{left:String.raw`\[`,right:String.raw`\]`,display:true},{left:String.raw`\(`,right:String.raw`\)`,display:false}],throwOnError:false})'></script>"
