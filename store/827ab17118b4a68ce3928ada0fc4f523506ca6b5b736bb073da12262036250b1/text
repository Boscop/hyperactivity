-- a canonical number that is not nil is above zero
zero-lt-step : (t c : Bool) → (r : List Bool) → (y : Bool) → (bcanon (cons c r) ≡ true → cmpN t zero (bin-to-nat (cons c r)) ≡ true) → bcanon (cons y (cons c r)) ≡ true → cmpN t zero (bin-to-nat (cons y (cons c r))) ≡ true
zero-lt-step t c r y h = case y return λ u → bcanon (cons u (cons c r)) ≡ true → cmpN t zero (bin-to-nat (cons u (cons c r))) ≡ true of
  true → λ q → λ i → true
  false → λ q → transB (cmp0-dbl t (bin-to-nat (cons c r))) (h q)
