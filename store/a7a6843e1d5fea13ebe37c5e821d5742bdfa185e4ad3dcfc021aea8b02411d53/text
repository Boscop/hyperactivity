-- a value arrives at a wire, by what waited there
nk-put-val : NkSlot → Word → NkVal → NkState → NkState
nk-put-val nks-none w v (nk-state sl rd n) = nk-state (nksl-cons w (nks-val v) sl) rd n
nk-put-val (nks-op o) w v (nk-state sl rd n) = nk-state (nk-del sl w) (nkp-cons o v rd) n
nk-put-val (nks-readers os) w v (nk-state sl rd n) = nk-state (nk-set sl w (nks-val v)) (nk-wake os w rd) n
nk-put-val (nks-val u) w v st = st
