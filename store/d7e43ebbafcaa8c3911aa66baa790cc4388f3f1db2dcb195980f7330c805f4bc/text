factor-motifs-auto : Nat → List MTerm → List (List MTerm) × List MTerm
factor-motifs-auto zero ts = (nil , ts)
factor-motifs-auto (suc k) ts =
  case best-motif ts of
    nil → (nil , ts)
    cons p ps →
      let pat = cons p ps
          ts1 = factor-motif pat ts
          res = factor-motifs-auto k ts1
      in (cons pat (fst res) , snd res)
