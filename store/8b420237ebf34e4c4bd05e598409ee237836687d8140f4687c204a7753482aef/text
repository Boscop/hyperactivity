-- B_k for k from 0, n of them: us are T^k E b_g over the attached vertex ds2, R maps them back to ds,
-- read at ds's free coordinates
b-mats : Nat → List Nat → List Nat → List Triple → (List Nat → List Nat → SQ) → Rows → List Rows
b-mats n ds ds2 ts rent us = case n of
  zero → nil
  suc g → cons (restrict (inv-free ds) (rows-map-entry rent (mons0 ds) (mons0 ds2) us)) (b-mats g ds ds2 ts rent (rows-map-t ds2 ts us))
