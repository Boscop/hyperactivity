s-change : List Word → List Word → Bool → List Word → List Word → Proc W (List Word)
s-change st m rec q body = bind (h-pointer (h-unhex (s-param "path" q))) (λ p →
  if h-not (h-eq p (s-param "was" q)) then ret {lzero} {W} (s-respond "409 Conflict" "text/plain" p)
  else bind (if rec then h-record-raw m (h-unhex (s-param "path" q)) body else h-unrecord-raw (h-unhex (s-param "path" q))) (λ u →
    bind (h-pointer (h-unhex (s-param "path" q))) (s-changed st (s-param "path" q) rec p)))
