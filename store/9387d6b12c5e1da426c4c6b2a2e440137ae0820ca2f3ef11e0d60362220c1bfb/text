papp-f : (Γ : CCtx) (a : TyShape) (P : Mean Γ (TV (s-path a))) (p : Code) → Der (j-tm , Γ , s-path a , p , P) → (r : Code) (f : DNF) →
  Opt (isTrue (dnf-canon f)) → Opt (isTrue (dnf-nonconst f)) → Opt (dnf-code f ≡ r) → Dec1 (Out Γ (cpapp p r) m-inf)
papp-f Γ a P p dp r f (some cf) (some nf) (some q) =
  c-derived (a , papp-mean Γ a f P , der-code j-tm Γ a (cpapp p (dnf-code f)) (cpapp p r) (papp-mean Γ a f P) (λ i → cpapp p (q i))
    (dpapp Γ a P p f cf nf (papp-mean Γ a f P) (λ i → papp-mean Γ a f P) dp))
papp-f Γ a P p dp r f cf nf q = c-refused
