-- Universal Pass 1b: higher-order λ-template factoring (λ arg → pre ++ arg ++ suf)
split-until : {A : Type} → (A → A → Bool) → Nat → List A → List A → Opt (List A × List A)
split-until eq zero suf xs =
  case split-prefix eq suf xs of
    some rest → some (nil , rest)
    none → none
split-until eq (suc k) suf xs =
  case split-prefix eq suf xs of
    some rest → some (nil , rest)
    none → (case xs of
              nil → none
              cons x r → (case split-until eq k suf r of
                            some p → some (cons x (fst p) , snd p)
                            none → none))
