-- the composed program's moves, each naming the component's next configuration
data ParMove (CP : Type) (CQ : Type) (M : Type) (N : Type) (E : Type) = pm-local-p (p2 : CP) | pm-local-q (q2 : CQ) | pm-send-p (m : M) (p2 : CP) | pm-send-q (n : N) (q2 : CQ) | pm-recv-q (q2 : CQ) | pm-recv-p (p2 : CP) | pm-ext-p (e : E) (p2 : CP) | pm-ext-q (e : E) (q2 : CQ)
