w-split-go : Word → List Word → List Word → (List Word × List Word)
w-split-go k xs acc =
  let fin = %welimP (λ _ → List Word × List Word) k (xs , acc) (λ _ st →
              case fst st of
                nil → (nil , snd st)
                cons x r → (r , cons x (snd st)))
  in (w-rev (snd fin) nil , fst fin)
