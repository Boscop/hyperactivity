sg-pat-info : NkSexp → (Bool × (Word × Word)) × Lst NkSexp
sg-pat-info pat =
  let xs = sg-sx-items pat
      h = sg-sx0 xs
      s = sg-sym-str h
      sp = nk-split-dot (sg-wtl s)
  in if andB (%wlt #0 (sg-sx-len xs)) (andB (sg-is-sym h) (andB (%weq (sg-whd s) #67) (%weq (nk-wlist-len (fst sp)) #64)))
       then ((true , (nk-key60 (fst sp) , nk-dec-val #0 (snd sp))) , sg-sx-tl xs)
       else ((false , (#0 , #0)) , lnil)
