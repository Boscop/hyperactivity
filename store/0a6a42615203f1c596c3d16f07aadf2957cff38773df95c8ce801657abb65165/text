-- partition transparency: shipping an agent across a peer wire, verifying its content-addressed payload
-- locally via ca-check, and reducing the cut on Peer B equals single-machine cut reduction on ca-union loc rem
wire-partition-transparent-ref : {K V : Type} → (unpack : V → WireId → ICAgent K) → (chk : K → V → Bool) →
  (loc rem : CAStore K V) → ValidCAStore chk rem → (k : K) → (arg : WireId) → (right : ICAgent K) →
  ic-interact (resolve-agent unpack (ca-or (loc k) (ca-check chk k (rem k))) k arg) right
  ≡ ic-interact (resolve-agent unpack (ca-union loc rem k) k arg) right
wire-partition-transparent-ref unpack chk loc rem vrem k arg right =
  λ i → ic-interact (resolve-agent unpack (ca-or (loc k) (ca-check-valid chk rem vrem k i)) k arg) right
