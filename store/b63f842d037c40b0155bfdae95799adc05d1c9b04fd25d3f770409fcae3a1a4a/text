-- ---------------------------------------------------------------- names
-- a byte of a name (lib/cxx/ast.cub's CStr has a writer, cstr-put, and no reader): %load8 is
-- bounds-checked by the machine (outside the string it reads 0); trusted like cstr-put
primitive cx-byte : (n : Nat) → Bytes n → Word → Word = λ n b off → %wofu32 (%load8 b off)
