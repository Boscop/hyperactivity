-- the form of a blocked body e at a type: at a function type the function that, given an
-- argument, is the form of e applied to it at the codomain there; at a path type the path that at
-- a point is the form, at the line there, of e at that point, and at an end of the interval is
-- the end the type names; at a pair type the pair of the forms of its two parts; at any other
-- type e; at a Glue type the element that is e on every face over e taken back to the base. A variable bound on the way enters the context with its own form
nk-rfl : Nat → NkTm → Word → NkTm → NkTm → NkTm
nk-rfl zero ctx n t e = e
nk-rfl (suc k) ctx n (nk-con c (nk-cons a (nk-cons f r))) e =
  if %weq c #1
  then (let c2 = nk-cons (nk-ent a (nk-sub-forms (nk-cons (nk-ent a (nk-free n)) ctx) (%wsucc n) (nk-rfl k (nk-cons (nk-ent a (nk-free n)) ctx) (%wsucc n) a (nk-free n)))) ctx
        in nk-lam (nk-abs n #0 (nk-rfl k c2 (%wsucc n) (nk-norm-in c2 (%wsucc n) (nk-app f (nk-free n))) (nk-app e (nk-free n)))))
  else (if %weq c #6 then nk-con #0 (nk-cons (nk-rfl k ctx n a (nk-op #9 e nk-nil)) (nk-cons (nk-rfl k ctx n (nk-norm-in ctx n (nk-app f (nk-op #9 e nk-nil))) (nk-op #10 e nk-nil)) nk-nil))
  else (if %weq c #4
        then (let c2 = nk-cons (nk-ent (nk-con #5 nk-nil) (nk-free n)) ctx
              in nk-lam (nk-abs n #0 (nk-rfl k c2 (%wsucc n) (nk-norm-in c2 (%wsucc n) (nk-app a (nk-free n))) (nk-op #8 (nk-free n) (nk-cons e (nk-cons f (nk-cons (nk-nth r #0) nk-nil)))))))
        else (if %weq c #7 then nk-glue (nk-sys (nk-eta-sides e (nk-args f))) (nk-rfl k ctx n a (nk-unglue f e)) else e)))
nk-rfl (suc k) ctx n t e = e
