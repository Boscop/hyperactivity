-- unline after a line body is the fibre map (uirx, then fusion)
ul-eta : (Γ : CCtx) (Y Z : Type 1) (ℓ : Y → Line Z) (X : Mean Γ Y) → PathM Γ (Line Z) (ul Γ Z (dline-body Γ Y Z ℓ X)) (fmapM Γ Y (Line Z) ℓ X)
ul-eta Γ Y Z ℓ X =
  pcat (Mean Γ (Line Z)) (ul Γ Z (dline-body Γ Y Z ℓ X))
    (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (λ xq → LineO (CtxV (fst Γ)) (FbE (fst Γ) Z) (degen-l (CtxV (fst Γ)) xq)) (FbE (fst Γ) (Line Z)) (pl-tri (fst Γ) Z) (snd Γ)
       (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (λ xq → LineO (CtxV (fst Γ)) (FbE (fst Γ) Z) (degen-l (CtxV (fst Γ)) xq)) (fline (fst Γ) Y Z ℓ) (snd Γ) X))
    (fmapM Γ Y (Line Z) ℓ X)
    (λ i → dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (λ xq → LineO (CtxV (fst Γ)) (FbE (fst Γ) Z) (degen-l (CtxV (fst Γ)) xq)) (FbE (fst Γ) (Line Z)) (pl-tri (fst Γ) Z) (snd Γ)
       (uirx (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (FbE (fst Γ) Y) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z)) (degen-l (CtxV (fst Γ))) (fline (fst Γ) Y Z ℓ) (snd Γ) X i))
    (fmap-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (λ xq → LineO (CtxV (fst Γ)) (FbE (fst Γ) Z) (degen-l (CtxV (fst Γ)) xq)) (FbE (fst Γ) (Line Z))
       (fline (fst Γ) Y Z ℓ) (pl-tri (fst Γ) Z) (snd Γ) X)
