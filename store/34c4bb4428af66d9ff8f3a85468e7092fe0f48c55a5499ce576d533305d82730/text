-- Univalent equality between Fin-indexed sequences and flat packed Bytes (times n 8) arrays
-- (two lines over Fin→Array in lib/prim.cub, ua in lib/core.cub, and package-transport in lib/structure.cub)
csr-array-path : (n : Nat) → (Fin n → Int64) ≡ Bytes (times n 8)
csr-array-path n = ua (Fin→Array n)
