-- the paper as it reads: its front matter, then its blocks
human : Paper → List Word
human (paper t s d a v bs) = texts (cons "---" (cons (cons #10 nil) (cons (field "title" t)
  (cons (field "subtitle" s) (cons (field "date" d) (cons (field "author" a) (cons "version: "
  (cons v (cons (cons #10 nil) (cons "---" (cons (cons #10 (cons #10 nil)) (cons (blocks-text bs) nil))))))))))))
