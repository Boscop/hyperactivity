-- the most of p, counted in whole words, any position of the reversed key matches: the longest run of
-- the turn's last words the text holds. Each step computes the next state once and folds in the one
-- before it
m-best-end : (n : Nat) → Bytes n → Word → Word
m-best-end n p a = if m-at-word n p (m-lo a) then wmax (wshr a #32) (m-lo a) else wshr a #32
