hhf-is-domain : List Word → Bool
hhf-is-domain p =
  if hhf-is-hc p then
    if hhf-has-prefix "lib/" p then true
    else if hhf-has-prefix "chem/" p then true
    else if hhf-has-prefix "fold/" p then true
    else if hhf-has-prefix "lqg/" p then true
    else if hhf-has-prefix "neuro/" p then true
    else hhf-has-prefix "phys/" p
  else false
