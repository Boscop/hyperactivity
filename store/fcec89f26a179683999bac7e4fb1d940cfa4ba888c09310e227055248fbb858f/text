sg-dc-lams : (Word → Lst (List Word) → NkSexp → Word × NkSexp) → Word → Lst (List Word) → List Word → Lst NkSexp → Word × NkSexp
sg-dc-lams go fr ds tg (lcons b (lcons body lnil)) =
  let nm = sg-dc-bname fr b
      p = go (%wsucc fr) (lcons nm ds) body
  in (fst p , nks-lst (lcons (nks-sym tg) (lcons (nks-sym nm) (lcons (snd p) lnil))))
sg-dc-lams go fr ds tg (lcons b rest) =
  let nm = sg-dc-bname fr b
      p = sg-dc-lams go (%wsucc fr) (lcons nm ds) tg rest
  in (fst p , nks-lst (lcons (nks-sym tg) (lcons (nks-sym nm) (lcons (snd p) lnil))))
sg-dc-lams _ fr _ _ _ = (fr , nks-sym nil)
