-- one level deeper charges every leaf once more
stree-deeper : (d : Nat) → (t : SumTree) → stree-depths (suc d) t ≡ plus (stree-size t) (stree-depths d t)
stree-deeper d stree-one = λ k → suc d
stree-deeper d (stree-plus l r) =
  transN (λ k → plus (stree-deeper (suc d) l k) (stree-deeper (suc d) r k))
    (stree-swap4 (stree-size l) (stree-depths (suc d) l) (stree-size r) (stree-depths (suc d) r))
