-- Theorem 1: 4D Hopf Torus S³ Normalization Invariant!
-- Every Hopf fiber point (x₁, x₂, x₃, x₄) = (c·a, c·b, s·p, s·q) with c = cos η, s = sin η,
-- (a, b) = (cos(ξ₁+ξ₂), sin(ξ₁+ξ₂)), (p, q) = (cos(ξ₁−ξ₂), sin(ξ₁−ξ₂)) satisfies:
--   x₁² + x₂² + x₃² + x₄² ≡ c²(a² + b²) + s²(p² + q²)
-- proving every Villarceau circle fiber lies identically on the unit 3-sphere S³ ⊂ R⁴.
hopf-torus-norm-ok : (c s a b p q : Word) →
  plusw (plusw (wsq (mulw c a)) (wsq (mulw c b))) (plusw (wsq (mulw s p)) (wsq (mulw s q)))
  ≡ plusw (mulw (wsq c) (plusw (wsq a) (wsq b))) (mulw (wsq s) (plusw (wsq p) (wsq q)))
hopf-torus-norm-ok c s a b p q =
  let left : plusw (wsq (mulw c a)) (wsq (mulw c b)) ≡ mulw (wsq c) (plusw (wsq a) (wsq b))
      left = catw (congw (λ z → plusw z (wsq (mulw c b))) (lg-sq-mul c a))
               (catw (congw (λ z → plusw (mulw (wsq c) (wsq a)) z) (lg-sq-mul c b))
                 (symw (lg-mulw-dist-l (wsq c) (wsq a) (wsq b))))
      right : plusw (wsq (mulw s p)) (wsq (mulw s q)) ≡ mulw (wsq s) (plusw (wsq p) (wsq q))
      right = catw (congw (λ z → plusw z (wsq (mulw s q))) (lg-sq-mul s p))
                (catw (congw (λ z → plusw (mulw (wsq s) (wsq p)) z) (lg-sq-mul s q))
                  (symw (lg-mulw-dist-l (wsq s) (wsq p) (wsq q))))
  in catw (congw (λ z → plusw z (plusw (wsq (mulw s p)) (wsq (mulw s q)))) left)
       (congw (λ z → plusw (mulw (wsq c) (plusw (wsq a) (wsq b))) z) right)
