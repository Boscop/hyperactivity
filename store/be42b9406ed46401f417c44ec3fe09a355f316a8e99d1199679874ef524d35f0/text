-- with Read(a) answering 0x35, the execution is Read(a), then Write(b, 0x6f), then Done (register r = 0)
bm-example : (a b : Nat) → (rho : Nat → Byte) →
  bm-run (toNat #12) (λ j → bm-x35) (bm-program zero a b , rho , nil) ≡ (cons (bm-read a) (cons (bm-write b bm-x6f) nil) , true)
bm-example a b rho = λ k → (cons (bm-read a) (cons (bm-write b bm-x6f) nil) , true)
