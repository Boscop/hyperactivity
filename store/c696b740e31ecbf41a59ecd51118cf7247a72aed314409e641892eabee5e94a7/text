-- 1. Sub-12h Clearance Trough & Opponent-Process Withdrawal:
--    Peak occupancy ~ d, trough occupancy at t = 12h is ρ·d, homeostatic cAMP/CREB
--    tolerance set-point is α·d (with ρ < α < 1).
--    Net affective state at trough: s(d) = ρ·d - α·d = -(α - ρ)·d.
--    Variables (0..2): d, ρ, α.
oxy-trough-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
oxy-trough-poly A ad mu q vs =
  (λ g sub →
    let d = g 0; rho = g 1; al = g 2
        z = q (fn-q 0 1)
        lhs = sub (mu rho d) (mu al d)
        rhs = sub z (mu (sub al rho) d)
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
