-- write PATH, a module the source does not hold: recorded, checked, and dropped again if it does not check
hy-created : List Word → List Word → List (List Word) → Proc W Unit
hy-created st path nil = bind (hy-forget st) (λ f → h-out (h-line (list-append path "   (a new module)")))
hy-created st path (cons p ps) = bind (h-unrecord path) (λ u → bind (hy-forget st) (λ f →
  bind (h-say (list-append (h-line "nothing written: it does not check") (h-indented "  " (cons p ps)))) (λ u2 → exit #1)))
