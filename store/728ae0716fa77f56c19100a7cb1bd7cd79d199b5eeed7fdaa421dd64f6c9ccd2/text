g-entry-of : Word → Word → Word → Word → Word → Proc W (Sum (List Word) (List (List Word × (List Word × (Word × Word))))) → Proc W (Sum (List Word) (List (List Word × (List Word × (Word × Word)))))
g-entry-of base len off ext nl rest =
  if weq nl #4095 then ret (inl "an index entry's path is 4095 bytes or longer, which this guard does not read") else
  if wlt len (wadd off (g-size ext nl)) then ret (inl "the index ends inside an entry") else
  bind (h-peek (wadd base off) (toNat #40)) (λ st →
  bind (h-peek (wadd base (wadd off #40)) (toNat #20)) (λ id →
  bind (h-peek (wadd base (wadd (wadd off #62) ext)) (toNat nl)) (λ path →
  bind rest (λ r → ret (g-cons-entry path id st r)))))
