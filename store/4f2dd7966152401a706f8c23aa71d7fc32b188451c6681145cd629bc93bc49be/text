-- (9.8) the stack-extension invariant: if the code of e occupies the bytes from a on, its #(e) steps
-- push e's meaning on any stack and leave the program counter after the code
sm-extends : (e : Expr) → (B : List Byte) → (a : Nat) → (rest : List Byte) →
  sm-drop a B ≡ list-append (sm-code e) rest → (S : List Byte) → (x : Byte) →
  sm-run B (sm-size e) (a , S , x , sm-running) ≡ (plus (list-length (sm-code e)) a , cons (denote e x) S , x , sm-running)
sm-extends Input B a rest p S x = λ i → sm-fetch (p i) a S x
sm-extends (Const b) B a rest p S x = λ i → sm-fetch (p i) a S x
sm-extends (Xor u v) B a rest p S x = sm-xor-last u v B a S x
  (sm-xor-after-v u v B a rest p S x (sm-extends v B (plus (list-length (sm-code u)) a) (cons op03 rest) (sm-at-v u v B a rest (sm-at-u u v B a rest p)) (cons (denote u x) S) x)
    (sm-xor-after-u u v B a S x (sm-extends u B a (list-append (sm-code v) (cons op03 rest)) (sm-at-u u v B a rest p) S x)))
