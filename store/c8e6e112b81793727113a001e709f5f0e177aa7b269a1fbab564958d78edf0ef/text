-- (part of language-support)
one_byte_opcode_modr_m_p : (proc_mode' : proc_mode) → (opcode : Bits #8) → Bool
one_byte_opcode_modr_m_p proc_mode' opcode =
  let t'1 : Bool
      t'1 =
        if (in_64bit_mode proc_mode') then
          (n64_bit_mode_one_byte_opcode_modr_m_p opcode)
        else
          (n32_bit_mode_one_byte_opcode_modr_m_p opcode)
  in t'1
