-- standpoint non-interference: for ANY multi-step peer computation p run across the network port,
-- Peer B's uncurated private objects have zero observable influence on Peer A's outcome
standpoint-noninterference : {K V A : Type} → (loc priv1 priv2 : CAStore K V) →
  (allow : K → Bool) → (chk : K → V → Bool) →
  ((k : K) → allow k ≡ true → priv1 k ≡ priv2 k) →
  (p : Step (StoreSig K V) A) →
  eval-peer loc (curate-store allow priv1) chk p ≡ eval-peer loc (curate-store allow priv2) chk p
standpoint-noninterference loc priv1 priv2 allow chk agree p =
  λ i → eval-peer loc (curate-ext allow priv1 priv2 agree i) chk p
