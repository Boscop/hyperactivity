-- Optimal 4-NAND2 Shared-Fanout XOR Netlist (sharing m = nand2(a, b) across both branches!):
-- Inputs (n = 2): a = inl unit, b = inr (inl unit)
-- Wire 0: m = nand2(a, b)          [env3: m = inl unit, a = inr (inl unit), b = inr (inr (inl unit))]
-- Wire 1: l = nand2(a, m)          [env4: l = inl unit, m = inr (inl unit), a = ..., b = inr (inr (inr (inl unit)))]
-- Wire 2: r = nand2(m, b)          [env5: r = inl unit, l = inr (inl unit), ...]
-- Output: o = nand2(l, r)          [4 physical NAND2 cells total — information-theoretic minimum!]
xor4-shared-net : Net B0 Empty Unit Unit (toNat #2) (toNat #3)
xor4-shared-net =
  ( sc-nand (cwire (inl unit)) (cwire (inr (inl unit)))
  , ( sc-nand (cwire (inr (inl unit))) (cwire (inl unit))
    , ( sc-nand (cwire (inr (inl unit))) (cwire (inr (inr (inr (inl unit)))))
      , (λ _ → sc-nand (cwire (inr (inl unit))) (cwire (inl unit))) ) ) )
