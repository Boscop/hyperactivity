m-Ref : {O : Sig} {A B : Type} → (A → B → Type) → Step O (MRes A) → Step O B → Type
m-Ref Q (sdone r) u = m-RefEnd Q r u
m-Ref Q (scmd c k) (sdone b) = Empty
m-Ref {O} {A} {B} Q (scmd c k) (scmd c2 k2) =
  (e : c ≡ c2) × ((r : Resp O c) → (r2 : Resp O c2) → PathP (λ i → Resp O (e i)) r r2 → m-Ref Q (k r) (k2 r2))
