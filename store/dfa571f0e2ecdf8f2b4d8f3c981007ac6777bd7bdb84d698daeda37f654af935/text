rm-wr-at : Target → RClass → Word → MPtr → RV → REv Unit
rm-wr-at t c al p v = case c of
  cl-scalar k → (case v of
    rv-s x → rm-store t k al p x
    _ → rm-throw (rx-ill-formed ri-operand-class))
  cl-fat mk → (case v of
    rv-fat a m → rm-then (rm-store t sk-ptr al p a)
                   (rm-bind (rm-off p (tg-size t ck-ptr)) (λ q → rm-store t mk al q m))
    _ → rm-throw (rx-ill-formed ri-operand-class))
  cl-unit → rm-ret unit
  cl-mem → rm-throw (rx-ill-formed ri-operand-class)
