lqg-tet-vol-closure-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-tet-vol-closure-poly A ad mu q vs =
  (λ g sub →
    let z = q (fn-q 0 1)
        j1x = g 0; j1y = g 1; j1z = g 2
        j2x = g 3; j2y = g 4; j2z = g 5
        j3x = g 6; j3y = g 7; j3z = g 8
        j4x = sub z (ad (ad j1x j2x) j3x)
        j4y = sub z (ad (ad j1y j2y) j3y)
        j4z = sub z (ad (ad j1z j2z) j3z)
        lhs = lqg-det3 A ad sub mu j4x j4y j4z j2x j2y j2z j3x j3y j3z
        rhs = sub z (lqg-det3 A ad sub mu j1x j1y j1z j2x j2y j2z j3x j3y j3z)
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
