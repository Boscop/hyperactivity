-- nk-spec: the first stage of the builder alone, a definition's code after specialization, to measure
-- each stage of the emission separately (part of machine-in-hyperactive)
nk-spec : Code → Code
nk-spec (cglob g) =
  (case unfold g return (λ _ → Code) of
     none → cword
     some c → fst (specialize (opt-or (def-type-code g) cword) sched-default lnil c))
nk-spec c = c
