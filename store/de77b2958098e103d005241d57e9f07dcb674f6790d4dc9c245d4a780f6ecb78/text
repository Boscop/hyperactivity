-- a value with both signs is 0, and so is one equal to it
sy-core-z : (A : Type) → (z : A) → (N P : A → Type) → ((x : A) → N x → P x → x ≡ z) → (sv sw : A) → sv ≡ sw → N sv → P sw → (sv ≡ z) × (sw ≡ z)
sy-core-z A z N P both sv sw e nsv psw = (both sv nsv (transport (λ i → P (e (~ i))) psw) , cl-tr A sw sv z (λ i → e (~ i)) (both sv nsv (transport (λ i → P (e (~ i))) psw)))
