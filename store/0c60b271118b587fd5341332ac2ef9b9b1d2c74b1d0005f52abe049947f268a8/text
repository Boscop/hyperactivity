-- Complete synthesizable SystemVerilog SoC:
--   1. `hypercore_rom`: compiled from `soc-demo-prog` via `encode-hart-inst`
--   2. `systolic_mac_2x2`: 2x2 MAC array lowering `systolic-step`
--   3. `hypercore_soc`: speculative next-line prefetch hart (`spipe-step`) + MMIO bus (`mmio-dispatch`)
hypercore-soc-sv : List Word
hypercore-soc-sv =
  sv-concat
    (cons sv-rom-module
    (cons sv-tensor-module
    (cons sv-soc-part1
    (cons sv-soc-part2
    (cons sv-soc-part3 nil)))))
