-- the focus through time: its last eight versions from the store's versions record, scrubbed by a slider
hi-history : List Word → Proc W (List Word)
hi-history f = bind (h-read (list-append h-source (list-append "/versions/" (h-hex f)))) (λ v →
  bind (hi-each (hi-recent (h-lines (s-or nil v))) hi-ver) (λ vs →
  ret (if h-null vs then nil else hi-sect "through time" (h-concat (cons "<div style='width:100%'><input type='range' id='hi-t' min='0' value='0' style='width:100%'><div class='who' id='hi-when'></div><div id='hi-versions'>" (cons vs (cons "</div></div>" (cons hi-scrub nil))))))))
