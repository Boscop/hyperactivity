s-uncomment : Bool → List (List Word) → List (List Word)
s-uncomment c nil = nil
s-uncomment true (cons l r) = s-uncomment (h-not (h-infix "-->" l)) r
s-uncomment false (cons l r) = if h-prefix "<!--" l then s-uncomment (h-not (h-infix "-->" l)) r
  else cons (if andB (h-prefix "#" l) (h-infix " {#" l) then h-before " {#" l else l) (s-uncomment false r)
