bn-plan-step-lem2 :
  (cap : Nat) → (p : NodePool) → (ps acc : List NodePool) → (b : Bool) →
  bn-le-nat (bn-pools-burn (cons p acc)) cap ≡ b →
  bn-le-nat (bn-pools-burn acc) cap ≡ true →
  ((acc2 : List NodePool) → bn-le-nat (bn-pools-burn acc2) cap ≡ true →
     bn-le-nat (bn-pools-burn (bn-plan-go cap ps acc2)) cap ≡ true) →
  bn-le-nat (bn-pools-burn (if b then bn-plan-go cap ps (cons p acc) else bn-plan-go cap ps acc)) cap ≡ true
bn-plan-step-lem2 _ p _ acc true  hEq _  ih = ih (cons p acc) hEq
bn-plan-step-lem2 _ _ _ acc false _   h0 ih = ih acc h0
