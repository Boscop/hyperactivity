-- the full product of two 64-bit values, by 32-bit halves
uq-mulw : UInt64 → UInt64 → DQ
uq-mulw a b =
  let m32 = u64 #4294967295
      s32 = u64 #32
      a0 = u64and a m32
      a1 = u64shr a s32
      b0 = u64and b m32
      b1 = u64shr b s32
      p00 = u64mul a0 b0
      p01 = u64mul a0 b1
      p10 = u64mul a1 b0
      p11 = u64mul a1 b1
      mid = u64add (u64add (u64shr p00 s32) (u64and p01 m32)) (u64and p10 m32)
  in (u64or (u64and p00 m32) (u64shl mid s32)
     , u64add (u64add p11 (u64shr p01 s32)) (u64add (u64shr p10 s32) (u64shr mid s32)))
