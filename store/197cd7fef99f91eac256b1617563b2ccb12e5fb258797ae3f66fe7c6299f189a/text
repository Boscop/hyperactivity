-- det(λ − q_123) at the vertex with doubled spins j1 … j4, coefficients constant first
bvol-charpoly : List Bool → List Bool → List Bool → List Bool → List BQ
bvol-charpoly j1 j2 j3 j4 = snd (bvol-steps (bin-to-nat (bin-half (bin-sub (bvol-amax j1 j2 j3 j4) (bvol-amin j1 j2 j3 j4)))) j1 j2 j3 j4
  (bin-add (bvol-amin j1 j2 j3 j4) bin-two) (cons (bq-make true bin-one bin-one) nil , cons bq-zero (cons (bq-make true bin-one bin-one) nil)))
