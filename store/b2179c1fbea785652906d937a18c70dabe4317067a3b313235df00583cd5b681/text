nk-rho-split-cons-below : (rho : NkW → NkEv) (w : NkW) (sp : NkSplit) (x : NkW) →
  (nk-wire-lt x (nk-n (nk-so sp)) ≡ true) →
  nk-rho-split-cons rho w sp x ≡ rho x
nk-rho-split-cons-below rho w (nk-split-r a b (nk-out fx n ws)) x lt =
  let lt1 = nk-wire-lt-wle-trans x n (nk-s n) lt (nk-wire-le-s n)
  in nk-rho-set-other (nk-rho-set rho n (rho w)) (nk-s n) x (rho w) (nk-wgt-neq x (nk-s n) lt1)
     ∙ nk-rho-set-other rho n x (rho w) (nk-wgt-neq x n lt)
