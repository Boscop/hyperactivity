-- in decimal, k digits: soundness, the electronic energy, the total energy, p
h2p-report : List Bool → List Bool → IV → Nat → Bool × IV → Bool × (((Bool × List Nat) × (Bool × List Nat)) × (((Bool × List Nat) × (Bool × List Nat)) × ((Bool × List Nat) × (Bool × List Nat))))
h2p-report S S2 R k r = (fst r , (iv-dec S k (h2p-energy S S2 R (snd r)) , (iv-dec S k (h2p-total S S2 R (snd r)) , iv-dec S k (snd r))))
