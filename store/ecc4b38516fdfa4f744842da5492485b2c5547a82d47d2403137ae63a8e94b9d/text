sep2d-append : (minX minY : Nat) → (r : Rect) → (xs ys : List Rect) →
  AllSep2D minX minY r xs → AllSep2D minX minY r ys → AllSep2D minX minY r (list-append xs ys)
sep2d-append minX minY r nil ys hx hy = hy
sep2d-append minX minY r (cons x xs) ys hx hy =
  (fst hx , sep2d-append minX minY r xs ys (snd hx) hy)
