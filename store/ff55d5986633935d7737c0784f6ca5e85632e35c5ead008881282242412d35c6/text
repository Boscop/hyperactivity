hs-bit : Word → Word → Word
hs-bit m k = %wand (%wshr m k) #1

-- Exact branchless 4-bit XOR forward & backward propagator (self-inverse: L edge a ^ b ^ c = 0!)
hs-fiber-xor : Word → Word → Word
hs-fiber-xor a b =
  let a0 = hs-bit a #0
      a1 = hs-bit a #1
      a2 = hs-bit a #2
      a3 = hs-bit a #3
      b0 = hs-bit b #0
      b1 = hs-bit b #1
      b2 = hs-bit b #2
      b3 = hs-bit b #3
      c0 = %wor (%wor (%wand a0 b0) (%wand a1 b1)) (%wor (%wand a2 b2) (%wand a3 b3))
      c1 = %wor (%wor (%wand a0 b1) (%wand a1 b0)) (%wor (%wand a2 b3) (%wand a3 b2))
      c2 = %wor (%wor (%wand a0 b2) (%wand a2 b0)) (%wor (%wand a1 b3) (%wand a3 b1))
      c3 = %wor (%wor (%wand a0 b3) (%wand a3 b0)) (%wor (%wand a1 b2) (%wand a2 b1))
  in %wor c0 (%wor (%wshl c1 #1) (%wor (%wshl c2 #2) (%wshl c3 #3)))

-- Exact branchless 4-bit AND forward propagator (Q edge z = x & y!)
hs-fiber-and : Word → Word → Word
hs-fiber-and x y =
  let x0 = hs-bit x #0
      x1 = hs-bit x #1
      x2 = hs-bit x #2
      x3 = hs-bit x #3
      y0 = hs-bit y #0
      y1 = hs-bit y #1
      y2 = hs-bit y #2
      y3 = hs-bit y #3
      xany = if %weq x #0 then #0 else #1
      yany = if %weq y #0 then #0 else #1
      z0 = %wor (%wor (%wand x0 yany) (%wand y0 xany)) (%wor (%wand x1 y2) (%wand x2 y1))
      z1 = %wor (%wand x1 (%wor y1 y3)) (%wand x3 y1)
      z2 = %wor (%wand x2 (%wor y2 y3)) (%wand x3 y2)
      z3 = %wand x3 y3
  in %wor z0 (%wor (%wshl z1 #1) (%wor (%wshl z2 #2) (%wshl z3 #3)))

-- Exact branchless 4-bit AND backward propagator: maximal valid mask for x given y and output z!
-- p in {0,1,2,3} is valid iff exists q in y with (p & q) in z:
--   p=0: (0&q)=0 -> valid iff z0 & (y != 0)
--   p=1: q in {0,2} -> 0; q in {1,3} -> 1 -> valid iff (z0 & (y0|y2)) | (z1 & (y1|y3))
--   p=2: q in {0,1} -> 0; q in {2,3} -> 2 -> valid iff (z0 & (y0|y1)) | (z2 & (y2|y3))
--   p=3: (3&q)=q -> valid iff (y & z) != 0
hs-fiber-and-bwd : Word → Word → Word
hs-fiber-and-bwd y z =
  let y0 = hs-bit y #0
      y1 = hs-bit y #1
      y2 = hs-bit y #2
      y3 = hs-bit y #3
      z0 = hs-bit z #0
      z1 = hs-bit z #1
      z2 = hs-bit z #2
      yany = if %weq y #0 then #0 else #1
      r0 = %wand z0 yany
      r1 = %wor (%wand z0 (%wor y0 y2)) (%wand z1 (%wor y1 y3))
      r2 = %wor (%wand z0 (%wor y0 y1)) (%wand z2 (%wor y2 y3))
      r3 = if %weq (%wand y z) #0 then #0 else #1
  in %wor r0 (%wor (%wshl r1 #1) (%wor (%wshl r2 #2) (%wshl r3 #3)))

-- Exhaustive 4,096-case verifier: checks that for EVERY (a,b) in 0..15 x 0..15 and EVERY (p,q) in 0..3 x 0..3:
--   1. (p in a /\ q in b) => (p ^ q) in hs-fiber-xor a b
--   2. (p in a /\ q in b) => (p & q) in hs-fiber-and a b
--   3. (p in a /\ q in b /\ (p & q) in z) => p in hs-fiber-and-bwd b z  (checked for all 16x16x16 triples!)
hs-in-m : Word → Word → Bool
hs-in-m p m = %weq (hs-bit m p) #1

hs-ok-pq : Word → Word → Word → Word → Word
hs-ok-pq a b p q =
  if hs-in-m p a then
    if hs-in-m q b then
      let okx = hs-in-m (%wxor p q) (hs-fiber-xor a b)
          oka = hs-in-m (%wand p q) (hs-fiber-and a b)
      in if okx then (if oka then #0 else #1) else #1
    else #0
  else #0

hs-chk-q : Nat → Word → Word → Word → Word → Word
hs-chk-q zero _ _ _ acc = acc
hs-chk-q (suc n) a b p acc =
  let q = fromNat n
  in hs-chk-q n a b p (%wadd acc (hs-ok-pq a b p q))

hs-chk-p : Nat → Word → Word → Word → Word
