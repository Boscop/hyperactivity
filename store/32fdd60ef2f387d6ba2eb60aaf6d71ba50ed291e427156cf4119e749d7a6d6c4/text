comp-ren-e : (s : TyShape) → CRenT s
comp-ren-e s-bool = ((λ Δ T ct Δ' w → one) , bool-ren)
comp-ren-e (s-pi a b) =
  (fam-ren a b (comp-ren-e a) ,
   λ Δ X cx Δ' w Δ2 w2 Y q ca → cx Δ2 (world-comp Δ2 Δ' Δ w2 w) Y (wc-tr Δ2 Δ' Δ w2 w (TV (s-pi a b)) X (fmapM Δ2 (AppV a b) (TV (s-pi a b)) (app-f a b) Y) q) ca)
comp-ren-e (s-sig a b) =
  (fam-ren a b (comp-ren-e a) ,
   λ Δ X cx Δ' w →
     (comp-fm a Δ' Δ w (TV (s-sig a b)) (sig-1 a b) X (csof-ren a (comp-ren-e a) Δ (fmapM Δ (TV (s-sig a b)) (TV a) (sig-1 a b) X) (fst cx) Δ' w) ,
      comp-fm b Δ' Δ w (TV (s-sig a b)) (sig-2 a b) X (csof-ren b (comp-ren-e b) Δ (fmapM Δ (TV (s-sig a b)) (TV b) (sig-2 a b) X) (snd cx) Δ' w)))
comp-ren-e (s-path a) =
  (path-ty-ren a (comp-ren-e a) ,
   λ Δ X cx Δ' w Δ2 w2 f cf nc →
     comp-tr a Δ2 (papp-mean Δ2 a f (wact Δ2 Δ (world-comp Δ2 Δ' Δ w2 w) (TV (s-path a)) X)) (papp-mean Δ2 a f (wact Δ2 Δ' w2 (TV (s-path a)) (wact Δ' Δ w (TV (s-path a)) X)))
       (λ i → papp-mean Δ2 a f (subM-comp Δ2 Δ' Δ w2 w (TV (s-path a)) X i))
       (cx Δ2 (world-comp Δ2 Δ' Δ w2 w) f cf nc))
