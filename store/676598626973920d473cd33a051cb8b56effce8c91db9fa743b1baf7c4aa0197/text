bin-addc-canon : (a : List Bool) → (c : Bool) → (b : List Bool) → bcanon a ≡ true → bcanon b ≡ true → bcanon (bin-addc c a b) ≡ true
bin-addc-canon a = case a return λ m → (c : Bool) → (b : List Bool) → bcanon m ≡ true → bcanon b ≡ true → bcanon (bin-addc c m b) ≡ true of
  nil → λ c b ca cb → (case c return λ u → bcanon (bin-addc u nil b) ≡ true of
    true → bin-succ-canon b cb
    false → cb)
  cons x xs → λ c b ca cb → bin-cons-canon (bit-eq (bit-eq x (bin-head b)) c) (bin-addc (carry3 x (bin-head b) c) xs (bin-tail b))
    (rec xs (carry3 x (bin-head b) c) (bin-tail b) (canon-tail x xs ca) (canon-tail-any b cb))
