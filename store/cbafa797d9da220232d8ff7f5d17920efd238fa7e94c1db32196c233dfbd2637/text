cm-ltw-le-lt : (x y z : Word) → ltw y x ≡ false → ltw y z ≡ true → ltw x z ≡ true
cm-ltw-le-lt x =
  %welimP (λ v → (y z : Word) → ltw y v ≡ false → ltw y z ≡ true → ltw v z ≡ true) x
    (λ y z h1 →
       %welimP (λ v → ltw y v ≡ true → ltw #0 v ≡ true) z
         (λ h2 → cm-ft-absurd (cm-catb (cm-symb (%welimP (λ u → ltw u #0 ≡ false) y (λ i → false) (λ n g i → false))) h2))
         (λ z1 gz h2 i → true))
    (λ x1 ih → cm-le-lt-step x1 ih)
