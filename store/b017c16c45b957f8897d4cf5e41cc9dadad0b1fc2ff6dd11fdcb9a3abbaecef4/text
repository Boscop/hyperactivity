x-lift-clo : (Code → LS → Code × LS) → Code → LS → Code × LS
x-lift-clo f c st =
  let sp = x-split c
      k = fst sp
      fv = x-frees c
      m = l-count fv
      g = snd st
      body = var-map-c (λ n d → if %wlt (%wsub n d) k then cvar n
                                else cvar (%wadd d (%wadd k (%wsub (%wsub m #1) (x-index (%wsub (%wsub n d) k) fv #0))))) #0 (snd sp)
  in x-lift-made f (x-apps (cglob g) (x-fv-vars fv) , (lcons (g , (%wadd m k , body)) (fst st) , %wsucc g))
