-- streaming graph.json node-by-node over an open descriptor so the whole JSON array is never held in memory
v-write-json-nodes : List Word → Word → Bool → List (List Word) → Proc W Unit
v-write-json-nodes st fd first nil = ret unit
v-write-json-nodes st fd first (cons i r) =
  bind (v-statement st i) (λ s →
  bind (fd-write fd (if first then v-json-node i s else cons #44 (v-json-node i s))) (λ w →
  v-write-json-nodes st fd false r))
