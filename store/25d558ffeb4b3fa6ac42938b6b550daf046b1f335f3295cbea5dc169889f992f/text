norm-suc : (e : Env) (a : LinCode) → lsem e (lnorm a) ≡ wev e a → lsem e (lnorm (lc-suc a)) ≡ wev e (lc-suc a)
norm-suc e a ha =
  catw (lsem-add e (lint #1 cnil) (lnorm a))
    (catw (congw (λ z → plusw #1 z) ha)
      (catw (plusw-suc-l #0 (wev e a)) (congw (λ z → %wsucc z) (plusw-zero-l (wev e a)))))
