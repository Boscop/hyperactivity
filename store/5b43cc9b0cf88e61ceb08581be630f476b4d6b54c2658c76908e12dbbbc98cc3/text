-- the token being read is held reversed
tok-go : List Word → List Word → List (List Word)
tok-go t =
  case t return λ w → List Word → List (List Word) of
    nil → λ cur → flush cur nil
    cons b r →
      λ cur →
        if is-space b then flush cur (rec r nil)
        else (if is-word b then rec r (cons b cur) else flush cur (cons (cons b nil) (rec r nil)))
