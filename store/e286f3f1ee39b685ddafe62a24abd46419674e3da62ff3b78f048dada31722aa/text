-- ---------------------------------------------------------------- soundness
pins-gt : (e : Val) (c : Nat) (m : Mono) (c2 : Nat) (m2 : Mono) (r2 ir : Poly) →
          pev e ir ≡ plus (times c (mev e m)) (pev e r2) →
          plus (times c2 (mev e m2)) (pev e ir) ≡ plus (times c (mev e m)) (plus (times c2 (mev e m2)) (pev e r2))
pins-gt e c m c2 m2 r2 ir h =
  transN (congN (λ z → plus (times c2 (mev e m2)) z) h) (plus-comm-mid (times c2 (mev e m2)) (times c (mev e m)) (pev e r2))
