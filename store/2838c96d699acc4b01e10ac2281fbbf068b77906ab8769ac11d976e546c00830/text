pf-chunk-ok : {A : Type} → (e : A → List Word) → (d : List Word → A) → ((a : A) → d (e a) ≡ a) →
              (a : A) → (tail : List Word) →
              pf-chunk-dec d (list-append (pf-chunk-enc e a) tail) ≡ (a , tail)
pf-chunk-ok {A} e d pf a tail =
  let h = ok-raw-list (e a) tail
  in concat {lzero} {A × List Word}
       {pf-chunk-dec d (list-append (enc-raw-list (e a)) tail)}
       {(d (e a) , tail)} {(a , tail)}
       (λ i → (d (fst (h i)) , snd (h i)))
       (λ i → (pf a i , tail))
