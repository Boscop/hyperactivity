-- everything the certificate at p = m/S checks but F's sign: the bracket lh of A canonical and ordered,
-- the angular tails at both its ends, G < 0 at its lower end and G > 0 at its upper, every evaluation
-- zero-free, the radial tail over the bracket, F's evaluation zero-free
cert-core : List Bool → List Bool → IE → IE → IE → IE → IE → IV → BZ → IV → Nat → Nat → Bool
cert-core S S2 sta gt str ce se R m lh M N =
  both (both (bcanon (snd m)) (both (bcanon (snd (fst lh))) (bcanon (snd (snd lh)))))
  (both (tail-ok S S2 (env4 (iv-unit S) (iv-mul S (m , m) (m , m)) (fst lh , fst lh) (mu-iv S (plus (suc (suc M)) (suc (suc M))))) sta)
  (both (tail-ok S S2 (env4 (iv-unit S) (iv-mul S (m , m) (m , m)) (snd lh , snd lh) (mu-iv S (plus (suc (suc M)) (suc (suc M))))) sta)
  (both (both (snd (g-val-of S S2 sta gt (iv-mul S (m , m) (m , m)) (fst lh , fst lh) M)) (iv-neg-sure (fst (g-val-of S S2 sta gt (iv-mul S (m , m) (m , m)) (fst lh , fst lh) M))))
  (both (both (snd (g-val-of S S2 sta gt (iv-mul S (m , m) (m , m)) (snd lh , snd lh) M)) (iv-pos-sure (fst (g-val-of S S2 sta gt (iv-mul S (m , m) (m , m)) (snd lh , snd lh) M))))
  (both (tail-ok S S2 (env5 (iv-unit S) (m , m) (fst (ieval S S2 (env3 R (m , m) lh) se)) (fst (ieval S S2 (env3 R (m , m) lh) ce)) (mu-iv S (suc N))) str)
        (snd (f-val-of S S2 str ce se R (m , m) lh N)))))))
