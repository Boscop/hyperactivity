ce-alloc = list-append "static uint64_t hy_bytes; static uint64_t *hy_at, *hy_end; static void *hy_alloc(uint64_t n) { hy_bytes += n; if (!hy_at || (uint64_t)(hy_end - hy_at) * 8 < n) { uint64_t m = n > (1ull << 24) ? n : (1ull << 24); hy_at = malloc(m); if (!hy_at) abort(); hy_end = hy_at + m / 8; } void *p = hy_at; hy_at += n / 8; return p; }" ce-nl
