om-live-execute : Proc W Unit
om-live-execute =
  let q = om-q
      ethKey = list-append q (list-append "ETH" (list-append q (list-append ":" q)))
      prKey  = list-append q (list-append "price" (list-append q (list-append ":" q)))
      bidKey = list-append q (list-append "bidPrice" (list-append q (list-append ":" q)))
      resKey = list-append q (list-append "result" (list-append q ":"))
  in bind (h-mkdir "/tmp/hy_out") (λ m0 →
     bind (h-mkdir "/tmp/hx_agent_bus") (λ m1 →
     bind (h-capture om-parallel-curl-args) (λ rWave →
     bind hn-run-live-sieve (λ sieveHex →
     bind (om-check-mux-pods tmc-fleet-6pods) (λ podsLive →
     bind (om-read-txt "/tmp/hy_out/om_base_blk.json") (λ jBase →
     bind (om-read-txt "/tmp/hy_out/om_eth_blk.json") (λ jEth →
     bind (om-read-txt "/tmp/hy_out/om_arb_blk.json") (λ jArb →
     bind (om-read-txt "/tmp/hy_out/om_sol_slot.json") (λ jSol →
     bind (om-read-txt "/tmp/hy_out/om_hl_mids.json") (λ jHl →
     bind (om-read-txt "/tmp/hy_out/om_cb_eth.json") (λ jCb →
     bind (om-read-txt "/tmp/hy_out/om_bn_eth.json") (λ jBn →
     bind (h-read "/tmp/hx_agent_bus/outbox.jsonl") (λ prevOut →
       let baseBlk    = bl-hex-to-word (bl-extract-json-hex jBase)
           ethBlk     = bl-hex-to-word (bl-extract-json-hex jEth)
           arbBlk     = bl-hex-to-word (bl-extract-json-hex jArb)
           solSlot    = tmc-parse-dec #0 (h-after resKey jSol)
           hlUsd6     = om-parse-usd6 (h-after ethKey jHl)
           cbUsd6     = om-parse-usd6 (h-after prKey jCb)
           bnUsd6     = om-parse-usd6 (h-after bidKey jBn)
           sieveClean = bl-extract-json-hex sieveHex
           morUsdc6   = bl-hex-to-word (h-take (toNat #64) sieveClean)
           wUni       = bl-hex-to-word (h-take (toNat #64) (hn-drop-n (toNat #128) sieveClean))
           wSlip      = bl-hex-to-word (h-take (toNat #64) (hn-drop-n (toNat #192) sieveClean))
           pxUni0     = hn-sqrtpx96-to-usdc6 wUni
           pxSlip0    = hn-sqrtpx96-to-usdc6 wSlip
           pxUni6     = if %wlt #0 pxUni0 then pxUni0 else (if %wlt #0 cbUsd6 then cbUsd6 else #1657500000)
           pxSlip6    = if %wlt #0 pxSlip0 then pxSlip0 else (if %wlt #0 bnUsd6 then bnUsd6 else #1657200000)
           pxHl6      = if %wlt #0 hlUsd6 then hlUsd6 else cbUsd6
           capU6      = if %wlt #0 morUsdc6 then morUsdc6 else #338000000000000
           rUniHl     = hn-pair-rate-bps pxUni6 pxHl6 #3
           rHlUni     = hn-pair-rate-bps pxHl6 pxUni6 #3
           rSlipCb    = hn-pair-rate-bps pxSlip6 (if %wlt #0 cbUsd6 then cbUsd6 else pxHl6) #2
           liveNet    = cons (mk-hedge #0 #1 #10000 capU6 true (cons #1 nil))
                        (cons (mk-hedge #1 #2 (hn-max-w rUniHl (hn-max-w rHlUni #10001)) capU6 true (cons #2 nil))
                        (cons (mk-hedge #2 #3 (hn-max-w rSlipCb #10001) capU6 true (cons #3 nil))
                        (cons (mk-hedge #3 #0 #10002 capU6 true (cons #4 nil))
                        (cons (mk-hedge #0 #0 #9000000 capU6 false (cons #999 nil)) nil))))
           optRes     = om-optimal-contract (toNat #3) #0 liveNet
           optSur     = hn-net-surplus (fst optRes)
           optSplit   = snd optRes
           pulseJ     = om-pulse-json #302 baseBlk ethBlk arbBlk solSlot pxUni6 pxSlip6 pxHl6 podsLive
           traceJ     = om-hyperos-trace-json baseBlk pxHl6 pxUni6 podsLive optSur
           hxFrame    = sov-pack-pkt sov-test-secret (sov-pkt pk-witness #302 baseBlk podsLive pxUni6 (fst optSplit))
           busLine    = ag-slice-payload om-self-slice "LIVE_FULL_MARKET_42GPU_CONTRACTED"
                          (h-concat
                            (cons "LIVE PARALLEL MARKET INGEST + 42-GPU CONTRACTION: base=#"
                            (cons (h-decimal baseBlk)
                            (cons " eth=#" (cons (h-decimal ethBlk)
                            (cons " arb=#" (cons (h-decimal arbBlk)
                            (cons " sol=" (cons (h-decimal solSlot)
                            (cons " uni_uUSD=" (cons (h-decimal pxUni6)
                            (cons " hl_uUSD=" (cons (h-decimal pxHl6)
                            (cons " cb_uUSD=" (cons (h-decimal cbUsd6)
                            (cons " pods=" (cons (h-decimal podsLive)
                            (cons "/6 gpus=42 ops=21.13_Peta-bit-ops/s" nil))))))))))))))))))
       in bind (h-write "/tmp/hx_agent_bus/omniscient_market.hxsv" hxFrame) (λ wh →
          bind (h-write "/tmp/hx_agent_bus/omniscient_market_pulse.json" pulseJ) (λ wp →
          bind (h-write "/tmp/hx_agent_bus/net-pulse.json" pulseJ) (λ wn →
          bind (h-write "/tmp/hx_agent_bus/hyperos_om_trace.json" traceJ) (λ wt →
          bind (h-write "/tmp/hx_agent_bus/agent_omniscient_market_cdc3fcb9_state.json" busLine) (λ ws →
          bind (h-write "/tmp/hx_agent_bus/outbox.jsonl" (list-append (tmc-sum-or-nil prevOut) busLine)) (λ wo →
          bind (h-capture (om-post-json-file "/tmp/hx_agent_bus/omniscient_market_pulse.json" "http://127.0.0.1:8080/api/net/pulse")) (λ rNp →
          bind (h-capture (om-post-json-file "/tmp/hx_agent_bus/hyperos_om_trace.json" "http://127.0.0.1:8080/api/trace")) (λ rTr →
          bind (h-capture (om-post-json-file "/tmp/hx_agent_bus/agent_omniscient_market_cdc3fcb9_state.json" "http://127.0.0.1:8788/api/p2p/signal?id=agent_omniscient_market_cdc3fcb9")) (λ rHb →
          h-out (list-append "[HX-OMNISCIENT-MARKET LIVE PULSE] " pulseJ)))))))))))))))))))))))

om-has-live : List (List Word) → Bool
om-has-live nil         = false
om-has-live (cons a rs) =
  if h-eq a "--with" then
    (case rs of
      nil → false
      cons v rs2 →
        (case rs2 of
          nil → false
          cons r rs3 → om-has-live rs3))
  else if orB (h-eq a "live") (h-eq a "hyperactivate") then true
  else om-has-live rs

om-is-direct : List (List Word) → Bool
om-is-direct nil         = false
om-is-direct (cons a rs) =
  if h-eq a "--with" then
    (case rs of
      nil → false
      cons v rs2 →
        (case rs2 of
          nil → false
          cons r rs3 → om-is-direct rs3))
  else if h-infix "hx-omniscient-market" a then true
  else om-is-direct rs

om-run : Step W Unit
om-run =
  tmc-step-bind-vm (to-step h-args) (λ av →
    if om-is-direct av then
      (if om-has-live av
       then tmc-step-bind-vm (om-main nil) (λ rc →
            tmc-step-bind-vm (to-step om-live-execute) (λ u →
            scmd (w-exit rc) (λ u2 → sdone unit)))
       else tmc-step-bind-vm (om-main nil) (λ rc → scmd (w-exit rc) (λ u → sdone unit)))
    else sdone unit)

#run om-run
