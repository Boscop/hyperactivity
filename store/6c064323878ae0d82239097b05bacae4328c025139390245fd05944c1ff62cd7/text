-- Exact Structural Allocation Proof: `rate` units of `suc cap` cover `rate` with `rate * (suc cap) >= rate`:
om-scale-units : Nat → Nat
om-scale-units rate = rate

om-le-weaken : (a b : Nat) → vh-le a b ≡ true → vh-le a (suc b) ≡ true
om-le-weaken zero    b       h = refl
om-le-weaken (suc a) zero    h = Empty-rec (vh-false-neq-true h)
om-le-weaken (suc a) (suc b) h = om-le-weaken a b h

om-le-pad-l : (c a b : Nat) → vh-le a b ≡ true → vh-le a (tmc-add c b) ≡ true
om-le-pad-l zero    a b h = h
om-le-pad-l (suc c) a b h = om-le-weaken a (tmc-add c b) (om-le-pad-l c a b h)

