-- Parse integer + 2 decimal digits of USD price string `"1658.25"` -> micro-USD `1658250000`:
om-parse-usd6 : List Word → Word
om-parse-usd6 s =
  let whole = tmc-parse-dec #0 s
      fracS = h-take (toNat #2) (list-append (h-after "." s) "00")
      frac2 = tmc-parse-dec #0 fracS
  in %wadd (%wmul whole #1000000) (%wmul frac2 #10000)

om-check-mux-pods : List TmcPod → Proc W Word
om-check-mux-pods nil = ret {lzero} {W} #0
om-check-mux-pods (cons (mk-tmc-pod nm ip port lport) ps) =
  let sock   = list-append "/tmp/hx_ssh_mux/" (list-append nm ".sock")
      remAdr = list-append "root@" ip
  in bind (h-capture (tmc-pod-check-args sock remAdr)) (λ r →
     bind (om-check-mux-pods ps) (λ rest →
       ret {lzero} {W} (%wadd (if %weq (fst r) #0 then #1 else #0) rest)))

