-- Structural dynamic hardware allocator: allocates `k` hardware units of capacity `suc c`
-- to cover ANY arbitrary real-time information bitrate `r : Nat` with ZERO dropped channels:
om-sub-nat : Nat → Nat → Nat
om-sub-nat zero    b       = zero
om-sub-nat (suc a) zero    = suc a
om-sub-nat (suc a) (suc b) = om-sub-nat a b

om-alloc-loop : Nat → Nat → Nat → Nat
om-alloc-loop zero    rem cap = zero
om-alloc-loop (suc f) zero cap = zero
om-alloc-loop (suc f) (suc r) cap =
  suc (om-alloc-loop f (om-sub-nat r cap) cap)

om-alloc-gpus : Nat → Nat → Nat
