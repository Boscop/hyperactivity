-- Build JSON-RPC 2.0 POST body with zero string-literal escapes (`om-q` = `cons #34 nil`):
om-rpc-body : List Word → List Word → List Word
om-rpc-body idStr methodStr =
  let q = om-q
  in h-concat
       (cons "{"
       (cons q (cons "jsonrpc" (cons q (cons ":" (cons q (cons "2.0" (cons q (cons ","
       (cons q (cons "id" (cons q (cons ":" (cons idStr (cons ","
       (cons q (cons "method" (cons q (cons ":" (cons q (cons methodStr (cons q (cons ","
       (cons q (cons "params" (cons q (cons ":[]}" nil)))))))))))))))))))))))))))

om-hl-body : List Word
om-hl-body =
  let q = om-q
  in h-concat (cons "{" (cons q (cons "type" (cons q (cons ":" (cons q (cons "allMids" (cons q (cons "}" nil)))))))))

om-cat-arglists : List (List (List Word)) → List (List Word)
om-cat-arglists nil         = nil
om-cat-arglists (cons a as) = list-append a (om-cat-arglists as)

om-curl-head : List (List Word)
om-curl-head =
  cons "/usr/bin/curl"
  (cons "-sS"
  (cons "--parallel"
  (cons "--parallel-immediate"
  (cons "--parallel-max"
  (cons "12" nil)))))

om-curl-post1 : List Word → List Word → List Word → List (List Word)
om-curl-post1 body outPath url =
  cons "--max-time" (cons "4"
  (cons "-X" (cons "POST"
  (cons "-H" (cons "Content-Type: application/json"
  (cons "--data" (cons body
  (cons "-o" (cons outPath (cons url nil))))))))))

om-curl-next-post : List Word → List Word → List Word → List (List Word)
om-curl-next-post body outPath url =
  cons "--next" (cons "-sS" (om-curl-post1 body outPath url))

om-curl-next-get : List Word → List Word → List (List Word)
om-curl-next-get outPath url =
  cons "--next" (cons "-sS"
  (cons "--max-time" (cons "4"
  (cons "-o" (cons outPath (cons url nil))))))

