GnKnot : Type → Type → Type
GnKnot A B =
  (fwd : A → B) ×
  ((bwd : B → A) ×
  (((a : A) → bwd (fwd a) ≡ a) ×
   ((b : B) → fwd (bwd b) ≡ b)))

gn-knot : {A B : Type} →
  (f : A → B) → (g : B → A) →
  ((a : A) → g (f a) ≡ a) →
  ((b : B) → f (g b) ≡ b) → GnKnot A B
gn-knot f g r s = (f , (g , (r , s)))

gn-knot-sym : {A B : Type} → GnKnot A B → GnKnot B A
gn-knot-sym k = gn-knot (fst (snd k)) (fst k) (snd (snd (snd k))) (fst (snd (snd k)))

gn-thm-knot-sym-invol : {A B : Type} → (k : GnKnot A B) → gn-knot-sym (gn-knot-sym k) ≡ k
gn-thm-knot-sym-invol k = refl

gn-path-trans : {A : Type} → {x y z : A} → x ≡ y → y ≡ z → x ≡ z
gn-path-trans {A} {x} {y} {z} p q =
  λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

gn-path-cong : {A B : Type} → (f : A → B) → {x y : A} → x ≡ y → f x ≡ f y
gn-path-cong f p = λ i → f (p i)

gn-knot-comp : {A B C : Type} → GnKnot A B → GnKnot B C → GnKnot A C
gn-knot-comp k1 k2 =
  gn-knot
    (λ a → fst k2 (fst k1 a))
    (λ c → fst (snd k1) (fst (snd k2) c))
    (λ a → gn-path-trans (gn-path-cong (fst (snd k1)) (fst (snd (snd k2)) (fst k1 a))) (fst (snd (snd k1)) a))
    (λ c → gn-path-trans (gn-path-cong (fst k2) (snd (snd (snd k1)) (fst (snd k2) c))) (snd (snd (snd k2)) c))

gn-thm-knot-assoc : {A B C D : Type} →
  (k1 : GnKnot A B) → (k2 : GnKnot B C) → (k3 : GnKnot C D) → (a : A) →
  fst (gn-knot-comp (gn-knot-comp k1 k2) k3) a ≡ fst (gn-knot-comp k1 (gn-knot-comp k2 k3)) a
gn-thm-knot-assoc k1 k2 k3 a = refl

-- Univalent Portal Arrival: any theorem r : P B arrives in workspace A along e : A == B!
gn-portal-arrive : {A B : Type 0} → (P : Type 0 → Type 0) → (e : A ≡ B) → P B → P A
gn-portal-arrive P e r = transport (λ i → P (e (~ i))) r

gn-thm-portal-refl : {A : Type 0} → (P : Type 0 → Type 0) → (r : P A) →
  gn-portal-arrive P refl r ≡ r
gn-thm-portal-refl P r = transportRefl

