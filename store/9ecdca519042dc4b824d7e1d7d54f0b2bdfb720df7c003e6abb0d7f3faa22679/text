zle-mul-nonpos : (a b v : Nat × Nat) → zle v (zero , zero) → zle a b → zle (zmul b v) (zmul a v)
zle-mul-nonpos a b v hv h = zle-zeq-r (zmul b v) (zmul a (zero , fst hv)) (zmul a v)
  (zmul-zeq-r a (zero , fst hv) v (zneg-eq v hv))
  (zle-zeq-l (zmul b (zero , fst hv)) (zmul b v) (zmul a (zero , fst hv))
    (zmul-zeq-r b (zero , fst hv) v (zneg-eq v hv))
    (zle-mul-negk a b (fst hv) h))
