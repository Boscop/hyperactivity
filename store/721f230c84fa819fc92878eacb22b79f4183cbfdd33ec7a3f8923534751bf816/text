-- Theorem (`ec-conscious-mask-fails`):
-- If two internal states s1, s2 have distinct autonomic signatures (auto s1 ≡ auto s2 → Empty),
-- then NO conscious modulation `mask` satisfying `Unfakeable auto mask` can make their
-- observed autonomic outputs agree (auto (mask s1) ≡ auto (mask s2) → Empty).
ec-conscious-mask-fails :
  {S Y : Type 0} → (auto : S → Y) → (mask : S → S) →
  Unfakeable auto mask →
  (s1 s2 : S) → (auto s1 ≡ auto s2 → Empty) →
  auto (mask s1) ≡ auto (mask s2) → Empty
ec-conscious-mask-fails auto mask unf s1 s2 neq masked-eq =
  neq (concat (sym (unf s1)) (concat masked-eq (unf s2)))
