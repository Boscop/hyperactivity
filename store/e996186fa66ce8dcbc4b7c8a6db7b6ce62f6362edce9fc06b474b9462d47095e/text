-- Exact 16-case Marching Squares cell emitter (v0=TL, v1=TR, v2=BR, v3=BL)
lv-cell-segs : Word → Word → SInt → SInt → SInt → SInt → List Seg → List Seg
lv-cell-segs ix iy v0 v1 v2 v3 acc =
  let b0 = lv-pos v0
      b1 = lv-pos v1
      b2 = lv-pos v2
      b3 = lv-pos v3
      c = wadd (if b0 then #8 else #0)
            (wadd (if b1 then #4 else #0)
              (wadd (if b2 then #2 else #0) (if b3 then #1 else #0)))
  in if weq c #0 then acc
     else if weq c #15 then acc
     else let px = sp (wadd #1280 (wmul ix #32))
              py = sp (wadd #1280 (wmul iy #32))
              px1 = si-add px (sp #32)
              py1 = si-add py (sp #32)
              eT = (si-add px (lv-interp v0 v1) , py)
              eR = (px1 , si-add py (lv-interp v1 v2))
              eB = (si-add px (lv-interp v3 v2) , py1)
              eL = (px , si-add py (lv-interp v0 v3))
          in if weq c #1 then lv-add4 eL eB acc
             else if weq c #2 then lv-add4 eB eR acc
             else if weq c #3 then lv-add4 eL eR acc
             else if weq c #4 then lv-add4 eR eT acc
             else if weq c #5 then lv-add4 eL eT (lv-add4 eR eB acc)
             else if weq c #6 then lv-add4 eB eT acc
             else if weq c #7 then lv-add4 eL eT acc
             else if weq c #8 then lv-add4 eT eL acc
             else if weq c #9 then lv-add4 eT eB acc
             else if weq c #10 then lv-add4 eT eR (lv-add4 eB eL acc)
             else if weq c #11 then lv-add4 eT eR acc
             else if weq c #12 then lv-add4 eR eL acc
             else if weq c #13 then lv-add4 eR eB acc
             else lv-add4 eB eL acc
