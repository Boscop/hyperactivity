in-emit-op : List Word → Word → List Word → List Word → List Word
in-emit-op zero-lit t a b =
  if %weq t #0 then list-append "(" (list-append a (list-append " ^ " (list-append b ")")))
  else if %weq t #1 then list-append "(" (list-append a (list-append " & " (list-append b ")")))
  else if %weq t #2 then list-append "(~(" (list-append a (list-append " & " (list-append b "))")))
  else if %weq t #3 then list-append "(~" (list-append a ")")
  else list-append "(" (list-append a (list-append " ^ " (list-append b ")")))
