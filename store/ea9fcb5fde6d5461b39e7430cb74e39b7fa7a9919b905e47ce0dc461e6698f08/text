bn-find-base-accept : Nat → List Word → List Word
bn-find-base-accept zero    bs = nil
bn-find-base-accept (suc k) bs =
  let pr  = bn-take-json-obj-go (toNat #2048) #0 false false bs
      obj = fst pr
      rst = snd pr
  in if h-null obj then nil
     else if andB (h-infix (bn-jkv "scheme" "exact" "") obj)
                  (h-infix (bn-jkv "network" "eip155:8453" "") obj)
          then obj
          else bn-find-base-accept k rst
