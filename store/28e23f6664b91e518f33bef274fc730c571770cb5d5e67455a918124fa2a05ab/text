hy-change-many : List Word → List Word → List (List Word) → List (List Word) → List (List Word × (List Word × List Word)) → List (List Word) → Proc W Unit
hy-change-many st m names ts cs roots =
  bind (hy-write-files m cs true) (λ u →
  bind (hy-verdicts st m roots) (λ after →
  bind (hy-read-backs st names ts) (λ rb →
  hy-keep-many st m names cs roots (list-append (hy-wrong after) rb))))
