lexle : {A : Type} → (A → A → Bool) → List A → List A → Bool
lexle le xs ys =
  (case xs return λ w → List A → Bool of
     nil → λ ys → true
     cons x xs1 →
       λ ys →
         case ys return λ w → Bool of
           nil → false
           cons y ys1 → lex-step (le x y) (le y x) (rec xs1 ys1)) ys
