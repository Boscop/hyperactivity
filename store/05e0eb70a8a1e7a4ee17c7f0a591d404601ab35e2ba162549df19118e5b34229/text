v-tree-line : VEnv → Nat → List Word → List Word → List Word
v-tree-line env d via n =
  let ks = v-look-list n (ve-ktab env) in
  let leaf = v-empty ks in
  let done = h-has n (ve-comp env) in
  let ps = v-look-list n (ve-ptab env) in
  let also = v-filter (λ p → h-not (h-eq p via)) ps in
  let open-under = v-filter (λ u → h-has u (ve-leaves env)) (v-look-list n (ve-und env)) in
  list-append (v-indent d) (list-append (v-look-word n (ve-sents env)) (list-append "  [" (list-append n
  (list-append (if leaf then (if h-has n (ve-ip env) then ", in progress]" else if done then ", resolved]" else if h-has n (ve-leaves env) then "]" else ", not needed]")
               else if done then ", resolved]" else list-append "; " (list-append (h-decimal (fromNat (list-length open-under))) " open tasks under it]"))
  (h-line (if andB (h-not (h-null via)) (h-not (v-empty also))
           then list-append "  (also " (list-append (v-joined ", " also) ")") else nil))))))
