expand-motif-cell-shift : (pat : List MTerm) → (t : MTerm) →
                          expand-motif-cell pat (mterm-shift-ref t) ≡ cons t nil
expand-motif-cell-shift pat t =
  case t return (λ u → expand-motif-cell pat (mterm-shift-ref u) ≡ cons u nil) of
    mempty → λ i → cons mempty nil
    mlit a → λ i → cons (mlit a) nil
    mref k → λ i → cons (mref k) nil
    mapp tid arg → λ i → cons (mapp tid (mterm-subst-shift-ref (mterm-pack-list pat) arg i)) nil
    mcat l r → λ i → cons (mcat (mterm-subst-shift-ref (mterm-pack-list pat) l i) (mterm-subst-shift-ref (mterm-pack-list pat) r i)) nil
