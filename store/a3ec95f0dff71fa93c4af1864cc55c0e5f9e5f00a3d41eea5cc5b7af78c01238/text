-- the staged entries with the view's entries cut to the ones kept: what the source holds at each path is
-- read once, which is what was read before, once per entry
os-kept : List (List Word) → List (List Word × (List Word × (Word × Word))) → List (List Word × (List Word × (Word × Word)))
os-kept keep nil = nil
os-kept keep (cons e r) = if h-prefix "store/entries/" (fst e) then (if h-has (fst e) keep then cons e (os-kept keep r) else os-kept keep r) else cons e (os-kept keep r)
