hy-write-new-module : List Word → List Word → List Word → List Word → Sum Unit (List Word) → Proc W Unit
hy-write-new-module st m path t (inr s) = h-fail (list-append path ": the source holds no head of it (no piece before its first definition)")
hy-write-new-module st m path t (inl u) = bind (h-record m path t) (λ w →
  bind (hy-verdicts st m (cons path nil)) (λ vs → hy-created path (hy-wrong (cons (true , nil) nil) vs)))
