-- the ε contraction of the last two variables (b-leg, then a-leg), dropping both
contr-entry : List Nat → List Nat → SQ
contr-entry t s = if exp-eq t (exp-init (exp-init s)) then (if eqb (exp-last (exp-init s)) (suc zero) then (if eqb (exp-last s) zero then sq-one else sq-zero) else (if eqb (exp-last s) (suc zero) then sq-neg sq-one else sq-zero)) else sq-zero
