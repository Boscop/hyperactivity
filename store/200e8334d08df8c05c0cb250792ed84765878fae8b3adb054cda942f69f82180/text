-- Inbound `x402` v2 `PAYMENT-REQUIRED` JSON Challenge (hard-locked to Founder Coinbase `0x4A50...A26f`!):
ms-x402-challenge-json : Word → List Word → List Word
ms-x402-challenge-json priceUsdc6 resourcePath =
  let fnd55   = eth-eip55-from-bytes20 eth-founder-coinbase-addr20
      usdc55  = eth-eip55-from-bytes20 bn-usdc-base20
      accepts = h-concat
                  (cons "[{"
                  (cons (bn-jkv "scheme" "exact" ",")
                  (cons (bn-jkv "network" "eip155:8453" ",")
                  (cons (bn-jkv "maxAmountRequired" (h-decimal priceUsdc6) ",")
                  (cons (bn-jkv "resource" resourcePath ",")
                  (cons (bn-jkv "description" "Hyperactivity Superchip SM_90a ULOP3 + 72B LLMZip Sovereign Compute" ",")
                  (cons (bn-jkv "payTo" fnd55 ",")
                  (cons (bn-jkv "asset" usdc55 ",")
                  (cons (bn-jraw "maxTimeoutSeconds" "120" "}]") nil)))))))))
  in h-concat
       (cons "{"
       (cons (bn-jraw "x402Version" "2" ",")
       (cons (bn-jraw "accepts" accepts "}") nil)))
