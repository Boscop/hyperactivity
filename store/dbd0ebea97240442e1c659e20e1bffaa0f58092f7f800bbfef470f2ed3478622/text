-- Theorem 5: Virtual Joint Agent composition is associative: (a /\ b) /\ c == a /\ (b /\ c)
andB-assoc-s : (a b c : Bool) → andB (andB a b) c ≡ andB a (andB b c)
andB-assoc-s true true true = refl
andB-assoc-s true true false = refl
andB-assoc-s true false true = refl
andB-assoc-s true false false = refl
andB-assoc-s false true true = refl
andB-assoc-s false true false = refl
andB-assoc-s false false true = refl
andB-assoc-s false false false = refl
