-- the frame of instance i at entry, from the argument slots
rm-frames-go : List RInstance → Target → RCrate → Word → List RSlot → List RSlot → REv RFrame
rm-frames-go nil t c = λ i img args → rm-throw (rx-ill-formed (ri-no-body i))
rm-frames-go (cons x xs) t c =
  rm-tcons {List RSlot → List RSlot → REv RFrame}
    (sr-on (rm-inst-cx t c x) (λ e img args → rm-throw e) (λ cb →
       rm-frame-go (rb-locals (snd cb)) (fst cb) (rb-blocks (snd cb)) (rb-argc (snd cb)) #0))
    (rm-frames-go xs t c)
