-- (part of language-support)
wme_size : (proc_mode' : proc_mode) → (addr_size : ZI) → (nbytes : ZI) → (eff_addr : Bits #64) → (base_reg : Option ZI) → (seg_reg : ZI) → (data' : Bits #128) → (check_alignment? : Bool) → (mem_ptr? : Bool) → MS Unit
wme_size proc_mode' addr_size nbytes eff_addr base_reg seg_reg data' check_alignment? mem_ptr? =
  store_bytes_to_ea proc_mode' addr_size nbytes eff_addr base_reg seg_reg (bv-trunc #128 (z-nat (z-mul (zpos #8) nbytes)) data') check_alignment? mem_ptr?
