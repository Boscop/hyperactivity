-- ---------------------------------------------------------------- a sorted list is fixed by its multiplicities
count-head : {o : Ord} → (x : El o) → (l : List (El o)) → count x (cons x l) ≡ suc (count x l)
count-head x l =
  cong {_} {_} {_} {Nat} (λ bb → plus (one-if bb) (count x l)) (isTrue→eq {eqo x x} (eqo-refl x))
