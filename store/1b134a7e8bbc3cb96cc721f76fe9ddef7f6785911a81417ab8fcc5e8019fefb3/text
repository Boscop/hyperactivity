-- (Hm_x, Hm_y) as the double sum over their monomials
hq-pair : Nat → Nat → BQ × (Nat × (Nat × Nat)) → BQ × (Nat × (Nat × Nat)) → BQ × (BQ × BQ)
hq-pair ap aq t v = n3-sc (bq-mul (fst t) (fst v)) (hq-K ap aq (plus (fst (snd t)) (fst (snd v))) (plus (fst (snd (snd t))) (fst (snd (snd v)))) (plus (snd (snd (snd t))) (snd (snd (snd v)))))
