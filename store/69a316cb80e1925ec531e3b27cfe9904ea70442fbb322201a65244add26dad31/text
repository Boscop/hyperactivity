reidx-push-d : (n : Nat) (X : Type 1) (Y F : X → Type 1) (Z W : Type 1) (F' : Z → Type 1) (H : W → Type 1) (g : (x : X) → Y x → Z)
  (gF : (x : X) (y : Y x) → F x → F' (g x y)) (h : Z → W) (hF : (z : Z) → F' z → H (h z)) (c : Cube n X) (d : DCube n X Y c) (e : DCube n X F c) →
  PathP (λ i → DCube n W H (dmap-map n X Y Z W g h c d i))
    (dcube-reidx n Z W F' H h hF (dcube-map n X Y Z g c d) (dcube-push n X Z Y F F' g gF c d e))
    (dcube-push n X W Y F H (λ x y → h (g x y)) (λ x y z → hF (g x y) (gF x y z)) c d e)
reidx-push-d zero X Y F Z W F' H g gF h hF c d e = λ i → hF (g c d) (gF c d e)
reidx-push-d (suc n) X Y F Z W F' H g gF h hF c d e =
  reidx-push-d n (Line X) (LineO X Y) (LineO X F) (Line Z) (Line W) (LineO Z F') (LineO W H) (lineo-map X Y Z g) (lineo-push X Z Y F F' g gF)
    (line-map Z W h) (lineo-reidx Z W F' H h hF) c d e
