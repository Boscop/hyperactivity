-- (2026-11-12) matches CCHM §6.2 “Composition for glueing” and appendix A “Details of composition for glueing”, step for step: a1 the composite of the unglued
-- tube (al its filler); on δ = ∀i.φ(i) the composite t1' in the face types and the path ω from its
-- image to a1 (vpart, the pres construction); on φ(i1) the fibre (α) given by contracting the
-- fibre of the equivalence at a1, extended by vpart (tp); the base a1 composed along α back to f
-- t1 on φ(i1) and constant on the tube's face; glued.
%comp-glue A S u u0 =
  let a0 = unglue (S @ 0) u0
      al = λ (k : I) → fill A (sysmap (λ w (i : I) → unglue (S @ i) (w @ i)) u) a0 k
      a1 = al @ 1
      delta = (∀ i → (faceof (S @ i)))
      S1 = S @ 1
      alpha1 = faceof S1
      vpart = sys+ delta
                (let tl = λ (k : I) → fill (λ (i : I) → fst (S @ i)) u u0 k
                 in (tl @ 1
                    , λ (q : I) →
                        comp A
                          (sys+ (q = 0) (λ (i : I) → fst (snd (S @ i)) (tl @ i))
                             (sys+ (q = 1) al (sysmap (λ w → al) u))) a0))
                (sysmap (λ w → (w @ 1 , λ (q : I) → a1)) u)
      tp = sys+ alpha1
             (let C = snd (snd S1) a1
              in hcomp (fib (fst S1) (A @ 1) (fst (snd S1)) a1)
                   (sysmap (λ w (j : I) → %@ (snd C w) j (fst C) w) vpart) (fst C)) []
      P = sysmap (λ e (q : I) → %@ (snd e) (~ q) (fst (snd S1) (fst e)) a1) tp
  in glue (sysmap (λ e → fst e) tp)
       (hcomp (A @ 1) (sys+ (faceof P) P (sysmap (λ w (q : I) → a1) u)) a1)
