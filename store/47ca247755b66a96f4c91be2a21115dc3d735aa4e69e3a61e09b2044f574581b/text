cs-hy-mod-at : (z : Bool) (hp : CsHeap) (a b : Word) → (%weq b #0 ≡ z) →
  cs-no-ub (if z then cso-ok hp (csv-word a) else cs-prim-res hp (cs-c11-mod a b)) ≡ true
cs-hy-mod-at true hp a b hb = refl
cs-hy-mod-at false hp a b hb =
  cong (λ z → cs-no-ub (cs-prim-res hp (if z then csp-ub else csp-ok (%wmod a b)))) hb
