<script>
(function(){
  'use strict';

  var ac = null;
  function getAC(){
    if (!ac) ac = new (window.AudioContext || window.webkitAudioContext)();
    if (ac.state === 'suspended') ac.resume();
    return ac;
  }

  function theme(){
    var dark = document.documentElement.classList.contains('dark');
    return {
      dark: dark,
      bg: dark ? '#000000' : '#ffffff',
      ink: dark ? '#ffffff' : '#000000',
      muted: dark ? '#8c8c8c' : '#666666',
      grid: dark ? 'rgba(255,255,255,0.12)' : 'rgba(0,0,0,0.10)',
      pink: '#ff0a94',
      blue: dark ? '#4da3ff' : '#1a73e8',
      amber: dark ? '#ffbe3b' : '#b86e00'
    };
  }

  function fitCanvas(cv){
    var r = cv.getBoundingClientRect();
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var w = Math.max(1, Math.round(r.width * dpr));
    var h = Math.max(1, Math.round(r.height * dpr));
    if (cv.width !== w || cv.height !== h) { cv.width = w; cv.height = h; }
    var ctx = cv.getContext('2d');
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, r.width, r.height);
    return { ctx: ctx, w: r.width, h: r.height };
  }

  function bestRat(x, maxQ){
    var bp = 1, bq = 1, be = Math.abs(x - 1);
    for (var q = 1; q <= maxQ; q++) {
      var p = Math.round(x * q);
      if (p < 0) continue;
      var e = Math.abs(x - p / q);
      if (e < be - 1e-9) { be = e; bp = p; bq = q; }
    }
    return { p: bp, q: bq, err: be };
  }

  function sbPath(p, q, maxSteps){
    var p1 = 0, q1 = 1, p2 = 1, q2 = 0, out = [];
    for (var i = 0; i < (maxSteps || 10); i++) {
      var mp = p1 + p2, mq = q1 + q2;
      if (mp === p && mq === q) break;
      if (p * mq < mp * q) { p2 = mp; q2 = mq; out.push('L'); }
      else { p1 = mp; q1 = mq; out.push('R'); }
    }
    return out.length ? out.join(' · ') : '∅ (1/1)';
  }

  /* =========================================================================
   * LAB 1: Coupled Cyclic Channel (O(1) Memory <=> Rational Balance)
   * ========================================================================= */
  var l1 = {
    ratio: 1.5, targetP: 2, targetQ: 3, // consumer consumes q=3? Wait: balance wA*p = wB*q => wA/wB = q/p
    handshake: false, audioOn: false,
    oscA: null, oscB: null, gain: null,
    phaseA: 0, phaseB: 0, buf: 1, maxBuf: 4,
    history: [], t: 0, peak: 1
  };
  var l1BufCv = document.getElementById('l1BufCv');
  var l1LissCv = document.getElementById('l1LissCv');
  var l1RatioEl = document.getElementById('l1Ratio');

  function l1ResetHistory(){
    l1.buf = 1; l1.peak = 1; l1.phaseA = 0; l1.phaseB = 0; l1.history = [];
  }

  function l1SyncUI(){
    var r = l1.ratio;
    var target = l1.targetQ / l1.targetP;
    var baseHz = 220;
    var beatHz = Math.abs(baseHz * r - baseHz * target);
    var br = bestRat(r, 12);
    document.getElementById('l1RatioVal').textContent = r.toFixed(3) + (br.err < 0.004 ? ' (' + br.p + ':' + br.q + ')' : '');
    document.getElementById('l1mRatio').textContent = r.toFixed(3);
    document.getElementById('l1mTarget').textContent = l1.targetQ + ' : ' + l1.targetP;
    var locked = Math.abs(r - target) < 0.004;
    document.getElementById('l1Stat').textContent = locked
      ? ('BALANCED · ' + l1.targetQ + ' : ' + l1.targetP)
      : (l1.handshake ? 'GALS HANDSHAKE LOCKED (STALLS)' : 'DETUNED · DRIFTING');
    document.getElementById('l1BufLbl').textContent = locked
      ? 'BOUNDED O(1)'
      : (l1.handshake ? 'CLAMPED ≤ 4 (GALS)' : 'UNBOUNDED DRIFT');
    document.getElementById('l1LissLbl').textContent = br.err < 0.004 ? ('Closed ' + br.p + ':' + br.q) : 'Open Quasi-Periodic';
    document.getElementById('l1mBeat').textContent = beatHz < 0.25 ? '0.0 Hz (Locked)' : (beatHz.toFixed(1) + ' Hz Beat');
    if (l1.audioOn && l1.oscA && l1.oscB) {
      var c = getAC();
      l1.oscB.frequency.setTargetAtTime(baseHz, c.currentTime, 0.02);
      l1.oscA.frequency.setTargetAtTime(baseHz * r, c.currentTime, 0.02);
    }
  }

  function l1ToggleAudio(){
    l1.audioOn = !l1.audioOn;
    var b = document.getElementById('l1Audio');
    b.textContent = l1.audioOn ? '■ Mute Channel' : '▶ Listen to Channel';
    if (!l1.audioOn) {
      if (l1.oscA) { try { l1.oscA.stop(); } catch(e){} l1.oscA = null; }
      if (l1.oscB) { try { l1.oscB.stop(); } catch(e){} l1.oscB = null; }
      return;
    }
    var c = getAC();
    var g = c.createGain(); g.gain.value = 0.075; g.connect(c.destination);
    var oA = c.createOscillator(), oB = c.createOscillator();
    oA.type = 'triangle'; oB.type = 'sine';
    oB.frequency.value = 220; oA.frequency.value = 220 * l1.ratio;
    oA.connect(g); oB.connect(g); oA.start(); oB.start();
    l1.oscA = oA; l1.oscB = oB; l1.gain = g;
    l1SyncUI();
  }

  document.getElementById('l1Audio').onclick = l1ToggleAudio;
  document.getElementById('l1Handshake').onclick = function(){
    l1.handshake = !l1.handshake;
    this.textContent = 'GALS Backpressure: ' + (l1.handshake ? 'ON' : 'OFF');
    this.classList.toggle('on', l1.handshake);
    l1ResetHistory();
    l1SyncUI();
  };
  l1RatioEl.oninput = function(){
    l1.ratio = parseFloat(this.value);
    l1ResetHistory();
    l1SyncUI();
  };
  document.querySelectorAll('[data-l1]').forEach(function(btn){
    btn.onclick = function(){
      document.querySelectorAll('[data-l1]').forEach(function(x){ x.classList.toggle('on', x === btn); });
      var k = btn.dataset.l1;
      if (k === '3:2') { l1.targetQ = 3; l1.targetP = 2; l1.ratio = 1.5; }
      else if (k === '4:3') { l1.targetQ = 4; l1.targetP = 3; l1.ratio = 4/3; }
      else if (k === '5:4') { l1.targetQ = 5; l1.targetP = 4; l1.ratio = 1.25; }
      else if (k === 'detune') { l1.targetQ = 3; l1.targetP = 2; l1.ratio = 1.545; }
      else if (k === 'phi') { l1.targetQ = 3; l1.targetP = 2; l1.ratio = 1.618; }
      l1RatioEl.value = l1.ratio.toFixed(3);
      l1ResetHistory();
      l1SyncUI();
    };
  });
  l1SyncUI();

  function stepLab1(dt){
    l1.t += dt;
    var baseRate = 2.6;
    var stepB = dt * baseRate;
    var stepA = dt * baseRate * l1.ratio;
    l1.phaseA += stepA;
    l1.phaseB += stepB;
    var stalled = false;
    while (l1.phaseA >= 1) {
      l1.phaseA -= 1;
      if (l1.handshake && l1.buf + l1.targetP > l1.maxBuf) {
        stalled = true;
      } else {
        l1.buf += l1.targetP;
      }
    }
    while (l1.phaseB >= 1) {
      l1.phaseB -= 1;
      if (l1.buf >= l1.targetQ) l1.buf -= l1.targetQ;
      else if (!l1.handshake) l1.buf -= l1.targetQ; // negative = starvation deficit
    }
    if (Math.abs(l1.buf) > l1.peak) l1.peak = Math.abs(l1.buf);
    if (l1.buf > 40) l1.buf = 40;
    if (l1.buf < -20) l1.buf = -20;
    l1.history.push({ v: l1.buf, s: stalled });
    if (l1.history.length > 220) l1.history.shift();
    document.getElementById('l1mPeak').textContent = Math.round(l1.peak) + ' tokens';

    var C = theme();
    // Buffer history canvas
    var b = fitCanvas(l1BufCv), ctx = b.ctx;
    var pad = 28, gw = b.w - pad * 2, gh = b.h - pad * 2;
    var maxV = Math.max(8, l1.peak + 2);
    var zeroY = b.h - pad - (gh * (0.2));
    ctx.strokeStyle = C.grid; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(pad, zeroY); ctx.lineTo(b.w - pad, zeroY); ctx.stroke();
    if (l1.handshake) {
      var capY = zeroY - (l1.maxBuf / maxV) * (gh * 0.78);
      ctx.strokeStyle = C.blue; ctx.setLineDash([4, 4]);
      ctx.beginPath(); ctx.moveTo(pad, capY); ctx.lineTo(b.w - pad, capY); ctx.stroke();
      ctx.setLineDash([]);
    }
    if (l1.history.length > 1) {
      ctx.strokeStyle = C.pink; ctx.lineWidth = 2;
      ctx.beginPath();
      for (var i = 0; i < l1.history.length; i++) {
        var x = pad + (i / 219) * gw;
        var y = zeroY - (l1.history[i].v / maxV) * (gh * 0.78);
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.stroke();
    }
    ctx.fillStyle = C.muted; ctx.font = '600 10.5px ui-monospace,Menlo,monospace';
    ctx.fillText('B = ' + l1.buf.toFixed(0), pad + 4, 18);
    ctx.fillText('0', 8, zeroY + 4);

    // True-ratio Lissajous canvas (exact ratio, never clamped!)
    var l = fitCanvas(l1LissCv), lx = l.ctx;
    var cx = l.w / 2, cy = l.h / 2, R = Math.min(cx, cy) - 20;
    lx.strokeStyle = C.grid; lx.lineWidth = 1;
    lx.strokeRect(cx - R, cy - R, R * 2, R * 2);
    lx.strokeStyle = C.pink; lx.lineWidth = 1.8;
    lx.beginPath();
    var br = bestRat(l1.ratio, 12);
    var turns = br.err < 0.004 ? br.q : 9;
    var steps = 520;
    for (var j = 0; j <= steps; j++) {
      var u = (j / steps) * Math.PI * 2 * turns;
      var px = cx + Math.sin(u * l1.ratio + l1.t * 0.8) * R * 0.92;
      var py = cy + Math.sin(u) * R * 0.92;
      if (j === 0) lx.moveTo(px, py); else lx.lineTo(px, py);
    }
    lx.stroke();
  }

  /* =========================================================================
   * LAB 2: Real Circle-Map Arnold Tongues & Devil's Staircase
   * ========================================================================= */
  var l2 = {
    omega: 2/3, K: 0.75, audioOn: false,
    oscA: null, oscB: null, mapImg: null, mapW: 0, mapH: 0
  };
  var l2MapCv = document.getElementById('l2MapCv');
  var l2StairCv = document.getElementById('l2StairCv');

  function windingNumber(omega, K, iters){
    var th = 0.137;
    var k2p = K / (Math.PI * 2);
    for (var i = 0; i < 40; i++) th = th + omega - k2p * Math.sin(Math.PI * 2 * th);
    var th0 = th;
    var N = iters || 90;
    for (var j = 0; j < N; j++) th = th + omega - k2p * Math.sin(Math.PI * 2 * th);
    return (th - th0) / N;
  }

  function renderArnoldMap(){
    var f = fitCanvas(l2MapCv), ctx = f.ctx, w = Math.floor(f.w), h = Math.floor(f.h);
    var C = theme();
    // Compute crisp grid (160 x 110) once per theme change for instant interactive redraw
    var gw = 160, gh = 110;
    if (!l2.mapCache || l2.mapDark !== C.dark) {
      var off = document.createElement('canvas');
      off.width = gw; off.height = gh;
      var octx = off.getContext('2d');
      var img = octx.createImageData(gw, gh);
      var targets = [
        [0,1],[1,1],[1,2],[1,3],[2,3],[1,4],[3,4],[1,5],[2,5],[3,5],[4,5],[1,6],[5,6]
      ];
      for (var y = 0; y < gh; y++) {
        var K = (1 - y / (gh - 1)) * 1.2;
        for (var x = 0; x < gw; x++) {
          var om = x / (gw - 1);
          var W = windingNumber(om, K, 64);
          var lockedQ = 0;
          for (var t = 0; t < targets.length; t++) {
            if (Math.abs(W - targets[t][0] / targets[t][1]) < 0.0045) {
              lockedQ = targets[t][1];
              break;
            }
          }
          var idx = (y * gw + x) * 4;
          if (lockedQ > 0) {
            var shade = Math.max(0.32, 1.0 - (lockedQ - 1) * 0.13);
            img.data[idx] = Math.round(255 * shade);
            img.data[idx + 1] = Math.round(10 * shade);
            img.data[idx + 2] = Math.round(148 * shade);
            img.data[idx + 3] = 235;
          } else {
            var bgv = C.dark ? 16 : 244;
            img.data[idx] = bgv; img.data[idx + 1] = bgv; img.data[idx + 2] = bgv; img.data[idx + 3] = 255;
          }
        }
      }
      octx.putImageData(img, 0, 0);
      l2.mapCache = off;
      l2.mapDark = C.dark;
    }
    ctx.imageSmoothingEnabled = true;
    ctx.drawImage(l2.mapCache, 0, 0, w, h);

    // Golden ratio vertical line phi^-1 = 0.618034
    var gx = 0.618034 * w;
    ctx.strokeStyle = C.blue; ctx.lineWidth = 1.5; ctx.setLineDash([4, 4]);
    ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, h); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = C.blue; ctx.font = '700 10px ui-monospace,Menlo,monospace';
    ctx.fillText('φ⁻¹', gx + 4, 14);

    // Tongue labels along bottom
    ctx.fillStyle = C.ink; ctx.font = '700 10px ui-monospace,Menlo,monospace';
    ctx.textAlign = 'center';
    [[0.5,'1/2'],[0.333,'1/3'],[0.667,'2/3'],[0.25,'1/4'],[0.75,'3/4'],[0.4,'2/5']].forEach(function(p){
      ctx.fillText(p[1], p[0] * w, h - 6);
    });
    ctx.textAlign = 'left';

    // Current crosshair
    var cx = l2.omega * w, cy = (1 - l2.K / 1.2) * h;
    ctx.strokeStyle = C.ink; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(cx - 8, cy); ctx.lineTo(cx + 8, cy); ctx.moveTo(cx, cy - 8); ctx.lineTo(cx, cy + 8); ctx.stroke();
    ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(cx, cy, 4, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = C.ink; ctx.stroke();
  }

  function renderStaircase(){
    var f = fitCanvas(l2StairCv), ctx = f.ctx, w = f.w, h = f.h;
    var C = theme(), pad = 26, gw = w - pad * 2, gh = h - pad * 2;
    ctx.strokeStyle = C.grid; ctx.lineWidth = 1;
    ctx.strokeRect(pad, pad, gw, gh);
    ctx.strokeStyle = C.pink; ctx.lineWidth = 2;
    ctx.beginPath();
    var N = 140;
    for (var i = 0; i <= N; i++) {
      var om = i / N;
      var W = windingNumber(om, l2.K, 80);
      var x = pad + om * gw, y = h - pad - Math.max(0, Math.min(1, W)) * gh;
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();

    var curW = windingNumber(l2.omega, l2.K, 140);
    var px = pad + l2.omega * gw, py = h - pad - Math.max(0, Math.min(1, curW)) * gh;
    ctx.strokeStyle = C.blue; ctx.setLineDash([3, 3]);
    ctx.beginPath(); ctx.moveTo(px, h - pad); ctx.lineTo(px, py); ctx.lineTo(pad, py); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = C.blue; ctx.beginPath(); ctx.arc(px, py, 5, 0, Math.PI * 2); ctx.fill();

    var br = bestRat(curW, 12);
    var isLocked = br.err < 0.003;
    document.getElementById('l2KLbl').textContent = 'K = ' + l2.K.toFixed(2);
    document.getElementById('l2mOK').textContent = l2.omega.toFixed(3) + ' / ' + l2.K.toFixed(2);
    document.getElementById('l2mW').textContent = isLocked
      ? (br.p + ' / ' + br.q + ' (' + curW.toFixed(4) + ')')
      : curW.toFixed(4);
    document.getElementById('l2mPath').textContent = isLocked && br.p > 0 ? sbPath(br.p, br.q, 9) : 'Irrational / High-q';
    document.getElementById('l2mReg').textContent = isLocked
      ? ('LOCKED (q = ' + br.q + ')')
      : 'QUASI-PERIODIC';
    document.getElementById('l2Stat').textContent = isLocked
      ? ('LOCKED ON ' + br.p + ':' + br.q + ' TONGUE')
      : 'QUASI-PERIODIC (UNLOCKED)';

    if (l2.audioOn && l2.oscA && l2.oscB) {
