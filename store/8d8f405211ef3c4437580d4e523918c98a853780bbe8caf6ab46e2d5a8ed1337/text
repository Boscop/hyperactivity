  function bjorklund(k, n){
    if (k <= 0) return new Array(n).fill(0);
    if (k >= n) return new Array(n).fill(1);
    var groups = [];
    for (var i = 0; i < k; i++) groups.push([1]);
    var rem = [];
    for (var j = 0; j < n - k; j++) rem.push([0]);
    while (rem.length > 1) {
      var m = Math.min(groups.length, rem.length);
      for (var t = 0; t < m; t++) groups[t] = groups[t].concat(rem[t]);
      var leftG = groups.slice(m), leftR = rem.slice(m);
      groups = groups.slice(0, m);
      rem = leftG.length ? leftG : leftR;
    }
    var out = [];
    groups.concat(rem).forEach(function(g){ out = out.concat(g); });
    return out;
  }

