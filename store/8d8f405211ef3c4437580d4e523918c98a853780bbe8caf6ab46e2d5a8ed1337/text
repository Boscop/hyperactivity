  // Build a genuine 1-second periodic click buffer (sharp 0.6ms filtered Dirac click)
  // Using a looping single-click AudioBuffer of length SR/baseRef lets playbackRate sweep
  // continuously from 1.5 Hz to 240 Hz with ZERO discontinuity between rhythm and pitch!
  function makeClickBuffer(c){
    var sr = c.sampleRate;
    var len = sr; // 1.0 Hz fundamental period = 1 click per second!
    var buf = c.createBuffer(1, len, sr);
    var d = buf.getChannelData(0);
    // Crisp 1.2ms damped impulse (broadband click that fuses cleanly into rich harmonic pitch)
    var clickN = Math.floor(sr * 0.0014);
    for (var i = 0; i < clickN; i++) {
      var t = i / sr;
      d[i] = Math.exp(-t * 2800) * Math.sin(2 * Math.PI * 950 * t + 0.4) * 0.9;
    }
    return buf;
  }

