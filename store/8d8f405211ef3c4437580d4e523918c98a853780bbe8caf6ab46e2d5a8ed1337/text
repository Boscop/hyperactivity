  function stepLab3(dt){
    var C = theme();
    var hz = l3Hz();
    if (l3.playing) {
      if (l3.mode === 'euclid') {
        var stepRate = Math.min(14, hz * 2.2);
        l3.phase = (l3.phase + dt * stepRate / l3.b) % 1;
        var idx = Math.floor(l3.phase * l3.b);
        if (idx !== l3.lastEuc) {
          l3.lastEuc = idx;
          if (l3.eucPat[idx]) fireClick(720, 0.22);
          else fireClick(240, 0.04);
          var cells = document.querySelectorAll('#l3EuclidStrip .pulse-cell');
          cells.forEach(function(el, ci){ el.classList.toggle('cur', ci === idx); });
        }
      } else {
        l3.phase = (l3.phase + dt * Math.min(hz / l3.b, 2.2)) % 1;
      }
    }

    // Ring visualization
    var r = fitCanvas(l3RingCv), ctx = r.ctx;
    var cx = r.w / 2, cy = r.h / 2, R = Math.min(cx, cy) - 24;
    ctx.strokeStyle = C.grid; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.stroke();

    if (l3.mode === 'euclid') {
      var n = l3.b, pat = l3.eucPat, hits = [];
      for (var i = 0; i < n; i++) {
        var ang = (i / n) * Math.PI * 2 - Math.PI / 2;
        var px = cx + Math.cos(ang) * R, py = cy + Math.sin(ang) * R;
        if (pat[i]) hits.push([px, py]);
        ctx.fillStyle = pat[i] ? C.pink : C.muted;
        ctx.beginPath(); ctx.arc(px, py, pat[i] ? 6 : 3, 0, Math.PI * 2); ctx.fill();
      }
      if (hits.length > 1) {
        ctx.strokeStyle = C.pink; ctx.lineWidth = 2;
        ctx.beginPath();
        hits.forEach(function(pt, hi){ if (hi === 0) ctx.moveTo(pt[0], pt[1]); else ctx.lineTo(pt[0], pt[1]); });
        ctx.closePath(); ctx.stroke();
      }
    } else {
      function poly(k, col, rad){
        ctx.strokeStyle = col; ctx.lineWidth = 2;
        ctx.beginPath();
        for (var m = 0; m <= k; m++) {
          var a = (m / k) * Math.PI * 2 - Math.PI / 2;
          var x = cx + Math.cos(a) * rad, y = cy + Math.sin(a) * rad;
          if (m === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.stroke();
        for (var m2 = 0; m2 < k; m2++) {
          var a2 = (m2 / k) * Math.PI * 2 - Math.PI / 2;
          ctx.fillStyle = col;
          ctx.beginPath(); ctx.arc(cx + Math.cos(a2) * rad, cy + Math.sin(a2) * rad, 4.5, 0, Math.PI * 2); ctx.fill();
        }
      }
      poly(l3.a, C.pink, R);
      poly(l3.b, C.blue, R * 0.74);
    }
    var hand = l3.phase * Math.PI * 2 - Math.PI / 2;
    ctx.strokeStyle = C.ink; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx + Math.cos(hand) * R, cy + Math.sin(hand) * R); ctx.stroke();

    // Impulse train waveform view
    var wv = fitCanvas(l3WaveCv), wctx = wv.ctx;
    var mid = wv.h / 2, pad = 20, span = wv.w - pad * 2;
    wctx.strokeStyle = C.grid; wctx.lineWidth = 1;
    wctx.beginPath(); wctx.moveTo(pad, mid); wctx.lineTo(wv.w - pad, mid); wctx.stroke();
    var windowSec = hz < 18 ? 1.0 : (hz < 60 ? 0.25 : 0.04);
    function drawTrain(rateHz, col, yOff, dir){
      wctx.strokeStyle = col; wctx.lineWidth = 1.8;
      var count = Math.min(80, Math.floor(rateHz * windowSec) + 2);
      for (var k = 0; k < count; k++) {
        var t = (k / rateHz) / windowSec;
        if (t > 1) break;
        var x = pad + t * span;
        wctx.beginPath();
        wctx.moveTo(x, mid + yOff);
        wctx.lineTo(x, mid + yOff + dir * 56);
        wctx.stroke();
      }
    }
    if (l3.mode === 'euclid') {
      var pat2 = l3.eucPat;
      for (var e = 0; e < pat2.length; e++) {
        var ex = pad + (e / pat2.length) * span;
        wctx.strokeStyle = pat2[e] ? C.pink : C.grid;
        wctx.lineWidth = pat2[e] ? 3 : 1;
        wctx.beginPath(); wctx.moveTo(ex, mid + 30); wctx.lineTo(ex, mid - (pat2[e] ? 64 : 14)); wctx.stroke();
      }
    } else {
      drawTrain(hz * (l3.a / l3.b), C.pink, -4, -1);
      drawTrain(hz, C.blue, 4, 1);
    }
    wctx.fillStyle = C.muted; wctx.font = '600 10.5px ui-monospace,Menlo,monospace';
    wctx.fillText('Window: ' + (windowSec * 1000).toFixed(0) + ' ms', pad, 18);
  }

  /* =========================================================================
   * LAB 4: Real In-Browser Interaction-Net Reducer (Live Rewrites -> Sight + Sound)
   * ========================================================================= */
  // Pure cell/port graph: each node has id, kind, ports[] (port 0 = principal).
  // A wire links (id1, p1) <-> (id2, p2). An active pair is a wire with p1===0 && p2===0!
  var Net = function(){
    this.nextId = 1;
    this.nodes = {};
    this.depth = 0;
    this.totalRedex = 0;
    this.history = []; // {d, pairs:[{kA,kB,ratioIdx}]}
    this.lastFlash = [];
  };
  Net.prototype.add = function(kind, arity, meta){
    var id = this.nextId++;
    var ports = [];
    for (var i = 0; i <= arity; i++) ports.push(null);
    this.nodes[id] = { id: id, kind: kind, ports: ports, meta: meta || {} };
    return id;
  };
  Net.prototype.wire = function(a, pa, b, pb){
    if (!this.nodes[a] || !this.nodes[b]) return;
    this.nodes[a].ports[pa] = { id: b, p: pb };
    this.nodes[b].ports[pb] = { id: a, p: pa };
  };
  Net.prototype.connectExt = function(e1, e2){
    if (e1 && e2) this.wire(e1.id, e1.p, e2.id, e2.p);
    else if (e1 && this.nodes[e1.id]) this.nodes[e1.id].ports[e1.p] = null;
    else if (e2 && this.nodes[e2.id]) this.nodes[e2.id].ports[e2.p] = null;
  };
  Net.prototype.activePairs = function(){
    var seen = {}, res = [];
    var ids = Object.keys(this.nodes);
    for (var i = 0; i < ids.length; i++) {
      var n = this.nodes[ids[i]];
      var t = n.ports[0];
      if (t && t.p === 0 && this.nodes[t.id]) {
        var a = Math.min(n.id, t.id), b = Math.max(n.id, t.id);
        var key = a + ':' + b;
        if (!seen[key]) { seen[key] = true; res.push([a, b]); }
      }
    }
    return res;
  };

  // Build Peano numeral n, returning {id, port} pointing to principal port of top S/Z
  Net.prototype.mkNat = function(n){
    var cur = this.add('Z', 0);
    for (var i = 0; i < n; i++) {
      var s = this.add('S', 1);
      this.wire(s, 1, cur, 0);
      cur = s;
    }
    return cur;
  };

  // Real parallel interaction-net depth step: fires ALL current active pairs simultaneously!
  Net.prototype.step = function(){
    var pairs = this.activePairs();
    if (!pairs.length) return [];
    var fired = [];
    var self = this;

    // Collect endpoints before mutating so parallel pairs never interfere
    pairs.forEach(function(pr){
      var A = self.nodes[pr[0]], B = self.nodes[pr[1]];
      if (!A || !B) return;
      // Canonicalize order so operator is on the left
      var ops = { '+':1, '×':1, 'δ':1, 'ε':1, 'INC':1, 'OSC':1 };
      if (!ops[A.kind] && ops[B.kind]) { var tmp = A; A = B; B = tmp; }

      var kA = A.kind, kB = B.kind;
      // Rule 1: (+) >< Z  ==> wire arg2 directly to result
      if (kA === '+' && kB === 'Z') {
        var arg2 = A.ports[1], out = A.ports[2];
        delete self.nodes[A.id]; delete self.nodes[B.id];
        self.connectExt(arg2, out);
        fired.push({ rule: '+ ⋈ Z', voice: 0 });
      }
      // Rule 2: (+) >< S  ==> emit S on result, wire new (+) to S.aux
      else if (kA === '+' && kB === 'S') {
        var a2 = A.ports[1], res = A.ports[2], pred = B.ports[1];
        delete self.nodes[A.id]; delete self.nodes[B.id];
        var sOut = self.add('S', 1);
        var addN = self.add('+', 2);
        self.connectExt({ id: sOut, p: 0 }, res);
        self.wire(sOut, 1, addN, 2);
        self.connectExt({ id: addN, p: 1 }, a2);
        self.connectExt({ id: addN, p: 0 }, pred);
        fired.push({ rule: '+ ⋈ S', voice: 4 });
      }
      // Rule 3: (×) >< Z ==> erase arg2, emit Z on result
      else if (kA === '×' && kB === 'Z') {
        var mArg = A.ports[1], mOut = A.ports[2];
        delete self.nodes[A.id]; delete self.nodes[B.id];
        var z = self.add('Z', 0);
        var er = self.add('ε', 0);
        self.connectExt({ id: z, p: 0 }, mOut);
        self.connectExt({ id: er, p: 0 }, mArg);
        fired.push({ rule: '× ⋈ Z', voice: 0 });
      }
      // Rule 4: (×) >< S ==> duplicate arg2 via δ, spawn parallel (+) and (×)!
      else if (kA === '×' && kB === 'S') {
        var yPort = A.ports[1], resP = A.ports[2], xPred = B.ports[1];
        delete self.nodes[A.id]; delete self.nodes[B.id];
        var dup = self.add('δ', 2);
        var addC = self.add('+', 2);
        var mulC = self.add('×', 2);
        self.connectExt({ id: dup, p: 0 }, yPort);
        self.wire(dup, 1, addC, 0);
        self.wire(dup, 2, mulC, 1);
        self.wire(mulC, 2, addC, 1);
        self.connectExt({ id: addC, p: 2 }, resP);
        self.connectExt({ id: mulC, p: 0 }, xPred);
        fired.push({ rule: '× ⋈ S → δ', voice: 2 });
      }
      // Rule 5: δ >< Z ==> two Zs
      else if (kA === 'δ' && kB === 'Z') {
        var d1 = A.ports[1], d2 = A.ports[2];
        delete self.nodes[A.id]; delete self.nodes[B.id];
        var z1 = self.add('Z', 0), z2 = self.add('Z', 0);
        self.connectExt({ id: z1, p: 0 }, d1);
        self.connectExt({ id: z2, p: 0 }, d2);
        fired.push({ rule: 'δ ⋈ Z', voice: 3 });
      }
      // Rule 6: δ >< S ==> two Ss + inner δ
      else if (kA === 'δ' && kB === 'S') {
        var o1 = A.ports[1], o2 = A.ports[2], sIn = B.ports[1];
        delete self.nodes[A.id]; delete self.nodes[B.id];
        var s1 = self.add('S', 1), s2 = self.add('S', 1), dN = self.add('δ', 2);
        self.connectExt({ id: s1, p: 0 }, o1);
        self.connectExt({ id: s2, p: 0 }, o2);
        self.wire(s1, 1, dN, 1);
        self.wire(s2, 1, dN, 2);
        self.connectExt({ id: dN, p: 0 }, sIn);
        fired.push({ rule: 'δ ⋈ S', voice: 5 });
      }
      // Rule 7: ε >< Z ==> annihilate
      else if (kA === 'ε' && kB === 'Z') {
        delete self.nodes[A.id]; delete self.nodes[B.id];
        fired.push({ rule: 'ε ⋈ Z', voice: 1 });
      }
      // Rule 8: ε >< S ==> propagate ε
      else if (kA === 'ε' && kB === 'S') {
        var sp = B.ports[1];
        delete self.nodes[A.id]; delete self.nodes[B.id];
        var e2 = self.add('ε', 0);
        self.connectExt({ id: e2, p: 0 }, sp);
        fired.push({ rule: 'ε ⋈ S', voice: 1 });
      }
      // Rule 9: Binary LSB increment INC >< B1 (carry ripple) / B0 / E
      else if (kA === 'INC' && kB === 'B1') {
        var iOut = A.ports[1], tail = B.ports[1];
        delete self.nodes[A.id]; delete self.nodes[B.id];
        var b0 = self.add('B0', 1), inc2 = self.add('INC', 1);
        self.connectExt({ id: b0, p: 0 }, iOut);
        self.wire(b0, 1, inc2, 1);
        self.connectExt({ id: inc2, p: 0 }, tail);
        fired.push({ rule: 'INC ⋈ 1 (carry)', voice: 4 });
      }
      else if (kA === 'INC' && kB === 'B0') {
        var iOut0 = A.ports[1], tail0 = B.ports[1];
        delete self.nodes[A.id]; delete self.nodes[B.id];
        var b1 = self.add('B1', 1);
        self.connectExt({ id: b1, p: 0 }, iOut0);
        self.connectExt({ id: b1, p: 1 }, tail0);
        fired.push({ rule: 'INC ⋈ 0 (done)', voice: 7 });
      }
      else if (kA === 'INC' && kB === 'E') {
        var iOutE = A.ports[1];
        delete self.nodes[A.id]; delete self.nodes[B.id];
        var b1e = self.add('B1', 1), endN = self.add('E', 0);
        self.connectExt({ id: b1e, p: 0 }, iOutE);
        self.wire(b1e, 1, endN, 0);
        fired.push({ rule: 'INC ⋈ E (MSB)', voice: 7 });
      }
      // Rule 10: Guarded corecursive oscillator pair OSC >< CLK (O(1) cyclic stream!)
      else if (kA === 'OSC' && kB === 'CLK') {
        A.meta.tick = (A.meta.tick || 0) + 1;
        var hitsA = (A.meta.tick % A.meta.div) === 0;
        if (hitsA) fired.push({ rule: '▸κ ' + A.meta.label, voice: A.meta.voice });
      }
    });

    this.depth++;
    this.totalRedex += fired.length;
    this.lastFlash = fired;
    this.history.push({ d: this.depth, fired: fired });
    if (this.history.length > 26) this.history.shift();
    return fired;
  };

  var l4Net = new Net(), l4Preset = 'add', l4Timer = null;
  var l4NetCv = document.getElementById('l4NetCv');
  var l4ScoreCv = document.getElementById('l4ScoreCv');

  // Pure Just Intonation ratios for voicing distinct active-pair rules honestly
  var JI_VOICE = [1, 9/8, 5/4, 4/3, 3/2, 5/3, 15/8, 2];

  function playVoice(vIdx, vol){
    var c = getAC(), now = c.currentTime;
    var freq = 220 * (JI_VOICE[vIdx % JI_VOICE.length] || 1);
    var o = c.createOscillator(), g = c.createGain();
    o.type = 'triangle';
    o.frequency.setValueAtTime(freq, now);
    g.gain.setValueAtTime(0.0001, now);
    g.gain.exponentialRampToValueAtTime(vol || 0.09, now + 0.012);
    g.gain.exponentialRampToValueAtTime(0.0001, now + 0.34);
    o.connect(g); g.connect(c.destination);
    o.start(now); o.stop(now + 0.36);
  }

  function buildLab4(preset){
    if (l4Timer) { clearInterval(l4Timer); l4Timer = null; document.getElementById('l4Run').textContent = '▶ Run Live'; }
    l4Preset = preset;
    l4Net = new Net();
    if (preset === 'add') {
      var root = l4Net.add('ROOT', 1);
      var a = l4Net.mkNat(5), b = l4Net.mkNat(4);
      var add = l4Net.add('+', 2);
      l4Net.wire(add, 0, a, 0);
      l4Net.wire(add, 1, b, 0);
      l4Net.wire(add, 2, root, 1);
    } else if (preset === 'mul') {
      var r2 = l4Net.add('ROOT', 1);
      var x = l4Net.mkNat(3), y = l4Net.mkNat(3);
      var mul = l4Net.add('×', 2);
      l4Net.wire(mul, 0, x, 0);
      l4Net.wire(mul, 1, y, 0);
      l4Net.wire(mul, 2, r2, 1);
    } else if (preset === 'bin') {
      var r3 = l4Net.add('ROOT', 1);
      var e = l4Net.add('E', 0);
      var cur = e;
      for (var bit = 0; bit < 4; bit++) {
        var b1 = l4Net.add('B1', 1);
        l4Net.wire(b1, 1, cur, 0);
        cur = b1;
      }
      var inc = l4Net.add('INC', 1);
      l4Net.wire(inc, 0, cur, 0);
      l4Net.wire(inc, 1, r3, 1);
    } else if (preset === 'cyclic') {
      // Three coupled guarded corecursive streams at rational ratios (period 2, 3, 4 => 3:2 and 4:3)
      var specs = [
        { label: '1:1 (T=4)', div: 4, voice: 0 },
        { label: '3:2 (T=3)', div: 3, voice: 4 },
        { label: '4:3 (T=2)', div: 2, voice: 2 }
      ];
      specs.forEach(function(sp){
        var o = l4Net.add('OSC', 0, sp);
        var k = l4Net.add('CLK', 0);
        l4Net.wire(o, 0, k, 0);
      });
    }
    l4UpdateMetrics([]);
  }

  function l4UpdateMetrics(fired){
    var cellCount = Object.keys(l4Net.nodes).length;
    document.getElementById('l4mDepth').textContent = l4Net.depth;
    document.getElementById('l4mPar').textContent = fired.length;
    document.getElementById('l4mTot').textContent = l4Net.totalRedex;
    document.getElementById('l4mCells').textContent = cellCount;
    document.getElementById('l4CellsLbl').textContent = cellCount + ' cells';
    document.getElementById('l4ConcLbl').textContent = fired.length + ' parallel';
    var pairsLeft = l4Net.activePairs().length;
    document.getElementById('l4Stat').textContent = pairsLeft === 0 && l4Net.depth > 0
      ? ('NORMAL FORM · D=' + l4Net.depth)
      : ('DEPTH D=' + l4Net.depth + ' · ' + (fired.length ? fired.map(function(x){ return x.rule; }).join(' ∥ ') : 'READY'));
  }

  function l4DoStep(){
    var fired = l4Net.step();
    if (!fired.length && l4Net.activePairs().length === 0) {
      if (l4Timer) { clearInterval(l4Timer); l4Timer = null; document.getElementById('l4Run').textContent = '▶ Run Live'; }
      l4UpdateMetrics([]);
      return;
    }
    l4UpdateMetrics(fired);
    var vol = Math.min(0.11, 0.22 / Math.max(1, fired.length));
    fired.forEach(function(f){ playVoice(f.voice, vol); });
  }

  document.getElementById('l4Step').onclick = function(){ getAC(); l4DoStep(); };
  document.getElementById('l4Reset').onclick = function(){ buildLab4(l4Preset); };
  document.getElementById('l4Run').onclick = function(){
    if (l4Timer) {
      clearInterval(l4Timer); l4Timer = null;
      this.textContent = '▶ Run Live';
      return;
    }
    if (l4Net.activePairs().length === 0) buildLab4(l4Preset);
    getAC();
    this.textContent = '■ Pause';
    l4DoStep();
    l4Timer = setInterval(l4DoStep, l4Preset === 'cyclic' ? 280 : 420);
  };
  document.querySelectorAll('[data-l4]').forEach(function(btn){
    btn.onclick = function(){
      document.querySelectorAll('[data-l4]').forEach(function(x){ x.classList.toggle('on', x === btn); });
      buildLab4(btn.dataset.l4);
    };
  });
  buildLab4('add');

  function drawLab4(){
    var C = theme();
    // Net graph canvas
    var nf = fitCanvas(l4NetCv), ctx = nf.ctx;
    var ids = Object.keys(l4Net.nodes).map(Number);
    var n = ids.length;
    var cx = nf.w / 2, cy = nf.h / 2, R = Math.min(cx, cy) - 28;
    var pos = {};
    for (var i = 0; i < n; i++) {
      var ang = (i / Math.max(1, n)) * Math.PI * 2 - Math.PI / 2;
      pos[ids[i]] = { x: cx + Math.cos(ang) * R, y: cy + Math.sin(ang) * R };
    }
    // Draw wires
    var activeSet = {};
    l4Net.activePairs().forEach(function(pr){ activeSet[pr[0]] = true; activeSet[pr[1]] = true; });
    for (var i2 = 0; i2 < n; i2++) {
      var nd = l4Net.nodes[ids[i2]];
      for (var p = 0; p < nd.ports.length; p++) {
        var tgt = nd.ports[p];
        if (!tgt || tgt.id < nd.id || !pos[tgt.id]) continue;
        var isAct = (p === 0 && tgt.p === 0);
        ctx.strokeStyle = isAct ? C.pink : C.grid;
        ctx.lineWidth = isAct ? 2.6 : 1.3;
        ctx.beginPath();
        ctx.moveTo(pos[nd.id].x, pos[nd.id].y);
        ctx.lineTo(pos[tgt.id].x, pos[tgt.id].y);
        ctx.stroke();
      }
    }
    // Draw cells
    for (var i3 = 0; i3 < n; i3++) {
      var node = l4Net.nodes[ids[i3]], pt = pos[node.id];
      var hot = !!activeSet[node.id];
      ctx.fillStyle = hot ? C.pink : (node.kind === 'δ' || node.kind === '×' ? C.blue : C.bg);
      ctx.strokeStyle = hot ? C.pink : C.ink;
      ctx.lineWidth = 1.8;
      ctx.beginPath(); ctx.arc(pt.x, pt.y, hot ? 12 : 10, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      ctx.fillStyle = hot || node.kind === 'δ' || node.kind === '×' ? '#fff' : C.ink;
      ctx.font = '700 10px ui-monospace,Menlo,monospace';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(node.kind, pt.x, pt.y + 0.5);
    }

    // Score canvas (real depth-time redex trace)
    var sf = fitCanvas(l4ScoreCv), sctx = sf.ctx;
    var pad = 24, gw = sf.w - pad * 2, gh = sf.h - pad * 2;
    for (var v = 0; v < 8; v++) {
      var yy = sf.h - pad - (v / 7) * gh;
      sctx.strokeStyle = C.grid; sctx.lineWidth = 1;
      sctx.beginPath(); sctx.moveTo(pad, yy); sctx.lineTo(sf.w - pad, yy); sctx.stroke();
    }
    var hist = l4Net.history;
    for (var h = 0; h < hist.length; h++) {
      var st = hist[h];
      var xx = pad + ((h + 0.5) / Math.max(8, hist.length)) * gw;
      var latest = (h === hist.length - 1);
      if (st.fired.length > 1) {
        // Chord bar connecting simultaneous parallel redexes
        var ys = st.fired.map(function(f){ return sf.h - pad - (f.voice / 7) * gh; });
        sctx.strokeStyle = latest ? C.pink : C.blue; sctx.lineWidth = 2;
        sctx.beginPath();
        sctx.moveTo(xx, Math.min.apply(null, ys));
        sctx.lineTo(xx, Math.max.apply(null, ys));
        sctx.stroke();
      }
      st.fired.forEach(function(f){
        var yy2 = sf.h - pad - (f.voice / 7) * gh;
        sctx.fillStyle = latest ? C.pink : (st.fired.length > 1 ? C.blue : C.ink);
        sctx.beginPath(); sctx.arc(xx, yy2, latest ? 6.5 : 4.5, 0, Math.PI * 2); sctx.fill();
      });
    }
  }

  /* =========================================================================
   * Main animation loop + theme observer
   * ========================================================================= */
  var lastTime = performance.now();
  function tick(now){
    var dt = Math.min(0.05, (now - lastTime) / 1000);
    lastTime = now;
    stepLab1(dt);
    stepLab3(dt);
    drawLab4();
    requestAnimationFrame(tick);
  }

  updateLab2();
  window.addEventListener('resize', updateLab2);
  new MutationObserver(function(){ l2.mapCache = null; updateLab2(); })
    .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  requestAnimationFrame(tick);
})();
</script>
</body>
