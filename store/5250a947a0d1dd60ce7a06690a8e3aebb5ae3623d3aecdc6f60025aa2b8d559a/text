s256-rounds-go : Nat → Word → List Word → Word → Word → Word → Word → List Word
s256-rounds-go zero _ _ ab cd ef gh = s256-fin ab cd ef gh
s256-rounds-go (suc rem) i nil ab cd ef gh = s256-fin ab cd ef gh
s256-rounds-go (suc rem) i (cons wi wr) ab cd ef gh =
  let a = %wand ab s256-m32
      b = %wshr ab #32
      c = %wand cd s256-m32
      d = %wshr cd #32
      e = %wand ef s256-m32
      f = %wshr ef #32
      g = %wand gh s256-m32
      h = %wshr gh #32
      t1 = s256-add (s256-add (s256-add h (s256-S1 e)) (s256-add (s256-ch e f g) (s256-k i))) wi
      t2 = s256-add (s256-S0 a) (s256-maj a b c)
  in s256-rounds-go rem (%wsucc i) wr (s256-pk (s256-add t1 t2) a) (s256-pk b c) (s256-pk (s256-add d t1) e) (s256-pk f g)
