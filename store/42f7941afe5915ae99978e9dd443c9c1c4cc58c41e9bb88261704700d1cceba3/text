hcm-dec-loop2 : Nat → Word → Word → Word → Word → Word → Word → Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
hcm-dec-loop2 zero _ _ _ _ _ _ _ _ _ _ _ _ k = k #0
hcm-dec-loop2 (suc rem) tab inb ilen outb pos hist mpos mlen lo hi code ipos k =
  hcm-maybe-rewind pos
    (let am = hcm-addr-m tab (hcm-h4 hist)
    in scmd (w-load am) (λ prev →
       let use_mp = if %wlt #0 mlen then mpos else if %wlt #0 prev then %wsub prev #1 else #0
           use_ml = if %wlt #0 mlen then mlen else if %wlt #0 prev then #4 else #0
       in scmd (w-load8 (%wadd outb use_mp)) (λ mbyte →
          hcm-dec-bits (toNat #8) tab hist #1 use_ml mbyte lo hi code inb ipos ilen #0 (λ x lo2 hi2 c2 ip2 ml_ok →
          scmd (w-store8 (%wadd outb pos) x) (λ _ →
          scmd (w-store am (%wsucc pos)) (λ _ →
          let hist2 = %wand (%wor (%wshl hist #8) x) #281474976710655
              mp2   = if %wlt #0 ml_ok then %wsucc use_mp else #0
              ml2   = if %wlt #0 ml_ok then (if %wlt ml_ok #32 then %wsucc ml_ok else #32) else #0
          in hcm-dec-loop2 rem tab inb ilen outb (%wsucc pos) hist2 mp2 ml2 lo2 hi2 c2 ip2 k))))))
