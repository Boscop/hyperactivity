-- 2. Taken-Branch Mispredict Squash Theorem: when `h-bnez` redirects away from `%wsucc ifPc`, the
--    wrong-path prefetched slot is squashed cleanly, retiring ONLY `hart-isa-step hs ifInst`!
spec-pipe-mispred-sound : (imem : Word → HartInst) → (hs : HartState) → (ifPc : Word) → (ifInst : HartInst) →
  weq (h-pc (hart-isa-step hs ifInst)) (%wsucc ifPc) ≡ false →
  spipe-flush (spipe-step imem (spipe hs true ifPc ifInst)) ≡
  hart-isa-step hs ifInst
spec-pipe-mispred-sound imem hs ifPc ifInst hMiss =
  λ i → spipe-flush (spipe-resolve imem (hart-isa-step hs ifInst) (%wsucc ifPc) (hMiss i))
