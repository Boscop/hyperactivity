-- Symplectic position update + passive clamp [-1.5, 1.5]
wa-mesh4-pos : Word → List Word
wa-mesh4-pos qi =
  let pi    = %wadd qi #4
      cNeg  = the (List Word) (cons #67 (cons #0 (cons #0 (cons #192 (cons #191 nil)))))
      cPos  = the (List Word) (cons #67 (cons #0 (cons #0 (cons #192 (cons #63 nil)))))
      sumQP = wa-bin #146 (wa-get qi) (wa-get pi)
      cl    = wa-bin #151 cNeg (wa-bin #150 cPos sumQP)
  in dw-app cl (wa-set qi)
