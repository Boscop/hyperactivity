-- the address of a place. An object local: its allocation, through the projections. A
-- register local: only through its value (the place starts with a deref).
rm-place-addr : RCx → RPlace → RFrame → REv MPtr
rm-place-addr cx (rplace l ps) =
  sr-on (cx-lty cx l) (λ e fr → rm-throw e) (λ lt →
  sr-on (cx-class cx lt) (λ e fr → rm-throw e) (λ c → case c of
    cl-mem → sr-on (cx-align cx lt) (λ e fr → rm-throw e) (λ la →
      let go = rm-proj-go ps cx lt #0 la
      in λ fr → rm-bind (fr-get fr l) (λ s → case s of
           sl-mem p → go fr p
           sl-none → rm-throw (rx-ub rub-dead-local)
           sl-reg v → rm-throw (rx-ill-formed ri-operand-class)))
    cl-unit → λ fr → rm-throw (rx-unsupported rz-borrow-of-register)
    _ → (case ps of
      nil → λ fr → rm-throw (rx-unsupported rz-borrow-of-register)
      cons pr ps2 → (case pr of
        rproj-deref →
          sr-on (rm-pointee lt) (λ e fr → rm-throw e) (λ t2 →
          sr-on (cx-align cx t2) (λ e fr → rm-throw e) (λ a2 →
            let go = rm-proj-go ps2 cx t2 #0 a2
            in λ fr → rm-bind (fr-get fr l) (λ s → rm-bind (rm-slot-ptr s) (λ p → go fr p))))
        _ → λ fr → rm-throw (rx-ill-formed (ri-place lt))))))
