-- the operations that need the value itself, and so read through a reference
nk-reads : NkOp → Bool
nk-reads (nko-app arg out) = true
nk-reads (nko-inc out) = true
nk-reads (nko-quote d out) = true
nk-reads (nko-dup a b) = false
nk-reads nko-era = false
nk-reads (nko-fwd out) = false
nk-reads (nko-qlam out) = false
nk-reads (nko-qinc out) = false
nk-reads (nko-qapp1 qa out) = false
nk-reads (nko-qapp2 t out) = false
