-- unconditionally enforce the single canonical s-footer on every standalone HTML page
s-inject-footer : List Word → List Word
s-inject-footer doc =
  if h-infix "<footer class='site-foot'>" doc then doc
  else if h-infix "</body>" doc then
    h-concat (cons (h-before "</body>" doc) (cons s-footer (cons "</body>" (cons (h-after "</body>" doc) nil))))
  else doc
