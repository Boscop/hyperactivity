-- THEOREM 3: PROVABLE SUFFICIENCY OF COARSE-GRAINED MODELS INSIDE A VERIFIED TRUST REGION
-- If actual modeling error eps_act <= eps_budget and eps_budget <= safety_margin, then eps_act <= safety_margin!
cos-thm-safe-margin-suff : (eps-act eps-bud margin : Nat) →
  hm-le eps-act eps-bud ≡ true → hm-le eps-bud margin ≡ true →
  hm-le eps-act margin ≡ true
cos-thm-safe-margin-suff = hm-le-trans
