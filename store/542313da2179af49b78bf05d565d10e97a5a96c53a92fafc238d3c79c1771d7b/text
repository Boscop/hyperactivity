-- (part of language-support)
rol_spec : (size : ZI) → (dst' : Bits #64) → (src : Bits #6) → (input_rflags : rflagsbits) → MF ((Bits #64) × rflagsbits × rflagsbits)
rol_spec size dst' src input_rflags =
  if (z-eq size (zpos #1)) then
    (bindF {((Bits #8) × rflagsbits × rflagsbits)} {((Bits #64) × rflagsbits × rflagsbits)} (rol_spec_8 (bv-trunc #64 #8 dst') src input_rflags) (λ t'1 →
       let elem0 : Bits #8
           elem0 = (fst t'1)
           elem1 : rflagsbits
           elem1 = (fst (snd t'1))
           elem2 : rflagsbits
           elem2 = (snd (snd t'1))
       in retF {((Bits #64) × rflagsbits × rflagsbits)} ((bv-zext #8 #64 elem0) , elem1 , elem2)))
  else if (z-eq size (zpos #2)) then
    (bindF {((Bits #16) × rflagsbits × rflagsbits)} {((Bits #64) × rflagsbits × rflagsbits)} (rol_spec_16 (bv-trunc #64 #16 dst') src input_rflags) (λ t'2 →
       let elem0 : Bits #16
           elem0 = (fst t'2)
           elem1 : rflagsbits
           elem1 = (fst (snd t'2))
           elem2 : rflagsbits
           elem2 = (snd (snd t'2))
       in retF {((Bits #64) × rflagsbits × rflagsbits)} ((bv-zext #16 #64 elem0) , elem1 , elem2)))
  else if (z-eq size (zpos #4)) then
    (bindF {((Bits #32) × rflagsbits × rflagsbits)} {((Bits #64) × rflagsbits × rflagsbits)} (rol_spec_32 (bv-trunc #64 #32 dst') src input_rflags) (λ t'3 →
       let elem0 : Bits #32
           elem0 = (fst t'3)
           elem1 : rflagsbits
           elem1 = (fst (snd t'3))
           elem2 : rflagsbits
           elem2 = (snd (snd t'3))
       in retF {((Bits #64) × rflagsbits × rflagsbits)} ((bv-zext #32 #64 elem0) , elem1 , elem2)))
  else if (z-eq size (zpos #8)) then
    (rol_spec_64 dst' src input_rflags)
  else
    (retF {((Bits #64) × rflagsbits × rflagsbits)} (#0 , #0 , #0))
