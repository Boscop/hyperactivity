hr-xorB : Bool → Bool → Bool
hr-xorB true  true  = false
hr-xorB true  false = true
hr-xorB false true  = true
hr-xorB false false = false

hr-xorB-cancel : (k b : Bool) → hr-xorB k (hr-xorB k b) ≡ b
hr-xorB-cancel true  true  = refl
hr-xorB-cancel true  false = refl
hr-xorB-cancel false true  = refl
hr-xorB-cancel false false = refl

-- Fail-closed stream cipher (recurses on `msg` first): when key stream is exhausted (`nil`), emits `nil` (NEVER plaintext `msg`!)
hr-stream-crypt : List Bool → List Bool → List Bool
hr-stream-crypt nil         key         = nil
hr-stream-crypt (cons b bs) nil         = nil
hr-stream-crypt (cons b bs) (cons k ks) = cons (hr-xorB k b) (hr-stream-crypt bs ks)

-- Recursive key-length sufficiency proposition (`|key| >= |msg|`, zero indexed-GADT transport!):
hr-covers : List Bool → List Bool → Type
hr-covers nil         key         = Unit
hr-covers (cons b bs) nil         = Empty
hr-covers (cons b bs) (cons k ks) = hr-covers bs ks

-- SECURITY THEOREM 1A (P0 Audit Closure): Exhausted key stream emits strictly ZERO bytes (zero plaintext tail leak!)
hr-thm-exhausted-key-zero-leak : (msg : List Bool) → hr-stream-crypt msg nil ≡ nil
hr-thm-exhausted-key-zero-leak nil         = refl
hr-thm-exhausted-key-zero-leak (cons b bs) = refl

-- UNIVERSAL THEOREM 1B: Bit-exact encrypted capsule roundtrip for ALL keys & payloads with `hr-covers msg key`!
hr-thm-cipher-roundtrip :
  (msg key : List Bool) → hr-covers msg key →
  hr-stream-crypt (hr-stream-crypt msg key) key ≡ msg
hr-thm-cipher-roundtrip nil         key         cov = refl
hr-thm-cipher-roundtrip (cons b bs) nil         cov = Empty-rec cov
hr-thm-cipher-roundtrip (cons b bs) (cons k ks) cov =
  λ i → cons (hr-xorB-cancel k b i) (hr-thm-cipher-roundtrip bs ks cov i)

