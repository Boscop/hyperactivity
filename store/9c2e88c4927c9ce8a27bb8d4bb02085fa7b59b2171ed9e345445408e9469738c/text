-- apply meets a closure: its body, the argument first. Increment meets a number: the next number.
-- Case meets constructor c: branch c applied to the fields
nk-act : Word → NkHd → NkEnv → NkAct
nk-act h (hd-clo b) parts = if %weq h #0 then act-ap b else act-none
nk-act h (hd-num m) parts = if %weq h #1 then act-hd (hd-num (%wsucc m)) else act-none
nk-act h (hd-con c) parts = if %weq h #2 then act-pa (nk-apps (nk-var (%wadd (nk-len parts) c)) #0 parts) else act-none
nk-act h hd parts = act-none
