-- logcount_int recurses in Sail; here on the bound (wadd (z-mag x') #2) (one call takes a negative to non-negative, then the magnitude halves)
-- (part of language-support)
logcount_int-body : ((x' : ZI) → ZI) → (x' : ZI) → ZI
logcount_int-body self' x' =
  let t'2 : ZI
      t'2 =
        if (z-eq x' (zpos #0)) then
          (zpos #0)
        else
          (let t'1 : ZI
               t'1 =
                 if (z-lt x' (zpos #0)) then
                   (self' (lognot_int x'))
                 else
                   (if (isEven x') then (self' (z-shr x' (zpos #1))) else (z-add (self' (z-shr x' (zpos #1))) (zpos #1)))
           in t'1)
  in t'2
