-- the path of three sites: 2 on the diagonal, −1 between neighbours; its eigenvalues are 2 − √2, 2 and 2 + √2
in-p3 : List (List BZ)
in-p3 = cons (cons (in-int 2) (cons (in-negint 1) (cons bz-zero nil))) (cons (cons (in-negint 1) (cons (in-int 2) (cons (in-negint 1) nil))) (cons (cons bz-zero (cons (in-negint 1) (cons (in-int 2) nil))) nil))
