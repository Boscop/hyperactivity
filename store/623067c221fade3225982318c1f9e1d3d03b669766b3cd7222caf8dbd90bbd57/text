-- what a failed Assert reports: the abort's kind
rm-assert-kind : RAssertMsg → RAbort
rm-assert-kind m = case m of
  rassert-bounds-check len idx → rab-bounds-check
  rassert-division-by-zero a → rab-division-by-zero
  rassert-remainder-by-zero a → rab-remainder-by-zero
  rassert-overflow o a b → rab-overflow o
