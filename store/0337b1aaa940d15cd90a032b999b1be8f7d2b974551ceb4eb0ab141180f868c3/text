-- the integer in a register local (an index)
rm-reg-int : RFrame → Word → REv UInt64
rm-reg-int fr l = rm-bind (fr-get fr l) (λ s → case s of
  sl-reg v → (case v of
    rv-s x → rm-res (sv-as-i x)
    rv-dead → rm-throw (rx-ub rub-dead-local)
    _ → rm-throw (rx-ill-formed ri-operand-class))
  sl-mem p → rm-throw (rx-ill-formed ri-operand-class)
  sl-none → rm-throw (rx-ill-formed ri-operand-class))
