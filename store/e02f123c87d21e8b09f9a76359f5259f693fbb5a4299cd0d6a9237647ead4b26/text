-- (part of language-support)
compute_mandatory_prefix_for_two_byte_opcode : (proc_mode' : proc_mode) → (opcode : Bits #8) → (prefixes' : prefixes) → Bits #8
compute_mandatory_prefix_for_two_byte_opcode proc_mode' opcode prefixes' =
  let t'1 : Bits #8
      t'1 =
        if (in_64bit_mode proc_mode') then
          (n64_bit_compute_mandatory_prefix_for_two_byte_opcode opcode prefixes')
        else
          (n32_bit_compute_mandatory_prefix_for_two_byte_opcode opcode prefixes')
  in t'1
