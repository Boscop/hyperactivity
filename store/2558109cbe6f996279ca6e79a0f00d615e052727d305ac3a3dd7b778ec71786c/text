evm-emit-inst : List (Word × Word) → EvmInst → List Word
evm-emit-inst tbl (ev-op op)   = cons op nil
evm-emit-inst tbl (ev-push bs) =
  let n = fromNat (list-length bs)
  in if %weq n #0 then cons #96 (cons #0 nil) else cons (%wadd #95 n) bs
evm-emit-inst tbl (ev-lbl l)   = cons #91 nil
evm-emit-inst tbl (ev-jmpi l)  =
  let dst = evm-lookup-lbl l tbl
  in cons #97 (list-append (evm-u16-be dst) (cons #87 nil))
evm-emit-inst tbl (ev-jmp l)   =
  let dst = evm-lookup-lbl l tbl
  in cons #97 (list-append (evm-u16-be dst) (cons #86 nil))
