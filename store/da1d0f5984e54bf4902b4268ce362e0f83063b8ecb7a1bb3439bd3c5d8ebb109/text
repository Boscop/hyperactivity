-- x(x − 27/16) = x² − 27/16 x has itself as squarefree part; x²(x − 1)² has x(x − 1)
poly-sf-check : poly-eq (squarefree (cons sq-zero (cons sq-zero (cons sq-one (cons (sq-neg (sq-nat 2)) (cons sq-one nil)))))) (cons sq-zero (cons (sq-neg sq-one) (cons sq-one nil))) ≡ true
poly-sf-check = λ i → true
