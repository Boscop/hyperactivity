-- Exact 64-bit bitwise NAND for `u, v <= 2^64 - 1`: `(2^64 - 1) - (u & v)` has zero borrows!
tr-nand64 : Word → Word → Word
tr-nand64 u v = %wsub tr-u64-max (%wand u v)

tr-nth-wire : Word → List Word → Word
tr-nth-wire idx nil         = #0
tr-nth-wire idx (cons w ws) = if %weq idx #0 then w else tr-nth-wire (%wsub idx #1) ws

-- Canonical 8 initial 64-bit truth-table wires (`0`, `1`, `x0`, `x1`, `x2`, `x3`, `x4`, `x5`):
tr-init-wires : List Word
