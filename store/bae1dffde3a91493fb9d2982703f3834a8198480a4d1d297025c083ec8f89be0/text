  cons #0
  (cons #18446744073709551615
  (cons #12297829382473034410
  (cons #14757395258967641292
  (cons #17361641481138401520
  (cons #18374966859414961920
  (cons #18446462598732840960
  (cons #18446744069414584320 nil)))))))

tr-eval-gates : Word → List Word → Word → List (Word × Word) → Word × Bool
tr-eval-gates idx wires last nil = (last , true)
tr-eval-gates idx wires last (cons g gs) =
  let a = fst g
      b = snd g
  in if andB (%wlt a idx) (%wlt b idx)
     then let va  = tr-nth-wire a wires
              vb  = tr-nth-wire b wires
              out = tr-nand64 va vb
          in tr-eval-gates (%wadd idx #1) (list-append wires (cons out nil)) out gs
     else (#0 , false)

-- Cold 64-bit truth-table evaluator over arbitrary NAND2 DAGs (`(outputTruthTable , dagWellFormed)`):
tr-eval-dag64 : List (Word × Word) → Word × Bool
tr-eval-dag64 nil         = (#0 , false)
tr-eval-dag64 (cons g gs) = tr-eval-gates #8 tr-init-wires #0 (cons g gs)

-- Structural commitment hash & gate count over the revealed NAND2 gate list:
tr-dag-len : List (Word × Word) → Word
tr-dag-len nil         = #0
tr-dag-len (cons g gs) = %wadd #1 (tr-dag-len gs)

tr-dag-hash : List (Word × Word) → Word
tr-dag-hash nil         = #1469598103934665603
tr-dag-hash (cons g gs) = sov-mac64 (tr-dag-hash gs) (fst g) (snd g) #1 #0 #0

tr-commit-hash : Word → Word → List (Word × Word) → Word → Word
tr-commit-hash solverAddr bountyId dag salt =
  sov-mac64 salt solverAddr bountyId (tr-dag-hash dag) (tr-dag-len dag) #1

-- On-chain reveal & cold-verifier settlement gate (NO untrusted `equivOk : Bool` oracle input!):
--   1. `commitBlk < revealBlk` (1-block anti-MEV delay),
--   2. `commitHash` matches `(callerAddr, bountyId, tr-dag-hash dag, tr-dag-len dag, salt)`,
--   3. `tr-eval-dag64 dag` is topologically acyclic AND its 64-bit truth table equals `specTT`,
--   4. `0 < tr-dag-len dag <= maxTargetCost`!
tr-settle-bounty :
  Word → Word → Word → Word → Word → Word → Word → Word → List (Word × Word) → Word → Word
tr-settle-bounty rewardWei specTT maxTargetCost commitHash commitBlk revealBlk callerAddr bountyId dag salt =
  let achievedCost = tr-dag-len dag
      expected     = tr-commit-hash callerAddr bountyId dag salt
      ev           = tr-eval-dag64 dag
      blkOk        = %wlt commitBlk revealBlk
      hashOk       = %weq expected commitHash
      costOk       = andB (%wlt #0 achievedCost) (tr-not (%wlt maxTargetCost achievedCost))
      equivOk      = andB (snd ev) (%weq (fst ev) specTT)
  in if andB blkOk (andB hashOk (andB equivOk costOk)) then rewardWei else #0

