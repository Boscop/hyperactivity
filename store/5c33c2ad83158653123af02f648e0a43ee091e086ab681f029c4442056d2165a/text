-- the roots of a polynomial with no root 0, of degree 1 or 2
roots-low : List SQ → List SQ
roots-low q = if eqb (poly-len q) 2 then cons (sq-neg (sq-mul (sq-nth zero q) (sq-inv (sq-nth (suc zero) q)))) nil
  else (if eqb (poly-len q) 3 then roots-quad (sq-neg (sq-mul (sq-nth (suc zero) q) (sq-inv (sq-nth 2 q)))) (sq-mul (sq-nth zero q) (sq-inv (sq-nth 2 q))) else nil)
