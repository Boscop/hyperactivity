rh-le-trans (suc a) zero c hab hbc = rh-absurd-f hab
rh-le-trans (suc a) (suc b) zero hab hbc = rh-absurd-f hbc
rh-le-trans (suc a) (suc b) (suc c) hab hbc = rh-le-trans a b c hab hbc

rh-le-suc-r : (z : Nat) → rh-le z (suc z) ≡ true
rh-le-suc-r zero = refl
rh-le-suc-r (suc z) = rh-le-suc-r z

rh-le-add-zero-l : (k x : Nat) → rh-le x (plus k x) ≡ true
rh-le-add-zero-l zero x = rh-le-refl x
rh-le-add-zero-l (suc k) x =
  rh-le-trans x (plus k x) (suc (plus k x))
    (rh-le-add-zero-l k x)
    (rh-le-suc-r (plus k x))

rh-le-add-mono : (a1 b1 a2 b2 : Nat) →
  rh-le a1 b1 ≡ true → rh-le a2 b2 ≡ true →
  rh-le (plus a1 a2) (plus b1 b2) ≡ true
rh-le-add-mono zero b1 a2 b2 h1 h2 =
  rh-le-trans a2 (plus b1 a2) (plus b1 b2)
    (rh-le-add-zero-l b1 a2)
    (rh-le-add-l b1 a2 b2 h2)
rh-le-add-mono (suc a1) zero a2 b2 h1 h2 = rh-absurd-f h1
rh-le-add-mono (suc a1) (suc b1) a2 b2 h1 h2 = rh-le-add-mono a1 b1 a2 b2 h1 h2

