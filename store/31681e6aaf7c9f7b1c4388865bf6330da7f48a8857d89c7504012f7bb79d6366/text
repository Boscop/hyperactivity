rh-le : Nat → Nat → Bool
rh-le zero _ = true
rh-le (suc _) zero = false
rh-le (suc a) (suc b) = rh-le a b

rh-le-refl : (n : Nat) → rh-le n n ≡ true
rh-le-refl zero = refl
rh-le-refl (suc n) = rh-le-refl n

rh-le-add-l : (k a b : Nat) → rh-le a b ≡ true → rh-le (plus k a) (plus k b) ≡ true
rh-le-add-l zero a b h = h
rh-le-add-l (suc k) a b h = rh-le-add-l k a b h

rh-absurd-f : {A : Type} → false ≡ true → A
rh-absurd-f h = Empty-rec (true≢false (λ i → h (~ i)))

rh-le-trans : (a b c : Nat) → rh-le a b ≡ true → rh-le b c ≡ true → rh-le a c ≡ true
