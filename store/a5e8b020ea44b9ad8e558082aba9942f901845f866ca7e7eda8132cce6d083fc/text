leB-plus : (a a2 b b2 : Nat) → leB a a2 ≡ true → leB b b2 ≡ true → leB (plus a b) (plus a2 b2) ≡ true
leB-plus zero zero b b2 = λ ha hb → hb
leB-plus zero (suc a2) b b2 = λ ha hb → leB-suc-r (plus zero b) (plus a2 b2) (leB-plus zero a2 b b2 refl hb)
leB-plus (suc a) zero b b2 = λ ha hb → Empty-rec (false≢true ha)
leB-plus (suc a) (suc a2) b b2 = λ ha hb → leB-plus a a2 b b2 ha hb
