hcm-upd-cnt : Word → Word → Word
hcm-upd-cnt v bit =
  let n0 = %wand v #65535
      n1 = %wand (%wshr v #16) #65535
      a0 = if %weq bit #1 then n0 else %wsucc n0
      a1 = if %weq bit #1 then %wsucc n1 else n1
      b0 = if %wlt #200 (%wadd a0 a1) then %wshr (%wsucc a0) #1 else a0
      b1 = if %wlt #200 (%wadd a0 a1) then %wshr (%wsucc a1) #1 else a1
  in %wor (%wshl b1 #16) b0
