hm-parse-go : Bool → List Word → List Word → List (List Word × List Word) → List Word → List (List Word × List Word)
hm-parse-go _ k v acc nil = hm-flush k v acc
hm-parse-go inv k v acc (cons c r) =
  if %weq c #10 then hm-parse-go false nil nil (hm-flush k v acc) r
  else if %weq c #13 then hm-parse-go inv k v acc r
  else if %weq c #32 then hm-parse-go true k v acc r
  else if inv then hm-parse-go true k (cons c v) acc r
  else hm-parse-go false (cons c k) v acc r
