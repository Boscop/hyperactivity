hop-0 sp ds ts = terms-append (hop-pair ts (vm-of (sp-ds sp 0 ds) ts) 1 2 sq-one (sp-ds sp 0 ds) (e-map sp 0 ds (inv-basis ds)))
  (terms-append (hop-pair ts (vm-of (sp-ds sp 0 ds) ts) 1 3 (sq-neg sq-one) (sp-ds sp 0 ds) (e-map sp 0 ds (inv-basis ds)))
    (hop-pair ts (vm-of (sp-ds sp 0 ds) ts) 2 3 sq-one (sp-ds sp 0 ds) (e-map sp 0 ds (inv-basis ds))))
