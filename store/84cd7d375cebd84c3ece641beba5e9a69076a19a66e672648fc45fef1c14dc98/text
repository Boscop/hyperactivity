show-branches : (Word → Code) → Lst (Lst (Word × Word)) → Word → Lst Code
show-branches showf lnil c = lnil
show-branches showf (lcons ks more) c =
  lcons (clams (%wadd (d-len ks) (count-rec ks)) (c-cons (cwlit c) (show-fields showf ks (d-len ks) (count-rec ks) #0 #0)))
        (show-branches showf more (%wsucc c))
