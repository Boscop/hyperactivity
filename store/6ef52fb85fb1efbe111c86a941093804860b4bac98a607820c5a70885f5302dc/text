eth-thm-keccak-vectors :
  andB (h-eq (h-hex (keccak256 nil)) "c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470")
       (h-eq (h-take (toNat #8) (h-hex (keccak256 "transfer(address,uint256)"))) "a9059cbb") ≡ true
eth-thm-keccak-vectors = refl

-- THEOREM 2: FOUNDER'S COINBASE BASE ADDRESS (`0x4A50FBF0128E2679C42466A8cC1A9D230b08A26f`) PASSES EIP-55 CHECKSUM BY `refl`!
eth-thm-founder-eip55-exact :
  eth-eip55-from-bytes20 eth-founder-coinbase-addr20 ≡ "0x4A50FBF0128E2679C42466A8cC1A9D230b08A26f"
eth-thm-founder-eip55-exact = refl

-- THEOREM 3: OFFICIAL ETHEREUM secp256k1 PRIVATE KEYS #1, #2, #3 & FULL 256-BIT FOUNDRY ACCOUNT #0 EXACT BY `refl`!
eth-foundry-priv0 : Word
eth-foundry-priv0 = h-be (eth-from-hex "ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80")

eth-thm-secp-vectors-1-2-3 :
  andB (secp-on-curve secp-gx secp-gy)
  (andB (h-eq (eth-priv-to-eip55 #1) "0x7E5F4552091A69125d5DfCb7b8C2659029395Bdf")
  (andB (h-eq (eth-priv-to-eip55 #2) "0x2B5AD5c4795c026514f8317c7a215E218DcCD6cF")
  (andB (h-eq (eth-priv-to-eip55 #3) "0x6813Eb9362372EEF6200f3b1dbC3f819671cBA69")
        (h-eq (eth-priv-to-eip55 eth-foundry-priv0) "0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266")))) ≡ true
eth-thm-secp-vectors-1-2-3 = refl

-- THEOREM 4: BASE MAINNET (`chainId = #8453`) EIP-1559 SIGN + ECRECOVER ROUND-TRIP BY `refl`!
eth-sample-base-tx : Eip1559Tx
eth-sample-base-tx =
  mk-tx1559 #8453 #0 #1000000 #50000000 #21000 eth-founder-coinbase-addr20 #1000000000000000 nil

eth-thm-base-eip1559-ecrecover :
  eth-tx1559-selfcheck #3 eth-sample-base-tx ≡ true
eth-thm-base-eip1559-ecrecover = refl
