-- index zero: for every exact p², A in their intervals, every angular chain from [0, 1] at any depth past
-- the start has every ratio s_l > 0, so the coefficients c_l = s_l c_{l−2} keep one sign
ang-ground : (S S2 : List Bool) → (st : IE) → (p2 a : IV) → (p2q aq : ZQ) → (M : Nat) → bcanon S ≡ true → le (suc zero) (bin-to-nat S) → bin-to-nat S2 ≡ times (bin-to-nat S) (bin-to-nat S) →
  inp S p2 p2q → inp S a aq →
  tail-ok S S2 (env4 (iv-unit S) p2 a (mu-iv S (plus (suc (suc M)) (suc (suc M))))) st ≡ true → tail-pos S S2 (env4 (iv-unit S) p2 a (mu-iv S (plus (suc (suc M)) (suc (suc M))))) st ≡ true →
  snd (irun S S2 (ang-env S p2 a) st (suc M) (iv-unit S , true)) ≡ true → run-pos S S2 (ang-env S p2 a) st (suc M) (iv-unit S , true) ≡ true →
  (k : Nat) → (tv rv : ZQ) → uni S tv → le (suc zero) (snd tv) → (ch : echain (ang-envq p2q aq) st (plus k (suc M)) tv rv) → posalong (ang-envq p2q aq) st S (plus k (suc M)) tv rv ch
ang-ground S S2 st p2 a p2q aq M cS hS hS2 hp ha hok hpos hf hr =
  deep-pos S S2 (ang-env S p2 a) (ang-envq p2q aq) st (suc M) cS hS hS2 (ang-env-ok S p2 a p2q aq hp ha)
    (ang-inv S S2 st p2 a p2q aq M cS hS hS2 hp ha hok) (ang-pinv S S2 st p2 a p2q aq M cS hS hS2 hp ha hok hpos) hf hr
