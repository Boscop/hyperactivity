-- the executor runs until no wire is left to look at, for at most k steps
nk-run : Nat → NkExec → NkExec
nk-run zero st = st
nk-run (suc k) (nk-exec nkw-nil n sl) = nk-exec nkw-nil n sl
nk-run (suc k) (nk-exec (nkw-cons u r) n sl) = nk-run k (nk-exec-go u r (nk-get sl u) (nk-plan (nk-get sl u) u n sl) sl)
