-- a word below 2^64 read back from the bytes the model's wb wrote (bit lo of each byte at 8·k,
-- the stored value the word under the 64-bit mask)
rd8-wb : (V : Word) → wlt V #18446744073709551616 ≡ true →
         rd8 (wand (wshr (wand V #18446744073709551615) #0) #255) (wand (wshr (wand V #18446744073709551615) #8) #255)
             (wand (wshr (wand V #18446744073709551615) #16) #255) (wand (wshr (wand V #18446744073709551615) #24) #255)
             (wand (wshr (wand V #18446744073709551615) #32) #255) (wand (wshr (wand V #18446744073709551615) #40) #255)
             (wand (wshr (wand V #18446744073709551615) #48) #255) (wand (wshr (wand V #18446744073709551615) #56) #255)
         ≡ V
rd8-wb V h =
  catw (cong8 (λ x0 x1 x2 x3 x4 x5 x6 x7 → rd8 (wand (wshr x0 #0) #255) (wand (wshr x1 #8) #255) (wand (wshr x2 #16) #255) (wand (wshr x3 #24) #255)
                                                (wand (wshr x4 #32) #255) (wand (wshr x5 #40) #255) (wand (wshr x6 #48) #255) (wand (wshr x7 #56) #255))
               (mask64 V h) (mask64 V h) (mask64 V h) (mask64 V h) (mask64 V h) (mask64 V h) (mask64 V h) (mask64 V h))
    (catw (cong8 rd8 (byte-dig V #0) (byte-dig V #8) (byte-dig V #16) (byte-dig V #24)
                     (byte-dig V #32) (byte-dig V #40) (byte-dig V #48) (byte-dig V #56))
      (rd8-dig V h))
