-- the division is exact when its remainder is zero: (n/d)·d = n, for either sign of n
in-exact : (s : Bool) → (m d : List Bool) → bcanon d ≡ true → le (suc zero) (bin-to-nat d) → in-rem m d ≡ zero → zeq (zmul (zv (bz-fdiv (s , m) d)) (the (Nat × Nat) (bin-to-nat d , zero))) (zv (s , m))
in-exact s m d cd hd hr = case s return λ u → zeq (zmul (zv (bz-fdiv (u , m) d)) (the (Nat × Nat) (bin-to-nat d , zero))) (zv (u , m)) of
  true → in-ex-pos (bin-to-nat m) (bin-to-nat (fst (bin-divmod m d))) (bin-to-nat d) (in-rem m d) (fst (bin-divmod-sound m d cd hd)) hr
  false → zeq-trans (zmul (zv (bz-fdiv (false , m) d)) (the (Nat × Nat) (bin-to-nat d , zero))) (zmul (the (Nat × Nat) (zero , bin-to-nat (fst (bin-divmod m d)))) (the (Nat × Nat) (bin-to-nat d , zero))) (zv (false , m))
    (zeq-of-path (zmul (zv (bz-fdiv (false , m) d)) (the (Nat × Nat) (bin-to-nat d , zero))) (zmul (the (Nat × Nat) (zero , bin-to-nat (fst (bin-divmod m d)))) (the (Nat × Nat) (bin-to-nat d , zero)))
      (λ i → zmul (in-qr-neg (bin-divmod m d) (transB (bin-null-sound (snd (bin-divmod m d)) (snd (bin-divmod-canon m d))) (λ j → cmpN true (hr j) zero)) i) (the (Nat × Nat) (bin-to-nat d , zero))))
    (in-ex-neg (bin-to-nat m) (bin-to-nat (fst (bin-divmod m d))) (bin-to-nat d) (in-rem m d) (fst (bin-divmod-sound m d cd hd)) hr)
