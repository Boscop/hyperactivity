-- Composing any cubical equivalence directly with compress-record (zero duplicate machinery!)
-- Example: 2D cubical curvature Δ_xy (grid-delta-codec) → flatten → causal context-fiber record compression
split-at-n : {A : Type} → Nat → List A → List A × List A
split-at-n zero xs = (nil , xs)
split-at-n (suc n) nil = (nil , nil)
split-at-n (suc n) (cons x r) = let p = split-at-n n r in (cons x (fst p) , snd p)
