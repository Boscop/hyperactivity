-- a turn kept: appended to the turns as a line (the file opened to append, created if missing)
c-append : List Word → Proc W Unit
c-append t = bind (h-cstr c-record) (λ p → bind (sys-call #2 p #1089 #420 #0 #0 #0) (λ fd →
  if wlt fd #9223372036854775808 then bind (h-put fd (h-line t)) (λ u → bind (sys-call #3 fd #0 #0 #0 #0 #0) (λ c → ret unit))
  else h-fail "chat: the turns could not be kept"))
