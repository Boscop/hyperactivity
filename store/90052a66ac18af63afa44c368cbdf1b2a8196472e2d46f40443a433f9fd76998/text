-- the spaces of a branch named, then its term
pair-at-vw : Nat → Nat → Bool → Bool → List Nat → List Triple → VW → List Nat → List Nat → List Nat → Term
pair-at-vw e e1 sp spp ds ts w ds3 ds4 ds5 = pair-vw w (vm-of ds3 ts) (mons0 ds4) (mons0 ds5) (vm-of (exp-init (exp-init ds5)) ts)
  (pair-weight (exp-at e1 ds3) (exp-at e1 ds) (exp-at e ds5) (exp-at e ds))
  (if sp then eplus-entry e1 ds else eminus-entry e1 ds)
  (if sp then scaled-entry ((exp-at e1 ds3 , suc (exp-at e1 ds3)) , (zero , suc zero)) (eminus-entry e1 ds3) else scaled-entry (sq-neg sq-one) (eplus-entry e1 ds3))
  (if spp then eplus-entry e ds4 else eminus-entry e ds4)
  (if spp then rplus-entry e (exp-init (exp-init ds5)) else rminus-entry e (exp-init (exp-init ds5)))
