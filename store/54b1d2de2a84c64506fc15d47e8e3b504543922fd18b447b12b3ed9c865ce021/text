-- sums of inequalities
le-add-path : (a b c d d1 d2 : Word) → plusw a d1 ≡ b → plusw c d2 ≡ d →
              plusw (plusw a c) (plusw d1 d2) ≡ plusw b d
le-add-path a b c d d1 d2 p q =
  catw (plusw-assoc a c (plusw d1 d2))
    (catw (congw (λ z → plusw a z) (plusw-mid c d1 d2))
      (catw (symw (plusw-assoc a d1 (plusw c d2))) (cong2w (λ z w → plusw z w) p q)))
