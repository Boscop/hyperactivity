-- Zero-allocation structural binary Nat recursion: depth 17 = 2^17 = 131,072 live gate-level cubical active pairs!
-- Packs (acc << 32) | st32 in ONE unboxed 64-bit Word -> 0 heap bytes allocated per active-pair step!
io-sim-step : Word → Word
io-sim-step p =
  let st  = %wand p #4294967295
      acc = %wshr p #32
      a0  = %wand st #1
      b0  = %wand (%wshr st #1) #1
      m1  = %wand (%wshr st #2) #1
      ta  = %wand (%wshr st #3) #1
      tb  = %wand (%wshr st #4) #1
      ea  = %wand (%wshr st #5) #1
      eb  = %wand (%wshr st #6) #1
      fc  = io-eval-bit io-w-face-conflict (toNat #3) a0 b0 m1
      era = io-eval-bit io-w-era-prune (toNat #6) ea eb fc
      act = %wxor era #1
      cm  = io-eval-bit io-w-commute (toNat #6) ta tb act
      an  = io-joint-annihilate ta tb act
      iv  = io-eval-bit io-w-demorgan-mux (toNat #5) a0 b0 m1
      st2 = %wand (%wadd (%wmul st #1664525) #1013904223) #4294967295
      ac2 = %wadd acc (%wadd fc (%wadd era (%wadd cm (%wadd an iv))))
  in %wor (%wshl ac2 #32) st2
