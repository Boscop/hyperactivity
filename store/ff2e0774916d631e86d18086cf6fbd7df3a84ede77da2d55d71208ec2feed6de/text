-- O_ee′ from the vertex's data and the edges' traces (sides e1 for e′, sides e for e)
o-terms-vw : Nat → Nat → List Nat → List Triple → VW → List Side → List Side → List Term
o-terms-vw e e1 ds ts w se se1 = cons (v-term-vw w) (terms-append (left-terms-vw w se1) (terms-append (right-terms-vw w se) (pair-terms-vw e e1 (signs-at (exp-at e1 ds)) ds ts w)))
