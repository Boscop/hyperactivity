-- the entries before the query c, counted down the tree from o: at most f nodes, each one comparison
si-cnt : (n : Nat) → Bytes n → Word → List (List Word) → Nat → Word → Word
si-cnt n B p c f = case f return λ w → Word → Word of
  zero → λ o → #0
  suc g → λ o → if weq (cstr-get n B o) #1
    then (if si-cmp n B c (si-rd4 n B (si-slot p (si-rd4 n B (wadd o #5)))) then rec g (wadd o #13)
          else wadd (%wsucc (si-rd4 n B (wadd o #1))) (rec g (si-rd4 n B (wadd o #9))))
    else #0
