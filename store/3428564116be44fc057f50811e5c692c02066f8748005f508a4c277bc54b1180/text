-- the claim for g = s^a z^b at R = r, with S and Z: 4s g_ss + 4g_s = 4a² s^{a−1} z^b, g_zz = b(b−1) s^a z^{b−2}
lap-mono2 : BQ → List (List BQ) → List (List BQ) → Nat → Nat → Bool
lap-mono2 r s z a b = b-isz (b-add (b-scale (fn-q 4 1) (lap-op (b-mul (b-pow s a) (b-pow z b))))
  (b-scale (fn-neg (bq-mul r r)) (b-mul b-d (b-add (b-scale (fn-q (times 4 (times a a)) 1) (b-mul (b-pow s (monus a 1)) (b-pow z b)))
                                                   (b-scale (fn-q (times b (monus b 1)) 1) (b-mul (b-pow s a) (b-pow z (monus b 2))))))))
