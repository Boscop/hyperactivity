-- ---------------------------------------------------------------- what followed, compiled
-- from place a of the forms, to the end of its sentence (a ., ! or ? before a separation or the end), at
-- most z bytes, consed as read (reversed): x above holds whether the sentence has ended
m-end-at : (s : Nat) → Bytes s → Word → Bool
m-end-at s b x = andB (orB (weq (cstr-get s b x) #46) (orB (weq (cstr-get s b x) #33) (weq (cstr-get s b x) #63)))
  (orB (h-not (wlt (wadd x #1) (bytes-length s b))) (weq (cstr-get s b (wadd x #1)) #32))
