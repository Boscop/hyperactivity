addw-head : (a b : Word) → W64w a → W64w b → QAll x86-step mn-ret (RQ (addw a b)) (X26 a b) → QAll x86-step mn-ret (RQ (addw a b)) (s0 a b)
addw-head a b ha hb t =
  q-run x86-step mn-ret #21 (RQ (addw a b)) refl (s0 a b) (ok21 a b)
    (q-rax x86-step mn-ret (RQ (addw a b)) (X21 a b) a (r21' a b ha) (eta21 a b)
      (q-run x86-step mn-ret #2 (RQ (addw a b)) refl (S21 a b) (ok2 a b) (h23 a b ha hb t)))
