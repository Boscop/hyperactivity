c-main-with : List (List Word) → Proc W Unit
c-main-with args = if h-has "--reset" args then bind (h-unlink c-record) (λ u → h-out (h-line "chat: the turns are forgotten; the record is the source and what is said from now"))
  else if h-null (h-concat args) then bind h-stdin (λ t → c-turn (c-strip-nl t))
  else c-turn (h-concat (c-sp args))
