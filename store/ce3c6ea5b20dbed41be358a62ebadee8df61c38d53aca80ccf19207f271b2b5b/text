-- a function's activation: its locals and parameters by id; this; the closure class when the
-- function is a lambda's call operator (0 otherwise: a captured variable, and this, are then
-- members of *this, archive/2026-11-11/C-clang.md); the result object of a function returning a class;
-- the object whose members are being initialized (a constructor's *this, or the aggregate of
-- an initializer list: what `this` means in a default member initializer, [class.mem]/11)
record CxEnv = { cxe-g : CxG ; cxe-locals : List (Word × CxBind) ; cxe-this : MPtr
               ; cxe-closure : Word ; cxe-result : MPtr ; cxe-agg : MPtr }
