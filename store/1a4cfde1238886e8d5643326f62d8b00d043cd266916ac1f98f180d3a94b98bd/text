sc-world : World MemS Memory
sc-world c m =
  case c return (λ x → Sum (mem-resp x × Memory) Memory) of
    mload a → inl (m a , m)
    mstore a v → inl (unit , mem-write a v m)
    mcas a o n → (case weq (m a) o of true → inl (true , mem-write a n m); false → inl (false , m))
    mfence → inl (unit , m)
