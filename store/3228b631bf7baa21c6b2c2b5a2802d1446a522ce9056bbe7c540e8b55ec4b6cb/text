gds6-decode-body : Nat → List Word → Sum Unit (List Gds6Box)
gds6-decode-body zero s =
  bind-res {List Word} {List Gds6Box} (expect-seq gds-v6-postamble s) (λ _ → inr nil)
gds6-decode-body (suc n) s =
  bind-res (gds6-decode-box s) (λ item →
  bind-res (gds6-decode-body n (snd item)) (λ bs →
    inr (cons (fst item) bs)))
