lsem-add : (e : Env) (f g : LinT) → lsem e (llin-add f g) ≡ plusw (lsem e f) (lsem e g)
lsem-add e f g =
  case f return (λ w → lsem e (llin-add w g) ≡ plusw (lsem e w) (lsem e g)) of
    lint k cs →
      (case g return (λ w → lsem e (llin-add (lint k cs) w) ≡ plusw (lsem e (lint k cs)) (lsem e w)) of
         lint m ds → lsem-add-body e k cs m ds)
