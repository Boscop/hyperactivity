-- a value arriving and an operation arriving at one wire commute, whatever is at the wire: the two
-- ends of a wire may be used in either order
nk-arrive-comm : (v : NkVal) (o : NkOp) (s : NkSlot) → nk-arrive-op o (nk-arrive-val v s) ≡ nk-arrive-val v (nk-arrive-op o s)
nk-arrive-comm v o nks-none = refl
nk-arrive-comm v o (nks-val u) = refl
nk-arrive-comm v o (nks-op p) = refl
nk-arrive-comm v o (nks-pair p u) = refl
