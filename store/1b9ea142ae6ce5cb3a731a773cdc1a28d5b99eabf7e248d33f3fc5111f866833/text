sf-best-hairpin-le : Nat → List AA → Nat × Nat
sf-best-hairpin-le zero seq = (zero , fold-score-contacts seq (sf-gen-hairpin zero seq))
sf-best-hairpin-le (suc t) seq =
  let cur = fold-score-contacts seq (sf-gen-hairpin (suc t) seq)
      prev = sf-best-hairpin-le t seq
  in if leb (snd prev) cur then (suc t , cur) else prev
