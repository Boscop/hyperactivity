nk-uses-var : Word → Word → NkTm → Bool
nk-uses-var c j (nk-var i) = if %wlt i c then false else %weq (%wsub i c) j
nk-uses-var c j (nk-lam b) = nk-uses-var (%wsucc c) j b
nk-uses-var c j (nk-susp b) = nk-uses-var c j b
nk-uses-var c j (nk-con k as) = nk-uses-var c j as
nk-uses-var c j (nk-op h p as) = if nk-uses-var c j p then true else nk-uses-var c j as
nk-uses-var c j (nk-match h p cs) = if nk-uses-var c j p then true else nk-uses-var c j cs
nk-uses-var c j (nk-cons t r) = if nk-uses-var c j t then true else nk-uses-var c j r
nk-uses-var c j t = false
