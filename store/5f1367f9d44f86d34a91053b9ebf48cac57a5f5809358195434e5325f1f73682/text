-- a run is a certified bracket of the lowest level of width at most 2^−n with the given ends at the given scale
he-pinned : (List (List BZ) × BZ) × (List (List BZ) × BZ) → Nat → BZ → BZ → BZ → ((BZ × BZ) × BZ) × Bool → Bool
he-pinned pr n lo hi sc r = if iq-good (he-count pr) 0 n r then (if he-eqz (fst (fst (fst r))) lo then (if he-eqz (snd (fst (fst r))) hi then he-eqz (snd (fst r)) sc else false) else false) else false
