sc-add-swap4 : (a b c d : Nat) → hm-add (hm-add a b) (hm-add c d) ≡ hm-add (hm-add a c) (hm-add b d)
sc-add-swap4 a b c d =
  web-trans-n (sc-add-assoc a b (hm-add c d))
    (web-trans-n (λ i → hm-add a (web-trans-n (web-sym-n (sc-add-assoc b c d))
                                  (web-trans-n (λ j → hm-add (sc-add-comm b c j) d)
                                               (sc-add-assoc c b d)) i))
                 (web-sym-n (sc-add-assoc a c (hm-add b d))))
