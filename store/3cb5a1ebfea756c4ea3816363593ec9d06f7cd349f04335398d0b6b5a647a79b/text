q-bytes-go v n off acc =
  if %wlt n (%wadd off #8) then q-bytes-tail v n (%wsub n off) acc
  else (let w = %load64 v off
        in q-bytes-go v n (%wadd off #8)
             (if %i64eq w (%i64ofw #0) then acc else (case %view w of wplit k b → cprim #1032 (lcons acc (lcons (cwlit off) (lcons (cplit k b) (lcons (cwlit n) lnil)))); _ → acc)))
