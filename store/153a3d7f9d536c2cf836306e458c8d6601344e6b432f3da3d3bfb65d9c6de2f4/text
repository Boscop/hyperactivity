-- orbit growth under plain relabellings: one step, every generator applied to every atom reached. The
-- computation needs the functions only; that they are automorphisms of a particular molecule is a
-- separate statement about them, proved where it is needed (auto-id, at-swap-auto).
orbit-step-fn : (A : Type 0) → List (A → A) → List A → List A
orbit-step-fn A gens ys = chem-concat A (chem-map (A → A) (List A) (λ f → chem-map A A f ys) gens)
