-- the tails: checked once over every index past the start (the step a parameter, so no check of these
-- statements ever unfolds a step's interval on unknown inputs)
rad-inv : (S S2 : List Bool) → (st : IE) → (p sg c : IV) → (pq sq cq : ZQ) → (N : Nat) → bcanon S ≡ true → le (suc zero) (bin-to-nat S) → bin-to-nat S2 ≡ times (bin-to-nat S) (bin-to-nat S) →
  inp S p pq → inp S sg sq → inp S c cq → tail-ok S S2 (env5 (iv-unit S) p sg c (mu-iv S (suc N))) st ≡ true →
  (k : Nat) → (tv w : ZQ) → uni S tv → le (suc zero) (snd tv) → isval (rad-envq pq sq cq (suc (plus k N)) tv) st w → uni S w
rad-inv S S2 st p sg c pq sq cq N cS hS hS2 hp hsg hc hok k tv w hu hl hv =
  tail-inv S S2 (env5 (iv-unit S) p sg c (mu-iv S (suc N))) (rad-envq pq sq cq (suc (plus k N)) tv) st w cS hS hS2
    (env-all5 (inp S) (iv-unit S) p sg c (mu-iv S (suc N)) tv pq sq cq (the (Nat × Nat) (suc zero , zero) , suc (plus k N))
       (unit-canon S cS , (hu , hl)) hp hsg hc (mu-inp S cS (suc N) (suc (plus k N)) (le-one-suc N) (k , plus-suc k N) (le-one-suc (plus k N))))
    hv hok
