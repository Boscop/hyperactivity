-- ---------------------------------------------------------------- two more, so that nothing below is written
-- for one target only: i386 System V (ILP32: long and pointers 4 bytes, long long and double
-- 8 bytes aligned 4, no 128-bit integer: its size is 0, which no scalar kind has), and s390x
-- (LP64, big-endian, char unsigned, 128-bit aligned 8)
i386-sysv-size : CK → Word
i386-sysv-size k = case k of
  ck-bool → #1
  ck-char → #1
  ck-short → #2
  ck-int → #4
  ck-long → #4
  ck-llong → #8
  ck-ptr → #4
  ck-float → #4
  ck-double → #8
  ck-int128 → #0
