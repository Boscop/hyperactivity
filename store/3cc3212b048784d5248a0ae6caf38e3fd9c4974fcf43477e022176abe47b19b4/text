sov-extract-cut-event : Sum Unit SovPkt → Sum Unit ProfEvent
sov-extract-cut-event (inl u) = inl u
sov-extract-cut-event (inr (sov-pkt _ _ _ pa _ _)) = inr (prof-unpack pa)

