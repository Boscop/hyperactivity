-- Keyed 64-bit ARX authentication tag over (magic, kind_seq, ptgt, pa, pb, pc) under 64-bit private secret:
sov-mix64 : Word → Word → Word
sov-mix64 h x =
  let s1 = %wxor h (%wmul (%wand x #4294967295) #2654435761)
      s2 = %wxor s1 (%wshr s1 #17)
      s3 = %wand (%wmul (%wand s2 #4294967295) #2246822519) #4294967295
      hi = %wand (%wxor (%wshr s1 #13) (%wmul (%wand x #65535) #3266489917)) #4294967295
  in %wor (%wshl hi #32) s3

sov-mac64 : Word → Word → Word → Word → Word → Word → Word
sov-mac64 secret kseq tgt a b c =
  let m0 = sov-mix64 (%wxor secret #1213748054) kseq
      m1 = sov-mix64 m0 tgt
      m2 = sov-mix64 m1 a
      m3 = sov-mix64 m2 b
  in sov-mix64 m3 c

sov-put32 : Word → List Word → List Word
sov-put32 v tl =
  cons (%wand (%wshr v #24) #255)
  (cons (%wand (%wshr v #16) #255)
  (cons (%wand (%wshr v #8) #255)
  (cons (%wand v #255) tl)))

sov-hd : List Word → Word
sov-hd nil = #0
sov-hd (cons x _) = x

sov-tl : List Word → List Word
sov-tl nil = nil
sov-tl (cons _ r) = r

sov-get32 : List Word → Word × List Word
sov-get32 xs =
  let b0 = sov-hd xs; r0 = sov-tl xs
      b1 = sov-hd r0; r1 = sov-tl r0
      b2 = sov-hd r1; r2 = sov-tl r1
      b3 = sov-hd r2; r3 = sov-tl r2
  in (%wor (%wshl (%wand b0 #255) #24)
     (%wor (%wshl (%wand b1 #255) #16)
     (%wor (%wshl (%wand b2 #255) #8)
           (%wand b3 #255))) , r3)

sov-pack-pkt : Word → SovPkt → List Word
sov-pack-pkt secret (sov-pkt k sq tg a b c) =
  let kseq = %wor (%wshl (%wand (sov-kind-code k) #255) #24) (%wand sq #16777215)
      tg32 = %wand tg #4294967295
      a32  = %wand a  #4294967295
      b32  = %wand b  #4294967295
      c32  = %wand c  #4294967295
      mac  = sov-mac64 secret kseq tg32 a32 b32 c32
      mhi  = %wand (%wshr mac #32) #4294967295
      mlo  = %wand mac #4294967295
  in sov-put32 sov-magic
     (sov-put32 kseq
     (sov-put32 tg32
     (sov-put32 a32
     (sov-put32 b32
     (sov-put32 c32
     (sov-put32 mhi
     (sov-put32 mlo nil)))))))

sov-unpack-pkt : Word → List Word → Sum Unit SovPkt
sov-unpack-pkt secret bs =
  if %weq (cli-len bs) #32 then
    let g0 = sov-get32 bs
        g1 = sov-get32 (snd g0)
        g2 = sov-get32 (snd g1)
        g3 = sov-get32 (snd g2)
        g4 = sov-get32 (snd g3)
        g5 = sov-get32 (snd g4)
        g6 = sov-get32 (snd g5)
        g7 = sov-get32 (snd g6)
        mg = fst g0
        ks = fst g1
        tg = fst g2
        a  = fst g3
        b  = fst g4
        c  = fst g5
        gotMac = %wor (%wshl (fst g6) #32) (fst g7)
        expMac = sov-mac64 secret ks tg a b c
    in if andB (%weq mg sov-magic) (%weq gotMac expMac)
       then inr (sov-pkt (sov-kind-decode (%wshr ks #24)) (%wand ks #16777215) tg a b c)
       else inl unit
  else inl unit

-- Wrap a 4-byte `ProfEvent` (`lib/hx-profiler.hypercubical`) into a 32B authenticated realtime wire frame:
sov-pack-cut-frame : Word → Word → ProfEvent → List Word
sov-pack-cut-frame secret seq ev =
