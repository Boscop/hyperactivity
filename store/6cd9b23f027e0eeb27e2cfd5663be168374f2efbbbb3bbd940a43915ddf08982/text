-- O(N) → O(N²) Sweep-Line DRC Contraction Theorem:
-- Checking N-1 adjacent neighbors on ANY untrusted AI cell list proves ALL N(N-1)/2 pairs pass DRC!
sweep-linear-drc-sound : (minS : Nat) → (rs : List Rect) →
  check-sweep-x minS rs ≡ true → PairwiseDrc minS rs
sweep-linear-drc-sound minS nil _ = unit
sweep-linear-drc-sound minS (cons r rs) h = adj-from-drc minS rs r h
