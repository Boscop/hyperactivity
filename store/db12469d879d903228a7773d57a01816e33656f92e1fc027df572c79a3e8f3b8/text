-- B_kl for one k, l from 0, n of them: ys are coordinates in ds6, each lifted, closed by R, read in ds
b2-row : Nat → List Nat → List Nat → Rows → (List Nat → List Nat → SQ) → Rows → List Rows
b2-row n ds ds6 m6 rent ys = case n of
  zero → nil
  suc g → cons (restrict (inv-free ds) (vmap rent ds ds6 (lift-in ds6 ys))) (b2-row g ds ds6 m6 rent (rows-apply-all m6 ys))
