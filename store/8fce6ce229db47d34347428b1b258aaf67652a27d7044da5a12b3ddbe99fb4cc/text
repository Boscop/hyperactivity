nk-rho-copy-below : (rho : NkW → NkEv) (parts : NkEnv) (n x : NkW) →
  (nk-wire-lt x n ≡ true) → nk-rho-copy rho parts n x ≡ rho x
nk-rho-copy-below rho nke-nil n x lt = refl
nk-rho-copy-below rho (nke-cons w r) n x lt =
  let x_lt_sn = nk-wire-lt-wle-trans x n (nk-s n) lt (nk-wire-le-s n)
  in nk-rho-copy-below (nk-rho-set rho n (rho w)) r (nk-s n) x x_lt_sn
     ∙ nk-rho-set-other rho n x (rho w) (nk-wgt-neq x n lt)
