  (fl-ln "    id<MTLBuffer> bOut  = [dev newBufferWithLength:NBLOCKS * sizeof(ValMon) options:MTLResourceStorageModeShared];"
  (fl-ln "    uint8_t* toks = (uint8_t*)[bToks contents];"
