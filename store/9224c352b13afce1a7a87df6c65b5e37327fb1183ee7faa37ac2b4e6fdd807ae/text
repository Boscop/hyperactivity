-- (part of language-support)
gpr_adc_spec_1 : (dst' : Bits #8) → (src : Bits #8) → (input_rflags : rflagsbits) → MF ((Bits #8) × rflagsbits × rflagsbits)
gpr_adc_spec_1 dst' src input_rflags =
  let input_cf : Bits #1
      input_cf = (rflagsbits-cf input_rflags)
      raw_result : Bits #9
      raw_result = (bits_of_int (z-add (bv-unsigned #8 dst') (z-add (bv-unsigned #8 src) (bv-unsigned #1 input_cf))) (zpos #9))
      signed_raw_result : Bits #9
      signed_raw_result = (bits_of_int (z-add (bv-signed #8 dst') (z-add (bv-signed #8 src) (bv-unsigned #1 input_cf))) (zpos #9))
      result' : Bits #8
      result' = (bv-trunc #9 #8 raw_result)
  in bindF {Bits #1} {((Bits #8) × rflagsbits × rflagsbits)} (cf_spec8 raw_result) (λ cf' →
       bindF {Bits #1} {((Bits #8) × rflagsbits × rflagsbits)} (pf_spec8 result') (λ pf' →
         let af : Bits #1
             af = (adc_af_spec8 dst' src input_cf)
             zf : Bits #1
             zf = (zf_spec (bv-unsigned #8 result'))
             sf : Bits #1
             sf = (sf_spec8 result')
         in bindF {Bits #1} {((Bits #8) × rflagsbits × rflagsbits)} (of_spec8 signed_raw_result) (λ of' →
              let output_rflags : rflagsbits
                  output_rflags = (rflagsbits-set-of (rflagsbits-set-sf (rflagsbits-set-zf (rflagsbits-set-af (rflagsbits-set-pf (rflagsbits-set-cf input_rflags cf') pf') af) zf) sf) of')
                  undefined_flags : rflagsbits
                  undefined_flags = #0
              in retF {((Bits #8) × rflagsbits × rflagsbits)} (result' , output_rflags , undefined_flags))))
