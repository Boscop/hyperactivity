-- 2. Hinge Suffix Invariance under Rational SE(3) Torsion Rotation (10 variables: q0..q3, p, q):
--    Rotating suffix atoms p, q by M(q) + T maps (p - q) to M(q)(p - q), whose squared norm
--    is identically N² ‖p - q‖² (so intra-suffix energies & clashes never need recomputation!).
se3-hinge-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
se3-hinge-poly A ad mu q vs =
  (λ g sub sq →
    let q0 = g 0; q1 = g 1; q2 = g 2; q3 = g 3
        dx = sub (g 4) (g 7)
        dy = sub (g 5) (g 8)
        dz = sub (g 6) (g 9)
        c2 = q (fn-q 2 1)
        s0 = sq q0; s1 = sq q1; s2 = sq q2; s3 = sq q3
        N  = ad (ad s0 s1) (ad s2 s3)
        r11 = sub (sub (ad s0 s1) s2) s3
        r12 = mu c2 (sub (mu q1 q2) (mu q0 q3))
        r13 = mu c2 (ad (mu q1 q3) (mu q0 q2))
        r21 = mu c2 (ad (mu q1 q2) (mu q0 q3))
        r22 = sub (ad (sub s0 s1) s2) s3
        r23 = mu c2 (sub (mu q2 q3) (mu q0 q1))
        r31 = mu c2 (sub (mu q1 q3) (mu q0 q2))
        r32 = mu c2 (ad (mu q2 q3) (mu q0 q1))
        r33 = ad (sub (sub s0 s1) s2) s3
        vx = ad (ad (mu r11 dx) (mu r12 dy)) (mu r13 dz)
        vy = ad (ad (mu r21 dx) (mu r22 dy)) (mu r23 dz)
        vz = ad (ad (mu r31 dx) (mu r32 dy)) (mu r33 dz)
        lhs = ad (ad (sq vx) (sq vy)) (sq vz)
        rhs = mu (sq N) (ad (ad (sq dx) (sq dy)) (sq dz))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
