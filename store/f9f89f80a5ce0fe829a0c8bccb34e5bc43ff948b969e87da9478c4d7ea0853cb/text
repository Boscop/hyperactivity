-- ============================================================================
-- SECTION 0: EXACT SIGNED INTEGERS Z (ZERO FLOATS, 0 POSTULATES!)
-- ============================================================================
-- Represent Z cleanly as a difference pair (pos, neg) : Nat x Nat? Even cleaner & canonical:
-- Exact Word-backed signed integer OR pure inductive Int so ALL ring/Stokes identities are
-- proved UNIVERSALLY for ALL integers (not just test cases!) by structural induction!

data Z : Type where
  zpos : Nat → Z          -- +n  (0 is zpos zero)
  zneg : Nat → Z          -- -(n + 1)

z-zero : Z
z-zero = zpos zero

z-one : Z
z-one = zpos (suc zero)

z-suc : Z → Z
z-suc (zpos n)        = zpos (suc n)
z-suc (zneg zero)     = zpos zero
z-suc (zneg (suc n))  = zneg n

z-pred : Z → Z
z-pred (zpos zero)    = zneg zero
z-pred (zpos (suc n)) = zpos n
z-pred (zneg n)       = zneg (suc n)

z-suc-pred : (x : Z) → z-suc (z-pred x) ≡ x
z-suc-pred (zpos zero)    = refl
z-suc-pred (zpos (suc n)) = refl
z-suc-pred (zneg n)       = refl

z-pred-suc : (x : Z) → z-pred (z-suc x) ≡ x
z-pred-suc (zpos n)       = refl
z-pred-suc (zneg zero)    = refl
z-pred-suc (zneg (suc n)) = refl

z-neg : Z → Z
z-neg (zpos zero)    = zpos zero
z-neg (zpos (suc n)) = zneg n
z-neg (zneg n)       = zpos (suc n)

z-add-nat : Nat → Z → Z
z-add-nat zero    y = y
z-add-nat (suc n) y = z-suc (z-add-nat n y)

z-sub-nat : Nat → Z → Z
z-sub-nat zero    y = y
z-sub-nat (suc n) y = z-pred (z-sub-nat n y)

z-add : Z → Z → Z
z-add (zpos n) y = z-add-nat n y
z-add (zneg n) y = z-pred (z-sub-nat n y)

z-sub : Z → Z → Z
z-sub x y = z-add x (z-neg y)

-- Universal Abelian-group laws on Z (proved for ALL x, y, z : Z, 0 postulates!)
z-add-nat-suc-r : (n : Nat) (y : Z) → z-add-nat n (z-suc y) ≡ z-suc (z-add-nat n y)
z-add-nat-suc-r zero    y = refl
z-add-nat-suc-r (suc n) y = cong z-suc (z-add-nat-suc-r n y)

z-add-nat-pred-r : (n : Nat) (y : Z) → z-add-nat n (z-pred y) ≡ z-pred (z-add-nat n y)
z-add-nat-pred-r zero    y = refl
z-add-nat-pred-r (suc n) y =
  concat (cong z-suc (z-add-nat-pred-r n y))
         (concat (z-suc-pred (z-add-nat n y)) (sym (z-pred-suc (z-add-nat n y))))

z-sub-nat-suc-r : (n : Nat) (y : Z) → z-sub-nat n (z-suc y) ≡ z-suc (z-sub-nat n y)
z-sub-nat-suc-r zero    y = refl
z-sub-nat-suc-r (suc n) y =
  concat (cong z-pred (z-sub-nat-suc-r n y))
         (concat (z-pred-suc (z-sub-nat n y)) (sym (z-suc-pred (z-sub-nat n y))))

z-sub-nat-pred-r : (n : Nat) (y : Z) → z-sub-nat n (z-pred y) ≡ z-pred (z-sub-nat n y)
z-sub-nat-pred-r zero    y = refl
z-sub-nat-pred-r (suc n) y = cong z-pred (z-sub-nat-pred-r n y)

z-add-suc-r : (x y : Z) → z-add x (z-suc y) ≡ z-suc (z-add x y)
z-add-suc-r (zpos n) y = z-add-nat-suc-r n y
z-add-suc-r (zneg n) y =
  concat (cong z-pred (z-sub-nat-suc-r n y))
         (concat (z-pred-suc (z-sub-nat n y)) (sym (z-suc-pred (z-sub-nat n y))))

z-add-pred-r : (x y : Z) → z-add x (z-pred y) ≡ z-pred (z-add x y)
z-add-pred-r (zpos n) y = z-add-nat-pred-r n y
z-add-pred-r (zneg n) y = cong z-pred (z-sub-nat-pred-r n y)

z-add-zero-r : (x : Z) → z-add x z-zero ≡ x
z-add-zero-r (zpos zero)    = refl
z-add-zero-r (zpos (suc n)) = cong z-suc (z-add-zero-r (zpos n))
z-add-zero-r (zneg zero)    = refl
z-add-zero-r (zneg (suc n)) = cong z-pred (z-add-zero-r (zneg n))

z-add-suc-l : (x y : Z) → z-add (z-suc x) y ≡ z-suc (z-add x y)
z-add-suc-l (zpos n)       y = refl
z-add-suc-l (zneg zero)    y = sym (z-suc-pred y)
z-add-suc-l (zneg (suc n)) y = sym (z-suc-pred (z-pred (z-sub-nat n y)))

z-add-pred-l : (x y : Z) → z-add (z-pred x) y ≡ z-pred (z-add x y)
z-add-pred-l (zpos zero)    y = refl
z-add-pred-l (zpos (suc n)) y = sym (z-pred-suc (z-add-nat n y))
z-add-pred-l (zneg n)       y = refl

z-add-comm : (x y : Z) → z-add x y ≡ z-add y x
z-add-comm (zpos zero)    y = sym (z-add-zero-r y)
z-add-comm (zpos (suc n)) y =
  concat (cong z-suc (z-add-comm (zpos n) y)) (sym (z-add-suc-r y (zpos n)))
z-add-comm (zneg zero)    y =
  concat (cong z-pred (sym (z-add-zero-r y))) (sym (z-add-pred-r y z-zero))
z-add-comm (zneg (suc n)) y =
  concat (cong z-pred (z-add-comm (zneg n) y)) (sym (z-add-pred-r y (zneg n)))

z-add-assoc : (x y w : Z) → z-add (z-add x y) w ≡ z-add x (z-add y w)
z-add-assoc (zpos zero)    y w = refl
z-add-assoc (zpos (suc n)) y w =
  concat (z-add-suc-l (z-add (zpos n) y) w) (cong z-suc (z-add-assoc (zpos n) y w))
z-add-assoc (zneg zero)    y w =
  concat (z-add-pred-l y w) refl
z-add-assoc (zneg (suc n)) y w =
  concat (z-add-pred-l (z-add (zneg n) y) w) (cong z-pred (z-add-assoc (zneg n) y w))

z-add-neg-r : (x : Z) → z-add x (z-neg x) ≡ z-zero
z-add-neg-r (zpos zero)    = refl
z-add-neg-r (zpos (suc zero)) = refl
z-add-neg-r (zpos (suc (suc n))) =
  concat (cong z-suc (z-add-pred-r (zpos (suc n)) (zneg n)))
         (concat (z-suc-pred (z-add (zpos (suc n)) (zneg n))) (z-add-neg-r (zpos (suc n))))
z-add-neg-r (zneg zero)    = refl
z-add-neg-r (zneg (suc n)) =
  concat (cong z-pred (z-add-suc-r (zneg n) (zpos (suc n))))
         (concat (z-pred-suc (z-add (zneg n) (zpos (suc n)))) (z-add-neg-r (zneg n)))

z-sub-add-cancel : (a b : Z) → z-add a (z-sub b a) ≡ b
z-sub-add-cancel a b =
  concat (z-add-comm a (z-add b (z-neg a)))
         (concat (z-add-assoc b (z-neg a) a)
                 (concat (cong (z-add b) (concat (z-add-comm (z-neg a) a) (z-add-neg-r a)))
                         (z-add-zero-r b)))

z-add-sub-cancel : (a d : Z) → z-sub (z-add a d) a ≡ d
z-add-sub-cancel a d =
  concat (z-add-comm (z-add a d) (z-neg a))
         (concat (sym (z-add-assoc (z-neg a) a d))
                 (cong (λ u → z-add u d) (concat (z-add-comm (z-neg a) a) (z-add-neg-r a))))

z-neg-suc : (u : Z) → z-neg (z-suc u) ≡ z-pred (z-neg u)
z-neg-suc (zpos zero)    = refl
z-neg-suc (zpos (suc k)) = refl
z-neg-suc (zneg zero)    = refl
z-neg-suc (zneg (suc k)) = refl

z-neg-pred : (u : Z) → z-neg (z-pred u) ≡ z-suc (z-neg u)
z-neg-pred (zpos zero)          = refl
z-neg-pred (zpos (suc zero))    = refl
z-neg-pred (zpos (suc (suc k))) = refl
z-neg-pred (zneg k)             = refl

z-neg-add : (a b : Z) → z-neg (z-add a b) ≡ z-add (z-neg a) (z-neg b)
z-neg-add (zpos zero)    b = refl
z-neg-add (zpos (suc n)) b =
  concat (z-neg-suc (z-add (zpos n) b))
         (concat (cong z-pred (z-neg-add (zpos n) b))
                 (concat (sym (z-add-pred-l (z-neg (zpos n)) (z-neg b)))
                         (cong (λ u → z-add u (z-neg b)) (sym (z-neg-suc (zpos n))))))
z-neg-add (zneg zero)    b = z-neg-pred b
z-neg-add (zneg (suc n)) b =
  concat (z-neg-pred (z-add (zneg n) b))
         (concat (cong z-suc (z-neg-add (zneg n) b))
                 (sym (z-add-suc-l (z-neg (zneg n)) (z-neg b))))

z-tel : (a b c : Z) → z-add (z-sub a b) (z-sub c a) ≡ z-sub c b
z-tel a b c =
  concat (z-add-comm (z-add a (z-neg b)) (z-add c (z-neg a)))
         (concat (z-add-assoc c (z-neg a) (z-add a (z-neg b)))
                 (cong (z-add c)
                   (concat (sym (z-add-assoc (z-neg a) a (z-neg b)))
                           (cong (λ u → z-add u (z-neg b))
                                 (concat (z-add-comm (z-neg a) a) (z-add-neg-r a))))))

z-pull-r : (x y w : Z) → z-add (z-add x w) y ≡ z-add (z-add x y) w
z-pull-r x y w =
  concat (z-add-assoc x w y)
         (concat (cong (z-add x) (z-add-comm w y)) (sym (z-add-assoc x y w)))

z-cancel-m : (m x y : Z) → z-add (z-add x m) (z-add y (z-neg m)) ≡ z-add x y
z-cancel-m m x y =
  concat (z-add-assoc x m (z-add y (z-neg m)))
         (cong (z-add x)
           (concat (sym (z-add-assoc m y (z-neg m)))
                   (concat (cong (λ u → z-add u (z-neg m)) (z-add-comm m y))
                           (concat (z-add-assoc y m (z-neg m))
                                   (concat (cong (z-add y) (z-add-neg-r m)) (z-add-zero-r y))))))

z-swap4 : (u v w q : Z) → z-add (z-add u v) (z-add w q) ≡ z-add (z-add u w) (z-add v q)
z-swap4 u v w q =
  concat (z-add-assoc u v (z-add w q))
         (concat (cong (z-add u) (concat (sym (z-add-assoc v w q))
                                         (concat (cong (λ x → z-add x q) (z-add-comm v w))
                                                 (z-add-assoc w v q))))
                 (sym (z-add-assoc u w (z-add v q))))

-- ============================================================================
-- SECTION 1: WITNESSED SAMENESS GROUPOID (`PathWay`: "IN WHAT WAY IS A == B?")
-- ============================================================================
-- Never collapse sameness to Bool! A witnessed path carries the exact transformation w : Z
-- (photometric shift, displacement, phase, or pose delta) plus the proof `z-add a w == b`!

PathWay : Z → Z → Type
PathWay a b = (w : Z) × (z-add a w ≡ b)

-- Reflexive identity witness (0 shift)
vi-path-refl : (a : Z) → PathWay a a
vi-path-refl a = (z-zero , z-add-zero-r a)

-- Witnessed sameness extraction: between ANY two observations a, b, compute EXACTLY HOW they relate!
vi-same-way : (a b : Z) → PathWay a b
vi-same-way a b = (z-sub b a , z-sub-add-cancel a b)

-- UNIVERSAL THEOREM 1 (SPATIOTEMPORAL PATH COMPOSITION — WITNESSES ADD EXACTLY!):
-- Composing path (a --w1--> b) with (b --w2--> c) produces (a --(w1+w2)--> c) with ZERO loss!
vi-thm-path-compose : {a b c : Z} → PathWay a b → PathWay b c → PathWay a c
vi-thm-path-compose {a} {b} {c} p q =
  (z-add (fst p) (fst q) ,
   concat (sym (z-add-assoc a (fst p) (fst q)))
          (concat (cong (λ u → z-add u (fst q)) (snd p)) (snd q)))

-- UNIVERSAL THEOREM 2 (EXACT PATH INVERSION — REVERSIBLE TRANSPORT!):
vi-thm-path-inv : {a b : Z} → PathWay a b → PathWay b a
vi-thm-path-inv {a} {b} p =
  (z-neg (fst p) ,
   concat (cong (λ u → z-add u (z-neg (fst p))) (sym (snd p)))
          (concat (z-add-assoc a (fst p) (z-neg (fst p)))
                  (concat (cong (z-add a) (z-add-neg-r (fst p))) (z-add-zero-r a))))

