-- An Object Class invariant `Inv : Signal -> List Z` extracts the exact translation/photometric-
-- invariant 1-path signature `vi-diff-list b xs` (invariant under ANY uniform illumination shift `c`!).

vi-shift-list : Z → List Z → List Z
vi-shift-list _ nil         = nil
vi-shift-list c (cons x xs) = cons (z-add x c) (vi-shift-list c xs)

vi-shift-signal : Z → Signal → Signal
vi-shift-signal c (sig b xs) = sig (z-add b c) (vi-shift-list c xs)

-- Prove exact shift invariance of discrete 1-path differentials: (x + c) - (prev + c) == x - prev!
vi-sub-shift-inv : (x prev c : Z) → z-sub (z-add x c) (z-add prev c) ≡ z-sub x prev
vi-sub-shift-inv x prev c =
  let n1 = z-neg-add prev c
      step1 = cong (z-add (z-add x c)) n1
  in concat step1
            (concat (z-swap4 x c (z-neg prev) (z-neg c))
                    (concat (cong (z-add (z-sub x prev)) (z-add-neg-r c)) (z-add-zero-r (z-sub x prev))))

vi-diff-shift-inv : (prev c : Z) → (xs : List Z) →
  vi-diff-list (z-add prev c) (vi-shift-list c xs) ≡ vi-diff-list prev xs
vi-diff-shift-inv prev c nil = refl
vi-diff-shift-inv prev c (cons x xs) =
  concat (cong (λ h → cons h (vi-diff-list (z-add x c) (vi-shift-list c xs))) (vi-sub-shift-inv x prev c))
         (cong (cons (z-sub x prev)) (vi-diff-shift-inv x c xs))

