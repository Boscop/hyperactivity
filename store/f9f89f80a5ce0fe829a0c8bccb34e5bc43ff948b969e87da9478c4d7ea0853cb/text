vi-int-list : Z → List Z → List Z
vi-int-list _ nil          = nil
vi-int-list prev (cons d ds) =
  let cur = z-add prev d
  in cons cur (vi-int-list cur ds)

-- UNIVERSAL THEOREM 6 (1D GENERALIZED STOKES / FUNDAMENTAL THEOREM FOR ALL SIGNALS OF ALL LENGTHS!):
vi-thm-diff-int-exact : (prev : Z) → (xs : List Z) →
