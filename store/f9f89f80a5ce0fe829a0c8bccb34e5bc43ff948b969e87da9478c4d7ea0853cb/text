vi-thm-diff-int-exact prev nil = refl
vi-thm-diff-int-exact prev (cons x xs) =
  let p1 = z-sub-add-cancel prev x
      p2 = cong (λ u → vi-int-list u (vi-diff-list x xs)) p1
      p3 = vi-thm-diff-int-exact x xs
  in concat (cong (λ u → cons u (vi-int-list (z-add prev (z-sub x prev)) (vi-diff-list x xs))) p1)
            (cong (cons x) (concat p2 p3))

-- Full signal = (basepoint, tail): lossless 1-jet step!
data Signal : Type where
  sig : (base : Z) (rest : List Z) → Signal

vi-jet1-fwd : Signal → Signal
vi-jet1-fwd (sig b xs) = sig b (vi-diff-list b xs)

vi-jet1-bwd : Signal → Signal
vi-jet1-bwd (sig b ds) = sig b (vi-int-list b ds)

vi-thm-jet1-lossless : (s : Signal) → vi-jet1-bwd (vi-jet1-fwd s) ≡ s
vi-thm-jet1-lossless (sig b xs) = cong (sig b) (vi-thm-diff-int-exact b xs)

-- Arbitrary k-th order Jet / Texture Tower (`Jet^k` for ALL k : Nat!):
vi-jet-k-fwd : Nat → Signal → Signal
vi-jet-k-fwd zero    s = s
vi-jet-k-fwd (suc k) s = vi-jet-k-fwd k (vi-jet1-fwd s)

vi-jet-k-bwd : Nat → Signal → Signal
vi-jet-k-bwd zero    s = s
vi-jet-k-bwd (suc k) s = vi-jet1-bwd (vi-jet-k-bwd k s)

-- UNIVERSAL THEOREM 7 (ALL-ORDER HIGHER PATH / TEXTURE JET TOWER IS 100% LOSSLESS FOR EVERY k : Nat!):
vi-thm-jet-k-lossless : (k : Nat) → (s : Signal) →
  vi-jet-k-bwd k (vi-jet-k-fwd k s) ≡ s
vi-thm-jet-k-lossless zero    s = refl
vi-thm-jet-k-lossless (suc k) s =
  concat (cong vi-jet1-bwd (vi-thm-jet-k-lossless k (vi-jet1-fwd s)))
         (vi-thm-jet1-lossless s)

