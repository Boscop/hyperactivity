vi-holonomy : Z → Z → Z → Z → Z
vi-holonomy b r t l = z-sub (z-add b r) (z-add t l)

-- UNIVERSAL THEOREM 3 (EXACT 2-CELL FLATNESS / d^2 = 0 — POINCARE LEMMA FOR ALL 4 VERTICES!):
-- For ANY 4 corner intensities (v00, v10, v11, v01) of a spatiotemporal plaquette,
-- the exact 1-paths (v10 - v00, v11 - v10, v11 - v01, v01 - v00) have ZERO holonomy identically!
vi-thm-stokes-plaquette-flat : (v00 v10 v11 v01 : Z) →
  vi-holonomy (z-sub v10 v00) (z-sub v11 v10) (z-sub v11 v01) (z-sub v01 v00) ≡ z-zero
vi-thm-stokes-plaquette-flat v00 v10 v11 v01 =
  let lhs = z-tel v10 v00 v11
      rhs = concat (z-add-comm (z-sub v11 v01) (z-sub v01 v00)) (z-tel v01 v00 v11)
  in concat (cong (λ u → z-sub u (z-add (z-sub v11 v01) (z-sub v01 v00))) lhs)
            (concat (cong (z-sub (z-sub v11 v00)) rhs) (z-add-neg-r (z-sub v11 v00)))

-- UNIVERSAL THEOREM 4 (2D GENERALIZED STOKES — ADJACENT PLAQUETTE INTERIOR-EDGE CANCELLATION!):
vi-thm-generalized-stokes-glue : (b1 b2 r t1 t2 l m : Z) →
  z-add (vi-holonomy b1 m t1 l) (vi-holonomy b2 r t2 m) ≡
  vi-holonomy (z-add b1 b2) r (z-add t1 t2) l
vi-thm-generalized-stokes-glue b1 b2 r t1 t2 l m =
  let n1 = z-neg-add t1 l
      n2 = z-neg-add t2 m
      sq1 = z-pull-r b1 (z-neg (z-add t1 l)) m
      sq2 = concat (cong (z-add (z-add b2 r)) n2) (sym (z-add-assoc (z-add b2 r) (z-neg t2) (z-neg m)))
      comb = concat (cong (λ u → z-add u (vi-holonomy b2 r t2 m)) sq1)
             (concat (cong (z-add (z-add (z-add b1 (z-neg (z-add t1 l))) m)) sq2)
                     (z-cancel-m m (z-add b1 (z-neg (z-add t1 l))) (z-add (z-add b2 r) (z-neg t2))))
      s4 = z-swap4 b1 (z-neg (z-add t1 l)) (z-add b2 r) (z-neg t2)
      pos-ok = sym (z-add-assoc b1 b2 r)
      neg-ok =
        concat (cong (λ u → z-add u (z-neg t2)) n1)
               (concat (z-pull-r (z-neg t1) (z-neg t2) (z-neg l))
                       (concat (cong (λ u → z-add u (z-neg l)) (sym (z-neg-add t1 t2)))
                               (sym (z-neg-add (z-add t1 t2) l))))
  in concat comb (concat s4 (concat (cong (λ u → z-add u (z-add (z-neg (z-add t1 l)) (z-neg t2))) pos-ok)
                                    (cong (z-add (z-add (z-add b1 b2) r)) neg-ok)))

