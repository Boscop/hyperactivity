-- the front page, sent to whoever asks the public server for local-only routes (s-views-path)
s-to-front : List Word
s-to-front = h-concat (cons "HTTP/1.1 302 Found" (cons h-crlf (cons "Location: /" (cons h-crlf (cons "Content-Length: 0" (cons h-crlf (cons "Cache-Control: no-cache" (cons h-crlf (cons "Connection: close" (cons h-crlf (cons h-crlf nil)))))))))))
