-- Split a sampled strand ONLY where z crosses 0 (with 1-sample overlap so joins have zero hairline seam)
split-strand-go : Bool → RPt → List RPt → List RPt → List RRun → List RRun
split-strand-go curFront prev nil curAcc runsAcc =
  let runPts = lg-rev curAcc
  in cons (rrun curFront (rpts-z-avg runPts) runPts) runsAcc
split-strand-go curFront prev (cons pt r) curAcc runsAcc =
  let isFront = case pt of rpt _ _ z _ → si-is-nonneg z
  in if bool-eq isFront curFront
     then split-strand-go curFront pt r (cons pt curAcc) runsAcc
     else let donePts = lg-rev (cons pt curAcc)
              runs2 = cons (rrun curFront (rpts-z-avg donePts) donePts) runsAcc
          in split-strand-go isFront pt r (cons pt (cons prev nil)) runs2
