render-runs : List RRun → List Word
render-runs nil = nil
render-runs (cons (rrun isFront _ pts) r) =
  let koW = if isFront then sp #108 else sp #56
      dKo = ribbon-poly-d (trim-ends pts) koW
      dFg = ribbon-poly-d pts si-zero
      seg = lg-concat (cons "<path d='" (cons dKo (cons "' fill='#ff0a94'/><path d='" (cons dFg (cons "' fill='#fff'/>" nil)))))
  in list-append seg (render-runs r)
