-- the separation written before a word: in the key one space; in the forms a line break where the run held
-- one (the line as written), else a space. One byte either way, so key and forms stay of equal length
nm-sep : Word → Word → Word
nm-sep lc st = if andB (weq lc #0) (weq (wand st #2) #2) then #10 else #32
