-- the interchange of sums: (x + u) + (y + v) = (x + y) + (u + v)
plusw-interchange : (x u y v : Word) → plusw (plusw x u) (plusw y v) ≡ plusw (plusw x y) (plusw u v)
plusw-interchange x u y v =
  plusw-assoc x u (plusw y v) ∙ (congw (λ z → plusw x z) (plusw-mid u y v) ∙ sym (plusw-assoc x y (plusw u v)))
