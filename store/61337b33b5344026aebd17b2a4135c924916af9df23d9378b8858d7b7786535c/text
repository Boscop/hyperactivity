v-layer-list : Nat → List (List Word × List (List Word)) → List (List Word) → List (List (List Word))
v-layer-list zero gtab rem = nil
v-layer-list (suc f) gtab rem =
  if v-empty rem then nil else
  let top = v-top-of gtab rem in
  cons top (v-layer-list f gtab (v-filter (λ x → h-not (h-has x top)) rem))
