bn-x86-lut-minterm : Word → Word → List Word
bn-x86-lut-minterm imm k =
  if %weq (%wand (%wshr imm k) #1) #0 then bn-empty-bytes
  else
    let invA = the (List Word) (if %weq (%wand (%wshr k #2) #1) #1 then bn-empty-bytes else bn-x86-not-rcx)
        invB = the (List Word) (if %weq (%wand (%wshr k #1) #1) #1 then bn-empty-bytes else bn-x86-not-rdx)
        invC = the (List Word) (if %weq (%wand k #1) #1            then bn-empty-bytes else bn-x86-not-rdx)
    in h-concat
         (cons (cons #76 (cons #137 (cons #217 nil)))
         (cons invA
         (cons (cons #76 (cons #137 (cons #202 nil)))
         (cons invB
         (cons (cons #72 (cons #33 (cons #209 nil)))
         (cons (cons #76 (cons #137 (cons #210 nil)))
         (cons invC
         (cons (cons #72 (cons #33 (cons #209 nil)))
         (cons (cons #72 (cons #9 (cons #200 nil))) nil)))))))))
