lqg-gauss-gram-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-gauss-gram-poly A ad mu q vs =
  (λ g sq →
    let sx = ad (ad (g 0) (g 3)) (ad (g 6) (g 9))
        sy = ad (ad (g 1) (g 4)) (ad (g 7) (g 10))
        sz = ad (ad (g 2) (g 5)) (ad (g 8) (g 11))
        lhs = ad (ad (sq sx) (sq sy)) (sq sz)
        q2 = q (fn-q 2 1)
        d00 = lqg-dot3 A ad mu g 0 0
        d33 = lqg-dot3 A ad mu g 3 3
        d66 = lqg-dot3 A ad mu g 6 6
        d99 = lqg-dot3 A ad mu g 9 9
        diag = ad (ad d00 d33) (ad d66 d99)
        cross = ad (ad (ad (lqg-dot3 A ad mu g 0 3) (lqg-dot3 A ad mu g 0 6))
                       (ad (lqg-dot3 A ad mu g 0 9) (lqg-dot3 A ad mu g 3 6)))
                   (ad (lqg-dot3 A ad mu g 3 9) (lqg-dot3 A ad mu g 6 9))
        rhs = ad diag (mu q2 cross)
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsq A mu)
