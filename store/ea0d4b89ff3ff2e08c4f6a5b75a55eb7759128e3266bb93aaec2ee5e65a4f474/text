-- composition in a Glue type: on each face the composition in that side's type; in the base, the
-- composition of the sides taken to the base, with, on each face, the image of the filler there
nk-sys-meet : NkTm → NkTm
nk-sys-meet (nk-cons b r) = nk-cons (nk-br (nk-up (nk-bf b)) (nk-lam (nk-app (nk-up2 (nk-bv b)) (nk-and-i (nk-var #1) (nk-var #0))))) (nk-sys-meet r)
nk-sys-meet t = nk-nil
