nk-read-ref-denotes : (rho : NkW → NkEv) (h : NkHd) (parts : NkEnv) (n : NkW) →
  (nk-ebound parts n ≡ true) →
  nk-val-ev (nk-rho-copy rho parts n) (nkv h (nk-copy-env parts n)) ≡ nk-val-ev rho (nkv h parts)
nk-read-ref-denotes rho h parts n hb =
  cong (λ z → nkev h z) (nk-copy-env-denotes rho parts n hb)
