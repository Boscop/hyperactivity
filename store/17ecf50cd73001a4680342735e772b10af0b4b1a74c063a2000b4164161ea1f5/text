rm-drop-body : RCx → RTy → RLayout → (RTy → RCall → MPtr → REv Unit) → RCall → MPtr → REv Unit
rm-drop-body cx ty l again = case ly-tag-of l of
  rtag-none → (case ly-variants-of l of
    nil → λ call p → rm-ret unit
    cons v vs → rm-drop-fields (vl-fields-of v) again)
  rtag-direct off size → rm-drop-enum cx ty l
  rtag-niche off size → rm-drop-enum cx ty l
