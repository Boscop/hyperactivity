dm-evm-block-num : List Word → Proc W Word
dm-evm-block-num rpcUrl =
  let req = h-concat
              (cons "{" (cons (h-quote "jsonrpc") (cons ":" (cons (h-quote "2.0")
              (cons "," (cons (h-quote "id") (cons ":1,"
              (cons (h-quote "method") (cons ":" (cons (h-quote "eth_blockNumber")
              (cons "," (cons (h-quote "params") (cons ":[]}" nil)))))))))))))
  in bind (dm-http-post-json rpcUrl req) (λ resp →
     ret {lzero} {W} (bl-hex-to-word (bl-extract-json-hex resp)))
