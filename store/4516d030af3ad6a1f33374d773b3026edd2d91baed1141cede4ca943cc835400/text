sl-fround : Word → Word → Word
sl-fround k r = %wand (%wadd (%wmul r #2654435761) k) #65535

sl-feistel-enc : Word → Word → Word
sl-feistel-enc k x =
  let l0 = %wand (%wshr x #16) #65535
      r0 = %wand x #65535
      l1 = r0
      r1 = %wxor l0 (sl-fround k r0)
      l2 = r1
      r2 = %wxor l1 (sl-fround (%wxor k #2781060887) r1)
  in %wor (%wshl l2 #16) r2

sl-feistel-dec : Word → Word → Word
sl-feistel-dec k y =
  let l2 = %wand (%wshr y #16) #65535
      r2 = %wand y #65535
      r1 = l2
      l1 = %wxor r2 (sl-fround (%wxor k #2781060887) r1)
      r0 = l1
      l0 = %wxor r1 (sl-fround k r0)
  in %wor (%wshl l0 #16) r0

