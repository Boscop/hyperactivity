-- SECTION 1: UNITARY SYNESTHETIC KNOTS & NEO-RIEMANNIAN TONNETZ SOUND ALGEBRA
-- ============================================================================
-- Exact 24-triad Tonnetz space: (root in 0..11, mode in 0..1 where 0=Major, 1=Minor)
-- Packed into Word `t = root * 2 + mode` in 0..23.
-- Neo-Riemannian group generators (exact involutions: P^2 = L^2 = R^2 = id):
--   * P (Parallel)    : (r, 0) <-> (r, 1)
--   * L (Leitton)     : (r, 0) <-> ((r + 4) mod 12, 1) ; (r, 1) <-> ((r + 8) mod 12, 0)
--   * R (Relative)    : (r, 0) <-> ((r + 9) mod 12, 1) ; (r, 1) <-> ((r + 3) mod 12, 0)

sl-mod12 : Word → Word
sl-mod12 x = %wsub x (%wmul #12 (%wdiv x #12))

sl-triad-root : Word → Word
sl-triad-root t = %wdiv t #2

sl-triad-mode : Word → Word
sl-triad-mode t = %wand t #1

sl-mk-triad : Word → Word → Word
sl-mk-triad r m = %wadd (%wmul (sl-mod12 r) #2) (%wand m #1)

sl-tonnetz-P : Word → Word
sl-tonnetz-P t = sl-mk-triad (sl-triad-root t) (%wxor (sl-triad-mode t) #1)

sl-tonnetz-L : Word → Word
sl-tonnetz-L t =
  let r = sl-triad-root t
      m = sl-triad-mode t
  in if %weq m #0 then sl-mk-triad (%wadd r #4) #1
     else sl-mk-triad (%wadd r #8) #0

sl-tonnetz-R : Word → Word
sl-tonnetz-R t =
  let r = sl-triad-root t
      m = sl-triad-mode t
  in if %weq m #0 then sl-mk-triad (%wadd r #9) #1
     else sl-mk-triad (%wadd r #3) #0

-- Exhaustive check of P^2 = L^2 = R^2 = id across ALL 24 Major/Minor triads (t = 0..23):
sl-check-tonnetz-24 : Nat → Word → Bool
sl-check-tonnetz-24 zero _ = true
sl-check-tonnetz-24 (suc k) t =
  andB (%weq (sl-tonnetz-P (sl-tonnetz-P t)) t)
  (andB (%weq (sl-tonnetz-L (sl-tonnetz-L t)) t)
  (andB (%weq (sl-tonnetz-R (sl-tonnetz-R t)) t)
        (sl-check-tonnetz-24 k (%wadd t #1))))

