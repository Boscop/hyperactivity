hm-thm-fermi-hop-conserves-N : (oi oj : Bool) →
  hm-add (hm-b2n (hm-hop-new-i oi oj)) (hm-b2n (hm-hop-new-j oi oj)) ≡ hm-add (hm-b2n oi) (hm-b2n oj)
hm-thm-fermi-hop-conserves-N true  true  = refl
hm-thm-fermi-hop-conserves-N true  false = refl
hm-thm-fermi-hop-conserves-N false true  = refl
hm-thm-fermi-hop-conserves-N false false = refl
