v-stream-nodes : VEnv → List Word → Word → Bool → List (List Word) → Proc W (List (List Word))
v-stream-nodes env dir fd first nil = ret nil
v-stream-nodes env dir fd first (cons i r) =
  bind (v-statement i) (λ s →
  bind (h-write (list-append dir (list-append "show-" (h-hex i))) (v-show-text env i s)) (λ b →
  bind (fd-write fd (if first then v-json-node env i s else cons #44 (v-json-node env i s))) (λ w →
  bind (v-stream-nodes env dir fd false r) (λ rest →
  ret (if v-empty s then cons (list-append i ": no statement") rest else rest)))))
