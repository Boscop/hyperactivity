safe-local : {M St : Type} → (P : NodeId → St → Type) → (beh : Beh M St) → LocalInv {M} {St} P beh → (g0 : FState M St) → ((i : NodeId) → P i (fst g0 i)) →
             Safe {M} {St} (λ g → (i : NodeId) → P i (fst g i)) beh g0
safe-local {M} {St} P beh li g0 h0 =
  safe-by-events {M} {St} (λ g → (i : NodeId) → P i (fst g i)) beh g0 h0
    (λ g i h → ns-local {M} {St} P beh li i ev-run g h)
    (λ g p rest h m s → ns-local {M} {St} P beh li (p-to p) (ev-deliver p rest) g h)
    (λ g n h s → h)
