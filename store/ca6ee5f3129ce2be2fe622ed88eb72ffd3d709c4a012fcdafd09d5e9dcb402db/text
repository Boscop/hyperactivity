-- /paper : the paper as it reads (lib/paper-view.cub keeps it in the store, paper/text), made when absent
s-paper-of : Sum Unit (List Word) → List Word
s-paper-of (inl u) = s-respond "503 Service Unavailable" "text/plain" "the paper is being made; reload in a minute"
s-paper-of (inr t) = s-response s-html (s-page "paper.md" t)
