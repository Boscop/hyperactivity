wequiv-comp : {A B C : Type} → WEquiv A B → WEquiv B C → WEquiv A C
wequiv-comp e1 e2 =
  let f1 = fst e1
      g1 = fst (snd e1)
      s1 = fst (snd (snd e1))
      r1 = snd (snd (snd e1))
      f2 = fst e2
      g2 = fst (snd e2)
      s2 = fst (snd (snd e2))
      r2 = snd (snd (snd e2))
  in ((λ a → f2 (f1 a)) ,
     ((λ c → g1 (g2 c)) ,
     ((λ c → wequiv-comp-path (λ i → f2 (s1 (g2 c) i)) (s2 c)) ,
      (λ a → wequiv-comp-path (λ i → g1 (r2 (f1 a) i)) (r1 a)))))
