-- (part of language-support)
main : MS Unit
main =
  bindS {Bits #48} {Unit} (getS {Bits #48} x86-haltAddrReg) (λ haltAddrReg'1 →
    bindS {Bool} {Unit} (getS {Bool} x86-log_register_writes) (λ log_register_writes'2 →
      bindS {ZI} {Unit} (x86_run_halt haltAddrReg'1 (zpos #10000) (b-not log_register_writes'2) false (zpos #0)) (λ steps' →
        retS {Unit} unit)))
