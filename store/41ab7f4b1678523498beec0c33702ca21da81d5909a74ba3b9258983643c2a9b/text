sg-dc-let : (Word → Lst (List Word) → NkSexp → Word × NkSexp) → Word → Lst (List Word) → Lst NkSexp → Word × NkSexp
sg-dc-let _ fr _ lnil = (fr , nks-sym nil)
sg-dc-let go fr ds (lcons a1 r1) =
  case r1 return (λ _ → Word × NkSexp) of
    lnil → (fr , nks-sym nil)
    lcons a2 r2 →
      case r2 return (λ _ → Word × NkSexp) of
        lnil → sg-dc-let2 go (%wsucc fr) ds (sg-fresh-nm fr) a1 a2
        lcons a3 _ →
          case sg-eq-name a1 return (λ _ → Word × NkSexp) of
            some nm → sg-dc-let2 go fr ds nm a2 a3
            none → (fr , nks-sym nil)
