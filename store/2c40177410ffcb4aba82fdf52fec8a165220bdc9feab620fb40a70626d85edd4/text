-- Arbitrary 10-Layer Layout & Routing Certifier Soundness Theorem:
cert-layout-3d-sound : (minS : Nat) → (ss : List Shape3D) →
  check-layout-3d minS ss ≡ true → Pairwise3D minS ss
cert-layout-3d-sound minS nil _ = unit
cert-layout-3d-sound minS (cons s ss) h =
  ( cert-sep3d-one minS s ss (andB-fst (check-sep3d-one minS s ss) (check-layout-3d minS ss) h)
  , cert-layout-3d-sound minS ss (andB-snd (check-sep3d-one minS s ss) (check-layout-3d minS ss) h) )
