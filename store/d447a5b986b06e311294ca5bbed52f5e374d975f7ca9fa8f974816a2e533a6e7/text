jp-add : JPoint → JPoint → JPoint
jp-add jp-inf          q               = q
jp-add p               jp-inf          = p
jp-add (jp-pt x1 y1 z1) (jp-pt x2 y2 z2) =
  let z1s = fp-sqr z1
      z2s = fp-sqr z2
      u1  = fp-mul x1 z2s
      u2  = fp-mul x2 z1s
      s1  = fp-mul y1 (fp-mul z2 z2s)
      s2  = fp-mul y2 (fp-mul z1 z1s)
  in if %weq u1 u2
     then (if %weq s1 s2 then jp-dbl (jp-pt x1 y1 z1) else jp-inf)
     else let h  = fp-sub u2 u1
              i  = fp-sqr (fp-mul #2 h)
              j  = fp-mul h i
              rr = fp-mul #2 (fp-sub s2 s1)
              v  = fp-mul u1 i
              x3 = fp-sub (fp-sub (fp-sqr rr) j) (fp-mul #2 v)
              y3 = fp-sub (fp-mul rr (fp-sub v x3)) (fp-mul #2 (fp-mul s1 j))
              z3 = fp-mul (fp-sub (fp-sqr (fp-add z1 z2)) (fp-add z1s z2s)) h
          in jp-pt x3 y3 z3
