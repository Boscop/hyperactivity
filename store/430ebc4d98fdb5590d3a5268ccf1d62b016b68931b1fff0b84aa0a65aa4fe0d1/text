bn-parse-be32s : Nat → List Word → List Word
bn-parse-be32s zero    bs = nil
bn-parse-be32s (suc k) bs =
  let b0 = bn-nth-w #0 bs
      b1 = bn-nth-w #1 bs
      b2 = bn-nth-w #2 bs
      b3 = bn-nth-w #3 bs
      w  = %wor (%wshl b0 #24) (%wor (%wshl b1 #16) (%wor (%wshl b2 #8) b3))
  in cons w (bn-parse-be32s k (kc-drop (toNat #4) bs))
