cs-sim-fst : (hp1 : CsHeap) (mp : CsMVal) (vp : CsVal) →
  (cs-val-rel hp1 mp vp ≡ true) →
  cs-sim-ok (case mp return (λ _ → CsOptM) of cmv-word w → csom-none; cmv-bool b → csom-none; cmv-pair ma mb → csom-some ma)
            (cs-load-res hp1 vp (suc zero)) ≡ true
cs-sim-fst hp1 (cmv-word w) vp hrel = refl
cs-sim-fst hp1 (cmv-bool b) vp hrel = refl
cs-sim-fst hp1 (cmv-pair ma mb) (csv-word w) hrel = cs-no hrel
cs-sim-fst hp1 (cmv-pair ma mb) (csv-ptr addr) hrel =
  cs-sim-fst-at hp1 addr ma mb
    (cs-loadv hp1 (csv-ptr addr) (suc zero))
    (cs-loadv hp1 (csv-ptr addr) (suc (suc zero))) refl refl hrel
