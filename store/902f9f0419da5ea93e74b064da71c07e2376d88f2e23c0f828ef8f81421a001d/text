-- Y/r = q/X: (Y·S)(X·S) = S2·q·r
recip-y : (Y X : Nat × Nat) → (q r Sv S2v : Nat) → S2v ≡ times Sv Sv → zeq (zmul Y X) (the (Nat × Nat) (times q r , zero)) → zeq (zmul (zsc Y Sv) (zsc X Sv)) (the (Nat × Nat) (times (times S2v q) r , zero))
recip-y Y X q r Sv S2v hS2 hY = transport (λ i → zeq (symNN (zmul-zsc2 Y X Sv Sv) i)
     (pairNN (times (times q r) (times Sv Sv)) zero (times (times S2v q) r) zero
        (symN (transN (times-assoc S2v q r) (transN (times-comm S2v (times q r)) (congN (times (times q r)) hS2)))) (λ j → zero) i))
  (zeq-zsc (zmul Y X) (the (Nat × Nat) (times q r , zero)) (times Sv Sv) hY)
