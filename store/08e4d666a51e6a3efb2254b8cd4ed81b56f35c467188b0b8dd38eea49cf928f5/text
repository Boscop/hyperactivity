hy-dead : List Word → List (List Word) → Proc W Unit
hy-dead m (cons e (cons r rs)) = bind (h-capture (cons m (cons "--dead" (cons e (cons (hy-spaced (cons r rs)) nil))))) (λ c → h-out (list-append "stated dead: " (list-append e (list-append " (statement " (list-append (h-before (cons #10 nil) (snd c)) (h-line ")"))))))
hy-dead m l = h-fail "hyperactive dead ENTRY REASON"
