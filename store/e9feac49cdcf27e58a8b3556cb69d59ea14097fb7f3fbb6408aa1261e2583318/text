-- parse a two-S-expression store/<key>/forms text into (term-code , type-code)
nk-read-forms : List Word → Opt (Code × Code)
nk-read-forms txt =
  case nk-parse-sexp (toNat #512) false txt return (λ _ → Opt (Code × Code)) of
    none → none
    some p1 →
      (case nk-parse-sexp (toNat #512) false (snd p1) return (λ _ → Opt (Code × Code)) of
         none → none
         some p2 → some (nk-sexp-code (toNat #256) lnil (fst (fst p2)) , nk-sexp-code (toNat #256) lnil (fst (fst p1))))
