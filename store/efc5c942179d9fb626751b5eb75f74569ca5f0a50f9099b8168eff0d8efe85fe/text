-- bytes whose four checks hold (si-made-ok-b, decided when they are made) answer every query with the number
-- of the text's suffixes that start with it
si-ask-ok : (T : List (List Word)) → (n : Nat) → (B : Bytes n) →
  isTrue (si-chk-chain n B #8 (si-o0 T) T) → isTrue (si-chk-tree n B (si-tree T) (si-rd4 n B #0)) →
  isTrue (si-fuel (si-tree T) (toNat (si-rd4 n B #4))) → isTrue (si-tokens-ok T) → (q : List (List Word)) →
  si-ask n B q ≡ fromNat (si-nstarts q (suffix-array T))
si-ask-ok T n B h1 h2 h3 h4 q = si-index-ok T n B #8 (si-o0 T) (si-rd4 n B #0) (list-length (suffix-array-fast T)) (toNat (si-rd4 n B #4)) h1 h2 h3 h4 q
