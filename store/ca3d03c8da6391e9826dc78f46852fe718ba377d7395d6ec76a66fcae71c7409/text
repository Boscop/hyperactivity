-- composition along a line of types: the sides and the base carried to the end of the line, and
-- composed there
nk-comp-brs : NkTm → NkTm → NkTm
nk-comp-brs aline (nk-cons b r) = nk-cons (nk-br (nk-nth (nk-args b) #0) (nk-lam (nk-transp (nk-lam (nk-app (nk-up2 aline) (nk-or-i (nk-var #1) (nk-var #0)))) (nk-var #0) (nk-app (nk-up (nk-nth (nk-args b) #1)) (nk-var #0))))) (nk-comp-brs aline r)
nk-comp-brs aline t = nk-nil
