-- POST /dht/announce : 1-RTT bidirectional Federated Peer Exchange (merges <peerId64> <url> lines and returns merged table)
s-private-host : List Word → Bool
s-private-host h =
  orB (h-eq h "localhost") (orB (h-prefix "127." h) (orB (h-prefix "0." h) (
  orB (h-prefix "10." h) (orB (h-prefix "169.254." h) (orB (h-prefix "192.168." h) (
  orB (h-prefix "[" h) (h-ends ".internal" h)))))))
