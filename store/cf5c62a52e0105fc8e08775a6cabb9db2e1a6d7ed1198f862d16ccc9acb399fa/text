-- Parity identity: XOR of the 3 row parities equals XOR of the 3 column parities
-- for EVERY 3×3 Boolean grid (x11..x33).
pm-xor-comm : (a b : Bool) → pm-xor a b ≡ pm-xor b a
pm-xor-comm true true = λ i → false
pm-xor-comm true false = λ i → true
pm-xor-comm false true = λ i → true
pm-xor-comm false false = λ i → false
