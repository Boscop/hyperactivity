-- (part of language-support)
xmmi_size : (nbytes : Bits #5) → (index' : Bits #4) → MS (Bits #128)
xmmi_size nbytes index' =
  λ σ →
    if (weq nbytes #4) then
      the (MS (Bits #128))
        (bindS {Bits #32} {Bits #128} (rx32 index') (λ t'1 →
           retS {Bits #128} (bv-zext #32 #128 t'1))) σ
    else if (weq nbytes #8) then
      the (MS (Bits #128))
        (bindS {Bits #64} {Bits #128} (rx64 index') (λ t'2 →
           retS {Bits #128} (bv-zext #64 #128 t'2))) σ
    else if (weq nbytes #16) then
      the (MS (Bits #128))
        (rx128 index') σ
    else
      the (MS (Bits #128))
        (retS {Bits #128} #0) σ
