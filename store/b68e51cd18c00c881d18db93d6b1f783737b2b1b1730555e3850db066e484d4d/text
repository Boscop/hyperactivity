cs-hy-shl-prim-mono : (hp : CsHeap) (a b : Word) (p : CsPrim) → cs-res-mono hp (cs-hy-shl-prim hp a b p)
cs-hy-shl-prim-mono hp a b csp-ub = unit
cs-hy-shl-prim-mono hp a b (csp-ok hi) =
  cs-ite-res-mono (%weq hi #0) hp (cs-prim-res hp (cs-c11-shl64 a b)) cso-abort
    (cs-prim-res-mono hp (cs-c11-shl64 a b)) unit
