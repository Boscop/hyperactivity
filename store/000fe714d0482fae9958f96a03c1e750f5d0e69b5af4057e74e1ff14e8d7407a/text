-- a row of c·(Hm − λS) − H2
pl-g-row : BQ → BQ → BQ → BQ → List BQ → List BQ → List (BQ × (BQ × BQ)) → List BQ
pl-g-row c lam l p hs ss ws = case hs of
  nil → nil
  cons h hr → (case ss of
    nil → nil
    cons s sr → (case ws of
      nil → nil
      cons w wr → cons (fn-sub (bq-mul c (fn-sub h (bq-mul lam s))) (pl-val l p w)) (pl-g-row c lam l p hr sr wr)))
