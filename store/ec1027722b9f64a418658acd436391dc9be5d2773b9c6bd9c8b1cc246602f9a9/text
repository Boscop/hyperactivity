-- a row of zeros passes the off-diagonal test past its first place
cl-zeros-offz : (A B : Type) → (z : A) → (isz : A → Bool) → isz z ≡ true → (ws : List B) → (j : Nat) → cl-offz A isz zero (suc j) (ln-map B A (λ w → z) ws) ≡ true
cl-zeros-offz A B z isz hz ws j = (case ws return λ xs → (j2 : Nat) → cl-offz A isz zero (suc j2) (ln-map B A (λ w → z) xs) ≡ true of
  nil → λ j2 → λ i → true
  cons w rest → λ j2 → cl-tr Bool (if isz z then cl-offz A isz zero (suc (suc j2)) (ln-map B A (λ w2 → z) rest) else false) (cl-offz A isz zero (suc (suc j2)) (ln-map B A (λ w2 → z) rest)) true
    (λ i → if hz i then cl-offz A isz zero (suc (suc j2)) (ln-map B A (λ w2 → z) rest) else false) (cl-zeros-offz A B z isz hz rest (suc j2))) j
