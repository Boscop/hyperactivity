bn-emit-5bits : Nat → Word → Word → Word × (Word × List Word)
bn-emit-5bits zero    acc bits = (acc , (bits , nil))
bn-emit-5bits (suc k) acc bits =
  if eth-le #5 bits
  then let nb  = %wsub bits #5
           val = %wand (%wshr acc nb) #31
           rst = bn-emit-5bits k (%wand acc (%wsub (%wshl #1 nb) #1)) nb
       in (fst rst , (fst (snd rst) , cons val (snd (snd rst))))
  else (acc , (bits , nil))
