-- the names of every module of the source
c-module-names : List (List Word) → Proc W (List (List Word))
c-module-names nil = ret nil
c-module-names (cons hx r) = bind (h-read (list-append h-index (list-append "/modules/" hx))) (λ p →
  bind (c-module-names r) (λ rest → ret (cons (h-trim (h-source-or p)) rest)))
