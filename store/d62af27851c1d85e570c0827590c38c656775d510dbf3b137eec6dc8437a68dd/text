nk-is-pk-glob : Word → Bool
nk-is-pk-glob g =
  if %weq g (nk-gix (code nk-pk-core)) then true
  else (if %weq g (nk-gix (code nk-pk-memd)) then true
  else (if %weq g (nk-gix (code nk-pk-mem0)) then true
  else (if %weq g (nk-gix (code nk-pk-mem1)) then true
  else (if %weq g (nk-gix (code nk-pk-mach)) then true
  else (if %weq g (nk-gix (code nk-pk-chkd)) then true
  else (if %weq g (nk-gix (code nk-pk-chk0)) then true
  else (if %weq g (nk-gix (code nk-pk-chk1)) then true
  else (if %weq g (nk-gix (code nk-pk-chk2)) then true
  else %weq g (nk-gix (code nk-pk-chk3))))))))))
