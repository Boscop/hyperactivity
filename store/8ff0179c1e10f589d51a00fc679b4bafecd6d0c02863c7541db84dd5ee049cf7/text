bytes-enc-dec-at : (n : Nat) → (b : SumFin n → Byte) → (j : SumFin n) → bytes-enc n (bytes-dec n b) j ≡ b j
bytes-enc-dec-at zero b j = Empty-rec j
bytes-enc-dec-at (suc n) b j = case j return (λ x → bytes-enc (suc n) (bytes-dec (suc n) b) x ≡ b x) of
  inl u → concat {lzero} {Byte} {snd (bv-split (bytes-bits n) 8 (bytes-dec (suc n) b))} {b (inl unit)} {b (inl u)}
    (λ k → snd (bv-split-cat (bytes-bits n) 8 (bytes-dec n (λ j2 → b (inr j2))) (b (inl unit)) k)) (λ k → b (inl (sf-unit u k)))
  inr j2 → concat {lzero} {Byte} {bytes-enc n (fst (bv-split (bytes-bits n) 8 (bytes-dec (suc n) b))) j2} {bytes-enc n (bytes-dec n (λ j3 → b (inr j3))) j2} {b (inr j2)}
    (λ k → bytes-enc n (fst (bv-split-cat (bytes-bits n) 8 (bytes-dec n (λ j3 → b (inr j3))) (b (inl unit)) k)) j2)
    (bytes-enc-dec-at n (λ j3 → b (inr j3)) j2)
