pts-to-path-go : Bool → List Pt2 → List Word
pts-to-path-go isFirst nil = nil
pts-to-path-go isFirst (cons pt r) =
  let cmd : List Word
      cmd = if isFirst then "M" else " L"
  in lg-concat (cons cmd (cons (lg-stenths (fst pt)) (cons " " (cons (lg-stenths (snd pt)) (cons (pts-to-path-go false r) nil)))))
