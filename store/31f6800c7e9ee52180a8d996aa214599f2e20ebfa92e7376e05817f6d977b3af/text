-- inputs enclosing exact inputs, at every index and every enclosed previous value
env-ok : List Bool → (Nat → IV → Nat → IV) → (Nat → ZQ → Nat → ZQ) → Type
env-ok S envt Et = (n : Nat) → (t : IV) → (tv : ZQ) → ivc t → encl S t (fst tv) (snd tv) → le (suc zero) (snd tv) →
  ((k : Nat) → ivc (envt (suc n) t k)) × (((k : Nat) → encl S (envt (suc n) t k) (fst (Et (suc n) tv k)) (snd (Et (suc n) tv k))) × ((k : Nat) → le (suc zero) (snd (Et (suc n) tv k))))
