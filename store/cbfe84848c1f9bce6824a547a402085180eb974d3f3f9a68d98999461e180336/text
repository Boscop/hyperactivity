step-r : {a b r : Bool} → isTrue b → isTrue (lex-step a b r) → isTrue r
step-r hb h =
  (case a return λ y → isTrue (lex-step y b r) → isTrue r of
     true → λ h → (case b return λ z → isTrue z → isTrue (if z then r else true) → isTrue r of true → λ hb h → h; false → λ hb h → Empty-rec hb) hb h
     false → λ h → Empty-rec h) h
