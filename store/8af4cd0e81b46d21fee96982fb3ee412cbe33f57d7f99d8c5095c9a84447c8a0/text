mask-select-lift : (m : List Bool) → (ls : List (List Word)) → mask-select (lines-of ls) (mask-lift m ls) ≡ lines-of (mask-select ls m)
mask-select-lift nil nil = λ i → nil
mask-select-lift nil (cons l ls) = mask-select-nil (lines-of (cons l ls))
mask-select-lift (cons b m) nil = λ i → nil
mask-select-lift (cons true m) (cons l ls) =
  mask-select-paint-true l (cons true (mask-lift m ls)) (cons #10 (lines-of ls)) ∙ (λ i → list-append l (cons #10 (mask-select-lift m ls i)))
mask-select-lift (cons false m) (cons l ls) =
  mask-select-paint-false l (cons false (mask-lift m ls)) (cons #10 (lines-of ls)) ∙ mask-select-lift m ls
