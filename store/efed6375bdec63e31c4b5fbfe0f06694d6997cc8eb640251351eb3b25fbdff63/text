-- Note stiffness k for Just-Intonation Stern-Brocot triad over 48kHz:
--   Unison 1/1 -> k=220, Maj3 5/4 -> k=344, Fifth 3/2 -> k=495, Octave 2/1 -> k=880
sb-note-k : Word → Word
sb-note-k idx =
  let m = %wmod idx #4
  in if %weq m #0 then #220
     else if %weq m #1 then #344
     else if %weq m #2 then #495
     else #880
