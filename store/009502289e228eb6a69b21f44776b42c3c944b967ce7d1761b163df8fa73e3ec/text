-- Relaxing a prior preserves every existing warranted conclusion's contrapositive: any witness
-- reachable under P remains reachable under Q.
relax-preserves-witness : {H : Type} → (P Q R : H → Type) → PriorRelaxed P Q →
  ((h : H) × P h × R h) → ((h : H) × Q h × R h)
relax-preserves-witness P Q R rel w = (fst w , (rel (fst w) (fst (snd w)) , snd (snd w)))
