-- the sides of a system at their first parts, at their second parts, and, under one more binder
-- i, at their first parts along the path up to i
nk-sys-p1 : NkTm → NkTm
nk-sys-p1 (nk-cons b r) = nk-cons (nk-br (nk-nth (nk-args b) #0) (nk-lam (nk-p1 (nk-app (nk-up (nk-nth (nk-args b) #1)) (nk-var #0))))) (nk-sys-p1 r)
nk-sys-p1 t = nk-nil
