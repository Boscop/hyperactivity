-- check: the machine's verdict on the workflow, the graph's rules (views/problems), and the names
-- the paper gives as code (paper/unresolved); the exit is 1 when any fails
hy-check : List Word → List Word → List (List Word) → Proc W Unit
hy-check st m nil =
  bind (hy-verdict st m "workflow/hyperactivity.cub") (λ v → bind (h-out (hy-verdict-text "workflow/hyperactivity.cub" v)) (λ u →
  bind (hy-view st m "check") (λ u2 → bind (hy-paper-ready st m) (λ r →
  bind (hy-get st "paper/unresolved") (λ pu → bind (h-out (hy-or nil pu)) (λ u3 →
  bind (hy-get st "views/problems") (λ vp →
  exit (if andB (hy-verdict-ok v) (andB (h-null (hy-or nil pu)) (h-null (hy-or nil vp))) then #0 else #1))))))))
hy-check st m (cons f r) = hy-machine-files m true (cons f r)
