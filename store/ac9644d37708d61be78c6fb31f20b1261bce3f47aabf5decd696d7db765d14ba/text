-- Same-row horizontal separation implies 2D DRC separation
after-to-2d : (minX minY : Nat) → (r : Rect) → (rs : List Rect) →
  AllAfter (plus minX (rx1 r)) rs → AllSep2D minX minY r rs
after-to-2d minX minY r nil h = unit
after-to-2d minX minY r (cons r2 rs) h =
  ( orB-true-l (drc-sep-x minX r r2) (drc-sep-y minY r r2) (fst h)
  , after-to-2d minX minY r rs (snd h) )
