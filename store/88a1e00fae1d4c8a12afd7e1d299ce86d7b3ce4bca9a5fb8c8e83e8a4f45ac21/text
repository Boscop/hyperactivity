check-comp1 c A u a =
  case A of
    tplam nX X LV → 
      let i = %dim nX
      in case infer-level (X i) of
           typed l → 
             case u of
               tplam nW W UV → 
                 let L0 = LV @ 0
                 in and-then (check a L0)
                      (and-then (tube-ok i (W i) L0 (LV @ i) (tval a)) (typed (LV @ 1)))
               _ → err u E-notline opq opq
           r → r
    _ → err A E-notline opq opq
