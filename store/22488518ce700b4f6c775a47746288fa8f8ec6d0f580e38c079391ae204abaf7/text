-- one evasion refutes the instrument: a structural class cannot settle what it was imposed to settle.
-- The scheduling of a class of molecules does not schedule an action on a receptor, and the supply
-- needs only one molecule outside the class with the action inside it.
evasion-refutes : (s : BScope) → Evasion s → (AffinitySettles s → Empty)
evasion-refutes s e =
  λ settles →
    let b1 = fst e in
    let b2 = fst (snd e) in
    let same = fst (snd (snd e)) in
    let inside = fst (snd (snd (snd e))) in
    let outside = snd (snd (snd (snd e))) in
    true-not-false (concat (sym inside) (concat (settles b1 b2 same) outside))
