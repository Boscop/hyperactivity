-- ============================================================================
-- 2. Dirac Hypersurface-Deformation Algebra & Off-Shell Anomaly Freedom
-- ============================================================================
-- Antisymmetry of the smeared lapse structure function:
--   q^{ab} (N ∂_b M - M ∂_b N) + q^{ab} (M ∂_b N - N ∂_b M) = 0.
-- Variables (0..4): qab, N, M, dN, dM.
lqg-dirac-antisym-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-dirac-antisym-poly A ad mu q vs =
  (λ g sub →
    let qab = g 0; N = g 1; M = g 2; dN = g 3; dM = g 4
        bNM = mu qab (sub (mu N dM) (mu M dN))
        bMN = mu qab (sub (mu M dN) (mu N dM))
    in (ad bNM bMN , q (fn-q 0 1)))
  (λ i → al-nth A (q (fn-q 0 1)) i vs) (al-gsub A ad mu q)
