-- nk-act-shape: the reference evaluator (nk-ev-go) and the net machine (nk-rule-el) select the
-- identical NkAct action from nk-act on every eliminator and value
nk-strip-shape : (t : NkTm) (rho : NkW → NkEv) (e : NkEnv) →
  nk-strip t (nk-ev-shape (nk-env-ev rho e)) ≡ nk-strip t e
nk-strip-shape t rho nke-nil = refl
nk-strip-shape (nk-lam b) rho (nke-cons w r) = nk-strip-shape b rho r
nk-strip-shape (nk-var i) rho (nke-cons w r) = refl
nk-strip-shape (nk-free x) rho (nke-cons w r) = refl
nk-strip-shape (nk-num m) rho (nke-cons w r) = refl
nk-strip-shape (nk-susp b) rho (nke-cons w r) = refl
nk-strip-shape (nk-con c as) rho (nke-cons w r) = refl
nk-strip-shape (nk-op h p as) rho (nke-cons w r) = refl
nk-strip-shape (nk-match h p cs) rho (nke-cons w r) = refl
nk-strip-shape nk-nil rho (nke-cons w r) = refl
nk-strip-shape (nk-cons a d) rho (nke-cons w r) = refl
