sg-parse-globs : NkTm → Lst (Word × List Word) → Lst (Word × (Code × Code)) → Lst (Word × (Code × Code))
sg-parse-globs _ lnil acc = acc
sg-parse-globs ksig-d (lcons it rest) acc =
  case sg-read-forms-at (toNat #8192) (toNat #2048) ksig-d (snd it) return (λ _ → Lst (Word × (Code × Code))) of
    none → sg-parse-globs ksig-d rest acc
    some cc → sg-parse-globs ksig-d rest (lcons (fst it , cc) acc)
