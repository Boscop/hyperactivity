-- GET /hi: the focus added to the reader's path walked, then the page, with the focus through time
hi-view : List Word → List Word → Proc W (List Word)
hi-view st q = bind (h-read (list-append st "/views/nodes")) (λ nv →
  bind (hi-walk st (hi-reader q) (hi-focus q)) (λ path →
  bind (hi-others st (hi-reader q) (hi-focus q)) (λ os →
  bind (hi-about (hi-focus q)) (λ ab →
  bind (hi-scene st (hi-reader q) (hi-focus q) (h-eq (s-param "radius" q) "2") (hi-rows (s-or nil nv))) (λ sc →
  bind (hi-history (hi-focus q)) (λ hs → bind (hi-morphs st (hi-reader q) (hi-focus q)) (λ ms →
  ret (s-response s-html (hi-page (hi-reader q) (hi-focus q) (h-eq (s-param "radius" q) "2") path os ab (h-concat (cons (hi-lens (hi-reader q) (hi-focus q)) (cons sc (cons ms (cons hs nil))))))))))))))
