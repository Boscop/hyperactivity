-- (part of language-support)
imul_spec_64 : (dst' : Bits #64) → (src : Bits #64) → ((Bits #64) × (Bits #64) × (Bits #128) × (Bits #1))
imul_spec_64 dst' src =
  let dst_int : Bits #64
      dst_int = dst'
      src_int : Bits #64
      src_int = src
      product_int : Bits #128
      product_int = (bits_of_int (z-mul (bv-signed #64 dst_int) (bv-signed #64 src_int)) (zpos #128))
      product : Bits #128
      product = product_int
      product_high : Bits #64
      product_high = (bv-slice #128 product #127 #64)
      product_low : Bits #64
      product_low = (bv-slice #128 product #63 #0)
      product_low_int : Bits #64
      product_low_int = product_low
      cf_and_of : Bits #1
      cf_and_of = (bool_to_bits (b-not (weq (bv-sext #64 #128 product_low_int) product_int)))
  in (product_high , product_low , product , cf_and_of)
