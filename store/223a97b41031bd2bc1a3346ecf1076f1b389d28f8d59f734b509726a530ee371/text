-- (2.8)–(2.9) the order of naturals carries its witness (lib/std.cub's le: k with k + m = n), and
-- transitivity is a function: the witnesses add
le-trans : {a b c : Nat} → le a b → le b c → le a c
le-trans {a} {b} {c} p q = (plus (fst q) (fst p) ,
  transN (plus-assoc (fst q) (fst p) a) (transN (congN (plus (fst q)) (snd p)) (snd q)))
