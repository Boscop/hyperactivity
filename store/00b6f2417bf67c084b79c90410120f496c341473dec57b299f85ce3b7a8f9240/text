-- USDC/WETH ERC-4626 vaults + 484-byte `Multicall3.tryAggregate` ABI layout hold by `refl`!
bl-thm-2026-aerov2-morpho-mc3-exact :
  let okMc3  = h-eq (eth-eip55-from-bytes20 (eth-from-hex "ca11bde05977b3631167028862be2a173976ca11")) bl-mc3-adr
      okAcl  = h-eq (eth-eip55-from-bytes20 (eth-from-hex "9cb220581b91b0c83223012fe69688b92ad07a76")) bl-aerov2-cl-fact
      okAvm  = h-eq (eth-eip55-from-bytes20 (eth-from-hex "8e6a9fcd1d638cc760ffba397605fe3355de76d2")) bl-aerov2-vamm-fact
      okMu   = h-eq (eth-eip55-from-bytes20 (eth-from-hex "1deefabee758aabdc29a542b24ca3b75afd56765")) bl-morpho-usdc-vlt
      okMw   = h-eq (eth-eip55-from-bytes20 (eth-from-hex "fefec33668e22677c4762d0853d56245a800ff08")) bl-morpho-weth-vlt
      cd36   = list-append (cons #112 (cons #160 (cons #130 (cons #49 nil)))) (eth-word-be32 #0)
      enc2   = bl-encode-mc3-36 #1 (cons (eth-founder-coinbase-addr20 , cd36) (cons (eth-founder-coinbase-addr20 , cd36) nil))
  in andB okMc3 (andB okAcl (andB okAvm (andB okMu (andB okMw (%weq (fromNat (list-length enc2)) #484))))) ≡ true
bl-thm-2026-aerov2-morpho-mc3-exact = refl
