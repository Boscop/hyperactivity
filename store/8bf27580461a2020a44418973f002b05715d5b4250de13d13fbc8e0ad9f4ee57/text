rev-bwd-zero-tape-aux : List Word → RevPair → RevPair → RevBwdAcc
rev-bwd-zero-tape-aux nil yFinal gOut = rbacc yFinal nil gOut
rev-bwd-zero-tape-aux (cons w ws) yFinal gOut =
  case rev-bwd-zero-tape-aux ws yFinal gOut of
    rbacc yAfter dws gNext →
      case gNext of
        rpair gy1 gy2 →
          case rev-bwd-1 w yAfter of
            rpair u v →
              rbacc (rpair u v) (cons (%wmul v gy2) dws) (rpair gy2 (%wadd gy1 (%wmul w gy2)))
