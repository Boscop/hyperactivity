nk-split-denotes : (rho : NkW → NkEv) (e : NkEnv) (o : NkOut) →
  (nk-ebound e (nk-n o) ≡ true) →
  (nk-env-ev (nk-rho-split rho e o) (nk-sa (nk-split e o)) ≡ nk-env-ev rho e)
  × (nk-env-ev (nk-rho-split rho e o) (nk-sb (nk-split e o)) ≡ nk-env-ev rho e)
nk-split-denotes rho nke-nil o hb = (refl , refl)
nk-split-denotes rho (nke-cons w r) o hb =
  let hw = nk-and-l (nk-wire-lt w (nk-n o)) (nk-ebound r (nk-n o)) hb
      hr = nk-and-r (nk-wire-lt w (nk-n o)) (nk-ebound r (nk-n o)) hb
      bds = nk-split-bounds r o
      ih = nk-split-denotes rho r o hr
  in nk-split-cons-denotes rho (nk-rho-split rho r o) w r (nk-split r o)
       (nk-rho-split-below rho r o w hw)
       (fst (snd bds)) (snd (snd bds)) (fst ih) (snd ih)
