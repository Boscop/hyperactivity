cmap-id-d : (sk : Lst Entry) (X : Type 1) (F : X → Type 1) (c : Cube (dims sk) X) (d : DCube (dims sk) X F c) →
  PathP (λ i → DCube (dims sk) X F (cmap-id sk X c i)) (cmap-d sk sk (cmap-of sk sk (λ k → k)) X F c d) d
cmap-id-d lnil X F c d = λ i → d
cmap-id-d (lcons (e-ty s) sk) X F c d =
  pcat-d (Cube (dims sk) X) (DCube (dims sk) X F)
    (cmap-cube (lcons (e-ty s) sk) (lcons (e-ty s) sk) (cmap-of (lcons (e-ty s) sk) (lcons (e-ty s) sk) (λ k → k)) X c)
    (cmap-cube sk sk (cmap-of sk sk (λ k → k)) X c) c (cmap-skip (e-ty s) sk sk (λ k → k) X c) (cmap-id sk X c)
    (cmap-d (lcons (e-ty s) sk) (lcons (e-ty s) sk) (cmap-of (lcons (e-ty s) sk) (lcons (e-ty s) sk) (λ k → k)) X F c d)
    (cmap-d sk sk (cmap-of sk sk (λ k → k)) X F c d) d
    (cmap-skip-d (e-ty s) sk sk (λ k → k) X F c d) (cmap-id-d sk X F c d)
cmap-id-d (lcons e-dim sk) X F c d =
  pcat-d (Cube (suc (dims sk)) X) (DCube (suc (dims sk)) X F)
    (cmap-cube (lcons e-dim sk) (lcons e-dim sk) (cmap-of (lcons e-dim sk) (lcons e-dim sk) (λ k → k)) X c)
    (cmap-cube sk sk (cmap-of sk sk (λ k → k)) (Line X) c) c (cmap-keep e-dim sk sk (λ k → k) X c) (cmap-id sk (Line X) c)
    (cmap-d (lcons e-dim sk) (lcons e-dim sk) (cmap-of (lcons e-dim sk) (lcons e-dim sk) (λ k → k)) X F c d)
    (cmap-d sk sk (cmap-of sk sk (λ k → k)) (Line X) (LineO X F) c d) d
    (cmap-keep-d e-dim sk sk (λ k → k) X F c d) (cmap-id-d sk (Line X) (LineO X F) c d)
