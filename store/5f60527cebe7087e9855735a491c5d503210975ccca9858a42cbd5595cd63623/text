-- (part of language-support)
gpr_xor_spec_8 : (dst' : Bits #64) → (src : Bits #64) → (input_rflags : rflagsbits) → MF ((Bits #64) × rflagsbits × rflagsbits)
gpr_xor_spec_8 dst' src input_rflags =
  let result' : Bits #64
      result' = (bv-slice #64 (logxor #64 dst' src) #63 #0)
      cf' : ZI
      cf' = (zpos #0)
  in bindF {Bits #1} {((Bits #64) × rflagsbits × rflagsbits)} (pf_spec64 result') (λ pf' →
       let zf : Bits #1
           zf = (zf_spec (bv-unsigned #64 result'))
           sf : Bits #1
           sf = (sf_spec64 result')
           of' : ZI
           of' = (zpos #0)
           output_rflags : rflagsbits
           output_rflags =
             (rflagsbits-set-of (rflagsbits-set-sf (rflagsbits-set-zf (rflagsbits-set-pf (rflagsbits-set-cf input_rflags (bits_of_int cf' (zpos #1))) pf') zf) sf) (bits_of_int of' (zpos #1)))
           undefined_flags : rflagsbits
           undefined_flags = (rflagsbits-set-af #0 #1)
       in retF {((Bits #64) × rflagsbits × rflagsbits)} (result' , output_rflags , undefined_flags))
