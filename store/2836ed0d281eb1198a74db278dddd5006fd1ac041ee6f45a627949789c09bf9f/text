-- Theorem (Covert stimulus optimizer leaves platform objective unconstrained):
-- State S = Bool × Stim = (platform-aligned-objective , stimulus-shown).
-- Observing only the stimulus `snd` yields zero warrant about the hidden objective `fst = true`
-- for any stimulus u : Stim (Meta FAIR TRIBE v2 / engagement maximization).
covert-optimizer-unconstrained : {Stim : Type} → (u : Stim) →
  Neg (Warrants {Bool × Stim} {Stim} (λ s → snd s) u (λ s → fst s ≡ true))
covert-optimizer-unconstrained u w = true≢false (sym (w ((false , u) , λ i → u)))
