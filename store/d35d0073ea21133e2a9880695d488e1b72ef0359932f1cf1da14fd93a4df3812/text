-- a signed magnitude whose list may be empty, against the value V it stands for, positive (s) or negative
zmag-pos : (l : List Bool) → (V : Nat) → bin-to-nat l ≡ V → zeq (zv (if bin-zero l then bz-zero else (true , l))) (V , zero)
zmag-pos l V = case l return λ m → bin-to-nat m ≡ V → zeq (zv (if bin-zero m then bz-zero else (true , m))) (V , zero) of
  nil → λ p → transN p (symN (plus-zero V))
  cons x r → λ p → transN (plus-zero (bin-to-nat (cons x r))) (transN p (symN (plus-zero V)))
