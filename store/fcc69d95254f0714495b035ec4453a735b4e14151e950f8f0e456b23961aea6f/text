ns-local : {M St : Type} → (P : NodeId → St → Type) → (beh : Beh M St) → LocalInv {M} {St} P beh → (j : NodeId) → (e : Ev M) → (g : FState M St) →
           ((i : NodeId) → P i (fst g i)) → (i : NodeId) → P i (fst (node-step {M} {St} beh j e g) i)
ns-local {M} {St} P beh li j e g h i =
  case nt-bdec (eqb i j) of
    inr ef → subst {lzero} {lzero} {St} {P i} (sym (ns-other {M} {St} i j e g (beh j (fst g j)) ef)) (h i)
    inl et → ns-self {M} {St} (P i) i j e g (beh j (fst g j)) et (h i)
               (subst {lzero} {lzero} {NodeId} {λ y → VOk {M} {St} (P y) (beh j (fst g j))} (sym (eqb-sound {i} {j} (eq→isTrue {eqb i j} et))) (li j (fst g j) (h j)))
