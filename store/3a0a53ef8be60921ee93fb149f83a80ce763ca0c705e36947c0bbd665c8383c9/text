-- atom maps compose, so mass balance is preserved along a composed derivation: if every elementary step
-- carries a map, the overall transformation carries one, and the conservation argument is the composition
-- rather than an induction done by hand. A mechanism is a derivation and its balance is a consequence.
am-comp : (L : Mol) → (M : Mol) → (R : Mol) → AtomMap L M → AtomMap M R → AtomMap L R
am-comp L M R f g =
  ( (λ x → am-fun M R g (am-fun L M f x))
  , (λ z → am-inv-fun L M f (am-inv-fun M R g z))
  , (λ x → concat (cong (am-inv-fun L M f) (am-gf M R g (am-fun L M f x))) (am-gf L M f x))
  , (λ z → concat (cong (am-fun M R g) (am-fg L M f (am-inv-fun M R g z))) (am-fg M R g z))
  , (λ x → concat (am-el M R g (am-fun L M f x)) (am-el L M f x)) )
