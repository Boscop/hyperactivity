-- the turn's words select: each word's forms' lines added at its weight, 3001 less the number of
-- lines holding them (a rare word identifies; one on more than 3000 lines identifies nothing)
c-select : List (List Word) → List (Word × Word) → Proc W (List (Word × Word))
c-select nil acc = ret acc
c-select (cons w r) acc = bind (c-forms w) (λ fs → bind (c-count-of fs) (λ n →
  if orB (weq n #0) (wlt #3000 n) then c-select r acc
  else bind (c-lines-forms fs) (λ ls → c-select r (c-merge (wsub #3001 n) acc ls))))
