-- one step of long division of a by b, quotient so far q: subtract c x^k b, c = lead a / lead b
divmod-step : List SQ → List SQ → List SQ → SQ → Nat → (List SQ → List SQ → List SQ → List SQ × List SQ) → List SQ × List SQ
divmod-step a b q c k rec = rec (poly-trim (vec-sub (poly-pad a (poly-shift k b)) (poly-shift k (vec-scale c b)))) b (vec-plus (poly-pad q (poly-shift k (cons c nil))) (poly-shift k (cons c nil)))
