bn-wasm-sleb-go : Nat → Word → List Word
bn-wasm-sleb-go zero    w = cons (%wand w #63) nil
bn-wasm-sleb-go (suc k) w =
  let lo = the Word (%wand w #127)
      hi = the Word (%wshr w #7)
  in if andB (%weq hi #0) (%weq (%wand lo #64) #0)
     then cons lo nil
     else cons (%wor lo #128) (bn-wasm-sleb-go k hi)
