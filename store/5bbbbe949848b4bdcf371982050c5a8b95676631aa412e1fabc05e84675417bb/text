-- the tree's query is the list's: the last element below the key
k-tree : {o : Ord} → (f : Nat) → (l : List (El o)) → Sorted l → (k : El o) → k-pq k (build f l) ≡ k-last k l
k-tree f =
  case f return λ w → (l : List (El o)) → Sorted l → (k : El o) → k-pq k (build w l) ≡ k-last k l of
    zero → λ l s k → k-spine k l
    suc g → λ l → k-build-at (build g) (rec g) (half (list-length l)) l
