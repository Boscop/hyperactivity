-- Executable bottom-up algebraic + MC=1 + ANF contractor on arbitrary WExpr trees!
ha-contract : WExpr → WExpr
ha-contract (we-k b)       = we-k b
ha-contract (we-v i)       = we-v i
ha-contract (we-not a)     = we-xor (ha-contract a) (we-k true)
ha-contract (we-xor a b)   = ha-mk-xor (ha-contract a) (ha-contract b)
ha-contract (we-and a b)   = ha-mk-and (ha-contract a) (ha-contract b)
ha-contract (we-or  a b)   = let a' = ha-contract a in let b' = ha-contract b in we-xor (we-xor a' b') (we-and a' b')
ha-contract (we-ch  e f g) = let e' = ha-contract e in let f' = ha-contract f in let g' = ha-contract g in we-xor g' (we-and e' (we-xor f' g'))
ha-contract (we-maj a b c) = let a' = ha-contract a in let b' = ha-contract b in let c' = ha-contract c in we-xor a' (we-and (we-xor a' b') (we-xor a' c'))
