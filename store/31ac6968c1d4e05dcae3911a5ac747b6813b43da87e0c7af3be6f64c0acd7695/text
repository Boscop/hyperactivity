-- (if b then x else true) = false gives b = true and x = false
sy-ite-false : (b x : Bool) → (if b then x else true) ≡ false → (b ≡ true) × (x ≡ false)
sy-ite-false b x = case b return λ w → (if w then x else true) ≡ false → (w ≡ true) × (x ≡ false) of
  true → λ h → ((λ i → true) , h)
  false → λ h → absurd-tf ((false ≡ true) × (x ≡ false)) h
