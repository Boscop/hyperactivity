logo-htree-build : Nat → Bool → Word → Word → List Word
logo-htree-build depth isFav coreSw horizonOp =
  let pL : Cx
      pL = (sn #3000 , si-zero)
      pR : Cx
      pR = (sp #3000 , si-zero)
      branchSw = if isFav then wquot (wmul coreSw #95) #100 else wquot (wmul coreSw #92) #100
      leftTree = htree-branch depth isFav pR pL #4400 branchSw #100
      rightTree = htree-branch depth isFav pL pR #4400 branchSw #100
      bridge = geo-path-svg pL pR #4 (wquot (wmul coreSw #112) #100) #100
      cL = cx-to-px pL
      cR = cx-to-px pR
      dotR = lg-tenths (wquot (wmul coreSw #56) #100)
      dots = lg-concat (cons "<circle cx='" (cons (lg-tenths (fst cL)) (cons "' cy='" (cons (lg-tenths (snd cL)) (cons "' r='" (cons dotR (cons "' fill='#fff'/><circle cx='" (cons (lg-tenths (fst cR)) (cons "' cy='" (cons (lg-tenths (snd cR)) (cons "' r='" (cons dotR (cons "' fill='#fff'/>" nil)))))))))))))
      ring : List Word
      ring = if weq horizonOp #0 then nil
             else lg-concat (cons "<circle cx='128' cy='128' r='113.8' fill='none' stroke='#fff' stroke-width='1.5' opacity='" (cons (lg-op horizonOp) (cons "'/>" nil)))
  in lg-concat (cons "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 256 256' width='256' height='256'><rect width='256' height='256' fill='#ff0a94'/>"
       (cons ring (cons leftTree (cons rightTree (cons bridge (cons dots (cons "</svg>" nil)))))))
