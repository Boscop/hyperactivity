-- ---------------------------------------------------------------- frames
rm-has-live-s : List RStmt → Word → Bool
rm-has-live-s nil l = false
rm-has-live-s (cons s ss) l = case s of
  rs-storage-live l2 → (case weq l l2 of
    true → true
    false → rm-has-live-s ss l)
  rs-storage-dead l2 → rm-has-live-s ss l
  rs-assign p rv → rm-has-live-s ss l
