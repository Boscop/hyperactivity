gpr_sbb_spec_4 : (dst' : Bits #32) → (src : Bits #32) → (input_rflags : rflagsbits) → MF ((Bits #32) × rflagsbits × rflagsbits)
gpr_sbb_spec_4 dst' src input_rflags =
  let input_cf : Bits #1
      input_cf = (rflagsbits-cf input_rflags)
      signed_raw_result : Bits #34
      signed_raw_result = (bits_of_int (z-sub (bv-signed #32 dst') (bv-signed #33 (bits_of_int (z-add (bv-signed #32 src) (bv-unsigned #1 input_cf)) (zpos #33)))) (zpos #34))
      result' : Bits #32
      result' = (bv-trunc #34 #32 signed_raw_result)
      cf' : Bits #1
      cf' = (bool_to_bits (z-lt (bv-unsigned #32 dst') (bv-unsigned #33 (bits_of_int (z-add (bv-unsigned #1 input_cf) (bv-unsigned #32 src)) (zpos #33)))))
  in bindF {Bits #1} {((Bits #32) × rflagsbits × rflagsbits)} (pf_spec32 result') (λ pf' →
       let af : Bits #1
           af = (sbb_af_spec32 dst' src input_cf)
           zf : Bits #1
           zf = (zf_spec (bv-unsigned #32 result'))
           sf : Bits #1
           sf = (sf_spec32 result')
       in bindF {Bits #1} {((Bits #32) × rflagsbits × rflagsbits)} (of_spec32 (bv-trunc #34 #33 signed_raw_result)) (λ of' →
            let output_rflags : rflagsbits
                output_rflags = (rflagsbits-set-of (rflagsbits-set-sf (rflagsbits-set-zf (rflagsbits-set-af (rflagsbits-set-pf (rflagsbits-set-cf input_rflags cf') pf') af) zf) sf) of')
                undefined_flags : rflagsbits
                undefined_flags = #0
            in retF {((Bits #32) × rflagsbits × rflagsbits)} (result' , output_rflags , undefined_flags)))
