-- transitivity of ≤: a ≤ b and b ≤ c implies a ≤ c
cm-le-trans-step : (a : Word) → ((b c : Word) → ltw b a ≡ false → ltw c b ≡ false → ltw c a ≡ false) →
                   (b c : Word) → ltw b (%wsucc a) ≡ false → ltw c b ≡ false → ltw c (%wsucc a) ≡ false
cm-le-trans-step a ih b =
  %welimP (λ v → (c : Word) → ltw v (%wsucc a) ≡ false → ltw c v ≡ false → ltw c (%wsucc a) ≡ false) b
    (λ c h1 h2 → cm-tf-absurd h1)
    (λ b1 gb c →
       %welimP (λ v → ltw (%wsucc b1) (%wsucc a) ≡ false → ltw v (%wsucc b1) ≡ false → ltw v (%wsucc a) ≡ false) c
         (λ h1 h2 → cm-tf-absurd h2)
         (λ c1 gc h1 h2 → ih b1 c1 h1 h2))
