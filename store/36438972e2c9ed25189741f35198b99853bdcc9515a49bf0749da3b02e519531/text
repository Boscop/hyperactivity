-- the arithmetic of an exact division with a nonnegative dividend: M = Q·D + R with R = 0 makes (Q, 0)·(D, 0) the integer (M, 0)
in-ex-pos : (M Q D R : Nat) → M ≡ plus (times Q D) R → R ≡ zero → plus (plus (times Q D) zero) zero ≡ plus M (plus (times Q zero) zero)
in-ex-pos M Q D R h hr = transN (transN (plus-zero (plus (times Q D) zero)) (plus-zero (times Q D))) (symN (transN (congN (λ z → plus M z) (transN (plus-zero (times Q zero)) (times-zero Q))) (transN (plus-zero M) (transN h (transN (congN (λ z → plus (times Q D) z) hr) (plus-zero (times Q D)))))))
