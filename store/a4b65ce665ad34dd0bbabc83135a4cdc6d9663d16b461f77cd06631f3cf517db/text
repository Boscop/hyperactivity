-- Two nets assigned to distinct horizontal M1 channel tracks NEVER short-circuit at any X coordinate!
channel-no-m1-short : (yTrk1 yTrk2 x1 x2 : Nat) →
  (yTrk1 ≡ yTrk2 → Empty) →
  Path Point3D (m1-horiz , (x1 , yTrk1)) (m1-horiz , (x2 , yTrk2)) → Empty
channel-no-m1-short yTrk1 yTrk2 x1 x2 neq h =
  neq (λ i → snd (snd (h i)))
