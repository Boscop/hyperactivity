-- ---------------------------------------------------------------- the coupling 4 J_I·J_K, I ≠ K
-- its entry from monomial s to monomial t: (2s_I − d_I)(2s_K − d_K) on the diagonal, 2 s_K (d_I − s_I) where t
-- raises I and lowers K, 2 s_I (d_K − s_K) where t lowers I and raises K
pair-entry : List Nat → Nat → Nat → List Nat → List Nat → SQ
pair-entry ds i k t s =
  if exp-eq t s then sq-diffs (times 2 (exp-at i s)) (exp-at i ds) (times 2 (exp-at k s)) (exp-at k ds)
  else (if exp-eq t (exp-up i (exp-down k s)) then (if eqb (exp-at k s) zero then sq-zero else sq-nat (times 2 (times (exp-at k s) (monus (exp-at i ds) (exp-at i s)))))
  else (if exp-eq t (exp-down i (exp-up k s)) then (if eqb (exp-at i s) zero then sq-zero else sq-nat (times 2 (times (exp-at i s) (monus (exp-at k ds) (exp-at k s)))))
  else sq-zero))
