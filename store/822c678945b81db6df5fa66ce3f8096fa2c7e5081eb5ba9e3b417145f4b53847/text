-- 2. Transposed Column-Tile Access (fixed col c, parallel rows r1, r2): equal banks implies r1 ≡ r2!
col-bank-conflict-free : (w : Nat) → (c r1 r2 : Vec Bool w) →
  swz-bank w r1 c ≡ swz-bank w r2 c → r1 ≡ r2
col-bank-conflict-free w c r1 r2 h =
  row-bank-conflict-free w c r1 r2
    (catV w (bv-xor w c r1) (bv-xor w r1 c) (bv-xor w c r2)
      (bv-xor-comm w c r1)
      (catV w (bv-xor w r1 c) (bv-xor w r2 c) (bv-xor w c r2)
        h
        (bv-xor-comm w r2 c)))
