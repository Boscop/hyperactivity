-- at the end of main: the bytes allocated, on the error stream, when HY_STATS is set
ce-stats : List Word
ce-stats = list-append "if (getenv(" (list-append (cons #34 nil) (list-append "HY_STATS" (list-append (cons #34 nil) (list-append ")) { fprintf(stderr, " (list-append (cons #34 nil) (list-append "bytes %llu" (list-append (cons #34 nil) ", (unsigned long long)hy_bytes); fputc(10, stderr); } ")))))))
