a64-nat-case : Enc → XEnv → Word → Lst Code → Code → Lst Word
a64-nat-case ce env d B x =
  let bz = ce env (%wsucc d) (l-at (cwlit #0) B #0)
      bs = xcat4 (a64-ld-fp #0 (a64-slot d)) (l-app (a64-movz #9 #1 #0) (a64-sub #0 #0 #9)) a64-push-x0
                 (l-app (ce (lcons (a64-slot (%wsucc d)) env) (%wadd d #2) (x-strip #1 (l-at (cwlit #0) B #1))) (a64-drop-slots #1))
      zpart = l-app bz (a64-b-skip (l-count bs))
  in xcat5 (ce env d x) a64-push-x0
           (xcat3 (a64-movz #9 #0 #0) (a64-cmp #0 #9) (a64-bcond-skip a64-cc-ne (l-count zpart)))
           (l-app zpart bs) (a64-drop-slots #1)
