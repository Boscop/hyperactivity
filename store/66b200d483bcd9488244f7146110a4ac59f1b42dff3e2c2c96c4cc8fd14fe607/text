go-below32 : (n : Nat) → (f : Fin n → UInt32) → (m j : Nat) → (h : le m n) → (hj : le (suc j) n) → (a : Array32 n) → le (suc j) m → index32 n (tabF-go32 n f m h a) j hj ≡ f (j , hj)
go-below32 n f zero j h hj a l = Empty-rec (le-suc-zero j l)
go-below32 n f (suc m) j h hj a l =
  case le-split j m l of
    inl l2 → go-below32 n f m j (le-pred m n h) hj (update32 n a m h (f (m , h))) l2
    inr e → concat (go-above32 n f m j (le-pred m n h) hj (update32 n a m h (f (m , h))) (subst {lzero} {lzero} {Nat} {λ x → le m x} {m} {j} (sym {lzero} {Nat} {j} {m} e) (le-refl m)))
                   (go-below-last32 n f m j h hj a e)
