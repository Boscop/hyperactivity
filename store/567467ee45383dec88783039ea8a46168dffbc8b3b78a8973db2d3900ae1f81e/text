-- lead-byte guard (`x == 32` for " Known (", `x == 81` for "Question for Avik (") keeps tail linear on >85% / >99% of bytes
v-known-rest : List Word → Bool
v-known-rest r = andB (h-prefix "Known (" r) (andB (v-digits (h-take (toNat #4) (h-drop "Known (" r))) (orB (h-prefix "," (h-drop-n (toNat #17) r)) (h-prefix ")" (h-drop-n (toNat #17) r))))
