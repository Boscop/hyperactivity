vocab-add-keep : (t x : List Word) → (vs : List (List Word)) → InVocab vs x → InVocab (vocab-add t vs) x
vocab-add-keep t x vs hx =
  (case find-tok t vs return (λ o → InVocab (case o of some _ → vs; none → cons t vs) x) of
     some _ → hx
     none →
       ifP {λ b → (idx : Word) × ((if b then some #0 else (case find-tok x vs of some k → some (%wsucc k); none → none)) ≡ some idx)} {wlist-eq x t}
         (λ e → (#0 , refl))
         (λ e → (%wsucc (fst hx) , λ i → case snd hx i of some k → some (%wsucc k); none → none)))
