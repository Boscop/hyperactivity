-- 1. Exact Credit Conservation: escrow + solver balance is invariant under every clear or reject.
pouw-conserved-at : {E : Type} → (b : Bool) → (ext : Pool E) → (st : PouwState E) →
  pouw-total (pouw-step b ext st) ≡ pouw-total st
pouw-conserved-at true ext st = refl
pouw-conserved-at false ext st = refl
