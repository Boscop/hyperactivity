-- a field with the class it is a member of, by the field's id alone (ids are unique in a unit)
cx-field-in : List CField → Word → CRecord → MRes (CRecord × CField) → MRes (CRecord × CField)
cx-field-in nil i r other = other
cx-field-in (cons f fs) i r other = case weq (cx-fld-id f) i of
  true → mok (r , f)
  false → cx-field-in fs i r other
