cos-main : List (List Word) → Step W Word
cos-main args =
  let p  = cos-pref args
      sf = list-append p "_v80_inet.sv"
      cf = list-append p "_cosmos.c"
      mf = list-append p "_cosmos.metal"
      hf = list-append p "_cosmos_host.m"
      jf = list-append p "_geodesic.json"
  in scmd w-now (λ t0 →
     scmd (w-file-write-named sf cos-sv-src) (λ bs →
     scmd (w-file-write-named cf cos-c-src) (λ bc →
     scmd (w-file-write-named mf cos-metal-src) (λ bm →
     scmd (w-file-write-named hf (cos-host-src mf)) (λ bh →
     scmd (w-file-write-named jf cos-geodesic-json) (λ bj →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-COSMOS (28th Engine) | V80=8192-tiles(477K-LUT-free) | 4096-Topo=126->45->12 | CBF=Proved | SV="
       (list-append (ce-dec bs)
       (list-append "B C11=" (list-append (ce-dec bc)
       (list-append "B Metal=" (list-append (ce-dec bm)
       (list-append "B Host=" (list-append (ce-dec bh)
       (list-append "B Geodesic=" (list-append (ce-dec bj)
       (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)")))))))))))))
       (sdone #0))))))))

cos-c : List Word
cos-c = emit-c-cli-opt (code cos-main)
