-- ---------------------------------------------------------------- 3. cross-peer boundary wires & hash-consed sub-nets
-- A frame transmitted across a boundary wire when an active port meets RemotePort(peer, wire):
data WireFrame (K : Type) (V : Type)
  = wf-era
  | wf-con (tag : Nat) (aux1 : WireId) (aux2 : WireId)
  | wf-ref (key : K) (arg : WireId) (payload : Sum Unit V)
