data CgmRewrite : Type where
  cgm-rw-ann : CgmRewrite
  cgm-rw-com : CgmRewrite
  cgm-rw-era : CgmRewrite

cgm-classify-redex : Word → Word → CgmRewrite
cgm-classify-redex a b =
  if orB (weq a #0) (weq b #0) then cgm-rw-era
  else if weq a b then cgm-rw-ann
  else cgm-rw-com

cgm-thm-annihilate-dual : cgm-classify-redex #1 #1 ≡ cgm-rw-ann
cgm-thm-annihilate-dual = refl

cgm-thm-commute-distinct : cgm-classify-redex #1 #2 ≡ cgm-rw-com
cgm-thm-commute-distinct = refl

cgm-thm-erase-ground : cgm-classify-redex #0 #2 ≡ cgm-rw-era
cgm-thm-erase-ground = refl

cgm-contains : List Word → List Word → Bool
cgm-contains pat nil = h-null pat
cgm-contains pat (cons x xs) =
  if h-prefix pat (cons x xs) then true else cgm-contains pat xs

cgm-ln : List Word → List Word → List Word
cgm-ln s rest = list-append s (cons #10 rest)

