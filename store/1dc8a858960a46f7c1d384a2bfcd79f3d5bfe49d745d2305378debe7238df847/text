fiber-with-esc-pos : (e : Word × Word) → (r : FTbl) → (y C f : Word) →
                     ftbl-find #0 y (fiber-with-esc e r) ≡ some (C , f) → wlt #0 f ≡ true
fiber-with-esc-pos e r y C f =
  ifP {λ b → (if b then some (#0 , fromNat (suc (list-length r)))
              else ftbl-find (wadd #0 (fromNat (suc (list-length r)))) y (ftbl-shift-pos (cons e r))) ≡ some (C , f) →
             wlt #0 f ≡ true} {weq y #0}
    (λ _ h →
       let pf : fromNat (suc (list-length r)) ≡ f
           pf = λ i → snd (cm-some-inj h i)
       in cm-catb (cm-congb (λ z → wlt #0 z) (symw pf)) (cm-lt-zero-suc (list-length r)))
    (λ _ h → ftbl-find-shift-pos (cons e r) (wadd #0 (fromNat (suc (list-length r)))) y C f h)
