eig-loop1 : SQ → VM → VM → VM → List SQ → List SQ → List SQ → Nat → Bool → Nat → Bool → Nat → List Nat → Rows → List (List (List PRad)) → List (List (List PRad))
eig-loop1 w a1 a2 aP mus es1 es2 k sn n sm m dsP xs0 acc = case mus of
  nil → acc
  cons mu1 rest → eig-loop1 w a1 a2 aP rest es1 es2 k sn n sm m dsP xs0 (if sq-nz mu1 then eig-loop2 w a1 a2 aP mu1 es1 es2 es2 k sn n sm m dsP xs0 acc else acc)
