-- a node of the second ring stands on the side of the first node of the first ring it neighbours
hi-h2 : List (List (List Word)) → List Word → List (List Word) → List Word → List Word
hi-h2 rows f nil n = "0"
hi-h2 rows f (cons m r) n = if h-has n (hi-around rows m) then hi-h rows f m else hi-h2 rows f r n
