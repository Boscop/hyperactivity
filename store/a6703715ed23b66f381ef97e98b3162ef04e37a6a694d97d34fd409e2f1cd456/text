base-ok : (t : List (List Word)) → DblInv t (suc zero) (ranks-of {suffix-ord} (list-map (take-n (suc zero)) (sufs t)))
base-ok t =
  let k = list-map (take-n (suc zero)) (sufs t)
      tk = key-tree {suffix-ord} k
  in ( (λ s → rk {suffix-ord} tk (take-n (suc zero) s))
     , map-map (rk {suffix-ord} tk) (take-n (suc zero)) (sufs t)
     , (λ s s' m m' → rank-prop {suffix-ord} k (take-n (suc zero) s) (take-n (suc zero) s') (mem-map {suffix-ord} {suffix-ord} (take-n (suc zero)) s' (sufs t) m'))
     , (λ s → rank-pos {suffix-ord} tk (take-n (suc zero) s)) )
