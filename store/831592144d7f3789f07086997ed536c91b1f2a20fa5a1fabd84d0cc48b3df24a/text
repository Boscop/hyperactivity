tr-cat : List (List Word) → List Word
tr-cat nil = nil
tr-cat (cons s r) = list-append s (tr-cat r)

tr-nl : List Word
tr-nl = cons #10 nil

tr-q : List Word
tr-q = cons #34 nil

tr-ln : List Word → List Word
tr-ln s = list-append s tr-nl

tr-json-str : List Word → List Word
tr-json-str s = tr-cat (cons tr-q (cons s (cons tr-q nil)))

