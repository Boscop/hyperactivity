-- the number of nodes of a body: the measure of what a step of normalizing has to read
nk-size : NkTm → Word
nk-size (nk-lam b) = %wsucc (nk-size b)
nk-size (nk-con c as) = %wsucc (nk-size as)
nk-size (nk-op h p as) = %wsucc (%wadd (nk-size p) (nk-size as))
nk-size (nk-match h p cs) = %wsucc (%wadd (nk-size p) (nk-size cs))
nk-size (nk-cons t r) = %wadd (nk-size t) (nk-size r)
nk-size t = #1
