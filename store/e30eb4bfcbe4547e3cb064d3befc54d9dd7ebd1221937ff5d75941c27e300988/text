tech-map-2-sound : {V : Type} → (env : V → Bool) → (b : B2) → (tx ty : NandCirc V) → (vx vy : Bool) →
  fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env tx ≡ vx →
  fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env ty ≡ vy →
  fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env (tech-map-2 b tx ty) ≡ snd (snd bool-alg) b vx vy
tech-map-2-sound {V} env b2-and tx ty vx vy hx hy =
  let nx = fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env tx
      ny = fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env ty
  in catB (nand2 (nand2 nx ny) (nand2 nx ny)) (nand2 (nand2 vx vy) (nand2 vx vy)) (andB vx vy)
       (λ i → nand2 (nand2 (hx i) (hy i)) (nand2 (hx i) (hy i)))
       (nand-and-law vx vy)
tech-map-2-sound {V} env b2-or tx ty vx vy hx hy =
  let nx = fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env tx
      ny = fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env ty
  in catB (nand2 (nand2 nx nx) (nand2 ny ny)) (nand2 (nand2 vx vx) (nand2 vy vy)) (b-or2 vx vy)
       (λ i → nand2 (nand2 (hx i) (hx i)) (nand2 (hy i) (hy i)))
       (nand-or-law vx vy)
tech-map-2-sound {V} env b2-xor tx ty vx vy hx hy =
  let nx = fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env tx
      ny = fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env ty
  in catB
       (nand2 (nand2 nx (nand2 nx ny)) (nand2 (nand2 nx ny) ny))
       (nand2 (nand2 vx (nand2 vx vy)) (nand2 (nand2 vx vy) vy))
       (b-xor2 vx vy)
       (λ i → nand2 (nand2 (hx i) (nand2 (hx i) (hy i))) (nand2 (nand2 (hx i) (hy i)) (hy i)))
       (nand4-xor-law vx vy)
