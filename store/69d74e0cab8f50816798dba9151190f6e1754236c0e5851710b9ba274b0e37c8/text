cs-eval-bool-brs : (Code → CsOptM) → CsBoolBrs → CsOptM → CsOptM
cs-eval-bool-brs ev csbb-none om = csom-none
cs-eval-bool-brs ev (csbb-two tbr fbr) om =
  cs-bind-om om (λ mc →
    case mc return (λ _ → CsOptM) of
      cmv-word w → csom-none
      cmv-pair a b → csom-none
      cmv-bool bc → if bc then ev tbr else ev fbr)
