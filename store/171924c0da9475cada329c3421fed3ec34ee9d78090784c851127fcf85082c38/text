v-json-node : VEnv → List Word → List (List Word) → List Word
v-json-node env n stmt =
  let unp = v-unprefixed n (v-stmt-line stmt) in
  let sk = v-split-known nil unp in
  let lay = v-layer-of n zero (ve-layers env) in
  let done = h-has n (ve-comp env) in
  let open-under = v-filter (λ u → h-has u (ve-leaves env)) (v-look-list n (ve-und env)) in
  j-obj
    (cons (j-field "id" (j-str n)) (cons (j-field "name" (j-str (v-look-word n (ve-sents env))))
    (cons (j-field "questions" (j-strs (v-questions unp)))
    (cons (j-field "parents" (j-strs (v-look-list n (ve-ptab env))))
    (cons (j-field "statement" (j-str (h-trim (v-head sk))))
    (cons (j-field "findings" (j-strs (list-map h-trim (h-tail-lists sk))))
    (cons (j-field "parts" "[]")
    (cons (j-field "state" (j-str (if done then "resolved" else v-state-of env n lay)))
    (cons (j-field "progress" (v-progress env n))
    (cons (j-field "layer" (v-json-layer lay))
    (cons (j-field "unblocks" (j-strs (if h-has n (ve-ready env) then h-sort (v-look-list n (ve-gtab env)) else nil)))
    (cons (j-field "waits" (j-strs (if h-has n (ve-leaves env) then h-sort (v-look-list n (ve-wtab env)) else nil)))
    (cons (j-field "after" (j-strs (v-collect-list n (ve-aft env))))
    (cons (j-field "context" (v-json-context env n))
    (cons (j-field "open" (h-decimal (fromNat (list-length open-under)))) nil)))))))))))))))
