ltn-weaken : (a b : Nat) → ltn a b ≡ true → ltn a (suc b) ≡ true
ltn-weaken a =
  case a return λ y → (b : Nat) → ltn y b ≡ true → ltn y (suc b) ≡ true of
    zero → λ b e i → true
    suc a1 → λ b → (case b return λ z → ltn (suc a1) z ≡ true → ltn (suc a1) (suc z) ≡ true of zero → λ e → Empty-rec (true≢false (sym e)); suc b1 → λ e → rec a1 b1 e)
