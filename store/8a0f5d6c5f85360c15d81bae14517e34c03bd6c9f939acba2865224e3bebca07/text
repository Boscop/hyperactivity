-- w(e, e′) for e′ over the edges from e1: the closed form of ⟨O_ee′⟩ in the state c
form-row : List Cand → List Nat → List Triple → List SQ → Nat → Nat → Nat → List (List Rad)
form-row cs ds ts c e e1 n = case n of
  zero → nil
  suc g → cons (closed-form cs (terms-expect (w-dim ds) (gram ds) c (o-terms e e1 ds ts))) (form-row cs ds ts c e (suc e1) g)
