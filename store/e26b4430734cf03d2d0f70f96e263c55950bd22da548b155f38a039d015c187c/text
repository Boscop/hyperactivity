-- the prefix of that length is common
lcp-common : (xs ys : List (List Word)) → take-n (lcp xs ys) xs ≡ take-n (lcp xs ys) ys
lcp-common xs =
  case xs return λ w → (ys : List (List Word)) → take-n (lcp w ys) w ≡ take-n (lcp w ys) ys of
    nil → λ ys i → nil
    cons a r →
      λ ys →
        case ys return λ v → take-n (lcp (cons a r) v) (cons a r) ≡ take-n (lcp (cons a r) v) v of
          nil → λ i → nil
          cons b s →
            ifP {λ c →
                   take-n (if c then suc (lcp r s) else zero) (cons a r) ≡ take-n (if c then suc (lcp r s) else zero) (cons b s)} {tok-eq a b}
              (λ e →
                 let p = tok-eq-sound a b (eq→isTrue e)
                     q = rec r s
                 in λ i → cons (p i) (q i))
              (λ e i → nil)
