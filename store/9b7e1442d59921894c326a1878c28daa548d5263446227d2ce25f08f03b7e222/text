ground-enc-rem : List Word → Word → (Word × List Word) → Word × List Word
ground-enc-rem rem x st =
  let len = fromNat (list-length rem)
      base = %wsucc len
      s = fst st
      ov = snd st
  in case find-nat-idx x rem of
       some k → (wadd (wmul s base) (fromNat k) , ov)
       none → (wadd (wmul s base) len , cons x ov)
