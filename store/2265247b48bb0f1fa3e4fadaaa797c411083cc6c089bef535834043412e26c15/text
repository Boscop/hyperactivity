nk-step-p : Word → (Lst NkTm × Opt Word) → Lst NkTm × Opt Word
nk-step-p w st =
  let stk = fst st
  in case snd st return (λ _ → Lst NkTm × Opt Word) of
       some op →
         if %weq op #0 then (lcons (nk-var w) stk , none)
         else (if %weq op #1 then (lcons (nk-free w) stk , none)
         else (if %weq op #2 then (lcons (nk-num w) stk , none)
         else (if %weq op #5 then nk-pop1 (nk-con w) stk
         else (if %weq op #6 then nk-pop2 (nk-op w) stk
         else nk-pop2 (nk-match w) stk))))
       none →
         if %weq w #3 then nk-pop1 nk-lam stk
         else (if %weq w #4 then nk-pop1 nk-susp stk
         else (if %weq w #8 then (lcons nk-nil stk , none)
         else (if %weq w #9 then nk-pop2 nk-cons stk
         else (stk , some w))))
