-- where the line is constant everywhere (the face is the end 1) the point is unchanged
nk-transp-step : NkTm → NkTm → NkTm → NkTm
nk-transp-step (nk-lam t) phi a = if nk-con-is phi #11 then a else nk-transp-at t (nk-lam t) phi a
nk-transp-step line phi a = if nk-con-is phi #11 then a else nk-transp line phi a
