    const dark = document.documentElement.classList.contains('dark');
    const bg = dark ? '#000' : '#fff', ink = dark ? '#fff' : '#000', muted = dark ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.14)';
    const pink = '#ff0a94', blue = dark ? '#4da3ff' : '#1a73e8', green = dark ? '#38d388' : '#0d8a4e';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);
    ctx.font = '700 12px ui-monospace, Menlo, monospace';
    const sumC = cred.bal.reduce((a, b) => a + b, 0);
    const sumM = cred.inflight.reduce((a, x) => a + x.q, 0);
    ctx.fillStyle = pink; ctx.fillText(`LOCAL CREDIT INVARIANT: Σc (${sumC}) + Σm (${sumM}) = ${sumC + sumM} ≡ 400 (ZERO GLOBAL SCHEDULER)`, 20, 24);

    // Draw 4 peer balance boxes
    const bw = Math.min(180, (W - 76) / 4), gap = (W - 40 - bw * 4) / 3;
    P_NAMES.forEach((nm, i) => {
      const x = 20 + i * (bw + gap);
      ctx.strokeStyle = blue; ctx.lineWidth = 2; ctx.strokeRect(x, 46, bw, 68);
      ctx.fillStyle = ink; ctx.fillText(nm, x + 12, 70);
      ctx.fillStyle = pink; ctx.font = '800 20px ui-monospace, Menlo, monospace';
      ctx.fillText(String(cred.bal[i]), x + 12, 100);
      ctx.font = '700 12px ui-monospace, Menlo, monospace';
    });

    // Draw in-flight channels + spent receipts
    ctx.fillStyle = blue; ctx.fillText(`IN-FLIGHT CHANNELS m_ij (${cred.inflight.length} pending):`, 20, 146);
    if (!cred.inflight.length) {
      ctx.fillStyle = muted; ctx.fillText('  (no in-flight credit; click any peer transfer above)', 20, 170);
    } else {
      cred.inflight.slice(0, 4).forEach((m, idx) => {
        ctx.fillStyle = green;
        ctx.fillText(`  [receipt #${m.id}] ${P_NAMES[m.from]} ──(${m.q})──▶ ${P_NAMES[m.to]}`, 20, 170 + idx * 22);
      });
    }
    ctx.fillStyle = ink; ctx.fillText(cred.msg, 20, H - 20);
    document.getElementById('credStatus').textContent = `CONSERVED: Σc(${sumC}) + Σm(${sumM}) = ${sumC + sumM} (Δ = 0)`;
    document.getElementById('credMetrics').innerHTML =
      `<div><b>${sumC}</b><span>Held Credit (Σc)</span></div>` +
      `<div><b>${sumM}</b><span>In-Flight Channels (Σm)</span></div>` +
      `<div><b>${cred.spent.size}</b><span>Spent Unique Receipts</span></div>` +
      `<div><b>${cred.replaysBlocked}</b><span>Double-Spends Blocked</span></div>`;
  }
  function allocCred(from, to, q) {
    if (cred.bal[from] < q) { cred.msg = `Refused: ${P_NAMES[from]} only holds ${cred.bal[from]} < ${q} (local precondition).`; drawCred(); return; }
    cred.bal[from] -= q;
    const id = cred.nextId++;
    cred.inflight.push({ id, from, to, q });
    cred.msg = `Allocated receipt #${id}: ${P_NAMES[from]} moved ${q} into channel m → ${P_NAMES[to]}.`;
    drawCred();
  }
  document.getElementById('credSendAB').onclick = () => allocCred(0, 1, 40);
  document.getElementById('credSendBC').onclick = () => allocCred(1, 2, 25);
  document.getElementById('credSendCA').onclick = () => allocCred(2, 3, 30);
  document.getElementById('credDeliver').onclick = () => {
    if (!cred.inflight.length) { cred.msg = 'No in-flight receipts to deliver.'; drawCred(); return; }
    const m = cred.inflight.shift();
    cred.spent.add(m.id);
    cred.bal[m.to] += m.q;
    cred.msg = `✓ Delivered receipt #${m.id}: ${P_NAMES[m.to]} received ${m.q}. Receipt #${m.id} permanently marked spent.`;
    drawCred();
  };
  document.getElementById('credReplay').onclick = () => {
    if (!cred.spent.size) { cred.msg = 'Deliver at least one receipt first, then try replaying it!'; drawCred(); return; }
    const lastId = Math.max(...cred.spent);
    cred.replaysBlocked++;
    cred.msg = `✗ REPLAY BLOCKED: receipt #${lastId} already in delivered set! Zero double-spend, zero blockchain needed.`;
    drawCred();
  };
  document.getElementById('credReset').onclick = () => { cred = { bal: [100,100,100,100], inflight: [], spent: new Set(), nextId: 1, msg: 'Reset. Total Σc + Σm = 400.', replaysBlocked: 0 }; drawCred(); };
  new ResizeObserver(drawCred).observe(document.getElementById('credCanvas').parentElement);
  drawCred();

  /* ============================================================ LAB 7: LIVE PoUW ECONOMY SIMULATOR */
  const BOUNTIES = {
    fold: { name: 'De Novo Pocket Binder (E ≤ 11, 0 clashes)', reward: 150, thm: 'lead-binder-globally-optimal', reuse: 'Prunes future docking bounties' },
    comp: { name: 'Exact rANS Renorm Bijection (M | L)', reward: 120, thm: 'sr-renorm-ok + hxz-ft', reuse: 'Shrinks all future wire frames' },
    book: { name: 'C++20 Order Book Volume Conservation', reward: 200, thm: 'hxb-exec-conserves-sample', reuse: 'Certifies zero-audit clearing' },
    chip: { name: '1-Pass FlashAttention 7nm Gate Netlist', reward: 180, thm: 'flash-tiled-hom + cub2silicon', reuse: '119,837× SRAM contraction' }
  };
  let pouw = { bty: 'fold', escrow: 1000, honestBal: 0, halBal: 0, byzBal: 0, settled: [], rounds: 0, rejected: 0, log: [] };
  function drawPoUW() {
    const c = document.getElementById('pouwCanvas'), st = c.parentElement;
    const dpr = Math.min(devicePixelRatio || 1, 2), W = st.clientWidth, H = st.clientHeight;
    c.width = Math.max(1, Math.floor(W * dpr)); c.height = Math.max(1, Math.floor(H * dpr));
    const ctx = c.getContext('2d');
    const dark = document.documentElement.classList.contains('dark');
    const bg = dark ? '#000' : '#fff', ink = dark ? '#fff' : '#000', muted = dark ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.14)';
    const pink = '#ff0a94', blue = dark ? '#4da3ff' : '#1a73e8', green = dark ? '#38d388' : '#0d8a4e';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);
    ctx.font = '700 12px ui-monospace, Menlo, monospace';
    const b = BOUNTIES[pouw.bty];
    const discount = Math.min(50, pouw.settled.length * 12);
    ctx.fillStyle = pink; ctx.fillText(`ACTIVE BOUNTY TYPE T: ${b.name} (${b.reward} cr · Portal Reuse Bonus: -${discount}% cost)`, 20, 24);

    // Three competing agents on left -> Cold Kernel Gate -> Conserved Ledger + Public Store on right
    const agents = [
      { nm: 'Honest Solver (Typed t : T)', bal: pouw.honestBal, col: green, st: pouw.rounds ? '✓ PASSED sg-check-forms → PAID' : 'Ready' },
      { nm: 'Hallucinating AI (Plausible)', bal: pouw.halBal, col: pink, st: pouw.rounds ? '✗ ILL-TYPED → 0 CREDIT' : 'Ready' },
      { nm: 'Byzantine Forger (1-Bit Flip)', bal: pouw.byzBal, col: '#c76b00', st: pouw.rounds ? '✗ DIGEST MISMATCH → REJECTED' : 'Ready' }
    ];
    const lw = Math.min(290, W * 0.38);
    agents.forEach((a, i) => {
      const y = 48 + i * 74;
      ctx.strokeStyle = a.col; ctx.lineWidth = 2; ctx.strokeRect(20, y, lw, 58);
      ctx.fillStyle = ink; ctx.fillText(a.nm, 30, y + 22);
      ctx.fillStyle = a.col; ctx.fillText(`Bal: ${a.bal} cr · ${a.st}`, 30, y + 44);
      // Wire arrow to kernel
      ctx.strokeStyle = a.col; ctx.beginPath(); ctx.moveTo(20 + lw, y + 29); ctx.lineTo(20 + lw + 42, 150); ctx.stroke();
    });

    // Center Cold Kernel Gate
    const kx = 20 + lw + 42, kw = 148;
    ctx.strokeStyle = blue; ctx.lineWidth = 2.5; ctx.strokeRect(kx, 88, kw, 126);
    ctx.fillStyle = blue; ctx.fillText('COLD KERNEL', kx + 26, 114);
    ctx.fillStyle = ink; ctx.fillText('sg-check-forms', kx + 18, 138);
    ctx.fillText('rANS + SHA256', kx + 22, 160);
    ctx.fillStyle = green; ctx.fillText('0 Trust Required', kx + 12, 188);

    // Right: Compounding Public Store & Conserved Supply
    const rx = kx + kw + 30, rw = Math.max(170, W - rx - 20);
    ctx.strokeStyle = pink; ctx.lineWidth = 2; ctx.strokeRect(rx, 48, rw, 206);
    ctx.fillStyle = pink; ctx.fillText('COMPOUNDING STORE', rx + 12, 72);
    ctx.fillStyle = ink; ctx.fillText(`Escrow: ${pouw.escrow} cr`, rx + 12, 98);
    ctx.fillText(`Total Supply: ${pouw.escrow + pouw.honestBal} cr`, rx + 12, 120);
    ctx.fillStyle = green; ctx.fillText(`Settled Artifacts (${pouw.settled.length}):`, rx + 12, 150);
    pouw.settled.slice(-4).forEach((s, i) => {
      ctx.fillStyle = ink; ctx.fillText(`• ${s.slice(0, 22)}`, rx + 12, 174 + i * 20);
    });

    ctx.fillStyle = ink;
    ctx.fillText(pouw.log[pouw.log.length - 1] || 'Click "Run Clearing Round" to simulate competing honest, hallucinating, and forged submissions.', 20, H - 18);
    document.getElementById('pouwStatus').textContent = `Rounds: ${pouw.rounds} · Honest Earned: ${pouw.honestBal} cr · Hallucinations/Forgeries Paid: 0 cr`;
    document.getElementById('pouwMetrics').innerHTML =
      `<div><b>${pouw.honestBal} cr</b><span>Honest Solver Earned</span></div>` +
      `<div><b>0 cr</b><span>Hallucination + Forger Payout</span></div>` +
      `<div><b>${pouw.escrow + pouw.honestBal} cr</b><span>Conserved Total Supply</span></div>` +
      `<div><b>${pouw.settled.length}</b><span>Permanent Store Artifacts</span></div>`;
  }
  document.querySelectorAll('[data-bty]').forEach(b => b.onclick = () => {
    pouw.bty = b.dataset.bty;
    document.querySelectorAll('[data-bty]').forEach(x => x.classList.toggle('on', x === b));
    drawPoUW();
  });
  document.getElementById('pouwRun').onclick = () => {
    const b = BOUNTIES[pouw.bty];
    const pay = Math.min(pouw.escrow, b.reward);
    pouw.rounds++;
    pouw.rejected += 2;
    if (pay > 0) {
      pouw.escrow -= pay;
      pouw.honestBal += pay;
      if (!pouw.settled.includes(b.thm)) pouw.settled.push(b.thm);
      pouw.log.push(`✓ Round ${pouw.rounds}: Honest settled +${pay} cr for ${b.thm}; Hallucinator & Forger got 0 cr! Portal transports artifact.`);
    } else {
      pouw.log.push(`Escrow empty—click Reset Economy to fund new bounties.`);
    }
    drawPoUW();
  };
  document.getElementById('pouwReset').onclick = () => {
    pouw = { bty: pouw.bty, escrow: 1000, honestBal: 0, halBal: 0, byzBal: 0, settled: [], rounds: 0, rejected: 0, log: [] };
    drawPoUW();
  };
  new ResizeObserver(drawPoUW).observe(document.getElementById('pouwCanvas').parentElement);
  drawPoUW();
})();
</script>
</body>
