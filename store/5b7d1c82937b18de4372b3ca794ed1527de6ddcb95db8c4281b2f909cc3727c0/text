-- (part of language-support)
unsigned_byte_p_int : (bits : ZI) → (x' : ZI) → MF Bool
unsigned_byte_p_int bits x' =
  bindF {Unit} {Bool} (fl-assert {exception} (z-le (zpos #0) bits) #149467514486126185021078021591788564786) (λ _ →
    retF {Bool} (b-and (z-le (zpos #0) x') (z-lt x' (z-pow2 bits))))
