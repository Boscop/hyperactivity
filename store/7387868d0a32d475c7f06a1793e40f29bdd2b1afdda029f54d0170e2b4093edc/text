ce-gcall-a : (Code → List Word → List Word) → Word → Word → Word → Lst Code → List Word → List Word
ce-gcall-a pr g ar n as acc =
  if %wlt n ar
    then list-append "hy_clo((uint64_t)w" (list-append (ce-dec g) (list-append ", " (list-append (ce-dec ar) (list-append ", " (list-append (ce-dec n) (list-append ", (uint64_t[]){0" (ce-args-a pr as false (list-append "})" acc))))))))
    else ce-apps-a pr (λ tl → list-append "g" (list-append (ce-dec g) (list-append "(" (ce-args-a pr (ce-take (toNat ar) as) true (list-append ")" tl))))) (ce-drop (toNat ar) as) acc
