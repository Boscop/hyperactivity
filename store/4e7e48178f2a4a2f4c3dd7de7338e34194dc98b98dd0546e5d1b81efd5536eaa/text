fd-specialize-sound : (keep : Nat → Bool) → (pkt : List Nat) → (out : FdFrame) →
  fd-rtl-specialized keep pkt out ≡ fd-filter-post keep (fd-decode (pkt-byte pkt) (list-length pkt) zero out) out
fd-specialize-sound keep pkt out =
  concat (fd-rtl-specialized-eq keep pkt out)
    (λ i → fd-filter-post keep (fd-dual-sound pkt out i) out)
