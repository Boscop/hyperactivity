-- ============================================================================
-- 1. Wilson Plaquette Holonomy → Continuum Field Strength (Zero Trig)
-- ============================================================================
-- Exact rational U(1) unit-circle holonomy: h(φ) = (1 + iφ)/(1 - iφ) = ((1-φ²) + 2iφ)/(1+φ²).
-- Unit-circle norm identity: (1 - φ²)² + (2φ)² = (1 + φ²)².
-- Plaquette magnetic action numerator: (1 + φ²) - (1 - φ²) = 2 φ².
-- Variable (0): φ.
lqg-cayley-u1-unit-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-cayley-u1-unit-poly A ad mu q vs =
  (λ g sub sq →
    let phi = g 0
        q1 = q (fn-q 1 1)
        q2 = q (fn-q 2 1)
        reN = sub q1 (sq phi)
        imN = mu q2 phi
        den = ad q1 (sq phi)
        lhs = ad (sq reN) (sq imN)
        rhs = sq den
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
