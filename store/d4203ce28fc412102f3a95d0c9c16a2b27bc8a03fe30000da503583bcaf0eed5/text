-- THEOREM 10B (LIVE `x402 v2` `PAYMENT-REQUIRED` CHALLENGE PARSER + ECRECOVER SELF-CHECK BY `refl`!):
bn-thm-uni3-and-x402-v2-ecrecover :
  let cd       = bn-encode-eth-to-usdc eth-founder-coinbase-addr20 #10000000000000000 #16000000
      sampleCh = h-concat
                   (cons "HTTP/2 402" (cons bn-nl
                   (cons "payment-required: "
                   (cons (bn-base64-enc
                           (h-concat
                             (cons "{"
                             (cons (bn-jraw "x402Version" "2" ",")
                             (cons (list-append (h-quote "accepts") ":[")
                             (cons (bn-default-accepted-json eth-founder-coinbase-addr20 #2000)
                             (cons "]}" nil)))))))
                   (cons bn-nl nil)))))
      parsed   = bn-parse-x402-402 sampleCh
      signed   = bn-sign-x402-v2 #3 (fst parsed) (fst (snd parsed)) (snd (snd parsed)) #1800000000 "hx-v2-test"
  in andB (h-eq (h-hex bn-uni3-sel4) "04e45aaf")
     (andB (%weq (fromNat (list-length cd)) #228)
     (andB (%weq (snd (snd parsed)) #2000)
     (andB (h-eq (fst (snd parsed)) eth-founder-coinbase-addr20)
           (fst signed)))) ≡ true
bn-thm-uni3-and-x402-v2-ecrecover = refl
