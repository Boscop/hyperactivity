-- ---------------------------------------------------------------- applied writes stay applied
kvl-rep-mono-recv : (w : KvWrite) → (st : KvRep) → InL {KvWrite} w (r-app st) → (r : Rcv KvMsg) → InL {KvWrite} w (r-app (kv-rep-recv st r))
kvl-rep-mono-recv w st h r-timeout = h
kvl-rep-mono-recv w st h (r-msg from (m-put w2)) = h
kvl-rep-mono-recv w st h (r-msg from (m-ack w2)) = h
kvl-rep-mono-recv w st h (r-msg from (m-get k rid)) = h
kvl-rep-mono-recv w st h (r-msg from (m-val rid v)) = h
