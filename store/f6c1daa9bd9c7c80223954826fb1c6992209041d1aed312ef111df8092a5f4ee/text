-- Univalent Contraction of Extensional k-Input Circuit Semantics to Finite Truth-Table Data!
BoolFnLutEquiv : (k : Nat) → Equiv (Vec Bool k → Bool) (Lut k)
BoolFnLutEquiv k =
  isoToEquiv {lzero} {Vec Bool k → Bool} {Lut k}
    (lut-tabulate k)
    (lut-lookup k)
    (lut-tab-lookup k)
    (λ f → funExt {lzero} {lzero} {Vec Bool k} {Bool}
      {lut-lookup k (lut-tabulate k f)} {f}
      (lut-lookup-tab k f))
