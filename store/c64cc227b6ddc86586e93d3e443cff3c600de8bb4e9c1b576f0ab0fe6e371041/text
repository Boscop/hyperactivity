-- q_IJK = [J_IJ², J_JK²] = [2J_I·J_J, 2J_J·J_K] = [4J_I·J_J, 4J_J·J_K]/4, applied
q-apply : List Nat → Nat → Nat → Nat → Mons → List SQ → List SQ
q-apply ds i j k ms v = vec-scale ((1 , 4) , (0 , 1)) (vec-sub (pair-apply ds i j ms (pair-apply ds j k ms v)) (pair-apply ds j k ms (pair-apply ds i j ms v)))
