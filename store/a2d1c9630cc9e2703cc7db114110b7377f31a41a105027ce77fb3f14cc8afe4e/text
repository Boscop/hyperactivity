  const workletCode = `
    class HyperWaveProcessor extends AudioWorkletProcessor {
      constructor() {
        super();
        this.N = 16;
        this.q = new Float32Array(16);
        this.p = new Float32Array(16);
        this.adj = Array.from({length:16}, () => []);
        this.params = { topo:'string', exc:'pluck', k:0.24, w:0.22, gamma:0.0024, alpha:0.06, modal:0.25, freq:220 };
        this.bowVel = 0; this.bowDecay = 0;
        this.modalZ = new Float32Array(6); this.modalV = new Float32Array(6);
        this.scope = new Float32Array(256); this.scIdx = 0; this.tick = 0;
        this.buildTopology('string');
        this.port.onmessage = (e) => {
          const d = e.data;
          if (d.type === 'param') {
            const oldTopo = this.params.topo;
            Object.assign(this.params, d.v);
            if (d.v.topo && d.v.topo !== oldTopo) this.buildTopology(d.v.topo);
          } else if (d.type === 'excite') {
            this.excite(d.freq || this.params.freq, d.vel || 0.9, d.node || 0);
          } else if (d.type === 'reset') {
            this.q.fill(0); this.p.fill(0); this.modalZ.fill(0); this.modalV.fill(0);
          } else if (d.type === 'bridge') {
            this.adj[0].push(8); this.adj[8].push(0); this.adj[3].push(12); this.adj[12].push(3);
          }
        };
      }
      buildTopology(topo) {
        this.adj = Array.from({length:16}, () => []);
        const add = (a,b) => { if (!this.adj[a].includes(b)) { this.adj[a].push(b); this.adj[b].push(a); } };
        if (topo === 'string') {
          for (let i=0;i<15;i++) add(i,i+1);
        } else if (topo === 'plate') {
          for (let r=0;r<4;r++) for (let c=0;c<4;c++) {
            const id = r*4+c;
            if (c<3) add(id, id+1);
            if (r<3) add(id, id+4);
          }
        } else if (topo === 'room') {
          for (let i=0;i<16;i++) { add(i,(i+1)%16); add(i,(i+4)%16); add(i,(i+7)%16); }
        } else if (topo === 'fhn') {
          for (let i=0;i<4;i++) add(i,(i+1)%4);
        } else if (topo === 'petersen') {
          // 10-node Petersen graph + 6 harmonic resonator satellites
          const pe = [[0,1],[1,2],[2,3],[3,4],[4,0],[5,7],[7,9],[9,6],[6,8],[8,5],[0,5],[1,6],[2,7],[3,8],[4,9]];
          pe.forEach(([a,b]) => add(a,b));
          for (let i=10;i<16;i++) add(i, i-10);
        }
      }
      excite(freq, vel, node) {
        this.params.freq = freq;
        const idx = Math.max(0, Math.min(15, node|0));
        const exc = this.params.exc;
        if (exc === 'pluck') {
          this.q[idx] += vel * 0.55;
          if (idx+1 < 16) this.q[idx+1] += vel * 0.35;
        } else if (exc === 'hammer') {
          this.p[idx] += vel * 0.28;
          if (idx+2 < 16) this.p[idx+2] -= vel * 0.14;
        } else if (exc === 'bow' || exc === 'reed') {
          this.bowVel = vel * 0.16; this.bowDecay = 0.99985;
          this.p[idx] += vel * 0.18;
        }
        // Also excite modal bank
        for (let m=0;m<6;m++) this.modalV[m] += vel * 0.16 / (m+1);
      }
      process(inputs, outputs) {
        const out = outputs[0][0];
        const outR = outputs[0][1] || out;
        const inp = (inputs[0] && inputs[0][0]) ? inputs[0][0] : null;
        const sr = sampleRate || 48000;
        const om = 2 * Math.PI * this.params.freq / sr;
        const kEff = Math.min(0.85, om * om * (1 + this.params.k * 2.2));
        const wEff = Math.min(0.45, this.params.w * (0.2 + om * 1.4));
        const g = this.params.gamma;
        const alpha = this.params.alpha;
        const modalMix = this.params.modal;
        const damp = (1 - g) / (1 + g);
        const q = this.q, p = this.p, adj = this.adj;
        let energy = 0;

        for (let s=0; s<out.length; s++) {
          const micF = inp ? inp[s] * 0.55 : 0;
          // Bowed stick-slip / reed nonlinear forcing
          let excF = micF;
          if (this.bowDecay > 0.001 && Math.abs(this.bowVel) > 1e-4) {
            const dv = p[0] - this.bowVel;
            excF += -0.06 * dv * Math.exp(-8 * dv * dv);
            this.bowVel *= this.bowDecay;
          }
          // Symplectic Störmer-Verlet step on Port-Hamiltonian Graph Laplacian
          for (let i=0;i<16;i++) {
            let lap = 0;
            const nb = adj[i];
            for (let j=0;j<nb.length;j++) lap += (q[i] - q[nb[j]]);
            const qi = q[i];
            const nl = alpha * qi * qi * qi;
            const fExt = (i === 0 ? excF : (i === 5 ? micF * 0.4 : 0));
            const force = kEff * qi + wEff * lap + nl - fExt;
            p[i] = damp * (p[i] - force);
          }
          let mixL = 0, mixR = 0;
          for (let i=0;i<16;i++) {
            q[i] += p[i];
            // Soft energy limiter strictly preserving finite bounds
            if (q[i] > 2.5) { q[i] = 2.5; p[i] *= -0.5; }
            else if (q[i] < -2.5) { q[i] = -2.5; p[i] *= -0.5; }
            if ((i & 1) === 0) mixL += q[i]; else mixR += q[i];
          }
          // Analytical Modal Eigenmode Cross-Synthesis Bank (driven by node 0 + mic)
          let modSum = 0;
          if (modalMix > 0.005) {
            const drv = (q[0] * 0.04 + micF * 0.25);
            for (let m=0;m<6;m++) {
              const fm = om * (m + 1) * (this.params.topo === 'petersen' ? (1 + m * 0.17) : 1);
              const km = Math.min(0.9, fm * fm);
              this.modalV[m] = (1 - g * (1 + m * 0.6)) * (this.modalV[m] - km * this.modalZ[m] + drv / (m + 1));
              this.modalZ[m] += this.modalV[m];
              modSum += this.modalZ[m] / (m + 1);
            }
          }
          const yL = Math.tanh((mixL * 0.18) * (1 - modalMix * 0.5) + modSum * modalMix * 0.35);
          const yR = Math.tanh((mixR * 0.18) * (1 - modalMix * 0.5) + modSum * modalMix * 0.35);
          out[s] = yL;
          if (outR !== out) outR[s] = yR;
          this.scope[this.scIdx] = yL;
          this.scIdx = (this.scIdx + 1) & 255;
        }
        if ((++this.tick & 3) === 0) {
          for (let i=0;i<16;i++) energy += 0.5 * p[i]*p[i] + 0.5 * kEff * q[i]*q[i];
          this.port.postMessage({ type:'telemetry', scope:Array.from(this.scope), q:Array.from(q), energy });
        }
        return true;
      }
    }
    registerProcessor('hyper-wave', HyperWaveProcessor);
  `;

