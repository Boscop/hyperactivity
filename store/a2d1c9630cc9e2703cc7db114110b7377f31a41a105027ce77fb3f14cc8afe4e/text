  // ── Exact Reversible Haar Lifting Wavelet (Bit-Exact JS Port of sound/wave) ──
  function haarLift(samples) {
    const s = [], d = [];
    for (let i=0; i+1<samples.length; i+=2) {
      const a = samples[i] | 0, b = samples[i+1] | 0;
      const diff = (b - a) | 0;
      const avg = (a + (diff >> 1)) | 0;
      s.push(avg); d.push(diff);
    }
    return { s, d };
  }
  function haarUnlift(s, d) {
    const out = [];
    for (let i=0;i<s.length;i++) {
      const a = (s[i] - (d[i] >> 1)) | 0;
      const b = (a + d[i]) | 0;
      out.push(a, b);
    }
    return out;
  }

  // ── Deterministic Offline 48kHz WAV Renderer + .MID Export + Wavelet Bench ──
  function renderOfflinePCM(nSamples) {
    const pcm = new Int16Array(nSamples);
    let q0=0,q1=0,q2=0,q3=0,p0=0,p1=0,p2=0,p3=0;
    const sc = SCALES[state.scale];
    const stepLen = Math.max(1200, Math.round(48000 * 60 / state.bpm / 4));
    const damp = (1 - state.gamma) / (1 + state.gamma);
    for (let i=0;i<nSamples;i++) {
      const st = Math.floor(i / stepLen) & 15;
      const inSt = i % stepLen;
      const hz = state.rootHz * sc[[0,4,7,9,12,7,4,2][st % 8] % sc.length].r;
      const om = 2 * Math.PI * hz / 48000;
      const kE = Math.min(0.85, om*om*(1 + state.k*2.2));
      const wE = Math.min(0.45, state.w*(0.2 + om*1.4));
      const f0 = (inSt < 24 && (state.seq[0][st] || state.seq[1][st])) ? 0.14 : 0;
      const l0 = wE*((q0-q1)+(q0-q3)), l1 = wE*((q1-q0)+(q1-q2)), l2 = wE*((q2-q1)+(q2-q3)), l3 = wE*((q3-q2)+(q3-q0));
      p0 = damp*(p0 - (kE*q0 + l0 + state.alpha*q0*q0*q0 - f0));
      p1 = damp*(p1 - (kE*q1 + l1)); p2 = damp*(p2 - (kE*q2 + l2)); p3 = damp*(p3 - (kE*q3 + l3));
      q0 += p0; q1 += p1; q2 += p2; q3 += p3;
      const y = Math.tanh((q0+q1+q2+q3)*0.32);
      pcm[i] = Math.max(-32767, Math.min(32767, Math.round(y * 32000)));
    }
    return pcm;
  }
