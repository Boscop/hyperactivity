  function drawInv(hist) {
    const c = document.getElementById('invCanvas'), g = c.getContext('2d');
    g.clearRect(0, 0, c.width, c.height);
    const maxL = Math.max(1e-6, ...hist.map(x=>x.loss));
    g.strokeStyle = '#ff0a94'; g.lineWidth = 2; g.beginPath();
    hist.forEach((x, i) => {
      const px = (i / Math.max(1, hist.length-1)) * (c.width - 20) + 10;
      const py = c.height - 15 - (x.loss / maxL) * (c.height - 30);
      if (i===0) g.moveTo(px,py); else g.lineTo(px,py);
    });
    g.stroke();
  }
  function anim() {
    // Oscilloscope
    const sc = document.getElementById('scopeCanvas'), sg = sc.getContext('2d');
    sg.clearRect(0, 0, sc.width, sc.height);
    sg.strokeStyle = '#ff0a94'; sg.lineWidth = 1.8; sg.beginPath();
    for (let i=0;i<lastScope.length;i++) {
      const x = (i / 255) * sc.width, y = sc.height/2 - lastScope[i] * (sc.height*0.42);
      if (i===0) sg.moveTo(x,y); else sg.lineTo(x,y);
    }
    sg.stroke();
    // 4x4 Physical Wavefield / Chladni Mesh
    const mc = document.getElementById('meshCanvas'), mg = mc.getContext('2d');
    mg.clearRect(0, 0, mc.width, mc.height);
    const cw = mc.width/4, ch = mc.height/4;
    for (let r=0;r<4;r++) for (let col=0;col<4;col++) {
      const idx = r*4+col, v = lastQ[idx] || 0;
      const mag = Math.min(1, Math.abs(v) * 1.4);
      mg.fillStyle = v >= 0 ? `rgba(255,10,148,${0.08 + mag*0.75})` : `rgba(26,115,232,${0.08 + mag*0.75})`;
      mg.fillRect(col*cw + 4, r*ch + 4, cw - 8, ch - 8);
      mg.strokeStyle = 'rgba(128,128,128,0.4)'; mg.strokeRect(col*cw + 4, r*ch + 4, cw - 8, ch - 8);
      mg.fillStyle = document.documentElement.classList.contains('dark') ? '#fff' : '#000';
      mg.font = '600 11px monospace';
      mg.fillText(`v${idx} q=${v.toFixed(2)}`, col*cw + 12, r*ch + 24);
    }
    requestAnimationFrame(anim);
  }

  renderPads(); renderSeq(); renderJamDag(); drawPoly(); syncCodeFromState(); snapCas('init'); anim();
})();
</script>
