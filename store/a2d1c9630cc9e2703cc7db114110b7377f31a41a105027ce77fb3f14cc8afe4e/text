  (p-euclid #3 #8 #220 #1000)
  (p-par (p-euclid #5 #12 #330 #850)
         (p-euclid #7 #16 #550 #700))

-- Physical Hamiltonian parameters (verified passive by wave-passivity-sos-id):
-- topo=string  exc=pluck  k=0.240  w=0.220  gamma=0.0024  alpha=0.06
</textarea>
          <div class="row" style="margin-top:8px">
            <button id="btnEvalCode" class="primary">Apply Term to Live Audio</button>
            <button id="btnSnapCas">Commit CAS Snapshot (SHA-256)</button>
            <span class="kv">History: <input id="casScrub" type="range" min="0" max="0" value="0" style="width:140px;vertical-align:middle"> <b id="casIdx">0/0</b></span>
          </div>
          <div id="codeLog" class="mono-box">Bidirectional reflection active: every UI control updates this term; editing p-euclid or parameter lines updates the live 48kHz AudioWorklet.</div>
        </div>
      </div>
      <div>
        <div class="card">
          <h2>Zero-Ontology Key Identities &amp; Composable Signed Warrants (WebCrypto ECDSA P-256)</h2>
          <div class="kv" style="margin-bottom:8px">
            Transparent peers (<code>wp-open</code>) collaborate with <b>zero authentication</b>. Generate local keys when proving identity via challenge-response, gating private channels, or composing a <b>Virtual Joint Agent (k₁ ∧ k₂)</b>.
          </div>
          <div class="row">
            <button id="btnGenKey1" class="primary">Generate Key k₁ (Self)</button>
            <button id="btnGenKey2">Generate Key k₂ (Collaborator)</button>
            <button id="btnSignJoint" class="ok">Co-Sign Joint Warrant (k₁ ∧ k₂)</button>
            <button id="btnChallenge">Run Challenge-Response</button>
          </div>
          <div id="warrantLog" class="mono-box">Mode: wp-open (transparent peer — any peer in room can pull &amp; remix freely via BroadcastChannel / WebRTC).</div>
        </div>
        <div class="card">
          <h2>16-Tile HyperNet-16 &amp; Ring-0 HyperOS Hardware Map</h2>
          <div class="mono-box">sound/graph.hypercubical:
  tile-id4 r c     -> 4x4 striped VAR_SRAM (16 Port-Hamiltonian vertices, 0 central switch)
  tile-ns-inv-cert -> exact toroidal neighbor symmetry (refl)
  sound-ring0-noninterference -> Ring-0 HyperOS Audio-DSP SIP (0 CR3 flushes)
Native ARM64 binary: sound/hx-sound.hypercubical (92x real-time 48kHz WAV, 4.68x lossless wavelet+HXZ)</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(() => {
  // ── Theme ──
  const btnTheme = document.getElementById('btnTheme');
  if (localStorage.getItem('hx-theme') === 'dark') document.documentElement.classList.add('dark');
  btnTheme.onclick = () => {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem('hx-theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
  };

  // ── Tabs ──
  document.querySelectorAll('.tab').forEach(b => {
    b.onclick = () => {
      document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
      document.querySelectorAll('.pane').forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      document.getElementById(b.dataset.pane).classList.add('active');
    };
  });

  // ── Scale Definitions (Stern-Brocot & Unbounded Tunings) ──
  const SCALES = {
    just: [
      { n:'1/1', r:1, p:1, q:1 }, { n:'16/15', r:16/15, p:16, q:15 }, { n:'9/8', r:9/8, p:9, q:8 },
      { n:'6/5', r:6/5, p:6, q:5 }, { n:'5/4', r:5/4, p:5, q:4 }, { n:'4/3', r:4/3, p:4, q:3 },
      { n:'45/32', r:45/32, p:45, q:32 }, { n:'3/2', r:3/2, p:3, q:2 }, { n:'8/5', r:8/5, p:8, q:5 },
      { n:'5/3', r:5/3, p:5, q:3 }, { n:'9/5', r:9/5, p:9, q:5 }, { n:'15/8', r:15/8, p:15, q:8 },
      { n:'2/1', r:2, p:2, q:1 }, { n:'9/4', r:9/4, p:9, q:4 }, { n:'5/2', r:5/2, p:5, q:2 },
      { n:'8/3', r:8/3, p:8, q:3 }, { n:'3/1', r:3, p:3, q:1 }, { n:'4/1', r:4, p:4, q:1 }
    ],
    '12tet': Array.from({length:18}, (_,i) => ({ n:['C','C#','D','Eb','E','F','F#','G','Ab','A','Bb','B'][i%12]+(Math.floor(i/12)+3), r:Math.pow(2,i/12), p:i+1, q:12 })),
    '19edo': Array.from({length:18}, (_,i) => ({ n:`${i}/19`, r:Math.pow(2,i/19), p:i+1, q:19 })),
    '22shruti': [
