<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hyperactive DAW · First-Principles Sound &amp; Live Jam Graph</title>
<style>
:root {
  --bg: #ffffff; --bg2: #f7f7f8; --ink: #000000; --muted: #555555;
  --line: rgba(0,0,0,0.16); --line-strong: #000000;
  --pink: #ff0a94; --blue: #1a73e8; --green: #0a8f5c; --amber: #c76b00;
  --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
}
html.dark {
  --bg: #000000; --bg2: #0c0c0e; --ink: #ffffff; --muted: #a6a6a6;
  --line: rgba(255,255,255,0.18); --line-strong: #ffffff;
  --pink: #ff0a94; --blue: #4da3ff; --green: #22c55e; --amber: #ffaa3b;
}
* { box-sizing: border-box; }
html, body {
  margin: 0; background: var(--bg); color: var(--ink);
  font: 15px/1.55 -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}
::selection { background: var(--pink); color: #fff; }
a { color: inherit; text-decoration: underline; text-decoration-color: var(--pink); }
.wrap { max-width: 1320px; margin: 0 auto; padding: 20px 20px 80px; }
.topbar {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;
  border-bottom: 1.5px solid var(--line-strong); padding-bottom: 12px; margin-bottom: 16px;
}
.brand { display: flex; align-items: baseline; gap: 12px; }
.kicker { font: 700 11px/1.2 var(--mono); color: var(--pink); letter-spacing: 0.08em; text-transform: uppercase; }
h1 { margin: 0; font-size: clamp(22px, 2.8vw, 30px); font-weight: 800; letter-spacing: -0.025em; }
.transport { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font: 600 12px/1 var(--mono); }
button, select, input[type="text"], input[type="number"] {
  font: 600 12px/1.2 var(--mono); color: var(--ink); background: var(--bg);
  border: 1px solid var(--line-strong); padding: 6px 10px; cursor: pointer; border-radius: 0;
}
button:hover { border-color: var(--pink); color: var(--pink); }
button.primary { background: var(--pink); color: #fff; border-color: var(--pink); }
button.primary:hover { opacity: 0.88; color: #fff; }
button.active { background: var(--ink); color: var(--bg); }
button.ok { border-color: var(--green); color: var(--green); }
.tabs {
  display: flex; flex-wrap: wrap; gap: 0; border-bottom: 1px solid var(--line); margin-bottom: 16px;
}
.tab {
  border: 1px solid var(--line); border-bottom: none; padding: 9px 14px;
  font: 700 12px/1.2 var(--mono); background: var(--bg2); color: var(--muted);
}
.tab.active { background: var(--bg); color: var(--ink); border-color: var(--line-strong); border-top: 2px solid var(--pink); }
.pane { display: none; }
.pane.active { display: block; }
.grid2 { display: grid; grid-template-columns: 1.25fr 1fr; gap: 16px; }
.grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
@media (max-width: 960px) { .grid2, .grid3 { grid-template-columns: 1fr; } }
.card {
  border: 1px solid var(--line); background: var(--bg2); padding: 14px; margin-bottom: 14px;
}
.card h2 {
  margin: 0 0 10px; font: 700 12px/1.2 var(--mono); text-transform: uppercase;
  letter-spacing: 0.06em; color: var(--pink); display: flex; justify-content: space-between; align-items: center;
}
.row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 10px; }
.kv { font: 500 11px/1.4 var(--mono); color: var(--muted); }
.kv b { color: var(--ink); }
.kv .g { color: var(--green); }
.kv .p { color: var(--pink); }
.kv .b { color: var(--blue); }
.slider-row { display: grid; grid-template-columns: 120px 1fr 76px; align-items: center; gap: 8px; margin: 6px 0; font: 500 11px/1.2 var(--mono); }
input[type="range"] { width: 100%; accent-color: var(--pink); }
.tonnetz { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; }
.pad {
  border: 1px solid var(--line-strong); padding: 10px 6px; text-align: center;
  font: 700 12px/1.2 var(--mono); background: var(--bg); user-select: none;
  transition: transform 0.04s, background 0.06s;
}
.pad:active, .pad.lit { background: var(--pink); color: #fff; border-color: var(--pink); transform: scale(0.97); }
.pad small { display: block; font-weight: 500; font-size: 10px; opacity: 0.72; margin-top: 3px; }
canvas { display: block; width: 100%; border: 1px solid var(--line); background: var(--bg); }
textarea {
  width: 100%; min-height: 220px; font: 500 12px/1.5 var(--mono);
  background: var(--bg); color: var(--ink); border: 1px solid var(--line-strong); padding: 10px;
}
.ch-row {
  display: grid; grid-template-columns: 28px 1fr 110px 90px 120px; align-items: center; gap: 8px;
  padding: 7px 8px; border: 1px solid var(--line); background: var(--bg); margin-bottom: 6px;
  font: 500 11px/1.3 var(--mono);
}
.ch-row.active { border-color: var(--pink); }
.badge { display: inline-block; padding: 2px 6px; font: 700 10px/1.2 var(--mono); border: 1px solid var(--line-strong); }
.badge.open { border-color: var(--green); color: var(--green); }
.badge.joint { border-color: var(--pink); color: var(--pink); }
.badge.key { border-color: var(--blue); color: var(--blue); }
.mono-box {
  font: 500 11px/1.5 var(--mono); background: var(--bg); border: 1px solid var(--line);
  padding: 8px 10px; max-height: 180px; overflow: auto; white-space: pre-wrap;
}
.step-grid { display: grid; grid-template-columns: repeat(16, 1fr); gap: 3px; margin: 8px 0; }
.step-cell {
  height: 26px; border: 1px solid var(--line); background: var(--bg); cursor: pointer;
  display: flex; align-items: center; justify-content: center; font: 600 10px/1 var(--mono);
}
.step-cell.on { background: var(--ink); color: var(--bg); border-color: var(--ink); }
.step-cell.now { outline: 2px solid var(--pink); }
.pillbar { display: flex; flex-wrap: wrap; gap: 6px; font: 500 11px/1.3 var(--mono); }
.pill { border: 1px solid var(--line); padding: 3px 8px; background: var(--bg); }
</style>
</head>
<body>
<div class="wrap">
  <div class="topbar">
    <div class="brand">
      <div>
        <div class="kicker">hyperactivity · sound/time · sound/wave · sound/graph · 0 postulates</div>
        <h1>Hyperactive DAW</h1>
      </div>
    </div>
    <div class="transport">
      <button id="btnAudio" class="primary">Start 48kHz Engine</button>
      <button id="btnPlay">Play Seq</button>
      <button id="btnMic">Mic Excite: OFF</button>
      <button id="btnMidi">WebMIDI: --</button>
      <label class="kv">BPM <input id="bpmIn" type="number" value="116" min="30" max="240" style="width:62px"></label>
      <button id="btnTheme">Theme</button>
      <a href="/kg?mod=sound/wave.hypercubical" style="font:700 11px var(--mono)">Source in /kg</a>
    </div>
  </div>

  <div class="pillbar" style="margin-bottom:14px">
    <span class="pill">CAS Root: <b id="casHash">sha256:init</b></span>
    <span class="pill">Hamiltonian E: <b id="statE">0.0000</b> (<span class="g" id="statPass">PASSIVE</span>)</span>
    <span class="pill">Wavelet+Δ Ratio: <b id="statRatio">--</b></span>
    <span class="pill">Room: <b id="statRoom">hyper-jam-01</b> (<b id="statPeers">1</b> peers)</span>
    <span class="pill">Key ID: <b id="statKey">open (transparent)</b></span>
  </div>

  <div class="tabs">
    <button class="tab active" data-pane="p1">1 · Play, Scales &amp; Live Jam DAG</button>
    <button class="tab" data-pane="p2">2 · Timeline, Wavelet Spectrum &amp; DTW Battle</button>
    <button class="tab" data-pane="p3">3 · Physical Wave Mesh &amp; Zero-Tape Inverse</button>
    <button class="tab" data-pane="p4">4 · .hypercubical Reflection, CAS &amp; Warrants</button>
  </div>

  <!-- PANE 1: PLAY, SCALES & LIVE JAM DAG -->
  <div id="p1" class="pane active">
    <div class="grid2">
      <div>
        <div class="card">
          <h2>Stern-Brocot &amp; Microtonal Harmonic Field <span class="kv">Keys: A-L / W-P</span></h2>
          <div class="row">
            <label class="kv">Scale:</label>
            <select id="scaleSel">
              <option value="just">Just Intonation (Stern-Brocot 5-limit)</option>
              <option value="12tet">12-TET (Equal Temperament)</option>
              <option value="19edo">19-EDO (Meantone Super-Consonant)</option>
              <option value="22shruti">Indian 22-Shruti (Pure Ratios)</option>
              <option value="bohlen">Bohlen-Pierce (3:1 Tritave)</option>
