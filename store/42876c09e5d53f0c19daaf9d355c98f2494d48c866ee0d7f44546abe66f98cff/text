-- the focus beside each statement asserted equivalent to it, each one morph away
hi-morphs : List Word → List Word → List Word → Proc W (List Word)
hi-morphs st rd f = bind (hi-equivalents f) (λ es → bind (hi-each (h-dedupe es) (hi-morph st rd f)) (λ ms →
  ret (if h-null ms then nil else list-append (hi-sect "equivalent" ms) hi-morph-js)))
