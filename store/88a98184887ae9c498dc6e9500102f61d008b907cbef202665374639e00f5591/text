--    `inc qword [32]` without the prefix is a read and a write: both can see 0
by-inc-nolock : List TsoThread
by-inc-nolock = cons (mev-thread (mi-read #8 #32 (λ x → mi-write #8 #32 (wadd x #1) (mi-ret (cons x nil))))) (cons (mev-thread (mi-read #8 #32 (λ x → mi-write #8 #32 (wadd x #1) (mi-ret (cons x nil))))) nil)
