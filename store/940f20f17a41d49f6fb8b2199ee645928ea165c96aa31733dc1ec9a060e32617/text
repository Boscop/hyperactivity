s-packs-valid : List (List Word) → Proc W Bool
s-packs-valid nil = ret true
s-packs-valid (cons ph r) =
  if h-null ph then s-packs-valid r
  else if h-not (s-hex64 ph) then ret {lzero} {W} false
  else bind (h-file-time (list-append "packs/" ph)) (λ ft →
    if wlt #0 ft then s-packs-valid r else ret {lzero} {W} false)
