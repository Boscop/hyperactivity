bin-mul-canon : (a b : List Bool) → bcanon a ≡ true → bcanon b ≡ true → bcanon (bin-mul a b) ≡ true
bin-mul-canon a b = case a return λ m → bcanon m ≡ true → bcanon b ≡ true → bcanon (bin-mul m b) ≡ true of
  nil → λ ca cb → λ i → true
  cons x xs → λ ca cb → mul-canon-step x xs b cb (rec xs (canon-tail x xs ca) cb)
