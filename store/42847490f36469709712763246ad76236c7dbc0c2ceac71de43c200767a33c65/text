superchip-opt : INetExpr → INetExpr
superchip-opt (in-lit w)        = in-lit w
superchip-opt in-var0           = in-var0
superchip-opt (in-dup-add x)    = bn-mk-dup-add (superchip-opt x)
superchip-opt (in-add a b)      = bn-mk-add (superchip-opt a) (superchip-opt b)
superchip-opt (in-xor a b)      = bn-mk-xor (superchip-opt a) (superchip-opt b)
superchip-opt (in-era-l _ live) = superchip-opt live
superchip-opt (in-lut3 m a b c) = bn-mk-lut3 m (superchip-opt a) (superchip-opt b) (superchip-opt c)
