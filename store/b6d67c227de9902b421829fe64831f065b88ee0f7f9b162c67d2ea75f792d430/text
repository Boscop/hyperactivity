-- the first q occurrences met, each as the position it starts at in the text read forward: step i reads
-- the byte at ℓ - 1 - i and folds in the state of the byte before it, at ℓ - i. They are met latest first,
-- so the list, consed as they are met, is in increasing order
m-occ : (n : Nat) → Bytes n → (k : Nat) → Bytes k → Word → Word → Word → (s : Nat) → Bytes s → List Word
m-occ n p k f m e q s b = m-occ-end e (%welimP (λ _ → Word × List Word) (bytes-length s b) (m-with q #0 , nil)
  (λ i a → m-occ-at e (wsub (bytes-length s b) i) (fst a) (snd a) (m-next n p k f m (m-lo (fst a)) (m-back s b i))))
