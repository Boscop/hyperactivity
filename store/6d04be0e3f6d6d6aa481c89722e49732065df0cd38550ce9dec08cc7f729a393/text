f64-to-int : Bool → IW → Float64 → MRes SV
f64-to-int sg w x = case w of
  iw128 → mr-map sv-of-dq (f64-to-dq sg x)
  _ → (case m-and (fi-lo-ok sg w x) (f64lt x (fi-hi sg w)) of
    false → mub ub-float-int-range
    true → mok (sv-i (case m-and (not sg) (not (f64lt x (f64 #9223372036854775808))) of
      true → u64add (f64-trunc-uq (f64sub x (f64 #9223372036854775808))) uq-top
      false → f64-trunc-uq x)))
