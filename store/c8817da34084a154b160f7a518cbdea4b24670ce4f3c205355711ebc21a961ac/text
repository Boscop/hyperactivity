sec-lemma : (t : List (List Word)) → (h0 : Nat) → (f : List (List Word) → Word) → Prop t (suc h0) f → PosRank f →
            (d d' : List (List Word)) → MemOrNil t d → MemOrNil t d' →
            word-le (sec f d) (sec f d') ≡ leq {suffix-ord} (take-n (suc h0) d) (take-n (suc h0) d')
sec-lemma t h0 f pr ps d d' =
  case d return λ w → MemOrNil t w → MemOrNil t d' → word-le (sec f w) (sec f d') ≡ leq {suffix-ord} (take-n (suc h0) w) (take-n (suc h0) d') of
    nil → λ m m' → wle-zero (sec f d')
    cons a q →
      λ m → (case d' return λ u → MemOrNil t u → word-le (f (cons a q)) (sec f u) ≡ leq {suffix-ord} (cons a (take-n h0 q)) (take-n (suc h0) u) of
               nil → λ m' → ps (cons a q)
               cons b w → λ m' → pr (cons a q) (cons b w) m m')
