-- composition in a line of compositions of types (S a line of systems of type lines from A):
-- the base composed with the unglued tube and, where the whole line is on a face, the unglued
-- filler of the faces' ends; then on the end's faces the transport fibre over it
%comp-gluel A S u u0 =
  let a0 = %unglueU (S @ 0) u0
      delta = (∀ i → (faceof (S @ i)))
      tl = λ (k : I) → fill (λ (i : I) → (S @ i) @ 1) u u0 k
      a1 =
        comp A
          (sys+ delta (λ (i : I) → %unglueU (S @ i) (tl @ i))
             (sysmap (λ w (i : I) → %unglueU (S @ i) (w @ i)) u)) a0
      tp =
        sysmap (λ w → %tproof (λ (j : I) → w @ ~ j) (sys+ delta (tl @ 1) (sysmap (λ v → v @ 1) u)) a1)
          (S @ 1)
  in glue (sysmap (λ e → fst e) tp)
       (hcomp (A @ 1) (sys+ (faceof tp) (sysmap (λ e (q : I) → (snd e) @ (~ q)) tp) (sysmap (λ w (q : I) → a1) u)) a1)
