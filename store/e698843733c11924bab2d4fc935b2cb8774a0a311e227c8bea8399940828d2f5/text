ce-exp : Nat → Word → Code → List Word
ce-exp zero d c = "hy_bad()"
ce-exp (suc k) d (cvar n) = list-append "v" (h-decimal (%wsub (%wsub d #1) n))
ce-exp (suc k) d (cwlit n) = list-append (h-decimal n) "ull"
ce-exp (suc k) d (cwop j a b) = list-append (ce-opname j) (list-append "(" (list-append (ce-exp k d a) (list-append ", " (list-append (ce-exp k d b) ")"))))
ce-exp (suc k) d (clet t b) = list-append "({ uint64_t v" (list-append (h-decimal d) (list-append " = " (list-append (ce-exp k d t) (list-append "; " (list-append (ce-exp k (%wsucc d) b) "; })")))))
ce-exp (suc k) d (capp f a) =
  (case fst (x-spine (capp f a)) return (λ _ → List Word) of
     cglob g → list-append "g" (list-append (h-decimal g) (list-append "(" (list-append (ce-args-n (λ x → ce-exp k d x) (snd (x-spine (capp f a))) true) ")")))
     h → "hy_bad()")
ce-exp (suc k) d (cglob g) = list-append "g" (list-append (h-decimal g) "()")
ce-exp (suc k) d c = "hy_bad()"
