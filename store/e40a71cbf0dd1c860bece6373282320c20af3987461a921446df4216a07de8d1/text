-- Executing arbitrary Ring-0 computation in Fiber A leaves Fiber B bit-identical & performs 0 CR3 flushes:
sip-ring0-noninterference :
  (f g : Word → Word) → (a b : Word) →
  (sip-read-B (sip-step-A f (sip-mem a b zero)) ≡ b)
  × (sip-flushes (sip-step-B g (sip-step-A f (sip-mem a b zero))) ≡ zero)
  × (sip-step-B g (sip-step-A f (sip-mem a b zero)) ≡ sip-step-A f (sip-step-B g (sip-mem a b zero)))
sip-ring0-noninterference f g a b = (refl , (refl , refl))
