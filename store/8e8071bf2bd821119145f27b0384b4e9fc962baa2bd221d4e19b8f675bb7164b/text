<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 920 260" width="920" height="260" role="img" aria-label="Hyperactivity Interaction Net Active Pair Reduction">
  <style>
    .bg { fill: #000000; }
    .frame { fill: none; stroke: #ffffff; stroke-width: 2; }
    .grid { stroke: rgba(255,255,255,0.08); stroke-width: 1; }
    .wire-p { fill: none; stroke: #ff0a94; stroke-width: 2.4; }
    .wire-b { fill: none; stroke: #4da3ff; stroke-width: 2.2; }
    .wire-w { fill: none; stroke: rgba(255,255,255,0.55); stroke-width: 1.6; }
    .node-v { fill: #000000; stroke: #ff0a94; stroke-width: 2.6; }
    .node-o { fill: #000000; stroke: #4da3ff; stroke-width: 2.6; }
    .lbl { fill: #ffffff; font: 700 13px ui-monospace, 'SF Mono', Menlo, monospace; text-anchor: middle; dominant-baseline: central; }
    .sub { fill: rgba(255,255,255,0.65); font: 600 11px ui-monospace, 'SF Mono', Menlo, monospace; }
    .pink { fill: #ff0a94; font: 700 11px ui-monospace, 'SF Mono', Menlo, monospace; }
    .blue { fill: #4da3ff; font: 700 11px ui-monospace, 'SF Mono', Menlo, monospace; }
    .title { fill: #ffffff; font: 800 22px ui-monospace, 'SF Mono', Menlo, monospace; letter-spacing: -0.02em; }
    @keyframes pulseRing {
      0%   { r: 24; opacity: 0.95; }
      100% { r: 44; opacity: 0; }
    }
    @keyframes dashFlow {
      to { stroke-dashoffset: -36; }
    }
    @keyframes blinkPair {
      0%, 100% { opacity: 1; }
      50%      { opacity: 0.45; }
    }
    .sonar { fill: none; stroke: #ff0a94; stroke-width: 2; animation: pulseRing 2.2s ease-out infinite; }
    .sonar2 { fill: none; stroke: #4da3ff; stroke-width: 1.8; animation: pulseRing 2.2s ease-out 1.1s infinite; }
    .flow-p { stroke-dasharray: 8 10; animation: dashFlow 1.1s linear infinite; }
    .flow-b { stroke-dasharray: 8 10; animation: dashFlow 1.3s linear infinite; }
    .active-spark { animation: blinkPair 1.1s ease-in-out infinite; }
  </style>

  <rect class="bg" width="920" height="260"/>
  <rect class="frame" x="1" y="1" width="918" height="258"/>
  <line class="grid" x1="460" y1="0" x2="460" y2="260"/>

  <!-- Left panel: Active Pair Rewrite (app ⋈ λ) -->
  <text class="pink" x="24" y="28">◈ ACTIVE PAIR REDUCTION · LOCK-FREE LOCAL REWRITE</text>
  <text class="sub" x="24" y="240">O(1) local step · zero global clock · optimal sharing</text>

  <!-- Auxiliary wires -->
  <path class="wire-w" d="M 54 96 C 95 96, 115 112, 152 128"/>
  <path class="wire-w" d="M 54 172 C 95 172, 115 156, 152 140"/>
  <path class="wire-w" d="M 308 128 C 345 112, 365 96, 412 96"/>
  <path class="wire-w" d="M 308 140 C 345 156, 365 172, 412 172"/>

  <!-- Principal-to-principal active wire -->
  <line class="wire-p flow-p" x1="196" y1="134" x2="264" y2="134"/>
  <circle class="active-spark" cx="230" cy="134" r="5" fill="#ff0a94"/>

  <!-- Operation cell (app) -->
  <circle class="sonar2" cx="174" cy="134" r="24"/>
  <circle class="node-o" cx="174" cy="134" r="24"/>
  <text class="lbl" x="174" y="134">app</text>
  <text class="blue" x="48" y="84">arg</text>
  <text class="sub" x="48" y="190">out</text>

  <!-- Value cell (λ) -->
  <circle class="sonar" cx="286" cy="134" r="24"/>
  <circle class="node-v" cx="286" cy="134" r="24"/>
  <text class="lbl" x="286" y="134">λ</text>
  <text class="pink" x="392" y="84">param</text>
  <text class="sub" x="392" y="190">body</text>

  <!-- Animated reduction packet -->
  <circle r="4" fill="#ffffff">
    <animateMotion dur="1.4s" repeatCount="indefinite" path="M 196 134 L 264 134"/>
  </circle>

  <!-- Right panel: Guarded Corecursion Homeostasis (life ▸ κ) -->
  <text class="blue" x="484" y="28">◈ GUARDED CORECURSION · life (▸ κ) · BOUNDED O(1) MEMORY</text>
  <text class="sub" x="484" y="240">Click to launch interactive lab → hyperactivity.ai/nets</text>

  <!-- Homeostatic 3-node ring -->
  <path class="wire-p flow-p" d="M 605 126 Q 690 64 775 126"/>
  <path class="wire-b flow-b" d="M 775 144 Q 690 210 605 144"/>
  <line class="wire-w" x1="690" y1="78" x2="690" y2="190"/>

  <!-- Moving quanta along the guarded loop -->
  <circle r="4.5" fill="#ff0a94">
    <animateMotion dur="2.4s" repeatCount="indefinite" path="M 605 126 Q 690 64 775 126"/>
  </circle>
  <circle r="4.5" fill="#4da3ff">
    <animateMotion dur="2.4s" repeatCount="indefinite" path="M 775 144 Q 690 210 605 144"/>
  </circle>

  <!-- Guarded nodes -->
  <circle class="sonar" cx="584" cy="135" r="22"/>
  <circle class="node-v" cx="584" cy="135" r="22"/>
  <text class="lbl" x="584" y="135">▸ κ</text>

  <circle class="node-o" cx="690" cy="78" r="19"/>
  <text class="lbl" x="690" y="78">force</text>

  <circle class="node-o" cx="690" cy="190" r="19"/>
  <text class="lbl" x="690" y="190">dup</text>

  <circle class="sonar2" cx="796" cy="135" r="22"/>
  <circle class="node-v" cx="796" cy="135" r="22"/>
  <text class="lbl" x="796" y="135">ua</text>
</svg>
