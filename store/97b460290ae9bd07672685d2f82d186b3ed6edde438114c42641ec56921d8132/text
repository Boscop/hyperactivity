lit-meet-law : (p1 n1 p2 n2 r : Bool) →
  lit-sat (b-or2 p1 p2) (b-or2 n1 n2) r ≡ andB (lit-sat p1 n1 r) (lit-sat p2 n2 r)
lit-meet-law p1 n1 p2 n2 r =
  catB
    (lit-sat (b-or2 p1 p2) (b-or2 n1 n2) r)
    (andB (andB (pos-sat p1 r) (pos-sat p2 r)) (andB (neg-sat n1 r) (neg-sat n2 r)))
    (andB (lit-sat p1 n1 r) (lit-sat p2 n2 r))
    (λ i → andB (pos-or-law p1 p2 r i) (neg-or-law n1 n2 r i))
    (andB-swap4 (pos-sat p1 r) (pos-sat p2 r) (neg-sat n1 r) (neg-sat n2 r))
