encode-proc : Word → Defs → Lst Word
encode-proc m defs =
  let slen = l-count (x-stub #0 #0)
      ars = x-arities defs
      dlen = l-count (x-driver #0 #0)
      aoff = slen
      doff = %wadd slen (l-count i-apply)
      offs = lcons (x-apply-key , aoff) (x-layout ars defs (%wadd doff dlen))
      tbl = (ars , offs)
  in xcat4 (x-stub #0 doff) i-apply (x-driver (x-tbl tbl m) aoff) (x-fns tbl defs)
