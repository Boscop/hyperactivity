kvl-vok-imp : (X : Type) → (P : KvSt → Type) → (v : NView KvMsg KvSt) → (X → VOk {KvMsg} {KvSt} P v) → VOk {KvMsg} {KvSt} (λ s → X → P s) v
kvl-vok-imp X P v-halt f = unit
kvl-vok-imp X P (v-send to m s) f = f
kvl-vok-imp X P (v-recv k) f = λ r x → f x r
kvl-vok-imp X P (v-now kn) f = λ w x → f x w
kvl-vok-imp X P (v-tau s) f = f
