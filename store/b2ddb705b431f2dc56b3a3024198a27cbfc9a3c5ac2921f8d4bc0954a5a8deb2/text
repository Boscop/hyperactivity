cs-env-rel-mono : (hp1 hp2 : CsHeap) (menv : Lst CsMVal) (cenv : CsEnv) →
  cs-heap-ext hp1 hp2 → cs-env-rel hp1 menv cenv → cs-env-rel hp2 menv cenv
cs-env-rel-mono hp1 hp2 menv cenv ext henv n =
  let o = cs-get-var cenv (%wsub (%wsub (cs-wlen menv) #1) n)
      om = cs-mget menv n
      hs1 = cong (cs-sim-ok om) (sym (cs-bind-ov-eq o (λ v → cso-ok hp1 v))) ∙ henv n
  in cong (cs-sim-ok om) (cs-bind-ov-eq o (λ v → cso-ok hp2 v))
     ∙ cs-env-rel-mono-ov hp1 hp2 om (cs-optv o) ext hs1
