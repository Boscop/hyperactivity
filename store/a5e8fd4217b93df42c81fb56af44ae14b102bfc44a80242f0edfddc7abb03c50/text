-- every wire the first plan writes is none of the wires the second writes
nk-aparts : NkFx → NkFx → Type
nk-aparts nkf-nil fx2 = Unit
nk-aparts (nkf-val w v r) fx2 = nk-apart w fx2 × nk-aparts r fx2
nk-aparts (nkf-op w o r) fx2 = nk-apart w fx2 × nk-aparts r fx2
nk-aparts (nkf-put w s r) fx2 = nk-apart w fx2 × nk-aparts r fx2
