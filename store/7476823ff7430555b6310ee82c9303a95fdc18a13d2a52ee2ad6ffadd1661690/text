hxn-main : List (List Word) → Step W Word
hxn-main args =
  let a1 = hxn-a1 args
      a2 = hxn-a2 args
      a3 = hxn-a3 args
  in if cli-eq a1 "listen" then hxn-listen (if %weq (cli-word a2) #0 then #47475 else cli-word a2)
     else if cli-eq a1 "send" then hxn-send (if %weq (cli-word a2) #0 then #47475 else cli-word a2) a3
     else hxn-bench (if %weq (cli-word a1) #0 then #65536 else cli-word a1)
