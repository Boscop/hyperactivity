hcm-squash : Word → Word → Word
hcm-squash ps ns =
  let pos = %wlt ns (%wsucc ps)
      m   = %wshr (if pos then %wsub ps ns else %wsub ns ps) #10
      q   = if %wlt #2047 m then #4095
            else if %wlt #1535 m then %wadd #4086 (%wdiv (%wmul (%wsub m #1536) #9) #512)
            else if %wlt #1279 m then %wadd #4069 (%wdiv (%wmul (%wsub m #1280) #17) #256)
            else if %wlt #1023 m then %wadd #4023 (%wdiv (%wmul (%wsub m #1024) #46) #256)
            else if %wlt #767 m then %wadd #3901 (%wdiv (%wmul (%wsub m #768) #122) #256)
            else if %wlt #511 m then %wadd #3608 (%wdiv (%wmul (%wsub m #512) #293) #256)
            else if %wlt #255 m then %wadd #2994 (%wdiv (%wmul (%wsub m #256) #614) #256)
            else %wadd #2048 (%wdiv (%wmul m #946) #256)
  in if pos then q else %wsub #4096 q
