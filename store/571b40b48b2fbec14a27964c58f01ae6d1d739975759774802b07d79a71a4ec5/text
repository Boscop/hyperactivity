cmp-double-z : (t x y : Bool) → (Y : Nat) → cmpN t (plus (bitn x) (times 2 zero)) (plus (bitn y) (times 2 Y)) ≡ cmpN (if bit-eq x y then t else y) zero Y
cmp-double-z t x y Y = case Y return λ n → cmpN t (plus (bitn x) (times 2 zero)) (plus (bitn y) (times 2 n)) ≡ cmpN (if bit-eq x y then t else y) zero n of
  zero → cmp-00 t x y
  suc j → cmp-0B t x (plus (bitn y) (times 2 (suc j))) (plus (bitn y) (times 2 j)) (dbl-suc y j)
