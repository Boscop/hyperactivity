-- local rewrite outcome of one active pair (principal port ⋈ principal port)
data CutOutcome (K : Type)
  = co-empty
  | co-erase2 (w1 : WireId) (w2 : WireId)
  | co-link2 (l1 : WireId) (r1 : WireId) (l2 : WireId) (r2 : WireId)
  | co-commute (t1 : Nat) (t2 : Nat) (a1 : WireId) (a2 : WireId) (b1 : WireId) (b2 : WireId)
  | co-expand (key : K) (arg : WireId) (peer : ICAgent K)
