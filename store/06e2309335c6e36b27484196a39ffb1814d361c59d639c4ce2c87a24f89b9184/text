-- a number with a bit in front: the bit plus twice the rest
cons-val : (s : Bool) → (r : List Bool) → bin-to-nat (cons s r) ≡ plus (bitn s) (times 2 (bin-to-nat r))
cons-val s r =
  case s return λ y → bin-to-nat (cons y r) ≡ plus (bitn y) (times 2 (bin-to-nat r)) of
    true → λ i → suc (times 2 (bin-to-nat r))
    false → λ i → times 2 (bin-to-nat r)
