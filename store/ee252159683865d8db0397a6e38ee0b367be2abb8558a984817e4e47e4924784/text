-- wiml_size: from linear_memory.sail (it calls what is defined after it there)
-- (part of language-support)
wiml_size : (nbytes : ZI) → (addr : Bits #48) → (sailval : ZI) → MS Unit
wiml_size nbytes addr sailval =
  λ σ →
    if (z-eq nbytes (zpos #1)) then
      the (MS Unit)
        (wiml08 addr (bits_of_int sailval (zpos #8))) σ
    else if (z-eq nbytes (zpos #2)) then
      the (MS Unit)
        (wiml16 addr (bits_of_int sailval (zpos #16))) σ
    else if (z-eq nbytes (zpos #4)) then
      the (MS Unit)
        (wiml32 addr (bits_of_int sailval (zpos #32))) σ
    else if (z-eq nbytes (zpos #8)) then
      the (MS Unit)
        (wiml64 addr (bits_of_int sailval (zpos #64))) σ
    else
      the (MS Unit)
        (liftS {Unit} (x86_model_error {Unit} #2202759391860346157669)) σ
