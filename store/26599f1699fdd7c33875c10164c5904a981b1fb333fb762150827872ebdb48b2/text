diff-undiff-mod-go : (B : Word) → (prev : Bounded B) → (ds : List (Bounded B)) →
                     diff-mod-go B prev (undiff-mod-go B prev ds) ≡ ds
diff-undiff-mod-go B prev ds =
  (case ds return (λ u → (p : Bounded B) → diff-mod-go B p (undiff-mod-go B p u) ≡ u) of
     nil → λ p i → nil
     cons d r → λ p →
       let x : Bounded B
           x = (mundiff-val B (fst p) (fst d) , mundiff-lt B (fst p) (fst d) (snd p) (snd d))
           d2 : Bounded B
           d2 = (mdiff-val B (fst p) (fst x) , mdiff-lt B (fst p) (fst x) (snd p) (snd x))
           pd : Path (Bounded B) d2 d
           pd = bounded-eq B d2 d (mdiff-mundiff B (fst p) (fst d) (snd p) (snd d))
       in λ i → cons (pd i) (rec r x i)) prev
