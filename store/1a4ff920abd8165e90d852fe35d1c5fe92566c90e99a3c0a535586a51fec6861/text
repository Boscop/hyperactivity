-- a + b + carry
bin-addc : Bool → List Bool → List Bool → List Bool
bin-addc c a b = case a of
  nil → (if c then bin-succ b else b)
  cons x xs → bin-cons (bit-eq (bit-eq x (bin-head b)) c) (bin-addc (if x then (if bin-head b then true else c) else (if bin-head b then c else false)) xs (bin-tail b))
