pf-via-ok : {A B : Type} → (c : Codec A B) → (pf : PFCodec B) → (a : A) → (tail : List Word) →
            pf-via-dec c pf (list-append (pf-enc pf (codec-enc c a)) tail) ≡ (a , tail)
pf-via-ok {A} {B} c pf a tail =
  let p0 : pf-dec pf (list-append (pf-enc pf (codec-enc c a)) tail) ≡ (codec-enc c a , tail)
      p0 = pf-ok pf (codec-enc c a) tail
  in concat {lzero} {A × List Word}
       {pf-via-dec c pf (list-append (pf-enc pf (codec-enc c a)) tail)}
       {(codec-dec c (codec-enc c a) , tail)} {(a , tail)}
       (λ i → (codec-dec c (fst (p0 i)) , snd (p0 i)))
       (λ i → (codec-ok c a i , tail))
