-- ── 3. Exact Symplectic Verlet Time-Reversibility (Zero-Tape O(1) Inverse) ──
-- For ANY force F (linear, Duffing, FitzHugh-Nagumo, bowed stick-slip, or N-node Laplacian):
--   Forward step:  p1 = p0 - F,   q1 = q0 + p1
--   Inverse step:  q0' = q1 - p1, p0' = p1 + F
-- Both q0' = q0 AND p0' = p0 hold identically in every commutative ring (zero tape memory!).
-- Variables (0..2): q0, p0, F.
wave-verlet-rev-q-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wave-verlet-rev-q-poly A ad mu q vs =
  (λ g sub _ →
    let q0 = g 0; p0 = g 1; F = g 2
        p1 = sub p0 F
        q1 = ad q0 p1
        q0' = sub q1 p1
    in (q0' , q0))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
