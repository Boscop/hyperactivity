wave-verlet-rev-p-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wave-verlet-rev-p-poly A ad mu q vs =
  (λ g sub _ →
    let p0 = g 0; F = g 1
        p1 = sub p0 F
        p0' = ad p1 F
    in (p0' , p0))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
