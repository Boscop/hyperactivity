s-italic-at : (List Word → List Word) → List Word → Sum Unit (List Word × List Word) → List Word
s-italic-at k r (inl u) = cons #42 (k r)
s-italic-at k r (inr p) = if andB (h-not (h-null (fst p))) (andB (s-no-star (fst p)) (s-free-after (snd p)))
  then list-append "<i>" (list-append (fst p) (list-append "</i>" (k (snd p)))) else cons #42 (k r)
