-- Single-Element Binary GDSII Stream Round-Trip Theorem:
-- Decoding `(gds-encode-one layer dtype r ++ rest)` recovers `(layer, dtype, r)` and exact `rest`!
gds-roundtrip-one : (layer dtype : Word) → (r : Rect) → (rest : List Word) →
  gds-decode-one (list-append (gds-encode-one layer dtype r) rest) ≡
  inr ((layer , (dtype , r)) , rest)
gds-roundtrip-one layer dtype (rect x0 y0 w h) rest =
  λ i → inr ((layer , (dtype , rect-recover-eq x0 y0 w h i)) , rest)
