nk-plain-nf : NkTm → Bool
nk-plain-nf (nk-var i) = true
nk-plain-nf (nk-free x) = true
nk-plain-nf (nk-num m) = true
nk-plain-nf (nk-lam b) = nk-plain-nf b
nk-plain-nf (nk-susp b) = true
nk-plain-nf nk-nil = true
nk-plain-nf (nk-cons t r) = if nk-plain-nf t then nk-plain-nf r else false
nk-plain-nf (nk-con c as) =
  if (if %weq c #7 then true else (if %weq c #8 then true else (if %weq c #30 then true else (if %weq c #47 then true else (if %weq c #51 then true else (if %weq c #52 then true else %weq c #54))))))
    then false
    else nk-plain-nf as
nk-plain-nf t = false
