nk-pick-wf-at : (z : Bool) (ins outs : NkEnv) (n0 n1 w : NkW) (r : NkEnv) (i : Word) (out : NkW) (fx : NkFx) →
  (nk-in-set ins n0 n1 w ≡ true) → (nk-fx-wf ins outs n0 n1 (nk-era-env r fx) ≡ true) →
  (nk-fx-wf ins outs n0 n1 (nk-pick r (%wsub i #1) out fx) ≡ true) →
  nk-fx-wf ins outs n0 n1 (if z then nkf-op w (nko-fwd out) (nk-era-env r fx) else nkf-op w nko-era (nk-pick r (%wsub i #1) out fx)) ≡ true
nk-pick-wf-at true ins outs n0 n1 w r i out fx hw her hp = nk-and-intro (nk-in-set ins n0 n1 w) (nk-fx-wf ins outs n0 n1 (nk-era-env r fx)) hw her
nk-pick-wf-at false ins outs n0 n1 w r i out fx hw her hp = nk-and-intro (nk-in-set ins n0 n1 w) (nk-fx-wf ins outs n0 n1 (nk-pick r (%wsub i #1) out fx)) hw hp
