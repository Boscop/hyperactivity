data GeoChoice : Type where
  gc-contractible : (sym : Word) → (depth : Nat) → (support : Word) → GeoChoice
  gc-modal        : (sym : Word) → (depth : Nat) → (support : Word) → (competitors : Nat) → GeoChoice
  gc-ground       : (sym : Word) → GeoChoice

geo-choice-sym : GeoChoice → Word
geo-choice-sym (gc-contractible s d m) = s
geo-choice-sym (gc-modal s d m c)      = s
geo-choice-sym (gc-ground s)           = s

geo-freq : Word → FTbl → Word
geo-freq x nil = #0
geo-freq x (cons e r) = if weq x (fst e) then snd e else geo-freq x r

geo-sup-go : Word → Word → FTbl → Word × Word
geo-sup-go bestSym bestCnt nil = (bestSym , bestCnt)
geo-sup-go bestSym bestCnt (cons e r) =
  if wlt bestCnt (snd e)
  then geo-sup-go (fst e) (snd e) r
  else geo-sup-go bestSym bestCnt r

geo-best-in-fiber : FTbl → Opt (Word × Word)
geo-best-in-fiber nil        = none
geo-best-in-fiber (cons e r) = some (geo-sup-go (fst e) (snd e) r)

geo-classify-tail : Nat → Word × Word → FTbl → GeoChoice
geo-classify-tail k e nil = gc-contractible (fst e) k (snd e)
geo-classify-tail k e (cons e2 rest) =
  let win = geo-sup-go (fst e) (snd e) (cons e2 rest)
  in gc-modal (fst win) k (snd win) (suc (list-length rest))

geo-cascade : Nat → List Word → CtxState → GeoChoice
geo-cascade zero excl st =
  gc-ground (cm-head-or #0 (unseen-bytes excl))
geo-cascade (suc k) excl st =
  case ftbl-exclude excl (cstate-fiber-at k st) of
    nil → geo-cascade k excl st
    cons e tail0 → geo-classify-tail k e tail0

geo-predict-upto : (Word → Word) → List Word → GeoChoice
geo-predict-upto q xs = geo-cascade 5 nil (cstate-feed (cstate-empty q) xs)

geo-predict : List Word → GeoChoice
geo-predict = geo-predict-upto (λ w → w)

