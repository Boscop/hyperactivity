-- rml16: from linear_memory.sail (it calls what is defined after it there)
-- (part of language-support)
rml16 : (lin_addr : Bits #48) → (r_x : Text) → MS (Bits #16)
rml16 lin_addr r_x =
  let one__plus_lin_addr : Bits #49
      one__plus_lin_addr = (bits_of_int (z-add (zpos #1) (bv-signed #48 lin_addr)) (zpos #49))
  in onS {Bool} {Bits #16} (canonical_address_p (bv-signed #49 one__plus_lin_addr)) (λ t'1 →
       λ σ →
         if t'1 then
           the (MS (Bits #16))
             (rb_ #48 (zpos #2) lin_addr r_x) σ
         else
           the (MS (Bits #16))
             (liftS {Bits #16} (x86_model_error {Bits #16} #491462078774)) σ)
