nk-trim-susp : NkTm → Word → NkEnv → NkOut → NkOut
nk-trim-susp b j nke-nil (nk-out fx n ws) = nk-out fx n nke-nil
nk-trim-susp b j (nke-cons w r) o =
  let o2 = nk-trim-susp b (%wsucc j) r o
      fx2 = nk-fx o2
      n2 = nk-n o2
      ws2 = nk-ws o2
  in if nk-uses-var #0 j b
       then nk-out fx2 n2 (nke-cons w ws2)
       else nk-out (nkf-op w nko-era (nkf-val n2 (nkv (hd-num #0) nke-nil) fx2)) (nk-s n2) (nke-cons n2 ws2)
