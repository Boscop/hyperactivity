-- Concrete multi-level self-collapsing example net (depth-4 bloated redundant net -> collapses to 1 gate!)
-- Raw: NOT(NOT(XOR(AND(x0, x1), XOR(AND(x2, ERA), DUP0(x3, x3))))) === AND(x0, x1)
tw-ex-bloated : INet
tw-ex-bloated =
  in-con #3
    (in-con #3
      (in-con #0
        (in-con #1 (in-wire #0) (in-wire #1))
        (in-con #0
          (in-con #1 (in-wire #2) in-era)
          (in-dup #0 (in-wire #3) (in-wire #3))))
      in-era)
    in-era
