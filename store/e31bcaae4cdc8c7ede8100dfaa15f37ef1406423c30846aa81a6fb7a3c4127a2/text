hn-eval : HNode → Nat
hn-eval (hn-lit v) = v
hn-eval (hn-add l r) = plus (hn-eval l) (hn-eval r)
hn-eval (hn-mul l r) = times (hn-eval l) (hn-eval r)
hn-eval (hn-dup2 s false) = let v = hn-eval s in plus v v
hn-eval (hn-dup2 s true)  = let v = hn-eval s in times v v
hn-eval (hn-face-guard cA cB body fb) =
  if clause-ok (toNat #4) (clause-meet (toNat #4) cA cB)
  then hn-eval body
  else fb
