nk-stuckm-at-wf : (ins : NkEnv) (h : Word) (n out : NkW) (ob : NkOut) →
  (nk-out-ok ins (nke-cons out nke-nil) n (nk-s n) ob ≡ true) →
  nk-out-ok ins (nke-cons out nke-nil) n n (nk-stuckm-at h n out ob) ≡ true
nk-stuckm-at-wf ins h n out (nk-out fx m ws) hob =
  let sn_m = nk-out-ok-le ins (nke-cons out nke-nil) n (nk-s n) (nk-out fx m ws) hob
      n_m = nk-wire-le-trans n (nk-s n) m (nk-wire-le-s n) sn_m
      pfx = nk-out-ok-fx ins (nke-cons out nke-nil) n (nk-s n) (nk-out fx m ws) hob
      hout = nk-in-set-hd out nke-nil n m
  in nk-out-ok-intro ins (nke-cons out nke-nil) n n (nkf-val out (nkv (hd-stuckm h) (nke-cons n ws)) fx) m nke-nil
       n_m
       (nk-and-intro (nk-in-set (nke-cons out nke-nil) n m out) (nk-fx-wf ins (nke-cons out nke-nil) n m fx) hout pfx)
       refl
