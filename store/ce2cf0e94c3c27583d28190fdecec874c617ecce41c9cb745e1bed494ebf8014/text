ms-cone-eval64 : Word → Word → Word → BoolCone → Word
ms-cone-eval64 x0 _  _  bc-var0        = bn-w64 x0
ms-cone-eval64 _  x1 _  bc-var1        = bn-w64 x1
ms-cone-eval64 _  _  x2 bc-var2        = bn-w64 x2
ms-cone-eval64 x0 x1 x2 (bc-not a)     = bn-not64 (ms-cone-eval64 x0 x1 x2 a)
ms-cone-eval64 x0 x1 x2 (bc-and a b)   = %wand (ms-cone-eval64 x0 x1 x2 a) (ms-cone-eval64 x0 x1 x2 b)
ms-cone-eval64 x0 x1 x2 (bc-or a b)    = %wor  (ms-cone-eval64 x0 x1 x2 a) (ms-cone-eval64 x0 x1 x2 b)
ms-cone-eval64 x0 x1 x2 (bc-xor a b)   = bn-xor64 (ms-cone-eval64 x0 x1 x2 a) (ms-cone-eval64 x0 x1 x2 b)
ms-cone-eval64 x0 x1 x2 (bc-nand a b)  = bn-not64 (%wand (ms-cone-eval64 x0 x1 x2 a) (ms-cone-eval64 x0 x1 x2 b))
ms-cone-eval64 x0 x1 x2 (bc-mux s a b) =
  let sv = ms-cone-eval64 x0 x1 x2 s
  in %wor (%wand sv (ms-cone-eval64 x0 x1 x2 a))
          (%wand (bn-not64 sv) (ms-cone-eval64 x0 x1 x2 b))
