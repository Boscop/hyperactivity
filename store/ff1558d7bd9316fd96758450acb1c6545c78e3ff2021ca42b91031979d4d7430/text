-- Theorem: the notation of a reading function is theorem-grade in every context. The reading of t
-- is the fiber over r c t's singleton; its center is r c t itself, and each (m , p) is reached along
-- p
reads-as-theorem-grade : {C M : Type} → (r : C → List Word → M) → (c : C) → theorem-grade (reads-as r) c
reads-as-theorem-grade {C} {M} r c t = ((r c t , λ i → r c t) , λ q i → (snd q i , λ j → snd q (i /\ j)))
