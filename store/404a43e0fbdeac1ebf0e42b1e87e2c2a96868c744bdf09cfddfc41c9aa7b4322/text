lcoef-same : Coefs → Coefs → Bool
lcoef-same cs ds =
  case cs return (λ w → Coefs → Bool) of
    cnil → λ ds → (case ds return (λ w → Bool) of cnil → true; ccons v2 c2 s → false)
    ccons v c r → λ ds →
      (case ds return (λ w → Bool) of
         cnil → false
         ccons v2 c2 s → andbt (weq v v2) (andbt (weq c c2) (rec r s)))
  ds
