nk-cases-src-u : Word → Opt Code
nk-cases-src-u g =
  if nk-is-pk-glob g then some (cwlit #0)
  else (if %weq g (nk-gix (code nk-ks-core0)) then def-source (nk-gix (code nk-ks-core))
  else (if %weq g (nk-gix (code nk-ks-mem0)) then def-source (nk-gix (code nk-ks-mem))
  else (if %weq g (nk-gix (code nk-ks-mach0)) then def-source (nk-gix (code nk-ks-mach))
  else (if %weq g (nk-gix (code nk-ks-chk0)) then def-source (nk-gix (code nk-ks-chk))
  else def-source g))))
