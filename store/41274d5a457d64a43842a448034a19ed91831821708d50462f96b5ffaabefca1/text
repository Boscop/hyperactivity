nk-dup-nil-plan-fx : (sl : NkSlots) (u a b n : NkW) (h : NkHd) →
  (nk-get sl u ≡ nks-pair (nko-dup a b) (nkv h nke-nil)) →
  nk-plan-fx sl u n ≡ nkf-put u nks-none (nkf-val a (nkv h nke-nil) (nkf-val b (nkv h nke-nil) nkf-nil))
nk-dup-nil-plan-fx sl u a b n h pu = cong (λ s → nk-fx (nk-plan s u n sl)) pu
