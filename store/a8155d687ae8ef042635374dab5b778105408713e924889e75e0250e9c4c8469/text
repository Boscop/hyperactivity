-- Kernel-checked certificate: emitted WASM starts with exact \0asm magic and non-empty valid length
dsp-wasm-magic-ok : List Word → Bool
dsp-wasm-magic-ok (cons b0 (cons b1 (cons b2 (cons b3 (cons v0 _))))) =
  andB (%weq b0 #0) (andB (%weq b1 #97) (andB (%weq b2 #115) (andB (%weq b3 #109) (%weq v0 #1))))
dsp-wasm-magic-ok _ = false
