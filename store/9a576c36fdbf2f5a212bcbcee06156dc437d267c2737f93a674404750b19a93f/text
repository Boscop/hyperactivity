-- a split witness refutes Warranted for EVERY target T: instead of trying to certify u,
-- the witness (m1, m2) directly identifies the discriminating experiment to run next
disagreement-refutes-warrant : (M O I R : Type 0) → (obs : M → O) → (y : O)
                             → (run : M → I → R) → (u : I)
                             → Disagreement M O I R obs y run u
                             → (target : R) → Neg (Warranted M O I R obs y run target u)
disagreement-refutes-warrant M O I R obs y run u d target w =
  snd (snd d) (concat (w (fst d)) (sym (w (fst (snd d)))))
