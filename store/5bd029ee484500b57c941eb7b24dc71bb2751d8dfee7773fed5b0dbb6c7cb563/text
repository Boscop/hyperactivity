s5-1-p7 = prose (cons "For de Bruijn variables the substitution algorithm is structural, with a lifted substitution under every binder:" (cons "```text" (cons "subst(Var(j), σ)          = σ[j]" (cons "subst(Lam(A, body), σ)    = Lam(subst(A, σ), subst(body, lift(σ)))" (cons "subst(App(f, x), σ)       = App(subst(f, σ), subst(x, σ))" (cons "subst(Pair(a, b), σ)     = Pair(subst(a, σ), subst(b, σ))" (cons "subst(PathLam(i, t), σ)  = PathLam(i, subst(t, σ))" (cons "subst(Comp(A, φ, u, a), σ) = Comp(subst(A, σ), φ[σ], subst(u, σ), subst(a, σ))" (cons "lift(σ)[0]               = Var(0)" (cons "lift(σ)[j+1]             = weaken(σ[j])" (cons "```" nil)))))))))))
