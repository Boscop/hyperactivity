mm-emit-list : List MetaCircuit → List Word → List Word
mm-emit-list nil tl = tl
mm-emit-list (cons (mcirc nm _ _ gs) rest) tl =
  let ng = ms-count-gates gs
  in ms-cat
       (cons "inline uint32_t opt_" (cons nm (cons "(uint32_t w0, uint32_t w1, uint32_t w2, uint32_t w3) {" (cons ce-nl
       (cons (mm-gates #4 gs
         (ms-cat (cons "  return w" (cons (ce-dec (%wadd #3 ng)) (cons ";" (cons ce-nl
                 (cons "}" (cons ce-nl (cons (mm-emit-list rest tl) nil))))))))) nil)))))
