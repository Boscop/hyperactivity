-- congruence in both arguments at once, one line in a cubical setting: both paths taken at the same point
-- of the interval
cong-material-bath : (h : Material → Bath → Nat) → (k1 : Material) → (k2 : Material) → k1 ≡ k2 → (v1 : Bath) → (v2 : Bath) → v1 ≡ v2 → h k1 v1 ≡ h k2 v2
cong-material-bath h k1 k2 q v1 v2 p = λ i → h (q i) (p i)
