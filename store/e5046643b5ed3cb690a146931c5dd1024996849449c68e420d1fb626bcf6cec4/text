ks-stage-bit : Word → Word → Word → List Word
ks-stage-bit st stride i =
  let prev = %wsub st #1
      gcur = ks-gn st i
      pcur = ks-pn st i
      gprv = ks-gn prev i
      pprv = ks-pn prev i
  in if %wlt i stride then
       sv-concat
         (cons (epfl-buf1 gprv gcur)
         (cons (epfl-buf1 pprv pcur) nil))
     else
       let j    = %wsub i stride
           gj   = ks-gn prev j
           pj   = ks-pn prev j
           pg   = sv-concat (cons "pg" (cons (epfl-dec st) (cons "_" (cons (epfl-dec i) nil))))
       in sv-concat
            (cons (epfl-gate2 pprv gj pg "11")
            (cons (epfl-or2-blif gprv pg gcur)
            (cons (epfl-gate2 pprv pj pcur "11") nil)))
