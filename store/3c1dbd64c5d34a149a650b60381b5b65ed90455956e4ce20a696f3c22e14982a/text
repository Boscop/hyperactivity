-- the block-diagonal lemma: the count of diag(a, C) on the padded witness
cl-block-count : (A : Type) → (z one : A) → (ad mu : A → A → A) → (isz neg : A → Bool) → (a : A) → (c : List A → List A → A) → (ws : List (List A)) →
  ad (mu a (mu one one)) (c nil nil) ≡ a → ((w : List A) → ad (mu a (mu one z)) (c nil w) ≡ z) → ((w : List A) → ad (mu a (mu z one)) (c w nil) ≡ z) →
  ((w w2 : List A) → ad (mu a (mu z z)) (c w w2) ≡ c w w2) → isz z ≡ true → isz a ≡ false →
  cl-count A z isz neg (cl-gram A (cl-bd A z ad mu a c) (cl-wit A z one ws)) ≡
  (if neg a then suc (fst (cl-count A z isz neg (cl-gram A c ws))) else fst (cl-count A z isz neg (cl-gram A c ws)) , snd (cl-count A z isz neg (cl-gram A c ws)))
cl-block-count A z one ad mu isz neg a c ws hA hB hC hD hz ha = cl-tr (Nat × Bool)
  (cl-count A z isz neg (cl-gram A (cl-bd A z ad mu a c) (cl-wit A z one ws)))
  (cl-count A z isz neg (cl-top A (List A) z a ws (cl-gram A c ws)))
  (if neg a then suc (fst (cl-count A z isz neg (cl-gram A c ws))) else fst (cl-count A z isz neg (cl-gram A c ws)) , snd (cl-count A z isz neg (cl-gram A c ws)))
  (λ i → cl-count A z isz neg (cl-tr (List (List A)) (cl-gram A (cl-bd A z ad mu a c) (cl-wit A z one ws)) (cl-mid A z a c ws) (cl-top A (List A) z a ws (cl-gram A c ws))
    (cl-bd-gram A z one ad mu a c ws hA hB hC hD) (cl-mid-top A z a c ws) i))
  (cl-bd-count A (List A) z a isz neg hz ha ws (cl-gram A c ws))
