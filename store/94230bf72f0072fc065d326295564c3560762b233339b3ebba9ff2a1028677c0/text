nk-tg-pf : NkTm → NkTm → NkTm → NkTm → NkTm → NkTm → NkTm
nk-tg-pf aline sysb psi u0 a1 b =
  let ctr = nk-app (nk-p2 (nk-app (nk-el b) nk-i1)) a1
  in nk-hcomp (nk-fiber (nk-app (nk-tl b) nk-i1) (nk-app aline nk-i1) (nk-p1 (nk-app (nk-el b) nk-i1)) a1)
       (nk-sys (nk-cons (nk-br psi (nk-lam (nk-app (nk-app (nk-up (nk-p2 ctr)) (nk-up (nk-mkpair u0 (nk-lam (nk-up a1))))) (nk-var #0)))) (nk-tg-fibs (nk-p2 ctr) psi u0 a1 sysb)))
       (nk-p1 ctr)
