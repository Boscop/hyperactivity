-- Universal Mechanized Compiler Soundness: holds for EVERY `e : HExpr` and ALL `Word` inputs!
ic-compile-sound : (e : HExpr) →
  Path (Word × Word) (inet-readout e (fst (inet-run-cnt (toNat #2) (ic-graph e))))
                     (hexpr-eval-hi e , hexpr-eval-lo e)
ic-compile-sound (hx-lit v)           = refl
ic-compile-sound (hx-add x y)         = refl
ic-compile-sound (hx-dup-add v)       = refl
ic-compile-sound (hx-par-add a b c d) = refl
