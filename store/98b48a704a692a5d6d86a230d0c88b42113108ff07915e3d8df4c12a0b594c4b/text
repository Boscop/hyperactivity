-- the type found against the type expected (nk-nil: none expected): the same, or a universe
-- found where a universe at least as high is expected
nk-agree : NkTm → NkTm → NkTm
nk-agree ty nk-nil = ty
nk-agree ty ex = if nk-tm-eq ty ex then ty else (if nk-con-is ty #2 then (if nk-con-is ex #2 then (if %wlt (nk-lvl ex) (nk-lvl ty) then nk-fail else ex) else nk-fail) else nk-fail)
