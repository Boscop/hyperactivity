-- the offset of field i of variant v of an ADT or tuple type
rm-field-off : RCx → RTy → Word → Word → RSt Word
rm-field-off cx ty v i =
  sr-bind (rm-lay (cx-ls cx) ty) (λ l →
  sr-bind (rm-nth (ly-variants-of l) v (ri-no-variant ty v)) (λ vl →
  sr-map rf-off (rm-nth (vl-fields-of vl) i (ri-no-field ty i))))
