-- the spanning trees of a network of n vertices, by deletion and contraction: a tree either omits the
-- first line or contains it, and the trees containing it are the trees of the network with the line's two
-- ends identified; a line from a vertex to itself is in no tree. The fuel f is the number of lines, which
-- each step lowers by one.
trees-by : Nat → Nat → List FaradayLine → Nat
trees-by f n ls = case f of
  zero → (if eqb n (suc zero) then suc zero else zero)
  suc g → (case ls of
  nil → (if eqb n (suc zero) then suc zero else zero)
  cons l rest → (if eqb (fst l) (snd l) then trees-by g n rest
    else plus (trees-by g n rest) (trees-by g (monus n (suc zero)) (identify-ends (fst l) (snd l) rest))))
