-- ---------------------------------------------------------------- the decoder
-- a 4-byte field at i and an 8-byte field at i, from a message of n bytes with i + 8 ≤ n
decode : (n : Nat) → Bytes n → (i : Nat) → le (plus i 8) n → UInt32 × Int64
decode n b i h = (load32 n b i (bound-i4 i n h) , load64 n b i h)
