-- (part of language-support)
write_iptr : (proc_mode' : proc_mode) → (iptr : Bits #48) → MS Unit
write_iptr proc_mode' iptr =
  λ σ →
    if (in_64bit_mode proc_mode') then
      the (MS Unit)
        (write_rip iptr) σ
    else if (in_compatibility_mode proc_mode') then
      the (MS Unit)
        (bindS {List (Bits #16)} {Unit} (getS {List (Bits #16)} x86-seg_hidden_attrs) (λ seg_hidden_attrs'2 →
           let cs_attr : Bits #16
               cs_attr = (vec-get {Bits #16} #0 seg_hidden_attrs'2 #1)
               cs_d : Bits #1
               cs_d = (code_segment_descriptor_attributesbits-d cs_attr)
           in λ σ →
                if (weq cs_d #1) then
                  the (MS Unit)
                    (write_rip (bv-zext #32 #48 (bv-trunc #48 #32 iptr))) σ
                else
                  the (MS Unit)
                    (bindS {Bits #48} {Unit} read_rip (λ rip_var →
                       let rip_new : Bits #48
                           rip_new = (changeSlice_bits #48 rip_var (zpos #0) (zpos #16) (bv-trunc #48 #16 iptr))
                       in write_rip rip_new)) σ)) σ
    else
      the (MS Unit)
        (retS {Unit} unit) σ
