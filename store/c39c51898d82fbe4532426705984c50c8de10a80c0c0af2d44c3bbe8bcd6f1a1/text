-- Adlam–Rovelli (2022) Cross-Perspective Link:
-- When Wigner physically measures Friend's record (so Friend's fact is stable for
-- Wigner's post-interaction observer oW, witnessed by `link : StableFor H oF oW`),
-- Wigner's reading yW uniquely determines Friend's reading across the entire fiber
-- of histories compatible with yW.
rqm-cross-perspective-link :
  (H : Type 0) → (oF oW : Observer H) →
  (link : StableFor H oF oW) →
  (yW : obs-type H oW) → (h : H) →
  RelativeFact H oW h yW →
  RelativeFact H oF h (fst link yW)
rqm-cross-perspective-link H oF oW link yW h pW =
  stable-fiber H oF oW link yW h pW
