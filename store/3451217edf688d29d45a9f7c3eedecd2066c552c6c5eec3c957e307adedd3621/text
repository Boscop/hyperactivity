-- Proof-Carrying Metacircular Compiler Package: emits wire graph WITH its soundness witness
ic-compile-cert : (e : HExpr) →
  (g : List INetSlot) × Path (Word × Word) (inet-readout e (fst (inet-run-cnt (toNat #2) g)))
                                           (hexpr-eval-hi e , hexpr-eval-lo e)
ic-compile-cert e = (ic-graph e , ic-compile-sound e)
