-- a family of sets over A fills over every 4-cube of A (isOfHLevel→isOfHLevelDep 4, for sets): the
-- 3-cubes over the 4-cube's sections, with fixed faces, form a line of propositions (each a path over a
-- line of propositions, down to paths in a set), so the 3-cube over t and the one over u are joined
fill4OverSets : {A : Type} → (B : A → Type) → ((a : A) → isSet (B a)) →
  {x y : A} {p q : x ≡ y} {r s : p ≡ q} {t u : r ≡ s} → (c : t ≡ u) →
  {b0 : B x} {b1 : B y} {bp : PathP (λ l → B (p l)) b0 b1} {bq : PathP (λ l → B (q l)) b0 b1}
  {br : PathP (λ k → PathP (λ l → B (r k l)) b0 b1) bp bq} {bs : PathP (λ k → PathP (λ l → B (s k l)) b0 b1) bp bq} →
  (bt : PathP (λ j → PathP (λ k → PathP (λ l → B (t j k l)) b0 b1) bp bq) br bs) →
  (bu : PathP (λ j → PathP (λ k → PathP (λ l → B (u j k l)) b0 b1) bp bq) br bs) →
  PathP (λ i → PathP (λ j → PathP (λ k → PathP (λ l → B (c i j k l)) b0 b1) bp bq) br bs) bt bu
fill4OverSets {A} B setB {x} {y} {p} {q} {r} {s} {t} {u} c {b0} {b1} {bp} {bq} {br} {bs} bt bu =
  let propDp = isPropPathP (λ l → B (q l)) (setB y) b0 b1
      propSq = isPropPathP (λ k → PathP (λ l → B (s k l)) b0 b1) (isProp→isSet propDp) bp bq
      propC3 = isPropPathP (λ j → PathP (λ k → PathP (λ l → B (u j k l)) b0 b1) bp bq) (isProp→isSet propSq) br bs
  in isProp→PathP (λ i → PathP (λ j → PathP (λ k → PathP (λ l → B (c i j k l)) b0 b1) bp bq) br bs) propC3 bt bu
