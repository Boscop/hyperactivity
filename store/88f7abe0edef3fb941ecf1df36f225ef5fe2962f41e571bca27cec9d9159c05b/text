one-if-strict1 : {p p' : Bool} → isTrue p → isTrue (not p') → (c c' : Nat) → ltn c c' ≡ false → ltn (plus (one-if p') c') (plus (one-if p) c) ≡ true
one-if-strict1 hp np c c' e =
  (case p return λ y → isTrue y → ltn (plus (one-if p') c') (plus (one-if y) c) ≡ true of
     true → λ u → (case p' return λ z → isTrue (not z) → ltn (plus (one-if z) c') (suc c) ≡ true of true → λ v → Empty-rec v; false → λ v → ltn-to-suc c' c e) np
     false → λ u → Empty-rec u) hp
