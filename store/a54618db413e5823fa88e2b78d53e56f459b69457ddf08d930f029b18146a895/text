scale-le : (e : Env) (c : Word) (l r : LinCode) → Lew (wev e l) (wev e r) → Lew (wev e (scale c l)) (wev e (scale c r))
scale-le e c l r h =
  %welimP (λ v → Lew (wev e (scale v l)) (wev e (scale v r))) c (lew-refl #0) (λ n k → le-add (wev e (scale n l)) (wev e (scale n r)) (wev e l) (wev e r) k h)
