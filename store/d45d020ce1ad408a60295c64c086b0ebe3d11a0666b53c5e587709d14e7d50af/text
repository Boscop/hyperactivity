-- a nonempty set closed backwards within the list: the decision answers false
tso-acyclic-closed : {A : Type} → (rel : A → A → Bool) → (S : A → Type) → (ns : List A) → TsoBack rel S →
                     ((c : A) → S c → TsoIn c ns) → (x : A) → S x → isTrue (tso-acyclic rel ns) → Empty
tso-acyclic-closed rel S ns bk sub x sx h =
  (case tso-peels (tso-len ns) rel ns return (λ l → TsoIn x l → isTrue (case l return (λ w → Bool) of nil → true; cons y r → false) → Empty) of
     nil → λ m2 h2 → m2
     cons y r → λ m2 h2 → h2) (tso-peels-keep (tso-len ns) rel S ns bk sub x sx) h
