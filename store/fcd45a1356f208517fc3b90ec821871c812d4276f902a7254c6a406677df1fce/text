-- u ∈ [a, b], v ∈ [c, d]: below every corner product means below u·v
bil-low : (u v a b c d m : Nat × Nat) → zle a u → zle u b → zle c v → zle v d → zle m (zmul a c) → zle m (zmul a d) → zle m (zmul b c) → zle m (zmul b d) → zle m (zmul u v)
bil-low u v a b c d m hau hub hcv hvd mac mad mbc mbd = zsplit v (zle m (zmul u v))
  (λ hv → zle-trans m (zmul a v) (zmul u v)
     (zsplit a (zle m (zmul a v))
        (λ ha → zle-trans m (zmul a c) (zmul a v) mac (zle-comm2 c a v a (zle-mul-nonneg c v a ha hcv)))
        (λ ha → zle-trans m (zmul a d) (zmul a v) mad (zle-comm2 d a v a (zle-mul-nonpos v d a ha hvd))))
     (zle-mul-nonneg a u v hv hau))
  (λ hv → zle-trans m (zmul b v) (zmul u v)
     (zsplit b (zle m (zmul b v))
        (λ hb → zle-trans m (zmul b c) (zmul b v) mbc (zle-comm2 c b v b (zle-mul-nonneg c v b hb hcv)))
        (λ hb → zle-trans m (zmul b d) (zmul b v) mbd (zle-comm2 d b v b (zle-mul-nonpos v d b hb hvd))))
     (zle-mul-nonpos u b v hv hub))
