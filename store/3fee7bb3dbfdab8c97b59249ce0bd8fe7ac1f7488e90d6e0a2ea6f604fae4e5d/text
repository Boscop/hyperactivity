-- b1 + 2A = b2 + 2B gives A = B and b1 = b2
split-half-eq : (b1 b2 : Bool) → (A B : Nat) → plus (bitn b1) (times 2 A) ≡ plus (bitn b2) (times 2 B) → A ≡ B
split-half-eq b1 b2 A B e = transN (symN (fst-cong (bhalf (plus (bitn b1) (times 2 A))) (the (Nat × Bool) (A , b1)) (half-of b1 A)))
  (transN (fst-cong (bhalf (plus (bitn b1) (times 2 A))) (bhalf (plus (bitn b2) (times 2 B))) (bhalf-cong (plus (bitn b1) (times 2 A)) (plus (bitn b2) (times 2 B)) e)) (fst-cong (bhalf (plus (bitn b2) (times 2 B))) (the (Nat × Bool) (B , b2)) (half-of b2 B)))
