-- UNIVERSAL THEOREM 1B (EXACT FRACTAL DIAMETER `2*k` FOR ALL SELF-SIMILAR LEVELS `k : Nat`, 0 POSTULATES):
dm-thm-fractal-clebsch-diam : (k : Nat) → dm-clebsch-diam k ≡ dm-double-nat k
dm-thm-fractal-clebsch-diam zero    = refl
dm-thm-fractal-clebsch-diam (suc k) = cong (λ n → suc (suc n)) (dm-thm-fractal-clebsch-diam k)
