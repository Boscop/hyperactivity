-- every entry of the root-sum terms ts, exactly: rows i < ni (source states), columns j < nj (target coordinates)
entries-row : List PCand → List Term → Nat → Nat → Nat → List (Bool × List PRad)
entries-row cs ts i j nj = case nj of
  zero → nil
  suc g → cons (half-trace-of cs (terms-entry i j ts)) (entries-row cs ts i (suc j) g)
