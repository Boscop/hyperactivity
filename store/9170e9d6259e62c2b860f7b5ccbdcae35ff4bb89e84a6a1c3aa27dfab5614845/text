-- the minimum of four is below each, the maximum above each
min4-le : (A B C D : BZ) → bcanon (snd A) ≡ true → bcanon (snd B) ≡ true → bcanon (snd C) ≡ true → bcanon (snd D) ≡ true →
  (zle (zv (bz-min (bz-min A B) (bz-min C D))) (zv A) × zle (zv (bz-min (bz-min A B) (bz-min C D))) (zv B)) × (zle (zv (bz-min (bz-min A B) (bz-min C D))) (zv C) × zle (zv (bz-min (bz-min A B) (bz-min C D))) (zv D))
min4-le A B C D cA cB cC cD =
  ((zle-trans (zv (bz-min (bz-min A B) (bz-min C D))) (zv (bz-min A B)) (zv A) (fst (bz-min-sound (bz-min A B) (bz-min C D) (bz-min-canon A B cA cB) (bz-min-canon C D cC cD))) (fst (bz-min-sound A B cA cB)) ,
    zle-trans (zv (bz-min (bz-min A B) (bz-min C D))) (zv (bz-min A B)) (zv B) (fst (bz-min-sound (bz-min A B) (bz-min C D) (bz-min-canon A B cA cB) (bz-min-canon C D cC cD))) (snd (bz-min-sound A B cA cB))) ,
   (zle-trans (zv (bz-min (bz-min A B) (bz-min C D))) (zv (bz-min C D)) (zv C) (snd (bz-min-sound (bz-min A B) (bz-min C D) (bz-min-canon A B cA cB) (bz-min-canon C D cC cD))) (fst (bz-min-sound C D cC cD)) ,
    zle-trans (zv (bz-min (bz-min A B) (bz-min C D))) (zv (bz-min C D)) (zv D) (snd (bz-min-sound (bz-min A B) (bz-min C D) (bz-min-canon A B cA cB) (bz-min-canon C D cC cD))) (snd (bz-min-sound C D cC cD))))
