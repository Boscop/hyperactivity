-- the first n paragraphs of lines (a paragraph ends at an empty line), and the lines after them
paragraphs : Nat → List (List Word) → List (List Word)
paragraphs zero ls = nil
paragraphs (suc n) nil = nil
paragraphs (suc zero) (cons nil ls) = nil
paragraphs (suc (suc m)) (cons nil ls) = cons nil (paragraphs (suc m) ls)
paragraphs (suc n) (cons (cons x l) ls) = cons (cons x l) (paragraphs (suc n) ls)
