-- nk-step-commute-ok: steps at two wires commute when their plans may be done in either order and
-- each changes neither the other's wire nor the wire the other reads (part of machine-in-hyperactive)
nk-step-commute-ok : (sl : NkSlots) (u1 n1 u2 n2 : Word) →
  nk-oks (nk-plan-fx sl u1 n1) (nk-plan-fx sl u2 n2) →
  nk-apart u1 (nk-plan-fx sl u2 n2) → nk-apart (nk-rw (nk-get sl u1) u1) (nk-plan-fx sl u2 n2) →
  nk-apart u2 (nk-plan-fx sl u1 n1) → nk-apart (nk-rw (nk-get sl u2) u2) (nk-plan-fx sl u1 n1) →
  nk-same (nk-step-at u2 n2 (nk-step-at u1 n1 sl)) (nk-step-at u1 n1 (nk-step-at u2 n2 sl))
nk-step-commute-ok sl u1 n1 u2 n2 ap a1 a2 b1 b2 x =
  nk-step-as-do sl u2 n2 (nk-plan-fx sl u1 n1) b1 b2 x
  ∙ (nk-do-swap-ok (nk-plan-fx sl u1 n1) (nk-plan-fx sl u2 n2) sl ap x
  ∙ sym (nk-step-as-do sl u1 n1 (nk-plan-fx sl u2 n2) a1 a2 x))
