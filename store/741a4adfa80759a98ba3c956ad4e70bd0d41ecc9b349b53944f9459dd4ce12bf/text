-- compare-exchange is the strong form: it answers whether it stored and the value it saw
data Atom =
    at-load (o : MOrd) (a : Word)
  | at-store (o : MOrd) (a : Word) (v : Word)
  | at-xchg (o : MOrd) (a : Word) (v : Word)
  | at-cas (so : MOrd) (fo : MOrd) (a : Word) (old : Word) (new : Word)
  | at-fence (o : MOrd)
