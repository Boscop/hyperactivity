-- transport in a line of function types: a function of an x at the end of the domain line; x is
-- carried back along the domain line, the function applied there, and the result carried forward
-- along the codomain line at x's filler
nk-transp-pi : NkTm → NkTm → NkTm → NkTm → NkTm
nk-transp-pi aline fline phi f =
  nk-lam (nk-transp
    (nk-lam (nk-app (nk-app (nk-up2 fline) (nk-var #0)) (nk-transp (nk-lam (nk-app (nk-up3 aline) (nk-or-i (nk-var #1) (nk-neg (nk-var #0))))) (nk-or-i (nk-up2 phi) (nk-var #0)) (nk-var #1))))
    (nk-up phi)
    (nk-app (nk-up f) (nk-transp (nk-lam (nk-app (nk-up2 aline) (nk-neg (nk-var #0)))) (nk-up phi) (nk-var #0))))
