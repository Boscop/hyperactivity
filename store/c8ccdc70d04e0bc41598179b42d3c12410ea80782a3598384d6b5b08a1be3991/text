-- an expression of the certified quantities: variables (inputs, each an interval), integers, rationals n/(d+1), +, −, ×, ÷
data IE = ie-var (k : Nat) | ie-int (k : Nat) | ie-rat (n : Nat) (d : Nat)
        | ie-add (a : IE) (b : IE) | ie-sub (a : IE) (b : IE) | ie-mul (a : IE) (b : IE) | ie-div (a : IE) (b : IE)
