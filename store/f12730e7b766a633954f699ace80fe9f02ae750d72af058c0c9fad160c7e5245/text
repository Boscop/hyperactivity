-- a command's sync with the served source, when one is named: what is unpublished published, then
-- the server's changes taken (at the start, `pull` true), or what the command changed published (at the end)
h-sync-at : List Word → List Word → Bool → Sum Unit (List Word) → Proc W Unit
h-sync-at st m pull (inl u) = ret unit
h-sync-at st m pull (inr srv) = bind (h-env "HYPERACTIVE_TOKEN") (λ tk → bind (h-list (list-append st "/before")) (λ hs →
  bind (h-publish-all st srv (h-pointer-or tk) m hs) (λ ok → if orB pull (h-not ok) then h-pull st m srv else ret {lzero} {W} unit)))
