-- `;` (#59), `|` (#124), `&` (#38), `$` (#36), `` ` `` (#96), `>` (#62), `<` (#60), `\n` (#10)
ap-has-shell-meta : List Word → Bool
ap-has-shell-meta nil = false
ap-has-shell-meta (cons c cs) =
  if orB (%weq c #59)
    (orB (%weq c #124)
    (orB (%weq c #38)
    (orB (%weq c #36)
    (orB (%weq c #96)
    (orB (%weq c #62)
    (orB (%weq c #60) (%weq c #10)))))))
  then true
  else ap-has-shell-meta cs

ap-has-wrapper-bin : List Word → Bool
ap-has-wrapper-bin cmd =
  orB (h-prefix "env " cmd)
  (orB (h-prefix "sudo " cmd)
  (orB (h-prefix "sh -c" cmd)
  (orB (h-prefix "bash -c" cmd)
       (h-prefix "zsh -c" cmd))))

-- A command is zero-whack-a-mole safe iff EITHER:
--   * `bypassSandbox == false` (runs auto-approved inside Standard Sandbox with 0 prompts!), OR
--   * `bypassSandbox == true` AND it invokes ONE bare target binary with zero shell metacharacters/wrappers!
ap-is-whackamole-free : Bool → List Word → Bool
ap-is-whackamole-free false cmd = true
ap-is-whackamole-free true  cmd =
  andB (h-not (ap-has-shell-meta cmd))
       (h-not (ap-has-wrapper-bin cmd))

