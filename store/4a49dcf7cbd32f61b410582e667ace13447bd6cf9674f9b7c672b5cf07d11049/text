fits-eq32 : (k i : Nat) → plus (times k 4) (plus (times i 4) 4) ≡ times (plus k (suc i)) 4
fits-eq32 k i =
  calc plus (times k 4) (plus (times i 4) 4) ≡ plus (times k 4) (times (suc i) 4) by (λ j → plus (times k 4) (plus-comm (times i 4) 4 j))
                                             ≡ times (plus k (suc i)) 4 by sym (times-distr k (suc i) 4)
