urewrite-pair : UCell → UCell → Nat → Word → Word → List Word → URewrite
urewrite-pair (ucell kA tA cA a1 a2) (ucell kB tB cB b1 b2) live f0 f1 restFree =
  if clause-ok (toNat #4) (clause-meet (toNat #4) cA cB)
  then
    (case kA of
       uc-era → urw-erase2 b1 b2
       uc-con →
         (case kB of
            uc-era → urw-erase2 a1 a2
            uc-con →
              (if %weq tA tB
               then urw-annihilate (a1 , b1) (a2 , b2)
               else urw-commute4 (hpool (suc (suc (suc (suc live)))) restFree))
            uc-dup → urw-commute4 (hpool (suc (suc (suc (suc live)))) restFree))
       uc-dup →
         (case kB of
            uc-era → urw-erase2 a1 a2
            uc-con → urw-commute4 (hpool (suc (suc (suc (suc live)))) restFree)
            uc-dup →
              (if %weq tA tB
               then urw-annihilate (a1 , b1) (a2 , b2)
               else urw-commute4 (hpool (suc (suc (suc (suc live)))) restFree))))
  else urw-erase2 a1 b1
