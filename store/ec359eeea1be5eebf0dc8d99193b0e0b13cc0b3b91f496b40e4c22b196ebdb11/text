-- (part of language-support)
gpr_and_spec_2 : (dst' : Bits #16) → (src : Bits #16) → (input_rflags : rflagsbits) → MF ((Bits #16) × rflagsbits × rflagsbits)
gpr_and_spec_2 dst' src input_rflags =
  let result' : Bits #16
      result' = (bv-slice #16 (bv-and #16 dst' src) #15 #0)
      cf' : ZI
      cf' = (zpos #0)
  in bindF {Bits #1} {((Bits #16) × rflagsbits × rflagsbits)} (pf_spec16 result') (λ pf' →
       let zf : Bits #1
           zf = (zf_spec (bv-unsigned #16 result'))
           sf : Bits #1
           sf = (sf_spec16 result')
           of' : ZI
           of' = (zpos #0)
           output_rflags : rflagsbits
           output_rflags =
             (rflagsbits-set-of (rflagsbits-set-sf (rflagsbits-set-zf (rflagsbits-set-pf (rflagsbits-set-cf input_rflags (bits_of_int cf' (zpos #1))) pf') zf) sf) (bits_of_int of' (zpos #1)))
           undefined_flags : rflagsbits
           undefined_flags = (rflagsbits-set-af #0 #1)
       in retF {((Bits #16) × rflagsbits × rflagsbits)} (result' , output_rflags , undefined_flags))
