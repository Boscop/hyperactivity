-- the end of the parameter objects of a call, last first: destroyed, their storage released
cx-parms-end : CxR → List CType → CxCall → CxU → CxEv Unit
cx-parms-end (cxr-cons x xs) ts call u = case ts of
  nil → cx-stop {Unit} st-ill-typed
  cons t ts2 → cx-then {Unit} {Unit} (cx-parms-end xs ts2 call u) (case x of
    cxr-parm p owned → (case owned of
      true → cx-then {Unit} {Unit} (cx-destroy t call u p) (cx-release ak-auto p)
      false → cx-ret {Unit} unit)
    _ → cx-stop {Unit} st-ill-typed)
cx-parms-end r ts call u = cx-ret {Unit} unit
