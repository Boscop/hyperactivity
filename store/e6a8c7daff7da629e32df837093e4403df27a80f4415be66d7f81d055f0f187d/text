--      .sh, .c, .h, .cu, .metal, .sv, .qasm, .tcl, .rs, .cpp, .ts) outside the exact frozen legacy list
--      (`g-legacy-ext`, which may only shrink, never grow).
--   2. ZERO new raw foreign-code string smuggling inside lib/*.hypercubical outside the audited compiler
--      TCB (`lib/ir/`, `lib/emit-c`, `lib/native*`, `lib/silicon/`, `lib/server`) and frozen legacy engines.
g-has-banned-ext : List Word → Bool
g-has-banned-ext p =
  orB (h-ends ".js" p)
  (orB (h-ends ".html" p)
  (orB (h-ends ".css" p)
  (orB (h-ends ".py" p)
  (orB (h-ends ".sh" p)
  (orB (h-ends ".c" p)
  (orB (h-ends ".h" p)
  (orB (h-ends ".cu" p)
  (orB (h-ends ".metal" p)
  (orB (h-ends ".sv" p)
  (orB (h-ends ".qasm" p)
  (orB (h-ends ".tcl" p)
  (orB (h-ends ".rs" p)
  (orB (h-ends ".cpp" p)
       (h-ends ".ts" p))))))))))))))

