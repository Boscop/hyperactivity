g-check-chunks : List Word → List (List Word) → Proc W (List Word)
g-check-chunks _ nil = ret {lzero} {W} nil
g-check-chunks path (cons ch cs) =
  if h-null ch then g-check-chunks path cs
  else bind (h-read (list-append "store/" (list-append ch "/text"))) (λ mt →
    case mt of
      inl _ → g-check-chunks path cs
      inr txt →
        if g-smuggles-foreign txt
        then ret {lzero} {W} (list-append "refused: " (list-append path (list-append " smuggles raw foreign code strings outside the compiler TCB (lib/ir/); lower from certified PolyOptCert/F2OptCert/QCircuit/KExpr ASTs (lib/guard.hypercubical)" (cons #10 nil))))
        else g-check-chunks path cs)

g-check-root-lines : List (List Word) → Proc W (List Word)
g-check-root-lines nil = ret {lzero} {W} nil
g-check-root-lines (cons ln lns) =
  let ws = h-split #32 ln
  in case ws of
    nil → g-check-root-lines lns
    cons hx rest →
      case rest of
        nil → g-check-root-lines lns
        cons mh _ →
          if h-eq hx "names" then g-check-root-lines lns
          else let p = h-unhex hx
               in if g-banned-ext p then
                    bind (g-check-root-lines lns) (λ more →
                      ret {lzero} {W} (list-append "refused: " (list-append p (list-append " introduces a banned non-.hypercubical file extension; compose pure .hypercubical instead (lib/guard.hypercubical)" (cons #10 more)))))
                  else if andB (h-prefix "lib/" p) (andB (h-ends ".hypercubical" p) (h-not (g-tcb-or-legacy p)))
                  then bind (h-read (list-append "store/" (list-append mh "/module"))) (λ mm →
                    case mm of
                      inl _ → g-check-root-lines lns
                      inr modt → bind (g-check-chunks p (h-split #10 modt)) (λ err →
                        bind (g-check-root-lines lns) (λ more → ret {lzero} {W} (list-append err more))))
                  else g-check-root-lines lns

g-foreign-refused : Proc W (List Word)
g-foreign-refused =
  bind (h-read "store/ROOT/root") (λ mr →
    case mr of
      inl _ → ret {lzero} {W} nil
      inr rh →
        let rhash = os-strip rh
        in bind (h-read (list-append "store/" (list-append rhash "/root"))) (λ mrt →
          case mrt of
            inl _ → ret {lzero} {W} nil
            inr rtxt → g-check-root-lines (h-split #10 rtxt)))

g-judge : List (List Word × (List Word × (Word × Word))) → Proc W Unit
g-judge es =
  let bad = g-refused es
  in if h-not (h-null bad) then bind (h-say bad) (λ u → exit #1)
     else bind g-foreign-refused (λ fbad →
       if h-null fbad then exit #0
       else bind (h-say fbad) (λ u → exit #1))

g-verdict : Sum (List Word) (List (List Word × (List Word × (Word × Word)))) → Proc W Unit
g-verdict (inl why) = h-fail why
g-verdict (inr es) = g-judge es



-- the index read: its header (DIRC, the version, the count), then its entries
g-read-index : Word → Word → List Word → Proc W Unit
g-read-index base len hd =
  if h-prefix "DIRC" hd then
    (if andB (wlt #1 (h-be (h-take (toNat #4) (h-drop "DIRC" hd)))) (wlt (h-be (h-take (toNat #4) (h-drop "DIRC" hd))) #4)
     then bind (g-entries base len (h-be (h-take (toNat #4) (h-drop "DIRC" hd))) #12 (toNat (h-be (h-drop "DIRCvers" hd)))) g-verdict
     else h-fail "the index is not version 2 or 3, which this guard reads")
  else h-fail "the index does not begin with DIRC"

g-index : List Word → Sum Unit (Word × Word) → Proc W Unit
g-index ipath (inl u) = h-fail (list-append "the guard cannot read the index " ipath)
g-index ipath (inr bl) = bind (h-peek (fst bl) (toNat #12)) (λ hd → g-read-index (fst bl) (snd bl) hd)



-- the index git commits: GIT_INDEX_FILE when git sets it, else .git/index
g-or-default : Sum Unit (List Word) → List Word
g-or-default (inl u) = ".git/index"
g-or-default (inr p) = p

g-main : Proc W Unit
g-main = bind (h-env "GIT_INDEX_FILE") (λ e → bind (h-file (g-or-default e)) (g-index (g-or-default e)))



-- g-run: the guard, run before every commit: only hyperactive code and prose enter the repository, each piece of prose held once (part of product-implementation)
g-run : Step W Unit
g-run = to-step g-main

#run g-run

