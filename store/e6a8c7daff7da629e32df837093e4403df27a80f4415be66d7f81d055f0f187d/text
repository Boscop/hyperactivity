-- an entry may be committed: hyperactive code, prose, or a file of g-frozen as it was
g-member : List Word → List Word → List (List Word × List Word) → Bool
g-member p h nil = false
g-member p h (cons e r) = if andB (h-eq p (fst e)) (h-eq h (snd e)) then true else g-member p h r

-- Decision (2026-11-16, Avik: "there will be no file system (asap)"; "all steps no questions"): the
-- code and the documents are the source, objects of store/ (src/store.c, lib/host.cub h-source), and
-- no file holds them; git carries store/ until a served store does. A commit may hold store/'s
-- objects, the root files the tools and legal/repo front door read from disk (LICENSE, CLAUDE.md,
-- README.md), and g-frozen; a .cub or .md file anywhere else is refused. The core changes so that the
-- machine reads each module and document from the source (src/syntax.c src_text, record_source;
-- src/lang.c load_file, --ingest, --record, the machine run as hyperactive or as the pre-commit hook;
-- src/store.c source_dir); ./hyperactive and .githooks/pre-commit become links to the machine.
g-allowed : List Word → List Word → Bool
g-allowed p h = if h-prefix "store/" p then true else if orB (h-eq p "LICENSE") (orB (h-eq p "CLAUDE.md") (h-eq p "README.md")) then true else g-member p h g-frozen



-- the index's entries from offset off: (path, object id in hex) for each, or why it is not read
g-ext : Word → Word → Word
g-ext version flags = if andB (weq version #3) (weq (wand flags #16384) #16384) then #2 else #0

g-size : Word → Word → Word
g-size ext nl = wmul (wadd (wquot (wadd (wadd #62 ext) nl) #8) #1) #8

-- an entry: its path, its object id, and the size and modification time (seconds) git recorded
g-cons-entry : List Word → List Word → List Word → Sum (List Word) (List (List Word × (List Word × (Word × Word)))) → Sum (List Word) (List (List Word × (List Word × (Word × Word))))
g-cons-entry path id st (inl why) = inl why
g-cons-entry path id st (inr es) = inr (cons (path , (h-hex id , (h-be (h-drop-n (toNat #36) st) , h-be (h-take (toNat #4) (h-drop-n (toNat #8) st))))) es)

g-entry-of : Word → Word → Word → Word → Word → Proc W (Sum (List Word) (List (List Word × (List Word × (Word × Word))))) → Proc W (Sum (List Word) (List (List Word × (List Word × (Word × Word)))))
g-entry-of base len off ext nl rest =
  if weq nl #4095 then ret (inl "an index entry's path is 4095 bytes or longer, which this guard does not read") else
  if wlt len (wadd off (g-size ext nl)) then ret (inl "the index ends inside an entry") else
  bind (h-peek (wadd base off) (toNat #40)) (λ st →
  bind (h-peek (wadd base (wadd off #40)) (toNat #20)) (λ id →
  bind (h-peek (wadd base (wadd (wadd off #62) ext)) (toNat nl)) (λ path →
  bind rest (λ r → ret (g-cons-entry path id st r)))))

g-entries : Word → Word → Word → Word → Nat → Proc W (Sum (List Word) (List (List Word × (List Word × (Word × Word)))))
g-entries base len version off zero = ret (inr nil)
g-entries base len version off (suc k) =
  bind (h-peek (wadd base (wadd off #60)) (suc (suc zero))) (λ fl →
  bind (h-peek (wadd base (wadd (wadd off #62) (g-ext version (h-be fl)))) (toNat #14)) (λ pre →
  -- an object of the source (a piece, a module's list) is admitted and holds no prose of its own:
  -- passed over by its first bytes; an entry of the view (store/entries/) is read, for the module it binds
  if andB (h-prefix "store/" pre) (h-not (h-prefix "store/entries/" pre))
  then g-entries base len version (wadd off (g-size (g-ext version (h-be fl)) (wand (h-be fl) #4095))) k
  else g-entry-of base len off (g-ext version (h-be fl)) (wand (h-be fl) #4095)
    (g-entries base len version (wadd off (g-size (g-ext version (h-be fl)) (wand (h-be fl) #4095))) k)))



-- the paths refused, each on its line
g-refused : List (List Word × (List Word × (Word × Word))) → List Word
g-refused nil = nil
g-refused (cons e r) = if g-allowed (fst e) (fst (snd e)) then g-refused r else
  list-append "refused: " (list-append (fst e) (list-append " is not of the source (store/: write it with hyperactive write), and is not a file the repository held, byte for byte, when code in any other language was banned (lib/guard.hypercubical)" (cons #10 (g-refused r))))

-- One source (Avik, 2026-11-15: "ONE SOURCE OF INFORMATION"; "Nothing is ever allowed to be stale";
-- "by construction we must ensure no pushes violate this"): no rendered presentation is stored
-- (.pdf, .docx, .epub: a presentation is computed from the value it presents); no line of prose of
-- 100 characters or more is held by two files (whitespace and leading > set aside; of a .cub file
-- outside the code, the text inside its string literals, the paper's lines). Code (src/, lib/,
-- experiments/, tests/, playground/) is not prose. A file is read as git stages it: its size and
-- modification time must be the ones the index recorded, else it is refused until staged whole.
os-lower : Word → Word
os-lower b = if andB (wlt #64 b) (wlt b #91) then wadd b #32 else b

os-presentation : List Word → Bool
os-presentation p = orB (h-ends ".pdf" (list-map os-lower p)) (orB (h-ends ".docx" (list-map os-lower p)) (h-ends ".epub" (list-map os-lower p)))

os-code : List Word → Bool
os-code p = orB (h-prefix "src/" p) (orB (h-prefix "lib/" p) (orB (h-prefix "experiments/" p) (orB (h-prefix "tests/" p) (h-prefix "playground/" p))))

os-prose : List Word → Bool
os-prose p = andB (h-not (os-code p)) (orB (h-ends ".md" p) (orB (h-ends ".txt" p) (orB (h-ends ".hypercubical" p) (h-ends ".cub" p))))

-- the text inside a line's string literals: each run between a quotation mark and the next
os-lits : Bool → List Word → List Word → List (List Word)
os-lits b cur nil = nil
os-lits b cur (cons x r) = if weq x #34 then (if b then cons (h-rev cur nil) (os-lits false nil r) else os-lits true nil r)
  else (if b then os-lits true (cons x cur) r else os-lits false cur r)

os-out : List Word → List (List Word)
os-out l = os-lits false nil l

os-space : Word → Bool
os-space b = orB (weq b #32) (andB (wlt #8 b) (wlt b #14))

os-lstrip : (Word → Bool) → List Word → List Word
os-lstrip p nil = nil
os-lstrip p (cons x r) = if p x then os-lstrip p r else cons x r

os-strip : List Word → List Word
os-strip l = h-rev (os-lstrip os-space (h-rev (os-lstrip os-space l) nil)) nil

os-key : List Word → List Word
os-key l = os-strip (os-lstrip (λ b → weq b #62) (os-strip l))

-- a line's key packed eight bytes to a word (Avik's one-source check held every long line of every prose
-- document as a list of bytes, a cell a byte, and outgrew a 7 GB machine at 19,624 index entries,
-- 2026-11-18): a key is compared and sorted as a list of words, an eighth as many cells. A line holds no
-- NUL byte, so packing with zero padding is injective: two lines are equal exactly when their packed keys
-- are, and the check stays exact. The last word's free low bytes are zero.
os-pad : Nat → Word → Word
os-pad zero a = a
os-pad (suc r) a = os-pad r (wmul a #256)

-- the bytes packed: e says no byte is held yet, r how many bytes the current word has room for
os-pk : List Word → Bool → Nat → Word → List Word
os-pk nil e r a = if e then nil else cons (os-pad r a) nil
os-pk (cons x xs) e zero a = cons a (os-pk xs false (toNat #7) x)
os-pk (cons x xs) e (suc zero) a = cons (wadd (wmul a #256) x) (os-pk xs true (toNat #8) #0)
os-pk (cons x xs) e (suc (suc r)) a = os-pk xs false (suc r) (wadd (wmul a #256) x)

os-pack : List Word → List Word
os-pack l = os-pk l true (toNat #8) #0

-- the bytes that are not zero
os-nz : List Word → List Word
os-nz nil = nil
os-nz (cons b r) = if weq b #0 then os-nz r else cons b (os-nz r)

-- a word's eight bytes, high first, its zero padding left out
os-byte : Word → Word → Word
os-byte w s = wand (wshr w s) #255

os-unword : Word → List Word
os-unword w = os-nz (cons (os-byte w #56) (cons (os-byte w #48) (cons (os-byte w #40) (cons (os-byte w #32) (cons (os-byte w #24) (cons (os-byte w #16) (cons (os-byte w #8) (cons (os-byte w #0) nil))))))))

-- a packed key read back as its line, for the report
os-unpack : List Word → List Word
os-unpack k = h-concat (list-map os-unword k)

-- packing loses nothing: a line of eleven bytes is two words and reads back whole
os-pack-back : os-unpack (os-pack "hyperactive") ≡ "hyperactive"
os-pack-back = refl

-- characters, not bytes: a byte continuing a UTF-8 sequence is not one
os-chars : List Word → Nat
os-chars nil = zero
os-chars (cons x r) = if andB (wlt #127 x) (wlt x #192) then os-chars r else suc (os-chars r)

os-long : List Word → Bool
os-long k = wlt #99 (fromNat (os-chars k))

os-lines-lits : List (List Word) → List (List Word)
os-lines-lits nil = nil
os-lines-lits (cons l r) = list-append (os-out l) (os-lines-lits r)

v-keep-long : List (List Word) → List (List Word)
v-keep-long nil = nil
v-keep-long (cons k r) = if os-long k then cons k (v-keep-long r) else v-keep-long r

-- a line under 100 bytes has under 100 characters: set aside before anything else is computed
os-at-least : Nat → List Word → Bool
os-at-least zero l = true
os-at-least (suc n) nil = false
os-at-least (suc n) (cons x r) = os-at-least n r

os-bytes-long : List (List Word) → List (List Word)
os-bytes-long nil = nil
os-bytes-long (cons l r) = if os-at-least (toNat #100) l then cons l (os-bytes-long r) else os-bytes-long r

os-keys : List Word → List (List Word) → List (List Word)
os-keys path ls = v-keep-long (list-map os-key (os-bytes-long (if orB (h-ends ".hypercubical" path) (h-ends ".cub" path) then os-lines-lits ls else ls)))

-- (line, path) pairs in the order of their lines, stably
os-merge : Nat → List (List Word × List Word) → List (List Word × List Word) → List (List Word × List Word)
os-merge zero a b = list-append a b
os-merge (suc f) nil b = b
os-merge (suc f) (cons x xs) nil = cons x xs
os-merge (suc f) (cons x xs) (cons y ys) = if h-lt (fst y) (fst x) then cons y (os-merge f (cons x xs) ys) else cons x (os-merge f xs (cons y ys))

os-two : (List Word × List Word) → (List Word × List Word) → (List (List Word × List Word)) × (List (List Word × List Word)) → (List (List Word × List Word)) × (List (List Word × List Word))
os-two x y h = (cons x (fst h) , cons y (snd h))

os-halves : List (List Word × List Word) → (List (List Word × List Word)) × (List (List Word × List Word))
os-halves nil = (nil , nil)
os-halves (cons x nil) = (cons x nil , nil)
os-halves (cons x (cons y r)) = os-two x y (os-halves r)

os-sort : Nat → List (List Word × List Word) → List (List Word × List Word)
os-sort zero xs = xs
os-sort (suc f) nil = nil
os-sort (suc f) (cons x nil) = cons x nil
os-sort (suc f) (cons x (cons y r)) = os-merge (plus (list-length (cons x (cons y r))) (list-length (cons x (cons y r)))) (os-sort f (fst (os-halves (cons x (cons y r))))) (os-sort f (snd (os-halves (cons x (cons y r)))))

-- in the sorted pairs, each line held by a file other than the first to hold it
os-cut : Word → List Word → List Word
os-cut n nil = nil
os-cut n (cons x r) = if andB (wlt #127 x) (wlt x #192) then cons x (os-cut n r) else if weq n #0 then nil else cons x (os-cut (wsub n #1) r)

os-twice : List Word → List Word → List (List Word × List Word) → List (List Word)
os-twice k p nil = nil
os-twice k p (cons e r) = if h-eq k (fst e)
  then (if h-eq p (snd e) then os-twice k p r else cons (list-append (snd e) (list-append " and " (list-append p (list-append " both hold: " (list-append (os-cut #80 (os-unpack k)) "…"))))) (os-twice k p r))
  else os-twice (fst e) (snd e) r

-- a staged file read, its size and time checked against the index's
hy-or-text : Sum Unit (List Word) → List Word
hy-or-text (inl u) = nil
hy-or-text (inr t) = t

-- the fields of a stat buffer the guard compares against the index: the size at byte 48 and the
-- modification time at byte 88, each named with the proof that its Int64 cell fits inside the 256 bytes
-- of the buffer, so neither read can be outside it (2026-11-18)
os-size-time : Word → RM 256 (Word × Word)
os-size-time r = λ b → (b , (i64toWord (load64 256 b 48 (200 , λ i → 256)) , i64toWord (load64 256 b 88 (160 , λ i → 256))))

-- an entry as staged: its size and time the ones the index recorded, then its prose's keys (k). The
-- buffer is read as a region, so both reads carry their proof of fitting (2026-11-18)
os-staged : List Word × (List Word × (Word × Word)) → Proc W (Sum (List Word) (List (List Word × List Word))) → Proc W (Sum (List Word) (List (List Word × List Word)))
os-staged e k =
  with-bytes {Sum (List Word) (List (List Word × List Word))} (wadd (fromNat (list-length (fst e))) #1) (λ p → bind (h-poke p (fst e)) (λ u0 →
  bind (with-region {Word × Word} 256 (λ st → sys-call #262 #18446744073709551516 p st #0 #0 #0) os-size-time) (λ st →
  if andB (weq (wand (fst st) #4294967295) (fst (snd (snd e)))) (weq (wand (snd st) #4294967295) (snd (snd (snd e))))
  then k
  else ret {lzero} {W} (inl (list-append (fst e) (list-append " differs from what is staged; stage it whole: git add " (fst e)))))))

os-keyed : List Word → Sum Unit (List Word) → Proc W (Sum (List Word) (List (List Word × List Word)))
os-keyed path t = ret {lzero} {W} (inr (list-map (λ k → (os-pack k , path)) (os-keys path (h-split #10 (hy-or-text t)))))

-- a module of the source (bound at PATH by an entry of the view staged, store/entries/ID): its text, as
-- the source holds it, is the prose of PATH
os-module : List Word × (List Word × (Word × Word)) → List Word → Proc W (Sum (List Word) (List (List Word × List Word)))
os-module e path = if h-not (os-prose path) then ret {lzero} {W} (inr nil) else os-staged e (bind (h-source-text path) (os-keyed path))

os-bound : List Word × (List Word × (Word × Word)) → Sum Unit (List Word) → Proc W (Sum (List Word) (List (List Word × List Word)))
os-bound e (inl u) = ret (inr nil)
os-bound e (inr t) = if h-eq (h-entry-module (h-entry-words t)) "-" then ret {lzero} {W} (inr nil) else os-module e (h-unhex (h-word (suc zero) (h-entry-words t)))

os-entry : List Word × (List Word × (Word × Word)) → Proc W (Sum (List Word) (List (List Word × List Word)))
os-entry e =
  if h-prefix "store/entries/" (fst e) then bind (h-read (fst e)) (os-bound e) else
  if os-presentation (fst e) then ret {lzero} {W} (inl (list-append (fst e) ": a stored presentation; it is computed from its value")) else
  if h-not (os-prose (fst e)) then ret {lzero} {W} (inr nil) else
  os-staged e (bind (h-read (fst e)) (os-keyed (fst e)))

os-add : Sum (List Word) (List (List Word × List Word)) → (List (List Word)) × (List (List Word × List Word)) → (List (List Word)) × (List (List Word × List Word))
os-add (inl why) acc = (cons why (fst acc) , snd acc)
os-add (inr ps) acc = (fst acc , list-append ps (snd acc))

os-collect : List (List Word × (List Word × (Word × Word))) → Proc W ((List (List Word)) × (List (List Word × List Word)))
os-collect nil = ret (nil , nil)
os-collect (cons e r) = bind (os-entry e) (λ x → bind (os-collect r) (λ rest → ret (os-add x rest)))

-- the module an entry of the view binds, read from its text; nil when it binds none (a dead entry, or "-")
os-entry-path : Sum Unit (List Word) → List Word
os-entry-path (inl u) = nil
os-entry-path (inr t) = if h-eq (h-entry-module (h-entry-words t)) "-" then nil else h-unhex (h-word (suc zero) (h-entry-words t))

-- (the module it binds, the entry's file) for every entry of the view staged. The pool keeps every entry
-- ever made, a write adding one (2026-11-18: 779 entries, about forty of them binding the workflow), and
-- reading the bound module's text once per entry read each document once per write of it.
os-paths-of : List (List Word × (List Word × (Word × Word))) → Proc W (List (List Word × List Word))
os-paths-of nil = ret nil
os-paths-of (cons e r) = if h-prefix "store/entries/" (fst e) then bind (h-read (fst e)) (λ t → bind (os-paths-of r) (λ rest → ret (cons (os-entry-path t , fst e) rest))) else os-paths-of r

-- of the pairs sorted by module, one entry's file for each module bound (none for the entries binding none)
os-first-each : List Word → List (List Word × List Word) → List (List Word)
os-first-each p nil = nil
os-first-each p (cons x r) = if h-eq p (fst x) then os-first-each p r else cons (snd x) (os-first-each (fst x) r)

-- the staged entries with the view's entries cut to the ones kept: what the source holds at each path is
-- read once, which is what was read before, once per entry
os-kept : List (List Word) → List (List Word × (List Word × (Word × Word))) → List (List Word × (List Word × (Word × Word)))
os-kept keep nil = nil
os-kept keep (cons e r) = if h-prefix "store/entries/" (fst e) then (if h-has (fst e) keep then cons e (os-kept keep r) else os-kept keep r) else cons e (os-kept keep r)

os-violations : List (List Word × (List Word × (Word × Word))) → Proc W (List (List Word))
os-violations es = bind (os-paths-of es) (λ ps → bind (os-collect (os-kept (os-first-each nil (os-sort (list-length ps) ps)) es)) (λ c → ret (list-append (fst c) (os-twice nil nil (os-sort (list-length (snd c)) (snd c))))))



