hy-finish : List Word → List Word → List Word → Proc W Unit
hy-finish st m f = bind (hy-doc m f) (λ t → bind (h-read (hy-pulls-path st)) (λ pt → bind (sys-call #201 #0 #0 #0 #0 #0 #0) (λ now →
  bind (hy-pull-decls st (hy-base f) (h-decimal now) (hy-doc-lines t) (hy-pulls pt) zero) (λ decls →
  if hy-module-path f
  then bind (h-source-text f) (λ old → bind (h-record m f (list-append (hy-or nil old) decls)) (λ b → h-out (h-line (list-append f ": the pulls made are appended."))))
  else bind (h-record m (list-append (h-before ".md" f) ".hypercubical") (hy-new-text f (hy-first-line (hy-or nil t)) (hy-doc-lines t) decls)) (λ b →
    bind (h-write "build/decompose-probe.hypercubical" (hy-check-source f)) (λ b2 →
    bind (h-capture (cons m (cons "--read" (cons "build/decompose-probe.hypercubical" nil)))) (λ r → hy-finished f (snd r) (hy-checked-ok (snd r)))))))))
