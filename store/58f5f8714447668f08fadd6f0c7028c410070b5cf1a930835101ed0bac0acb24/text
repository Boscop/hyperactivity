rqm-bool3 : (b1 b2 b3 : Bool) → RqmOr (b1 ≡ b2) (RqmOr (b1 ≡ b3) (b2 ≡ b3))
rqm-bool3 true true b3 = rqm-inl (λ i → true)
rqm-bool3 false false b3 = rqm-inl (λ i → false)
rqm-bool3 true false true = rqm-inr (rqm-inl (λ i → true))
rqm-bool3 true false false = rqm-inr (rqm-inr (λ i → false))
rqm-bool3 false true false = rqm-inr (rqm-inl (λ i → false))
rqm-bool3 false true true = rqm-inr (rqm-inr (λ i → true))
