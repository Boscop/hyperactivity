signed_byte_p_int : (bits : ZI) → (x' : ZI) → MF Bool
signed_byte_p_int bits x' =
  bindF {Unit} {Bool} (fl-assert {exception} (z-le (zpos #0) bits) #149467514486126185021078021591788565046) (λ _ →
    retF {Bool} (b-and (z-le (z-negate (z-pow2 (z-sub bits (zpos #1)))) x') (z-lt x' (z-pow2 (z-sub bits (zpos #1))))))
