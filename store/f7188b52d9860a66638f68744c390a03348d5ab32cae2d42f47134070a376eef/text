rp-report : Word → List (List Word) → Proc W Unit
rp-report t0 ts =
  bind (h-out (h-line (list-append "tokens: " (h-decimal (fromNat (list-length ts)))))) (λ u →
  bind time-now (λ t1 →
  bind (h-out (h-line (list-append "read and tokenized: " (rp-ms t0 t1)))) (λ u1 →
  bind (h-out (h-line (list-append "positions in a repeat (a common prefix with the next suffix): " (h-decimal (rp-nonzero (lcp-array (suffix-array ts))))))) (λ u2 →
  bind time-now (λ t2 →
  bind (h-out (h-line (list-append "suffix array and LCP array: " (rp-ms t1 t2)))) (λ u3 → exit #0))))))
