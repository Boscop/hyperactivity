hy-after : List Word → List Word → Nat → List (List Word) → HyState → HyState → Proc W Unit
hy-after st m n a s (hy-walking k) = hy-show st m n (hy-walking k)
hy-after st m n a s hy-working = hy-working-after st m n a s
hy-after st m n a s (hy-reading f) = bind (hy-recorded st a s) (λ u → hy-show st m n (hy-reading f))
hy-after st m n a s (hy-decomposing f xy) = bind (hy-recorded st a s) (λ u → hy-show st m n (hy-decomposing f xy))
