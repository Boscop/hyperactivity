-- the reply: the selected sentence and the one that followed it in the store's record (a sentence of
-- the conversation alone, a turn following a reply being no part of it); when the selected sentence is
-- this very turn said before, what followed it alone
c-reply : List Word → Proc W (List Word)
c-reply turn = bind c-base (λ base → bind (c-select (c-words turn) nil) (λ scores →
  if weq (fst (c-best scores (#0 , #0))) #0 then ret {lzero} {W} "(nothing in the record is selected by these words)"
  else bind (c-line-range (fst (c-best scores (#0 , #0))) (fst (c-best scores (#0 , #0)))) (λ l →
    if h-eq (c-strip-nl l) (c-flat turn) then c-line-range (wadd (fst (c-best scores (#0 , #0))) #1) (wadd (fst (c-best scores (#0 , #0))) #1)
    else if wlt (fst (c-best scores (#0 , #0))) base then c-line-range (fst (c-best scores (#0 , #0))) (wadd (fst (c-best scores (#0 , #0))) #1)
    else ret {lzero} {W} l)))
