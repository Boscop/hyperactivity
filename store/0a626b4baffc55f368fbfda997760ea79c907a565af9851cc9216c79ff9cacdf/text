k-events : List Dgram → List (Word × KObj) → List (Word × EpollEvent) → List EpollEvent
k-events net t nil = nil
k-events net t (cons e r) =
  case k-find (fst e) t of
    inr u → k-events net t r
    inl o → (let m = %wor (%wand (ev-events (snd e)) (k-ready net o)) (k-hup o)
             in if %weq m #0 then k-events net t r
                else cons (EpollEvent { ev-events = m ; ev-data = ev-data (snd e) }) (k-events net t r))
