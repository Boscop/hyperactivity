tw-lem-mk-and : (env : Word → Bool) → (a b : INet) → (eq : Bool) → in-eq a b ≡ eq →
  in-eval env (in-mk-and-c eq a b) ≡ web-andB (in-eval env a) (in-eval env b)
tw-lem-mk-and env a b true h =
  web-trans-b (web-sym-b (tw-lem-and-self (in-eval env a)))
              (λ i → web-andB (in-eval env a) (tw-thm-eq-sound env a b h i))
tw-lem-mk-and env in-era _ false _ = refl
tw-lem-mk-and env (in-wire k) in-era false _ = web-sym-b (tw-lem-and-false-r (env k))
tw-lem-mk-and env (in-wire _) (in-wire _) false _ = refl
tw-lem-mk-and env (in-wire _) (in-con _ _ _) false _ = refl
tw-lem-mk-and env (in-wire _) (in-dup _ _ _) false _ = refl
tw-lem-mk-and env (in-con t x y) in-era false _ = web-sym-b (tw-lem-and-false-r (in-opB t (in-eval env x) (in-eval env y)))
tw-lem-mk-and env (in-con _ _ _) (in-wire _) false _ = refl
tw-lem-mk-and env (in-con _ _ _) (in-con _ _ _) false _ = refl
tw-lem-mk-and env (in-con _ _ _) (in-dup _ _ _) false _ = refl
tw-lem-mk-and env (in-dup l x y) in-era false _ = web-sym-b (tw-lem-and-false-r (in-dupB l (in-eval env x) (in-eval env y)))
tw-lem-mk-and env (in-dup _ _ _) (in-wire _) false _ = refl
tw-lem-mk-and env (in-dup _ _ _) (in-con _ _ _) false _ = refl
tw-lem-mk-and env (in-dup _ _ _) (in-dup _ _ _) false _ = refl
