h-publish-text : List Word → List Word → List Word → Sum Unit (List Word) → Proc W Bool
h-publish-text srv tok path (inl u) = bind (h-post srv tok (list-append "/source/unrecord?path=" (h-hex path)) nil) (h-published path)
h-publish-text srv tok path (inr t) = bind (h-post srv tok (list-append "/source/record?path=" (h-hex path)) t) (h-published path)
