-- no nonzero coefficient on us and none on ps past them: none on us followed by ps
sy-nzc-app : (A V : Type) → (z : A) → (isz : A → Bool) → (us ps : List V) → (cs : List A) → sy-nzc A V z isz cs us ≡ false → sy-nzc A V z isz (sy-skip A V us cs) ps ≡ false → sy-nzc A V z isz cs (sy-app V us ps) ≡ false
sy-nzc-app A V z isz us ps cs = (case us return λ w → (cs2 : List A) → sy-nzc A V z isz cs2 w ≡ false → sy-nzc A V z isz (sy-skip A V w cs2) ps ≡ false → sy-nzc A V z isz cs2 (sy-app V w ps) ≡ false of
  nil → λ cs2 h1 h2 → h2
  cons u ur → λ cs2 h1 h2 → λ i → if fst (sy-ite-false (isz (cl-hd A z cs2)) (sy-nzc A V z isz (cl-tl A cs2) ur) h1) i
    then sy-nzc-app A V z isz ur ps (cl-tl A cs2) (snd (sy-ite-false (isz (cl-hd A z cs2)) (sy-nzc A V z isz (cl-tl A cs2) ur) h1)) h2 i else true) cs
