-- ---------------------------------------------------------------- the quadratic form of a vertex, and a network of vertices
-- In a fixed state c of the vertex the energy is Σ_{e,e′} n_e n_e′ w(e, e′), w(e, e′) = ⟨O_ee′⟩, each a canonical form.
rads-scale : SQ → List Rad → List Rad
rads-scale a rs = case rs of
  nil → nil
  cons r rest → cons (fst r , (fst (snd r) , sq-mul a (snd (snd r)))) (rads-scale a rest)
