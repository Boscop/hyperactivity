-- a molecule whose atoms can be told apart by a test that is sound: what a representation has when its
-- atoms are given by a numbering, which is what every file format supplies and what the construction
-- deliberately does not assume elsewhere
MolEq : Type 1
MolEq = (M : Mol) × (eq : mol-atoms M → mol-atoms M → Bool) × ((a : mol-atoms M) → (b : mol-atoms M) → isTrue (eq a b) → a ≡ b)
