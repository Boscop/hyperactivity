nk-weq-sound : (a b : NkW) → (nk-weq a b ≡ true) → a ≡ b
nk-weq-sound w-end w-end h = refl
nk-weq-sound (w-0 a) (w-0 b) h = cong (λ z → w-0 z) (nk-weq-sound a b h)
nk-weq-sound (w-1 a) (w-1 b) h = cong (λ z → w-1 z) (nk-weq-sound a b h)
nk-weq-sound w-end (w-0 b) h = nk-no h
nk-weq-sound w-end (w-1 b) h = nk-no h
nk-weq-sound (w-0 a) w-end h = nk-no h
nk-weq-sound (w-0 a) (w-1 b) h = nk-no h
nk-weq-sound (w-1 a) w-end h = nk-no h
nk-weq-sound (w-1 a) (w-0 b) h = nk-no h
