it-orth-fp : (A V : Type) → (z : A) → (isz neg : A → Bool) → ((x : A) → isz x ≡ true → x ≡ z) → (f : V → V → A) → (ws : List V) → it-ok A V isz f ws ≡ true → sy-orth A V z f (it-fp A V neg f ws)
it-orth-fp A V z isz neg izz f ws = case ws return λ w → it-ok A V isz f w ≡ true → sy-orth A V z f (it-fp A V neg f w) of
  nil → λ h → unit
  cons u ur → λ h → it-ifd V (neg (f u u)) u (it-fp A V neg f ur) (λ l → sy-orth A V z f l)
    (λ e → (it-all-fp A V neg f (λ x → f x u ≡ z) ur (it-allz-all A V z isz izz f u ur (fst (it-ok3 (it-allz A V isz f u ur) (isz (f u u)) (it-ok A V isz f ur) h))) ,
            it-orth-fp A V z isz neg izz f ur (snd (snd (it-ok3 (it-allz A V isz f u ur) (isz (f u u)) (it-ok A V isz f ur) h)))))
    (it-orth-fp A V z isz neg izz f ur (snd (snd (it-ok3 (it-allz A V isz f u ur) (isz (f u u)) (it-ok A V isz f ur) h))))
