s-cached-route-file : List Word → List Word → Proc W (List Word)
s-cached-route-file st p =
  if orB (h-eq p "/") (h-null p) then s-site-file st "front" else
  if h-eq p "/llms.txt" then s-site-file st "llms-txt" else
  if h-eq p "/feed.xml" then s-site-file st "feed-xml" else
  if h-eq p "/corpus/paper" then s-site-file st "corpus-paper" else
  if orB (h-eq p "/ide") (orB (h-eq p "/studio") (h-eq p "/kernel")) then s-mod-file st "doc" "docs/kernel.html" else
  if h-eq p "/cubical.wasm" then s-mod-file st "bin" "docs/cubical.wasm.hex" else
  if h-eq p "/music" then s-mod-file st "music" "lib/server.hypercubical" else
  bind (s-cached-treatise-file st p) (λ tf →
  if h-not (h-null tf) then ret {lzero} {W} tf else
  if andB (h-prefix "/corpus/" p) (s-known (s-at-name (h-drop "/corpus" p) s-published))
  then s-mod-file st "corpus" (s-corpus-work-path (s-at-name (h-drop "/corpus" p) s-published)) else
  if s-known (s-at-name p s-published)
  then s-mod-file st "page" (s-corpus-work-path (s-at-name p s-published)) else
  ret {lzero} {W} nil)
