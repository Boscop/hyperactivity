branch-dims e d Pv F c tel b fs ds =
  case tel of
    ty nm r → 
      case b of
        bi nm b1 → let i = %dim nm in branch-dims e d Pv F c (r i) (b1 i) fs (lsnoc ds i)
        _ → err e E-ctor opq opq
    tz bdy → 
      case b of
        be t → and-then (check t (Pv (mkcon d c fs ds))) (branch-boundary Pv F t (tval bdy))
        _ → err e E-ctor opq opq
    _ → err e E-ctor opq opq
