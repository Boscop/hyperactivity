      (tt-ln "    );"
      (tt-ln ""
      (tt-ln "    wire [31:0] step_mix = inet4_flags ^ bf16_fp32_0 ^ bf16_fp32_1 ^ alu_y ^ {sram_1_out, sram_0_out, fiber_y};"
      (tt-ln ""
      (tt-ln "    always @(posedge clk) begin"
      (tt-ln "        if (!rst_n) begin"
      (tt-ln "            op_a     <= 32'd0;"
      (tt-ln "            op_b     <= 32'd0;"
      (tt-ln "            ctrl     <= 8'd0;"
      (tt-ln "            zip_sm   <= 8'd0;"
      (tt-ln "            sram_d1  <= 8'd0;"
