      (tt-ln "        .VDD  (VDD),"
      (tt-ln "        .VSS  (VSS),"
      (tt-ln "        `endif"
      (tt-ln "        .CLK  (clk),"
      (tt-ln "        .CEN  (sram_cen),"
      (tt-ln "        .GWEN (sram_wen),"
      (tt-ln "        .WEN  (8'h00),"
