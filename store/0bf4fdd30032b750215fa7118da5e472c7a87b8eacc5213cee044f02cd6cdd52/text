-- rml_size: from linear_memory.sail (it calls what is defined after it there)
-- (part of language-support)
rml_size-case1 : (addr : Bits #48) → (r_x : Text) → MS (Bits #128)
rml_size-case1 addr r_x =
  bindS {Bits #8} {Bits #128} (rml08 addr r_x) (λ t'1 →
    retS {Bits #128} (bv-zext #8 #128 t'1))
