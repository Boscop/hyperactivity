-- the first plan fits beside the second: none of its values goes to a wire the second sets or
-- delivers a value to, none of its operations to a wire the second sets or places an operation on,
-- and the wires it sets are none of the second's wires at all. A value and an operation at one wire
-- are allowed: they are the wire's two ends
nk-fits : NkFx → NkFx → Type
nk-fits nkf-nil fx2 = Unit
nk-fits (nkf-val w v r) fx2 = (nk-off w (nk-puts fx2) × nk-off w (nk-vals fx2)) × nk-fits r fx2
nk-fits (nkf-op w o r) fx2 = (nk-off w (nk-puts fx2) × nk-off w (nk-ops fx2)) × nk-fits r fx2
nk-fits (nkf-put w s r) fx2 = (nk-off w (nk-puts fx2) × (nk-off w (nk-vals fx2) × nk-off w (nk-ops fx2))) × nk-fits r fx2
