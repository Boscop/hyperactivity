-- (part of language-support)
rotate_right_bits : (w_n : Word) → (x' : Bits w_n) → (width : ZI) → (places : ZI) → Bits w_n
rotate_right_bits w_n x' width places =
  let low : Bits w_n
      low = (bv-shr w_n x' (z-nat places))
      high : Bits w_n
      high = (bv-shl w_n x' (z-nat (z-sub width places)))
  in (bv-or w_n high low)
