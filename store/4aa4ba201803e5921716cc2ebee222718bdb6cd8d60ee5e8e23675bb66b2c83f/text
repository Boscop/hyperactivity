-- an application of a global to two codes of the fragment, by which global
ex-of-bin : Word → Opt Ex → Opt Ex → Opt Ex
ex-of-bin gi oa ox =
  case oa of
    none → none
    some ea → (case ox of
                 none → none
                 some ex → (if weq gi (gidx-r (code plus)) then some (eadd ea ex)
                            else if weq gi (gidx-r (code times)) then some (emul ea ex) else none))
