-- Flat 256-bit content-addressed Kademlia XOR metric + Federated PEX + Provider Index (lib/dht.hypercubical)
s-hex-nib : Word → Word
s-hex-nib c =
  if andB (wlt #47 c) (wlt c #58) then wsub c #48 else
  if andB (wlt #96 c) (wlt c #103) then wadd #10 (wsub c #97) else
  if andB (wlt #64 c) (wlt c #71) then wadd #10 (wsub c #65) else #0
