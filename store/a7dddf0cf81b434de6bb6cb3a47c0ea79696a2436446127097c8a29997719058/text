sg-decanon : Nat → Word → Lst (List Word) → NkSexp → Word × NkSexp
sg-decanon zero fr _ e = (fr , e)
sg-decanon (suc _) fr ds (nks-sym s) =
  case s return (λ _ → Word × NkSexp) of
    nil → (fr , nks-sym nil)
    cons c r →
      if andB (%weq c #64) (%wlt #0 (nk-wlist-len r))
        then (fr , nks-sym (sg-nth-str ds (nk-dec-val #0 r)))
        else (fr , nks-sym (cons c r))
sg-decanon (suc k) fr ds (nks-lst xs) =
  sg-dc-head fr ds (sg-decanon k) xs
