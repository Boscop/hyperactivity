pick-min-l-br : {C S : Type} → (sem : C → S) → (spec : S) → (cost : C → Nat) →
  (a b : fiber sem spec) → (cmp : Bool) → leB (cost (fst a)) (cost (fst b)) ≡ cmp →
  leB (cost (fst (if cmp then a else b))) (cost (fst a)) ≡ true
pick-min-l-br sem spec cost a b true = λ _ → leB-refl (cost (fst a))
pick-min-l-br sem spec cost a b false = λ h → leB-total-false (cost (fst a)) (cost (fst b)) h
