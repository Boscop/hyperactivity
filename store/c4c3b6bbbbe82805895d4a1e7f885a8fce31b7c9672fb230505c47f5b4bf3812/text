xor4-shared-sound : (a b : Bool) →
  net-eval (toNat #3) (toNat #2) nand-alg (env2-bool a b) xor4-shared-net unit ≡ b-xor2 a b
xor4-shared-sound false false = λ _ → false
xor4-shared-sound false true  = λ _ → true
xor4-shared-sound true  false = λ _ → true
xor4-shared-sound true  true  = λ _ → false
