-- renaming: one algebra over the rule table; a derivation at ne or nf renames along any world, Der carries nothing
RenAt : Tag → Jdg → Type 1
RenAt t J = (Δ' : CCtx) (w : World Δ' (fst (snd J))) →
  RenT t (fst J) Δ' (fst (snd (snd J))) (wact Δ' (fst (snd J)) w (JZ (fst J) (fst (snd (snd J)))) (snd (snd (snd (snd J)))))
