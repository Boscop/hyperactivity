adc_af_spec32 : (dst' : Bits #32) → (src : Bits #32) → (cf' : Bits #1) → Bits #1
adc_af_spec32 dst' src cf' =
  let dst_3_0 : Bits #4
      dst_3_0 = (bv-slice #32 dst' #3 #0)
      src_3_0 : Bits #4
      src_3_0 = (bv-slice #32 src #3 #0)
      adc : Bits #6
      adc = (bits_of_int (z-add (bv-unsigned #4 dst_3_0) (z-add (bv-unsigned #4 src_3_0) (bv-unsigned #1 cf'))) (zpos #6))
      af : Bits #1
      af = (bool_to_bits (z-lt (zpos #15) (bv-unsigned #6 adc)))
  in af
