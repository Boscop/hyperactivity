-- a false statement is refused: c·x = c + x is not an identity
ac-false : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
ac-false A ad mu q vs = (mu (al-nth A (q (fn-q 0 1)) 0 vs) (al-nth A (q (fn-q 0 1)) 1 vs) , ad (al-nth A (q (fn-q 0 1)) 0 vs) (al-nth A (q (fn-q 0 1)) 1 vs))
