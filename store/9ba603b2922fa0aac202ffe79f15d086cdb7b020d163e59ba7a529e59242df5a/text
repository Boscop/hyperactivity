cmp-false-lt : (m n : Nat) → cmpN true m n ≡ false → le (suc n) m
cmp-false-lt m = case m return λ z → (n : Nat) → cmpN true z n ≡ false → le (suc n) z of
  zero → λ n h → cmp-false-lt0 n h
  suc m2 → λ n → (case n return λ w → cmpN true (suc m2) w ≡ false → le (suc w) (suc m2) of
    zero → λ h → le-one-suc m2
    suc n2 → λ h → le-suc2 (suc n2) m2 (rec m2 n2 h))
