-- the latest time anything under a directory was changed (nanoseconds since 1970): every regular
-- file's modification time, through every directory but .git, build and .cubical-store, to depth
-- `depth`. A program keeping something computed from the files stamps it with this and computes it
-- again when the stamp has moved.
h-skip : List Word → Bool
h-skip n = if h-eq n "." then true else if h-eq n ".." then true else if h-eq n ".git" then true else
  if h-eq n "build" then true else h-eq n ".cubical-store"
