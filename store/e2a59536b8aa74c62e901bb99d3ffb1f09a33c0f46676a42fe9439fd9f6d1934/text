nk-split-cons-wf : (ins outs : NkEnv) (n0 nst w : NkW) (sp : NkSplit) →
  (nk-wire-le n0 nst ≡ true) → (nk-in-set ins n0 nst w ≡ true) →
  (nk-split-ok ins outs n0 nst sp ≡ true) →
  nk-split-ok ins outs n0 nst (nk-split-cons w sp) ≡ true
nk-split-cons-wf ins outs n0 nst w (nk-split-r a b o) p0 hw hsp =
  nk-split-cons-wf-o ins outs n0 nst w a b o p0 hw
    (nk-split-ok-o ins outs n0 nst (nk-split-r a b o) hsp)
    (nk-split-ok-a ins outs n0 nst (nk-split-r a b o) hsp)
    (nk-split-ok-b ins outs n0 nst (nk-split-r a b o) hsp)
