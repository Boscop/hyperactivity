-- Every state feedback loop MUST cross gcmd's ▸ κ continuation (one register clock edge):
-- unclocked combinational feedback cycles are statically rejected by guarded typing!
seq-proc : {κ : Clock} {St In Out : Type} → (St → In → St) → (St → Out) → St → GProc κ (PinSig In Out) Empty
seq-proc nextSt outFn st = gcmd (pin-io (outFn st)) (λ inp → seq-proc nextSt outFn (nextSt st inp))
