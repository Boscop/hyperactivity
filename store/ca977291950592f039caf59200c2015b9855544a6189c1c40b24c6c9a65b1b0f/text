hh-read-doc : List (List Word × List Word) → List Word → (List Word → Step W Word) → Step W Word
hh-read-doc rmap doc k =
  let mh = hh-opt-str (hm-find (hh-hex doc) rmap)
  in if cli-eq mh nil then k nil
     else scmd (w-file-read-named (list-append "store/" (list-append mh "/module"))) (λ rm →
          let th = hh-trim (snd rm)
          in scmd (w-file-read-named (list-append "store/" (list-append th "/text"))) (λ rt → k (snd rt)))
