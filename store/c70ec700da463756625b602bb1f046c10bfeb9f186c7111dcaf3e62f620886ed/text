cs-bind-fields : CsHeap → CsVal → Word → Nat → Nat → CsEnv → Opt CsEnv
cs-bind-fields hp ptr d idx zero env = some env
cs-bind-fields hp ptr d idx (suc k) env =
  case cs-load hp ptr (suc idx) return (λ _ → Opt CsEnv) of
    none → none
    some v → cs-bind-fields hp ptr (%wsucc d) (suc idx) k (cs-env-push d v env)
