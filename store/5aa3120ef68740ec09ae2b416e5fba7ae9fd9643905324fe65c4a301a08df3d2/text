cstate-fiber-at : Nat → CtxState → FTbl
cstate-fiber-at zero (mk-cstate _ _ t0 _ _ _ _) = t0
cstate-fiber-at (suc zero) (mk-cstate _ hist _ t1 _ _ _) = ct-lookup-opt (ctx-key-at 1 hist) t1
cstate-fiber-at (suc (suc zero)) (mk-cstate _ hist _ _ t2 _ _) = ct-lookup-opt (ctx-key-at 2 hist) t2
cstate-fiber-at (suc (suc (suc zero))) (mk-cstate _ hist _ _ _ t3 _) = ct-lookup-opt (ctx-key-at 3 hist) t3
cstate-fiber-at (suc (suc (suc (suc _)))) (mk-cstate _ hist _ _ _ _ t4) = ct-lookup-opt (ctx-key-at 4 hist) t4
