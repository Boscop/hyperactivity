-- a word below 2 compared with 0 is the negation of its comparison with 1
small2 : (r : Word) → wlt r #2 ≡ true → weq #0 r ≡ bnot (weq r #1)
small2 r =
  %welimP (λ v → wlt v #2 ≡ true → weq #0 v ≡ bnot (weq v #1)) r
    (λ h → refl)
    (λ n g → %welimP (λ w → wlt (%wsucc w) #2 ≡ true → weq #0 (%wsucc w) ≡ bnot (weq (%wsucc w) #1)) n
               (λ h → refl)
               (λ m g2 h → ft-absurd (weq #0 (%wsucc (%wsucc m)) ≡ bnot (weq (%wsucc (%wsucc m)) #1)) h))
