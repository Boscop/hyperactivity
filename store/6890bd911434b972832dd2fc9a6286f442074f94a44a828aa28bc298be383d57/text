sv-inet-tile-module : List Word
sv-inet-tile-module =
  sv-lines
    (cons "// Section 4.5 GALS Cubical Interaction-Net Silicon Tile (lib/silicon/inet.hypercubical + export.hypercubical)"
    (cons "module hypercore_inet_tile ("
    (cons "  input  logic        clk, rst, pair_valid,"
    (cons "  input  logic        op_a, op_b,"
    (cons "  input  logic [3:0]  tag_a, tag_b,"
    (cons "  input  logic [3:0]  pos_a, neg_a, pos_b, neg_b,"
    (cons "  output logic        clk_en_out, face_conflict_out,"
    (cons "  output logic [15:0] ann_count, comm_count, prune_count, free_ptr, gated_cycles"
    (cons ");"
    (cons "  logic [3:0] pos_m, neg_m;"
    (cons "  logic       conflict;"
    (cons "  hypercore_dnf_unit u_dnf ("
    (cons "    .pos_a(pos_a), .neg_a(neg_a), .pos_b(pos_b), .neg_b(neg_b),"
    (cons "    .pos_out(pos_m), .neg_out(neg_m), .conflict(conflict)"
    (cons "  );"
    (cons "  assign clk_en_out        = pair_valid;"
    (cons "  assign face_conflict_out = conflict;"
    (cons "  always_ff @(posedge clk) begin"
    (cons "    if (rst) begin"
    (cons "      ann_count <= 16'd0; comm_count <= 16'd0; prune_count <= 16'd0;"
    (cons "      free_ptr  <= 16'd0; gated_cycles <= 16'd0;"
    (cons "    end else if (!pair_valid) begin"
    (cons "      gated_cycles <= gated_cycles + 16'd1;"
    (cons "    end else if (conflict) begin"
    (cons "      prune_count <= prune_count + 16'd1;"
    (cons "    end else if ((op_a == op_b) && (tag_a == tag_b)) begin"
    (cons "      ann_count <= ann_count + 16'd1;"
    (cons "    end else begin"
    (cons "      comm_count <= comm_count + 16'd1;"
    (cons "      free_ptr   <= free_ptr + 16'd4;"
    (cons "    end"
    (cons "  end"
    (cons "endmodule"
    (cons "" nil))))))))))))))))))))))))))))))))))
