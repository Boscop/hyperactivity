lineo-lift : (X X' : Type 1) (Y : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') →
  ((x : X) (y : Y x) → F' (f x y)) → (L : Line X) (D : LineO X Y L) → LineO X' F' (lineo-map X Y X' f L D)
lineo-lift X X' Y F' f g L D = (g (fst L) (fst D) , g (fst (snd L)) (fst (snd D)) , λ i → g (snd (snd L) i) (snd (snd D) i))
