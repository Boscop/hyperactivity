cs-for-loop : (CsHeap → CsEnv → CsExp → CsRes) → Nat → Word → Word → CsHeap → CsVal → CsEnv → CsExp → CsRes
cs-for-loop ev zero idx d hp acc env step = cso-ok hp acc
cs-for-loop ev (suc rem) idx d hp acc env step =
  cs-bind-res
    (ev hp (cs-env-push (%wsucc d) acc (cs-env-push d (csv-word idx) env)) step)
    (λ hp1 acc1 → cs-for-loop ev rem (%wsucc idx) d hp1 acc1 env step)
