sg-read-forms-at : Nat → Nat → NkTm → List Word → Opt (Code × Code)
sg-read-forms-at pf cf ksig txt =
  case sg-parse-sexp pf false txt return (λ _ → Opt (Code × Code)) of
    none → none
    some p1 →
      (case sg-parse-sexp pf false (snd p1) return (λ _ → Opt (Code × Code)) of
         none → none
         some p2 →
           let dT = fst (snd (sg-dc cf #0 #0 lnil #0 (fst (fst p1)) lnil))
               dt = fst (snd (sg-dc cf #0 #0 lnil #0 (fst (fst p2)) lnil))
               cT = fst (sg-tc cf #0 ksig lnil #0 #0 #0 dT lnil)
               ct = fst (sg-tc cf #0 ksig lnil #0 #0 #0 dt lnil)
           in some (ct , cT))
