-- the bytes packed: e says no byte is held yet, r how many bytes the current word has room for
os-pk : List Word → Bool → Nat → Word → List Word
os-pk nil e r a = if e then nil else cons (os-pad r a) nil
os-pk (cons x xs) e zero a = cons a (os-pk (cons x xs) true (toNat #8) #0)
os-pk (cons x xs) e (suc zero) a = cons (wadd (wmul a #256) x) (os-pk xs true (toNat #8) #0)
os-pk (cons x xs) e (suc (suc r)) a = os-pk xs false (suc r) (wadd (wmul a #256) x)
