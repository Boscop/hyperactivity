grad-dot-2 : (n : Nat) → (b : A2) → (a d : Circ A0 A1 A2 (SumFin n)) →
  (x dx : SumFin n → Nat) → (dy : Nat) →
  ((s : Nat) → fin-dot n (circ-grad n a x s) dx ≡ times s (snd (fold fwd-alg (fwd-env x dx) a))) →
  ((s : Nat) → fin-dot n (circ-grad n d x s) dx ≡ times s (snd (fold fwd-alg (fwd-env x dx) d))) →
  fin-dot n (circ-grad n (cop2 b a d) x dy) dx ≡
  times dy (snd (fold fwd-alg (fwd-env x dx) (cop2 b a d)))
grad-dot-2 n a2-add a d x dx dy ihA ihD =
  transN (dot-add n (circ-grad n a x dy) (circ-grad n d x dy) dx)
    (transN (cong2N plus (ihA dy) (ihD dy))
      (sym (times-distr-r dy (snd (fold fwd-alg (fwd-env x dx) a)) (snd (fold fwd-alg (fwd-env x dx) d)))))
grad-dot-2 n a2-mul a d x dx dy ihA ihD =
  let va = fold val-alg x a
      vd = fold val-alg x d
      pa = fold fwd-alg (fwd-env x dx) a
      pd = fold fwd-alg (fwd-env x dx) d
  in transN (dot-add n (circ-grad n a x (times dy vd)) (circ-grad n d x (times dy va)) dx)
       (transN (cong2N plus (ihA (times dy vd)) (ihD (times dy va)))
         (mul-adj-law dy va vd (fst pa) (fst pd) (snd pa) (snd pd) (fwd-fst x dx a) (fwd-fst x dx d)))
