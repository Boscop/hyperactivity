-- the reads n := read16le(b, 2) and t := read16le(b, 0) occur only in the branch s ≥ 4
appc-D : (Nat → Nat) → Nat → Nat → Nat → Bool × (Nat → Nat)
appc-D mu b s o =
  if fd-ltb s fd-four then (false , mu)
  else (if fd-ltb (fd-monus s fd-four) (appc-read16le mu b (suc (suc zero))) then (false , mu)
  else (true , appc-write-frame mu o (appc-read16le mu b zero) (appc-read16le mu b (suc (suc zero))) (plus b fd-four)))
