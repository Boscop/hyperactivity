tt-v2k-io-block : List Word → Word → Word → List Word → List Word
tt-v2k-io-block name ng prog tl =
  tt-cat
    (cons "module hx_opt_" (cons name (cons "(input wire w0, input wire w1, input wire w2, output wire y);" (cons tt-nl
    (cons (io-sv-gates (toNat ng) #3 prog
      (tt-cat (cons "  assign y = w" (cons (ce-dec (%wadd #2 ng)) (cons ";" (cons tt-nl
              (cons "endmodule" (cons tt-nl (cons tl nil))))))))) nil)))))

tt-v2k-ms-list : List MetaCircuit → List Word → List Word
tt-v2k-ms-list nil tl = tl
tt-v2k-ms-list (cons (mcirc nm _ _ gs) rest) tl =
  let ng = ms-count-gates gs
  in tt-cat
       (cons "module hx_meta_" (cons nm (cons "(input wire w0, input wire w1, input wire w2, input wire w3, output wire y);" (cons tt-nl
       (cons (ms-sv-gates #4 gs
         (tt-cat (cons "  assign y = w" (cons (ce-dec (%wadd #3 ng)) (cons ";" (cons tt-nl
                 (cons "endmodule" (cons tt-nl (cons (tt-v2k-ms-list rest tl) nil))))))))) nil)))))

