tt-nl : List Word
tt-nl = cons #10 nil

tt-q : List Word
tt-q = cons #34 nil

tt-cat : List (List Word) → List Word
tt-cat nil = nil
tt-cat (cons xs xss) = list-append xs (tt-cat xss)

tt-ln : List Word → List Word → List Word
tt-ln s tl = list-append s (list-append tt-nl tl)

tt-quoted : List Word → List Word
tt-quoted s = tt-cat (cons tt-q (cons s (cons tt-q nil)))

