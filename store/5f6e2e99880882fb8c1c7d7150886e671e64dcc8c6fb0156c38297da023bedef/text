ixr-isub : (r : Word → Word) (e : IEx) → PathP (λ i → IEx) (ixr r e) (isub (λ k → ixv (r k)) e)
ixr-isub r ix0 = λ i → ix0
ixr-isub r ix1 = λ i → ix1
ixr-isub r (ixv k) = λ i → ixv (r k)
ixr-isub r (ixneg x) = λ i → ixneg (ixr-isub r x i)
ixr-isub r (ixmeet x y) = λ i → ixmeet (ixr-isub r x i) (ixr-isub r y i)
ixr-isub r (ixjoin x y) = λ i → ixjoin (ixr-isub r x i) (ixr-isub r y i)
