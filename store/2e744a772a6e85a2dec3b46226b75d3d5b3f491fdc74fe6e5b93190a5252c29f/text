cfs-dec-cons : Word → Nat → Nat → List Word → CtxState → (Word × Word) → FTbl → SRState → Word × SRState
cfs-dec-cons L fuel k excl st e r st0 =
  let ft  = fiber-with-esc e r
      p   = sr-dec-step ft L fuel st0
      tag = fst p
      st1 = snd p
  in if weq tag #0 then cfs-dec-sym L fuel k (ftbl-add-syms (cons e r) excl) st st1
     else (wsub tag #1 , st1)
