-- Sensitized mux delay: when selector sel is proved constant, false branch arrival time is soundly pruned!
mux-sensitized : (Bool × Nat) → (Bool × Nat) → (Bool × Nat) → Nat → (Bool × Nat)
mux-sensitized sel tbranch ebranch dmux =
  if fst sel then (fst tbranch , plus dmux (maxN (snd sel) (snd tbranch)))
  else (fst ebranch , plus dmux (maxN (snd sel) (snd ebranch)))
