-- Complete 8-module synthesizable IEEE 1800-2017 SystemVerilog suite:
--   alu_sum_rtl, xor4_shared_net, hypercore_rom, systolic_mac_2x2, hypercore_soc,
--   hypercore_secded84, hypercore_dnf_unit, hypercore_inet_tile
hypercore-full-rtl-sv : List Word
hypercore-full-rtl-sv =
  sv-concat
    (cons (sv-ln "`timescale 1ns/1ps")
    (cons hypercore-sv-file
    (cons sv-nl
    (cons hypercore-soc-sv
    (cons sv-nl
    (cons sv-secded-module
    (cons sv-dnf-module
    (cons sv-inet-tile-module nil))))))))
