-- the fuel bounds the depth of halving; any fuel sorts, and the length is always enough
msort-fuel : {o : Ord} → Nat → List (El o) → List (El o)
msort-fuel f =
  case f return λ w → List (El o) → List (El o) of
    zero → λ l → ins-sort l
    suc f1 →
      λ l →
        case l return λ v → List (El o) of
          nil → nil
          cons x r →
            case r return λ u → List (El o) of
              nil → cons x nil
              cons y r2 → merge (rec f1 (fst (halves (cons x (cons y r2))))) (rec f1 (snd (halves (cons x (cons y r2)))))
