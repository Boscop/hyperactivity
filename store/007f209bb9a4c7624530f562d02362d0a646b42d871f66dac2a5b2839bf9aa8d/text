-- multiplying by a nonnegative (k, 0) keeps order; by a nonpositive (0, k) reverses it
zle-mul-posk : (a b : Nat × Nat) → (k : Nat) → zle a b → zle (zmul a (k , zero)) (zmul b (k , zero))
zle-mul-posk a b k h = zle-path (zsc a k) (zmul a (k , zero)) (zsc b k) (zmul b (k , zero)) (symNN (zmul-zsc a k)) (symNN (zmul-zsc b k)) (zle-scale a b k h)
