-- the successor
bin-succ-sound : (n : List Bool) → bin-to-nat (bin-succ n) ≡ suc (bin-to-nat n)
bin-succ-sound n =
  case n return λ m → bin-to-nat (bin-succ m) ≡ suc (bin-to-nat m) of
    nil → λ i → suc zero
    cons b rest → (case b return λ y → bin-to-nat (bin-succ (cons y rest)) ≡ suc (bin-to-nat (cons y rest)) of
      true → transN (congN (times 2) (rec rest)) (times2-suc (bin-to-nat rest))
      false → λ i → suc (times 2 (bin-to-nat rest)))
