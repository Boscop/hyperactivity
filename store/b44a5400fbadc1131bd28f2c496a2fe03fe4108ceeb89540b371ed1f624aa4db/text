hhf-main : List (List Word) → Step W Word
hhf-main _ =
  scmd w-now (λ t0 →
  scmd (w-file-read-named "store/ROOT/root") (λ rr →
  let rh = hhf-trim (snd rr)
  in scmd (w-file-read-named (list-append "store/" (list-append rh "/root"))) (λ rt →
     let rmap = hm-parse (snd rt)
     in hhf-scan rmap #0 #0 #0 (λ mods chunks mbytes →
        scmd w-now (λ t1 →
        cli-say (list-append "HX-Hyperfactor store/ ROOT=" (list-append rh
          (list-append " entries=" (list-append (ce-dec mods)
          (list-append " total_chunk_refs=" (list-append (ce-dec chunks)
          (list-append " manifest_bytes=" (list-append (ce-dec mbytes)
          (list-append " (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)")))))))))) (sdone #0))))))
