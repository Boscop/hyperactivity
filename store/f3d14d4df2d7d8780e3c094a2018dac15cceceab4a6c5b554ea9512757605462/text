step-twice : {a b r : Bool} → isTrue (lex-step a b r) → isTrue (lex-step a b (lex-step a b r))
step-twice h =
  (case a return λ y → isTrue (lex-step y b r) → isTrue (lex-step y b (lex-step y b r)) of
     true → (case b return λ z → isTrue (lex-step true z r) → isTrue (lex-step true z (lex-step true z r)) of true → λ h → h; false → λ h → unit)
     false → λ h → h) h
