-- transport along a congruence, row by row and then over the rows
ln-inner : (f : List BQ → List BQ → BQ) → (l : List BQ → List BQ) → (x : List BQ) → (ws : List (List BQ)) →
  ln-map (List BQ) BQ (λ y → f (l x) (l y)) ws ≡ ln-map (List BQ) BQ (λ y → f (l x) y) (ln-map (List BQ) (List BQ) l ws)
ln-inner f l x ws = case ws return λ zs → ln-map (List BQ) BQ (λ y → f (l x) (l y)) zs ≡ ln-map (List BQ) BQ (λ y → f (l x) y) (ln-map (List BQ) (List BQ) l zs) of
  nil → λ i → nil
  cons y rest → λ i → cons (f (l x) (l y)) (ln-inner f l x rest i)
