epfl-fa-bit-exact : Word → List Word
epfl-fa-bit-exact i =
  let ai = epfl-indexed "a" i
      bi = epfl-indexed "b" i
      fi = epfl-indexed "f" i
      co = the (List Word) (if %weq i #127 then "cOut" else list-append "c" (epfl-dec (%wsucc i)))
      s  = epfl-dec i
      t0 = list-append "g" s
      t1 = list-append "n" s
      ci = list-append "c" s
      x  = list-append "x" s
      t2 = list-append "h" s
      t3 = list-append "m" s
  in if %weq i #0 then
       sv-concat
         (cons (epfl-gate2 ai bi co "11")
         (cons (epfl-gate2 ai bi t1 "00")
         (cons (epfl-gate2 co t1 fi "00") nil)))
     else
       sv-concat
         (cons (epfl-gate2 ai bi t0 "11")
         (cons (epfl-gate2 ai bi t1 "00")
         (cons (epfl-gate2 t0 t1 x  "00")
         (cons (epfl-gate2 x  ci t2 "11")
         (cons (epfl-gate2 x  ci t3 "00")
         (cons (epfl-gate2 t2 t3 fi "00")
         (cons (epfl-or2-blif t0 t2 co) nil)))))))
