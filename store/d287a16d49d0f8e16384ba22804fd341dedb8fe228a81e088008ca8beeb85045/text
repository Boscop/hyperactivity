function p2pWantHash(sha256) {
  const ids = livePeerIds();
  if (!ids.length) return Promise.resolve(null);
  return new Promise(res => {
    const timer = setTimeout(() => { pendingWants.delete(sha256); res(null); }, 1800);
    const arr = pendingWants.get(sha256) || [];
    arr.push(txt => { clearTimeout(timer); res(txt); });
    pendingWants.set(sha256, arr);
    ids.forEach(id => sendToPeer(id, { t: 'WANT', h: sha256 }));
  });
}

// Complete vanilla-ICE gathering helper so SDP carries all host + srflx candidates in one POST
function waitIceComplete(pc) {
  if (pc.iceGatheringState === 'complete') return Promise.resolve();
  return new Promise(res => {
    const t = setTimeout(res, 1600);
    pc.addEventListener('icegatheringstatechange', () => {
      if (pc.iceGatheringState === 'complete') { clearTimeout(t); res(); }
    });
  });
}

function bindDataChannel(peerId, pc, dc) {
  dc.onopen = async () => {
    let p = peers.get(peerId);
    if (!p) { p = { id: peerId, transport: 'WEBRTC', pc, dc, manifest: null, lastSeen: Date.now() }; peers.set(peerId, p); }
    else { p.pc = pc; p.dc = dc; p.transport = 'WEBRTC'; p.lastSeen = Date.now(); }
    delete myOffers[peerId];
    const man = await buildMyManifest();
    sendToPeer(peerId, { t: 'MANIFEST', manifest: man });
    renderPeersUI();
  };
  dc.onclose = () => renderPeersUI();
  dc.onmessage = ev => {
    try { onMeshPacket(JSON.parse(ev.data), 'WEBRTC', dc); } catch (e) {}
  };
}

const rtcPending = new Map(); // peerId -> { pc, role }

async function pollWebRTCSignal() {
  if (typeof RTCPeerConnection === 'undefined') return;
  try {
    const envelope = JSON.stringify({
      ts: Date.now(),
      offers: myOffers,
      answers: myAnswers
    });
    const res = await fetch('/api/p2p/signal?id=' + encodeURIComponent(myPeerId), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: envelope
    });
    if (!res.ok) return;
    const data = await res.json();
    if (!data || !Array.isArray(data.peers)) return;
    const now = Date.now();

    for (const [pid, raw] of data.peers) {
      if (!pid || pid === myPeerId) continue;
      let env = null;
      try { env = JSON.parse(raw); } catch (e) { continue; }
      if (!env || (env.ts && now - env.ts > 45000)) continue;

      const existing = peers.get(pid);
      if (existing && existing.dc && existing.dc.readyState === 'open') continue;

      // 1. Check if pid answered an offer we made
      if (env.answers && env.answers[myPeerId] && rtcPending.has(pid)) {
        const st = rtcPending.get(pid);
        if (st.role === 'offerer' && st.pc.signalingState === 'have-local-offer') {
          await st.pc.setRemoteDescription(env.answers[myPeerId]);
        }
      }

      // 2. Check if pid posted an offer addressed to us
      if (env.offers && env.offers[myPeerId] && !rtcPending.has(pid)) {
        const pc = new RTCPeerConnection({ iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] });
        rtcPending.set(pid, { pc, role: 'answerer' });
        pc.ondatachannel = ev => bindDataChannel(pid, pc, ev.channel);
        await pc.setRemoteDescription(env.offers[myPeerId]);
        const ans = await pc.createAnswer();
        await pc.setLocalDescription(ans);
        await waitIceComplete(pc);
        myAnswers[pid] = pc.localDescription;
      }

      // 3. Deterministic tie-breaker: lower peerId initiates offer if not yet negotiating
      if (myPeerId < pid && !rtcPending.has(pid) && rtcPending.size < 6) {
        const pc = new RTCPeerConnection({ iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] });
        const dc = pc.createDataChannel('hx-p2p-v1');
        rtcPending.set(pid, { pc, role: 'offerer' });
        bindDataChannel(pid, pc, dc);
        const off = await pc.createOffer();
        await pc.setLocalDescription(off);
        await waitIceComplete(pc);
        myOffers[pid] = pc.localDescription;
      }
    }
  } catch (e) {}
}

