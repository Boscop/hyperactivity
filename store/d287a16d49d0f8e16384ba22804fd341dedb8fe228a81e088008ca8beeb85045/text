// ---------------- Distributed Interaction-Net Cut Dispatcher ----------------
distBtn.addEventListener('click', async () => {
  const src = codeEl.value;
  const lines = src.split('\n');
  const preambleLines = [];
  const cuts = [];
  for (const ln of lines) {
    if (/^\s*#(show|type)\b/.test(ln)) cuts.push(ln.trim());
    else preambleLines.push(ln);
  }
  if (!cuts.length) {
    triggerEval();
    return;
  }
  runBtn.disabled = true;
  distBtn.disabled = true;
  dotEl.className = 'dot';
  const peerIds = livePeerIds();
  const workers = ['LOCAL', ...peerIds];
  statusEl.textContent = 'Partitioning ' + cuts.length + ' interaction-net cuts across ' + workers.length + ' node(s)…';

  const deps = [];
  workspace.forEach(rec => {
    if (rec.visibility === 'public') deps.push({ path: rec.path, sha256: rec.sha256 });
  });
  const preamble = preambleLines.join('\n');
  const t0 = performance.now();

  const tasks = cuts.map((directive, idx) => {
    const target = workers[idx % workers.length];
    const unitCode = preamble + '\n' + directive + '\n';
    if (target === 'LOCAL') {
      return runWorkerCut(unitCode).then(r => ({
        idx, directive, worker: myPeerId + ' (local)', ok: r.ok, output: r.output, steps: r.steps, ms: r.ms, verified: r.ok
      }));
    }
    const reqId = 'cut_' + Date.now() + '_' + idx + '_' + Math.random().toString(36).slice(2, 6);
    return new Promise(resolve => {
      const timer = setTimeout(async () => {
        pendingCuts.delete(reqId);
        // Seamless confluent fallback to local worker if remote peer drops mid-cut
        const fb = await runWorkerCut(unitCode);
        resolve({ idx, directive, worker: myPeerId + ' (fallback)', ok: fb.ok, output: fb.output, steps: fb.steps, ms: fb.ms, verified: fb.ok });
      }, 6000);
      pendingCuts.set(reqId, {
        timer,
        resolve: async (pkt) => {
          let verified = pkt.ok;
          let witnessNote = '';
          // Zero-trust local cubical witness check for #show cuts!
          const m = directive.match(/^#show\s+(.+)$/);
          if (pkt.ok && m && pkt.output && !pkt.output.includes('\n')) {
            const lhs = m[1].trim();
            const rhs = pkt.output.trim();
            const witCode = preamble + '\nhx_wit_' + idx + ' : (' + lhs + ') ≡ (' + rhs + ')\nhx_wit_' + idx + ' = refl\n';
            const chk = await runWorkerCut(witCode);
            verified = chk.ok;
            witnessNote = chk.ok ? ' [witness refl ✓]' : ' [FORGED NORMAL FORM REJECTED]';
          }
          resolve({
            idx,
            directive,
            worker: pkt.peerId + ' (remote P2P)' + witnessNote,
            ok: pkt.ok && verified,
            output: pkt.output,
            steps: pkt.steps || 0,
            ms: pkt.ms || '?',
            verified
          });
        }
      });
      sendToPeer(target, { t: 'CUT_REQ', reqId, code: unitCode, deps });
    });
  });

  const results = await Promise.all(tasks);
  const wallMs = (performance.now() - t0).toFixed(1);
  const totalSteps = results.reduce((s, r) => s + Number(r.steps || 0), 0);
  const allOk = results.every(r => r.ok);

  runBtn.disabled = false;
  distBtn.disabled = false;
  dotEl.className = allOk ? 'dot ready' : 'dot err';
  statusEl.textContent = allOk
    ? ('Distributed ' + cuts.length + ' cuts across ' + workers.length + ' peer(s)')
    : 'Cut verification failure';
  timeBadge.textContent = totalSteps.toLocaleString() + ' net steps · ' + wallMs + ' ms wall';

  outEl.textContent =
    '⚡ Distributed Interaction-Net Execution (' + workers.length + ' active node' + (workers.length === 1 ? '' : 's') + ', ' + wallMs + ' ms wall):\n' +
    results.map(r =>
      '  [' + (r.idx + 1) + '] ' + r.directive + '\n' +
      '      ↳ ' + (r.output || '(unit)') + '   (' + Number(r.steps).toLocaleString() + ' steps on ' + r.worker + ')'
    ).join('\n');
});

function triggerEval() {
  runBtn.disabled = true;
  distBtn.disabled = true;
  dotEl.className = 'dot';
  statusEl.textContent = 'Elaborating & normalizing…';
  worker.postMessage({ type: 'eval', origin: location.origin, code: codeEl.value });
}

runBtn.addEventListener('click', triggerEval);
codeEl.addEventListener('keydown', (e) => {
  if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
    e.preventDefault();
    if (!runBtn.disabled) triggerEval();
  }
});

loadModBtn.addEventListener('click', () => {
  const rel = modInput.value.trim();
  if (!rel) return;
  loadModBtn.disabled = true;
  runBtn.disabled = true;
  dotEl.className = 'dot';
  statusEl.textContent = 'Pulling & checking ' + rel + '…';
  worker.postMessage({ type: 'load_mod', origin: location.origin, rel });
});

worker.onmessage = async (ev) => {
  const m = ev.data;
  if (m.hashes) renderHashes(m.hashes);
  if (m.type === 'cas_store') {
    publicHashAllowlist.add(m.sha256);
    await casPutVerified(m.sha256, m.txt);
    return;
  }
  if (m.type === 'hashes') return;
  if (m.type === 'cut_done' && m.callId && workerCalls.has(m.callId)) {
    const fn = workerCalls.get(m.callId);
    workerCalls.delete(m.callId);
    fn(m);
    return;
  }
  if (m.type === 'error' && m.callId && workerCalls.has(m.callId)) {
    const fn = workerCalls.get(m.callId);
    workerCalls.delete(m.callId);
    fn({ ok: false, steps: 0, ms: '0', output: m.error });
    return;
  }

  if (m.type === 'status') {
    statusEl.textContent = m.text;
  } else if (m.type === 'ready') {
    dotEl.className = 'dot ready';
    statusEl.textContent = 'Kernel ready · lib/core.hypercubical (' + m.ms + ' ms)';
    stepBadge.textContent = Number(m.totalSteps).toLocaleString() + ' net steps';
    runBtn.disabled = false;
    distBtn.disabled = false;
    saveWsBtn.disabled = false;
    loadModBtn.disabled = false;
    triggerEval();
  } else if (m.type === 'result') {
    runBtn.disabled = false;
    distBtn.disabled = false;
    loadModBtn.disabled = false;
    dotEl.className = m.ok ? 'dot ready' : 'dot err';
    statusEl.textContent = m.ok ? '0 failures' : 'Rejected by lib/check.hypercubical';
    stepBadge.textContent = Number(m.totalSteps).toLocaleString() + ' total steps';
    timeBadge.textContent = Number(m.steps).toLocaleString() + ' steps · ' + m.ms + ' ms';
    outEl.textContent = m.output || (m.ok ? '✓ All definitions elaborated (0 failures, ' + Number(m.steps).toLocaleString() + ' interaction-net steps).' : 'Failed.');
  } else if (m.type === 'mod_loaded') {
    runBtn.disabled = false;
    distBtn.disabled = false;
    loadModBtn.disabled = false;
    dotEl.className = m.ok ? 'dot ready' : 'dot err';
    statusEl.textContent = m.ok ? ('Loaded ' + m.rel) : ('Failed loading ' + m.rel);
    stepBadge.textContent = Number(m.totalSteps).toLocaleString() + ' total steps';
    timeBadge.textContent = Number(m.steps).toLocaleString() + ' steps · ' + m.ms + ' ms';
    outEl.textContent = (m.ok ? ('✓ Pulled, SHA-256 verified & elaborated ' + m.rel + ' (' + Number(m.steps).toLocaleString() + ' steps in ' + m.ms + ' ms).\n') : '') + (m.output || '');
  } else if (m.type === 'error') {
    runBtn.disabled = false;
    distBtn.disabled = false;
    loadModBtn.disabled = false;
    dotEl.className = 'dot err';
    statusEl.textContent = 'Kernel error';
    outEl.textContent = m.error;
  }
};

// Boot sequence: open IndexedDB CAStore, rehydrate sovereign workspace, boot WASM, join P2P mesh
(async () => {
  await openLocalPool();
  refreshCasCount();
  const saved = await wsLoadAll();
  saved.forEach(rec => {
    workspace.set(rec.path, rec);
    if (rec.visibility === 'public') publicHashAllowlist.add(rec.sha256);
  });
  renderWorkspaceUI();
  worker.postMessage({ type: 'boot', origin: location.origin, preloaded: saved });

  broadcastMesh({ t: 'HELLO' });
  setInterval(() => {
    broadcastMesh({ t: 'HELLO' });
    renderPeersUI();
  }, 5000);
  setTimeout(pollWebRTCSignal, 600);
  setInterval(pollWebRTCSignal, 6000);
})();
</script>
