<script>
const PRESETS = [
  {
    title: '1 · Distributed Net Cuts (P2P)',
    sub: 'Parallel interaction-net reductions partitioned across live peers + local witness check',
    code: `-- Click "⚡ Distribute Cuts" with 1+ live peers (open /kernel in a second tab
-- or machine!) to partition each #show cut across peer cubical.wasm workers
-- and verify every returned normal form locally in lib/check.hypercubical.

p2p-fib : Nat → Nat
p2p-fib zero = zero
p2p-fib (suc zero) = suc zero
p2p-fib (suc (suc n)) = plus (p2p-fib (suc n)) (p2p-fib n)

p2p-sum-sq : Nat → Nat
p2p-sum-sq zero = zero
p2p-sum-sq (suc n) = plus (times (suc n) (suc n)) (p2p-sum-sq n)

#show p2p-fib 14
#show p2p-sum-sq 12
#show times 29 31
#show p2p-fib 15
`
  },
  {
    title: '2 · Path Symmetry & Involutivity',
    sub: 'Interval reversal (~ i) is definitionally involutive in src/dnf.c',
    code: `k-sym : {A : Type} {x y : A} → Path A x y → Path A y x
k-sym p = λ i → p (~ i)

k-sym-invol : {A : Type} {x y : A} (p : Path A x y) → Path (Path A x y) (k-sym (k-sym p)) p
k-sym-invol p = refl

#type k-sym-invol {Bool} {true} {true}
#show plus 21 21
`
  },
  {
    title: '3 · Sovereign Curation & Non-Interference',
    sub: 'Load lib/distnet.hypercubical & inspect wire-partition-transparent + standpoint-noninterference',
    code: `import "lib/distnet.hypercubical"

#type disjoint-cuts-commute {Nat} {Nat}
#type wire-forged-rejected {Nat} {Nat}
#type wire-partition-transparent {Nat} {Nat}
#type curated-private-withheld {Nat} {Nat}
#type standpoint-noninterference {Nat} {Nat} {Bool}
`
  },
  {
    title: '4 · Forged Proof Rejection',
    sub: 'Watch lib/check.hypercubical reject Path Bool true false = refl & recover',
    code: `-- False claim: lib/check.hypercubical rejects refl because endpoint i1
-- reduces to true rather than false, leaving your CAStore untouched.

forged-claim : Path Bool true false
forged-claim = refl
`
  }
];

const CORE_IMPORTS = [
  'lib/prelude.hypercubical',
  'lib/code.hypercubical',
  'lib/match.hypercubical',
  'lib/nav.hypercubical',
  'lib/cost.hypercubical',
  'lib/lin.hypercubical',
  'lib/check.hypercubical',
  'lib/std.hypercubical',
  'lib/core.hypercubical'
];

function toHex(u8) {
  let s = '';
  for (let i = 0; i < u8.length; i++) s += u8[i].toString(16).padStart(2, '0');
  return s;
}
async function sha256Text(str) {
  const bytes = new TextEncoder().encode(str);
  const d = await crypto.subtle.digest('SHA-256', bytes);
  return toHex(new Uint8Array(d));
}

// ---------------- Sovereign IndexedDB CAStore (hx-cas-v1) ----------------
let casDB = null;
const workspace = new Map(); // path -> { path, sha256, visibility, text, updatedAt }

function openLocalPool() {
  if (!('indexedDB' in window)) return Promise.resolve(null);
  return new Promise(res => {
    const req = indexedDB.open('hx-cas-v1', 2);
    req.onupgradeneeded = () => {
      const db = req.result;
      if (!db.objectStoreNames.contains('obj')) db.createObjectStore('obj');
      if (!db.objectStoreNames.contains('ws')) db.createObjectStore('ws', { keyPath: 'path' });
    };
    req.onsuccess = () => { casDB = req.result; res(casDB); };
    req.onerror = () => res(null);
  });
}

function casGet(hash) {
  if (!casDB || !hash) return Promise.resolve(null);
  return new Promise(res => {
    try {
      const r = casDB.transaction('obj', 'readonly').objectStore('obj').get(hash);
      r.onsuccess = async () => {
        const val = r.result;
        if (typeof val !== 'string') return res(null);
        // ca-check on read
        if (hash.length === 64 && (await sha256Text(val)) !== hash) return res(null);
        res(val);
      };
      r.onerror = () => res(null);
    } catch (e) { res(null); }
  });
}

async function casPutVerified(expectedHash, text) {
  const actual = await sha256Text(text);
  if (expectedHash && expectedHash.length === 64 && actual !== expectedHash) {
    throw new Error('peer-forged-rejected: SHA-256 mismatch (' + actual.slice(0, 12) + ' != ' + expectedHash.slice(0, 12) + ')');
  }
  if (casDB) {
    await new Promise(res => {
      try {
        const tx = casDB.transaction('obj', 'readwrite');
        tx.objectStore('obj').put(text, actual);
        tx.oncomplete = () => res(true);
        tx.onerror = () => res(false);
      } catch (e) { res(false); }
    });
    refreshCasCount();
  }
  return actual;
}

function wsLoadAll() {
  if (!casDB || !casDB.objectStoreNames.contains('ws')) return Promise.resolve([]);
  return new Promise(res => {
    try {
      const r = casDB.transaction('ws', 'readonly').objectStore('ws').getAll();
      r.onsuccess = () => res(r.result || []);
      r.onerror = () => res([]);
    } catch (e) { res([]); }
  });
}

function wsPutRecord(rec) {
  workspace.set(rec.path, rec);
  if (!casDB || !casDB.objectStoreNames.contains('ws')) return Promise.resolve();
  return new Promise(res => {
    try {
      const tx = casDB.transaction('ws', 'readwrite');
      tx.objectStore('ws').put(rec);
      tx.oncomplete = () => res();
      tx.onerror = () => res();
    } catch (e) { res(); }
  });
}

function refreshCasCount() {
  if (!casDB) return;
  try {
    const r = casDB.transaction('obj', 'readonly').objectStore('obj').count();
    r.onsuccess = () => {
      document.getElementById('casCountBadge').textContent = (r.result || 0) + ' objs';
    };
  } catch (e) {}
}

// ---------------- Peer Identity & Multi-Transport Mesh (WebRTC + BroadcastChannel) ----------------
const myPeerId = (() => {
  const a = new Uint8Array(4);
  crypto.getRandomValues(a);
  return 'p_' + toHex(a);
})();
document.getElementById('myNodeBadge').textContent = myPeerId;

const peers = new Map(); // peerId -> { id, transport, pc, dc, manifest, lastSeen }
const myOffers = {};     // targetPeerId -> RTCSessionDescriptionInit (with gathered ICE)
const myAnswers = {};    // offererPeerId -> RTCSessionDescriptionInit (with gathered ICE)
const pendingWants = new Map(); // sha256 -> [resolve...]
const pendingCuts = new Map();  // reqId -> { resolve, reject, timer }

const bc = typeof BroadcastChannel !== 'undefined' ? new BroadcastChannel('hx-p2p-v1') : null;

async function buildMyManifest() {
  const pubMods = [];
  workspace.forEach(rec => {
    if (rec.visibility === 'public') {
      pubMods.push({ path: rec.path, sha256: rec.sha256, bytes: rec.text.length });
    }
  });
  pubMods.sort((a, b) => a.path.localeCompare(b.path));
  const rootSeed = pubMods.map(m => m.path + ':' + m.sha256).join('\n');
  const root = await sha256Text(rootSeed);
  return { peerId: myPeerId, root: root.slice(0, 16), published: pubMods };
}

function sendToPeer(peerId, pkt) {
  const p = peers.get(peerId);
  const raw = JSON.stringify({ ...pkt, from: myPeerId, to: peerId });
  if (p && p.dc && p.dc.readyState === 'open') {
    try { p.dc.send(raw); return true; } catch (e) {}
  }
  if (bc && p && p.transport === 'LOCAL') {
    bc.postMessage(raw);
    return true;
  }
  return false;
}

function broadcastMesh(pkt) {
  const raw = JSON.stringify({ ...pkt, from: myPeerId });
  if (bc) bc.postMessage(raw);
  peers.forEach(p => {
    if (p.dc && p.dc.readyState === 'open') {
      try { p.dc.send(raw); } catch (e) {}
    }
  });
}

async function announceManifest() {
  const man = await buildMyManifest();
  broadcastMesh({ t: 'MANIFEST', manifest: man });
}

function livePeerIds() {
  const out = [];
  const now = Date.now();
  peers.forEach((p, id) => {
    const dcOpen = p.dc && p.dc.readyState === 'open';
    const locAlive = p.transport === 'LOCAL' && (now - p.lastSeen < 18000);
    if (dcOpen || locAlive) out.push(id);
  });
  return out;
}

function renderPeersUI() {
  const ids = livePeerIds();
  document.getElementById('peerCountBadge').textContent = ids.length + (ids.length === 1 ? ' peer' : ' peers');
  document.getElementById('meshBadge').textContent = '⚡ P2P: ' + ids.length + ' live';
  const box = document.getElementById('peerList');
  if (!ids.length) {
    box.innerHTML = '<div style="font:400 11px/1.45 var(--mono);color:var(--muted)">0 peers connected right now. Open <code>/kernel</code> in another tab or device to form a live interaction-net mesh.</div>';
    return;
  }
  box.innerHTML = '';
  ids.forEach(id => {
    const p = peers.get(id);
    const d = document.createElement('div');
    d.className = 'peer-item';
    const root = (p.manifest && p.manifest.root) ? p.manifest.root : 'empty';
    const pub = (p.manifest && Array.isArray(p.manifest.published)) ? p.manifest.published : [];
    const head = document.createElement('div');
    head.innerHTML = '<b>' + id + '</b> <span style="opacity:.65">[' + p.transport + ' · root ' + root.slice(0, 10) + ']</span>';
    d.appendChild(head);
    if (!pub.length) {
      const sub = document.createElement('div');
      sub.style.cssText = 'opacity:.6;font-size:10.5px;margin-top:2px';
      sub.textContent = '0 published modules (compute worker ready)';
      d.appendChild(sub);
    } else {
      pub.forEach(m => {
        const mr = document.createElement('div');
        mr.className = 'peer-mod';
        const sp = document.createElement('span');
        sp.textContent = m.path + ' (' + m.sha256.slice(0, 8) + ')';
        const btn = document.createElement('button');
        btn.className = 'mini-btn';
        btn.textContent = 'Pull & Check';
        btn.onclick = () => pullPublishedFromPeer(id, m.path, m.sha256);
        mr.appendChild(sp);
        mr.appendChild(btn);
        d.appendChild(mr);
      });
    }
    box.appendChild(d);
  });
}

async function onMeshPacket(pkt, viaTransport, rtcChannel) {
  if (!pkt || !pkt.from || pkt.from === myPeerId) return;
  if (pkt.to && pkt.to !== myPeerId) return;
  let p = peers.get(pkt.from);
  if (!p) {
    p = { id: pkt.from, transport: viaTransport, pc: null, dc: rtcChannel || null, manifest: null, lastSeen: Date.now() };
    peers.set(pkt.from, p);
  } else {
    p.lastSeen = Date.now();
    if (rtcChannel) { p.dc = rtcChannel; p.transport = 'WEBRTC'; }
  }

  if (pkt.t === 'HELLO') {
    const man = await buildMyManifest();
    sendToPeer(pkt.from, { t: 'MANIFEST', manifest: man });
    renderPeersUI();
  } else if (pkt.t === 'MANIFEST') {
    p.manifest = pkt.manifest;
    renderPeersUI();
  } else if (pkt.t === 'WANT' && pkt.h) {
    // Sovereign curation check (curated-private-withheld): ONLY serve objects that are PUBLISHED or public core/lib!
    let allowed = false;
    workspace.forEach(rec => {
      if (rec.sha256 === pkt.h && rec.visibility === 'public') allowed = true;
    });
    if (publicHashAllowlist.has(pkt.h)) allowed = true;
    if (!allowed) {
      sendToPeer(pkt.from, { t: 'WITHHELD', h: pkt.h });
      return;
    }
    const txt = await casGet(pkt.h);
    if (txt !== null) sendToPeer(pkt.from, { t: 'OBJ', h: pkt.h, s: txt });
  } else if (pkt.t === 'OBJ' && pkt.h && typeof pkt.s === 'string') {
    try {
      await casPutVerified(pkt.h, pkt.s);
      publicHashAllowlist.add(pkt.h);
      const ws = pendingWants.get(pkt.h);
      if (ws) { pendingWants.delete(pkt.h); ws.forEach(fn => fn(pkt.s)); }
    } catch (err) {
      outEl.textContent += '\n[SECURITY] ' + err.message + ' from ' + pkt.from;
    }
  } else if (pkt.t === 'CUT_REQ' && pkt.reqId && pkt.code) {
    // Execute remote interaction-net cut inside our isolated WASM worker!
    if (Array.isArray(pkt.deps)) {
      for (const dep of pkt.deps) {
        if (dep.path && dep.sha256) {
          let txt = await casGet(dep.sha256);
          if (txt === null) txt = await p2pWantHash(dep.sha256);
          if (txt !== null) worker.postMessage({ type: 'put_mod', rel: dep.path, txt, sha256: dep.sha256 });
        }
      }
    }
    runWorkerCut(pkt.code).then(res => {
      sendToPeer(pkt.from, {
        t: 'CUT_RES',
        reqId: pkt.reqId,
        ok: res.ok,
        output: res.output,
        steps: res.steps,
        ms: res.ms
      });
    });
  } else if (pkt.t === 'CUT_RES' && pkt.reqId) {
    const waiter = pendingCuts.get(pkt.reqId);
    if (waiter) {
      clearTimeout(waiter.timer);
      pendingCuts.delete(pkt.reqId);
      waiter.resolve({ ...pkt, peerId: pkt.from });
    }
  }
}

