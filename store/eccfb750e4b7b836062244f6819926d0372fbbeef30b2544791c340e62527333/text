mdiff-lt : (B p x : Word) → wlt p B ≡ true → wlt x B ≡ true → wlt (mdiff-val B p x) B ≡ true
mdiff-lt B p x hp hx =
  ifP {λ b → wlt (if b then wsub (wadd x B) p else wsub x p) B ≡ true} {wlt x p}
    (λ e →
       let hle : wlt (wadd x B) p ≡ false
           hle = cm-le-trans p B (wadd x B) (cm-lt-asym p B hp) (cm-le-add-r x B)
           hlt : wlt (wadd x B) (wadd p B) ≡ true
           hlt = cm-catb (cm-congb (λ z → wlt z (wadd p B)) (cm-wadd-comm x B))
                   (cm-catb (cm-congb (λ z → wlt (wadd B x) z) (cm-wadd-comm p B))
                     (cm-lt-shift B x p e))
       in cm-wsub-lt-of-lt-add (wadd x B) p B hle hlt)
    (λ e → cm-le-lt-trans (wsub x p) x B (cm-wsub-le x p) hx)
