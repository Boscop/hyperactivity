-- a query with the point 0 is at most an entry exactly when it is at most the entry's suffix
si-key : (c : List (List Word)) → (e : El entry-ord) → leq {entry-ord} (c , #0) e ≡ lexle (lexle word-le) c (fst e)
si-key c e = concat (λ k → lex-step (lexle (lexle word-le) c (fst e)) (lexle (lexle word-le) (fst e) c) (not (wlt-x0 (snd e) k)))
  (sq-step-true (lexle (lexle word-le) c (fst e)) (lexle (lexle word-le) (fst e) c))
