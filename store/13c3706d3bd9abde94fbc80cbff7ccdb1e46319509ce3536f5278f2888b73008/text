-- an eliminator meeting a blocked value becomes a blocked value: the value is set on a new wire,
-- and the result holds that wire and the eliminator's arguments; an eliminator with branches has
-- them built in its environment first, each on a wire
nk-stuck-el : Word → NkTm → NkEnv → Word → NkVal → Word → NkOut
nk-stuck-el h nk-nil aux out v n = nk-plan-of (nkf-val n v (nkf-val out (nkv (hd-stuck h) (nke-cons n aux)) nkf-nil)) (%wsucc n)
nk-stuck-el h cs aux out v n = nk-stuckm-at h n out (nk-build cs aux out (nk-plan-of (nkf-val n v nkf-nil) (%wsucc n)))
