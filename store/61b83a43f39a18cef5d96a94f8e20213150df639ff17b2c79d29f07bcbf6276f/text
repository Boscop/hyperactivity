-- Pure checked DAW effect algebra (tempo, loop, 1/64th grid, clips, notes, synth patch, mix, live WASM DSP)
data DawEffect
  = daw-bpm (bpm : Word)
  | daw-loop (startBar : Word) (endBar : Word)
  | daw-grid (snapSixtyFourths : Word)
  | daw-clear (trk : Word)
  | daw-clip (trk : Word) (startBar : Word) (lenBars : Word) (name : List Word)
  | daw-note (trk : Word) (stepQ : Word) (row : Word) (durQ : Word) (velPct : Word)
  | daw-patch (trk : Word) (kind : List Word) (cutPct : Word) (resPct : Word) (drvPct : Word) (fmPct : Word)
  | daw-mix (trk : Word) (gainPct : Word) (revPct : Word) (dlyPct : Word)
  | daw-wasm (expr : List Word)
  | daw-mesh4
  | daw-play (on : Bool)
  | daw-seq (a : DawEffect) (b : DawEffect)
