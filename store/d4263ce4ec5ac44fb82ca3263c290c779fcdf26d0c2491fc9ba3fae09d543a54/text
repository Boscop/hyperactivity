-- the candidates that are roots of m, zero excluded where the exponent a > 0
p-roots-in : List SQ → Nat → List PCand → List PCand
p-roots-in m a cs = case cs of
  nil → nil
  cons c rest → (if sq-nz (poly-eval m (fst c)) then p-roots-in m a rest else (if sq-nz (fst c) then cons c (p-roots-in m a rest) else (if eqb a zero then cons c (p-roots-in m a rest) else p-roots-in m a rest)))
