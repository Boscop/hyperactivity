nk-compat-b-s : NkTm → NkTm → Word → NkTm → NkTm → Bool
nk-compat-b-s kdefs ctx n b (nk-cons c r) =
  if nk-compat-s-s kdefs ctx n (nk-nth (nk-args b) #1) (nk-nth (nk-args c) #1) (nk-br-clauses-s kdefs ctx n b) (nk-br-clauses-s kdefs ctx n c)
    then nk-compat-b-s kdefs ctx n b r else false
nk-compat-b-s kdefs ctx n b t = true
