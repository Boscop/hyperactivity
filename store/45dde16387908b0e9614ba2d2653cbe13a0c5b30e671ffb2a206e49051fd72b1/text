-- ============================================================================

-- Exact p-adic valuation v_p(m) of a positive Word m (bounded fuel)
cm-vp-go : Nat → Word → Word → Word → Word
cm-vp-go zero _ _ acc = acc
cm-vp-go (suc rem) m p acc =
  if %weq (%wmod m p) #0 then cm-vp-go rem (%wdiv m p) p (%wsucc acc) else acc

cm-vp : Word → Word → Word
cm-vp m p = if orB (%weq m #0) (%wlt p #2) then #0 else cm-vp-go (toNat #32) m p #0

-- Exact Hurwitz-Lemniscate periodicity step:
-- When derivative order n advances by (p^2 - 1), the smooth CM valuation bound advances by EXACTLY +p!
cm-period-step-ok : Word → Word → Bool
cm-period-step-ok p n =
  let step = %wsub (%wmul p p) #1
  in %weq (rh-cm-lemniscate-vp (%wadd n step) p) (%wadd p (rh-cm-lemniscate-vp n p))

-- THEOREM 2 (ZERO FLOOR-DRIFT PERIODICITY OF HEIGHT-2 CM VALUATIONS — 0 POSTULATES!):
-- Proves floor((n + (p^2 - 1)) * p / (p^2 - 1)) == p + floor(n * p / (p^2 - 1)) across
-- ALL n = 1..100 for inert primes p in {3, 7, 11, 19, 23} — proving ZERO cumulative rounding error!
cm-thm-zero-floor-drift :
  andB (rz-all-upto #100 (cm-period-step-ok #3))
  (andB (rz-all-upto #100 (cm-period-step-ok #7))
  (andB (rz-all-upto #100 (cm-period-step-ok #11))
  (andB (rz-all-upto #100 (cm-period-step-ok #19))
        (rz-all-upto #100 (cm-period-step-ok #23))))) ≡ true
cm-thm-zero-floor-drift = refl

