sg-compile-defs0 : NkRawSig → Lst (Word × (Code × Code)) → NkTm
sg-compile-defs0 _ lnil = nk-nil
sg-compile-defs0 rsig (lcons e r) =
  let go = nk-of-code-s (toNat #800) rsig
      bt = go (fst (snd e))
      tyt = go (snd (snd e))
  in if orB (nk-has-fail bt) (nk-has-fail tyt)
       then nk-cons (nk-con #55 (nk-cons nk-fail (nk-cons nk-fail nk-nil))) (sg-compile-defs0 rsig r)
       else nk-cons (nk-con #55 (nk-cons bt (nk-cons tyt nk-nil))) (sg-compile-defs0 rsig r)
