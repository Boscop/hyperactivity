-- by the head of the line: the numbers and the universe are constant lines, the point unchanged;
-- a function type and a path type by their clauses; a line whose head is not known yet stays
nk-transp-at : NkTm → NkTm → NkTm → NkTm → NkTm
nk-transp-at (nk-con c args) line phi a =
  if %weq c #3 then a
  else (if %weq c #2 then a
  else (if %weq c #1 then nk-transp-pi (nk-lam (nk-nth args #0)) (nk-lam (nk-nth args #1)) phi a
  else (if %weq c #4 then nk-transp-path (nk-lam (nk-nth args #0)) (nk-lam (nk-nth args #1)) (nk-lam (nk-nth args #2)) phi a
  else (if %weq c #6 then nk-transp-sig (nk-lam (nk-nth args #0)) (nk-lam (nk-nth args #1)) phi a
  else nk-transp line phi a))))
nk-transp-at t line phi a = nk-transp line phi a
