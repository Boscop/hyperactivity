bw-flag : (A : Type) → (z one : A) → (ad mu : A → A → A) → (ng : A → A) → (isz : A → Bool) → (n : Nat) → (sy-vn A n → sy-vn A n → A) → Bool
bw-flag A z one ad mu ng isz n = case n return λ k → (sy-vn A k → sy-vn A k → A) → Bool of
  zero → λ f → true
  suc m → λ f → if isz (f (bw-e A z one m) (bw-e A z one m)) then false else bw-flag A z one ad mu ng isz m (bw-g A z one ad mu ng m f)
