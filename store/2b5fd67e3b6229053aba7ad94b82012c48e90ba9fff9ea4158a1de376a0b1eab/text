-- and there are exactly n² of them, for every n: the degeneracy of hydrogen's n-th level, which the
-- so(4) symmetry predicts and the spectrum shows
shell-square : (n : Nat) → shell-states n ≡ times n n
shell-square n = case n return (λ m → shell-states m ≡ times m m) of
  zero → (λ i → zero)
  suc k → concat (cong (λ x → plus x (suc (plus k k))) (shell-square k)) (concat (plus-suc (times k k) (plus k k)) (cong suc (concat (plus-comm (times k k) (plus k k)) (concat (plus-assoc k k (times k k)) (cong (plus k) (sym (times-suc k k)))))))
