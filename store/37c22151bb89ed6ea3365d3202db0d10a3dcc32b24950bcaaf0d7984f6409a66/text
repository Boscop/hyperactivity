cs-hy-shl-at : (za zb lt : Bool) (hp : CsHeap) (a b : Word) →
  (%weq a #0 ≡ za) → (%weq b #0 ≡ zb) → (%wlt b #64 ≡ lt) →
  cs-no-ub
    (if (if za then true else zb) then cs-ok hp (csv-word a)
     else if c-not lt then cs-abort
     else cs-hy-shl-prim hp a b (cs-c11-shr64 a (%wsub #64 b))) ≡ true
cs-hy-shl-at true zb lt hp a b ha hb hlt = refl
cs-hy-shl-at false true lt hp a b ha hb hlt = refl
cs-hy-shl-at false false false hp a b ha hb hlt = refl
cs-hy-shl-at false false true hp a b ha hb hlt =
  let g64 = cs-shl-guard b hb
      step1 = cong (λ z → cs-no-ub (cs-hy-shl-prim hp a b (if z then csp-ok (%wshr a (%wsub #64 b)) else csp-ub))) g64
      shl_ok = cong (λ z → cs-no-ub (cs-prim-res hp (if z then csp-ok (%wand (%wshl a b) cs-mask64) else csp-ub))) hlt
  in step1 ∙ cs-no-ub-if-abort (%weq (%wshr a (%wsub #64 b)) #0) (cs-prim-res hp (cs-c11-shl64 a b)) shl_ok
