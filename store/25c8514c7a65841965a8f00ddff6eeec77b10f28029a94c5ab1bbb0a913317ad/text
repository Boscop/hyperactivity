-- ---------------------------------------------------------------- 4. Concrete 3nm GAA Tapeout Witness
-- Behavioral ALU sum slice with redundant double-negation & dead constant-OR cone:
--   rtl(a, b) = ~(~((1'b0 | a) ^ b))  [4 behavioral gates → optimized to 1 XOR → 4 NAND2 cells!]
alu-sum-rtl : Circ B0 B1 B2 Bool
alu-sum-rtl =
  cop1 b1-not
    (cop1 b1-not
      (cop2 b2-xor
        (cop2 b2-or (cop0 b0-false) (cwire false))
        (cwire true)))
