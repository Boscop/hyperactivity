dm-pack-hxsv32 : Word → Word → Word → Word → List Word
dm-pack-hxsv32 seq atlasHash activeGpus surplusOrBurst =
  let kseq = %wor (%wshl #3 #24) (%wand seq #16777215)
      tg32 = %wand activeGpus #4294967295
      a32  = %wand atlasHash #4294967295
      b32  = %wand surplusOrBurst #4294967295
      c32  = #0
      mac  = dm-sov-mac64 dm-sov-secret kseq tg32 a32 b32 c32
      mhi  = %wand (%wshr mac #32) #4294967295
      mlo  = %wand mac #4294967295
  in dm-put32-be dm-sov-magic
     (dm-put32-be kseq
     (dm-put32-be tg32
     (dm-put32-be a32
     (dm-put32-be b32
     (dm-put32-be c32
     (dm-put32-be mhi
     (dm-put32-be mlo nil)))))))
