a64-stub : Word → Word → Lst Word
a64-stub n off0 =
  let pre = a64-save-callee
      setup = xcat5 (a64-insn #2432697331) (a64-mov-r #20 #2) (a64-ldr-idx #21 #20 #1) (a64-ldr-idx #22 #20 #2) (a64-mov-r #24 #0)
      adr-at = %wadd (l-count pre) (l-count setup)
      adr = a64-adr-back-x23 adr-at
      pushes = a64-stub-pushes n
      post = xcat3 (a64-drop-slots n) (a64-str-idx #21 #20 #1) a64-restore-callee
  in xcat6 pre setup adr pushes (a64-call-off off0) post
