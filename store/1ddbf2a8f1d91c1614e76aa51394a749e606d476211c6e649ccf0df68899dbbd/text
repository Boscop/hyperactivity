pl-ufind : (List (List BZ) × BZ) × (List (List BZ) × BZ) → Nat → BZ → BZ → BZ × BZ
pl-ufind pr n lo hi = case n of
  zero → (lo , hi)
  suc j → if eqb (fst (wt-crt (hc-n pr (bz-half (bz-add lo hi)) (true , bin-pow2 20)))) 0 then pl-ufind pr j (bz-half (bz-add lo hi)) hi else pl-ufind pr j lo (bz-half (bz-add lo hi))
