g-after : {M A : Type} → GProc κ (NetSig M) A → Rcv M → Word → ▸ κ (GProc κ (NetSig M) A)
g-after {κ} {M} {A} (gret a) rm w = next (gret a)
g-after {κ} {M} {A} (gcmd c k) rm w =
  (case c return (λ x → (net-resp {M} x → ▸ κ (GProc κ (NetSig M) A)) → ▸ κ (GProc κ (NetSig M) A)) of
     n-send to m → λ k2 → k2 unit
     n-recv → λ k2 → k2 rm
     n-now → λ k2 → k2 w) k
g-after {κ} {M} {A} (gtau t) rm w = t
