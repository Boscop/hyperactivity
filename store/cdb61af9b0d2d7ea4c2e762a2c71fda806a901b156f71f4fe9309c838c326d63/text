-- Electrothermal Corner Dominance on Mapped Foundry Netlists: hot/IR-dropped corner `dHot ≥ dNom`
-- upper-bounds nominal setup arrival across EVERY mapped NAND2 netlist!
nand-electrothermal-sta-mono : {V : Type} → (dNom dHot : Nat) → leB dNom dHot ≡ true →
  (arrNom arrHot : V → Nat) → ((v : V) → leB (arrNom v) (arrHot v) ≡ true) →
  (g : NandCirc V) →
  le (nand-sta-late {V} dNom arrNom g) (nand-sta-late {V} dHot arrHot g)
nand-electrothermal-sta-mono {V} dNom dHot hd arrNom arrHot hv g =
  sta-late-mono {B0} {Empty} {Unit} {V}
    (λ u → Empty-rec u) (λ u → Empty-rec u)
    (λ _ → dNom) (λ _ → dHot)
    arrNom arrHot
    (λ u → Empty-rec u)
    (λ _ → hd)
    hv g
