gt-zero-canon : (t : Bool) → (xs : List Bool) → (x : Bool) → bcanon (cons x xs) ≡ true → cmpN t (bin-to-nat (cons x xs)) zero ≡ false
gt-zero-canon t xs = case xs return λ m → (x : Bool) → bcanon (cons x m) ≡ true → cmpN t (bin-to-nat (cons x m)) zero ≡ false of
  nil → λ x → (case x return λ u → bcanon (cons u nil) ≡ true → cmpN t (bin-to-nat (cons u nil)) zero ≡ false of
    true → λ h → λ i → false
    false → λ h → absurd-ft (cmpN t zero zero ≡ false) h)
  cons c r → λ x → gt-zero-step t c r x (rec r c)
