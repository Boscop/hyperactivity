-- the front page and archive, then every published work's page and search item
s-site-all : List Word → List Work → Proc W Unit
s-site-all st nil =
  bind (s-isolated (bind (s-site-kept st "front" s-front) (λ f → ret {lzero} {W} unit))) (λ ok1 →
  bind (s-isolated (bind (s-site-kept st "archive" s-archive) (λ ar → ret {lzero} {W} unit))) (λ ok2 →
  ret {lzero} {W} unit))
s-site-all st (cons (work n k p) r) =
  bind (s-ensure-mod st "page" p (if orB (h-ends ".hypercubical" p) (h-ends ".cub" p) then s-essay p else s-doc p)) (λ ok1 →
  bind (s-ensure-mod st "corpus" p (s-corpus-one st (list-append "/" n))) (λ ok2 →
  s-site-all st r))
