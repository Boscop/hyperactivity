tso-keep-lt : {A : Type} → (p : A → Bool) → (ns : List A) → (m : A) → TsoIn m ns → (isTrue (p m) → Empty) →
              tso-len (tso-keep p ns) < tso-len ns
tso-keep-lt p nil m mm np = mm
tso-keep-lt p (cons y r) m mm np =
  (case mm of
     inl e →
       (case p y return (λ b → (isTrue b → isTrue (p y)) → tso-len (if b then cons y (tso-keep p r) else tso-keep p r) < suc (tso-len r)) of
          true → λ ev → Empty-rec (np (subst {_} {_} {_} {λ w → isTrue (p w)} (sym e) (ev unit)))
          false → λ ev → tso-keep-le p r) (λ u → u)
     inr m2 →
       (case p y return (λ b → tso-len (if b then cons y (tso-keep p r) else tso-keep p r) < suc (tso-len r)) of
          true → tso-keep-lt p r m m2 np
          false → tso-lt-le (tso-len (tso-keep p r)) (tso-len r) (tso-keep-lt p r m m2 np)))
