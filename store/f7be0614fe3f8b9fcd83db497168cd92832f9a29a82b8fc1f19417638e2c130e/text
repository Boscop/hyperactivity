flash-tiled-hom :
  (xs ys : List AttnAcc) →
  flash-fold (list-append xs ys) ≡ aacc-op (flash-fold xs) (flash-fold ys)
flash-tiled-hom nil ys = λ i → aacc-idl (flash-fold ys) (~ i)
flash-tiled-hom (cons x xs) ys =
  let ih = flash-tiled-hom xs ys
  in ht-trans (λ i → aacc-op x (ih i))
              (λ i → aacc-assoc x (flash-fold xs) (flash-fold ys) (~ i))
