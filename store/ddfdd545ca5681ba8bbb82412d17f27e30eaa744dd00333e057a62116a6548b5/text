-- ---------------------------------------------------------------- division, rationals, integers, signs
bin-of-nat-sound : (n : Nat) → bin-to-nat (bin-of-nat n) ≡ n
bin-of-nat-sound n = case n return λ m → bin-to-nat (bin-of-nat m) ≡ m of
  zero → λ i → zero
  suc k → transN (bin-succ-sound (bin-of-nat k)) (congN suc (rec k))
