-- ---------------------------------------------------------------- 3. Planetary Proof-of-Useful-Reduction Market (`lib/credit.hypercubical`)
-- `pouw-settle`: Requester `i` locks bounty `q` on channel `k` (`cr-allocate i j q k`);
-- when untrusted Worker `j` submits `(ans, validProof)`, if `validProof = true`, channel `k`
-- delivers `q` to Worker `j` (`cr-deliver i j q k`), otherwise refunds Requester `i`!
pouw-settle-valid :
  Nat → Nat → Nat → Nat → Nat → CrState → CrState
pouw-settle-valid i j q kA kD s =
  cr-move (cr-deliver i j q kD) (cr-move (cr-allocate i j q kA) s)
