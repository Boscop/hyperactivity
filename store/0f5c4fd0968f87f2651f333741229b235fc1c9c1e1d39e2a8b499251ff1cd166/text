-- ============================================================================
-- 2. Cross-Simplicity Constraint: (u ∧ v) ∧ (u ∧ w) = 0 for Adjacent Faces
-- ============================================================================
-- Two faces of a 4-simplex sharing an edge u (B = u ∧ v, C = u ∧ w; 12 variables):
--   B01 C23 - B02 C13 + B03 C12 + B12 C03 - B13 C02 + B23 C01 = 0.
lqg-cross-simplicity-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-cross-simplicity-poly A ad mu q vs =
  (λ g sub →
    let u0 = g 0; u1 = g 1; u2 = g 2; u3 = g 3
        v0 = g 4; v1 = g 5; v2 = g 6; v3 = g 7
        w0 = g 8; w1 = g 9; w2 = g 10; w3 = g 11
        b01 = sub (mu u0 v1) (mu u1 v0); c01 = sub (mu u0 w1) (mu u1 w0)
        b02 = sub (mu u0 v2) (mu u2 v0); c02 = sub (mu u0 w2) (mu u2 w0)
        b03 = sub (mu u0 v3) (mu u3 v0); c03 = sub (mu u0 w3) (mu u3 w0)
        b12 = sub (mu u1 v2) (mu u2 v1); c12 = sub (mu u1 w2) (mu u2 w1)
        b13 = sub (mu u1 v3) (mu u3 v1); c13 = sub (mu u1 w3) (mu u3 w1)
        b23 = sub (mu u2 v3) (mu u3 v2); c23 = sub (mu u2 w3) (mu u3 w2)
        t1 = ad (sub (mu b01 c23) (mu b02 c13)) (mu b03 c12)
        t2 = ad (sub (mu b12 c03) (mu b13 c02)) (mu b23 c01)
    in (ad t1 t2 , q (fn-q 0 1)))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
