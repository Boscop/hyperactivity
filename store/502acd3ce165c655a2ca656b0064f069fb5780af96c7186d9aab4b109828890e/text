-- a value: a closure, a number, a reference to a held wire, or a blocked term: a free variable, an
-- application waiting on a blocked function (the wires of the function and the argument), an
-- increment waiting on a blocked number
data NkVal = nkv-lam (b : NkTm) (e : NkEnv) | nkv-num (m : Word) | nkv-ref (w : Word) | nkv-var (x : Word) | nkv-napp (f : Word) (a : Word) | nkv-ninc (a : Word)
