syn3-xor-zero-eq : (s1 s2 : Bit3) → syn3-nonzero (syn3-xor s1 s2) ≡ false → s1 ≡ s2
syn3-xor-zero-eq s1 s2 h =
  let z  = or3-false-elim (b-xor2 (fst s1) (fst s2))
             (b-xor2 (fst (snd s1)) (fst (snd s2)))
             (b-xor2 (snd (snd s1)) (snd (snd s2))) h
      e1 = xor-eq-from-false (fst s1) (fst s2) (fst z)
      e2 = xor-eq-from-false (fst (snd s1)) (fst (snd s2)) (fst (snd z))
      e3 = xor-eq-from-false (snd (snd s1)) (snd (snd s2)) (snd (snd z))
  in λ i → (e1 i , (e2 i , e3 i))
