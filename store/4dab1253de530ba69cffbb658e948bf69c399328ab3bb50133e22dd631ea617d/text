render-runs : SInt → SInt → List RRun → List Word
render-runs koFront koBack nil = nil
render-runs koFront koBack (cons (rrun isFront _ pts) r) =
  let dFg = ribbon-poly-d pts si-zero
      seg = if isFront
            then let dKo = ribbon-poly-d (trim-ends pts) koFront
                 in lg-concat (cons "<path d='" (cons dKo (cons "' fill='#ff0a94'/><path d='" (cons dFg (cons "' fill='#fff'/>" nil)))))
            else if wlt #8 (fromNat (list-length pts))
                 then let dKo = ribbon-poly-d (trim-ends pts) koBack
                      in lg-concat (cons "<path d='" (cons dKo (cons "' fill='#ff0a94'/><path d='" (cons dFg (cons "' fill='#fff'/>" nil)))))
                 else lg-concat (cons "<path d='" (cons dFg (cons "' fill='#fff'/>" nil)))
  in list-append seg (render-runs koFront koBack r)
