-- finish: a document becomes a decomposed one (its source the document, checked equal, the file removed); a
-- decomposed one gains the pulls made, appended
hy-new-text : List Word → List Word → List (List Word) → List Word → List Word
hy-new-text f title ls decls =
  list-append (h-line (list-append "-- " (list-append (h-before ".md" f) (list-append ".hypercubical — " title))))
  (list-append (h-line "-- decomposed with hyperactive decompose (lib/selection.hypercubical): the document once, as its source, and its pieces, each a selection of its lines or their re-expression.")
  (list-append (h-line (list-append "import " (hy-q (list-append (hy-ups f) "lib/selection.hypercubical"))))
  (list-append (h-line (list-append (hy-base f) "-source : List Word"))
  (list-append (h-line (list-append (hy-base f) (list-append "-source = lines-of " (hy-lines-term ls))))
  decls))))
