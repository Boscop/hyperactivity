-- Canonical 6-function Boolean/Arithmetic gate benchmark suite: (truth_table, expected_opt_gates)
--   15=NOT(w0) [1], 192=AND2(w0,w1) [2], 252=OR2(w0,w1) [3], 102=XOR2(w0,w1) [4], 202=MUX2(w0,w1,w2) [4], 232=MAJ3(w0,w1,w2) [6]
hxl-synth-one : Word → Word → Word × Word
hxl-synth-one tbl exp_g =
  let res = hs-id tbl #6
      g   = fst res
      pr  = fst (snd res)
      ok  = if %weq g exp_g then hs-verify tbl pr (toNat g) else false
  in (if ok then #1 else #0 , g)
