inp-ok : (S : List Bool) → (envt : Nat → IV → Nat → IV) → (Et : Nat → ZQ → Nat → ZQ) →
  ((n : Nat) → (t : IV) → (tv : ZQ) → inp S t tv → (k : Nat) → inp S (envt (suc n) t k) (Et (suc n) tv k)) → env-ok S envt Et
inp-ok S envt Et h n t tv c e l = ((λ k → fst (h n t tv (c , (e , l)) k)) , ((λ k → fst (snd (h n t tv (c , (e , l)) k))) , (λ k → snd (snd (h n t tv (c , (e , l)) k)))))
