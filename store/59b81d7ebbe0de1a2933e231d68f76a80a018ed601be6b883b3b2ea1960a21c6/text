-- 7. SHA-256 Maj(a,b,c): (a & b) ^ (a & c) ^ (b & c) -> a ^ ((a ^ b) & (a ^ c)) [3 ANDs -> 1 AND, -66.7%]
cert-sha256-maj : F2OptCert
cert-sha256-maj =
  mk-f2-cert "sha256_maj"
    (f2prog #3 nil (cons (f2-xor (f2-xor (f2-and (f2-v #0) (f2-v #1)) (f2-and (f2-v #0) (f2-v #2))) (f2-and (f2-v #1) (f2-v #2))) nil))
    (f2prog #3 nil (cons (f2-xor (f2-v #0) (f2-and (f2-xor (f2-v #0) (f2-v #1)) (f2-xor (f2-v #0) (f2-v #2)))) nil))
    refl refl
