nk-plan-at : (s : NkSlot) (u n : Word) (a b : NkSlots) → (nk-get a (nk-rw s u) ≡ nk-get b (nk-rw s u)) → nk-plan s u n a ≡ nk-plan s u n b
nk-plan-at (nks-pair o v) u n a b e = nk-plan-by-at (nk-held o v) o v u n a b e
nk-plan-at nks-none u n a b e = refl
nk-plan-at (nks-val v) u n a b e = refl
nk-plan-at (nks-op o) u n a b e = refl
