nk-fwd-step-out : (sl : NkSlots) (u out n : NkW) (v : NkVal) →
  (nk-get sl u ≡ nks-pair (nko-fwd out) v) → (nk-weq u out ≡ false) →
  nk-get (nk-step-at u n sl) out ≡ nk-ch (nkc-val v) (nk-get sl out)
nk-fwd-step-out sl u out n v pu neq =
  let sl1 = nk-upd sl u (nk-ch (nkc-put nks-none))
  in cong (λ fx → nk-get (nk-do fx sl) out) (nk-fwd-plan-fx sl u out n v pu)
     ∙ (nk-get-set sl1 out (nk-ch (nkc-val v) (nk-get sl1 out))
     ∙ cong (nk-ch (nkc-val v)) (nk-get-set-other sl u out nks-none neq))
