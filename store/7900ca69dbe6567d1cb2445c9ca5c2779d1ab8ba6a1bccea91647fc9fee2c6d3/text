-- the coordinates of −a are a's swapped: fst (toZ2 (negZ a)) = snd (toZ2 a) and the other way
toZ2-neg-fst : (a : Int) → plusw (fst (toZ2 a)) (fst (toZ2 (negZ a))) ≡ plusw #0 (plusw (fst (toZ2 a)) (snd (toZ2 a)))
toZ2-neg-fst a =
  case a return (λ w → plusw (fst (toZ2 w)) (fst (toZ2 (negZ w))) ≡ plusw #0 (plusw (fst (toZ2 w)) (snd (toZ2 w)))) of
    pos n → (case n return (λ m → plusw (fst (toZ2 (pos m))) (fst (toZ2 (negZ (pos m)))) ≡ plusw #0 (plusw (fst (toZ2 (pos m))) (snd (toZ2 (pos m))))) of
               zero → λ i → #0
               suc k → sym (plusw-zero-l (plusw (%wsucc (fromNat k)) #0)))
    negsuc n → sym (plusw-zero-l (plusw #0 (%wsucc (fromNat n))))
