-- ---------------------------------------------------------------- the index's guarantee
si-fast-chk : (T : List (List Word)) → (n : Nat) → (B : Bytes n) → (r : Word) → (g : Nat) → isTrue (si-chk-tree n B (build g (suffix-array-fast T)) r) → isTrue (si-chk-tree n B (build g (suffix-array T)) r)
si-fast-chk T n B r g ht = subst {_} {_} {List (El entry-ord)} {λ l → isTrue (si-chk-tree n B (build {El entry-ord} g l) r)} (suffix-array-fast-is T) ht
