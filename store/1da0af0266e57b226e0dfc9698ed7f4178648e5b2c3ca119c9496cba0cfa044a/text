-- every rule: the operation and the value that met, and the first wire name the rule may use.
-- apply and increment facing a reference are not rules: that is a read, the memory's (nk-plan-read)
nk-rule : NkOp → NkVal → Word → NkOut
nk-rule (nko-app arg out) (nkv-lam b e) n = nk-build b (nke-cons arg e) out (nk-out nkf-nil n)
nk-rule (nko-app arg out) (nkv-num m) n = nk-out (nkf-op arg nko-era nkf-nil) n
nk-rule (nko-app arg out) (nkv-ref w) n = nk-out nkf-nil n
nk-rule (nko-inc out) (nkv-lam b e) n = nk-out (nk-era-env e nkf-nil) n
nk-rule (nko-inc out) (nkv-num m) n = nk-out (nkf-val out (nkv-num (%wsucc m)) nkf-nil) n
nk-rule (nko-inc out) (nkv-ref w) n = nk-out nkf-nil n
nk-rule (nko-dup a b) (nkv-lam t nke-nil) n = nk-out (nkf-val a (nkv-lam t nke-nil) (nkf-val b (nkv-lam t nke-nil) nkf-nil)) n
nk-rule (nko-dup a b) (nkv-lam t (nke-cons w r)) n = nk-out (nkf-val n (nkv-lam t (nke-cons w r)) (nkf-val a (nkv-ref n) (nkf-val b (nkv-ref n) nkf-nil))) (%wsucc n)
nk-rule (nko-dup a b) (nkv-num m) n = nk-out (nkf-val a (nkv-num m) (nkf-val b (nkv-num m) nkf-nil)) n
nk-rule (nko-dup a b) (nkv-ref w) n = nk-out (nkf-val a (nkv-ref w) (nkf-val b (nkv-ref w) nkf-nil)) n
nk-rule nko-era (nkv-lam b e) n = nk-out (nk-era-env e nkf-nil) n
nk-rule nko-era (nkv-num m) n = nk-out nkf-nil n
nk-rule nko-era (nkv-ref w) n = nk-out nkf-nil n
nk-rule (nko-fwd out) v n = nk-out (nkf-val out v nkf-nil) n
