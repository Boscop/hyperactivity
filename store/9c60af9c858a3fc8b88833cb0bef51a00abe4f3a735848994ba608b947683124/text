hypernet16-slice-hier : GdsHier
hypernet16-slice-hier =
  gh-join (gh-leaf (cmos7-cell-boxes #3 #3))
    (gh-join (gh-leaf (cmos7-cell-boxes #2 #7))
      (gh-join (gh-leaf (cmos7-cell-boxes #2 #7))
        (gh-join (gh-leaf (cmos7-cell-boxes #2 #8))
          (gh-join (gh-leaf (cmos7-cell-boxes #2 #8))
