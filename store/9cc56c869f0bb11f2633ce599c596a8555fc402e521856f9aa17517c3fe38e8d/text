-- the readers' documents (readers/READER.md): their paths picked from the source's module names while still in
-- hex (the hex of "readers/" begins every one), kept in the store (STORE/hi/readers) with the time of the
-- modules directory they were read at, and read again only when that time has moved
hi-reader-paths : Proc W (List (List Word))
hi-reader-paths = bind (h-file-time (list-append h-index "/modules")) (λ t → bind (h-env "CUBICAL_STORE") (λ e →
  bind (h-read (list-append (h-store-of e) "/hi/readers")) (λ c → hi-readers-or (h-store-of e) (h-decimal t) c)))
