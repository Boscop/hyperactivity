-- its search, outside every proof: the largest λ at which Temple's form has one negative direction
pl-tfind : BQ → (List (List BQ) × List (List BQ)) × List (List (BQ × (BQ × BQ))) → Nat → BZ → BZ → BZ × BZ
pl-tfind mu m n lo hi = case n of
  zero → (lo , hi)
  suc j → if eqb (fst (wt-crt (pl-tblk mu (pl-q (bz-half (bz-add lo hi))) pl-l1 pl-p1 m))) 1 then pl-tfind mu m j (bz-half (bz-add lo hi)) hi else pl-tfind mu m j lo (bz-half (bz-add lo hi))
