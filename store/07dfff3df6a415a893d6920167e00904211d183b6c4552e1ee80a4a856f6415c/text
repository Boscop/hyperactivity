-- SECTION 4: PURE .hypercubical NATIVE TOPOLOGICAL CLASSIFIER CLI (`emit-c-cli-opt`)
--   Classifies canonical geometric/texture archetypes (Flat, Vertical Edge,
--   Horizontal Edge, Corner/T-Junction, Checkerboard) under arbitrary brightness
--   shifts & verifies 0-error fiber invariance live!
-- ============================================================================

vc-w : Word → Z
vc-w w = zpos (toNat w)

vc-proto-flat : Patch3
vc-proto-flat = patch3 (vc-w #10) (vc-w #10) (vc-w #10) (vc-w #10) (vc-w #10) (vc-w #10) (vc-w #10) (vc-w #10) (vc-w #10)

vc-proto-vedge : Patch3
vc-proto-vedge = patch3 (vc-w #0) (vc-w #0) (vc-w #20) (vc-w #0) (vc-w #0) (vc-w #20) (vc-w #0) (vc-w #0) (vc-w #20)

vc-proto-hedge : Patch3
vc-proto-hedge = patch3 (vc-w #0) (vc-w #0) (vc-w #0) (vc-w #0) (vc-w #0) (vc-w #0) (vc-w #20) (vc-w #20) (vc-w #20)

vc-proto-corner : Patch3
vc-proto-corner = patch3 (vc-w #0) (vc-w #0) (vc-w #0) (vc-w #0) (vc-w #20) (vc-w #20) (vc-w #0) (vc-w #20) (vc-w #20)

vc-proto-checker : Patch3
vc-proto-checker = patch3 (vc-w #0) (vc-w #20) (vc-w #0) (vc-w #20) (vc-w #0) (vc-w #20) (vc-w #0) (vc-w #20) (vc-w #0)

vc-nat-to-w : Nat → Word
vc-nat-to-w zero    = #0
vc-nat-to-w (suc n) = %wadd #1 (vc-nat-to-w n)

vc-best-of : Word → Word → Word → Word → Word → Word
vc-best-of d0 d1 d2 d3 d4 =
  let b1 = if %wlt d1 d0 then #1 else #0
      m1 = if %wlt d1 d0 then d1 else d0
      b2 = if %wlt d2 m1 then #2 else b1
      m2 = if %wlt d2 m1 then d2 else m1
      b3 = if %wlt d3 m2 then #3 else b2
      m3 = if %wlt d3 m2 then d3 else m2
  in if %wlt d4 m3 then #4 else b3

vc-classify-p3 : Patch3 → Word
vc-classify-p3 p =
  let s = vc-topo-sig p
  in vc-best-of
       (vc-nat-to-w (vc-sig-dist s (vc-topo-sig vc-proto-flat)))
       (vc-nat-to-w (vc-sig-dist s (vc-topo-sig vc-proto-vedge)))
       (vc-nat-to-w (vc-sig-dist s (vc-topo-sig vc-proto-hedge)))
       (vc-nat-to-w (vc-sig-dist s (vc-topo-sig vc-proto-corner)))
       (vc-nat-to-w (vc-sig-dist s (vc-topo-sig vc-proto-checker)))

vc-main : List (List Word) → Step W Word
vc-main _ =
  let c0 = vc-classify-p3 (vc-shift-p3 (vc-w #77) vc-proto-flat)
      c1 = vc-classify-p3 (vc-shift-p3 (vc-w #42) vc-proto-vedge)
      c2 = vc-classify-p3 (vc-shift-p3 (vc-w #99) vc-proto-hedge)
      c3 = vc-classify-p3 (vc-shift-p3 (vc-w #13) vc-proto-corner)
      c4 = vc-classify-p3 (vc-shift-p3 (vc-w #55) vc-proto-checker)
      ok = andB (%weq c0 #0) (andB (%weq c1 #1) (andB (%weq c2 #2) (andB (%weq c3 #3) (%weq c4 #4))))
      hit = if ok then #5 else #0
      frame = sov-pack-pkt sov-test-secret (sov-pkt pk-witness #46 hit #5 #0 #6)
