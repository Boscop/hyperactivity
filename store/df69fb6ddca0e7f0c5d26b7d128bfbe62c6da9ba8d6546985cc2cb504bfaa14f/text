os-violations : List (List Word × (List Word × (Word × Word))) → Proc W (List (List Word))
os-violations es = bind (os-paths-of es) (λ ps → bind (os-collect (os-kept (os-first-each nil (os-sort (list-length ps) ps)) es)) (λ c → ret (list-append (fst c) (os-twice nil nil (os-sort (list-length (snd c)) (snd c))))))
