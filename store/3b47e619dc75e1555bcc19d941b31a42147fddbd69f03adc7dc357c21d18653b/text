sv-rom-cases : Word → List HartInst → List Word
sv-rom-cases idx nil = nil
sv-rom-cases idx (cons inst rest) =
  let line = sv-concat
               (cons "      8'h"
               (cons (cons (sv-hex-digit (%wand (%wshr idx #4) #15))
                     (cons (sv-hex-digit (%wand idx #15)) nil))
               (cons ": inst = 32'h"
               (cons (sv-hex8 (encode-hart-inst inst))
               (cons ";" (cons sv-nl nil))))))
  in list-append line (sv-rom-cases (%wsucc idx) rest)
