-- Bogoliubov unitary diagonalization norm identity:
-- With Bogoliubov amplitudes (u, v), diagonalized energy E = (u² - v²)ξ - 2uvΔ and
-- off-diagonal anomalous term O = (u² - v²)Δ + 2uvξ satisfy:
--   E² + O² = (u² + v²)² (ξ² + Δ²).
-- Thus when u² + v² = 1 (canonical anticommutation) and O = 0 (gap condition), E² = ξ² + Δ².
-- Variables (0..3): u, v, ξ, Δ.
phys-bdg-rot-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
phys-bdg-rot-poly A ad mu q vs =
  (λ g sub sq →
    let u = g 0; v = g 1; xi = g 2; del = g 3
        q2 = q (fn-q 2 1)
        u2mv2 = sub (sq u) (sq v)
        u2pv2 = ad (sq u) (sq v)
        uv2 = mu q2 (mu u v)
        E = sub (mu u2mv2 xi) (mu uv2 del)
        O = ad (mu u2mv2 del) (mu uv2 xi)
        lhs = ad (sq E) (sq O)
        rhs = mu (sq u2pv2) (ad (sq xi) (sq del))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
