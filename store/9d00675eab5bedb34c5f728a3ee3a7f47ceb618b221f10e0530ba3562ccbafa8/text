adj-implies-after : (minS : Nat) → (rs : List Rect) → (bound : Nat) → (cur : Rect) →
  leB bound (rx0 cur) ≡ true →
  check-adj-from minS cur rs ≡ true →
  AllAfter bound (cons cur rs)
adj-implies-after minS nil = λ bound cur hb _ → (hb , unit)
adj-implies-after minS (cons nxt tail) = λ bound cur hb hAdj →
  let hSep  = andB-fst (drc-sep-x minS cur nxt) (check-adj-from minS nxt tail) hAdj
      hTail = andB-snd (drc-sep-x minS cur nxt) (check-adj-from minS nxt tail) hAdj
      hStep = leB-trans (rx0 cur) (plus minS (rx1 cur)) (rx0 nxt) (rect-span-mono minS cur) hSep
      hNxt  = leB-trans bound (rx0 cur) (rx0 nxt) hb hStep
  in (hb , adj-implies-after minS tail bound nxt hNxt hTail)
