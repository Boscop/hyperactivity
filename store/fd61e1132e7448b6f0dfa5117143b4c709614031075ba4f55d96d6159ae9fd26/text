-- the elements: carbon 6, nitrogen 7, oxygen 8, hydrogen 1
vln-el : Vln → Nat
vln-el x = case x of
  vl-c1 → 6
  vl-o1 → 8
  vl-o2 → 8
  vl-ho → 1
  vl-ca → 6
  vl-ha → 1
  vl-n → 7
  vl-hn1 → 1
  vl-hn2 → 1
  vl-cb → 6
  vl-hb → 1
  vl-cg1 → 6
  vl-g11 → 1
  vl-g12 → 1
  vl-g13 → 1
  vl-cg2 → 6
  vl-g21 → 1
  vl-g22 → 1
  vl-g23 → 1
