str-main : List (List Word) → Step W Word
str-main args =
  let p  = str-pref args
      mf = list-append p "_strike.metal"
      hf = list-append p "_strike_host.m"
      bf = list-append p "_m5_k4_boot.sh"
      tf = list-append p "_v80_build.tcl"
      rf = list-append p "_cbf_actuator_rt.c"
  in scmd w-now (λ t0 →
     scmd (w-file-write-named mf str-metal-src) (λ bm →
     scmd (w-file-write-named hf (str-host-src mf)) (λ bh →
     scmd (w-file-write-named bf str-m5-boot-sh) (λ bb →
     scmd (w-file-write-named tf str-v80-tcl) (λ bt →
     scmd (w-file-write-named rf str-cbf-rt-c) (λ br →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-STRIKE (30th Engine — Global 5-Axis Closure) | AllPillars=1 | Metal="
       (list-append (ce-dec bm)
       (list-append "B Host=" (list-append (ce-dec bh)
       (list-append "B M5Boot=" (list-append (ce-dec bb)
       (list-append "B V80TCL=" (list-append (ce-dec bt)
       (list-append "B RT-CBF=" (list-append (ce-dec br)
       (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))))))))
       (sdone #0))))))))
