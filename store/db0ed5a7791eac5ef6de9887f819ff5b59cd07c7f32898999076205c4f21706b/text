-- modules written to the descriptor, a newline after each
c-put-modules : Word → List (List Word) → Proc W Unit
c-put-modules fd nil = ret unit
c-put-modules fd (cons mh r) = bind (h-read (list-append h-source (cons #47 (list-append mh "/module")))) (λ mo →
  bind (c-put-pieces fd (h-lines (h-source-or mo))) (λ u → bind (fd-write fd (cons #10 nil)) (λ w → c-put-modules fd r)))
