nk-op-outs : NkOp → NkEnv
nk-op-outs (nko-el h cs aux out) = nke-cons out nke-nil
nk-op-outs (nko-dup a b) = nke-cons a (nke-cons b nke-nil)
nk-op-outs nko-era = nke-nil
nk-op-outs (nko-fwd out) = nke-cons out nke-nil
nk-op-outs (nko-quote d out) = nke-cons out nke-nil
nk-op-outs (nko-gather d k done todo out) = nke-cons out nke-nil
