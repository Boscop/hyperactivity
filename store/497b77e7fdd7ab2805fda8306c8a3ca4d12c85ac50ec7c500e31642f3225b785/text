nk-act-shape : (h : Word) (cs : NkTm) (hd : NkHd) (rho : NkW → NkEv) (parts : NkEnv) →
  nk-act h cs hd (nk-ev-shape (nk-env-ev rho parts)) ≡ nk-act h cs hd parts
nk-act-shape h cs hd rho parts =
  cong
    (λ z → if nk-is-iop h then (if nk-is-pt hd then nk-act-i h cs (nk-dnf-of hd) else act-none) else (if %wlt #19 h then act-stuck else z))
    (nk-act0-shape h cs hd rho parts)
