-- Inference presentations are first-class values: any verified judgment family P arrives
-- across a cubical equivalence/path e : A ≡ B via portal-arrive, and across any n-hop chain
-- via portal-arrive-chain.
sg-theory-transport : {A B : Type 0} → (P : Type 0 → Type 0) → (e : A ≡ B) → P B → P A
sg-theory-transport P e r = portal-arrive P e r
