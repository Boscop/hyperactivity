-- his colour table (screen-colors, docs/synesthesia.cub) as a JavaScript object, so the page's toggle and
-- /synesthesia draw from the one table
sy-js-pairs : List (List Word × List Word) → List Word
sy-js-pairs nil = nil
sy-js-pairs (cons e r) = h-concat (cons "'" (cons (fst e) (cons "':'" (cons (snd e) (cons "'," (cons (sy-js-pairs r) nil))))))
