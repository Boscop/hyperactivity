-- Unconditional off-switch: from any mode m, decouple back to probing mode false without proof obligation
safe-off-switch : {Sp Sa : Sig} {W A : Type} → (m : Bool)
                → ▸ κ (RProc κ (SafeGateDS Sp Sa W) A false)
                → RProc κ (SafeGateDS Sp Sa W) A m
safe-off-switch m nextp = rcmd m sg-decouple (λ u → nextp)
