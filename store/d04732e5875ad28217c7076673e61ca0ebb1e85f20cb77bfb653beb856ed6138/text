-- D inside a parameter of another data type d2 (a nested occurrence: a list of D's): positive when
-- that argument is, d2 is an ordinary data type (no indices, no dimensions, not codata), and d2's
-- parameter there occurs strictly positively in every constructor of d2 (itself recursively at its
-- own parameters, or as a field, or in a codomain or a pair)
nested-pos d pvs d2 ps =
  andb (notb (is-codata d2))
    (andb (%weq (%dnidx d2) #0)
      (let pc = params-fresh (dtel (%dent d2)) lnil
       in andb (notb (lany tel-has-dim (snd pc))) (nested-args d pvs d2 pc ps #0)))
