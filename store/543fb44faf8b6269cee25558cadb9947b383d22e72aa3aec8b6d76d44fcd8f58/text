nk-con-at-wf : (ins outs : NkEnv) (n0 nst : NkW) (c : Word) (out : NkW) (oa : NkOut) →
  (nk-in-set outs n0 nst out ≡ true) → (nk-out-ok ins outs n0 nst oa ≡ true) →
  nk-out-ok ins outs n0 nst (nk-con-at c out oa) ≡ true
nk-con-at-wf ins outs n0 nst c out (nk-out fx n ws) hout hoa =
  let ple = nk-out-ok-le ins outs n0 nst (nk-out fx n ws) hoa
      pfx = nk-out-ok-fx ins outs n0 nst (nk-out fx n ws) hoa
  in nk-out-ok-intro ins outs n0 nst (nkf-val out (nkv (hd-con c) ws) fx) n nke-nil
       ple
       (nk-and-intro (nk-in-set outs n0 n out) (nk-fx-wf ins outs n0 n fx) (nk-in-set-up outs n0 nst n out ple hout) pfx)
       refl
