nk-fx-wf-up : (ins outs : NkEnv) (n0 n1 n2 : NkW) (fx : NkFx) → (nk-wire-le n1 n2 ≡ true) → (nk-fx-wf ins outs n0 n1 fx ≡ true) → nk-fx-wf ins outs n0 n2 fx ≡ true
nk-fx-wf-up ins outs n0 n1 n2 nkf-nil p h = refl
nk-fx-wf-up ins outs n0 n1 n2 (nkf-at w c r) p h =
  nk-and-intro (nk-chg-wf ins outs n0 n2 w c) (nk-fx-wf ins outs n0 n2 r)
    (nk-chg-wf-up ins outs n0 n1 n2 w c p (nk-and-l (nk-chg-wf ins outs n0 n1 w c) (nk-fx-wf ins outs n0 n1 r) h))
    (nk-fx-wf-up ins outs n0 n1 n2 r p (nk-and-r (nk-chg-wf ins outs n0 n1 w c) (nk-fx-wf ins outs n0 n1 r) h))
