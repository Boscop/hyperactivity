bennett-zero-garbage : {St : Type} → (fwd bwd : St → St) → ((s : St) → bwd (fwd s) ≡ s) →
  (outBit : St → Bool) → (s0 : St) → (y0 : Bool) →
  bennett-run fwd bwd outBit (s0 , y0) ≡ (s0 , b-xor2 y0 (outBit (fwd s0)))
bennett-zero-garbage fwd bwd hInv outBit s0 y0 =
  λ i → (hInv s0 i , b-xor2 y0 (outBit (fwd s0)))
