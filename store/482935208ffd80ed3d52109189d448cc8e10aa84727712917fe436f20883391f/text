export-hypertensor-soc : List Word → List Word → Step W (Word × Word)
export-hypertensor-soc rtlPath tbPath =
  to-step {W} {Word × Word}
    (bind (file-write-named rtlPath hypertensor-soc-sv)     (λ nRtl →
     bind (file-write-named tbPath  hypertensor-gate-tb-sv) (λ nTb  →
       ret {lzero} {W} (nRtl , nTb))))
