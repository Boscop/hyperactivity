-- a bisection's result is a certified bracket of level j of width at most 2^−w
iq-good : (BZ → BZ → Nat × Bool) → Nat → Nat → ((BZ × BZ) × BZ) × Bool → Bool
iq-good c j w r = if snd r then (if iq-cert c j (fst r) then bz-le (bz-mul (bz-sub (snd (fst (fst r))) (fst (fst (fst r)))) (true , bin-pow2 w)) (snd (fst r)) else false) else false
