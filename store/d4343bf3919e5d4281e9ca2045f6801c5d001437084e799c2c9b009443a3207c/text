-- then ⟦bs⟧ is v at those arguments for every fuel (stated of a state that is a variable: the
-- call's state is not unfolded)
reaches-gen : (stp : X86Step) → (s s2 : X86) → (v k : Word) → Runs stp mn-ret k s s2 → weq (x86-rip s2) mn-ret ≡ true →
              opt-or (mn-result (some s2)) v ≡ v → (n : Word) → opt-or (mn-result (run-to stp n mn-ret s)) v ≡ v
reaches-gen stp s s2 v k r h e n =
  case run-to-runs stp mn-ret k s2 h s r n return (λ _ → opt-or (mn-result (run-to stp n mn-ret s)) v ≡ v) of
    inl q → cong (λ o → opt-or (mn-result o) v) q
    inr q → cong (λ o → opt-or (mn-result o) v) q ∙ e
