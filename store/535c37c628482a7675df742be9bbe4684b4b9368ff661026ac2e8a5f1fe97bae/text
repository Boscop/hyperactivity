-- past 40 occurrences of the selected end, the family is shown from the first 40 met, said to be part, its
-- agreement not claimed
c-meaning-at : Word → List Word → Proc W (Word × List (List Word)) → Proc W (List Word)
c-meaning-at e t got = if weq e #0 then ret {lzero} {W} (c-meaning nil) else bind got (λ cf →
  if wlt #40 (fst cf) then ret {lzero} {W} (list-append (h-line (list-append "(" (list-append (h-decimal (fst cf))
      (list-append " occurrences of " (list-append (h-drop-n (toNat (wsub (m-len #0 t) e)) t) "; what followed the first 40 met:)")))))
    (h-concat (list-map (λ x → h-line (list-append "  " x)) (h-dedupe (snd cf)))))
  else ret {lzero} {W} (c-meaning (h-dedupe (snd cf))))
