-- any change of plan 1 and any change of plan 2 satisfy nk-ok1? (even when outs1 overlaps ins2 or ins1 overlaps outs2!)
nk-chg-ok1 : (ins1 outs1 ins2 outs2 : NkEnv) (n1 m1 n2 m2 w k : NkW) (c d : NkCh) →
  (nk-ebound ins1 n1 ≡ true) → (nk-ebound outs1 n1 ≡ true) →
  (nk-ebound ins2 n1 ≡ true) → (nk-ebound outs2 n1 ≡ true) →
  (nk-edisj ins1 ins2 ≡ true) → (nk-edisj outs1 outs2 ≡ true) →
  (nk-wire-le n1 m1 ≡ true) → (nk-wire-le m1 n2 ≡ true) →
  (nk-chg-wf ins1 outs1 n1 m1 w c ≡ true) → (nk-chg-wf ins2 outs2 n2 m2 k d ≡ true) →
  nk-ok1? w c k d ≡ true
nk-chg-ok1 ins1 outs1 ins2 outs2 n1 m1 n2 m2 w k (nkc-put s) d bi1 bo1 bi2 bo2 di do0 p12 pm hc hd = nk-no hc
nk-chg-ok1 ins1 outs1 ins2 outs2 n1 m1 n2 m2 w k c (nkc-put s) bi1 bo1 bi2 bo2 di do0 p12 pm hc hd = nk-no hd
nk-chg-ok1 ins1 outs1 ins2 outs2 n1 m1 n2 m2 w k (nkc-val v1) (nkc-op o2) bi1 bo1 bi2 bo2 di do0 p12 pm hc hd = nk-if-same (nk-weq w k) true
nk-chg-ok1 ins1 outs1 ins2 outs2 n1 m1 n2 m2 w k (nkc-op o1) (nkc-val v2) bi1 bo1 bi2 bo2 di do0 p12 pm hc hd = nk-if-same (nk-weq w k) true
nk-chg-ok1 ins1 outs1 ins2 outs2 n1 m1 n2 m2 w k (nkc-val v1) (nkc-val v2) bi1 bo1 bi2 bo2 di do0 p12 pm hc hd =
  cong (λ z → if z then false else true) (nk-set-disj-neq outs1 outs2 n1 m1 n2 m2 w k bo1 bo2 do0 p12 pm hc hd)
nk-chg-ok1 ins1 outs1 ins2 outs2 n1 m1 n2 m2 w k (nkc-op o1) (nkc-op o2) bi1 bo1 bi2 bo2 di do0 p12 pm hc hd =
  cong (λ z → if z then false else true) (nk-set-disj-neq ins1 ins2 n1 m1 n2 m2 w k bi1 bi2 di p12 pm hc hd)
