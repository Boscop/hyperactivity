-- the elimination of x by branches B (lifted afterwards), applied to args: a new definition g, its
-- parameters the free variables of B (fv), the arguments (a of them) and the scrutinee
x-elim : Word → Lst Code → Code → Lst Code → LS → Code × LS
x-elim dd B x args st =
  let fv = x-frees-l-sorted B
      m = l-count fv
      a = l-count args
      g = snd st
      body = ccase dd (x-elim-brs dd #0 B g fv m a) (cvar #0)
  in (x-apps (cglob g) (l-app (x-fv-vars fv) (l-app args (lcons x lnil))) , (lcons (g , (%wadd m (%wadd a #1) , body)) (fst st) , %wsucc g))
