si-hom-nat : {R T : Type} → (S : SemiringOn R) → (S2 : SemiringOn T) → (h : R → T) → SemiringHom S S2 h → (n : Nat) → h (si-nat S n) ≡ si-nat S2 n
si-hom-nat {R} {T} S S2 h hh zero = fst hh
si-hom-nat {R} {T} S S2 h hh (suc n) = concat {lzero} {T} {h (si-add S (si-one S) (si-nat S n))} {si-add S2 (h (si-one S)) (h (si-nat S n))} {si-add S2 (si-one S2) (si-nat S2 n)}
  (fst (snd (snd hh)) (si-one S) (si-nat S n)) (λ k → si-add S2 (fst (snd hh) k) (si-hom-nat S S2 h hh n k))
