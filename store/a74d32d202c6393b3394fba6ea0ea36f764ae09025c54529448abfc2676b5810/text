nk-infer-brs : (NkTm → Word → NkTm → NkTm → NkTm) → NkTm → NkTm → Word → Word → NkTm → NkTm → NkTm → NkTm → NkTm
nk-infer-brs chk kdefs ctx n di ps (nk-cons cty cr) (nk-cons h hr) (nk-cons b br) =
  let recs = nk-args h
      r0 = nk-infer-br-fields chk kdefs ctx n n (nk-data-ty di ps) recs recs (nk-app-list cty ps) (nk-unwrap-susp b)
  in if nk-failed r0 then nk-infer-brs chk kdefs ctx n di ps cr hr br else r0
nk-infer-brs chk kdefs ctx n di ps ctys hs bs = nk-fail
