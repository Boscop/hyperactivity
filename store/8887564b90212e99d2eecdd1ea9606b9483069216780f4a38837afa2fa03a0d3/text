w-paras-onto : List (List Word) → List (List Word) → List (List Word)
w-paras-onto cur nil = if h-null (h-concat cur) then nil else cons (w-join (h-rev-lists cur nil)) nil
w-paras-onto cur (cons l r) = if w-blank l
  then (if h-null (h-concat cur) then w-paras-onto nil r else cons (w-join (h-rev-lists cur nil)) (w-paras-onto nil r))
  else w-paras-onto (cons l cur) r
