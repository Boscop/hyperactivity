shape-cast : (s s' : TyShape) (P : TyShape → Type 1) → P s' → Dec1 (P s)
shape-cast s-bool s-bool P x = c-derived x
shape-cast (s-pi a b) (s-pi a' b') P x =
  d-bind (P (s-pi a' b)) (P (s-pi a b)) (shape-cast b b' (λ b0 → P (s-pi a' b0)) x) (λ y → shape-cast a a' (λ a0 → P (s-pi a0 b)) y)
shape-cast (s-sig a b) (s-sig a' b') P x =
  d-bind (P (s-sig a' b)) (P (s-sig a b)) (shape-cast b b' (λ b0 → P (s-sig a' b0)) x) (λ y → shape-cast a a' (λ a0 → P (s-sig a0 b)) y)
shape-cast (s-path a) (s-path a') P x = shape-cast a a' (λ a0 → P (s-path a0)) x
shape-cast s s' P x = c-refused
