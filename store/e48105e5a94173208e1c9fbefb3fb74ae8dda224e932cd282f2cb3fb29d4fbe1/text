wl-main : List (List Word) → Step W Word
wl-main args =
  let p  = wl-pref args
      mf = list-append p ".metal"
      hf = list-append p "_host.m"
      uf = list-append p "_h100.cu"
      jf = list-append p "_protocol.json"
  in scmd w-now (λ t0 →
     scmd (w-file-write-named mf wl-metal-src) (λ bm →
     scmd (w-file-write-named hf (wl-host-src mf)) (λ bh →
     scmd (w-file-write-named uf wl-cuda-src) (λ bu →
     scmd (w-file-write-named jf wl-json-src) (λ bj →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-WETLAB Cayley-SU2=1 Verlet=1 Homology-d2=0 H1-Hess=0 ProtoInd=1 Metal="
       (list-append (ce-dec bm)
       (list-append "B Host=" (list-append (ce-dec bh)
       (list-append "B H100=" (list-append (ce-dec bu)
       (list-append "B JSON=" (list-append (ce-dec bj)
       (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))))))
       (sdone #0)))))))
