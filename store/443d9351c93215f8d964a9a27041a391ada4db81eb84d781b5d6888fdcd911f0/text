-- inc ((λg. (λf. f (f x)) (λy. g y)) (λz. inc z)): f is a closure with a part, used twice
nk-demo-term : Word → NkTm
nk-demo-term x = nk-inc (nk-app (nk-lam (nk-app (nk-lam (nk-app (nk-var #0) (nk-app (nk-var #0) (nk-num x)))) (nk-lam (nk-app (nk-var #1) (nk-var #0))))) (nk-lam (nk-inc (nk-var #0))))
