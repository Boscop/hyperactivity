-- signed addition keeps magnitudes canonical
bz-add-canon : (a b : BZ) → bcanon (snd a) ≡ true → bcanon (snd b) ≡ true → bcanon (snd (bz-add a b)) ≡ true
bz-add-canon a b ca cb = if-canon (bit-eq (fst a) (fst b)) (fst a , bin-add (snd a) (snd b))
  (if bin-leb (snd b) (snd a) then (if bin-zero (bin-sub (snd a) (snd b)) then bz-zero else (fst a , bin-sub (snd a) (snd b))) else (fst b , bin-sub (snd b) (snd a)))
  (bin-add-canon (snd a) (snd b) ca cb)
  (if-canon (bin-leb (snd b) (snd a)) (if bin-zero (bin-sub (snd a) (snd b)) then bz-zero else (fst a , bin-sub (snd a) (snd b))) (fst b , bin-sub (snd b) (snd a))
    (if-canon (bin-zero (bin-sub (snd a) (snd b))) bz-zero (fst a , bin-sub (snd a) (snd b)) (λ i → true) (subb-canon (snd a) false (snd b)))
    (subb-canon (snd b) false (snd a)))
