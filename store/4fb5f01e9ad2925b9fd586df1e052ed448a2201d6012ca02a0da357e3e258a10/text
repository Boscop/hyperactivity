sy-vn-wl : (A : Type) → (z : A) → (ad mu : A → A → A) → (ng : A → A) → (isz : A → Bool) → sy-DL A z ad mu ng isz → (n : Nat) → sy-WL A (sy-vn A n) z ad mu (sy-vz A z n) (sy-va A ad n) (sy-vs A mu n)
sy-vn-wl A z ad mu ng isz DL n = case n return λ k → sy-WL A (sy-vn A k) z ad mu (sy-vz A z k) (sy-va A ad k) (sy-vs A mu k) of
  zero → sy-wl-unit A z ad mu
  suc m → sy-wl-step A (sy-vn A m) z ad mu ng isz (sy-vz A z m) (sy-va A ad m) (sy-vs A mu m) DL (sy-vn-wl A z ad mu ng isz DL m)
