-- Key Forwarding Lemma: reading through the EX bypass mux BEFORE WB retirement equals reading
-- architectural registers AFTER WB retirement (2-line refl)!
bypass-eq-flush : (rf : RegFile) → (wbV : Bool) → (wbRd : Word) → (wbVal : Nat) → (rs : Word) →
  bypass-read rf wbV wbRd wbVal rs ≡ pipe-flush-raw rf wbV wbRd wbVal rs
bypass-eq-flush rf true  wbRd wbVal rs = refl
bypass-eq-flush rf false wbRd wbVal rs = refl
