fs-tt : (c : Bool) → plus (bitn true) (times 2 (bitn c)) ≡ plus (bitn (bit-eq true c)) (plus (bitn true) (bitn c))
fs-tt c = case c return λ w → plus (bitn true) (times 2 (bitn w)) ≡ plus (bitn (bit-eq true w)) (plus (bitn true) (bitn w)) of
  true → λ i → suc (suc (suc zero))
  false → λ i → suc zero
