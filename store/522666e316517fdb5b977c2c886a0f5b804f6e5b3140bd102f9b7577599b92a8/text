-- K(A, B, C) at α = ap/aq, A = a1 − 1, B = b1 − 1, C = c1 − 1
hq-K : Nat → Nat → Nat → Nat → Nat → BQ × (BQ × BQ)
hq-K ap aq a1 b1 c1 = n3-sc (bq-mul (bq-mul (fn-q 1 2) (bq-make true (he-fact (monus (plus a1 (plus b1 c1)) 1)) bin-one))
  (bq-mul (hq-two a1 b1) (bq-make true (he-pow (bin-of-nat aq) (plus a1 (plus b1 c1))) (he-pow (bin-of-nat (times 2 ap)) (plus a1 (plus b1 c1)))))) (hq-T a1 b1 c1)
