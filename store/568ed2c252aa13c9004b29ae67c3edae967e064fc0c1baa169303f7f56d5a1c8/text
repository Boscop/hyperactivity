mul-canon-step : (x : Bool) → (xs b : List Bool) → bcanon b ≡ true → bcanon (bin-mul xs b) ≡ true → bcanon (bin-mul (cons x xs) b) ≡ true
mul-canon-step x xs b cb h = case x return λ u → bcanon (bin-mul (cons u xs) b) ≡ true of
  true → bin-add-canon b (bin-cons false (bin-mul xs b)) cb (bin-cons-canon false (bin-mul xs b) h)
  false → bin-cons-canon false (bin-mul xs b) h
