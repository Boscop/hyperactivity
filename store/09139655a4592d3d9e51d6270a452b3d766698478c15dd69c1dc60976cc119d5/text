  (hlz-line "    device const float* x [[buffer(8)]],"
  (hlz-line "    device float* y [[buffer(9)]],"
  (hlz-line "    constant LlmDims& dm [[buffer(10)]],"
  (hlz-line "    uint row [[threadgroup_position_in_grid]],"
  (hlz-line "    uint tid [[thread_index_in_threadgroup]]) {"
