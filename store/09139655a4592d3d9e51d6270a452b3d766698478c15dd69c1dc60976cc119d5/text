  (hlz-line "// Fused Bit-Exact Lossless Top-15 Palette BF16 GEMV (1.50 bytes/weight = 25.0% less memory traffic!)"
  (hlz-line "kernel void hx_gemv_bf16_zip("
  (hlz-line "    device const uchar4* sm4 [[buffer(0)]],"
