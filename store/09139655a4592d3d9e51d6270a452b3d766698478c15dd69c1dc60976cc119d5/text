  (hlz-line "// Baseline: Uncompressed BF16 GEMV (2.00 bytes/weight)"
  (hlz-line "kernel void hx_gemv_bf16_raw("
  (hlz-line "    device const ushort4* W4 [[buffer(0)]],"
  (hlz-line "    device const float4* x4 [[buffer(1)]],"
  (hlz-line "    device float* y [[buffer(2)]],"
  (hlz-line "    constant LlmDims& dm [[buffer(3)]],"
  (hlz-line "    uint row [[threadgroup_position_in_grid]],"
  (hlz-line "    uint tid [[thread_index_in_threadgroup]]) {"
  (hlz-line "  float acc = 0.0f;"
  (hlz-line "  uint cols4 = dm.cols >> 2;"
  (hlz-line "  device const ushort4* wr = W4 + row * cols4;"
  (hlz-line "  for (uint g = tid; g < cols4; g += 128) {"
  (hlz-line "    ushort4 w = wr[g]; float4 xv = x4[g];"
  (hlz-line "    acc = fma(bf16_to_f32(w.x), xv.x, acc);"
  (hlz-line "    acc = fma(bf16_to_f32(w.y), xv.y, acc);"
  (hlz-line "    acc = fma(bf16_to_f32(w.z), xv.z, acc);"
  (hlz-line "    acc = fma(bf16_to_f32(w.w), xv.w, acc);"
  (hlz-line "  }"
  (hlz-line "  acc = simd_sum(acc);"
  (hlz-line "  threadgroup float sh[4];"
  (hlz-line "  if ((tid & 31) == 0) sh[tid >> 5] = acc;"
  (hlz-line "  threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hlz-line "  if (tid == 0) y[row] = sh[0] + sh[1] + sh[2] + sh[3];"
