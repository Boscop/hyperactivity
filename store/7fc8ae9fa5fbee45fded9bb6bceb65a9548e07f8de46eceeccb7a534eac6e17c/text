bb-pick-min-le-r :
  {C : Type 0} → (E : C → Nat) → (c1 c2 : C) →
  leb (E (bb-pick-min E c1 c2)) (E c2) ≡ true
bb-pick-min-le-r E c1 c2 =
  bb2-leb-total (E c1) (E c2)
    (λ p → transport (λ i → leb (E (if p (~ i) then c1 else c2)) (E c2) ≡ true) p)
    (λ q → (λ b r →
      (case b return (λ v → leb (E c1) (E c2) ≡ v → leb (E (if v then c1 else c2)) (E c2) ≡ true) of
        true → (λ s → s)
        false → (λ _ → bb2-leb-refl (E c2))) r)
      (leb (E c1) (E c2)) (λ i → leb (E c1) (E c2)))
