lc-fmt-l5 : Word → Word → Word → Word → List Word
lc-fmt-l5 mUsdc mWeth pUni pSlip =
  lc-ln (h-concat (cons "  4. $488M 0-bps Sieve    : Morpho_USDC=$" (cons (h-decimal mUsdc) (cons "M | Morpho_WETH=" (cons (h-decimal mWeth) (cons " ETH | UniV3_uUSDC=" (cons (h-decimal pUni) (cons " | Slipstream_uUSDC=" (cons (h-decimal pSlip) nil)))))))))
