-- (part of language-support)
rme_size : (proc_mode' : proc_mode) → (addr_size : ZI) → (nbytes : ZI) → (eff_addr : Bits #64) → (base_reg : Option ZI) → (seg_reg : ZI) → (r_x : Text) → (check_alignment? : Bool) → (mem_ptr? : Bool) → MS (Bits #128)
rme_size proc_mode' addr_size nbytes eff_addr base_reg seg_reg r_x check_alignment? mem_ptr? =
  bindS {Bits (wmul #8 (z-nat nbytes))} {Bits #128} (load_bytes_from_ea proc_mode' addr_size nbytes eff_addr base_reg seg_reg r_x check_alignment? mem_ptr?) (λ t'1 →
    retS {Bits #128} (bv-zext (wmul #8 (z-nat nbytes)) #128 t'1))
