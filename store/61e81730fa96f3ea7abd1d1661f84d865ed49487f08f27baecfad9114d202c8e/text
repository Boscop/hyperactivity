fold-spectral-laplacian-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
fold-spectral-laplacian-poly A ad mu q vs =
  (λ g sub sq →
    let w01 = g 0; w02 = g 1; w12 = g 2
        x0 = g 3; x1 = g 4; x2 = g 5
        lx0 = ad (mu w01 (sub x0 x1)) (mu w02 (sub x0 x2))
        lx1 = ad (mu w01 (sub x1 x0)) (mu w12 (sub x1 x2))
        lx2 = ad (mu w02 (sub x2 x0)) (mu w12 (sub x2 x1))
        lhs = ad (ad (mu x0 lx0) (mu x1 lx1)) (mu x2 lx2)
        rhs = ad (ad (mu w01 (sq (sub x0 x1))) (mu w02 (sq (sub x0 x2)))) (mu w12 (sq (sub x1 x2)))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
