cfs-enc-cons : Word → Nat → Nat → List Word → CtxState → (Word × Word) → FTbl → Word → SRState → SRState
cfs-enc-cons L fuel k excl st e r x st0 =
  let ft = fiber-with-esc e r
  in case ftbl-find #0 (wadd #1 x) ft of
       some _ → sr-enc-step ft L fuel st0 (wadd #1 x)
       none →
         let st1 = cfs-enc-sym L fuel k (ftbl-add-syms (cons e r) excl) st x st0
         in sr-enc-step ft L fuel st1 #0
