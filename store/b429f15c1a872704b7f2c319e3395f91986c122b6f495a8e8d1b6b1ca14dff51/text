-- (part of language-support)
ash_bits : (w_n : Word) → (i' : Bits w_n) → (c' : ZI) → Bits w_n
ash_bits w_n i' c' =
  let t'1 : Bits w_n
      t'1 =
        if (z-eq c' (zpos #0)) then
          i'
        else
          (if (z-lt (zpos #0) c') then (bv-shl w_n i' (z-nat c')) else (bv-sar w_n i' (z-nat (z-negate c'))))
  in t'1
