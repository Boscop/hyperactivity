alg-dl : (sk : Lst Entry) (X : Type 1) (G : Cube (dims sk) X) → PAlg (X → Type 1) (DL X) (λ F → DCube (dims sk) X F G)
alg-dl sk X G =
  (λ F d → dcube-fmap (dims sk) X (DL X F) F (λ x q → fst q) G d ,
   λ F d → dcube-fmap (dims sk) X (DL X F) F (λ x q → fst (snd q)) G d ,
   λ F d → dcube-fmap (dims sk) X (DL X F) (DL X F) (λ x q → rev-o X F (degen-l X x) q) G d ,
   λ F d → dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) G d ,
   λ F d → dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) G d ,
   λ k F d → gdiag DgI (λ sq p → (fst p , DL (fst p) (fst (snd p)) , snd (snd p))) (λ sq p → DCube (dims sq) (fst p) (fst (snd p)) (snd (snd p))) (λ sq p → (Line (fst p) , LineO (fst p) (fst (snd p)) , snd (snd p))) (λ s sq p → p) dg-dl sk k (X , F , G) d)
