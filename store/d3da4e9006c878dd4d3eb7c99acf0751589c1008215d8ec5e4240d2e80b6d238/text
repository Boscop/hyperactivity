nk-put-ok-fx : (u : NkW) (s : NkSlot) (n0 n1 : NkW) (ins outs : NkEnv) (fx : NkFx) →
  (nk-wire-lt u n0 ≡ true) → (nk-emem u ins ≡ false) → (nk-emem u outs ≡ false) →
  (nk-fx-wf ins outs n0 n1 fx ≡ true) → nk-ok? u (nkc-put s) fx ≡ true
nk-put-ok-fx u s n0 n1 ins outs nkf-nil lt hi ho hf = refl
nk-put-ok-fx u s n0 n1 ins outs (nkf-at k d r) lt hi ho hf =
  nk-and-intro (nk-ok1? u (nkc-put s) k d) (nk-ok? u (nkc-put s) r)
    (cong (λ z → if z then false else true) (nk-chg-clear u k n0 n1 ins outs d lt hi ho (nk-and-l (nk-chg-wf ins outs n0 n1 k d) (nk-fx-wf ins outs n0 n1 r) hf)))
    (nk-put-ok-fx u s n0 n1 ins outs r lt hi ho (nk-and-r (nk-chg-wf ins outs n0 n1 k d) (nk-fx-wf ins outs n0 n1 r) hf))
