runs-run : (stp : X86Step) → (stop k : Word) → (s : X86) → run-ok stp stop k s ≡ true → Runs stp stop k s (snd (run-of stp k s))
runs-run stp stop k =
  %welimP (λ v → (s : X86) → run-ok stp stop v s ≡ true → Runs stp stop v s (snd (run-of stp v s))) k
    (λ s h → refl)
    (λ j ih s h → runs-run-at stp stop j ih s (weq (x86-rip s) stop) refl h)
