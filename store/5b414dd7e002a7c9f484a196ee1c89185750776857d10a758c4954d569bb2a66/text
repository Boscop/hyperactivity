-- Two binary observables A, B : H → Bool are complementary at outcome yA of A if
-- the A-fiber over yA contains both a B=true history and a B=false history.
ComplementaryAt : (H : Type 0) → (H → Bool) → (H → Bool) → Bool → Type 0
ComplementaryAt H oA oB yA =
  ((hT : H) × (oA hT ≡ yA) × (oB hT ≡ true)) ×
  ((hF : H) × (oA hF ≡ yA) × (oB hF ≡ false))
