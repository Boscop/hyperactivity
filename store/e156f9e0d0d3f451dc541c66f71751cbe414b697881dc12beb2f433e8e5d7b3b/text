-- the bracket's ends checked (F(a) < 0 < F(b), every check sound), then j halvings
h2p-root : List Bool → List Bool → IV → Nat → Nat → Nat → Nat → BZ → BZ → Bool × IV
h2p-root S S2 R M K N j a b = h2p-bisect S S2 R M K N j
  (both (both (fst (h2p-at S S2 R a M K N)) (iv-neg-sure (snd (h2p-at S S2 R a M K N))))
        (both (fst (h2p-at S S2 R b M K N)) (iv-pos-sure (snd (h2p-at S S2 R b M K N)))) , (a , b))
