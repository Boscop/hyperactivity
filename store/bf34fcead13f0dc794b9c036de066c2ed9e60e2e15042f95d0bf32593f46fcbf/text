lib-cell2 : List Word → List Word → List Word → List Word → List Word → List Word
lib-cell2 cname areaStr fnStr dly trn =
  list-append
    (sv-lines
      (cons (list-append "  cell(" (list-append cname ") {"))
      (cons (list-append "    area : " (list-append areaStr ";"))
      (cons "    pin(A) { direction : input; capacitance : 1.0; }"
      (cons "    pin(B) { direction : input; capacitance : 1.0; }"
      (cons (list-append "    pin(Y) { direction : output; function : " (list-append (sv-q fnStr) ";")) nil))))))
    (list-append
      (lib-nldm-pin "A" dly trn)
      (list-append
        (lib-nldm-pin "B" dly trn)
        (sv-lines (cons "    }" (cons "  }" nil)))))
