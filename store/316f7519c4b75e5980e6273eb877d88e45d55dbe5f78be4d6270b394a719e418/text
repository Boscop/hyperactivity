-- and whether a constituent with a given tag is present, which is how a rate reads the medium: the tag
-- names the substance that catalyses the change in question. Matching the tag to the motion rather than
-- to the mixture as a whole is what this layer still owes.
mixture-has : Nat → Mixture → Bool
mixture-has n m = case m of
  nil → false
  cons c r → (case eqb (con-tag c) n of true → true; false → mixture-has n r)
