-- Branch-Resolution & Next-Line Speculative Fetch Unit:
-- Keeps speculative `%wsucc ifPc` instruction at IPC=1 on sequential/fallthrough hit; squashes on taken redirect!
spipe-resolve : (Word → HartInst) → HartState → Word → Bool → SpecPipe
spipe-resolve imem hs1 nextPc true  = spipe hs1 true nextPc (imem nextPc)
spipe-resolve imem hs1 nextPc false = spipe hs1 false #0 h-nop
