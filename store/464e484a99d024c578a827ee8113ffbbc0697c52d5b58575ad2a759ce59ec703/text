nk-fx-clear : (u n0 n1 : NkW) (ins outs : NkEnv) (fx : NkFx) → (nk-wire-lt u n0 ≡ true) → (nk-emem u ins ≡ false) → (nk-emem u outs ≡ false) → (nk-fx-wf ins outs n0 n1 fx ≡ true) → nk-clear? u fx ≡ true
nk-fx-clear u n0 n1 ins outs nkf-nil lt hi ho hf = refl
nk-fx-clear u n0 n1 ins outs (nkf-at k c r) lt hi ho hf =
  cong (λ z → if z then false else nk-clear? u r)
    (nk-chg-clear u k n0 n1 ins outs c lt hi ho (nk-and-l (nk-chg-wf ins outs n0 n1 k c) (nk-fx-wf ins outs n0 n1 r) hf))
  ∙ nk-fx-clear u n0 n1 ins outs r lt hi ho (nk-and-r (nk-chg-wf ins outs n0 n1 k c) (nk-fx-wf ins outs n0 n1 r) hf)
