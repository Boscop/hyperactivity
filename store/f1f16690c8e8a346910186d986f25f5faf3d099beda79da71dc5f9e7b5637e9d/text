hy-doc : List Word → List Word → Proc W (Sum Unit (List Word))
hy-doc m f = if hy-module-path f
  then bind (h-write "build/decompose-probe.hypercubical" (hy-source-probe f)) (λ b → bind (h-capture (cons m (cons "build/decompose-probe.hypercubical" nil))) (λ r → h-read "build/decompose-source"))
  else h-document f
