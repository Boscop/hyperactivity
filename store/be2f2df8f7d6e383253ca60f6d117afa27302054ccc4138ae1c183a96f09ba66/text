-- an operation at wire u reads a held wire, by what is held: nothing held yet, nothing asked. A
-- held value with parts is copied one level, each part of the copy a new wire holding a reference
nk-plan-read : NkSlot → NkOp → Word → Word → NkOut
nk-plan-read (nks-val (nkv-num m)) o u n = nk-out (nkf-put u (nks-pair o (nkv-num m)) nkf-nil) n
nk-plan-read (nks-val (nkv-ref y)) o u n = nk-out (nkf-put u (nks-pair o (nkv-ref y)) nkf-nil) n
nk-plan-read (nks-val (nkv-lam t e)) o u n = nk-out (nkf-put u (nks-pair o (nkv-lam t (nk-copy-env e n))) (nk-copy-fx e n)) (nk-copy-n e n)
nk-plan-read (nks-val (nkv-var x)) o u n = nk-out (nkf-put u (nks-pair o (nkv-var x)) nkf-nil) n
nk-plan-read (nks-val (nkv-lvl l)) o u n = nk-out (nkf-put u (nks-pair o (nkv-lvl l)) nkf-nil) n
nk-plan-read (nks-val (nkv-q t)) o u n = nk-out (nkf-put u (nks-pair o (nkv-q t)) nkf-nil) n
nk-plan-read (nks-val (nkv-napp f a)) o u n = nk-out (nkf-put u (nks-pair o (nkv-napp n (%wsucc n))) (nkf-val n (nkv-ref f) (nkf-val (%wsucc n) (nkv-ref a) nkf-nil))) (%wadd n #2)
nk-plan-read (nks-val (nkv-ninc a)) o u n = nk-out (nkf-put u (nks-pair o (nkv-ninc n)) (nkf-val n (nkv-ref a) nkf-nil)) (%wsucc n)
nk-plan-read nks-none o u n = nk-out nkf-nil n
nk-plan-read (nks-op p) o u n = nk-out nkf-nil n
nk-plan-read (nks-pair p v) o u n = nk-out nkf-nil n
