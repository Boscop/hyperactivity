-- the inner branch for constructor c2 against the outer constructor c with field kinds ks
inner-branches d shapes ks rest c2 c =
  case rest of
    lnil → lnil
    lcons ks2 more →
      lcons (clams (%wadd (lst-count ks2) (count-rec ks2))
               (if %weq c2 c then compare-fields d ks ks2 (lst-count ks) (count-rec ks) (lst-count ks2) (count-rec ks2) #0 #0
                else c-false))
            (inner-branches d shapes ks more (%wsucc c2) c)
