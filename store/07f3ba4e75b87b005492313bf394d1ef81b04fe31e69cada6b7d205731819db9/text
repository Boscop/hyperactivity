-- COROLLARY 3b: STRICT WELL-FOUNDED DESCENT H(dor(src, dst), dst) < H(src, dst)
sc-thm-dor-strict-lt : (src dst : SCAddr) →
  hm-lt zero (sc-hamming src dst) ≡ true →
  hm-lt (sc-hamming (sc-dor-step src dst) dst) (sc-hamming src dst) ≡ true
sc-thm-dor-strict-lt src dst h =
  web-trans-b
    (λ i → hm-le (suc (sc-hamming (sc-dor-step src dst) dst)) (sc-thm-dor-decr src dst h (~ i)))
    (hm-le-refl (suc (sc-hamming (sc-dor-step src dst) dst)))
