nk-ok-op : (fx : NkFx) (w : Word) (o : NkOp) → nk-off w (nk-puts fx) → nk-off w (nk-ops fx) → nk-ok w (nk-arrive-op o) fx
nk-ok-op nkf-nil w o hp ho = unit
nk-ok-op (nkf-val k v r) w o hp ho = (nk-ov (%weq w k) w k o v refl , nk-ok-op r w o hp ho)
nk-ok-op (nkf-op k o2 r) w o hp ho = (inl (fst ho) , nk-ok-op r w o hp (snd ho))
nk-ok-op (nkf-put k s r) w o hp ho = (inl (fst hp) , nk-ok-op r w o (snd hp) ho)
