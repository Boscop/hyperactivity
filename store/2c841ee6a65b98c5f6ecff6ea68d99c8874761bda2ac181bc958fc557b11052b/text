-- subtraction with borrow: (a − b − c) + (c + b) = a when c + b ≤ a
bin-subb-sound : (a : List Bool) → (c : Bool) → (b : List Bool) → le (plus (bitn c) (bin-to-nat b)) (bin-to-nat a) → plus (bin-to-nat (bin-subb c a b)) (plus (bitn c) (bin-to-nat b)) ≡ bin-to-nat a
bin-subb-sound a = case a return λ m → (c : Bool) → (b : List Bool) → le (plus (bitn c) (bin-to-nat b)) (bin-to-nat m) → plus (bin-to-nat (bin-subb c m b)) (plus (bitn c) (bin-to-nat b)) ≡ bin-to-nat m of
  nil → λ c b h → plus-zero-r (fst h) (plus (bitn c) (bin-to-nat b)) (snd h)
  cons x xs → λ c b h → sub-step x xs b c (rec xs) h
