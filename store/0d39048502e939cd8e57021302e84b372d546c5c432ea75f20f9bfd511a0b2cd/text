dot-add : (n : Nat) → (g1 g2 dx : SumFin n → Nat) →
  fin-dot n (add-vec n g1 g2) dx ≡ plus (fin-dot n g1 dx) (fin-dot n g2 dx)
dot-add n =
  case n return (λ m → (g1 g2 dx : SumFin m → Nat) →
    fin-dot m (add-vec m g1 g2) dx ≡ plus (fin-dot m g1 dx) (fin-dot m g2 dx)) of
    zero → λ g1 g2 dx → refl
    suc m → λ g1 g2 dx →
      transN
        (cong2N plus
          (times-distr-l (g1 (inl unit)) (g2 (inl unit)) (dx (inl unit)))
          (rec m (λ v → g1 (inr v)) (λ v → g2 (inr v)) (λ v → dx (inr v))))
        (swap4
          (times (g1 (inl unit)) (dx (inl unit)))
          (times (g2 (inl unit)) (dx (inl unit)))
          (fin-dot m (λ v → g1 (inr v)) (λ v → dx (inr v)))
          (fin-dot m (λ v → g2 (inr v)) (λ v → dx (inr v))))
