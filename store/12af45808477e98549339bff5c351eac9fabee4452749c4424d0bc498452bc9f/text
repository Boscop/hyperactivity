go-below-last : (n : Nat) → (f : Fin n → Int64) → (m j : Nat) → (h : le (suc m) n) → (hj : le (suc j) n) → (a : Array n) → j ≡ m → index n (update n a m h (f (m , h))) j hj ≡ f (j , hj)
go-below-last n f m j h hj a e =
  let q = fin-eq n j m hj h e
  in concat (cong {lzero} {lzero} {Fin n} {Int64} (λ p → index n (update n a m h (f (m , h))) (fst p) (snd p)) {the (Fin n) (j , hj)} {the (Fin n) (m , h)} q)
            (concat (index-update n a m h (f (m , h))) (cong {lzero} {lzero} {Fin n} {Int64} f {(m , h)} {(j , hj)} (sym {lzero} {Fin n} {the (Fin n) (j , hj)} {the (Fin n) (m , h)} q)))
