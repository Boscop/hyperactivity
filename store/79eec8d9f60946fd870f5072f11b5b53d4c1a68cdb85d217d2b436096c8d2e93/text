msame-sound : (a b : Mono) → msame a b ≡ true → a ≡ b
msame-sound a b =
  case a return (λ w → (b : Mono) → msame w b ≡ true → w ≡ b) of
    mone → λ b →
      (case b return (λ w → msame mone w ≡ true → mone ≡ w) of
         mone → λ p i → mone
         mvar v2 r2 → λ p → Empty-rec {lzero} {mone ≡ mvar v2 r2} (false≢true p))
    mvar v r → λ b →
      (case b return (λ w → msame (mvar v r) w ≡ true → mvar v r ≡ w) of
         mone → λ p → Empty-rec {lzero} {mvar v r ≡ mone} (false≢true p)
         mvar v2 r2 → λ p → cong-mvar (weq-sound v v2 (andbn-l (weq v v2) (msame r r2) p)) (rec r r2 (andbn-r (weq v v2) (msame r r2) p)))
  b
