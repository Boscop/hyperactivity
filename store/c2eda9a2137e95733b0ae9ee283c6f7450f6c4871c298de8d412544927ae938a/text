-- nk-wait-app: waiting is not a step (the paper's §4.5: "A read that arrives before its value exists
-- waits. Waiting is not a step."). An apply facing a reference to a held wire that holds nothing
-- yet: the step at its wire leaves the memory as it was (part of machine-in-hyperactive)
nk-wait-app : (sl : NkSlots) (u n a out w : Word) → (nk-get sl u ≡ nks-pair (nko-app a out) (nkv-ref w)) → (nk-get sl w ≡ nks-none) → nk-step-at u n sl ≡ sl
nk-wait-app sl u n a out w p q =
  cong (λ s → nk-do (nk-fx (nk-plan s u n sl)) sl) p
  ∙ cong (λ z → nk-do (nk-fx (nk-plan-read z (nko-app a out) u n)) sl) q
