v-json-context : VEnv → List Word → List Word
v-json-context env n =
  j-arr (h-concat-lists (list-map (λ m → list-map (λ d → j-obj (cons (j-field "path" (j-str d)) (cons (j-field "via" (if h-eq m n then "null" else j-str m)) nil))) (v-collect-list m (ve-ctx env))) (v-by-depth env (v-look-list n (ve-anc env)))))
