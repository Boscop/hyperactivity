-- the bytes packed: e says no byte is held yet, r how many bytes the current word has room for
os-pk : Bool → Nat → Word → List Word → List Word
os-pk e r a nil = if e then nil else cons (os-pad r a) nil
os-pk e zero a (cons x xs) = cons a (os-pk true (toNat #8) #0 (cons x xs))
os-pk e (suc zero) a (cons x xs) = cons (wadd (wmul a #256) x) (os-pk true (toNat #8) #0 xs)
os-pk e (suc (suc r)) a (cons x xs) = os-pk false (suc r) (wadd (wmul a #256) x) xs
