nk-off?-at : (c : Bool) (w k : Word) (r : NkWork) → (%weq w k ≡ c) → ((if c then false else nk-off? w r) ≡ true) → ((nk-off? w r ≡ true) → nk-off w r) → nk-off w (nkw-cons k r)
nk-off?-at true w k r p h ih = Empty-rec {lzero} {nk-off w (nkw-cons k r)} (false≢true h)
nk-off?-at false w k r p h ih = ((p , nk-weq-sym-f w k p) , ih h)
