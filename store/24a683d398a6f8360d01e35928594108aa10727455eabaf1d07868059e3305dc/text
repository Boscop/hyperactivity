-- the module laws: of Unit, and of A × W from those of W
sy-wl-unit : (A : Type) → (z : A) → (ad mu : A → A → A) → sy-WL A Unit z ad mu unit (λ p q → unit) (λ c p → unit)
sy-wl-unit A z ad mu = ((λ x → λ i → unit) , ((λ x → sy-unit-eta x) , ((λ c u v → λ i → unit) , ((λ p q x → λ i → unit) , ((λ c a y → λ i → unit) , ((λ p q r s → λ i → unit) , (λ x → sy-unit-eta x)))))))
