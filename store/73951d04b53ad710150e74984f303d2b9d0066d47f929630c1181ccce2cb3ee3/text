-- at the end of a schedule: the trace is mutually exclusive, the lock is free, and the counter
-- is the number of threads that entered (no increment lost)
spin-ok : List Word → TsoSt → Bool
spin-ok out s = andB (spin-mutex (tso-trace s) #0) (andB (weq (ts-mem s #0) #0) (weq (ts-mem s #1) (spin-sum out)))
