-- ============================================================================
-- SECTION 1: EXACT 3D HAND-PINCH HYSTERESIS & 90 HZ PHOTON-TO-PHOTON BUDGET PROOFS
-- ============================================================================
-- Joint coordinates in micrometers (um) -> exact integer squared Euclidean distance!
-- Pinch Schmitt-trigger hysteresis prevents micro-tremor chatter:
--   * Engages pinch when d^2 <= 144 mm^2 (d <= 12 mm)
--   * Releases pinch only when d^2 >= 324 mm^2 (d >= 18 mm)
--   * Holds state cleanly inside deadband (144 < d^2 < 324)!

record Vec3i =
  { v3-x : Word ; v3-y : Word ; v3-z : Word }

vp-abs-diff : Word → Word → Word
vp-abs-diff a b = if %wlt a b then %wsub b a else %wsub a b

vp-dist2 : Vec3i → Vec3i → Word
vp-dist2 a b =
  let dx = vp-abs-diff (v3-x a) (v3-x b)
      dy = vp-abs-diff (v3-y a) (v3-y b)
      dz = vp-abs-diff (v3-z a) (v3-z b)
  in %wadd (%wmul dx dx) (%wadd (%wmul dy dy) (%wmul dz dz))

-- Clean direct %wlt Schmitt trigger:
--   d2 <= 144  <==>  d2 < 145   ==> true  (pinch engaged!)
--   d2 >= 324  <==>  323 < d2   ==> false (pinch released!)
--   otherwise                   ==> prev  (tremor-immune hold!)
vp-pinch-step : Bool → Vec3i → Vec3i → Bool
vp-pinch-step prev thumb idx =
  let d2 = vp-dist2 thumb idx
  in if %wlt d2 #145 then true
     else if %wlt #323 d2 then false
     else prev

-- 90 Hz / 96 Hz / 100 Hz Apple Vision Pro R1->M2 frame budget check (in microseconds):
--   90 Hz  => 11,111 us budget
--   96 Hz  => 10,416 us budget
--   100 Hz => 10,000 us budget
vp-meets-90hz : Word → Word → Word → Word → Bool
vp-meets-90hz tSensorUs tKernelUs tMetalUs tAudioUs =
  %wlt (%wadd tSensorUs (%wadd tKernelUs (%wadd tMetalUs tAudioUs))) #11111

-- THEOREM 1: EXACT 3D PINCH HYSTERESIS TREMOR IMMUNITY & 90 HZ SUB-11MS FRAME BUDGET BY `refl`!
--   * 3-4-5 triangle (dx=6, dy=8, dz=0 => d^2 = 100 <= 144): engages pinch = true!
--   * Tremor jitter to d^2 = 225 (15 mm, inside [12..18] mm deadband): HOLDS true without false release!
--   * Open fingers to d^2 = 400 (20 mm >= 18 mm): cleanly releases pinch = false!
--   * Tremor jitter back to d^2 = 225 while open: HOLDS false without false trigger!
vp-thumb : Vec3i
vp-thumb = Vec3i { v3-x = #100 ; v3-y = #200 ; v3-z = #300 }

vp-close : Vec3i -- d^2 = 36 + 64 = 100 <= 144 (engages pinch!)
vp-close = Vec3i { v3-x = #106 ; v3-y = #208 ; v3-z = #300 }

vp-mid : Vec3i -- d^2 = 225 inside [145..323] deadband (holds state!)
vp-mid = Vec3i { v3-x = #115 ; v3-y = #200 ; v3-z = #300 }

vp-far : Vec3i -- d^2 = 400 >= 324 (releases pinch!)
vp-far = Vec3i { v3-x = #120 ; v3-y = #200 ; v3-z = #300 }

vp-thm-pinch-hysteresis-and-90hz :
  let s1 = vp-pinch-step false vp-thumb vp-close
      s2 = vp-pinch-step s1    vp-thumb vp-mid
      s3 = vp-pinch-step s2    vp-thumb vp-far
      s4 = vp-pinch-step s3    vp-thumb vp-mid
  in andB s1
     (andB s2
     (andB (if s3 then false else true)
     (andB (if s4 then false else true)
           (vp-meets-90hz #450 #800 #2100 #300)))) ≡ true
vp-thm-pinch-hysteresis-and-90hz = refl

