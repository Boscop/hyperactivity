vp-metal-p1 : List Word → List Word
vp-metal-p1 r =
  sl-ln "#include <metal_stdlib>"
  (sl-ln "using namespace metal;"
  (sl-ln "// Generated from lib/ir/vision-pro-metal.hypercubical (HX-VISIONPRO)"
  (sl-ln "// Low-Level Stereo Foveated Metal Compute Sensor <-> Actuator Kernel (M2 / A18 Pro)"
  (sl-ln "struct VpPose {"
  (sl-ln "  float3 head_pos; float3 left_thumb; float3 left_index;"
  (sl-ln "  float3 right_thumb; float3 right_index; uint triad; uint val_open;"
  (sl-ln "};"
  (sl-ln "kernel void visionpro_stereo_foveated_loop("
  (sl-ln "  device uint* stereo_rgba [[buffer(0)]],"
  (sl-ln "  device uint* actuator_out [[buffer(1)]],"
  (sl-ln "  constant VpPose& pose [[buffer(2)]],"
  (sl-ln "  constant uint2& eye_dim [[buffer(3)]],"
  (sl-ln "  uint2 gid [[thread_position_in_grid]]) {"
  (sl-ln "  uint w2 = eye_dim.x * 2u, h = eye_dim.y;"
  (sl-ln "  if (gid.x >= w2 || gid.y >= h) return;"
  (sl-ln "  uint eye = (gid.x >= eye_dim.x) ? 1u : 0u;"
  (sl-ln "  uint lx = eye ? (gid.x - eye_dim.x) : gid.x;" r)))))))))))))))))

vp-metal-p2 : List Word
vp-metal-p2 =
  sl-ln "  float ipd = eye ? 0.0315f : -0.0315f; // exact 63mm stereo interpupillary baseline"
  (sl-ln "  float u = ((float)lx / (float)eye_dim.x) * 2.0f - 1.0f;"
  (sl-ln "  float v = ((float)gid.y / (float)h) * 2.0f - 1.0f;"
  (sl-ln "  float r2_fov = u*u + v*v;"
  (sl-ln "  // Dynamic gaze-foveated raymarch step count (full 16 steps in fovea, 4 in periphery!):"
  (sl-ln "  uint steps = (r2_fov < 0.16f) ? 16u : ((r2_fov < 0.64f) ? 8u : 4u);"
  (sl-ln "  float3 ld = pose.left_thumb - pose.left_index;"
  (sl-ln "  float3 rd = pose.right_thumb - pose.right_index;"
  (sl-ln "  uint l_pinch = (dot(ld, ld) <= 0.000144f) ? 1u : 0u;"
  (sl-ln "  uint r_pinch = (dot(rd, rd) <= 0.000144f) ? 1u : 0u;"
  (sl-ln "  float3 ro = pose.head_pos + float3(ipd, 0.0f, 0.0f);"
  (sl-ln "  float3 dir = normalize(float3(u, v, -1.2f));"
  (sl-ln "  float t = 0.0f, glow = 0.0f;"
  (sl-ln "  float3 target = 0.5f * (pose.right_thumb + pose.right_index);"
  (sl-ln "  for (uint s = 0u; s < steps; s++) {"
  (sl-ln "    float3 p = ro + dir * t - target;"
  (sl-ln "    float d = length(p) - (r_pinch ? 0.08f : 0.05f);"
  (sl-ln "    glow += 0.01f / (0.002f + d * d);"
  (sl-ln "    t += max(d * 0.7f, 0.01f);"
  (sl-ln "  }"
  (sl-ln "  uint cR = min((uint)(glow * (float)(1u + (pose.triad & 7u)) * 12.0f), 255u);"
  (sl-ln "  uint cG = min((uint)(glow * (float)(1u + l_pinch * 4u) * 10.0f), 255u);"
  (sl-ln "  uint cB = min((uint)(glow * (float)(1u + r_pinch * 6u) * 16.0f), 255u);"
  (sl-ln "  stereo_rgba[gid.y * w2 + gid.x] = (255u << 24u) | (cR << 16u) | (cG << 8u) | cB;"
  (sl-ln "  if (gid.x == 0u && gid.y == 0u) {"
  (sl-ln "    actuator_out[0] = (l_pinch << 1u) | r_pinch;"
  (sl-ln "    actuator_out[1] = pose.triad;"
  (sl-ln "    actuator_out[2] = steps;"
  (sl-ln "  }"
  (sl-ln "}" nil)))))))))))))))))))))))))))))

vp-metal-src : List Word
vp-metal-src = vp-metal-p1 vp-metal-p2

