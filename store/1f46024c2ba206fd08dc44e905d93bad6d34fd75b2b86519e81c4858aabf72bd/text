nk-rho-split-below : (rho : NkW → NkEv) (e : NkEnv) (o : NkOut) (x : NkW) →
  (nk-wire-lt x (nk-n o) ≡ true) → nk-rho-split rho e o x ≡ rho x
nk-rho-split-below rho nke-nil o x lt = refl
nk-rho-split-below rho (nke-cons w r) o x lt =
  let sp = nk-split r o
      ple = fst (nk-split-bounds r o)
      ltn = nk-wire-lt-wle-trans x (nk-n o) (nk-n (nk-so sp)) lt ple
  in nk-rho-split-cons-below (nk-rho-split rho r o) w sp x ltn
     ∙ nk-rho-split-below rho r o x lt
