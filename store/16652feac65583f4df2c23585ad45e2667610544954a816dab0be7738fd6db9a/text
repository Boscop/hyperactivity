-- an operation reads a held wire: it waits if nothing is there
k-read : KSlot → Word → KOp → KState → KState
k-read ks-none w o (k-state sl rd n) = k-state (ksl-cons w (ks-readers (kos-cons o kos-nil)) sl) rd n
k-read (ks-readers os) w o (k-state sl rd n) = k-state (k-set sl w (ks-readers (kos-cons o os))) rd n
k-read (ks-val (kv-num m)) w o (k-state sl rd n) = k-state sl (kp-cons o (kv-num m) rd) n
k-read (ks-val (kv-ref y)) w o (k-state sl rd n) = k-state sl (kp-cons o (kv-ref y) rd) n
k-read (ks-val (kv-lam t e)) w o (k-state sl rd n) = k-read-copy t o rd (k-copy e sl n)
k-read (ks-op p) w o st = st
