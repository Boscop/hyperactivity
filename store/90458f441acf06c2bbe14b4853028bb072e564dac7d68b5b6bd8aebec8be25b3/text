fold-prod : {O0 O1 O2 V R T : Type} → (A : Alg O0 O1 O2 R) → (B : Alg O0 O1 O2 T) →
  (ea : V → R) → (eb : V → T) → (d : Circ O0 O1 O2 V) →
  fold (alg-prod A B) (λ v → (ea v , eb v)) d ≡ (fold A ea d , fold B eb d)
fold-prod A B ea eb (cwire v) = λ i → (ea v , eb v)
fold-prod A B ea eb (cop0 c) = λ i → (fst A c , fst B c)
fold-prod A B ea eb (cop1 u a) =
  let ih = fold-prod A B ea eb a
  in λ i → (fst (snd A) u (fst (ih i)) , fst (snd B) u (snd (ih i)))
fold-prod A B ea eb (cop2 b x y) =
  let ihx = fold-prod A B ea eb x
      ihy = fold-prod A B ea eb y
  in λ i → (snd (snd A) b (fst (ihx i)) (fst (ihy i)) , snd (snd B) b (snd (ihx i)) (snd (ihy i)))
