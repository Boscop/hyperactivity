-- Template: cpair, cfst, csnd (heap block [0, va, vb] + in-bounds p[1] and p[2] projection, zero UB)
cs-pair-template-sound : (k j : Nat) (fns : CsFns) (ars : Lst (Word × Word)) (hp hp1 hp2 : CsHeap) (env : CsEnv) (d : Word) (a b : Code) (va vb : CsVal) →
  (cs-eval k fns hp env (cs-compile j ars d a) ≡ cso-ok hp1 va) →
  (cs-eval k fns hp1 env (cs-compile j ars d b) ≡ cso-ok hp2 vb) →
  cs-eval (suc k) fns hp env (cs-compile (suc j) ars d (cpair a b))
  ≡ cs-hy-con hp2 #0 (lcons va (lcons vb lnil))
cs-pair-template-sound k j fns ars hp hp1 hp2 env d a b va vb ha hb =
  cong (λ r → cs-bind-res r (λ h1 v1 → cs-bind-res (cs-eval k fns h1 env (cs-compile j ars d b)) (λ h2 v2 → cs-hy-con h2 #0 (lcons v1 (lcons v2 lnil))))) ha
  ∙ cong (λ r → cs-bind-res r (λ h2 v2 → cs-hy-con h2 #0 (lcons va (lcons v2 lnil)))) hb
