max-v : (x y : BZ) → bcanon (snd x) ≡ true → bcanon (snd y) ≡ true → (v : Bool) → bz-le x y ≡ v → zle (zv x) (zv (if v then y else x)) × zle (zv y) (zv (if v then y else x))
max-v x y cx cy v = case v return λ u → bz-le x y ≡ u → zle (zv x) (zv (if u then y else x)) × zle (zv y) (zv (if u then y else x)) of
  true → λ e → (zle-of-true x y cx cy e , zle-refl (zv y))
  false → λ e → (zle-refl (zv x) , zle-of-false x y cx cy e)
