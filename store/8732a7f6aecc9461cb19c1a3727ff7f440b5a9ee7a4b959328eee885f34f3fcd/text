-- a word below 2^64 read back from its digits is itself
rd8-dig : (V : Word) → wlt V #18446744073709551616 ≡ true →
          rd8 (dig V #1) (dig V #256) (dig V #65536) (dig V #16777216) (dig V #4294967296) (dig V #1099511627776) (dig V #281474976710656) (dig V #72057594037927936) ≡ V
rd8-dig V h =
  catw (congw (λ z → wand z #18446744073709551615)
         (bu-dig V #56 (bu-dig V #48 (bu-dig V #40 (bu-dig V #32 (bu-dig V #24 (bu-dig V #16 (bu-dig V #8 (bu-dig V #0 (symw (wrem-one V)) refl) refl) refl) refl) refl) refl) refl) refl))
    (catw (wand-mask (wrem V #18446744073709551616) #64)
      (catw (wrem-small (wrem V #18446744073709551616) #18446744073709551616 (wrem-lt V #18446744073709551616 refl))
        (wrem-small V #18446744073709551616 h)))
