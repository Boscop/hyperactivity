-- ============================================================================
-- 1. SEMANTICS-PRESERVING PRODUCTIVE LOSSLESS COMPRESSION STEPS
-- ============================================================================

CanonStep : {A B : Type} → (A → B) → (A → Nat) → A → A → Type
CanonStep eval cost c0 c1 = (eval c0 ≡ eval c1) × le (cost c1) (cost c0)

udt-step-refl : {A B : Type} → (eval : A → B) → (cost : A → Nat) → (c : A) →
  CanonStep eval cost c c
udt-step-refl eval cost c = ((λ i → eval c) , (zero , λ i → cost c))

udt-step-compose :
  {A B : Type} → (eval : A → B) → (cost : A → Nat) →
  {c0 c1 c2 : A} →
  CanonStep eval cost c0 c1 →
  CanonStep eval cost c1 c2 →
  CanonStep eval cost c0 c2
udt-step-compose {A} {B} eval cost {c0} {c1} {c2} s01 s12 =
  (concat {lzero} {B} {eval c0} {eval c1} {eval c2} (fst s01) (fst s12) ,
   le-trans {cost c2} {cost c1} {cost c0} (snd s12) (snd s01))

