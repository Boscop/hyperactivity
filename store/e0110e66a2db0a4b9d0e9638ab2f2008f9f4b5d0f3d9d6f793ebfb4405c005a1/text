-- Univalent Confluence Diamond: any peak `b <- a -> c` of semantics-preserving symmetry rewrites
-- closes uniquely at the canonical fiber representative `best (eval b) ≡ best (eval c)`.
udt-thm-univalent-diamond :
  {A B : Type} → (eval : A → B) → (best : B → A) →
  {a b c : A} →
  eval a ≡ eval b →
  eval a ≡ eval c →
  best (eval b) ≡ best (eval c)
udt-thm-univalent-diamond eval best p q =
  cong best (concat (sym p) q)

-- Semantic soundness of the diamond apex: the converged representative computes `eval a` losslessly.
udt-thm-diamond-sound :
  {A B : Type} → (eval : A → B) → (best : B → A) →
  (sec : (y : B) → eval (best y) ≡ y) →
  {a b : A} → (p : eval a ≡ eval b) →
  eval (best (eval b)) ≡ eval a
udt-thm-diamond-sound eval best sec {a} {b} p =
  concat (sec (eval b)) (sym p)

-- DNA Fiber Equivalence: the deployed program type `A` is equivalent to `(y : B) × fiber eval y`.
udt-thm-dna-fiber-equiv :
  {A B : Type} → (eval : A → B) → Equiv A ((y : B) × fiber eval y)
udt-thm-dna-fiber-equiv eval = fiberEquiv eval

-- Any intra-fiber compression transform `g` preserves extensional system behavior identically.
udt-thm-in-fiber-preserves-semantics :
  {A B : Type} → (eval : A → B) →
  (g : (y : B) → fiber eval y → fiber eval y) →
  (c : A) → eval (in-fiber eval g c) ≡ eval c
udt-thm-in-fiber-preserves-semantics eval g c = in-fiber-key eval g c

-- Univalent Portal Transport: any market-wide or physical property `P` proved on the compressed
-- normal form `c1` transports without loss back to the unreduced real-time composition `c0`.
udt-thm-portal-analysis-transport :
  {A : Type} → {B : Type 0} → (eval : A → B) → (P : B → Type 0) →
  {c0 c1 : A} → eval c0 ≡ eval c1 → P (eval c1) → P (eval c0)
udt-thm-portal-analysis-transport {A} {B} eval P {c0} {c1} eq pc1 =
  portal-arrive {P (eval c0)} {P (eval c1)} (λ X → X) (λ i → P (eq i)) pc1

-- ============================================================================
-- 3. SYMBOLIC TRACE OVER REAL-TIME INPUT COMPOSITIONS & ALGEBRAIC SYMMETRY
-- ============================================================================

data SymExpr
  = sx-in   (slot : Nat)
  | sx-lit  (val : Nat)
  | sx-add  (l : SymExpr) (r : SymExpr)
  | sx-mul  (l : SymExpr) (r : SymExpr)

udt-nat-eq : Nat → Nat → Bool
udt-nat-eq zero    zero    = true
udt-nat-eq zero    (suc m) = false
udt-nat-eq (suc n) zero    = false
udt-nat-eq (suc n) (suc m) = udt-nat-eq n m

udt-nat-eq-sound : (a b : Nat) → udt-nat-eq a b ≡ true → a ≡ b
udt-nat-eq-sound zero zero h = λ i → zero
udt-nat-eq-sound zero (suc m) h = Empty-rec (true≢false (sym h))
udt-nat-eq-sound (suc n) zero h = Empty-rec (true≢false (sym h))
udt-nat-eq-sound (suc n) (suc m) h = congN (λ z → suc z) (udt-nat-eq-sound n m h)

udt-expr-eq : SymExpr → SymExpr → Bool
udt-expr-eq (sx-in i)    (sx-in j)    = udt-nat-eq i j
udt-expr-eq (sx-lit a)   (sx-lit b)   = udt-nat-eq a b
udt-expr-eq (sx-add a b) (sx-add c d) = if udt-expr-eq a c then udt-expr-eq b d else false
udt-expr-eq (sx-mul a b) (sx-mul c d) = if udt-expr-eq a c then udt-expr-eq b d else false
udt-expr-eq _            _            = false

udt-bool-and-l : (x y : Bool) → (if x then y else false) ≡ true → x ≡ true
udt-bool-and-l true  y h = λ i → true
udt-bool-and-l false y h = Empty-rec (true≢false (sym h))

udt-bool-and-r : (x y : Bool) → (if x then y else false) ≡ true → y ≡ true
udt-bool-and-r true  y h = h
udt-bool-and-r false y h = Empty-rec (true≢false (sym h))

udt-expr-eq-sound : (x y : SymExpr) → udt-expr-eq x y ≡ true → x ≡ y
udt-expr-eq-sound (sx-in i) (sx-in j) h = cong (λ z → sx-in z) (udt-nat-eq-sound i j h)
udt-expr-eq-sound (sx-in i) (sx-lit b) h = Empty-rec (true≢false (sym h))
udt-expr-eq-sound (sx-in i) (sx-add c d) h = Empty-rec (true≢false (sym h))
udt-expr-eq-sound (sx-in i) (sx-mul c d) h = Empty-rec (true≢false (sym h))
udt-expr-eq-sound (sx-lit a) (sx-in j) h = Empty-rec (true≢false (sym h))
udt-expr-eq-sound (sx-lit a) (sx-lit b) h = cong (λ z → sx-lit z) (udt-nat-eq-sound a b h)
udt-expr-eq-sound (sx-lit a) (sx-add c d) h = Empty-rec (true≢false (sym h))
udt-expr-eq-sound (sx-lit a) (sx-mul c d) h = Empty-rec (true≢false (sym h))
udt-expr-eq-sound (sx-add a b) (sx-in j) h = Empty-rec (true≢false (sym h))
udt-expr-eq-sound (sx-add a b) (sx-lit c) h = Empty-rec (true≢false (sym h))
udt-expr-eq-sound (sx-add a b) (sx-mul c d) h = Empty-rec (true≢false (sym h))
udt-expr-eq-sound (sx-add a b) (sx-add c d) h =
  let p = udt-expr-eq-sound a c (udt-bool-and-l (udt-expr-eq a c) (udt-expr-eq b d) h)
      q = udt-expr-eq-sound b d (udt-bool-and-r (udt-expr-eq a c) (udt-expr-eq b d) h)
  in λ i → sx-add (p i) (q i)
udt-expr-eq-sound (sx-mul a b) (sx-in j) h = Empty-rec (true≢false (sym h))
udt-expr-eq-sound (sx-mul a b) (sx-lit c) h = Empty-rec (true≢false (sym h))
udt-expr-eq-sound (sx-mul a b) (sx-add c d) h = Empty-rec (true≢false (sym h))
udt-expr-eq-sound (sx-mul a b) (sx-mul c d) h =
  let p = udt-expr-eq-sound a c (udt-bool-and-l (udt-expr-eq a c) (udt-expr-eq b d) h)
      q = udt-expr-eq-sound b d (udt-bool-and-r (udt-expr-eq a c) (udt-expr-eq b d) h)
  in λ i → sx-mul (p i) (q i)

-- Exact arithmetic over Nat for zero-postulate distributive symmetry proofs:
udt-mul : Nat → Nat → Nat
udt-mul zero    m = zero
udt-mul (suc n) m = plus m (udt-mul n m)

udt-plus-zero-r : (a : Nat) → plus a zero ≡ a
udt-plus-zero-r zero    = λ i → zero
udt-plus-zero-r (suc n) = congN (λ z → suc z) (udt-plus-zero-r n)

udt-plus-suc-r : (a b : Nat) → plus a (suc b) ≡ suc (plus a b)
udt-plus-suc-r zero    b = λ i → suc b
udt-plus-suc-r (suc n) b = congN (λ z → suc z) (udt-plus-suc-r n b)

udt-plus-comm : (a b : Nat) → plus a b ≡ plus b a
udt-plus-comm zero    b = sym (udt-plus-zero-r b)
udt-plus-comm (suc n) b = transN (congN (λ z → suc z) (udt-plus-comm n b)) (sym (udt-plus-suc-r b n))

udt-plus-swap4 : (a b c d : Nat) → plus (plus a b) (plus c d) ≡ plus (plus a c) (plus b d)
udt-plus-swap4 a b c d =
  let s1 = plus-assoc a b (plus c d)
      s2 = congN (plus a) (sym (plus-assoc b c d))
      s3 = congN (λ z → plus a (plus z d)) (udt-plus-comm b c)
      s4 = congN (plus a) (plus-assoc c b d)
      s5 = sym (plus-assoc a c (plus b d))
  in transN s1 (transN s2 (transN s3 (transN s4 s5)))

-- Universal right-distributivity symmetry: `(a + b) * x ≡ (a * x) + (b * x)`.
udt-distrib-r : (a b x : Nat) → udt-mul (plus a b) x ≡ plus (udt-mul a x) (udt-mul b x)
udt-distrib-r zero b x = λ i → udt-mul b x
udt-distrib-r (suc n) b x =
  let ih = congN (plus x) (udt-distrib-r n b x)
  in transN ih (sym (plus-assoc x (udt-mul n x) (udt-mul b x)))

sym-eval : (Nat → Nat) → SymExpr → Nat
sym-eval env (sx-in k)    = env k
sym-eval env (sx-lit v)   = v
sym-eval env (sx-add l r) = plus (sym-eval env l) (sym-eval env r)
sym-eval env (sx-mul l r) = udt-mul (sym-eval env l) (sym-eval env r)

-- Gate/operation complexity of a symbolic market/system expression (mul=4, add=1):
sym-cost : SymExpr → Nat
sym-cost (sx-in k)    = zero
sym-cost (sx-lit v)   = zero
sym-cost (sx-add l r) = suc (plus (sym-cost l) (sym-cost r))
sym-cost (sx-mul l r) = suc (suc (suc (suc (plus (sym-cost l) (sym-cost r)))))

-- Symmetry-exploiting bilinear factorizer: collapses `(a * x) + (b * x)` -> `(a + b) * x`
-- and constant-folds `(sx-lit a) + (sx-lit b)` -> `sx-lit (a + b)`!
sym-add-opt : SymExpr → SymExpr → SymExpr
sym-add-opt (sx-lit a) (sx-lit b) = sx-lit (plus a b)
sym-add-opt (sx-mul a x) (sx-mul b y) =
  if udt-expr-eq x y
  then sx-mul (sym-add-opt a b) x
  else sx-add (sx-mul a x) (sx-mul b y)
sym-add-opt l r = sx-add l r

sym-compress : SymExpr → SymExpr
sym-compress (sx-in k)    = sx-in k
sym-compress (sx-lit v)   = sx-lit v
sym-compress (sx-mul l r) = sx-mul (sym-compress l) (sym-compress r)
sym-compress (sx-add l r) = sym-add-opt (sym-compress l) (sym-compress r)

-- Universal Semantic Preservation Proof for `sym-add-opt` & `sym-compress` across ALL environments!
sym-add-opt-sound : (env : Nat → Nat) → (l r : SymExpr) →
  sym-eval env (sym-add-opt l r) ≡ plus (sym-eval env l) (sym-eval env r)
sym-add-opt-sound env (sx-in i) r = λ j → plus (env i) (sym-eval env r)
sym-add-opt-sound env (sx-add a b) r = λ j → plus (plus (sym-eval env a) (sym-eval env b)) (sym-eval env r)
sym-add-opt-sound env (sx-lit a) (sx-in j) = λ k → plus a (env j)
sym-add-opt-sound env (sx-lit a) (sx-lit b) = λ k → plus a b
sym-add-opt-sound env (sx-lit a) (sx-add c d) = λ k → plus a (plus (sym-eval env c) (sym-eval env d))
sym-add-opt-sound env (sx-lit a) (sx-mul c d) = λ k → plus a (udt-mul (sym-eval env c) (sym-eval env d))
sym-add-opt-sound env (sx-mul a x) (sx-in j) = λ k → plus (udt-mul (sym-eval env a) (sym-eval env x)) (env j)
sym-add-opt-sound env (sx-mul a x) (sx-lit b) = λ k → plus (udt-mul (sym-eval env a) (sym-eval env x)) b
sym-add-opt-sound env (sx-mul a x) (sx-add c d) = λ k → plus (udt-mul (sym-eval env a) (sym-eval env x)) (plus (sym-eval env c) (sym-eval env d))
sym-add-opt-sound env (sx-mul a x) (sx-mul b y) =
  let bEq = udt-expr-eq x y
  in (case bEq return (λ v → udt-expr-eq x y ≡ v →
        sym-eval env (if v then sx-mul (sym-add-opt a b) x else sx-add (sx-mul a x) (sx-mul b y)) ≡
        plus (udt-mul (sym-eval env a) (sym-eval env x)) (udt-mul (sym-eval env b) (sym-eval env y))) of
        true → λ heq →
          let xeqy = udt-expr-eq-sound x y heq
              s1   = congN (λ z → udt-mul z (sym-eval env x)) (sym-add-opt-sound env a b)
              s2   = udt-distrib-r (sym-eval env a) (sym-eval env b) (sym-eval env x)
              s3   = λ k → plus (udt-mul (sym-eval env a) (sym-eval env x)) (udt-mul (sym-eval env b) (sym-eval env (xeqy k)))
          in transN s1 (transN s2 s3)
        false → λ heq → λ k → plus (udt-mul (sym-eval env a) (sym-eval env x)) (udt-mul (sym-eval env b) (sym-eval env y)))
     (λ k → bEq)

udt-thm-sym-compress-sound : (env : Nat → Nat) → (e : SymExpr) →
  sym-eval env (sym-compress e) ≡ sym-eval env e
udt-thm-sym-compress-sound env (sx-in k) = λ i → env k
udt-thm-sym-compress-sound env (sx-lit v) = λ i → v
udt-thm-sym-compress-sound env (sx-mul l r) =
  let pl = udt-thm-sym-compress-sound env l
      pr = udt-thm-sym-compress-sound env r
  in λ i → udt-mul (pl i) (pr i)
udt-thm-sym-compress-sound env (sx-add l r) =
  let s1 = sym-add-opt-sound env (sym-compress l) (sym-compress r)
      pl = udt-thm-sym-compress-sound env l
      pr = udt-thm-sym-compress-sound env r
  in transN s1 (λ i → plus (pl i) (pr i))

-- ============================================================================
-- 4. CONTINUOUS MARKET-WIDE SYMBOLIC TRACE RECORD & KERNEL `refl` WITNESSES
-- ============================================================================

-- Each real-time event appends `(slot, weight)` to the composed market calculation, immediately
-- compresses via `sym-compress`, and records `(raw_composition, compressed_nf, raw_cost, nf_cost)`
-- paired with the universal semantic-preservation theorem `udt-thm-sym-compress-sound`!
CanonTraceRow : Type
CanonTraceRow = SymExpr × (SymExpr × (Nat × Nat))

udt-trace-step : (Nat × Nat) → SymExpr → CanonTraceRow
udt-trace-step ev prevNf =
  let term = sx-mul (sx-lit (snd ev)) (sx-in (fst ev))
      raw  = sx-add prevNf term
      nf   = sym-compress raw
  in (raw , (nf , (sym-cost raw , sym-cost nf)))

udt-trace-run : List (Nat × Nat) → SymExpr → List CanonTraceRow
udt-trace-run nil acc = nil
udt-trace-run (cons ev rest) acc =
  let row = udt-trace-step ev acc
  in cons row (udt-trace-run rest (fst (snd row)))

-- Concrete multi-event market calculation composition `(3*x0 + 5*x0) + (2*x1 + 7*x1)`:
udt-sample-market-raw : SymExpr
udt-sample-market-raw =
  sx-add
    (sx-add (sx-mul (sx-lit (toNat #3)) (sx-in zero))
            (sx-mul (sx-lit (toNat #5)) (sx-in zero)))
    (sx-add (sx-mul (sx-lit (toNat #2)) (sx-in (suc zero)))
            (sx-mul (sx-lit (toNat #7)) (sx-in (suc zero))))

-- 1. Uncompressed cost is 19 operations (4 muls * 4 + 3 adds * 1 = 19);
--    `sym-compress` collapses unobserved common-channel symmetries down to `(8 * x0) + (9 * x1)` = 9 ops!
udt-thm-raw-cost-19 : sym-cost udt-sample-market-raw ≡ toNat #19
udt-thm-raw-cost-19 = refl

udt-thm-compressed-cost-9 : sym-cost (sym-compress udt-sample-market-raw) ≡ toNat #9
udt-thm-compressed-cost-9 = refl

-- 2. Exact `CanonStep` witness (10 operations saved + universal semantic path across EVERY market feed `env`):
udt-thm-market-canon-step :
  (env : Nat → Nat) →
  CanonStep (sym-eval env) sym-cost udt-sample-market-raw (sym-compress udt-sample-market-raw)
udt-thm-market-canon-step env =
  (sym (udt-thm-sym-compress-sound env udt-sample-market-raw) ,
   (toNat #10 , refl))

-- 3. Multi-tick live symbolic trace collapses 3 consecutive updates on channel 0 (`3*x0`, `+5*x0`, `+4*x0`)
--    into a single O(1)-size normal-form node `12*x0` (`cost = 4`, constant instead of linear growth!):
udt-sample-stream : List (Nat × Nat)
udt-sample-stream =
  cons (zero , toNat #5)
  (cons (zero , toNat #4) nil)

udt-thm-stream-constant-nf-cost :
  list-map (λ row → snd (snd (snd row))) (udt-trace-run udt-sample-stream (sx-mul (sx-lit (toNat #3)) (sx-in zero)))
  ≡ cons (toNat #4) (cons (toNat #4) nil)
udt-thm-stream-constant-nf-cost = refl
