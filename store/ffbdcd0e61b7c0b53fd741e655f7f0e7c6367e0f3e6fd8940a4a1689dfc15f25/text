-- Demo verifier for warrant CLI check: keys 11 and 22 signed claim 777; key 11 signed delegation (33 xor 9)
demo-ver : Word → Word → Bool
demo-ver pk cl =
  orB (andB (%weq pk #11) (%weq cl #777))
  (orB (andB (%weq pk #22) (%weq cl #777))
  (orB (andB (%weq pk #11) (%weq cl (%wxor #33 #9)))
       (andB (%weq pk #33) (%weq cl #777))))
