-- Article JSON-LD for published papers and essays
s-article-ld : List Word → List Word → List Word → List Word
s-article-ld title desc url = h-concat (cons "<script type='application/ld+json'>{" (cons (s-ld-kv "@context" "https://schema.org") (cons "," (cons (s-ld-kv "@type" "Article") (cons "," (cons (s-ld-kv "headline" title) (cons "," (cons (s-ld-kv "description" desc) (cons "," (cons (s-ld-kv "url" url) (cons "," (cons (s-ld-str "author") (cons ":{" (cons (s-ld-kv "@type" "Person") (cons "," (cons (s-ld-kv "name" "Avik Jain") (cons "}," (cons (s-ld-str "publisher") (cons ":{" (cons (s-ld-kv "@type" "Organization") (cons "," (cons (s-ld-kv "name" "Hyperactive Labs, Inc.") (cons "," (cons (s-ld-kv "url" "https://hyperactivity.ai") (cons "}}</script>" nil)))))))))))))))))))))))))
