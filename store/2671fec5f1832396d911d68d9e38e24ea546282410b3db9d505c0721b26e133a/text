-- Subdivide one ruling line r±(u, v) = (h·u, r₀(cv ∓ u·sv), r₀(sv ± u·cv)) for u ∈ [-U, +U]
-- Parameters (scaled by 10000): r₀ = 1800, U = 31500, h = 1587 (so h·U = 5000 = 0.50)
hyp-ruling-pt : SInt → SInt → SInt → SInt → (Word × Word) × SInt
hyp-ruling-pt fam u cv sv =
  let x = fx-mul (sp #1587) u
      fu = fx-mul fam u
      y = fx-mul (sp #1800) (si-sub cv (fx-mul fu sv))
      z = fx-mul (sp #1800) (si-add sv (fx-mul fu cv))
  in proj-3d x y z
