-- u · 0 = 0
cl-dot-nil-r : (A : Type) → (z : A) → (ad mu : A → A → A) → ((x : A) → mu x z ≡ z) → ad z z ≡ z → (u : List A) → cl-dot A z ad mu u nil ≡ z
cl-dot-nil-r A z ad mu m0 a0 u = case u return λ w → cl-dot A z ad mu w nil ≡ z of
  nil → λ i → z
  cons x xs → cl-tr A (ad (mu x z) (cl-dot A z ad mu xs nil)) (ad z z) z (λ i → ad (m0 x i) (cl-dot-nil-r A z ad mu m0 a0 xs i)) a0
