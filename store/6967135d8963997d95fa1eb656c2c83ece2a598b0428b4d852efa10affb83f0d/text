par-recv-count : {C M N E : Type} → (stepQ : C → ParLab N M E → C → Type) → (q : C) → (u : List M) → (q2 : C) →
  par-recv-ok {C} {M} {N} {E} stepQ q u q2 → Path Nat (suc (list-length {M} (par-tail {M} u))) (list-length {M} u)
par-recv-count {C} {M} {N} {E} stepQ q u q2 = case u return (λ w → par-recv-ok {C} {M} {N} {E} stepQ q w q2 → Path Nat (suc (list-length {M} (par-tail {M} w))) (list-length {M} w)) of
  nil → λ h → Empty-rec {lzero} {Path Nat (suc zero) zero} h
  cons m r → λ h → λ k → suc (list-length {M} r)
