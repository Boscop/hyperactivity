drc-span-step-aux :
  (x0 w s cw gap ms xend : Nat) →
  leB w cw ≡ true → leB s gap ≡ true →
  leB (plus (plus (plus x0 cw) gap) ms) xend ≡ true →
  leB (plus x0 (plus (plus w s) ms)) xend ≡ true
drc-span-step-aux x0 w s cw gap ms xend hcw hgap ih =
  let hstep : leB (plus (plus x0 w) s) (plus (plus x0 cw) gap) ≡ true
      hstep = opt-le-plus (plus x0 w) (plus x0 cw) s gap
                (opt-le-plus x0 x0 w cw (opt-le-refl x0) hcw) hgap
      hleft : leB (plus (plus (plus x0 w) s) ms)
                  (plus (plus (plus x0 cw) gap) ms) ≡ true
      hleft = opt-le-plus (plus (plus x0 w) s) (plus (plus x0 cw) gap) ms ms
                hstep (opt-le-refl ms)
      hcomb : leB (plus (plus (plus x0 w) s) ms) xend ≡ true
      hcomb = opt-le-trans (plus (plus (plus x0 w) s) ms)
                (plus (plus (plus x0 cw) gap) ms) xend hleft ih
  in opt-le-subst-l (plus (plus (plus x0 w) s) ms)
       (plus x0 (plus (plus w s) ms)) xend (symN (opt-assoc3 x0 w s ms)) hcomb
