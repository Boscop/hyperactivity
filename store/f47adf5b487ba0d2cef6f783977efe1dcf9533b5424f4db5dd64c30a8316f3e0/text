-- fold: every fold-safe module is removed from the view (remove; its text stays in the source under its
-- hash, and another module still holds every piece of it).
hy-fold : List Word → List Word → List (List Word) → Proc W Unit
hy-fold st m args = bind (hy-fold-safe-list st m args) (λ ks → bind (hy-remove st m ks) (λ u →
  h-out (h-line (list-append (h-decimal (fromNat (list-length ks))) " modules folded: each was held whole by another, imported by none, and named nowhere"))))
