-- ---------------------------------------------------------------- 1. universal property & functoriality of Basins
-- non-dependent elimination out of Basins: any flow-invariant observable factors through Basins
basin-rec : {S O : Type 0} {step : S → S → Bool}
          → (f : S → O)
          → ((a b : S) → isTrue (step a b) → f a ≡ f b)
          → Basins S step → O
basin-rec f inv (basin-pt x) = f x
basin-rec f inv (basin-step a b p i) = inv a b p i
