-- the record: every text of the store, as it is
c-ready : Proc W Unit
c-ready = bind (c-exists c-record) (λ have → if have then ret {lzero} {W} unit else
  bind (h-mkdir "build") (λ u → bind (h-mkdir "build/chat") (λ v →
  bind (h-run (cons "/usr/bin/env" (cons "sh" (cons "-c" (cons "cat store/[0-9a-f]*/text > build/chat/record.tmp && mv build/chat/record.tmp build/chat/record" nil))))) (λ r →
  if weq r #0 then ret {lzero} {W} unit else h-fail "chat: the record could not be made"))))
