roots-from : SQ → List SQ → List SQ
roots-from s rs = case rs of
  nil → nil
  cons r rest → (if sq-nz r then cons (sq-mul ((suc zero , 2) , (zero , suc zero)) (sq-plus s r)) (cons (sq-mul ((suc zero , 2) , (zero , suc zero)) (sq-sub s r)) nil)
    else cons (sq-mul ((suc zero , 2) , (zero , suc zero)) s) nil)
