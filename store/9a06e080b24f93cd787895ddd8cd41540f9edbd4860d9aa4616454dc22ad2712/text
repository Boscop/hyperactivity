-- /doc of a selection essay: its source's lines as a page; any other .cub document as its text
s-essay-of : List Word → Sum Unit (List Word) → Proc W (List Word)
s-essay-of p (inl u) = s-doc p
s-essay-of p (inr t) = ret {lzero} {W} (s-response s-html (s-page (list-append (h-before ".cub" p) ".md") (h-concat (list-map h-line (s-src-lines (list-length t) (inl unit) t)))))
