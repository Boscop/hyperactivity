-- ============================================================================
-- 1. Universal Tracelessness of Thiemann's Triad Commutator [A, B] on 2×2 Matrices
-- ============================================================================
-- A = [[a0, a1], [a2, a3]], B = [[b0, b1], [b2, b3]] (8 variables).
-- tr(AB - BA) = (a0 b0 + a1 b2 + a2 b1 + a3 b3) - (b0 a0 + b1 a2 + b2 a1 + b3 a3) = 0.
lqg-comm-tr-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-comm-tr-poly A ad mu q vs =
  (λ g sub →
    let a0 = g 0; a1 = g 1; a2 = g 2; a3 = g 3
        b0 = g 4; b1 = g 5; b2 = g 6; b3 = g 7
        trAB = ad (ad (mu a0 b0) (mu a1 b2)) (ad (mu a2 b1) (mu a3 b3))
        trBA = ad (ad (mu b0 a0) (mu b1 a2)) (ad (mu b2 a1) (mu b3 a3))
    in (sub trAB trBA , q (fn-q 0 1)))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
