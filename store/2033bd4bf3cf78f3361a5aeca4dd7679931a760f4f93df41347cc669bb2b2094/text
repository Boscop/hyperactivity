inv-solve-run : Word × (Word × Bool)
inv-solve-run =
  let kTgt   = #2400
      alpha  = #160
      tgtSt  = verlet-fwd-n (toNat #16) kTgt alpha (#20000 , #0)
      tgtQ   = fst tgtSt
      kFinal = %welimP (λ _ → Word) #40 #1200 (λ _ k → inv-solve-step tgtQ alpha k)
      endFin = verlet-fwd-n (toNat #16) kFinal alpha (#20000 , #0)
      revFin = verlet-inv-n (toNat #16) kFinal alpha endFin
      revOk  = andB (%weq (fst revFin) #20000) (%weq (snd revFin) #0)
      err    = inv-loss kFinal alpha tgtQ
  in (kFinal , (err , revOk))
