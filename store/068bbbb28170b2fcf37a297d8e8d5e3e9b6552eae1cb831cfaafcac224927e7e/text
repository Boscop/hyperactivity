si-and4 : {a b c d : Bool} → isTrue (andB a (andB b (andB c d))) → isTrue a × (isTrue b × (isTrue c × isTrue d))
si-and4 {a} {b} {c} {d} h = (and-fst {a} {andB b (andB c d)} h , (and-fst {b} {andB c d} (and-snd {a} {andB b (andB c d)} h) ,
  (and-fst {c} {d} (and-snd {b} {andB c d} (and-snd {a} {andB b (andB c d)} h)) , and-snd {c} {d} (and-snd {b} {andB c d} (and-snd {a} {andB b (andB c d)} h)))))
