ho-entry : Proc W Unit
ho-entry =
  bind h-args (λ argv →
  bind (h-mkdir ho-out-dir) (λ m0 →
    let elf  = emit-elf64-x86 #11 (ho-op-inet ho-state-1)
        p0   = ho-compile-genome-ptx ho-gen0
        p1   = ho-compile-genome-ptx ho-gen1
        p2   = ho-compile-genome-ptx ho-gen2
        p3   = ho-compile-genome-ptx ho-gen3
        mode = ho-mode-of (h-tail-lists argv)
    in bind (h-write (list-append ho-out-dir "/hyperop_x86_64.elf") elf) (λ wElf →
       bind (h-write (list-append ho-out-dir "/hyperop_gen0.ptx") p0) (λ w0 →
       bind (h-write (list-append ho-out-dir "/hyperop_gen1.ptx") p1) (λ w1 →
       bind (h-write (list-append ho-out-dir "/hyperop_gen2.ptx") p2) (λ w2 →
       bind (h-write (list-append ho-out-dir "/hyperop_gen3.ptx") p3) (λ w3 →
       if %weq mode #2
       then ho-daemon-loop (toNat #100000) #1 ho-state-0 #0
       else if %weq mode #1
       then bind (ho-run-epoch #1 ho-state-0 #0) (λ r1 →
            bind (ho-run-epoch #2 (fst r1) (snd r1)) (λ r2 →
            bind (ho-run-epoch #3 (fst r2) (snd r2)) (λ r3 →
            ret {lzero} {W} unit)))
       else
         h-out
           (h-concat
             (cons (bn-ln "[HX-HYPEROPERATOR | 100% PURE .HYPERCUBICAL HYPERPROFILER + HYPEROPTIMIZER + 7-NETWORK MESH]")
             (cons (bn-ln (list-append "  Emitted Bare Binaries  : x86_64_ELF64=" (list-append (h-decimal (fromNat (list-length elf))) (list-append "B | Gen0=" (list-append (h-decimal (fromNat (list-length p0))) (list-append "B | Gen1=" (list-append (h-decimal (fromNat (list-length p1))) (list-append "B | Gen2=" (list-append (h-decimal (fromNat (list-length p2))) (list-append "B | Gen3=" (list-append (h-decimal (fromNat (list-length p3))) "B")))))))))))
             (cons (bn-ln "  Closed-Loop Proofs     : ho-thm-metacircular-nonregressing | ho-thm-closed-loop-trajectory | ho-thm-lux-chord-retract | ho-portal-transport-chain")
             (cons (bn-ln "  Connected Mesh Targets : Ethereum_L1 | Base_8453 | Arbitrum_42161 | Solana | Hyperliquid | Polymarket | TIG_OPOW")
             (cons (bn-ln "  Run 'evolve' (3-stage closed-loop pass) or 'daemon' (continuous loop) to operate.") nil)))))))))))))
