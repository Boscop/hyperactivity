-- (part of language-support)
write_xmmi_size : (nbytes : Bits #5) → (index' : Bits #4) → (sailval : ZI) → MS Unit
write_xmmi_size nbytes index' sailval =
  λ σ →
    if (weq nbytes #4) then
      the (MS Unit)
        (wx32 index' (bits_of_int sailval (zpos #32))) σ
    else if (weq nbytes #8) then
      the (MS Unit)
        (wx64 index' (bits_of_int sailval (zpos #64))) σ
    else if (weq nbytes #16) then
      the (MS Unit)
        (wx128 index' (bits_of_int sailval (zpos #128))) σ
    else
      the (MS Unit)
        (retS {Unit} unit) σ
