nk-trim-susp-bounds-step : (used : Bool) (w : NkW) (o2 : NkOut) (n0 : NkW) →
  (nk-wire-lt w n0 ≡ true) →
  (nk-wire-le n0 (nk-n o2) ≡ true) →
  (nk-ebound (nk-ws o2) (nk-n o2) ≡ true) →
  (nk-wire-le n0 (nk-n (if used then nk-out (nk-fx o2) (nk-n o2) (nke-cons w (nk-ws o2))
                        else nk-out (nkf-op w nko-era (nkf-val (nk-n o2) (nkv (hd-num #0) nke-nil) (nk-fx o2))) (nk-s (nk-n o2)) (nke-cons (nk-n o2) (nk-ws o2)))) ≡ true)
  × (nk-ebound (nk-ws (if used then nk-out (nk-fx o2) (nk-n o2) (nke-cons w (nk-ws o2))
                       else nk-out (nkf-op w nko-era (nkf-val (nk-n o2) (nkv (hd-num #0) nke-nil) (nk-fx o2))) (nk-s (nk-n o2)) (nke-cons (nk-n o2) (nk-ws o2))))
               (nk-n (if used then nk-out (nk-fx o2) (nk-n o2) (nke-cons w (nk-ws o2))
                      else nk-out (nkf-op w nko-era (nkf-val (nk-n o2) (nkv (hd-num #0) nke-nil) (nk-fx o2))) (nk-s (nk-n o2)) (nke-cons (nk-n o2) (nk-ws o2)))) ≡ true)
nk-trim-susp-bounds-step true w o2 n0 hw ple hws =
  (ple , nk-and-intro (nk-wire-lt w (nk-n o2)) (nk-ebound (nk-ws o2) (nk-n o2)) (nk-wire-lt-wle-trans w n0 (nk-n o2) hw ple) hws)
nk-trim-susp-bounds-step false w o2 n0 hw ple hws =
  let n2 = nk-n o2
      sn2 = nk-s n2
  in (nk-wire-le-trans n0 n2 sn2 ple (nk-wire-le-s n2) ,
      nk-and-intro (nk-wire-lt n2 sn2) (nk-ebound (nk-ws o2) sn2)
        (nk-wire-lt-s n2) (nk-ebound-up n2 sn2 (nk-ws o2) (nk-wire-le-s n2) hws))
