-- MECHANICAL OPENQASM 3.0 EMITTER (LOWERS THE EXACT PROVED `List QGate` — ZERO HAND-WRITTEN QASM!)
kexpr-qasm-gate : QGate → List Word
kexpr-qasm-gate (qg-h q)    = list-append "h q[" (list-append (ce-dec q) "];")
kexpr-qasm-gate (qg-t q)    = list-append "t q[" (list-append (ce-dec q) "];")
kexpr-qasm-gate (qg-tdg q)  = list-append "tdg q[" (list-append (ce-dec q) "];")
kexpr-qasm-gate (qg-cx c t) = list-append "cx q[" (list-append (ce-dec c) (list-append "], q[" (list-append (ce-dec t) "];")))
