lg-interchange : (p q r s : Word) → plusw (plusw p q) (plusw r s) ≡ plusw (plusw p r) (plusw q s)
lg-interchange p q r s =
  catw (plusw-assoc p q (plusw r s))
    (catw (congw (λ z → plusw p z) (catw (symw (plusw-assoc q r s)) (catw (congw (λ z → plusw z s) (plusw-comm q r)) (plusw-assoc r q s))))
      (symw (plusw-assoc p r (plusw q s))))
