-- In-place binary split (`CON–DUP` commutation or `TREE_SPLIT`): reuses 1 active cell ID in-place
-- and pops 1 fresh cell ID from `freeStack`, spawning 2 active child cells (`live = suc l -> suc (suc l)`).
pool-split : Nat → Word → List Word → HeapPool
pool-split l freshId restFree = hpool (suc (suc l)) restFree
