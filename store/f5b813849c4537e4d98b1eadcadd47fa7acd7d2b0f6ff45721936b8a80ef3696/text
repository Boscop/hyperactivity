kexpr-main : List (List Word) → Step W Word
kexpr-main args =
  let p   = kexpr-pref args
      cf  = list-append p ".c"
      mf  = list-append p ".metal"
      uf  = list-append p ".cu"
      sf  = list-append p ".sv"
      q7f = list-append p "_tof7.qasm"
      q4f = list-append p "_rel4.qasm"
  in scmd w-now (λ t0 →
     scmd (w-file-write-named cf  kexpr-emit-c) (λ bc →
     scmd (w-file-write-named mf  kexpr-emit-metal) (λ bm →
     scmd (w-file-write-named uf  kexpr-emit-cuda) (λ bu →
     scmd (w-file-write-named sf  kexpr-emit-sv) (λ bs →
     scmd (w-file-write-named q7f kexpr-qasm-tof7) (λ b7 →
     scmd (w-file-write-named q4f kexpr-qasm-rel4) (λ b4 →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-KEXPR (29th Engine) | Z[zeta_8] tof7=8/8 rel4=8/8 | C11=" (list-append (ce-dec bc)
       (list-append "B Metal=" (list-append (ce-dec bm)
       (list-append "B CUDA=" (list-append (ce-dec bu)
       (list-append "B SV=" (list-append (ce-dec bs)
       (list-append "B QASM7=" (list-append (ce-dec b7)
       (list-append "B QASM4=" (list-append (ce-dec b4)
       (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))))))))))
       (sdone #0)))))))))
