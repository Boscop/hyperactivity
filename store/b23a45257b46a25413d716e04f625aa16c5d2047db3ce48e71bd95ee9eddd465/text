-- the projector onto μ's eigenspace, Π_{ν ≠ μ} (M − ν)/(μ − ν), on coordinates
eig-proj : VM → SQ → List SQ → Rows → Rows
eig-proj a mu nus cs = case nus of
  nil → cs
  cons nu rest → (if sq-eq nu mu then eig-proj a mu rest cs else mat-scale (sq-inv (sq-sub mu nu)) (shift-apply a nu (eig-proj a mu rest cs)))
