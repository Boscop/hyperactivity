-- a document of the repository: no path above it or from the root
s-doc : List Word → Proc W (List Word)
s-doc p0 = let p = s-unescape p0 in if orB (h-prefix "." p) (orB (h-prefix "/" p) (orB (h-infix ".." p) (orB (h-prefix "packs/" p) (orB (h-prefix "roots/" p) (orB (h-prefix "store/" p) (h-eq p "root")))))) then ret {lzero} {W} (s-respond "404 Not Found" "text/plain" "no such document")
  else bind (h-document p) (λ t → ret (s-doc-of p t))
