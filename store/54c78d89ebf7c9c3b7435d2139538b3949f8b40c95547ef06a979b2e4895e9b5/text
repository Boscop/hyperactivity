-- a type is first-order data when compiled code holds its values: a word, a byte string, data whose
-- parameters are first-order data, or a pair of such. A function whose parameters and result are all
-- first-order data is called with values, so a call to it passes each argument once
fo-ty : Nat → Code → Bool
fo-ty zero c = false
fo-ty (suc n) cword = true
fo-ty (suc n) (cpty k m) = true
fo-ty (suc n) (cdata d ps) = if l-any (λ p → if fo-ty n p then false else true) ps then false else true
fo-ty (suc n) (csigma A B) = andB (fo-ty n A) (fo-ty n B)
fo-ty (suc n) (cann t T) = fo-ty n t
fo-ty (suc n) c = false
