-- equal rationals with positive denominators: one positive, the other
posn-qeq : (v w : ZQ) → qeq v w → le (suc zero) (snd v) → posn w → posn v
posn-qeq v w e lv hw = zpos-unscale (fst v) (snd w)
  (zle-zeq-r (the (Nat × Nat) (suc zero , zero)) (zsc (fst w) (snd v)) (zsc (fst v) (snd w)) (zeq-sym (zsc (fst v) (snd w)) (zsc (fst w) (snd v)) e) (zpos-scale (fst w) (snd v) hw lv))
