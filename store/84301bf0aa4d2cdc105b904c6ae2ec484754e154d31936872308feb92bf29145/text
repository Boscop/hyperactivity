     cli-say (list-append "HX-WETLAB Cayley-SU2=1 Verlet=1 Homology-d2=0 H1-Hess=0 ProtoInd=1 Metal="
       (list-append (ce-dec bm)
       (list-append "B Host=" (list-append (ce-dec bh)
