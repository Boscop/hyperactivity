data WLRxn : Type where
  wl-r-bind   : WLRxn
  wl-r-unbind : WLRxn
  wl-r-cat    : WLRxn
  wl-r-unfold : WLRxn
  wl-r-refold : WLRxn

data WLProto : Type where
  wl-pnil  : WLProto
  wl-pcons : WLRxn → WLProto → WLProto

-- Discrete integer-molecule flask state: (E, ES, Eu) total enzyme molecules in a wet-lab micro-volume
data WLFlask : Type where
  wl-fl : Nat → Nat → Nat → WLFlask

wl-total-enz : WLFlask → Nat
wl-total-enz (wl-fl e es eu) = hm-add e (hm-add es eu)

wl-step : WLRxn → WLFlask → WLFlask
wl-step wl-r-bind   (wl-fl (suc e) es eu) = wl-fl e (suc es) eu
wl-step wl-r-unbind (wl-fl e (suc es) eu) = wl-fl (suc e) es eu
wl-step wl-r-cat    (wl-fl e (suc es) eu) = wl-fl (suc e) es eu
wl-step wl-r-unfold (wl-fl (suc e) es eu) = wl-fl e es (suc eu)
wl-step wl-r-refold (wl-fl e es (suc eu)) = wl-fl (suc e) es eu
wl-step _           fl                    = fl

wl-run-proto : WLProto → WLFlask → WLFlask
wl-run-proto wl-pnil         fl = fl
wl-run-proto (wl-pcons r ps) fl = wl-run-proto ps (wl-step r fl)

wl-sym-n : {a b : Nat} → a ≡ b → b ≡ a
wl-sym-n p = λ i → p (~ i)

wl-trans-n : {a b c : Nat} → a ≡ b → b ≡ c → a ≡ c
wl-trans-n {a} {b} {c} p q = λ i → comp (λ j → Nat) (λ j → [ i = 0 ↦ a , i = 1 ↦ q j ]) (p i)

wl-step-conserves : (r : WLRxn) → (fl : WLFlask) → wl-total-enz (wl-step r fl) ≡ wl-total-enz fl
wl-step-conserves wl-r-bind   (wl-fl zero    es eu) = refl
wl-step-conserves wl-r-bind   (wl-fl (suc e) es eu) = hm-add-suc-r e (hm-add es eu)
wl-step-conserves wl-r-unbind (wl-fl e zero    eu) = refl
wl-step-conserves wl-r-unbind (wl-fl e (suc es) eu) = wl-sym-n (hm-add-suc-r e (hm-add es eu))
wl-step-conserves wl-r-cat    (wl-fl e zero    eu) = refl
wl-step-conserves wl-r-cat    (wl-fl e (suc es) eu) = wl-sym-n (hm-add-suc-r e (hm-add es eu))
wl-step-conserves wl-r-unfold (wl-fl zero    es eu) = refl
wl-step-conserves wl-r-unfold (wl-fl (suc e) es eu) =
  wl-trans-n (λ i → hm-add e (hm-add-suc-r es eu i)) (hm-add-suc-r e (hm-add es eu))
wl-step-conserves wl-r-refold (wl-fl e es zero)     = refl
wl-step-conserves wl-r-refold (wl-fl e es (suc eu)) =
  wl-sym-n (wl-trans-n (λ i → hm-add e (hm-add-suc-r es eu i)) (hm-add-suc-r e (hm-add es eu)))

-- THEOREM 9: EXACT ATOMIC/ENZYME CONSERVATION ACROSS ANY ARBITRARY-LENGTH WET-LAB PROTOCOL `p : WLProto`!
wl-thm-protocol-conserves : (p : WLProto) → (fl : WLFlask) →
  wl-total-enz (wl-run-proto p fl) ≡ wl-total-enz fl
wl-thm-protocol-conserves wl-pnil         fl = refl
wl-thm-protocol-conserves (wl-pcons r ps) fl =
  wl-trans-n (wl-thm-protocol-conserves ps (wl-step r fl)) (wl-step-conserves r fl)

