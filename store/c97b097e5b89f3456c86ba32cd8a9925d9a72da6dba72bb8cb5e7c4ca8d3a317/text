-- Brunnemann–Thiemann volume triple reduction on the Gauss-invariant subspace:
-- With J4 = -(J1 + J2 + J3) (9 variables: 0..2 = J1, 3..5 = J2, 6..8 = J3),
-- the signed volume triple product satisfies:
--   det(J4, J2, J3) = -det(J1, J2, J3),
-- proving all four face triples of a closed quantum tetrahedron agree up to orientation sign.
lqg-det3 : (A : Type) → (A → A → A) → (A → A → A) → (A → A → A) →
           A → A → A → A → A → A → A → A → A → A
lqg-det3 A ad sub mu a1 a2 a3 b1 b2 b3 c1 c2 c3 =
  ad (sub (mu a1 (sub (mu b2 c3) (mu b3 c2)))
          (mu a2 (sub (mu b1 c3) (mu b3 c1))))
     (mu a3 (sub (mu b1 c2) (mu b2 c1)))
