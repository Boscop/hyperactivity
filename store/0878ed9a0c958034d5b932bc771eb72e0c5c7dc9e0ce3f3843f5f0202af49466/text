mul-adj-law : (dy va vd fa fd da dd : Nat) → fa ≡ va → fd ≡ vd →
  plus (times (times dy vd) da) (times (times dy va) dd) ≡
  times dy (plus (times fa dd) (times da fd))
mul-adj-law dy va vd fa fd da dd eqA eqD =
  let l1 : times (times dy vd) da ≡ times dy (times da fd)
      l1 = transN (times-assoc-n dy vd da)
             (transN (congN (times dy) (times-comm-n vd da))
               (congN (λ z → times dy (times da z)) (sym eqD)))
      r1 : times (times dy va) dd ≡ times dy (times fa dd)
      r1 = transN (times-assoc-n dy va dd)
             (congN (λ z → times dy (times z dd)) (sym eqA))
  in transN (cong2N plus l1 r1)
       (transN (plus-comm (times dy (times da fd)) (times dy (times fa dd)))
         (sym (times-distr-r dy (times fa dd) (times da fd))))
