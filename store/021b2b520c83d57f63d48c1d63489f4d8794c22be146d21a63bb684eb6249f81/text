rcpt-move-total : (mv : RcptMove) → (s : RcptState) → rcpt-allowed mv s → rcpt-total (rcpt-move mv s) ≡ rcpt-total s
rcpt-move-total (rcpt-send u i j q k) s h = cr-move-total (cr-allocate i j q k) (rcpt-credit s) (snd h)
rcpt-move-total (rcpt-deliver u i j q k) s h = cr-move-total (cr-deliver i j q k) (rcpt-credit s) (snd (snd h))
rcpt-move-total (rcpt-ack u) s h = rcpt-ack-total u s
