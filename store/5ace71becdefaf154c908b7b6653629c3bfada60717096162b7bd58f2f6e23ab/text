-- Pass 1b automatic selector: find repeated higher-order λ-template (pre, suf) framing 1-token middle
count-lam-go : Nat → Nat → List MTerm → List MTerm → List MTerm → Word
count-lam-go zero maxa pre suf xs = #0
count-lam-go (suc fuel) maxa pre suf nil = #0
count-lam-go (suc fuel) maxa pre suf (cons x xs) =
  case split-prefix mterm-eq pre (cons x xs) of
    some ap →
      (case split-until mterm-eq maxa suf ap of
         some p → %wsucc (count-lam-go fuel maxa pre suf (snd p))
         none → count-lam-go fuel maxa pre suf xs)
    none → count-lam-go fuel maxa pre suf xs
