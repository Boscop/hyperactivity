rec-shape d c =
  case c of
    tdata d2 ps V → if %weq d d2 then sh-rec else sh-none
    tpathp L a b V → rec-shape-line d L
    tguess k g t V → rec-shape d t
    tpi B nm b V →
      (case B of
         ttick k V2 → sh-none
         _ → if cany (is-data-d d) B then sh-none else sh-under (λ s → sh-pi s) (rec-shape d (b (%var nm Uw) Uw)))
    tsigma B nm b V →
      (let s1 = rec-shape d B
           s2 = rec-shape d (b (%var nm Uw) Uw)
       in case s1 of
            sh-none → sh-under (λ s → sh-snd s) s2
            _ → (case s2 of sh-none → sh-fst s1; _ → sh-pair s1 s2))
    _ → sh-none
