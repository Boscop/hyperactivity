-- Active-pair test: `p0[a] = {b, 0}` and `p0[b] = {a, 0}` (mirrors `hyperinet_core` scanner)
inet-active : INetSlot → INetSlot → Bool
inet-active (islot ia ka p0a _ _) (islot ib kb p0b _ _) =
  if orB (%weq (ik-code ka) #0) (%weq (ik-code kb) #0) then false
  else andB (%weq p0a (%wmul ib #4)) (%weq p0b (%wmul ia #4))
