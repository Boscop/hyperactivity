-- retype at a cube only propositionally the projection: move along the path (the coherence carried by a
-- filler), then retype-eta
retype-eta2 : (Γ : CCtx) (a : TyShape) (U1 W Z : Type 1) (ty : U1 → Sem a) (w : (u : U1) → El a (ty u) → W) (u : Z → U1) (e : (z : Z) → El a (ty (u z)))
  (Rm : Mean Γ Z) (Um : Mean Γ U1) (qU : PathM Γ U1 Um (fmapM Γ Z U1 u Rm))
  (p : PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) (fmapM Γ Z (TV a) (λ z → (ty (u z) , e z)) Rm)) (fmapM Γ U1 (Sem a) ty Um)) →
  PathM Γ W (retype Γ a U1 W ty w Um (fmapM Γ Z (TV a) (λ z → (ty (u z) , e z)) Rm) p) (fmapM Γ Z W (λ z → w (u z) (e z)) Rm)
retype-eta2 Γ a U1 W Z ty w u e Rm Um qU p =
  pcat (Mean Γ W) (retype Γ a U1 W ty w Um (fmapM Γ Z (TV a) (λ z → (ty (u z) , e z)) Rm) p)
    (retype Γ a U1 W ty w (fmapM Γ Z U1 u Rm) (fmapM Γ Z (TV a) (λ z → (ty (u z) , e z)) Rm)
       (comp (λ k → PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) (fmapM Γ Z (TV a) (λ z → (ty (u z) , e z)) Rm)) (fmapM Γ U1 (Sem a) ty (qU k))) (λ k → []) p))
    (fmapM Γ Z W (λ z → w (u z) (e z)) Rm)
    (λ j → retype Γ a U1 W ty w (qU j) (fmapM Γ Z (TV a) (λ z → (ty (u z) , e z)) Rm)
       (comp (λ k → PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) (fmapM Γ Z (TV a) (λ z → (ty (u z) , e z)) Rm)) (fmapM Γ U1 (Sem a) ty (qU (j /\ k)))) (λ k → [ j = 0 ↦ p ]) p))
    (retype-eta Γ a U1 W Z ty w u e Rm
       (comp (λ k → PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) (fmapM Γ Z (TV a) (λ z → (ty (u z) , e z)) Rm)) (fmapM Γ U1 (Sem a) ty (qU k))) (λ k → []) p))
