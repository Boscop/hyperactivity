-- ---------------------------------------------------------------- readiness (epoll, level-triggered)
-- EPOLLIN 1, EPOLLOUT 4, EPOLLHUP 16 (reported whether asked or not)
k-ready : List Dgram → KObj → Word
k-ready net o = case o of
  k-pipe-in q → (case q of nil → #0; cons x xs → #1)
  k-pipe-out w → #4
  k-udp b → (case b of inl a → (case k-next-dgram a net of inl p → #5; inr u → #4); inr u → #4)
  k-epoll l → #0
