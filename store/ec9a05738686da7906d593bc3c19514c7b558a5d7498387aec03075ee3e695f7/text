sg-push-ihs : Lst NkSexp → NkTm → Lst (List Word) → Word × Lst (List Word)
sg-push-ihs lnil _ env = (#0 , env)
sg-push-ihs (lcons f fr) rcs env =
  if %weq (sg-tm-len rcs) #0 then (#0 , env)
  else if %weq (sg-num-val (sg-tm-hd rcs)) #1
    then (let p = sg-push-ihs fr (sg-tm-tl rcs) (lcons (cons #114 (cons #58 (sg-sym-str f))) env) in (%wsucc (fst p) , snd p))
    else sg-push-ihs fr (sg-tm-tl rcs) env
