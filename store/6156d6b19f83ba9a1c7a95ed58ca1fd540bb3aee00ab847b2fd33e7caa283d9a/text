nk-infer-skip-ihs : (NkTm → Word → NkTm → NkTm → NkTm) → NkTm → NkTm → Word → Word → NkTm → NkTm → NkTm → NkTm
nk-infer-skip-ihs chk kdefs curCtx curN n0 dummyTy (nk-cons (nk-num rf) rr) br =
  if %weq rf #1
    then (if nk-is-lam br
            then let c2 = nk-ext-s kdefs curCtx curN dummyTy
                 in nk-infer-skip-ihs chk kdefs c2 (%wsucc curN) n0 dummyTy rr (nk-subst (nk-lam-body br) #0 (nk-free curN))
            else nk-fail)
    else nk-infer-skip-ihs chk kdefs curCtx curN n0 dummyTy rr br
nk-infer-skip-ihs chk kdefs curCtx curN n0 dummyTy recs br =
  let rty = chk curCtx curN br nk-nil
  in if nk-failed rty then nk-fail else (if nk-no-free-ge n0 rty then rty else nk-fail)
