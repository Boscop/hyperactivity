coproc-basin-merge : {S1 S2 : Type 0}
                   → (eq1 : S1 → S1 → Bool) → (eq2 : S2 → S2 → Bool)
                   → (s1 : S1 → S1 → Bool) → (s2 : S2 → S2 → Bool)
                   → (c : (S1 × S2) → (S1 × S2) → Bool)
                   → (p q : S1 × S2) → isTrue (c p q)
                   → basin-of (S1 × S2) (coupled-step eq1 eq2 s1 s2 c) p
                     ≡ basin-of (S1 × S2) (coupled-step eq1 eq2 s1 s2 c) q
coproc-basin-merge = basin-couple-merges
