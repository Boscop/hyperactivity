sg-wop-idx : List Word → Opt Word
sg-wop-idx tag =
  if nk-wlist-eq tag "%weq" then some #0
  else if nk-wlist-eq tag "%wlt" then some #1
  else if nk-wlist-eq tag "%wadd" then some #2
  else if nk-wlist-eq tag "%wmax" then some #3
  else if nk-wlist-eq tag "%wsub" then some #4
  else if nk-wlist-eq tag "%wmul" then some #5
  else if nk-wlist-eq tag "%wdiv" then some #6
  else if nk-wlist-eq tag "%wmod" then some #7
  else if nk-wlist-eq tag "%wand" then some #8
  else if nk-wlist-eq tag "%wor" then some #9
  else if nk-wlist-eq tag "%wxor" then some #10
  else if nk-wlist-eq tag "%wshl" then some #11
  else if nk-wlist-eq tag "%wshr" then some #12
  else none
