-- the labellings counted by their records: (record, how many), the count in binary
fq-eqv : Nat × (Nat × (Nat × Nat)) → Nat × (Nat × (Nat × Nat)) → Bool
fq-eqv v w = if eqb (fst v) (fst w) then (if eqb (fst (snd v)) (fst (snd w)) then (if eqb (fst (snd (snd v))) (fst (snd (snd w))) then eqb (snd (snd (snd v))) (snd (snd (snd w))) else false) else false) else false
