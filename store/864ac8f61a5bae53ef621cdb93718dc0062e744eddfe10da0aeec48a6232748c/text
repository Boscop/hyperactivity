-- the subsets of the candidates whose members are pairwise not close
fq-subs : Nat → List (Nat × Nat) → List (Nat × Nat) → List (List (Nat × Nat))
fq-subs r cs sel = case cs of
  nil → cons sel nil
  cons c rest → fq-appl (if fq-free r c sel then fq-subs r rest (cons c sel) else nil) (fq-subs r rest sel)
