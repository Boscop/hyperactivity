-- what the public server keeps local-only: the raw binding history (/history, /api/history), while /graph,
-- /api/graph, /hi, /hi/scene, /hi/field, /hi/room, and /hi/events are served publicly from precomputed views/
s-views-path : List Word → Bool
s-views-path p = orB (h-prefix "/history" p) (h-prefix "/api/history" p)
