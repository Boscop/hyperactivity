-- so the sign is a function on the arrangements themselves, not on triples: it is defined on the points
-- and carried along the rotation paths by sgn-rot, which is what makes it well defined on a
-- configuration rather than on a drawing of one
cyc-sign : Cyc Nb → Bool
cyc-sign z =
  case z return (λ w → Bool) of
    cyc a b c → is-pos a b c
    cyc-rot a b c i → sgn-rot a b c i
