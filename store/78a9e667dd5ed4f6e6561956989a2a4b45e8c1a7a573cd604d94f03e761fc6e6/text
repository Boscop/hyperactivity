max4-ge : (A B C D : BZ) → bcanon (snd A) ≡ true → bcanon (snd B) ≡ true → bcanon (snd C) ≡ true → bcanon (snd D) ≡ true →
  (zle (zv A) (zv (bz-max (bz-max A B) (bz-max C D))) × zle (zv B) (zv (bz-max (bz-max A B) (bz-max C D)))) × (zle (zv C) (zv (bz-max (bz-max A B) (bz-max C D))) × zle (zv D) (zv (bz-max (bz-max A B) (bz-max C D))))
max4-ge A B C D cA cB cC cD =
  ((zle-trans (zv A) (zv (bz-max A B)) (zv (bz-max (bz-max A B) (bz-max C D))) (fst (bz-max-sound A B cA cB)) (fst (bz-max-sound (bz-max A B) (bz-max C D) (bz-max-canon A B cA cB) (bz-max-canon C D cC cD))) ,
    zle-trans (zv B) (zv (bz-max A B)) (zv (bz-max (bz-max A B) (bz-max C D))) (snd (bz-max-sound A B cA cB)) (fst (bz-max-sound (bz-max A B) (bz-max C D) (bz-max-canon A B cA cB) (bz-max-canon C D cC cD)))) ,
   (zle-trans (zv C) (zv (bz-max C D)) (zv (bz-max (bz-max A B) (bz-max C D))) (fst (bz-max-sound C D cC cD)) (snd (bz-max-sound (bz-max A B) (bz-max C D) (bz-max-canon A B cA cB) (bz-max-canon C D cC cD))) ,
    zle-trans (zv D) (zv (bz-max C D)) (zv (bz-max (bz-max A B) (bz-max C D))) (snd (bz-max-sound C D cC cD)) (snd (bz-max-sound (bz-max A B) (bz-max C D) (bz-max-canon A B cA cB) (bz-max-canon C D cC cD)))))
