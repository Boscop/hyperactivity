-- the semantic substitution environment: lookup(i, evalEnv(θ, ρ)) = eval(θ(i), ρ)
tl-evalEnv : (g d : TlCtx) → TlSub g d → TlEnv d → TlEnv g
tl-evalEnv tl-empty d th rho = unit
tl-evalEnv (tl-ext g a) d th rho = (tl-evalEnv g d (λ b i → th b (tl-vs g a b i)) rho , tl-eval {(d , a)} (th a (tl-vz g a)) rho)
