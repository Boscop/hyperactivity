-- Compile HExpr -> pin transactions + result slot(s):
--   hx-dup-add v:
--     slot 0: NUM(v), p0 -> {1,0} (4)
--     slot 1: DUP,    p0 -> {0,0} (0), p1 -> {2,0} (8), p2 -> {2,1} (9)
--     Note: p2 defaults to EXT on load, so instead wire DUP(p1->{2,0}, p2->{2,1}) via:
--       slot 0: NUM(v), p0 -> {1,0} (4)
--       slot 1: DUP,    p0 -> {0,0} (0), p1 -> {2,0} (8)  [p2=EXT] -> produces NUM(v) in slot 0 & slot 1!
--     Wait: for full `let x = v in x + x`, wire slot 0=NUM(v) ⋈ slot 1=DUP,
--       and use `hx-add` directly for binary add, OR add a 2-bit p2 load?
--     Even cleaner: `hx-dup-add` compiles to TWO parallel redexes or `NUM(v) ⋈ DUP` -> readout BOTH slots = v,
--     AND `hx-add x y` compiles to `NUM(x) ⋈ ADD(NUM(y))` -> result in slot 2 = x + y!
--     AND `hx-par-add a b c d` compiles BOTH `a + b` (slots 0,1,2) AND `c + d` (slots 3,4,5)
--     to fire SIMULTANEOUSLY on Lane 0 and Lane 1 (dual_fire = 1)!
compile-hexpr : HExpr → List Word
compile-hexpr (hx-lit v) =
  sv-concat
    (cons ic-clear-all
    (cons (ic-load #0 #0 #4)
    (cons (ic-load #0 #3 v)
    (cons (ic-load #0 #1 #3) nil))))
compile-hexpr (hx-add x y) =
  sv-concat
    (cons ic-clear-all
    (cons (ic-load #0 #0 #4)   -- slot 0: NUM(x), p0 -> slot 1.0 (4)
    (cons (ic-load #0 #3 x)
    (cons (ic-load #0 #1 #4)
    (cons (ic-load #1 #0 #5)   -- slot 1: ADD, p0 -> slot 0.0 (0), p1 -> slot 2.0 (8)
    (cons (ic-load #1 #1 #0)
    (cons (ic-load #1 #2 #8)
    (cons (ic-load #2 #0 #4)   -- slot 2: NUM(y), p0 -> slot 1.1 (5)
    (cons (ic-load #2 #3 y)
    (cons (ic-load #2 #1 #5) nil))))))))))
compile-hexpr (hx-dup-add v) =
  -- Compiles `let x = v in (x, x)` via unboxed hardware DUP: slot 0=NUM(v) ⋈ slot 1=DUP -> slot 0=v, slot 1=v
  sv-concat
    (cons ic-clear-all
    (cons (ic-load #0 #0 #4)   -- slot 0: NUM(v), p0 -> slot 1.0 (4)
    (cons (ic-load #0 #3 v)
    (cons (ic-load #0 #1 #4)
    (cons (ic-load #1 #0 #2)   -- slot 1: DUP, p0 -> slot 0.0 (0), p1 -> EXT (3)
    (cons (ic-load #1 #1 #0)
    (cons (ic-load #1 #2 #3) nil)))))))
compile-hexpr (hx-par-add a b c d) =
  -- Compiles `(a + b) || (c + d)` into disjoint slots {0,1,2} and {3,4,5} for 2-redex/cycle dual-lane firing!
  sv-concat
    (cons ic-clear-all
    (cons (ic-load #0 #0 #4)   -- Subgraph 0: slot 0=NUM(a) ⋈ slot 1=ADD(slot 2=NUM(b))
    (cons (ic-load #0 #3 a)
    (cons (ic-load #0 #1 #4)
    (cons (ic-load #1 #0 #5)
    (cons (ic-load #1 #1 #0)
    (cons (ic-load #1 #2 #8)
    (cons (ic-load #2 #0 #4)
    (cons (ic-load #2 #3 b)
    (cons (ic-load #2 #1 #5)
    (cons (ic-load #3 #0 #4)   -- Subgraph 1: slot 3=NUM(c) ⋈ slot 4=ADD(slot 5=NUM(d))
    (cons (ic-load #3 #3 c)
    (cons (ic-load #3 #1 #16)  -- {4,0} = 16
    (cons (ic-load #4 #0 #5)
    (cons (ic-load #4 #1 #12)  -- {3,0} = 12
    (cons (ic-load #4 #2 #20)  -- {5,0} = 20
    (cons (ic-load #5 #0 #4)
    (cons (ic-load #5 #3 d)
    (cons (ic-load #5 #1 #17) nil))))))))))))))))))) -- {4,1} = 17
