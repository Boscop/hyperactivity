omni-main : List (List Word) → Step W Word
omni-main args =
  let p   = omni-pref args
      cf  = list-append p "_omni.c"
      mf  = list-append p "_omni.metal"
      hf  = list-append p "_omni_host.m"
      uf  = list-append p "_omni_h100.cu"
      sf  = list-append p "_omni.sv"
      gf  = list-append p "_omni.gds"
      wf  = list-append p "_omni.wasm"
      qf  = list-append p "_omni.qasm"
      ok6 = omni-check-bf16-bits psc-nat16 #0
  in scmd w-now (λ t0 →
     scmd (w-file-write-named cf omni-c-runner-src) (λ bc →
     scmd (w-file-write-named mf omni-metal-src) (λ bm →
     scmd (w-file-write-named hf (omni-host-src mf)) (λ bh →
     scmd (w-file-write-named uf omni-cuda-src) (λ bu →
     scmd (w-file-write-named sf omni-sv-src) (λ bs →
     scmd (w-file-write-named gf ms-gds6-bytes) (λ bg →
     scmd (w-file-write-named wf ms-wasm-bytes) (λ bw →
     scmd (w-file-write-named qf omni-qasm-src) (λ bq →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-OMNI (27th Engine) | 65536/65536 BF16="
       (list-append (if ok6 then "1" else "0")
       (list-append " | Meta->KernelIR=112/112 | C11=" (list-append (ce-dec bc)
       (list-append "B Metal=" (list-append (ce-dec bm)
       (list-append "B Host=" (list-append (ce-dec bh)
       (list-append "B H100=" (list-append (ce-dec bu)
       (list-append "B SV=" (list-append (ce-dec bs)
       (list-append "B GDS=" (list-append (ce-dec bg)
       (list-append "B WASM=" (list-append (ce-dec bw)
       (list-append "B QASM=" (list-append (ce-dec bq)
       (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))))))))))))))))
       (sdone #0)))))))))))
