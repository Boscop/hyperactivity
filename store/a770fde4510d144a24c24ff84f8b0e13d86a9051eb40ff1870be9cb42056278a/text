ke-emit-rotr : KTarget → List Word → Word → List Word
ke-emit-rotr kt-sv s n =
  let r = %wand n #31
  in if %weq r #0 then s
     else list-append "{" (list-append s (list-append "[" (list-append (ce-dec (%wsub r #1))
          (list-append ":0], " (list-append s (list-append "[31:" (list-append (ce-dec r) "]}")) )))))
ke-emit-rotr _ s n =
  let r = %wand n #31
  in if %weq r #0 then s
     else list-append "((" (list-append s (list-append " >> " (list-append (ce-dec r)
          (list-append "u) | (" (list-append s (list-append " << " (list-append (ce-dec (%wsub #32 r)) "u))")))))))
