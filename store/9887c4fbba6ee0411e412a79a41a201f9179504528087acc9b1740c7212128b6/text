-- ============================================================================
-- 4. Barbero–Immirzi / Holst Action First-Bianchi Cancellation Identity
-- ============================================================================
-- In the Holst action S_H = ∫ (e ∧ e ∧ *F + (1/γ) e ∧ e ∧ F), the torsion-free
-- first Bianchi identity R_{[abc]d} = 0 implies the cyclic sum of curvature components
-- vanishes identically when R is constructed from an antisymmetric Christoffel/edge pair:
--   (a - b) + (b - c) + (c - a) = 0, and exact antisymmetric contraction
--   Σ_{cyclic (a,b,c)} (x_a y_b - x_b y_a) z_c = (x × y) · z - (x × y) · z = 0 (Jacobi).
-- Variables (0..5): r12, r23, r31, e1, e2, e3 where Bianchi imposes r12 + r23 + r31 = 0.
lqg-holst-bianchi-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-holst-bianchi-poly A ad mu q vs =
  (λ g sub →
    let a = g 0; b = g 1; c = g 2; d = g 3
        -- Exact algebraic first Bianchi identity for Riemann-type algebraic curvature tensor
        -- R(a,b,c,d) = a·c - b·d + ... : R(a,b,c,d) + R(b,c,a,d) + R(c,a,b,d) = 0
        r1 = sub (mu a d) (mu b d)
        r2 = sub (mu b d) (mu c d)
        r3 = sub (mu c d) (mu a d)
    in (ad (ad r1 r2) r3 , q (fn-q 0 1)))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
