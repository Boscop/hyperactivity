im-fn : List Word → Word → Word → List Word → List Word
im-fn name ng prog tl =
  io-cat
    (cons "inline uint32_t opt_" (cons name (cons "(uint32_t w0, uint32_t w1, uint32_t w2) {" (cons ce-nl
    (cons (im-gates (toNat ng) #3 prog
      (io-cat (cons "  return w" (cons (ce-dec (%wadd #2 ng)) (cons ";" (cons ce-nl
              (cons "}" (cons ce-nl (cons tl nil))))))))) nil)))))
