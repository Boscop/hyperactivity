-- the chunks run one process after another, by xargs (a loop in this process would keep what each
-- run allocates until it ends); whether every one succeeded and none ended inside a record
e-run-chunks : List Word → List Word → List Word → List Word → List Word → List (List Word) → Proc W Bool
e-run-chunks m self syn out dir ps = bind (h-write (list-append dir "/list") (h-concat (list-map h-line ps))) (λ w →
  bind (e-cmd (cons "xargs" (cons "-a" (cons (list-append dir "/list") (cons "-I" (cons "{}" (cons m (cons self (cons "--chunk" (cons syn (cons out (cons "{}" (cons dir nil))))))))))))) (λ s →
  bind (h-read (list-append dir "/carry")) (λ c → ret (andB (weq s #0) (h-null (e-or c))))))
