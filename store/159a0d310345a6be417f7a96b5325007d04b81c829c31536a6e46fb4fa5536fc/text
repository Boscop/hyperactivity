-- the service refines the single sequential map: for every program of the sequential client and
-- every choice sequence, the history the client has observed is a history of kv-map-world
-- from the empty map
kv-refines : (prog : List KvCmd) → Refines {KvS} {Word → Word} {KvMsg} {KvSt} kv-map-world (λ k → #0) (λ g → c-hist (snd (fst g 3))) kv-seq-beh (kv-init (kv-seq-cli prog))
kv-refines prog chs =
  (kv-store (c-conf (snd (fst (fleet-run {KvMsg} {KvSt} kv-seq-beh chs (kv-init (kv-seq-cli prog))) 3))) , snd (snd (snd (snd (kv-seq-safe prog chs)))))
