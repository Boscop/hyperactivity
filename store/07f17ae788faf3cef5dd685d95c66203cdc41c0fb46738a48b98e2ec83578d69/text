-- ---------------------------------------------------------------- 3. Checked Parallel `N-Queens` & Higher-Order λ-Sharing Workloads
-- Exact structural bitmask `N-Queens` graph search matching `hypernet16_tile`'s hardware `NQ_SEARCH` rule:
nq-step : (Word → Word → Word → Word) → Nat → Word → Word → Word → Word → Word
nq-step k zero          bit cols dl dr = #0
nq-step k (suc remCols) bit cols dl dr =
  let blocked = %wor cols (%wor dl dr)
      here    = if %weq (%wand blocked bit) #0
                then k (%wor cols bit) (%wshl (%wor dl bit) #1) (%wshr (%wor dr bit) #1)
                else #0
      rest    = nq-step k remCols (%wshl bit #1) cols dl dr
  in %wadd here rest
