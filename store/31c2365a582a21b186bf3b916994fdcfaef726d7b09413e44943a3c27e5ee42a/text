-- (kept only when a served source is named: without one, git carries the change)
h-keep-before-with : List Word → Sum Unit (List Word) → Proc W Unit
h-keep-before-with path (inl u) = ret unit
h-keep-before-with path (inr s) = bind (h-env "CUBICAL_STORE") (λ e → bind (h-read (h-before-of (h-store-of e) path)) (h-keep-before-at (h-store-of e) path))
