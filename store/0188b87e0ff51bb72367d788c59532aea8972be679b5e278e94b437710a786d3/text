-- ---------------------------------------------------------------- runs that may fail
-- a run of the meaning is a tree over the observed signature ending in MRes: a result, or a
-- failure (undefined behaviour or a stop, with its reason) after which nothing follows
r-bind : {O : Sig} {A B : Type} → Step O (MRes A) → (A → Step O (MRes B)) → Step O (MRes B)
r-bind (sdone r) f = case r of
  mok a → f a
  mub w → sdone (mub w)
  mstop w → sdone (mstop w)
r-bind (scmd c k) f = scmd c (λ x → r-bind (k x) f)
