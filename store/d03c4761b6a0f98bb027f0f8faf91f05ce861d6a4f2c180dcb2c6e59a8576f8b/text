nk-copy-fx-wf : (ins outs : NkEnv) (n0 n : NkW) (e : NkEnv) →
  (nk-wire-le n0 n ≡ true) → nk-fx-wf ins outs n0 (nk-adv n e) (nk-copy-fx e n) ≡ true
nk-copy-fx-wf ins outs n0 n nke-nil p0 = refl
nk-copy-fx-wf ins outs n0 n (nke-cons w r) p0 =
  let p1 = nk-adv-mono (nk-s n) r
      hr = nk-in-range-up n0 (nk-s n) (nk-adv (nk-s n) r) n p1 (nk-in-range-self n0 n p0)
  in nk-and-intro (nk-in-set outs n0 (nk-adv (nk-s n) r) n) (nk-fx-wf ins outs n0 (nk-adv (nk-s n) r) (nk-copy-fx r (nk-s n)))
       (nk-in-set-range outs n0 (nk-adv (nk-s n) r) n hr)
       (nk-copy-fx-wf ins outs n0 (nk-s n) r (nk-wire-le-trans n0 n (nk-s n) p0 (nk-wire-le-s n)))
