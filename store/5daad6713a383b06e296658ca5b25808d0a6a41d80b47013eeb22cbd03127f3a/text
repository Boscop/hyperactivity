-- ---------------------------------------------------------------- equality of words and of tokens
eqw-toNat : (a b : Word) → eqw a b ≡ eqb (toNat a) (toNat b)
eqw-toNat a b =
  %welimP (λ v → (b : Word) → eqw v b ≡ eqb (toNat v) (toNat b)) a
    (λ b → %welimP (λ v → eqw #0 v ≡ eqb (toNat #0) (toNat v)) b (λ i → true) (λ m g i → false))
    (λ n h b →
       %welimP (λ v → eqw (%wsucc n) v ≡ eqb (toNat (%wsucc n)) (toNat v)) b (λ i → false)
         (λ m g → h m)) b
