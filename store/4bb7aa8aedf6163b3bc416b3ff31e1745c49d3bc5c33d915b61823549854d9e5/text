sv-rom-module : List Word
sv-rom-module =
  list-append
    (sv-lines
      (cons "module hypercore_rom (input logic [7:0] pc, output logic [31:0] inst);"
      (cons "  always_comb begin"
      (cons "    case (pc)" nil))))
    (list-append
      (sv-rom-cases #0 soc-demo-prog)
      (sv-lines
        (cons "      default: inst = 32'h00000000;"
        (cons "    endcase"
        (cons "  end"
        (cons "endmodule"
        (cons "" nil)))))))
