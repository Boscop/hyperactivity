-- coef · J at the exponents (I, J, K) moved by (+ua − da, +ub − db, +uc − dc); zero when coef is
he-t : Nat → Nat → BQ → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → BQ
he-t ap aq cf ei ej ek ua da ub db uc dc = if bq-nz cf then bq-mul cf (he-J ap aq (monus (plus ei (suc ua)) da) (monus (plus ej (suc ub)) db) (monus (plus ek (suc uc)) dc)) else bq-zero
