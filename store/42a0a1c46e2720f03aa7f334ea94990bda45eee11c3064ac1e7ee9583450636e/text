-- UNIVERSAL THEOREM 6 (MULTI-MARKET EXECUTION NEVER VIOLATES PRINCIPAL + GAS + FOUNDER FLOOR, 0 POSTULATES):
ho-thm-crossvenue-zero-loss :
  (principal fee sweep gross : Nat) →
  ho-admit-crossvenue principal fee sweep gross ≡ true →
  bn-le-nat (plus principal (plus fee sweep)) gross ≡ true
ho-thm-crossvenue-zero-loss _ _ _ _ h = h
