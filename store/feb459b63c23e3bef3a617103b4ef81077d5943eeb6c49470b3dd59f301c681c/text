-- (part of language-support)
x86_operand_to_xmm_mem : (proc_mode' : proc_mode) → (operand_size : ZI) → (inst_ac? : Bool) → (operand : Bits #128) → (seg_reg : ZI) → (addr : Bits #64) → (prefixes' : prefixes) → (rex_byte : Bits #8) → (r_m : Bits #3) → (mod_var : Bits #2) → (sib' : sib) → MS Unit
x86_operand_to_xmm_mem proc_mode' operand_size inst_ac? operand seg_reg addr prefixes' rex_byte r_m mod_var sib' =
  λ σ →
    if (weq mod_var #3) then
      the (MS Unit)
        (onS {Bits #4} {Unit} (reg_index r_m rex_byte #0) (λ t'1 →
           write_xmmi_size (bits_of_int operand_size (zpos #5)) t'1 (bv-unsigned #128 operand))) σ
    else
      the (MS Unit)
        (let k'8 : Bool → MS Unit
             k'8 =
               λ check_alignment? →
                 bindS {ZI} {Unit} (select_address_size proc_mode' (Some prefixes')) (λ addr_size →
                   let base_reg : Option ZI
                       base_reg = (select_base_register proc_mode' rex_byte r_m mod_var sib')
                   in wme_size proc_mode' addr_size operand_size addr base_reg seg_reg operand check_alignment? false)
         in λ σ →
              if inst_ac? then
                the (MS Unit)
                  (bindS {Bool} {Unit} alignment_checking_enabled_p (λ t'3 →
                     k'8 t'3)) σ
              else
                the (MS Unit)
                  (k'8 false) σ) σ
