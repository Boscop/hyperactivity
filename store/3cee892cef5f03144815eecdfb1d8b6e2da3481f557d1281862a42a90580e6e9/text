-- the other readers whose path ends at the focus
hi-at : List Word → List Word → List Word → List (List Word) → Proc W (List (List Word))
hi-at st rd f nil = ret nil
hi-at st rd f (cons e r) = bind (h-read (list-append st (list-append "/hi/" e))) (λ w → bind (hi-at st rd f r) (λ rest →
  ret (if andB (h-prefix "walk-" e) (andB (h-eq (hi-last (h-lines (s-or nil w))) f) (h-not (h-eq (h-unhex (h-drop "walk-" e)) rd))) then cons (h-unhex (h-drop "walk-" e)) rest else rest)))
