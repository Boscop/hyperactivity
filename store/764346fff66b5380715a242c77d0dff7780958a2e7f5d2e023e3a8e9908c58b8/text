hh-resp : List Word → List Word → List Word → List Word
hh-resp status ct body =
  list-append "HTTP/1.1 " (list-append status (list-append hh-crlf
  (list-append "Content-Type: " (list-append ct (list-append hh-crlf
  (list-append "Cache-Control: public, max-age=60" (list-append hh-crlf
  (list-append "X-Engine: hx-httpd-native-c11" (list-append hh-crlf
  (list-append "Connection: close" (list-append hh-crlf
  (list-append "Content-Length: " (list-append (ce-dec (cli-len body)) (list-append hh-crlf (list-append hh-crlf body)))))))))))))))
