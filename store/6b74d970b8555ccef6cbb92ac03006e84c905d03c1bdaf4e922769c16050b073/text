const-head1 : (P : Type 1) (d : Conj) (ds : DNF) → isTrue (dnf-canon (lcons d ds)) → dnf-nonconst (lcons d ds) ≡ false → (lcons d ds ≡ dnf-one → P) → P
const-head1 P lnil ds c n k1 = const-tail1 P ds (canon-ok (lcons lnil ds) (isTrue→eq {dnf-canon (lcons lnil ds)} c)) k1
const-head1 P (lcons l ls) ds c n k1 = Empty-rec (false-true Empty (λ i → n (~ i)))
