counts-phi : (f : List (List Word) → Word) → (a : El PO) → (l l' : List (El entry-ord)) →
             ((x : El entry-ord) → count x l ≡ count x l') → count {PO} a (list-map (phi f) l) ≡ count {PO} a (list-map (phi f) l')
counts-phi f a l l' h =
  ifP {λ bb → count {PO} a (list-map (phi f) l) ≡ count {PO} a (list-map (phi f) l')} {eqo {PO} a (phi f (snd a))}
    (λ e → tr (count {entry-ord} (snd a) l) (count-phi-t f a l e) (tr (count {entry-ord} (snd a) l') (h (snd a)) (sym (count-phi-t f a l' e))))
    (λ e → tr zero (count-phi-f f a l e) (sym (count-phi-f f a l' e)))
