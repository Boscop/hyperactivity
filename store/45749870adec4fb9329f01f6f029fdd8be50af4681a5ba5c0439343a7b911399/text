-- three doubled spins close a triangle: even sum, each at most the sum of the others
btri-ok : List Bool → List Bool → List Bool → Bool
btri-ok x y z = if bin-bit0 (bin-add x (bin-add y z)) then false else (if bin-leb x (bin-add y z) then (if bin-leb y (bin-add x z) then bin-leb z (bin-add x y) else false) else false)
