-- a directly recursive field: of the data type itself, or of a path line into it, at any dimension
-- (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §18.17 “E28a — Induction hypotheses for path-typed recursive fields”): laid out and compiled as a reference to the type
is-rec-ty d c =
  case c of
    tdata d2 ps V → %weq d d2
    tpathp L a b V → is-rec-line d L
    tguess k g t V → is-rec-ty d t
    _ → false
