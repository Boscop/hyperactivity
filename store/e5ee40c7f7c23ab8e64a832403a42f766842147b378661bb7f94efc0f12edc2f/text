-- a nonpositive verdict means value ≤ 0
bz-nonpos-true : (s : Bool) → (m : List Bool) → bcanon m ≡ true → bz-nonpos (s , m) ≡ true → zle (zv (s , m)) (zero , zero)
bz-nonpos-true s m c = case s return λ u → bz-nonpos (u , m) ≡ true → zle (zv (u , m)) (zero , zero) of
  true → λ h → nonpos-tv m (bin-null m) (symB (bin-null-sound m c)) h
  false → λ h → (bin-to-nat m , plus-zero (bin-to-nat m))
