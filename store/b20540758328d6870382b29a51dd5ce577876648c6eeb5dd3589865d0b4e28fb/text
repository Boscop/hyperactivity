-- Dirac's level as a series in x to order n, for principal number nn and κ = j + ½ (kq = κ):
-- u = −x/κ², D = n − δ = n − κ + κ√(1 + u), w = x/D², E/mc² = (1 + w)^{−1/2} = 1/√(1 + w)
dirac-d : Nat → BQ → Nat → List BQ
dirac-d nn kq n = ps-add (ps-const (fn-sub (fn-q nn 1) kq) n) (ps-scale kq (ps-sqrt1 (ps-shift (ps-const (fn-neg (fn-inv (bq-mul kq kq))) n) n) n) n) n
