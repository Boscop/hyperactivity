-- structural equality of codes (the fragment matching covers)
code-same a b =
  case a of
    cvar n → (case b of cvar m → %weq n m; _ → false)
    cglob n → (case b of cglob m → %weq n m; _ → false)
    clam x → (case b of clam y → code-same x y; _ → false)
    capp f x → (case b of capp g y → andb (code-same f g) (code-same x y); _ → false)
    cpair x y → (case b of cpair x2 y2 → andb (code-same x x2) (code-same y y2); _ → false)
    cfst x → (case b of cfst y → code-same x y; _ → false)
    csnd x → (case b of csnd y → code-same x y; _ → false)
    clet t x → (case b of clet t2 y → andb (code-same t t2) (code-same x y); _ → false)
    ccon d c fs ds → (case b of ccon d2 c2 fs2 ds2 → andb (%weq d d2) (andb (%weq c c2) (andb (list-same fs fs2) (list-same ds ds2))); _ → false)
    ccase d B x → (case b of ccase d2 B2 y → andb (%weq d d2) (andb (list-same B B2) (code-same x y)); _ → false)
    celim d P B x → (case b of celim d2 P2 B2 y → andb (%weq d d2) (andb (code-same P P2) (andb (list-same B B2) (code-same x y))); _ → false)
    cforce x → (case b of cforce y → code-same x y; _ → false)
    cthunk x → (case b of cthunk y → code-same x y; _ → false)
    cdata d ps → (case b of cdata d2 ps2 → andb (%weq d d2) (list-same ps ps2); _ → false)
    cwlit n → (case b of cwlit m → %weq n m; _ → false)
    cwsucc x → (case b of cwsucc y → code-same x y; _ → false)
    cwop o x y → (case b of cwop o2 x2 y2 → andb (%weq o o2) (andb (code-same x x2) (code-same y y2)); _ → false)
    cwelim w z s mo → (case b of cwelim w2 z2 s2 mo2 → andb (code-same w w2) (andb (code-same z z2) (code-same s s2)); _ → false)
    cann t T → (case b of cann t2 T2 → code-same t t2; _ → false)
    -- types, as a residual's motives hold them (a specialized process's eliminations)
    cpi m x y → (case b of cpi m2 x2 y2 → andb (%weq m m2) (andb (code-same x x2) (code-same y y2)); _ → false)
    csigma x y → (case b of csigma x2 y2 → andb (code-same x x2) (code-same y y2); _ → false)
    cuniv l → (case b of cuniv l2 → code-same l l2; _ → false)
    cword → (case b of cword → true; _ → false)
    cpty k n → (case b of cpty k2 n2 → andb (%weq k k2) (code-same n n2); _ → false)
    cplit k x → (case b of cplit k2 x2 → andb (%weq k k2) (%weq x x2); _ → false)
    cprim k as → (case b of cprim k2 as2 → andb (%weq k k2) (list-same as as2); _ → false)
    clzero → (case b of clzero → true; _ → false)
    clsuc l → (case b of clsuc l2 → code-same l l2; _ → false)
    clmax x y → (case b of clmax x2 y2 → andb (code-same x x2) (code-same y y2); _ → false)
    _ → false
