-- bounds on 2^{i/8} 3^{j/8} at precision k: (lower, upper) as rationals over 2^{k(i+j)}
rad-bounds : Nat → Nat → Nat → BQ × BQ
rad-bounds k i j = (bq-make true (bin-mul (bin-pow (root8 2 k) i) (bin-pow (root8 3 k) j)) (bin-pow2 (times k (plus i j))) ,
  bq-make true (bin-mul (bin-pow (bin-succ (root8 2 k)) i) (bin-pow (bin-succ (root8 3 k)) j)) (bin-pow2 (times k (plus i j))))
