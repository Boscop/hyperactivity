idc-car : (n : Nat) (X : Type 1) (E : X → Type 1) (Z : Type 1) (c : Cube n X) → DCube n X (λ γ → E γ → Z) c →
  DCube n X (λ γ → E γ → Z) (dcube-map n X (SF X E) X (λ γ' p → fst p) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c))
idc-car n X E Z c W =
  carry n X (λ γ → E γ → Z) (cube-map n X X (λ x → x) c) (dcube-map n X (SF X E) X (λ γ' p → fst p) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c))
    (psym (Cube n X) (dcube-map n X (SF X E) X (λ γ' p → fst p) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c)) (cube-map n X X (λ x → x) c)
       (dcube-map-of n X (SF X E) X (λ γ' p → fst p) (λ γ → (γ , λ ρ → ρ)) c))
    (dcube-reidx n X X (λ γ → E γ → Z) (λ γ → E γ → Z) (λ x → x) (λ x y → y) c W)
