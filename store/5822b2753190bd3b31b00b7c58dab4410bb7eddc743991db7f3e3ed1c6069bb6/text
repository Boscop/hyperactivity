step-lt : {a b r : Bool} → isTrue a → isTrue (not b) → isTrue (lex-step a b r)
step-lt ha nb =
  (case a return λ y → isTrue y → isTrue (lex-step y b r) of
     true → λ ha → (case b return λ z → isTrue (not z) → isTrue (if z then r else true) of true → λ nb → Empty-rec nb; false → λ nb → unit) nb
     false → λ ha → Empty-rec ha) ha
