euclid-gen-go : Nat → Word → Word → Word → Word → Word → Word → List GestureEvent
euclid-gen-go zero _ _ _ _ _ _ = nil
euclid-gen-go (suc f) i k n stepDur freq vel =
  let rest = euclid-gen-go f (%wsucc i) k n stepDur freq vel
  in if euclid-hit k n i
     then cons (ge-impulse (%wmul i stepDur) #0 freq vel) rest
     else rest
