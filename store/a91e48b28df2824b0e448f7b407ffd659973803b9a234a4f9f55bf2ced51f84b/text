-- the bonds as a tree rooted at the central carbon
gl-par : Glyc → Glyc
gl-par x = case x of
  gl-c1 → gl-c2
  gl-o1 → gl-c1
  gl-ho1 → gl-o1
  gl-h1a → gl-c1
  gl-h1b → gl-c1
  gl-c2 → gl-c2
  gl-o2 → gl-c2
  gl-ho2 → gl-o2
  gl-h2 → gl-c2
  gl-c3 → gl-c2
  gl-o3 → gl-c3
  gl-ho3 → gl-o3
  gl-h3a → gl-c3
  gl-h3b → gl-c3
