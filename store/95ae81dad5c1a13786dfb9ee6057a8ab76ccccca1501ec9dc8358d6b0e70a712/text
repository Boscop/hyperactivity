kvl-rep-nohalt : (r : Nat) → r < 3 → (st : KvSt) → IsHaltV {KvMsg} {KvSt} (kv-bc-beh r st) → Empty
kvl-rep-nohalt zero h st x = kvl-rep-nohalt-go (snd st) (fst st) (r-pend (fst st)) x
kvl-rep-nohalt (suc zero) h st x = kvl-rep-nohalt-go (snd st) (fst st) (r-pend (fst st)) x
kvl-rep-nohalt (suc (suc zero)) h st x = kvl-rep-nohalt-go (snd st) (fst st) (r-pend (fst st)) x
kvl-rep-nohalt (suc (suc (suc j))) h st x = Empty-rec h
