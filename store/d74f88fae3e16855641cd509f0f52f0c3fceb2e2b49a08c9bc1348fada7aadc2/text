kexpr-emit-qasm : List Word → List QGate → List Word
kexpr-emit-qasm comment circ =
  hw-ln "OPENQASM 3.0;"
  (hw-ln (list-append "include " (list-append hw-q (list-append "stdgates.inc" (list-append hw-q ";"))))
  (hw-ln (list-append "// " comment)
  (hw-ln "qubit[3] q;"
  (kexpr-qasm-gates circ nil))))
