tl-rename : {GA : TlCtx × TlTy} → TlTm GA → (d : TlCtx) → TlRen (fst GA) d → TlTm (d , snd GA)
tl-rename (tl-var g a i) d s = tl-var d a (s a i)
tl-rename (tl-lit g b) d s = tl-lit d b
tl-rename (tl-tt g) d s = tl-tt d
tl-rename (tl-lam g a b t) d s = tl-lam d a b (tl-rename t (tl-ext d a) (tl-ren-lift g d a s))
tl-rename (tl-app g a b f x) d s = tl-app d a b (tl-rename f d s) (tl-rename x d s)
tl-rename (tl-pair g a b x y) d s = tl-pair d a b (tl-rename x d s) (tl-rename y d s)
tl-rename (tl-fst g a b p) d s = tl-fst d a b (tl-rename p d s)
tl-rename (tl-snd g a b p) d s = tl-snd d a b (tl-rename p d s)
tl-rename (tl-inl g a b x) d s = tl-inl d a b (tl-rename x d s)
tl-rename (tl-inr g a b y) d s = tl-inr d a b (tl-rename y d s)
tl-rename (tl-case g a b c e l r) d s = tl-case d a b c (tl-rename e d s) (tl-rename l (tl-ext d a) (tl-ren-lift g d a s)) (tl-rename r (tl-ext d b) (tl-ren-lift g d b s))
