rc-threads : {R : Type} → List AtomThread → List Word → Word → (List TsoEv → List (Word × MOrd) → List Word → R → R) → List Word → RcRun R
rc-threads nil dom t k outs nx es ms acc = k es ms outs acc
rc-threads (cons th r) dom t k outs nx es ms acc =
  rc-thread dom t (λ out nx2 es2 ms2 acc2 → rc-threads r dom (%wsucc t) k (app-w outs out) nx2 es2 ms2 acc2) th nx es ms acc
