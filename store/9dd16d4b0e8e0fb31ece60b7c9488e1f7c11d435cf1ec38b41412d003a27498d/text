-- where an error is: the term's own shape as a code (its variables free, so it prints as written),
-- not its value, whose normal form may be large or unbounded (a proof applied to variables)
tsrc c =
  case c of
    tv x T → cfree x
    ti i → cfree i
    tg n V → cglob n
    tlam nm b V → clam (tsrc (b (%var nm Uw) Uw))
    tapp f a V → capp (tsrc f) (tsrc a)
    tpair a b V → cpair (tsrc a) (tsrc b)
    tfst p V → cfst (tsrc p)
    tsnd p V → csnd (tsrc p)
    tpi A nm b V → cpi #2 (tsrc A) (tsrc (b (%var nm Uw) Uw))
    tsigma A nm b V → csigma (tsrc A) (tsrc (b (%var nm Uw) Uw))
    tuniv l V → cuniv (tsrc l)
    tpathp A a b V → cpathp (tsrc A) (tsrc a) (tsrc b)
    tplam nm b V → cplam (tsrc (b (%dim nm)))
    tpapp p r V → cpapp (tsrc p) (tsrc r)
    tc0 → ci0
    tc1 → ci1
    tneg r V → cneg (tsrc r)
    tmeet r s V → cmeet (tsrc r) (tsrc s)
    tjoin r s V → cjoin (tsrc r) (tsrc s)
    tlet t nm b V → clet (tsrc t) (tsrc (b (%var nm Uw) Uw))
    tann t T V → cann (tsrc t) (tsrc T)
    tforce t V → cforce (tsrc t)
    tthunk t V → cthunk (tsrc t)
    tlevel → clevel
    tlzero → clzero
    tlsuc l V → clsuc (tsrc l)
    tlmax a b V → clmax (tsrc a) (tsrc b)
    tguess k g t V → tsrc t
    tspine t V → tsrc t
    thole k V → cfree V
    _ → cfree (tval c)
