csr-le-max-r : (a b c : Nat) → (csr-nat-le a c ≡ true) → csr-nat-le a (csr-nat-max b c) ≡ true
csr-le-max-r zero b c h = refl
csr-le-max-r (suc a) zero zero h = cs-no h
csr-le-max-r (suc a) (suc b) zero h = cs-no h
csr-le-max-r (suc a) zero (suc c) h = h
csr-le-max-r (suc a) (suc b) (suc c) h = csr-le-max-r a b c h
