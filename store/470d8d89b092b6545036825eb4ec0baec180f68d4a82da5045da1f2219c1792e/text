-- Multi-row 2D standard-cell floorplan placer: stacks rows vertically at pitch `rowGap + cellH`
place-grid-2d : Nat → Nat → Nat → Nat → Nat → List (List Nat) → List Rect
place-grid-2d x0 yCur cellH xGap yGap nil = nil
place-grid-2d x0 yCur cellH xGap yGap (cons row rows) =
  list-append
    (place-row x0 yCur cellH xGap row)
    (place-grid-2d x0 (plus yGap (plus cellH yCur)) cellH xGap yGap rows)
