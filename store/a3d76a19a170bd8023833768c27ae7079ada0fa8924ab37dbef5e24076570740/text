bw-neg : (A : Type) → (z one : A) → (ad mu : A → A → A) → (ng : A → A) → (neg : A → Bool) → (n : Nat) → (sy-vn A n → sy-vn A n → A) → Nat
bw-neg A z one ad mu ng neg n = case n return λ k → (sy-vn A k → sy-vn A k → A) → Nat of
  zero → λ f → zero
  suc m → λ f → if neg (f (bw-e A z one m) (bw-e A z one m)) then suc (bw-neg A z one ad mu ng neg m (bw-g A z one ad mu ng m f)) else bw-neg A z one ad mu ng neg m (bw-g A z one ad mu ng m f)
