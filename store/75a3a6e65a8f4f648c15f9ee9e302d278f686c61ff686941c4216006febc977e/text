-- streaming each node's show-<hex> view one statement at a time, collecting only missing-statement diagnostics
v-keep-each : List Word → List Word → List (List Word) → Proc W (List (List Word))
v-keep-each st dir nil = ret nil
v-keep-each st dir (cons i r) =
  bind (v-statement st i) (λ s →
  bind (h-write (list-append dir (list-append "show-" (h-hex i))) (v-show-text i s)) (λ b →
  bind (v-keep-each st dir r) (λ rest →
  ret (list-append (v-rule (h-null (h-concat s)) i "no statement") rest))))
