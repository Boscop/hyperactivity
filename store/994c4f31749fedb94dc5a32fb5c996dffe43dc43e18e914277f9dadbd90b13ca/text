ht-entry : Proc W Unit
ht-entry =
  bind h-args (λ argv →
  bind (h-mkdir ht-out-dir) (λ m0 →
    let ptx    = ht-emit-saturated-sm90a-ptx
        isLive = ht-is-live (h-tail-lists argv)
    in bind (h-write (list-append ht-out-dir "/hx_hyperthroughput_sm90a.ptx") ptx) (λ w0 →
       bind (if isLive then ht-remote-bench else ret {lzero} {W} (#0 , bn-empty-bytes)) (λ rPtx →
         let l1 = bn-ln "[HX-HYPERTHROUGHPUT | MULTI-SM HOPPER SM_90a ULOP3.LUT + 64-LANE CSA COMPILER]"
             l2 = bn-ln "  1. 64-Lane CSA Proofs   : ht-thm-ulop3-csa64-exact=PASS | ht-thm-7mask-csa-tree-exact=PASS (8 ULOP3s vs 224 scalar ops = 28x)"
             l3 = bn-ln (list-append "  2. Saturated SM_90a PTX : " (list-append (h-decimal (fromNat (list-length ptx))) "B | 32x-unrolled lop3.b32/turn (416 gate-equivs/turn, 0 C/Python)"))
             l4 = bn-ln (list-append "  3. H200 ptxas Assembly  : " (if isLive then snd rPtx else "PLAN_READY (pass 'hyperactivate' to assemble & run on H200s)"))
         in bind (h-out (h-concat (cons l1 (cons l2 (cons l3 (cons l4 nil)))))) (λ u1 →
            exit #0)))))
