-- ---------------------------------------------------------------- 1. Shared-Fanout Net Synthesis & Structural CSE
-- Exact gate count of a shared k-wire SSA Net over n primary inputs (no tree fanout duplication!)
net-gates : {O0 O1 O2 : Type} → (k n : Nat) → Net O0 O1 O2 Unit n k → Nat
net-gates {O0} {O1} {O2} zero n f = circ-gates {O0} {O1} {O2} {SumFin n} (f unit)
net-gates {O0} {O1} {O2} (suc k) n lk =
  plus (circ-gates {O0} {O1} {O2} {SumFin n} (fst lk))
       (net-gates {O0} {O1} {O2} k (suc n) (snd lk))
