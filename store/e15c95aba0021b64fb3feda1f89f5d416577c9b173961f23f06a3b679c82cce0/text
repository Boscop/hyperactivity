gpu-lane-eval : GpuOp → Word → Word → Word
gpu-lane-eval gop-add a b = u64toWord (u64add (u64 a) (u64 b))
gpu-lane-eval gop-sub a b = u64toWord (u64sub (u64 a) (u64 b))
gpu-lane-eval gop-mul a b = u64toWord (u64mul (u64 a) (u64 b))
gpu-lane-eval gop-and a b = u64toWord (u64and (u64 a) (u64 b))
gpu-lane-eval gop-or  a b = u64toWord (u64or  (u64 a) (u64 b))
gpu-lane-eval gop-xor a b = u64toWord (u64xor (u64 a) (u64 b))
gpu-lane-eval gop-shl a b = u64toWord (u64shl (u64 a) (u64and (u64 b) (u64 #63)))
gpu-lane-eval gop-shr a b = u64toWord (u64shr (u64 a) (u64and (u64 b) (u64 #63)))
gpu-lane-eval gop-eq  a b = if %weq a b then #0 else #1
gpu-lane-eval gop-lt  a b = if %wlt a b then #0 else #1
