-- an entry of the store: the source's (pieces, modules and their pointers, shared; lib/host.cub,
-- h-source) or the machine's own
hy-source-entry : List Word → Bool
hy-source-entry rel = orB (h-prefix "written/" rel) (orB (h-prefix "modules/" rel) (orB (h-prefix "names-of/" rel) (orB (h-prefix "module-of/" rel)
  (andB (orB (h-ends "/text" rel) (h-ends "/module" rel)) (weq (fromNat (list-length (h-before "/" rel))) #64)))))
