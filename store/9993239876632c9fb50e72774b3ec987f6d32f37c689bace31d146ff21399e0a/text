-- (part of language-support)
mul_spec_64 : (dst' : Bits #64) → (src : Bits #64) → ((Bits #64) × (Bits #64) × (Bits #128))
mul_spec_64 dst' src =
  let product : Bits #128
      product = (bits_of_int (z-mul (bv-unsigned #64 dst') (bv-unsigned #64 src)) (zpos #128))
      product_high : Bits #64
      product_high = (bv-slice #128 product #127 #64)
      product_low : Bits #64
      product_low = (bv-slice #128 product #63 #0)
  in (product_high , product_low , product)
