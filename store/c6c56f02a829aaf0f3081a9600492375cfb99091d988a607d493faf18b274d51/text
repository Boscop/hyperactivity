-- the pairs of x with each of ys
pair-terms : Nat → List FaradayLine → Placed → List Placed → QP × QP
pair-terms n ls x ys = case ys of
  nil → ((0 , 1) , (0 , 1))
  cons y rest → (if sp-charged (fst x)
    then (if sp-charged (fst y)
      then terms-add (sp-like (fst x) (fst y)) (eff-resistance n ls (snd x) (snd y)) (pair-terms n ls x rest)
      else pair-terms n ls x rest)
    else pair-terms n ls x rest)
