-- one electron's half of ∇f·∇g, for that electron's exponents (x, x′), the pair's k and k′, α, and the totals
-- (e1 on that electron, e2 on the other, e3 on r₁₂), the offsets written for the electron as the first coordinate;
-- sw exchanges the first two coordinates of every offset
he-grad : Nat → Nat → Bool → Nat → Nat → Nat → Nat → BQ → Nat → Nat → Nat → BQ
he-grad ap aq sw x x2 k k2 al ei ej ek = he-sumq
  (cons (he-o ap aq sw (bq-add (he-nat (times x x2)) (he-half (he-nat (plus (times x k2) (times x2 k))))) ei ej ek 0 2 0 0 0 0)
  (cons (he-o ap aq sw (he-neg (bq-mul al (bq-add (he-nat (plus x x2)) (he-half (he-nat (plus k k2)))))) ei ej ek 0 1 0 0 0 0)
  (cons (he-o ap aq sw (bq-mul al al) ei ej ek 0 0 0 0 0 0)
  (cons (he-o ap aq sw (bq-add (he-nat (times k k2)) (he-half (he-nat (plus (times x k2) (times x2 k))))) ei ej ek 0 0 0 0 0 2)
  (cons (he-o ap aq sw (he-neg (he-half (he-nat (plus (times x k2) (times x2 k))))) ei ej ek 0 2 2 0 0 2)
  (cons (he-o ap aq sw (he-neg (he-half (bq-mul al (he-nat (plus k k2))))) ei ej ek 1 0 0 0 0 2)
  (cons (he-o ap aq sw (he-half (bq-mul al (he-nat (plus k k2)))) ei ej ek 0 1 2 0 0 2) nil)))))))
