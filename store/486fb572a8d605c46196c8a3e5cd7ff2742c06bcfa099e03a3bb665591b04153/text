pull-lift : (n : Nat) (X : Type 1) (Y : X → Type 1) (X1 : Type 1) (Y1 : X1 → Type 1) (φ : (x : X) → Y x → X1) (ψ : (x : X) (y : Y x) → Y1 (φ x y))
  (X' : Type 1) (F1 : X1 → Type 1) (F' : X' → Type 1) (f : (x : X1) → Y1 x → X') (gp : (x : X1) (y : Y1 x) → F' (f x y) → F1 x)
  (l : (x : X) (y : Y x) → F' (f (φ x y) (ψ x y))) (c : Cube n X) (d : DCube n X Y c)
  (E : DCube n X' F' (dcube-map n X1 Y1 X' f (dcube-map n X Y X1 φ c d) (dcube-lift n X X1 Y Y1 φ ψ c d))) →
  PathP (λ i → DCube n X' F' (map-lift n X X1 Y Y1 φ ψ X' f c d i)) E (dcube-lift n X X' Y F' (λ x y → f (φ x y) (ψ x y)) l c d) →
  PathP (λ i → DCube n X1 F1 (dcube-map n X Y X1 φ c d)) (dcube-pull n X1 X' Y1 F1 F' f gp (dcube-map n X Y X1 φ c d) (dcube-lift n X X1 Y Y1 φ ψ c d) E)
    (dcube-lift n X X1 Y F1 φ (λ x y → gp (φ x y) (ψ x y) (l x y)) c d)
pull-lift zero X Y X1 Y1 φ ψ X' F1 F' f gp l c d E Pe = λ i → gp (φ c d) (ψ c d) (Pe i)
pull-lift (suc n) X Y X1 Y1 φ ψ X' F1 F' f gp l c d E Pe =
  pull-lift n (Line X) (LineO X Y) (Line X1) (LineO X1 Y1) (lineo-map X Y X1 φ) (lineo-lift X X1 Y Y1 φ ψ) (Line X') (LineO X1 F1) (LineO X' F')
    (lineo-map X1 Y1 X' f) (lineo-pull X1 X' Y1 F1 F' f gp) (lineo-lift X X' Y F' (λ x y → f (φ x y) (ψ x y)) l) c d E Pe
