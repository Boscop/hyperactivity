-- sizes, by the size of a code the reading passes (lib/match.cub's code-size, a helper of the
-- bootstrap files, has no type): the nodes of a program's codes, of the forms' codes
bc-prog-size : (Code → Word) → Lst (Word × Code) → Word
bc-prog-size sz lnil = #0
bc-prog-size sz (lcons e r) = wadd (sz (snd e)) (bc-prog-size sz r)
