ho-daemon-loop : Nat → Word → OperatorState → Word → Proc W Unit
ho-daemon-loop zero    _     _  _    = ret {lzero} {W} unit
ho-daemon-loop (suc k) epIdx st best =
  bind (ho-run-epoch epIdx st best) (λ res →
  bind (h-capture (cons "/bin/sleep" (cons "4" nil))) (λ slp →
  ho-daemon-loop k (%wadd epIdx #1) (fst res) (snd res)))
