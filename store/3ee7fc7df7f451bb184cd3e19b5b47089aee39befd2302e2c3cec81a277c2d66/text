nk-fire-rp-agree : (ev : NkEvJ → NkEv) (rho : NkW → NkEv) (t : NkTm) (h : Word) (cs : NkTm) (aux parts : NkEnv) (hd : NkHd) →
  ev (nkevj-tm t (nk-env-ev rho (nk-eapp (nk-erev parts nke-nil) aux)))
  ≡ nk-ev-fire ev (act-rp t) h cs (nk-env-ev rho aux) (nkev hd (nk-env-ev rho parts))
nk-fire-rp-agree ev rho t h cs aux parts hd =
  cong (λ z → ev (nkevj-tm t z))
    (nk-env-ev-app rho (nk-erev parts nke-nil) aux
     ∙ cong (λ z → nk-ev-app z (nk-env-ev rho aux)) (nk-env-ev-rev rho parts nke-nil))
