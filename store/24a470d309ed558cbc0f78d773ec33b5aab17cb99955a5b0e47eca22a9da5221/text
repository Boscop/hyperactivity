-- every published work's page and search item, made and kept one after another (the child at start)
s-site-all : List Word → List Work → Proc W Unit
s-site-all st nil = ret {lzero} {W} unit
s-site-all st (cons (work n k p) r) = bind (s-public st (inr (work n k p))) (λ x → bind (s-corpus-one st (list-append "/" n)) (λ y → s-site-all st r))
