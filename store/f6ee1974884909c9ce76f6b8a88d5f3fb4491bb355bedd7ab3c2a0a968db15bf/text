-- Exact Bijective Inverse Quarter-Round (reverses every ARX coupling step-by-step!):
chacha20-qr-inv : QR4 → QR4
chacha20-qr-inv (qr4 a2 b2 c2 d2) =
  let b1 = ho-u32-xor (ho-u32-rotr b2 #7) c2
      c1 = ho-u32-sub c2 d2
      d1 = ho-u32-xor (ho-u32-rotr d2 #8) a2
      a1 = ho-u32-sub a2 b1
      b0 = ho-u32-xor (ho-u32-rotr b1 #12) c1
      c0 = ho-u32-sub c1 d1
      d0 = ho-u32-xor (ho-u32-rotr d1 #16) a1
      a0 = ho-u32-sub a1 b0
  in qr4 a0 b0 c0 d0
