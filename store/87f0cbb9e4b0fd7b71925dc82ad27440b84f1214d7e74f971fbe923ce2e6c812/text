nk-con-ev-eq : (b51 b52 : Bool) (c : Word) (x51 x52 xas y51 y52 yas : NkEv) →
  (x51 ≡ y51) → (x52 ≡ y52) → (xas ≡ yas) →
  (if b51 then x51 else (if b52 then x52 else nkev (hd-con c) xas))
  ≡ (if b51 then y51 else (if b52 then y52 else nkev (hd-con c) yas))
nk-con-ev-eq true b52 c x51 x52 xas y51 y52 yas e51 e52 eas = e51
nk-con-ev-eq false true c x51 x52 xas y51 y52 yas e51 e52 eas = e52
nk-con-ev-eq false false c x51 x52 xas y51 y52 yas e51 e52 eas = cong (nkev (hd-con c)) eas
