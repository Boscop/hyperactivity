-- the suffix array by prefix doubling is the suffix array: both sorted, the same entries
sa-counts : (t : List (List Word)) → (f : List (List Word) → Word) → (a : El PO) →
            count {PO} a (msort-list {PO} (list-map (phi f) (entries t #0))) ≡ count {PO} a (list-map (phi f) (suffix-array t))
sa-counts t f a =
  concat (msort-fuel-count {PO} a (list-length (list-map (phi f) (entries t #0))) (list-map (phi f) (entries t #0)))
         (counts-phi f a (entries t #0) (suffix-array t) (λ x → sym (suffix-array-permutation t x)))
