DgOps : (I : Lst Entry → Type 2) (Ln : (sq : Lst Entry) → I sq → I sq) (K : (sq : Lst Entry) → I sq → Type 1)
  (pd : (sq : Lst Entry) → I (lcons e-dim sq) → I sq) (pt : (s : TyShape) (sq : Lst Entry) → I (lcons (e-ty s) sq) → I sq) → Type 2
DgOps I Ln K pd pt =
  (nil0 : (iq : I lnil) → K lnil (Ln lnil iq) → K lnil iq) ×
  (ty0 : (s : TyShape) (sq : Lst Entry) (iq : I (lcons (e-ty s) sq)) → K (lcons (e-ty s) sq) (Ln (lcons (e-ty s) sq) iq) → K (lcons (e-ty s) sq) iq) ×
  (tyd : (s : TyShape) (sq : Lst Entry) (iq : I (lcons (e-ty s) sq)) → K (lcons (e-ty s) sq) (Ln (lcons (e-ty s) sq) iq) → K sq (Ln sq (pt s sq iq))) ×
  (tyu : (s : TyShape) (sq : Lst Entry) (iq : I (lcons (e-ty s) sq)) → K sq (pt s sq iq) → K (lcons (e-ty s) sq) iq) ×
  (dm0 : (sq : Lst Entry) (iq : I (lcons e-dim sq)) → K (lcons e-dim sq) (Ln (lcons e-dim sq) iq) → K (lcons e-dim sq) iq) ×
  (dmd : (sq : Lst Entry) (iq : I (lcons e-dim sq)) → K (lcons e-dim sq) (Ln (lcons e-dim sq) iq) → K sq (Ln sq (pd sq iq))) ×
  ((sq : Lst Entry) (iq : I (lcons e-dim sq)) → K sq (pd sq iq) → K (lcons e-dim sq) iq)
