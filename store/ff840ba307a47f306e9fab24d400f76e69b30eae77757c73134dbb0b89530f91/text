hd-cong : {A B : Type} → (f : A → B) → {x y : A} → x ≡ y → f x ≡ f y
hd-cong f p = λ i → f (p i)

hd-trans : {A : Type} → {x y z : A} → x ≡ y → y ≡ z → x ≡ z
hd-trans {A} {x} p q = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

hd-sym : {A : Type} → {x y : A} → x ≡ y → y ≡ x
hd-sym {A} {x} p = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ p j , i = 1 ↦ x ]) x

hd-add : Nat → Nat → Nat
hd-add zero    n = n
hd-add (suc m) n = suc (hd-add m n)

hd-mul : Nat → Nat → Nat
hd-mul zero    _ = zero
hd-mul (suc m) n = hd-add n (hd-mul m n)

hd-le : Nat → Nat → Bool
hd-le zero    _       = true
hd-le (suc _) zero    = false
hd-le (suc m) (suc n) = hd-le m n

hd-min : Nat → Nat → Nat
hd-min zero    _       = zero
hd-min (suc _) zero    = zero
hd-min (suc m) (suc n) = suc (hd-min m n)

hd-add-zero-r : (a : Nat) → hd-add a zero ≡ a
hd-add-zero-r zero    = refl
hd-add-zero-r (suc a) = hd-cong suc (hd-add-zero-r a)

hd-add-suc-r : (a b : Nat) → hd-add a (suc b) ≡ suc (hd-add a b)
hd-add-suc-r zero    b = refl
hd-add-suc-r (suc a) b = hd-cong suc (hd-add-suc-r a b)

hd-add-assoc : (a b c : Nat) → hd-add (hd-add a b) c ≡ hd-add a (hd-add b c)
hd-add-assoc zero    b c = refl
hd-add-assoc (suc a) b c = hd-cong suc (hd-add-assoc a b c)

hd-add-comm : (a b : Nat) → hd-add a b ≡ hd-add b a
hd-add-comm zero    b = hd-sym (hd-add-zero-r b)
hd-add-comm (suc a) b = hd-trans (hd-cong suc (hd-add-comm a b)) (hd-sym (hd-add-suc-r b a))

hd-mul-zero-r : (a : Nat) → hd-mul a zero ≡ zero
hd-mul-zero-r zero    = refl
hd-mul-zero-r (suc a) = hd-mul-zero-r a

hd-mul-suc-r : (a b : Nat) → hd-mul a (suc b) ≡ hd-add a (hd-mul a b)
hd-mul-suc-r zero    b = refl
hd-mul-suc-r (suc a) b =
  let ih = hd-mul-suc-r a b
      p1 = hd-cong (λ x → suc (hd-add b x)) ih
      p2 = hd-cong suc (hd-sym (hd-add-assoc b a (hd-mul a b)))
      p3 = hd-cong (λ x → suc (hd-add x (hd-mul a b))) (hd-add-comm b a)
      p4 = hd-cong suc (hd-add-assoc a b (hd-mul a b))
  in hd-trans p1 (hd-trans p2 (hd-trans p3 p4))

hd-mul-comm : (a b : Nat) → hd-mul a b ≡ hd-mul b a
hd-mul-comm zero    b = hd-sym (hd-mul-zero-r b)
hd-mul-comm (suc a) b = hd-trans (hd-cong (hd-add b) (hd-mul-comm a b)) (hd-sym (hd-mul-suc-r b a))

hd-mul-dist-l : (a b c : Nat) → hd-mul (hd-add a b) c ≡ hd-add (hd-mul a c) (hd-mul b c)
hd-mul-dist-l zero    b c = refl
hd-mul-dist-l (suc a) b c = hd-trans (hd-cong (hd-add c) (hd-mul-dist-l a b c)) (hd-sym (hd-add-assoc c (hd-mul a c) (hd-mul b c)))

hd-mul-dist-r : (a b c : Nat) → hd-mul a (hd-add b c) ≡ hd-add (hd-mul a b) (hd-mul a c)
hd-mul-dist-r a b c =
  hd-trans (hd-mul-comm a (hd-add b c))
  (hd-trans (hd-mul-dist-l b c a)
  (hd-trans (hd-cong (λ x → hd-add x (hd-mul c a)) (hd-mul-comm b a))
            (hd-cong (hd-add (hd-mul a b)) (hd-mul-comm c a))))

