k-tail-le : (t s1 p2 : List (List Word)) → k-Pred t s1 p2 → (x a : List Word) → isTrue (leq {token-ord} x a) → isTrue (leq {token-ord} a x) →
            (p0 : List (List Word)) → MemOrNil t p0 → isTrue (not (leq {suffix-ord} (cons x s1) (cons a p0))) → isTrue (leq {suffix-ord} p0 p2)
k-tail-le t s1 p2 pr2 x a lxa lax p0 =
  case p0 return λ v → MemOrNil t v → isTrue (not (leq {suffix-ord} (cons x s1) (cons a v))) → isTrue (leq {suffix-ord} v p2) of
    nil → λ mo n → unit
    cons c p1 →
      λ mo n →
        k-pred-ge t s1 p2 pr2 (cons c p1) mo
          (bool-cases {isTrue (not (k-sle s1 (cons c p1)))} (k-sle s1 (cons c p1))
             (λ hs → Empty-rec (true-not {k-sle (cons x s1) (cons a (cons c p1))}
                      (step-eq {k-tle x a} {k-tle a x} {k-sle s1 (cons c p1)} lxa lax hs) n))
             (λ ns → ns))
