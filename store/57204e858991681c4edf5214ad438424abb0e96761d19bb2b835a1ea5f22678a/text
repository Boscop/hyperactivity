-- an operation meeting a blocked term becomes a blocked term: the value that blocked it is set on a
-- new wire, and the result, made from that wire, goes to out
nk-stuck : NkVal → (Word → NkVal) → Word → Word → NkOut
nk-stuck v mk out n = nk-out (nkf-val n v (nkf-val out (mk n) nkf-nil)) (%wsucc n)
