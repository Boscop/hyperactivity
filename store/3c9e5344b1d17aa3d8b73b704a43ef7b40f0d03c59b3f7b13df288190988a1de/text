hy-fold-safe-list : List Word → List Word → List (List Word) → Proc W (List (List Word))
hy-fold-safe-list st m args = bind (hy-files-read st) (λ fs → bind (hy-hw-all (hy-scoped args fs)) (λ ps →
  bind (hy-unimported-list m) (λ us → bind hy-every-files (λ all → bind (h-read "Makefile") (λ mk →
  bind (hy-nm-all all (h-inter (h-msort (hy-hw-paths ps ps)) us)) (λ named →
  ret (h-minus (h-inter (h-msort (hy-hw-paths ps ps)) us)
        (h-msort (list-append (hy-nm-hits "Makefile" (hy-or nil mk) (h-inter (h-msort (hy-hw-paths ps ps)) us)) named)))))))))
