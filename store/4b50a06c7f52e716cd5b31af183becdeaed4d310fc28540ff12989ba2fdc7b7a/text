sram-package-transport : {B R A : Type} → (P : (X : Type) → X → Type) →
  (flip : R → B → B) → ((r : R) (b : B) → flip r (flip r b) ≡ b) →
  Package P (B × R → A) → Package P (B × R → A)
sram-package-transport {B} {R} {A} P flip inv =
  package-transport P (dom-equiv {B × R} {B × R} {A} (SwizzleEquiv flip inv))
