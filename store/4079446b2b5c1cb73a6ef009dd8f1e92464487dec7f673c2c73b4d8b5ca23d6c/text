sv-net-lines : (k n idx : Nat) → (SumFin n → List Word) → Net B0 Empty Unit Unit n k → List Word
sv-net-lines zero n idx env f =
  sv-concat
    (cons "  assign y = "
    (cons (fold sv-nand-alg env (f unit))
    (cons ";" (cons sv-nl nil))))
sv-net-lines (suc j) n idx env lk =
  let wn  = sv-wire-name idx
      rhs = fold sv-nand-alg env (fst lk)
      line = sv-concat
               (cons "  wire "
               (cons wn
               (cons ";"
               (cons sv-nl
               (cons "  assign "
               (cons wn
               (cons " = "
               (cons rhs
               (cons ";" (cons sv-nl nil))))))))))
  in list-append line (sv-net-lines j (suc n) (suc idx) (ext-env wn env) (snd lk))
