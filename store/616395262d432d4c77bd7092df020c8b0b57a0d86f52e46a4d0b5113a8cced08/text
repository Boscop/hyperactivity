it-allz-all : (A V : Type) → (z : A) → (isz : A → Bool) → ((x : A) → isz x ≡ true → x ≡ z) → (f : V → V → A) → (u : V) → (ur : List V) → it-allz A V isz f u ur ≡ true → sy-all V (λ x → f x u ≡ z) ur
it-allz-all A V z isz izz f u ur = case ur return λ w → it-allz A V isz f u w ≡ true → sy-all V (λ x → f x u ≡ z) w of
  nil → λ h → unit
  cons x xr → λ h → (izz (f x u) (fst (it-and-t (isz (f x u)) (it-allz A V isz f u xr) h)) , it-allz-all A V z isz izz f u xr (snd (it-and-t (isz (f x u)) (it-allz A V isz f u xr) h)))
