nk-sexp-let : (Lst (List Word) → NkSexp → Code) → Lst (List Word) → Lst NkSexp → Code
nk-sexp-let go env (lcons nm (lcons t (lcons body lnil))) = clet (go env t) (go (lcons (nk-bname (toNat #8) nm) env) body)
nk-sexp-let go env (lcons t (lcons body lnil)) = clet (go env t) (go (lcons nil env) body)
nk-sexp-let _ _ _ = cclock
