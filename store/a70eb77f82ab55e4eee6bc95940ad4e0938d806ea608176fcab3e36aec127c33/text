sg-head-app : Code → NkSexp → Lst Code → Code
sg-head-app hc (nks-sym s) ac =
  case s return (λ _ → Code) of
    nil → nk-capp-all hc ac
    cons c r →
      if andB (%weq c #68) (%weq (nk-wlist-len r) #64) then cdata (nk-key60 r) ac
      else if %weq c #67 then
        (let dp = nk-split-dot r in
         if %weq (nk-wlist-len (fst dp)) #64
           then ccon (nk-key60 (fst dp)) (nk-dec-val #0 (snd dp)) ac lnil
           else nk-capp-all hc ac)
      else nk-capp-all hc ac
sg-head-app hc (nks-lst _) ac = nk-capp-all hc ac
