-- Convert Q16 signed 32-bit displacement to 16-bit signed PCM sample (clamped)
q16-to-pcm16 : Word → Word
q16-to-pcm16 x =
  let u = w32 x
      neg = %wlt #2147483647 u
      mag = if neg then s32-neg u else u
      cl  = if %wlt #32700 mag then #32700 else mag
  in if neg then %wand (%wsub #65536 cl) #65535 else cl
