bac-node : {o : Ord} → (b : List (El o) → RTree (El o)) →
           ((l : List (El o)) → Sorted l → (k : El o) → cnt-tree k (b l) ≡ fromNat (count-lt k l)) →
           (k : El o) → (l a : List (El o)) → (x : El o) → (r : List (El o)) → Sorted l → list-append a (cons x r) ≡ l →
           cnt-tree k (rnode (b a) (fromNat (list-length a)) x (b r)) ≡ fromNat (count-lt k l)
bac-node b ih k l a x r s ea =
  let s2 = subst {_} {_} {List (El o)} {λ w → Sorted {o} w} (sym ea) s
      sa = sorted-app-l {o} a (cons x r) s2
      sr = sorted-app-r {o} a (cons x r) s2
  in tr (fromNat (plus (count-lt k a) (plus (one-if (not (leq k x))) (count-lt k r))))
       (ifP {λ bb → (if bb then cnt-tree k (b a) else wadd (%wsucc (fromNat (list-length a))) (cnt-tree k (b r)))
                    ≡ fromNat (plus (count-lt k a) (plus (one-if (not bb)) (count-lt k r)))} {leq k x}
          (bac-true b ih k x a r sa (fst sr))
          (bac-false b ih k x a r s2))
       (λ i → fromNat (count-lt-split k l a x r ea i))
