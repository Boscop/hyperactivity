nk-sexp-lams : (Lst (List Word) → NkSexp → Code) → Lst (List Word) → (Code → Code) → List Word → Lst NkSexp → Code
nk-sexp-lams go env wrap tg (lcons b (lcons body lnil)) = wrap (go (lcons (nk-bname (toNat #8) b) env) body)
nk-sexp-lams go env wrap tg (lcons b rest) = wrap (go (lcons (nk-bname (toNat #8) b) env) (nks-lst (lcons (nks-sym tg) rest)))
nk-sexp-lams _ _ _ _ _ = cclock
