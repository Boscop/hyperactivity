ltn-tri : (m n : Nat) → ltn m n ≡ false → ltn n m ≡ false → m ≡ n
ltn-tri m =
  case m return λ y → (n : Nat) → ltn y n ≡ false → ltn n y ≡ false → y ≡ n of
    zero →
      λ n →
        case n return λ z → ltn zero z ≡ false → ltn z zero ≡ false → zero ≡ z of
          zero → λ e f i → zero
          suc k → λ e f → Empty-rec (true≢false e)
    suc m1 →
      λ n →
        case n return λ z → ltn (suc m1) z ≡ false → ltn z (suc m1) ≡ false → suc m1 ≡ z of
          zero → λ e f → Empty-rec (true≢false f)
          suc n1 → λ e f → congN suc (rec m1 n1 e f)
