sg-split-nul : List Word → List Word → List (List Word) → List (List Word)
sg-split-nul nil cur acc =
  case cur return (λ _ → List (List Word)) of
    nil → sg-rev-ls acc nil
    cons _ _ → sg-rev-ls (cons (sg-rev-w cur nil) acc) nil
sg-split-nul (cons c r) cur acc =
  if %weq c #0 then
    (case cur return (λ _ → List (List Word)) of
       nil → sg-split-nul r nil acc
       cons _ _ → sg-split-nul r nil (cons (sg-rev-w cur nil) acc))
  else sg-split-nul r (cons c cur) acc
