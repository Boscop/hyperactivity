-- the diagonal after a skipped entry: the type case unfolds, the dimension case is diag-nat at degeneracy
diag-skip : (e : Entry) (sk' : Lst Entry) (k : Word) (X : Type 1) (c : Cube (suc (dims sk')) X) →
  PathP (λ i → Cube (dims (lcons e sk')) X) (diag-sk (lcons e sk') (%wsucc k) X (skip-cube e sk' (Line X) c)) (skip-cube e sk' X (diag-sk sk' k X c))
diag-skip (e-ty s) sk' k X c = diag-ty-s sk' s k X c
diag-skip e-dim sk' k X c =
  pcat (Cube (suc (dims sk')) X) (diag-sk (lcons e-dim sk') (%wsucc k) X (cube-map (dims sk') (Line X) (Line (Line X)) (degen-l (Line X)) c)) (diag-sk sk' k (Line X) (cube-map (dims sk') (Line (Line X)) (Line (Line X)) (exch-l X) (cube-map (dims sk') (Line X) (Line (Line X)) (degen-l (Line X)) c)))
    (cube-map (dims sk') X (Line X) (degen-l X) (diag-sk sk' k X c))
    (diag-dim-s sk' k X (cube-map (dims sk') (Line X) (Line (Line X)) (degen-l (Line X)) c))
    (pcat (Cube (suc (dims sk')) X)
       (diag-sk sk' k (Line X) (cube-map (dims sk') (Line (Line X)) (Line (Line X)) (exch-l X) (cube-map (dims sk') (Line X) (Line (Line X)) (degen-l (Line X)) c)))
       (diag-sk sk' k (Line X) (cube-map (dims sk') (Line X) (Line (Line X)) (line-map X (Line X) (degen-l X)) c))
       (cube-map (dims sk') X (Line X) (degen-l X) (diag-sk sk' k X c))
       (λ i → diag-sk sk' k (Line X) (cube-comp (dims sk') (Line X) (Line (Line X)) (Line (Line X)) (exch-l X) (degen-l (Line X)) c i))
       (diag-nat sk' k X (Line X) (degen-l X) c))
