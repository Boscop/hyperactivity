-- (a + b) + (c + (d + e)) = (a + (d + c)) + (b + e)
shuffle6 : (a b c d e : Nat) → plus (plus a b) (plus c (plus d e)) ≡ plus (plus a (plus d c)) (plus b e)
shuffle6 a b c d e = transN (plus-assoc a b (plus c (plus d e))) (transN (congN (plus a) (shuffle5 b c d e)) (symN (plus-assoc a (plus d c) (plus b e))))
