s-answer-treatises : List Word → List Word → Proc W (List Word) → Proc W (List Word)
s-answer-treatises st p next =
  if h-eq p "/paper.pdf" then s-mod-kept st "bin" "docs/hyperactivity.pdf.hex" s-paper-pdf else
  if h-eq p "/pdf" then s-mod-kept st "doc" "docs/pdf-viewer.html" s-pdf-view else
  if h-eq p "/monograph" then s-mod-kept st "doc" "docs/pdf-viewer.html" s-pdf-view else
  if h-eq p "/kg" then s-mod-kept st "doc" "docs/kg.html" s-kg else
  if h-eq p "/nets" then s-mod-kept st "doc" "docs/nets.html" s-nets else
  if h-eq p "/neuro" then s-mod-kept st "doc" "docs/neuro.html" s-neuro else
  if h-eq p "/physics" then s-mod-kept st "doc" "docs/physics.html" s-physics else
  if h-eq p "/ai" then s-mod-kept st "doc" "docs/ai.html" s-ai else
  if h-eq p "/silicon" then s-mod-kept st "doc" "docs/silicon.html" s-silicon else
  if h-eq p "/hyperfactor" then s-mod-kept st "doc" "docs/hyperfactor.html" s-hyperfactor else
  if h-eq p "/learn" then s-mod-kept st "doc" "docs/learn.html" s-learn else
  next
