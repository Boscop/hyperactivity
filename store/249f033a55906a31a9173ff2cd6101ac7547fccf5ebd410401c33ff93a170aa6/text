-- ⟨((a c) f, ½) J | ((a ½) e, c) J⟩ = (−1)^(½+c+e+f) √((2e+1)(2f+1)) {a ½ e; J c f}, the coefficient that moves
-- a spin ½ from being coupled last to being coupled to a first; {a ½ e; J c f} = {c J e; ½ a f} (exchange upper
-- and lower in columns 1 and 2, then put column 2 first). Doubled spins.
brecouple : List Bool → List Bool → List Bool → List Bool → List Bool → Amp
brecouple a e c f j = amp-mul (not (bin-bit1 (bin-add bin-one (bin-add c (bin-add e f)))) , (bin-mul (bin-add e bin-one) (bin-add f bin-one) , bin-one))
  (bsixj-half c j e a f)
