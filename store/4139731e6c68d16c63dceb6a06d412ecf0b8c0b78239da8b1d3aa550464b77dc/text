-- ---------------------------------------------------------------- the certificate at one p
-- a point m/S, known exactly
point-inp : (S : List Bool) → (b : BZ) → le (suc zero) (bin-to-nat S) → bcanon (snd b) ≡ true → inp S (the IV (b , b)) (zv b , bin-to-nat S)
point-inp S b hS cb = ((cb , cb) , ((zle-refl (zsc (zv b) (bin-to-nat S)) , zle-refl (zsc (zv b) (bin-to-nat S))) , hS))
