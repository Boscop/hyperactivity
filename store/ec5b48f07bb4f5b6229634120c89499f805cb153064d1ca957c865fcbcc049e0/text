-- and how many have more peaks reported than there are classes, which would mean a spectrum resolving a
-- distinction the molecule does not have
tally-peaks-above : List Compd → Nat
tally-peaks-above cs = case cs of
  nil → 0
  cons c r → (case leb (suc (compd-conf-count c)) (compd-peaks c) of true → suc (tally-peaks-above r); false → tally-peaks-above r)
