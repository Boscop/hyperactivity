nk-check-br-fields : (NkTm → Word → NkTm → NkTm → NkTm) → NkTm → NkTm → Word → Word → Word → NkTm → NkTm → NkTm → NkTm → NkTm → NkTm → Bool
nk-check-br-fields chk kdefs curCtx curN di j P recsOrig (nk-cons rf rr) curCtorTy revFvs br =
  if nk-is-lam br
    then let cnf = nk-norm-in-s kdefs curCtx curN curCtorTy
         in if nk-con-is cnf #1
              then let dom = nk-nth (nk-args cnf) #0
                       cod = nk-nth (nk-args cnf) #1
                       c2 = nk-ext-s kdefs curCtx curN dom
                       v = nk-free curN
                   in nk-check-br-fields chk kdefs c2 (%wsucc curN) di j P recsOrig rr (nk-ap1 cod v) (nk-cons v revFvs) (nk-subst (nk-lam-body br) #0 v)
              else false
    else false
nk-check-br-fields chk kdefs curCtx curN di j P recsOrig rrem curCtorTy revFvs br =
  let fvs = nk-rev revFvs nk-nil
  in nk-check-ihs chk kdefs curCtx curN di j P fvs fvs recsOrig br
