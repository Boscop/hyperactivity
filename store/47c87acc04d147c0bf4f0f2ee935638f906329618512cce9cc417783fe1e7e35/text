kv-rep-go-inv : (c : KvCli) → (lg ap : List KvWrite) → (pd : KvPend) → KvRepInv (KvRep { r-log = lg ; r-app = ap ; r-pend = pd }) →
                VOk {KvMsg} {KvSt} (λ s → KvRepInv (fst s)) (nview-map {KvMsg} {KvRep} {KvSt} (λ r → (r , c)) (kv-rep-go (KvRep { r-log = lg ; r-app = ap ; r-pend = pd }) pd))
kv-rep-go-inv c lg ap kp-none h = λ r → kv-rep-recv-inv (KvRep { r-log = lg ; r-app = ap ; r-pend = kp-none }) h r
kv-rep-go-inv c lg ap (kp-ack to w) h = (inl-cons-all {KvWrite} (λ x → InL {KvWrite} x lg) w ap (snd h) (fst h) , unit)
kv-rep-go-inv c lg ap (kp-val to rid v) h = (fst h , unit)
