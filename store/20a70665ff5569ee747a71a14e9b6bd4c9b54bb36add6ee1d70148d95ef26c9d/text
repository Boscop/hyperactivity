-- (part of language-support)
idiv_spec_32 : (dst' : Bits #64) → (src : Bits #32) → (Bool × (Bits #32) × (Bits #32))
idiv_spec_32 dst' src =
  let dst_int : Bits #64
      dst_int = dst'
      src_int : Bits #32
      src_int = src
      quotient_int : Bits #65
      quotient_int = (bits_of_int (z-tdiv (bv-signed #64 dst_int) (bv-signed #32 src_int)) (zpos #65))
      remainder_int : Bits #32
      remainder_int = (bits_of_int (z-tmod (bv-signed #64 dst_int) (bv-signed #32 src_int)) (zpos #32))
      overflow? : Bool
      overflow? = (b-or (z-lt (bv-signed #65 quotient_int) (zneg #2147483648)) (z-lt (zpos #2147483647) (bv-signed #65 quotient_int)))
      t'1 : (Bool × (Bits #32) × (Bits #32))
      t'1 =
        if overflow? then
          (true , #0 , #0)
        else
          (let quotient : Bits #32
               quotient = (bv-trunc #65 #32 quotient_int)
               remainder : Bits #32
               remainder = remainder_int
           in (overflow? , quotient , remainder))
  in t'1
