-- writing one wire leaves the reading of every other wire as it was: the two names are walked
-- together, and where they part the write is in the other branch
nk-get-set-other : (m : NkSlots) (w x : NkW) (s : NkSlot) → (nk-weq w x ≡ false) → nk-get (nk-set m w s) x ≡ nk-get m x
nk-get-set-other m w-end w-end s q = nk-no (sym q)
nk-get-set-other m (w-0 r) (w-0 y) s q = nk-get-set-other (nk-left m) r y s q
nk-get-set-other m (w-1 r) (w-1 y) s q = nk-get-set-other (nk-right m) r y s q
nk-get-set-other m w-end (w-0 y) s q = refl
nk-get-set-other m w-end (w-1 y) s q = refl
nk-get-set-other m (w-0 r) w-end s q = refl
nk-get-set-other m (w-0 r) (w-1 y) s q = refl
nk-get-set-other m (w-1 r) w-end s q = refl
nk-get-set-other m (w-1 r) (w-0 y) s q = refl
