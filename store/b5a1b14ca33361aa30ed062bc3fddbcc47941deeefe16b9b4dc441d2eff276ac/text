-- Exact 3-Center 4-Electron Amide O=C-N π-Resonance Secular Polynomial:
--   H_π(ω) = [[aO, b1, 0], [b1, aC, b2·c], [0, b2·c, aN]] where c = cos ω.
--   det(E I - H_π) = (E - aO)(E - aC)(E - aN) - b1²(E - aN) - b2² c² (E - aO).
-- Proves universally that the π-delocalization spectrum depends ONLY on c² = cos²ω,
-- peaking at ω = 0°, 180° (c² = 1, planar peptide bond) and collapsing at ω = 90° (c² = 0)!
-- Variables (0..6): E, aO, aC, aN, b1, b2, c.
chem-amide-pi-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-amide-pi-poly A ad mu q vs =
  (λ g sub sq →
    let E = g 0; aO = g 1; aC = g 2; aN = g 3; b1 = g 4; b2 = g 5; c = g 6
        eO = sub E aO; eC = sub E aC; eN = sub E aN
        b2c = mu b2 c
        -- Direct 3×3 determinant of [[eO, -b1, 0], [-b1, eC, -b2c], [0, -b2c, eN]]:
        det3 = sub (mu eO (sub (mu eC eN) (sq b2c))) (mu (sq b1) eN)
        rhs  = sub (sub (mu eO (mu eC eN)) (mu (sq b1) eN)) (mu (mu (sq b2) (sq c)) eO)
    in (det3 , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
