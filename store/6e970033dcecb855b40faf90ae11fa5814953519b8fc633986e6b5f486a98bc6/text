tm-same : ETm → ETm → Bool
tm-same s t =
  case s return (λ w → ETm → Bool) of
    etv v → λ t → (case t return (λ w → Bool) of etv w → weq v w; etc f → false; eapp a b → false)
    etc f → λ t → (case t return (λ w → Bool) of etv w → false; etc g → weq f g; eapp a b → false)
    eapp a b → λ t → (case t return (λ w → Bool) of etv w → false; etc g → false; eapp c d → andbt (rec a c) (rec b d))
  t
