-- after a record: on, or the writer told that another writer changed the same definition
hy-on-record : List (List Word) → Proc W Unit → Proc W Unit
hy-on-record nil k = k
hy-on-record (cons c cs) k = h-fail (list-append "nothing written: another writer changed the same definition while this change was being made (" (list-append c "); make the change again from what the source holds now"))
