clause-conflict-unsat : (w : Nat) → (c : ClauseVec w) → (rho : Vec Bool w) →
  clause-ok w c ≡ false → clause-sat w c rho ≡ false
clause-conflict-unsat zero c rho = λ h → Empty-rec (bool-discr h)
clause-conflict-unsat (suc w) c rho = λ h →
  let p = fst (fst c); n = fst (snd c); r0 = fst rho
      tail : ClauseVec w
      tail = (snd (fst c) , snd (snd c))
  in conflict-branch w p n r0 tail (snd rho) (lit-ok p n) refl h (clause-conflict-unsat w tail (snd rho))
