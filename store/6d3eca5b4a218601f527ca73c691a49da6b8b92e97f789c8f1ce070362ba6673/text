lg-sq-add : (x y : Word) → wsq (plusw x y) ≡ plusw (plusw (wsq x) (wsq y)) (plusw (mulw x y) (mulw x y))
lg-sq-add x y =
  catw (mulw-dist x y (plusw x y))
    (catw (congw (λ z → plusw z (mulw y (plusw x y))) (lg-mulw-dist-l x x y))
      (catw (congw (λ z → plusw (plusw (wsq x) (mulw x y)) z) (lg-mulw-dist-l y x y))
        (catw (congw (λ z → plusw (plusw (wsq x) (mulw x y)) (plusw z (wsq y))) (lg-mulw-comm y x))
          (catw (congw (λ z → plusw (plusw (wsq x) (mulw x y)) z) (plusw-comm (mulw x y) (wsq y)))
            (lg-interchange (wsq x) (mulw x y) (wsq y) (mulw x y))))))
