-- a value. An integer of at most 64 bits is sv-i of its value extended to 64 bits (by its sign
-- when the kind is signed, by zeros otherwise): the canonical form every operation keeps. A
-- 128-bit integer is its two halves.
data SV = sv-i (v : UInt64) | sv-w (lo : UInt64) (hi : UInt64) | sv-b (b : Bool)
        | sv-f (x : Float32) | sv-d (x : Float64) | sv-p (p : MPtr)
