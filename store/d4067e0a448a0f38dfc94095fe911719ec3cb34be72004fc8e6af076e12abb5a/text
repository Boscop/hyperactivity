-- the commutation lemma at the identity substitution
pfold-nat : (I : Type 2) (Ln : I → I) (K K' : I → Type 1) (M : I → I → Type 2) (LnM : (iq iq' : I) → M iq iq' → M (Ln iq) (Ln iq'))
  (h : (iq iq' : I) → M iq iq' → K iq → K' iq') (A : PAlg I Ln K) (A' : PAlg I Ln K') →
  (s0 : (iq iq' : I) (mq : M iq iq') (x : K (Ln iq)) → PathP (λ t → K' iq') (fst A' iq' (h (Ln iq) (Ln iq') (LnM iq iq' mq) x)) (h iq iq' mq (fst A iq x))) →
  (s1 : (iq iq' : I) (mq : M iq iq') (x : K (Ln iq)) → PathP (λ t → K' iq') (fst (snd A') iq' (h (Ln iq) (Ln iq') (LnM iq iq' mq) x)) (h iq iq' mq (fst (snd A) iq x))) →
  (sr : (iq iq' : I) (mq : M iq iq') (x : K (Ln iq)) → PathP (λ t → K' (Ln iq')) (fst (snd (snd A')) iq' (h (Ln iq) (Ln iq') (LnM iq iq' mq) x)) (h (Ln iq) (Ln iq') (LnM iq iq' mq) (fst (snd (snd A)) iq x))) →
  (sm : (iq iq' : I) (mq : M iq iq') (x : K (Ln iq)) → PathP (λ t → K' (Ln (Ln iq'))) (fst (snd (snd (snd A'))) iq' (h (Ln iq) (Ln iq') (LnM iq iq' mq) x)) (h (Ln (Ln iq)) (Ln (Ln iq')) (LnM (Ln iq) (Ln iq') (LnM iq iq' mq)) (fst (snd (snd (snd A))) iq x))) →
  (sj : (iq iq' : I) (mq : M iq iq') (x : K (Ln iq)) → PathP (λ t → K' (Ln (Ln iq'))) (fst (snd (snd (snd (snd A')))) iq' (h (Ln iq) (Ln iq') (LnM iq iq' mq) x)) (h (Ln (Ln iq)) (Ln (Ln iq')) (LnM (Ln iq) (Ln iq') (LnM iq iq' mq)) (fst (snd (snd (snd (snd A)))) iq x))) →
  (sd : (kq : Word) (iq iq' : I) (mq : M iq iq') (x : K (Ln iq)) → PathP (λ t → K' iq') (snd (snd (snd (snd (snd A')))) kq iq' (h (Ln iq) (Ln iq') (LnM iq iq' mq) x)) (h iq iq' mq (snd (snd (snd (snd (snd A)))) kq iq x))) →
  (r : IEx) (i i' : I) (m : M i i') (x : K (Ln i)) →
  PathP (λ t → K' i') (pfold I Ln K' A' r i' (h (Ln i) (Ln i') (LnM i i' m) x)) (h i i' m (pfold I Ln K A r i x))
pfold-nat I Ln K K' M LnM h A A' s0 s1 sr sm sj sd r i i' m x =
  pcat (K' i') (pfold I Ln K' A' r i' (h (Ln i) (Ln i') (LnM i i' m) x)) (pfold I Ln K' A' (isub (λ k → ixv k) r) i' (h (Ln i) (Ln i') (LnM i i' m) x)) (h i i' m (pfold I Ln K A r i x))
    (λ t → pfold I Ln K' A' (isub-id r (~ t)) i' (h (Ln i) (Ln i') (LnM i i' m) x))
    (pfold-sub I Ln K K' M LnM h A A' (λ k → ixv k) s0 s1 sr sm sj sd r i i' m x)
