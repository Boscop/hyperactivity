swap4 : (a b c d : Nat) → plus (plus a b) (plus c d) ≡ plus (plus a c) (plus b d)
swap4 a b c d =
  transN (plus-assoc a b (plus c d))
  (transN (congN (plus a) (transN (sym (plus-assoc b c d)) (transN (congN (λ u → plus u d) (plus-comm b c)) (plus-assoc c b d))))
    (sym (plus-assoc a c (plus b d))))
