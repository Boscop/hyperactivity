-- the least element of a list under a given rank, with a default for the empty list: the canonical
-- representative of an orbit, chosen inside the orbit so that the choice is invariant
min-by : (A : Type 0) → (A → Nat) → List A → A → A
min-by A rk xs d = case xs of
  nil → d
  cons y r → (case leb (rk y) (rk (min-by A rk r d)) of true → y; false → min-by A rk r d)
