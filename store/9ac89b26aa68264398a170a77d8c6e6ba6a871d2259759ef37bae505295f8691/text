ac : (sk : Lst Entry) → PAlg (Type 1) Line (Cube (dims sk))
ac sk =
  (λ X c → cube-map (dims sk) (Line X) X (λ L → fst L) c ,
   λ X c → cube-map (dims sk) (Line X) X (λ L → fst (snd L)) c ,
   λ X c → cube-map (dims sk) (Line X) (Line X) (rev-l X) c ,
   λ X c → cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c ,
   λ X c → cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c ,
   λ k X c → diag-sk sk k X c)
