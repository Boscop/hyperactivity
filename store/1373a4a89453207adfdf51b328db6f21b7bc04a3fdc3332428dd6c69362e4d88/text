-- a constructor's fields and dimensions along its telescope
check-con c tel fs ds =
  case tel of
    tx A nm r → 
      case fs of
        lnil → err c E-ctor opq opq
        lcons f fr → let Av = tval A in and-then (check f Av) (check-con c (r (tval f) Av) fr ds)
    ty nm r → 
      case fs of
        lcons f fr → err c E-ctor opq opq
        lnil → 
          case ds of
            lnil → err c E-ctor opq opq
            lcons e er → 
              if check-iv e then check-con c (r (tval e)) lnil er else err e E-notiv opq opq
    tz b → chk (andb (isnil fs) (isnil ds)) (err c E-ctor opq opq)
