-- the semantic substitution lemma: ⟦t[θ]⟧ρ = ⟦t⟧(⟦θ⟧ρ)
dx-subst-eval : (th : Nat → LetCore) → (t : LetCore) → (rho : Nat → Nat) → dx-eval (dx-subst th t) rho ≡ dx-eval t (λ i → dx-eval (th i) rho)
dx-subst-eval th (dx-var i) rho = λ k → dx-eval (th i) rho
dx-subst-eval th (dx-num n) rho = λ k → n
dx-subst-eval th (dx-plus u v) rho = λ k → plus (dx-subst-eval th u rho k) (dx-subst-eval th v rho k)
