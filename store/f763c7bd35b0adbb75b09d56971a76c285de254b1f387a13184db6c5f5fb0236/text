fold-leb-plus-mono : (a b c d : Nat) → leb a b ≡ true → leb c d ≡ true → leb (plus a c) (plus b d) ≡ true
fold-leb-plus-mono zero b c d p q = fold-leb-plus-l c d b q
fold-leb-plus-mono (suc a) zero c d p q = Empty-rec (fold-false-ne-true p)
fold-leb-plus-mono (suc a) (suc b) c d p q = fold-leb-plus-mono a b c d p q
