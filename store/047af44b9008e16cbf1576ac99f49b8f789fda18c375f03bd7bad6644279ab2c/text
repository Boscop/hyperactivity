ha-lem-mk-xor : (env : Word → Bool) → (a b : WExpr) → web-xorB (weval env a) (weval env b) ≡ weval env (ha-mk-xor a b)
ha-lem-mk-xor env (we-k false) b = web-lem-xor-0l (weval env b)
ha-lem-mk-xor env (we-k true)  _ = refl
ha-lem-mk-xor env (we-v _)     _ = refl
ha-lem-mk-xor env (we-not _)   _ = refl
ha-lem-mk-xor env (we-xor _ _) _ = refl
ha-lem-mk-xor env (we-and _ _) _ = refl
ha-lem-mk-xor env (we-or  _ _) _ = refl
ha-lem-mk-xor env (we-ch _ _ _) _ = refl
ha-lem-mk-xor env (we-maj _ _ _) _ = refl
