v-mk-wtab : List (List Word) → List (List Word) → List (List Word × List (List Word)) → List (List Word × List (List Word)) → List (List Word × List (List Word)) → List (List Word × List (List Word))
v-mk-wtab done-set leaves aft anc und =
  list-map (λ x → (x , h-dedupe (v-step-all (v-leaves-at done-set leaves und) (v-step-all (λ m → v-collect-list m aft) (v-look-list x anc))))) leaves
