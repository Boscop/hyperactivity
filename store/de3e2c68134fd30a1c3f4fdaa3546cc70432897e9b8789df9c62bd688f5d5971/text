urxi : (n : Nat) (X X' : Type 1) (F' : X' → Type 1) (φ : X → X') (c : Cube n X) (d : DCube n X (λ x → F' (φ x)) c) →
  PathP (λ i → DCube n X (λ x → F' (φ x)) c) (dcube-unreidx n X X' F' φ c (dcube-reidx n X X' (λ x → F' (φ x)) F' φ (λ x q → q) c d)) d
urxi zero X X' F' φ c d = λ i → d
urxi (suc n) X X' F' φ c d = urxi n (Line X) (Line X') (LineO X' F') (line-map X X' φ) c d
