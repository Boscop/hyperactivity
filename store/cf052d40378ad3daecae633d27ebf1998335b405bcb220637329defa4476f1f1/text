xp-sp-t : (g : List XpTy) → (a b : XpExpr) → (A : XpTy) →
  ((T : XpTy) → xp-infer g a ≡ inl T → XpDer (g , a , T)) → ((T : XpTy) → xp-infer g b ≡ inl T → XpDer (g , b , T)) →
  (t : XpTy) → (y : Sum XpTy Unit) → xp-infer g a ≡ inl t → xp-infer g b ≡ y → xp-plus-ty (inl t) y ≡ inl A → XpDer (g , xp-plus a b , A)
xp-sp-t g a b A sa sb xt-nat y ea eb h = xp-sp-y g a b A (sa xt-nat ea) sb y eb h
xp-sp-t g a b A sa sb (xt-prod c d) y ea eb h = Empty-rec (xp-inr-inl A h)
