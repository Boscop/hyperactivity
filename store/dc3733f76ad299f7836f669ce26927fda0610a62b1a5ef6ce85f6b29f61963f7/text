-- Head-to-Head 32-Bit 2-Stage RAW-Forwarding Pipelined RISC-V Core Executing Identical 3 Workloads
sv-rv32-bench-part1 : List Word
sv-rv32-bench-part1 =
  sv-lines
    (cons "// 32-Bit 2-Stage RAW-Forwarding Pipelined RISC-V Benchmark Core (identical PDK comparison)"
    (cons "module riscv32_pipe ("
    (cons "  input  logic        clk, rst, start,"
    (cons "  input  logic [1:0]  prog_sel,"
    (cons "  output logic        halted,"
    (cons "  output logic [31:0] result_out,"
    (cons "  output logic [15:0] cycle_count, inst_retired"
    (cons ");"
    (cons "  // Instruction encoding: [31:28] op (0=NOP,1=ADDI,2=ADD,3=MUL,4=OR,5=AND,6=BNEZ,7=HALT),"
    (cons "  // [27:24] rd, [23:20] rs1, [19:16] rs2, [15:0] imm/target"
    (cons "  logic [7:0]  pc;"
    (cons "  logic        ex_valid, running;"
    (cons "  logic [31:0] ex_inst;"
    (cons "  logic [31:0] rf [0:15];"
    (cons "  logic [31:0] fetch_inst;"
    (cons "  always_comb begin"
    (cons "    case (pc)"
    (cons "      // Prog 0 (PC 0..10): sequential 8-leaf loop sum i=1..8 -> x3 = 36"
    (cons "      8'd0:  fetch_inst = {4'd1, 4'd1, 4'd0, 4'd0, 16'd1};  // x1 = 1"
    (cons "      8'd1:  fetch_inst = {4'd1, 4'd2, 4'd0, 4'd0, 16'd8};  // x2 = 8 (count)"
    (cons "      8'd2:  fetch_inst = {4'd1, 4'd3, 4'd0, 4'd0, 16'd0};  // x3 = 0 (acc)"
    (cons "      8'd3:  fetch_inst = {4'd2, 4'd3, 4'd3, 4'd1, 16'd0};  // loop: x3 = x3 + x1"
    (cons "      8'd4:  fetch_inst = {4'd1, 4'd1, 4'd1, 4'd0, 16'd1};  // x1 = x1 + 1"
    (cons "      8'd5:  fetch_inst = {4'd1, 4'd2, 4'd2, 4'd0, 16'hFFFF}; // x2 = x2 - 1"
    (cons "      8'd6:  fetch_inst = {4'd6, 4'd0, 4'd2, 4'd0, 16'd3};  // bnez x2 -> PC 3"
    (cons "      8'd7:  fetch_inst = {4'd7, 4'd0, 4'd3, 4'd0, 16'd0};  // halt(x3)"
    (cons "      // Prog 1 (PC 16..20): x1=3+3=6; x2=x1+x1=12; x3=x2*x2=144"
    (cons "      8'd16: fetch_inst = {4'd1, 4'd1, 4'd0, 4'd0, 16'd3};"
    (cons "      8'd17: fetch_inst = {4'd2, 4'd1, 4'd1, 4'd1, 16'd0};"
    (cons "      8'd18: fetch_inst = {4'd2, 4'd2, 4'd1, 4'd1, 16'd0};"
    (cons "      8'd19: fetch_inst = {4'd3, 4'd3, 4'd2, 4'd2, 16'd0};"
    (cons "      8'd20: fetch_inst = {4'd7, 4'd0, 4'd3, 4'd0, 16'd0};"
    (cons "      // Prog 2 (PC 32..46): software face-conflict check + live 8-leaf loop"
    (cons "      8'd32: fetch_inst = {4'd1, 4'd4, 4'd0, 4'd0, 16'd1};  // pa = 1"
    (cons "      8'd33: fetch_inst = {4'd1, 4'd5, 4'd0, 4'd0, 16'd1};  // nb = 1"
    (cons "      8'd34: fetch_inst = {4'd5, 4'd6, 4'd4, 4'd5, 16'd0};  // conf = pa & nb"
    (cons "      8'd35: fetch_inst = {4'd6, 4'd0, 4'd6, 4'd0, 16'd0};  // bnez conf -> skip dead tree to PC 0!"
    (cons "      default: fetch_inst = 32'd0;"
    (cons "    endcase"
    (cons "  end" nil))))))))))))))))))))))))))))))))))))))))
