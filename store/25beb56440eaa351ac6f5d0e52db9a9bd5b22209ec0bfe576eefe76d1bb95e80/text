-- the same for the radial chain: every r_n > 0, so g_n = r_n g_{n−1} > 0 and F = Σ g_n x^n has no sign change
rad-ground : (S S2 : List Bool) → (st : IE) → (p sg c : IV) → (pq sq cq : ZQ) → (N : Nat) → bcanon S ≡ true → le (suc zero) (bin-to-nat S) → bin-to-nat S2 ≡ times (bin-to-nat S) (bin-to-nat S) →
  inp S p pq → inp S sg sq → inp S c cq →
  tail-ok S S2 (env5 (iv-unit S) p sg c (mu-iv S (suc N))) st ≡ true → tail-pos S S2 (env5 (iv-unit S) p sg c (mu-iv S (suc N))) st ≡ true →
  snd (irun S S2 (rad-env S p sg c) st N (iv-unit S , true)) ≡ true → run-pos S S2 (rad-env S p sg c) st N (iv-unit S , true) ≡ true →
  (k : Nat) → (tv rv : ZQ) → uni S tv → le (suc zero) (snd tv) → (ch : echain (rad-envq pq sq cq) st (plus k N) tv rv) → posalong (rad-envq pq sq cq) st S (plus k N) tv rv ch
rad-ground S S2 st p sg c pq sq cq N cS hS hS2 hp hsg hc hok hpos hf hr =
  deep-pos S S2 (rad-env S p sg c) (rad-envq pq sq cq) st N cS hS hS2 (rad-env-ok S p sg c pq sq cq hp hsg hc)
    (rad-inv S S2 st p sg c pq sq cq N cS hS hS2 hp hsg hc hok) (rad-pinv S S2 st p sg c pq sq cq N cS hS hS2 hp hsg hc hok hpos) hf hr
