lv-trace-loop : Nat → Pt2 → Pt2 → List Seg → List Pt2 → (List Pt2 × List Seg)
lv-trace-loop zero start cur pool acc = (lg-rev acc , pool)
lv-trace-loop (suc rem) start cur pool acc =
  if lv-pt-eq cur start then (lg-rev acc , pool)
  else case lv-pop-next cur pool nil of
         sf-none → (lg-rev acc , pool)
         sf-hit nxt rest → lv-trace-loop rem start nxt rest (cons nxt acc)
