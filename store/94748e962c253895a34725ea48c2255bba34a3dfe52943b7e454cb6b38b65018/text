-- ============================================================================
-- SECTION 2: COMPACT LINE-SAFE (<96 CHAR) CODEGEN COMBINATORS
--   Note: ` maps to " (#96 -> #34) and ~ maps to \ (#126 -> #92).
--   Never use C bitwise complement; always use `^ 0xffffffffffffffffULL`.
-- ============================================================================

hxp-nl : List Word
hxp-nl = cons #10 nil

hxp-tr : List Word → List Word
hxp-tr nil         = nil
hxp-tr (cons c cs) =
  let m = if %weq c #96 then #34 else (if %weq c #126 then #92 else c)
  in cons m (hxp-tr cs)

hxp-ln : List Word → List Word
hxp-ln s = list-append (hxp-tr s) hxp-nl

hxp-cat : List (List Word) → List Word
hxp-cat nil           = nil
hxp-cat (cons xs xss) = list-append xs (hxp-cat xss)

hxp-b8 :
  List Word → List Word → List Word → List Word →
  List Word → List Word → List Word → List Word → List Word
hxp-b8 a1 a2 a3 a4 a5 a6 a7 a8 =
  hxp-cat (cons (hxp-ln a1) (cons (hxp-ln a2) (cons (hxp-ln a3) (cons (hxp-ln a4)
  (cons (hxp-ln a5) (cons (hxp-ln a6) (cons (hxp-ln a7) (cons (hxp-ln a8) nil))))))))

