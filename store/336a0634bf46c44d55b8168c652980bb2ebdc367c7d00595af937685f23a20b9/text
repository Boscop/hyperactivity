ce-opname : Word → List Word
ce-opname j =
  if %weq j #2 then "hy_add"
  else if %weq j #5 then "hy_mul"
  else if %weq j #4 then "hy_sub"
  else if %weq j #0 then "hy_eq"
  else if %weq j #1 then "hy_lt"
  else if %weq j #6 then "hy_div"
  else if %weq j #3 then "hy_max"
  else if %weq j #7 then "hy_mod"
  else if %weq j #8 then "hy_and"
  else if %weq j #9 then "hy_or"
  else if %weq j #10 then "hy_xor"
  else if %weq j #11 then "hy_shl"
  else if %weq j #12 then "hy_shr"
  else "hy_bad2"
