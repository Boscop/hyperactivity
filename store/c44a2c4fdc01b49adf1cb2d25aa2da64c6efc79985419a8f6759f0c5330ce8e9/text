-- UNIVERSAL 3-STAGE FUTAMURA-ON-FUTAMURA-ON-FUTAMURA + 2-CELL ASSOCIATIVITY COHERENCE!
fut-thm-fut3-sound : (s1 s2 s3 : Word → Opt Bool) → (d : Word → Bool) → (e : FExpr) →
  feval d (f-mix s3 (f-mix s2 (f-mix s1 e))) ≡ feval (f-merge s1 (f-merge s2 (f-merge s3 d))) e
fut-thm-fut3-sound s1 s2 s3 d e =
  web-trans-b
    (fut-thm-mix-sound s3 d (f-mix s2 (f-mix s1 e)))
    (fut-thm-fut2-sound s1 s2 (f-merge s3 d) e)
