-- a rank on the atoms, used to tell them apart and to choose representatives
val-rank : Val → Nat
val-rank x = case x of
  v-c1 → 0
  v-o1 → 1
  v-o2 → 2
  v-ho → 3
  v-ca → 4
  v-ha → 5
  v-n → 6
  v-hn1 → 7
  v-hn2 → 8
  v-cb → 9
  v-hb → 10
  v-cg1 → 11
  v-g11 → 12
  v-g12 → 13
  v-g13 → 14
  v-cg2 → 15
  v-g21 → 16
  v-g22 → 17
  v-g23 → 18
