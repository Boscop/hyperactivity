of-iter : {A : Type} → (A → A) → Nat → A → A
of-iter _ zero x = x
of-iter f (suc n) x = of-iter f n (f x)

of-cong : {A B : Type} → (f : A → B) → {x y : A} → x ≡ y → f x ≡ f y
of-cong f p = λ i → f (p i)

of-trans : {A : Type} → {x y z : A} → x ≡ y → y ≡ z → x ≡ z
of-trans {A} {x} {y} {z} p q =
  λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

-- THEOREM 1 (UNIVERSAL CUT-INVARIANT PRESERVATION):
-- Any invariant I preserved by 1 step of a heterogeneous machine is preserved for ALL n : Nat ticks!
of-thm-cut-inv-all :
  {S : Type} → (step : S → S) → (I : S → Type) →
  ((s : S) → I s → I (step s)) →
  (n : Nat) → (s : S) → I s → I (of-iter step n s)
of-thm-cut-inv-all _ _ _ zero _ hs = hs
of-thm-cut-inv-all step I hstep (suc n) s hs =
  of-thm-cut-inv-all step I hstep n (step s) (hstep s hs)

-- Helper lemma: projection commutes with n-step iteration for ALL n : Nat!
of-iter-comm :
  {S R : Type} → (pi : S → R) → (stepS : S → S) → (stepR : R → R) →
  ((s : S) → pi (stepS s) ≡ stepR (pi s)) →
  (n : Nat) → (s : S) → pi (of-iter stepS n s) ≡ of-iter stepR n (pi s)
of-iter-comm _ _ _ _ zero _ = refl
of-iter-comm pi stepS stepR hcomm (suc n) s =
  of-trans (of-iter-comm pi stepS stepR hcomm n (stepS s))
           (of-cong (of-iter stepR n) (hcomm s))

-- THEOREM 2 (UNIVERSAL READOUT-EXACT REDUNDANCY ERASURE):
-- If abstraction/erasure pi : S -> R commutes with dynamics (pi o stepS == stepR o pi)
-- and factors the readout (obsS == obsR o pi), then erasing ALL hidden/redundant degrees
-- of freedom produces BIT-IDENTICAL readouts for ALL n : Nat (infinite coinductive horizon)!
of-thm-erasure-bisim :
  {S R O : Type} → (pi : S → R) → (stepS : S → S) → (stepR : R → R) →
  (obsS : S → O) → (obsR : R → O) →
  ((s : S) → pi (stepS s) ≡ stepR (pi s)) →
  ((s : S) → obsS s ≡ obsR (pi s)) →
  (n : Nat) → (s : S) → obsS (of-iter stepS n s) ≡ obsR (of-iter stepR n (pi s))
of-thm-erasure-bisim pi stepS stepR obsS obsR hcomm hobs n s =
  of-trans (hobs (of-iter stepS n s))
           (of-cong obsR (of-iter-comm pi stepS stepR hcomm n s))

