of-step-full : HeteroFull → HeteroFull
of-step-full s =
  let r2 = of-step-red (of-erase s)
  in HeteroFull
       { hf-pa = hr-pa r2 ; hf-pb = hr-pb r2
       ; hf-v1 = hr-v1 r2 ; hf-v2 = hr-v2 r2
       ; hf-c1 = hr-c1 r2 ; hf-c2 = hr-c2 r2
       ; hf-hphase = %wxor (%wadd (hf-hphase s) #17) (hf-pa s)
       ; hf-hion   = %wadd (hf-hion s) (hf-v1 s)
       ; hf-hsolv  = %wxor (hf-hsolv s) #255
