-- Exact Readout-Irrelevant Erasure Projection pi : HeteroFull -> HeteroRed (-33.3% state width!)
of-erase : HeteroFull → HeteroRed
of-erase s = HeteroRed
  { hr-pa = hf-pa s ; hr-pb = hf-pb s
  ; hr-v1 = hf-v1 s ; hr-v2 = hf-v2 s
  ; hr-c1 = hf-c1 s ; hr-c2 = hf-c2 s
  }

-- Exact lossless 1-unit exchange across a cut (guaranteed to conserve a + b identically!)
-- Direction `dir` = 1 moves 1 quantum a -> b (if a > 0); dir = 0 moves 1 quantum b -> a (if b > 0)
of-cut-a : Word → Word → Word → Word
of-cut-a dir a b =
  if %weq dir #1 then (if %wlt #0 a then %wsub a #1 else a)
  else (if %wlt #0 b then %wadd a #1 else a)

of-cut-b : Word → Word → Word → Word
of-cut-b dir a b =
  if %weq dir #1 then (if %wlt #0 a then %wadd b #1 else b)
  else (if %wlt #0 b then %wsub b #1 else b)

