--   * Photonic rail parity drives Bioelectric ion-channel direction (pA & 1)
--   * Bioelectric potential parity drives Chemical phosphorylation direction (v1 & 1)
of-step-red : HeteroRed → HeteroRed
of-step-red r =
  let d-phot = %wand (hr-c1 r) #1
      d-bio  = %wand (hr-pa r) #1
      d-chem = %wand (hr-v1 r) #1
  in HeteroRed
       { hr-pa = of-cut-a d-phot (hr-pa r) (hr-pb r)
       ; hr-pb = of-cut-b d-phot (hr-pa r) (hr-pb r)
       ; hr-v1 = of-cut-a d-bio  (hr-v1 r) (hr-v2 r)
       ; hr-v2 = of-cut-b d-bio  (hr-v1 r) (hr-v2 r)
       ; hr-c1 = of-cut-a d-chem (hr-c1 r) (hr-c2 r)
       ; hr-c2 = of-cut-b d-chem (hr-c1 r) (hr-c2 r)
