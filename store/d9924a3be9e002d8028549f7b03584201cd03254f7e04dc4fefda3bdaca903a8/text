kc-round-loop : Nat → Word → List UInt64 → List UInt64
kc-round-loop zero    lfsr st = st
kc-round-loop (suc n) lfsr st =
  let rc    = kc-rc-bits (toNat #7) #0 lfsr (u64 #0)
      lfsr2 = kc-lfsr-step (toNat #7) lfsr
      st1   = kc-theta st
      st2   = kc-rhopi st1
      st3   = kc-chi-loop (toNat #25) #0 st2
      st4   = kc-set64 #0 (u64xor (kc-nth64 #0 st3) rc) st3
  in kc-round-loop n lfsr2 st4
