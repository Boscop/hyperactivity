-- the names among a text's tokens (each token's core, when the token is made of name characters)
hi-cores : List (List Word) → List (List Word)
hi-cores nil = nil
hi-cores (cons nil r) = hi-cores r
hi-cores (cons (cons c cs) r) = if orB (h-not (hi-ident-char c)) (h-null (hi-core (cons c cs))) then hi-cores r else cons (hi-core (cons c cs)) (hi-cores r)
