nk-build-con-wf : (g : Bool) (ins outs : NkEnv) (n0 : NkW) (c : Word) (as : NkTm) (e : NkEnv) (out : NkW) (o : NkOut) →
  (nk-out-ok ins outs n0 (nk-n o) (nk-build-gref (nk-bnum as) e out o) ≡ true) →
  (nk-out-ok ins outs n0 (nk-n o) (nk-con-at c out (nk-build as e out o)) ≡ true) →
  nk-out-ok ins outs n0 (nk-n o) (if g then nk-build-gref (nk-bnum as) e out o else nk-con-at c out (nk-build as e out o)) ≡ true
nk-build-con-wf true ins outs n0 c as e out o hg hc = hg
nk-build-con-wf false ins outs n0 c as e out o hg hc = hc
