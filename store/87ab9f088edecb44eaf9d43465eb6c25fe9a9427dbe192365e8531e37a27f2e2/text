kv-rep-recv-inv : (st : KvRep) → KvRepInv st → (r : Rcv KvMsg) → KvRepInv (kv-rep-recv st r)
kv-rep-recv-inv st h r-timeout = h
kv-rep-recv-inv st h (r-msg from (m-put w)) = ((λ x m → inr (fst h x m)) , inl (λ i → w))
kv-rep-recv-inv st h (r-msg from (m-ack w)) = h
kv-rep-recv-inv st h (r-msg from (m-get k rid)) = (fst h , unit)
kv-rep-recv-inv st h (r-msg from (m-val rid v)) = h
