rn-app : (Δ' Δ : CCtx) (w : World Δ' Δ) (a b : TyShape) (R : Mean Δ (AppV a b)) →
  RenR k-ne j-tm Δ' (s-pi a b) (wact Δ' Δ w (TV (s-pi a b)) (fmapM Δ (AppV a b) (TV (s-pi a b)) (app-f a b) R)) →
  RenR k-nf j-tm Δ' a (wact Δ' Δ w (TV a) (fmapM Δ (AppV a b) (TV a) (app-a a b) R)) →
  RenR k-ne j-tm Δ' b (wact Δ' Δ w (TV b) (fmapM Δ (AppV a b) (TV b) (app-r a b) R))
rn-app Δ' Δ w a b R Fn An =
  (capp (fst Fn) (fst An) ,
   d-fm-out t-ne j-tm Δ' Δ w (AppV a b) b (app-r a b) R (capp (fst Fn) (fst An))
     (napp Δ' a b (wact Δ' Δ w (AppV a b) R) (fst Fn) (fst An)
        (d-fm-in t-ne j-tm Δ' Δ w (AppV a b) (s-pi a b) (app-f a b) R (fst Fn) (snd Fn)) (d-fm-in t-nf j-tm Δ' Δ w (AppV a b) a (app-a a b) R (fst An) (snd An))))
