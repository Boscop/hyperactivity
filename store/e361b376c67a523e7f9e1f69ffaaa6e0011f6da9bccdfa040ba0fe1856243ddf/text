-- ============================================================================
-- 2. Data-Processing Fiber Monotonicity (Direct Optical vs. Symbolic Channel)
-- ============================================================================
-- Any state s in the direct optical fiber (o_direct s ≡ y) lies in the symbolic fiber
-- (g (o_direct s) ≡ g y): fewer abstraction layers strictly refine the observation fiber.
ec-direct-refines-symbolic :
  {S Y Z : Type 0} → (o-direct : S → Y) → (g : Y → Z) →
  (s : S) → (y : Y) →
  o-direct s ≡ y → g (o-direct s) ≡ g y
ec-direct-refines-symbolic o-direct g s y p = λ i → g (p i)
