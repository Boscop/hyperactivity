tech-map-1-sound : {V : Type} → (env : V → Bool) → (u : B1) → (ta : NandCirc V) → (va : Bool) →
  fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env ta ≡ va →
  fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env (tech-map-1 u ta) ≡ fst (snd bool-alg) u va
tech-map-1-sound {V} env b1-not ta va ha =
  catB
    (nand2 (fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env ta) (fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env ta))
    (nand2 va va)
    (not va)
    (λ i → nand2 (ha i) (ha i))
    (nand-inv-law va)
tech-map-1-sound {V} env b1-buf ta va ha = ha
