le-prop : (m n : Nat) → isProp (le m n)
le-prop m n u v =
  let p = plus-cancel {m} {fst u} {fst v} (concat (plus-comm m (fst u)) (concat (snd u) (concat (sym (snd v)) (plus-comm (fst v) m))))
  in λ i → (p i , isProp→PathP {lzero} {plus (fst u) m ≡ n} {plus (fst v) m ≡ n} (λ j → plus (p j) m ≡ n) (isSetNat (plus (fst v) m) n) (snd u) (snd v) i)
