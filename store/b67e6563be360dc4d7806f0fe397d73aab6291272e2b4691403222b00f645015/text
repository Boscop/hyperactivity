-- the same machine as a guarded process
mach-gproc : {M X : Type} → (X → NView M X) → X → GProc κ (NetSig M) X
mach-gproc {κ} {M} {X} v x = case v x of
  v-halt → gret x
  v-send to m s → gcmd (n-send to m) (λ u → mach-gproc v s)
  v-recv k → gcmd n-recv (λ r → mach-gproc v (k r))
  v-now kn → gcmd n-now (λ w → mach-gproc v (kn w))
  v-tau s → gtau (mach-gproc v s)
