-- the sequential client's phase: done; in a put (n < 3: about to send to replica n; n ≥ 3:
-- waiting for replica 0's acknowledgement); about to send a get to replica 0; waiting for its
-- value
data KvPhase = ph-done | ph-put (w : KvWrite) (n : Nat) | ph-get-send (k : Word) | ph-get-wait (k : Word)
