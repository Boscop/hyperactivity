q-emit-qasm3 : Word → List QGate → List Word
q-emit-qasm3 nq gs =
  list-append
    (sv-concat
      (cons "OPENQASM 3.0;"
      (cons sv-nl
      (cons "include "
      (cons (cons #34 (list-append "stdgates.inc" (cons #34 nil)))
      (cons ";" (cons sv-nl nil)))))))
    (list-append
      (sv-concat (cons "qubit[" (cons (q-digit nq) (cons "] q;" (cons sv-nl nil)))))
      (q-emit-body gs))
