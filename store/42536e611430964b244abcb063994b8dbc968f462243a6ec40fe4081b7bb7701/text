taylor-mul-path : (x h : Nat) (a b : Pl) (qa qb : Nat) →
                  pat (plus x h) a ≡ TF h (pat x a) (pat x (D a)) qa →
                  pat (plus x h) b ≡ TF h (pat x b) (pat x (D b)) qb →
                  times (pat (plus x h) a) (pat (plus x h) b) ≡
                  TF h (times (pat x a) (pat x b)) (plus (times (pat x (D a)) (pat x b)) (times (pat x a) (pat x (D b))))
                       (Qmul (pat x a) (pat x (D a)) qa (pat x b) (pat x (D b)) qb h)
taylor-mul-path x h a b qa qb pa pb =
  transN (cong2N (λ u v → times u v) pa pb) (tmul-id (pat x a) (pat x (D a)) qa (pat x b) (pat x (D b)) qb h)
