-- Exact ISCAS-85 `c17` standard benchmark (6 NAND2 gates, 5 inputs N1,N2,N3,N6,N7 -> 2 outputs N22,N23):
--   N10 = nand(N1, N3)
--   N11 = nand(N3, N6)
--   N16 = nand(N2, N11)
--   N19 = nand(N11, N7)
--   N22 = nand(N10, N16)
--   N23 = nand(N16, N19)
c17-n22-spec : Bool → Bool → Bool → Bool → Bool → Bool
c17-n22-spec n1 n2 n3 n6 n7 =
  let n10 = nand2 n1 n3
      n11 = nand2 n3 n6
      n16 = nand2 n2 n11
  in nand2 n10 n16
