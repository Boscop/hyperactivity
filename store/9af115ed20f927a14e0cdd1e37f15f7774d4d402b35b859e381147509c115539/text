chk-codata d ent =
  case ent of
    dcoent tel l → 
      let lv = codata-level d tel
      in and-then (chk (lvl-closed (lvl-of lv)) (refused lv E-openlevel opq opq))
           (and-then (check-ptys tel) (let pc = params-fresh tel lnil in check-cofields d (snd pc)))
    _ → refused opq E-notcodata opq opq
