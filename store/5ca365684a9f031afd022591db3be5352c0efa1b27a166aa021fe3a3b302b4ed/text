-- the source binds the name, or holds a module or document at the path
hi-bound : List Word → Proc W Bool
hi-bound t = bind (h-read (list-append h-source (list-append "/written/" (h-hex t)))) (λ w →
  bind (h-read (list-append h-source (list-append "/modules/" (h-hex t)))) (λ m → ret (orB (hi-some w) (hi-some m))))
