cliff-S-sec-raw : (s : Bool) → (p : Pauli1) → cliff-S (cliff-Sdg (s , p)) ≡ (s , p)
cliff-S-sec-raw false p-I = λ _ → (false , p-I)
cliff-S-sec-raw false p-X = λ _ → (false , p-X)
cliff-S-sec-raw false p-Y = λ _ → (false , p-Y)
cliff-S-sec-raw false p-Z = λ _ → (false , p-Z)
cliff-S-sec-raw true  p-I = λ _ → (true  , p-I)
cliff-S-sec-raw true  p-X = λ _ → (true  , p-X)
cliff-S-sec-raw true  p-Y = λ _ → (true  , p-Y)
cliff-S-sec-raw true  p-Z = λ _ → (true  , p-Z)
