chem-hb-12-10-sos-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-hb-12-10-sos-poly A ad mu q vs =
  (λ g sub sq →
    let x = g 0
        q1 = q (fn-q 1 1); q2 = q (fn-q 2 1); q3 = q (fn-q 3 1)
        q4 = q (fn-q 4 1); q5 = q (fn-q 5 1); q6 = q (fn-q 6 1)
        x2 = sq x; x3 = mu x2 x; x4 = sq x2; x5 = mu x4 x; x6 = mu x5 x
        lhs = ad (sub (mu q5 x6) (mu q6 x5)) q1
        dx = sub x q1
        poly4 = ad (ad (ad (ad (mu q5 x4) (mu q4 x3)) (mu q3 x2)) (mu q2 x)) q1
        rhs = mu (sq dx) poly4
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
