cs-print-gcall-eq : (cf : Code → CsExp) (pr : Code → List Word → List Word) →
  ((x : Code) (tl : List Word) → cs-print (cf x) tl ≡ pr x tl) →
  (g ar n : Word) (as : Lst Code) (acc : List Word) →
  cs-print (cs-comp-gcall cf g ar n as) acc ≡ ce-gcall pr g ar n as acc
cs-print-gcall-eq cf pr h g ar n as acc =
  cs-print-gcall-at (%wlt n ar) cf pr h g ar n as acc
