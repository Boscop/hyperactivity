h-publish-text : List Word → List Word → List Word → List Word → List Word → Sum Unit (List Word) → Proc W Bool
h-publish-text st srv tok path was (inl u) = bind (h-post srv tok (list-append "/source/unrecord?path=" (list-append path (list-append "&was=" was))) nil) (h-publish-answer st path)
h-publish-text st srv tok path was (inr t) = bind (h-post srv tok (list-append "/source/record?path=" (list-append path (list-append "&was=" was))) t) (h-publish-answer st path)
