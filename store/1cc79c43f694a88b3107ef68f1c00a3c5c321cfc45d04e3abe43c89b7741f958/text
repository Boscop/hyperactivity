a64-gref : Enc → Tbl → XEnv → Word → Word → Lst Code → Lst Word
a64-gref ce tbl env d g args =
  let a = x-ar tbl g
      n = l-count args
  in if %weq n a then a64-call ce tbl env d g args
     else if %wlt n a then a64-clo ce tbl env d g a args
     else a64-applies ce tbl env d (a64-call ce tbl env d g (x-take a args)) (x-drop a args)
