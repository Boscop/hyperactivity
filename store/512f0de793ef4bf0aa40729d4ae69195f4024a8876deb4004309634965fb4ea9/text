-- Exact resulting cell count after firing a cut on a net with n cells:
--   ANN: n - 2 (both nodes annihilate, aux wires fuse directly!)
--   COM: n + 2 (optimal lazy duplication: 2 cells -> 4 cells)
--   ERA: n - 1 (target erased, 1-2 erasers propagate cleanly)
--   UNF: n + 3 (factor box Φ unfolds into 4-cell internal subgraph)
--   OP:  n - 1 (primitive ALU reduction collapses op+num -> num)
net-step-cells : Word → CutRule → Word
net-step-cells n cr-ann   = %wsub n #2
net-step-cells n cr-com   = %wadd n #2
net-step-cells n cr-era   = %wsub n #1
net-step-cells n cr-unf   = %wadd n #3
net-step-cells n cr-op    = %wsub n #1
net-step-cells n cr-inert = n
