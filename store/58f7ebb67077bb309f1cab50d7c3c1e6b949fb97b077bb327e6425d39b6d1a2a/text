-- comp A u a: A a line of types, u a line of systems (faces free of the line) or a total line,
-- a at 0 agreeing with u at 0; the result is at A 1
check-comp c A u a =
  case A of
    tguess k g t V → if %weq g #0 then redo k else check-comp c t u a
    -- the line left to find, no type expected: the constant line at the base's type
    thole k V → comp-hole-line c k a
    tspine t V → (case t of thole k V2 → comp-hole-line c k a; _ → check-comp1 c A u a)
    _ → case u of
          tguess k g t V → if %weq g #0 then redo k else check-comp c A t a
          _ → check-comp1 c A u a
