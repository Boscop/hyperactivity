-- the sign of a canonical form: 0 zero, 1 positive, 2 negative, 3 not decided within f doublings of the precision
form-sign-from : Nat → Nat → List Rad → Nat
form-sign-from f k rs = case f of
  zero → 3
  suc g → (if bq-pos (fst (form-bounds k rs)) then 1 else (if bq-neg-strict (snd (form-bounds k rs)) then 2 else form-sign-from g (times 2 k) rs))
