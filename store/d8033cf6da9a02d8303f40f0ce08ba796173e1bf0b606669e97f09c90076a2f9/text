tree-cnt : {o : Ord} → (f : Nat) → (l : List (El o)) → Sorted l → (k : El o) → cnt-tree k (build f l) ≡ fromNat (count-lt k l)
tree-cnt f =
  case f return λ w → (l : List (El o)) → Sorted l → (k : El o) → cnt-tree k (build w l) ≡ fromNat (count-lt k l) of
    zero → λ l → spine-cnt l
    suc g → λ l → build-at-cnt (build g) (rec g) (half (list-length l)) l
