xp-sound-plus : (g : List XpTy) → (a b : XpExpr) → (A : XpTy) →
  ((T : XpTy) → xp-infer g a ≡ inl T → XpDer (g , a , T)) → ((T : XpTy) → xp-infer g b ≡ inl T → XpDer (g , b , T)) →
  (x y : Sum XpTy Unit) → xp-infer g a ≡ x → xp-infer g b ≡ y → xp-plus-ty x y ≡ inl A → XpDer (g , xp-plus a b , A)
xp-sound-plus g a b A sa sb (inl t) y ea eb h = xp-sp-t g a b A sa sb t y ea eb h
xp-sound-plus g a b A sa sb (inr u) y ea eb h = Empty-rec (xp-inr-inl A h)
