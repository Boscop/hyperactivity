-- one step of the shard's walk: the suffix at i is in the shard or q does not begin it
step : (q : List (List Word)) (i : Nat) (s : List (List Word)) (b : Bool) → (isTrue (pre q s) → isTrue b) →
  (S : List Entry) (H : List Nat) → look q S ≡ H →
  look q (if b then cons (entry i s) S else S) ≡ (if pre q s then cons i H else H)
step q i s b =
  case b return λ y → (isTrue (pre q s) → isTrue y) → (S : List Entry) (H : List Nat) → look q S ≡ H →
      look q (if y then cons (entry i s) S else S) ≡ (if pre q s then cons i H else H) of
    true → λ h S H e j → if pre q s then cons i (e j) else e j
    false → λ h S H e → skip (pre q s) i H (look q S) h e
