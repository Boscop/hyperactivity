gl-m1 : Glyc → Glyc
gl-m1 x = case x of
  gl-c1 → gl-c1
  gl-o1 → gl-o1
  gl-ho1 → gl-ho1
  gl-h1a → gl-h1b
  gl-h1b → gl-h1a
  gl-c2 → gl-c2
  gl-o2 → gl-o2
  gl-ho2 → gl-ho2
  gl-h2 → gl-h2
  gl-c3 → gl-c3
  gl-o3 → gl-o3
  gl-ho3 → gl-ho3
  gl-h3a → gl-h3a
  gl-h3b → gl-h3b
