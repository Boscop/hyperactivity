-- an enclosure of X/q encloses every rational equal to it
encl-qeq : (S : List Bool) → (I : IV) → (X : Nat × Nat) → (q : Nat) → (X2 : Nat × Nat) → (q2 : Nat) → encl S I X q → zeq (zsc X2 q) (zsc X q2) → le (suc zero) q → encl S I X2 q2
encl-qeq S I X q X2 q2 e Qe hq =
  (zle-cancel-scale (zsc (zv (fst I)) q2) (zsc X2 (bin-to-nat S)) q
     (zle-path (zsc (zsc (zv (fst I)) q) q2) (zsc (zsc (zv (fst I)) q2) q) (zsc (zsc X2 q) (bin-to-nat S)) (zsc (zsc X2 (bin-to-nat S)) q)
        (zsc-swap (zv (fst I)) q q2) (zsc-swap X2 q (bin-to-nat S))
        (zle-zeq-r (zsc (zsc (zv (fst I)) q) q2) (zsc (zsc X q2) (bin-to-nat S)) (zsc (zsc X2 q) (bin-to-nat S))
           (zeq-zsc (zsc X q2) (zsc X2 q) (bin-to-nat S) (zeq-sym (zsc X2 q) (zsc X q2) Qe))
           (zle-path (zsc (zsc (zv (fst I)) q) q2) (zsc (zsc (zv (fst I)) q) q2) (zsc (zsc X (bin-to-nat S)) q2) (zsc (zsc X q2) (bin-to-nat S))
              (λ i → zsc (zsc (zv (fst I)) q) q2) (zsc-swap X (bin-to-nat S) q2)
              (zle-scale (zsc (zv (fst I)) q) (zsc X (bin-to-nat S)) q2 (fst e)))))
     hq ,
   zle-cancel-scale (zsc X2 (bin-to-nat S)) (zsc (zv (snd I)) q2) q
     (zle-path (zsc (zsc X2 q) (bin-to-nat S)) (zsc (zsc X2 (bin-to-nat S)) q) (zsc (zsc (zv (snd I)) q2) q) (zsc (zsc (zv (snd I)) q2) q)
        (zsc-swap X2 q (bin-to-nat S)) (λ i → zsc (zsc (zv (snd I)) q2) q)
        (zle-zeq-l (zsc (zsc X q2) (bin-to-nat S)) (zsc (zsc X2 q) (bin-to-nat S)) (zsc (zsc (zv (snd I)) q2) q)
           (zeq-sym (zsc (zsc X2 q) (bin-to-nat S)) (zsc (zsc X q2) (bin-to-nat S)) (zeq-zsc (zsc X2 q) (zsc X q2) (bin-to-nat S) Qe))
           (zle-path (zsc (zsc X (bin-to-nat S)) q2) (zsc (zsc X q2) (bin-to-nat S)) (zsc (zsc (zv (snd I)) q) q2) (zsc (zsc (zv (snd I)) q2) q)
              (zsc-swap X (bin-to-nat S) q2) (zsc-swap (zv (snd I)) q q2)
              (zle-scale (zsc X (bin-to-nat S)) (zsc (zv (snd I)) q) q2 (snd e)))))
     hq)
