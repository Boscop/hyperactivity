encode-boot-frame : CubBootOp → Word
encode-boot-frame (cbo-ho-beta a b) =
  %wor (%wshl #1 #28) (%wor (%wshl a #10) b)
encode-boot-frame (cbo-dup-let a b) =
  %wor (%wshl #2 #28) (%wor (%wshl a #10) b)
encode-boot-frame (cbo-face-if pa na v) =
  %wor (%wshl #3 #28) (%wor (%wshl pa #24) (%wor (%wshl na #20) (%wshl v #10)))
encode-boot-frame (cbo-flash-kv s v) =
  %wor (%wshl #4 #28) (%wor (%wshl s #10) v)
encode-boot-frame (cbo-moe-mac pa na x w) =
  %wor (%wshl #5 #28) (%wor (%wshl pa #24) (%wor (%wshl na #20) (%wor (%wshl x #10) w)))
