hcm-thm-pkt-pack :
  let pk = hcm-pack-pkt #165 #90 #64 #255 #7
  in (if %weq (%wand pk #255) #165 then
        if %weq (%wand (%wshr pk #8) #255) #90 then
          if %weq (%wand (%wshr pk #16) #255) #64 then
            if %weq (%wand (%wshr pk #24) #511) #255 then %weq (%wshr pk #36) #7 else false
          else false
        else false
      else false) ≡ true
hcm-thm-pkt-pack = refl
