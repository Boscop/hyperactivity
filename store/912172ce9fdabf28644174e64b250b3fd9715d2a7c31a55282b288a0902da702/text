cs-print-brs-eq : (nf_of : Word → Word → Word) (B : Lst Code) (cf : Word → Code → CsExp) (pr : Word → Code → List Word → List Word) →
  ((e : Word) (c : Code) (tl : List Word) → cs-print (cf e c) tl ≡ pr e c tl) →
  (dd d k : Word) (acc : List Word) →
  cs-print (cs-comp-brs-by nf_of B cf dd d k) acc ≡ cs-brs-by nf_of B pr dd d k acc
cs-print-brs-eq nf_of lnil cf pr h dd d k acc = refl
cs-print-brs-eq nf_of (lcons br r) cf pr h dd d k acc =
  let nf = nf_of dd k
      d2 = %wadd d nf
      b2 = x-strip nf br
  in cong (λ z → list-append "case " (list-append (ce-dec k) (list-append ": { " (list-append (ce-binds (toNat nf) d #0)
            (list-append "r" (list-append (ce-dec d) (list-append " = " z)))))))
       (h d2 b2 (list-append "; break; } " (cs-print (cs-comp-brs-by nf_of r cf dd d (%wsucc k)) acc))
        ∙ cong (λ z → pr d2 b2 (list-append "; break; } " z)) (cs-print-brs-eq nf_of r cf pr h dd d (%wsucc k) acc))
