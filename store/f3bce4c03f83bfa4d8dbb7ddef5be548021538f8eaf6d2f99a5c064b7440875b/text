-- at every dimension, M(L u, L v) = diag(a, C − bbᵀ/a)(u, v) is the scalar identity at a, u₀, v₀, b·u′, b·v′, C(u′, v′)
ln-elim-reduce : (a : BQ) → (b : List BQ) → (c : List BQ → List BQ → BQ) → (u v : List BQ) →
  fn-eq (ln-blk a b c (ln-ell a b u) (ln-ell a b v)) (ln-dg a b c u v) ≡ ln-el-at a (ln-hd u) (ln-hd v) (ln-dot b (ln-tl u)) (ln-dot b (ln-tl v)) (c (ln-tl u) (ln-tl v))
ln-elim-reduce a b c u v = λ i → ln-el-at a (ln-hd u) (ln-hd v) (ln-dot b (ln-tl u)) (ln-dot b (ln-tl v)) (c (ln-tl u) (ln-tl v))
