subst-form : (sk' sk : Lst Entry) → CMap sk' sk → Word → DNF
subst-form sk' lnil σ k = dnf-zero
subst-form sk' (lcons (e-ty a) sk) σ k = if weq k #0 then dnf-zero else subst-form sk' sk σ (%wsub k #1)
subst-form sk' (lcons e-dim sk) σ k = if weq k #0 then snd σ else subst-form sk' sk (fst σ) (%wsub k #1)
