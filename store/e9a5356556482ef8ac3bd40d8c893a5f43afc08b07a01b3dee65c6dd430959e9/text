nk-edisj-not-mem-at : (eq : Bool) (m2 : Bool) (w x : NkW) (r e2 : NkEnv) → (nk-weq w x ≡ eq) → (nk-emem x e2 ≡ m2) → ((if eq then true else nk-emem w r) ≡ true) → ((if m2 then false else nk-edisj r e2) ≡ true) → ((nk-edisj r e2 ≡ true) → (nk-emem w r ≡ true) → nk-emem w e2 ≡ false) → nk-emem w e2 ≡ false
nk-edisj-not-mem-at eq true w x r e2 pe pm hm hd ih = nk-no hd
nk-edisj-not-mem-at true false w x r e2 pe pm hm hd ih = cong (λ z → nk-emem z e2) (nk-weq-sound w x pe) ∙ pm
nk-edisj-not-mem-at false false w x r e2 pe pm hm hd ih = ih hd hm
