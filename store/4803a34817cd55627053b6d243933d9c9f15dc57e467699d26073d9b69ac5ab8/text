-- Arrival-Order Confluence: whether value or eliminator arrives first over GALS links, both form ws-pair o v!
wslot-order-indep : {Val Op : Type} → (v : Val) → (o : Op) →
  Path (WSlot Val Op)
    (wslot-ch {Val} {Op} (wc-op o) (wslot-ch {Val} {Op} (wc-val v) ws-none))
    (wslot-ch {Val} {Op} (wc-val v) (wslot-ch {Val} {Op} (wc-op o) ws-none))
wslot-order-indep v o = refl
