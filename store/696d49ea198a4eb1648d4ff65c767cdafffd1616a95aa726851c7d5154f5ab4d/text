nk-emem-erev : (w : NkW) (a acc : NkEnv) → (nk-emem w (nk-erev a acc) ≡ true) → (if nk-emem w a then true else nk-emem w acc) ≡ true
nk-emem-erev w nke-nil acc hm = hm
nk-emem-erev w (nke-cons x r) acc hm =
  nk-or-swap (nk-emem w r) (nk-weq w x) (nk-emem w acc) (nk-emem-erev w r (nke-cons x acc) hm)
