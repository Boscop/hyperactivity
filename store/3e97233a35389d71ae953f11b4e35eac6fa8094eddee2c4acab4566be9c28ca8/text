dm-thm-conj-inner :
  {S : Type} → (enc dec : S → S) → ((s : S) → dec (enc s) ≡ s) →
  (step : S → S) → (n : Nat) → (x : S) →
  dm-iter n (dm-conj-step enc dec step) (enc x) ≡ enc (dm-iter n step x)
dm-thm-conj-inner enc dec retS step zero    x = refl
dm-thm-conj-inner enc dec retS step (suc n) x =
  let ih = dm-thm-conj-inner enc dec retS step n x
      s1 = cong (dm-conj-step enc dec step) ih
      s2 = cong (λ z → enc (step z)) (retS (dm-iter n step x))
  in λ i → comp (λ j → S)
       (λ j → [ i = 0 ↦ s1 (~ j) , i = 1 ↦ s2 j ])
       (dm-conj-step enc dec step (enc (dm-iter n step x)))
