-- (part of language-support)
binary_logext : (size : ZI) → (i' : ZI) → MF ZI
binary_logext size i' =
  bindF {Unit} {ZI} (fl-assert {exception} (z-lt (zpos #0) size) #149467514486126185021078021591788696624) (λ _ →
    bindF {Bool} {ZI} (logbitp_int (z-sub size (zpos #1)) i') (λ t'2 →
      retF {ZI} (binary_logapp (z-sub size (zpos #1)) i' (if t'2 then (z-negate (zpos #1)) else (zpos #0)))))
