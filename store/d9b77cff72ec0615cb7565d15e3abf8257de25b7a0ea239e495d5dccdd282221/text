hxf-main : List (List Word) → Step W Word
hxf-main args =
  let seqs = hxf-arg1 args
      K    = hxf-arg2 args
  in scmd w-now (λ t0 →
     let res = sf-fold-auto (hxf-seq seqs)
         bb  = hxf-bb K
     in scmd w-now (λ t1 →
        cli-say (list-append "Fold " (list-append seqs (list-append (if fst res then " -> hairpin turn=" else " -> helix turn=") (list-append (ce-dec (fromNat (fst (snd res)))) (list-append " score=" (list-append (ce-dec (fromNat (fst (snd (snd res))))) (list-append " gap=" (list-append (ce-dec (fromNat (snd (snd (snd res))))) (list-append " | Pocket K^4=" (list-append (ce-dec (%wmul (%wmul K K) (%wmul K K))) (list-append " opt=" (list-append (ce-dec (fst bb)) (list-append " pruned=" (list-append (ce-dec (fst (snd bb))) (list-append " evaled=" (list-append (ce-dec (snd (snd bb))) (list-append " (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000000)) " ms)")))))))))))))))))) (sdone #0)))
