-- a member passing a test makes tso-any true
tso-any-intro : {A : Type} → (q : A → Bool) → (y : A) → (ns : List A) → TsoIn y ns → isTrue (q y) → isTrue (tso-any q ns)
tso-any-intro q y nil m h = Empty-rec m
tso-any-intro q y (cons z r) m h =
  (case m of
     inl e → (case q z return (λ b → isTrue b → isTrue (if b then true else tso-any q r)) of
                true → λ u → unit
                false → λ f → Empty-rec f) (subst {_} {_} {_} {λ w → isTrue (q w)} e h)
     inr m2 → (case q z return (λ b → isTrue (if b then true else tso-any q r)) of
                 true → unit
                 false → tso-any-intro q y r m2 h))
