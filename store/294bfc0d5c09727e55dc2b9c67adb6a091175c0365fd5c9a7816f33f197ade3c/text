dht-check-sound-bool : {K V : Type} → (chk : K → V → Bool) → (c : Bool) → (k : K) → (v0 v : V) →
  c ≡ chk k v0 → Path (Sum Unit V) (if c then inr v0 else inl unit) (inr v) → chk k v ≡ true
dht-check-sound-bool {K} {V} chk true k v0 v hc eq =
  (λ i → chk k (dht-inr-inj {V} {v} {v0} (sym eq) i)) ∙ sym hc
dht-check-sound-bool chk false k v0 v hc eq = Empty-rec (dn-inl≠inr eq)
