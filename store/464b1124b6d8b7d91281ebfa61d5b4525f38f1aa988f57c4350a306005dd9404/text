cl-nl : List Word
cl-nl = cons #10 nil

cl-tr : List Word → List Word
cl-tr nil         = nil
cl-tr (cons c cs) = cons (if %weq c #96 then #34 else c) (cl-tr cs)

cl-ql : List Word → List Word → List Word
cl-ql s tl = list-append (cl-tr s) (list-append cl-nl tl)

cl-cat : List (List Word) → List Word
cl-cat nil           = nil
cl-cat (cons xs xss) = list-append xs (cl-cat xss)

cl-lt-nat : Nat → Nat → Bool
cl-lt-nat zero    zero    = false
cl-lt-nat zero    (suc b) = true
cl-lt-nat (suc a) zero    = false
cl-lt-nat (suc a) (suc b) = cl-lt-nat a b

cl-accept-seq : Nat → Nat → Bool
cl-accept-seq seen incoming = cl-lt-nat seen incoming

-- THEOREM 1A (UNIVERSAL DUPLICATE RE-POLL REJECTION — ZERO 1HZ BUS SPAM):
cl-thm-rejects-duplicate : (s : Nat) → cl-accept-seq s s ≡ false
cl-thm-rejects-duplicate zero    = refl
cl-thm-rejects-duplicate (suc s) = cl-thm-rejects-duplicate s

-- THEOREM 1B (UNIVERSAL STRICTLY-MONOTONE NEXT-FRAME ACCEPTANCE):
cl-thm-accepts-next-seq : (s : Nat) → cl-accept-seq s (suc s) ≡ true
cl-thm-accepts-next-seq zero    = refl
cl-thm-accepts-next-seq (suc s) = cl-thm-accepts-next-seq s

