-- Zero-UB predicate for C binary word operations:
--   div/mod guarded against b == 0; shl/shr guarded against b >= 64; all other uint64_t ops total.
COpUBFree : Word → Word → Word → Type
COpUBFree j a b =
  (%weq j #6 ≡ true → %weq b #0 ≡ true → ce-op-sem j a b ≡ cv-word #0) ×
  (%weq j #7 ≡ true → %weq b #0 ≡ true → ce-op-sem j a b ≡ cv-word #0) ×
  (%weq j #11 ≡ true → %wlt b #64 ≡ false → ce-op-sem j a b ≡ cv-word #0) ×
  (%weq j #12 ≡ true → %wlt b #64 ≡ false → ce-op-sem j a b ≡ cv-word #0)
