nm-step : Word → Word → List Word → Word → Word × List Word
nm-step lc st acc c =
  if nm-ws c then
    (if wlt #0 (wshr st #2)
       then (wadd #1 (if weq c #10 then #2 else #0) , (if weq (wand st #2) #2 then acc else nm-dashes (wshr st #2) (cons #32 acc)))
       else (wadd #1 (nm-nl st c) , acc))
  else if andB (weq c #45) (weq (wand st #1) #1) then (wadd st #4 , acc)
  else (#0 , cons (nm-low lc c) (if weq (wand st #1) #1 then nm-dashes (wshr st #2) (cons #32 acc) else acc))
