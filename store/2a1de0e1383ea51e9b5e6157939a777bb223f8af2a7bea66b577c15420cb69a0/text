cm-map-comp : {A B C : Type} → (g : B → C) → (f : A → B) → (xs : List A) → list-map g (list-map f xs) ≡ list-map (λ x → g (f x)) xs
cm-map-comp {A} {B} {C} g f xs =
  case xs return (λ w → list-map g (list-map f w) ≡ list-map (λ x → g (f x)) w) of
    nil → λ i → nil
    cons x r → λ i → cons (g (f x)) (rec r i)
