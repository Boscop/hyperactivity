nk-ty-spine : (NkTm → Word → NkTm → NkTm → NkTm) → NkTm → NkTm → Word → NkTm → NkTm → NkTm
nk-ty-spine chk kdefs ctx n (nk-cons a r) curTy =
  let nf = nk-norm-in-s kdefs ctx n curTy
  in if nk-con-is nf #1
       then (if nk-failed (chk ctx n a (nk-nth (nk-args nf) #0))
               then nk-fail
               else nk-ty-spine chk kdefs ctx n r (nk-app (nk-nth (nk-args nf) #1) a))
       else nk-fail
nk-ty-spine chk kdefs ctx n as curTy = nk-norm-in-s kdefs ctx n curTy
