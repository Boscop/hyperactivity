vf-at : (sk : Lst Entry) (a : TyShape) (f : VarP (lcons (e-ty a) sk) → Word) (k : Word) → Opt (f none ≡ k) →
  Opt ((v : VarP sk) × f (some v) ≡ k) → Opt ((v : VarP (lcons (e-ty a) sk)) × f v ≡ k)
vf-at sk a f k (some p) r = some (none , p)
vf-at sk a f k none r = opt-1 (λ q → (some (fst q) , snd q)) r
