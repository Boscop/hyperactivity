-- a UnicodeData line with a lowercase: a character outside ASCII replaced by it (ASCII by y///)
e-ucd-low : List Word → List Word
e-ucd-low line = if wlt (e-num-onto #16 #0 (e-nth zero (h-split #59 line))) #128 then nil
  else e-ucd-rule (e-num-onto #16 #0 (e-nth zero (h-split #59 line))) (e-utf8 (e-num-onto #16 #0 (e-nth (toNat #13) (h-split #59 line))))
