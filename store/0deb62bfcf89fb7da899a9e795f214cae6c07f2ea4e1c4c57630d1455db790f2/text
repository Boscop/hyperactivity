-- one branch of a kind at √V → 1: the maps composed, weighted
unit-branch : Nat → Bool → Nat → Bool → Nat → List Nat → Rows → Rows
unit-branch k sn n sm m dsP rs = mat-scale (sq-mul (side-weight sn n dsP) (side-weight sm m dsP)) (last-maps k sn n sm m dsP (mid-maps k sn n sm m dsP (first-maps k sn n dsP rs)))
