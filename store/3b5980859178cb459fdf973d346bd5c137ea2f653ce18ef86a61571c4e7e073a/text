w-driver-performs-all : (c : WCmd) → isTrue (w-performed c)
w-driver-performs-all c = case c return (λ x → isTrue (w-performed x)) of
  w-now → unit
  w-write fd n b → unit
  w-read fd n → unit
  w-sleep ns → unit
  w-exit ec → unit
  w-open n p f m → unit
  w-close fd → unit
  w-load a → unit
  w-store a v → unit
  w-cas a o nw → unit
  w-fence → unit
  w-sys nr a1 a2 a3 a4 a5 a6 → unit
  w-alloc n → unit
  w-load8 a → unit
  w-store8 a v → unit
  w-spawn a e o → unit
  w-fd-write fd t → unit
  w-file-read-named p → unit
  w-file-write-named p t → unit
  w-free a → unit
  w-snapshot n a → unit
