nk-upd-same-at : (c : Bool) (a b : NkSlots) (w x : Word) (f : NkSlot → NkSlot) → (%weq w x ≡ c) → nk-same a b → nk-get (nk-upd a w f) x ≡ nk-get (nk-upd b w f) x
nk-upd-same-at true a b w x f p h =
  cong (λ z → nk-get (nk-upd a w f) z) (sym (weq-sound w x p)) ∙ (nk-get-set a w (f (nk-get a w)) ∙ (cong f (h w) ∙ (sym (nk-get-set b w (f (nk-get b w))) ∙ cong (λ z → nk-get (nk-upd b w f) z) (weq-sound w x p))))
nk-upd-same-at false a b w x f p h = nk-get-set-other a w x (f (nk-get a w)) p ∙ (h x ∙ sym (nk-get-set-other b w x (f (nk-get b w)) p))
