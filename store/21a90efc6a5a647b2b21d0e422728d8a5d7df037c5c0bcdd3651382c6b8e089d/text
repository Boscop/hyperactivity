s-paper-of : Sum Unit (List Word) → List Word
s-paper-of (inl u) = s-respond "503 Service Unavailable" "text/plain" "the paper is being made; reload in a minute"
s-paper-of (inr t) = s-response s-html (s-page "paper.md" (list-append "# hyperactivity\n\n*A decentralized operating system language for collective superintelligence.* Avik Jain\n\n" (s-paper-text t)))
