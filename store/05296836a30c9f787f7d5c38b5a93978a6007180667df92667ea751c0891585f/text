hcm-dec-file : List Word → List Word → Step W Word
hcm-dec-file inp out =
  scmd w-now (λ t0 →
  hcm-read-raw inp (λ inb ilen →
  hcm-get32 inb #4 (λ n →
  hcm-get32 inb #8 (λ c0 →
  scmd (w-alloc #7866496) (λ tab →
  scmd (w-alloc (%wadd n #16)) (λ outb →
  scmd (w-store (hcm-slot-inb tab) inb) (λ _ →
  scmd (w-store (hcm-slot-ilen tab) ilen) (λ _ →
  let nn = toNat n
      fin = hcm-dec-fin out t0 ilen n tab inb outb
  in scmd (w-sys #900 #0 #0 #0 #0 #0 #0) (λ _ →
     hcm-dec-loop2 nn tab outb #0 #0 (hcm-pack-lohi #0 #4294967295) c0 #12 #0 fin)))))))))
