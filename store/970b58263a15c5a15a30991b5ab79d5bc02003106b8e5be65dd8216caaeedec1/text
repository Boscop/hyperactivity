ce-run-of : Code → List Word
ce-run-of (cglob g) =
  (case unfold g return (λ _ → List Word) of
     none → "/* no code */"
     some c →
       let defs = x-erase g (x-forms-all (snd (program-of-at unfold g (fst (specialize (opt-or (def-type-code g) cword) sched-default lnil c)) #256)))
       in list-append ce-prelude
            (list-append ce-prelude2
              (list-append ce-prelude3
                (list-append ce-world-driver
                  (list-append (ce-protos defs)
                    (list-append (ce-wraps defs)
                      (list-append (ce2-fns defs defs)
                        (ce-world-main g))))))))
ce-run-of c = "/* not a definition */"
