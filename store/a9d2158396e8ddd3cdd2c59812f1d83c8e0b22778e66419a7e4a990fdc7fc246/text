-- adding transitions refines the quotient: every path in s1 survives in (step-or s1 s2)
basin-refine : {S : Type 0} {s1 s2 : S → S → Bool}
             → Basins S s1 → Basins S (step-or s1 s2)
basin-refine {S} {s1} {s2} =
  basin-map {S} {S} {s1} {step-or s1 s2} (λ x → x) (λ a b p → orB-inl (s1 a b) (s2 a b) p)
