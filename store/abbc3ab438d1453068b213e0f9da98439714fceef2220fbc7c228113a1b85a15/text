<script>
// Lab 1: Cycle-Accurate 16-Tile HyperNet-16 (4x4) vs. Pipelined RISC-V Simulator
(function() {
  const stage = document.getElementById('hnStage');
  const canvas = document.getElementById('hnCanvas');
  const ctx = canvas.getContext('2d');
  const st = document.getElementById('hnStatus');
  const btnPlay = document.getElementById('hnPlay');

  const WLOADS = {
    0: { name: '5-Queens (ans=10)', hnMax: 29, rvMax: 2001, ans: 10, peak: 7, steals: 7, steps: 70, allocs: 14, pruned: 0, gatedPct: '84.1%' },
    3: { name: '§4.5 Cubical 5-Queens (ans=10)', hnMax: 32, rvMax: 2006, ans: 10, peak: 8, steals: 8, steps: 72, allocs: 15, pruned: 1, gatedPct: '84.8%' },
    2: { name: '16-Leaf Map-Reduce (ans=136)', hnMax: 27, rvMax: 83, ans: 136, peak: 5, steals: 6, steps: 46, allocs: 16, pruned: 0, gatedPct: '89.4%' },
    1: { name: 'HO λ-Closure DUP (ans=12)', hnMax: 5, rvMax: 6, ans: 12, peak: 2, steals: 1, steps: 4, allocs: 2, pruned: 0, gatedPct: '90.0%' }
  };

  let curW = 0, cyc = 0, playing = true, tickAcc = 0, phase = 0;

  function resize() {
    const r = stage.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.floor(r.width * dpr));
    canvas.height = Math.max(1, Math.floor(r.height * dpr));
  }
  new ResizeObserver(resize).observe(stage); resize();

  document.querySelectorAll('[data-w]').forEach(b => {
    b.onclick = () => {
      curW = parseInt(b.getAttribute('data-w'), 10);
      cyc = 0;
      document.querySelectorAll('[data-w]').forEach(x => x.classList.toggle('on', x === b));
    };
  });
  btnPlay.onclick = () => { playing = !playing; btnPlay.textContent = playing ? '⏸ Pause' : '▶ Play'; };
  document.getElementById('hnStep').onclick = () => { playing = false; btnPlay.textContent = '▶ Play'; stepOnce(); };
  document.getElementById('hnReset').onclick = () => { cyc = 0; };

  function stepOnce() {
    const w = WLOADS[curW];
    if (cyc < w.hnMax) cyc++;
    else if (cyc < w.rvMax) cyc = Math.min(w.rvMax, cyc + Math.max(1, Math.ceil(w.rvMax / 38)));
    else cyc = 0;
  }

  function tileState(tid, c, w) {
    if (c === 0) return { dq: tid === 0 ? (curW === 3 ? 2 : 1) : 0, free: tid === 0 ? (curW === 3 ? 6 : 7) : 8, vpark: 0, pruneFlash: false };
    if (c >= w.hnMax) return { dq: 0, free: 8, vpark: 0, pruneFlash: false };
    const u = c / w.hnMax;
    const reach = tid < w.peak && c >= tid + 1 && u < 0.88;
    const dq = reach ? Math.max(1, Math.min(5, Math.round(3 * Math.sin(Math.PI * ((c - tid) / Math.max(2, w.hnMax - tid)))))) : 0;
    const vpark = (tid < w.peak && u > 0.25 && u < 0.92 && ((c + tid) % 3 === 0)) ? 1 : 0;
    const free = 8 - (dq > 0 ? 1 : 0) - vpark;
    const pruneFlash = (curW === 3 && tid === 0 && c >= 1 && c <= 3);
    return { dq, free, vpark, pruneFlash };
  }

  function draw() {
    phase += 0.05;
    if (playing) { tickAcc++; if (tickAcc >= 9) { tickAcc = 0; stepOnce(); } }
    const w = WLOADS[curW];
    const dark = document.documentElement.classList.contains('dark');
    const bg = dark ? '#000' : '#fff', ink = dark ? '#fff' : '#000';
    const muted = dark ? 'rgba(255,255,255,0.22)' : 'rgba(0,0,0,0.18)';
    const pink = '#ff0a94', blue = dark ? '#4da3ff' : '#1a73e8';
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const W = canvas.width / dpr, H = canvas.height / dpr;

    ctx.setTransform(1,0,0,1,0,0); ctx.fillStyle = bg; ctx.fillRect(0,0,canvas.width,canvas.height);
    ctx.scale(dpr, dpr);

    const gridW = Math.min(W * 0.56, H - 34);
    const ox = 18, oy = 22;
    const cellS = (gridW - 3 * 8) / 4;
    const hnCyc = Math.min(cyc, w.hnMax);
    const hnDone = cyc >= w.hnMax;

    // Draw 4x4 HyperNet-16 tiles
    let liveFreeCells = 0, liveFreeVars = 0, activeCnt = 0;
    const centers = [];
    for (let i = 0; i < 16; i++) {
      const r = Math.floor(i / 4), col = i % 4;
      const x = ox + col * (cellS + 8), y = oy + r * (cellS + 8);
      centers.push({ x: x + cellS / 2, y: y + cellS / 2 });
      const ts = tileState(i, hnCyc, w);
      liveFreeCells += ts.free;
      liveFreeVars += (8 - ts.vpark);
      if (ts.dq > 0) activeCnt++;

      ctx.fillStyle = ts.pruneFlash ? 'rgba(255,10,148,0.22)' : (ts.dq > 0 ? (dark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.05)') : bg);
      ctx.fillRect(x, y, cellS, cellS);
      ctx.strokeStyle = ts.dq > 0 ? pink : (ts.vpark > 0 ? blue : muted);
      ctx.lineWidth = ts.dq > 0 ? 2 : 1;
      ctx.strokeRect(x, y, cellS, cellS);

      ctx.font = '700 10px ui-monospace, Menlo, monospace';
      ctx.fillStyle = ts.dq > 0 ? ink : (dark ? '#777' : '#888');
      ctx.textAlign = 'left'; ctx.textBaseline = 'top';
      ctx.fillText(`T${i}`, x + 5, y + 4);

      ctx.textAlign = 'right';
      ctx.fillStyle = ts.dq > 0 ? pink : (ts.vpark ? blue : (dark ? '#666' : '#999'));
      ctx.fillText(ts.pruneFlash ? '⊥PRUNE' : (ts.dq > 0 ? `dq:${ts.dq}` : 'GATED'), x + cellS - 5, y + 4);

      // Deque activity bar
      const bw = ((cellS - 10) * Math.min(ts.dq, 5)) / 5;
      ctx.fillStyle = muted; ctx.fillRect(x + 5, y + cellS - 16, cellS - 10, 4);
      if (bw > 0) { ctx.fillStyle = pink; ctx.fillRect(x + 5, y + cellS - 16, bw, 4); }
      // Striped VAR_SRAM bar
      ctx.fillStyle = ts.vpark ? blue : muted;
      ctx.fillRect(x + 5, y + cellS - 9, cellS - 10, 3);
    }

    // Draw active ring work-stealing & striped vxchg arcs while running
    if (!hnDone && hnCyc > 0) {
      for (let i = 0; i < Math.min(w.peak - 1, hnCyc); i++) {
        const a = centers[i], b = centers[(i + 1) % 16];
        ctx.strokeStyle = pink; ctx.lineWidth = 1.4;
        ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
        const u = (phase + i * 0.27) % 1;
        ctx.fillStyle = pink;
        ctx.beginPath(); ctx.arc(a.x + (b.x - a.x) * u, a.y + (b.y - a.y) * u, 3, 0, Math.PI * 2); ctx.fill();
      }
      if (hnCyc > 2) {
        const s = centers[hnCyc % w.peak], d = centers[(hnCyc * 3 + 1) % w.peak];
        ctx.strokeStyle = blue; ctx.setLineDash([3, 3]); ctx.lineWidth = 1.3;
        ctx.beginPath(); ctx.moveTo(s.x, s.y); ctx.lineTo(d.x, d.y); ctx.stroke();
        ctx.setLineDash([]);
      }
    }

    // Right comparison panel
    const rx = ox + gridW + 22, rw = Math.max(150, W - rx - 18);
    ctx.textAlign = 'left'; ctx.textBaseline = 'top';
    ctx.font = '700 11px ui-monospace, Menlo, monospace';
    ctx.fillStyle = pink;
    ctx.fillText('HYPERNET-16 (4×4 GALS, ZERO SWITCH)', rx, oy);

    const hnNs = (hnCyc * 1.4105).toFixed(1);
    ctx.fillStyle = ink; ctx.font = '700 18px ui-monospace, Menlo, monospace';
    ctx.fillText(`${hnCyc} / ${w.hnMax} cyc (${hnNs} ns)`, rx, oy + 17);

    ctx.fillStyle = muted; ctx.fillRect(rx, oy + 43, rw, 10);
    ctx.fillStyle = pink; ctx.fillRect(rx, oy + 43, rw * (hnCyc / w.hnMax), 10);

    ctx.font = '600 11px ui-monospace, Menlo, monospace';
    ctx.fillStyle = dark ? '#bbb' : '#333';
    ctx.fillText(`Cells: ${hnDone ? 128 : liveFreeCells}/128 · Vars: ${hnDone ? 128 : liveFreeVars}/128`, rx, oy + 60);
    ctx.fillText(`GALS Gated: ${w.gatedPct} · Pruned: ${hnCyc >= 1 ? w.pruned : 0}`, rx, oy + 77);
    if (hnDone) {
      ctx.fillStyle = pink; ctx.font = '700 12px ui-monospace, Menlo, monospace';
      ctx.fillText(`✓ QUIESCENT · root_result = ${w.ans}`, rx, oy + 96);
    }

    // Pipelined RISC-V bar
    const ry = oy + 134;
    const rvCyc = Math.min(cyc, w.rvMax);
    const rvNs = (rvCyc * 0.879).toFixed(1);
    ctx.fillStyle = blue; ctx.font = '700 11px ui-monospace, Menlo, monospace';
    ctx.fillText('RISCV32_PIPE16 (2-STAGE + STACK)', rx, ry);
    ctx.fillStyle = ink; ctx.font = '700 18px ui-monospace, Menlo, monospace';
    ctx.fillText(`${rvCyc} / ${w.rvMax} cyc (${rvNs} ns)`, rx, ry + 17);

    ctx.fillStyle = muted; ctx.fillRect(rx, ry + 43, rw, 10);
    ctx.fillStyle = blue; ctx.fillRect(rx, ry + 43, rw * (rvCyc / w.rvMax), 10);

    ctx.font = '600 11px ui-monospace, Menlo, monospace';
    ctx.fillStyle = dark ? '#bbb' : '#333';
    const cycRatio = (w.rvMax / w.hnMax).toFixed(1);
    const nsRatio = ((w.rvMax * 0.87897) / (w.hnMax * 1.4105)).toFixed(1);
    ctx.fillText(`Cycle speedup: ${cycRatio}× · 7nm time: ${nsRatio}×`, rx, ry + 60);
    ctx.fillText(rvCyc < w.rvMax ? 'Sequential stack backtracking…' : `✓ HALTED · result_out = ${w.ans}`, rx, ry + 77);

    if (curW === 3 && hnCyc >= 1) {
      ctx.strokeStyle = pink; ctx.lineWidth = 1;
      ctx.strokeRect(rx, ry + 104, rw, 44);
      ctx.fillStyle = pink; ctx.font = '700 10.5px ui-monospace, Menlo, monospace';
      ctx.fillText('§4.5 conf = |((pa|pb)&(na|nb)) = 1', rx + 8, ry + 112);
      ctx.fillStyle = ink;
      ctx.fillText('2,001-cyc dead tree killed in 1 cyc', rx + 8, ry + 128);
    }

    st.textContent = `${w.name} · HyperNet-16: ${hnCyc}/${w.hnMax} cyc · RISC-V: ${rvCyc}/${w.rvMax} cyc · Active Tiles: ${activeCnt}/16`;
    requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);
})();

// Lab 2: Hierarchical 18,664,712-Polygon Calma GDSII v6.0 Die Inspector
(function() {
  const stage = document.getElementById('gdsStage');
  const canvas = document.getElementById('gdsCanvas');
  const ctx = canvas.getContext('2d');
  const st = document.getElementById('gdsStatus');

  let zoom = 0;
  const vis = { feol: true, m12: true, sram: true, noc: true };

  function resize() {
    const r = stage.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.floor(r.width * dpr));
    canvas.height = Math.max(1, Math.floor(r.height * dpr));
    render();
  }
  new ResizeObserver(resize).observe(stage);

  document.querySelectorAll('[data-z]').forEach(b => {
    b.onclick = () => {
      zoom = parseInt(b.getAttribute('data-z'), 10);
      document.querySelectorAll('[data-z]').forEach(x => x.classList.toggle('on', x === b));
      render();
    };
  });
  document.querySelectorAll('[data-ly]').forEach(b => {
    b.onclick = () => {
      const k = b.getAttribute('data-ly');
      vis[k] = !vis[k];
      b.classList.toggle('on', vis[k]);
      render();
    };
  });
  canvas.onclick = () => {
    zoom = (zoom + 1) % 3;
    document.querySelectorAll('[data-z]').forEach(x => x.classList.toggle('on', parseInt(x.getAttribute('data-z'), 10) === zoom));
    render();
  };

  function drawTile(x, y, s, detail) {
    if (vis.m12) {
      ctx.fillStyle = '#ef4444';
      ctx.fillRect(x, y, s, Math.max(2, s * 0.033));
      ctx.fillRect(x, y + s * 0.967, s, Math.max(2, s * 0.033));
    }
    if (vis.sram) {
      ctx.fillStyle = 'rgba(255,10,148,0.26)';
      ctx.strokeStyle = '#ff0a94'; ctx.lineWidth = 1.2;
      const sy = y + s * 0.08, sh = s * 0.38, sw = s * 0.42;
      ctx.fillRect(x + s * 0.04, sy, sw, sh); ctx.strokeRect(x + s * 0.04, sy, sw, sh);
      ctx.fillRect(x + s * 0.54, sy, sw, sh); ctx.strokeRect(x + s * 0.54, sy, sw, sh);
      if (detail) {
        ctx.fillStyle = '#ff0a94'; ctx.font = '700 10px ui-monospace, Menlo, monospace';
        ctx.textAlign = 'center';
        ctx.fillText('CELL_SRAM (15/0)', x + s * 0.25, sy + sh * 0.5);
        ctx.fillText('STRIPED VAR_SRAM (15/0)', x + s * 0.75, sy + sh * 0.5);
      }
    }
    if (vis.feol) {
      const rows = detail ? 30 : 10;
      const ry0 = y + s * 0.53, rh = (s * 0.40) / rows;
      for (let r = 0; r < rows; r++) {
        ctx.fillStyle = (r % 2 === 0) ? 'rgba(26,115,232,0.55)' : 'rgba(77,163,255,0.38)';
        ctx.fillRect(x + s * 0.05, ry0 + r * rh, s * 0.90, Math.max(1, rh * 0.72));
      }
    }
    if (vis.m12) {
      ctx.fillStyle = '#f59e0b';
      ctx.fillRect(x + s * 0.07, y + s * 0.485, s * 0.86, Math.max(2, s * 0.025));
      ctx.fillStyle = '#10b981';
      ctx.fillRect(x + s * 0.23, y + s * 0.20, Math.max(2, s * 0.03), s * 0.62);
      ctx.fillRect(x + s * 0.74, y + s * 0.20, Math.max(2, s * 0.03), s * 0.62);
      ctx.fillStyle = '#ffffff';
      const vs = Math.max(2.5, s * 0.03);
      ctx.fillRect(x + s * 0.23, y + s * 0.485, vs, vs);
      ctx.fillRect(x + s * 0.74, y + s * 0.485, vs, vs);
    }
  }

  function render() {
    const dark = document.documentElement.classList.contains('dark');
    const bg = dark ? '#080b12' : '#f8fafc', ink = dark ? '#fff' : '#000';
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const W = canvas.width / dpr, H = canvas.height / dpr;

    ctx.setTransform(1,0,0,1,0,0); ctx.fillStyle = bg; ctx.fillRect(0,0,canvas.width,canvas.height);
    ctx.scale(dpr, dpr);

    if (zoom === 0) {
      const dieS = Math.min(W - 40, H - 28);
      const dx = (W - dieS) / 2, dy = (H - dieS) / 2;
      if (vis.m12) {
        ctx.fillStyle = '#ef4444';
        ctx.fillRect(dx, dy, dieS, 3);
        ctx.fillRect(dx, dy + dieS - 3, dieS, 3);
      }
      const pad = dieS * 0.03, pitch = (dieS - pad * 2) / 4, ts = pitch * 0.90;
      for (let r = 0; r < 4; r++) {
        for (let c = 0; c < 4; c++) {
          drawTile(dx + pad + c * pitch + pitch * 0.05, dy + pad + r * pitch + pitch * 0.05, ts, false);
        }
      }
      if (vis.noc) {
        for (let ch = 1; ch <= 3; ch++) {
          const p = pad + ch * pitch;
          ctx.fillStyle = '#06b6d4'; ctx.fillRect(dx + pad, dy + p - 1.5, dieS - pad * 2, 3);
          ctx.fillStyle = '#ff0a94'; ctx.fillRect(dx + p - 1.5, dy + pad, 3, dieS - pad * 2);
        }
      }
      st.textContent = 'HYPERNET16_4X4_DIE (132×132 µm) · AREF 4×4 = 129,600 CMOS7 Cells · 18,664,712 Polygons · 0 DRC Shorts (click to zoom)';
    } else if (zoom === 1) {
      const ts = Math.min(W - 60, H - 32);
      drawTile((W - ts) / 2, (H - ts) / 2, ts, true);
      st.textContent = 'HYPERNET16_TILE (30×30 µm) · AREF 45×30 STDCELL_SLICE6 = 8,100 CMOS7 Cells + Dual Local SRAMs (click to zoom)';
    } else {
      const names = ['CMOS7_INV', 'CMOS7_NAND2', 'CMOS7_NOR2', 'CMOS7_XOR2', 'CMOS7_MUX2', 'CMOS7_DFF'];
      const gates = [[3,3], [2,7], [2,7], [2,8], [2,8], [2,8]];
      const sw = Math.min(W - 36, 760), sh = Math.min(H - 64, 240);
      const sx = (W - sw) / 2, sy = (H - sh) / 2, cw = sw / 6;
      for (let i = 0; i < 6; i++) {
        const cx = sx + i * cw;
        if (vis.feol) {
          ctx.fillStyle = 'rgba(59,130,246,0.18)'; ctx.fillRect(cx, sy, cw, sh * 0.5);
          ctx.fillStyle = 'rgba(16,185,129,0.45)';
          ctx.fillRect(cx + cw * 0.1, sy + sh * 0.15, cw * 0.8, sh * 0.25);
          ctx.fillRect(cx + cw * 0.1, sy + sh * 0.60, cw * 0.8, sh * 0.25);
          ctx.fillStyle = '#ff0a94';
          const [g1, g2] = gates[i];
          ctx.fillRect(cx + cw * (g1 / 10), sy + sh * 0.10, Math.max(3, cw * 0.09), sh * 0.80);
          if (g2 !== g1) ctx.fillRect(cx + cw * (g2 / 10), sy + sh * 0.10, Math.max(3, cw * 0.09), sh * 0.80);
        }
        if (vis.m12) {
          ctx.fillStyle = '#ef4444';
          ctx.fillRect(cx, sy, cw, sh * 0.06);
          ctx.fillRect(cx, sy + sh * 0.94, cw, sh * 0.06);
          ctx.fillStyle = '#f59e0b';
          ctx.fillRect(cx + cw * 0.2, sy + sh * 0.45, cw * 0.6, sh * 0.10);
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(cx + cw * 0.46, sy + sh * 0.45, cw * 0.10, sh * 0.10);
        }
        ctx.strokeStyle = dark ? 'rgba(255,255,255,0.28)' : 'rgba(0,0,0,0.28)';
        ctx.strokeRect(cx, sy, cw, sh);
        ctx.fillStyle = ink; ctx.font = '700 10.5px ui-monospace, Menlo, monospace';
        ctx.textAlign = 'center';
        ctx.fillText(names[i].replace('CMOS7_', ''), cx + cw * 0.5, sy + sh + 16);
      }
      st.textContent = 'STDCELL_SLICE6 (600×200 nm, dbu=1 nm) · 6 Transistor-Level 7nm CMOS Masters (NWELL 1/0, DIFF 2/0, POLY 3/0, CONT 4/0, M1 11-12/0)';
    }
  }
  new MutationObserver(render).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  render();
})();
</script>
