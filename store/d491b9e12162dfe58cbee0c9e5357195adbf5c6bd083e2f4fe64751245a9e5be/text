nk-trim-susp-bounds : (b : NkTm) (j : Word) (e : NkEnv) (o : NkOut) →
  (nk-ebound e (nk-n o) ≡ true) →
  (nk-wire-le (nk-n o) (nk-n (nk-trim-susp b j e o)) ≡ true)
  × (nk-ebound (nk-ws (nk-trim-susp b j e o)) (nk-n (nk-trim-susp b j e o)) ≡ true)
nk-trim-susp-bounds b j nke-nil (nk-out fx n ws) hb = (nk-wire-le-refl n , refl)
nk-trim-susp-bounds b j (nke-cons w r) o hb =
  let hw = nk-and-l (nk-wire-lt w (nk-n o)) (nk-ebound r (nk-n o)) hb
      hr = nk-and-r (nk-wire-lt w (nk-n o)) (nk-ebound r (nk-n o)) hb
      ih = nk-trim-susp-bounds b (%wsucc j) r o hr
  in nk-trim-susp-bounds-step (nk-uses-var #0 j b) w (nk-trim-susp b (%wsucc j) r o) (nk-n o) hw (fst ih) (snd ih)
