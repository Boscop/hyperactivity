bm-step-at : BmStmt → (Nat → Byte) → List BmStmt → DStep BmSig BmConf (Nat → Byte) Empty
bm-step-at bm-skip rho k = bm-step-skip rho k
bm-step-at (bm-seq s t) rho k = bm-tau (s , rho , cons t k)
bm-step-at (bm-if e s t) rho k = bm-tau (bm-choose (eqBits 8 (bm-eval e rho) bm-zero) s t , rho , k)
bm-step-at (bm-read-into r a) rho k = bm-call (bm-read a) (λ b → (bm-skip , bm-set rho r b , k))
bm-step-at (bm-write-of a e) rho k = bm-call (bm-write a (bm-eval e rho)) (λ u → (bm-skip , rho , k))
