hopf-raw : SInt → SInt → SInt → SInt → HPt
hopf-raw cEta sEta xi1 xi2 =
  let aSum = si-add xi1 xi2
      aDif = si-sub xi1 xi2
      x1 = fx-mul cEta (fx-cos aSum)
      x2 = fx-mul cEta (fx-sin aSum)
      x3 = fx-mul sEta (fx-cos aDif)
      x4 = fx-mul sEta (fx-sin aDif)
      den = si-sub (sp #14800) x4
      X = fx-div x1 den
      Y = fx-div x2 den
      Z = fx-div x3 den
      sc = fx-div (sp #56000) (si-sub (sp #56000) Z)
  in hpt (fx-mul X sc) (si-neg (fx-mul Y sc)) Z
