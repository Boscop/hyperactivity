sg-norm-defs : NkTm → NkTm → NkTm
sg-norm-defs kdefs0 (nk-cons e r) =
  let as = nk-args e
      body = nk-nth as #0
      ty = nk-nth as #1
  in if nk-has-fail ty
       then nk-cons e (sg-norm-defs kdefs0 r)
       else nk-cons (nk-con #55 (nk-cons body (nk-cons (nk-norm-s kdefs0 ty) nk-nil))) (sg-norm-defs kdefs0 r)
sg-norm-defs _ _ = nk-nil
