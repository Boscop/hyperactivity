-- a body's value, given how any further thing is computed (r): clause for clause what nk-build
-- places on wires
nk-ev-tm : (NkEvJ → NkEv) → NkTm → NkEv → NkEv
nk-ev-tm r (nk-var i) e = nk-ev-nth e i
nk-ev-tm r (nk-free x) e = nkev (hd-var x) nkev-nil
nk-ev-tm r (nk-num m) e = nkev (hd-num m) nkev-nil
nk-ev-tm r (nk-lam b) e = nkev (hd-clo b) e
nk-ev-tm r (nk-con c as) e = nkev (hd-con c) (r (nkevj-tm as e))
nk-ev-tm r (nk-op h p as) e = r (nkevj-el h nk-nil (r (nkevj-tm as e)) (r (nkevj-tm p e)))
nk-ev-tm r (nk-match h p cs) e = r (nkevj-el h cs e (r (nkevj-tm p e)))
nk-ev-tm r nk-nil e = nkev-nil
nk-ev-tm r (nk-cons t rest) e = nkev-cons (r (nkevj-tm t e)) (r (nkevj-tm rest e))
