eval-cut-wire : {K V : Type} → (V → WireId → ICAgent K) → (K → V → Bool) → CAStore K V → WireFrame K V → ICAgent K → CutOutcome K
eval-cut-wire unpack chk loc wf-era right = ic-interact ic-era right
eval-cut-wire unpack chk loc (wf-con t a1 a2) right = ic-interact (ic-con t a1 a2) right
eval-cut-wire unpack chk loc (wf-ref k arg pay) right =
  ic-interact (resolve-agent unpack (ca-or (loc k) (ca-check chk k pay)) k arg) right
