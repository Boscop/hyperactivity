s-object-post : List Word → List Word → List Word → Proc W (List Word)
s-object-post m q body = if s-object-name (s-param "h" q) (s-param "k" q)
  then bind (h-take-object m (s-param "h" q) (s-param "k" q) body) (λ ok → ret (s-object-taken ok))
  else ret {lzero} {W} (s-respond "400 Bad Request" "text/plain" "an object is named by its hash and kind (text, module, entry)")
