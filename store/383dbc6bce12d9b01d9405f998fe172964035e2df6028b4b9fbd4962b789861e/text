-- (part of language-support)
alignment_checking_enabled_p : MS Bool
alignment_checking_enabled_p =
  bindS {List (Bits #64)} {Bool} (getS {List (Bits #64)} x86-ctrs) (λ ctrs'1 →
    let cr0 : Bits #32
        cr0 = (bv-trunc #64 #32 (vec-get {Bits #64} #0 ctrs'1 #0))
        am : Bits #1
        am = (cr0bits-am cr0)
    in bindS {rflagsbits} {Bool} (getS {rflagsbits} x86-rflags) (λ rflags_var →
         let ac : Bits #2
             ac = (bv-zext #1 #2 (rflagsbits-ac rflags_var))
         in bindS {List (Bits #16)} {Bool} (getS {List (Bits #16)} x86-seg_visibles) (λ seg_visibles'3 →
              let cpl : Bits #2
                  cpl = (segment_selectorbits-rpl (vec-get {Bits #16} #0 seg_visibles'3 #1))
              in retS {Bool} (b-and (weq am #1) (b-and (weq ac #1) (weq cpl #3))))))
