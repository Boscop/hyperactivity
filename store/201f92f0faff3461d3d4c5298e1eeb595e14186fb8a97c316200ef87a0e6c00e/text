-- Predict blended probability p in [1, 4095] from O1, O3, O6 + active LZ match bit!
hcm-blend : Word → Word → Word → Word → Word → Word
hcm-blend p1 p3 p6 mlen mbit =
  let pm = if %wlt #0 mlen then
             let conf = if %wlt #7 mlen then #4064 else if %wlt #3 mlen then #3968 else #3600
             in if %weq mbit #1 then conf else %wsub #4096 conf
           else #2048
      wsum = if %wlt #0 mlen then %wadd (%wadd p1 (%wmul p3 #2)) (%wadd (%wmul p6 #3) (%wmul pm #10))
             else %wadd (%wadd p1 (%wmul p3 #3)) (%wmul p6 #4)
      p = if %wlt #0 mlen then %wshr wsum #4 else %wshr wsum #3
  in if %wlt p #1 then #1 else if %wlt #4095 p then #4095 else p
