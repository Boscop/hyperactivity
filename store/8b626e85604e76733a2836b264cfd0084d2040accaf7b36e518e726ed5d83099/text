-- a query at most the tokens from the record at o, read where they are: Θ(the bytes of the tokens compared)
si-cmp : (n : Nat) → Bytes n → List (List Word) → Word → Bool
si-cmp n B c = case c return λ w → Word → Bool of
  nil → λ o → true
  cons x r → λ o → if weq (cstr-get n B o) #1
    then lex-step (lexle word-le x (si-tok n B o)) (lexle word-le (si-tok n B o) x) (rec r (si-next n B o))
    else false
