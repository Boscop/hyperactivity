-- the hop's gravitational factor along edge 0, after H_0 of side sp, exactly
proj-hop-with : List Triple → VM → List Nat → Rows → List (List (List PRad))
proj-hop-with ts aP dsP xs0 = proj-pair ts aP 1 2 sq-one dsP xs0 (proj-pair ts aP 1 3 (sq-neg sq-one) dsP xs0 (proj-pair ts aP 2 3 sq-one dsP xs0
  (proj-zero (rows-len xs0) (vertex-count (vw-frs (fst aP))))))
