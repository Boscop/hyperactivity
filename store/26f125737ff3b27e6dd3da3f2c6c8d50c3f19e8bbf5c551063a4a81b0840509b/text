-- ceiling, positive with a remainder: A ≤ (Q+1)·D
cdiv-pos-rem : (k Q D R A : Nat) → plus k (suc R) ≡ D → A ≡ plus (times Q D) R → le (plus A (plus (times (suc Q) zero) zero)) (plus (plus (times (suc Q) D) zero) zero)
cdiv-pos-rem k Q D R A h hA = (suc k ,
  transN (congN (plus (suc k)) (transN (congN (plus A) (symN (zero-pz (suc Q)))) (plus-zero A)))
  (transN (div-up-alg k R Q D A h hA)
  (symN (transN (plus-zero (plus (times (suc Q) D) zero)) (plus-zero (times (suc Q) D))))))
