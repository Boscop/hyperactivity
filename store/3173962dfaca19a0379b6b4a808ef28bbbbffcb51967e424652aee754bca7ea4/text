-- ---------------------------------------------------------------- tags and discriminants
rm-set-tag-at : Target → Word → Word → List RVariantLayout → RTy → Word → MPtr → REv Unit
rm-set-tag-at t off size vs ty v =
  sr-on (rm-nth vs v (ri-no-variant ty v)) (λ e p → rm-throw e) (λ vl → case vl-tag-of vl of
    rtv-none → λ p → rm-ret unit
    rtv-some x → sr-on (rm-tag-sk size) (λ e p → rm-throw e) (λ tk →
      λ p → rm-bind (rm-off p off) (λ q → rm-store t tk #1 q (sv-i (uq-of-word x)))))
