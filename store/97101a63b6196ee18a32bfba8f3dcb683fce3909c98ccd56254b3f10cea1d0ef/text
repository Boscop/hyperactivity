csr-nth-append : (xs ys : List Word) (i : Nat) →
  (if csr-nat-lt i (csr-list-len xs) then csr-list-nth xs i else csr-list-nth ys (csr-nat-sub i (csr-list-len xs)))
  ≡ csr-list-nth (list-append xs ys) i
csr-nth-append nil ys zero = refl
csr-nth-append nil ys (suc i) = refl
csr-nth-append (cons x r) ys zero = refl
csr-nth-append (cons x r) ys (suc i) = csr-nth-append r ys i
