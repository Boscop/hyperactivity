-- 0-Cells: Universal Web Expression IR (Boolean / F2-ANF / CNF-Clause / SHA-256 Gate / Tensor AST)
data WExpr : Type where
  we-k   : Bool → WExpr
  we-v   : Word → WExpr
  we-not : WExpr → WExpr
  we-xor : WExpr → WExpr → WExpr
  we-and : WExpr → WExpr → WExpr
  we-or  : WExpr → WExpr → WExpr
  we-ch  : WExpr → WExpr → WExpr → WExpr
  we-maj : WExpr → WExpr → WExpr → WExpr
