-- (part of language-support)
idiv_spec_8 : (dst' : Bits #16) → (src : Bits #8) → (Bool × (Bits #8) × (Bits #8))
idiv_spec_8 dst' src =
  let dst_int : Bits #16
      dst_int = dst'
      src_int : Bits #8
      src_int = src
      quotient_int : Bits #17
      quotient_int = (bits_of_int (z-tdiv (bv-signed #16 dst_int) (bv-signed #8 src_int)) (zpos #17))
      remainder_int : Bits #8
      remainder_int = (bits_of_int (z-tmod (bv-signed #16 dst_int) (bv-signed #8 src_int)) (zpos #8))
      overflow? : Bool
      overflow? = (b-or (z-lt (bv-signed #17 quotient_int) (zneg #128)) (z-lt (zpos #127) (bv-signed #17 quotient_int)))
      t'1 : (Bool × (Bits #8) × (Bits #8))
      t'1 =
        if overflow? then
          (true , #0 , #0)
        else
          (let quotient : Bits #8
               quotient = (bv-trunc #17 #8 quotient_int)
               remainder : Bits #8
               remainder = remainder_int
           in (overflow? , quotient , remainder))
  in t'1
