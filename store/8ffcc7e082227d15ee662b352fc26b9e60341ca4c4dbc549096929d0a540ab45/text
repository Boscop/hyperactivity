-- E₋: z^k ↦ (d−k)/d z^k + (k/d) w z^(k−1) in the edge's variable
eminus-entry : Nat → List Nat → List Nat → List Nat → SQ
eminus-entry e ds t s = if exp-eq t (exp-snoc s zero) then ((monus (exp-at e ds) (exp-at e s) , exp-at e ds) , (zero , suc zero))
  else (if eqb (exp-at e s) zero then sq-zero else (if exp-eq t (exp-snoc (exp-down e s) (suc zero)) then ((exp-at e s , exp-at e ds) , (zero , suc zero)) else sq-zero))
