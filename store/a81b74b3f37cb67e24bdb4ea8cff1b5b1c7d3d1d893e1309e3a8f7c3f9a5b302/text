-- Closure application routine (a64-apply): closure at [x29, #32], arg at [x29, #16].
-- When closures are invoked dynamically at runtime, falls back cleanly via a64-exit to the net;
-- saturated direct calls (`a64-call`) execute natively at full ARM64 speed.
a64-apply : Lst Word
a64-apply = xcat3 a64-stp-fp-lr a64-mov-fp-sp a64-exit
