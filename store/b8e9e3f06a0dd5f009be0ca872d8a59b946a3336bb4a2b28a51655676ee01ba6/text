-- ---------------------------------------------------------------- the lexicographic order of a doubled prefix
lex-assoc : (a b c d e : Bool) → lex-step a b (lex-step c d e) ≡ lex-step (lex-step a b c) (lex-step b a d) e
lex-assoc a b c d e =
  (case a return λ y → lex-step y b (lex-step c d e) ≡ lex-step (lex-step y b c) (lex-step b y d) e of
     true → (case b return λ z → lex-step true z (lex-step c d e) ≡ lex-step (lex-step true z c) (lex-step z true d) e of
               true → λ i → lex-step c d e
               false → λ i → true)
     false → λ i → false)
