h-post : List Word → List Word → List Word → List Word → Proc W (Sum Unit (List Word))
h-post srv tok path body = h-http srv (h-concat (cons "POST " (cons path (cons " HTTP/1.1" (cons h-crlf (cons "Host: " (cons (h-srv-host srv) (cons h-crlf
  (cons "X-Token: " (cons tok (cons h-crlf (cons "Content-Length: " (cons (h-decimal (fromNat (list-length body))) (cons h-crlf
  (cons "Connection: close" (cons h-crlf (cons h-crlf (cons body nil))))))))))))))))))
