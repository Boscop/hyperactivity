nk-env-ev-set-lt : (rho : NkW → NkEv) (n : NkW) (val : NkEv) (e : NkEnv) →
  (nk-ebound e n ≡ true) → nk-env-ev (nk-rho-set rho n val) e ≡ nk-env-ev rho e
nk-env-ev-set-lt rho n val e hb =
  nk-env-ev-ext (nk-rho-set rho n val) rho e
    (λ w hm → nk-rho-set-other rho n w val (nk-wgt-neq w n (nk-emem-bound w e n hm hb)))
