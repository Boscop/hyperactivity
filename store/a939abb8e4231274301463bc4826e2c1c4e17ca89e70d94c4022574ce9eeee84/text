papp-line : (Γ : CCtx) (Y Z : Type 1) (ℓ : Y → Line Z) (f : DNF) → Mean Γ Y → Mean Γ Z
papp-line Γ Y Z ℓ f X =
  papp-dd (fst Γ) (CtxV (fst Γ)) (FbE (fst Γ) Z) f (snd Γ)
    (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (fline (fst Γ) Y Z ℓ) (snd Γ) X)
