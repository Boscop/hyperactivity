-- sums over the misfolds (realized folds below the maximum), weighted by count: Σ n, Σ n·hh, Σ n·hh², and the native's count
sl-msum : Nat → Nat → Nat → Nat → List Nat → Nat
sl-msum s m e k h = case h of
  nil → 0
  cons n rest → plus (if eqb (sl-hh s k) m then 0 else times n (case e of
      zero → 1
      suc e1 → (case e1 of
        zero → sl-hh s k
        suc e2 → times (sl-hh s k) (sl-hh s k)))) (sl-msum s m e (suc k) rest)
