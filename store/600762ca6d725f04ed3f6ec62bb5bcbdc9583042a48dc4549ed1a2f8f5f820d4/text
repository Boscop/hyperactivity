-- the value of a glvalue ([conv.lval]); of a class type it is not asked (a class is copied by
-- its constructor)
cx-lv-load : CxU → CType → CxR → CxEv CxR
cx-lv-load u ty r = case r of
  cxr-lv p al → (case cx-tc ty of
    cxtc-scalar → cx-bind {SV} {CxR} (cx-ld u ty al p) (λ v → cx-ret {CxR} (cxr-val v))
    cxtc-mfp → cx-mfp-load u p
    _ → cx-stop {CxR} st-ill-typed)
  cxr-bf p bit w → cx-bind {SV} {CxR} (cx-bf-load u ty p bit w) (λ v → cx-ret {CxR} (cxr-val v))
  _ → cx-stop {CxR} st-ill-typed
