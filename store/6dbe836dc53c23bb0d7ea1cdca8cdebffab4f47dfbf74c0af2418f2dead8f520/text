  (cons (ev-op #21)                     -- ISZERO
  (cons (ev-jmpi revLbl)                -- if failed -> revert
  (cons (ev-push (cons #64 nil))
  (cons (ev-op #81)                     -- MLOAD(64) = bal
  nil))))))))))))))))))))))))

