-- Read exactly 32 CSPRNG bytes from `/dev/urandom` via `dd`:
bl-urandom32-hex : Proc W (List Word)
bl-urandom32-hex =
  bind (h-capture (cons "/bin/dd" (cons "if=/dev/urandom" (cons "bs=32" (cons "count=1" nil))))) (λ r →
    let raw = h-take (toNat #32) (snd r)
    in if %weq (fromNat (list-length raw)) #32
       then ret {lzero} {W} (h-hex raw)
       else bind (h-fail "CSPRNG /dev/urandom read < 32B") (λ u → ret {lzero} {W} nil))

bl-load-or-gen-key : Proc W Word
bl-load-or-gen-key =
  bind (h-read bl-key-path) (λ ex →
    case ex of
      inr kh →
        let clean = h-take (toNat #64) kh
            priv  = h-be (eth-from-hex clean)
        in if andB (%wlt #0 priv) (%wlt priv secp-n)
           then ret {lzero} {W} priv
           else bind (h-fail "Invalid existing keyfile") (λ u → ret {lzero} {W} #0)
      inl u →
        bind (h-mkdir bl-vault-dir) (λ m1 →
        bind (h-capture (cons "/bin/chmod" (cons "700" (cons bl-vault-dir nil)))) (λ c1 →
        bind bl-urandom32-hex (λ hex64 →
          let priv = h-be (eth-from-hex hex64)
          in if andB (%wlt #0 priv) (%wlt priv secp-n)
             then bind (h-write bl-key-path (h-line hex64)) (λ w1 →
                  bind (h-capture (cons "/bin/chmod" (cons "600" (cons bl-key-path nil)))) (λ c2 →
                  ret {lzero} {W} priv))
             else bind (h-fail "CSPRNG scalar out of range") (λ u2 → ret {lzero} {W} #0)))))

-- JSON-RPC helper over `/usr/bin/curl` (runs live when outside sandbox):
bl-rpc-post : List Word → Proc W (List Word)
bl-rpc-post jsonBody =
  bind (h-capture
    (cons "/usr/bin/curl"
    (cons "-sS" (cons "--max-time" (cons "10"
    (cons "-H" (cons "Content-Type: application/json"
    (cons "-d" (cons jsonBody (cons bl-rpc-url nil)))))))))) (λ r →
    if %weq (fst r) #0 then ret {lzero} {W} (snd r) else ret {lzero} {W} "RPC_OFFLINE")

bl-dq : List Word
bl-dq = cons #34 nil

bl-open-0x : List Word
bl-open-0x = cons #34 (cons #48 (cons #120 nil))

bl-extract-json-hex : List Word → List Word
bl-extract-json-hex resp =
  let p1 = h-after (h-quote "result") resp
      p2 = h-after bl-open-0x p1
  in h-before bl-dq p2

-- Parse hex string to `Word` bignum:
bl-hex-to-word-go : Word → List Word → Word
bl-hex-to-word-go acc nil         = acc
bl-hex-to-word-go acc (cons c cs) = bl-hex-to-word-go (%wadd (%wshl acc #4) (eth-nib-val c)) cs

bl-hex-to-word : List Word → Word
bl-hex-to-word s = bl-hex-to-word-go #0 (eth-strip-0x s)

bl-thm-rpc-hex-parse-8453 :
  let s1 = h-concat (cons "{" (cons (h-quote "result") (cons ":" (cons (h-quote "0x2105") (cons "}" nil)))))
      s2 = h-concat (cons "{" (cons (h-quote "result") (cons ": " (cons (h-quote "0x2105") (cons "}" nil)))))
  in andB (%weq (bl-hex-to-word (bl-extract-json-hex s1)) #8453)
          (%weq (bl-hex-to-word (bl-extract-json-hex s2)) #8453) ≡ true
bl-thm-rpc-hex-parse-8453 = refl

bl-rpc-call : List Word → List Word → Proc W (List Word)
bl-rpc-call method paramsJson =
  let req = h-concat
              (cons "{" (cons (h-quote "jsonrpc") (cons ":" (cons (h-quote "2.0")
              (cons "," (cons (h-quote "id") (cons ":1,"
              (cons (h-quote "method") (cons ":" (cons (h-quote method)
              (cons "," (cons (h-quote "params") (cons ":" (cons paramsJson (cons "}" nil)))))))))))))))
  in bl-rpc-post req

-- Subcommand `keygen`: generates/loads 0600 key, runs cold EIP-1559 + ecrecover self-test on the LIVE key,
-- computes deterministic Vault address at nonce 0, and prints ONLY public addresses!
bl-cmd-keygen : Proc W Unit
bl-cmd-keygen =
  bind bl-load-or-gen-key (λ priv →
    let rel20    = eth-priv-to-addr20 priv
        relEip55 = eth-eip55-from-bytes20 rel20
        vlt20    = eth-create-addr20 rel20 #0
        vltEip55 = eth-eip55-from-bytes20 vlt20
        initB    = evm-vault-initcode rel20
        testTx   = mk-tx1559 #8453 #0 #1000000 #50000000 #250000 nil #0 initB
        sigOk    = eth-tx1559-selfcheck priv testTx
        fndEip55 = eth-eip55-from-bytes20 eth-founder-coinbase-addr20
    in if eth-not sigOk
       then h-fail "CRITICAL: Live key EIP-1559 ecrecover self-check failed!"
       else
         let summary = h-concat
               (cons "[HX-BASE-LIVE | CHAIN ID 8453 (BASE MAINNET) SOVEREIGN VAULT READY]" (cons (cons #10 nil)
               (cons "  1. Gas Deposit / Relayer Address (Base ETH) : " (cons relEip55 (cons (cons #10 nil)
               (cons "  2. Deterministic Vault Address (at nonce 0) : " (cons vltEip55 (cons (cons #10 nil)
               (cons "  3. Hardcoded Founder Payout (Coinbase Base) : " (cons fndEip55 (cons (cons #10 nil)
               (cons "  4. Zero-solc EVM Initcode Size              : " (cons (h-decimal (fromNat (list-length initB)))
               (cons " bytes (ecrecover_selfcheck=PASS, private_key_mode=0600_VAULT_ONLY)" (cons (cons #10 nil) nil)))))))))))))))
         in bind (h-write bl-meta-path summary) (λ wm →
            h-out summary))

-- Subcommand `status`: queries live Base Mainnet balances & nonce!
bl-cmd-status : Proc W Unit
bl-cmd-status =
  bind bl-load-or-gen-key (λ priv →
    let rel20    = eth-priv-to-addr20 priv
        relEip55 = eth-eip55-from-bytes20 rel20
        vlt20    = eth-create-addr20 rel20 #0
        vltEip55 = eth-eip55-from-bytes20 vlt20
        fndEip55 = eth-eip55-from-bytes20 eth-founder-coinbase-addr20
    in bind (bl-rpc-call "eth_chainId" "[]") (λ rCid →
       bind (bl-rpc-call "eth_getBalance" (h-concat (cons "[" (cons (h-quote relEip55) (cons "," (cons (h-quote "latest") (cons "]" nil))))))) (λ rBal →
       bind (bl-rpc-call "eth_getTransactionCount" (h-concat (cons "[" (cons (h-quote relEip55) (cons "," (cons (h-quote "latest") (cons "]" nil))))))) (λ rNc →
       bind (bl-rpc-call "eth_getBalance" (h-concat (cons "[" (cons (h-quote fndEip55) (cons "," (cons (h-quote "latest") (cons "]" nil))))))) (λ rFnd →
         let cidW = bl-hex-to-word (bl-extract-json-hex rCid)
             balW = bl-hex-to-word (bl-extract-json-hex rBal)
             ncW  = bl-hex-to-word (bl-extract-json-hex rNc)
             fndW = bl-hex-to-word (bl-extract-json-hex rFnd)
         in h-out (h-concat
              (cons "[HX-BASE-LIVE | LIVE RPC STATUS]" (cons (cons #10 nil)
              (cons "  chain_id=" (cons (h-decimal cidW)
              (cons " | relayer=" (cons relEip55
              (cons " (wei=" (cons (h-decimal balW)
              (cons ", nonce=" (cons (h-decimal ncW)
              (cons ") | vault=" (cons vltEip55
              (cons " | founder=" (cons fndEip55
              (cons " (wei=" (cons (h-decimal fndW) (cons ")" (cons (cons #10 nil) nil))))))))))))))))))))))))

-- Subcommand `deploy`: signs & broadcasts EIP-1559 Base contract creation tx!
bl-cmd-deploy : Proc W Unit
bl-cmd-deploy =
  bind bl-load-or-gen-key (λ priv →
    let rel20    = eth-priv-to-addr20 priv
        relEip55 = eth-eip55-from-bytes20 rel20
        initB    = evm-vault-initcode rel20
    in bind (bl-rpc-call "eth_getBalance" (h-concat (cons "[" (cons (h-quote relEip55) (cons "," (cons (h-quote "latest") (cons "]" nil))))))) (λ rBal →
       bind (bl-rpc-call "eth_getTransactionCount" (h-concat (cons "[" (cons (h-quote relEip55) (cons "," (cons (h-quote "latest") (cons "]" nil))))))) (λ rNc →
       bind (bl-rpc-call "eth_gasPrice" "[]") (λ rGp →
         let balW = bl-hex-to-word (bl-extract-json-hex rBal)
             ncW  = bl-hex-to-word (bl-extract-json-hex rNc)
             gpW  = bl-hex-to-word (bl-extract-json-hex rGp)
             mfee = %wadd (%wmul gpW #2) #2000000
             prio = #1000000
             gasL = #300000
             reqW = %wmul mfee gasL
         in if %wlt balW reqW
            then h-fail (list-append "AWAITING_BASE_GAS_SEED_AT_" relEip55)
            else
              let tx  = mk-tx1559 #8453 ncW prio mfee gasL nil #0 initB
                  ok  = eth-tx1559-selfcheck priv tx
                  raw = fst (eth-tx1559-sign-raw priv tx)
                  rHx = list-append "0x" (h-hex raw)
              in if eth-not ok then h-fail "ecrecover pre-broadcast check failed"
                 else bind (bl-rpc-call "eth_sendRawTransaction" (h-concat (cons "[" (cons (h-quote rHx) (cons "]" nil))))) (λ rTx →
                      h-out (h-concat (cons "[HX-BASE-LIVE | DEPLOY TX BROADCAST] " (cons rTx (cons (cons #10 nil) nil)))))))))

-- Subcommand `return-gas`: returns remaining ETH on relayer straight back to founder `0x4A50...A26f`!
bl-cmd-return-gas : Proc W Unit
bl-cmd-return-gas =
  bind bl-load-or-gen-key (λ priv →
    let rel20    = eth-priv-to-addr20 priv
        relEip55 = eth-eip55-from-bytes20 rel20
    in bind (bl-rpc-call "eth_getBalance" (h-concat (cons "[" (cons (h-quote relEip55) (cons "," (cons (h-quote "latest") (cons "]" nil))))))) (λ rBal →
       bind (bl-rpc-call "eth_getTransactionCount" (h-concat (cons "[" (cons (h-quote relEip55) (cons "," (cons (h-quote "latest") (cons "]" nil))))))) (λ rNc →
       bind (bl-rpc-call "eth_gasPrice" "[]") (λ rGp →
         let balW = bl-hex-to-word (bl-extract-json-hex rBal)
             ncW  = bl-hex-to-word (bl-extract-json-hex rNc)
             gpW  = bl-hex-to-word (bl-extract-json-hex rGp)
             mfee = %wadd (%wmul gpW #2) #2000000
             cost = %wmul mfee #25000
         in if eth-le balW cost
            then h-fail "Relayer balance below 21000-gas L2 fee"
            else
              let sendVal = %wsub balW cost
                  tx      = mk-tx1559 #8453 ncW #1000000 mfee #21000 eth-founder-coinbase-addr20 sendVal nil
                  raw     = fst (eth-tx1559-sign-raw priv tx)
                  rHx     = list-append "0x" (h-hex raw)
              in bind (bl-rpc-call "eth_sendRawTransaction" (h-concat (cons "[" (cons (h-quote rHx) (cons "]" nil))))) (λ rTx →
                   h-out (h-concat (cons "[HX-BASE-LIVE | RETURNED GAS TO FOUNDER COINBASE] " (cons rTx (cons (cons #10 nil) nil)))))))))

bl-dispatch : List (List Word) → Proc W Unit
bl-dispatch nil         = bl-cmd-keygen
bl-dispatch (cons c rs) =
  if h-eq c "status" then bl-cmd-status
  else if h-eq c "deploy" then bl-cmd-deploy
  else if h-eq c "return-gas" then bl-cmd-return-gas
  else bl-cmd-keygen

bl-entry : Proc W Unit
bl-entry = bind h-args (λ argv → bl-dispatch (h-tail-lists argv))
