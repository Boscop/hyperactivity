data EvmInst : Type where
  ev-op   : Word → EvmInst
  ev-push : List Word → EvmInst
  ev-lbl  : Word → EvmInst
  ev-jmpi : Word → EvmInst
  ev-jmp  : Word → EvmInst

evm-inst-size : EvmInst → Word
evm-inst-size (ev-op op)   = #1
evm-inst-size (ev-push bs) =
  let n = fromNat (list-length bs)
  in if %weq n #0 then #2 else %wadd #1 n
evm-inst-size (ev-lbl l)   = #1
evm-inst-size (ev-jmpi l)  = #4
evm-inst-size (ev-jmp l)   = #4

evm-pass1 : Word → List EvmInst → List (Word × Word)
evm-pass1 pc nil                   = nil
evm-pass1 pc (cons (ev-lbl l) ins) = cons (l , pc) (evm-pass1 (%wadd pc #1) ins)
evm-pass1 pc (cons inst ins)       = evm-pass1 (%wadd pc (evm-inst-size inst)) ins

evm-lookup-lbl : Word → List (Word × Word) → Word
evm-lookup-lbl l nil         = #0
evm-lookup-lbl l (cons p ps) = if %weq l (fst p) then snd p else evm-lookup-lbl l ps

evm-u16-be : Word → List Word
evm-u16-be w = cons (%wand (%wshr w #8) #255) (cons (%wand w #255) nil)

evm-emit-inst : List (Word × Word) → EvmInst → List Word
evm-emit-inst tbl (ev-op op)   = cons op nil
evm-emit-inst tbl (ev-push bs) =
  let n = fromNat (list-length bs)
  in if %weq n #0 then cons #96 (cons #0 nil) else cons (%wadd #95 n) bs
evm-emit-inst tbl (ev-lbl l)   = cons #91 nil
evm-emit-inst tbl (ev-jmpi l)  =
  let dst = evm-lookup-lbl l tbl
  in cons #97 (list-append (evm-u16-be dst) (cons #87 nil))
evm-emit-inst tbl (ev-jmp l)   =
  let dst = evm-lookup-lbl l tbl
  in cons #97 (list-append (evm-u16-be dst) (cons #86 nil))

evm-pass2 : List (Word × Word) → List EvmInst → List Word
evm-pass2 tbl nil         = nil
evm-pass2 tbl (cons i is) = list-append (evm-emit-inst tbl i) (evm-pass2 tbl is)

evm-assemble : List EvmInst → List Word
evm-assemble prog = evm-pass2 (evm-pass1 #0 prog) prog

-- Universal 12-byte EVM creation (`initcode`) wrapper copying `L` runtime bytes to mem[0..L] & returning:
evm-wrap-initcode : List Word → List Word
evm-wrap-initcode rt =
  let len = fromNat (list-length rt)
      hdr = list-append (cons #97 (evm-u16-be len))
              (cons #128 (cons #96 (cons #12 (cons #96 (cons #0 (cons #57 (cons #96 (cons #0 (cons #243 nil)))))))))
  in list-append hdr rt

-- Deterministic Ethereum CREATE address: `keccak256(RLP([sender20, nonce]))[12..32]`
eth-create-addr20 : List Word → Word → List Word
eth-create-addr20 sender20 nonce =
  kc-drop (toNat #12) (keccak256 (rlp-list (cons (rlp-bytes sender20) (cons (rlp-uint nonce) nil))))

