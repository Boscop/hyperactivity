-- (8.13), (8.14), (8.15) load_p(increment(s)) = load_p(s) +₃₂ 1
increment-load : {S : Type} → (load : S → Word32) → (store : S → Word32 → S) → ((s : S) → (w : Word32) → load (store s w) ≡ w) →
  (s : S) → load (increment load store s) ≡ add32 (load s) word-one
increment-load {S} load store ls s = ls s (add32 (load s) word-one)
