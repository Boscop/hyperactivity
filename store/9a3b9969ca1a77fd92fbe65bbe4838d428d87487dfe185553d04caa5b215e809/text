-- x ≤ y (ltw y x = false) and y < z (ltw y z = true) implies x < z
cm-le-lt-step : (x : Word) → ((y z : Word) → ltw y x ≡ false → ltw y z ≡ true → ltw x z ≡ true) →
                (y z : Word) → ltw y (%wsucc x) ≡ false → ltw y z ≡ true → ltw (%wsucc x) z ≡ true
cm-le-lt-step x ih y =
  %welimP (λ v → (z : Word) → ltw v (%wsucc x) ≡ false → ltw v z ≡ true → ltw (%wsucc x) z ≡ true) y
    (λ z h1 h2 → cm-tf-absurd h1)
    (λ y1 gy z →
       %welimP (λ v → ltw (%wsucc y1) (%wsucc x) ≡ false → ltw (%wsucc y1) v ≡ true → ltw (%wsucc x) v ≡ true) z
         (λ h1 h2 → cm-ft-absurd h2)
         (λ z1 gz h1 h2 → ih y1 z1 h1 h2))
