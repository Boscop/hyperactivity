try-hyp : (ETm → OTrace) → Eqs → Pos → Word → Word → ETm → OTrace
try-hyp deeper hs p n i s =
  %welimP (λ v → Word → OTrace) n (λ i → notr)
    (λ k h i →
       (case try-dir deeper hs p i false s return (λ w → OTrace) of
          atrace tr → atrace tr
          notr → (case try-dir deeper hs p i true s return (λ w → OTrace) of atrace tr → atrace tr; notr → h (%wsucc i))))
  i
