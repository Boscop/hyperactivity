-- block bb of instance i
rm-prog-go : List RInstance → Target → RCrate → Word → Word → RBlockFn
rm-prog-go nil t c = λ i bb call fr → rm-throw (rx-ill-formed (ri-no-body i))
rm-prog-go (cons x xs) t c =
  rm-tcons {Word → RBlockFn}
    (sr-on (rm-inst-cx t c x) (λ e bb call fr → rm-throw e) (λ cb → rm-blocks (rb-blocks (snd cb)) (fst cb)))
    (rm-prog-go xs t c)
