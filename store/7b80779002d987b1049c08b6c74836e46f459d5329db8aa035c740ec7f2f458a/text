-- the term of Racah's sum at t, its magnitude: the a's and b's already halved
sixj-term : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → QP
sixj-term a1 a2 a3 a4 b1 b2 b3 t = (fact (suc t) , times (times (fact (monus t a1)) (fact (monus t a2))) (times (times (fact (monus t a3)) (fact (monus t a4))) (times (fact (monus b1 t)) (times (fact (monus b2 t)) (fact (monus b3 t))))))
