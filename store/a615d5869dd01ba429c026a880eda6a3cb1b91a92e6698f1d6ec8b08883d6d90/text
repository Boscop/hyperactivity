path-ty-ren : (a : TyShape) → CRenT a → (Δ : CCtx) (T : Mean Δ (Sem (s-path a))) → CompTy (s-path a) Δ T → (Δ' : CCtx) (w : World Δ' Δ) →
  CompTy (s-path a) Δ' (wact Δ' Δ w (Sem (s-path a)) T)
path-ty-ren a Ra Δ T ct Δ' w =
  ((λ Δ2 w2 f cf nc →
      ty-tr a Δ2 (papp-line Δ2 (Sem (s-path a)) (Sem a) (ty-line a) f (wact Δ2 Δ (world-comp Δ2 Δ' Δ w2 w) (Sem (s-path a)) T))
        (papp-line Δ2 (Sem (s-path a)) (Sem a) (ty-line a) f (wact Δ2 Δ' w2 (Sem (s-path a)) (wact Δ' Δ w (Sem (s-path a)) T)))
        (λ i → papp-line Δ2 (Sem (s-path a)) (Sem a) (ty-line a) f (subM-comp Δ2 Δ' Δ w2 w (Sem (s-path a)) T i))
        (fst ct Δ2 (world-comp Δ2 Δ' Δ w2 w) f cf nc)) ,
   comp-fm a Δ' Δ w (Sem (s-path a)) (tend-0 a) T (csof-ren a Ra Δ (fmapM Δ (Sem (s-path a)) (TV a) (tend-0 a) T) (fst (snd ct)) Δ' w) ,
   comp-fm a Δ' Δ w (Sem (s-path a)) (tend-1 a) T (csof-ren a Ra Δ (fmapM Δ (Sem (s-path a)) (TV a) (tend-1 a) T) (snd (snd ct)) Δ' w))
