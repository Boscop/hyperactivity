-- an object received, taken into the pool by the machine m when its hash is h
h-put : List Word → List Word → List Word → List Word → Proc W Bool
h-put m h k t = bind (h-write "build/put" t) (λ b → bind (h-capture (cons m (cons "--put" (cons h (cons k (cons "build/put" nil)))))) (λ r → ret (weq (fst r) #0)))
