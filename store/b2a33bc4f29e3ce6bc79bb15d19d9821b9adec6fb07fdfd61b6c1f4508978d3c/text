nk-side-split : NkTm → NkTm → NkTm → NkTm
nk-side-split (nk-op h c (nk-cons r z)) body rest = if %weq h #7 then nk-cons (nk-br c (nk-restr c body)) (nk-side-split r body rest) else nk-cons (nk-br (nk-op h c (nk-cons r z)) (nk-restr (nk-op h c (nk-cons r z)) body)) rest
nk-side-split t body rest = nk-cons (nk-br t (nk-restr t body)) rest
