loop-ok : (t : List (List Word)) → (fuel h0 : Nat) → (r : List Word) → DblInv t (suc h0) r → FinalP t (loop t fuel h0 r)
loop-ok t fuel =
  case fuel return λ w → (h0 : Nat) → (r : List Word) → DblInv t (suc h0) r → FinalP t (loop t w h0 r) of
    zero → λ h0 r inv → (rk {suffix-ord} (key-tree {suffix-ord} (sufs t)) , (λ i → ranks-of {suffix-ord} (sufs t)) , λ s s' m m' → rank-prop {suffix-ord} (sufs t) s s' m')
    suc g →
      λ h0 r inv →
        ifP {λ bb → FinalP t (if bb then loop t g (plus h0 (suc h0)) (round (suc h0) r) else r)} {ltn (suc h0) (list-length t)}
          (λ e → rec g (plus h0 (suc h0)) (round (suc h0) r) (round-ok t h0 r inv))
          (λ e → ( fst inv , fst (snd inv)
                 , λ s s' m m' → tr (leq {suffix-ord} (take-n (suc h0) s) (take-n (suc h0) s')) (fst (snd (snd inv)) s s' m m')
                                    (λ i → leq {suffix-ord} (mem-short t (suc h0) s m e i) (mem-short t (suc h0) s' m' e i))))
