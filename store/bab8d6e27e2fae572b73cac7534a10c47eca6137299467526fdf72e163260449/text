-- a row of ⟨(H_g − λ)φ, (H_g − μ)φ⟩ = H2 − (λ + μ)·Hm + λμ·S (Temple's form: it has a negative direction on the span
-- exactly when some vector's Temple quotient is above λ; not the certificate of this module's head)
pl-t-row : BQ → BQ → BQ → BQ → List BQ → List BQ → List (BQ × (BQ × BQ)) → List BQ
pl-t-row sm pr l p hs ss ws = case hs of
  nil → nil
  cons h hr → (case ss of
    nil → nil
    cons s sr → (case ws of
      nil → nil
      cons w wr → cons (bq-add (fn-sub (pl-val l p w) (bq-mul sm h)) (bq-mul pr s)) (pl-t-row sm pr l p hr sr wr)))
