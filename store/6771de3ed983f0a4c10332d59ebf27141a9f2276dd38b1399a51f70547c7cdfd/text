-- row i of the Laplacian over the vertices vs: the lines leaving i on the diagonal, less the lines
-- joining i and j elsewhere
lap-row : List FaradayLine → Nat → List Nat → List ZP
lap-row ls i vs = case vs of
  nil → nil
  cons j rest → cons (if eqb i j then (line-deg i ls , zero) else (zero , line-mult i j ls)) (lap-row ls i rest)
