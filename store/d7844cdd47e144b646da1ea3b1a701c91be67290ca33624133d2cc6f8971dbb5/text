-- subtraction returns a canonical number
subb-canon : (a : List Bool) → (c : Bool) → (b : List Bool) → bcanon (bin-subb c a b) ≡ true
subb-canon a = case a return λ m → (c : Bool) → (b : List Bool) → bcanon (bin-subb c m b) ≡ true of
  nil → λ c b → λ i → true
  cons x xs → λ c b → bin-cons-canon (bit-eq (bit-eq x (bin-head b)) c) (bin-subb (borrow3 x (bin-head b) c) xs (bin-tail b)) (rec xs (borrow3 x (bin-head b) c) (bin-tail b))
