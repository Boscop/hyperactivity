-- a text recorded as the module at a path by the machine m (the reader cuts a .cub into its
-- declarations; any other document is held whole)
h-record-raw : List Word → List Word → List Word → Proc W Unit
h-record-raw m path t = bind (h-write "build/record" t) (λ b →
  bind (h-capture (cons m (cons "--record" (cons path (cons "build/record" nil))))) (λ r → ret unit))
