-- one step: rewrite if the subterm is the instance of the equation's side, else leave the term
step : Eqs → Pos → Word → Bool → Subst → ETm → ETm
step hs p i d σ t =
  case tm-same (subterm p t) (tsubst σ (lhs d (hyp-at i hs))) return (λ w → ETm) of
    true → replace p (tsubst σ (rhs d (hyp-at i hs))) t
    false → t
