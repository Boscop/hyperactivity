-- One branch of tr(σ_z M_e) where M on the attached vertex has minimal polynomial x(x − μ): there √V = μ^{1/8}/√2 · M/μ,
-- so the branch is μ^{1/8}/√2 times the rational map R σ_z (M/μ) E, weighted (d′+1)/(d+1). Returned: that rational map
-- (without μ^{1/8}/√2) on vectors over the weight-zero monomials of ds.
tz-proj-branch : Bool → Nat → List Nat → List Triple → SQ → Rows → Rows
tz-proj-branch s e ds ts mu vs = mat-scale (sq-mul (side-weight s e ds) (sq-inv mu))
  (rows-map-entry (sigma-entry (if s then rplus-entry e (ds-plus e ds) else rminus-entry e (ds-minus e ds))) (mons0 ds) (mons0 (sp-ds s e ds))
    (to-mons (vm-of (sp-ds s e ds) ts) (rows-apply-all (snd (vm-of (sp-ds s e ds) ts)) (to-coords (vm-of (sp-ds s e ds) ts) (e-map s e ds vs)))))
