sg-check-file : NkTm → NkTm → List Word → Proc W Bool
sg-check-file ks1 ks2 p =
  bind (h-read p) (λ res →
    case res return (λ _ → Proc W Bool) of
      inl _ → bind (h-out (h-line (list-append "missing " p))) (λ _ → ret false)
      inr txt →
        if sg-check-2 p ks1 ks2 txt
          then bind (h-out (h-line (list-append "ok " p))) (λ _ → ret true)
          else bind (h-out (h-line (list-append "refused " p))) (λ _ → ret false))
