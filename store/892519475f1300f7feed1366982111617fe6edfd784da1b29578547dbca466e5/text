-- rm-copy depth target layouts type dst-alignment src-alignment dst src
rm-copy : Word → Target → List RLayoutEntry → RTy → Word → Word → MPtr → MPtr → REv Unit
rm-copy d t ls =
  %welimP (λ x → RTy → Word → Word → MPtr → MPtr → REv Unit) d
    (λ ty da sa dst src → rm-throw (rx-ill-formed ri-layout-depth))
    (λ k cpy ty da sa → sr-on (rm-class t ty) (λ e dst src → rm-throw e) (λ c → case c of
       cl-mem → rm-copy-mem cpy t ls ty da sa
       cl-unit → λ dst src → rm-ret unit
       cl-scalar sk → λ dst src → rm-bind (rm-rd-at t (cl-scalar sk) sa src) (rm-wr-at t (cl-scalar sk) da dst)
       cl-fat mk → λ dst src → rm-bind (rm-rd-at t (cl-fat mk) sa src) (rm-wr-at t (cl-fat mk) da dst)))
