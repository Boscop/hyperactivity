v-keep-with : List Word → VEnv → Proc W Unit
v-keep-with st env =
  let dir = list-append st "/views/" in
  let tmp = list-append dir "graph.json.tmp" in
  let dst = list-append dir "graph.json" in
  bind (v-open-trunc tmp) (λ fd →
  bind (fd-write fd (list-append "{" (list-append (j-str "nodes") ":["))) (λ w0 →
  bind (v-stream-nodes env dir fd true (ve-names env)) (λ sp →
  bind (fd-write fd (list-append "]," (list-append (j-str "roots") (list-append ":" (list-append (j-strs (ve-roots env)) "}"))))) (λ w1 →
  bind (sys-call #3 fd #0 #0 #0 #0 #0) (λ cl →
  bind (v-rename tmp dst) (λ rn →
  let gp = v-step-all (v-node-problems env) (ve-names env) in
  let ps = list-append gp sp in
  bind (h-write (list-append dir "problems") (v-lines ps)) (λ b0 →
  bind (h-write (list-append dir "check") (list-append (v-lines ps) (v-summary (list-length (ve-names env)) ps))) (λ b1 →
  bind (h-write (list-append dir "nodes") (h-concat (list-map (λ i → h-line (v-joined " " (cons i (v-look-list i (ve-ptab env))))) (ve-names env)))) (λ b2 →
  bind (h-write (list-append dir "roots") (h-concat (list-map h-line (ve-roots env)))) (λ b3 →
  bind (h-write (list-append dir "tree") (v-tree-of env)) (λ b4 →
  bind (h-write (list-append dir "order") (v-order-of env)) (λ b5 →
  bind (v-read-shows dir (ve-ip env)) (λ ip-txt →
  bind (h-write (list-append dir "open") (v-open-of env ip-txt)) (λ b6 →
  bind (h-read (list-append h-index "/meta/root")) (λ rt →
  bind (h-write (list-append dir "stamp") (v-or-nil rt)) (λ b7 →
  bind (h-write (list-append dir "source-stamp") (v-or-nil rt)) (λ b8 →
  exit #0)))))))))))))))))
