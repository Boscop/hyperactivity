par-move : {CP CQ M N E : Type} → ParMove CP CQ M N E → ParState CP CQ M N → ParState CP CQ M N
par-move (pm-local-p p2) s = (p2 , fst (snd s) , fst (snd (snd s)) , snd (snd (snd s)))
par-move (pm-local-q q2) s = (fst s , q2 , fst (snd (snd s)) , snd (snd (snd s)))
par-move (pm-send-p m p2) s = (p2 , fst (snd s) , list-append (fst (snd (snd s))) (cons m nil) , snd (snd (snd s)))
par-move (pm-send-q n q2) s = (fst s , q2 , fst (snd (snd s)) , list-append (snd (snd (snd s))) (cons n nil))
par-move (pm-recv-q q2) s = (fst s , q2 , par-tail (fst (snd (snd s))) , snd (snd (snd s)))
par-move (pm-recv-p p2) s = (p2 , fst (snd s) , fst (snd (snd s)) , par-tail (snd (snd (snd s))))
par-move (pm-ext-p e p2) s = (p2 , fst (snd s) , fst (snd (snd s)) , snd (snd (snd s)))
par-move (pm-ext-q e q2) s = (fst s , q2 , fst (snd (snd s)) , snd (snd (snd s)))
