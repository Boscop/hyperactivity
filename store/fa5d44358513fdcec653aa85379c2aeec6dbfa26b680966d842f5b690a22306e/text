-- tr M_e at the vertex with doubled spins ds and orientation ts, edge e: the side through 2j + 1 and, where
-- j > 0, the side through 2j − 1
edge-trace : Nat → List Nat → List Triple → List Side
edge-trace e ds ts = cons (side-of e ds (ds-plus e ds) ts (eplus-entry e ds) (rplus-entry e (ds-plus e ds)) (t-minpoly (ds-plus e ds) ts))
  (if eqb (exp-at e ds) zero then nil else cons (side-of e ds (ds-minus e ds) ts (eminus-entry e ds) (rminus-entry e (ds-minus e ds)) (t-minpoly (ds-minus e ds) ts)) nil)
