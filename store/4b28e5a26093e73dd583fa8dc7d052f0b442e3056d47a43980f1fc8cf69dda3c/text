cs-subw-lt-succ : (m n : Word) → ltw (subw m n) (%wsucc m) ≡ true
cs-subw-lt-succ m n =
  %welimP (λ u → (v : Word) → ltw (subw u v) (%wsucc u) ≡ true) m
    (λ v → refl)
    (λ m0 hm v →
       %welimP (λ w → ltw (subw (%wsucc m0) w) (%wsucc (%wsucc m0)) ≡ true) v
         (cs-ltw-succ (%wsucc m0))
         (λ n0 hn → cs-ltw-step (subw m0 n0) (%wsucc m0) (hm n0)))
    n
