ossc-frontier-master : OsEffect
ossc-frontier-master = ossc-eff-all (
  cons (eff-view ed-mono dp-full fl-light #0) (
  cons (eff-mount-ui "PART I · SCALE" ossc-supercomp-ui) (
  cons (eff-mount-ui "PART II · TOWER & CLOSURE" ossc-tower-ui) (
  cons (eff-mount-ui "PART III · EXACT WET-LAB" ossc-wetlab-ui) (
  cons (eff-mount-ui "PART IV · HYPERACTIVITY OS & THIS" ossc-this-ui) nil)))))
