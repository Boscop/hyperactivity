hxn-settle : Word → Word → Word → Word → SRState → Word × (Word × Word)
hxn-settle key escrow bal len frame =
  let dec = cfs-dec-list sr-sample-L sr-sample-fuel (toNat len) cfs-sample-init-ctx frame
      v   = %weq (hxn-digest dec) key
  in if v then (#1 , (#0 , %wadd bal escrow)) else (#0 , (escrow , bal))
