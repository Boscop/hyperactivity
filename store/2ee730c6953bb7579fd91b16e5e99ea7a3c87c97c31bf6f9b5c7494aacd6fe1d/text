-- every chunk with its title
w-titled : List Word → Nat → Nat → List (List Word) → List (List Word × List Word)
w-titled label j n nil = nil
w-titled label j n (cons c r) =
  cons ((if h-eq (h-decimal (fromNat n)) "1" then label else list-append label (list-append ", part " (list-append (h-decimal (fromNat (suc j))) (list-append " of " (h-decimal (fromNat n)))))) , c)
    (w-titled label (suc j) n r)
