-- HTML: text escaped, and Markdown's inline marks (`code`, **bold**, *italic*)
s-esc : List Word → List Word
s-esc nil = nil
s-esc (cons x r) =
  if weq x #38 then list-append "&amp;" (s-esc r) else
  if weq x #60 then list-append "&lt;" (s-esc r) else
  if weq x #62 then list-append "&gt;" (s-esc r) else
  if weq x #34 then list-append "&quot;" (s-esc r) else
  if weq x #39 then list-append "&#x27;" (s-esc r) else cons x (s-esc r)
