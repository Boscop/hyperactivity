-- Φ(m,n) at √V → 1, on vectors of the vertex holding H_p's leg: Σ_k coeff_k · kind k; it is 0 (A = √V − M = 0)
unit-phi : Nat → Nat → List Nat → Rows → Rows
unit-phi n m dsP rs = mat-plus (mat-plus (mat-scale (kind-coeff 1) (unit-kind 1 n m dsP rs)) (mat-scale (kind-coeff 2) (unit-kind 2 n m dsP rs)))
  (mat-plus (mat-plus (mat-scale (kind-coeff 3) (unit-kind 3 n m dsP rs)) (mat-scale (kind-coeff 4) (unit-kind 4 n m dsP rs))) (mat-scale (kind-coeff 5) (unit-kind 5 n m dsP rs)))
