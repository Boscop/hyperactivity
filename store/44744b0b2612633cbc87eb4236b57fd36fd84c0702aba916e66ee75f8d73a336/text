sf-project-file : List Word → List Word → List (List Word × List Word) → Word → Proc W Word
sf-project-file src dst patches expected =
  bind (h-read src) (λ mt →
    case mt of
      inl e → bind (h-say (list-append "ERR read: " (list-append src sf-nl))) (λ u → ret {lzero} {W} #0)
      inr txt →
        let res = sf-apply-patches patches txt
            cnt = fst res
            out = snd res
        in bind (h-write dst out) (λ u1 →
           bind (h-say (h-concat (cons "[SITE-FRONTIER] " (cons dst (cons " | patches=" (cons (ce-dec cnt) (cons "/" (cons (ce-dec expected) (cons " | bytes=" (cons (ce-dec (fromNat (list-length out))) (cons sf-nl nil))))))))))) (λ u2 →
           ret {lzero} {W} (if %weq cnt expected then #1 else #0))))

