// Pure high-contrast chamfered-pill (V_*) and sharp-rect (O_*) cells
function drawSpaciousCell(ctx, c, sx, sy, sc, isLight, ink, accent, isHover) {
  const birth = Math.min(1, 0.35 + c.age * 1.9);
  const s = sc * birth;
  const isCubical = ['V_PLAM','V_IV','V_SYS','V_GLUE','V_GLUEV','O_PAPPP','O_SUBST','O_COMP','O_UNGLUE'].includes(c.kind);
  const w = Math.max(66, c.label.length * 9 + 26);
  const h = c.sub ? 42 : 34;

  ctx.save();
  ctx.translate(sx, sy);
  ctx.scale(s, s);

  if (c.polarity === 'root') {
    ctx.fillStyle = isLight ? '#000' : '#fff';
    ctx.fillRect(-36, -15, 72, 30);
    ctx.fillStyle = isLight ? '#fff' : '#000';
    ctx.font = '800 11.5px ui-monospace, Menlo, monospace';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText('OUT', 0, 1);
    ctx.restore(); return;
  }

  ctx.beginPath();
  if (c.polarity === 'val') {
    const ch = isCubical ? 11 : 16;
    ctx.moveTo(-w/2 + ch, -h/2);
    ctx.lineTo(w/2 - ch, -h/2);
    ctx.lineTo(w/2, -h/2 + ch);
    ctx.lineTo(w/2, h/2 - ch);
    ctx.lineTo(w/2 - ch, h/2);
    ctx.lineTo(-w/2 + ch, h/2);
    ctx.lineTo(-w/2, h/2 - ch);
    ctx.lineTo(-w/2, -h/2 + ch);
    ctx.closePath();
  } else {
    ctx.rect(-w/2, -h/2, w, h);
  }
  ctx.fillStyle = isLight ? '#ffffff' : '#000000';
  ctx.fill();
  ctx.lineWidth = isHover ? 3 : 2;
  ctx.strokeStyle = accent;
  ctx.stroke();

  // Principal port indicator dot on edge facing principal partner
  const ep0 = c.ports[0];
  if (ep0 && net.cells.has(ep0.cell)) {
    const o = net.cells.get(ep0.cell);
    const pSelf = cellScreenPos(c), pOther = cellScreenPos(o);
    const ang = Math.atan2(pOther.y - pSelf.y, pOther.x - pSelf.x);
    const bx = Math.cos(ang) * (w/2), by = Math.sin(ang) * (h/2);
    ctx.fillStyle = c.polarity === 'val' ? accent : (isLight ? '#fff' : '#000');
    ctx.strokeStyle = accent; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(bx, by, 4, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
  }

  // 21:1 contrast upright typography
  ctx.fillStyle = ink;
  ctx.font = '800 13px ui-monospace, Menlo, monospace';
  ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  ctx.fillText(c.label, 0, c.sub ? -6 : 0);
  if (c.sub) {
    ctx.fillStyle = accent;
    ctx.font = '600 9.5px ui-monospace, Menlo, monospace';
    ctx.fillText(c.sub, 0, 10);
  }
  ctx.restore();
}

function draw() {
  animTime += 0.03;
  net.computeLayouts();

  for (const c of net.cells.values()) {
    c.age += 0.04;
    if (c !== dragCell) {
      c.x += (c.tx - c.x) * 0.14;
      c.y += (c.ty - c.y) * 0.14;
      c.hx += (c.thx - c.hx) * 0.14;
      c.hy += (c.thy - c.hy) * 0.14;
    }
  }

  // Always keep backing buffer synced to container and clear 100% of pixels
  const r = canvas.parentElement.getBoundingClientRect();
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const bw = Math.max(1, Math.round(r.width * dpr)), bh = Math.max(1, Math.round(r.height * dpr));
  if (canvas.width !== bw || canvas.height !== bh) { canvas.width = bw; canvas.height = bh; }
  const W = r.width, H = r.height;
  const isLight = !document.documentElement.classList.contains('dark');
  const ink = isLight ? '#000000' : '#ffffff';
  ctx.setTransform(1, 0, 0, 1, 0, 0);
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

  if (hypMode) {
    const { cx, cy, R } = getDiskParams();
    ctx.save();
    ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2);
    ctx.clip();
    ctx.strokeStyle = isLight ? 'rgba(0,0,0,0.08)' : 'rgba(255,255,255,0.09)';
    ctx.lineWidth = 1;
    [0.7, 1.4, 2.1].forEach(rh => {
      const rp = Math.tanh(rh / 2) * R;
      ctx.beginPath(); ctx.arc(cx, cy, rp, 0, Math.PI * 2); ctx.stroke();
    });
    ctx.restore();

    ctx.strokeStyle = ink;
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.stroke();
    ctx.fillStyle = ink;
    ctx.font = '700 10px ui-monospace, Menlo, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('∂ℍ² · POINCARÉ DISK (DRAG FOR MÖBIUS TRANSFORM)', cx, cy + R + 18);
  }

  // Wires (pure black/white, #ff0a94 electric pink for active pairs)
  const activeSet = new Set(net.activePairs().map(p => `${Math.min(p.op.id, p.val.id)}-${Math.max(p.op.id, p.val.id)}`));
  const disk = hypMode ? getDiskParams() : null;
  const p2pOn = (typeof p2pCutMode !== 'undefined' && p2pCutMode);
  const cutX = p2pOn ? (hypMode ? disk.cx : Math.round(W / 2 + cam.x * cam.zoom)) : 0;
  const frameCutPorts = [];
  if (p2pOn) drawP2PBackdrop(ctx, W, H, isLight, cutX, disk);

  for (const c of net.cells.values()) {
    for (let p = 0; p < c.ports.length; p++) {
      const ep = c.ports[p]; if (!ep) continue;
      if (ep.cell === c.id && p < ep.port) {
        const sp = cellScreenPos(c);
        ctx.strokeStyle = ink; ctx.lineWidth = 1.8;
        ctx.beginPath();
        ctx.arc(sp.x, sp.y + 24 * sp.scale, 18 * sp.scale, 0, Math.PI);
        ctx.stroke(); continue;
      }
      if (ep.cell <= c.id) continue;
      const o = net.cells.get(ep.cell); if (!o) continue;
      const sp1 = cellScreenPos(c), sp2 = cellScreenPos(o);
      const key = `${Math.min(c.id, o.id)}-${Math.max(c.id, o.id)}`;
      const isActive = (p === 0 && ep.port === 0 && activeSet.has(key));
      const isHover = hoveredPair && ((hoveredPair.op.id === c.id && hoveredPair.val.id === o.id) || (hoveredPair.op.id === o.id && hoveredPair.val.id === c.id));
      const isCrossCut = p2pOn && ((c.peer || 0) !== (o.peer || 0));

      ctx.save();
      if (isActive) {
        ctx.strokeStyle = '#ff0a94'; ctx.lineWidth = isHover ? 4.5 : 3;
      } else {
        ctx.strokeStyle = ink; ctx.lineWidth = 1.8;
      }

      if (hypMode) {
        strokeHyperbolicGeodesic(ctx, disk.cx, disk.cy, disk.R, sp1.z.x, sp1.z.y, sp2.z.x, sp2.z.y, isActive, animTime);
        if (isCrossCut) {
          frameCutPorts.push({ x: cutX, y: (sp1.y + sp2.y) / 2, active: isActive, hover: isHover });
        }
      } else if (isCrossCut) {
        let cutY = (sp1.y + sp2.y) / 2;
        for (let tries = 0; tries < 5; tries++) {
          if (!frameCutPorts.some(fp => Math.abs(fp.y - cutY) < 15)) break;
          cutY += (tries % 2 === 0 ? 1 : -1) * (16 * Math.ceil((tries + 1) / 2));
        }
        frameCutPorts.push({ x: cutX, y: cutY, active: isActive, hover: isHover });
        if (isActive) {
          ctx.beginPath();
          const segs = [[sp1.x, sp1.y, cutX, cutY], [cutX, cutY, sp2.x, sp2.y]];
          let first = true;
          for (let sg = 0; sg < 2; sg++) {
            const [ax, ay, bx, by] = segs[sg];
            const dx = bx - ax, dy = by - ay, len = Math.hypot(dx, dy) || 1;
            const nx = -dy / len, ny = dx / len;
            for (let s = 0; s <= 12; s++) {
              const t = s / 12, w = Math.sin((sg * 0.5 + t * 0.5) * Math.PI * 4 + animTime * 5) * 4 * Math.sin(t * Math.PI);
              const px = ax + dx * t + nx * w, py = ay + dy * t + ny * w;
              if (first) { ctx.moveTo(px, py); first = false; } else ctx.lineTo(px, py);
            }
          }
          ctx.stroke();
        } else {
          const opBlue = isLight ? '#1a73e8' : '#4da3ff';
          const leftPt = (c.peer || 0) === 0 ? sp1 : sp2;
          const rightPt = (c.peer || 0) === 0 ? sp2 : sp1;
          ctx.lineWidth = 2;
          ctx.strokeStyle = ink;
          ctx.beginPath();
          ctx.moveTo(leftPt.x, leftPt.y);
          ctx.bezierCurveTo((leftPt.x + cutX) / 2, leftPt.y, (leftPt.x + cutX) / 2, cutY, cutX, cutY);
          ctx.stroke();
          ctx.strokeStyle = opBlue;
          ctx.beginPath();
          ctx.moveTo(cutX, cutY);
          ctx.bezierCurveTo((rightPt.x + cutX) / 2, cutY, (rightPt.x + cutX) / 2, rightPt.y, rightPt.x, rightPt.y);
          ctx.stroke();
        }
      } else if (isActive) {
        ctx.beginPath();
        const steps = 20, dx = sp2.x - sp1.x, dy = sp2.y - sp1.y, len = Math.hypot(dx, dy) || 1;
        const nx = -dy/len, ny = dx/len;
        for (let s = 0; s <= steps; s++) {
          const t = s/steps, w = Math.sin(t*Math.PI*3 + animTime*5) * 4 * Math.sin(t*Math.PI);
          const px = sp1.x + dx*t + nx*w, py = sp1.y + dy*t + ny*w;
          if (s === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        }
        ctx.stroke();
      } else {
        const midY = (sp1.y + sp2.y) / 2;
        ctx.beginPath();
        ctx.moveTo(sp1.x, sp1.y);
        ctx.bezierCurveTo(sp1.x, midY, sp2.x, midY, sp2.x, sp2.y);
        ctx.stroke();
      }
      ctx.restore();
    }
  }

  // Shockwaves
  for (let i = net.sparks.length - 1; i >= 0; i--) {
    const sp = net.sparks[i]; sp.r += 4.2; sp.alpha -= 0.05;
    if (sp.alpha <= 0) { net.sparks.splice(i, 1); continue; }
    let sx, sy;
    if (hypMode) {
      const m = mobius(sp.hx, sp.hy, hypPan.x, hypPan.y);
      sx = disk.cx + m.x * disk.R; sy = disk.cy + m.y * disk.R;
    } else {
      sx = W/2 + (sp.x + cam.x) * cam.zoom; sy = H/2 + (sp.y + cam.y) * cam.zoom;
    }
    ctx.save(); ctx.strokeStyle = '#ff0a94'; ctx.globalAlpha = sp.alpha; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(sx, sy, sp.r, 0, Math.PI*2); ctx.stroke(); ctx.restore();
  }

  // Cells: strictly 2 accents — Electric Pink (Values V_*) + Gemini Blue (Ops O_*)
  for (const c of net.cells.values()) {
    const sp = cellScreenPos(c);
    const opBlue = isLight ? '#1a73e8' : '#4da3ff';
    const accent = synMode ? synColorFor(c.label) : (c.polarity === 'val' ? '#ff0a94' : opBlue);
    drawSpaciousCell(ctx, c, sp.x, sp.y, sp.scale, isLight, ink, accent, hoveredCell === c);
  }

  if (p2pOn) {
    drawP2POverlay(ctx, W, H, isLight, ink, cutX, frameCutPorts);
  }

  if (net.horizonHit) {
    ctx.save();
    ctx.fillStyle = '#ff0a94';
    ctx.font = '700 11px ui-monospace, Menlo, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('LAZY HORIZON REACHED (96 CELLS) · CLICK ANY PINK PAIR TO EXPAND ON DEMAND', W / 2, H - 14);
    ctx.restore();
  }

  drawKanBox();
  drawScope();
  requestAnimationFrame(draw);
}

// ============================================================================
// 8. SUB-CANVASES (MUSIC OF THE SPHERES, CAUSAL DAG, KAN BOX, OSCILLOSCOPE)
