document.getElementById('codeEditor').value = CODE_TEMPLATES[0].code;

document.getElementById('btnRunCode').onclick = runStudioCodeBuffer;
document.getElementById('codeEditor').addEventListener('keydown', e => {
  if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
    e.preventDefault();
    runStudioCodeBuffer();
  }
});
document.getElementById('kernelBarToggle').onclick = () => {
  document.getElementById('kernelBox').classList.toggle('open');
};

document.getElementById('loadModBtn').onclick = async () => {
  const rel = document.getElementById('modInput').value.trim();
  if (!rel) return;
  ensureWasmKernel();
  let res = await fetch('/api/kg/module?path=' + encodeURIComponent(rel));
  if (res.ok) {
    const txt = await res.text();
    document.getElementById('codeEditor').value = txt;
    document.getElementById('savePathInput').value = rel;
    setStudioMode('code');
    runStudioCodeBuffer();
  } else if (wasmWorker) {
    wasmWorker.postMessage({ type: 'fetch_mod_text', origin: location.origin, rel });
  }
};

document.getElementById('saveWsBtn').onclick = async () => {
  const path = document.getElementById('savePathInput').value.trim();
  const vis = document.getElementById('saveVisSelect').value;
  const text = document.getElementById('codeEditor').value;
  if (!path) return;
  const res = await runWorkerCut(text);
  if (!res.ok) {
    setStudioMode('code');
    document.getElementById('kernelBox').classList.add('open');
    document.getElementById('kernelDot').className = 'k-dot err';
    document.getElementById('kernelOut').textContent = res.output || 'Rejected by kernel.';
    return;
  }
  const sha = await casPutVerified(null, text);
  if (vis === 'public') publicHashAllowlist.add(sha);
  wasmWorker.postMessage({ type: 'put_mod', rel: path, txt: text, sha256: sha });
  await wsPutRecord({ path, sha256: sha, visibility: vis, text, updatedAt: Date.now() });
  renderWorkspaceUI();
  broadcastMesh({ t: 'MANIFEST', manifest: await buildMyManifest() });
  showStepToast('RECORDED TO SOVEREIGN POOL', `${path} (${sha.slice(0, 12)}…) saved as ${vis.toUpperCase()}.`, true);
};

document.getElementById('distBtn').onclick = async () => {
  const src = document.getElementById('codeEditor').value;
  const pre = [], cuts = [];
  for (const ln of src.split('\n')) {
    if (/^\s*#(show|type)\b/.test(ln)) cuts.push(ln.trim());
    else pre.push(ln);
  }
  if (!cuts.length) { setStudioMode('code'); runStudioCodeBuffer(); return; }
  const workers = ['LOCAL', ...liveMeshPeerIds()];
  const preamble = pre.join('\n');
  const t0 = performance.now();
  const tasks = cuts.map((dir, idx) => {
    const target = workers[idx % workers.length];
    const unitCode = preamble + '\n' + dir + '\n';
    if (target === 'LOCAL') {
      return runWorkerCut(unitCode).then(r => `[${idx + 1}] ${dir} ⟶ ${r.output || '✓'} (${r.steps} steps, local)`);
    }
    const reqId = 'cut_' + Date.now() + '_' + idx;
    return new Promise(resolve => {
      const timer = setTimeout(async () => {
        pendingCuts.delete(reqId);
        const fb = await runWorkerCut(unitCode);
        resolve(`[${idx + 1}] ${dir} ⟶ ${fb.output || '✓'} (${fb.steps} steps, fallback)`);
      }, 5000);
      pendingCuts.set(reqId, {
        timer,
        resolve: async (pkt) => resolve(`[${idx + 1}] ${dir} ⟶ ${pkt.output || '✓'} (${pkt.steps || 0} steps on ${pkt.peerId})`)
      });
      sendToMeshPeer(target, { t: 'CUT_REQ', reqId, code: unitCode });
    });
  });
  const outRows = await Promise.all(tasks);
  setStudioMode('code');
  document.getElementById('kernelBox').classList.add('open');
  document.getElementById('kernelOut').textContent =
    `⚡ Distributed ${cuts.length} cut(s) across ${workers.length} node(s) in ${(performance.now() - t0).toFixed(1)} ms:\n` +
    outRows.join('\n');
};

document.getElementById('btnMore').onclick = (e) => {
  e.stopPropagation();
  document.getElementById('morePop').classList.toggle('open');
};
document.addEventListener('click', (e) => {
  const pop = document.getElementById('morePop');
  if (pop && pop.classList.contains('open') && !e.target.closest('.more-wrap')) {
    pop.classList.remove('open');
  }
});


const qParams = new URLSearchParams(location.search);
const qPreset = qParams.get('preset');
const qMod = qParams.get('mod');
const qTerm = qParams.get('term');
if (qTerm) window.__hxFocusTerm = qTerm;
const qMode = qParams.get('mode');
const isEmbedView = document.documentElement.classList.contains('embed');
const isKernelRoute = (location.pathname.replace(/\/$/, '') === '/kernel');

loadPreset(PRESETS.find(p => p.id === qPreset) || PRESETS.find(p => p.id === 'add') || PRESETS[0]);

if (!isEmbedView) {
  if (qMod) {
    document.getElementById('modInput').value = qMod;
    setStudioMode('code');
    document.getElementById('loadModBtn').click();
  } else if (qMode === 'code' || (isKernelRoute && !qPreset)) {
    setStudioMode('code');
    runStudioCodeBuffer();
  } else if (qMode === 'pool') {
    setStudioMode('pool');
  } else {
    // Gently warm WASM kernel in background after initial paint so switching to Code is instant
    setTimeout(ensureWasmKernel, 1400);
  }
  broadcastMesh({ t: 'HELLO' });
  setInterval(() => { broadcastMesh({ t: 'HELLO' }); renderPeersUI(); }, 5000);
}

if (qParams.get('p2p') === '1') toggleP2PCut();
if (qParams.get('autoplay') === '1') {
  audio.enabled = false;
  const bs = document.getElementById('btnSound');
  if (bs) bs.classList.remove('on');
  document.getElementById('speedSlider').value = '360';
  setTimeout(() => { if (!playing) document.getElementById('btnPlay').click(); }, 450);
}
requestAnimationFrame(draw);

