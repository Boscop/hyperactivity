      self.postMessage({type:'status',text:'Elaborating lib/core.hypercubical…',hashes:verifiedHashes});
      for(const rel of ${JSON.stringify(CORE_IMPORTS)}){if(!loadedFiles.has(rel))await fetchModuleTree(msg.origin,rel);}
