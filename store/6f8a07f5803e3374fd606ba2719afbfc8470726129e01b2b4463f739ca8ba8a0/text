function stripLineComment(ln) {
  let inStr = false;
  for (let i = 0; i < ln.length; i++) {
    if (ln[i] === '"') inStr = !inStr;
    if (!inStr && ln[i] === '-' && ln[i + 1] === '-') return ln.slice(0, i);
  }
  return ln;
}

function hxTokenize(src) {
  const toks = [];
  let i = 0;
  while (i < src.length) {
    const c = src[i];
    if (/\s/.test(c)) { i++; continue; }
    if (c === '-' && src[i + 1] === '>') { toks.push({ t: 'ARR', v: '→' }); i += 2; continue; }
    if (c === '→' || c === '↦') { toks.push({ t: 'ARR', v: c }); i++; continue; }
    if (c === 'λ' || c === '\\') { toks.push({ t: 'LAM', v: 'λ' }); i++; continue; }
    if ('(),@~:.=[]|{}'.includes(c)) { toks.push({ t: c, v: c }); i++; continue; }
    if (c === '#') {
      let j = i + 1;
      while (j < src.length && /[0-9]/.test(src[j])) j++;
      toks.push({ t: 'WORD', v: src.slice(i, j), n: parseInt(src.slice(i + 1, j) || '0', 10) });
      i = j; continue;
    }
    if (/[0-9]/.test(c)) {
      let j = i;
      while (j < src.length && /[0-9]/.test(src[j])) j++;
      toks.push({ t: 'NAT', v: src.slice(i, j), n: parseInt(src.slice(i, j), 10) });
      i = j; continue;
    }
    if (/[A-Za-z_']/.test(c)) {
      let j = i;
      while (j < src.length && (/[A-Za-z0-9_']/.test(src[j]) || (src[j] === '-' && src[j + 1] !== '>'))) j++;
      toks.push({ t: 'ID', v: src.slice(i, j) });
      i = j; continue;
    }
    i++;
  }
  return toks;
}

function parseHxExprTokens(toks, startPos = 0) {
  let pos = startPos;
  const peek = () => toks[pos];
  const eat = (t) => {
    const k = toks[pos];
    if (!k || (t && k.t !== t)) throw new Error(`Expected ${t || 'expression'}`);
    pos++; return k;
  };
  function skipImplicit() {
    while (peek() && peek().t === '{') {
      let d = 0;
      do {
        if (peek().t === '{') d++;
        else if (peek().t === '}') d--;
        pos++;
      } while (pos < toks.length && d > 0);
    }
  }
  function pExpr() {
    let left = pLam();
    if (peek() && peek().t === ',') { eat(','); return { k: 'pair', a: left, b: pExpr() }; }
    return left;
  }
  function pLam() {
    if (peek() && peek().t === 'ID' && peek().v === 'let' && toks[pos + 1] && toks[pos + 1].t === 'ID') {
      eat('ID');
      const vname = eat('ID').v;
      while (peek() && peek().t !== '=') pos++;
      if (peek() && peek().t === '=') eat('=');
      const valAst = pExpr();
      if (peek() && peek().t === 'ID' && peek().v === 'in') eat('ID');
      const bodyAst = pExpr();
      return { k: 'app', fn: { k: 'lam', param: vname, body: bodyAst }, arg: valAst };
    }
    if (peek() && peek().t === 'ID' && peek().v === 'if') {
      eat('ID');
      const condAst = pExpr();
      if (peek() && peek().t === 'ID' && peek().v === 'then') eat('ID');
      const tAst = pExpr();
      if (peek() && peek().t === 'ID' && peek().v === 'else') eat('ID');
      const eAst = pExpr();
      return { k: 'app', fn: { k: 'app', fn: { k: 'app', fn: { k: 'var', name: 'if-then-else' }, arg: condAst }, arg: tAst }, arg: eAst };
    }
    if (peek() && peek().t === 'LAM') {
      eat('LAM');
      const binders = [];
      while (peek() && peek().t !== 'ARR' && peek().t !== '.') {
        if (peek().t === '{') { skipImplicit(); continue; }
        if (peek().t === '(') {
          eat('(');
          const name = eat('ID').v;
          let isDim = false;
          if (peek() && peek().t === ':') {
            eat(':');
            if (peek() && peek().v === 'I') isDim = true;
            while (peek() && peek().t !== ')') pos++;
          }
          if (peek() && peek().t === ')') eat(')');
          binders.push({ name, isDim });
        } else if (peek().t === 'ID') {
          const name = eat('ID').v;
          binders.push({ name, isDim: (name === 'i' || name === 'j' || name === 'k') });
        } else break;
      }
      if (peek() && (peek().t === 'ARR' || peek().t === '.')) eat();
      let body = pExpr();
      for (let b = binders.length - 1; b >= 0; b--) {
        body = binders[b].isDim ? { k: 'plam', dim: binders[b].name, body } : { k: 'lam', param: binders[b].name, body };
      }
      return body;
    }
    if (peek() && peek().t === '[') {
      const save = pos;
      eat('[');
      if (peek() && peek().t === 'ID' && toks[pos + 1] && toks[pos + 1].t === ']') {
        const dim = eat('ID').v; eat(']');
        return { k: 'plam', dim, body: pExpr() };
      }
      pos = save;
    }
    return pApp();
  }
  function pApp() {
    skipImplicit();
    let node = pAtom();
    while (peek()) {
      if (peek().t === '{') { skipImplicit(); continue; }
      if (peek().t === '@') { eat('@'); node = { k: 'papp', fn: node, r: pAtom() }; }
      else if (['ID', 'NAT', 'WORD', '(', 'LAM', '~', '['].includes(peek().t)) {
        const arg = pAtom();
        if (node.k === 'var' && node.name === 'fst') node = { k: 'fst', e: arg };
        else if (node.k === 'var' && node.name === 'snd') node = { k: 'snd', e: arg };
        else if (node.k === 'var' && node.name === 'unfold') node = { k: 'unfold', e: arg };
        else node = { k: 'app', fn: node, arg };
      } else break;
    }
    return node;
  }
  function pAtom() {
    skipImplicit();
    const k = peek();
    if (!k) throw new Error('Unexpected end of expression');
    if (k.t === '(') {
      eat('(');
      if (peek() && peek().t === ')') { eat(')'); return { k: 'var', name: 'unit' }; }
      const e = pExpr();
      if (peek() && peek().t === ')') eat(')');
      return e;
    }
    if (k.t === '[') {
      eat('[');
      const items = [];
      while (peek() && peek().t !== ']') {
        items.push(pLam());
        if (peek() && peek().t === ',') eat(','); else break;
      }
      if (peek() && peek().t === ']') eat(']');
      let lst = { k: 'var', name: 'nil' };
      for (let idx = items.length - 1; idx >= 0; idx--) {
        lst = { k: 'app', fn: { k: 'app', fn: { k: 'var', name: 'cons' }, arg: items[idx] }, arg: lst };
      }
      return lst;
    }
    if (k.t === 'LAM') return pLam();
    if (k.t === '~') { eat('~'); return { k: 'neg', e: pAtom() }; }
    if (k.t === 'WORD') { eat('WORD'); return { k: 'word', n: k.n, v: k.v }; }
    if (k.t === 'NAT') { eat('NAT'); return { k: 'nat', n: k.n }; }
    if (k.t === 'ID') { eat('ID'); return { k: 'var', name: k.v }; }
    throw new Error(`Unexpected '${k.v}'`);
  }
  const ast = pExpr();
  return { ast, nextPos: pos };
}

function parsePatternAtom(toks, st, ctors) {
  while (st.p < toks.length && toks[st.p].t === '{') {
    let d = 0;
    do { if (toks[st.p].t === '{') d++; else if (toks[st.p].t === '}') d--; st.p++; } while (st.p < toks.length && d > 0);
  }
  const t = toks[st.p];
  if (!t) return null;
  if (t.t === '(') {
    st.p++;
    if (st.p < toks.length && toks[st.p].t === 'ID') {
      const head = toks[st.p++].v;
      const sub = [];
      while (st.p < toks.length && toks[st.p].t !== ')') {
        const sp = parsePatternAtom(toks, st, ctors);
        if (!sp) break;
        sub.push(sp);
      }
      if (st.p < toks.length && toks[st.p].t === ')') st.p++;
      if (sub.length === 0) {
        if (ctors && ctors.has(head) && ctors.get(head) === 0) return { kind: 'con', con: head, args: [] };
        return { kind: 'var', name: head };
      }
      return { kind: 'con', con: head, args: sub };
    }
    while (st.p < toks.length && toks[st.p].t !== ')') st.p++;
    if (st.p < toks.length) st.p++;
    return { kind: 'var', name: '_' };
  }
  if (t.t === 'ID') {
    st.p++;
    if (ctors && ctors.has(t.v) && ctors.get(t.v) === 0) return { kind: 'con', con: t.v, args: [] };
    return { kind: 'var', name: t.v };
  }
  if (t.t === 'NAT') {
    st.p++;
    let pat = { kind: 'con', con: 'zero', args: [] };
    for (let i = 0; i < Math.min(8, t.n); i++) pat = { kind: 'con', con: 'suc', args: [pat] };
    return pat;
  }
  st.p++;
  return { kind: 'var', name: '_' };
}

function parseHypercubicalModule(src) {
  const ctors = new Map([
    ['zero', 0], ['suc', 1], ['true', 0], ['false', 0],
    ['nil', 0], ['cons', 2], ['unit', 0], ['refl', 0],
    ['inl', 1], ['inr', 1], ['bend', 0], ['b0', 1], ['b1', 1]
  ]);
  const defs = new Map();
  const targets = [];

  const rawLines = src.split('\n');
  const decls = [];
  for (const raw of rawLines) {
    const clean = stripLineComment(raw);
    if (!clean.trim()) continue;
    if (/^\s+/.test(clean) && decls.length > 0 && !/^\s*#(show|type)\b/.test(clean)) {
      decls[decls.length - 1] += ' ' + clean.trim();
    } else {
      decls.push(clean.trim());
    }
  }

  // Pass 1: data declarations & #show/#type directives
  for (const d of decls) {
    let m;
    if ((m = d.match(/^#(show|type)\s+(.+)$/))) {
      targets.push({ kind: m[1], expr: m[2].trim() });
      continue;
    }
    if (d.startsWith('data ')) {
      const eqIdx = d.indexOf('=');
      if (eqIdx > 0) {
        const rhs = d.slice(eqIdx + 1);
        for (const branch of rhs.split('|')) {
          const bt = hxTokenize(branch);
          if (!bt.length || bt[0].t !== 'ID') continue;
          const cname = bt[0].v;
          let arity = 0, p = 1;
          while (p < bt.length) {
            if (bt[p].t === '{') {
              let depth = 0;
              do { if (bt[p].t === '{') depth++; else if (bt[p].t === '}') depth--; p++; } while (p < bt.length && depth > 0);
            } else if (bt[p].t === '(') {
              arity++;
              let depth = 0;
              do { if (bt[p].t === '(') depth++; else if (bt[p].t === ')') depth--; p++; } while (p < bt.length && depth > 0);
            } else { arity++; p++; }
          }
          ctors.set(cname, arity);
        }
      }
    }
  }
  targets.sort((a, b) => (a.kind === 'show' ? 0 : 1) - (b.kind === 'show' ? 0 : 1));

  // Pass 2: function equations `fname pat1 ... patN = rhs`
  const skipTypeNames = new Set();
  for (const d of decls) {
    if (d.startsWith('data ') || d.startsWith('import ') || d.startsWith('#')) continue;
    const toks = hxTokenize(d);
    if (toks.length < 3 || toks[0].t !== 'ID') continue;
    if (toks[1].t === ':' || (toks[1].t === '{' && toks.some(t => t.t === ':') && !toks.some(t => t.t === '='))) {
      if (/\b(Type|Set)\s*$/.test(d)) skipTypeNames.add(toks[0].v);
      continue;
    }
    let eqPos = -1, depth = 0;
    for (let i = 1; i < toks.length; i++) {
      if (toks[i].t === '(' || toks[i].t === '{' || toks[i].t === '[') depth++;
      else if (toks[i].t === ')' || toks[i].t === '}' || toks[i].t === ']') depth = Math.max(0, depth - 1);
      else if (depth === 0 && toks[i].t === '=') { eqPos = i; break; }
    }
    if (eqPos < 1) continue;
    const fname = toks[0].v;
    const lhsToks = toks.slice(1, eqPos);
    const rhsToks = toks.slice(eqPos + 1);
    if (!rhsToks.length) continue;

    const pats = [];
    const st = { p: 0 };
    while (st.p < lhsToks.length) {
      const pa = parsePatternAtom(lhsToks, st, ctors);
      if (!pa) break;
      pats.push(pa);
    }
    try {
      const { ast } = parseHxExprTokens(rhsToks, 0);
      if (!defs.has(fname)) defs.set(fname, { name: fname, arity: pats.length, clauses: [], scrutIdx: 0 });
      const entry = defs.get(fname);
      entry.arity = Math.max(entry.arity, pats.length);
      entry.clauses.push({ pats, rhs: ast });
    } catch (_) {}
  }

  for (const entry of defs.values()) {
    let sIdx = 0;
    for (let i = 0; i < entry.arity; i++) {
      if (entry.clauses.some(cl => cl.pats[i] && cl.pats[i].kind === 'con')) { sIdx = i; break; }
    }
    entry.scrutIdx = sIdx;
  }

  // Fallback visualization target if module has no `#show` directive
  if (targets.length === 0) {
    for (const entry of defs.values()) {
      if (skipTypeNames.has(entry.name)) continue;
      if (entry.arity === 0) {
        targets.push({ kind: 'def', expr: entry.name });
      } else {
        const sampleArgs = [];
        for (let i = 0; i < entry.arity; i++) {
          const conCl = entry.clauses.find(cl => cl.pats[i] && cl.pats[i].kind === 'con');
          if (conCl) {
            const cn = conCl.pats[i].con;
            if (cn === 'zero' || cn === 'suc') sampleArgs.push('2');
            else if (ctors.get(cn) === 0) sampleArgs.push(cn);
            else sampleArgs.push(`x${i + 1}`);
          } else sampleArgs.push(`x${i + 1}`);
        }
        targets.push({ kind: 'def', expr: `${entry.name} ${sampleArgs.join(' ')}` });
      }
      if (targets.length >= 4) break;
    }
  }

  return { ctors, defs, targets };
}

function flattenSpine(node) {
  const args = [];
  let cur = node;
  while (cur && cur.k === 'app') {
    args.unshift(cur.arg);
    cur = cur.fn;
  }
  return { head: cur, args };
}

function buildNatChain(net, n) {
  if (n > 6) {
    return { cell: net.add('V_NATN', String(n), 'Nat', 1, 0, 0, { nat: n }), port: 0 };
  }
  let h = net.add('V_Z', 'Z', '0', 1);
  for (let i = 0; i < n; i++) {
    const s = net.add('V_S', 'S', 'Nat', 2);
    net.wire(s, 1, h, 0);
    h = s;
  }
  return { cell: h, port: 0 };
}

function emitWithModule(astNode, net, modEnv, varEnv, dims) {
  function connectPort(cid, pidx, target) {
    if (target.kind === 'pending') { target.proxy.cell = cid; target.proxy.port = pidx; }
    else net.wire(cid, pidx, target.cell, target.port);
  }

  function wireUses(srcCell, srcPort, uses) {
    if (uses.length === 0) {
      const era = net.add('O_ERA', 'ε', 'unused', 1);
      net.wire(srcCell, srcPort, era, 0);
    } else if (uses.length === 1) {
      if (uses[0].cell !== null) net.wire(srcCell, srcPort, uses[0].cell, uses[0].port);
    } else {
      let curC = srcCell, curP = srcPort;
      for (let k = 0; k < uses.length - 1; k++) {
        const dup = net.add('O_DUP', 'δ', 'O_DUP', 3);
        net.wire(curC, curP, dup, 0);
        if (uses[k].cell !== null) net.wire(dup, 1, uses[k].cell, uses[k].port);
        curC = dup; curP = 2;
      }
      const last = uses[uses.length - 1];
      if (last.cell !== null) net.wire(curC, curP, last.cell, last.port);
    }
  }

  function emit(node, env, dm) {
    if (net.cells.size >= 84 && node.k !== 'var') {
      return { cell: net.add('V_CON', '…', 'lazy', 1, 0, 0, { con: '…', arity: 0 }), port: 0 };
    }
    if (node.k === 'nat') return buildNatChain(net, node.n);
    if (node.k === 'word') return { cell: net.add('V_WORD', node.v, 'Word', 1, 0, 0, { n: node.n }), port: 0 };
    if (node.k === 'neg') {
      const inner = node.e.k === 'var' ? node.e.name : 'i';
      return { cell: net.add('V_IV', `~${inner}`, 'De Morgan', 1, 0, 0, { expr: `~${inner}` }), port: 0 };
    }
    if (node.k === 'pair') {
      const p = net.add('V_PAIR', 'pair', 'Σ', 3);
      connectPort(p, 1, emit(node.a, env, dm));
      connectPort(p, 2, emit(node.b, env, dm));
      return { cell: p, port: 0 };
    }
    if (node.k === 'fst' || node.k === 'snd') {
      const op = net.add(node.k === 'fst' ? 'O_FST' : 'O_SND', node.k, node.k === 'fst' ? 'O_FST' : 'O_SND', 2);
      connectPort(op, 0, emit(node.e, env, dm));
      return { cell: op, port: 1 };
    }
    if (node.k === 'unfold') {
      const op = net.add('O_UNFOLD', 'unfold', 'O_UNFOLD', 2);
      connectPort(op, 0, emit(node.e, env, dm));
      return { cell: op, port: 1 };
    }
    if (node.k === 'lam') {
      const lam = net.add('V_LAM', 'λ', node.param, 3);
      const prev = env.get(node.param), uses = [];
      env.set(node.param, uses);
      const body = emit(node.body, env, dm);
      if (prev !== undefined) env.set(node.param, prev); else env.delete(node.param);
      if (body.kind === 'pending' && uses.includes(body.proxy)) {
        // Identity λx.x self-wire!
        if (uses.length === 1) { net.wire(lam, 1, lam, 2); return { cell: lam, port: 0 }; }
      }
      connectPort(lam, 2, body);
      wireUses(lam, 1, uses);
      return { cell: lam, port: 0 };
    }
    if (node.k === 'plam') {
      net.kanMode = 'path';
      const plam = net.add('V_PLAM', 'path-λ', node.dim, 2);
      const nd = new Set(dm); nd.add(node.dim);
      connectPort(plam, 1, emit(node.body, env, nd));
      return { cell: plam, port: 0 };
    }
    if (node.k === 'papp') {
      const rStr = node.r.k === 'neg' ? `~${node.r.e.name || 'i'}` : (node.r.name || node.r.v || String(node.r.n ?? 0));
      if (node.fn.k === 'var' && !env.has(node.fn.name) && !(modEnv && modEnv.defs.has(node.fn.name))) {
        const lbl = `${node.fn.name} @ ${rStr}`;
        return { cell: net.add('V_IV', lbl, 'path fiber', 1, 0, 0, { expr: lbl }), port: 0 };
      }
      net.kanMode = 'path';
      const papp = net.add('O_PAPPP', `@ ${rStr}`, rStr, 2);
      connectPort(papp, 0, emit(node.fn, env, dm));
      return { cell: papp, port: 1 };
    }

    // Spine application or variable / constructor / user-defined function
    if (node.k === 'var' || node.k === 'app') {
      const { head, args } = flattenSpine(node);
      if (head.k === 'var' && !env.has(head.name)) {
        const nm = head.name;
        if (dm.has(nm) && args.length === 0) {
          return { cell: net.add('V_IV', nm, 'dim ∈ I', 1, 0, 0, { expr: nm }), port: 0 };
        }
        // Built-in prelude primitives mapped to native cells
        if ((nm === 'zero') && args.length === 0) return { cell: net.add('V_Z', 'Z', '0', 1), port: 0 };
        if ((nm === 'suc') && args.length === 1) {
          const s = net.add('V_S', 'S', 'Nat', 2);
          connectPort(s, 1, emit(args[0], env, dm));
          return { cell: s, port: 0 };
        }
        if ((nm === 'plus' || nm === 'add') && args.length === 2 && !(modEnv && modEnv.defs.has(nm) && nm !== 'plus' && nm !== 'add')) {
          const op = net.add('O_ADD', '+', 'O_ADD', 3);
          connectPort(op, 0, emit(args[0], env, dm));
          connectPort(op, 1, emit(args[1], env, dm));
          return { cell: op, port: 2 };
        }
        if ((nm === 'times' || nm === 'mul') && args.length === 2) {
          const op = net.add('O_MUL', '×', 'O_MUL', 3);
          connectPort(op, 0, emit(args[0], env, dm));
          connectPort(op, 1, emit(args[1], env, dm));
          return { cell: op, port: 2 };
        }
        if ((nm === 'not' || nm === 'notB') && args.length === 1 && !(modEnv && modEnv.defs.has(nm))) {
          const op = net.add('O_NOT', 'not', 'O_NOT', 2);
          connectPort(op, 0, emit(args[0], env, dm));
          return { cell: op, port: 1 };
        }
        if (nm === 'Path' && args.length === 3) {
          const eq = net.add('O_EQ', '≡', 'Path', 3);
          connectPort(eq, 0, emit(args[1], env, dm));
          connectPort(eq, 1, emit(args[2], env, dm));
          return { cell: eq, port: 2 };
        }
        // User or prelude data constructors (arbitrary arity k -> V_CON with 1 + k ports!)
        if (modEnv && modEnv.ctors.has(nm) && args.length === modEnv.ctors.get(nm)) {
          const ar = modEnv.ctors.get(nm);
          const cid = net.add('V_CON', nm, ar > 0 ? `${ar}-ary` : 'con', 1 + ar, 0, 0, { con: nm, arity: ar });
          for (let i = 0; i < ar; i++) connectPort(cid, 1 + i, emit(args[i], env, dm));
          return { cell: cid, port: 0 };
        }
        // User-defined pattern-matching / recursive functions!
        if (modEnv && modEnv.defs.has(nm)) {
          const def = modEnv.defs.get(nm);
          if (args.length === def.arity && def.arity > 0) {
            const sIdx = def.scrutIdx || 0;
            const hasConPat = def.clauses.some(cl => cl.pats[sIdx] && cl.pats[sIdx].kind === 'con');
            if (hasConPat) {
              // Principal port 0 faces scrutinee arg[sIdx]; aux ports 1..N-1 hold other args; port N is OUT!
              const op = net.add('O_UDEF', nm, 'def', 1 + def.arity, 0, 0, { defName: nm, modEnv });
              connectPort(op, 0, emit(args[sIdx], env, dm));
              let aux = 1;
              for (let i = 0; i < def.arity; i++) {
                if (i === sIdx) continue;
                connectPort(op, aux++, emit(args[i], env, dm));
              }
              return { cell: op, port: def.arity };
            } else {
              // Non-pattern combinator (e.g. `double x = plus x x`): emit as O_UDEF facing V_CON('•') trigger so you watch it unfold in 1 step!
              const op = net.add('O_UDEF', nm, 'unfold', 2 + def.arity, 0, 0, { defName: nm, modEnv, combinator: true });
              const trig = net.add('V_CON', '•', 'call', 1, 0, 0, { con: '•', arity: 0 });
              net.wire(op, 0, trig, 0);
              for (let i = 0; i < def.arity; i++) connectPort(op, 1 + i, emit(args[i], env, dm));
              return { cell: op, port: 1 + def.arity };
            }
          }
          if (def.arity === 0 && args.length === 0 && def.clauses[0]) {
            const op = net.add('O_UDEF', nm, 'def', 2, 0, 0, { defName: nm, modEnv, combinator: true });
            const trig = net.add('V_CON', '•', 'call', 1, 0, 0, { con: '•', arity: 0 });
            net.wire(op, 0, trig, 0);
            return { cell: op, port: 1 };
          }
        }
      }
      if (node.k === 'var') {
        if (env.has(node.name)) {
          const proxy = { cell: null, port: null };
          env.get(node.name).push(proxy);
          return { kind: 'pending', proxy };
        }
        return { cell: net.add('V_CON', node.name, 'atom', 1, 0, 0, { con: node.name, arity: 0 }), port: 0 };
      }
      // Fallback curried application cell O_APP
      const app = net.add('O_APP', 'app', 'O_APP', 3);
      connectPort(app, 0, emit(node.fn, env, dm));
      connectPort(app, 1, emit(node.arg, env, dm));
      return { cell: app, port: 2 };
    }
    throw new Error('Unsupported term');
  }

  return emit(astNode, varEnv, dims);
}

// Match & fire a user-defined O_UDEF interaction rule locally on the net!
function fireUserDef(net, opId, valId, spawn, evId) {
  const op = net.cells.get(opId), val = net.cells.get(valId);
  if (!op || !val || !op.meta || !op.meta.modEnv) return false;
  const modEnv = op.meta.modEnv;
  const def = modEnv.defs.get(op.meta.defName);
  if (!def) return false;

  // Unfold compact V_NATN (`14` -> `S(13)` or `Z`) lazily on demand!
  if (val.kind === 'V_NATN') {
    const n = val.meta.nat || 0;
    if (n <= 0) {
      const z = spawn('V_Z', 'Z', '0', 1);
      net.wire(opId, 0, z, 0);
      net.remove(valId);
      return true;
    } else {
      const s = spawn('V_S', 'S', 'Nat', 2);
      const rest = n - 1 === 0 ? spawn('V_Z', 'Z', '0', 1) : spawn('V_NATN', String(n - 1), 'Nat', 1, { nat: n - 1 });
      net.wire(s, 1, rest, 0);
      net.wire(opId, 0, s, 0);
      net.remove(valId);
      return true;
    }
  }

  const valConName = val.kind === 'V_Z' ? 'zero'
    : val.kind === 'V_S' ? 'suc'
    : val.kind === 'V_NIL' ? 'nil'
    : val.kind === 'V_CONS' ? 'cons'
    : (val.meta && val.meta.con) ? val.meta.con : val.label;

  if (op.meta.combinator) {
    const cl = def.clauses[0];
    const outEp = net.endpoint(opId, 1 + def.arity);
    const argEps = [];
    for (let i = 0; i < def.arity; i++) argEps.push(net.endpoint(opId, 1 + i));
    net.remove(opId); net.remove(valId);
    const varEnv = new Map();
    const bindOrder = [];
    for (let i = 0; i < def.arity; i++) {
      const pn = (cl.pats[i] && cl.pats[i].name) || `_p${i}`;
      const u = []; varEnv.set(pn, u); bindOrder.push({ ep: argEps[i], uses: u });
    }
    const res = emitWithModule(cl.rhs, net, modEnv, varEnv, new Set());
    for (const c of net.cells.values()) if (c.bornEvent === 0) c.bornEvent = evId;
    if (outEp) {
      if (res.kind === 'pending') { res.proxy.cell = outEp.cell; res.proxy.port = outEp.port; }
      else net.wire(res.cell, res.port, outEp.cell, outEp.port);
    }
    for (const b of bindOrder) wireExtEndpointToUses(net, b.ep, b.uses, spawn);
    return true;
  }

  const sIdx = def.scrutIdx || 0;
  // Find matching clause (supporting 1-level or nested `suc (suc n)` when child is already a constructor!)
  for (const cl of def.clauses) {
    const pat = cl.pats[sIdx];
    const bindings = []; // { ep, varName }
    const consumedCells = [opId, valId];
    if (!matchCellAgainstPat(net, val, pat, bindings, consumedCells)) continue;

    // Bind remaining non-scrutinee arguments
    let aux = 1;
    let otherOk = true;
    for (let i = 0; i < def.arity; i++) {
      if (i === sIdx) continue;
      const argEp = net.endpoint(opId, aux++);
      const pOther = cl.pats[i];
      if (pOther && pOther.kind === 'var') {
        bindings.push({ ep: argEp, name: pOther.name });
      } else if (pOther && pOther.kind === 'con' && argEp && net.cells.has(argEp.cell)) {
        const ac = net.cells.get(argEp.cell);
        if (!matchCellAgainstPat(net, ac, pOther, bindings, consumedCells)) { otherOk = false; break; }
        consumedCells.push(ac.id);
      } else {
        bindings.push({ ep: argEp, name: `_a${i}` });
      }
    }
    if (!otherOk) continue;

    const outEp = net.endpoint(opId, def.arity);
    for (const cid of consumedCells) net.remove(cid);

    const varEnv = new Map();
    for (const b of bindings) {
      if (!varEnv.has(b.name)) varEnv.set(b.name, []);
    }
    const res = emitWithModule(cl.rhs, net, modEnv, varEnv, new Set());
    for (const c of net.cells.values()) if (c.bornEvent === 0) c.bornEvent = evId;

    if (outEp) {
      if (res.kind === 'pending') { res.proxy.cell = outEp.cell; res.proxy.port = outEp.port; }
      else net.wire(res.cell, res.port, outEp.cell, outEp.port);
    }
    for (const b of bindings) {
      const uses = varEnv.get(b.name) || [];
      wireExtEndpointToUses(net, b.ep, uses, spawn);
    }
    return true;
  }

  // If nested pattern (e.g. `fib (suc (suc n))`) is waiting for inner argument `val.ports[1]` to reduce to V_* first:
  for (let p = 1; p < val.ports.length; p++) {
    const subEp = val.ports[p];
    if (subEp && net.cells.has(subEp.cell)) {
      const subC = net.cells.get(subEp.cell);
      if (subC.kind === 'V_NATN') {
        // Peel nested V_NATN!
        const n = subC.meta.nat || 0;
        if (n <= 0) {
          const z = spawn('V_Z', 'Z', '0', 1);
          net.wire(val.id, p, z, 0); net.remove(subC.id);
        } else {
          const s = spawn('V_S', 'S', 'Nat', 2);
          const r = n - 1 === 0 ? spawn('V_Z', 'Z', '0', 1) : spawn('V_NATN', String(n - 1), 'Nat', 1, { nat: n - 1 });
          net.wire(s, 1, r, 0); net.wire(val.id, p, s, 0); net.remove(subC.id);
        }
        return fireUserDef(net, opId, valId, spawn, evId);
      }
    }
  }
  return false;
}

function matchCellAgainstPat(net, cell, pat, bindings, consumedCells) {
  if (!pat || pat.kind === 'var') {
    // Variable pattern matches the cell itself — wait: cell was attached to op, so we recreate/keep it?
    // If scrutinee itself is matched by a variable pattern `f x = ...`, keep `cell` alive!
    const idx = consumedCells.indexOf(cell.id);
    if (idx >= 0) consumedCells.splice(idx, 1);
    bindings.push({ ep: { cell: cell.id, port: 0 }, name: pat ? pat.name : '_' });
    return true;
  }
  const cname = cell.kind === 'V_Z' ? 'zero'
    : cell.kind === 'V_S' ? 'suc'
    : cell.kind === 'V_NIL' ? 'nil'
    : cell.kind === 'V_CONS' ? 'cons'
    : (cell.meta && cell.meta.con) ? cell.meta.con : cell.label;
  if (cname !== pat.con) return false;
  for (let i = 0; i < pat.args.length; i++) {
    const subPat = pat.args[i];
    const fieldEp = net.endpoint(cell.id, 1 + i);
    if (subPat.kind === 'var') {
      bindings.push({ ep: fieldEp, name: subPat.name });
    } else if (subPat.kind === 'con') {
      if (!fieldEp || !net.cells.has(fieldEp.cell)) return false;
      const fc = net.cells.get(fieldEp.cell);
      if (fc.polarity !== 'val') return false;
      consumedCells.push(fc.id);
      if (!matchCellAgainstPat(net, fc, subPat, bindings, consumedCells)) return false;
    }
  }
  return true;
}

function wireExtEndpointToUses(net, extEp, uses, spawn) {
  if (!extEp || !net.cells.has(extEp.cell)) return;
  if (uses.length === 0 || (uses.length === 1 && uses[0].cell === null)) {
    const e = spawn('O_ERA', 'ε', 'erase', 1);
    net.wire(e, 0, extEp.cell, extEp.port);
  } else if (uses.length === 1) {
    net.wire(extEp.cell, extEp.port, uses[0].cell, uses[0].port);
  } else {
    let curCell = extEp.cell, curPort = extEp.port;
    for (let k = 0; k < uses.length - 1; k++) {
      const d = spawn('O_DUP', 'δ', 'O_DUP', 3);
      net.wire(curCell, curPort, d, 0);
      if (uses[k].cell !== null) net.wire(d, 1, uses[k].cell, uses[k].port);
      curCell = d; curPort = 2;
    }
    const last = uses[uses.length - 1];
    if (last.cell !== null) net.wire(curCell, curPort, last.cell, last.port);
  }
}

