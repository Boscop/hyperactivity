      document.getElementById('codeEditor').value = rec.text;
      document.getElementById('savePathInput').value = rec.path;
      document.getElementById('saveVisSelect').value = rec.visibility;
      setStudioMode('code');
      runStudioCodeBuffer();
    };
    const badge = document.createElement('span');
    badge.className = rec.visibility === 'public' ? 'tag-pub' : 'tag-priv';
    badge.textContent = rec.visibility === 'public' ? 'PUBLISHED' : 'PRIVATE';
    badge.onclick = async () => {
      rec.visibility = rec.visibility === 'public' ? 'private' : 'public';
      await wsPutRecord(rec);
      renderWorkspaceUI();
      broadcastMesh({ t: 'MANIFEST', manifest: await buildMyManifest() });
    };
    row.appendChild(left); row.appendChild(badge);
    el.appendChild(row);
  });
}

async function pullPublishedFromPeer(peerId, path, sha256) {
  let txt = await casGet(sha256);
  if (txt === null) txt = await p2pWantHash(sha256);
  if (txt === null) return;
  await casPutVerified(sha256, txt);
  ensureWasmKernel();
  wasmWorker.postMessage({ type: 'put_mod', rel: path, txt, sha256 });
  document.getElementById('codeEditor').value = txt;
  document.getElementById('savePathInput').value = path;
  setStudioMode('code');
  runStudioCodeBuffer();
}

function triggerWasmEvalOnly() {
  ensureWasmKernel();
  if (!wasmReady) return;
  const src = document.getElementById('codeEditor').value;
  // Filter out pure visual-curriculum shorthands (`#show life`, `#show sort [...]`, `#show badd ...`, `#show prove ...`) before sending to cubical.wasm
  const wasmLines = src.split('\n').filter(ln => {
    const m = ln.match(/^\s*#show\s+(.+)$/);
    if (!m) return true;
    const e = m[1].trim();
    if (/^(life|badd\s+|(cert)?sort\s*\[|prove\s+|unfold\s+#|comp\s+A\s+\[|transport\s+\(ua)/i.test(e)) return false;
    return true;
  });
  document.getElementById('kernelDot').className = 'k-dot';
  document.getElementById('kernelStatusText').textContent = 'Checking in cubical.wasm…';
  wasmWorker.postMessage({ type: 'eval', origin: location.origin, code: wasmLines.join('\n') });
}

function visualizeTargetWithModEnv(exprStr, modEnv) {
  currentModEnv = modEnv;
  document.getElementById('exprInput').value = exprStr;
  compileExpression(exprStr, null, modEnv);
}

function runStudioCodeBuffer() {
  const src = document.getElementById('codeEditor').value;
  const modEnv = parseHypercubicalModule(src);
  currentModEnv = modEnv;

  if (window.__hxFocusTerm) {
    const ft = window.__hxFocusTerm;
    window.__hxFocusTerm = null;
    if (modEnv.defs.has(ft)) {
      const d = modEnv.defs.get(ft);
      const args = Array.from({ length: d.arity }, (_, i) => `x${i + 1}`);
      modEnv.targets.unshift({ kind: 'def', expr: d.arity ? `${ft} ${args.join(' ')}` : ft });
    } else {
      modEnv.targets.unshift({ kind: 'def', expr: ft });
    }
  }

  // Render target selector chips if multiple #show / definitions exist
  const strip = document.getElementById('targetStrip');
  const chipsEl = document.getElementById('targetChips');
  chipsEl.innerHTML = '';
  if (modEnv.targets.length > 0) {
    strip.classList.toggle('show', modEnv.targets.length > 1);
    modEnv.targets.forEach((t, idx) => {
      const b = document.createElement('button');
      b.className = 'target-chip' + (idx === 0 ? ' on' : '');
      b.textContent = t.expr.length > 26 ? t.expr.slice(0, 25) + '…' : t.expr;
      b.title = `#${t.kind} ${t.expr}`;
      b.onclick = () => {
        chipsEl.querySelectorAll('.target-chip').forEach(x => x.classList.remove('on'));
        b.classList.add('on');
        visualizeTargetWithModEnv(t.expr, modEnv);
      };
      chipsEl.appendChild(b);
    });
    visualizeTargetWithModEnv(modEnv.targets[0].expr, modEnv);
  }
  triggerWasmEvalOnly();
}

function setStudioMode(mode) {
  activeStudioMode = mode;
  document.querySelectorAll('.mode-tab').forEach(b => b.classList.toggle('on', b.dataset.mode === mode));
  document.getElementById('paneLearn').classList.toggle('on', mode === 'learn');
  document.getElementById('paneCode').classList.toggle('on', mode === 'code');
  document.getElementById('panePool').classList.toggle('on', mode === 'pool');
  if (mode === 'code' || mode === 'pool') ensureWasmKernel();
}

// Wire Studio UI controls
document.getElementById('myNodeBadge').textContent = netPeerId;
document.querySelectorAll('.mode-tab').forEach(b => {
