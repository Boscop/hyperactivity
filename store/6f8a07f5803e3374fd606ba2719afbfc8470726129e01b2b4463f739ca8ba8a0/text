function drawSphere() {
  const W = sphereCanvas.width, H = sphereCanvas.height, cx = W/2, cy = H/2, R = 100;
  const isLight = !document.documentElement.classList.contains('dark');
  spctx.clearRect(0, 0, W, H);
  spctx.strokeStyle = isLight ? 'rgba(0,0,0,0.2)' : 'rgba(255,255,255,0.2)'; spctx.lineWidth = 2;
  spctx.beginPath(); spctx.arc(cx, cy, R, 0, Math.PI*2); spctx.stroke();
  spctx.beginPath(); spctx.arc(cx, cy, R*0.42, 0, Math.PI*2); spctx.stroke();
  for (let i = activeChords.length - 1; i >= 0; i--) {
    const ch = activeChords[i]; ch.alpha -= 0.014;
    if (ch.alpha <= 0) { activeChords.splice(i, 1); continue; }
    const n1 = SPHERE_NODES.find(n => n.key === ch.key) || SPHERE_NODES[0], n0 = SPHERE_NODES[0];
    const x1 = cx + Math.cos(n1.ang)*R, y1 = cy + Math.sin(n1.ang)*R;
    const x0 = cx + Math.cos(n0.ang)*R, y0 = cy + Math.sin(n0.ang)*R;
    spctx.save(); spctx.strokeStyle = ch.color; spctx.globalAlpha = ch.alpha; spctx.lineWidth = 3.5;
    spctx.beginPath(); spctx.moveTo(cx, cy); spctx.lineTo(x1, y1); spctx.lineTo(x0, y0); spctx.stroke();
    spctx.fillStyle = ch.color; spctx.beginPath(); spctx.arc(x1, y1, 8, 0, Math.PI*2); spctx.fill(); spctx.restore();
  }
  spctx.fillStyle = '#ff0a94'; spctx.beginPath(); spctx.arc(cx, cy, 5, 0, Math.PI*2); spctx.fill();
  spctx.font = '700 16px ui-monospace, Menlo, monospace'; spctx.textAlign = 'center'; spctx.textBaseline = 'middle';
  SPHERE_NODES.forEach(n => {
    const x = cx + Math.cos(n.ang)*R, y = cy + Math.sin(n.ang)*R;
    const lx = cx + Math.cos(n.ang)*(R + 25), ly = cy + Math.sin(n.ang)*(R + 21);
    spctx.fillStyle = isLight ? '#000' : '#fff'; spctx.beginPath(); spctx.arc(x, y, 4, 0, Math.PI*2); spctx.fill();
    spctx.fillStyle = n.key === 'normal' ? '#ff0a94' : (isLight ? '#444' : '#aaa'); spctx.fillText(n.label, lx, ly);
  });
}

function drawCausalDag() {
  const W = causalCanvas.width, H = causalCanvas.height, isLight = !document.documentElement.classList.contains('dark');
  cctx.clearRect(0, 0, W, H);
  if (!net.events.length) {
    cctx.fillStyle = isLight ? '#999' : '#444'; cctx.font = '600 18px ui-monospace, Menlo, monospace';
    cctx.textAlign = 'center'; cctx.fillText('AWAITING INTERACTION EVENTS', W/2, H/2 + 6); return;
  }
  const byDepth = new Map();
  net.events.forEach(ev => { if (!byDepth.has(ev.depth)) byDepth.set(ev.depth, []); byDepth.get(ev.depth).push(ev); });
  const depths = [...byDepth.keys()].sort((a,b) => a - b), pos = new Map();
  depths.forEach((d, di) => {
    const row = byDepth.get(d);
    const x = 36 + (depths.length === 1 ? (W - 72)/2 : (di / (depths.length - 1)) * (W - 72));
    row.forEach((ev, ri) => {
      const y = 28 + (row.length === 1 ? (H - 56)/2 : (ri / (row.length - 1)) * (H - 56));
      pos.set(ev.id, { x, y });
    });
  });
  cctx.strokeStyle = isLight ? 'rgba(0,0,0,0.35)' : 'rgba(255,255,255,0.35)'; cctx.lineWidth = 2;
  net.events.forEach(ev => {
    const p2 = pos.get(ev.id);
    ev.parents.forEach(pid => { const p1 = pos.get(pid); if (p1 && p2) { cctx.beginPath(); cctx.moveTo(p1.x, p1.y); cctx.lineTo(p2.x, p2.y); cctx.stroke(); } });
  });
  net.events.forEach(ev => {
    const p = pos.get(ev.id);
    cctx.fillStyle = (ev.key === 'comp' || ev.key === 'papp' || ev.key === 'unglue') ? '#ffd400' : '#ff0a94';
    cctx.beginPath(); cctx.arc(p.x, p.y, 7, 0, Math.PI*2); cctx.fill();
  });
}

function drawKanBox() {
  if (!net.kanMode) return;
  const W = kanCanvas.width, H = kanCanvas.height, isLight = !document.documentElement.classList.contains('dark');
  kctx.clearRect(0, 0, W, H);
  const p = net.kanProgress;
  document.getElementById('kanPhase').textContent = `j = ${p.toFixed(2)}`;
  document.getElementById('kanTitle').textContent = net.kanMode === 'univalence' ? 'GLUE / UA FIBER' : net.kanMode === 'path' ? 'INTERVAL I = [0,1]' : 'KAN OPEN BOX';
  const x0 = 60, x1 = W - 60, y0 = H - 40, y1 = 40;
  if (p > 0) { const curY = y0 - (y0 - y1)*p; kctx.fillStyle = 'rgba(255,10,148,0.16)'; kctx.fillRect(x0, curY, x1 - x0, y0 - curY); }
  kctx.strokeStyle = '#00e5ff'; kctx.lineWidth = 4; kctx.beginPath(); kctx.moveTo(x0, y0); kctx.lineTo(x0, y1); kctx.stroke();
  kctx.strokeStyle = '#ffd400'; kctx.lineWidth = 4; kctx.beginPath(); kctx.moveTo(x1, y0); kctx.lineTo(x1, y1); kctx.stroke();
  kctx.strokeStyle = isLight ? '#000' : '#fff'; kctx.lineWidth = 4; kctx.beginPath(); kctx.moveTo(x0, y0); kctx.lineTo(x1, y0); kctx.stroke();
  const lidY = y0 - (y0 - y1)*p;
  kctx.strokeStyle = '#ff0a94'; kctx.lineWidth = p >= 1 ? 5 : 3; kctx.setLineDash(p >= 1 ? [] : [8,6]);
  kctx.beginPath(); kctx.moveTo(x0, lidY); kctx.lineTo(x1, lidY); kctx.stroke(); kctx.setLineDash([]);
  kctx.font = '700 18px ui-monospace, Menlo, monospace'; kctx.textAlign = 'center';
  kctx.fillStyle = isLight ? '#000' : '#fff'; kctx.fillText(net.kanMode === 'univalence' ? 'true : Bool' : 'p(i)', W/2, y0 + 22);
  kctx.fillStyle = '#00e5ff'; kctx.fillText('i=0', x0 - 28, (y0 + y1)/2);
  kctx.fillStyle = '#ffd400'; kctx.fillText('i=1', x1 + 28, (y0 + y1)/2);
  if (p >= 1) { kctx.fillStyle = '#ff0a94'; kctx.fillText(net.kanMode === 'univalence' ? 'false : Bool' : 'p ∙ q', W/2, y1 - 12); }
}

function drawScope() {
  if (!scopeCanvas || !sctx) return;
  const W = scopeCanvas.width, H = scopeCanvas.height;
  sctx.clearRect(0, 0, W, H); sctx.strokeStyle = '#ff0a94'; sctx.lineWidth = 2.5; sctx.beginPath();
  if (audio.analyser && (audio.enabled || audio.droneOn)) {
    const buf = new Uint8Array(audio.analyser.frequencyBinCount);
    audio.analyser.getByteTimeDomainData(buf);
    for (let i = 0; i < buf.length; i++) {
      const x = (i / (buf.length - 1)) * W, y = (buf[i] / 255) * H;
      if (i === 0) sctx.moveTo(x, y); else sctx.lineTo(x, y);
    }
  } else { sctx.moveTo(0, H/2); sctx.lineTo(W, H/2); }
  sctx.stroke();
}

// ============================================================================
// 9. POINTER & MÖBIUS INTERACTION
// ============================================================================
function findHitScreen(sx, sy) {
  for (const pair of net.activePairs()) {
    const a = cellScreenPos(pair.op), b = cellScreenPos(pair.val);
    const dx = b.x - a.x, dy = b.y - a.y, len2 = dx*dx + dy*dy + 0.01;
    const t = Math.max(0, Math.min(1, ((sx - a.x)*dx + (sy - a.y)*dy) / len2));
    if (Math.hypot(sx - (a.x + t*dx), sy - (a.y + t*dy)) < 18) return { type:'pair', pair };
  }
  for (const c of net.cells.values()) {
    const sp = cellScreenPos(c);
    if (Math.hypot(sx - sp.x, sy - sp.y) < 32 * sp.scale) return { type:'cell', cell:c };
  }
  return null;
}

canvas.addEventListener('pointermove', e => {
  const rect = canvas.getBoundingClientRect(), sx = e.clientX - rect.left, sy = e.clientY - rect.top;
  if (dragCell && !hypMode) {
    dragCell.x = (sx - rect.width/2)/cam.zoom - cam.x; dragCell.tx = dragCell.x;
    dragCell.y = (sy - rect.height/2)/cam.zoom - cam.y; dragCell.ty = dragCell.y;
    if (p2pCutMode) {
      const np = dragCell.x < 0 ? 0 : 1;
      if (dragCell.peer !== np) dragCell.peer = np;
    }
    return;
  }
  if (panStart) {
    if (hypMode) {
      const { R } = getDiskParams();
      const nx = panStart.hx - (e.clientX - panStart.x) / (R * 1.15);
      const ny = panStart.hy - (e.clientY - panStart.y) / (R * 1.15);
      const mag = Math.hypot(nx, ny);
      const clamp = mag > 0.88 ? 0.88 / mag : 1;
      hypPan.x = nx * clamp; hypPan.y = ny * clamp;
    } else {
      cam.x = panStart.cx + (e.clientX - panStart.x) / cam.zoom;
      cam.y = panStart.cy + (e.clientY - panStart.y) / cam.zoom;
    }
    return;
  }
  const hit = findHitScreen(sx, sy), tip = document.getElementById('hoverTip');
  hoveredPair = hit && hit.type === 'pair' ? hit.pair : null;
  hoveredCell = hit && hit.type === 'cell' ? hit.cell : null;
  if (hoveredPair) {
    const info = net.describeRule(hoveredPair.op, hoveredPair.val), pyth = PYTH[info.key] || PYTH.beta;
    const p2pTag = p2pCutMode
      ? ((hoveredPair.op.peer !== hoveredPair.val.peer) ? ' · ⚡ CROSS-PEER CUT (WireFrame)' : ` · LOCAL PEER ${hoveredPair.op.peer ? 'B' : 'A'} (0 msgs)`)
      : '';
    canvas.style.cursor = 'pointer'; tip.style.display = 'block';
    tip.innerHTML = `<div>ACTIVE PAIR: ${info.text}</div><div class="ht-sub">Click to fire local step · ${pyth.name}${p2pTag}</div>`;
  } else if (hoveredCell) {
    canvas.style.cursor = hypMode ? 'grab' : 'move'; tip.style.display = 'block';
    const p2pSub = p2pCutMode ? ` · peer: ${hoveredCell.peer ? 'B' : 'A'} (drag across ∂P to migrate)` : '';
    tip.innerHTML = `<div>${hoveredCell.kind} (${hoveredCell.label})</div><div class="ht-sub">polarity: ${hoveredCell.polarity} · ports: ${hoveredCell.ports.length}${p2pSub}</div>`;
  } else { canvas.style.cursor = 'grab'; tip.style.display = 'none'; }
});

