function normRel(d,imp){const raw=imp.startsWith('/')?imp.slice(1):(d+imp),ps=[];for(const s of raw.split('/')){if(!s||s==='.')continue;if(s==='..')ps.pop();else ps.push(s);}return ps.join('/');}
function parseImports(r,t){const i=r.lastIndexOf('/'),d=i>=0?r.slice(0,i+1):'',o=[];for(const ln of t.split('\\n')){const m=ln.match(/^\\s*import\\s+"([^"]+)"/);if(m)o.push(normRel(d,m[1]));}return o;}
function recordVerified(n,h,len){const disp=n.endsWith('.cub')?altExt(n):n;if(!verifiedHashes.some(x=>x.name===disp&&x.fullSha===h))verifiedHashes.push({name:disp,sha256:h.slice(0,12),fullSha:h,bytes:len});}
async function fetchModuleTree(origin,rel){
  if(loadedFiles.has(rel))return;
  loadedFiles.set(rel,'pending');
  const alt=altExt(rel);
  let res=await fetch(origin+'/source/text?path='+pathHex(rel));
  if(!res.ok&&alt)res=await fetch(origin+'/source/text?path='+pathHex(alt));
