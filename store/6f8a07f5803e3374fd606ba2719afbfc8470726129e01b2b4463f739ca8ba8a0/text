// 9. P2P DISTRIBUTED INTERACTION-NET CUT PARTITION (lib/distnet.hypercubical)
// ============================================================================
let p2pCutMode = false;
let p2pLocalCuts = 0;
let p2pWireFrames = 0;
const flyingWireFrames = [];
const netPeerId = (() => {
  const b = new Uint8Array(3);
  crypto.getRandomValues(b);
  return 'p_' + Array.from(b).map(x => x.toString(16).padStart(2, '0')).join('');
})();
let remoteNetPeer = null;
const netBC = typeof BroadcastChannel !== 'undefined' ? new BroadcastChannel('hx-p2p-v1') : null;
if (netBC) {
  netBC.onmessage = ev => {
    try {
      const m = JSON.parse(ev.data);
      if (!m || !m.from || m.from === netPeerId) return;
      remoteNetPeer = m.from;
      if (p2pCutMode && m.t === 'NET_STEP' && !playing) {
        stepLocalAndInspect(m.seq, true);
      }
    } catch (e) {}
  };
  setInterval(() => netBC.postMessage(JSON.stringify({ t: 'HELLO', from: netPeerId })), 5000);
}

// Balanced graph bisection across Peer A (0, left) and Peer B (1, right)
function partitionNetPeers(targetNet, force) {
  const cells = [...targetNet.cells.values()];
  if (!cells.length) return;
  if (!force && cells.some(c => c.peer === 0) && cells.some(c => c.peer === 1)) return;
  for (const c of cells) c.peer = 0;
  if (cells.length < 2) { targetNet.layoutDirty = true; return; }

  const root = cells.find(c => c.polarity === 'root') || cells[0];
  const visited = new Set([root.id]);
  const children = new Map();
  const order = [root.id];
  for (let qi = 0; qi < order.length; qi++) {
    const id = order[qi];
    const c = targetNet.cells.get(id);
    const kids = [];
    for (let p = 0; p < c.ports.length; p++) {
      const ep = c.ports[p];
      if (ep && targetNet.cells.has(ep.cell) && !visited.has(ep.cell)) {
        visited.add(ep.cell);
        kids.push(ep.cell);
        order.push(ep.cell);
      }
    }
    children.set(id, kids);
  }
  for (const c of cells) {
    if (!visited.has(c.id)) {
      visited.add(c.id);
      children.get(root.id).push(c.id);
      children.set(c.id, []);
      order.push(c.id);
    }
  }
  const subSize = new Map();
  const calcSz = (id) => {
    let s = 1;
    for (const k of (children.get(id) || [])) s += calcSz(k);
    subSize.set(id, s);
    return s;
  };
  calcSz(root.id);
  const markSubtree = (id, p) => {
    const c = targetNet.cells.get(id);
    if (c) c.peer = p;
    for (const k of (children.get(id) || [])) markSubtree(k, p);
  };

  let spine = [root.id];
  let b = root.id;
  while (true) {
    while ((children.get(b) || []).length === 1) {
      b = children.get(b)[0];
      spine.push(b);
    }
    const ck = children.get(b) || [];
    if (ck.length >= 2) {
      const heavyIdx = ck.findIndex(cid => (subSize.get(cid) || 1) > cells.length * 0.72 && (children.get(cid) || []).length >= 1);
      if (heavyIdx >= 0) {
        // Put light sibling subtrees on Peer B (right) if heavy is left, then bisect inside heavy!
        for (let i = heavyIdx + 1; i < ck.length; i++) markSubtree(ck[i], 1);
        b = ck[heavyIdx];
        spine.push(b);
        continue;
      }
    }
    break;
  }
  const kids = children.get(b) || [];
  if (kids.length >= 2) {
    const curRight = cells.filter(c => c.peer === 1).length;
    const targetRight = Math.max(1, Math.round(cells.length / 2) - curRight);
    let bestIdx = kids.length - 1, bestDiff = Infinity, accRight = 0;
    for (let i = kids.length - 1; i >= 1; i--) {
      accRight += subSize.get(kids[i]) || 1;
      const diff = Math.abs(accRight - targetRight);
      if (diff < bestDiff) { bestDiff = diff; bestIdx = i; }
    }
    for (let i = bestIdx; i < kids.length; i++) markSubtree(kids[i], 1);
    const finalRight = cells.filter(c => c.peer === 1).length;
    if (b !== root.id && finalRight < cells.length / 2) {
      targetNet.cells.get(b).peer = 1;
    }
  } else {
    const split = Math.max(1, Math.floor(order.length / 2));
    for (let i = split; i < order.length; i++) {
      targetNet.cells.get(order[i]).peer = 1;
    }
  }
  targetNet.layoutDirty = true;
}

function captureP2PPreFire(targetNet, op, val) {
  const preCross = new Set();
  for (const c of targetNet.cells.values()) {
    for (let p = 0; p < c.ports.length; p++) {
      const ep = c.ports[p];
      if (!ep || ep.cell <= c.id) continue;
      const o = targetNet.cells.get(ep.cell);
      if (o && (c.peer || 0) !== (o.peer || 0)) preCross.add(`${c.id}:${p}-${o.id}:${ep.port}`);
    }
  }
  return {
    opPeer: op.peer || 0,
    valPeer: val.peer || 0,
    opKind: op.kind,
    valKind: val.kind,
    opLabel: op.label,
    valLabel: val.label,
    opPos: { x: op.x, y: op.y, hx: op.hx, hy: op.hy },
    valPos: { x: val.x, y: val.y, hx: val.hx, hy: val.hy },
    preCross
  };
}

function pushWirePacket(fromPos, toPos, label) {
  if (flyingWireFrames.length >= 18) flyingWireFrames.shift();
  flyingWireFrames.push({
    x0: fromPos.x, y0: fromPos.y,
    x1: toPos.x, y1: toPos.y,
    hx0: fromPos.hx || 0, hy0: fromPos.hy || 0,
    hx1: toPos.hx || 0, hy1: toPos.hy || 0,
    t: 0, label
  });
}

function finalizeP2PFire(targetNet, snap, evId, isHomeostasis) {
  const spawned = [...targetNet.cells.values()].filter(c => c.bornEvent === evId);
  if (snap.opPeer !== snap.valPeer) {
    p2pWireFrames++;
    const pushOpToVal = (snap.opKind === 'O_ERA' || snap.opKind === 'O_DUP' || snap.opKind === 'O_SUBST' || snap.opKind === 'O_PAPPP');
    let wfTag = 'wf-con(' + snap.valLabel + ')';
    if (snap.opKind === 'O_ERA') wfTag = 'wf-era(ε)';
    else if (snap.opKind === 'O_DUP') wfTag = 'wf-dup(δ)';
    else if (snap.opKind === 'O_APP' && snap.valKind === 'V_LAM') wfTag = 'wf-beta(λ)';
    else if (snap.opKind === 'O_SUBST' || snap.opKind === 'O_PAPPP') wfTag = 'wf-subst';
    else if (snap.opKind === 'O_COMP' || snap.opKind === 'O_UNGLUE') wfTag = 'wf-kan';
    pushWirePacket(pushOpToVal ? snap.opPos : snap.valPos, pushOpToVal ? snap.valPos : snap.opPos, wfTag);

    if (!isHomeostasis) {
      for (const nc of spawned) {
        let assigned = null;
        const ep0 = nc.ports[0];
        if (ep0 && targetNet.cells.has(ep0.cell)) {
          const ext0 = targetNet.cells.get(ep0.cell);
          if (ext0.bornEvent < evId) assigned = ext0.peer || 0;
        }
        if (assigned === null) {
          for (let p = 1; p < nc.ports.length; p++) {
            const ep = nc.ports[p];
            if (ep && targetNet.cells.has(ep.cell)) {
              const ext = targetNet.cells.get(ep.cell);
              if (ext.bornEvent < evId) { assigned = ext.peer || 0; break; }
            }
          }
        }
        nc.peer = assigned !== null ? assigned : (nc.polarity === 'val' ? snap.opPeer : snap.valPeer);
        nc.x = nc.peer === 0 ? Math.min(-90, nc.x) : Math.max(90, nc.x);
      }
    }
  } else {
    p2pLocalCuts++;
    if (!isHomeostasis) {
      for (const nc of spawned) {
        nc.peer = snap.opPeer;
        nc.x = nc.peer === 0 ? Math.min(-90, nc.x) : Math.max(90, nc.x);
      }
      // Detect capability link forwarding across ∂P when bridge() splices two pre-existing cells on opposite peers
      for (const c of targetNet.cells.values()) {
        if (c.bornEvent >= evId) continue;
        for (let p = 0; p < c.ports.length; p++) {
          const ep = c.ports[p];
          if (!ep || ep.cell <= c.id) continue;
          const o = targetNet.cells.get(ep.cell);
          if (!o || o.bornEvent >= evId) continue;
          if ((c.peer || 0) !== (o.peer || 0) && !snap.preCross.has(`${c.id}:${p}-${o.id}:${ep.port}`)) {
            p2pWireFrames++;
            pushWirePacket(
              { x: c.x, y: c.y, hx: c.hx, hy: c.hy },
              { x: o.x, y: o.y, hx: o.hx, hy: o.hy },
              'wf-link'
            );
          }
        }
      }
    }
  }
}

function stepLocalAndInspect(seq, fromRemote) {
  if (p2pCutMode && !fromRemote && netBC && net.activePairs().length > 0) {
    netBC.postMessage(JSON.stringify({ t: 'NET_STEP', seq: !!seq, from: netPeerId }));
  }
  const fired = net.stepParallel(seq);
  updateHUD();
  return fired;
}

function drawP2PBackdrop(ctx, W, H, isLight, cutX, disk) {
  ctx.save();
  if (hypMode && disk) {
    ctx.beginPath();
    ctx.arc(disk.cx, disk.cy, disk.R, 0, Math.PI * 2);
    ctx.clip();
    ctx.fillStyle = isLight ? 'rgba(255,10,148,0.03)' : 'rgba(255,10,148,0.045)';
    ctx.fillRect(disk.cx - disk.R, disk.cy - disk.R, disk.R, disk.R * 2);
    ctx.fillStyle = isLight ? 'rgba(26,115,232,0.035)' : 'rgba(77,163,255,0.05)';
    ctx.fillRect(disk.cx, disk.cy - disk.R, disk.R, disk.R * 2);
    ctx.strokeStyle = '#ff0a94';
    ctx.lineWidth = 1.8;
    ctx.setLineDash([7, 6]);
    ctx.beginPath();
    ctx.moveTo(disk.cx, disk.cy - disk.R);
    ctx.lineTo(disk.cx, disk.cy + disk.R);
    ctx.stroke();
    ctx.restore();
    return;
  }
  const clampedCut = Math.max(0, Math.min(W, cutX));
  ctx.fillStyle = isLight ? 'rgba(255,10,148,0.022)' : 'rgba(255,10,148,0.035)';
  ctx.fillRect(0, 0, clampedCut, H);
  ctx.fillStyle = isLight ? 'rgba(26,115,232,0.026)' : 'rgba(77,163,255,0.04)';
  ctx.fillRect(clampedCut, 0, Math.max(0, W - clampedCut), H);

  if (cutX >= -4 && cutX <= W + 4) {
    ctx.strokeStyle = '#ff0a94';
    ctx.lineWidth = 1.8;
    ctx.setLineDash([7, 6]);
    ctx.beginPath();
    ctx.moveTo(cutX, 0);
    ctx.lineTo(cutX, H);
    ctx.stroke();
  }
  ctx.restore();
}

function worldToScreenPt(wx, wy, whx, why, W, H) {
  if (hypMode) {
    const { cx, cy, R } = getDiskParams();
    const m = mobius(whx || 0, why || 0, hypPan.x, hypPan.y);
    return { x: cx + m.x * R, y: cy + m.y * R };
  }
  return { x: W / 2 + (wx + cam.x) * cam.zoom, y: H / 2 + (wy + cam.y) * cam.zoom };
}

function drawP2POverlay(ctx, W, H, isLight, ink, cutX, frameCutPorts) {
  ctx.save();
  const opBlue = isLight ? '#1a73e8' : '#4da3ff';

  // 1. Marshaling proxy ports (◇ passive channel / ◆ cross-cut active pair) along ∂P
  for (const fp of frameCutPorts) {
    const r = fp.active ? (fp.hover ? 8.5 : 7) : 5.5;
    ctx.beginPath();
    ctx.moveTo(fp.x, fp.y - r);
    ctx.lineTo(fp.x + r, fp.y);
    ctx.lineTo(fp.x, fp.y + r);
    ctx.lineTo(fp.x - r, fp.y);
    ctx.closePath();
    ctx.fillStyle = fp.active ? '#ff0a94' : (isLight ? '#ffffff' : '#000000');
    ctx.fill();
    ctx.lineWidth = fp.active ? 2.2 : 1.8;
    ctx.strokeStyle = fp.active ? ink : '#ff0a94';
    ctx.stroke();
  }

  // 2. Animated WireFrame packets routed through the ∂P cut boundary
  for (let i = flyingWireFrames.length - 1; i >= 0; i--) {
    const f = flyingWireFrames[i];
    f.t += 0.034;
    if (f.t >= 1) { flyingWireFrames.splice(i, 1); continue; }
    const p0 = worldToScreenPt(f.x0, f.y0, f.hx0, f.hy0, W, H);
    const p1 = worldToScreenPt(f.x1, f.y1, f.hx1, f.hy1, W, H);
    const midPt = { x: cutX, y: (p0.y + p1.y) / 2 };
    let px, py;
    if (f.t < 0.5) {
      const u = f.t * 2;
      px = p0.x + (midPt.x - p0.x) * u;
      py = p0.y + (midPt.y - p0.y) * u;
    } else {
      const u = (f.t - 0.5) * 2;
      px = midPt.x + (p1.x - midPt.x) * u;
      py = midPt.y + (p1.y - midPt.y) * u;
    }
    ctx.font = '800 10px ui-monospace, Menlo, monospace';
    const tw = ctx.measureText(f.label).width + 12;
    ctx.fillStyle = '#ff0a94';
    ctx.fillRect(px - tw / 2, py - 9, tw, 18);
    ctx.strokeStyle = isLight ? '#ffffff' : '#000000';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(px - tw / 2, py - 9, tw, 18);
    ctx.fillStyle = '#ffffff';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(f.label, px, py + 0.5);
  }

  // 3. Responsive, collision-free P2P Partition HUD pill (docked below compiler HUD, never clips)
  let countA = 0, countB = 0;
  for (const c of net.cells.values()) { if ((c.peer || 0) === 0) countA++; else countB++; }
  const ccEl = document.querySelector('.compiler-card');
  const ccRect = (ccEl && ccEl.offsetParent !== null) ? ccEl.getBoundingClientRect() : null;
  const stgRect = canvas.parentElement.getBoundingClientRect();
  const pillY = ccRect ? Math.max(10, Math.round(ccRect.bottom - stgRect.top + 8)) : 10;
  const compact = W < 620;
  const peerBName = remoteNetPeer ? `${remoteNetPeer}` : 'PEER B';
  const leftTxt = compact
    ? `A(${countA}) · ${p2pLocalCuts} LOCAL`
    : `PEER A (${netPeerId}) · ${countA} CELLS · ${p2pLocalCuts} INTERIOR`;
  const midTxt = `∂P:${frameCutPorts.length}`;
  const rightTxt = compact
    ? `B(${countB}) · ${p2pWireFrames} FRAMES`
    : `${peerBName} · ${countB} CELLS · ${p2pWireFrames} WIRE FRAMES`;

  ctx.font = compact ? '800 9.5px ui-monospace, Menlo, monospace' : '800 10.5px ui-monospace, Menlo, monospace';
  const lw = ctx.measureText(leftTxt).width;
  const mw = ctx.measureText(midTxt).width + 14;
  const rw = ctx.measureText(rightTxt).width;
  const padX = 10, boxH = 23;
  const totalW = Math.min(W - 16, Math.ceil(lw + mw + rw + padX * 4));
  const anchorX = Math.max(8 + totalW / 2, Math.min(W - 8 - totalW / 2, cutX));
  const boxX = Math.round(anchorX - totalW / 2);

  ctx.fillStyle = isLight ? 'rgba(255,255,255,0.94)' : 'rgba(0,0,0,0.92)';
  ctx.fillRect(boxX, pillY, totalW, boxH);
  ctx.strokeStyle = ink;
  ctx.lineWidth = 1.5;
  ctx.strokeRect(boxX, pillY, totalW, boxH);

  const midCenter = boxX + padX + lw + padX + mw / 2;
  ctx.textBaseline = 'middle';
  ctx.fillStyle = ink;
  ctx.textAlign = 'left';
  ctx.fillText(leftTxt, boxX + padX, pillY + boxH / 2 + 0.5);

  ctx.fillStyle = '#ff0a94';
  ctx.textAlign = 'center';
  ctx.fillText(midTxt, midCenter, pillY + boxH / 2 + 0.5);

  ctx.fillStyle = opBlue;
  ctx.textAlign = 'right';
  ctx.fillText(rightTxt, boxX + totalW - padX, pillY + boxH / 2 + 0.5);

  ctx.restore();
}

function toggleP2PCut() {
  p2pCutMode = !p2pCutMode;
  p2pLocalCuts = 0;
  p2pWireFrames = 0;
  flyingWireFrames.length = 0;
  if (p2pCutMode) {
    partitionNetPeers(net, true);
    cam.x = 0;
  } else {
    for (const c of net.cells.values()) c.peer = 0;
  }
  net.layoutDirty = true;
  const btn = document.getElementById('btnP2P');
  if (btn) btn.classList.toggle('on', p2pCutMode);
  if (p2pCutMode && netBC) netBC.postMessage(JSON.stringify({ t: 'HELLO', from: netPeerId }));
  showStepToast(
    p2pCutMode ? 'P2P GRAPH PARTITION ACTIVE (PEER A ⋈ PEER B)' : 'SINGLE-NODE VIEW',
    p2pCutMode
      ? 'Cells bisected into Peer A (left) and Peer B (right) with ◇ channel ports on ∂P. Drag any cell across ∂P to migrate it live!'
      : 'Returned to unpartitioned single-machine canvas.',
    false
  );
}

function startPlayLoop() {
