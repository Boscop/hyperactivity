      this.wire(pair, 1, head, 0);
      if (k < 6) {
        const nextFix = spawn('O_FIX', 'fix', '▸ κ', 2, { tick: k + 1 });
        const tick = spawn('V_CON', '⋄', 'Tick κ', 1);
        this.wire(pair, 2, nextFix, 1);
        this.wire(nextFix, 0, tick, 0);
      } else {
        const selfEnd = spawn('V_CON', 'self', 'fixed pt', 1);
        this.wire(pair, 2, selfEnd, 0);
      }
      this.remove(opId); this.remove(valId);
    }

    if (p2pSnap) finalizeP2PFire(this, p2pSnap, evId, false);
    this.trace.unshift({ step: this.work, rule: info.text, ratio: (PYTH[info.key] || PYTH.beta).name });
    if (this.trace.length > 60) this.trace.pop();
    return info;
  }

  narrate(op, val) {
    if (op.kind === 'O_ADD' && val.kind === 'V_S') return `+ met S(n): peeled one S to the output and pushed + one step deeper.`;
    if (op.kind === 'O_ADD' && val.kind === 'V_Z') return `+ met Z (zero): annihilated both cells and wired the second number straight to output.`;
    if (op.kind === 'O_MUL' && val.kind === 'V_S') return `× met S(n): spawned δ (duplicator) to share the second number into + and ×.`;
    if (op.kind === 'O_MUL' && val.kind === 'V_Z') return `× met Z (zero): output Z and spawned ε (eraser) to dissolve the unused argument.`;
    if (op.kind === 'O_BINC' && val.kind === 'V_B1') return `Carry +1 met bit 1: flipped bit to 0 and rippled a new +1 carry to the next bit.`;
    if (op.kind === 'O_BINC' && val.kind === 'V_B0') return `Carry +1 met bit 0: absorbed the carry in 1 local step, flipping 0 to 1.`;
    if (op.kind === 'O_BINC' && val.kind === 'V_BE') return `Carry +1 reached end of bit-string: allocated a new most-significant bit 1.`;
    if (op.kind === 'O_BADD' && val.kind === 'V_BE') return `Binary +₂ reached end of first number: wired remaining bits straight to output.`;
    if (op.kind === 'O_BADD') return `Binary +₂ added LSB pair locally, emitting the sum bit and spawning +1 if both bits were 1.`;
    if (op.kind === 'O_CMP' && op.meta.cert) return `Merged sorted sub-pairs into a dependent pair Σ(Sorted List, Proof Witness) so the rationale travels with the value.`;
    if (op.kind === 'O_CMP' && op.meta.stage === 'merge') return `Merged the two sorted sub-pairs into a single ordered list.`;
    if (op.kind === 'O_CMP') return `Compared two numbers locally and ordered them into [min, max].`;
    if (op.kind === 'O_EQ' && val.kind === 'V_S') return `Equality ≡ matched S on both sides (cong suc): peeled one successor layer off both numbers.`;
    if (op.kind === 'O_EQ' && val.kind === 'V_Z') return `Equality ≡ reached base case Z: if both sides hit Z, emits proof witness refl; otherwise refutes with ⊥.`;
    if (op.kind === 'O_LMERGE' && val.kind === 'V_NIL') return `merge hit empty list []: wired the remaining sorted tail straight to output.`;
    if (op.kind === 'O_LMERGE' && val.kind === 'V_CONS') return `merge compared the two list heads locally, emitted the smaller head ::, and pushed merge onto the tails.`;
    if (op.kind === 'O_LEQ' && val.kind === 'V_S') return `Atomic Peano ≤ peeled one S layer off both numbers simultaneously (S a ≤ S b ⟺ a ≤ b).`;
    if (op.kind === 'O_LEQ' && val.kind === 'V_Z') return `Atomic Peano ≤ hit Z first — decided the smaller number and emitted sorted pair min :: max :: [].`;
    if (op.kind === 'O_LIFE' && val.kind === 'V_TICK') {
      const ph = (val.meta.t || 1) % 3;
      if (ph === 1) return `Guarded tick κ${val.meta.t}: ▸ self sensed environment, emitted obs ${val.meta.t}, and spawned next guarded self.`;
      if (ph === 2) return `Guarded tick κ${val.meta.t}: mitosis — parallel act/signal branch running alongside ▸ self.`;
      return `Guarded tick κ${val.meta.t}: homeostatic closure — recycled spent shell back into persistent O(1) core (never stalls, never explodes).`;
    }
    if (op.kind === 'O_PRUNE') return `Autopoietic metabolism: processed ${val.label} locally and maintained homeostasis.`;
    if (op.kind === 'O_NOT') return `not met ${val.label} head-to-head and flipped it to ${val.label === 'true' ? 'false' : 'true'}.`;
    if (op.kind === 'O_APP' && val.kind === 'V_LAM') return `β-reduction: app annihilated λ(${val.sub}), wiring argument to parameter and body to output.`;
    if (op.kind === 'O_DUP' && val.kind === 'V_S') return `δ duplicated S(n) into two S cells sharing a new δ on the tail.`;
    if (op.kind === 'O_DUP') return `δ commuted through ${val.label}, duplicating it lazily one layer at a time.`;
    if (op.kind === 'O_ERA') return `ε dissolved ${val.label} locally with zero garbage collector.`;
    if (op.kind === 'O_FST' || op.kind === 'O_SND') return `${op.label} kept one side of pair and spawned ε to erase the other.`;
    if (op.kind === 'O_PAPPP') return `Applied cubical path at ${op.sub}, spawning a dimension substitution wave.`;
    if (op.kind === 'O_SUBST') return `Substitution wave ${op.label} propagated through ${val.label}.`;
    if (op.kind === 'O_COMP' && val.kind === 'V_SYS') return `Kan composition filled the open square, closing the lid p ∙ q.`;
    if (op.kind === 'O_COMP' && val.kind === 'V_GLUE') return `Transport along ua(notEquiv) reduced Glue into unglue on face i=0.`;
    if (op.kind === 'O_UNGLUE') return `unglue extracted the equivalence function and applied it to the input.`;
    if (op.kind === 'O_UDEF') return op.meta && op.meta.combinator ? `Unfolded definition ${op.label} into its interaction-net body.` : `Matched ${op.label} against constructor ${val.label} and rewired its fields locally.`;
    return `${op.label} interacted with ${val.label} locally.`;
  }

  stepParallel(sequential = false) {
    const pairs = this.activePairs();
    if (!pairs.length) return 0;
    const HORIZON_CELLS = 96;
    const MAX_FIRES_PER_STEP = sequential ? 1 : 12;
    if (this.cells.size >= HORIZON_CELLS) {
      this.horizonHit = true;
      showStepToast('LAZY HORIZON (96 CELLS)', 'Paused automatic expansion to prevent exponential blowup. Click any pink pair to expand on demand.', false);
      return 0;
    }
    this.horizonHit = false;
    this.depth++;
    const batch = pairs.slice(0, MAX_FIRES_PER_STEP);
    const narrations = batch.map(p => this.narrate(p.op, p.val));
    const ids = batch.map(p => [p.op.id, p.val.id]);
    let fired = 0;
    for (let idx = 0; idx < ids.length; idx++) {
      if (this.cells.size >= HORIZON_CELLS) { this.horizonHit = true; break; }
      const [oid, vid] = ids[idx];
      const info = this.firePair(oid, vid);
      if (info) { fired++; audio.playRule(info.key, idx, ids.length); }
    }
    const done = this.activePairs().length === 0;
    if (done) {
      setTimeout(() => audio.playNormalForm(), 160);
      const speedup = this.depth > 0 ? (this.work / this.depth).toFixed(2) : '1.00';
      showStepToast(`NORMAL FORM ≡ · W=${this.work} D=${this.depth} (${speedup}×)`, `${narrations[0]} Computation complete — 0 active pairs remain.`, true);
    } else if (fired === 1) {
      showStepToast(`${sequential ? 'SEQUENTIAL' : 'STEP'} · D=${this.depth} · W=${this.work}`, narrations[0], false);
    } else if (fired > 1) {
      showStepToast(`PARALLEL (${fired}× SIMULTANEOUS) · D=${this.depth}`, `Fired ${fired} disjoint active pairs in lock-free parallel: ${narrations[0]}`, false);
    }
    return fired;
  }

  // ==========================================================================
  // CROSSING-FREE PLANAR + POINCARÉ DISK (ℍ²) HYPERBOLIC LAYOUT ENGINE
  // ==========================================================================
  computeLayouts() {
    if (!this.layoutDirty) return;
    this.layoutDirty = false;
    const cells = [...this.cells.values()];
    if (!cells.length) return;
    const root = cells.find(c => c.polarity === 'root') || cells[0];

    // Build ordered spanning tree from root (preserving port order so wires never cross!)
    const visited = new Set([root.id]);
    const children = new Map();
    const queue = [root.id];
    while (queue.length) {
      const id = queue.shift();
      const c = this.cells.get(id);
      const kids = [];
      for (let p = 0; p < c.ports.length; p++) {
        const ep = c.ports[p];
        if (ep && this.cells.has(ep.cell) && !visited.has(ep.cell)) {
          visited.add(ep.cell);
          kids.push(ep.cell);
          queue.push(ep.cell);
        }
      }
      children.set(id, kids);
    }
    // Attach any disconnected components cleanly
    for (const c of cells) {
      if (!visited.has(c.id)) {
        visited.add(c.id);
        children.get(root.id).push(c.id);
        children.set(c.id, []);
      }
    }

    // Subtree leaf weights for proportional planar & hyperbolic angular allocation
    const weight = new Map();
    function calcW(id) {
      const kids = children.get(id) || [];
      if (!kids.length) { weight.set(id, 1); return 1; }
      let s = 0; for (const k of kids) s += calcW(k);
      weight.set(id, s); return s;
    }
    calcW(root.id);

    // 1. CROSSING-FREE PLANAR HIERARCHICAL LAYOUT (ordered x-slots by subtree weight)
    const self = this;
    const levelY = 104, unitX = 96;
    const cellDepth = new Map();
    function placePlanar(id, depth, xMin, xMax) {
      const c = self.cells.get(id);
      cellDepth.set(id, depth);
      c.tx = (xMin + xMax) / 2;
      c.ty = -210 + depth * levelY;
      const kids = children.get(id) || [];
      const totalW = weight.get(id) || 1;
      let cur = xMin;
      for (const k of kids) {
        const w = weight.get(k) || 1;
        const span = (xMax - xMin) * (w / totalW);
        placePlanar(k, depth + 1, cur, cur + span);
        cur += span;
      }
    }
    const totalSpan = Math.max(240, (weight.get(root.id) || 1) * unitX);
    placePlanar(root.id, 0, -totalSpan / 2, totalSpan / 2);

    // 2. POINCARÉ DISK (ℍ²) HYPERBOLIC LAYOUT — ZERO CROSSINGS FOR EXPONENTIAL TREES!
    // Root sits at origin (0,0); depth d maps to hyperbolic radius r_h = d * 0.85 -> r_poincare = tanh(r_h / 2)
    function placeHyperbolic(id, depth, aMin, aMax) {
      const c = self.cells.get(id);
      if (depth === 0) {
        c.thx = 0; c.thy = 0;
      } else {
        const ang = (aMin + aMax) / 2;
        const r = Math.tanh(depth * 0.56);
        c.thx = r * Math.cos(ang);
        c.thy = r * Math.sin(ang);
      }
      const kids = children.get(id) || [];
      const totalW = weight.get(id) || 1;
      let cur = aMin;
      for (const k of kids) {
        const w = weight.get(k) || 1;
        const span = (aMax - aMin) * (w / totalW);
        placeHyperbolic(k, depth + 1, cur, cur + span);
        cur += span;
      }
    }
    placeHyperbolic(root.id, 0, -Math.PI / 2, Math.PI * 1.5);

    // 3. SOVEREIGN TWO-PEER DOMAIN SEPARATION (Peer A: x < -84, Peer B: x > +84)
    if (typeof p2pCutMode !== 'undefined' && p2pCutMode) {
      const parentOf = new Map();
      for (const [pid, kids] of children.entries()) {
        for (const kid of kids) parentOf.set(kid, pid);
      }
      for (let side = 0; side <= 1; side++) {
        const sideSet = new Set(cells.filter(c => (c.peer || 0) === side).map(c => c.id));
        if (!sideSet.size) continue;
        const sideRoots = [...sideSet].filter(id => !parentOf.has(id) || !sideSet.has(parentOf.get(id)));
        sideRoots.sort((a, b) => (self.cells.get(a).tx - self.cells.get(b).tx) || (a - b));
        const sWeight = new Map();
        const calcSW = (id) => {
          const sk = (children.get(id) || []).filter(k => sideSet.has(k));
          if (!sk.length) { sWeight.set(id, 1); return 1; }
          let sum = 0; for (const k of sk) sum += calcSW(k);
          sWeight.set(id, sum); return sum;
        };
        let totalSW = 0;
        for (const rId of sideRoots) totalSW += calcSW(rId);
        const margin = 84;
        const spanW = Math.max(116, totalSW * 94);
        const xStart = side === 0 ? (-margin - spanW) : margin;
        const aStart = side === 0 ? (0.60 * Math.PI) : (-0.40 * Math.PI);
        const aSpan = 0.80 * Math.PI;
        const placeSide = (id, x0, x1, a0, a1) => {
          const c = self.cells.get(id);
          c.tx = (x0 + x1) / 2;
          const d = cellDepth.get(id) || 0;
          const r = Math.tanh((d + 1) * 0.44);
          const ang = (a0 + a1) / 2;
          c.thx = r * Math.cos(ang);
          c.thy = r * Math.sin(ang);
          const sk = (children.get(id) || []).filter(k => sideSet.has(k));
          const sw = sWeight.get(id) || 1;
          let cx0 = x0, ca0 = a0;
          for (const k of sk) {
            const kw = sWeight.get(k) || 1;
            const dx = (x1 - x0) * (kw / sw), da = (a1 - a0) * (kw / sw);
            placeSide(k, cx0, cx0 + dx, ca0, ca0 + da);
            cx0 += dx; ca0 += da;
          }
        };
        let curX = xStart, curA = aStart;
        for (const rId of sideRoots) {
          const rw = sWeight.get(rId) || 1;
          const dx = spanW * (rw / (totalSW || 1)), da = aSpan * (rw / (totalSW || 1));
          placeSide(rId, curX, curX + dx, curA, curA + da);
          curX += dx; curA += da;
        }
      }
    }
  }
}

// ============================================================================
// 4. LIVE HYPERACTIVITY EXPRESSION → INTERACTION NET COMPILER
// ============================================================================
function tokenize(src) {
  const toks = []; let i = 0;
  while (i < src.length) {
    const c = src[i];
    if (/\s/.test(c)) { i++; continue; }
    if (c === '-' && src[i+1] === '>') { toks.push({ t:'ARR', v:'→' }); i += 2; continue; }
    if (c === '→') { toks.push({ t:'ARR', v:'→' }); i++; continue; }
    if (c === 'λ' || c === '\\') { toks.push({ t:'LAM', v:'λ' }); i++; continue; }
    if ('(),@~:.'.includes(c)) { toks.push({ t:c, v:c }); i++; continue; }
    if (c === '#') {
      let j = i + 1; while (j < src.length && /[0-9]/.test(src[j])) j++;
      toks.push({ t:'WORD', v: src.slice(i, j), n: parseInt(src.slice(i+1, j) || '0', 10) });
      i = j; continue;
    }
    if (/[A-Za-z0-9_']/.test(c)) {
      let j = i; while (j < src.length && /[A-Za-z0-9_']/.test(src[j])) j++;
      toks.push({ t:'ID', v: src.slice(i, j) }); i = j; continue;
    }
    throw new Error(`Unexpected '${c}'`);
  }
  return toks;
}

function parseExpr(src) {
  const toks = tokenize(src); let pos = 0;
  const peek = () => toks[pos];
  const eat = (t) => { const k = toks[pos]; if (!k || (t && k.t !== t)) throw new Error(`Expected ${t || 'token'}`); pos++; return k; };
  function pExpr() {
    let left = pLam();
    if (peek() && peek().t === ',') { eat(','); return { k:'pair', a:left, b:pExpr() }; }
    return left;
  }
  function pLam() {
    if (peek() && peek().t === 'LAM') {
      eat('LAM'); const binders = [];
      while (peek() && peek().t !== 'ARR' && peek().t !== '.') {
        if (peek().t === '(') {
          eat('('); const name = eat('ID').v; let isDim = false;
          if (peek() && peek().t === ':') { eat(':'); if (eat('ID').v === 'I') isDim = true; }
          eat(')'); binders.push({ name, isDim });
        } else {
          const name = eat('ID').v;
          binders.push({ name, isDim: (name === 'i' || name === 'j' || name === 'k') });
        }
      }
      if (!binders.length) throw new Error('Expected binder after λ');
      if (peek() && (peek().t === 'ARR' || peek().t === '.')) eat();
      let body = pExpr();
      for (let b = binders.length - 1; b >= 0; b--)
        body = binders[b].isDim ? { k:'plam', dim:binders[b].name, body } : { k:'lam', param:binders[b].name, body };
      return body;
    }
    return pApp();
  }
  function pApp() {
    let node = pAtom();
    while (peek()) {
      if (peek().t === '@') { eat('@'); node = { k:'papp', fn:node, r:pAtom() }; }
      else if (['ID','WORD','(','LAM','~'].includes(peek().t)) {
        const arg = pAtom();
        if (node.k === 'var' && node.name === 'fst') node = { k:'fst', e:arg };
        else if (node.k === 'var' && node.name === 'snd') node = { k:'snd', e:arg };
        else if (node.k === 'var' && node.name === 'unfold') node = { k:'unfold', e:arg };
        else node = { k:'app', fn:node, arg };
      } else break;
    }
    return node;
  }
  function pAtom() {
    const k = peek(); if (!k) throw new Error('Unexpected end');
    if (k.t === '(') { eat('('); const e = pExpr(); eat(')'); return e; }
    if (k.t === 'LAM') return pLam();
    if (k.t === '~') { eat('~'); return { k:'neg', e:pAtom() }; }
    if (k.t === 'WORD') { eat('WORD'); return { k:'word', n:k.n, v:k.v }; }
    if (k.t === 'ID') { eat('ID'); return { k:'var', name:k.v }; }
    throw new Error(`Unexpected '${k.v}'`);
  }
  const ast = pExpr();
  if (pos < toks.length) throw new Error(`Trailing '${toks[pos].v}'`);
  return ast;
}

function compileAstToNet(ast, net) {
  const root = net.add('ROOT', 'OUT', 'observer', 1, 0, -200);
  function emit(node, env, dims) {
    if (node.k === 'var') {
      if (env.has(node.name)) { const proxy = { cell:null, port:null }; env.get(node.name).push(proxy); return { kind:'pending', proxy }; }
      if (dims.has(node.name)) return { cell: net.add('V_IV', node.name, 'dim ∈ I', 1, 0, 0, { expr: node.name }), port: 0 };
      return { cell: net.add('V_CON', node.name, 'atom', 1), port: 0 };
    }
    if (node.k === 'word') return { cell: net.add('V_WORD', node.v, 'Word', 1, 0, 0, { n: node.n }), port: 0 };
    if (node.k === 'neg') {
      const inner = node.e.k === 'var' ? node.e.name : 'i';
      return { cell: net.add('V_IV', `~${inner}`, 'De Morgan', 1, 0, 0, { expr: `~${inner}` }), port: 0 };
    }
    if (node.k === 'pair') {
      const p = net.add('V_PAIR', 'pair', 'Σ', 3);
      connect(p, 1, emit(node.a, env, dims)); connect(p, 2, emit(node.b, env, dims));
      return { cell: p, port: 0 };
    }
    if (node.k === 'fst' || node.k === 'snd') {
      const op = net.add(node.k === 'fst' ? 'O_FST' : 'O_SND', node.k, node.k === 'fst' ? 'O_FST' : 'O_SND', 2);
      connect(op, 0, emit(node.e, env, dims)); return { cell: op, port: 1 };
    }
    if (node.k === 'unfold') {
      const op = net.add('O_UNFOLD', 'unfold', 'O_UNFOLD', 2);
      connect(op, 0, emit(node.e, env, dims)); return { cell: op, port: 1 };
    }
    if (node.k === 'app') {
      const app = net.add('O_APP', 'app', 'O_APP', 3);
      connect(app, 0, emit(node.fn, env, dims)); connect(app, 1, emit(node.arg, env, dims));
      return { cell: app, port: 2 };
    }
    if (node.k === 'lam') {
      const lam = net.add('V_LAM', 'λ', node.param, 3);
      const prev = env.get(node.param), uses = []; env.set(node.param, uses);
      const body = emit(node.body, env, dims);
      if (prev !== undefined) env.set(node.param, prev); else env.delete(node.param);
      connect(lam, 2, body);
      if (uses.length === 0) { const era = net.add('O_ERA', 'ε', `unused`, 1); net.wire(lam, 1, era, 0); }
      else if (uses.length === 1) { if (uses[0].cell) net.wire(lam, 1, uses[0].cell, uses[0].port); }
      else {
        let curC = lam, curP = 1;
        for (let k = 0; k < uses.length - 1; k++) {
          const dup = net.add('O_DUP', 'δ', 'O_DUP', 3);
          net.wire(curC, curP, dup, 0);
          if (uses[k].cell) net.wire(dup, 1, uses[k].cell, uses[k].port);
          curC = dup; curP = 2;
        }
        const last = uses[uses.length - 1];
        if (last.cell) net.wire(curC, curP, last.cell, last.port);
      }
      return { cell: lam, port: 0 };
    }
    if (node.k === 'plam') {
      net.kanMode = 'path';
      const plam = net.add('V_PLAM', 'path-λ', node.dim, 2);
      const nd = new Set(dims); nd.add(node.dim);
      connect(plam, 1, emit(node.body, env, nd)); return { cell: plam, port: 0 };
    }
    if (node.k === 'papp') {
      const rStr = node.r.k === 'neg' ? `~${node.r.e.name || 'i'}` : (node.r.name || node.r.v || '0');
      if (node.fn.k === 'var' && !env.has(node.fn.name)) {
        const lbl = `${node.fn.name} @ ${rStr}`;
        return { cell: net.add('V_IV', lbl, 'path fiber', 1, 0, 0, { expr: lbl }), port: 0 };
      }
      net.kanMode = 'path';
      const papp = net.add('O_PAPPP', `@ ${rStr}`, rStr, 2);
      connect(papp, 0, emit(node.fn, env, dims)); return { cell: papp, port: 1 };
    }
    throw new Error('Unsupported node');
  }
  function connect(cid, pidx, target) {
    if (target.kind === 'pending') { target.proxy.cell = cid; target.proxy.port = pidx; }
    else net.wire(cid, pidx, target.cell, target.port);
  }
  connect(root, 0, emit(ast, new Map(), new Set()));
}

function buildPeano(net, n) {
  let head = net.add('V_Z', 'Z', '0', 1);
  for (let i = 0; i < n; i++) {
    const s = net.add('V_S', 'S', 'Nat', 2);
    net.wire(s, 1, head, 0);
    head = s;
  }
  return head;
}

function buildBinary(net, n) {
  if (n === 0) return net.add('V_BE', 'end', '0b', 1);
  const bits = [];
  let v = n;
  while (v > 0) { bits.push(v & 1); v >>= 1; }
  let head = net.add('V_BE', 'end', '0b', 1);
  for (let i = bits.length - 1; i >= 0; i--) {
    const b = net.add(bits[i] ? 'V_B1' : 'V_B0', String(bits[i]), 'bit', 2);
    net.wire(b, 1, head, 0);
    head = b;
  }
  return head;
}

function tryCompileCurriculum(src, net) {
  const s = src.trim();
  let m;
  if (/^life$/i.test(s)) {
    const root = net.add('ROOT', 'OUT', '▸ Proc κ', 1);
