function toHexBytes(u8) {
  let s = '';
  for (let i = 0; i < u8.length; i++) s += u8[i].toString(16).padStart(2, '0');
  return s;
}
async function sha256Text(str) {
  const bytes = new TextEncoder().encode(str);
  const d = await crypto.subtle.digest('SHA-256', bytes);
  return toHexBytes(new Uint8Array(d));
}

// --- Sovereign IndexedDB CAStore (hx-cas-v1) ---
let casDB = null;
const workspaceMap = new Map();
const publicHashAllowlist = new Set();

function openLocalPool() {
  if (!('indexedDB' in window)) return Promise.resolve(null);
  return new Promise(res => {
    try {
      const req = indexedDB.open('hx-cas-v1', 2);
      req.onupgradeneeded = () => {
        const db = req.result;
        if (!db.objectStoreNames.contains('obj')) db.createObjectStore('obj');
        if (!db.objectStoreNames.contains('ws')) db.createObjectStore('ws', { keyPath: 'path' });
      };
      req.onsuccess = () => { casDB = req.result; res(casDB); };
      req.onerror = () => res(null);
    } catch (e) { res(null); }
  });
}

function casGet(hash) {
  if (!casDB || !hash) return Promise.resolve(null);
  return new Promise(res => {
    try {
      const r = casDB.transaction('obj', 'readonly').objectStore('obj').get(hash);
      r.onsuccess = async () => {
        const val = r.result;
        if (typeof val !== 'string') return res(null);
        if (hash.length === 64 && (await sha256Text(val)) !== hash) return res(null);
        res(val);
      };
      r.onerror = () => res(null);
    } catch (e) { res(null); }
  });
}

async function casPutVerified(expectedHash, text) {
  const actual = await sha256Text(text);
  if (expectedHash && expectedHash.length === 64 && actual !== expectedHash) {
    throw new Error('SHA-256 mismatch');
  }
  if (casDB) {
    await new Promise(res => {
      try {
        const tx = casDB.transaction('obj', 'readwrite');
        tx.objectStore('obj').put(text, actual);
        tx.oncomplete = () => res(true);
        tx.onerror = () => res(false);
      } catch (e) { res(false); }
    });
    refreshCasCount();
  }
  return actual;
}

function wsLoadAll() {
  if (!casDB || !casDB.objectStoreNames.contains('ws')) return Promise.resolve([]);
  return new Promise(res => {
    try {
      const r = casDB.transaction('ws', 'readonly').objectStore('ws').getAll();
      r.onsuccess = () => res(r.result || []);
      r.onerror = () => res([]);
    } catch (e) { res([]); }
  });
}

function wsPutRecord(rec) {
  workspaceMap.set(rec.path, rec);
  if (!casDB || !casDB.objectStoreNames.contains('ws')) return Promise.resolve();
  return new Promise(res => {
    try {
      const tx = casDB.transaction('ws', 'readwrite');
      tx.objectStore('ws').put(rec);
      tx.oncomplete = () => res();
      tx.onerror = () => res();
    } catch (e) { res(); }
  });
}

function refreshCasCount() {
  if (!casDB) return;
  try {
    const r = casDB.transaction('obj', 'readonly').objectStore('obj').count();
    r.onsuccess = () => {
      const el = document.getElementById('casCountBadge');
      if (el) el.textContent = (r.result || 0) + ' objs';
    };
  } catch (e) {}
}

// --- Live Peer Mesh (BroadcastChannel + WebRTC) ---
const meshPeers = new Map();
const myOffers = {}, myAnswers = {};
const pendingWants = new Map(), pendingCuts = new Map(), rtcPending = new Map();

async function buildMyManifest() {
  const pubMods = [];
  workspaceMap.forEach(rec => {
    if (rec.visibility === 'public') pubMods.push({ path: rec.path, sha256: rec.sha256, bytes: rec.text.length });
  });
  pubMods.sort((a, b) => a.path.localeCompare(b.path));
  const root = await sha256Text(pubMods.map(m => m.path + ':' + m.sha256).join('\n'));
  return { peerId: netPeerId, root: root.slice(0, 16), published: pubMods };
}

function sendToMeshPeer(peerId, pkt) {
  const p = meshPeers.get(peerId);
  const raw = JSON.stringify({ ...pkt, from: netPeerId, to: peerId });
  if (p && p.dc && p.dc.readyState === 'open') { try { p.dc.send(raw); return true; } catch (e) {} }
  if (netBC && p && p.transport === 'LOCAL') { netBC.postMessage(raw); return true; }
  return false;
}

function broadcastMesh(pkt) {
  const raw = JSON.stringify({ ...pkt, from: netPeerId });
  if (netBC) netBC.postMessage(raw);
  meshPeers.forEach(p => {
    if (p.dc && p.dc.readyState === 'open') { try { p.dc.send(raw); } catch (e) {} }
  });
}

function liveMeshPeerIds() {
  const out = [], now = Date.now();
  meshPeers.forEach((p, id) => {
    if ((p.dc && p.dc.readyState === 'open') || (p.transport === 'LOCAL' && now - p.lastSeen < 18000)) out.push(id);
  });
  return out;
}

function renderPeersUI() {
  const ids = liveMeshPeerIds();
  const badge = document.getElementById('peerCountBadge');
  if (badge) badge.textContent = ids.length + (ids.length === 1 ? ' peer' : ' peers');
