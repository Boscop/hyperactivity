<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hyperactivity Studio · Live Interaction Nets &amp; Cubical Kernel</title>
<meta name="description" content="Unified Hyperactivity Studio: learn interaction nets from first principles, write and verify cubical modules in WebAssembly, and watch every definition reduce as live local cells.">
<script>
(function(){
  var q = new URLSearchParams(location.search);
  if (q.get('embed') === '1') document.documentElement.classList.add('embed');
  if (q.get('hero') === '1') document.documentElement.classList.add('hero');
  try {
    var t = localStorage.getItem('hxTheme');
    if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme:dark)').matches))
      document.documentElement.classList.add('dark');
  } catch (e) {}
})();
</script>
<style>
:root {
  --bg: #ffffff;
  --panel: #fafafa;
  --card: rgba(255, 255, 255, 0.94);
  --ink: #000000;
  --muted: #5a5a5a;
  --line: rgba(0, 0, 0, 0.12);
  --line-strong: rgba(0, 0, 0, 0.24);
  --border-hi: #000000;
  --pink: #ff0a94;
  --blue: #1a73e8;
  --ok: #0a8a43;
  --err: #d91b42;
  --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  --sans: -apple-system, BlinkMacSystemFont, 'Inter', 'Helvetica Neue', sans-serif;
}
html.dark {
  --bg: #000000;
  --panel: #080808;
  --card: rgba(8, 8, 8, 0.92);
  --ink: #ffffff;
  --muted: #989898;
  --line: rgba(255, 255, 255, 0.13);
  --line-strong: rgba(255, 255, 255, 0.26);
  --border-hi: #ffffff;
  --pink: #ff0a94;
  --blue: #4da3ff;
  --ok: #26d07c;
  --err: #ff4d6d;
}
* { box-sizing: border-box; }
html, body {
  margin: 0; height: 100%; overflow: hidden;
  background: var(--bg); color: var(--ink);
  font-family: var(--sans);
  -webkit-font-smoothing: antialiased;
}
::selection { background: var(--pink); color: #fff; }

.workspace {
  display: grid;
  grid-template-columns: 396px minmax(0, 1fr);
  grid-template-rows: minmax(0, 1fr) 52px;
  height: calc(100vh - 48px);
  transition: grid-template-columns 0.18s ease;
}
.workspace.rail-collapsed {
  grid-template-columns: 0px minmax(0, 1fr);
}
.workspace.rail-collapsed .sidebar {
  border-right: 0; overflow: hidden; pointer-events: none; opacity: 0;
}

/* LEFT RAIL: Calm 3-Lens Studio Pane (Learn · Code · Pool) */
.sidebar {
  grid-row: 1 / 3;
  border-right: 1.5px solid var(--line-strong);
  background: var(--panel);
  display: flex; flex-direction: column;
  min-width: 0; min-height: 0;
  transition: opacity 0.15s ease;
}
.mode-bar {
  display: flex; align-items: center; gap: 4px;
  padding: 10px 12px;
  border-bottom: 1px solid var(--line);
  background: var(--bg);
}
.mode-tabs {
  display: grid; grid-template-columns: repeat(3, 1fr);
  flex: 1; border: 1.5px solid var(--border-hi); background: var(--bg);
}
.mode-tab {
  background: transparent; color: var(--ink); border: 0;
  border-right: 1px solid var(--line-strong);
  padding: 6px 8px;
  font: 700 11.5px/1.2 var(--mono);
  letter-spacing: 0.03em; cursor: pointer;
}
.mode-tab:last-child { border-right: 0; }
.mode-tab:hover { color: var(--pink); }
.mode-tab.on { background: var(--ink); color: var(--bg); }
.rail-hide-btn {
  background: transparent; color: var(--muted);
  border: 1px solid var(--line-strong);
  width: 28px; height: 28px; cursor: pointer;
  font: 700 12px var(--mono); flex-shrink: 0;
}
.rail-hide-btn:hover { border-color: var(--pink); color: var(--pink); }

.pane-body {
  display: none; flex: 1; flex-direction: column; min-height: 0; overflow: hidden;
}
.pane-body.on { display: flex; }

/* TAB 1: LEARN (Pedagogy + Live Code + Guided Curriculum) */
.learn-scroll {
  flex: 1; overflow-y: auto; padding: 14px 16px 22px;
  display: flex; flex-direction: column; gap: 14px;
}
.lesson-story {
  background: var(--bg); border: 1.5px solid var(--border-hi);
  padding: 14px 15px;
}
.lesson-kicker {
  font: 800 10px/1.2 var(--mono); letter-spacing: 0.11em;
  text-transform: uppercase; color: var(--pink); margin-bottom: 6px;
}
.lesson-title {
  font: 800 17px/1.22 var(--sans); letter-spacing: -0.015em; margin: 0 0 8px;
}
.lesson-prose {
  font: 400 13.5px/1.55 var(--sans); color: var(--ink); opacity: 0.88; margin: 0;
}
.lesson-code-box {
  margin-top: 12px; border-top: 1px solid var(--line); padding-top: 10px;
}
.lesson-code-head {
  display: flex; justify-content: space-between; align-items: center;
  font: 700 10px var(--mono); color: var(--muted); text-transform: uppercase;
  letter-spacing: 0.06em; margin-bottom: 6px;
}
.link-pill {
  background: none; border: 1px solid var(--pink); color: var(--pink);
  padding: 2px 8px; font: 700 10px var(--mono); cursor: pointer; text-decoration: none;
}
.link-pill:hover { background: var(--pink); color: #fff; }
pre.lesson-snippet {
  margin: 0; padding: 10px 12px; background: var(--panel);
  border: 1px solid var(--line-strong);
  font: 500 11.5px/1.5 var(--mono); white-space: pre-wrap; color: var(--ink);
}
.sec-head {
  display: flex; justify-content: space-between; align-items: center;
  font: 700 10px var(--mono); letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--muted); padding: 2px 2px 0;
}
.presets { display: flex; flex-direction: column; gap: 4px; }
.preset-btn {
  text-align: left; background: var(--bg); color: var(--ink);
  border: 1px solid var(--line-strong); padding: 8px 10px; cursor: pointer;
  transition: border-color 0.12s;
}
.preset-btn:hover { border-color: var(--pink); }
.preset-btn.active {
  border: 1.5px solid var(--pink);
  box-shadow: inset 3px 0 0 var(--pink);
}
.preset-btn .pt {
  display: flex; justify-content: space-between; align-items: center;
  font: 700 12px/1.25 var(--sans);
}
.preset-btn .tag {
  font: 700 9.5px var(--mono); color: var(--pink);
  border: 1px solid var(--line-strong); padding: 1px 5px;
}
.preset-btn .pe {
  font: 500 11px/1.3 var(--mono); color: var(--muted);
  margin-top: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* TAB 2: CODE (General .hypercubical Editor + cubical.wasm Checker) */
.code-top {
  display: flex; justify-content: space-between; align-items: center; gap: 6px;
  padding: 8px 12px; border-bottom: 1px solid var(--line); background: var(--bg);
}
.code-templates {
  display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; align-items: center;
}
.code-templates::-webkit-scrollbar { display: none; }
.tpl-chip {
  background: var(--panel); color: var(--ink);
  border: 1px solid var(--line-strong); padding: 3px 7px;
  font: 600 10.5px var(--mono); cursor: pointer; white-space: nowrap;
}
.tpl-chip:hover, .tpl-chip.on { border-color: var(--pink); color: var(--pink); }
.run-code-btn {
  background: var(--pink); color: #fff; border: 1.5px solid var(--pink);
  padding: 5px 11px; font: 700 11px var(--mono); cursor: pointer; white-space: nowrap;
}
.run-code-btn:hover { background: var(--ink); border-color: var(--ink); color: var(--bg); }

.target-strip {
  display: none; align-items: center; gap: 5px; flex-wrap: wrap;
  padding: 6px 12px; border-bottom: 1px solid var(--line);
  background: var(--panel); font: 600 10.5px var(--mono);
}
.target-strip.show { display: flex; }
.target-lbl { color: var(--muted); font-size: 10px; text-transform: uppercase; }
.target-chip {
  background: var(--bg); color: var(--ink); border: 1px solid var(--line-strong);
  padding: 2px 7px; font: 600 10.5px var(--mono); cursor: pointer;
}
.target-chip.on, .target-chip:hover { border-color: var(--pink); color: var(--pink); }

textarea#codeEditor {
  flex: 1; width: 100%; resize: none; border: 0; outline: 0;
  padding: 14px 16px; background: var(--bg); color: var(--ink);
  font: 500 12.5px/1.58 var(--mono); tab-size: 2; min-height: 0;
}
.kernel-status-box {
  border-top: 1.5px solid var(--border-hi); background: var(--panel);
  display: flex; flex-direction: column; max-height: 38%;
}
.kernel-bar {
  display: flex; justify-content: space-between; align-items: center; gap: 8px;
  padding: 7px 12px; font: 700 11px var(--mono); cursor: pointer; user-select: none;
}
.k-left { display: flex; align-items: center; gap: 7px; min-width: 0; }
.k-dot { width: 8px; height: 8px; background: var(--pink); flex-shrink: 0; }
.k-dot.ready { background: var(--ok); }
.k-dot.err { background: var(--err); }
#kernelStatusText { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#kernelTimeBadge { color: var(--muted); font-size: 10px; white-space: nowrap; }
pre#kernelOut {
  display: none; margin: 0; padding: 10px 12px;
  border-top: 1px solid var(--line);
  font: 500 11.5px/1.5 var(--mono); overflow-y: auto;
  white-space: pre-wrap; word-break: break-word; max-height: 170px;
}
.kernel-status-box.open pre#kernelOut { display: block; }

/* TAB 3: POOL & P2P (Sovereign CAS + WebRTC Mesh, clean & tucked away) */
.pool-scroll {
  flex: 1; overflow-y: auto; padding: 14px 16px 24px;
  display: flex; flex-direction: column; gap: 14px;
}
.pool-card {
  background: var(--bg); border: 1px solid var(--line-strong); padding: 11px 12px;
}
.pool-row { display: flex; gap: 5px; margin-top: 6px; }
.pool-input {
  flex: 1; min-width: 0; background: var(--bg); color: var(--ink);
  border: 1px solid var(--line-strong); padding: 6px 8px;
  font: 600 11px var(--mono); outline: none;
}
.pool-input:focus { border-color: var(--pink); }
.pool-btn {
  background: var(--ink); color: var(--bg); border: 1px solid var(--border-hi);
  padding: 6px 10px; font: 700 11px var(--mono); cursor: pointer; white-space: nowrap;
}
.pool-btn:hover { background: var(--pink); border-color: var(--pink); color: #fff; }
.pool-btn:disabled { opacity: 0.45; cursor: wait; }
.pool-note { font: 400 11px/1.45 var(--sans); color: var(--muted); margin-top: 6px; }
.ws-row, .hash-row {
  display: flex; justify-content: space-between; align-items: center; gap: 6px;
  padding: 4px 0; border-bottom: 1px solid var(--line);
  font: 500 11px/1.35 var(--mono);
}
.ws-row:last-child, .hash-row:last-child { border-bottom: 0; }
.tag-priv, .tag-pub {
  padding: 1px 5px; font-size: 9.5px; cursor: pointer; font-weight: 700;
}
.tag-priv { border: 1px solid var(--line-strong); color: var(--muted); }
.tag-pub { border: 1px solid var(--pink); color: var(--pink); }
.hash-list { max-height: 150px; overflow-y: auto; margin-top: 6px; }
.h-ok { color: var(--ok); white-space: nowrap; }

/* RIGHT STAGE: Spacious Iconic Cell Canvas */
.stage {
  position: relative; grid-column: 2; grid-row: 1;
  min-width: 0; min-height: 0; overflow: hidden; background: var(--bg);
}
#netCanvas { display: block; width: 100%; height: 100%; cursor: grab; }
#netCanvas:active { cursor: grabbing; }

.stage-hud {
  position: absolute; top: 12px; left: 12px; right: 12px;
  display: flex; justify-content: space-between; align-items: flex-start;
  gap: 10px; pointer-events: none; z-index: 5;
}
.hud-left { display: flex; align-items: center; gap: 6px; pointer-events: auto; max-width: min(460px, 62%); }
.rail-open-btn {
  display: none; background: var(--card); color: var(--ink);
  border: 1.5px solid var(--border-hi); height: 34px; padding: 0 10px;
  font: 700 11.5px var(--mono); cursor: pointer;
}
.workspace.rail-collapsed .rail-open-btn { display: inline-flex; align-items: center; gap: 5px; }
.rail-open-btn:hover { border-color: var(--pink); color: var(--pink); }

.compiler-card {
  background: var(--card); border: 1.5px solid var(--border-hi);
  padding: 5px 7px; display: flex; flex-direction: column; gap: 4px;
  backdrop-filter: blur(8px); flex: 1; min-width: 0;
}
.compiler-top { display: none; }
.compiler-row { display: flex; align-items: center; gap: 6px; }
.net-badge {
  font: 800 10px var(--mono); color: var(--pink); letter-spacing: 0.06em;
  padding: 0 4px; white-space: nowrap; user-select: none;
}
.expr-input {
  flex: 1; min-width: 140px; background: transparent; color: var(--ink);
  border: 0; outline: none; padding: 4px 4px;
  font: 600 12.5px var(--mono);
}
.compile-btn {
  background: var(--ink); color: var(--bg); border: 1px solid var(--border-hi);
  padding: 4px 10px; font: 700 11px var(--mono); cursor: pointer;
}
.compile-btn:hover { background: var(--pink); border-color: var(--pink); color: #fff; }
.compiler-err {
  display: none; font: 600 11px var(--mono); color: var(--err); padding: 2px 4px;
}
.desc { display: none; }

.metrics-card {
  pointer-events: auto; background: var(--card);
  border: 1.5px solid var(--border-hi); padding: 6px 12px;
  display: flex; gap: 14px; align-items: center; backdrop-filter: blur(8px);
}
.metric { display: flex; flex-direction: column; align-items: flex-end; }
.metric .ml { font: 700 9px var(--mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
.metric .mv { font: 800 13px var(--mono); color: var(--ink); }
.metric .mv.pink { color: var(--pink); }
.metric .mv.ok { color: var(--ok); }

.hover-tip {
  position: absolute; bottom: 64px; left: 14px; pointer-events: none; display: none;
  background: var(--card); border: 1.5px solid var(--border-hi);
  padding: 7px 11px; font: 700 11.5px/1.35 var(--mono); max-width: 360px; z-index: 6;
}
.hover-tip .ht-sub { font-weight: 500; font-size: 10.5px; color: var(--muted); margin-top: 2px; }

.step-toast {
  position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%) translateY(8px);
  background: var(--card); border: 1.5px solid var(--border-hi);
  padding: 8px 14px; max-width: min(520px, calc(100% - 28px));
  opacity: 0; pointer-events: none; transition: opacity 0.16s, transform 0.16s; z-index: 6;
}
.step-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
.step-toast.done { border-color: var(--pink); }
.st-head { font: 800 10px var(--mono); letter-spacing: 0.08em; color: var(--pink); text-transform: uppercase; }
.st-body { font: 500 12.5px/1.4 var(--sans); margin-top: 2px; }

.right-dock { position: absolute; bottom: 14px; right: 14px; pointer-events: none; z-index: 5; }
.dock-card {
  display: none; background: var(--card); border: 1.5px solid var(--border-hi); padding: 8px; width: 210px;
}
.dock-card.show { display: block; }
.dock-head { display: flex; justify-content: space-between; font: 800 9.5px var(--mono); color: var(--pink); margin-bottom: 4px; }
#kanCanvas { width: 100%; height: auto; display: block; }

/* BOTTOM BAR: Minimal, Spacious, Zero Clutter */
.controls {
  grid-column: 2; grid-row: 2;
  border-top: 1.5px solid var(--line-strong);
  background: var(--bg);
  display: flex; justify-content: space-between; align-items: center;
  padding: 0 14px; gap: 10px; position: relative; z-index: 10;
}
.ctrl-group { display: flex; align-items: center; gap: 6px; }
.btn {
  background: var(--bg); color: var(--ink);
  border: 1.5px solid var(--line-strong);
  padding: 6px 11px; font: 700 11.5px/1 var(--mono); cursor: pointer;
  white-space: nowrap;
}
.btn:hover { border-color: var(--pink); color: var(--pink); }
.btn.primary { background: var(--pink); border-color: var(--pink); color: #fff; }
.btn.primary:hover { background: var(--ink); border-color: var(--ink); color: var(--bg); }
.btn.on { background: var(--ink); border-color: var(--ink); color: var(--bg); }

/* Clean Settings Popover (keeps Granularity, Speed, Trace, Synesthesia out of your face!) */
.more-wrap { position: relative; }
.more-pop {
  display: none; position: absolute; bottom: 42px; right: 0;
  width: 268px; background: var(--bg); border: 1.5px solid var(--border-hi);
  padding: 12px; box-shadow: 0 8px 28px rgba(0,0,0,0.16);
  flex-direction: column; gap: 10px; z-index: 30;
}
.more-pop.open { display: flex; }
.pop-row {
  display: flex; justify-content: space-between; align-items: center; gap: 8px;
  font: 600 11px var(--mono);
}
.pop-row select {
  background: var(--panel); color: var(--ink); border: 1px solid var(--line-strong);
  padding: 4px 6px; font: 600 11px var(--mono);
}
.pop-row input[type="range"] { width: 120px; accent-color: var(--pink); }
.trace-mini {
  border-top: 1px solid var(--line); padding-top: 8px; max-height: 120px; overflow-y: auto;
  font: 500 10.5px/1.45 var(--mono); color: var(--muted);
}
.trace-row { display: flex; justify-content: space-between; gap: 6px; padding: 2px 0; }
.trace-row .rule { color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.trace-row .ratio { color: var(--pink); flex-shrink: 0; }

/* Responsive & Embed Modes */
@media (max-width: 960px) {
  .workspace { grid-template-columns: 1fr; grid-template-rows: 44% minmax(0, 1fr) 50px; }
  .sidebar { grid-row: 1; border-right: 0; border-bottom: 1.5px solid var(--line-strong); }
  .stage { grid-column: 1; grid-row: 2; }
  .controls { grid-column: 1; grid-row: 3; }
  .metrics-card, .rail-hide-btn { display: none; }
}
html.embed nav, html.embed .sidebar, html.embed .metrics-card, html.embed .right-dock, html.embed .rail-open-btn, html.embed #btnMore { display: none !important; }
html.embed .workspace { grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) 46px; height: 100vh; }
html.embed .stage { grid-column: 1; grid-row: 1; }
html.embed .controls { grid-column: 1; grid-row: 2; padding: 0 10px; }
html.hero .compiler-card, html.hero #btnHyp, html.hero #btnP2P { display: none !important; }
html.hero .step-toast { bottom: 10px; padding: 6px 10px; max-width: calc(100% - 20px); }
</style>
</head>
<body>
<!--HX:NAV-->

<div class="workspace" id="workspace">
  <aside class="sidebar" id="sidebar">
    <div class="mode-bar">
      <div class="mode-tabs" role="tablist">
        <button class="mode-tab on" data-mode="learn" id="tabLearn">Learn</button>
        <button class="mode-tab" data-mode="code" id="tabCode">Code</button>
        <button class="mode-tab" data-mode="pool" id="tabPool">Pool · P2P</button>
      </div>
      <button class="rail-hide-btn" id="btnHideRail" title="Collapse sidebar for full-screen net canvas">◂</button>
    </div>

    <!-- 1. LEARN TAB: Guided Story + Live Code + Curriculum -->
    <div class="pane-body on" id="paneLearn">
      <div class="learn-scroll">
        <div class="lesson-story">
          <div class="lesson-kicker" id="presetKicker">CHAPTER 1 · PEANO NUMBERS &amp; ADDITION</div>
          <h2 class="lesson-title" id="presetTitle">1. Unary Addition (2 + 3)</h2>
          <p class="lesson-prose" id="presetDesc"></p>
          <div class="lesson-code-box">
            <div class="lesson-code-head">
              <span>Surface Code (.hypercubical)</span>
              <button class="link-pill" id="btnOpenInCode">Edit in Code →</button>
            </div>
            <pre class="lesson-snippet" id="presetCodeSnippet"></pre>
          </div>
        </div>

        <div class="sec-head"><span>Interactive Curriculum</span><span>13 chapters</span></div>
        <div class="presets" id="presetList"></div>
      </div>
    </div>

    <!-- 2. CODE TAB: General .hypercubical Editor + Live Cell Compiler + WASM Typechecker -->
    <div class="pane-body" id="paneCode">
      <div class="code-top">
        <div class="code-templates" id="codeTemplates"></div>
        <button class="run-code-btn" id="btnRunCode" title="Typecheck in cubical.wasm &amp; render live interaction net (Ctrl/Cmd + Enter)">Run ↵</button>
      </div>
      <div class="target-strip" id="targetStrip">
        <span class="target-lbl">Visualize:</span>
        <div id="targetChips" style="display:flex;gap:4px;flex-wrap:wrap"></div>
      </div>
      <textarea id="codeEditor" spellcheck="false" placeholder="-- Write any data type, function, and #show expression…"></textarea>
      <div class="kernel-status-box" id="kernelBox">
        <div class="kernel-bar" id="kernelBarToggle" title="Click to toggle full cubical.wasm output">
          <div class="k-left">
            <span class="k-dot" id="kernelDot"></span>
            <span id="kernelStatusText">Cubical WASM kernel standing by…</span>
          </div>
          <span id="kernelTimeBadge">▾</span>
        </div>
        <pre id="kernelOut">Booting cubical.wasm in background worker…</pre>
      </div>
    </div>

    <!-- 3. POOL & P2P TAB: Sovereign IndexedDB CAS + Live WebRTC Mesh -->
    <div class="pane-body" id="panePool">
      <div class="pool-scroll">
        <div class="pool-card">
          <div class="sec-head"><span>Sovereign Workspace</span><span id="myNodeBadge" style="color:var(--pink)">peer: …</span></div>
          <div class="pool-row">
            <input class="pool-input" id="savePathInput" value="local/my_module.hypercubical" spellcheck="false">
            <select class="pool-input" id="saveVisSelect" style="flex:0 0 auto;width:auto">
              <option value="private">PRIVATE</option>
              <option value="public">PUBLISHED</option>
            </select>
          </div>
          <div class="pool-row">
            <button class="pool-btn" id="saveWsBtn" disabled style="width:100%">Check &amp; Record to Pool</button>
          </div>
          <div class="pool-note"><b>PRIVATE</b> stays in browser IndexedDB. <b>PUBLISHED</b> is shared with live peers while open.</div>
          <div id="wsList" style="margin-top:8px"></div>
