function withCStr(str,fn){const b=enc.encode(str),p=ex.wasm_alloc(b.length+1);new Uint8Array(memory.buffer).set(b,p);new Uint8Array(memory.buffer)[p+b.length]=0;try{return fn(p);}finally{ex.wasm_free(p);}}
