  const kEl = document.getElementById('presetKicker'); if (kEl) kEl.textContent = preset.kicker;
  const tEl = document.getElementById('presetTitle'); if (tEl) tEl.textContent = preset.title;
  const dEl = document.getElementById('presetDesc'); if (dEl) dEl.textContent = preset.desc;
  const sEl = document.getElementById('presetCodeSnippet');
  if (sEl) sEl.textContent = LESSON_CODE[preset.id] || ('#show ' + preset.expr);
  document.querySelectorAll('.preset-btn').forEach(b => b.classList.toggle('active', b.dataset.id === preset.id));
  setHypMode(!!preset.hypDefault);
  compileExpression(preset.expr, preset, null);
}

function updateHUD() {
  const active = net.activePairs();
  document.getElementById('mWork').textContent = net.work;
  document.getElementById('mDepth').textContent = net.depth;
  document.getElementById('mPar').textContent = net.depth > 0 ? (net.work / net.depth).toFixed(2) : '—';
