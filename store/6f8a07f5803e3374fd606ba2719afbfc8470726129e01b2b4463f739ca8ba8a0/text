        fd_write(fd,iovs,len,nw){const dv=new DataView(memory.buffer),u8=new Uint8Array(memory.buffer);let tot=0;for(let i=0;i<len;i++){const p=dv.getUint32(iovs+i*8,true),l=dv.getUint32(iovs+i*8+4,true),s=dec.decode(u8.subarray(p,p+l));if(fd===1)outBuf+=s;else errBuf+=s;tot+=l;}dv.setUint32(nw,tot,true);return 0;},
        fd_close:()=>0,fd_fdstat_get:()=>8,fd_filestat_get:()=>8,fd_prestat_get:()=>8,fd_prestat_dir_name:()=>8,fd_read:()=>8,fd_readdir:()=>8,fd_seek:()=>8,path_create_directory:()=>8,path_filestat_get:()=>8,path_open:()=>8,path_remove_directory:()=>8,path_rename:()=>8,path_unlink_file:()=>8,poll_oneoff:()=>8,proc_exit:(c)=>{throw new Error('exit '+c);},sched_yield:()=>0
