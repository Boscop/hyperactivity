function p2pWantHash(sha256) {
  const ids = liveMeshPeerIds();
  if (!ids.length) return Promise.resolve(null);
  return new Promise(res => {
    const timer = setTimeout(() => { pendingWants.delete(sha256); res(null); }, 1800);
    const arr = pendingWants.get(sha256) || [];
    arr.push(txt => { clearTimeout(timer); res(txt); });
    pendingWants.set(sha256, arr);
    ids.forEach(id => sendToMeshPeer(id, { t: 'WANT', h: sha256 }));
  });
}

async function onStudioMeshPacket(pkt, via, rtcCh) {
  if (!pkt || !pkt.from || pkt.from === netPeerId) return;
  if (pkt.to && pkt.to !== netPeerId) return;
  remoteNetPeer = pkt.from;
  let p = meshPeers.get(pkt.from);
  if (!p) {
    p = { id: pkt.from, transport: via, pc: null, dc: rtcCh || null, manifest: null, lastSeen: Date.now() };
    meshPeers.set(pkt.from, p);
  } else {
    p.lastSeen = Date.now();
    if (rtcCh) { p.dc = rtcCh; p.transport = 'WEBRTC'; }
  }
  if (pkt.t === 'NET_STEP' && p2pCutMode && !playing) {
    stepLocalAndInspect(pkt.seq, true);
  } else if (pkt.t === 'HELLO') {
    sendToMeshPeer(pkt.from, { t: 'MANIFEST', manifest: await buildMyManifest() });
    renderPeersUI();
  } else if (pkt.t === 'MANIFEST') {
    p.manifest = pkt.manifest; renderPeersUI();
  } else if (pkt.t === 'WANT' && pkt.h) {
    let allowed = publicHashAllowlist.has(pkt.h);
    workspaceMap.forEach(rec => { if (rec.sha256 === pkt.h && rec.visibility === 'public') allowed = true; });
    if (!allowed) return;
    const txt = await casGet(pkt.h);
    if (txt !== null) sendToMeshPeer(pkt.from, { t: 'OBJ', h: pkt.h, s: txt });
  } else if (pkt.t === 'OBJ' && pkt.h && typeof pkt.s === 'string') {
    try {
      await casPutVerified(pkt.h, pkt.s);
      publicHashAllowlist.add(pkt.h);
      const ws = pendingWants.get(pkt.h);
      if (ws) { pendingWants.delete(pkt.h); ws.forEach(fn => fn(pkt.s)); }
    } catch (_) {}
  } else if (pkt.t === 'CUT_REQ' && pkt.reqId && pkt.code) {
    ensureWasmKernel();
    runWorkerCut(pkt.code).then(res => {
      sendToMeshPeer(pkt.from, { t: 'CUT_RES', reqId: pkt.reqId, ok: res.ok, output: res.output, steps: res.steps, ms: res.ms });
    });
  } else if (pkt.t === 'CUT_RES' && pkt.reqId && pendingCuts.has(pkt.reqId)) {
    const w = pendingCuts.get(pkt.reqId);
    clearTimeout(w.timer); pendingCuts.delete(pkt.reqId);
    w.resolve({ ...pkt, peerId: pkt.from });
  }
}

