rm-sk-same : SK → SK → Bool
rm-sk-same a b = case a of
  sk-int s w → (case b of
    sk-int s2 w2 → m-and (u64eq (uq-b s) (uq-b s2)) (u64eq (iw-bits w) (iw-bits w2))
    _ → false)
  sk-bool → (case b of
    sk-bool → true
    _ → false)
  sk-ptr → (case b of
    sk-ptr → true
    _ → false)
  _ → false
