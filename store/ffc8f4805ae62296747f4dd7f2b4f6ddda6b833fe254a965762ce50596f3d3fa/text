-- and the converse, which is the point: any function whatever out of the tautomers already respects
-- every transfer. A tautomer-dependent quantity cannot be stated of the substance; a field that
-- states one has chosen a form and dropped the choice from the record.
taut-respects : (A : Type 0) → (step : A → A → Bool) → (B : Type 0) → (g : Taut A step → B) → (a : A) → (b : A) → (p : isTrue (step a b)) → g (taut-pt a) ≡ g (taut-pt b)
taut-respects A step B g a b p = λ i → g (taut-tr a b p i)
