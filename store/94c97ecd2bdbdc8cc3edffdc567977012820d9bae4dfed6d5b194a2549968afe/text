-- ── 7. Exact CDF 5/3 Quadratic Lifting Wavelet (Lossless JPEG2000 / Audio) ──
-- Reversible 3-sample quadratic lifting block (a, b, c) -> (s0, d0, s1) with bit-exact inverse:
--   d0 = b - ((a + c) >>> 1),   s0 = a + (d0 >>> 2),   s1 = c + (d0 >>> 2)
--   a  = s0 - (d0 >>> 2),       c  = s1 - (d0 >>> 2),  b  = d0 + ((a + c) >>> 1)
w32-asr2 : Word → Word
w32-asr2 x = w32-asr1 (w32-asr1 x)
