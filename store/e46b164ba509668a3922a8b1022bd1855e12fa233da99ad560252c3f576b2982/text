-- function values in C. After lifting, a function value is a definition applied to fewer
-- arguments than it takes: a block [the definition's wrapper][its arity][how many are held][the
-- held arguments]. hy_app gives one more argument: with the last one the wrapper is called on all
-- of them, before that a block holding one more is made
ce-prelude2 : List Word
ce-prelude2 = list-append "static uint64_t hy_clo(uint64_t fn, uint64_t ar, uint64_t n, const uint64_t *f) { uint64_t *p = malloc((n + 3) * sizeof *p); if (!p) abort(); p[0] = fn; p[1] = ar; p[2] = n; for (uint64_t i = 0; i < n; i++) p[i + 3] = f[i + 1]; return (uint64_t)p; }" (list-append ce-nl
  (list-append "static uint64_t hy_app(uint64_t c, uint64_t x) { uint64_t *p = (uint64_t *)c; uint64_t n = p[2]; if (n + 1 == p[1]) { uint64_t a[n + 1]; for (uint64_t i = 0; i < n; i++) a[i] = p[i + 3]; a[n] = x; return ((uint64_t (*)(const uint64_t *))p[0])(a); } uint64_t *q = malloc((n + 4) * sizeof *q); if (!q) abort(); q[0] = p[0]; q[1] = p[1]; q[2] = n + 1; for (uint64_t i = 0; i < n; i++) q[i + 3] = p[i + 3]; q[n + 3] = x; return (uint64_t)q; }" ce-nl))
