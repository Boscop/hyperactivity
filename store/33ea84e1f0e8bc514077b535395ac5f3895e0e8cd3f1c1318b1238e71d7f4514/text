-- the test: the first plan fits beside the second
nk-fits? : NkFx → NkFx → Bool
nk-fits? nkf-nil fx2 = true
nk-fits? (nkf-val w v r) fx2 = nk-and (nk-off? w (nk-puts fx2)) (nk-and (nk-off? w (nk-vals fx2)) (nk-fits? r fx2))
nk-fits? (nkf-op w o r) fx2 = nk-and (nk-off? w (nk-puts fx2)) (nk-and (nk-off? w (nk-ops fx2)) (nk-fits? r fx2))
nk-fits? (nkf-put w s r) fx2 = nk-and (nk-off? w (nk-puts fx2)) (nk-and (nk-off? w (nk-vals fx2)) (nk-and (nk-off? w (nk-ops fx2)) (nk-fits? r fx2)))
