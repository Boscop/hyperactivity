-- ---------------------------------------------------------------- 2. Theorem 3: Spoken language
-- Holding the physical acoustic waveform invariant (naive vs. trained listener; Remez et al. 1981
-- sine-wave speech; Bhartṛhari dhvani vs. sphoṭa), distinct conscious experiences under an identical
-- waveform prove that verbal experience cannot factor through the acoustic signal alone.
spoken-not-purely-sonic : {State Wave Exp : Type} →
  (wave : State → Wave) → (exp : State → Exp) →
  (naive trained : State) →
  wave naive ≡ wave trained →
  Neg (exp naive ≡ exp trained) →
  Neg ((f : Wave → Exp) × ((s : State) → exp s ≡ f (wave s)))
spoken-not-purely-sonic wave exp naive trained sameW diffE fac =
  diffE (concat (snd fac naive) (concat (cong (fst fac) sameW) (sym (snd fac trained))))
