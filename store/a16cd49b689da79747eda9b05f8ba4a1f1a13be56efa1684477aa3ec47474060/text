hy-recover-text : List Word → List Word → List Word → Sum Unit (List Word) → Proc W Unit
hy-recover-text st m path (inl u) = hy-forget st
hy-recover-text st m path (inr old) = bind (h-record m path old) (λ w → bind (hy-forget st) (λ u → h-say (h-line (list-append "an interrupted change was put back: " path))))
