rd8-push-mem : (V : Word) → wlt V #18446744073709551616 ≡ true →
  rd8 (wand (wand (wshr V #0) #255) #255) (wand (wand (wshr V #8) #255) #255) (wand (wand (wshr V #16) #255) #255) (wand (wand (wshr V #24) #255) #255)
      (wand (wand (wshr V #32) #255) #255) (wand (wand (wshr V #40) #255) #255) (wand (wand (wshr V #48) #255) #255) (wand (wand (wshr V #56) #255) #255) ≡ V
rd8-push-mem V h = rd8-of V (byte-dig2 V #0) (byte-dig2 V #8) (byte-dig2 V #16) (byte-dig2 V #24) (byte-dig2 V #32) (byte-dig2 V #40) (byte-dig2 V #48) (byte-dig2 V #56) h
