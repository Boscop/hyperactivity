-- interpretation by structural recursion
tl-eval : {GA : TlCtx × TlTy} → TlTm GA → TlEnv (fst GA) → tl-el (snd GA)
tl-eval (tl-var g a i) rho = tl-lookup i rho
tl-eval (tl-lit g b) rho = b
tl-eval (tl-tt g) rho = unit
tl-eval (tl-lam g a b t) rho = λ v → tl-eval t (rho , v)
tl-eval (tl-app g a b f x) rho = tl-eval f rho (tl-eval x rho)
tl-eval (tl-pair g a b x y) rho = (tl-eval x rho , tl-eval y rho)
tl-eval (tl-fst g a b p) rho = fst (tl-eval p rho)
tl-eval (tl-snd g a b p) rho = snd (tl-eval p rho)
tl-eval (tl-inl g a b x) rho = inl (tl-eval x rho)
tl-eval (tl-inr g a b y) rho = inr (tl-eval y rho)
tl-eval (tl-case g a b c s l r) rho = case tl-eval s rho of
  inl x → tl-eval l (rho , x)
  inr y → tl-eval r (rho , y)
