-- 1 + (r : rs), r the low bit, rs canonical as a tail
succ-canon-cons : (r : Bool) → (rs : List Bool) → bcanon (bin-succ (cons r rs)) ≡ true → bcanon (cons false (bin-succ (cons r rs))) ≡ true
succ-canon-cons r rs = case r return λ u → bcanon (bin-succ (cons u rs)) ≡ true → bcanon (cons false (bin-succ (cons u rs))) ≡ true of
  true → λ h → h
  false → λ h → h
