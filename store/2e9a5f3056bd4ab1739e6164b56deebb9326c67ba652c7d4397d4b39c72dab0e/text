-- Context-selected memory transport M_i(w, t) = Σ_{(e, p) : Sel_i(w, t)} transport_p(r(e)):
-- Given past occurrences Occ with context map ctx : Occ → Ctx and continuation family R : Ctx → Type,
-- every occurrence in the selection fiber over present context t transports its continuation into R t.
mem-transport : {Occ Ctx : Type} → (ctx : Occ → Ctx) → (R : Ctx → Type) →
  ((e : Occ) → R (ctx e)) → (t : Ctx) → fiber ctx t → R t
mem-transport ctx R r t ep = subst {lzero} {lzero} {Ctx} {R} (snd ep) (r (fst ep))
