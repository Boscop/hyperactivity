-- One symplectic Verlet momentum update for node i with neighbors (nb1, nb2) and excitation ext:
--   p_i = damp * (p_i - (k*q_i + w*((q_i - q_nb1) + (q_i - q_nb2)) + alpha*q_i^3 - ext))
wa-mesh4-mom : Word → Word → Word → List Word → List Word
wa-mesh4-mom qi nb1 nb2 ext =
  let pi   = %wadd qi #4
      kq   = wa-bin #148 (wa-get #2) (wa-get qi)
      lap  = wa-bin #148 (wa-get #3)
               (wa-bin #146 (wa-bin #147 (wa-get qi) (wa-get nb1))
                            (wa-bin #147 (wa-get qi) (wa-get nb2)))
      q2   = wa-bin #148 (wa-get qi) (wa-get qi)
      nl   = wa-bin #148 (wa-get #5) (wa-bin #148 q2 (wa-get qi))
      ftot = wa-bin #147 (wa-bin #146 (wa-bin #146 kq lap) nl) ext
      pnew = wa-bin #148 (wa-get #4) (wa-bin #147 (wa-get pi) ftot)
  in dw-app pnew (wa-set pi)
