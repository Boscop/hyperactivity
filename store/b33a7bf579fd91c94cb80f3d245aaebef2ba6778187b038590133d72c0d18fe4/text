-- what is compiled, observed through the model: the flat handler's process run on a flat memory
flat-run : {S : Sig} {A : Type} → Target → Step (MK S) A → FM → Step (MT S) (A × FM)
flat-run {S} {A} t C fm = o-run {MT S} {MT S} {A} {FM} (fm-obs {S}) (o-handle {MK S} {MT S} {A} (mem-flat-k {S} t) C) fm
