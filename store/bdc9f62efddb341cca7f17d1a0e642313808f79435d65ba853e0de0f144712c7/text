-- Complete 192-Byte (6 x 32B) Deployless EVM State-Sieve Initcode (`RETURN(0, 192)`):
--   Word 0 [0..31]   : Morpho Blue 0-bps Base USDC Balance
--   Word 1 [32..63]  : Morpho Blue 0-bps Base WETH Balance
--   Word 2 [64..95]  : Uniswap V3 WETH/USDC 5bps `sqrtPriceX96`
--   Word 3 [96..127] : Aerodrome Slipstream WETH/USDC `sqrtPriceX96`
--   Word 4 [128..159]: Aerodrome vAMM WETH/USDC `reserve0` (WETH wei)
--   Word 5 [160..191]: Aerodrome vAMM WETH/USDC `reserve1` (USDC micro)
ms-inst-concat : List (List EvmInst) → List EvmInst
ms-inst-concat nil         = nil
ms-inst-concat (cons x xs) = list-append x (ms-inst-concat xs)
