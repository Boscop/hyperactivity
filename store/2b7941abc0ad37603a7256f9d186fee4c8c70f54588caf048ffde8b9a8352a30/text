wlt-tri : (a b : Word) → weq a b ≡ false → wlt a b ≡ false → wlt b a ≡ true
wlt-tri a =
  %welimP (λ v → (b : Word) → weq v b ≡ false → wlt v b ≡ false → wlt b v ≡ true) a
    (λ b → %welimP (λ w → weq #0 w ≡ false → wlt #0 w ≡ false → wlt w #0 ≡ true) b
       (λ e l → bool-absurd (wlt #0 #0 ≡ true) (weq #0 #0) (weq-refl #0) e)
       (λ m g e l → bool-absurd (wlt (%wsucc m) #0 ≡ true) (wlt #0 (%wsucc m)) (wlt-0s m) l))
    (λ n h b → %welimP (λ w → weq (%wsucc n) w ≡ false → wlt (%wsucc n) w ≡ false → wlt w (%wsucc n) ≡ true) b
       (λ e l → wlt-0s n)
       (λ m g e l → pcat0 Bool (wlt (%wsucc m) (%wsucc n)) (wlt m n) true (wlt-ss m n)
          (h m (pcat0 Bool (weq n m) (weq (%wsucc n) (%wsucc m)) false (sym (weq-ss n m)) e)
               (pcat0 Bool (wlt n m) (wlt (%wsucc n) (%wsucc m)) false (sym (wlt-ss n m)) l))))
