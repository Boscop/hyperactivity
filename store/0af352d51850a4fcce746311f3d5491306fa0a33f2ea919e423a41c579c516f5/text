-- (designable and m = u, designable, others with u ≥ 1 and m = u, others with u ≥ 1), over s < k
fr-add : Bool → Bool → Bool → (Nat × Nat) × (Nat × Nat) → (Nat × Nat) × (Nat × Nat)
fr-add des tight pos r = if des then ((plus (fr-b tight) (fst (fst r)) , suc (snd (fst r))) , snd r) else (fst r , (plus (fr-b (fr-and pos tight)) (fst (snd r)) , plus (fr-b pos) (snd (snd r))))
