ml-step-le : {S : Type} → (cost : S → Nat) → (f : S → S) → (s : S) →
  ml-le (cost (ml-meta-step cost f s)) (cost s) ≡ true
ml-step-le cost f s =
  let p = ml-cost-if cost (ml-le (cost (f s)) (cost s)) (f s) s
      q = ml-if-le-r (cost (f s)) (cost s)
  in λ i → comp (λ j → Bool) (λ j → [ i = 0 ↦ ml-le (p (~ j)) (cost s) , i = 1 ↦ true ]) (q i)
