pr-chain4 : List Word
pr-chain4 = cons #1 (cons #2 (cons #3 (cons #4 nil)))

pr-main : List (List Word) → Step W Word
pr-main _ =
  scmd (w-file-read-named "/tmp/hy_out/live_world_feeds/base_uniswapv2_weth_usdc.json") (λ rBase →
  scmd (w-file-read-named "/tmp/hy_out/live_world_feeds/hl_live.json") (λ rHl →
  scmd (w-file-read-named "/tmp/hy_out/live_world_feeds/cb_btc.json") (λ rCbBtc →
  scmd (w-file-read-named "/tmp/hy_out/live_world_feeds/cb_eth.json") (λ rCbEth →
  scmd (w-file-read-named "/tmp/hy_out/live_world_feeds/cb_sol.json") (λ rCbSol →
  let hexBody = pr-after-sub "0x" (snd rBase)
      -- Shift reserve0 right by 16 bits (4 hex nibbles) to avoid >18.44 ETH u64 truncation!
      r0Shr16 = pr-parse-hex-n #16 (pr-drop-w #44 hexBody) #0
      r1Uusdc = pr-parse-hex-n #16 (pr-drop-w #112 hexBody) #0
      -- Exact uETH = r0Shr16 / 15258789 (safe up to 1.2M WETH, 1e-6 ETH precision!)
      r0Micro = %wdiv r0Shr16 #15258789
      -- Exact Base UniV2 WETH/USDC price in cents: (r1Uusdc * 100) / r0Micro
      baseEthCents = if %weq r0Micro #0 then #0 else %wdiv (%wmul r1Uusdc #100) r0Micro

      hlBtcC = pr-parse-cents (pr-after-sub (pr-key "BTC") (snd rHl)) #0
      hlEthC = pr-parse-cents (pr-after-sub (pr-key "ETH") (snd rHl)) #0
      hlSolC = pr-parse-cents (pr-after-sub (pr-key "SOL") (snd rHl)) #0
      cbBtcC = pr-parse-cents (pr-after-sub (pr-key "amount") (snd rCbBtc)) #0
      cbEthC = pr-parse-cents (pr-after-sub (pr-key "amount") (snd rCbEth)) #0
      cbSolC = pr-parse-cents (pr-after-sub (pr-key "amount") (snd rCbSol)) #0

      spBtcBps     = pr-spread-bps hlBtcC cbBtcC
      spEthCbBps   = pr-spread-bps hlEthC cbEthC
      spEthBaseBps = pr-spread-bps hlEthC baseEthCents
      spSolBps     = pr-spread-bps hlSolC cbSolC

      ryAMilli = %wdiv r1Uusdc #1000
      arbRes = pr-sweep-arb #1000000 #1800000 #1000000 #1600000 #200 #1000 (toNat #60) #1 #0 #0
      bestDx = fst arbRes
      bestP  = snd arbRes
      payouts = pr-split-w bestP pr-chain4
      pLeak = if %weq (pr-sum-w payouts) bestP then #0 else #1

      rawTag = pr-mod bestDx #256
      masked = pr-feistel3-enc #42 #17 #99 rawTag
      unmask = pr-feistel3-dec #42 #17 #99 masked
      fioOk  = if %weq unmask rawTag then #1 else #0

      frame  = sov-pack-pkt sov-test-secret (sov-pkt pk-witness #101 spEthBaseBps bestP pLeak fioOk)
  in scmd (w-file-write-named "/tmp/hx_agent_bus/p2p_reactor.hxsv" frame) (λ u0 →
     cli-say "HX-P2P-REACTOR LIVE MULTI-VENUE ARBITRAGE SCAN (100% pure .hypercubical, 0 floats, UBSan-clean)"
       (cli-say (list-append "  [BASE MAINNET DEX]  UniV2 WETH/USDC: reserveWETH(uETH)="
                (list-append (pr-wdec r0Micro)
                (list-append " reserveUSDC(mUSDC)="
                (list-append (pr-wdec ryAMilli)
                (list-append " -> price_cents=" (pr-wdec baseEthCents))))))
       (cli-say (list-append "  [LIVE ETH SPREAD]   Hyperliquid("
                (list-append (pr-wdec hlEthC)
                (list-append ") vs BaseUniV2("
                (list-append (pr-wdec baseEthCents)
                (list-append ") = "
                (list-append (pr-wdec spEthBaseBps)
                (list-append " bps | vs Coinbase("
                (list-append (pr-wdec cbEthC)
                (list-append ") = "
                (list-append (pr-wdec spEthCbBps) " bps"))))))))))
       (cli-say (list-append "  [LIVE BTC SPREAD]   Hyperliquid("
                (list-append (pr-wdec hlBtcC)
                (list-append ") vs Coinbase("
                (list-append (pr-wdec cbBtcC)
                (list-append ") = "
                (list-append (pr-wdec spBtcBps) " bps"))))))
       (cli-say (list-append "  [LIVE SOL SPREAD]   Hyperliquid("
                (list-append (pr-wdec hlSolC)
                (list-append ") vs Coinbase("
                (list-append (pr-wdec cbSolC)
                (list-append ") = "
                (list-append (pr-wdec spSolBps) " bps"))))))
       (cli-say (list-append "  [AMM FLASH SWEEP]   optimal_dx="
                (list-append (pr-wdec bestDx)
                (list-append " net_surplus="
                (list-append (pr-wdec bestP)
                (list-append " | 50/25/12.5/12.5 payouts=["
                (list-append (pr-fmt-list payouts)
                (list-append "] wei_leak=" (pr-wdec pLeak))))))))
       (cli-say (list-append "  [FIBER-IO MASK]     raw="
                (list-append (pr-wdec rawTag)
                (list-append " -> masked="
                (list-append (pr-wdec masked)
                (list-append " -> decoded="
                (list-append (pr-wdec unmask)
                (list-append " roundtrip_ok=" (pr-wdec fioOk))))))))
       (cli-say "  [HXSV 32B P2P BUS]  Wrote 32-byte authenticated HXSV frame -> /tmp/hx_agent_bus/p2p_reactor.hxsv"
         (sdone #0))))))))))))))

