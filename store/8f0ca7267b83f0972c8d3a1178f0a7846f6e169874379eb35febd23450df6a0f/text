pr-amm-out : Word → Word → Word → Word
pr-amm-out rx ry dx =
  let dxf = %wmul dx #997
      num = %wmul ry dxf
      den = %wadd (%wmul rx #1000) dxf
  in if %weq den #0 then #0 else %wdiv num den

pr-amm-k-ok : Word → Word → Word → Bool
pr-amm-k-ok rx ry dx =
  let dy = pr-amm-out rx ry dx
  in if %wlt ry dy then false
     else not (%wlt (%wmul (%wadd rx dx) (%wsub ry dy)) (%wmul rx ry))

pr-two-pool-profit : Word → Word → Word → Word → Word → Word → Word
pr-two-pool-profit rxA ryA rxB ryB dx gas =
  let dy = pr-amm-out rxA ryA dx
      out = pr-amm-out ryB rxB dy
      cost = %wadd dx gas
  in if %wlt cost out then %wsub out cost else #0

-- UNIVERSAL THEOREM 7 (AMM CONSTANT-PRODUCT INVARIANT + POSITIVE ARB + ZERO-LOSS ATOMIC REVERT!):
pr-thm-amm-k-and-atomic-revert :
  andB (pr-amm-k-ok #1000000 #1800000 #25000)
  (andB (%wlt #0 (pr-two-pool-profit #1000000 #1800000 #1000000 #1600000 #25000 #200))
        (%weq (pr-two-pool-profit #1000000 #1682000 #1000000 #1682000 #25000 #200) #0)) ≡ true
pr-thm-amm-k-and-atomic-revert = refl

pr-split-w : Word → List Word → List Word
pr-split-w _ nil = nil
pr-split-w p (cons _ nil) = cons p nil
pr-split-w p (cons _ (cons v rest)) =
  let h = %wdiv p #2
      r = %wsub p h
  in cons h (pr-split-w r (cons v rest))

pr-sum-w : List Word → Word
pr-sum-w nil = #0
pr-sum-w (cons x xs) = %wadd x (pr-sum-w xs)

pr-sweep-arb : Word → Word → Word → Word → Word → Word → Nat → Word → Word → Word → Word × Word
pr-sweep-arb _ _ _ _ _ _ zero _ bestDx bestP = (bestDx , bestP)
pr-sweep-arb rxA ryA rxB ryB gas step (suc fuel) k bestDx bestP =
  let dx = %wmul k step
      p = pr-two-pool-profit rxA ryA rxB ryB dx gas
      nDx = if %wlt bestP p then dx else bestDx
      nP  = if %wlt bestP p then p else bestP
  in pr-sweep-arb rxA ryA rxB ryB gas step fuel (%wadd k #1) nDx nP

