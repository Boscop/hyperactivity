pr-trans : {A : Type} → {x y z : A} → x ≡ y → y ≡ z → x ≡ z
pr-trans {A} {x} p q = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

pr-half : Nat → Nat
pr-half zero = zero
pr-half (suc zero) = zero
pr-half (suc (suc n)) = suc (pr-half n)

pr-rem-half : Nat → Nat
pr-rem-half zero = zero
pr-rem-half (suc zero) = suc zero
pr-rem-half (suc (suc n)) = suc (pr-rem-half n)

pr-plus-suc-r : (a b : Nat) → plus a (suc b) ≡ suc (plus a b)
pr-plus-suc-r zero _ = refl
pr-plus-suc-r (suc a) b = cong suc (pr-plus-suc-r a b)

pr-plus-zero-r : (a : Nat) → plus a zero ≡ a
pr-plus-zero-r zero = refl
pr-plus-zero-r (suc a) = cong suc (pr-plus-zero-r a)

-- UNIVERSAL THEOREM 1 (EXACT INTEGER HALVING CONSERVATION FOR ALL p : Nat):
pr-thm-half-sum : (p : Nat) → plus (pr-half p) (pr-rem-half p) ≡ p
pr-thm-half-sum zero = refl
pr-thm-half-sum (suc zero) = refl
pr-thm-half-sum (suc (suc n)) =
  pr-trans (cong suc (pr-plus-suc-r (pr-half n) (pr-rem-half n)))
           (cong (λ x → suc (suc x)) (pr-thm-half-sum n))

-- Recursive 50% -> 25% -> 12.5% -> ... geometric waterfall; terminal operator keeps exact remainder
pr-split-geom : Nat → List Word → List Nat
pr-split-geom _ nil = nil
pr-split-geom p (cons _ nil) = cons p nil
pr-split-geom p (cons _ (cons v rest)) =
  cons (pr-half p) (pr-split-geom (pr-rem-half p) (cons v rest))

pr-nat-sum : List Nat → Nat
pr-nat-sum nil = zero
pr-nat-sum (cons x xs) = plus x (pr-nat-sum xs)

-- UNIVERSAL THEOREM 2 (ZERO-WEI-LEAK WATERFALL CONSERVATION FOR ALL SURPLUSES p & CHAIN DEPTHS!):
pr-thm-split-conserves : (p : Nat) → (root : Word) → (chain : List Word) →
  pr-nat-sum (pr-split-geom p (cons root chain)) ≡ p
pr-thm-split-conserves p _ nil = pr-plus-zero-r p
pr-thm-split-conserves p _ (cons v rest) =
  pr-trans (cong (plus (pr-half p)) (pr-thm-split-conserves (pr-rem-half p) v rest))
           (pr-thm-half-sum p)

-- PoUW Clearinghouse + Waterfall Composition (escrow, solverBalance)
pr-pouw-total : Nat × Nat → Nat
pr-pouw-total st = plus (fst st) (snd st)

pr-pouw-settle : Bool → Nat × Nat → Nat × Nat
pr-pouw-settle true  st = (zero , plus (fst st) (snd st))
pr-pouw-settle false st = st

-- UNIVERSAL THEOREM 3 (PoUW CLEARING + DYADIC WATERFALL EXACT CREDIT CONSERVATION!):
pr-thm-pouw-waterfall-conserved : (okFlag : Bool) → (st : Nat × Nat) → (root : Word) → (chain : List Word) →
  plus (pr-nat-sum (pr-split-geom (fst st) (cons root chain))) (snd st) ≡ pr-pouw-total (pr-pouw-settle okFlag st)
pr-thm-pouw-waterfall-conserved true st root chain =
  cong (λ x → plus x (snd st)) (pr-thm-split-conserves (fst st) root chain)
pr-thm-pouw-waterfall-conserved false st root chain =
  cong (λ x → plus x (snd st)) (pr-thm-split-conserves (fst st) root chain)

