pr-hex-nib : Word → Word
pr-hex-nib b =
  if andB (not (%wlt b #48)) (%wlt b #58) then %wsub b #48
  else if andB (not (%wlt b #97)) (%wlt b #103) then %wadd #10 (%wsub b #97)
  else if andB (not (%wlt b #65)) (%wlt b #71) then %wadd #10 (%wsub b #65)
  else #0

pr-drop-w : Word → List Word → List Word
pr-drop-w n xs =
  if %weq n #0 then xs
  else case xs of
    nil → nil
    cons _ tl → pr-drop-w (%wsub n #1) tl

pr-parse-hex-n : Word → List Word → Word → Word
pr-parse-hex-n n xs acc =
  if %weq n #0 then acc
  else case xs of
    nil → acc
    cons b bs → pr-parse-hex-n (%wsub n #1) bs (%wadd (%wmul acc #16) (pr-hex-nib b))

pr-prefix-eq : List Word → List Word → Bool
pr-prefix-eq nil _ = true
pr-prefix-eq (cons _ _) nil = false
pr-prefix-eq (cons p ps) (cons b bs) =
  if %weq p b then pr-prefix-eq ps bs else false

pr-len-w : List Word → Word → Word
pr-len-w nil acc = acc
pr-len-w (cons _ xs) acc = pr-len-w xs (%wadd acc #1)

pr-after-sub : List Word → List Word → List Word
pr-after-sub _ nil = nil
pr-after-sub pat (cons b bs) =
  if pr-prefix-eq pat (cons b bs)
    then pr-drop-w (pr-len-w pat #0) (cons b bs)
    else pr-after-sub pat bs

pr-q : List Word
pr-q = cons #34 nil

pr-key : List Word → List Word
pr-key k = list-append pr-q (list-append k (list-append pr-q (list-append ":" pr-q)))

pr-parse-cents-frac : Nat → List Word → Word → Word
pr-parse-cents-frac zero _ acc = acc
pr-parse-cents-frac (suc rem) nil acc =
  pr-parse-cents-frac rem nil (%wmul acc #10)
pr-parse-cents-frac (suc rem) (cons b bs) acc =
  if andB (not (%wlt b #48)) (%wlt b #58)
    then pr-parse-cents-frac rem bs (%wadd (%wmul acc #10) (%wsub b #48))
    else pr-parse-cents-frac rem nil (%wmul acc #10)

pr-parse-cents : List Word → Word → Word
pr-parse-cents nil acc = %wmul acc #100
pr-parse-cents (cons b bs) acc =
  if andB (not (%wlt b #48)) (%wlt b #58)
    then pr-parse-cents bs (%wadd (%wmul acc #10) (%wsub b #48))
    else if %weq b #46
      then pr-parse-cents-frac (toNat #2) bs acc
      else %wmul acc #100

pr-abs-diff : Word → Word → Word
pr-abs-diff a b = if %wlt a b then %wsub b a else %wsub a b

pr-spread-bps : Word → Word → Word
pr-spread-bps a b =
  let d = pr-abs-diff a b
      m = if %wlt a b then a else b
  in if %weq m #0 then #0 else %wdiv (%wmul d #10000) m

pr-wdec-go : Nat → Word → List Word → List Word
pr-wdec-go zero _ acc = acc
pr-wdec-go (suc fuel) n acc =
  if %weq n #0 then acc
  else pr-wdec-go fuel (%wdiv n #10) (cons (%wadd #48 (pr-mod n #10)) acc)

pr-wdec : Word → List Word
pr-wdec n = if %weq n #0 then cons #48 nil else pr-wdec-go (toNat #24) n nil

pr-fmt-list : List Word → List Word
pr-fmt-list nil = nil
pr-fmt-list (cons x nil) = pr-wdec x
pr-fmt-list (cons x (cons y ys)) =
  list-append (pr-wdec x) (list-append " / " (pr-fmt-list (cons y ys)))

