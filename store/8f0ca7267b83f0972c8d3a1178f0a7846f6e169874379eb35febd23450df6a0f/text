pr-iter : {X : Type} → Nat → (X → X) → X → X
pr-iter zero _ x = x
pr-iter (suc n) f x = f (pr-iter n f x)

-- UNIVERSAL THEOREM 5 (HOMOMORPHIC CONJUGATED EXECUTION: dec((enc o F o dec)^n (enc x)) === F^n x!):
pr-thm-conj-iter : {X : Type} → (enc dec : X → X) → (ret : (x : X) → dec (enc x) ≡ x) →
  (f : X → X) → (n : Nat) → (x : X) →
  pr-iter n (λ y → enc (f (dec y))) (enc x) ≡ enc (pr-iter n f x)
pr-thm-conj-iter _ _ _ _ zero _ = refl
pr-thm-conj-iter enc dec ret f (suc n) x =
  pr-trans (cong (λ y → enc (f (dec y))) (pr-thm-conj-iter enc dec ret f n x))
           (cong (λ z → enc (f z)) (ret (pr-iter n f x)))

pr-thm-homomorphic-exec : {X : Type} → (enc dec : X → X) → (ret : (x : X) → dec (enc x) ≡ x) →
  (f : X → X) → (n : Nat) → (x : X) →
  dec (pr-iter n (λ y → enc (f (dec y))) (enc x)) ≡ pr-iter n f x
pr-thm-homomorphic-exec enc dec ret f n x =
  pr-trans (cong dec (pr-thm-conj-iter enc dec ret f n x)) (ret (pr-iter n f x))

pr-mod : Word → Word → Word
pr-mod a m = if %weq m #0 then #0 else %wsub a (%wmul (%wdiv a m) m)

pr-fround : Word → Word → Word
pr-fround k r = pr-mod (%wadd (%wmul r #5) (%wadd k #3)) #16

pr-feistel1-enc : Word → Word → Word
pr-feistel1-enc k x =
  let l = %wdiv x #16
      r = pr-mod x #16
      nr = pr-mod (%wadd l (pr-fround k r)) #16
  in %wadd (%wmul r #16) nr

pr-feistel1-dec : Word → Word → Word
pr-feistel1-dec k y =
  let r = %wdiv y #16
      nr = pr-mod y #16
      l = pr-mod (%wsub (%wadd nr #16) (pr-fround k r)) #16
  in %wadd (%wmul l #16) r

pr-feistel3-enc : Word → Word → Word → Word → Word
pr-feistel3-enc k1 k2 k3 x = pr-feistel1-enc k3 (pr-feistel1-enc k2 (pr-feistel1-enc k1 x))

pr-feistel3-dec : Word → Word → Word → Word → Word
pr-feistel3-dec k1 k2 k3 y = pr-feistel1-dec k1 (pr-feistel1-dec k2 (pr-feistel1-dec k3 y))

pr-check-256 : Nat → Word → (Word → Bool) → Bool
pr-check-256 zero _ _ = true
pr-check-256 (suc n) i p = andB (p i) (pr-check-256 n (%wadd i #1) p)

-- UNIVERSAL THEOREM 6 (EXHAUSTIVE 256/256 BIJECTION PROOF OF 3-ROUND FEISTEL WIRE CIPHER!):
pr-thm-feistel3-bijection-256 :
