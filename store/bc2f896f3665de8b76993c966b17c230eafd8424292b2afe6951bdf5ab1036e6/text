-- Exact geodesic arc sampling: M_{p1}(s * M_{-p1}(p2)) for s = 0/N .. N/N (zero trig!)
geo-sample-go : Nat → Word → Word → Cx → Cx → List Word → List Word
geo-sample-go zero n idx p1 w acc = acc
geo-sample-go (suc rem) n idx p1 w acc =
  let sw = (si-div-w (si-mul (fst w) (sp idx)) n , si-div-w (si-mul (snd w) (sp idx)) n)
      pt = cx-to-px (mob p1 sw)
      cmd : List Word
      cmd = if weq idx #0 then "M" else " L"
      seg = lg-concat (cons cmd (cons (lg-tenths (fst pt)) (cons " " (cons (lg-tenths (snd pt)) nil))))
  in geo-sample-go rem n (%wsucc idx) p1 w (list-append acc seg)
