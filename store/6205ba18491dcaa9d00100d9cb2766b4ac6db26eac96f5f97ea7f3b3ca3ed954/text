-- the text files of a module: its pieces' texts
c-texts-of : List Word → Proc W (List (List Word))
c-texts-of hexpath = bind (h-read (list-append "store/modules/" hexpath)) (λ k →
  bind (h-read (list-append "store/" (list-append (c-or-nil k) "/module"))) (λ m →
  ret (list-map (λ p → list-append "store/" (list-append p "/text")) (h-lines (c-or-nil m)))))
