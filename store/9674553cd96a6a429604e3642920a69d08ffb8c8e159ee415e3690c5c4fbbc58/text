paragraphs-split : (n : Nat) → (ls : List (List Word)) → list-append (paragraphs n ls) (paragraphs-rest n ls) ≡ ls
paragraphs-split zero ls = λ i → ls
paragraphs-split (suc n) nil = λ i → nil
paragraphs-split (suc zero) (cons nil ls) = λ i → cons nil ls
paragraphs-split (suc (suc m)) (cons nil ls) = λ i → cons nil (paragraphs-split (suc m) ls i)
paragraphs-split (suc n) (cons (cons x l) ls) = λ i → cons (cons x l) (paragraphs-split (suc n) ls i)
