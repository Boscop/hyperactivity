-- a step taken after another step that changes neither its wire nor the wire it reads is its own
-- plan, as it stood before, done after the other's plan
nk-step-after : (sl : NkSlots) (u1 n1 u2 n2 : Word) → nk-apart u2 (nk-plan-fx sl u1 n1) → nk-apart (nk-rw (nk-get sl u2) u2) (nk-plan-fx sl u1 n1) → nk-same (nk-step-at u2 n2 (nk-step-at u1 n1 sl)) (nk-do (nk-plan-fx sl u2 n2) (nk-do (nk-plan-fx sl u1 n1) sl))
nk-step-after sl u1 n1 u2 n2 b1 b2 x = cong (λ p → nk-get (nk-do (nk-fx p) (nk-do (nk-plan-fx sl u1 n1) sl)) x) (nk-plan-stable sl u2 n2 (nk-plan-fx sl u1 n1) b1 b2)
