-- Total frustration defect of a two-domain fold:
--   d_tot(c1, c2) = d1(c1) + d2(c2) + d12(c1, c2).
glued-defect :
  {C1 C2 I : Type 0} {r1 : C1 → I} {r2 : C2 → I} →
  (C1 → Nat) → (C2 → Nat) → (C1 → C2 → Nat) →
  GluedFold C1 C2 I r1 r2 → Nat
glued-defect d1 d2 d12 g = plus (d1 (fst (fst g))) (plus (d2 (snd (fst g))) (d12 (fst (fst g)) (snd (fst g))))
