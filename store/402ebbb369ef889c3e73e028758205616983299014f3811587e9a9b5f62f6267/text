rfp r d t =
  case rewrite-root-path d r t of
    some p → some p
    none →
      (case t of
         clam x → omap2 clam clam (rfp r (%wsucc d) x)
         capp f a → (case rfp r d f of some p → some (capp (fst p) a , capp (snd p) (sh1 d a)); none → omap2 (capp f) (capp (sh1 d f)) (rfp r d a))
         cpair a b → (case rfp r d a of some p → some (cpair (fst p) b , cpair (snd p) (sh1 d b)); none → omap2 (cpair a) (cpair (sh1 d a)) (rfp r d b))
         cfst x → omap2 cfst cfst (rfp r d x)
         csnd x → omap2 csnd csnd (rfp r d x)
         clet a x → (case rfp r d a of some p → some (clet (fst p) x , clet (snd p) (sh1 (%wsucc d) x)); none → omap2 (clet a) (clet (sh1 d a)) (rfp r (%wsucc d) x))
         ccon dd c fs ds → omap2 (λ fs2 → ccon dd c fs2 ds) (λ fs2 → ccon dd c fs2 (sh1-list d ds)) (rfp-list r d fs)
         ccase dd B x → (case rfp r d x of some p → some (ccase dd B (fst p) , ccase dd (sh1-list d B) (snd p)); none → omap2 (λ B2 → ccase dd B2 x) (λ B2 → ccase dd B2 (sh1 d x)) (rfp-list r d B))
         celim dd P B x → (case rfp r d x of some p → some (celim dd P B (fst p) , celim dd (sh1 d P) (sh1-list d B) (snd p)); none → omap2 (λ B2 → celim dd P B2 x) (λ B2 → celim dd (sh1 d P) B2 (sh1 d x)) (rfp-list r d B))
         cwop o a b → (case rfp r d a of some p → some (cwop o (fst p) b , cwop o (snd p) (sh1 d b)); none → omap2 (cwop o a) (cwop o (sh1 d a)) (rfp r d b))
         cwsucc a → omap2 cwsucc cwsucc (rfp r d a)
         cwelim w z s mo → (case rfp r d w of
                              some p → some (cwelim (fst p) z s mo , cwelim (snd p) (sh1 d z) (sh1 d s) (omap (sh1 d) mo))
                              none → (case rfp r d z of
                                        some p → some (cwelim w (fst p) s mo , cwelim (sh1 d w) (snd p) (sh1 d s) (omap (sh1 d) mo))
                                        none → omap2 (λ s2 → cwelim w z s2 mo) (λ s2 → cwelim (sh1 d w) (sh1 d z) s2 (omap (sh1 d) mo)) (rfp r d s)))
         cprim q as → omap2 (cprim q) (cprim q) (rfp-list r d as)
         cann a T → omap2 (λ a2 → cann a2 T) (λ a2 → cann a2 (sh1 d T)) (rfp r d a)
         cforce x → omap2 cforce cforce (rfp r d x)
         cthunk x → omap2 cthunk cthunk (rfp r d x)
         _ → none)
