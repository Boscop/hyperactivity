-- nk-step-commute-ok: steps at two wires commute when their plans may be done in either order
-- (nk-oks) and each writes neither the other's wire nor the wire the other reads
-- (part of machine-in-hyperactive)
nk-step-commute-ok : (sl : NkSlots) (u1 n1 u2 n2 : Word) →
  nk-oks (nk-fx (nk-plan (nk-get sl u1) u1 n1 sl)) (nk-fx (nk-plan (nk-get sl u2) u2 n2 sl)) →
  nk-apart u1 (nk-fx (nk-plan (nk-get sl u2) u2 n2 sl)) → nk-apart (nk-rw (nk-get sl u1) u1) (nk-fx (nk-plan (nk-get sl u2) u2 n2 sl)) →
  nk-apart u2 (nk-fx (nk-plan (nk-get sl u1) u1 n1 sl)) → nk-apart (nk-rw (nk-get sl u2) u2) (nk-fx (nk-plan (nk-get sl u1) u1 n1 sl)) →
  nk-same (nk-step-at u2 n2 (nk-step-at u1 n1 sl)) (nk-step-at u1 n1 (nk-step-at u2 n2 sl))
nk-step-commute-ok sl u1 n1 u2 n2 ap a1 a2 b1 b2 x =
  cong (λ p → nk-get (nk-do (nk-fx p) (nk-step-at u1 n1 sl)) x) (nk-plan-stable sl u2 n2 (nk-fx (nk-plan (nk-get sl u1) u1 n1 sl)) b1 b2)
  ∙ (nk-do-swap-ok (nk-fx (nk-plan (nk-get sl u1) u1 n1 sl)) (nk-fx (nk-plan (nk-get sl u2) u2 n2 sl)) sl ap x
  ∙ sym (cong (λ p → nk-get (nk-do (nk-fx p) (nk-step-at u2 n2 sl)) x) (nk-plan-stable sl u1 n1 (nk-fx (nk-plan (nk-get sl u2) u2 n2 sl)) a1 a2)))
