-- Map disk point z ∈ (-1, 1)² to SVG coordinate scaled by 10 inside 256×256 (center 128.0, radius 112.6)
-- px_x * 10 = 1280 + (zx * 1126) / 10000, px_y * 10 = 1280 - (zy * 1126) / 10000
cx-to-px : Cx → Word × Word
cx-to-px z =
  let dx = si-div-w (si-mul (fst z) (sp #1126)) fx-S
      dy = si-div-w (si-mul (snd z) (sp #1126)) fx-S
      px = si-abs (si-add (sp #1280) dx)
      py = si-abs (si-sub (sp #1280) dy)
  in (px , py)
