data SB4 : Type where
  sb4 : (x0 x1 x2 x3 : RQ) → SB4

-- Unitary self-dual Fourier transform F = (1/2) H_4 over exact rationals Q!
atp-fourier4 : SB4 → SB4
atp-fourier4 (sb4 f0 f1 f2 f3) =
  let h0 = rq-div-w (rq-add (rq-add f0 f1) (rq-add f2 f3)) #2
      h1 = rq-div-w (rq-add (rq-sub f0 f1) (rq-sub f2 f3)) #2
      h2 = rq-div-w (rq-sub (rq-add f0 f1) (rq-add f2 f3)) #2
      h3 = rq-div-w (rq-sub (rq-sub f0 f1) (rq-sub f2 f3)) #2
  in sb4 h0 h1 h2 h3

atp-sb4-eq : SB4 → SB4 → Bool
atp-sb4-eq (sb4 a0 a1 a2 a3) (sb4 b0 b1 b2 b3) =
  andB (rq-eq a0 b0) (andB (rq-eq a1 b1) (andB (rq-eq a2 b2) (rq-eq a3 b3)))

-- Exact L2 norm squared ||f||_2^2 = f0^2 + f1^2 + f2^2 + f3^2 over Q!
atp-l2-sq : SB4 → RQ
atp-l2-sq (sb4 x0 x1 x2 x3) =
  rq-add (rq-add (rq-mul x0 x0) (rq-mul x1 x1))
         (rq-add (rq-mul x2 x2) (rq-mul x3 x3))

