atp-poisson-ok : SB4 → Bool
atp-poisson-ok f =
  case f of
    sb4 f0 f1 f2 f3 →
      case atp-fourier4 f of
        sb4 g0 g1 g2 g3 →
          andB (rq-eq (rq-add f0 f2) (rq-add g0 g1))
          (andB (rq-eq (atp-l2-sq f) (atp-l2-sq (sb4 g0 g1 g2 g3)))
                (atp-sb4-eq (atp-fourier4 (sb4 g0 g1 g2 g3)) f))

