ct-uac : Target → CTy → CTy → MRes CTy
ct-uac t a b = case m-or (ct-is a ct-ptr) (ct-is b ct-ptr) of
  true → mstop st-ill-typed
  false → (case m-or (ct-is a ct-double) (ct-is b ct-double) of
    true → mok ct-double
    false → (case m-or (ct-is a ct-float) (ct-is b ct-float) of
      true → mok ct-float
      false → mok (ct-uac-int t (ct-promote t a) (ct-promote t b))))
