-- Exact phase-addition law: merging two adjacent Rz(q, k1) and Rz(q, k2) into Rz(q, (k1+k2) mod 8)
-- preserves the exact unitary phase mod 8 on EVERY computational basis state `st`!
q-rz-merge-sound :
  (q k1 k2 : Word) → (st : Word → Bool) →
  %wmod (%wadd (q-rz-phase q k1 st) (q-rz-phase q k2 st)) #8 ≡
  q-rz-phase q (%wmod (%wadd k1 k2) #8) st
q-rz-merge-sound q k1 k2 st =
  case st q return (λ b → %wmod (%wadd (if b then k1 else #0) (if b then k2 else #0)) #8 ≡
                          (if b then %wmod (%wadd k1 k2) #8 else #0)) of
    false → refl
    true  → refl
