si-tab-suc : (n : Nat) → (B : Bytes n) → (y : List Word) → (r : List (List Word)) → (p : Word) → (m : Word) →
  si-rep n B (si-rd4 n B (si-slot (wadd p #4) m)) (si-drop m r) → si-rep n B (si-rd4 n B (si-slot p (%wsucc m))) (si-drop (%wsucc m) (cons y r))
si-tab-suc n B y r p m h = subst {_} {_} {Word} {λ z → si-rep n B (si-rd4 n B z) (si-drop m r)} (sym (si-slot-suc p m)) h
