cfs-list-range :
  (L : Word) → (fuel : Nat) → (init : SRState) → (xs : List Word) → (st : CtxState) →
  CFSRangePres L fuel → SRInRange L init →
  SRInRange L (cfs-enc-list L fuel init st xs)
cfs-list-range L fuel init xs =
  case xs return (λ u → (st : CtxState) → CFSRangePres L fuel → SRInRange L init →
                        SRInRange L (cfs-enc-list L fuel init st u)) of
    nil → λ _ _ hrng → hrng
    cons x r → λ st hpres hrng →
      hpres 5 nil st x (cfs-enc-list L fuel init (cstate-advance st x) r)
        (rec r (cstate-advance st x) hpres hrng)
