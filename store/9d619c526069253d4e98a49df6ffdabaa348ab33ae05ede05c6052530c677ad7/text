-- Carryless 32-bit range encoder renormalization (at most 4 bytes)
hcm-renorm-enc : Nat → Word → Word → Word → Word → (Word → Word → Word → Step W Word) → Step W Word
hcm-renorm-enc zero lo hi outb opos k = k lo hi opos
hcm-renorm-enc (suc fuel) lo hi outb opos k =
  if %wlt (%wxor lo hi) #16777216 then
    hcm-emit-b outb opos (%wshr lo #24) (λ op2 →
      hcm-renorm-enc fuel (%wand (%wshl lo #8) #4294967295) (%wand (%wor (%wshl hi #8) #255) #4294967295) outb op2 k)
  else k lo hi opos
