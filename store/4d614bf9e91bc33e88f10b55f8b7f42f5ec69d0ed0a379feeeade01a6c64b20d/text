cs-code10-sim-eq : (nf_of : Word → Word → Word) (k : Nat) (ars : Lst (Word × Word))
  (menv : Lst CsMVal) (ev_r : CsExp → CsRes) (c : Code) →
  cs-sim-ok (cs-code10-eval nf_of (cs-code-eval-by nf_of k) menv (cs-code10 c))
            (ev_r (cs-compile-by nf_of (suc k) ars (cs-wlen menv) c))
  ≡ cs-sim-ok (cs-code10-eval nf_of (cs-code-eval-by nf_of k) menv (cs-code10 c))
              (ev_r (cs-code10-comp nf_of k ars (cs-wlen menv) (cs-code10 c)))
cs-code10-sim-eq nf_of k ars menv ev_r (cvar n) = refl
cs-code10-sim-eq nf_of k ars menv ev_r (cwlit w) = refl
cs-code10-sim-eq nf_of k ars menv ev_r (cwsucc a) = refl
cs-code10-sim-eq nf_of k ars menv ev_r (cwop j a b) = refl
cs-code10-sim-eq nf_of k ars menv ev_r (clet t b) = refl
cs-code10-sim-eq nf_of k ars menv ev_r (cpair a b) = refl
cs-code10-sim-eq nf_of k ars menv ev_r (cfst p) = refl
cs-code10-sim-eq nf_of k ars menv ev_r (csnd p) = refl
cs-code10-sim-eq nf_of k ars menv ev_r (ccase dd B cond) = refl
cs-code10-sim-eq nf_of k ars menv ev_r other = refl
