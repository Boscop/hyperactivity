-- the number of eigenvalues of the symmetric integer matrix m below p/q (q > 0), and whether p/q missed every zero of
-- the leading minors of q·m − p·1 (when false, the count is not read)
inertia-below : List (List BZ) → BZ → BZ → Nat × Bool
inertia-below m p q = in-changes bz-one (in-minors m bz-one (in-shift q p zero m))
