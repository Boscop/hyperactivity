-- a rank on the atoms, which is what gives the orbit computation a least element to pick
il-rank : Ile → Nat
il-rank x = case x of
  il-c1 → 0
  il-o1 → 1
  il-o2 → 2
  il-ho → 3
  il-ca → 4
  il-ha → 5
  il-n → 6
  il-hn1 → 7
  il-hn2 → 8
  il-cb → 9
  il-hb → 10
  il-cg1 → 11
  il-g11 → 12
  il-g12 → 13
  il-cd1 → 14
  il-d11 → 15
  il-d12 → 16
  il-d13 → 17
  il-cg2 → 18
  il-g21 → 19
  il-g22 → 20
  il-g23 → 21
