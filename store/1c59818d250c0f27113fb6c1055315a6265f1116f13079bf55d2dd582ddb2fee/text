<script>
// Lab 1: Observation Fiber & Active Querying Refinement
(function() {
  const stage = document.getElementById('fibStage');
  const canvas = document.getElementById('fibCanvas');
  const ctx = canvas.getContext('2d');
  const statusEl = document.getElementById('fibStatus');
  const H = [
    { id: 'h0', a: 1, b: 1, c: 1, safe: true  },
    { id: 'h1', a: 1, b: 1, c: 0, safe: true  },
    { id: 'h2', a: 1, b: 0, c: 1, safe: false },
    { id: 'h3', a: 1, b: 0, c: 0, safe: false },
    { id: 'h4', a: 0, b: 1, c: 1, safe: true  },
    { id: 'h5', a: 0, b: 1, c: 0, safe: false },
    { id: 'h6', a: 0, b: 0, c: 1, safe: false },
    { id: 'h7', a: 0, b: 0, c: 0, safe: false },
  ];
  let qA = false, qB = false, qC = false, t = 0;

  function resize() {
    const r = stage.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.floor(r.width * dpr));
    canvas.height = Math.max(1, Math.floor(r.height * dpr));
  }
  new ResizeObserver(resize).observe(stage); resize();

  const bA = document.getElementById('qA'), bB = document.getElementById('qB'), bC = document.getElementById('qC');
  bA.onclick = () => { qA = !qA; bA.classList.toggle('on', qA); };
  bB.onclick = () => { qB = !qB; bB.classList.toggle('on', qB); };
  bC.onclick = () => { qC = !qC; bC.classList.toggle('on', qC); };
  document.getElementById('qReset').onclick = () => { qA = qB = qC = false; [bA,bB,bC].forEach(b=>b.classList.remove('on')); };

  function draw() {
    t += 0.03;
    const dark = document.documentElement.classList.contains('dark');
    const bg = dark ? '#000' : '#fff', ink = dark ? '#fff' : '#000';
    const pink = '#ff0a94', blue = dark ? '#4da3ff' : '#1a73e8';
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const W = canvas.width / dpr, Hh = canvas.height / dpr;

    ctx.setTransform(1,0,0,1,0,0); ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.fillStyle = bg; ctx.fillRect(0,0,canvas.width,canvas.height);
    ctx.scale(dpr, dpr);

    // Filter compatible histories (true world is h0: a=1, b=1, c=1)
    const alive = H.filter(h => (!qA || h.a === 1) && (!qB || h.b === 1) && (!qC || h.c === 1));
    const allSafe = alive.every(h => h.safe);
    const anySafe = alive.some(h => h.safe);
    const split = anySafe && !allSafe;

    const ax = W * 0.16, ay = Hh * 0.5;
    // Draw observation node on left, histories in a column/arc on right
    const rx = W * 0.68;
    H.forEach((h, i) => {
      const inFib = alive.includes(h);
      const y = 34 + (i / 7) * (Hh - 68);
      // Edge from Observation y to history h_i
      ctx.beginPath(); ctx.moveTo(ax + 44, ay); ctx.lineTo(rx - 22, y);
      ctx.strokeStyle = !inFib ? (dark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.08)') : (h.safe ? blue : pink);
      ctx.lineWidth = inFib ? 1.8 : 0.8;
      ctx.stroke();

      if (inFib) {
        const u = (t * 0.4 + i * 0.13) % 1;
        ctx.beginPath();
        ctx.arc(ax + 44 + (rx - 22 - (ax + 44)) * u, ay + (y - ay) * u, 2.8, 0, Math.PI * 2);
        ctx.fillStyle = h.safe ? blue : pink; ctx.fill();
      }

      // History node
      ctx.beginPath(); ctx.arc(rx, y, inFib ? 14 : 9, 0, Math.PI * 2);
      ctx.fillStyle = !inFib ? bg : (h.safe ? blue : pink);
      ctx.fill();
      ctx.strokeStyle = inFib ? ink : (dark ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.2)');
      ctx.lineWidth = inFib ? 1.5 : 1; ctx.stroke();

      ctx.font = '700 11px ui-monospace, Menlo, monospace';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillStyle = inFib ? '#fff' : (dark ? 'rgba(255,255,255,0.28)' : 'rgba(0,0,0,0.28)');
      ctx.fillText(h.id, rx, y);

      ctx.textAlign = 'left';
      ctx.fillStyle = inFib ? ink : (dark ? 'rgba(255,255,255,0.25)' : 'rgba(0,0,0,0.25)');
      ctx.fillText(h.safe ? 'P(h) = TRUE' : 'P(h) = FALSE', rx + 24, y);
    });

    // Observation center node
    ctx.beginPath(); ctx.arc(ax, ay, 42, 0, Math.PI * 2);
    ctx.fillStyle = bg; ctx.fill();
    ctx.strokeStyle = split ? pink : blue; ctx.lineWidth = 2.5; ctx.stroke();
    ctx.textAlign = 'center'; ctx.fillStyle = ink; ctx.font = '700 11px ui-monospace, Menlo, monospace';
    ctx.fillText('Obs y', ax, ay - 8);
    ctx.fillStyle = split ? pink : blue;
    ctx.fillText(`|Fib|=${alive.length}`, ax, ay + 10);

    if (split) {
      const w1 = alive.find(h => h.safe), w2 = alive.find(h => !h.safe);
      statusEl.textContent = `${alive.length} histories in Fib(y) · SPLIT WITNESS (${w1.id} vs ${w2.id}) — QUERY REQUIRED`;
      statusEl.style.color = pink;
    } else {
      statusEl.textContent = `${alive.length} compatible ${alive.length===1?'history':'histories'} · ✓ WARRANTED ACROSS ENTIRE FIBER (P holds for all h ∈ Fib)`;
      statusEl.style.color = blue;
    }
    requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);
})();

// Lab 2: Standpoint Interaction Network
(function() {
  const stage = document.getElementById('spStage');
  const canvas = document.getElementById('spCanvas');
  const ctx = canvas.getContext('2d');
  const statusEl = document.getElementById('spStatus');
  let mode = 'hx', flip = false, t = 0;

  function resize() {
    const r = stage.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.floor(r.width * dpr));
    canvas.height = Math.max(1, Math.floor(r.height * dpr));
  }
  new ResizeObserver(resize).observe(stage); resize();
  const bHx = document.getElementById('spModeHx'), bRl = document.getElementById('spModeRlhf');
  bHx.onclick = () => { mode = 'hx'; bHx.classList.add('on'); bRl.classList.remove('on'); };
  bRl.onclick = () => { mode = 'rlhf'; bRl.classList.add('on'); bHx.classList.remove('on'); };
  document.getElementById('spFlip').onclick = () => { flip = !flip; };

  function draw() {
    t += 0.03;
    const dark = document.documentElement.classList.contains('dark');
    const bg = dark ? '#000' : '#fff', ink = dark ? '#fff' : '#000';
    const pink = '#ff0a94', blue = dark ? '#4da3ff' : '#1a73e8';
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const W = canvas.width / dpr, H = canvas.height / dpr;

    ctx.setTransform(1,0,0,1,0,0); ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.fillStyle = bg; ctx.fillRect(0,0,canvas.width,canvas.height);
    ctx.scale(dpr, dpr);

    const agents = [
      { name: 'Agent α', x: W * 0.20, y: H * 0.26, val: +1 },
      { name: 'Agent β', x: W * 0.20, y: H * 0.74, val: flip ? +1 : -1 },
      { name: 'Agent γ', x: W * 0.80, y: H * 0.26, val: +1 },
      { name: 'Agent δ', x: W * 0.80, y: H * 0.74, val: -1 },
    ];
    const cx = W * 0.50, cy = H * 0.50;

    agents.forEach((a, i) => {
      ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(cx, cy);
      ctx.strokeStyle = a.val > 0 ? blue : pink; ctx.lineWidth = 1.8; ctx.stroke();
      const u = (t * 0.45 + i * 0.25) % 1;
      ctx.beginPath(); ctx.arc(a.x + (cx - a.x)*u, a.y + (cy - a.y)*u, 3.2, 0, Math.PI*2);
      ctx.fillStyle = a.val > 0 ? blue : pink; ctx.fill();

      ctx.beginPath(); ctx.arc(a.x, a.y, 26, 0, Math.PI*2);
      ctx.fillStyle = bg; ctx.fill(); ctx.strokeStyle = a.val > 0 ? blue : pink; ctx.lineWidth = 2; ctx.stroke();
      ctx.font = '700 11px ui-monospace, Menlo, monospace'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillStyle = ink; ctx.fillText(a.name, a.x, a.y - 6);
      ctx.fillStyle = a.val > 0 ? blue : pink; ctx.fillText(a.val > 0 ? '+1' : '-1', a.x, a.y + 9);
    });

    const avg = agents.reduce((s, a) => s + a.val, 0) / agents.length;
    ctx.beginPath(); ctx.arc(cx, cy, 48, 0, Math.PI * 2);
    ctx.fillStyle = bg; ctx.fill();
    ctx.strokeStyle = mode === 'hx' ? pink : ink; ctx.lineWidth = 2.5; ctx.stroke();
    ctx.textAlign = 'center'; ctx.fillStyle = ink; ctx.font = '700 11px ui-monospace, Menlo, monospace';
    if (mode === 'hx') {
      ctx.fillText('SET UNION', cx, cy - 12);
      ctx.fillStyle = blue; ctx.fillText('α,γ ⊢ +1', cx, cy + 4);
      ctx.fillStyle = pink; ctx.fillText((flip ? 'δ' : 'β,δ') + ' ⊢ -1', cx, cy + 18);
      statusEl.textContent = 'Hyperactive Set-Union: every standpoint preserved + explicit split witness';
      statusEl.style.color = pink;
    } else {
      ctx.fillText('RLHF MEAN', cx, cy - 8);
      ctx.fillStyle = ink; ctx.fillText(`r̄ = ${avg >= 0 ? '+' : ''}${avg.toFixed(2)}`, cx, cy + 10);
      statusEl.textContent = `Scalar RLHF Average collapses 4 incompatible standpoints to r̄ = ${avg.toFixed(2)} (satisfies nobody)`;
      statusEl.style.color = blue;
    }
    requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);
})();
</script>
