-- a suffix that q begins is in the shard q's first token names
in-shard : (x : List Word) (qr : List (List Word)) (t : List Word) (r : List (List Word)) →
  isTrue (pre (cons x qr) (cons t r)) → isTrue (tok-eq (skey t) (skey x))
in-shard x qr t r h =
  subst {_} {_} {_} {λ y → isTrue (tok-eq (skey t) (skey y))}
    (sym (tok-eq-sound x t (and-fst {tok-eq x t} {pre qr r} h))) (tok-eq-refl (skey t))
