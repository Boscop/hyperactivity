-- ---------------------------------------------------------------- the transitions, cell by cell
-- thread t reads one cell: the newest write to it in t's own buffer, else memory
tso-read1 : Word → Word → TsoSt → Word × TsoSt
tso-read1 t a (tso-st m ls bf nx lg) =
  (case tso-buf-find a (bf t) of
     inl p → (fst p , tso-st m ls bf (%wsucc nx) (cons (l-read t nx a (fst p) (snd p)) lg))
     inr u → (m a , tso-st m ls bf (%wsucc nx) (cons (l-read t nx a (m a) (ls a)) lg)))
