DLDim : (sk : Lst Entry) (k : Word) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y)) (c : Cube (suc (suc (dims sk))) X) (d : DCube (suc (suc (dims sk))) X Y c) → Bool → Type 1
DLDim sk k X Y Z H f g c d b =
  PathP (λ i → DCube (suc (dims sk)) Z H (ddm-dim sk k X Y Z f c d b i))
    (dsd-dim sk k Z H (dm2 (dims sk) X Y Z f c d) (dcube-lift (suc (suc (dims sk))) X Z Y H f g c d) b)
    (dcube-lift (suc (dims sk)) X Z Y H f g (dsk-dim sk k X c b) (dsd-dim sk k X Y c d b))
