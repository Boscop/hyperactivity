cs-print-args-eq : (cf : Code → CsExp) (pr : Code → List Word → List Word) →
  ((x : Code) (tl : List Word) → cs-print (cf x) tl ≡ pr x tl) →
  (as : Lst Code) (first : Bool) (acc : List Word) →
  cs-print (cs-comp-args cf as first) acc ≡ ce-args pr as first acc
cs-print-args-eq cf pr h lnil first acc = refl
cs-print-args-eq cf pr h (lcons a r) true acc =
  h a (cs-print (cs-comp-args cf r false) acc)
  ∙ cong (pr a) (cs-print-args-eq cf pr h r false acc)
cs-print-args-eq cf pr h (lcons a r) false acc =
  cong (list-append ", ")
    (h a (cs-print (cs-comp-args cf r false) acc)
     ∙ cong (pr a) (cs-print-args-eq cf pr h r false acc))
