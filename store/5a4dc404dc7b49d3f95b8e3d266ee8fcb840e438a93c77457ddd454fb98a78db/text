-- Canonical 5-cycle multi-redex hardware trace on the built-in reset net:
--   Reset net (4 live nodes):
--     n0 = CON (p0 -> n1.0, p1 -> n2.0, p2 -> n3.0)
--     n1 = DUP (p0 -> n0.0, p1 -> EXT0, p2 -> EXT1)
--     n2 = ERA (p0 -> n0.1)
--     n3 = ERA (p0 -> n0.2)
--   Cycle 1: n0(CON) ⋈ n1(DUP) COMMUTE -> 6 live nodes (n0,n4=DUP; n1,n5=CON; n2,n3=ERA), n0⋈n2 & n4⋈n3 active!
--   Cycle 2: n0(DUP) ⋈ n2(ERA) ERASE   -> 6 live nodes (n0,n2=ERA wired to n1.1, n5.1)
--   Cycle 3: n3(ERA) ⋈ n4(DUP) ERASE   -> 6 live nodes (n3,n4=ERA wired to n1.2, n5.2)
--   Done! Normal form reached in 3 redexes with 6 live nodes, 0 remaining active pairs, 0 stalls, 0 instructions.
inet-trace-live : Word → Word
inet-trace-live c =
  if %weq c #0 then #4
  else if %weq c #1 then #6
  else if %weq c #2 then #6
  else #6
