cs-read-range : CsHeap → CsVal → Nat → Nat → Opt (Lst CsVal)
cs-read-range hp ptr base zero = some lnil
cs-read-range hp ptr base (suc k) =
  case cs-load hp ptr base return (λ _ → Opt (Lst CsVal)) of
    none → none
    some v →
      (case cs-read-range hp ptr (suc base) k return (λ _ → Opt (Lst CsVal)) of
         none → none
         some vs → some (lcons v vs))
