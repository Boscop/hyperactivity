ot-js-1 : List Word
ot-js-1 =
  ot-cat (
    cons "(function(){var tab='sci',aud=false,ac=null,W=null,t=0;" (
    cons "document.querySelectorAll('[data-t]').forEach(function(b){b.onclick=function(){tab=b.getAttribute('data-t');document.querySelectorAll('[data-t]').forEach(function(k){k.classList.toggle('on',k===b)});document.querySelectorAll('.pane').forEach(function(p){p.classList.toggle('on',p.id==='p-'+tab)});resizeAll()}});" (
    cons "function tone(f,d){if(!aud)return;try{if(!ac)ac=new(window.AudioContext||window.webkitAudioContext)();var o=ac.createOscillator(),g=ac.createGain();o.type='sine';o.frequency.value=f;g.gain.setValueAtTime(0.035,ac.currentTime);g.gain.exponentialRampToValueAtTime(0.0001,ac.currentTime+(d||0.14));o.connect(g);g.connect(ac.destination);o.start();o.stop(ac.currentTime+(d||0.14))}catch(_){}}" (
    cons "function gcd(a,b){a=a<0n?-a:a;b=b<0n?-b:b;while(b){var r=a%b;a=b;b=r}return a||1n}" (
    cons "function qNorm(n,d){if(d<0n){n=-n;d=-d}var g=gcd(n,d);return[n/g,d/g]}" (
    cons "function qAdd(a,b){return qNorm(a[0]*b[1]+b[0]*a[1],a[1]*b[1])}" (
    cons "function qSub(a,b){return qNorm(a[0]*b[1]-b[0]*a[1],a[1]*b[1])}" (
    cons "function qMul(a,b){return qNorm(a[0]*b[0],a[1]*b[1])}" (
    cons "function qDiv(a,b){return qNorm(a[0]*b[1],a[1]*b[0])}" (
    cons "var sciHist=[];" (
    cons "function runExactQ(){var N=+document.getElementById('sl-n').value,dv=+document.getElementById('sl-d').value;document.getElementById('s-nv').textContent=N;document.getElementById('s-dv').textContent='1/'+dv;" (
    cons "var h=[1n,BigInt(dv)],h2=qMul(h,h),one=[1n,1n],den=qAdd(one,h2),c=qDiv(qSub(one,h2),den),s=qDiv(qMul([2n,1n],h),den);" (
    cons "var xr=[1n,1n],xi=[0n,1n],er=1.0,ei=0.0,dt=2.0/dv;sciHist=[];" (
    cons "for(var k=0;k<N;k++){var n2=qAdd(qMul(xr,xr),qMul(xi,xi)),e2=er*er+ei*ei;sciHist.push([Number(n2[0])/Number(n2[1]),e2,Number(xr[0])/Number(xr[1])]);" (
    cons "var nxr=qSub(qMul(c,xr),qMul(s,xi)),nxi=qAdd(qMul(s,xr),qMul(c,xi));xr=nxr;xi=nxi;var ner=er-dt*ei,nei=ei+dt*er;er=ner;ei=nei}" (
    cons "var fn2=qAdd(qMul(xr,xr),qMul(xi,xi)),fe2=er*er+ei*ei;" (
    cons "document.getElementById('q-norm').textContent='|psi|^2 = '+fn2[0]+' / '+fn2[1]+' (EXACT)';" (
    cons "document.getElementById('m-cerr').textContent=(fn2[0]-fn2[1])+' / '+fn2[1];" (
    cons "document.getElementById('m-eerr').textContent='+'+(fe2-1).toExponential(3);" (
    cons "var U=BigInt(document.getElementById('sl-u').value),T=BigInt(document.getElementById('sl-t').value);document.getElementById('u-v').textContent=U;document.getElementById('t-v').textContent=T;" (
    cons "var c0=7n,c1=11n,e0=3n,ume=U-e0,ener=U*c1*c1-4n*T*c0*c1-e0*(c0*c0+c1*c1),sos=(ume*c1-2n*T*c0)*(ume*c1-2n*T*c0),lhs=ume*ener-sos,rhs=c0*c0*(e0*e0-U*e0-4n*T*T),res=lhs-rhs;" (
    cons "document.getElementById('sos-st').textContent='RESIDUAL = '+res+' / 1';" (
    cons "document.getElementById('q-out').textContent='EXACT RATIONAL CAYLEY SU(2) STEP='+N+' (dt=2/'+dv+')'+String.fromCharCode(10)+'  Cayley cos = '+c[0]+'/'+c[1]+''+String.fromCharCode(10)+'  Cayley sin = '+s[0]+'/'+s[1]+''+String.fromCharCode(10)+'  Exact |psi_N|^2 = '+fn2[0]+' / '+fn2[1]+' (0 bits lost)'+String.fromCharCode(10)+'  Exact psi_N real digits = '+xr[0].toString().length+' / '+xr[1].toString().length+''+String.fromCharCode(10)+''+String.fromCharCode(10)+'EXACT 2-RDM HUBBARD SOS IDENTITY OVER Z[U,t,E0,c0,c1]:'+String.fromCharCode(10)+'  (U-E0)*E - ((U-E0)*c1 - 2*t*c0)^2 - c0^2*(E0^2-U*E0-4*t^2)'+String.fromCharCode(10)+'  Evaluated at U='+U+', t='+T+', c0=7, c1=11: EXACT RESIDUAL = '+res+' / 1';drawSci()}" (
    cons "function drawSci(){var cv=document.getElementById('cv-sci');if(!cv)return;var x=cv.getContext('2d'),w=cv.clientWidth,h=cv.clientHeight;if(w<10)return;var d=window.devicePixelRatio||1;cv.width=w*d;cv.height=h*d;x.setTransform(d,0,0,d,0,0);x.fillStyle='#020202';x.fillRect(0,0,w,h);" (
    cons "var cy=h*0.62;x.strokeStyle='rgba(255,255,255,0.16)';x.beginPath();x.moveTo(24,cy);x.lineTo(w-24,cy);x.stroke();" (
    cons "var N=sciHist.length;if(N<2)return;" (
    cons "x.strokeStyle='#ff0a94';x.lineWidth=2;x.setLineDash([5,4]);x.beginPath();for(var i=0;i<N;i++){var px=24+(w-48)*(i/(N-1)),e2=Math.min(4.5,sciHist[i][1]),py=cy-(e2-1)*55;if(i===0)x.moveTo(px,py);else x.lineTo(px,py)}x.stroke();x.setLineDash([]);" (
    cons "x.strokeStyle='#38d388';x.lineWidth=2.6;x.beginPath();for(var i=0;i<N;i++){var px=24+(w-48)*(i/(N-1)),py=cy-(sciHist[i][0]-1)*55;if(i===0)x.moveTo(px,py);else x.lineTo(px,py)}x.stroke();" (
    cons "x.strokeStyle='rgba(255,255,255,0.45)';x.lineWidth=1.4;x.beginPath();for(var i=0;i<N;i++){var px=24+(w-48)*(i/(N-1)),py=cy+60-sciHist[i][2]*45;if(i===0)x.moveTo(px,py);else x.lineTo(px,py)}x.stroke();" (
    cons "x.fillStyle='#38d388';x.font='600 11px ui-monospace,Menlo,monospace';x.fillText('GREEN: EXACT Q CAYLEY |psi|^2 = 1/1',28,22);x.fillStyle='#ff0a94';x.fillText('PINK DASHED: IEEE-754 EULER DRIFT',28,38)}" nil))))))))))))))))))))))))))))))

