-- one side drawn: each kept word carries the name it shares with its place in the other side, so the
-- change between them is one interpolation in which the kept words move and the others fade
hi-mside : List Word → List Word → Nat → List (List Word × List Word) → List Word
hi-mside x p k nil = nil
hi-mside x p k (cons e r) = list-append (if h-eq (fst e) x then nil else h-concat (cons "<span class='w" (cons (if h-eq (fst e) "=" then "' style='view-transition-name:" else "' style='opacity:.75;color:#ffd479'>") (cons (if h-eq (fst e) "=" then list-append p (list-append (h-decimal (fromNat k)) "'>") else nil) (cons (s-esc (snd e)) (cons "</span> " nil)))))) (hi-mside x p (suc k) r)
