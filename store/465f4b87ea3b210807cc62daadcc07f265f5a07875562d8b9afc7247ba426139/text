-- a lattice point, offset so that no coordinate goes below zero
sl-step : Nat × Nat → Nat → Nat × Nat
sl-step p d = if eqb d 0 then (the (Nat × Nat) (suc (fst p) , snd p)) else (if eqb d 1 then (the (Nat × Nat) (fst p , suc (snd p))) else (if eqb d 2 then (the (Nat × Nat) (monus (fst p) 1 , snd p)) else (the (Nat × Nat) (fst p , monus (snd p) 1))))
