-- load_bytes_from_ea: from memory_accessors.sail (it calls what is defined after it there)
-- (part of language-support)
load_bytes_from_ea : (proc_mode' : proc_mode) → (addr_size : ZI) → (nbytes : ZI) → (eff_addr : Bits #64) → (base_reg : Option ZI) → (seg_reg : ZI) → (r_x : Text) → (check_alignment? : Bool) → (mem_ptr? : Bool) → MS (Bits (wmul #8 (z-nat nbytes)))
load_bytes_from_ea proc_mode' addr_size nbytes eff_addr base_reg seg_reg r_x check_alignment? mem_ptr? =
  bindS {List (Bits #16)} {Bits (wmul #8 (z-nat nbytes))} (getS {List (Bits #16)} x86-seg_hidden_attrs) (λ seg_hidden_attrs'1 →
    let cs_attrs : code_segment_descriptor_attributesbits
        cs_attrs = (vec-get {Bits #16} #0 seg_hidden_attrs'1 #1)
    in λ σ →
         if (b-and (b-not (in_64bit_mode proc_mode')) (b-and (z-eq seg_reg (zpos #1)) (b-and (str-eq r_x #14930) (weq (code_segment_descriptor_attributesbits-r cs_attrs) #0)))) then
           the (MS (Bits (wmul #8 (z-nat nbytes))))
             (liftS {Bits (wmul #8 (z-nat nbytes))} (x86_fault {Bits (wmul #8 (z-nat nbytes))} #93637690974564060930392721801307408224776595650152955241647700)) σ
         else
           the (MS (Bits (wmul #8 (z-nat nbytes))))
             (bindS {Bits #64} {Bits (wmul #8 (z-nat nbytes))} (ea_to_la proc_mode' eff_addr seg_reg nbytes) (λ lin_addr →
                onS {Unit} {Bits (wmul #8 (z-nat nbytes))} (check_linear_memory_access proc_mode' addr_size nbytes lin_addr base_reg seg_reg r_x check_alignment? mem_ptr?) (λ t'4 →
                  rb_ #64 nbytes lin_addr r_x))) σ)
