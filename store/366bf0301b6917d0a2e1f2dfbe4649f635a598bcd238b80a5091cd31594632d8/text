bn-s256-rounds : Nat → Word → List Word → List Word → List Word
bn-s256-rounds zero    idx ws st = st
bn-s256-rounds (suc k) idx ws st =
  let a  = bn-nth-w #0 st
      b  = bn-nth-w #1 st
      c  = bn-nth-w #2 st
      d  = bn-nth-w #3 st
      e  = bn-nth-w #4 st
      f  = bn-nth-w #5 st
      g  = bn-nth-w #6 st
      h  = bn-nth-w #7 st
      ki = bn-nth-w idx bn-sha256-k-words
      wi = bn-nth-w idx ws
      t1 = bn-add32 h (bn-add32 (bn-s256-S1 e) (bn-add32 (bn-s256-ch e f g) (bn-add32 ki wi)))
      t2 = bn-add32 (bn-s256-S0 a) (bn-s256-maj a b c)
      nx = cons (bn-add32 t1 t2)
           (cons a (cons b (cons c (cons (bn-add32 d t1) (cons e (cons f (cons g nil)))))))
  in bn-s256-rounds k (%wadd idx #1) ws nx
