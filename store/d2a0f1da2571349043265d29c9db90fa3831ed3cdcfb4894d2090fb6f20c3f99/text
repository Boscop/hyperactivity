-- obj.f(args), ptr->f(args), (obj.*pm)(args)
cx-mcall : CxH → CxU → CType → List CType → CxSub → CxSub → CxEnv → CxMode → CxK → CxEv CxR
cx-mcall h u t ats callee args env mode k = callee env cxm-get (λ c → case c of
  cxr-bound this fid virt → cx-bind {Word} {CxR} (cx-dispatch u this fid virt) (λ f2 →
    cx-apply h u t f2 this args ats (cxu-ltr u) env mode k)
  _ → cx-stop {CxR} st-ill-typed)
