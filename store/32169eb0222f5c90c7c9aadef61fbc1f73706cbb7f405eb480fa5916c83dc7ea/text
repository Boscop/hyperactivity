cs-hy-sub-sound : (hp : CsHeap) (a b : Word) →
  cs-hy-bop #4 hp (csv-word a) (csv-word b) ≡ cs-ok hp (csv-word (%wsub a b))
cs-hy-sub-sound hp a b =
  cong (λ z → cs-ok hp (csv-word z))
    (cong (λ z → if z then %wsub a b else #0) (sym (ltw≡wlt b a))
     ∙ (cong (λ z → if ltw b a then z else #0) (sym (subw≡wsub a b))
        ∙ (cs-ltw-subw a b ∙ subw≡wsub a b)))
