-- (part of language-support)
vex_get_l : (vex_prefixes' : vex_prefixes) → Bits #2
vex_get_l vex_prefixes' =
  let m'1 : Bits #8
      m'1 = (vex_prefixes-byte0 vex_prefixes')
      t'2 : Bits #2
      t'2 =
        if (weq m'1 #197) then
          (bv-zext #1 #2 (vex2_byte1-l (vex_prefixes-byte1 vex_prefixes')))
        else if (weq m'1 #196) then
          (bv-zext #1 #2 (vex3_byte2-l (vex_prefixes-byte2 vex_prefixes')))
        else
          #3
  in t'2
