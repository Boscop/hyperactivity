s-taken : List Word → List Word → Bool → List Word → List Word → Sum Unit (List Word) → Proc W (List Word)
s-taken st hx rec body p t = if s-held rec body t then bind (h-pointer (h-unhex hx)) (s-changed st hx p)
  else ret {lzero} {W} (s-respond "422 Unprocessable Content" "text/plain" "the module does not read")
