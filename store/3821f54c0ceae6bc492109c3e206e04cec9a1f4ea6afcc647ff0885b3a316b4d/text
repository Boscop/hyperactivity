-- Contradiction Pruning Theorem: if clause-ok is false, NO interval assignment can satisfy it!
lit-conflict : (p n r : Bool) → lit-ok p n ≡ false → lit-sat p n r ≡ false
lit-conflict false n r = λ h → Empty-rec (bool-discr h)
lit-conflict true false r = λ h → Empty-rec (bool-discr h)
lit-conflict true true false = λ h → refl
lit-conflict true true true = λ h → refl
