-- Fused compressed-stream BF16->FP32 product === raw uncompressed BF16->FP32 product (0.00e+00 error!)
psc-thm-fused-bf16-fp32-exact :
  psc-bf16-mul-fp32 (psc-bf16-unpack (psc-bf16-sm #16457) #3 (psc-bf16-exp #16457) #0) #16384
  ≡ psc-bf16-mul-fp32 #16457 #16384
psc-thm-fused-bf16-fp32-exact = refl
