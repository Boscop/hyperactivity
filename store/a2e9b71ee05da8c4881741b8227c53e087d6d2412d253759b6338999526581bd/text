keys-eq : (f : List (List Word) → Word) → (h : Nat) → (t : List (List Word)) → (r : List Word) → r ≡ list-map f (sufs t) →
          zippad r (drop-n h r) ≡ list-map (dkey f h) (sufs t)
keys-eq f h t r e =
  tr (zippad (list-map f (sufs t)) (list-map f (sufs (drop-n h t)))) (λ i → zippad (e i) (drop-keys f h t r e i)) (shift f h t)
