nk-set : NkSlots → NkW → NkSlot → NkSlots
nk-set nksl-nil w-end s = nksl-node s nksl-nil nksl-nil
nk-set nksl-nil (w-0 r) s = nksl-node nks-none (nk-set nksl-nil r s) nksl-nil
nk-set nksl-nil (w-1 r) s = nksl-node nks-none nksl-nil (nk-set nksl-nil r s)
nk-set (nksl-node t a b) w-end s = nksl-node s a b
nk-set (nksl-node t a b) (w-0 r) s = nksl-node t (nk-set a r s) b
nk-set (nksl-node t a b) (w-1 r) s = nksl-node t a (nk-set b r s)
