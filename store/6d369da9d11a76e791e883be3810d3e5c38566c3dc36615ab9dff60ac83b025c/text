tir-sym : {A : Type} → {x y : A} → x ≡ y → y ≡ x
tir-sym {A} {x} p = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ p j , i = 1 ↦ x ]) x

tir-xorB : Bool → Bool → Bool
