-- Theorem: the condition is exact. If printing a name and a text and reading gives back the meaning,
-- the name holds no newline (the name read is a first line, which holds none)
text-written-raw-round-trip-needs : (n s : List Word) → Path (Lst Meaning) (text-written-raw (text-written-raw-print n s)) (lcons (means n (code (List Word)) (text-code s)) lnil) → isTrue (no-newline n)
text-written-raw-round-trip-needs n s p = subst {lzero} {lzero} {List Word} {λ x → isTrue (no-newline x)} {raw-first-line (text-written-raw-print n s)} {n} (cong meaning-name p) (first-line-clean (text-written-raw-print n s))
