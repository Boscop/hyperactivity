nk-get-do-apart : (fx : NkFx) (sl : NkSlots) (u : NkW) → nk-apart u fx → nk-get (nk-do fx sl) u ≡ nk-get sl u
nk-get-do-apart nkf-nil sl u ap = refl
nk-get-do-apart (nkf-at k c r) sl u ap = nk-get-do-apart r (nk-upd sl k (nk-ch c)) u (snd (snd ap)) ∙ nk-get-set-other sl k u (nk-ch c (nk-get sl k)) (fst (snd ap))
