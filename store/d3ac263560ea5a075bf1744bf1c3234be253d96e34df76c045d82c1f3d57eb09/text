branch-boundary Pv F t bs =
  case %view bs of
    wsys bl → 
      let bodyv = tval t
      in rall
           (λ br →
              let cl = fst br
                  w = snd br
                  v1 = %restrict cl bodyv
                  v2 = %restrict cl (F w)
              in chk (conv (%restrict cl (Pv w)) v1 v2) (refused bodyv E-boundary v2 v1)) bl
    _ → ok
