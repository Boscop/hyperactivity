q-check-exact-state : Word → QState3 → Bool
q-check-exact-state tgt (qs3 s0 s1 s2 s3 s4 s5 s6 s7) =
  web-andB (q-ck-exact tgt #0 s0) (web-andB (q-ck-exact tgt #1 s1)
  (web-andB (q-ck-exact tgt #2 s2) (web-andB (q-ck-exact tgt #3 s3)
  (web-andB (q-ck-exact tgt #4 s4) (web-andB (q-ck-exact tgt #5 s5)
  (web-andB (q-ck-exact tgt #6 s6) (q-ck-exact tgt #7 s7)))))))
