nk-act0-shape : (h : Word) (cs : NkTm) (hd : NkHd) (rho : NkW → NkEv) (parts : NkEnv) →
  nk-act0 h cs hd (nk-ev-shape (nk-env-ev rho parts)) ≡ nk-act0 h cs hd parts
nk-act0-shape h cs (hd-clo b) rho parts = refl
nk-act0-shape h cs (hd-susp b) rho parts = refl
nk-act0-shape h cs (hd-num m) rho parts = refl
nk-act0-shape h cs (hd-con c) rho parts =
  cong
    (λ z →
      if %weq h #2 then act-rp z
      else (if %weq h #3 then (if nk-is-dcon c then act-rp (nk-elim-body cs (nk-dc-k c)) else act-none)
      else (if %weq h #9 then (if %weq c #0 then act-rp (nk-var #1) else act-stuck)
      else (if %weq h #10 then (if %weq c #0 then act-rp (nk-var #0) else act-stuck)
      else (if %weq h #8 then (if (if %weq c #10 then true else %weq c #11) then act-ap (nk-var (if %weq c #10 then #1 else #2)) else act-none)
      else act-none)))))
    (nk-strip-shape (nk-branch cs c) rho parts)
nk-act0-shape h cs (hd-var x) rho parts = refl
nk-act0-shape h cs (hd-lvl l) rho parts = refl
nk-act0-shape h cs (hd-stuck g) rho parts = refl
nk-act0-shape h cs (hd-stuckm g) rho parts = refl
nk-act0-shape h cs (hd-dnf d) rho parts = refl
nk-act0-shape h cs (hd-q t) rho parts = refl
