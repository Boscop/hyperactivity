-- Dynamic-Balance Callback Subcall Engine:
-- Layout per subcall: `[target32 (off), len32 (off+32), patchOff32 (off+64), data (off+96 .. off+96+len)]`
-- Uses `mem[192]` for `target` and `mem[224]` for `len` so `evm-bal-of-this` (`mem[0..128)`) never collides!
npm-cb-subcall : List EvmInst
npm-cb-subcall =
  list-append
    (cons (ev-op #128)                    -- [off, off]
    (cons (ev-op #53)                     -- [target, off]
    (cons (ev-op #128)                    -- [target, target, off]
    (cons (ev-op #21)                     -- [target==0, target, off]
    (cons (ev-jmpi #45)                   -- if target == 0 -> done callback!
    (cons (ev-push (cons #192 nil))
    (cons (ev-op #82)                     -- MSTORE(192, target); stack: [off]
    (cons (ev-op #128)                    -- [off, off]
    (cons (ev-push (cons #32 nil))
    (cons (ev-op #1)                      -- [off+32, off]
    (cons (ev-op #53)                     -- [len, off]
    (cons (ev-push (cons #224 nil))
    (cons (ev-op #82)                     -- MSTORE(224, len); stack: [off]
    (cons (ev-op #128)                    -- [off, off]
    (cons (ev-push (cons #64 nil))
    (cons (ev-op #1)                      -- [off+64, off]
    (cons (ev-op #53)                     -- [patchOff, off]
    (cons (ev-op #144)                    -- [off, patchOff]
    (cons (ev-push (cons #96 nil))
    (cons (ev-op #1)                      -- [dataOff = off+96, patchOff]
    (cons (ev-push (cons #224 nil))
    (cons (ev-op #81)                     -- [len, dataOff, patchOff]
    (cons (ev-op #129)                    -- [dataOff, len, dataOff, patchOff]
    (cons (ev-push (cons #1 (cons #0 nil))) -- [256, dataOff, len, dataOff, patchOff]
    (cons (ev-op #55)                     -- CALLDATACOPY(256, dataOff, len); stack: [dataOff, patchOff]
    (cons (ev-op #144)                    -- [patchOff, dataOff]
    (cons (ev-op #128)                    -- [patchOff, patchOff, dataOff]
    (cons (ev-op #21)                     -- [patchOff==0, patchOff, dataOff]
    (cons (ev-jmpi #44)                   -- if patchOff == 0 -> skip balance patch!
    (cons (ev-push (cons #1 (cons #0 nil))) -- [256, patchOff, dataOff]
    (cons (ev-op #1)                      -- [memAddr = 256+patchOff, dataOff]
    (cons (ev-op #128)                    -- [memAddr, memAddr, dataOff]
    (cons (ev-op #81)                     -- [tok20 = MLOAD(memAddr), memAddr, dataOff]
    nil)))))))))))))))))))))))))))))))))
  (list-append (evm-bal-of-this #99)      -- [bal, memAddr, dataOff]
    (cons (ev-op #144)                    -- [memAddr, bal, dataOff]
    (cons (ev-op #82)                     -- MSTORE(memAddr, bal); stack: [dataOff]
    (cons (ev-jmp #46)
    (cons (ev-lbl #44)
    (cons (ev-op #80)                     -- POP patchOff; stack: [dataOff]
    (cons (ev-lbl #46)
    (cons (ev-push nil)                   -- retLen = 0
    (cons (ev-push nil)                   -- retOff = 0
    (cons (ev-push (cons #224 nil))
    (cons (ev-op #81)                     -- argsLen = MLOAD(224)
    (cons (ev-push (cons #1 (cons #0 nil))) -- argsOff = 256
    (cons (ev-push nil)                   -- value = 0
    (cons (ev-push (cons #192 nil))
    (cons (ev-op #81)                     -- target = MLOAD(192)
    (cons (ev-op #90)                     -- GAS
    (cons (ev-op #241)                    -- CALL
    (cons (ev-op #21)
    (cons (ev-jmpi #99)                   -- revert if subcall failed!
    (cons (ev-push (cons #224 nil))
    (cons (ev-op #81)                     -- [len, dataOff]
    (cons (ev-op #1)                      -- [nextOff = dataOff + len]
    nil))))))))))))))))))))))

