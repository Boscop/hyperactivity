npm-abs-diff : Word → Word → Word
npm-abs-diff a b = if %wlt a b then %wsub b a else %wsub a b

npm-min-w : Word → Word → Word
npm-min-w a b = if %wlt a b then a else b

npm-spread-bps10 : Word → Word → Word
npm-spread-bps10 pA pB =
  let mn = npm-min-w pA pB
