  bind (npm-cycle ep true) (λ u0 →
  bind npm-sleep-1s (λ s0 →
  npm-loop k (%wadd ep #1)))

npm-main : Proc W Unit
npm-main =
  bind h-args (λ av →
    if npm-has-flag "--audit" av
    then bind (npm-cycle #1 false) (λ u → exit #0)
    else if npm-has-flag "--execute" av
    then bind (npm-cycle #1 true) (λ u → exit #0)
    else if npm-has-flag "--linerate" av
    then npm-linerate-main
    else if npm-has-flag "--daemon" av
    then npm-loop (toNat #50000) #1
    else bind (h-out (list-append "HX-NETPOS-MAXLEV TYPECHECKED OK (0 postulates)" npm-nl)) (λ u → exit #0))

npm-run : Step W Unit
