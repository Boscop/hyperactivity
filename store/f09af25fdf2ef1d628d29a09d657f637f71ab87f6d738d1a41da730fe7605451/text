-- an operation arrives at a wire
sm-put-op : SmSlot → Word → SmOp → SmState → SmState
sm-put-op sms-none w o (sm-state sl rd n) = sm-state (smsl-cons w (sms-op o) sl) rd n
sm-put-op (sms-val v) w o (sm-state sl rd n) = sm-state (sm-del sl w) (smp-cons o v rd) n
sm-put-op (sms-op p) w o st = st
sm-put-op (sms-readers os) w o st = st
