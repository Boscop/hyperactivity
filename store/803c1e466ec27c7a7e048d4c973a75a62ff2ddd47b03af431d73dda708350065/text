data KExpr : Type where
  ke-k    : Word → KExpr
  ke-v    : Word → KExpr
  ke-not  : KExpr → KExpr
  ke-xor  : KExpr → KExpr → KExpr
  ke-and  : KExpr → KExpr → KExpr
  ke-or   : KExpr → KExpr → KExpr
  ke-add  : KExpr → KExpr → KExpr
  ke-sub  : KExpr → KExpr → KExpr
  ke-mul  : KExpr → KExpr → KExpr
  ke-rotr : KExpr → Word → KExpr
  ke-ch   : KExpr → KExpr → KExpr → KExpr
  ke-maj  : KExpr → KExpr → KExpr → KExpr
