fwd-alg : Alg A0 A1 A2 (Nat × Nat)
fwd-alg =
  ( (λ c → case c of a0-zero → (zero , zero); a0-one → (suc zero , zero))
  , (λ u p → p)
  , (λ b p q → case b of
      a2-add → (plus (fst p) (fst q) , plus (snd p) (snd q))
      a2-mul → (times (fst p) (fst q) , plus (times (fst p) (snd q)) (times (snd p) (fst q)))) )
