-- store release, load acquire
asb-ra : Handler AtomS TsoIS → List TsoThread
asb-ra hd = cons (at-thread hd (ai-store mo-release #0 #1 (ai-load mo-acquire #1 (λ r → ai-ret (cons r nil)))))
           (cons (at-thread hd (ai-store mo-release #1 #1 (ai-load mo-acquire #0 (λ r → ai-ret (cons r nil))))) nil)
