-- a homomorphism commutes with interpretation: h(⟦e⟧_R σ) = ⟦e⟧_T (h ∘ σ)
si-interp-hom : {R T : Type} → (S : SemiringOn R) → (S2 : SemiringOn T) → (h : R → T) → SemiringHom S S2 h → (sigma : Word → R) → (e : Ex) →
  h (si-interp S sigma e) ≡ si-interp S2 (λ v → h (sigma v)) e
si-interp-hom {R} {T} S S2 h hh sigma (ec n) = si-hom-nat S S2 h hh n
si-interp-hom {R} {T} S S2 h hh sigma (ev v) = λ k → h (sigma v)
si-interp-hom {R} {T} S S2 h hh sigma (eadd a b) =
  concat {lzero} {T} {h (si-add S (si-interp S sigma a) (si-interp S sigma b))} {si-add S2 (h (si-interp S sigma a)) (h (si-interp S sigma b))}
    {si-add S2 (si-interp S2 (λ v → h (sigma v)) a) (si-interp S2 (λ v → h (sigma v)) b)}
  (fst (snd (snd hh)) (si-interp S sigma a) (si-interp S sigma b))
  (λ k → si-add S2 (si-interp-hom S S2 h hh sigma a k) (si-interp-hom S S2 h hh sigma b k))
si-interp-hom {R} {T} S S2 h hh sigma (emul a b) =
  concat {lzero} {T} {h (si-mul S (si-interp S sigma a) (si-interp S sigma b))} {si-mul S2 (h (si-interp S sigma a)) (h (si-interp S sigma b))}
    {si-mul S2 (si-interp S2 (λ v → h (sigma v)) a) (si-interp S2 (λ v → h (sigma v)) b)}
  (snd (snd (snd hh)) (si-interp S sigma a) (si-interp S sigma b))
  (λ k → si-mul S2 (si-interp-hom S S2 h hh sigma a k) (si-interp-hom S S2 h hh sigma b k))
