mterm-subst-app : MTerm → MTerm → MTerm → MTerm
mterm-subst-app pre suf mempty = mempty
mterm-subst-app pre suf (mlit a) = mlit a
mterm-subst-app pre suf (mref k) = mref k
mterm-subst-app pre suf (mapp tid arg) =
  %welimP (λ _ → MTerm) tid
    (mcat pre (mcat (mterm-subst-app pre suf arg) suf))
    (λ n _ → mapp n (mterm-subst-app pre suf arg))
mterm-subst-app pre suf (mcat l r) = mcat (mterm-subst-app pre suf l) (mterm-subst-app pre suf r)
