h-unrecord : List Word → Proc W Unit
h-unrecord path = bind (h-read (list-append h-source (list-append "/names-of/" (h-hex path)))) (λ ns →
  bind (h-unrecord-names (h-lines (h-source-or ns))) (λ u →
  bind (h-unlink (list-append h-source (list-append "/names-of/" (h-hex path)))) (λ u2 →
  h-unlink (list-append h-source (list-append "/modules/" (h-hex path))))))
