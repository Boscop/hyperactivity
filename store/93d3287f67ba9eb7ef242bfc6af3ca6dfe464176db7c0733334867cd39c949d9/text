s-unpack-one : List Word → Proc W Word
s-unpack-one file = h-run (cons "/bin/sh" (cons "-c" (cons "IFS=; ! (tar -tvzf $1 | grep -vE '^[d-]') >/dev/null && ! (tar -tzf $1 | grep -vE '^store(/|$)' || tar -tzf $1 | grep -E '(^|/)\.\.(/|$)') >/dev/null && (tar -xzf $1 --skip-old-files store 2>/dev/null || tar -k -xzf $1 store)" (cons "_" (cons file nil)))))
