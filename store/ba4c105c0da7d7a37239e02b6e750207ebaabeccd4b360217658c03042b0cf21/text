-- Single auxiliary-spin x term of the {15j} symbol of the first kind:
--   (-1)^{phase(x)} · (x + 1) · ∏_{k=1}^5 {6j}(j_k, j_{k+1}, i_k; i_{k+1}, x, j_{k+5})
-- Triads per {6j}: (j_k, j_{k+1}, i_k), (j_k, x, j_{k+5}), (i_{k+1}, j_{k+1}, j_{k+5}), (i_{k+1}, x, i_k).
fifteenj-term :
  Nat → Nat → Nat → Nat → Nat →
  Nat → Nat → Nat → Nat → Nat →
  Nat → Nat → Nat → Nat → Nat →
  Nat → CG
fifteenj-term j1 j2 j3 j4 j5 j6 j7 j8 j9 j10 i1 i2 i3 i4 i5 x =
  let s1 = sixj j1 j2 i1 i2 x j6
      s2 = sixj j2 j3 i2 i3 x j7
      s3 = sixj j3 j4 i3 i4 x j8
      s4 = sixj j4 j5 i4 i5 x j9
      s5 = sixj j5 j1 i5 i1 x j10
      prod = cg-mul s1 (cg-mul s2 (cg-mul s3 (cg-mul s4 s5)))
      w = cg-scale-nat (suc x) prod
  in cg-flip (lqg15-odd x) w
