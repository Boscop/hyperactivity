-- a command's sync with the served source, when one is named: what is unpublished published, then
-- (at the start, `pull` true) the server's changes taken
h-sync-at : List Word → List Word → Bool → Sum Unit (List Word) → Proc W Unit
h-sync-at st m pull (inl u) = ret unit
h-sync-at st m pull (inr srv) = bind (h-env "HYPERACTIVE_TOKEN") (λ tk → bind (h-read (list-append st "/unpublished")) (λ l →
  bind (h-publish-all srv (h-source-or tk) (h-lines (h-source-or l))) (λ left →
  bind (h-write (list-append st "/unpublished") left) (λ w → if pull then h-pull st m srv else ret {lzero} {W} unit))))
