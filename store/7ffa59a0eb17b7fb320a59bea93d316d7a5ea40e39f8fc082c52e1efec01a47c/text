hy-fold-modules : List Word → List Word → List (List Word) → Proc W Unit
hy-fold-modules st m args = bind (hy-fold-safe-list st m args) (λ ks → bind (hy-fold-each ks st m) (λ u →
  h-out (h-line (list-append (h-decimal (fromNat (list-length ks))) " modules folded: each was held whole by another, imported by none, and named nowhere"))))
