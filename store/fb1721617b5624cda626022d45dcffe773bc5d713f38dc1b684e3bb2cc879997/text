-- Exact Heap Cell Conservation Theorem 1 (Split / Commutation):
-- Popping 1 cell for a 1→2 redex split strictly preserves total heap cells `live + |freeStack|`.
pool-split-conserves : (l : Nat) → (freshId : Word) → (rest : List Word) →
  pool-capacity (pool-split l freshId rest) ≡ pool-capacity (hpool (suc l) (cons freshId rest))
pool-split-conserves l freshId rest =
  sym (λ i → suc (plus-suc-r-nat l (list-length {Word} rest) i))
