-- ---------------------------------------------------------------- era-env, pick, split, and closure environment trimming soundness
nk-emem-false-tl-at : (eq : Bool) (u : NkW) (r : NkEnv) → ((if eq then true else nk-emem u r) ≡ false) → nk-emem u r ≡ false
nk-emem-false-tl-at true u r h = nk-no (sym h)
nk-emem-false-tl-at false u r h = h
