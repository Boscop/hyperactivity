-- {a b c; ½ e f} with e = c ± ½, f = b ± ½ (doubled): zero unless (a b c) and (a e f) close; e = c − ½ is the
-- canonical form; e = c + ½ is {a f e; ½ c b} (exchange upper and lower in columns 2 and 3, then exchange the two
-- columns), whose lower entries are e − ½ and f ∓ ½
bsixj-half : List Bool → List Bool → List Bool → List Bool → List Bool → Amp
bsixj-half a b c e f = if btri-ok a b c then (if btri-ok a e f then
    (if bin-leb e c then bsixj-c a b c (bin-leb b f) else bsixj-c a f e (bin-leb f b))
  else amp-zero) else amp-zero
