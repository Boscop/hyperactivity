-- Exact Spin–Orbit Landé Splitting & Center-of-Gravity Conservation for ALL orbital l:
-- For j_+ = l + 1/2 (degeneracy 2l + 2):  j_+(j_+ + 1) - l(l+1) - 3/4 = l.
-- For j_- = l - 1/2 (degeneracy 2l):      j_-(j_- + 1) - l(l+1) - 3/4 = -(l + 1).
-- Weighted average shift: (2l + 2)·(l) + (2l)·(-(l + 1)) = 0 identically for EVERY l!
-- Variable (0): l.
phys-so-cog-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
phys-so-cog-poly A ad mu q vs =
  (λ g sub →
    let l = g 0
        q1 = q (fn-q 1 1)
        q2 = q (fn-q 2 1)
        qhalf = q (fn-q 1 2)
        q34 = q (fn-q 3 4)
        jp = ad l qhalf
        jm = sub l qhalf
        ll1 = mu l (ad l q1)
        shift-p = sub (sub (mu jp (ad jp q1)) ll1) q34
        shift-m = sub (sub (mu jm (ad jm q1)) ll1) q34
        deg-p = ad (mu q2 l) q2
        deg-m = mu q2 l
        cog = ad (mu deg-p shift-p) (mu deg-m shift-m)
    in (cog , q (fn-q 0 1)))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
