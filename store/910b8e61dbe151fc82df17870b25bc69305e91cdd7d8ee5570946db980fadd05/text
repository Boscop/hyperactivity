bn-arm64-emit-expr : INetExpr → List Word
bn-arm64-emit-expr (in-lit w)        = bn-arm64-mov64 #0 (bn-w64 w)
bn-arm64-emit-expr in-var0           = bn-u32-le #2852652000
bn-arm64-emit-expr (in-dup-add x)    = list-append (bn-arm64-emit-expr x) (bn-u32-le #2332033024)
bn-arm64-emit-expr (in-add a b) =
  h-concat
    (cons (bn-arm64-emit-expr a)
    (cons (bn-u32-le #4162785248)
    (cons (bn-arm64-emit-expr b)
    (cons (bn-u32-le #4165011425)
    (cons (bn-u32-le #2332033056) nil)))))
bn-arm64-emit-expr (in-xor a b) =
  h-concat
    (cons (bn-arm64-emit-expr a)
    (cons (bn-u32-le #4162785248)
    (cons (bn-arm64-emit-expr b)
    (cons (bn-u32-le #4165011425)
    (cons (bn-u32-le #3388997664) nil)))))
bn-arm64-emit-expr (in-era-l _ live) = bn-arm64-emit-expr live
bn-arm64-emit-expr (in-lut3 m a b c) =
  bn-arm64-mov64 #0 (bn-lut3-w64 m (inet-eval #0 a) (inet-eval #0 b) (inet-eval #0 c))
