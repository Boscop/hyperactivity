kir-lem-and-c : (env : Word → Bool) → (a b : WExpr) → (eq : Bool) → (kir-eq a b ≡ eq) →
  web-andB (weval env a) (weval env b) ≡ weval env (kir-and-c eq a b)
kir-lem-and-c env a b true  h =
  web-trans-b (λ k → web-andB (weval env a) (kir-eq-sound env a b h (~ k))) (web-lem-and-self (weval env a))
kir-lem-and-c env a b false _ = ha-lem-mk-and env a b
