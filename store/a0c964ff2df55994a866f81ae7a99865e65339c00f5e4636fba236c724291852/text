nk-get-do-pick-apart : (e : NkEnv) (i : Word) (out : NkW) (fx : NkFx) (sl : NkSlots) (u : NkW) →
  (nk-emem u e ≡ false) → nk-apart u fx →
  nk-get (nk-do (nk-pick e i out fx) sl) u ≡ nk-get sl u
nk-get-do-pick-apart e i out fx sl u hm ap =
  nk-get-do-apart (nk-pick e i out fx) sl u (nk-pick-apart e i out fx u hm ap)
