-- an atom a bond is incident on is one of the two atoms of its pair
meq-inc-cases : (Q : MolEq) → (i : meq-idx Q) → (a : mol-atoms (meq-mol Q)) → isTrue (meq-inc Q i a) → Sum (a ≡ fst i) (a ≡ fst (snd i))
meq-inc-cases Q i a p =
  case or-cases (meq-eq Q a (fst i)) (meq-eq Q a (fst (snd i))) p of
    inl q → inl (meq-sound Q a (fst i) q)
    inr q → inr (meq-sound Q a (fst (snd i)) q)
