-- Sample one chunk of a Hopf fiber: 9 samples (sub = 8), overlap = 0.04 rad (#400)
hopf-sample-pts : Nat → Word → Word → SInt → SInt → SInt → SInt → SInt → List HPt
hopf-sample-pts zero sub idx cEta sEta t0 dt xi2 = nil
hopf-sample-pts (suc rem) sub idx cEta sEta t0 dt xi2 =
  let xi1 = si-add t0 (si-div-w (si-mul dt (sp idx)) sub)
  in cons (hopf-raw cEta sEta xi1 xi2) (hopf-sample-pts rem sub (%wsucc idx) cEta sEta t0 dt xi2)
