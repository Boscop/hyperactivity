split-bit-eq : (b1 b2 : Bool) → (A B : Nat) → plus (bitn b1) (times 2 A) ≡ plus (bitn b2) (times 2 B) → b1 ≡ b2
split-bit-eq b1 b2 A B e = transB (symB (snd-cong (bhalf (plus (bitn b1) (times 2 A))) (the (Nat × Bool) (A , b1)) (half-of b1 A)))
  (transB (snd-cong (bhalf (plus (bitn b1) (times 2 A))) (bhalf (plus (bitn b2) (times 2 B))) (bhalf-cong (plus (bitn b1) (times 2 A)) (plus (bitn b2) (times 2 B)) e)) (snd-cong (bhalf (plus (bitn b2) (times 2 B))) (the (Nat × Bool) (B , b2)) (half-of b2 B)))
