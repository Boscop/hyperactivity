-- Commutative, associative, idempotent CRDT join across out-of-order multi-cloud socket frames:
sov-merge-target : SovTarget → SovTarget → SovTarget
sov-merge-target (sov-target id1 g1 d1 f1 c1 dr1 lv1) (sov-target _ g2 d2 f2 c2 dr2 lv2) =
  sov-target id1
    (sov-min-w g1 g2)
    (%wor d1 d2)
    (%wor f1 f2)
    (andB c1 c2)
    (sov-max-w dr1 dr2)
    (sov-max-w lv1 lv2)
