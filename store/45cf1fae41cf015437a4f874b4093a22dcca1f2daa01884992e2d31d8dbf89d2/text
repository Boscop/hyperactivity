k-skip-s : (k1 : Nat) → ((p s : List (List Word)) → ltn (lcp p s) k1 ≡ false → plus k1 (lcp (drop-n k1 p) (drop-n k1 s)) ≡ lcp p s) →
           (p s : List (List Word)) → ltn (lcp p s) (suc k1) ≡ false → plus (suc k1) (lcp (drop-n (suc k1) p) (drop-n (suc k1) s)) ≡ lcp p s
k-skip-s k1 ih p s =
  (case p return λ v → ltn (lcp v s) (suc k1) ≡ false → plus (suc k1) (lcp (drop-n (suc k1) v) (drop-n (suc k1) s)) ≡ lcp v s of
     nil → λ h → Empty-rec (true≢false h)
     cons a p1 →
       λ h →
         (case s return λ v → ltn (lcp (cons a p1) v) (suc k1) ≡ false → plus (suc k1) (lcp (drop-n k1 p1) (drop-n (suc k1) v)) ≡ lcp (cons a p1) v of
            nil → λ h → Empty-rec (true≢false h)
            cons b s1 →
              λ h →
                ifP {λ bb → ltn (if bb then suc (lcp p1 s1) else zero) (suc k1) ≡ false → suc (plus k1 (lcp (drop-n k1 p1) (drop-n k1 s1))) ≡ (if bb then suc (lcp p1 s1) else zero)} {tok-eq a b}
                  (λ e h → λ i → suc (ih p1 s1 h i))
                  (λ e h → Empty-rec (true≢false h))
                  h)
         h)
