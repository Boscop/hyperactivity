-- a closed descriptor leaves the table and every interest list
k-del : Word → List (Word × KObj) → List (Word × KObj)
k-del fd nil = nil
k-del fd (cons e r) =
  if %weq (fst e) fd then k-del fd r
  else cons (case snd e of k-pipe-in q → e; k-pipe-out w → e; k-udp b → e; k-epoll l → (fst e , k-epoll (k-forget fd l))) (k-del fd r)
