ribbon-poly-d : List RPt → SInt → List Word
ribbon-poly-d nil extraW = nil
ribbon-poly-d (cons _ nil) extraW = nil
ribbon-poly-d (cons p0 (cons p1 r)) extraW =
  let lr0 = ribbon-offset-pt p0 p0 p1 extraW
      res = ribbon-build-go p0 (cons p1 r) extraW (cons (fst lr0) nil) (cons (snd lr0) nil)
  in closed-poly-d (list-append (fst res) (snd res))
