  function computeWitnessedDTW(xs, ys) {
    const n = xs.length, m = ys.length;
    const dp = Array.from({length:n+1}, () => new Float64Array(m+1).fill(1e12));
    const bt = Array.from({length:n+1}, () => new Uint8Array(m+1));
    dp[0][0] = 0;
    for (let i=1;i<=n;i++) for (let j=1;j<=m;j++) {
      const cost = Math.abs(xs[i-1] - ys[j-1]);
      let best = dp[i-1][j-1], dir = 1;
      if (dp[i-1][j] < best) { best = dp[i-1][j]; dir = 2; }
      if (dp[i][j-1] < best) { best = dp[i][j-1]; dir = 3; }
      dp[i][j] = cost + best; bt[i][j] = dir;
    }
    const path = []; let i = n, j = m;
    while (i > 0 || j > 0) {
      const d = bt[i][j];
      if (d === 1) { path.push({step:'diag', err:xs[i-1]-ys[j-1]}); i--; j--; }
      else if (d === 2) { path.push({step:'right', err:xs[i-1]-ys[Math.max(0,j-1)]}); i--; }
      else { path.push({step:'up', err:xs[Math.max(0,i-1)]-ys[j-1]}); j--; }
    }
    path.reverse();
    return { cost: Math.round(dp[n][m]), path };
  }
