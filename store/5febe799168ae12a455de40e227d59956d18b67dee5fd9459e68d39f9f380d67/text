    const rollFwd = (k, n) => { let q=1, p=0; for(let i=0;i<n;i++){ p -= k*q + 0.04*q*q*q; q += p; } return [q,p]; };
    const rollInv = (k, q, p, n) => { for(let i=0;i<n;i++){ q -= p; p += k*q + 0.04*q*q*q; } return [q,p]; };
    const [tgtQ] = rollFwd(kTgt, 64); let k = kTgt * 0.35; const hist = [];
    for (let it=0;it<36;it++) {
      const [q0] = rollFwd(k,64), [qp] = rollFwd(k+1e-6,64);
      const loss = (q0-tgtQ)*(q0-tgtQ), grad = 2*(q0-tgtQ)*((qp-q0)/1e-6);
