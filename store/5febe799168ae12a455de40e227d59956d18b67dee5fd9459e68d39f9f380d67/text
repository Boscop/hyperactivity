    const secFunc = [3, 2, 1, 0];
    const secExp  = [7, 8, 1, 4, 115, 116, 101, 112, 0, 0];
    const body = [0, ...exprBytes, 0x0b];
    const cPay = [1, ...uleb(body.length), ...body];
