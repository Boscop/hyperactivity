  // ── 48kHz Stereo WAV Export, .MID Export/Import, Bit-Exact Haar & CDF 5/3 Bench ──
  function renderStereoPCM(nFrames) {
    const pcm = new Int16Array(nFrames * 2);
    let q0=0,q1=0,q2=0,q3=0,p0=0,p1=0,p2=0,p3=0;
    const sc = SCALES[state.scale], stepLen = Math.max(1200, Math.round(48000 * 60 / state.bpm / 4));
    const damp = (1 - state.gamma) / (1 + state.gamma);
    for (let i=0;i<nFrames;i++) {
      const st = Math.floor(i / stepLen) & 15, inSt = i % stepLen;
      const ns = curNotes().filter(n => n.step === st);
      const hz = ns.length ? state.rootHz * sc[ns[0].row % sc.length].r : state.rootHz;
      const om = 2 * Math.PI * hz / 48000;
      const kE = Math.min(0.85, om*om*(1 + state.k*2.2)), wE = Math.min(0.45, state.w*(0.2 + om*1.4));
      const f0 = (inSt < 24 && ns.length) ? 0.16 : 0;
      const l0=wE*((q0-q1)+(q0-q3)), l1=wE*((q1-q0)+(q1-q2)), l2=wE*((q2-q1)+(q2-q3)), l3=wE*((q3-q2)+(q3-q0));
      p0 = damp*(p0-(kE*q0+l0+state.alpha*q0*q0*q0-f0)); p1 = damp*(p1-(kE*q1+l1)); p2 = damp*(p2-(kE*q2+l2)); p3 = damp*(p3-(kE*q3+l3));
      q0+=p0; q1+=p1; q2+=p2; q3+=p3;
      const yL = Math.tanh((q0+q2)*0.45), yR = Math.tanh((q1+q3)*0.45);
      pcm[i*2] = Math.max(-32767, Math.min(32767, Math.round(yL*32000)));
      pcm[i*2+1] = Math.max(-32767, Math.min(32767, Math.round(yR*32000)));
    }
    return pcm;
  }
