  }
  document.getElementById('btnGenKey1').onclick = async () => { const g = await genKey(); key1 = g.kp; key1Id = g.id; document.getElementById('statKey').textContent = 'k1:' + key1Id; document.getElementById('warrantLog').textContent = `Local key identity k1 = ${key1Id} (zero server account).`; };
  document.getElementById('btnGenKey2').onclick = async () => { const g = await genKey(); key2 = g.kp; key2Id = g.id; document.getElementById('warrantLog').textContent += `\nCollaborator key k2 = ${key2Id}.`; };
  document.getElementById('btnSignJoint').onclick = async () => {
    if (!key1) await document.getElementById('btnGenKey1').onclick();
    if (!key2) await document.getElementById('btnGenKey2').onclick();
    const cl = new TextEncoder().encode(document.getElementById('casHash').textContent);
    const s1 = await crypto.subtle.sign({ name:'ECDSA', hash:'SHA-256' }, key1.privateKey, cl);
    const s2 = await crypto.subtle.sign({ name:'ECDSA', hash:'SHA-256' }, key2.privateKey, cl);
    const v1 = await crypto.subtle.verify({ name:'ECDSA', hash:'SHA-256' }, key1.publicKey, s1, cl);
    const v2 = await crypto.subtle.verify({ name:'ECDSA', hash:'SHA-256' }, key2.publicKey, s2, cl);
    document.getElementById('warrantLog').textContent =
      `Virtual Joint Agent wp-and(k1:${key1Id}, k2:${key2Id}) on ${document.getElementById('casHash').textContent}:\n` +
      `  Verify(k1) = ${v1} · Verify(k2) = ${v2} -> wp-joint-agent-compose = ${v1 && v2} (associative & symmetric!)`;
  };
  document.getElementById('btnDeleg').onclick = async () => {
    if (!key1) await document.getElementById('btnGenKey1').onclick();
    if (!key2) await document.getElementById('btnGenKey2').onclick();
    const delegMsg = new TextEncoder().encode(`deleg:${key2Id}:scope=drums`);
    const claimMsg = new TextEncoder().encode(`drums:${document.getElementById('casHash').textContent}`);
    const sd = await crypto.subtle.sign({ name:'ECDSA', hash:'SHA-256' }, key1.privateKey, delegMsg);
    const sc = await crypto.subtle.sign({ name:'ECDSA', hash:'SHA-256' }, key2.privateKey, claimMsg);
    const ok1 = await crypto.subtle.verify({ name:'ECDSA', hash:'SHA-256' }, key1.publicKey, sd, delegMsg);
    const ok2 = await crypto.subtle.verify({ name:'ECDSA', hash:'SHA-256' }, key2.publicKey, sc, claimMsg);
    document.getElementById('warrantLog').textContent =
      `Attenuated Capability Delegation wp-deleg(k1:${key1Id} → k2:${key2Id}, scope=drums):\n` +
      `  Issuer signed delegation = ${ok1} · Delegate signed in-scope claim = ${ok2} -> wp-deleg-sound = ${ok1 && ok2}`;
  };
  document.getElementById('btnPrivEnc').onclick = async () => {
    const aesKey = await crypto.subtle.generateKey({ name:'AES-GCM', length:256 }, true, ['encrypt','decrypt']);
    const iv = crypto.getRandomValues(new Uint8Array(12));
    const plain = new TextEncoder().encode(JSON.stringify(curNotes()));
    const ct = await crypto.subtle.encrypt({ name:'AES-GCM', iv }, aesKey, plain);
    const dec = await crypto.subtle.decrypt({ name:'AES-GCM', iv }, aesKey, ct);
    const ctHash = (await sha256Hex(new Uint8Array(ct))).slice(0, 16);
    const ok = new TextDecoder().decode(dec) === JSON.stringify(curNotes());
    document.getElementById('warrantLog').textContent =
      `Key-Gated Private Stem (AES-256-GCM over CAS):\n  Ciphertext SHA-256: ${ctHash}... (${ct.byteLength} B)\n  Authorized key decrypt round-trip = ${ok}`;
  };
  document.getElementById('btnChallenge').onclick = async () => {
    if (!key1) await document.getElementById('btnGenKey1').onclick();
    const nonce = crypto.getRandomValues(new Uint8Array(16));
    const sig = await crypto.subtle.sign({ name:'ECDSA', hash:'SHA-256' }, key1.privateKey, nonce);
    const ok = await crypto.subtle.verify({ name:'ECDSA', hash:'SHA-256' }, key1.publicKey, sig, nonce);
    document.getElementById('warrantLog').textContent = `Challenge-Response (wp-challenge-ok) on 128-bit nonce -> Key k1:${key1Id} Verify = ${ok}`;
  };

  // ── Visualizers & Animation Loop ──
  function drawPoly() {
    const c = document.getElementById('polyCanvas'), g = c.getContext('2d');
    const dark = document.documentElement.classList.contains('dark');
    g.clearRect(0, 0, c.width, c.height);
    const ring = (cx, cy, R, k, n, col) => {
      const pat = euclid(k, n), pts = [];
      g.strokeStyle = dark ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.2)';
      g.beginPath(); g.arc(cx, cy, R, 0, Math.PI*2); g.stroke();
      for (let i=0;i<n;i++) {
        const a = -Math.PI/2 + (i/n)*Math.PI*2, x = cx+Math.cos(a)*R, y = cy+Math.sin(a)*R;
        if (pat[i]) pts.push([x,y]);
        g.fillStyle = pat[i] ? col : (dark ? '#444' : '#ccc');
        g.beginPath(); g.arc(x, y, pat[i]?5:2.8, 0, Math.PI*2); g.fill();
      }
      if (pts.length > 1) { g.strokeStyle = col; g.lineWidth = 1.5; g.beginPath(); pts.forEach(([x,y],i)=>i?g.lineTo(x,y):g.moveTo(x,y)); g.closePath(); g.stroke(); }
      g.fillStyle = dark ? '#fff' : '#000'; g.font = '700 11px monospace'; g.fillText(`E(${k},${n})`, cx-20, cy+4);
    };
    ring(140, 70, 52, parseInt(document.getElementById('eucK1').value)||3, parseInt(document.getElementById('eucN1').value)||8, '#ff0a94');
    ring(390, 70, 52, parseInt(document.getElementById('eucK2').value)||5, parseInt(document.getElementById('eucN2').value)||12, '#1a73e8');
  }
  function drawWavelet(s, d) {
    const c = document.getElementById('waveletCanvas'), g = c.getContext('2d');
    g.clearRect(0, 0, c.width, c.height);
    const dr = (arr, y0, col) => { g.strokeStyle = col; g.beginPath(); const st = Math.max(1, Math.floor(arr.length/c.width)); for(let x=0;x<c.width;x++){ const y = y0 - ((arr[x*st]||0)/32768)*26; if(x===0)g.moveTo(x,y);else g.lineTo(x,y); } g.stroke(); };
    dr(s, 34, '#1a73e8'); dr(d, 94, '#ff0a94');
  }
  function drawDtw(path) {
    const c = document.getElementById('dtwCanvas'), g = c.getContext('2d');
    g.clearRect(0, 0, c.width, c.height);
    const bw = Math.max(12, Math.floor((c.width-20)/Math.max(1,path.length))-4);
    g.strokeStyle = '#888'; g.beginPath(); g.moveTo(0,95); g.lineTo(c.width,95); g.stroke();
    path.forEach((p, idx) => { const h = Math.max(-80, Math.min(80, p.err*1.4)); g.fillStyle = p.err>=0?'#1a73e8':'#ff0a94'; g.fillRect(10+idx*(bw+4), h>=0?95-h:95, bw, Math.abs(h)+2); });
  }
  function drawInv(hist) {
    const c = document.getElementById('invCanvas'), g = c.getContext('2d');
    g.clearRect(0, 0, c.width, c.height);
    const maxL = Math.max(1e-6, ...hist.map(x=>x.loss));
    g.strokeStyle = '#ff0a94'; g.lineWidth = 2; g.beginPath();
    hist.forEach((x,i)=>{ const px=(i/Math.max(1,hist.length-1))*(c.width-20)+10, py=c.height-15-(x.loss/maxL)*(c.height-30); if(i===0)g.moveTo(px,py);else g.lineTo(px,py); });
    g.stroke();
  }
  function anim() {
    const sc = document.getElementById('scopeCanvas'), sg = sc.getContext('2d');
    sg.clearRect(0, 0, sc.width, sc.height); sg.strokeStyle = '#ff0a94'; sg.lineWidth = 1.6; sg.beginPath();
    for (let i=0;i<lastScope.length;i++) { const x=(i/255)*sc.width, y=sc.height/2 - lastScope[i]*(sc.height*0.42); if(i===0)sg.moveTo(x,y);else sg.lineTo(x,y); }
    sg.stroke();
    const mc = document.getElementById('meshCanvas'), mg = mc.getContext('2d');
    mg.clearRect(0, 0, mc.width, mc.height);
    const cw = mc.width/4, ch = mc.height/4, dark = document.documentElement.classList.contains('dark');
    for (let r=0;r<4;r++) for (let col=0;col<4;col++) {
      const idx = r*4+col, v = lastQ[idx] || 0, mag = Math.min(1, Math.abs(v)*1.4);
      mg.fillStyle = v>=0 ? `rgba(255,10,148,${0.08+mag*0.75})` : `rgba(26,115,232,${0.08+mag*0.75})`;
      mg.fillRect(col*cw+4, r*ch+4, cw-8, ch-8);
      mg.strokeStyle = 'rgba(128,128,128,0.38)'; mg.strokeRect(col*cw+4, r*ch+4, cw-8, ch-8);
      mg.fillStyle = dark ? '#fff' : '#000'; mg.font = '600 10.5px monospace';
      mg.fillText(`v${idx} q=${v.toFixed(2)}`, col*cw+10, r*ch+22);
    }
    if (document.getElementById('p3').classList.contains('active')) drawEq();
    if (sightActive) drawSight();
    requestAnimationFrame(anim);
  }

  renderStemDeck(); renderChops(); renderPads(); renderJamDag(); renderPlugins(); renderArrTracks();
  drawChain(); drawPoly(); drawPiano(); drawAuto(); drawEq(); drawSight();
  syncCodeFromState(); snapCas('init'); anim();
})();
</script>
