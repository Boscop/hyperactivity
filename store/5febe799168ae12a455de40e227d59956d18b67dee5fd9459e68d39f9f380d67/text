  // ── Partition-of-Unity 4-Stem Audio Separator (Bass + Harmony + Drums + Space === Original) ──
  let extDeckOn = false;
  function separateFourStems(audioBuf) {
    const L = audioBuf.getChannelData(0);
    const R = audioBuf.numberOfChannels > 1 ? audioBuf.getChannelData(1) : L;
    const N = Math.min(L.length, 48000 * 30);
    const mid = new Float32Array(N), side = new Float32Array(N);
    for (let i=0;i<N;i++) { mid[i] = 0.5*(L[i]+R[i]); side[i] = 0.5*(L[i]-R[i]); }
    // Zero-phase forward+backward 2nd-order Linkwitz-Riley lowpass at 180Hz -> Bass stem
    const aLp = 1 - Math.exp(-2 * Math.PI * 180 / (audioBuf.sampleRate || 48000));
    const bass = new Float32Array(N);
    let y = 0; for (let i=0;i<N;i++) { y += aLp * (mid[i] - y); bass[i] = y; }
    y = 0; for (let i=N-1;i>=0;i--) { y += aLp * (bass[i] - y); bass[i] = y; }
    // Percussive/transient detector (fast vs slow RMS ratio on mid residual) -> Drums stem
    const drums = new Float32Array(N), harm = new Float32Array(N), space = new Float32Array(N);
    let fast = 0, slow = 0, hpY = 0;
    const aHp = 1 - Math.exp(-2 * Math.PI * 4500 / (audioBuf.sampleRate || 48000));
    for (let i=0;i<N;i++) {
      const rem = mid[i] - bass[i];
      const e = rem * rem;
      fast = fast * 0.92 + e * 0.08;
      slow = slow * 0.996 + e * 0.004;
      const pMask = Math.min(1, Math.max(0, (fast - slow * 1.45) / (fast + slow + 1e-7)));
      drums[i] = rem * pMask;
      const hRem = rem - drums[i];
      hpY += aHp * (hRem - hpY);
      const air = hRem - hpY;
      harm[i] = hpY;
      // Exact partition of unity: bass + harm + drums + space === mid + side === L!
      space[i] = air + side[i];
    }
    return [bass, harm, drums, space];
  }
