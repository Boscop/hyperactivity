<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hyperactive DAW 1.0 · First-Principles Sound, Stem Player &amp; Live Jam Graph</title>
<style>
:root {
  --bg: #ffffff; --bg2: #f6f6f8; --bg3: #ececef; --ink: #000000; --muted: #555555;
  --line: rgba(0,0,0,0.15); --line-strong: #000000;
  --pink: #ff0a94; --blue: #1a73e8; --green: #0a8f5c; --amber: #d97706;
  --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
}
html.dark {
  --bg: #050507; --bg2: #0d0d11; --bg3: #16161c; --ink: #ffffff; --muted: #a1a1aa;
  --line: rgba(255,255,255,0.16); --line-strong: #ffffff;
  --pink: #ff0a94; --blue: #4da3ff; --green: #22c55e; --amber: #fbbf24;
}
* { box-sizing: border-box; }
html, body {
  margin: 0; background: var(--bg); color: var(--ink);
  font: 14px/1.5 -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}
::selection { background: var(--pink); color: #fff; }
a { color: inherit; text-decoration: underline; text-decoration-color: var(--pink); }
.wrap { max-width: 1420px; margin: 0 auto; padding: 16px 18px 80px; }
.topbar {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px;
  border-bottom: 1.5px solid var(--line-strong); padding-bottom: 10px; margin-bottom: 12px;
}
.kicker { font: 700 10.5px/1.2 var(--mono); color: var(--pink); letter-spacing: 0.08em; text-transform: uppercase; }
h1 { margin: 0; font-size: clamp(20px, 2.4vw, 27px); font-weight: 800; letter-spacing: -0.025em; }
.transport { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font: 600 11.5px/1 var(--mono); }
button, select, input[type="text"], input[type="number"] {
  font: 600 11.5px/1.2 var(--mono); color: var(--ink); background: var(--bg);
  border: 1px solid var(--line-strong); padding: 5px 9px; cursor: pointer; border-radius: 0;
}
button:hover { border-color: var(--pink); color: var(--pink); }
button.primary { background: var(--pink); color: #fff; border-color: var(--pink); }
button.primary:hover { opacity: 0.88; color: #fff; }
button.active { background: var(--ink); color: var(--bg); }
button.ok { border-color: var(--green); color: var(--green); }
button.sm { padding: 3px 7px; font-size: 10.5px; }
.pillbar { display: flex; flex-wrap: wrap; gap: 6px; font: 500 11px/1.3 var(--mono); margin-bottom: 12px; }
.pill { border: 1px solid var(--line); padding: 3px 8px; background: var(--bg2); }
.tabs { display: flex; flex-wrap: wrap; gap: 0; border-bottom: 1px solid var(--line); margin-bottom: 14px; }
.tab {
  border: 1px solid var(--line); border-bottom: none; padding: 8px 13px;
  font: 700 11.5px/1.2 var(--mono); background: var(--bg2); color: var(--muted);
}
.tab.active { background: var(--bg); color: var(--ink); border-color: var(--line-strong); border-top: 2.5px solid var(--pink); }
.pane { display: none; }
.pane.active { display: block; }
.grid2 { display: grid; grid-template-columns: 1.25fr 1fr; gap: 14px; }
.gridEq { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
@media (max-width: 980px) { .grid2, .gridEq { grid-template-columns: 1fr; } }
.card { border: 1px solid var(--line); background: var(--bg2); padding: 13px; margin-bottom: 14px; }
.card h2 {
  margin: 0 0 9px; font: 700 11.5px/1.2 var(--mono); text-transform: uppercase;
  letter-spacing: 0.06em; color: var(--pink); display: flex; justify-content: space-between; align-items: center; gap: 8px;
}
.row { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin-bottom: 9px; }
.kv { font: 500 11px/1.4 var(--mono); color: var(--muted); }
.kv b { color: var(--ink); }
.g { color: var(--green); } .p { color: var(--pink); } .b { color: var(--blue); } .a { color: var(--amber); }
.slider-row { display: grid; grid-template-columns: 118px 1fr 68px; align-items: center; gap: 8px; margin: 5px 0; font: 500 11px/1.2 var(--mono); }
input[type="range"] { width: 100%; accent-color: var(--pink); }
canvas { display: block; width: 100%; border: 1px solid var(--line); background: var(--bg); }
textarea {
  width: 100%; min-height: 210px; font: 500 11.5px/1.48 var(--mono);
  background: var(--bg); color: var(--ink); border: 1px solid var(--line-strong); padding: 9px;
}
.mono-box {
  font: 500 11px/1.45 var(--mono); background: var(--bg); border: 1px solid var(--line);
  padding: 8px 10px; max-height: 175px; overflow: auto; white-space: pre-wrap;
}
/* Kano / Ye Stem Player Deck */
.stem-deck { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 10px; }
.stem-col {
  border: 1.5px solid var(--line-strong); background: var(--bg); padding: 10px 8px; text-align: center;
  display: flex; flex-direction: column; align-items: center; gap: 6px;
}
.stem-title { font: 800 11px/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; }
.led-track {
  position: relative; width: 34px; height: 142px; background: var(--bg3); border: 1px solid var(--line-strong);
  cursor: ns-resize; overflow: hidden; user-select: none; touch-action: none;
}
.led-fill { position: absolute; bottom: 0; left: 0; right: 0; transition: height 0.03s; }
.led-segs {
  position: absolute; inset: 0; pointer-events: none;
  background: repeating-linear-gradient(to top, transparent 0px, transparent 8px, var(--bg) 8px, var(--bg) 11px);
}
.chop-grid { display: grid; grid-template-columns: repeat(8, 1fr); gap: 5px; margin-top: 8px; }
.chop-pad {
  border: 1px solid var(--line-strong); background: var(--bg); padding: 9px 4px;
  font: 700 10.5px/1.15 var(--mono); text-align: center; cursor: pointer; user-select: none;
}
.chop-pad.has { border-color: var(--pink); }
.chop-pad:active, .chop-pad.lit { background: var(--pink); color: #fff; }
.tonnetz { display: grid; grid-template-columns: repeat(6, 1fr); gap: 5px; }
.pad {
  border: 1px solid var(--line-strong); padding: 9px 5px; text-align: center;
  font: 700 11.5px/1.15 var(--mono); background: var(--bg); user-select: none;
}
.pad:active, .pad.lit { background: var(--pink); color: #fff; border-color: var(--pink); }
.pad small { display: block; font-weight: 500; font-size: 9.5px; opacity: 0.72; margin-top: 2px; }
.ch-row {
  display: grid; grid-template-columns: 24px 1fr 112px 64px 96px; align-items: center; gap: 6px;
  padding: 6px 8px; border: 1px solid var(--line); background: var(--bg); margin-bottom: 5px;
  font: 500 11px/1.25 var(--mono);
}
.ch-row.active { border-color: var(--pink); }
.badge { display: inline-block; padding: 2px 5px; font: 700 9.5px/1.2 var(--mono); border: 1px solid var(--line-strong); }
.badge.open { border-color: var(--green); color: var(--green); }
.badge.joint { border-color: var(--pink); color: var(--pink); }
.badge.key { border-color: var(--blue); color: var(--blue); }
.plug-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; margin-bottom: 8px; }
.plug-btn { text-align: left; padding: 7px 9px; font-size: 11px; }
.plug-btn small { display: block; font-weight: 400; color: var(--muted); font-size: 10px; margin-top: 2px; }
.meter-bar { height: 10px; background: var(--bg3); border: 1px solid var(--line); overflow: hidden; flex: 1; min-width: 80px; }
.meter-fill { height: 100%; width: 0%; background: var(--green); transition: width 0.04s; }
</style>
</head>
<body>
<div class="wrap">
  <div class="topbar">
    <div>
      <div class="kicker">hyperactivity 1.0 · sound/time · sound/wave · sound/graph · 0 postulates · zero vst</div>
      <h1>Hyperactive DAW</h1>
    </div>
    <div class="transport">
      <button id="btnAudio" class="primary">Start 48kHz Engine</button>
      <button id="btnPlay">Play</button>
      <button id="btnMic">Mic: OFF</button>
      <button id="btnMidi">MIDI/MPE: --</button>
      <button id="btnUndo" title="Undo (Cmd+Z)">↩</button>
      <button id="btnRedo" title="Redo (Cmd+Shift+Z)">↪</button>
      <label class="kv">BPM <input id="bpmIn" type="number" value="116" min="40" max="240" style="width:58px"></label>
      <div style="display:flex;align-items:center;gap:5px;width:130px">
        <span class="kv">OUT</span>
        <div class="meter-bar"><div id="outMeter" class="meter-fill"></div></div>
      </div>
      <button id="btnTheme">Theme</button>
      <a href="/kg?mod=sound/wave.hypercubical" style="font:700 11px var(--mono)">/kg</a>
    </div>
  </div>

  <div class="pillbar">
    <span class="pill">CAS Root: <b id="casHash">sha256:init</b></span>
    <span class="pill">Hamiltonian E: <b id="statE">0.000</b> (<span class="g" id="statPass">PASSIVE</span>)</span>
    <span class="pill">Tape: <b id="statTape">LIVE 1.00×</b></span>
    <span class="pill">WASM DSP: <b id="statWasm">0 live</b></span>
    <span class="pill">HXW2 Codec: <b id="statRatio">1.48× (20×RT)</b></span>
    <span class="pill">Room: <b id="statRoom">hyper-jam-01</b> (<b id="statPeers">1</b> peers)</span>
    <span class="pill">Key: <b id="statKey">wp-open (transparent)</b></span>
  </div>

  <div class="tabs">
    <button class="tab active" data-pane="p1">1 · Stem Player, Chops &amp; Play Surface</button>
    <button class="tab" data-pane="p2">2 · Piano Roll, Scenes &amp; ? Intelligence</button>
    <button class="tab" data-pane="p3">3 · Pro Mix Rack (EQ · Comp · Space · Synth)</button>
    <button class="tab" data-pane="p4">4 · Physical Wave Mesh &amp; Zero-Tape Inverse</button>
    <button class="tab" data-pane="p5">5 · Russian-Method Sight-Play &amp; DTW Battle</button>
    <button class="tab" data-pane="p6">6 · .hypercubical Plugins, WASM, P2P &amp; Warrants</button>
  </div>

  <!-- TAB 1: KANO STEM PLAYER + SAMPLE CHAIN + HARMONIC PAD + LIVE JAM DAG -->
  <div id="p1" class="pane active">
    <div class="grid2">
      <div>
        <div class="card" id="stemDropZone">
          <h2>Kano / Ye Stem Player Deck · Live Loop, 4-Stem Audio Split, Reverse &amp; Chop
            <span class="kv">Drag sliders · Double-click Isolate · Drop .wav/.mp3/.flac</span>
          </h2>
          <div class="stem-deck" id="stemDeck"></div>
          <div class="row">
            <button id="btnLoopCap" class="primary">Capture 2-Bar Loop</button>
            <button id="btnLoopDiv">÷2 Stutter</button>
            <button id="btnLoopMul">×2 Expand</button>
            <button id="btnReverse">Reverse (Verlet Inv)</button>
            <button id="btnChopLive" class="ok">Chop → 8 CAS Pads</button>
            <label class="badge" style="cursor:pointer">Drop Audio → 4-Stem Split <input id="chopWavIn" type="file" accept=".wav,.mp3,.flac,.ogg,.m4a,audio/*" style="display:none"></label>
            <button id="btnExtToggle" class="sm">Deck: Synth</button>
          </div>
          <div class="kv" id="extDeckStat" style="margin-bottom:4px">Partition-of-unity 4-stem separator ready (<code>Bass + Harmony + Drums + Space ≡ Original</code>).</div>
          <div class="slider-row"><span>Tape Speed</span><input id="slSpeed" type="range" min="-2.0" max="2.0" step="0.05" value="1.0"><span id="vSpeed">1.00×</span></div>
          <div class="kv">Playable SHA-256 Chop Pads (keys 1–8 · every chop records upstream Sample Chain edge):</div>
          <div class="chop-grid" id="chopGrid"></div>
        </div>

        <div class="card">
          <h2>Stern-Brocot &amp; Microtonal Harmonic Field <span class="kv">Keys: A–L / W–P · 8-Voice Polyphonic</span></h2>
          <div class="row">
            <select id="scaleSel">
              <option value="just">Just Intonation (Stern-Brocot 5-Limit)</option>
              <option value="12tet">12-TET (Equal Temperament)</option>
              <option value="19edo">19-EDO (Super-Consonant Meantone)</option>
              <option value="22shruti">Indian 22-Shruti (Pure Ratios)</option>
              <option value="bohlen">Bohlen-Pierce (3:1 Tritave)</option>
              <option value="maqam">Maqam Rast (Quarter-Tone)</option>
              <option value="harmonic">Natural Harmonic Overtones (1..12)</option>
            </select>
            <label class="kv">Root Hz <input id="rootHz" type="number" value="220" min="55" max="880" style="width:66px"></label>
            <button id="btnPlrP">Tonnetz P</button>
            <button id="btnPlrL">Tonnetz L</button>
            <button id="btnPlrR">Tonnetz R</button>
          </div>
          <div id="padGrid" class="tonnetz"></div>
          <div class="kv" style="margin-top:6px" id="scaleInfo">Active triad: <b>C maj</b> · Proved involutions: <code>tonnetz-P/L/R-inv</code> · Farey consonance width 1/(p·q).</div>
        </div>
      </div>

      <div>
        <div class="card">
          <h2>Sample Chain &amp; Provenance Graph (Indra's Net · Zero-Decay Upstream Credit)</h2>
          <canvas id="chainCanvas" width="540" height="215"></canvas>
          <div class="row" style="margin-top:7px">
            <button id="btnTipChain" class="primary">Tip Downstream Remix (+10 cr)</button>
            <button id="btnRemixChain">+ Fork New Remix Node</button>
            <span class="kv" id="chainStat">Total conserved: <b>100 cr</b> (<code>sample-chain-credit-conserved</code>)</span>
          </div>
        </div>

        <div class="card">
          <h2>Perpetually Live Branching Jam DAG (Coherent Cones · WebRTC + BroadcastChannel)</h2>
          <div class="row">
            <input id="roomIn" type="text" value="hyper-jam-01" style="width:130px">
            <button id="btnJoinRoom" class="ok">Join / Sync Room</button>
            <button id="btnForkBranch">+ Fork Live Branch</button>
          </div>
          <div id="jamDagList"></div>
          <div class="kv" id="creditLog">Cone coherent: <b class="g">true</b> · Open peers pull/remix directly via CAS set union.</div>
        </div>

        <div class="card">
          <h2>Euclidean Polyrhythm Wheel (lib/resonance balance-canonical)</h2>
          <div class="row">
            <span class="kv">A:</span><input id="eucK1" type="number" value="3" min="1" max="16" style="width:46px"><input id="eucN1" type="number" value="8" min="2" max="16" style="width:46px">
            <span class="kv">B:</span><input id="eucK2" type="number" value="5" min="1" max="16" style="width:46px"><input id="eucN2" type="number" value="12" min="2" max="16" style="width:46px">
            <button id="btnApplyEuc">Apply to Piano Roll</button>
          </div>
          <canvas id="polyCanvas" width="540" height="140"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB 2: MULTI-BAR PIANO ROLL, SCENES, AUTOMATION & ? INTELLIGENCE -->
  <div id="p2" class="pane">
    <div class="card">
      <h2>Scale-Snapped Interactive Piano Roll · 4 Scenes · Typed-Hole (?) Compositional Intelligence
        <span class="kv">Left-click/drag: paint · Right-click: erase · Adapts live to active microtonal scale</span>
      </h2>
      <div class="row">
        <span class="kv">Scene:</span>
        <button class="sm active scene-btn" data-sc="0">A · Intro</button>
        <button class="sm scene-btn" data-sc="1">B · Lift</button>
        <button class="sm scene-btn" data-sc="2">C · Drop</button>
        <button class="sm scene-btn" data-sc="3">D · Bridge</button>
        <span class="kv" style="margin-left:8px">Stem:</span>
        <select id="prStemSel">
          <option value="1">Stem 2 · Poly Harmony</option>
          <option value="0">Stem 1 · Sub/Bass String</option>
          <option value="2">Stem 3 · 2D Drums</option>
        </select>
        <button id="btnHoleBass" class="ok">? Fill Bassline</button>
        <button id="btnHoleCounter" class="ok">? Counter-Melody</button>
        <button id="btnHoleTonnetz" class="ok">? Tonnetz Prog</button>
        <button id="btnHoleDrums" class="ok">? Euclidean Drums</button>
        <button id="btnClearRoll">Clear Scene</button>
      </div>
      <canvas id="pianoCanvas" width="1320" height="310"></canvas>
      <div class="kv" style="margin:6px 0 4px">Continuous Parameter Automation Lane (uncoarsened <code>ge-param</code> curve — drag to draw Cutoff / Stiffness k):</div>
      <canvas id="autoCanvas" width="1320" height="74"></canvas>
      <div class="row" style="margin-top:10px">
        <button id="btnExportWav" class="primary">Export 48kHz Stereo WAV (4s)</button>
        <button id="btnExportStems" class="ok">Export 4 Isolated Stems (.wav)</button>
        <button id="btnExportMid">Export .MID</button>
        <label class="badge" style="cursor:pointer">Import .WAV / .MID <input id="fileIn" type="file" accept=".wav,.mp3,.flac,.mid,.midi" style="display:none"></label>
        <button id="btnWaveletBench">Verify Bit-Exact Haar+CDF5/3 Wavelet &amp; Compression</button>
      </div>
      <div id="ioLog" class="mono-box">Ready. Piano roll notes synthesize live across all 4 stems and export bit-exact 48kHz Stereo PCM WAV, isolated stems, or Standard MIDI (.mid).</div>
    </div>

    <div class="card">
      <h2>N-Track Arrangement Timeline (Bars 1–16) &amp; Sample-Accurate DAG Sidechain Router
        <span class="kv">Click cells to cycle Scene A/B/C/D clips · Sidechain runs inside 48kHz AudioWorklet</span>
      </h2>
      <div class="row">
        <button id="btnAddTrack" class="primary">+ Add Track</button>
        <button id="btnArrMode">Arrangement Mode: OFF (Loop Scene)</button>
        <span class="kv" id="arrBarStat">Bar: <b>1 / 16</b> · Active sidechain edges: <b id="scEdgeCount">1</b> (Drums → Bass)</span>
      </div>
      <div id="arrTracks" style="display:flex;flex-direction:column;gap:6px;margin-top:6px"></div>
    </div>
  </div>

  <!-- TAB 3: PRO MIX RACK (FABFILTER PRO-Q3 / PRO-C2 / VALHALLA / SERUM UNISON) -->
  <div id="p3" class="pane">
    <div class="gridEq">
      <div class="card">
        <h2>4-Band Parametric EQ + Live FFT Analyzer (Pro-Q3 Class)</h2>
        <canvas id="eqCanvas" width="640" height="220"></canvas>
        <div class="slider-row"><span>Low Shelf 90Hz</span><input id="eq0" type="range" min="-15" max="15" step="0.5" value="2.0"><span id="veq0">+2.0 dB</span></div>
        <div class="slider-row"><span>Mid Bell 450Hz</span><input id="eq1" type="range" min="-15" max="15" step="0.5" value="-1.5"><span id="veq1">-1.5 dB</span></div>
        <div class="slider-row"><span>Pres Bell 2.4kHz</span><input id="eq2" type="range" min="-15" max="15" step="0.5" value="2.5"><span id="veq2">+2.5 dB</span></div>
        <div class="slider-row"><span>Air Shelf 8.5kHz</span><input id="eq3" type="range" min="-15" max="15" step="0.5" value="3.0"><span id="veq3">+3.0 dB</span></div>
      </div>

      <div class="card">
        <h2>Master Dynamics Compressor, Saturation &amp; Stereo Space (Pro-C2 / Valhalla Class)</h2>
        <div class="slider-row"><span>Comp Thresh</span><input id="cThr" type="range" min="-36" max="0" step="1" value="-14"><span id="vcThr">-14 dB</span></div>
        <div class="slider-row"><span>Comp Ratio</span><input id="cRat" type="range" min="1" max="12" step="0.5" value="3.5"><span id="vcRat">3.5:1</span></div>
        <div class="slider-row"><span>Analog Drive α</span><input id="slA" type="range" min="0.00" max="0.60" step="0.01" value="0.08"><span id="vA">0.08</span></div>
        <div class="slider-row"><span>Hadamard Space</span><input id="slSpace" type="range" min="0.00" max="0.95" step="0.01" value="0.32"><span id="vSpace">0.32</span></div>
        <div class="slider-row"><span>Ping-Pong Delay</span><input id="slDly" type="range" min="0.00" max="0.75" step="0.01" value="0.22"><span id="vDly">0.22</span></div>
        <div class="row" style="margin-top:8px">
          <span class="kv">Gain Reduction:</span>
          <div class="meter-bar"><div id="grMeter" class="meter-fill" style="background:var(--pink)"></div></div>
          <span class="kv" id="grVal">0.0 dB</span>
        </div>
        <canvas id="scopeCanvas" width="640" height="120" style="margin-top:8px"></canvas>
      </div>
    </div>

    <div class="card">
      <h2>8-Voice Polyphonic Physical / Unison Synth &amp; Modulation Matrix (Serum / Physical Class)</h2>
      <div class="gridEq">
        <div>
          <div class="row">
            <select id="topoSel">
              <option value="string">1D Chain (Plucked / Bowed String)</option>
              <option value="plate">2D 4×4 Mesh (Drumhead / Plate · HyperNet-16)</option>
              <option value="room">3D Coupled Chamber (Physical Cathedral)</option>
              <option value="fhn">Nonlinear FHN / Duffing Analog Synth</option>
              <option value="petersen">Non-Euclidean Petersen Graph (Impossible Gong)</option>
            </select>
            <select id="excSel">
              <option value="pluck">Pluck (Displacement)</option>
              <option value="hammer">Piano Hammer (Momentum)</option>
              <option value="bow">Bowed Stick-Slip</option>
              <option value="reed">Brass / Reed Valve</option>
            </select>
          </div>
          <div class="slider-row"><span>Stiffness k</span><input id="slK" type="range" min="0.02" max="0.85" step="0.005" value="0.24"><span id="vK">0.240</span></div>
          <div class="slider-row"><span>Coupling w</span><input id="slW" type="range" min="0.00" max="0.48" step="0.005" value="0.22"><span id="vW">0.220</span></div>
          <div class="slider-row"><span>Damping γ</span><input id="slG" type="range" min="0.0002" max="0.04" step="0.0002" value="0.0022"><span id="vG">0.0022</span></div>
        </div>
        <div>
