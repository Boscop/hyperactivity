  function drawEq() {
    const c = document.getElementById('eqCanvas'), g = c.getContext('2d');
    const dark = document.documentElement.classList.contains('dark');
    g.clearRect(0, 0, c.width, c.height);
    // Live FFT analyzer behind EQ curve
    if (analyser) {
      const bins = new Uint8Array(analyser.frequencyBinCount);
      analyser.getByteFrequencyData(bins);
      g.fillStyle = 'rgba(26,115,232,0.22)';
      g.beginPath(); g.moveTo(0, c.height);
      for (let i=0;i<bins.length;i++) {
        const x = (Math.log2(i + 1) / Math.log2(bins.length)) * c.width;
        const y = c.height - (bins[i] / 255) * (c.height - 20);
        g.lineTo(x, y);
      }
      g.lineTo(c.width, c.height); g.closePath(); g.fill();
    }
    // 0 dB center line
    g.strokeStyle = dark ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.2)';
    g.beginPath(); g.moveTo(0, c.height/2); g.lineTo(c.width, c.height/2); g.stroke();
    // Parametric EQ curve
    const bandX = [0.14, 0.38, 0.66, 0.88];
    g.strokeStyle = '#ff0a94'; g.lineWidth = 2.4; g.beginPath();
    for (let px=0; px<c.width; px++) {
      const u = px / c.width;
      let db = 0;
      state.eq.forEach((gain, bi) => {
        const d = u - bandX[bi];
        if (bi === 0) db += gain / (1 + Math.exp((u - 0.22) * 14));
        else if (bi === 3) db += gain / (1 + Math.exp((0.78 - u) * 14));
        else db += gain * Math.exp(-(d * d) / 0.018);
      });
      const y = c.height / 2 - db * 5.2;
      if (px === 0) g.moveTo(px, y); else g.lineTo(px, y);
    }
    g.stroke();
  }
