    const toks = src.replace(/\(/g, ' ( ').replace(/\)/g, ' ) ').trim().split(/\s+/).filter(Boolean);
    let pos = 0;
    const f32Bytes = (v) => { const b = new ArrayBuffer(4); new DataView(b).setFloat32(0, v, true); return Array.from(new Uint8Array(b)); };
    const uleb = (n) => { const out = []; do { let b = n & 127; n >>>= 7; if (n) b |= 128; out.push(b); } while (n); return out; };
    const parse = () => {
      if (pos >= toks.length) throw new Error('Unexpected EOF in DspExpr');
      let t = toks[pos++];
      if (t === '(') { const r = parse(); if (toks[pos] === ')') pos++; return r; }
      if (t === 'in' || t === 'd-in') return [0x20, 0];
      if (t === 'sc' || t === 'd-sc') return [0x20, 1];
      if (t === 'p1' || t === 'd-p1') return [0x20, 2];
      if (t === 'p2' || t === 'd-p2') return [0x20, 3];
      if (t === 'st' || t === 'd-st') return [0x20, 4];
      const ops2 = { add:0x92, 'd-add':0x92, sub:0x93, 'd-sub':0x93, mul:0x94, 'd-mul':0x94, div:0x95, 'd-div':0x95, min:0x96, 'd-min':0x96, max:0x97, 'd-max':0x97 };
      const ops1 = { abs:0x8b, 'd-abs':0x8b, neg:0x8c, 'd-neg':0x8c };
      if (ops2[t]) { const a = parse(), b = parse(); return [...a, ...b, ops2[t]]; }
      if (ops1[t]) { const a = parse(); return [...a, ops1[t]]; }
      const num = parseFloat(t);
      if (Number.isFinite(num)) return [0x43, ...f32Bytes(num)];
      throw new Error('Unknown DspExpr token: ' + t);
    };
