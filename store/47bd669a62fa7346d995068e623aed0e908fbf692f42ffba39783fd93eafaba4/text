-- a stuck transport in a data type: the lines of its parameters along the telescope, its element
q-trans bs d psi ls x =
  let i = %dim
      bs2 = lcons (qd i) bs
  in obind (q-fields bs2 (dtel (%dent d)) (lmap (λ l → l @ i) ls))
       (λ cls →
          obind (quote bs (mkdata d (lmap (λ l → l @ 0) ls)) x)
            (λ cx →
               some
                 (ctrans d (q-face bs psi) (lmap cplam cls) cx , mkdata d (lmap (λ l → l @ 1) ls))))
