-- Shared-fanout 6-NAND2 netlist for ISCAS-85 c17 (n=5 inputs, k=4 shared internal wires + 2 outputs = 6 NAND2)
-- Inputs: 0=n1, 1=n2, 2=n3, 3=n6, 4=n7
c17-env5 : Bool → Bool → Bool → Bool → Bool → SumFin (toNat #5) → Bool
c17-env5 n1 n2 n3 n6 n7 (inl _) = n1
c17-env5 n1 n2 n3 n6 n7 (inr (inl _)) = n2
c17-env5 n1 n2 n3 n6 n7 (inr (inr (inl _))) = n3
c17-env5 n1 n2 n3 n6 n7 (inr (inr (inr (inl _)))) = n6
c17-env5 n1 n2 n3 n6 n7 (inr (inr (inr (inr (inl _))))) = n7
c17-env5 n1 n2 n3 n6 n7 (inr (inr (inr (inr (inr e))))) = Empty-rec e
