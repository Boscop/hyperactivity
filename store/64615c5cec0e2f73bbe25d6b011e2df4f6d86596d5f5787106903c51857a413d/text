-- THEOREM 9: UNIVERSAL TENSOR-NETWORK CONTRACTION ASSOCIATIVITY OVER ALL Nat!
omni-thm-tensor-assoc : (a b c : Nat) → hm-mul (hm-mul a b) c ≡ hm-mul a (hm-mul b c)
omni-thm-tensor-assoc zero    b c = refl
omni-thm-tensor-assoc (suc a) b c =
  web-trans-n (omni-mul-add-l b (hm-mul a b) c)
              (λ i → hm-add (hm-mul b c) (omni-thm-tensor-assoc a b c i))
