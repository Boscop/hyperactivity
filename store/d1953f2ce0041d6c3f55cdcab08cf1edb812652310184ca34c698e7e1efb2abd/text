-- in_list recurses in Sail; here on the bound (vec-len {Text} xs') (the list shortens)
-- (part of language-support)
in_list-body : ((x' : Text) → (xs' : List Text) → Bool) → (x' : Text) → (xs' : List Text) → Bool
in_list-body self' x' xs' =
  let t'3 : Bool
      t'3 =
        case xs' of
          cons h'1 r'2 →
            (let y' : Text
                 y' = h'1
                 ys' : List Text
                 ys' = r'2
             in (if (str-eq x' y') then true else (self' x' ys')))
          nil → false
  in t'3
