-- an eliminator meets a value: a blocked value is set on a new wire and the eliminator, holding
-- that wire and its arguments, becomes a blocked value; otherwise the table says what is built
nk-rule-el : Word → NkEnv → Word → NkHd → NkEnv → Word → NkOut
nk-rule-el h aux out hd parts n = if nk-blocked hd then nk-plan-of (nkf-val n (nkv hd parts) (nkf-val out (nkv (hd-stuck h) (nke-cons n aux)) nkf-nil)) (%wsucc n) else nk-fire (nk-act h hd parts) aux parts out n
