gds-body-roundtrip : (layer dtype : Word) → (rs : List Rect) →
  Path (Sum Unit (List Rect))
    (gds-decode-body (list-length rs) (gds-encode-body layer dtype rs))
    (inr rs)
gds-body-roundtrip layer dtype nil = λ _ → inr nil
gds-body-roundtrip layer dtype (cons (rect x0 y0 w h) rs) =
  λ i →
    bind-res {List Rect} {List Rect}
      (gds-body-roundtrip layer dtype rs i)
      (λ tail → inr (cons (rect-recover-eq x0 y0 w h i) tail))
