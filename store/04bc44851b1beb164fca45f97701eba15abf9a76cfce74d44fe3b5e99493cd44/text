-- one halving of the bracket ((lo, hi), sc), and whether its point was read
iq-half : (BZ → BZ → Nat × Bool) → Nat → (BZ × BZ) × BZ → ((BZ × BZ) × BZ) × Bool
iq-half c j b = iq-try1 c j (fst (fst b)) (snd (fst b)) (bz-add (fst (fst b)) (snd (fst b))) (snd b) (c (bz-add (fst (fst b)) (snd (fst b))) (iq-dbl (snd b)))
