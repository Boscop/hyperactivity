-- Single Closed-Loop `Hyperprofiler -> Hyperoptimizer` Step Operating on `Hyperoperator`:
ho-hyperoptimize-step : OperatorState → OperatorState
ho-hyperoptimize-step (mk-op-state fs e g) =
  let act = prof-prescribe-geodesic fs
  in mk-op-state (hp-apply-self-opt fs act) (superchip-opt e) (ho-evolve-genome-by-action act g)
