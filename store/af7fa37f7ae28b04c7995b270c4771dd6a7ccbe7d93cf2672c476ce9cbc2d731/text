-- UNIVERSAL PROOF 4: 3D EUCLIDEAN SQUARED-DISTANCE SYMMETRY OVER ALL Nat^6!
hm-absdiff-sym : (a b : Nat) → hm-absdiff a b ≡ hm-absdiff b a
hm-absdiff-sym zero    zero    = refl
hm-absdiff-sym zero    (suc _) = refl
hm-absdiff-sym (suc _) zero    = refl
hm-absdiff-sym (suc a) (suc b) = hm-absdiff-sym a b
