<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 920 210" width="920" height="210" role="img" aria-label="Observation Fiber and Warrant">
  <style>
    .bg { fill: #000000; }
    .frame { fill: none; stroke: #ffffff; stroke-width: 1.5; }
    .lbl { fill: #ffffff; font: 700 12px ui-monospace, 'SF Mono', Menlo, monospace; dominant-baseline: central; }
    .sub { fill: rgba(255,255,255,0.62); font: 600 11px ui-monospace, 'SF Mono', Menlo, monospace; }
    .pink { fill: #ff0a94; font: 700 11px ui-monospace, 'SF Mono', Menlo, monospace; }
    .blue { fill: #4da3ff; font: 700 11px ui-monospace, 'SF Mono', Menlo, monospace; }
    @keyframes dash { to { stroke-dashoffset: -28; } }
    .edge-b { stroke: #4da3ff; stroke-width: 1.8; fill: none; stroke-dasharray: 6 8; animation: dash 1.4s linear infinite; }
    .edge-p { stroke: #ff0a94; stroke-width: 2; fill: none; stroke-dasharray: 6 8; animation: dash 1.1s linear infinite; }
    .edge-d { stroke: rgba(255,255,255,0.16); stroke-width: 1; fill: none; }
  </style>
  <rect class="bg" width="920" height="210"/>
  <rect class="frame" x="1" y="1" width="918" height="208"/>
  <text class="pink" x="24" y="26">◈ OBSERVATION FIBER Fib_o(y) = { h : H | o(h) ≡ y } · WARRANT vs. SPLIT WITNESS</text>

  <!-- Observation node -->
  <circle cx="115" cy="112" r="38" fill="#000" stroke="#ff0a94" stroke-width="2.5"/>
  <text class="lbl" x="115" y="104" text-anchor="middle">Obs y</text>
  <text class="pink" x="115" y="124" text-anchor="middle">o(h) ≡ y</text>

  <!-- Compatible histories -->
  <line class="edge-b" x1="153" y1="100" x2="340" y2="62"/>
  <line class="edge-b" x1="153" y1="112" x2="340" y2="112"/>
  <line class="edge-p" x1="153" y1="124" x2="340" y2="162"/>

  <circle cx="356" cy="62" r="14" fill="#4da3ff"/>
  <text class="lbl" x="356" y="62" text-anchor="middle">h₁</text>
  <text class="blue" x="380" y="62">P(h₁) = TRUE</text>

  <circle cx="356" cy="112" r="14" fill="#4da3ff"/>
  <text class="lbl" x="356" y="112" text-anchor="middle">h₂</text>
  <text class="blue" x="380" y="112">P(h₂) = TRUE</text>

  <circle cx="356" cy="162" r="14" fill="#ff0a94"/>
  <text class="lbl" x="356" y="162" text-anchor="middle">h₃</text>
  <text class="pink" x="380" y="162">P(h₃) = FALSE  ← split witness (h₁, h₃)</text>

  <!-- Active query refinement on right -->
  <line x1="650" y1="44" x2="650" y2="188" stroke="rgba(255,255,255,0.2)"/>
  <text class="blue" x="674" y="68">ACTIVE QUERY q(h)</text>
  <text class="sub" x="674" y="92">separates h₃ from {h₁, h₂}</text>
  <rect x="674" y="112" width="218" height="58" fill="none" stroke="#4da3ff" stroke-width="1.8"/>
  <text class="lbl" x="783" y="132" text-anchor="middle">✓ WARRANTED</text>
  <text class="blue" x="783" y="152" text-anchor="middle">Π (h ∈ Fib). P(h)</text>
</svg>
