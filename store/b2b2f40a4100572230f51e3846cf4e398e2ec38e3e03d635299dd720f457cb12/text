nk-step-fx-clear : (x u n0 n1 : NkW) (ins outs : NkEnv) (fx : NkFx) →
  (nk-weq x u ≡ false) → (nk-wire-lt x n0 ≡ true) → (nk-emem x ins ≡ false) → (nk-emem x outs ≡ false) →
  (nk-step-fx-wf u ins outs n0 n1 fx ≡ true) → nk-clear? x fx ≡ true
nk-step-fx-clear x u n0 n1 ins outs nkf-nil neq lt hi ho hwf = refl
nk-step-fx-clear x u n0 n1 ins outs (nkf-at w (nkc-put s) r) neq lt hi ho hwf =
  let wu = nk-weq-sound w u (nk-and-l (nk-weq w u) (nk-fx-wf ins outs n0 n1 r) hwf)
      neqw = cong (λ z → nk-weq x z) wu ∙ neq
  in nk-step-fx-clear-at (nk-weq x w) x w s r n0 n1 ins outs neqw lt hi ho (nk-and-r (nk-weq w u) (nk-fx-wf ins outs n0 n1 r) hwf)
nk-step-fx-clear x u n0 n1 ins outs (nkf-at w (nkc-val v) r) neq lt hi ho hwf = nk-no hwf
nk-step-fx-clear x u n0 n1 ins outs (nkf-at w (nkc-op o) r) neq lt hi ho hwf = nk-no hwf
