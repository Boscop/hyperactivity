data CsCode10 =
    cc10-var (n : Word)
  | cc10-wlit (w : Word)
  | cc10-wsucc (a : Code)
  | cc10-wop (j : Word) (a : Code) (b : Code)
  | cc10-let (t : Code) (b : Code)
  | cc10-pair (a : Code) (b : Code)
  | cc10-fst (p : Code)
  | cc10-snd (p : Code)
  | cc10-case (dd : Word) (B : Lst Code) (cond : Code)
  | cc10-other
