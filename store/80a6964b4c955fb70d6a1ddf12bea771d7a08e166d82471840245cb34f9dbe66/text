-- GET /hi/events: the focus's presence and what is written there, as server-sent events; the server
-- holds no connection, so it tells the page to ask again in two seconds (retry), and each answer is
-- the state at that moment
hi-events : List Word → List Word → Proc W (List Word)
hi-events st q = bind (hi-others st (hi-reader q) (hi-focus q)) (λ os → bind (hi-about (hi-focus q)) (λ ab →
  ret (s-respond "200 OK" "text/event-stream" (h-concat (cons "retry: 30000" (cons (cons #10 (cons #10 nil)) (cons (hi-event "presence" (hi-present os)) (cons (hi-event "written" (hi-written ab)) nil))))))))
