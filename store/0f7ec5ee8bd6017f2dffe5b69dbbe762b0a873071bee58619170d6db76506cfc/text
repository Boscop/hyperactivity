-- the middle maps, stage 1 to stage 2
mid-maps : Nat → Bool → Nat → Bool → Nat → List Nat → Rows → Rows
mid-maps k sn n sm m dsP rs = if eqb k 1 then ctr-map (sp-ds sm m (mid-base k sn n dsP)) (e-map sm m (mid-base k sn n dsP) (f-map sn n (ctr-ds sn n dsP) rs))
  else (if eqb k 2 then e-map sm m (mid-base k sn n dsP) (f-map sn n (ctr-ds sn n dsP) rs)
  else (if eqb k 3 then ctr-map (sp-ds sm m dsP) (e-map sm m dsP (r-map sn n dsP rs))
  else (if eqb k 4 then e-map sm m dsP (r-map sn n dsP rs)
  else ctr-map (sp-ds sm m (mid-base k sn n dsP)) (e-map sm m (mid-base k sn n dsP) (f-map sn n (sp-ds sn n dsP) rs)))))
