cs-switch-tail-dl : (d : Word) (tl : List Word) → cs-switch-tail d tl ≡ list-append (cs-switch-tail d nil) tl
cs-switch-tail-dl d tl =
  cs-dl-comp (list-append "default: abort(); } r") (λ x → list-append (ce-dec d) (list-append "; })" x))
    (cs-dl-lit "default: abort(); } r")
    (cs-dl-comp (list-append (ce-dec d)) (list-append "; })")
      (cs-dl-lit (ce-dec d)) (cs-dl-lit "; })")) tl
