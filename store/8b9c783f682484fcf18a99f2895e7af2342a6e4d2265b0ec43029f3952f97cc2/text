sg-compile-datas : NkRawSig → Lst (Word × (Code × Lst Code)) → NkTm
sg-compile-datas _ lnil = nk-nil
sg-compile-datas rsig (lcons e r) =
  let d = fst e
      cf = fst (snd e)
      cs = snd (snd e)
      np = nk-cpi-len cf
      go = nk-of-code-s (toNat #800) rsig
      cft = go cf
      cst = nk-map-tm go cs
      hyps = nk-data-hyps d np cs
  in if orB (nk-has-fail cft) (nk-has-fail cst)
       then nk-cons (nk-con #57 (nk-cons (nk-num np) (nk-cons nk-fail (nk-cons hyps (nk-cons nk-nil nk-nil))))) (sg-compile-datas rsig r)
       else nk-cons (nk-con #57 (nk-cons (nk-num np) (nk-cons cft (nk-cons hyps (nk-cons cst nk-nil))))) (sg-compile-datas rsig r)
