hi-link : List Word → List Word → Proc W (List Word)
hi-link rd nil = ret nil
hi-link rd (cons x r) = if orB (h-not (hi-ident-char x)) (h-null (hi-core (cons x r))) then ret {lzero} {W} (s-esc (cons x r)) else
  bind (hi-bound (hi-core (cons x r))) (λ b → ret (if b then list-append (hi-a rd (hi-core (cons x r)) (hi-core (cons x r))) (s-esc (h-drop-n (list-length (hi-core (cons x r))) (cons x r))) else s-esc (cons x r)))
