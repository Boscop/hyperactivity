tso-keep-sub : {A : Type} → (p : A → Bool) → (ns : List A) → (x : A) → TsoIn x (tso-keep p ns) → TsoIn x ns
tso-keep-sub p nil x m = m
tso-keep-sub p (cons y r) x m =
  (case p y return (λ b → TsoIn x (if b then cons y (tso-keep p r) else tso-keep p r) → TsoIn x (cons y r)) of
     true → λ m2 → (case m2 of inl e → inl e; inr m3 → inr (tso-keep-sub p r x m3))
     false → λ m2 → inr (tso-keep-sub p r x m2)) m
