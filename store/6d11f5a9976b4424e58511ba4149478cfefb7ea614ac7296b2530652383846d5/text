cm-ltw-le-trans : (x y z : Word) → ltw x y ≡ true → ltw z y ≡ false → ltw x z ≡ true
cm-ltw-le-trans x =
  %welimP (λ v → (y z : Word) → ltw v y ≡ true → ltw z y ≡ false → ltw v z ≡ true) x
    (λ y → %welimP (λ v → (z : Word) → ltw #0 v ≡ true → ltw z v ≡ false → ltw #0 z ≡ true) y
             (λ z h1 h2 → cm-ft-absurd h1)
             (λ y1 gy z → %welimP (λ v → ltw #0 (%wsucc y1) ≡ true → ltw v (%wsucc y1) ≡ false → ltw #0 v ≡ true) z
                            (λ h1 h2 → cm-tf-absurd h2)
                            (λ z1 gz h1 h2 i → true)))
    (λ x1 ih → cm-lt-le-step x1 ih)
