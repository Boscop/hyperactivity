nk-fo-bcadr : (as : NkTm) → (nk-fo-tm as ≡ true) → nk-fo-tm (nk-bcadr as) ≡ true
nk-fo-bcadr (nk-cons a tl) h = nk-fo-bcadr-tl a tl (nk-and-r (nk-fo-tm a) (nk-fo-tm tl) h)
nk-fo-bcadr (nk-var i) h = refl
nk-fo-bcadr (nk-free x) h = refl
nk-fo-bcadr (nk-num m) h = refl
nk-fo-bcadr (nk-lam b) h = refl
nk-fo-bcadr (nk-susp b) h = refl
nk-fo-bcadr (nk-con c as) h = refl
nk-fo-bcadr (nk-op op p as) h = refl
nk-fo-bcadr (nk-match op p cs) h = refl
nk-fo-bcadr nk-nil h = refl
