pg-shift : bt-all1 (λ c → bt-all1 (λ m → (if fn-eq (bq-mul m (fn-sub (bq-mul (fn-q 2 1) c) (bq-mul (fn-q 2 1) (bq-mul c m)))) (fn-sub (pg-delta c m) (bq-mul (fn-q 2 1) (pg-gamma c m))) then fn-eq (bq-mul m (fn-neg (bq-mul c m))) (fn-neg (pg-gamma c m)) else false)) tb-p3) tb-p2 ≡ true
pg-shift = λ i → true
