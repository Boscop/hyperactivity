data GestureEvent =
    ge-sample  (t ch axis val : Word)        -- continuous sensor/travel/pressure/pitch sample
  | ge-impulse (t node freq force : Word)    -- physical strike/pluck/bow excitation
  | ge-param   (t target val : Word)         -- continuous physical/graph parameter change
  | ge-patch   (t hash : Word)               -- hot-patch topology transition
