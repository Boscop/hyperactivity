v-insert-depth : VEnv → List Word → List (List Word) → List (List Word)
v-insert-depth env x nil = cons x nil
v-insert-depth env x (cons y r) =
  if wlt (fromNat (list-length (v-look-list y (ve-anc env)))) (fromNat (list-length (v-look-list x (ve-anc env))))
  then cons y (v-insert-depth env x r) else cons x (cons y r)
