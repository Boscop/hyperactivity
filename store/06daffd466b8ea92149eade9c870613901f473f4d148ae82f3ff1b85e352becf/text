-- the laws of the scalars used by the elimination (a commutative ring without zero divisors, its zero decided by isz):
-- x·0 = 0, 0·x = 0, x + 0 = x, 0 + x = x, (s·x)·y = s·(x·y), c·(p + q) = c·p + c·q, (p + q)·a = p·a + q·a, a·b = b·a,
-- (−b) + b = 0, the interchange, a product of nonzeros is nonzero, and isz x = true gives x = 0
sy-DL : (A : Type) → A → (A → A → A) → (A → A → A) → (A → A) → (A → Bool) → Type
sy-DL A z ad mu ng isz = ((x : A) → mu x z ≡ z) × (((x : A) → mu z x ≡ z) × (((x : A) → ad x z ≡ x) × (((x : A) → ad z x ≡ x) × (((s x y : A) → mu (mu s x) y ≡ mu s (mu x y)) × (((c p q : A) → mu c (ad p q) ≡ ad (mu c p) (mu c q)) × (((p q a : A) → mu (ad p q) a ≡ ad (mu p a) (mu q a)) × (((a b : A) → mu a b ≡ mu b a) × (((b : A) → ad (ng b) b ≡ z) × (((p q r s : A) → ad (ad p q) (ad r s) ≡ ad (ad p r) (ad q s)) × (((c a : A) → isz c ≡ false → isz a ≡ false → isz (mu c a) ≡ false) × ((x : A) → isz x ≡ true → x ≡ z)))))))))))
