emit-elf64-arm64 : Word → INetExpr → List Word
emit-elf64-arm64 env e =
  let prolog = the (List Word) (bn-arm64-mov64 #8 (bn-w64 env))
      body   = the (List Word) (bn-arm64-emit-expr (superchip-opt e))
      epilog = the (List Word) (list-append (bn-u32-le #3531606984) (bn-u32-le #3556769793))
  in bn-elf64-image #183 (list-append prolog (list-append body epilog))
