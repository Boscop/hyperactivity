-- Wire-indexed netlist evaluator (bit-packed wire state: bit k of state = value of wire k)
cir-eval-net : Word → Word → List (Word × Word) → Word
cir-eval-net st _ nil = st
cir-eval-net st idx (cons g rest) =
  let va  = %wand (%wshr st (fst g)) #1
      vb  = %wand (%wshr st (snd g)) #1
      vo  = cir-nand1 va vb
      st2 = %wor st (%wshl vo idx)
  in cir-eval-net st2 (%wsucc idx) rest
