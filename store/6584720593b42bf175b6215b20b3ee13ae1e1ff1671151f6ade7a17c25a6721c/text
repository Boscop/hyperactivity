-- a wire that a plan writes nowhere reads the same after the plan
nk-get-do-apart : (fx : NkFx) (sl : NkSlots) (u : Word) → nk-apart u fx → nk-get (nk-do fx sl) u ≡ nk-get sl u
nk-get-do-apart nkf-nil sl u ap = refl
nk-get-do-apart (nkf-val k v r) sl u ap = nk-get-do-apart r (nk-upd sl k (nk-arrive-val v)) u (snd (snd ap)) ∙ nk-get-set-other sl k u (nk-arrive-val v (nk-get sl k)) (fst (snd ap))
nk-get-do-apart (nkf-op k o r) sl u ap = nk-get-do-apart r (nk-upd sl k (nk-arrive-op o)) u (snd (snd ap)) ∙ nk-get-set-other sl k u (nk-arrive-op o (nk-get sl k)) (fst (snd ap))
nk-get-do-apart (nkf-put k s r) sl u ap = nk-get-do-apart r (nk-upd sl k (λ s0 → s)) u (snd (snd ap)) ∙ nk-get-set-other sl k u s (fst (snd ap))
