it-len-split : (A V : Type) → (neg : A → Bool) → (f : V → V → A) → (ws : List V) → plus (sy-len V (it-fn A V neg f ws)) (sy-len V (it-fp A V neg f ws)) ≡ sy-len V ws
it-len-split A V neg f ws = case ws return λ w → plus (sy-len V (it-fn A V neg f w)) (sy-len V (it-fp A V neg f w)) ≡ sy-len V w of
  nil → λ i → zero
  cons u ur → it-len2 V (neg (f u u)) u (it-fn A V neg f ur) (it-fp A V neg f ur) (sy-len V ur) (it-len-split A V neg f ur)
