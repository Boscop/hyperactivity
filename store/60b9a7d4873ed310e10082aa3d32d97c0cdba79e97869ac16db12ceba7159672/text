addw-tail-n : (a b : Word) → W64w a → W64w b → nc26 a b ≡ true → QAll x86-step mn-ret (RQ (addw a b)) (X26 a b)
addw-tail-n a b ha hb h =
  q-step x86-step mn-ret (RQ (addw a b)) (X26 a b) (x86-set-rip #4194451 (X26 a b)) refl (jae-n a b h) refl
    (q-run x86-step mn-ret #11 (RQ (addw a b)) refl (x86-set-rip #4194451 (X26 a b)) refl
      (q-stop x86-step mn-ret (RQ (addw a b)) (Y a b) refl
        (res-eq a b ha hb (catw2 (λ i → nc-fits a b (~ i)) h))))
