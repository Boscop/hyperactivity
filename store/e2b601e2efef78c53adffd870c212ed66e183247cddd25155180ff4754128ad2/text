-- G D_pq = (G D′_qp)ᵀ for every p < n1, q < n2
pair-adj-row : Nat → Rows → List (List Rows) → List (List Rows) → Nat → Nat → Nat → Bool
pair-adj-row n g d d2 p q n2 = case n2 of
  zero → true
  suc k → (if rows-eq (mat-mul n g (lm-nth q (lr-nth p d))) (transpose n (mat-mul n g (lm-nth p (lr-nth q d2)))) then pair-adj-row n g d d2 p (suc q) k else false)
