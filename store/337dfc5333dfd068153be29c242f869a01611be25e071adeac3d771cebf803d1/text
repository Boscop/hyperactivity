-- the pivot's coefficient Σ c_j·(−b_j), and the others' coefficients c_j·a
sy-hs : (A W : Type) → A → (A → A → A) → (A → A → A) → (A → A) → List A → List (A × W) → A
sy-hs A W z ad mu ng cs ts = case ts of
  nil → z
  cons t tr → ad (mu (cl-hd A z cs) (ng (fst t))) (sy-hs A W z ad mu ng (cl-tl A cs) tr)
