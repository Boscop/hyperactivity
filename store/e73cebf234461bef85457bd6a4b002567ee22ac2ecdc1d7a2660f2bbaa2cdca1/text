ms-cone-gates : BoolCone → Nat
ms-cone-gates bc-var0         = suc zero
ms-cone-gates bc-var1         = suc zero
ms-cone-gates bc-var2         = suc zero
ms-cone-gates (bc-not x)      = suc (ms-cone-gates x)
ms-cone-gates (bc-and a b)    = suc (plus (ms-cone-gates a) (ms-cone-gates b))
ms-cone-gates (bc-or a b)     = suc (plus (ms-cone-gates a) (ms-cone-gates b))
ms-cone-gates (bc-xor a b)    = suc (plus (ms-cone-gates a) (ms-cone-gates b))
ms-cone-gates (bc-nand a b)   = suc (plus (ms-cone-gates a) (ms-cone-gates b))
ms-cone-gates (bc-mux s a b)  = suc (plus (ms-cone-gates s) (plus (ms-cone-gates a) (ms-cone-gates b)))
