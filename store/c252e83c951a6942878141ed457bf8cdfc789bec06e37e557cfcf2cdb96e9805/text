-- UNIVERSAL THEOREM 1 (`S + K < K * S` STRICT HYPERFACTORIZATION GAIN, 0 POSTULATES):
ch-thm-hyperfactor-strict :
  (s k : Nat) →
  let bigS = suc (suc (suc s))
      bigK = suc (suc k)
  in ch-le (plus bigS (suc bigK)) (ch-mul bigK bigS) ≡ true
ch-thm-hyperfactor-strict s k =
  ch-le-add-l (suc (suc (suc s))) (suc (suc (suc k)))
    (ch-mul (suc k) (suc (suc (suc s))))
    (ch-lem-tail s k)
