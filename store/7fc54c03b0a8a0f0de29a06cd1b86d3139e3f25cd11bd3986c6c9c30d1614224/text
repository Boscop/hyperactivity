cs-brs-by : (Word → Word → Word) → Lst Code → (Word → Code → List Word → List Word) → Word → Word → Word → List Word → List Word
cs-brs-by nf_of lnil f dd d k acc = acc
cs-brs-by nf_of (lcons br r) f dd d k acc =
  let nf = nf_of dd k
  in list-append "case " (list-append (ce-dec k) (list-append ": { " (list-append (ce-binds (toNat nf) d #0)
       (list-append "r" (list-append (ce-dec d) (list-append " = "
         (f (%wadd d nf) (x-strip nf br) (list-append "; break; } " (cs-brs-by nf_of r f dd d (%wsucc k) acc)))))))))
