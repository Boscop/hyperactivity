nk-eval-pack : NkPack → (Lst NkTm × Opt Word) → Lst NkTm × Opt Word
nk-eval-pack nkp-0 st = st
nk-eval-pack (nkp-1 a) st = nk-step-p a st
nk-eval-pack (nkp-3 p) st = nk-step-3 p st
nk-eval-pack (nkp-24 w0 w1 w2 w3 w4 w5 w6 w7) st =
  nk-step-3 w7 (nk-step-3 w6 (nk-step-3 w5 (nk-step-3 w4 (nk-step-3 w3 (nk-step-3 w2 (nk-step-3 w1 (nk-step-3 w0 st)))))))
nk-eval-pack (nkp-2 l r) st = nk-eval-pack r (nk-eval-pack l st)
