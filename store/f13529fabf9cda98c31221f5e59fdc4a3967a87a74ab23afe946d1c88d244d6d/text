max-mux4-loop : Nat → Word → List Word
max-mux4-loop zero _ = nil
max-mux4-loop (suc k) i =
  let s   = epfl-dec i
      t0  = list-append "m0_" s
      t1  = list-append "m1_" s
      t2  = list-append "m2_" s
      t3  = list-append "m3_" s
      t01 = list-append "m01_" s
      t23 = list-append "m23_" s
      res = epfl-indexed "result" i
  in sv-concat
       (cons (epfl-gate2 "w0" (epfl-indexed "in0" i) t0 "11")
       (cons (epfl-gate2 "w1" (epfl-indexed "in1" i) t1 "11")
       (cons (epfl-gate2 "w2" (epfl-indexed "in2" i) t2 "11")
       (cons (epfl-gate2 "w3" (epfl-indexed "in3" i) t3 "11")
       (cons (epfl-or2-blif t0 t1 t01)
       (cons (epfl-or2-blif t2 t3 t23)
       (cons (epfl-or2-blif t01 t23 res)
       (cons (max-mux4-loop k (%wsucc i)) nil))))))))
