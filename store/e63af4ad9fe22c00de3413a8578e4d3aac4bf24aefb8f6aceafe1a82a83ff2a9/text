msing-daemon-loop : Nat → Word → SingularityState → Proc W Unit
msing-daemon-loop zero    _     _  = ret {lzero} {W} unit
msing-daemon-loop (suc k) epIdx st =
  bind (msing-run-epoch epIdx st) (λ nextSt →
  bind (h-capture (cons "/bin/sleep" (cons "4" nil))) (λ slp →
  msing-daemon-loop k (%wadd epIdx #1) nextSt))

msing-mode : List (List Word) → Word
msing-mode nil         = #0
msing-mode (cons a rs) =
  if h-eq a "spawn" then #4
  else if h-eq a "primer" then #3
  else if h-eq a "daemon" then #2
  else if orB (h-eq a "converge") (h-eq a "evolve") then #1
  else msing-mode rs

msing-spawn-title : List (List Word) → List Word
msing-spawn-title nil                  = "HX-Autopoietic-Swarm-Node"
msing-spawn-title (cons a (cons t rs)) = if h-eq a "spawn" then t else msing-spawn-title (cons t rs)
msing-spawn-title (cons a nil)         = "HX-Autopoietic-Swarm-Node"

msing-entry : Proc W Unit
msing-entry =
  bind h-args (λ av →
  bind (msing-mkdir msing-out-dir) (λ md0 →
    let tailAv = h-tail-lists av
        mode   = msing-mode tailAv
        elf    = emit-elf64-x86 #11 (ho-op-inet ho-state-1)
        ptx    = msing-compile-coupled-sm90a ho-gen3 #1638920000 #1638890000 #1639050000
    in bind (h-write (list-append msing-out-dir "/singularity_x86_64.elf") elf) (λ we0 →
       bind (h-write (list-append msing-out-dir "/singularity_coupled_sm90a.ptx") ptx) (λ wp0 →
       if %weq mode #4
       then msing-run-primer true (msing-spawn-title tailAv)
       else if %weq mode #3
       then msing-run-primer false "HX-Autopoietic-Swarm-Primer"
       else if %weq mode #2
       then bind (msing-run-primer false "HX-Autopoietic-Swarm-Daemon") (λ up →
            msing-daemon-loop (toNat #100000) #1 msing-state-0)
       else if %weq mode #1
       then bind (msing-run-primer false "HX-Autopoietic-Swarm-Converge") (λ up →
            bind (msing-run-epoch #1 msing-state-0) (λ s1 →
            bind (msing-run-epoch #2 s1) (λ s2 →
            ret {lzero} {W} unit)))
       else
         h-out
           (h-concat
             (cons (bn-ln "[HX-METACIRCULAR-SINGULARITY | 100% PURE .HYPERCUBICAL STOKES + TIR + HFKE SWARM + AGENT INITIALIZER]")
             (cons (bn-ln (list-append "  Bare Capsules Emitted  : x86_64_ELF64=" (list-append (h-decimal (fromNat (list-length elf))) (list-append "B | MarketCoupled_SM90a_PTX=" (list-append (h-decimal (fromNat (list-length ptx))) "B | Base_11Word_Sieve=352B")))))
             (cons (bn-ln "  Unified Proofs (0 post): msing-thm-generalized-stokes-unbounded | msing-thm-singularity-descent | msing-thm-tir-unitary-and-golay23 | msing-thm-cryptic-tir-conjugation | msing-thm-inf-cell-and-portal-arrive | msing-thm-primer-valid")
