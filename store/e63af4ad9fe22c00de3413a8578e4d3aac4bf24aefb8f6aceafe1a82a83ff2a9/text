msing-target-arg : List (List Word) → List Word
msing-target-arg nil                             = nil
msing-target-arg (cons a (cons b (cons c rest))) =
  if h-eq a "--with" then msing-target-arg rest else a
msing-target-arg (cons a rest)                   = a

msing-is-direct : List (List Word) → Bool
msing-is-direct av = h-infix "hx-metacircular-singularity" (msing-target-arg (h-tail-lists av))

msing-run : Step W Unit
msing-run =
  to-step
    (bind h-args (λ av →
      if msing-is-direct av
      then bind msing-entry (λ ue → exit #0)
      else ret {lzero} {W} unit))

