-- SECTION 1: UNBOUNDED-ORDER GENERALIZED DISCRETE STOKES CONTRACTION (0 POSTULATES)
--   Formalizes `integral_Omega (d f) === f(boundary_end) - f(boundary_start)` over
--   arbitrary chain order `extra : Nat` on the exact commutative ring `Z` (`ap-reflect`):
--   every interior vertex cancels telescopically, collapsing O(N) bulk onto O(1) boundary!
-- ============================================================================

msing-end : Nat → Nat → Nat
msing-end base zero        = suc base
msing-end base (suc extra) = msing-end (suc base) extra

msing-stokes-chain1 : (Nat → Z) → Nat → Nat → Z
msing-stokes-chain1 f base zero        = z-sub (f (suc base)) (f base)
msing-stokes-chain1 f base (suc extra) =
  z-add (z-sub (f (suc base)) (f base)) (msing-stokes-chain1 f (suc base) extra)

msing-expr-stokes-base : AlgExpr
msing-expr-stokes-base = ae-add (ae-var vx0) (ae-sub (ae-var vx1) (ae-var vx0))

msing-lem-stokes-base : (a b : Z) → z-add a (z-sub b a) ≡ b
msing-lem-stokes-base a b =
  ap-reflect msing-expr-stokes-base (ae-var vx1) refl (env6 a b z-zero z-zero z-zero z-zero)

msing-expr-stokes-stepL : AlgExpr
msing-expr-stokes-stepL = ae-add (ae-var vx0) (ae-add (ae-sub (ae-var vx1) (ae-var vx0)) (ae-var vx2))

msing-expr-stokes-stepR : AlgExpr
msing-expr-stokes-stepR = ae-add (ae-var vx1) (ae-var vx2)

msing-lem-stokes-step : (a b r : Z) → z-add a (z-add (z-sub b a) r) ≡ z-add b r
msing-lem-stokes-step a b r =
  ap-reflect msing-expr-stokes-stepL msing-expr-stokes-stepR refl (env6 a b r z-zero z-zero z-zero)

-- UNIVERSAL THEOREM 0 (GENERALIZED DISCRETE STOKES BOUNDARY CONTRACTION TO UNBOUNDED ORDER, 0 POSTULATES):
-- For ALL potentials `f : Nat -> Z`, ALL start points `base : Nat`, and ALL chain orders `extra : Nat`,
-- `f(base) + sum_{k=0..extra} (f(base+k+1) - f(base+k)) === f(msing-end base extra)`!
msing-thm-generalized-stokes-unbounded :
  (f : Nat → Z) → (base extra : Nat) →
  z-add (f base) (msing-stokes-chain1 f base extra) ≡ f (msing-end base extra)
msing-thm-generalized-stokes-unbounded f base zero =
  msing-lem-stokes-base (f base) (f (suc base))
msing-thm-generalized-stokes-unbounded f base (suc extra) =
  pr-trans (msing-lem-stokes-step (f base) (f (suc base)) (msing-stokes-chain1 f (suc base) extra))
           (msing-thm-generalized-stokes-unbounded f (suc base) extra)

