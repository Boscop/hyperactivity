cs-mk-bool-brs-zero : (n0 n1 d : Word) (cf : Word → Code → CsExp) (tbr fbr : Code) →
  (n0 ≡ #0) → (n1 ≡ #0) →
  cs-mk-bool-brs n0 n1 d cf tbr fbr
  ≡ cse-br-cons #0 d #0 (cf d tbr) (cse-br-cons #1 d #0 (cf d fbr) cse-br-nil)
cs-mk-bool-brs-zero n0 n1 d cf tbr fbr hn0 hn1 =
  cong (λ u → cs-mk-bool-brs u n1 d cf tbr fbr) hn0
  ∙ cong (λ u → cs-mk-bool-brs #0 u d cf tbr fbr) hn1
