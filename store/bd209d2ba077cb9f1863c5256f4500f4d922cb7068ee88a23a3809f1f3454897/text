l-judge-tool : List Word → List Word → Proc W Unit
l-judge-tool call tool =
  if h-has tool l-file-tools then
    (if orB (h-infix ".hypercubical" (l-field "file_path" call)) (h-infix ".hypercubical" (l-field "notebook_path" call)) then l-refuse l-why else exit #0)
  else if orB (h-eq tool "Grep") (h-eq tool "Glob") then
    (if orB (l-any (λ k → h-infix ".hypercubical" (l-field k call)) (cons "path" (cons "pattern" (cons "glob" nil))))
          (orB (h-eq (l-field "type" call) "cub")
               (andB (h-eq tool "Grep") (andB (h-null (l-field "glob" call)) (andB (h-null (l-field "type" call)) (l-grep-in-repo call)))))
     then l-refuse (list-append l-why " (a search of the repository reaches .hypercubical files: name a non-.hypercubical glob or type)") else exit #0)
  else if h-eq tool "Bash" then
    (if l-any l-segment-bad (l-segments-onto nil (l-field "command" call)) then l-refuse (list-append l-why " (this command reaches where code is kept)") else exit #0)
  else exit #0
