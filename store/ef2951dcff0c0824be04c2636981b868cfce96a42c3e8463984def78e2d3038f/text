-- the product of enclosures encloses the product
iv-mul-sound : (S : List Bool) → (I1 I2 : IV) → (X1 X2 : Nat × Nat) → (q1 q2 : Nat) → bcanon S ≡ true → le (suc zero) (bin-to-nat S) → ivc I1 → ivc I2 → encl S I1 X1 q1 → encl S I2 X2 q2 → encl S (iv-mul S I1 I2) (zmul X1 X2) (times q1 q2)
iv-mul-sound S I1 I2 X1 X2 q1 q2 cS hS c1 c2 e1 e2 = (mul-low S I1 I2 X1 X2 q1 q2 cS hS c1 c2 e1 e2 , mul-high S I1 I2 X1 X2 q1 q2 cS hS c1 c2 e1 e2)
