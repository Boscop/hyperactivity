hxl-main : List (List Word) → Step W Word
hxl-main args =
  let out = hxl-arg1 args
  in scmd w-now (λ t0 →
     hhf-run-audit (λ rh st →
     scmd (w-load st) (λ entries →
     scmd (w-load (%wadd st #8)) (λ dmods →
     scmd (w-load (%wadd st #16)) (λ chunks →
     scmd (w-load (%wadd st #32)) (λ up →
     scmd (w-load (%wadd st #40)) (λ rp →
     scmd (w-load (%wadd st #48)) (λ fl →
     scmd (w-free st) (λ _ →
     let syn    = hxl-synth-suite
         syn_ok = fst syn
         syn_g  = snd syn
         alu_ok = hxl-alu-check
         tir_ok = hxl-tir-check
     in scmd w-now (λ t1 →
        let us = %wdiv (%wsub t1 t0) #1000
            js = hxl-json rh entries dmods chunks up rp fl syn_ok syn_g alu_ok tir_ok us
        in scmd (w-file-write-named out js) (λ nb →
           let all_ok = if %weq syn_ok #6 then (if %weq alu_ok #1 then %weq tir_ok #1 else false) else false
           in cli-say (list-append "HX-LOOP PASS=" (list-append (if all_ok then "1" else "0")
                (list-append " ROOT=" (list-append rh
                (list-append " mods=" (list-append (ce-dec dmods)
                (list-append " univ_proofs=" (list-append (ce-dec up)
                (list-append " refl=" (list-append (ce-dec rp)
                (list-append " foreign_inc=" (list-append (ce-dec fl)
                (list-append " synth=" (list-append (ce-dec syn_ok) (list-append "/6(" (list-append (ce-dec syn_g)
                (list-append "g) alu=" (list-append (ce-dec alu_ok)
                (list-append " tir=" (list-append (ce-dec tir_ok)
                (list-append " ledger=" (list-append (ce-dec nb)
                (list-append "B (" (list-append (ce-dec us) " us)"))))))))))))))))))))))))
                (sdone (if all_ok then #0 else #1)))))))))))))
