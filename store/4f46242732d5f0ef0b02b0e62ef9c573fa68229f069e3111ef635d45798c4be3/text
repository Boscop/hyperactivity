-- Theorem (cs-val-rel-mono): Kripke value denotation is preserved across every bump-arena extension
cs-val-rel-mono : (hp1 hp2 : CsHeap) (mv : CsMVal) (cv : CsVal) →
  cs-heap-ext hp1 hp2 →
  (cs-val-rel hp1 mv cv ≡ true) →
  cs-val-rel hp2 mv cv ≡ true
cs-val-rel-mono hp1 hp2 (cmv-word w) (csv-word w') ext h = h
cs-val-rel-mono hp1 hp2 (cmv-word w) (csv-ptr addr) ext h = cs-no h
cs-val-rel-mono hp1 hp2 (cmv-bool b) (csv-word w) ext h = cs-no h
cs-val-rel-mono hp1 hp2 (cmv-bool b) (csv-ptr addr) ext h =
  cs-bool-rel-mono-at hp1 hp2 addr b (cs-loadv hp1 (csv-ptr addr) zero) ext refl h
cs-val-rel-mono hp1 hp2 (cmv-pair a b) (csv-word w) ext h = cs-no h
cs-val-rel-mono hp1 hp2 (cmv-pair a b) (csv-ptr addr) ext h =
  cs-pair-rel-mono-at hp1 hp2 addr a b
    (cs-loadv hp1 (csv-ptr addr) (suc zero))
    (cs-loadv hp1 (csv-ptr addr) (suc (suc zero)))
    ext (λ v hv → cs-val-rel-mono hp1 hp2 a v ext hv) (λ v hv → cs-val-rel-mono hp1 hp2 b v ext hv) refl refl h
