-- Σ_{v ≤ w} C(a, m − v) C(b, v) (−1)^v as an integer, the difference of its even and odd parts
he-cpart : Nat → Nat → Nat → Nat → Nat × Nat
he-cpart a b m w = case w of
  zero → (he-choose a m , 0)
  suc w1 → he-cadd (he-odd (suc w1)) (times (he-choose a (monus m (suc w1))) (he-choose b (suc w1))) (he-cpart a b m w1)
