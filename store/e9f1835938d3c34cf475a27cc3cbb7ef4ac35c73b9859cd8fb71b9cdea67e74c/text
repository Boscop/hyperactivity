-- 2. Mechanical Apple Metal MSL Emitter (EXACT SAME superoptimized AST!)
kir-fn-metal : List Word → WExpr → List Word → List Word
kir-fn-metal name e tail =
  hw-ln (list-append "inline uint " (list-append name (list-append "(uint x0, uint x1, uint x2) { return "
        (list-append (kir-emit-expr "0u" "0xFFFFFFFFu" (kir-opt e)) "; }")))) tail
