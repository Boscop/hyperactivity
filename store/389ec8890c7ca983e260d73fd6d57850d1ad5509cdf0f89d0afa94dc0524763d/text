l-search : List (List Word) → Bool
l-search nil = false
l-search (cons c r) =
  orB (h-has c (cons "rg" (cons "ag" (cons "ack" (cons "find" (cons "fd" (cons "tree" nil)))))))
  (orB (andB (h-eq c "git") (h-eq (l-first r) "grep"))
  (andB (orB (h-eq c "grep") (h-eq c "egrep")) (l-any (λ w → andB (h-prefix "-" w) (orB (h-infix "r" w) (h-infix "R" w))) r)))
