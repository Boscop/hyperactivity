s-corpus-essays : List (List Word × List Word) → Proc W (List (List Word))
s-corpus-essays nil = ret nil
s-corpus-essays (cons x r) = bind (s-essay-lines (fst x)) (λ ls → bind (s-corpus-essays r) (λ rest → ret {lzero} {W} (cons (s-corpus-item (list-append "/doc?path=" (fst x)) (snd x) (h-concat (list-map h-line ls))) rest)))
