z-double-cong : (x y : ZWord) → z-eq x y → z-eq (z-double x) (z-double y)
z-double-cong x y h =
  let env = z4-env (fst x) (snd x) (fst y) (snd y)
      s1 = same-norm-eq env
             (lc-add (lc-add (lc-var #0) (lc-var #0)) (lc-add (lc-var #3) (lc-var #3)))
             (lc-add (lc-add (lc-var #0) (lc-var #3)) (lc-add (lc-var #0) (lc-var #3))) refl
      s3 = same-norm-eq env
             (lc-add (lc-add (lc-var #2) (lc-var #1)) (lc-add (lc-var #2) (lc-var #1)))
             (lc-add (lc-add (lc-var #2) (lc-var #2)) (lc-add (lc-var #1) (lc-var #1))) refl
  in catw s1 (catw (cong2w plusw h h) s3)
