-- the fact o holds is stable for o' when o''s record fixes it: a map from what o' records to what o
-- records, agreeing with o on every history
StableFor : (H : Type 0) → Observer H → Observer H → Type 0
StableFor H o o2 = (f : obs-type H o2 → obs-type H o) × ((h : H) → f (obs-of H o2 h) ≡ obs-of H o h)
