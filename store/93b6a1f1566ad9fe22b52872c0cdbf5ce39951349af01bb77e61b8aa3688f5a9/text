-- ---------------------------------------------------------------- 1. Structured C11 subset AST & exact byte-printer equivalence
data CsExp =
    cse-bad
  | cse-var (vid : Word)
  | cse-ull (lit : Word)
  | cse-add1 (a : CsExp)
  | cse-bop (op : Word) (a : CsExp) (b : CsExp)
  | cse-let (vid : Word) (t : CsExp) (b : CsExp)
  | cse-call (fn : Word) (args : CsExp)
  | cse-clo (fn : Word) (ar : Word) (n : Word) (args : CsExp)
  | cse-app (f : CsExp) (a : CsExp)
  | cse-pair (a : CsExp) (b : CsExp)
  | cse-fst (p : CsExp)
  | cse-snd (p : CsExp)
  | cse-con (tag : Word) (nf : Word) (args : CsExp)
  | cse-switch (d : Word) (scrut : CsExp) (brs : CsExp)
  | cse-for (d : Word) (bound : CsExp) (init : CsExp) (step : CsExp)
  | cse-args-nil
  | cse-fargs (hd : CsExp) (tl : CsExp)
  | cse-cargs (hd : CsExp) (tl : CsExp)
  | cse-br-nil
  | cse-br-cons (tag : Word) (d : Word) (nf : Word) (body : CsExp) (rest : CsExp)
