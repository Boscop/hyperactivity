-- Emit one NAND2 gate in WASM: local.get i; local.get j; i32.and; i32.const 1; i32.xor; local.set nw
iw-gate-code : Nat → Word → Word → List Word
iw-gate-code zero _ _ = nil
iw-gate-code (suc k) nw prog =
  let g = %wand prog #63
      i = %wshr g #3
      j = %wand g #7
      -- 0x20=local.get, 0x71=i32.and, 0x41=i32.const, 0x73=i32.xor, 0x21=local.set
      step = the (List Word)
        (cons #32 (cons i (cons #32 (cons j (cons #113 (cons #65 (cons #1 (cons #115 (cons #33 (cons nw nil))))))))))
  in list-append step (iw-gate-code k (%wsucc nw) (%wshr prog #6))
