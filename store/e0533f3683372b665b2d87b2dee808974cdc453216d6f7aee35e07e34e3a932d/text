-- Any involutive bank hash (such as XOR bank swizzling) induces a computational Equiv and univalent Path!
SwizzleEquiv : {B R : Type} → (flip : R → B → B) → ((r : R) (b : B) → flip r (flip r b) ≡ b) → Equiv (B × R) (B × R)
SwizzleEquiv {B} {R} flip inv =
  isoToEquiv {lzero} {B × R} {B × R} (swizzle-map flip) (swizzle-map flip) (swizzle-inv flip inv) (swizzle-inv flip inv)
