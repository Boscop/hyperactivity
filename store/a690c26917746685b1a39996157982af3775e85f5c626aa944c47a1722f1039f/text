s-corpus-one : List Word → List Word → Proc W (List Word)
s-corpus-one st q = if h-eq q "/paper" then bind (h-read (list-append st "/paper/text")) (λ pt → ret {lzero} {W} (s-response "application/json" (s-corpus-item "/paper" "hyperactivity: the paper" (s-paper-text (s-or nil pt))))) else s-corpus-at (s-at-name q s-published)
