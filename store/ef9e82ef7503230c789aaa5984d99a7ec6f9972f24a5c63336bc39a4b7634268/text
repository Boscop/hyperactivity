ce-op-sem : Word → Word → Word → CVal
ce-op-sem j a b =
  if %weq j #0  then c-bool (%weq a b)
  else if %weq j #1  then c-bool (%wlt a b)
  else if %weq j #2  then cv-word (%wadd a b)
  else if %weq j #3  then cv-word (%wmax a b)
  else if %weq j #4  then cv-word (%wsub a b)
  else if %weq j #5  then cv-word (%wmul a b)
  else if %weq j #6  then cv-word (if %weq b #0 then #0 else %wdiv a b)
  else if %weq j #7  then cv-word (if %weq b #0 then #0 else %wmod a b)
  else if %weq j #8  then cv-word (%wand a b)
  else if %weq j #9  then cv-word (%wor a b)
  else if %weq j #10 then cv-word (%wxor a b)
  else if %weq j #11 then cv-word (if %wlt b #64 then %wshl a b else #0)
  else if %weq j #12 then cv-word (if %wlt b #64 then %wshr a b else #0)
  else cv-word #0
