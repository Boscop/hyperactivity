-- unsigned division and remainder, total: by 0 the quotient is 0 and the remainder the dividend
x-udiv : Bool → Lst Word
x-udiv rem =
  let body = xcat3 i-xor-edx i-div (if rem then i-mov-rax-rdx else lnil)
      zero = the (Lst Word) (if rem then lnil else i-xor-eax)
  in xcat4 i-test-rcx (i-jcc j-e (%wadd (l-count body) #5)) body (l-app (i-jmp (l-count zero)) zero)
