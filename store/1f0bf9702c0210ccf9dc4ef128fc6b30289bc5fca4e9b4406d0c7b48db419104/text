-- A Funnel on (C, defect, step):
-- Every conformation c either is already native (defect c ≡ 0, and step keeps it at 0)
-- OR a single local move strictly lowers its frustration defect (defect (step c) + 1 ≤ defect c).
FoldFunnel : (C : Type 0) → (C → Nat) → (C → C) → Type 0
FoldFunnel C defect step =
  (c : C) →
    (defect c ≡ zero → defect (step c) ≡ zero) ×
    (leb 1 (defect c) ≡ true → leb (suc (defect (step c))) (defect c) ≡ true)
