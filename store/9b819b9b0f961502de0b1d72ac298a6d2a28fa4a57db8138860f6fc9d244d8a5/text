eig-loop2 : SQ → VM → VM → VM → SQ → List SQ → List SQ → List SQ → Nat → Bool → Nat → Bool → Nat → List Nat → Rows → List (List (List PRad)) → List (List (List PRad))
eig-loop2 w a1 a2 aP mu1 es1 mus es2 k sn n sm m dsP xs0 acc = case mus of
  nil → acc
  cons mu2 rest → eig-loop2 w a1 a2 aP mu1 es1 rest es2 k sn n sm m dsP xs0 (if sq-nz mu2 then proj-add w (nats-comb (suc zero) (mu-exps mu1) (suc zero) (mu-exps mu2)) (eig-map a1 a2 aP mu1 es1 mu2 es2 k sn n sm m dsP xs0) acc else acc)
