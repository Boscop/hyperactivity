-- Extract 32-byte word `idx` (`64` hex chars) from a `0x`-prefixed hex string:
ms-word-at-hex : Nat → List Word → Word
ms-word-at-hex wordIdx hex0x =
  let body  = if h-prefix "0x" hex0x then ms-drop-chars (toNat #2) hex0x else hex0x
      start = bn-mul-nat wordIdx (toNat #64)
      slice = h-take (toNat #64) (ms-drop-chars start body)
  in bl-hex-to-word slice
