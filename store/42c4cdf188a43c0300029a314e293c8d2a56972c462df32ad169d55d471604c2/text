fleet-proc-run : {M St : Type} → (beh : Beh M St) → (chs : List Adv) → (g : FState M St) →
                 Path (Outcome (FState M St) × List Adv)
                      (runp {EnvS} {FState M St} {List Adv} (fleet-proc {M} {St} beh (nt-len {Adv} chs) g) (feed-world {Adv}) chs)
                      (done (fleet-run {M} {St} beh chs g) , nil)
fleet-proc-run {M} {St} beh nil g = λ i → (done g , nil)
fleet-proc-run {M} {St} beh (cons a r) g = fleet-proc-run {M} {St} beh r (fleet-step {M} {St} beh a g)
