reidx-fmap : (n : Nat) (X X' : Type 1) (F F2 : X → Type 1) (F' : X' → Type 1) (h : (x : X) → F x → F2 x) (f : X → X')
  (g : (x : X) → F2 x → F' (f x)) (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → DCube n X' F' (cube-map n X X' f c))
    (dcube-reidx n X X' F2 F' f g c (dcube-fmap n X F F2 h c d)) (dcube-reidx n X X' F F' f (λ x y → g x (h x y)) c d)
reidx-fmap zero X X' F F2 F' h f g c d = λ i → g c (h c d)
reidx-fmap (suc n) X X' F F2 F' h f g c d =
  reidx-fmap n (Line X) (Line X') (LineO X F) (LineO X F2) (LineO X' F') (lineo-fmap X F F2 h) (line-map X X' f) (lineo-reidx X X' F2 F' f g) c d
