-- ({v₀}, R, Q, ℓ) → install(v₁) → routeNew → drainOld → retireOld reaches ({v₁}, R′, Q′, ℓ′)
up-sequence : (v0 v1 r : Nat) → (q l : List Nat) →
  up-retire-old v1 (up-drain-old (up-route-new v1 (up-install v1 (cons v0 nil , r , q , l)))) ≡ (cons v1 nil , v1 , nil , list-append l q)
up-sequence v0 v1 r q l = λ k → (cons v1 nil , v1 , nil , list-append l q)
