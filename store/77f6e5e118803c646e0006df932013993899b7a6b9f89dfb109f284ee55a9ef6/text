-- ---------------------------------------------------------------- transport
-- transport along a line of types, from its start: eliminator 20 on the line, with the face where
-- the line is constant and the point transported
nk-transp : NkTm → NkTm → NkTm → NkTm
nk-transp line phi a = nk-op #20 line (nk-cons phi (nk-cons a nk-nil))
