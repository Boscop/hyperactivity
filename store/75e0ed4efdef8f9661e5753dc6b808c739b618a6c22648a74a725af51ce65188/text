ext-liftG : (Γ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (Z : Type 1)
  (l : (γ : CtxV (fst Γ)) (e : EnvV (fst Γ) γ → Y) → FbE (lcons (e-ty a) (fst Γ)) Z (γ , λ ρ → h (e ρ))) (M : Mean Γ Y) →
  Mean (ext-h Γ a Y h M) Z
ext-liftG Γ a Y h Z l M =
  dcube-lift (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y) (FbE (lcons (e-ty a) (fst Γ)) Z)
    (λ γ e → (γ , λ ρ → h (e ρ))) l (snd Γ) M
