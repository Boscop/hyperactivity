-- bitcount8 recurses in Sail; here on the bound #9 (the 8-bit argument shifts right by one)
-- (part of language-support)
bitcount8-body : ((x' : Bits #8) → MF ZI) → (x' : Bits #8) → MF ZI
bitcount8-body self' x' =
  if (eq_bits_nat #8 x' (zpos #0)) then
    (retF {ZI} (zpos #0))
  else
    (bindF {ZI} {ZI} (self' (bits_of_int (logtail_int (zpos #1) (bv-unsigned #8 x')) (zpos #8))) (λ t'1 →
       bindF {ZI} {ZI} (check_range (zpos #0) (zpos #8) t'1) (λ t'2 →
         nat_of_int (z-add (bv-unsigned #1 (loghead_bits #8 (zpos #1) x')) t'2))))
