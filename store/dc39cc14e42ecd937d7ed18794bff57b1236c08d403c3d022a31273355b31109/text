-- Streaming rANS decode step: apply exact rANS inverse step, then refill bytes while s < L
sr-dec-step : FTbl → Word → Nat → SRState → Word × SRState
sr-dec-step tbl L fuel st =
  let d = rans-dec-step tbl (fst st)
      x = fst d
      s0 = snd d
      st0 = sr-refill-loop (suc fuel) L s0 (snd st)
  in (x , st0)
