nk-compat-t-s : NkTm → NkTm → Word → NkTm → NkTm → NkTm → NkTm → Bool
nk-compat-t-s kdefs ctx n u1 u2 sg (nk-cons tau r) =
  if nk-consistent sg tau
    then (let csub = nk-sub-clause tau (nk-sub-clause sg ctx)
          in if nk-eq-s kdefs csub n
                  (nk-norm-in-s kdefs csub n (nk-sub-clause tau (nk-sub-clause sg u1)))
                  (nk-norm-in-s kdefs csub n (nk-sub-clause tau (nk-sub-clause sg u2)))
               then nk-compat-t-s kdefs ctx n u1 u2 sg r else false)
    else nk-compat-t-s kdefs ctx n u1 u2 sg r
nk-compat-t-s kdefs ctx n u1 u2 sg t = true
