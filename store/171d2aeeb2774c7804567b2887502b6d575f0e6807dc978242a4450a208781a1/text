-- Native Boltzmann Weight Strictly Dominates All M Misfolds:
-- Whenever x > M (suc M ≤ x) and base weight W ≥ 1, native weight x·W > M·W.
fold-boltzmann-dominates : (M x W : Nat) → leb (suc M) x ≡ true → leb 1 W ≡ true → leb (suc (times M W)) (times x W) ≡ true
fold-boltzmann-dominates M zero W h w = Empty-rec (fold-false-ne-true h)
fold-boltzmann-dominates zero (suc x') W h w = fold-leb-plus-r 1 W (times x' W) w
fold-boltzmann-dominates (suc M') (suc x') W h w =
  transport (λ i → leb (fold-plus-suc-r W (times M' W) i) (plus W (times x' W)) ≡ true)
    (fold-leb-plus-mono W W (suc (times M' W)) (times x' W)
      (fold-leb-refl W)
      (fold-boltzmann-dominates M' x' W h w))
