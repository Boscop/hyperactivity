sta-late-mono-leB : {O0 O1 O2 V : Type} → (d1 d1h : O1 → Nat) → (d2 d2h : O2 → Nat) →
  (env envh : V → Nat) →
  ((u : O1) → leB (d1 u) (d1h u) ≡ true) →
  ((b : O2) → leB (d2 b) (d2h b) ≡ true) →
  ((v : V) → leB (env v) (envh v) ≡ true) →
  (c : Circ O0 O1 O2 V) →
  leB (fold {O0} {O1} {O2} {V} {Nat} (sta-late-alg {O0} {O1} {O2} d1 d2) env c)
      (fold {O0} {O1} {O2} {V} {Nat} (sta-late-alg {O0} {O1} {O2} d1h d2h) envh c) ≡ true
sta-late-mono-leB {O0} {O1} {O2} {V} d1 d1h d2 d2h env envh h1 h2 hv c =
  let A  = sta-late-alg {O0} {O1} {O2} d1 d2
      Ah = sta-late-alg {O0} {O1} {O2} d1h d2h
  in case c return (λ w → leB (fold {O0} {O1} {O2} {V} {Nat} A env w) (fold {O0} {O1} {O2} {V} {Nat} Ah envh w) ≡ true) of
       cwire v → hv v
       cop0 k → refl
       cop1 u a → leB-plus (d1 u) (d1h u) (fold {O0} {O1} {O2} {V} {Nat} A env a) (fold {O0} {O1} {O2} {V} {Nat} Ah envh a) (h1 u) (rec a)
       cop2 b x y →
         leB-plus (d2 b) (d2h b)
           (maxN (fold {O0} {O1} {O2} {V} {Nat} A env x) (fold {O0} {O1} {O2} {V} {Nat} A env y))
           (maxN (fold {O0} {O1} {O2} {V} {Nat} Ah envh x) (fold {O0} {O1} {O2} {V} {Nat} Ah envh y))
           (h2 b)
           (leB-max
             (fold {O0} {O1} {O2} {V} {Nat} A env x) (fold {O0} {O1} {O2} {V} {Nat} Ah envh x)
             (fold {O0} {O1} {O2} {V} {Nat} A env y) (fold {O0} {O1} {O2} {V} {Nat} Ah envh y)
             (rec x) (rec y))
