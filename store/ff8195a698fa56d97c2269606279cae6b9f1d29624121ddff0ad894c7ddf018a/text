-- ---------------------------------------------------------------- 1. dynamic / reshaping signatures
-- a dynamic signature: interface states I, a Sig at each i : I, and how (c, r) reshapes i
DynSig : Type (lsuc lzero)
DynSig = (I : Type) × (S : I → Sig) × ((i : I) → (c : Cmd (S i)) → Resp (S i) c → I)
