-- the work at a public name, kept per module hash (s-mod-kept) so unchanged works stay cached across root updates
s-public : List Word → Sum Unit Work → Proc W (List Word)
s-public st (inl u) = ret {lzero} {W} (s-respond "404 Not Found" s-html s-not-found)
s-public st (inr (work n k p)) = s-mod-kept st "page" p (if h-ends ".cub" p then s-essay p else s-doc p)
