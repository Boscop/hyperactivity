-- = n(l ⊕ r)!, by cancellation of the two child factorials; log₂(n!) is independent of the tree
stree-interleavings-fact : (t : SumTree) → stree-interleavings t ≡ fact (stree-size t)
stree-interleavings-fact stree-one = λ k → suc zero
stree-interleavings-fact (stree-plus l r) =
  transN (λ k → times (times (interleavings (stree-size l) (stree-size r)) (stree-interleavings-fact l k)) (stree-interleavings-fact r k))
    (ilv-fact (stree-size l) (stree-size r))
