-- Exact binomial coefficient C(n, k) for counting projection-neutral horizon punctures
-- Σ_{i=1}^{2k} m_i = 0 (m_i = ±1/2) on a quantum horizon S².
lqg-binom : Nat → Nat → Nat
lqg-binom n k = case k of
  zero → 1
  suc k' → (case n of
    zero → 0
    suc n' → plus (lqg-binom n' k') (lqg-binom n' (suc k')))
