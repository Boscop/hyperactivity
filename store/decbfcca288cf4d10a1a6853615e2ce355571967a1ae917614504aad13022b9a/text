grid-col-zz-ok : (prev : List Word) → (rows : List (List Word)) → grid-col-zz-dec prev (grid-col-zz-enc prev rows) ≡ rows
grid-col-zz-ok prev rows =
  (case rows return (λ u → (p : List Word) → grid-col-zz-dec p (grid-col-zz-enc p u) ≡ u) of
     nil → λ p i → nil
     cons row r → λ p →
       let pq : zip-zz-dec p (zip-zz-enc p row) ≡ row
           pq = zip-zz-ok p row
       in λ i → cons (pq i) (concat {lzero} {List (List Word)}
                               {grid-col-zz-dec (zip-zz-dec p (zip-zz-enc p row)) (grid-col-zz-enc row r)}
                               {grid-col-zz-dec row (grid-col-zz-enc row r)} {r}
                               (λ j → grid-col-zz-dec (pq j) (grid-col-zz-enc row r))
                               (rec r row) i)) prev
