-- a value arrives at a wire, by what waited there
k-put-val : KSlot → Word → KVal → KState → KState
k-put-val ks-none w v (k-state sl rd n) = k-state (ksl-cons w (ks-val v) sl) rd n
k-put-val (ks-op o) w v (k-state sl rd n) = k-state (k-del sl w) (kp-cons o v rd) n
k-put-val (ks-readers os) w v (k-state sl rd n) = k-state (k-set sl w (ks-val v)) (k-wake os w rd) n
k-put-val (ks-val u) w v st = st
