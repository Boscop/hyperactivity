expand-lam-cell : List MTerm → List MTerm → MTerm → List MTerm
expand-lam-cell pre suf mempty = cons mempty nil
expand-lam-cell pre suf (mlit a) = cons (mlit a) nil
expand-lam-cell pre suf (mref k) = cons (mref k) nil
expand-lam-cell pre suf (mapp tid arg) =
  %welimP (λ _ → List MTerm) tid
    (list-append pre (list-append (mterm-unpack-list (mterm-subst-app (mterm-pack-list pre) (mterm-pack-list suf) arg)) suf))
    (λ n _ → cons (mapp n (mterm-subst-app (mterm-pack-list pre) (mterm-pack-list suf) arg)) nil)
expand-lam-cell pre suf (mcat l r) =
  cons (mcat (mterm-subst-app (mterm-pack-list pre) (mterm-pack-list suf) l)
             (mterm-subst-app (mterm-pack-list pre) (mterm-pack-list suf) r)) nil
