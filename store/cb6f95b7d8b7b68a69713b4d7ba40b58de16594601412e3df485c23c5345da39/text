cs-hy-div-at : (z : Bool) (hp : CsHeap) (a b : Word) → (%weq b #0 ≡ z) →
  cs-no-ub (if z then cso-ok hp (csv-word #0) else cs-prim-res hp (cs-c11-div a b)) ≡ true
cs-hy-div-at true hp a b hb = refl
cs-hy-div-at false hp a b hb =
  cong (λ z → cs-no-ub (cs-prim-res hp (if z then csp-ub else csp-ok (%wdiv a b)))) hb
