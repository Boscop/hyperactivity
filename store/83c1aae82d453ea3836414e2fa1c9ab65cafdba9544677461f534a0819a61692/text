-- ---------------------------------------------------------------- the longest common prefix
-- the number of tokens two suffixes begin with in common
lcp : List (List Word) → List (List Word) → Nat
lcp xs ys =
  (case xs return λ w → List (List Word) → Nat of
     nil → λ ys → zero
     cons a r → λ ys → case ys of nil → zero; cons b s → if tok-eq a b then suc (rec r s) else zero) ys
