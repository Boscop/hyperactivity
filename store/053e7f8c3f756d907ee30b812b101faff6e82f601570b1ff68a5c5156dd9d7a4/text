-- a module published: its text when the source holds it, else its removal, from the pointer kept
h-publish-answer : List Word → List Word → Sum Unit (List Word) → Proc W Bool
h-publish-answer st path r = bind (h-unlink (h-before-of st path)) (λ u →
  if weq (h-status r) #200 then ret {lzero} {W} true
  else bind (h-say (h-line (list-append path (list-append " was changed on the served source since this session had it; the session now holds the server's, and this change is not published: write it again"
    (if weq (h-status r) #0 then " (the server cannot be reached)" else ""))))) (λ u2 → ret {lzero} {W} false))
