-- the handedness of the medium decides, at a fixed temperature and instrument
sp-handedness-decides : count-in sp-glycerol (sit-room 0) ≡ count-in sp-glycerol (sit-room-chiral 0) → Empty
sp-handedness-decides q = transport (λ i → isTrue (eqb 3 ((concat (sym sp-glc-achiral) (concat q sp-glc-chiral)) i))) unit
