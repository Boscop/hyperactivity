-- at a node, the comparison read from the bytes is the order's
si-node-cmp : (n : Nat) → (B : Bytes n) → (T : List (List Word)) → (p : Word) → (o0 : Word) → si-rep n B o0 T → si-tab n B p o0 T →
  (c : List (List Word)) → (x : El entry-ord) → si-keyok T x → (kb : Word) → kb ≡ snd x →
  si-cmp n B c (si-rd4 n B (si-slot p kb)) ≡ leq {entry-ord} (c , #0) x
si-node-cmp n B T p o0 hr ht c x hk kb e =
  concat (cong (λ z → si-cmp n B c (si-rd4 n B (si-slot p z))) e)
    (concat (si-cmp-ok n B c (si-rd4 n B (si-slot p (snd x))) (si-drop (snd x) T)
               (si-tab-at n B T p o0 hr ht (snd x) (subst {_} {_} {List (List Word)} {si-cons} (fst hk) (snd hk))))
       (concat (cong (lexle (lexle word-le) c) (sym (fst hk))) (sym (si-key c x))))
