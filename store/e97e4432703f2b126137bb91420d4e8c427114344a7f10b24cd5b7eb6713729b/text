xp-complete : {J : List XpTy × XpExpr × XpTy} → XpDer J → xp-infer (fst J) (fst (snd J)) ≡ inl (snd (snd J))
xp-complete (xd-var g n a h) = h
xp-complete (xd-num g n) = λ k → inl xt-nat
xp-complete (xd-plus g a b da db) = xp-plus-path g a b (xp-complete da) (xp-complete db)
xp-complete (xd-pair g a b A B da db) = xp-pair-path g a b A B (xp-complete da) (xp-complete db)
xp-complete (xd-fst g p A B dp) = xp-fst-path g p A B (xp-complete dp)
xp-complete (xd-snd g p A B dp) = xp-snd-path g p A B (xp-complete dp)
