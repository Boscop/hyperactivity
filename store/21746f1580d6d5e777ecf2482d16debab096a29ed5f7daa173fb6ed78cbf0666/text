-- the instruction table: 01 pushes the input; 02 b pushes b (a truncated 02 faults); 03 pops b and a
-- and pushes a ⊕ b (underflow faults); ff halts; every other byte faults
sm-push-const : List Byte → Nat → List Byte → Byte → SmState
sm-push-const nil pc S x = (pc , S , x , sm-fault)
sm-push-const (cons b r) pc S x = (suc (suc pc) , cons b S , x , sm-running)
