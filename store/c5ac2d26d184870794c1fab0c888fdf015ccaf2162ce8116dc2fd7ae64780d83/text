-- F = c − r_1 at R, p, A: the radial chain started at [0, 1] at n = N
f-val : List Bool → List Bool → IV → IV → IV → Nat → IV × Bool
f-val S S2 R p a N = (iv-sub (fst (ieval S S2 (env3 R p a) c-ie)) (fst (irun S S2 (rad-env S p (fst (ieval S S2 (env3 R p a) sig-ie)) (fst (ieval S S2 (env3 R p a) c-ie))) rad-step N (iv-unit S , true))) ,
  both (both (snd (ieval S S2 (env3 R p a) sig-ie)) (snd (ieval S S2 (env3 R p a) c-ie)))
       (snd (irun S S2 (rad-env S p (fst (ieval S S2 (env3 R p a) sig-ie)) (fst (ieval S S2 (env3 R p a) c-ie))) rad-step N (iv-unit S , true))))
