-- Exact cell count preservation: placing N standard-cell widths emits N placed cell rectangles
place-row-len : (y0 h gap : Nat) → (ws : List Nat) → (xCur : Nat) →
  list-length (place-row xCur y0 h gap ws) ≡ list-length ws
place-row-len y0 h gap nil = λ xCur _ → zero
place-row-len y0 h gap (cons w ws) = λ xCur i → suc (place-row-len y0 h gap ws (plus gap (plus w xCur)) i)
