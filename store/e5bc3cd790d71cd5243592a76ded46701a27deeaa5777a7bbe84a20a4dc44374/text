hy-pack-make : Sum Unit (List Word) → Proc W Word
hy-pack-make (inl u) = h-run (cons "/bin/sh" (cons "-c" (cons "COPYFILE_DISABLE=1 tar -czf build/pack.tgz store" nil)))
hy-pack-make (inr x) = h-run (cons "/bin/sh" (cons "-c" (cons "find store -newer ./.cubical-store/sent-marker -type f > build/pack.files && if [ -s build/pack.files ]; then COPYFILE_DISABLE=1 tar -czf build/pack.tgz -T build/pack.files; else COPYFILE_DISABLE=1 tar -czf build/pack.tgz store/ROOT/root; fi" nil)))
