-- *italic*: a star not after a word character or a star, a run without a star, a star not before a
-- word character or a star
md-ital-c : (Bool → Word → List Word → List Word) → Bool → List Word → List Word → List Word
md-ital-c k lk a nil = list-append "<i>" (list-append (k lk #32 a) "</i>")
md-ital-c k lk a (cons z c) = if h-not (orB (s-word z) (weq z #42)) then list-append "<i>" (list-append (k lk #32 a) (list-append "</i>" (k lk #42 (cons z c)))) else cons #42 (k lk #42 (list-append a (cons #42 (cons z c))))
