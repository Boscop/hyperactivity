cs-eval-switch : (CsHeap → CsEnv → CsExp → CsRes) → CsHeap → CsEnv → CsVal → Word → CsExp → CsRes
cs-eval-switch ev hp env ptr tag cs-br-nil = cs-abort
cs-eval-switch ev hp env ptr tag (cs-br-cons k d nf body rest) =
  if %weq tag k
    then cs-bind-opt (cs-bind-fields hp ptr d zero (toNat nf) env) (λ env1 → ev hp env1 body)
    else cs-eval-switch ev hp env ptr tag rest
cs-eval-switch ev hp env ptr tag other = cs-ub
