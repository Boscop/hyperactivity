run-to-runs : (stp : X86Step) → (stop k : Word) → (s2 : X86) → weq (x86-rip s2) stop ≡ true →
              (s : X86) → Runs stp stop k s s2 → (n : Word) → RunTo (run-to stp n stop s) s2
run-to-runs stp stop k s2 h =
  %welimP (λ v → (s : X86) → Runs stp stop v s s2 → (n : Word) → RunTo (run-to stp n stop s) s2) k
    (λ s p n → inr (subst {lzero} {lzero} {X86} {λ x → run-to stp n stop x ≡ some s2} (sym p) (at-stop stp stop s2 h n)))
    (λ j ih → run-to-runs-step stp stop j s2 ih)
