bn-default-accepted-json : List Word → Word → List Word
bn-default-accepted-json payTo20 val6 =
  let extraObj = h-concat (cons "{" (cons (bn-jkv "name" "USD Coin" ",") (cons (bn-jkv "version" "2" "}") nil)))
  in h-concat
       (cons "{"
       (cons (bn-jkv "scheme" "exact" ",")
       (cons (bn-jkv "network" "eip155:8453" ",")
       (cons (bn-jkv "amount" (h-decimal val6) ",")
       (cons (bn-jkv "asset" "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913" ",")
       (cons (bn-jkv "payTo" (eth-eip55-from-bytes20 payTo20) ",")
       (cons (bn-jraw "maxTimeoutSeconds" "300" ",")
       (cons (bn-jraw "extra" extraObj "}") nil))))))))
