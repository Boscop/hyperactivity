-- 3. Exact Jacobi Identity for Thiemann's Nested Commutators [H_E, [V, h]]
-- ============================================================================
-- For V = diag(v1, v2), H_E = [[a, b], [c, d]], h = [[h0, h1], [h2, h3]] (10 variables),
-- check the (1,2) entry of [H_E, [V, h]] + [V, [h, H_E]] + [h, [H_E, V]] = 0.
lqg-m2-c11 : (A : Type) → (A → A → A) → (A → A → A) → (A → A → A) →
             A → A → A → A → A → A → A → A → A
lqg-m2-c11 A ad sub mu a0 a1 a2 a3 b0 b1 b2 b3 =
  sub (ad (mu a0 b0) (mu a1 b2)) (ad (mu b0 a0) (mu b1 a2))
