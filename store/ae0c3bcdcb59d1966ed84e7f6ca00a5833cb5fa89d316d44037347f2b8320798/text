nk-stuck-cs-wf : (ins : NkEnv) (h : Word) (cs : NkTm) (aux : NkEnv) (out : NkW) (v : NkVal) (n : NkW) →
  (nk-env-in-set ins n (nk-s n) aux ≡ true) →
  nk-out-ok ins (nke-cons out nke-nil) n n (nk-stuckm-at h n out (nk-build cs aux out (nk-plan-of (nkf-val n v nkf-nil) (nk-s n)))) ≡ true
nk-stuck-cs-wf ins h cs aux out v n haux =
  let outs = nke-cons out nke-nil
      sn = nk-s n
      rn = nk-in-range-self n n (nk-wire-le-refl n)
      fx0 = nkf-val n v nkf-nil
      hfx0 = nk-and-intro (nk-in-set outs n sn n) true (nk-in-set-range outs n sn n rn) refl
      ho0 = nk-out-ok-intro ins outs n sn fx0 sn nke-nil (nk-wire-le-refl sn) hfx0 refl
      hb = nk-build-wf cs ins outs n aux out (nk-plan-of fx0 sn) (nk-wire-le-s n) haux (nk-in-set-hd out nke-nil n sn) ho0
  in nk-stuckm-at-wf ins h n out (nk-build cs aux out (nk-plan-of fx0 sn)) hb
