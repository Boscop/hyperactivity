-- ---------------------------------------------------------------- the invariants: the kernel of the total J+
-- the entry of the total J+ from weight-zero monomial s to weight-one monomial t: Σ_I (d_I − s_I) where t = s + e_I
jp-entry : List Nat → Nat → Nat → List Nat → List Nat → SQ
jp-entry ds f i t s = case f of
  zero → sq-zero
  suc g → sq-plus (if exp-eq t (exp-up i s) then sq-nat (monus (exp-at i ds) (exp-at i s)) else sq-zero) (jp-entry ds g (suc i) t s)
