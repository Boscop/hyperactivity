-- CCastKind: Clang's cast kinds met
data CCastKind =
    ck-LValueToRValue
  | ck-NoOp
  | ck-FunctionToPointerDecay
  | ck-ArrayToPointerDecay
  | ck-IntegralCast
  | ck-IntegralToBoolean
  | ck-BitCast
  | ck-DerivedToBase
  | ck-UncheckedDerivedToBase
  | ck-NullToPointer
  | ck-ToVoid
  | ck-BuiltinFnToFnPtr
  | ck-ConstructorConversion
  | ck-PointerToBoolean
  | ck-NullToMemberPointer
  | ck-UserDefinedConversion
  | ck-IntegralToFloating
  | ck-FloatingToIntegral
  | ck-FloatingCast
  | ck-BaseToDerived
  | ck-Dynamic
