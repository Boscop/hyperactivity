os-entry : List Word × (List Word × (Word × Word)) → Proc W (Sum (List Word) (List (List Word × List Word)))
os-entry e =
  if h-prefix "store/entries/" (fst e) then bind (h-read (fst e)) (os-bound e) else
  if os-presentation (fst e) then ret {lzero} {W} (inl (list-append (fst e) ": a stored presentation; it is computed from its value")) else
  if h-not (os-prose (fst e)) then ret {lzero} {W} (inr nil) else
  os-staged e (bind (h-read (fst e)) (os-keyed (fst e)))
