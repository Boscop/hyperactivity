replace : Pos → ETm → ETm → ETm
replace p r t =
  case p return (λ w → ETm → ETm) of
    here → λ t → r
    pl q → λ t → (case t return (λ w → ETm) of etv v → etv v; etc f → etc f; eapp a b → eapp (rec q a) b)
    pr q → λ t → (case t return (λ w → ETm) of etv v → etv v; etc f → etc f; eapp a b → eapp a (rec q b))
  t
