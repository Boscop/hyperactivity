ha-kv : List Word → Word → List Word → List Word
ha-kv k v rest = list-append hw-q (list-append k (list-append hw-q (list-append ":" (list-append (ce-dec v) rest))))

-- Scratch layout at st (56 bytes = 7 words):
--   +0: dmods, +8: proven_pure, +16: unproven_exec, +24: foreign_trust_gap,
--   +32: total_decls, +40: proof_lines, +48: foreign_lines
ha-scan-root : List (List Word × List Word) → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
ha-scan-root nil _ _ _ _ k = k #0
ha-scan-root (cons e r) idx pbuf buf st k =
  let phex = fst e
      mh   = snd e
  in if cli-eq phex "names" then ha-scan-root r idx pbuf buf st k
     else
       let path = hhf-unhex phex
       in if hhf-is-domain path then
            hhf-maybe-rew idx (λ _ →
            scmd (w-file-read-named (list-append "store/" (list-append mh "/module"))) (λ rm →
            let chs = hhf-split-lines (snd rm) nil
            in ha-scan-chunks chs pbuf buf #0 #0 #0 (λ dc pc fc →
               let cls = ha-status (%wlt #0 fc) (%wlt #0 pc)
               in scmd (w-load st) (λ dm →
                  scmd (w-load (%wadd st #8)) (λ pm →
                  scmd (w-load (%wadd st #16)) (λ um →
                  scmd (w-load (%wadd st #24)) (λ fm →
                  scmd (w-load (%wadd st #32)) (λ td →
                  scmd (w-load (%wadd st #40)) (λ tp →
                  scmd (w-load (%wadd st #48)) (λ tf →
                  scmd (w-store st (%wsucc dm)) (λ _ →
                  scmd (w-store (%wadd st #8)  (if %weq cls #0 then %wsucc pm else pm)) (λ _ →
                  scmd (w-store (%wadd st #16) (if %weq cls #1 then %wsucc um else um)) (λ _ →
                  scmd (w-store (%wadd st #24) (if %weq cls #2 then %wsucc fm else fm)) (λ _ →
                  scmd (w-store (%wadd st #32) (%wadd td dc)) (λ _ →
                  scmd (w-store (%wadd st #40) (%wadd tp pc)) (λ _ →
                  scmd (w-store (%wadd st #48) (%wadd tf fc)) (λ _ →
                  ha-scan-root r (%wsucc idx) pbuf buf st k)))))))))))))))))
          else ha-scan-root r idx pbuf buf st k

ha-fin : Word → Word → List Word → Word → Word → Step W Word
ha-fin pbuf buf rh st t0 =
  scmd (w-sys #901 #0 #0 #0 #0 #0 #0) (λ _ →
  scmd (w-free pbuf) (λ _ →
  scmd (w-free buf) (λ _ →
  scmd (w-load st) (λ dm →
  scmd (w-load (%wadd st #8)) (λ pm →
  scmd (w-load (%wadd st #16)) (λ um →
  scmd (w-load (%wadd st #24)) (λ fm →
  scmd (w-load (%wadd st #32)) (λ td →
  scmd (w-load (%wadd st #40)) (λ tp →
  scmd (w-load (%wadd st #48)) (λ tf →
  scmd (w-free st) (λ _ →
  scmd (w-file-write-named "/tmp/hy_out/hx_auto_proofs.hypercubical" ha-auto-proofs-src) (λ ab →
  let summary =
        list-append "{" (ha-kv "domain_mods" dm
        (list-append "," (ha-kv "proven_pure" pm
        (list-append "," (ha-kv "unproven_exec" um
        (list-append "," (ha-kv "foreign_trust_gap" fm
        (list-append "," (ha-kv "total_decls" td
        (list-append "," (ha-kv "eq_proof_lines" tp
        (list-append "," (ha-kv "foreign_lines" tf
        (list-append "," (ha-kv "auto_proofs_bytes" ab (list-append "}" ce-nl))))))))))))))))
  in scmd (w-file-write-named "/tmp/hy_out/hx_obligations.json" summary) (λ _ →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-AUDIT ROOT=" (list-append rh
       (list-append " domain_mods=" (list-append (ce-dec dm)
       (list-append " proven_pure=" (list-append (ce-dec pm)
       (list-append " unproven_exec=" (list-append (ce-dec um)
       (list-append " foreign_trust_gap=" (list-append (ce-dec fm)
       (list-append " decls=" (list-append (ce-dec td)
       (list-append " eq_lines=" (list-append (ce-dec tp)
       (list-append " foreign_lines=" (list-append (ce-dec tf)
       (list-append " auto_proofs=" (list-append (ce-dec ab)
       (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))))))))))))))))
       (sdone #0)))))))))))))))

ha-root-arg : List (List Word) → List Word → List Word
ha-root-arg nil def = def
ha-root-arg (cons a _) _ = a

ha-zero-st : Word → (Unit → Step W Word) → Step W Word
ha-zero-st st k =
  scmd (w-store st #0) (λ _ →
  scmd (w-store (%wadd st #8) #0) (λ _ →
  scmd (w-store (%wadd st #16) #0) (λ _ →
  scmd (w-store (%wadd st #24) #0) (λ _ →
  scmd (w-store (%wadd st #32) #0) (λ _ →
  scmd (w-store (%wadd st #40) #0) (λ _ →
  scmd (w-store (%wadd st #48) #0) k))))))

ha-fin-k : Word → Word → List Word → Word → Word → Word → Step W Word
ha-fin-k pbuf buf rh st t0 _ = ha-fin pbuf buf rh st t0

ha-main : List (List Word) → Step W Word
ha-main args =
  scmd w-now (λ t0 →
  scmd (w-file-read-named "store/ROOT/root") (λ rr →
  let rh = ha-root-arg args (hhf-trim (snd rr))
  in scmd (w-file-read-named (list-append "store/" (list-append rh "/root"))) (λ rt →
     let rmap = hm-parse (snd rt)
     in scmd (w-alloc #512) (λ pbuf →
        scmd (w-alloc #262144) (λ buf →
        scmd (w-alloc #64) (λ st →
        ha-zero-st st (λ _ →
        let fin = ha-fin-k pbuf buf rh st t0
        in scmd (w-sys #900 #0 #0 #0 #0 #0 #0) (λ _ →
           ha-scan-root rmap #0 pbuf buf st fin))))))))

ha-c : List Word
ha-c = emit-c-cli-opt (code ha-main)
