ha-mob1 : Bool × Bool → Bool × Bool
ha-mob1 p = (fst p , web-xorB (fst p) (snd p))

ha-lem-xor-cancel-l : (a b : Bool) → web-xorB a (web-xorB a b) ≡ b
ha-lem-xor-cancel-l true  true  = refl
ha-lem-xor-cancel-l true  false = refl
ha-lem-xor-cancel-l false true  = refl
ha-lem-xor-cancel-l false false = refl

ha-thm-mob1-inv : (p : Bool × Bool) → ha-mob1 (ha-mob1 p) ≡ p
ha-thm-mob1-inv p = λ i → (fst p , ha-lem-xor-cancel-l (fst p) (snd p) i)

-- Complete 1-Cell WEquiv proving the Fast Mobius Butterfly is a Self-Inverse Lossless Transport!
ha-equiv-mob1 : WEquiv (Bool × Bool) (Bool × Bool)
ha-equiv-mob1 = (ha-mob1 , (ha-mob1 , (ha-thm-mob1-inv , ha-thm-mob1-inv)))

ha-xor-zip : List Bool → List Bool → List Bool
ha-xor-zip nil         bs          = bs
ha-xor-zip (cons _ _)  nil         = nil
ha-xor-zip (cons a ra) (cons b rb) = cons (web-xorB a b) (ha-xor-zip ra rb)

-- UNIVERSAL INVOLUTION OVER ARBITRARY-WIDTH BIT-VECTORS!
ha-thm-xor-zip-inv : (a b : List Bool) → ha-xor-zip a (ha-xor-zip a b) ≡ b
ha-thm-xor-zip-inv nil         b           = refl
ha-thm-xor-zip-inv (cons _ _)  nil         = refl
ha-thm-xor-zip-inv (cons a ra) (cons b rb) = λ i → cons (ha-lem-xor-cancel-l a b i) (ha-thm-xor-zip-inv ra rb i)

