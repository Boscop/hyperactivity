-- SECTION 5: PROOF-CARRYING AUDIT CLASSIFIER + PURE-SYMBOLIC PROOF SYNTHESIZER
-- ============================================================================
-- 0 = PROVEN_PURE, 1 = UNPROVEN_EXEC, 2 = FOREIGN_TRUST_GAP
ha-status : Bool → Bool → Word
ha-status hasForeign hasProof =
  if hasForeign then #2 else if hasProof then #0 else #1

ha-thm-foreign-never-hidden : (hasProof : Bool) → ha-status true hasProof ≡ #2
ha-thm-foreign-never-hidden true  = refl
ha-thm-foreign-never-hidden false = refl

ha-thm-unproven-flagged : ha-status false false ≡ #1
ha-thm-unproven-flagged = refl

ha-thm-proven-pure : ha-status false true ≡ #0
