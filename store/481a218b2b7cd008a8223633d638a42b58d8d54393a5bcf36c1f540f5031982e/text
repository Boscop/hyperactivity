ha-f2-dot : List Bool → List Bool → Bool
ha-f2-dot nil         _           = false
ha-f2-dot (cons _ _)  nil         = false
ha-f2-dot (cons x rx) (cons r rr) = web-xorB (web-andB x r) (ha-f2-dot rx rr)

ha-lem-f2-step : (x a b d1 d2 : Bool) →
  web-xorB (web-andB x (web-xorB a b)) (web-xorB d1 d2) ≡ web-xorB (web-xorB (web-andB x a) d1) (web-xorB (web-andB x b) d2)
ha-lem-f2-step true  true  true  true  true  = refl
ha-lem-f2-step true  true  true  true  false = refl
ha-lem-f2-step true  true  true  false true  = refl
