-- Structural equality decider on INet (proved sound via kir-weq-eq!)
in-eq : INet → INet → Bool
in-eq (in-wire i)      (in-wire j)      = %weq i j
in-eq in-era           in-era           = true
in-eq (in-con t1 a1 b1) (in-con t2 a2 b2) = web-andB (%weq t1 t2) (web-andB (in-eq a1 a2) (in-eq b1 b2))
in-eq (in-dup l1 a1 b1) (in-dup l2 a2 b2) = web-andB (%weq l1 l2) (web-andB (in-eq a1 a2) (in-eq b1 b2))
in-eq _                _                = false
