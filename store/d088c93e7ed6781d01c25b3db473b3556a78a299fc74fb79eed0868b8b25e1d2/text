kv-put-view : KvCli → KvWrite → Nat → NView KvMsg KvCli
kv-put-view c w zero = v-send 0 (m-put w) (kv-set-ph c (ph-put w 1))
kv-put-view c w (suc zero) = v-send 1 (m-put w) (kv-set-ph c (ph-put w 2))
kv-put-view c w (suc (suc zero)) = v-send 2 (m-put w) (kv-set-ph c (ph-put w 3))
kv-put-view c w (suc (suc (suc j))) = v-recv (λ r → kv-seq-ack c w r)
