-- 1. GALS Empty-Wire Clock-Gating Theorem: when `pairValid = false`, `clk_en = false` and all active
--    counters + local SRAM `freePtr` remain untouched.
inet-hw-gals-idle-gated : (a c p fp g : Nat) → (ap : InetActPair) →
  (inet-hw-clk-en false ≡ false) ×
  (inet-hw-step (ihw a c p fp g) false ap ≡ ihw a c p fp (suc g))
inet-hw-gals-idle-gated a c p fp g ap = (refl , refl)
