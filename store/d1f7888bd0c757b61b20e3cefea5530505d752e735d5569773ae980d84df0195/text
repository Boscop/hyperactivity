-- J(A, B, C) at α = ap/aq: Σ · (A+B+C+2)! aq^N / (2^{A+B} (2ap)^N), N = A + B + C + 3
he-J : Nat → Nat → Nat → Nat → Nat → BQ
he-J ap aq a b c = bq-mul (he-sum a b c (plus a b)) (bq-make true (bin-mul (he-fact (plus (plus a b) (plus c 2))) (he-pow (bin-of-nat aq) (plus (plus a b) (plus c 3)))) (bin-mul (bin-pow2 (plus a b)) (he-pow (bin-of-nat (times 2 ap)) (plus (plus a b) (plus c 3)))))
