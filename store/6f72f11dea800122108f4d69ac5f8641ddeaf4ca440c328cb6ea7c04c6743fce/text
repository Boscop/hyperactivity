-- Deliverable A: Cold store/<d>/decl + store/<g>/forms parser and DAG crawler
sg-subst-self : Nat → Word → List Word → NkSexp → Lst NkSexp → NkSexp × Lst NkSexp
sg-subst-self zero _ _ e xs = (e , xs)
sg-subst-self (suc k) mode dsym e xs =
  if %weq mode #1 then
    (if %weq (sg-sx-len xs) #0 then (nks-sym nil , lnil)
     else
       let a = fst (sg-subst-self k #0 dsym (sg-sx0 xs) lnil)
           r = snd (sg-subst-self k #1 dsym (nks-sym nil) (sg-sx-tl xs))
       in (nks-sym nil , lcons a r))
  else
    (case e return (λ _ → NkSexp × Lst NkSexp) of
       nks-sym s → (nks-sym (if nk-wlist-eq s "self" then dsym else s) , lnil)
       nks-lst ys → (nks-lst (snd (sg-subst-self k #1 dsym (nks-sym nil) ys)) , lnil))
