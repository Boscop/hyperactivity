-- a response; no cache keeps an old page, so a reader always sees what was last deployed
s-respond : List Word → List Word → List Word → List Word
s-respond status ctype body = list-append (h-concat (cons "HTTP/1.1 " (cons status (cons h-crlf (cons "Content-Type: " (cons ctype (cons h-crlf (cons "Content-Length: " (cons (h-decimal (fromNat (list-length body))) (cons h-crlf (cons "Cache-Control: no-cache" (cons h-crlf (cons "Connection: close" (cons h-crlf (cons h-crlf nil))))))))))))))) body
