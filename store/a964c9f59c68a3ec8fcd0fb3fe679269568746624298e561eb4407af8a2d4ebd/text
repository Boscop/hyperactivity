ok-hdr-raw : (h : TextHdr) → dec-hdr-raw (enc-hdr-raw h) ≡ h
ok-hdr-raw h =
  case h return (λ u → dec-hdr-raw (enc-hdr-raw u) ≡ u) of
    mk-thdr v q m l →
      let p0 = pf2-ok enc-vq dec-vq ok-vq enc-ml dec-ml ok-ml ((v , q) , (m , l)) nil
          p1 : fst (pf2-dec dec-vq dec-ml (pf2-enc enc-vq enc-ml ((v , q) , (m , l)))) ≡ ((v , q) , (m , l))
          p1 = concat {lzero} {(List (List Word) × List (List Word)) × (List (List MTerm) × Opt (List MTerm × List MTerm))}
                 {fst (pf2-dec dec-vq dec-ml (pf2-enc enc-vq enc-ml ((v , q) , (m , l))))}
                 {fst (pf2-dec dec-vq dec-ml (list-append (pf2-enc enc-vq enc-ml ((v , q) , (m , l))) nil))}
                 {((v , q) , (m , l))}
                 (λ i → fst (pf2-dec dec-vq dec-ml (sym (cm-append-nil (pf2-enc enc-vq enc-ml ((v , q) , (m , l)))) i)))
                 (λ i → fst (p0 i))
      in λ i → let r = p1 i in mk-thdr (fst (fst r)) (snd (fst r)) (fst (snd r)) (snd (snd r))
