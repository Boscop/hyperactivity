jp-dbl : JPoint → JPoint
jp-dbl jp-inf        = jp-inf
jp-dbl (jp-pt x y z) =
  if orB (%weq y #0) (%weq z #0) then jp-inf
  else let a  = fp-sqr x
           b  = fp-sqr y
           c  = fp-sqr b
           d  = fp-mul #2 (fp-sub (fp-sqr (fp-add x b)) (fp-add a c))
           e  = fp-mul #3 a
           f  = fp-sqr e
           x3 = fp-sub f (fp-mul #2 d)
           y3 = fp-sub (fp-mul e (fp-sub d x3)) (fp-mul #8 c)
           z3 = fp-mul #2 (fp-mul y z)
       in jp-pt x3 y3 z3
