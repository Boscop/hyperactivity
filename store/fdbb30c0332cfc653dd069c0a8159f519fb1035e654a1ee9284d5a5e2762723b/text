-- x is a prefix of y, each element equal by the order
sq-pre : {A : Type} → (A → A → Bool) → List A → List A → Bool
sq-pre le x = case x return λ w → List A → Bool of
  nil → λ y → true
  cons c r → λ y → case y return λ v → Bool of
    nil → false
    cons d s → andB (andB (le c d) (le d c)) (rec r s)
