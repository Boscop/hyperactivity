-- foldable: the modules held whole by another that no module imports. Each adds no text and nothing
-- reaches it by import. A module a command names by its path is not seen by this and must be excluded
-- before a fold.
hy-hw-paths : List (List Word × List (List Word)) → List (List Word × List (List Word)) → List (List Word)
hy-hw-paths nil all = nil
hy-hw-paths (cons e r) all =
  if h-null (h-concat (snd e)) then hy-hw-paths r all
  else if h-null (hy-hw-in all (fst e) (snd e)) then hy-hw-paths r all
  else cons (fst e) (hy-hw-paths r all)
