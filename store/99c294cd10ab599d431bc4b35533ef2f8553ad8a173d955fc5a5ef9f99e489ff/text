kir-lem-xor-c : (env : Word → Bool) → (a b : WExpr) → (eq : Bool) → (kir-eq a b ≡ eq) →
  web-xorB (weval env a) (weval env b) ≡ weval env (kir-xor-c eq a b)
kir-lem-xor-c env a b true  h =
  web-trans-b (λ k → web-xorB (weval env a) (kir-eq-sound env a b h (~ k))) (web-lem-xor-self (weval env a))
kir-lem-xor-c env a b false _ = ha-lem-mk-xor env a b
