-- THEOREM 3: CLOSURE UNDER ARBITRARY META-PASS COMPOSITION (g o f)
tw-thm-compose-sound : (f g : INet → INet) →
  ((env : Word → Bool) → (n : INet) → in-eval env (f n) ≡ in-eval env n) →
  ((env : Word → Bool) → (n : INet) → in-eval env (g n) ≡ in-eval env n) →
  (env : Word → Bool) → (n : INet) → in-eval env (in-meta-fuse g f n) ≡ in-eval env n
tw-thm-compose-sound f g pf pg env n = web-trans-b (pg env (f n)) (pf env n)
