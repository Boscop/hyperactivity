index-update-if32 : (n : Nat) → (a : Array32 n) → (i j : Nat) → (hi : le (suc i) n) → (hj : le (suc j) n) → (v : UInt32) → index32 n (update32 n a i hi v) j hj ≡ (if eqb i j then v else index32 n a j hj)
index-update-if32 n a i j hi hj v =
  ifP {λ b → index32 n (update32 n a i hi v) j hj ≡ (if b then v else index32 n a j hj)} {eqb i j}
    (λ e → index-update-eq32 n a i j hi hj v (eqb-sound {i} {j} (eq→isTrue {eqb i j} e)))
    (λ e → index-update-ne32 n a i j hi hj v
             (case trich i j of
                inl l → inl l
                inr m → (case m of
                           inl q → Empty-rec (subst {lzero} {lzero} {Bool} {isTrue} {eqb i j} {false} e (eqb-complete {i} {j} q))
                           inr l → inr l)))
