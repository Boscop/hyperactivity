-- a child waited for: its exit status, or 128 and the signal's number when a signal ended it (as a
-- shell reports it), so a killed child never reads as one that succeeded. The status is read through a
-- region of 8 bytes, so the read carries its own proof of fitting (2026-11-18)
h-wait : Word → Proc W Word
h-wait pid = bind (with-region {Word} 8 (λ st → sys-call #61 pid st #0 #0 #0 #0) h-wait-status) (λ s →
  ret (if weq (wand s #127) #0 then wand (wshr s #8) #255 else wadd #128 (wand s #127)))
