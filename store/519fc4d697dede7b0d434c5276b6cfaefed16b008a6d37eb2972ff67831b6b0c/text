-- rust-call t crate fuel image j args
rust-call : Target → RCrate → Word → List RSlot → Word → List RSlot → REv RSlot
rust-call t c fuel img j args =
  let prog = rm-prog-go (cr-instances c) t c
      mkf = rm-frames-go (cr-instances c) t c
  in rm-bind (mkf j img args) (λ fr → rm-run fuel prog mkf img j fr #0)
