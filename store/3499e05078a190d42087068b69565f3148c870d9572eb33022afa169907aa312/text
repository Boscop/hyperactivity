ke-opt : KExpr → KExpr
ke-opt (ke-k c)       = ke-k c
ke-opt (ke-v i)       = ke-v i
ke-opt (ke-not a)     = ke-opt-not (ke-opt a)
ke-opt (ke-xor a b)   = ke-opt-bin ke-xor-op ke-xor (ke-opt a) (ke-opt b)
ke-opt (ke-and a b)   = ke-opt-bin ke-and-op ke-and (ke-opt a) (ke-opt b)
ke-opt (ke-or  a b)   = ke-opt-bin ke-or-op  ke-or  (ke-opt a) (ke-opt b)
ke-opt (ke-add a b)   = ke-opt-bin ke-add32  ke-add (ke-opt a) (ke-opt b)
ke-opt (ke-sub a b)   = ke-opt-bin ke-sub32  ke-sub (ke-opt a) (ke-opt b)
ke-opt (ke-mul a b)   = ke-opt-bin ke-mul32  ke-mul (ke-opt a) (ke-opt b)
ke-opt (ke-rotr a n)  = ke-opt-rotr (ke-opt a) n
ke-opt (ke-ch e f g)  = ke-xor (ke-opt g) (ke-and (ke-opt e) (ke-xor (ke-opt f) (ke-opt g)))
ke-opt (ke-maj a b c) = ke-xor (ke-opt a) (ke-and (ke-xor (ke-opt a) (ke-opt b)) (ke-xor (ke-opt a) (ke-opt c)))
