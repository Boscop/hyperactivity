-- equality of differences is transitive; it survives swapping both sides; a path is one
rearr4 : (a b c d : Nat) → plus (plus a b) (plus c d) ≡ plus (plus c b) (plus a d)
rearr4 a b c d = transN (plus-comm (plus a b) (plus c d)) (transN (plus-assoc c d (plus a b))
  (transN (congN (plus c) (plus-comm d (plus a b))) (transN (congN (plus c) (plus-assoc a b d))
  (transN (congN (plus c) (transN (symN (plus-assoc a b d)) (transN (congN (λ z → plus z d) (plus-comm a b)) (plus-assoc b a d))))
  (symN (plus-assoc c b (plus a d)))))))
