sg-scan-refs : List Word → List Word → Lst (Bool × List Word) → Lst (Bool × List Word)
sg-scan-refs nil cur acc = sg-push-ref cur acc
sg-scan-refs (cons c r) cur acc =
  if orB (nk-is-ws c) (orB (%weq c #40) (%weq c #41))
    then sg-scan-refs r nil (sg-push-ref cur acc)
    else sg-scan-refs r (cons c cur) acc
