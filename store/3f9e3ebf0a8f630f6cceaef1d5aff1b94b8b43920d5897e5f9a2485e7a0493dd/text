-- a body with a free variable replaced by a closed body
nk-sub-fr : Word → NkTm → NkTm → NkTm
nk-sub-fr x e (nk-free y) = if %weq x y then e else nk-free y
nk-sub-fr x e (nk-lam b) = nk-lam (nk-sub-fr x e b)
nk-sub-fr x e (nk-susp b) = nk-susp (nk-sub-fr x e b)
nk-sub-fr x e (nk-con c as) = nk-con c (nk-sub-fr x e as)
nk-sub-fr x e (nk-op h p as) = nk-op h (nk-sub-fr x e p) (nk-sub-fr x e as)
nk-sub-fr x e (nk-match h p cs) = nk-match h (nk-sub-fr x e p) (nk-sub-fr x e cs)
nk-sub-fr x e (nk-cons t r) = nk-cons (nk-sub-fr x e t) (nk-sub-fr x e r)
nk-sub-fr x e t = t
