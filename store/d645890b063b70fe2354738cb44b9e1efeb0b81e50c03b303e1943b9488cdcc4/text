-- THE COUNT IS THE MATRIX'S: two witnesses that pass the check show the same count
inertia-cert-sound : (n : Nat) → (s : it-sym ZrC n) → (ws vs : List (sy-vn ZrC n)) →
  snd (inertia-cert n s ws) ≡ true → snd (inertia-cert n s vs) ≡ true → fst (inertia-cert n s ws) ≡ fst (inertia-cert n s vs)
inertia-cert-sound n s ws vs hw hv =
  it-count-matrix ZrC zrz (zrp zr1) zr-ad zr-mu zr-ng zr-isz zr-neg zr-DL (λ i → true) (λ i → false)
    (λ x → zr-np x ≡ true) (λ x → zr-nn x ≡ true) zr-QN zr-QP zr-both n s ws vs
    (snd (it-and-t (eqb (sy-len (sy-vn ZrC n) ws) n) (it-ok ZrC (sy-vn ZrC n) zr-isz (zr-fm n s) ws) hw))
    (snd (it-and-t (eqb (sy-len (sy-vn ZrC n) vs) n) (it-ok ZrC (sy-vn ZrC n) zr-isz (zr-fm n s) vs) hv))
    (zr-eqb (sy-len (sy-vn ZrC n) ws) n (fst (it-and-t (eqb (sy-len (sy-vn ZrC n) ws) n) (it-ok ZrC (sy-vn ZrC n) zr-isz (zr-fm n s) ws) hw)))
    (zr-eqb (sy-len (sy-vn ZrC n) vs) n (fst (it-and-t (eqb (sy-len (sy-vn ZrC n) vs) n) (it-ok ZrC (sy-vn ZrC n) zr-isz (zr-fm n s) vs) hv)))
