-- 1. Universal Inner-Projection Positivity (Bazley 1959 / Löwdin 1965):
--    For V > 0 with v = ⟨ψ|V|ψ⟩, m = ⟨φ|V⁻¹|φ⟩ > 0, and overlap c = ⟨ψ|φ⟩:
--      m · (v - c²/m) = m·v - c².
--    Writing v = a² + b², m = p² + q², c = a·p + b·q (2-component realization of V^{1/2}ψ, V^{-1/2}φ):
--      (a² + b²)(p² + q²) - (a p + b q)² = (a q - b p)² ≥ 0.
--    Variables (0..3): a, b, p, q.
chem-inner-proj-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-inner-proj-poly A ad mu q vs =
  (λ g sub sq →
    let a = g 0; b = g 1; p = g 2; qv = g 3
        lhs = sub (mu (ad (sq a) (sq b)) (ad (sq p) (sq qv))) (sq (ad (mu a p) (mu b qv)))
        rhs = sq (sub (mu a qv) (mu b p))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
