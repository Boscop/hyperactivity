one-if-mono : {p p' : Bool} → (isTrue p → isTrue p') → (c c' : Nat) → ltn c' c ≡ false → ltn (plus (one-if p') c') (plus (one-if p) c) ≡ false
one-if-mono imp c c' e =
  (case p return λ y → (isTrue y → isTrue p') → ltn (plus (one-if p') c') (plus (one-if y) c) ≡ false of
     true → λ imp → (case p' return λ z → isTrue z → ltn (plus (one-if z) c') (suc c) ≡ false of true → λ u → e; false → λ u → Empty-rec u) (imp unit)
     false → λ imp → (case p' return λ z → ltn (plus (one-if z) c') c ≡ false of true → ltn-suc-false c' c e; false → e)) imp
