h-dir-chunks : (List Word → Proc W Word) → List Word → Word → Word → Word → Nat → Proc W Word
h-dir-chunks rec path fd buf acc zero = ret acc
h-dir-chunks rec path fd buf acc (suc k) =
  bind (sys-call #217 fd buf #65536 #0 #0 #0) (λ n →
  if andB (wlt #0 n) (wlt n #9223372036854775808)
  then bind (h-entries-time rec path buf #0 n (toNat (wquot n #20))) (λ t → h-dir-chunks rec path fd buf (h-wmax acc t) k)
  else ret {lzero} {W} acc)
