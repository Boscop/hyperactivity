chem-thermo-cycle-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-thermo-cycle-poly A ad mu q vs =
  (λ g sub →
    let eBm = g 0; eBw = g 1; eAm = g 2; eAw = g 3
        dM = g 4; dW = g 5; dB = g 6; dA = g 7
        dGB = sub (ad (ad eBm dM) dB) (ad (ad eBw dW) dB)
        dGA = sub (ad (ad eAm dM) dA) (ad (ad eAw dW) dA)
        lhs = sub dGB dGA
        rhs = sub (sub eBm eBw) (sub eAm eAw)
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
