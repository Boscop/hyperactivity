sy-page : List Word → Bool → List Word
sy-page t units = h-concat (cons "<!doctype html><html class='syn-page' lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>synthetic synesthesia · Avik Jain</title><style>*{box-sizing:border-box} body{margin:0;background:#000;color:#fff;font:500 26px/1.6 ui-sans-serif,-apple-system,system-ui,sans-serif} main{max-width:900px;margin:0 auto;padding:28px 18px 60px} textarea{width:100%;font:16px ui-sans-serif,-apple-system,system-ui,sans-serif;background:#000;color:#fff;border:1px solid #444;border-radius:8px;padding:8px} main button{font:15px ui-sans-serif,-apple-system,system-ui,sans-serif;background:#000;color:#fff;border:1px solid #666;border-radius:8px;padding:6px 12px;margin:8px 8px 20px 0;cursor:pointer} .t{white-space:pre-wrap;overflow-wrap:break-word}</style></head><body><!--HX:NAV--><main><form method='get' action='/synesthesia'><textarea name='text' rows='3'>" (cons (s-esc t) (cons "</textarea><br><button name='units' value='1'>units by first letter</button><button name='units' value='0'>letter by letter</button></form><div class='t'>" (cons (if units then sy-units nil t else sy-letters t) (cons "</div></main></body></html>" nil)))))
