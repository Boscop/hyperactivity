dm-awaken-fleet-go : List DmPod → Proc W (Word × (Word × List Word))
dm-awaken-fleet-go nil         = ret {lzero} {W} (#0 , (#0 , nil))
dm-awaken-fleet-go (cons p ps) =
  bind (dm-inject-pod p) (λ rP →
  bind (dm-awaken-fleet-go ps) (λ rRest →
    ret {lzero} {W}
      ( %wadd (fst rP) (fst rRest)
      , (%wadd (fst (snd rP)) (fst (snd rRest)) , list-append (snd (snd rP)) (snd (snd rRest))))))
