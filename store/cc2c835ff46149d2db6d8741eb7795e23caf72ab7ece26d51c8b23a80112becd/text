-- rm-rv-val cx rvalue type-of-the-destination
rm-rv-val : RCx → RRvalue → RTy → RFrame → REv RV
rm-rv-val cx rv dty = case rv of
  rrv-use op rt → rm-opd-rv cx op
  rrv-repeat op n → λ fr → rm-throw (rx-ill-formed ri-operand-class)
  rrv-ref k p → rm-ref-of cx p dty
  rrv-raw-ptr m p → rm-ref-of cx p dty
  rrv-cast k op ty → rm-cast cx k op dty
  rrv-binop o a b → rm-binop-rv cx o a b
  rrv-unop o a → rm-unop-rv cx o a
  rrv-discriminant p → rm-discr-rv cx p dty
  rrv-aggregate k ops → rm-agg-rv cx k ops
