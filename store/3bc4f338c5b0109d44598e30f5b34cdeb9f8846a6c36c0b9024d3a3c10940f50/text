-- Universal Kraft Inequality: for EVERY finite binary prefix-free code, sum_i 2^(D - l_i) <= 2^D
kraft-inequality : (D : Nat) → (t : PartialTree) → PDepthOk D t →
                   leB (kraft-partial D t) (opt-pow2 D) ≡ true
kraft-inequality D pempty _ = refl
kraft-inequality D pfull  _ = opt-le-refl (opt-pow2 D)
kraft-inequality zero (pbranch l r) e = Empty-rec e
kraft-inequality (suc k) (pbranch l r) h =
  opt-le-plus (kraft-partial k l) (opt-pow2 k) (kraft-partial k r) (opt-pow2 k)
    (kraft-inequality k l (fst h)) (kraft-inequality k r (snd h))
