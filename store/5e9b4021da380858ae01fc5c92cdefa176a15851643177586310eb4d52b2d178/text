cs-compile-closed-no-ub : (k : Nat) (fns : CsFns) (ars : Lst (Word × Word))
  (hp : CsHeap) (cenv : CsEnv) (c : Code) (mv : CsMVal) →
  (cs-code-eval k lnil c ≡ csom-some mv) →
  cs-no-ub (cs-eval k fns hp cenv (cs-compile k ars #0 c)) ≡ true
cs-compile-closed-no-ub k fns ars hp cenv c mv hev =
  cs-res-rel-no-ub mv (cs-eval k fns hp cenv (cs-compile k ars #0 c))
    (cs-compile-closed-sound k fns ars hp cenv c mv hev)
