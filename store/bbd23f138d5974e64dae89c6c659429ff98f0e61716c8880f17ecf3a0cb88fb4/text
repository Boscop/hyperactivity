-- build bootstrap.tgz (~95 KB: Makefile, src/*, hyperactive, README.md) so any bare peer machine can bootstrap without git
s-make-bootstrap : List Word → Proc W Unit
s-make-bootstrap dst =
  bind (h-file-time "Makefile") (λ mt →
  if wlt #0 mt
  then bind (h-run (cons "/bin/sh" (cons "-c" (cons "IFS=; COPYFILE_DISABLE=1 tar -czf $1 Makefile src hyperactive README.md" (cons "_" (cons dst nil)))))) (λ r → ret {lzero} {W} unit)
  else ret {lzero} {W} unit)
