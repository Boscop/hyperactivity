-- ---------------------------------------------------------------- the run
-- rm-run fuel blocks frames image i frame bb: instance i from block bb in a frame, to its return
rm-run : Word → (Word → Word → RBlockFn) → (Word → List RSlot → List RSlot → REv RFrame) → List RSlot → Word → RFrame → Word → REv RSlot
rm-run fuel prog mkf img =
  %welimP (λ x → Word → RFrame → Word → REv RSlot) fuel (λ i fr bb → rm-stop st-fuel)
    (λ k again i fr bb →
       rm-bind (prog i bb (λ j args → rm-bind (mkf j img args) (λ f2 → again j f2 #0)) fr) (λ nx → case nx of
         rn-goto f2 b2 → again i f2 b2
         rn-ret v → rm-ret v))
