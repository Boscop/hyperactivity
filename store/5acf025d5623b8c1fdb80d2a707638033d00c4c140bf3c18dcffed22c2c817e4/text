-- ── 12. Exact Acoustic Holography Closed-Form Modal Inverse (Zero AI Slop!) ──
-- For a coupled 2-node Port-Hamiltonian resonator with ground k and coupling w:
--   Symmetric mode  (q,  q): F_0 = k*q + w*(q - q)   = k * q           (eigenvalue omega1^2 = k)
--   Antisym mode    (q, -q): F_0 = k*q + w*(q - (-q)) = (k + 2*w) * q  (eigenvalue omega2^2 = k + 2w)
-- Therefore ANY two measured spectral peaks (omega1^2, omega2^2) of a real sound
-- invert ANALYTICALLY to k = omega1^2, w = (omega2^2 - omega1^2) / 2!
-- Variables (0..2): k, w, qv.
wave-modal-sym-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wave-modal-sym-poly A ad mu q vs =
  (λ g sub →
    let k = g 0; w = g 1; qv = g 2
    in (ad (mu k qv) (mu w (sub qv qv)) , mu k qv))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
