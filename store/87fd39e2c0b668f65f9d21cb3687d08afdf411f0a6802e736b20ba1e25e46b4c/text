s-start : List Word → List Word → Word → Proc W Unit
s-start st m port = bind (s-listen port) (λ fd →
  if wlt fd #9223372036854775807 then bind (h-out (h-line (list-append "http://localhost:" (list-append (h-decimal port) "/")))) (λ u → s-serve (toNat #1000000) st m fd)
  else h-fail (list-append "server: the port cannot be listened on: " (h-decimal port)))
