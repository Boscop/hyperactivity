-- ---------------------------------------------------------------- (7.6c) finite-prefix judgments
-- a transition is internal (inl unit) or visible (inr e)
tau-chain : {C L : Type} → (C → Sum Unit L → C → Type) → C → List C → C → Type
tau-chain step x nil z = x ≡ z
tau-chain step x (cons y r) z = step x (inl unit) y × tau-chain step y r z
