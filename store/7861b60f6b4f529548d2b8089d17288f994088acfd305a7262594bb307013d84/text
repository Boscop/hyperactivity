-- the branch (sp at e′, spp at e) of tr(M_e M_e′) against the branch (spp at e, sp at e′) of tr(M_e′ M_e)
pair-branch-adj : Nat → Nat → Bool → Bool → List Nat → List Triple → VW → Bool
pair-branch-adj e e1 sp spp ds ts w = pair-adj-terms (vw-d w) (gram ds) (pair-branch-vw e e1 sp spp ds ts w) (pair-branch-vw e1 e spp sp ds ts w)
