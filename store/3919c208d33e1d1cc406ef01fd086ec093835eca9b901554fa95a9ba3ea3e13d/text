-- ---------------------------------------------------------------- selection
-- a word's occurrences: the record's lines that hold it, ascending, and its weight (3001 less
-- their number); a word on more than 3000 lines identifies nothing and selects nothing
c-count : List Word → Proc W Word
c-count w = bind (c-out (cons "grep" (cons "-c" (cons "-i" (cons "-w" (cons "-F" (cons "-e" (cons w (cons c-record nil))))))))) (λ o → ret (h-number (c-strip-nl o)))
