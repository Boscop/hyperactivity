-- 3. Monotone Public Wealth Compounding: every settled artifact permanently enlarges the public pool.
pouw-pool-mono-at : {E : Type} → (b : Bool) → (ext : Pool E) → (st : PouwState E) → (x : E) →
  snd (snd st) x ≡ true → snd (snd (pouw-step b ext st)) x ≡ true
pouw-pool-mono-at true ext st x h = λ i → po-or (h i) (ext x)
pouw-pool-mono-at false ext st x h = h
