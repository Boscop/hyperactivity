papp-dd-pull : (sk : Lst Entry) (fm : DNF) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (c : Cube (dims sk) X) (d : DCube (dims sk) X Y c) (e : DCube (dims sk) X' (DL X' F') (dcube-map (dims sk) X Y X' f c d)) →
  DDPull (dims sk) (λ Z H G q → papp-dd sk Z H fm G q) X X' Y F F' f g c d e
papp-dd-pull sk fm X X' Y F F' f g c d e = papp-ex-pull sk (dnf-ix fm) X X' Y F F' f g c d e
