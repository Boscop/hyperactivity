-- L(s, x): the true walks in the strip of code at least st, weighed exactly
fd-low : Nat → Nat → Nat → List (Nat × (Nat × Nat)) → Nat
fd-low s st x rs = case rs of
  nil → 0
  cons r rest → plus (if leb 5 (fst r) then (if leb st (snd (snd r)) then fd-wt s 5 x (fst (snd r)) else 0) else 0) (fd-low s st x rest)
