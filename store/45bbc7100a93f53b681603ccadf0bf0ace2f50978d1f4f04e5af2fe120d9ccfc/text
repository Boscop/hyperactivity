-- Flat-grid UiNode projector: flattens right-nested `ui-row` chains into a single responsive CSS grid!
ossc-ui-leaf : UiNode → List Word
ossc-ui-leaf ui-nil = nil
ossc-ui-leaf (ui-heading t) =
  h-concat (cons "<h3 class='os-h3'>" (cons (ossc-esc t) (cons "</h3>" nil)))
ossc-ui-leaf (ui-text t) =
  h-concat (cons "<p class='os-p'>" (cons (ossc-esc t) (cons "</p>" nil)))
ossc-ui-leaf (ui-code s) =
  h-concat (cons "<pre class='os-code'><code>" (cons (ossc-esc s) (cons "</code></pre>" nil)))
ossc-ui-leaf (ui-metric l v) =
  h-concat (cons "<div class='os-metric'><div class='os-ml'>" (cons (ossc-esc l)
           (cons "</div><div class='os-mv'>" (cons (ossc-esc v) (cons "</div></div>" nil)))))
ossc-ui-leaf (ui-canvas w h ops) =
  h-concat (cons "<svg class='os-svg' viewBox='0 0 " (cons (ce-dec w) (cons " " (cons (ce-dec h)
           (cons "'>" (cons (ossc-cv-to-svg ops) (cons "</svg>" nil)))))))
ossc-ui-leaf (ui-row a b) = list-append (ossc-ui-leaf a) (ossc-ui-leaf b)
ossc-ui-leaf (ui-col a b) = list-append (ossc-ui-leaf a) (ossc-ui-leaf b)
