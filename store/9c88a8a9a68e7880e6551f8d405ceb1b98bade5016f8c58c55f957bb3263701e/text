-- the ceiling: n ≤ q·D
cdiv-qr-sound : (pos : Bool) → (A D : Nat) → (qr : List Bool × List Bool) → div-post A D qr → bcanon (snd qr) ≡ true → zle (if pos then (A , zero) else (zero , A)) (zmul (zv (bz-cdiv-qr pos qr)) (D , zero))
cdiv-qr-sound pos A D qr post cr = case pos return λ u → zle (if u then (A , zero) else (zero , A)) (zmul (zv (bz-cdiv-qr u qr)) (D , zero)) of
  true → cpos-v A D qr post (bin-null (snd qr)) (symB (bin-null-sound (snd qr) cr))
  false → zle-mul-r (zv (bz-neg (true , fst qr))) (the (Nat × Nat) (zero , bin-to-nat (fst qr))) (zero , A) D (bz-neg-sound true (fst qr))
    (cdiv-neg (bin-to-nat (fst qr)) D (bin-to-nat (snd qr)) A (fst post))
