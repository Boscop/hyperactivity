dy-cert : Nat → BZ → BZ → List (List BZ) → List (List BZ) → List BZ → Bool
dy-cert c rho t a l d = if hc-symgo a zero a then (if dy-ulgo t zero l then (if bz-pos (bz-sub (bz-mul (dy-minabs d) (bz-mul t t)) (bz-mul (bz-mul (dy-wmax t l) (dy-umax t l)) (bz-add (bz-mul (bz-mul t t) rho) (dy-res t a l d)))) then eqb (dy-negs d) c else false) else false) else false
