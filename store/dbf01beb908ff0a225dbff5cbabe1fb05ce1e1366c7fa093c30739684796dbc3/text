s-link : Nat → Word → List Word → List Word
s-link zero prev t = t
s-link (suc f) prev nil = nil
s-link (suc f) prev (cons x r) = if weq x #91 then s-link-at (s-link f #93) r (s-upto #93 r)
  else if andB (weq x #104) (andB (h-not (orB (weq prev #61) (orB (weq prev #39) (s-word prev)))) (orB (h-prefix "ttps://" r) (h-prefix "ttp://" r)))
    then s-bare (s-link f #32) (s-url-trim (cons x (s-url-take r))) (cons x r)
  else cons x (s-link f x r)
