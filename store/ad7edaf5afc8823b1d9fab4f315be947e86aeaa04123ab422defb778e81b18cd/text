-- the rotation of the second methyl group
vln-r2 : Vln → Vln
vln-r2 x = case x of
  vl-c1 → vl-c1
  vl-o1 → vl-o1
  vl-o2 → vl-o2
  vl-ho → vl-ho
  vl-ca → vl-ca
  vl-ha → vl-ha
  vl-n → vl-n
  vl-hn1 → vl-hn1
  vl-hn2 → vl-hn2
  vl-cb → vl-cb
  vl-hb → vl-hb
  vl-cg1 → vl-cg1
  vl-g11 → vl-g11
  vl-g12 → vl-g12
  vl-g13 → vl-g13
  vl-cg2 → vl-cg2
  vl-g21 → vl-g22
  vl-g22 → vl-g23
  vl-g23 → vl-g21
