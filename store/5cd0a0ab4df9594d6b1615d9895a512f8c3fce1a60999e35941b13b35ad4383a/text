-- and the theorem at that generality: a reflexive relation with one failure to compose is not
-- identity, whatever it relates. Nothing may be transported along it that identity would transport —
-- not a hazard assessment, not an interchangeability, and not a criminal liability.
non-transitive-at-not-identity : (A : Type 1) → (R : A → A → Type 0) → ((x : A) → R x x) → NonTransitiveAt A R → (((x : A) → (y : A) → R x y → x ≡ y) → Empty)
non-transitive-at-not-identity A R rfl n =
  λ det →
    let x = fst n in
    let y = fst (snd n) in
    let z = fst (snd (snd n)) in
    let xy = fst (snd (snd (snd n))) in
    let yz = fst (snd (snd (snd (snd n)))) in
    let nxz = snd (snd (snd (snd (snd n)))) in
    nxz (transport (λ i → R x (concat (det x y xy) (det y z yz) i)) (rfl x))
