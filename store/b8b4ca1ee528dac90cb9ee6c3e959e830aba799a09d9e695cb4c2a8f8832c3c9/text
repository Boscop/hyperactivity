spectre-leak-witness :
  Neg ((s1 s2 : Nat → Nat) → ((i : Nat) → fd-ltb i (suc zero) ≡ true → s1 i ≡ s2 i) →
       spec-vuln-obs (suc zero) (suc zero) s1 ≡ spec-vuln-obs (suc zero) (suc zero) s2)
spectre-leak-witness hyp =
  inl-inj-zero-one (λ i → snd (hyp spectre-s1 spectre-s2 spectre-pub-eq i))
