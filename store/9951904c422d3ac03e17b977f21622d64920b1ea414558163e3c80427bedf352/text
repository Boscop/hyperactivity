-- 3. Mechanical NVIDIA 8xH100 CUDA Emitter (EXACT SAME superoptimized AST!)
kir-fn-cuda : List Word → WExpr → List Word → List Word
kir-fn-cuda name e tail =
  hw-ln (list-append "__device__ __forceinline__ uint32_t " (list-append name (list-append "(uint32_t x0, uint32_t x1, uint32_t x2) { return "
        (list-append (kir-emit-expr "0u" "0xFFFFFFFFu" (kir-opt e)) "; }")))) tail
