  (hw-ln "    double grw = ((double)tot_rw) / (dt * 1e6);"
  (hw-ln (list-append "    printf(" (list-append hw-q (list-append "[TOWER GPU %s] 262,144 REAL INet graph reductions (%llu rewrites) in %.2f ms | %.2f G-rewrites/s | exact_errors=%u (0=exact!)" (list-append hw-esc-n (list-append hw-q ", [[dev name] UTF8String], (unsigned long long)tot_rw, dt, grw, errs);")))))
  (hw-ln "  }"
  (hw-ln "  return 0;"
  (hw-ln "}" nil))))))))))))))))))))))))))))))))
