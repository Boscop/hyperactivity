zipe-entries : (f : List (List Word) → Word) → (t : List (List Word)) → (i : Word) → zipe (entries t i) (list-map f (sufs t)) ≡ list-map (phi f) (entries t i)
zipe-entries f t =
  case t return λ w → (i : Word) → zipe (entries w i) (list-map f (sufs w)) ≡ list-map (phi f) (entries w i) of
    nil → λ i j → nil
    cons x r → λ i j → cons (f (cons x r) , (cons x r , i)) (rec r (wadd i #1) j)
