-- closure environment trimming (nk-trim-susp / nk-uses-var): wire denotation and evaluation preservation
nk-trim-ev : NkTm → Word → NkEv → NkEv
nk-trim-ev b j (nkev-cons v r) =
  nkev-cons (if nk-uses-var #0 j b then v else nkev (hd-num #0) nkev-nil) (nk-trim-ev b (%wsucc j) r)
nk-trim-ev b j e = nkev-nil
