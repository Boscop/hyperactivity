-- the bracket's ends checked (F(lo) < 0 < F(hi), both starts sound), then j halvings
h2p-root : List Bool → List Bool → Nat → Nat → Nat → Nat → BZ → BZ → Bool × (BZ × BZ)
h2p-root S S2 M K N j lo hi = h2p-bisect S S2 M K N j
  (both (both (fst (h2p-at S S2 lo M K N)) (iv-neg-sure (snd (h2p-at S S2 lo M K N))))
        (both (fst (h2p-at S S2 hi M K N)) (iv-pos-sure (snd (h2p-at S S2 hi M K N)))) , (lo , hi))
