hmat-main : List (List Word) → Step W Word
hmat-main args =
  let p  = hmat-pref args
      mf = list-append p ".metal"
      hf = list-append p "_host.m"
      uf = list-append p "_h100.cu"
  in scmd w-now (λ t0 →
     scmd (w-file-write-named mf hmat-metal-src) (λ bm →
     scmd (w-file-write-named hf (hmat-host-src mf)) (λ bh →
     scmd (w-file-write-named uf hmat-cuda-src) (λ bu →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-MATTER BnB-Sound=1 BCS-Gap=1 Dist2-Sym=1 Fermi-Pauli=1 Metal="
       (list-append (ce-dec bm)
       (list-append "B Host=" (list-append (ce-dec bh)
       (list-append "B H100-CUDA=" (list-append (ce-dec bu)
       (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))))
       (sdone #0))))))
