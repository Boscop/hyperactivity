-- Compositional simulation combinators
cs-sim-bind : (hp : CsHeap) (om1 : CsOptM) (r1 : CsRes) (km : CsMVal → CsOptM) (kr : CsHeap → CsVal → CsRes) →
  cs-res-mono hp r1 →
  (cs-sim-ok om1 r1 ≡ true) →
  ((mv1 : CsMVal) (hp1 : CsHeap) (cv1 : CsVal) →
     cs-heap-ext hp hp1 → (cs-val-rel hp1 mv1 cv1 ≡ true) →
     cs-sim-ok (km mv1) (kr hp1 cv1) ≡ true) →
  cs-sim-ok (cs-bind-om om1 km) (cs-bind-res r1 kr) ≡ true
cs-sim-bind hp csom-none r1 km kr mr1 hs1 hstep = refl
cs-sim-bind hp (csom-some mv1) cso-abort km kr mr1 hs1 hstep = cs-no hs1
cs-sim-bind hp (csom-some mv1) cso-ub km kr mr1 hs1 hstep = cs-no hs1
cs-sim-bind hp (csom-some mv1) (cso-ok hp1 cv1) km kr mr1 hs1 hstep = hstep mv1 hp1 cv1 mr1 hs1
