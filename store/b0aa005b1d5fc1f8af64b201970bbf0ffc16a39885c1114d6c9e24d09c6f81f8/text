hcm-enc-fin : List Word → Word → Word → Word → Word → Word → Word → Word → Step W Word
hcm-enc-fin out t0 n tab inb outb lof op1 =
  hcm-put32 outb op1 lof (λ op2 →
  scmd (w-sys #901 #0 #0 #0 #0 #0 #0) (λ _ →
  hcm-write-raw out outb op2 (λ _ →
  scmd (w-free tab) (λ _ →
  scmd (w-free inb) (λ _ →
  scmd (w-free outb) (λ _ →
  scmd w-now (λ t1 →
  cli-say (list-append "HX-CM enc " (list-append (ce-dec n) (list-append " -> " (list-append (ce-dec op2)
    (list-append " B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000000)) " ms)")))))) (sdone #0))))))))
