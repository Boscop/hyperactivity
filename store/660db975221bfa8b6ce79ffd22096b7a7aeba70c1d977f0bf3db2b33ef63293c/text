-- one search item, kept as the pages are (s-site-kept); a name not published is not found, and nothing is kept for it
s-corpus-kept-one : List Word → List Word → Proc W (List Word)
s-corpus-kept-one st q = if orB (h-eq q "/paper") (s-known (s-at-name q s-published)) then s-site-kept st (list-append "corpus-" (h-drop "/" q)) (s-corpus-one st q) else ret {lzero} {W} (s-respond "404 Not Found" "text/plain" "")
