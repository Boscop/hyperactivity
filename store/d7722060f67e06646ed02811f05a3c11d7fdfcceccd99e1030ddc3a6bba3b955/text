-- open: what is in progress, then the first layer
v-open : List Word → Proc W Unit
v-open st = bind (if h-null (h-concat v-in-progress) then ret {lzero} {W} unit else bind (h-out (h-line (h-line "In progress:"))) (λ u → v-show-all st v-in-progress)) (λ u →
  h-out (list-append (h-line "Can start now and unblocks the most:") (h-concat (list-map (λ x → list-append (v-line x) (v-gain-line x)) (v-top v-ready)))))
