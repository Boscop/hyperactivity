-- the count of negative directions a witness shows, and whether the witness is one:
-- n vectors, pairwise orthogonal for the matrix, none of length zero
inertia-cert : (n : Nat) → it-sym ZrC n → List (sy-vn ZrC n) → Nat × Bool
inertia-cert n s ws = (it-count ZrC (sy-vn ZrC n) zr-neg (zr-fm n s) ws , (if eqb (sy-len (sy-vn ZrC n) ws) n then it-ok ZrC (sy-vn ZrC n) zr-isz (zr-fm n s) ws else false))
