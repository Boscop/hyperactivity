-- PC-relative branches: on ARM64, PC is the address of the branch instruction itself,
-- so skipping `skip` bytes forward branches by `skip + 4` bytes (`(skip >> 2) + 1` words).
a64-b-skip : Word → Lst Word
a64-b-skip skip = a64-insn (a64-or #335544320 (a64-and (%wsucc (a64-shr skip #2)) #67108863))
