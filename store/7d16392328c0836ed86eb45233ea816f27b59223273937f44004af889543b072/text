ce-cli-try-inline : Lst (Word × Word) → (Code → List Word → List Word) → Word → Word → Lst Code → List Word → Opt (List Word)
ce-cli-try-inline ars pr dd j (lcons (ccon wdd wj wfs _) (lcons k lnil)) acc =
  if %weq j #1 then
    if ce-is-step-dd dd then
      if ce-is-wcmd-dd wdd then
        let sp = x-spine k
            as = snd sp
        in case fst sp of
             cglob g →
               if %weq (%wsucc (l-count as)) (x-look ars g) then
                 if %weq wj #7 then
                   case wfs of
                     lcons a _ → some (ce-cli-call pr g as (λ tl → list-append "(*(const uint64_t *)(uintptr_t)(" (pr a (list-append "))" tl))) acc)
                     lnil → none
                 else if %weq wj #8 then
                   case wfs of
                     lcons a r1 →
                       case r1 of
                         lcons v _ → some (list-append "({ *(uint64_t *)(uintptr_t)(" (pr a (list-append ") = (" (pr v (list-append "); " (ce-cli-call pr g as (λ tl → list-append "(uint64_t)(uintptr_t)&hy_c0[0]" tl) (list-append "; })" acc)))))))
                         lnil → none
                     lnil → none
                 else if %weq wj #13 then
                   case wfs of
                     lcons a _ → some (ce-cli-call pr g as (λ tl → list-append "(uint64_t)(*(const uint8_t *)(uintptr_t)(" (pr a (list-append ")))" tl))) acc)
                     lnil → none
                 else if %weq wj #14 then
                   case wfs of
                     lcons a r1 →
                       case r1 of
                         lcons v _ → some (list-append "({ *(uint8_t *)(uintptr_t)(" (pr a (list-append ") = (uint8_t)(" (pr v (list-append "); " (ce-cli-call pr g as (λ tl → list-append "(uint64_t)(uintptr_t)&hy_c0[0]" tl) (list-append "; })" acc)))))))
                         lnil → none
                     lnil → none
                 else none
               else none
             _ → none
      else none
    else none
  else none
ce-cli-try-inline _ _ _ _ _ _ = none
