u1-pair : Nat → Nat → Nat → Nat → List (SQ × List Loop)
u1-pair j k m n =
  cons (sq-neg ((suc zero , 4) , (zero , suc zero)) , cons (loop-of j k sq-one) (cons (loop-of m n sq-one) nil))
  (cons (((suc zero , 4) , (zero , suc zero)) , cons (loop-of j k sq-one) (cons (loop-of m n (sq-neg sq-one)) nil))
  (cons (((suc zero , 4) , (zero , suc zero)) , cons (loop-of j k (sq-neg sq-one)) (cons (loop-of m n sq-one) nil))
  (cons (sq-neg ((suc zero , 4) , (zero , suc zero)) , cons (loop-of j k (sq-neg sq-one)) (cons (loop-of m n (sq-neg sq-one)) nil)) nil)))
