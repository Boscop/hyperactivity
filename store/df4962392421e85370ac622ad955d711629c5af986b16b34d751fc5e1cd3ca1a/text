-- s + 2(d + X + Y) = c + (x + 2X) + (y + 2Y) when s + 2d = c + x + y
add-rearrange : (s d X Y c x y : Nat) → plus s (times 2 d) ≡ plus c (plus x y) → plus s (times 2 (plus d (plus X Y))) ≡ plus c (plus (plus x (times 2 X)) (plus y (times 2 Y)))
add-rearrange s d X Y c x y h =
  transN (congN (plus s) (times2-plus d (plus X Y)))
  (transN (congN (λ z → plus s (plus (times 2 d) z)) (times2-plus X Y))
  (transN (symN (plus-assoc s (times 2 d) (plus (times 2 X) (times 2 Y))))
  (transN (congN (λ z → plus z (plus (times 2 X) (times 2 Y))) h)
  (transN (plus-assoc c (plus x y) (plus (times 2 X) (times 2 Y)))
  (congN (plus c) (plus-mid4 x y (times 2 X) (times 2 Y)))))))
