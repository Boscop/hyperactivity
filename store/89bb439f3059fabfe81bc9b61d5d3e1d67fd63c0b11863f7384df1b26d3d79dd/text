s-corpus-kept-one : List Word → List Word → Proc W (List Word)
s-corpus-kept-one st q =
  if h-eq q "/paper" then s-site-kept st "corpus-paper" (s-corpus-one st q)
  else if s-known (s-at-name q s-published) then s-mod-kept st "corpus" (s-corpus-work-path (s-at-name q s-published)) (s-corpus-one st q)
  else ret {lzero} {W} (s-respond "404 Not Found" "text/plain" "")
