hcm-enc-file : List Word → List Word → Step W Word
hcm-enc-file inp out =
  scmd w-now (λ t0 →
  hcm-read-raw inp (λ inb n →
  scmd (w-alloc #7866496) (λ tab →
  scmd (w-alloc (%wadd (%wmul n #2) #64)) (λ outb →
  cli-poke outb "HXC3" (λ _ →
  hcm-put32 outb #4 n (λ op0 →
  let nn = toNat n
      fin = hcm-enc-fin out t0 n tab inb outb
  in scmd (w-sys #900 #0 #0 #0 #0 #0 #0) (λ _ →
     hcm-enc-loop2 nn tab inb outb #0 #0 (hcm-pack-lohi #0 #4294967295) op0 #0 fin)))))))
