-- unconditionally enforce the single canonical s-nav on every HTML page
s-inject-nav : List Word → List Word
s-inject-nav doc =
  if h-infix "<nav" doc then
    h-concat (cons (h-before "<nav" doc) (cons s-nav (cons (h-after "</nav>" doc) nil)))
  else if h-infix "<!--HX:NAV-->" doc then
    h-concat (cons (h-before "<!--HX:NAV-->" doc) (cons s-nav (cons (h-after "<!--HX:NAV-->" doc) nil)))
  else if h-infix "<body>" doc then
    h-concat (cons (h-before "<body>" doc) (cons "<body>" (cons s-nav (cons (h-after "<body>" doc) nil))))
  else doc
