-- the diagonal: Σ_i w_i·(+1 on an empty or doubly occupied site, −1 on a singly occupied one)
hb-diag : Nat → Nat → Nat → Nat → List Bool → List Bool → BZ
hb-diag ae ai k i u d = case u of
  nil → bz-zero
  cons x xs → (case d of
    nil → bz-zero
    cons y ys → bz-add (if bit-eq x y then in-int (hb-w ae ai k i) else in-negint (hb-w ae ai k i)) (hb-diag ae ai k (suc i) xs ys))
