-- (part of language-support)
vex_prefixes_map_p : (bytes' : Bits #16) → (vex_prefixes' : vex_prefixes) → Bool
vex_prefixes_map_p bytes' vex_prefixes' =
  let byte0 : Bits #8
      byte0 = (vex_prefixes-byte0 vex_prefixes')
      byte1 : Bits #8
      byte1 = (vex_prefixes-byte1 vex_prefixes')
      t'1 : Bool
      t'1 =
        if (weq bytes' #15) then
          (b-or (weq byte0 #197) (b-and (weq byte0 #196) (weq (vex3_byte1-m_mmmm byte1) #1)))
        else
          (b-and (weq byte0 #196) (if (weq bytes' #3896) then (weq (vex3_byte1-m_mmmm byte1) #2) else (weq (vex3_byte1-m_mmmm byte1) #3)))
  in t'1
