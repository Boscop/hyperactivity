nk-plan-slot-wf : (s : NkSlot) (u n : NkW) (sl : NkSlots) →
  nk-and (nk-wire-le n (nk-n (nk-plan s u n sl)))
         (nk-step-fx-wf u (nk-slot-ins s) (nk-slot-outs s) n (nk-n (nk-plan s u n sl)) (nk-fx (nk-plan s u n sl))) ≡ true
nk-plan-slot-wf (nks-pair o v) u n sl = nk-plan-by-wf (nk-held o v) o v u n sl
nk-plan-slot-wf nks-none u n sl = nk-and-intro (nk-wire-le n n) true (nk-wire-le-refl n) refl
nk-plan-slot-wf (nks-val v) u n sl = nk-and-intro (nk-wire-le n n) true (nk-wire-le-refl n) refl
nk-plan-slot-wf (nks-op o) u n sl = nk-and-intro (nk-wire-le n n) true (nk-wire-le-refl n) refl
