dm-http-post-json : List Word → List Word → Proc W (List Word)
dm-http-post-json url body =
  bind (h-capture
    (cons "/usr/bin/curl"
    (cons "-sS" (cons "--max-time" (cons "6"
    (cons "-H" (cons "Content-Type: application/json"
    (cons "-d" (cons body (cons url nil)))))))))) (λ r →
    if %weq (fst r) #0 then ret {lzero} {W} (snd r) else ret {lzero} {W} nil)
