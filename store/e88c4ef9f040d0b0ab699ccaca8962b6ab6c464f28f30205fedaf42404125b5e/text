every-drop : (P : Conj → Bool) (c : Conj) (f : DNF) → every-c P f ≡ true → every-c P (dnf-drop-sup c f) ≡ true
every-drop P c lnil h = λ i → true
every-drop P c (lcons d ds) h =
  bool-case0 (λ b → every-c P (if b then dnf-drop-sup c ds else lcons d (dnf-drop-sup c ds)) ≡ true) (conj-sub c d)
    (λ e → every-drop P c ds (andB-r (P d) (every-c P ds) h))
    (λ e → andB-intro (P d) (every-c P (dnf-drop-sup c ds)) (andB-l (P d) (every-c P ds) h) (every-drop P c ds (andB-r (P d) (every-c P ds) h)))
