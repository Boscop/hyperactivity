-- Pass 2 automatic selector: induce equivalence classes from shared bidirectional (left, right) contexts
ctx-add-entry : Word → Word → Word → List ((Word × Word) × List Word) → List ((Word × Word) × List Word)
ctx-add-entry l m r nil = cons ((l , r) , cons m nil) nil
ctx-add-entry l m r (cons e rest) =
  if andB (weq l (fst (fst e))) (weq r (snd (fst e))) then
    if word-in-list m (snd e) then cons e rest
    else cons (fst e , cons m (snd e)) rest
  else cons e (ctx-add-entry l m r rest)
