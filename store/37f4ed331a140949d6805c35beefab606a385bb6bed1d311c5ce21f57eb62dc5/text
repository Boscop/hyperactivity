hy-unexplained : List Word → List Word → List (List Word) → Proc W Unit
hy-unexplained st m args = bind (hy-reason-data st m) (λ d → bind (hy-files-read st) (λ fs →
  bind (hy-reasoned st (fst (fst d)) (h-concat-lists (list-map (λ e → snd e) fs))) (λ own →
  bind (hy-closure (toNat #256) st (hy-seed own (snd d) fs) (hy-seed own (snd d) fs)) (λ have →
  h-out (hy-unexplained-report (snd own) have (hy-scoped args fs))))))
