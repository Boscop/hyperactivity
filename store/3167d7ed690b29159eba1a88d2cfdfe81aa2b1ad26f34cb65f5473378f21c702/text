-- signed addition, on canonical magnitudes
bz-add-sound : (s1 : Bool) → (m1 : List Bool) → (s2 : Bool) → (m2 : List Bool) → bcanon m1 ≡ true → bcanon m2 ≡ true → zeq (zv (bz-add (s1 , m1) (s2 , m2))) (zplus (zv (s1 , m1)) (zv (s2 , m2)))
bz-add-sound s1 m1 s2 m2 c1 c2 = case s1 return λ u → zeq (zv (bz-add (u , m1) (s2 , m2))) (zplus (zv (u , m1)) (zv (s2 , m2))) of
  true → (case s2 return λ w → zeq (zv (bz-add (true , m1) (w , m2))) (zplus (zv (true , m1)) (zv (w , m2))) of
    true → congN (λ z → plus z zero) (bin-add-sound m1 m2)
    false → zadd-tf m1 m2 (bin-leb m2 m1) (symB (bin-leb-sound m2 m1 c2 c1)))
  false → (case s2 return λ w → zeq (zv (bz-add (false , m1) (w , m2))) (zplus (zv (false , m1)) (zv (w , m2))) of
    true → zadd-ft m1 m2 (bin-leb m2 m1) (symB (bin-leb-sound m2 m1 c2 c1))
    false → symN (bin-add-sound m1 m2))
