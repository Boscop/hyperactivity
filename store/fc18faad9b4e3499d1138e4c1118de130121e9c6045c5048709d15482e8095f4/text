lv-loops-d : Nat → List Seg → List Word
lv-loops-d zero _ = nil
lv-loops-d (suc rem) nil = nil
lv-loops-d (suc rem) (cons s rest) =
  let p0 = fst s
      p1 = snd s
      tr = lv-trace-loop 400 p0 p1 rest (cons p1 (cons p0 nil))
      loopD = closed-poly-d (fst tr)
      more = lv-loops-d rem (snd tr)
  in lg-concat (cons loopD (cons " " (cons more nil)))
