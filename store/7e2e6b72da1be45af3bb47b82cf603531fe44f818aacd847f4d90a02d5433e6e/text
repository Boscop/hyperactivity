hcm-dec-fin : List Word → Word → Word → Word → Word → Word → Word → Word → Step W Word
hcm-dec-fin out t0 ilen n tab inb outb _ =
  scmd (w-sys #901 #0 #0 #0 #0 #0 #0) (λ _ →
  hcm-write-raw out outb n (λ _ →
  scmd (w-free tab) (λ _ →
  scmd (w-free inb) (λ _ →
  scmd (w-free outb) (λ _ →
  scmd w-now (λ t1 →
  cli-say (list-append "HX-CM dec " (list-append (ce-dec ilen) (list-append " -> " (list-append (ce-dec n)
    (list-append " B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000000)) " ms)")))))) (sdone #0)))))))
