opt-2-l0-le : {V : Type} → (b : B2) → (c : B0) → (y : Circ B0 B1 B2 V) →
  Path Bool (leB (circ-gates {B0} {B1} {B2} {V} (opt-2-l0 {V} b c y)) (suc (circ-gates {B0} {B1} {B2} {V} y))) true
opt-2-l0-le {V} b2-and b0-false y = λ _ → true
opt-2-l0-le {V} b2-and b0-true  y = leB-suc-r (circ-gates y) (circ-gates y) (leB-refl (circ-gates y))
opt-2-l0-le {V} b2-or  b0-false y = leB-suc-r (circ-gates y) (circ-gates y) (leB-refl (circ-gates y))
opt-2-l0-le {V} b2-or  b0-true  y = λ _ → true
opt-2-l0-le {V} b2-xor b0-false y = leB-suc-r (circ-gates y) (circ-gates y) (leB-refl (circ-gates y))
opt-2-l0-le {V} b2-xor b0-true  y = opt-not-le {V} y
