-- Reverse: any choice function that factors through content alone is necessarily framing-invariant.
factored-is-framing-invariant : {C Choice : Type} → (eval : (Bool × C) → Choice) →
  ((g : C → Choice) × ((s : Bool × C) → eval s ≡ g (snd s))) →
  FramingInvariant eval
factored-is-framing-invariant eval fac c =
  concat (snd fac (true , c)) (sym (snd fac (false , c)))
