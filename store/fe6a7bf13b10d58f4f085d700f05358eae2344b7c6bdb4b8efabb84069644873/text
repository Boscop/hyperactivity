-- ---------------------------------------------------------------- the order that computes, and recursion along it
-- m < n is Unit or Empty on numerals: a proof of it on numerals is unit
-- (by recursion on the bound: m < zero is Empty whatever m is)
above : Nat → Nat → Type
above zero m = Empty
above (suc n) zero = Unit
above (suc n) (suc m) = above n m
