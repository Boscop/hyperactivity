-- an entry of the store: the source's (pieces and modules, shared; lib/host.cub, h-source), the index
-- computed from the view (what paths and names hold; h-index), or the machine's own
hy-index-entry : List Word → Bool
hy-index-entry rel = orB (h-prefix "written/" rel) (orB (h-prefix "modules/" rel) (orB (h-prefix "names-of/" rel) (h-prefix "module-of/" rel)))
