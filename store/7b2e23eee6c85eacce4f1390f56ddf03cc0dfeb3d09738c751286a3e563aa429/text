-- between a and c in the order, b shares with c at least what a shares
k-btw : (a b c : List (List Word)) → isTrue (leq {suffix-ord} a b) → isTrue (leq {suffix-ord} b c) → ltn (lcp b c) (lcp a c) ≡ false
k-btw a =
  case a return λ w → (b c : List (List Word)) → isTrue (leq {suffix-ord} w b) → isTrue (leq {suffix-ord} b c) → ltn (lcp b c) (lcp w c) ≡ false of
    nil → λ b c h1 h2 → k-ltn-zero (lcp b c)
    cons x a1 → k-btw-c x a1 (rec a1)
