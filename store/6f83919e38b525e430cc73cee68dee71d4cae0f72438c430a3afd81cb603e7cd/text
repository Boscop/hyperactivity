-- Cost Functors on the SAME Web of Identity
wcost-size : WExpr → Word
wcost-size (we-k _)       = #1
wcost-size (we-v _)       = #1
wcost-size (we-not a)     = %wadd #1 (wcost-size a)
wcost-size (we-xor a b)   = %wadd #1 (%wadd (wcost-size a) (wcost-size b))
wcost-size (we-and a b)   = %wadd #1 (%wadd (wcost-size a) (wcost-size b))
wcost-size (we-or  a b)   = %wadd #1 (%wadd (wcost-size a) (wcost-size b))
wcost-size (we-ch  e f g) = %wadd #4 (%wadd (wcost-size e) (%wadd (wcost-size f) (wcost-size g)))
wcost-size (we-maj a b c) = %wadd #5 (%wadd (wcost-size a) (%wadd (wcost-size b) (wcost-size c)))
