-- the meaning of a text in the record, the record unchanged (what /api/meaning answers as one types). Past
-- 40 places, the family is shown from the first 40 met, said to be part, its agreement not claimed
c-shown : Word → List Word → List Word → Word × List (List Word) → List Word
c-shown e key forms got =
  if wlt #40 (fst got) then list-append (h-line (list-append "(" (list-append (h-decimal (fst got))
      (list-append " places hold " (list-append (c-unwords (c-words (c-tail e forms))) "; what followed the first 40 met:)")))))
    (h-concat (list-map (λ x → h-line (list-append "  " (c-unwords x))) (c-one-each (list-map (c-transport (c-words (c-tail e key)) (c-words (c-tail e forms))) (snd got)))))
  else c-meaning (c-one-each (list-map (c-transport (c-words (c-tail e key)) (c-words (c-tail e forms))) (snd got)))
