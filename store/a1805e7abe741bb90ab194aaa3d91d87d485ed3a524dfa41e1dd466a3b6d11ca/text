-- ============================================================================
-- 3. U(1) Gauss Constraint Conservation under Thiemann's Magnetic Loops
-- ============================================================================
-- A magnetic loop α_{12}^s pushes +s onto end 1 and -s onto end 2; a second loop α_{34}^t
-- pushes +t onto end 3 and -t onto end 4. The vertex Gauss sum n1 + n2 + n3 + n4 is
-- identically conserved for all rational charges and loop powers.
-- Variables (0..5): n1, n2, n3, n4, s, t.
lqg-u1-gauss-loop-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-u1-gauss-loop-poly A ad mu q vs =
  (λ g sub →
    let n1 = g 0; n2 = g 1; n3 = g 2; n4 = g 3
        s  = g 4; t  = g 5
        after  = ad (ad (ad n1 s) (sub n2 s)) (ad (ad n3 t) (sub n4 t))
        before = ad (ad n1 n2) (ad n3 n4)
    in (after , before))
  (λ i → al-nth A (q (fn-q 0 1)) i vs) (al-gsub A ad mu q)
