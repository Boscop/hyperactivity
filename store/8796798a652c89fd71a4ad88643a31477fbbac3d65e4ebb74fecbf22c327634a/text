-- over k ≤ n and kt = k ± 1
hop-unit-k : List Bool → List Bool → List Bool → List Bool → Nat → Bool
hop-unit-k x v2 w2 m n = case n of
  zero → hop-norm-at x v2 nil bin-one w2 m
  suc g → both (both (hop-norm-at x v2 (bin-of-nat n) (bin-add (bin-of-nat n) bin-one) w2 m) (hop-norm-at x v2 (bin-of-nat n) (bin-of-nat g) w2 m)) (hop-unit-k x v2 w2 m g)
