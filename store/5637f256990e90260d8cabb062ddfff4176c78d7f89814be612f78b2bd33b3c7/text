cs-sim-cc11 : (e11 e12 : Bool) (j : Word) (hp : CsHeap) (a b : Word) →
  (%weq j #11 ≡ e11) → (%weq j #12 ≡ e12) →
  cs-sim-ok (if e12 then csom-some (cmv-word (if %wlt b #64 then %wshr a b else #0)) else csom-none)
            (if e11 then cs-hy-shl hp a b else if e12 then cs-hy-shr hp a b else cso-abort) ≡ true
cs-sim-cc11 true false j hp a b h11 h12 = refl
cs-sim-cc11 true true j hp a b h11 h12 =
  cs-no (sym (cong (λ z → %weq z #12) (cs-weq-sound j #11 h11)) ∙ h12)
cs-sim-cc11 false true j hp a b h11 h12 = cs-sim-shr-at (%wlt b #64) hp a b refl
cs-sim-cc11 false false j hp a b h11 h12 = refl
