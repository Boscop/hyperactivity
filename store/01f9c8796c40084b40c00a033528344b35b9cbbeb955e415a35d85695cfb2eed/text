-- THEOREM 7: RECURSIVE DATACENTER-OPTIMIZES-DATACENTER MONOTONICITY OVER ALL GENERATIONS g : Nat!
-- If generation g's verified compiler/superoptimizer guarantees cost(g+1) <= cost(g) for every step,
-- then EVERY future generation g is provably <= generation 0 (zero regression across unbounded self-improvement)!
sc-thm-dc-gen-monotone : (cost : Nat → Nat) →
  ((g : Nat) → hm-le (cost (suc g)) (cost g) ≡ true) →
  (g : Nat) → hm-le (cost g) (cost zero) ≡ true
sc-thm-dc-gen-monotone cost step zero    = hm-le-refl (cost zero)
sc-thm-dc-gen-monotone cost step (suc g) =
  hm-le-trans (cost (suc g)) (cost g) (cost zero) (step g) (sc-thm-dc-gen-monotone cost step g)
