cs-alloc-ext : (hp : CsHeap) (newblk : CsBlk) → cs-heap-ext hp (fst (cs-alloc hp newblk))
cs-alloc-ext hp newblk addr idx v =
  (case hp return (λ hp0 → (a0 : Nat) →
     (cs-load hp0 (csv-ptr a0) idx ≡ some v) →
     cs-load (cs-snoc CsBlk hp0 newblk) (csv-ptr a0) idx ≡ some v) of
     lnil → λ a0 h → cs-no (cong (cs-is-some CsVal) h)
     lcons blk r → λ a0 →
       (case a0 return (λ j0 →
          (cs-load (the CsHeap (lcons blk r)) (csv-ptr j0) idx ≡ some v) →
          cs-load (the CsHeap (lcons blk (cs-snoc CsBlk r newblk))) (csv-ptr j0) idx ≡ some v) of
          zero → λ h → h
          suc j0 → λ h → rec r j0 h)) addr
