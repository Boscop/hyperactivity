rc11-outcomes : Memory → List Word → List AtomThread → TsoAx
rc11-outcomes m0 dom ths =
  rc-threads ths dom #0
    (λ es ms out acc →
       tso-ax-rfs es m0 es
         (λ rf acc2 →
            (let ws = tso-keep tso-ev-writes es
             in tso-ax-cos (tso-len ws) ws (λ co acc3 → rc-tally m0 es ms out rf co acc3) nil acc2))
         nil acc)
    nil #1 nil nil (tso-ax nil #0 #0)
