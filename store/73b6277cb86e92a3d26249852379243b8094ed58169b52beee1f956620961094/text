-- the shard named k: every suffix of ts, numbered from i, whose first token's shard name is k
shard : List Word → Nat → List (List Word) → List Entry
shard k i ts =
  (case ts return λ w → Nat → List Entry of
     nil → λ i → nil
     cons t r → λ i → if tok-eq (skey t) k then cons (entry i (cons t r)) (rec r (suc i)) else rec r (suc i)) i
