nk-emem-sub : (a full : NkEnv) (n0 n1 : NkW) → ((w : NkW) → (nk-emem w a ≡ true) → nk-emem w full ≡ true) → nk-env-in-set full n0 n1 a ≡ true
nk-emem-sub nke-nil full n0 n1 sub = refl
nk-emem-sub (nke-cons x r) full n0 n1 sub =
  let hx = sub x (cong (λ z → if z then true else nk-emem x r) (nk-weq-refl x))
  in nk-and-intro (nk-in-set full n0 n1 x) (nk-env-in-set full n0 n1 r)
       (cong (λ z → if z then true else nk-in-range n0 n1 x) hx)
       (nk-emem-sub r full n0 n1 (λ w hm → sub w (nk-emem-tl (nk-weq w x) w r hm)))
