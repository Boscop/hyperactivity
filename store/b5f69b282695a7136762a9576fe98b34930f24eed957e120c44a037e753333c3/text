poly-main : List (List Word) → Step W Word
poly-main args =
  let p  = poly-pref args
      cf = list-append p ".c"
      mf = list-append p ".metal"
      uf = list-append p ".cu"
      sf = list-append p ".sv"
      wf = list-append p ".wasm"
  in scmd w-now (λ t0 →
     scmd (w-file-write-named cf poly-emit-c) (λ bc →
     scmd (w-file-write-named mf poly-emit-metal) (λ bm →
     scmd (w-file-write-named uf poly-emit-cuda) (λ bu →
     scmd (w-file-write-named sf poly-emit-sv) (λ bs →
     scmd (w-file-write-named wf poly-wasm-bytes) (λ bw →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-POLY (33rd Engine) | 8/8 PolyZ+PolyF2 certs=refl | C11=" (list-append (ce-dec bc)
       (list-append "B Metal=" (list-append (ce-dec bm)
       (list-append "B CUDA=" (list-append (ce-dec bu)
       (list-append "B SV=" (list-append (ce-dec bs)
       (list-append "B WASM=" (list-append (ce-dec bw)
       (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))))))))
       (sdone #0))))))))
