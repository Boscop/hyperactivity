-- UNIVERSAL RANGE-CODER SOUNDNESS OVER ALL WORDS (cubical induction via %welimP):
-- 1. Bit-0 interval [mid+1, hi]: for ANY mid, d : Word, code = (d+1) + mid ALWAYS decodes to #0!
hcm-ltw-add-succ : (m d : Word) → ltw m (plusw (%wsucc d) m) ≡ true
hcm-ltw-add-succ m d =
  %welimP (λ v → ltw v (plusw (%wsucc d) v) ≡ true) m (λ i → true) (λ k ih → ih)
