-- a store with no session/state (before it was kept) reaches its state by the log, once
hy-state-or-log : List Word → Nat → Sum Unit HyState → Proc W HyState
hy-state-or-log st n (inr s) = ret s
hy-state-or-log st n (inl u) = bind (hy-get st "session/log") (λ l → ret (hy-fold n (hy-walking (suc zero)) (hy-log-lines l)))
