      if(!e.a.alive || !e.b.alive) continue;
      ctx.beginPath(); ctx.moveTo(e.a.x, e.a.y); ctx.lineTo(e.b.x, e.b.y);
      ctx.strokeStyle = e.kind === 'crystal' ? blue : (dark ? 'rgba(255,255,255,0.35)' : 'rgba(0,0,0,0.3)');
      ctx.lineWidth = e.kind === 'crystal' ? 2 : 1.1;
      ctx.stroke();
      // Traveling mutual-information pulse along crystallized 1-cells
      if(e.kind === 'crystal'){
        const u = (t*0.6 + (e.a.x+e.b.y)*0.003) % 1;
        const px = e.a.x + (e.b.x - e.a.x)*u;
        const py = e.a.y + (e.b.y - e.a.y)*u;
        ctx.fillStyle = pink;
        ctx.beginPath(); ctx.arc(px, py, 2.5, 0, Math.PI*2); ctx.fill();
      }
    }

    // Draw split witness if active
    const surv = nodes.filter(n=>n.alive);
    if(splitActive && surv.length >= 2){
      const a = surv[0], b = surv[surv.length-1];
      ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y);
      ctx.strokeStyle = pink; ctx.lineWidth = 2.6; ctx.stroke();
      ctx.font = '700 11px ui-monospace, monospace'; ctx.fillStyle = pink;
      ctx.fillText('SPLIT WITNESS: P(h₁) ∧ ¬P(h₂)', (a.x+b.x)/2 - 80, (a.y+b.y)/2 - 10);
    }

    // Draw 0-cell nodes
    for(const n of nodes){
      if(!n.alive){
        ctx.fillStyle = dark ? 'rgba(255,255,255,0.12)' : 'rgba(0,0,0,0.1)';
        ctx.beginPath(); ctx.arc(n.x, n.y, 2.5, 0, Math.PI*2); ctx.fill();
