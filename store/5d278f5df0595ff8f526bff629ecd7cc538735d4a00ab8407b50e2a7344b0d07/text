      const ang = (i/N)*Math.PI*2 + Math.random()*0.4;
      const rad = 55 + Math.random()*95;
      nodes.push({
        x: W*0.5 + Math.cos(ang)*rad,
        y: H*0.5 + Math.sin(ang)*rad,
        vx: (Math.random()-0.5)*1.4,
        vy: (Math.random()-0.5)*1.4,
        alive: true,
        crystal: false,
        group: i % 4,
        tx: 0, ty: 0
      });
    }
    updateStat();
  }

  function updateStat(){
    const alive = nodes.filter(n=>n.alive).length;
    const crys = nodes.filter(n=>n.alive && n.crystal).length;
    const ent = Math.max(0, Math.log2(Math.max(1, alive - crys*0.75)));
    const mi = Math.max(0, Math.log2(N) - ent);
