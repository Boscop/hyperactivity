      'H = ' + ent.toFixed(2) + ' bits · I(A;B) = ' + mi.toFixed(2) + ' bits · ' + crystals + ' ua-crystals';
  }

  document.getElementById('l1-obs').onclick = function(){
    obsCount++;
    const alive = nodes.filter(n=>n.alive && !n.crystal);
    const drop = Math.max(1, Math.floor(alive.length * 0.35));
    for(let i=0;i<drop && i<alive.length;i++) alive[i].alive = false;
    // Add proof 1-cell edges among surviving nodes
    const surv = nodes.filter(n=>n.alive);
