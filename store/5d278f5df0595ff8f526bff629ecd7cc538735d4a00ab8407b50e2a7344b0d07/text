    ctx.fillStyle = dark ? 'rgba(255,255,255,0.65)' : 'rgba(0,0,0,0.65)';
    ctx.fillText('● 0-cell (state/type)   ─ 1-cell (proof)   ■ crystallized ua-lattice   ● MI flow', 14, H-12);
    requestAnimationFrame(tick);
  }
  tick();
})();

