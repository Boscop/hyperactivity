    }
    phiHist.push(phi);
    if(phiHist.length > 160) phiHist.shift();

    const mi = (-Math.log2(Math.max(0.05, 1 - phi*0.92))).toFixed(2);
    stat.textContent = 'Scale: ' + SCALES[cur].name + ' · Coherence Φ = ' + phi.toFixed(2) + ' · I(A;B) = ' + mi + ' bits';

    ctx.fillStyle = bg; ctx.fillRect(0,0,W,H);
    const splitX = W*0.60;

    // Draw edges between nearby / coupled nodes
    ctx.lineWidth = 1.1;
    for(let i=0;i<osc.length;i++){
      for(let j=i+1;j<osc.length;j++){
        const d = Math.hypot(osc[i].x-osc[j].x, osc[i].y-osc[j].y);
        const linked = (cur==='rna' && j===i+1) || (cur==='bio' && d<92) || (cur==='neuro' && ((i<osc.length/2)!==(j<osc.length/2)) && (i%3===j%3)) || (cur==='super' && d<125);
        if(linked){
          const coh = 0.5 + 0.5*Math.cos(osc[i].th - osc[j].th);
          ctx.strokeStyle = coh > 0.78 ? pink : (dark ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.18)');
          ctx.beginPath(); ctx.moveTo(osc[i].x, osc[i].y); ctx.lineTo(osc[j].x, osc[j].y); ctx.stroke();
        }
      }
    }

    // Draw coupled nodes with phase arrows
    for(const o of osc){
      const coh = 0.5 + 0.5*Math.cos(o.th - meanTh);
      ctx.beginPath(); ctx.arc(o.x, o.y, 9, 0, Math.PI*2);
      ctx.fillStyle = bg; ctx.fill();
      ctx.strokeStyle = coh > 0.8 ? blue : ink; ctx.lineWidth = 2; ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(o.x, o.y);
      ctx.lineTo(o.x + Math.cos(o.th)*8, o.y + Math.sin(o.th)*8);
      ctx.strokeStyle = pink; ctx.lineWidth = 2; ctx.stroke();
    }

    // Divider & right-side live Coherence Φ(t) telemetry trace
    ctx.strokeStyle = dark ? 'rgba(255,255,255,0.18)' : 'rgba(0,0,0,0.16)';
    ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(splitX, 16); ctx.lineTo(splitX, H-16); ctx.stroke();

    const gx = splitX + 18, gy = 48, gw = W - splitX - 34, gh = H - 96;
    ctx.strokeStyle = dark ? 'rgba(255,255,255,0.22)' : 'rgba(0,0,0,0.22)';
    ctx.strokeRect(gx, gy, gw, gh);
    ctx.font = '700 11px ui-monospace, monospace'; ctx.fillStyle = ink;
    ctx.fillText('COLLECTIVE COHERENCE Φ(t) ∈ [0, 1]', gx, gy - 12);

    if(phiHist.length > 1){
      ctx.beginPath();
      phiHist.forEach((v, idx)=>{
        const px = gx + (idx/(159))*gw;
        const py = gy + gh - v*gh;
        if(idx===0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      });
      ctx.strokeStyle = pink; ctx.lineWidth = 2.4; ctx.stroke();
    }

    ctx.font = '600 11px ui-monospace, monospace';
    ctx.fillStyle = blue;
    ctx.fillText(phi > 0.78 ? 'STATE: CRYSTALLIZED COHERENT ATTRACTOR' : 'STATE: UNCOUPLED / HIGH ENTROPY', gx, gy + gh + 22);
    requestAnimationFrame(tick);
  }
  tick();
})();
</script>
