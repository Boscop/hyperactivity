-- (part of language-support)
rml_size : (nbytes : ZI) → (addr : Bits #48) → (r_x : Text) → MS (Bits #128)
rml_size nbytes addr r_x =
  λ σ →
    if (z-lt nbytes (zpos #6)) then
      (if (z-lt nbytes (zpos #2)) then
         (if (z-eq nbytes (zpos #1)) then
            the (MS (Bits #128))
              (rml_size-case1 addr r_x) σ
          else
            the (MS (Bits #128))
              (rml_size-case8 nbytes addr r_x) σ)
       else
         (if (z-lt nbytes (zpos #4)) then
            (if (z-eq nbytes (zpos #2)) then
               the (MS (Bits #128))
                 (rml_size-case2 addr r_x) σ
             else
               the (MS (Bits #128))
                 (rml_size-case8 nbytes addr r_x) σ)
          else
            (if (z-eq nbytes (zpos #4)) then
               the (MS (Bits #128))
                 (rml_size-case3 addr r_x) σ
             else
               the (MS (Bits #128))
                 (rml_size-case8 nbytes addr r_x) σ)))
    else
      (if (z-lt nbytes (zpos #10)) then
         (if (z-lt nbytes (zpos #8)) then
            (if (z-eq nbytes (zpos #6)) then
               the (MS (Bits #128))
                 (rml_size-case4 addr r_x) σ
             else
               the (MS (Bits #128))
                 (rml_size-case8 nbytes addr r_x) σ)
          else
            (if (z-eq nbytes (zpos #8)) then
               the (MS (Bits #128))
                 (rml_size-case5 addr r_x) σ
             else
               the (MS (Bits #128))
                 (rml_size-case8 nbytes addr r_x) σ))
       else
         (if (z-lt nbytes (zpos #16)) then
            (if (z-eq nbytes (zpos #10)) then
               the (MS (Bits #128))
                 (rml_size-case6 addr r_x) σ
             else
               the (MS (Bits #128))
                 (rml_size-case8 nbytes addr r_x) σ)
          else
            (if (z-eq nbytes (zpos #16)) then
               the (MS (Bits #128))
                 (rml_size-case7 addr r_x) σ
             else
               the (MS (Bits #128))
                 (rml_size-case8 nbytes addr r_x) σ)))
