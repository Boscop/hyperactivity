-- the admission test, unchanged in shape: fast enough in this bath to average, and proper unless the
-- medium cannot tell the molecule from its mirror image
bm-admitted : Bath → BMotion → Bool
bm-admitted v q = case leb (bath-res v) (bm-rate q v) of
  false → false
  true → (case sol-chiral (bath-sol v) of false → true; true → bm-proper q)
