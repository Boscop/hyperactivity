-- the parity example: adding two moves within a parity fiber (the proof of parity is carried:
-- parity (suc (suc n)) is not (not (parity n)) by computation, and not (not b) ≡ b by cases)
not-not : (b : Bool) → not (not b) ≡ b
not-not b = case b return (λ x → not (not x) ≡ x) of true → λ i → true; false → λ i → false
