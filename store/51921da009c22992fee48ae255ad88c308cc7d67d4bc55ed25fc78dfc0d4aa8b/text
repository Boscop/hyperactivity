-- the meaning of a text in the record, the record unchanged (what /api/meaning answers as one types).
-- When more than 40 lines hold the selected end, the family is shown from the first 40 of them and
-- said to be part, its agreement not claimed.
c-meaning-of : List Word → Proc W (List Word)
c-meaning-of t = bind c-ready (λ u → bind (c-longest (c-flat t)) (λ s → bind (c-family-in "40" s) (λ cf →
  if wlt #40 (fst cf) then ret {lzero} {W} (list-append (h-line (list-append "(" (list-append (h-decimal (fst cf)) (list-append " lines hold " (list-append s "; what followed it in the first 40:)")))))
    (h-concat (list-map (λ x → h-line (list-append "  " x)) (snd cf))))
  else ret {lzero} {W} (c-meaning s (snd cf)))))
