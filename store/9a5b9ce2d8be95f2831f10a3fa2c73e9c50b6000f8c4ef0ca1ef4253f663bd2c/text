-- transport in a line of path types computes: the constant path at 3, carried along the constant
-- line of paths from 3 to 3 in the numbers, is the constant path at 3, by the path clause, the
-- composition it makes, and the number clauses (part of machine-in-hyperactive)
nk-kan-path : nk-norm (nk-transp (nk-lam (nk-pathp (nk-lam nk-N) (nk-num #3) (nk-num #3))) nk-i0 (nk-lam (nk-num #3))) ≡ nk-lam (nk-num #3)
nk-kan-path = refl
