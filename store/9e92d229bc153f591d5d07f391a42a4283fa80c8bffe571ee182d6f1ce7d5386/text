cs-sim-bool-con : (hp : CsHeap) (b : Bool) →
  cs-res-rel (cmv-bool b) (cs-hy-con hp (if b then #0 else #1) lnil) ≡ true
cs-sim-bool-con hp b =
  let tag = cs-bool-tag b
      blk = lcons (csv-word tag) lnil
      ld0 = cong cs-optv (cs-alloc-load-self hp blk zero)
  in cong (λ t → cs-res-rel (cmv-bool b) (cs-hy-con hp t lnil)) (cs-if-bool-tag b)
     ∙ (cong (λ o → cs-ov-word-eq o tag) ld0 ∙ cs-weq-self tag)
