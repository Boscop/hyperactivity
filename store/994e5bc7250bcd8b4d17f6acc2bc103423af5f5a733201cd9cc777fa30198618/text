col-diff-undiff-go : (B : Word) → (prev : List (Bounded B)) → (drows : List (List (Bounded B))) →
                     col-diff-mod-go B prev (col-undiff-mod-go B prev drows) ≡ drows
col-diff-undiff-go B prev drows =
  (case drows return (λ u → (p : List (Bounded B)) → col-diff-mod-go B p (col-undiff-mod-go B p u) ≡ u) of
     nil → λ p i → nil
     cons drow r → λ p →
       let row = zip-mundiff B p drow
       in λ i → cons (zip-mdiff-mundiff B p drow i) (rec r row i)) prev
