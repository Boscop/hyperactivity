-- the focus added to the reader's path walked when writable; on read-only public GET, existing path + focus returned without mutating disk
hi-walk : List Word → List Word → List Word → Proc W (List (List Word))
hi-walk st rd f = bind (h-mkdir (list-append st "/hi")) (λ u → bind (h-read (hi-walk-path st rd)) (λ w →
  bind (h-write (hi-walk-path st rd) (list-append (s-or nil w) (h-line f))) (λ b → ret (h-lines (list-append (s-or nil w) (h-line f))))))
