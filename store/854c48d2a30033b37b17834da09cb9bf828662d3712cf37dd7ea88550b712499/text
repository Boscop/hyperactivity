-- Any forged object returned along a corrupted multi-hop path is stripped to absent (inl unit)
dht-forged-hop-rejected : {b : Nat} {N K V : Type} → (chk : K → V → Bool) → (fuel : Nat) →
  (nid : N → BKey b) → (kid : K → BKey b) → (rt : N → List N) → (stores : N → CAStore K V) →
  (start : N) → (k : K) → (bad : V) →
  dht-walk {b} fuel nid kid rt stores start k ≡ inr bad → chk k bad ≡ false →
  dht-lookup {b} chk fuel nid kid rt stores start k ≡ inl unit
dht-forged-hop-rejected {b} chk fuel nid kid rt stores start k bad walkEq badChk =
  (λ i → ca-check chk k (walkEq i)) ∙ peer-forged-rejected chk k bad badChk
