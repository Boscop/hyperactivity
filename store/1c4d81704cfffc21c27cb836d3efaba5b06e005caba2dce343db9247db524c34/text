-- the executor run for at most k steps: it stops when no wire is left to step (as first written
-- it went through all k, a step with nothing to do changing nothing: every normal form cost k of
-- those, 30000 as called)
nk-run : Nat → NkExec → NkExec
nk-run zero st = st
nk-run (suc k) (nk-exec nkw-nil n sl) = nk-exec nkw-nil n sl
nk-run (suc k) (nk-exec (nkw-cons u r) n sl) = nk-run k (nk-exec-step (nk-exec (nkw-cons u r) n sl))
