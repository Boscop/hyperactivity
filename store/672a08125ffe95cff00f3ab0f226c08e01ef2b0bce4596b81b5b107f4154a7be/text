tp-det : (Γ1 Γ2 : CCtx) (pΓ : PathP (λ i → CCtx) Γ1 Γ2) (a1 a2 : TyShape) (T1 : Mean Γ1 (Sem (s-path a1))) (T2 : Mean Γ2 (Sem (s-path a2))) (l1 u1 v1 l2 u2 v2 : Code) →
  DetR (j-ty , dext Γ1 , a1 , l1 , path-line-ty Γ1 a1 T1) (j-ty , dext Γ2 , a2 , l2 , path-line-ty Γ2 a2 T2) (λ i → dext (pΓ i)) →
  DetR (j-tm , Γ1 , a1 , u1 , fmapM Γ1 (Sem (s-path a1)) (TV a1) (tend-0 a1) T1) (j-tm , Γ2 , a2 , u2 , fmapM Γ2 (Sem (s-path a2)) (TV a2) (tend-0 a2) T2) pΓ →
  DetR (j-tm , Γ1 , a1 , v1 , fmapM Γ1 (Sem (s-path a1)) (TV a1) (tend-1 a1) T1) (j-tm , Γ2 , a2 , v2 , fmapM Γ2 (Sem (s-path a2)) (TV a2) (tend-1 a2) T2) pΓ →
  DetR (concl r-ty-path (x-tp Γ1 a1 T1 l1 u1 v1)) (concl r-ty-path (x-tp Γ2 a2 T2 l2 u2 v2)) pΓ
tp-det Γ1 Γ2 pΓ a1 a2 T1 T2 l1 u1 v1 l2 u2 v2 eL e0 e1 =
  ((λ i → j-ty) , (λ i → s-path (fst (snd eL) i)) ,
   (λ i → cpathp (cplam (fst (snd (snd eL)) i)) (fst (snd (snd e0)) i) (fst (snd (snd e1)) i)) ,
   tp-join Γ1 Γ2 pΓ a1 a2 (fst (snd eL)) T1 T2
     (rebase (dext Γ1) (dext Γ2) (λ i → dext (pΓ i)) j-ty j-ty a1 a2 (path-line-ty Γ1 a1 T1) (path-line-ty Γ2 a2 T2) (fst eL) (λ i → j-ty) (fst (snd eL)) (fst (snd eL)) (snd (snd (snd eL))))
     (rebase Γ1 Γ2 pΓ j-tm j-tm a1 a2 (fmapM Γ1 (Sem (s-path a1)) (TV a1) (tend-0 a1) T1) (fmapM Γ2 (Sem (s-path a2)) (TV a2) (tend-0 a2) T2) (fst e0) (λ i → j-tm) (fst (snd e0)) (fst (snd eL)) (snd (snd (snd e0))))
     (rebase Γ1 Γ2 pΓ j-tm j-tm a1 a2 (fmapM Γ1 (Sem (s-path a1)) (TV a1) (tend-1 a1) T1) (fmapM Γ2 (Sem (s-path a2)) (TV a2) (tend-1 a2) T2) (fst e1) (λ i → j-tm) (fst (snd e1)) (fst (snd eL)) (snd (snd (snd e1)))))
