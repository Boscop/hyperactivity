q0e : (Γ : CCtx) (a : TyShape) (T : Mean Γ (Sem (s-path a))) →
  PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) (fmapM Γ (Sem (s-path a)) (TV a) (tend-0 a) T)) (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst l) (ul Γ (Sem a) (path-line-ty Γ a T)))
q0e Γ a T =
  pcat (Mean Γ (Sem a)) (fmapM Γ (TV a) (Sem a) (λ q → fst q) (fmapM Γ (Sem (s-path a)) (TV a) (tend-0 a) T)) (fmapM Γ (Sem (s-path a)) (Sem a) (λ D → fst (fst D)) T)
    (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst l) (ul Γ (Sem a) (path-line-ty Γ a T)))
    (fmapM-fmapM Γ (Sem (s-path a)) (TV a) (Sem a) (tend-0 a) (λ q → fst q) T)
    (psym (Mean Γ (Sem a)) (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst l) (ul Γ (Sem a) (path-line-ty Γ a T))) (fmapM Γ (Sem (s-path a)) (Sem a) (λ D → fst (fst D)) T)
       (pcat (Mean Γ (Sem a)) (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst l) (ul Γ (Sem a) (path-line-ty Γ a T)))
          (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst l) (fmapM Γ (Sem (s-path a)) (Line (Sem a)) (ty-line a) T)) (fmapM Γ (Sem (s-path a)) (Sem a) (λ D → fst (fst D)) T)
          (λ i → fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst l) (ul-eta Γ (Sem (s-path a)) (Sem a) (ty-line a) T i))
          (fmapM-fmapM Γ (Sem (s-path a)) (Line (Sem a)) (Sem a) (ty-line a) (λ l → fst l) T)))
