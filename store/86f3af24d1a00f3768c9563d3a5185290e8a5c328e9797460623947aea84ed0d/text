cx-tc : CType → CxTC
cx-tc (ct-builtin b) = case b of
  ctb-void → cxtc-void
  ctb-bound-member → cxtc-fn
  ctb-builtin-fn → cxtc-fn
  _ → cxtc-scalar
cx-tc (ct-pointer u) = cxtc-scalar
cx-tc (ct-lref u) = cxtc-ref u
cx-tc (ct-rref u) = cxtc-ref u
cx-tc (ct-array u n) = cxtc-array u n
cx-tc (ct-record id) = cxtc-record id
cx-tc (ct-enum id) = cxtc-scalar
cx-tc (ct-function ret ps va cn vo rf ne) = cxtc-fn
cx-tc (ct-member-pointer cls u) = case cx-tc u of
  cxtc-fn → cxtc-mfp
  _ → cxtc-scalar
cx-tc (ct-qual cn vo rs u) = cx-tc u
cx-tc ct-nil = cxtc-void
cx-tc (ct-cons x xs) = cxtc-void
