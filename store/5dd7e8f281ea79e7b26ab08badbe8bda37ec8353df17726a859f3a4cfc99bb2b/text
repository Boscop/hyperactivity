rf-thm-inv-f2 = refl

rf-thm-inv-f3 : rf-all-nz #3 (λ a → %weq (rf-mul #3 a (rf-inv #3 a)) #1) ≡ true
rf-thm-inv-f3 = refl

rf-thm-inv-f167 : rf-all-nz #167 (λ a → %weq (rf-mul #167 a (rf-inv #167 a)) #1) ≡ true
