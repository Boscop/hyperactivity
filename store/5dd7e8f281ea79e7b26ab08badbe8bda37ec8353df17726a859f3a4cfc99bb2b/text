-- ============================================================================
-- SECTION 1: EXACT PRIME-FIELD F_p ARITHMETIC CORE (ALL PRIMES p >= 2)
-- ============================================================================

rf-add : Word → Word → Word → Word
rf-add p a b = %wmod (%wadd a b) p

rf-sub : Word → Word → Word → Word
rf-sub p a b = %wmod (%wadd (%wsub p (%wmod b p)) (%wmod a p)) p

rf-mul : Word → Word → Word → Word
rf-mul p a b = %wmod (%wmul a b) p

rf-pow-go : Nat → Word → Word → Word → Word → Word
rf-pow-go zero    _ _ _ acc = acc
rf-pow-go (suc k) p b e acc =
  if %weq e #0 then acc
  else
    let acc2 = if %weq (%wand e #1) #1 then rf-mul p acc b else acc
        b2   = rf-mul p b b
        e2   = %wshr e #1
    in rf-pow-go k p b2 e2 acc2

-- Fermat inverse in F_p: a^(p - 2) mod p
rf-inv : Word → Word → Word
rf-inv p a = rf-pow-go (toNat #32) p (%wmod a p) (%wsub p #2) #1

rf-all-nz-go : Nat → Word → Word → (Word → Bool) → Bool
rf-all-nz-go zero    _ _   _ = true
rf-all-nz-go (suc k) p cur f =
  if f cur then rf-all-nz-go k p (%wsucc cur) f else false

rf-all-nz : Word → (Word → Bool) → Bool
rf-all-nz p f = rf-all-nz-go (toNat (%wsub p #1)) p #1 f

-- THEOREM 1, 2, 3: EXACT MULTIPLICATIVE INVERSE ACROSS ALL NONZERO ELEMENTS OF F_2, F_3, AND F_167 (H_668)!
