-- every bond single; the root has none
gl-ord : Glyc → Bond
gl-ord x = case x of
  gl-c1 → bond-single
  gl-o1 → bond-single
  gl-ho1 → bond-single
  gl-h1a → bond-single
  gl-h1b → bond-single
  gl-c2 → bond-none
  gl-o2 → bond-single
  gl-ho2 → bond-single
  gl-h2 → bond-single
  gl-c3 → bond-single
  gl-o3 → bond-single
  gl-ho3 → bond-single
  gl-h3a → bond-single
  gl-h3b → bond-single
