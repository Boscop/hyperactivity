io-safety-check : Bool → Bool → Bool → Bool
io-safety-check a b v =
  let wa   = io-b2w a
      wb   = io-b2w b
      wv   = io-b2w v
      comm = io-eval-bit io-w-commute (toNat #6) wa wb wv
      ann  = io-joint-annihilate wa wb wv
      era1 = io-eval-bit io-w-era-prune (toNat #6) wa wb #1
      fire = io-eval-bit io-w-vxchg-fire (toNat #5) wa wb #1
      clk0 = io-eval-bit io-w-gals-clk (toNat #4) wv #1 #0
      ok1  = %weq (%wand comm ann) #0
      ok2  = %weq (%wor comm ann) wv
      ok3  = %weq era1 #1
      ok4  = %weq fire #0
      ok5  = %weq clk0 #0
  in if ok1 then if ok2 then if ok3 then if ok4 then ok5 else false else false else false else false
