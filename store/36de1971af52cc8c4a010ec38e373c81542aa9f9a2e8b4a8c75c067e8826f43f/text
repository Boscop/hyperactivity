ossc-hero-stage : List Word
ossc-hero-stage =
  h-concat (
    cons "<section class='os-hero-stage'><div class='os-canvas-wrap'><canvas id='ossc-live'></canvas>" (
    cons "<div class='os-hud-top'><div class='os-pill-group'>" (
    cons "<button class='os-pill on' data-osmode='dor'>2^d Hypercube DOR</button>" (
    cons "<button class='os-pill' data-osmode='cayley'>Cayley SU(2) Wet-Lab</button>" (
    cons "<button class='os-pill' data-osmode='tower'>Datacenter(g) &amp; 32-Engine Tower</button>" (
    cons "</div><div class='os-wasm-badge' id='ossc-wbadge'><span class='os-pulse'></span>BOOTING /hx/supercomp.wasm ...</div></div></div>" (
    cons "<div class='os-hud-bar'><label class='os-scrub'><span id='ossc-dlbl'>d=20</span><input id='ossc-dim' type='range' min='1' max='20' value='20'></label>" (
    cons "<div class='os-live-readout' id='ossc-rd'>Instantiating kernel-compiled /hx/supercomp.wasm ...</div></div></section>" nil))))))))
