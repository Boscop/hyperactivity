-- icons, RSS discovery, Open Graph, Twitter card, and optional canonical URL
s-og-at : List Word → List Word → List Word → List Word → List Word
s-og-at t desc ogtype url = h-concat (cons "<link rel='icon' href='/favicon.ico?v=lv2' sizes='32x32'><link rel='icon' type='image/png' sizes='32x32' href='/favicon-32.png?v=lv2'><link rel='icon' type='image/svg+xml' href='/favicon.svg?v=lv2'><link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png?v=lv2'><link rel='alternate' type='application/rss+xml' title='Hyperactive Labs' href='https://hyperactivity.ai/feed.xml'>" (cons (if h-null url then nil else h-concat (cons "<link rel='canonical' href='" (cons url (cons "'><meta property='og:url' content='" (cons url (cons "'>" nil)))))) (cons "<meta property='og:site_name' content='Hyperactive Labs'><meta property='og:title' content='" (cons t (cons "'><meta property='og:description' content='" (cons desc (cons "'><meta property='og:type' content='" (cons ogtype (cons "'><meta property='og:image' content='https://hyperactivity.ai/og.png?v=lv2'><meta property='og:image:width' content='1200'><meta property='og:image:height' content='630'><meta name='twitter:card' content='summary_large_image'>" nil)))))))))
