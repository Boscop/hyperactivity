bn-lem-add2 _ _ in-var0           = refl
bn-lem-add2 _ _ (in-dup-add _)    = refl
bn-lem-add2 _ _ (in-add _ _)      = refl
bn-lem-add2 _ _ (in-xor _ _)      = refl
bn-lem-add2 _ _ (in-era-l _ _)    = refl
bn-lem-add2 _ _ (in-lut3 _ _ _ _) = refl
