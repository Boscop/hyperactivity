-- 8. Full Adder (SUM, CARRY): 4 ANDs/ORs -> 1 AND (-75% MC!) via shared SSA DAG
cert-full-adder : F2OptCert
cert-full-adder =
  mk-f2-cert "full_adder"
    (f2prog #3 nil
      (cons (f2-xor (f2-xor (f2-v #0) (f2-v #1)) (f2-v #2))
      (cons (f2-or (f2-or (f2-and (f2-v #0) (f2-v #1)) (f2-and (f2-v #0) (f2-v #2))) (f2-and (f2-v #1) (f2-v #2))) nil)))
    (f2prog #3
      (cons (#3 , f2-xor (f2-v #0) (f2-v #2))
      (cons (#4 , f2-xor (f2-v #1) (f2-v #2)) nil))
      (cons (f2-xor (f2-v #3) (f2-v #1))
      (cons (f2-xor (f2-v #2) (f2-and (f2-v #3) (f2-v #4))) nil)))
    refl refl
