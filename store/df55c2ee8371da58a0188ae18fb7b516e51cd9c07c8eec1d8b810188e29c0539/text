-- (k + 1) + (QD + R) = D + QD when k + (R + 1) = D
div-up-alg : (k R Q D A : Nat) → plus k (suc R) ≡ D → A ≡ plus (times Q D) R → plus (suc k) A ≡ plus D (times Q D)
div-up-alg k R Q D A h hA =
  transN (congN (λ z → suc (plus k z)) hA)
  (transN (congN suc (plus-comm-mid k (times Q D) R))
  (transN (symN (plus-suc (times Q D) (plus k R)))
  (transN (congN (plus (times Q D)) (symN (plus-suc k R)))
  (transN (congN (plus (times Q D)) h)
  (plus-comm (times Q D) D)))))
