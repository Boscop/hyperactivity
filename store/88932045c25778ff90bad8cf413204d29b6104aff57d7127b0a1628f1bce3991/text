vx-sym : {A : Type} → {x y : A} → x ≡ y → y ≡ x
vx-sym p = λ i → p (~ i)

vx-trans : {A : Type} → {x y z : A} → x ≡ y → y ≡ z → x ≡ z
vx-trans {A} {x} {y} {z} p q =
  λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

vx-cong : {A B : Type} → (f : A → B) → {x y : A} → x ≡ y → f x ≡ f y
vx-cong f p = λ i → f (p i)

vx-cong2 : {A B C : Type} → (f : A → B → C) → {a1 a2 : A} → {b1 b2 : B} →
  a1 ≡ a2 → b1 ≡ b2 → f a1 b1 ≡ f a2 b2
vx-cong2 f p q = λ i → f (p i) (q i)

