data VxSys (S I O : Type) : Type where
  mk-vxsys : (s0 : S) → (step : S → I → O × S) → (cost : Word) → VxSys S I O

vx-exec : {S I O : Type} → (S → I → O × S) → S → List I → List O
vx-exec stp s nil         = nil
vx-exec stp s (cons x xs) =
  let r = stp s x
  in cons (fst r) (vx-exec stp (snd r) xs)

vx-run : {S I O : Type} → VxSys S I O → List I → List O
vx-run (mk-vxsys s0 stp c) tr = vx-exec stp s0 tr

-- THEOREM 1: UNIVERSAL RELATIONAL SIMULATION SOUNDNESS OVER ALL TRACES!
-- Regardless of whether S1 and S2 are finite, infinite, encoded, or retimed,
-- a step-preserving simulation relation R guarantees identical observable output streams
-- across ALL finite-horizon traces `tr : List I`!
vx-thm-sim-exec : {S1 S2 I O : Type} →
  (stp1 : S1 → I → O × S1) →
  (stp2 : S2 → I → O × S2) →
  (R : S1 → S2 → Type) →
  ((s1 : S1) → (s2 : S2) → (x : I) → R s1 s2 →
    (fst (stp1 s1 x) ≡ fst (stp2 s2 x)) × R (snd (stp1 s1 x)) (snd (stp2 s2 x))) →
  (s1 : S1) → (s2 : S2) → R s1 s2 → (tr : List I) →
  vx-exec stp1 s1 tr ≡ vx-exec stp2 s2 tr
vx-thm-sim-exec stp1 stp2 R hstep s1 s2 hr nil = refl
vx-thm-sim-exec stp1 stp2 R hstep s1 s2 hr (cons x xs) =
  let stepCert = hstep s1 s2 x hr
  in vx-cong2 cons (fst stepCert)
       (vx-thm-sim-exec stp1 stp2 R hstep (snd (stp1 s1 x)) (snd (stp2 s2 x)) (snd stepCert) xs)

vx-thm-sim-sound : {S1 S2 I O : Type} →
  (s10 : S1) → (stp1 : S1 → I → O × S1) → (c1 : Word) →
  (s20 : S2) → (stp2 : S2 → I → O × S2) → (c2 : Word) →
  (R : S1 → S2 → Type) →
  R s10 s20 →
  ((s1 : S1) → (s2 : S2) → (x : I) → R s1 s2 →
    (fst (stp1 s1 x) ≡ fst (stp2 s2 x)) × R (snd (stp1 s1 x)) (snd (stp2 s2 x))) →
  (tr : List I) →
  vx-run (mk-vxsys s10 stp1 c1) tr ≡ vx-run (mk-vxsys s20 stp2 c2) tr
vx-thm-sim-sound s10 stp1 c1 s20 stp2 c2 R h0 hstep tr =
  vx-thm-sim-exec stp1 stp2 R hstep s10 s20 h0 tr

-- THEOREM 2: COMPOSITIONAL TRANSITIVITY OF SYSTEM EQUIVALENCE (Spec ≈ Mid ≈ Impl => Spec ≈ Impl)
vx-thm-sim-compose : {S1 S2 S3 I O : Type} →
  (sys1 : VxSys S1 I O) → (sys2 : VxSys S2 I O) → (sys3 : VxSys S3 I O) →
  ((tr : List I) → vx-run sys1 tr ≡ vx-run sys2 tr) →
  ((tr : List I) → vx-run sys2 tr ≡ vx-run sys3 tr) →
  (tr : List I) → vx-run sys1 tr ≡ vx-run sys3 tr
vx-thm-sim-compose sys1 sys2 sys3 e12 e23 tr = vx-trans (e12 tr) (e23 tr)

-- THEOREM 3: EXACT REFUTATION SOUNDNESS (Any distinguishing trace `cex` refutes ALL simulations!)
vx-thm-cex-refutes : {S1 S2 I O : Type} →
  (s10 : S1) → (stp1 : S1 → I → O × S1) → (c1 : Word) →
  (s20 : S2) → (stp2 : S2 → I → O × S2) → (c2 : Word) →
  (cex : List I) →
  ((vx-run (mk-vxsys s10 stp1 c1) cex ≡ vx-run (mk-vxsys s20 stp2 c2) cex) → Empty) →
  (R : S1 → S2 → Type) →
  R s10 s20 →
  ((s1 : S1) → (s2 : S2) → (x : I) → R s1 s2 →
    (fst (stp1 s1 x) ≡ fst (stp2 s2 x)) × R (snd (stp1 s1 x)) (snd (stp2 s2 x))) →
  Empty
vx-thm-cex-refutes s10 stp1 c1 s20 stp2 c2 cex hneq R h0 hstep =
  hneq (vx-thm-sim-sound s10 stp1 c1 s20 stp2 c2 R h0 hstep cex)

