-- 1. 4-Step Sequential LFSR (x^4 + x + 1) State Update Spec vs 1-Cycle Parallel Jump-4 XOR Matrix Impl
--    Inputs: v0..v3 = state s0..s3, v4..v7 = serial stream bits x0..x3.
--    Spec executes 4 sequential feedback shift stages; Impl computes all 4 next-state bits in 1 flat XOR rank!
vx-lfsr4-spec : F2Prog
vx-lfsr4-spec =
  f2prog #8
    (cons (#8  , f2-xor (f2-xor (f2-v #0) (f2-v #1)) (f2-v #4))
    (cons (#9  , f2-xor (f2-xor (f2-v #1) (f2-v #2)) (f2-v #5))
    (cons (#10 , f2-xor (f2-xor (f2-v #2) (f2-v #3)) (f2-v #6))
    (cons (#11 , f2-xor (f2-xor (f2-v #3) (f2-v #8)) (f2-v #7)) nil))))
    (cons (f2-v #8) (cons (f2-v #9) (cons (f2-v #10) (cons (f2-v #11) nil))))

vx-lfsr4-cand : F2Prog
vx-lfsr4-cand =
  f2prog #8 nil
    (cons (f2-xor (f2-xor (f2-v #0) (f2-v #1)) (f2-v #4))
    (cons (f2-xor (f2-xor (f2-v #1) (f2-v #2)) (f2-v #5))
    (cons (f2-xor (f2-xor (f2-v #2) (f2-v #3)) (f2-v #6))
    (cons (f2-xor (f2-xor (f2-xor (f2-v #0) (f2-v #1)) (f2-v #3)) (f2-xor (f2-v #4) (f2-v #7))) nil))))

vx-cert-lfsr-jump4 : F2OptCert
vx-cert-lfsr-jump4 = mk-f2-cert "vx_lfsr_jump4" vx-lfsr4-spec vx-lfsr4-cand refl refl

-- 2. 2-Stage Cascaded Hardware Priority Mux/Arbiter Spec (6 AND/ORs) vs ANF-Superoptimized 2-AND DAG (-66.7%!)
--    v0=s0, v1=s1, v2=a, v3=b, v4=c:  s1 ? (s0 ? a : b) : c  ===  c ^ (s1 & (b ^ c ^ (s0 & (a ^ b))))
vx-mux4-spec : F2Prog
vx-mux4-spec =
  f2prog #5
    (cons (#5 , f2-or (f2-and (f2-v #0) (f2-v #2)) (f2-and (f2-not (f2-v #0)) (f2-v #3))) nil)
    (cons (f2-or (f2-and (f2-v #1) (f2-v #5)) (f2-and (f2-not (f2-v #1)) (f2-v #4))) nil)

vx-mux4-cand : F2Prog
vx-mux4-cand =
  f2prog #5
    (cons (#5 , f2-and (f2-v #0) (f2-xor (f2-v #2) (f2-v #3))) nil)
    (cons (f2-xor (f2-v #4) (f2-and (f2-v #1) (f2-xor (f2-xor (f2-v #3) (f2-v #4)) (f2-v #5)))) nil)

vx-cert-mux-pipe4 : F2OptCert
vx-cert-mux-pipe4 = mk-f2-cert "vx_mux_pipe4" vx-mux4-spec vx-mux4-cand refl refl

-- 3. Coupled Eigenmode + Bilinear State-Space Step Spec (8 muls) vs Gauss-Factored Superopt Impl (4 muls, -50%!)
vx-eigen-spec : RProg
vx-eigen-spec =
  rprog #8 nil
    (cons (re-add (re-add (re-mul (re-v #0) (re-v #2)) (re-mul (re-v #0) (re-v #3)))
                  (re-add (re-mul (re-v #1) (re-v #2)) (re-mul (re-v #1) (re-v #3))))
    (cons (re-sub (re-mul (re-v #4) (re-v #6)) (re-mul (re-v #5) (re-v #7)))
    (cons (re-add (re-mul (re-v #4) (re-v #7)) (re-mul (re-v #5) (re-v #6))) nil)))

vx-eigen-cand : RProg
vx-eigen-cand =
  rprog #8
    (cons (#8  , re-mul (re-add (re-v #0) (re-v #1)) (re-add (re-v #2) (re-v #3)))
    (cons (#9  , re-mul (re-v #4) (re-v #6))
    (cons (#10 , re-mul (re-v #5) (re-v #7))
    (cons (#11 , re-mul (re-add (re-v #4) (re-v #5)) (re-add (re-v #6) (re-v #7))) nil))))
    (cons (re-v #8)
    (cons (re-sub (re-v #9) (re-v #10))
    (cons (re-sub (re-sub (re-v #11) (re-v #9)) (re-v #10)) nil)))

vx-cert-coupled-eigen : PolyOptCert
vx-cert-coupled-eigen = mk-poly-cert "vx_coupled_eigen" vx-eigen-spec vx-eigen-cand refl refl

-- 4. Unfactored Degree-3 Polynomial Pipeline Spec (6 muls) vs Horner Recurrence Impl (3 muls, -50%!)
--    v0 + v1*v4 + v2*v4^2 + v3*v4^3  ===  v0 + v4*(v1 + v4*(v2 + v4*v3))
vx-horner-spec : RProg
vx-horner-spec =
  rprog #5 nil
    (cons (re-add
            (re-add (re-v #0) (re-mul (re-v #1) (re-v #4)))
            (re-add (re-mul (re-v #2) (re-mul (re-v #4) (re-v #4)))
                    (re-mul (re-v #3) (re-mul (re-v #4) (re-mul (re-v #4) (re-v #4)))))) nil)

vx-horner-cand : RProg
vx-horner-cand =
  rprog #5 nil
    (cons (re-add (re-v #0)
            (re-mul (re-v #4)
              (re-add (re-v #1)
                (re-mul (re-v #4)
                  (re-add (re-v #2) (re-mul (re-v #4) (re-v #3))))))) nil)

vx-cert-horner-deg3 : PolyOptCert
vx-cert-horner-deg3 = mk-poly-cert "vx_horner_deg3" vx-horner-spec vx-horner-cand refl refl

vx-ring-certs : List PolyOptCert
vx-ring-certs = cons vx-cert-coupled-eigen (cons vx-cert-horner-deg3 nil)

vx-f2-certs : List F2OptCert
vx-f2-certs = cons vx-cert-lfsr-jump4 (cons vx-cert-mux-pipe4 nil)

