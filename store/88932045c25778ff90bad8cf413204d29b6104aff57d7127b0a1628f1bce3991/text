-- THEOREM 4: UNIVERSAL 2-STEP RELATIONAL k-INDUCTION OVER INFINITE TRAJECTORIES!
-- When 1-step invariants are not inductive (e.g. 2-stage forwarding pipelines, retimed loops),
-- proving Base(0), Base(1), and Inv(t) & Inv(t+1) => Inv(t+2) establishes Inv(t) for ALL t : Nat!
vx-kind2-pair : (Inv : Nat → Type) →
  Inv zero →
  Inv (suc zero) →
  ((t : Nat) → Inv t → Inv (suc t) → Inv (suc (suc t))) →
  (t : Nat) → Inv t × Inv (suc t)
vx-kind2-pair Inv b0 b1 ind zero = (b0 , b1)
vx-kind2-pair Inv b0 b1 ind (suc t) =
  let ih = vx-kind2-pair Inv b0 b1 ind t
  in (snd ih , ind t (fst ih) (snd ih))

vx-thm-kind2-sound : (Inv : Nat → Type) →
  Inv zero →
  Inv (suc zero) →
  ((t : Nat) → Inv t → Inv (suc t) → Inv (suc (suc t))) →
  (t : Nat) → Inv t
vx-thm-kind2-sound Inv b0 b1 ind t = fst (vx-kind2-pair Inv b0 b1 ind t)

-- THEOREM 5: UNIVERSAL 2-WIDE MACRO-STEP SUPEROPTIMIZATION EQUIVALENCE!
-- If `stepFast s x0 x1` computes 2 sequential steps `step1 (step1 s x0) x1` in 1 fused cycle,
-- then running `stepFast` over ANY stream of input pairs reaches the EXACT same state!
vx-fold1-pairs : {S I : Type} → (S → I → S) → S → List (I × I) → S
vx-fold1-pairs stp s nil         = s
vx-fold1-pairs stp s (cons p ps) = vx-fold1-pairs stp (stp (stp s (fst p)) (snd p)) ps

vx-fold2-macro : {S I : Type} → (S → I → I → S) → S → List (I × I) → S
vx-fold2-macro fast s nil         = s
vx-fold2-macro fast s (cons p ps) = vx-fold2-macro fast (fast s (fst p) (snd p)) ps

vx-thm-unroll2-sound : {S I : Type} →
  (stp : S → I → S) →
  (fast : S → I → I → S) →
  ((s : S) → (x0 x1 : I) → fast s x0 x1 ≡ stp (stp s x0) x1) →
  (s : S) → (ps : List (I × I)) →
  vx-fold2-macro fast s ps ≡ vx-fold1-pairs stp s ps
vx-thm-unroll2-sound stp fast h s nil = refl
vx-thm-unroll2-sound stp fast h s (cons p ps) =
  vx-trans
    (vx-cong (λ q → vx-fold2-macro fast q ps) (h s (fst p) (snd p)))
    (vx-thm-unroll2-sound stp fast h (stp (stp s (fst p)) (snd p)) ps)

-- INFINITE-STATE HARDWARE CASE STUDY: Direct-Form vs Transposed-Systolic 2-Tap Volterra/FIR Filter
-- Holds for ANY arbitrary linear or nonlinear tap operators `f1 f2 : Word → Word`!
-- Spec holds raw input history `(x1, x2)` and computes `x + (f1(x1) + f2(x2))` on the critical path;
-- Transposed Impl holds pre-accumulated partial sums `(p0, p1)` where `p0 = f1(x1) + f2(x2)`, `p1 = f2(x1)`,
-- cutting critical-path combinational depth in HALF across an INFINITE `Word × Word` state space!
vx-fir2-spec-step : (Word → Word) → (Word → Word) → (Word × Word) → Word → Word × (Word × Word)
vx-fir2-spec-step f1 f2 st x =
  (%wadd x (%wadd (f1 (fst st)) (f2 (snd st))) , (x , fst st))

vx-fir2-impl-step : (Word → Word) → (Word → Word) → (Word × Word) → Word → Word × (Word × Word)
vx-fir2-impl-step f1 f2 st x =
  (%wadd x (fst st) , (%wadd (f1 x) (snd st) , f2 x))

vx-fir2-rel : (Word → Word) → (Word → Word) → (Word × Word) → (Word × Word) → Type
vx-fir2-rel f1 f2 s1 s2 =
  (fst s2 ≡ %wadd (f1 (fst s1)) (f2 (snd s1))) ×
  (snd s2 ≡ f2 (fst s1))

vx-fir2-step-lemma : (f1 f2 : Word → Word) → (s1 s2 : Word × Word) → (x : Word) →
  vx-fir2-rel f1 f2 s1 s2 →
  (fst (vx-fir2-spec-step f1 f2 s1 x) ≡ fst (vx-fir2-impl-step f1 f2 s2 x)) ×
  vx-fir2-rel f1 f2 (snd (vx-fir2-spec-step f1 f2 s1 x)) (snd (vx-fir2-impl-step f1 f2 s2 x))
vx-fir2-step-lemma f1 f2 s1 s2 x hr =
  (vx-cong (λ v → %wadd x v) (vx-sym (fst hr)) ,
   (vx-cong (λ v → %wadd (f1 x) v) (snd hr) , refl))

-- Universal theorem over ALL arbitrary tap functions `f1, f2 : Word → Word`, ALL initial histories, and ALL input streams `tr`!
vx-thm-fir2-retiming-sound : (f1 f2 : Word → Word) → (x10 x20 : Word) → (tr : List Word) →
  vx-run (mk-vxsys (x10 , x20) (vx-fir2-spec-step f1 f2) #4) tr ≡
  vx-run (mk-vxsys (%wadd (f1 x10) (f2 x20) , f2 x10) (vx-fir2-impl-step f1 f2) #2) tr
vx-thm-fir2-retiming-sound f1 f2 x10 x20 tr =
  vx-thm-sim-sound
    (x10 , x20) (vx-fir2-spec-step f1 f2) #4
    (%wadd (f1 x10) (f2 x20) , f2 x10) (vx-fir2-impl-step f1 f2) #2
    (vx-fir2-rel f1 f2)
    (refl , refl)
    (vx-fir2-step-lemma f1 f2)
    tr

-- Cold-reset corollary at `(#0, #0)` for concrete linear taps `(3, 5)` over ALL infinite input streams `tr`:
vx-thm-fir2-cold-reset-3-5 : (tr : List Word) →
  vx-run (mk-vxsys (#0 , #0) (vx-fir2-spec-step (λ u → %wmul #3 u) (λ u → %wmul #5 u)) #4) tr ≡
  vx-run (mk-vxsys (#0 , #0) (vx-fir2-impl-step (λ u → %wmul #3 u) (λ u → %wmul #5 u)) #2) tr
vx-thm-fir2-cold-reset-3-5 tr =
  vx-thm-fir2-retiming-sound (λ u → %wmul #3 u) (λ u → %wmul #5 u) #0 #0 tr

-- ============================================================================
-- SECTION 4: CONSTRUCTIVE FINITE-STATE MEALY COALGEBRA EQUIVALENCE DECIDER
--   Zero halting problem: product space |S1|*|S2| is finite; BFS decides EITHER
--   exact closed bisimulation relation (`vx-proved`) OR shortest CEX (`vx-refuted`)!
-- ============================================================================

data VxMealyVerdict : Type where
  vx-proved  : (rel : List (Word × Word)) → VxMealyVerdict
  vx-refuted : (cex : List Word)          → VxMealyVerdict

vx-verdict-is-proved : VxMealyVerdict → Bool
vx-verdict-is-proved (vx-proved r)  = true
vx-verdict-is-proved (vx-refuted c) = false

vx-verdict-cex : VxMealyVerdict → List Word
vx-verdict-cex (vx-proved r)  = nil
vx-verdict-cex (vx-refuted c) = c

vx-pair-mem : Word → Word → List (Word × Word) → Bool
vx-pair-mem a b nil = false
vx-pair-mem a b (cons p ps) =
  if web-andB (%weq a (fst p)) (%weq b (snd p)) then true else vx-pair-mem a b ps

vx-snoc : List Word → Word → List Word
vx-snoc nil x = cons x nil
vx-snoc (cons y ys) x = cons y (vx-snoc ys x)

vx-q-app : List ((Word × Word) × List Word) → List ((Word × Word) × List Word) → List ((Word × Word) × List Word)
vx-q-app nil ys = ys
vx-q-app (cons x xs) ys = cons x (vx-q-app xs ys)

-- Expand all inputs `0 .. nI-1` from product state `(q1, q2)` reached by `tr`:
vx-expand-inputs :
  (Word → Word → Word × Word) →
  (Word → Word → Word × Word) →
  Word → Word → List Word → Nat → Word →
  List (Word × Word) → List ((Word × Word) × List Word) →
  Sum (List Word) (List (Word × Word) × List ((Word × Word) × List Word))
vx-expand-inputs stp1 stp2 q1 q2 tr zero x vis q = inr (vis , q)
vx-expand-inputs stp1 stp2 q1 q2 tr (suc rem) x vis q =
  let r1 = stp1 q1 x
      r2 = stp2 q2 x
      tr1 = vx-snoc tr x
  in if web-notB (%weq (fst r1) (fst r2)) then inl tr1
     else
       let n1 = snd r1
           n2 = snd r2
       in if vx-pair-mem n1 n2 vis
          then vx-expand-inputs stp1 stp2 q1 q2 tr rem (%wadd x #1) vis q
          else vx-expand-inputs stp1 stp2 q1 q2 tr rem (%wadd x #1)
                 (cons (n1 , n2) vis)
                 (vx-q-app q (cons ((n1 , n2) , tr1) nil))

vx-bfs-mealy :
  (Word → Word → Word × Word) →
  (Word → Word → Word × Word) →
  Nat → Nat →
  List (Word × Word) → List ((Word × Word) × List Word) →
  VxMealyVerdict
vx-bfs-mealy stp1 stp2 nI zero vis q = vx-proved vis
vx-bfs-mealy stp1 stp2 nI (suc fuel) vis nil = vx-proved vis
vx-bfs-mealy stp1 stp2 nI (suc fuel) vis (cons item rest) =
  let q1 = fst (fst item)
      q2 = snd (fst item)
      tr = snd item
  in case vx-expand-inputs stp1 stp2 q1 q2 tr nI #0 vis rest of
       inl cex  → vx-refuted cex
       inr next → vx-bfs-mealy stp1 stp2 nI fuel (fst next) (snd next)

vx-decide-mealy :
  Word → Word → Word →
  Word → (Word → Word → Word × Word) →
  Word → (Word → Word → Word × Word) →
  VxMealyVerdict
vx-decide-mealy nS1 nS2 nI s10 stp1 s20 stp2 =
  vx-bfs-mealy stp1 stp2 (toNat nI) (toNat (%wmul nS1 nS2))
    (cons (s10 , s20) nil)
    (cons ((s10 , s20) , nil) nil)

-- Independent cold relational closure checker (`vx-rel-closed`) on any discovered `rel`:
vx-pair-ok-inputs :
  (Word → Word → Word × Word) →
  (Word → Word → Word × Word) →
  List (Word × Word) → Word → Word → Nat → Word → Bool
vx-pair-ok-inputs stp1 stp2 rel q1 q2 zero x = true
vx-pair-ok-inputs stp1 stp2 rel q1 q2 (suc rem) x =
  let r1 = stp1 q1 x
      r2 = stp2 q2 x
  in web-andB (%weq (fst r1) (fst r2))
       (web-andB (vx-pair-mem (snd r1) (snd r2) rel)
                 (vx-pair-ok-inputs stp1 stp2 rel q1 q2 rem (%wadd x #1)))

vx-rel-all-ok :
  (Word → Word → Word × Word) →
  (Word → Word → Word × Word) →
  Nat → List (Word × Word) → List (Word × Word) → Bool
vx-rel-all-ok stp1 stp2 nI fullRel nil = true
vx-rel-all-ok stp1 stp2 nI fullRel (cons p ps) =
  web-andB (vx-pair-ok-inputs stp1 stp2 fullRel (fst p) (snd p) nI #0)
           (vx-rel-all-ok stp1 stp2 nI fullRel ps)

vx-rel-closed :
  Word → Word → Word →
  (Word → Word → Word × Word) →
  (Word → Word → Word × Word) →
  VxMealyVerdict → Bool
vx-rel-closed s10 s20 nI stp1 stp2 (vx-refuted c) = false
vx-rel-closed s10 s20 nI stp1 stp2 (vx-proved rel) =
  web-andB (vx-pair-mem s10 s20 rel)
           (vx-rel-all-ok stp1 stp2 (toNat nI) rel rel)

-- Concrete Verification 4A: 4-State Redundant Protocol Spec vs 2-State Superoptimized Quotient Impl
vx-proto4-spec : Word → Word → Word × Word
vx-proto4-spec s x = (%wxor (%wand s #1) (%wand x #1) , %wand (%wadd s (%wadd (%wand x #1) #2)) #3)

vx-proto2-impl : Word → Word → Word × Word
vx-proto2-impl s x = (%wxor (%wand s #1) (%wand x #1) , %wxor (%wand s #1) (%wand x #1))

vx-proto-verdict : VxMealyVerdict
vx-proto-verdict = vx-decide-mealy #4 #2 #2 #0 vx-proto4-spec #0 vx-proto2-impl

vx-thm-mealy-equiv-proved : vx-rel-closed #0 #0 #2 vx-proto4-spec vx-proto2-impl vx-proto-verdict ≡ true
vx-thm-mealy-equiv-proved = refl

-- Concrete Verification 4B: Deep 3-Step Saturating Counter Spec vs Buggy Wrap-Around Impl -> Exact Minimal CEX!
vx-sat4-spec : Word → Word → Word × Word
vx-sat4-spec s x =
  if %weq x #0 then (#0 , #0)
  else if %wlt s #2 then (#0 , %wadd s #1)
  else (#1 , #2)

vx-buggy-wrap-impl : Word → Word → Word × Word
vx-buggy-wrap-impl s x =
  if %weq x #0 then (#0 , #0)
  else if %wlt s #2 then (#0 , %wadd s #1)
  else (#0 , #0)

vx-bug-verdict : VxMealyVerdict
vx-bug-verdict = vx-decide-mealy #3 #3 #2 #0 vx-sat4-spec #0 vx-buggy-wrap-impl

vx-list-eq-w : List Word → List Word → Bool
vx-list-eq-w nil nil = true
vx-list-eq-w (cons a as) (cons b bs) = web-andB (%weq a b) (vx-list-eq-w as bs)
vx-list-eq-w _ _ = false

-- Kernel-checked refl proof: `vx-decide-mealy` automatically finds the exact minimal 3-step CEX `[#1, #1, #1]`!
vx-thm-mealy-bug-cex : vx-list-eq-w (vx-verdict-cex vx-bug-verdict) (cons #1 (cons #1 (cons #1 nil))) ≡ true
vx-thm-mealy-bug-cex = refl

vx-thm-cex-diverges :
  vx-list-eq-w
    (vx-exec vx-sat4-spec #0 (vx-verdict-cex vx-bug-verdict))
    (vx-exec vx-buggy-wrap-impl #0 (vx-verdict-cex vx-bug-verdict)) ≡ false
vx-thm-cex-diverges = refl

