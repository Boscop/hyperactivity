-- multiplying equal integers gives equal integers
zmul-zeq-r : (a v w : Nat × Nat) → zeq v w → zeq (zmul a v) (zmul a w)
zmul-zeq-r a v w e = transN (regroup2 (fst a) (snd a) (fst v) (snd v) (snd w) (fst w))
  (transN (cong2plus (times (fst a) (plus (fst v) (snd w))) (times (fst a) (plus (fst w) (snd v))) (times (snd a) (plus (snd v) (fst w))) (times (snd a) (plus (snd w) (fst v)))
            (congN (times (fst a)) e)
            (congN (times (snd a)) (transN (plus-comm (snd v) (fst w)) (transN (symN e) (plus-comm (fst v) (snd w))))))
    (symN (regroup2 (fst a) (snd a) (fst w) (snd w) (snd v) (fst v))))
