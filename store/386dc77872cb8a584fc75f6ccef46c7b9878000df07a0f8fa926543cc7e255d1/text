mterm-subst-shift-app : (pre suf t : MTerm) → mterm-subst-app pre suf (mterm-shift-app t) ≡ t
mterm-subst-shift-app pre suf t =
  case t return (λ u → mterm-subst-app pre suf (mterm-shift-app u) ≡ u) of
    mempty → λ i → mempty
    mlit a → λ i → mlit a
    mref k → λ i → mref k
    mapp tid arg → λ i → mapp tid (rec arg i)
    mcat l r → λ i → mcat (rec l i) (rec r i)
