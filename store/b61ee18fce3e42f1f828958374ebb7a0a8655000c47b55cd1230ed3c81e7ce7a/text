-- one entry of the image: row t against the vector v over the monomials ms
pair-dot : List Nat → Nat → Nat → List Nat → Mons → List SQ → SQ
pair-dot ds i k t ms v = case ms of
  nil → sq-zero
  cons s rest → sq-plus (sq-mul (pair-entry ds i k t s) (poly-head v)) (pair-dot ds i k t rest (poly-tail v))
