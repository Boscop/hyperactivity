h-pull : List Word → List Word → List Word → Proc W Unit
h-pull st m srv = bind (h-read (list-append st "/source-seq")) (λ s →
  bind (h-get srv (list-append "/source/changes?since=" (h-pointer-or s))) (λ r →
  if weq (h-status r) #200
  then bind (h-take-changes srv m (h-lines (h-body r))) (λ u →
    bind (h-write (list-append st "/source-seq") (h-last-seq (h-pointer-or s) (h-lines (h-body r)))) (λ w → ret unit))
  else h-say (h-line (list-append "the served source cannot be reached: " srv))))
