cite-check-all : Proc W Unit
cite-check-all =
  bind (h-read "README.md") (λ md →
  bind (cite-missing (h-dedupe (list-append cite-audited (cite-filter-thms (cite-ticks (cite-or-empty md)))))) (λ miss →
    if h-null (h-concat miss) then bind (h-out (h-line "cite-check: all README & audited theorem citations resolved in store")) (λ _ → exit #0)
    else bind (h-say (h-concat (list-map h-line (cons "cite-check: unresolved theorem citations:" miss)))) (λ _ → exit #1)))
