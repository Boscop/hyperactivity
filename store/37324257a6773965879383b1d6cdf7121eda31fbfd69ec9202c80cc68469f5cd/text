ctx-extract-classes : List Word → List ((Word × Word) × List Word) → List (List Word)
ctx-extract-classes used nil = nil
ctx-extract-classes used (cons e rest) =
  let fresh = ctx-filter-fresh used (snd e)
  in case fresh of
       nil → ctx-extract-classes used rest
       cons a r0 →
         (case r0 of
            nil → ctx-extract-classes used rest
            cons b r → cons fresh (ctx-extract-classes (list-append fresh used) rest))
