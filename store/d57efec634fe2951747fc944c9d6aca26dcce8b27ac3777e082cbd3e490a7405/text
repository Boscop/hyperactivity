-- ============================================================================
-- 6. FUNCTOR 4: MECHANICAL APPLE A18 PRO METAL GPU 32-WAY BIT-SLICED INET COMPILER
-- Compiles EVERY `prog : Word` witness gate-by-gate into 32-way parallel SIMD NAND2 Metal code!
-- Each GPU thread evaluates 32 cubical interaction-net active pairs simultaneously in 1 cycle!
-- ============================================================================
im-gates : Nat → Word → Word → List Word → List Word
im-gates zero _ _ tl = tl
im-gates (suc k) nw prog tl =
  let g = %wand prog #63
      i = %wshr g #3
      j = %wand g #7
  in io-cat (cons "  uint32_t w" (cons (ce-dec nw) (cons " = ~(w" (cons (ce-dec i)
            (cons " & w" (cons (ce-dec j) (cons ");" (cons ce-nl
            (cons (im-gates k (%wsucc nw) (%wshr prog #6) tl) nil)))))))))
