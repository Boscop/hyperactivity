sfin-eq : (n : Nat) → SumFin n → SumFin n → Bool
sfin-eq n =
  case n return (λ k → SumFin k → SumFin k → Bool) of
    zero → λ e _ → Empty-rec e
    suc m → λ x y →
      case x of
        inl _ → (case y of inl _ → true; inr _ → false)
        inr x' → (case y of inl _ → false; inr y' → rec m x' y')
