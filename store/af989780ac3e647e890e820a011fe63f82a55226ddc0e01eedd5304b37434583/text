-- the normal form of a body in a context: its variables replaced by their forms, the machine's
-- normal form, a pass of transport and composition steps, and all three again until nothing
-- changes (a step can leave a variable where its structure is needed again); each normal form
-- computed once
nk-norm-in-it : Nat → NkTm → Word → NkTm → NkTm
nk-norm-in-it zero ctx n t = nk-nf (toNat #30000) (nk-sub-forms ctx n t)
nk-norm-in-it (suc k) ctx n t =
  let nf = nk-nf (toNat #30000) (nk-sub-forms ctx n t)
      kn = nk-kan nf
  in if nk-tm-eq kn nf then nf else nk-norm-in-it k ctx n kn
