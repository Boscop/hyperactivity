s-public-answer : List Word → List Word → List Word → Proc W (List Word)
s-public-answer st m path =
  if orB (h-eq (h-before "?" path) "/") (h-null path) then s-kept-public st "front" else
  if h-eq (h-before "?" path) "/llms.txt" then s-kept-public st "llms-txt" else
  if h-eq (h-before "?" path) "/feed.xml" then s-kept-public st "feed-xml" else
  if h-eq (h-before "?" path) "/paper" then s-paper st m else
  if h-eq (h-before "?" path) "/paper.pdf" then s-kept-public st "paper-pdf" else
  if h-eq (h-before "?" path) "/pdf" then s-kept-public st "pdf-view" else
  if h-eq (h-before "?" path) "/kg" then s-kept-public st "kg" else
  if h-eq (h-before "?" path) "/api/kg/index" then s-kept-public st "kg-index" else
  if h-prefix "/api/kg/module" path then s-kg-module (s-query path) else
  if h-eq (h-before "?" path) "/nets" then s-kept-public st "nets" else
  if h-eq (h-before "?" path) "/neuro" then s-kept-public st "neuro" else
  if h-eq (h-before "?" path) "/physics" then s-kept-public st "physics" else
  if h-eq (h-before "?" path) "/ai" then s-kept-public st "ai" else
  if h-eq (h-before "?" path) "/music" then s-kept-public st "music" else
  if andB (h-prefix "/corpus/" path) (orB (h-eq (h-before "?" path) "/corpus/paper") (s-known (s-at-name (h-drop "/corpus" (h-before "?" path)) s-published))) then s-kept-public st (list-append "corpus-" (h-drop "/corpus/" (h-before "?" path))) else
  if s-known (s-at-name (h-drop "/" (h-before "?" path)) s-published) then s-kept-public st (h-drop "/" (h-before "?" path)) else
  s-answer st m path
