nk-fire-self-agree : (ev : NkEvJ → NkEv) (rho : NkW → NkEv) (t : NkTm) (h : Word) (cs : NkTm) (aux parts : NkEnv) (hd : NkHd) (n : NkW) →
  (nk-ebound aux n ≡ true) →
  let v = nkev hd (nk-env-ev rho parts)
      rho2 = nk-rho-set rho n v
  in ev (nkevj-tm t (nk-env-ev rho2 (nke-cons n aux)))
     ≡ nk-ev-fire ev (act-self t) h cs (nk-env-ev rho aux) v
nk-fire-self-agree ev rho t h cs aux parts hd n hb =
  let v = nkev hd (nk-env-ev rho parts)
      rho2 = nk-rho-set rho n v
  in cong (λ z → ev (nkevj-tm t z))
       (cong (λ z → nkev-cons z (nk-env-ev rho2 aux)) (nk-rho-set-same rho n v)
        ∙ cong (λ z → nkev-cons v z) (nk-env-ev-set-lt rho n v aux hb))
