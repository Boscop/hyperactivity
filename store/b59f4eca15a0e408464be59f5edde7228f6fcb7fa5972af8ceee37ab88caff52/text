-- ⟨A|H|B⟩ and ⟨A|B⟩
fk-el : (Nat → BQ) → (Nat → Nat → BQ) → (Nat → Nat → Nat → Nat → BQ) → List Nat → List Nat → BQ
fk-el d h v a b = fk-sgn (not (bit-eq (fk-par a (fk-minus a b) false false) (fk-par b (fk-minus b a) false false))) (bq-mul (fk-prod d (fk-inter a b)) (fk-core d h v (fk-minus a b) (fk-minus b a) (fk-inter a b)))
