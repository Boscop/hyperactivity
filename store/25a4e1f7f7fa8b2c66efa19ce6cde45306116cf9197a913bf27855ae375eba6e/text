-- the page: the reader's path and who else is here, the scene, what readers wrote here, and the gesture
hi-page : List Word → List Word → Bool → List (List Word) → List (List Word) → List Word → List Word → List Word
hi-page rd f far path os ab sc = h-concat (cons "<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>" (cons (s-esc f) (cons "</title>" (cons hi-style (cons "</head><body><main><div class='bar'>" (cons (s-esc rd) (cons ": " (cons (h-concat (list-map (λ p → list-append (hi-a rd p p) " → ") (hi-recent path))) (cons (if h-null (h-concat os) then nil else list-append " · also here: " (s-esc (h-concat (list-map (λ o → list-append o " ") os)))) (cons " · <a href='" (cons (s-esc (list-append (hi-href rd f) (if far then nil else "&radius=2"))) (cons (if far then "'>radius 1</a>" else "'>radius 2</a>") (cons "</div><form method='get' action='/hi'><input type='hidden' name='reader' value='" (cons (s-esc rd) (cons "'><input name='focus' placeholder='any name, node or document path' size='34'> <button>go</button></form>" (cons sc (cons (hi-sect "written here" (if h-null ab then nil else list-append "<ul>" (list-append ab "</ul>"))) (cons "<form method='post' action='/hi/write'><input type='hidden' name='reader' value='" (cons (s-esc rd) (cons "'><input type='hidden' name='focus' value='" (cons (s-esc f) (cons "'><select name='kind'>" (cons hi-options (cons "</select><textarea name='text' rows='3' placeholder='a question, an asserted equivalence, a warrant or a witness, at this focus'></textarea><button>write</button></form></main></body></html>" nil))))))))))))))))))))))))
