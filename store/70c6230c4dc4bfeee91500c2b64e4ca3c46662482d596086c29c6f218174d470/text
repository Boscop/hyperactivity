omni-emit-mc-cuda : List MetaCircuit → List Word → List Word
omni-emit-mc-cuda nil tail = tail
omni-emit-mc-cuda (cons (mcirc nm _ _ gs) cs) tail =
  hw-ln (list-append "__device__ __forceinline__ uint32_t mc_"
        (list-append nm "(uint32_t w0, uint32_t w1, uint32_t w2, uint32_t w3) {"))
        (omni-cuda-gates #4 gs (omni-emit-mc-cuda cs tail))
