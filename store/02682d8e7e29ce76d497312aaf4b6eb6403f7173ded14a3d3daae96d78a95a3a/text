deploy : {M St : Type} → Corpus M St → Config → Fleet M St
deploy {M} {St} cp cfg =
  Fleet { fl-size = dp-len {NodeCfg} (cf-nodes (fst cfg))
        ; fl-beh = λ i s → dp-role-view {M} {St} cp (dp-nth {NodeCfg} i (cf-nodes (fst cfg))) s
        ; fl-init = ((λ i → dp-role-init {M} {St} cp (dp-nth {NodeCfg} i (cf-nodes (fst cfg)))) , net-empty {M})
        ; fl-config = fst cfg
        ; fl-node = λ i → to-step {W} {Sum Errno Word} (linux-run {Sum Errno Word} (cf-platform (fst cfg)) (snd cfg) (dp-node {lsuc lzero} {M} {St} cp (fst cfg) i)) }
