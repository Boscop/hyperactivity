-- the fleet value: its size, the behaviour and initial state the properties are stated of, the
-- configuration it was placed by, and each node's process over W
record Fleet (M : Type) (St : Type) = { fl-size : Nat ; fl-beh : NodeId → St → NView M St ; fl-init : FState M St ; fl-config : ConfigData ; fl-node : NodeId → Step W (Sum Errno Word) }
