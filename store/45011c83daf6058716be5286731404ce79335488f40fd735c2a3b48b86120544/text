renamed-waw-commute : (e1 e2 : Nat) → nat-eq e1 e2 ≡ false →
  (rd : Word) → (v1 v2 : Nat) → (prf : PRF) → (q : PhysTag) →
  prf-write (e1 , rd) v1 (prf-write (e2 , rd) v2 prf) q ≡
  prf-write (e2 , rd) v2 (prf-write (e1 , rd) v1 prf) q
renamed-waw-commute e1 e2 hNeq rd v1 v2 prf q =
  waw-branch rd v1 v2 prf q
    (ptag-eq q (e1 , rd))
    (ptag-eq q (e2 , rd))
    (andB-false-absorb
      (nat-eq (fst q) e1) (weq (snd q) rd)
      (nat-eq (fst q) e2) (weq (snd q) rd)
      (nat-eq-trans-false (fst q) e1 e2 hNeq))
