q-basis3 : Word → QState3
q-basis3 m =
  qs3 (if %weq m #0 then z8-one else z8-zero)
      (if %weq m #1 then z8-one else z8-zero)
      (if %weq m #2 then z8-one else z8-zero)
      (if %weq m #3 then z8-one else z8-zero)
      (if %weq m #4 then z8-one else z8-zero)
      (if %weq m #5 then z8-one else z8-zero)
      (if %weq m #6 then z8-one else z8-zero)
      (if %weq m #7 then z8-one else z8-zero)
