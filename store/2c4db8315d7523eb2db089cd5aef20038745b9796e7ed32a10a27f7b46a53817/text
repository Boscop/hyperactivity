g-entries : Word → Word → Word → Word → Nat → Proc W (Sum (List Word) (List (List Word × (List Word × (Word × Word)))))
g-entries base len version off zero = ret (inr nil)
g-entries base len version off (suc k) =
  bind (h-peek (wadd base (wadd off #60)) (suc (suc zero))) (λ fl →
  bind (h-peek (wadd base (wadd (wadd off #62) (g-ext version (h-be fl)))) (toNat #14)) (λ pre →
  -- an object of the source (a piece, a module's list) is admitted and holds no prose of its own:
  -- passed over by its first bytes; an entry of the view (store/entries/) is read, for the module it binds
  if andB (h-prefix "store/" pre) (h-not (h-prefix "store/entries/" pre))
  then g-entries base len version (wadd off (g-size (g-ext version (h-be fl)) (wand (h-be fl) #4095))) k
  else g-entry-of base len off (g-ext version (h-be fl)) (wand (h-be fl) #4095)
    (g-entries base len version (wadd off (g-size (g-ext version (h-be fl)) (wand (h-be fl) #4095))) k)))
