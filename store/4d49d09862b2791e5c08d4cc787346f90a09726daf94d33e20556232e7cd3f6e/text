-- Eternal Optimality Theorem for 64-Input Circuits:
-- NO fan-in-2 circuit in the universe depending on ≥ 64 input leaves can EVER achieve depth ≤ 5!
-- (Proves depth = 6 in `adder64-sound`, `wallace64-sound`, `mxfp64-mac-sound`, `opt-adder64` is optimal!)
no-64input-depth5-circuit : {O0 O1 O2 V : Type} → (c : Circ O0 O1 O2 V) →
  leB (toNat #64) (circ-leaves {O0} {O1} {O2} {V} c) ≡ true →
  leB (circ-depth {O0} {O1} {O2} {V} c) (toNat #5) ≡ true →
  Empty
no-64input-depth5-circuit {O0} {O1} {O2} {V} c h64 h5 =
  let hPow : leB (pow2 (circ-depth {O0} {O1} {O2} {V} c)) (pow2 (toNat #5)) ≡ true
      hPow = pow2-mono (circ-depth {O0} {O1} {O2} {V} c) (toNat #5) h5
      hImp : leB (toNat #64) (pow2 (toNat #5)) ≡ true
      hImp = leB-trans (toNat #64) (circ-leaves {O0} {O1} {O2} {V} c) (pow2 (toNat #5))
               h64
               (leB-trans (circ-leaves {O0} {O1} {O2} {V} c)
                 (pow2 (circ-depth {O0} {O1} {O2} {V} c))
                 (pow2 (toNat #5))
                 (fanin2-lightcone-leB {O0} {O1} {O2} {V} c)
                 hPow)
  in false≢true hImp
