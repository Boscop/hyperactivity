-- Tail-recursive Haar lift & unlift (O(N), zero stack overflow on 96,000+ samples!)
haar-lift-tr : List Word → List Word → List Word → (List Word × List Word)
haar-lift-tr nil sa da = (w-rev sa nil , w-rev da nil)
haar-lift-tr (cons x nil) sa da = (w-rev (cons (w32 x) sa) nil , w-rev da nil)
haar-lift-tr (cons a (cons b r)) sa da =
  let p = haar-lift-pair (a , b)
  in haar-lift-tr r (cons (fst p) sa) (cons (snd p) da)
