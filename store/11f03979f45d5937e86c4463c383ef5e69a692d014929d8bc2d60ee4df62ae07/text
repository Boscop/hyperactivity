-- the part of c²·d on the side where d has nothing is zero
zr-sq0 : (P N D1 D2 : Nat) → times P N ≡ zero → D1 ≡ zero → plus (times (plus (times P P) (times N N)) D1) (times (plus (times P N) (times N P)) D2) ≡ zero
zr-sq0 P N D1 D2 pn d = cl-tr Nat (xeval (zr-e P N D1 D2 zero zero) zr-sq-l) (xeval (zr-e P N D1 D2 zero zero) zr-sq-m) zero
  (ring-eq (zr-e P N D1 D2 zero zero) zr-sq-l zr-sq-m (λ i → norm zr-sq-l))
  (cl-tr Nat (xeval (zr-e P N D1 D2 zero zero) zr-sq-m) (plus (times (plus (times P P) (times N N)) zero) zero) zero
    (λ i → plus (times (plus (times P P) (times N N)) (d i)) (times (pn i) (plus D2 D2)))
    (λ i → plus (times-zero (plus (times P P) (times N N)) i) zero))
