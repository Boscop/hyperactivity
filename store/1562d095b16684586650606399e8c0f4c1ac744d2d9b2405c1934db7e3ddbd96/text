-- the spanning trees of a network of n vertices, by deletion and contraction: a tree either omits the
-- first line or contains it, and the trees containing it are the trees of the network with the line's two
-- ends identified; a line from a vertex to itself is in no tree. trees-step takes one step, given the count
-- t for the remaining lines; the fuel f of trees-by is the number of lines, which each step lowers by one.
trees-step : (Nat → List FaradayLine → Nat) → Nat → List FaradayLine → Nat
trees-step t n ls = case ls of
  nil → (if eqb n (suc zero) then suc zero else zero)
  cons l rest → (if eqb (fst l) (snd l) then t n rest
    else plus (t n rest) (t (monus n (suc zero)) (identify-ends (fst l) (snd l) rest)))
