-- ---------------------------------------------------------------- 1. Verified Peephole Logic Optimizer
circ-gates : {O0 O1 O2 V : Type} → Circ O0 O1 O2 V → Nat
circ-gates (cwire v) = zero
circ-gates (cop0 c) = zero
circ-gates (cop1 u a) = suc (circ-gates a)
circ-gates (cop2 b x y) = suc (plus (circ-gates x) (circ-gates y))
