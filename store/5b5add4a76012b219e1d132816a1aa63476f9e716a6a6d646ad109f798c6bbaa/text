bb2-leb-trans : (a b c : Nat) → leb a b ≡ true → leb b c ≡ true → leb a c ≡ true
bb2-leb-trans zero b c p q = λ i → true
bb2-leb-trans (suc a) zero c p q = Empty-rec (bb2-false-ne-true p)
bb2-leb-trans (suc a) (suc b) zero p q = Empty-rec (bb2-false-ne-true q)
bb2-leb-trans (suc a) (suc b) (suc c) p q = bb2-leb-trans a b c p q
