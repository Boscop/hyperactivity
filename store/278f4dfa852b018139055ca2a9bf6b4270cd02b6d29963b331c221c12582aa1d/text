world-id : (Γ : CCtx) → World Γ Γ
world-id Γ =
  (λ k → k , mono-id , (λ k i → isdim (fst Γ) k) , snd (sub-id Γ) ,
   λ v → (v , (λ i → var-word (fst Γ) v) ,
          λ i → (var-shape (fst Γ) v ,
                 psym (Mean Γ (TV (var-shape (fst Γ) v)))
                   (subM Γ Γ (TV (var-shape (fst Γ) v)) (sub-id Γ) (varCube Γ v)) (varCube Γ v)
                   (pcat (Mean Γ (TV (var-shape (fst Γ) v)))
                      (subM Γ Γ (TV (var-shape (fst Γ) v)) (sub-id Γ) (varCube Γ v))
                      (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (SubF (fst Γ) (fst Γ)) (FbE (fst Γ) (TV (var-shape (fst Γ) v)))
                         (λ γ' p ρ' → varM (fst Γ) v (fst p) (snd p ρ')) (snd Γ) (fst (snd (sub-id Γ))))
                      (varCube Γ v)
                      (subM-of Γ Γ (TV (var-shape (fst Γ) v)) (sub-id Γ) (varM (fst Γ) v))
                      (fmap-of (dims (fst Γ)) (CtxV (fst Γ)) (SubF (fst Γ) (fst Γ)) (FbE (fst Γ) (TV (var-shape (fst Γ) v)))
                         (λ γ → (γ , λ ρ → ρ)) (λ γ' p ρ' → varM (fst Γ) v (fst p) (snd p ρ')) (snd Γ)))
                   i)))
