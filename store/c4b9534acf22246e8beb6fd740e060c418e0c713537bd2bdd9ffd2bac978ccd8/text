-- Symmetry of hardware interaction rules: rule(a, b) = rule(b, a) for all node kinds
inet-rule-sym : (a b : INetKind) → Path Word (inet-rule-delta2 a b) (inet-rule-delta2 b a)
inet-rule-sym ik-free ik-free = refl
inet-rule-sym ik-free ik-con  = refl
inet-rule-sym ik-free ik-dup  = refl
inet-rule-sym ik-free ik-era  = refl
inet-rule-sym ik-con  ik-free = refl
inet-rule-sym ik-con  ik-con  = refl
inet-rule-sym ik-con  ik-dup  = refl
inet-rule-sym ik-con  ik-era  = refl
inet-rule-sym ik-dup  ik-free = refl
inet-rule-sym ik-dup  ik-con  = refl
inet-rule-sym ik-dup  ik-dup  = refl
inet-rule-sym ik-dup  ik-era  = refl
inet-rule-sym ik-era  ik-free = refl
inet-rule-sym ik-era  ik-con  = refl
inet-rule-sym ik-era  ik-dup  = refl
inet-rule-sym ik-era  ik-era  = refl
