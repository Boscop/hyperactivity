-- Forward: a framing-invariant choice function descends cleanly through the content projection `snd`.
framing-invariant-factors : {C Choice : Type} → (eval : (Bool × C) → Choice) →
  FramingInvariant eval →
  (g : C → Choice) × ((s : Bool × C) → eval s ≡ g (snd s))
framing-invariant-factors eval inv =
  ((λ c → eval (true , c)) ,
   λ s → case fst s return (λ b → eval (b , snd s) ≡ eval (true , snd s)) of
     true → λ i → eval (true , snd s)
     false → sym (inv (snd s)))
