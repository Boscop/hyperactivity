-- how many positions of the reversed text are in state e: the occurrences of the end of length e (e is
-- the most any position matches, so no state passes it and state e is exactly an occurrence; e ≥ 1)
m-count-go : (n : Nat) → Bytes n → (k : Nat) → Bytes k → Word → Word → Word → Word → List Word → Word
m-count-go n p k f m e j a nil = if weq j e then wadd a #1 else a
m-count-go n p k f m e j a (cons c r) = m-count-go n p k f m e (m-next n p k f m j c) (if weq j e then wadd a #1 else a) r
