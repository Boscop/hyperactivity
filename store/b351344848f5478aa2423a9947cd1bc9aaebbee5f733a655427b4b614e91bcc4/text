-- (a1 p + a2 q) + (a1 r + a2 s) = a1 (p + r) + a2 (q + s)
regroup2 : (a1 a2 p q r s : Nat) → plus (plus (times a1 p) (times a2 q)) (plus (times a1 r) (times a2 s)) ≡ plus (times a1 (plus p r)) (times a2 (plus q s))
regroup2 a1 a2 p q r s = transN (plus-mid4 (times a1 p) (times a2 q) (times a1 r) (times a2 s))
  (cong2plus (plus (times a1 p) (times a1 r)) (times a1 (plus p r)) (plus (times a2 q) (times a2 s)) (times a2 (plus q s)) (symN (times-ldistr a1 p r)) (symN (times-ldistr a2 q s)))
