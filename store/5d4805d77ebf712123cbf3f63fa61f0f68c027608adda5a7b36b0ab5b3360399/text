-- Amy/Nam `tof_3` benchmark (2 Toffoli gates on shared controls + uncompute: 14 T -> 12 T via T-merge/cancel!)
-- Amy/Nam `tof_pair_shared` (2 back-to-back Toffolis sharing control qubits (0,1) -> targets 2,3):
--   T(0) + T(0) = S(0) and Tdg(1) + T(1) = I(1) cancel 4 T-gates (14 -> 10 T-gates, 28.6% T-count cut!)
amy-tof-pair : List QGate
amy-tof-pair = list-append (q-toffoli #0 #1 #2) (q-toffoli #0 #1 #3)
