tso-chain-preds : {A : Type} → (rel : A → A → Bool) → (cs : List A) → (zs : List A) → (x y : A) → TsoIn x cs →
                  ((c : A) → TsoIn c zs → TsoIn c cs) → TsoChain rel x zs y →
                  ((c : A) → TsoIn c zs → TsoHasPred rel cs c) × TsoHasPred rel cs y
tso-chain-preds rel cs nil x y inx sub ch = ((λ c m → Empty-rec m) , (x , (inx , ch)))
tso-chain-preds rel cs (cons z r) x y inx sub ch =
  ((λ c m → case m of
              inl e → subst {_} {_} {_} {TsoHasPred rel cs} (sym e) (x , (inx , fst ch))
              inr m2 → fst (tso-chain-preds rel cs r z y (sub z (inl (λ i → z))) (λ c2 m3 → sub c2 (inr m3)) (snd ch)) c m2) ,
   snd (tso-chain-preds rel cs r z y (sub z (inl (λ i → z))) (λ c2 m3 → sub c2 (inr m3)) (snd ch)))
