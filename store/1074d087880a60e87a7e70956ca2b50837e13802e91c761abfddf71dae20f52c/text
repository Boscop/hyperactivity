  (Z : Type 1) (k : (x : X) → F x → Z) (kT : (x : X) → Y x → Z)
  (q : PathP (λ i → (x : X) (y : Y x) → F' (f x y) → Z) (λ x y e → kT x y) (λ x y e → k x (g x y e)))
  (H : Z → Type 1) (lT : (x : X) (y : Y x) → H (kT x y)) (l : (x : X) (y : Y x) (v : F' (f x y)) → H (k x (g x y v)))
  (ql : PathP (λ i → (x : X) (y : Y x) (v : F' (f x y)) → H (q i x y v)) (λ x y v → lT x y) l)
  (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' F' (dcube-map n X Y X' f c d)) →
  PathP (λ i → DCube n Z H (map-pull-i n X X' Y F F' f g Z k kT q c d e i)) (dcube-lift n X Z Y H kT lT c d) (dcube-liftp n X X' Y F F' f g Z k H l c d e)
lift-pull-i zero X X' Y F F' f g Z k kT q H lT l ql c d e = λ i → ql i c d e
lift-pull-i (suc n) X X' Y F F' f g Z k kT q H lT l ql c d e =
