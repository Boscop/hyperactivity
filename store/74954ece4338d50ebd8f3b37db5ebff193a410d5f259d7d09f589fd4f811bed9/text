wt-thm-delta-sec : (p : Bool) → (ds : List Bool) → wt-delta-enc p (wt-delta-dec p ds) ≡ ds
wt-thm-delta-sec _ nil = refl
wt-thm-delta-sec true  (cons true  r) = λ i → cons true  (wt-thm-delta-sec false r i)
wt-thm-delta-sec true  (cons false r) = λ i → cons false (wt-thm-delta-sec true  r i)
wt-thm-delta-sec false (cons true  r) = λ i → cons true  (wt-thm-delta-sec true  r i)
wt-thm-delta-sec false (cons false r) = λ i → cons false (wt-thm-delta-sec false r i)
