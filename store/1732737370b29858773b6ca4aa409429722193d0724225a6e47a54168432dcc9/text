-- the remainder stays below the divisor after a subtraction
rem-bound : (x : Bool) → (k1 R R1 D T : Nat) → plus k1 (suc R) ≡ D → plus R1 D ≡ T → T ≡ plus (bitn x) (times 2 R) → le (suc R1) D
rem-bound x k1 R R1 D T h1 h2 h3 = (plus (times 2 k1) (bitn (not x)) ,
  plus-cancel-l D (plus (plus (times 2 k1) (bitn (not x))) (suc R1)) D (rem-alg x k1 R R1 D T h1 h2 h3))
