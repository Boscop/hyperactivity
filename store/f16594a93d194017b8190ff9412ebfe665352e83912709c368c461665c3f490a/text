-- Balanced log-depth MXFP dot-product with factored block scale equals sequential elementwise scaled MAC!
mxfp64-mac-sound : (s : Nat) → (prods : Nat → Nat) →
  times s (atree-eval plus (tree-bal-from (toNat #6) zero prods)) ≡
  atree-eval plus (atree-map (times s) (tree-chain-from (toNat #63) zero prods))
mxfp64-mac-sound s prods =
  transN (congN (times s) (wallace64-sound prods))
    (sym (mxfp-scale-factor s (tree-chain-from (toNat #63) zero prods)))
