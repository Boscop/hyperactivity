nk-out-ok-self : (ins outs : NkEnv) (n0 nst : NkW) (o : NkOut) →
  (nk-out-ok ins outs n0 nst o ≡ true) → nk-out-ok ins outs n0 (nk-n o) o ≡ true
nk-out-ok-self ins outs n0 nst (nk-out fx n ws) h =
  nk-out-ok-intro ins outs n0 n fx n ws
    (nk-wire-le-refl n)
    (nk-out-ok-fx ins outs n0 nst (nk-out fx n ws) h)
    (nk-out-ok-ws ins outs n0 nst (nk-out fx n ws) h)
