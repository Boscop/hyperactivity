-- {A B C; ½ C−½ B±½} from doubled x = 2A, y = 2B, z = 2C (A B C a triangle), up for B + ½ (Edmonds, Table 5):
--   {A B C; ½ C−½ B+½} = (−1)^s √[(s−2B)(s−2C+1) / ((2B+1)(2B+2)2C(2C+1))]
--   {A B C; ½ C−½ B−½} = (−1)^s √[(s+1)(s−2A) / (2B(2B+1)2C(2C+1))],   s = A+B+C;
-- doubled, s − 2B = (x+z−y)/2, s − 2C + 1 = (x+y−z+2)/2, s + 1 = (x+y+z+2)/2, s − 2A = (y+z−x)/2
bsixj-c : List Bool → List Bool → List Bool → Bool → Amp
bsixj-c x y z up = if bin-null z then amp-zero else (if up
  then (not (bin-bit1 (bin-add x (bin-add y z))) , (bin-mul (bin-sub (bin-add x z) y) (bin-add (bin-sub (bin-add x y) z) bin-two) ,
    bin-mul (bin-pow2 2) (bin-mul (bin-mul (bin-add y bin-one) (bin-add y bin-two)) (bin-mul z (bin-add z bin-one)))))
  else (if bin-null y then amp-zero else (not (bin-bit1 (bin-add x (bin-add y z))) , (bin-mul (bin-add (bin-add x (bin-add y z)) bin-two) (bin-sub (bin-add y z) x) ,
    bin-mul (bin-pow2 2) (bin-mul (bin-mul y (bin-add y bin-one)) (bin-mul z (bin-add z bin-one)))))))
