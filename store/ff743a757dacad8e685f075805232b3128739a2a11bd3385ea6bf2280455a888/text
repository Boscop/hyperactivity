-- a path over a line of types from transport: toPathP
toPathP : {l : Level} {A0 A1 : Type l} {A : A0 ≡ A1} {x : A0} {y : A1} →
                                                              transport A x ≡ y → PathP A x y
toPathP p =
  λ i →
    comp (λ j → A i) (λ j → [ i = 0 ↦ x , i = 1 ↦ p j ])
      (comp (λ j → A (i /\ j)) (λ j → [ i = 0 ↦ x ]) x)
