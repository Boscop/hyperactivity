-- level j (from 0) of the pencil ((hn, dh), (sn, ds)) lies in [lo/sc, hi/sc]: S has no negative direction, N(lo, sc)
-- has j, N(hi, sc) has j + 1. Two certificates for the bracket and one for S, the ends found by any untrusted search
wt-bracket : (List (List BZ) × BZ) × (List (List BZ) × BZ) → Nat → BZ → BZ → BZ → Bool
wt-bracket pr j lo hi sc = if wt-is 0 (fst (snd pr)) then (if wt-is j (hc-n pr lo sc) then wt-is (suc j) (hc-n pr hi sc) else false) else false
