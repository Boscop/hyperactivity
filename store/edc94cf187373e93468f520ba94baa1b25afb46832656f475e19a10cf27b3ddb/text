-- long division returns canonical numbers
div-canon-v : (rest d q r : List Bool) → ((q2 r2 : List Bool) → bcanon q2 ≡ true → bcanon r2 ≡ true → bcanon (fst (bin-div-loop rest d q2 r2)) ≡ true × bcanon (snd (bin-div-loop rest d q2 r2)) ≡ true) → (x : Bool) → bcanon q ≡ true → bcanon r ≡ true → (v : Bool) → bcanon (fst (if v then bin-div-loop rest d (bin-cons true q) (bin-sub (bin-cons x r) d) else bin-div-loop rest d (bin-cons false q) (bin-cons x r))) ≡ true × bcanon (snd (if v then bin-div-loop rest d (bin-cons true q) (bin-sub (bin-cons x r) d) else bin-div-loop rest d (bin-cons false q) (bin-cons x r))) ≡ true
div-canon-v rest d q r ih x cq cr v = case v return λ u → bcanon (fst (if u then bin-div-loop rest d (bin-cons true q) (bin-sub (bin-cons x r) d) else bin-div-loop rest d (bin-cons false q) (bin-cons x r))) ≡ true × bcanon (snd (if u then bin-div-loop rest d (bin-cons true q) (bin-sub (bin-cons x r) d) else bin-div-loop rest d (bin-cons false q) (bin-cons x r))) ≡ true of
  true → ih (bin-cons true q) (bin-sub (bin-cons x r) d) (bin-cons-canon true q cq) (subb-canon (bin-cons x r) false d)
  false → ih (bin-cons false q) (bin-cons x r) (bin-cons-canon false q cq) (bin-cons-canon x r cr)
