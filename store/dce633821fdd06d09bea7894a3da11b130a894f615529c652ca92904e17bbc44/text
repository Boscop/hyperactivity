-- spawn at most one detached background refresh so PUT /roots/<R> returns immediately while keeping RAM bounded
s-spawn-refresh : List Word → List Word → Proc W Unit
s-spawn-refresh st m =
  bind (sys-call #57 #0 #0 #0 #0 #0 #0) (λ pid →
  if weq pid #0
  then bind (h-run (cons "/usr/bin/env" (cons "flock" (cons "-n" (cons (list-append st "/refresh.lock") (cons m (cons "lib/server.cub" (cons "refresh" nil)))))))) (λ rc →
    bind (sys-call #231 #0 #0 #0 #0 #0 #0) (λ x → ret {lzero} {W} unit))
  else ret {lzero} {W} unit)
