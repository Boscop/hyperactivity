wl-step-conserves : (r : WLRxn) → (fl : WLFlask) → wl-total-enz (wl-step r fl) ≡ wl-total-enz fl
wl-step-conserves wl-r-bind   (wl-fl zero    es eu) = refl
wl-step-conserves wl-r-bind   (wl-fl (suc e) es eu) = hm-add-suc-r e (hm-add es eu)
wl-step-conserves wl-r-unbind (wl-fl e zero    eu) = refl
wl-step-conserves wl-r-unbind (wl-fl e (suc es) eu) = wl-sym-n (hm-add-suc-r e (hm-add es eu))
wl-step-conserves wl-r-cat    (wl-fl e zero    eu) = refl
wl-step-conserves wl-r-cat    (wl-fl e (suc es) eu) = wl-sym-n (hm-add-suc-r e (hm-add es eu))
wl-step-conserves wl-r-unfold (wl-fl zero    es eu) = refl
wl-step-conserves wl-r-unfold (wl-fl (suc e) es eu) =
  wl-trans-n (λ i → hm-add e (hm-add-suc-r es eu i)) (hm-add-suc-r e (hm-add es eu))
wl-step-conserves wl-r-refold (wl-fl e es zero)     = refl
wl-step-conserves wl-r-refold (wl-fl e es (suc eu)) =
  wl-sym-n (wl-trans-n (λ i → hm-add e (hm-add-suc-r es eu i)) (hm-add-suc-r e (hm-add es eu)))
