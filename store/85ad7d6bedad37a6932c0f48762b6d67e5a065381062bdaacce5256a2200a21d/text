-- Every shared k-wire netlist agrees between 2-state Bool and 4-state Verilog on defined inputs
net-val4-sound : {Out : Type} → (k n : Nat) → (env : SumFin n → Bool) → (net : Net B0 B1 B2 Out n k) → (o : Out) →
  lift4 (net-eval k n bool-alg env net o) ≡ net-eval k n val4-alg (λ v → lift4 (env v)) net o
net-val4-sound k n env net o = net-hom k n bool-alg val4-alg lift4 val4-alg-hom env net o
