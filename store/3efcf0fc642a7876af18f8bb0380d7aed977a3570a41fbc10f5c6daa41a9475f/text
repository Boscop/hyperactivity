-- Complementary PMOS Strip Theorem: dual pull-up diffusion strip conducts iff NMOS strip is cut off!
lvs-cmos-dual-sound : {V : Type} → (env : V → Bool) → (gs : List V) → (g0 : V) →
  pmos-on env (cmos-dual (extract-strip-pdn g0 gs)) ≡ not (strip-conducts env g0 gs)
lvs-cmos-dual-sound {V} env gs g0 =
  catB
    (pmos-on env (cmos-dual (extract-strip-pdn g0 gs)))
    (not (nmos-on env (extract-strip-pdn g0 gs)))
    (not (strip-conducts env g0 gs))
    (cmos-complementary env (extract-strip-pdn g0 gs))
    (λ i → not (lvs-euler-sound {V} env gs g0 i))
