sv-hypernet16-vs-rv32-tb : List Word
sv-hypernet16-vs-rv32-tb =
  sv-lines
    (cons "`timescale 1ns/1ps"
    (cons "module hypernet16_vs_rv32_tb;"
    (cons "  logic clk = 0, rst = 1, start = 0;"
    (cons "  logic [1:0] prog_sel = 0;"
    (cons "  always #5 clk = ~clk;"
    (cons "  logic        hn_q, rv_halt;"
    (cons "  logic [31:0] hn_ans, rv_ans;"
    (cons "  logic [15:0] hn_steps, hn_stolen, hn_pruned, hn_allocs, hn_gated, rv_cyc, rv_inst;"
    (cons "  logic [7:0]  hn_fcells, hn_fvars;"
    (cons "  logic [4:0]  hn_peak;"
    (cons "  hypernet16_mesh_4x4 u_hn16 ("
    (cons "    .clk(clk), .rst(rst), .start(start), .prog_sel(prog_sel),"
    (cons "    .quiescent(hn_q), .root_result(hn_ans),"
    (cons "    .total_steps(hn_steps), .stolen_count(hn_stolen), .pruned_count(hn_pruned),"
    (cons "    .alloc_count(hn_allocs), .gated_tile_cycles(hn_gated),"
    (cons "    .total_free_cells(hn_fcells), .total_free_vars(hn_fvars), .active_tiles_peak(hn_peak)"
    (cons "  );"
    (cons "  riscv32_pipe16 u_rv32 ("
    (cons "    .clk(clk), .rst(rst), .start(start), .prog_sel(prog_sel),"
    (cons "    .halted(rv_halt), .result_out(rv_ans), .cycle_count(rv_cyc), .inst_retired(rv_inst)"
    (cons "  );"
    (cons "  integer p, hn_cyc;"
    (cons "  logic [31:0] exp_ans [0:3];"
    (cons "  initial begin"
    (cons "    exp_ans[0] = 32'd10;"
    (cons "    exp_ans[1] = 32'd12;"
    (cons "    exp_ans[2] = 32'd136;"
    (cons "    exp_ans[3] = 32'd10;"
    (cons "    @(posedge clk); @(posedge clk); rst = 0;"
    (cons "    for (p = 0; p < 4; p = p + 1) begin"
    (cons "      prog_sel = p[1:0]; start = 1;"
    (cons "      @(posedge clk); start = 0;"
    (cons "      hn_cyc = 0;"
    (cons "      while ((!hn_q || !rv_halt) && hn_cyc < 5000) begin"
    (cons "        @(posedge clk);"
    (cons "        if (!hn_q) hn_cyc = hn_cyc + 1;"
    (cons "      end"
    (cons (list-append "      $display(" (cons #34 (list-append "BENCH_%0d: ans=%0d (rv=%0d) | HyperNet16_4x4(cycles=%0d, steps=%0d, stolen=%0d, peak_tiles=%0d/16, pruned=%0d, allocs=%0d, cells=%0d/128, vars=%0d/128, gated_cyc=%0d) | RISCV32(cycles=%0d, inst=%0d)" (cons #34 ","))))
    (cons "               p, hn_ans, rv_ans, hn_cyc, hn_steps, hn_stolen, hn_peak, hn_pruned, hn_allocs, hn_fcells, hn_fvars, hn_gated, rv_cyc, rv_inst);"
    (cons "      if (!hn_q || !rv_halt || hn_ans !== exp_ans[p] || rv_ans !== exp_ans[p] || hn_fcells !== 8'd128 || hn_fvars !== 8'd128) begin"
    (cons (list-append "        $display(" (cons #34 (list-append "FAIL on BENCH_%0d!" (cons #34 ", p);"))))
    (cons "        $fatal(1);"
    (cons "      end"
    (cons "    end"
    (cons (list-append "    $display(" (cons #34 (list-append "ALL_4_HYPERNET16_BENCHMARKS_PASSED" (cons #34 ");"))))
    (cons "    $finish;"
    (cons "  end"
    (cons "endmodule" nil))))))))))))))))))))))))))))))))))))))))))))))))
