zadd-tf : (m1 m2 : List Bool) → (v : Bool) → cmpN true (bin-to-nat m2) (bin-to-nat m1) ≡ v → zeq (zv (if v then (if bin-zero (bin-sub m1 m2) then bz-zero else (true , bin-sub m1 m2)) else (false , bin-sub m2 m1))) (plus (bin-to-nat m1) zero , bin-to-nat m2)
zadd-tf m1 m2 v = case v return λ u → cmpN true (bin-to-nat m2) (bin-to-nat m1) ≡ u → zeq (zv (if u then (if bin-zero (bin-sub m1 m2) then bz-zero else (true , bin-sub m1 m2)) else (false , bin-sub m2 m1))) (plus (bin-to-nat m1) zero , bin-to-nat m2) of
  true → λ e → zsub-pos (bin-sub m1 m2) (plus (bin-to-nat m1) zero) (bin-to-nat m2)
    (transN (bin-sub-sound m1 m2 (cmp-true-le (bin-to-nat m2) (bin-to-nat m1) e)) (symN (plus-zero (bin-to-nat m1))))
  false → λ e → zsub-neg (bin-sub m2 m1) (plus (bin-to-nat m1) zero) (bin-to-nat m2)
    (transN (congN (plus (bin-to-nat (bin-sub m2 m1))) (plus-zero (bin-to-nat m1)))
      (bin-sub-sound m2 m1 (le-of-lt (bin-to-nat m1) (bin-to-nat m2) (cmp-false-lt (bin-to-nat m2) (bin-to-nat m1) e))))
