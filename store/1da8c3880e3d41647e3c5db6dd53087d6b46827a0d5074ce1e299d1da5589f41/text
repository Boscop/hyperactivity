-- Autonomous sequence-only fold selector: compares ALL hairpin turn positions vs. Pro-aware α-helix.
-- Returns (is-hairpin : Bool, (best-turn : Nat, (best-score : Nat, gap : Nat))).
sf-fold-auto : List AA → Bool × (Nat × (Nat × Nat))
sf-fold-auto seq =
  let n = sf-len seq
      bh = sf-best-hairpin-le (monus n 4) seq
      hs = fold-score-contacts seq (sf-gen-helix seq)
  in if leb hs (snd bh)
     then (true , (fst bh , (snd bh , monus (snd bh) hs)))
     else (false , (zero , (hs , monus hs (snd bh))))
