sv-rv32-bench-part2 : List Word
sv-rv32-bench-part2 =
  sv-lines
    (cons "  wire [3:0]  op  = ex_inst[31:28], rd = ex_inst[27:24], rs1 = ex_inst[23:20], rs2 = ex_inst[19:16];"
    (cons "  wire [31:0] imm = {{16{ex_inst[15]}}, ex_inst[15:0]};"
    (cons "  wire [31:0] v1  = (rs1 == 4'd0) ? 32'd0 : rf[rs1];"
    (cons "  wire [31:0] v2  = (rs2 == 4'd0) ? 32'd0 : rf[rs2];"
    (cons "  logic [31:0] alu_y;"
    (cons "  always_comb begin"
    (cons "    case (op)"
    (cons "      4'd1: alu_y = v1 + imm;"
    (cons "      4'd2: alu_y = v1 + v2;"
    (cons "      4'd3: alu_y = v1 * v2;"
    (cons "      4'd4: alu_y = v1 | v2;"
    (cons "      default: alu_y = v1 & v2;"
    (cons "    endcase"
    (cons "  end"
    (cons "  wire take_br = ex_valid && (op == 4'd6) && (v1 != 32'd0);"
    (cons "  integer k;"
    (cons "  always_ff @(posedge clk) begin"
    (cons "    if (rst) begin"
    (cons "      pc <= 8'd0; ex_valid <= 1'b0; ex_inst <= 32'd0; running <= 1'b0; halted <= 1'b0;"
    (cons "      result_out <= 32'd0; cycle_count <= 16'd0; inst_retired <= 16'd0;"
    (cons "      for (k = 0; k < 16; k = k + 1) rf[k] <= 32'd0;"
    (cons "    end else if (start) begin"
    (cons "      pc <= (prog_sel == 2'd0) ? 8'd0 : (prog_sel == 2'd1) ? 8'd16 : 8'd32;"
    (cons "      ex_valid <= 1'b0; ex_inst <= 32'd0; running <= 1'b1; halted <= 1'b0;"
    (cons "      result_out <= 32'd0; cycle_count <= 16'd0; inst_retired <= 16'd0;"
    (cons "      for (k = 0; k < 16; k = k + 1) rf[k] <= 32'd0;"
    (cons "    end else if (running && !halted) begin"
    (cons "      cycle_count <= cycle_count + 16'd1;"
    (cons "      if (ex_valid) begin"
    (cons "        inst_retired <= inst_retired + 16'd1;"
    (cons "        if (op >= 4'd1 && op <= 4'd5 && rd != 4'd0) rf[rd] <= alu_y;"
    (cons "        if (op == 4'd7) begin halted <= 1'b1; running <= 1'b0; result_out <= v1; end"
    (cons "      end"
    (cons "      if (take_br) begin"
    (cons "        pc <= ex_inst[7:0]; ex_valid <= 1'b0; ex_inst <= 32'd0;"
    (cons "      end else begin"
    (cons "        ex_valid <= 1'b1; ex_inst <= fetch_inst; pc <= pc + 8'd1;"
    (cons "      end"
    (cons "    end"
    (cons "  end"
    (cons "endmodule"
    (cons "" nil))))))))))))))))))))))))))))))))))))))))))
