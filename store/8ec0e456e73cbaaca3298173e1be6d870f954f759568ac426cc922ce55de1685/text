-- transport of λx. inc x along the constant line of N → N computes, by the function clause and
-- then the number clause, to λx. inc x (part of machine-in-hyperactive)
nk-kan-fun : nk-norm (nk-transp (nk-lam (nk-pi nk-N (nk-lam nk-N))) nk-i0 (nk-lam (nk-inc (nk-var #0)))) ≡ nk-lam (nk-inc (nk-var #0))
nk-kan-fun = refl
