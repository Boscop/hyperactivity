enc-dec-s3 : (b : Bytes4) → le-s3 (decodeLE b) ≡ (b fin4-1 , b fin4-0)
enc-dec-s3 b = concat {lzero} {BitVec 8 × BitVec 8} {le-s3 (decodeLE b)} {bv-split 8 8 (bv-cat 8 8 (b fin4-1) (b fin4-0))} {(b fin4-1 , b fin4-0)}
  (λ k → bv-split 8 8 (snd (enc-dec-s2 b k))) (bv-split-cat 8 8 (b fin4-1) (b fin4-0))
