-- Polymorphic hardware model of Hyperactivity's NkSlot / NkCh / nk-ch (lib/kernel.cub:106)
data WSlot (Val : Type) (Op : Type) =
    ws-none
  | ws-val (v : Val)
  | ws-op (o : Op)
  | ws-pair (o : Op) (v : Val)
