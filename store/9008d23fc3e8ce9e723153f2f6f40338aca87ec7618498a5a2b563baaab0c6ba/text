-- the forms of the English entries numbered nums (the etymology program's index of English, made
-- once by lib/etym.cub): each entry's own key and the keys of every word form Wiktionary gives for it
c-forms-of : List (List Word) → Proc W (List (List Word))
c-forms-of nil = ret nil
c-forms-of (cons n r) =
  bind (c-out (cons "grep" (cons "-a" (cons "-m" (cons "200" (cons "-e" (cons (list-append c-tab (list-append "#" (list-append n "$"))) (cons "build/etym/en.syn.index" nil)))))))) (λ s →
  bind (c-out (cons "sed" (cons "-n" (cons (list-append (h-decimal (wadd (c-num16 #0 n) #1)) (list-append "p;" (list-append (h-decimal (wadd (c-num16 #0 n) #1)) "q"))) (cons "build/etym/en.index" nil))))) (λ h →
  bind (c-forms-of r) (λ rest → ret (cons (c-field zero (c-strip-nl h)) (list-append (list-map (λ l → c-field zero l) (h-lines s)) rest)))))
