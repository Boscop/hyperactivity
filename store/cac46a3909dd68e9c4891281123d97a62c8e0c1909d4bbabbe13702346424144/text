-- P (with holes) against X: the holes P is made of at X's corresponding parts
vmatch hs P X sg =
  case hole-of hs P of
    some k → if solved sg k then sg else lcons (k , svv X) sg
    -- equal already (no hole in P where X differs): nothing to find, and no walk of a large value
    none → if uconv P X then sg else vmatch-w hs (%view P) X sg
