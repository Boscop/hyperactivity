ln-outer : (f : List BQ → List BQ → BQ) → (l : List BQ → List BQ) → (ws xs : List (List BQ)) →
  ln-map (List BQ) (List BQ) (λ x → ln-map (List BQ) BQ (λ y → f (l x) (l y)) ws) xs ≡
  ln-map (List BQ) (List BQ) (λ x → ln-map (List BQ) BQ (λ y → f x y) (ln-map (List BQ) (List BQ) l ws)) (ln-map (List BQ) (List BQ) l xs)
ln-outer f l ws xs = case xs return λ zs → ln-map (List BQ) (List BQ) (λ x → ln-map (List BQ) BQ (λ y → f (l x) (l y)) ws) zs ≡
    ln-map (List BQ) (List BQ) (λ x → ln-map (List BQ) BQ (λ y → f x y) (ln-map (List BQ) (List BQ) l ws)) (ln-map (List BQ) (List BQ) l zs) of
  nil → λ i → nil
  cons x rest → λ i → cons (ln-inner f l x ws i) (ln-outer f l ws rest i)
