rans-pack-ok : (xs : List Word) → rans-unpack (rans-pack xs) ≡ xs
rans-pack-ok xs =
  let p = rans-encode xs
      n = fst (snd p)
      s = snd (snd p)
  in concat {lzero} {List Word}
       {rans-decode (fst p , (n , bytes-to-word-with (word-to-bytes-go (plus n n) s)))}
       {rans-decode p} {xs}
       (λ i → rans-decode (fst p , (n , word-bytes-ok (plus n n) s i)))
       (rans-roundtrip xs)
