-- the document of a decomposition: the file itself, or a decomposed one's source, written out by the machine
hy-source-probe : List Word → List Word
hy-source-probe f = list-append (h-line (list-append "import " (hy-q (list-append "../" f))))
  (list-append (h-line (list-append "import " (hy-q "../lib/host.hypercubical")))
  (list-append (h-line "hy-source-out : Step W Unit")
  (list-append (h-line (list-append "hy-source-out = to-step (bind (h-write " (list-append (hy-q "build/decompose-source") (list-append " " (list-append (hy-base f) "-source) (λ b → exit #0))")))))
  (h-line "#run hy-source-out"))))
