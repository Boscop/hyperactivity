-- the readers' last focuses, the reader's own left out
hi-lasts : List Word → List Word → List (List Word) → Proc W (List (List Word))
hi-lasts st rd nil = ret nil
hi-lasts st rd (cons e r) = bind (h-read (list-append st (list-append "/hi/" e))) (λ w → bind (hi-lasts st rd r) (λ rest →
  ret (if andB (h-prefix "walk-" e) (h-not (h-eq (h-unhex (h-drop "walk-" e)) rd)) then cons (hi-last (h-lines (s-or nil w))) rest else rest)))
