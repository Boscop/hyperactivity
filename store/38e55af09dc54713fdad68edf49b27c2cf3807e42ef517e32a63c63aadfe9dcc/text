-- c − r from c and r
f-inp-at : (S S2 : List Bool) → (C R1 : IV) → (cq rv : ZQ) → inp S C cq → inp S R1 rv →
  inp S (iv-sub C R1) (zplus (zsc (fst cq) (snd rv)) (zsc (zsw (fst rv)) (snd cq)) , times (snd cq) (snd rv))
f-inp-at S S2 C R1 cq rv hc hr = (iv-add-canon C (iv-neg R1) (fst hc) (iv-neg-canon R1 (fst hr)) ,
  (iv-sub-sound S C R1 (fst cq) (fst rv) (snd cq) (snd rv) (fst hc) (fst hr) (fst (snd hc)) (fst (snd hr)) ,
   le1-times (snd cq) (snd rv) (snd (snd hc)) (snd (snd hr))))
