ltn-asym : (m n : Nat) → ltn m n ≡ true → ltn n m ≡ false
ltn-asym m =
  case m return λ y → (n : Nat) → ltn y n ≡ true → ltn n y ≡ false of
    zero →
      λ n →
        case n return λ z → ltn zero z ≡ true → ltn z zero ≡ false of
          zero → λ e → Empty-rec (true≢false (sym e))
          suc k → λ e i → false
    suc m1 →
      λ n →
        case n return λ z → ltn (suc m1) z ≡ true → ltn z (suc m1) ≡ false of
          zero → λ e → Empty-rec (true≢false (sym e))
          suc n1 → λ e → rec m1 n1 e
