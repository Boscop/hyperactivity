-- ---------------------------------------------------------------- 3. embedding static GProc into RProc
-- defined explicitly via fix so pfix gives the exact one-step unfolding path under a tick
g2r-step : {S : Sig} {A : Type}
         → ▸ κ (GProc κ S A → RProc κ (const-ds S) A unit)
         → GProc κ S A → RProc κ (const-ds S) A unit
g2r-step rec (gret a) = rret unit a
g2r-step rec (gcmd c k) = rcmd unit c (λ r → λ α → rec α (k r α))
g2r-step rec (gtau t) = rtau unit (λ α → rec α (t α))
