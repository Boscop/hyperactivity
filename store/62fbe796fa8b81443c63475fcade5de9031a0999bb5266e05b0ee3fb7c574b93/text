-- (part of language-support)
write_msr : (idx : ZI) → (value : Bits #64) → MS Unit
write_msr idx value =
  bindS {List (Bits #64)} {Unit} (getS {List (Bits #64)} x86-msrs) (λ msrs'1 →
    bindS {Unit} {Unit} (putS (x86-set-msrs (vec-set {Bits #64} msrs'1 (z-nat idx) value))) (λ _ →
      retS {Unit} unit))
