-- (part of language-support)
x86_decode_sib_p : (modr_m' : modr_m) → (n16_bit_addressp : Bool) → Bool
x86_decode_sib_p modr_m' n16_bit_addressp =
  let r_m : Bits #3
      r_m = (modr_m-r_m modr_m')
      mod_var : Bits #2
      mod_var = (modr_m-mod modr_m')
  in (b-and (b-not n16_bit_addressp) (b-and (weq r_m #4) (b-not (weq mod_var #3))))
