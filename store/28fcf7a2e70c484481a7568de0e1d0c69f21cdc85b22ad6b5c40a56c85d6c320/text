emit-c-proc-unit-program : Word → Defs → List Word
emit-c-proc-unit-program m defs =
  let ars = x-arities defs
  in list-append ce-world-inc
       (list-append ce-prelude
         (list-append ce-prelude2
           (list-append ce-world-helpers
             (list-append ce-world-run
               (ce-protos defs
                 (ce-wraps defs
                   (ce-wfns ars defs
                     (ce-proc-unit-main m))))))))
