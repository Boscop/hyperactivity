-- (D_{k−1}, P_{k−1}, P_k) ↦ (D_k, P_k, D_k λ P_k − N_k D_{k−1} P_{k−1}), one step at A = 2a
zchar-step : List Bool → List Bool → List Bool × (List BZ × List BZ) → List Bool × (List BZ × List BZ)
zchar-step n d st = (d , (snd (snd st) , zpoly-add (cons bz-zero (zpoly-scale (bz-of d) (snd (snd st)))) (zpoly-scale (bz-neg (bz-of (bin-mul n (fst st)))) (fst (snd st)))))
