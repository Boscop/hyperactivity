tw-lem-opB-go : (t : Word) → (x y : Bool) → (b0 b1 b2 b3 : Bool) →
  %weq t #0 ≡ b0 → %weq t #1 ≡ b1 → %weq t #2 ≡ b2 → %weq t #3 ≡ b3 →
  (if b0 then web-xorB x y else if b1 then web-andB x y else if b3 then web-notB x else
    (if b0 then web-xorB x y else if b1 then web-andB x y else if b2 then web-notB (web-andB x y) else if b3 then web-notB x else web-xorB x y))
  ≡ (if b0 then web-xorB x y else if b1 then web-andB x y else if b2 then web-notB (web-andB x y) else if b3 then web-notB x else web-xorB x y)
tw-lem-opB-go _ _ _ true  _     _     _     _ _ _  _  = refl
tw-lem-opB-go _ _ _ false true  _     _     _ _ _  _  = refl
tw-lem-opB-go _ _ _ false false true  false _ _ _  _  = refl
tw-lem-opB-go t _ _ false false true  true  _ _ h2 h3 = Empty-rec (true≢false (λ i → %weq (tw-trans-w (kir-weq-eq t #2 h2) (kir-weq-eq t #3 h3) i) #2))
tw-lem-opB-go _ _ _ false false false true  _ _ _  _  = refl
tw-lem-opB-go _ _ _ false false false false _ _ _  _  = refl
