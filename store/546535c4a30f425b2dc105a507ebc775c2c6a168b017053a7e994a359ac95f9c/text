pack-equiv : {A : Type} → (m n : Nat) → Equiv ((SumFin m → A) × (SumFin n → A)) (Sum (SumFin m) (SumFin n) → A)
pack-equiv {A} m n = isoToEquiv {lzero} {(SumFin m → A) × (SumFin n → A)} {Sum (SumFin m) (SumFin n) → A} (pack {A} m n) (unpack {A} m n)
  (λ z → funExt {lzero} {lzero} {Sum (SumFin m) (SumFin n)} {A} {pack {A} m n (unpack {A} m n z)} {z} (pack-unpack-at {A} m n z))
  (λ xy → λ t → xy)
