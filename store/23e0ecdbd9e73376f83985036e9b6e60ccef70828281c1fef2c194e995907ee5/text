-- the decimal digits of a binary natural, most significant first (f bounds the count)
dec-digits : Nat → List Bool → List Nat → List Nat
dec-digits f n acc = case f of
  zero → acc
  suc g → (if bin-null n then acc else dec-digits g (fst (bin-divmod n (bin-of-nat 10))) (cons (bin-to-nat (snd (bin-divmod n (bin-of-nat 10)))) acc))
