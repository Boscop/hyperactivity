nk-def-ok-ks : NkTm → Code → Bool
nk-def-ok-ks ksig (cglob g) =
  if nk-failed ksig then false
  else (let kd = nk-nth (nk-args ksig) #0
            kf = nk-nth (nk-args ksig) #1
            dm = nk-nth (nk-args ksig) #2
            gm = nk-nth (nk-args ksig) #3
        in case nk-find-g-ks gm #0 g return (λ _ → Bool) of
             some gi →
               let ge = nk-nth kf gi
                   body = nk-nth (nk-args ge) #0
                   ty = nk-nth (nk-args ge) #1
               in nk-has-s (nk-con #56 (nk-cons kd (nk-cons (nk-hide-at gi kf) (nk-cons dm (nk-cons gm nk-nil))))) body ty
             none → false)
nk-def-ok-ks ksig c = false
