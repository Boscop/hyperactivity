-- Exact fixed-point cosh(x) for |x| <= 2.5 (scale 10000): 1 + x²/2 + x⁴/24 + x⁶/720 + x⁸/40320
fx-cosh : SInt → SInt
fx-cosh x =
  let x2 = fx-mul x x
      t2 = si-div-w x2 #2
      x4 = fx-mul x2 x2
      t4 = si-div-w x4 #24
      x6 = fx-mul x4 x2
      t6 = si-div-w x6 #720
      x8 = fx-mul x6 x2
      t8 = si-div-w x8 #40320
  in si-add (sp fx-S) (si-add t2 (si-add t4 (si-add t6 t8)))
