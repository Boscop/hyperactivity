nk-trim-susp-denotes-step : (used : Bool) (rho rho2 : NkW → NkEv) (b : NkTm) (j : Word) (w : NkW) (r : NkEnv) (o2 : NkOut) →
  (rho2 w ≡ rho w) →
  (nk-ebound (nk-ws o2) (nk-n o2) ≡ true) →
  (nk-env-ev rho2 (nk-ws o2) ≡ nk-trim-ev b (%wsucc j) (nk-env-ev rho r)) →
  nk-env-ev (nk-rho-trim-step used rho2 o2)
    (nk-ws (if used then nk-out (nk-fx o2) (nk-n o2) (nke-cons w (nk-ws o2))
            else nk-out (nkf-op w nko-era (nkf-val (nk-n o2) (nkv (hd-num #0) nke-nil) (nk-fx o2))) (nk-s (nk-n o2)) (nke-cons (nk-n o2) (nk-ws o2))))
  ≡ nkev-cons (if used then rho w else nkev (hd-num #0) nkev-nil) (nk-trim-ev b (%wsucc j) (nk-env-ev rho r))
nk-trim-susp-denotes-step true rho rho2 b j w r o2 hw hws ih =
  cong (λ z → nkev-cons z (nk-env-ev rho2 (nk-ws o2))) hw
  ∙ cong (λ z → nkev-cons (rho w) z) ih
nk-trim-susp-denotes-step false rho rho2 b j w r o2 hw hws ih =
  let z0 = nkev (hd-num #0) nkev-nil
      rho3 = nk-rho-set rho2 (nk-n o2) z0
  in cong (λ z → nkev-cons z (nk-env-ev rho3 (nk-ws o2))) (nk-rho-set-same rho2 (nk-n o2) z0)
     ∙ cong (λ z → nkev-cons z0 z) (nk-env-ev-set-lt rho2 (nk-n o2) z0 (nk-ws o2) hws ∙ ih)
