-- the positive arrangement is unchanged by a three-cycle: the set of three rotations is closed under
-- rotation, so the test is constant along the path, case by case
sgn-rot : (a : Nb) → (b : Nb) → (c : Nb) → is-pos a b c ≡ is-pos b c a
sgn-rot a b c = case a return (λ w → is-pos w b c ≡ is-pos b c w) of
  nb-h1 → (case b return (λ w → is-pos nb-h1 w c ≡ is-pos w c nb-h1) of
    nb-h1 → (case c return (λ w → is-pos nb-h1 nb-h1 w ≡ is-pos nb-h1 w nb-h1) of
      nb-h1 → (λ i → false)
      nb-h2 → (λ i → false)
      nb-cs → (λ i → false))
    nb-h2 → (case c return (λ w → is-pos nb-h1 nb-h2 w ≡ is-pos nb-h2 w nb-h1) of
      nb-h1 → (λ i → false)
      nb-h2 → (λ i → false)
      nb-cs → (λ i → true))
    nb-cs → (case c return (λ w → is-pos nb-h1 nb-cs w ≡ is-pos nb-cs w nb-h1) of
      nb-h1 → (λ i → false)
      nb-h2 → (λ i → false)
      nb-cs → (λ i → false)))
  nb-h2 → (case b return (λ w → is-pos nb-h2 w c ≡ is-pos w c nb-h2) of
    nb-h1 → (case c return (λ w → is-pos nb-h2 nb-h1 w ≡ is-pos nb-h1 w nb-h2) of
      nb-h1 → (λ i → false)
      nb-h2 → (λ i → false)
      nb-cs → (λ i → false))
    nb-h2 → (case c return (λ w → is-pos nb-h2 nb-h2 w ≡ is-pos nb-h2 w nb-h2) of
      nb-h1 → (λ i → false)
      nb-h2 → (λ i → false)
      nb-cs → (λ i → false))
    nb-cs → (case c return (λ w → is-pos nb-h2 nb-cs w ≡ is-pos nb-cs w nb-h2) of
      nb-h1 → (λ i → true)
      nb-h2 → (λ i → false)
      nb-cs → (λ i → false)))
  nb-cs → (case b return (λ w → is-pos nb-cs w c ≡ is-pos w c nb-cs) of
    nb-h1 → (case c return (λ w → is-pos nb-cs nb-h1 w ≡ is-pos nb-h1 w nb-cs) of
      nb-h1 → (λ i → false)
      nb-h2 → (λ i → true)
      nb-cs → (λ i → false))
    nb-h2 → (case c return (λ w → is-pos nb-cs nb-h2 w ≡ is-pos nb-h2 w nb-cs) of
      nb-h1 → (λ i → false)
      nb-h2 → (λ i → false)
      nb-cs → (λ i → false))
    nb-cs → (case c return (λ w → is-pos nb-cs nb-cs w ≡ is-pos nb-cs w nb-cs) of
      nb-h1 → (λ i → false)
      nb-h2 → (λ i → false)
      nb-cs → (λ i → false)))
