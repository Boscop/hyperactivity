-- addition respects the relation: from a + b' = a' + b and c + d' = c' + d
nat-pair-add-wd : (x x2 y y2 : Nat × Nat) → nat-pair-rel x x2 → nat-pair-rel y y2 → nat-pair-rel (nat-pair-add x y) (nat-pair-add x2 y2)
nat-pair-add-wd x x2 y y2 h1 h2 =
  transN (stree-swap4 (fst x) (fst y) (snd x2) (snd y2))
  (transN (λ k → plus (h1 k) (h2 k))
  (stree-swap4 (fst x2) (snd x) (fst y2) (snd y)))
