-- Wrong-Path Squash Safety Theorem: ANY squashed wrong-path instruction (even a rogue store or branch!)
-- has ZERO architectural effect on PC, registers, or Data RAM!
wrong-path-squash-safe : (hs : HartState) → (wrongPc : Word) → (wrongInst : HartInst) →
  spipe-flush (spipe hs false wrongPc wrongInst) ≡ hs
wrong-path-squash-safe hs wrongPc wrongInst = λ _ → hs
