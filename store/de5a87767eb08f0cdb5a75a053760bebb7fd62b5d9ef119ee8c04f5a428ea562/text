-- ONE UNIVERSAL CATAMORPHISM (FOLD) OVER ALL INTERACTION NETS!
in-fold : {R : Type} → (Word → R) → R → (Word → R → R → R) → (Word → R → R → R) → INet → R
in-fold fw fe fc fd (in-wire k)     = fw k
in-fold fw fe fc fd in-era          = fe
in-fold fw fe fc fd (in-con t a b)  = fc t (in-fold fw fe fc fd a) (in-fold fw fe fc fd b)
in-fold fw fe fc fd (in-dup l a b)  = fd l (in-fold fw fe fc fd a) (in-fold fw fe fc fd b)
