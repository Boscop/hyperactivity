cs-print-apps-eq : (cf : Code → CsExp) (pr : Code → List Word → List Word) →
  ((x : Code) (tl : List Word) → cs-print (cf x) tl ≡ pr x tl) →
  (hd : CsExp) (hd_pr : List Word → List Word) →
  ((tl : List Word) → cs-print hd tl ≡ hd_pr tl) →
  (as : Lst Code) (acc : List Word) →
  cs-print (cs-comp-apps cf hd as) acc ≡ ce-apps pr hd_pr as acc
cs-print-apps-eq cf pr h hd hd_pr hhd lnil acc = hhd acc
cs-print-apps-eq cf pr h hd hd_pr hhd (lcons a r) acc =
  cs-print-apps-eq cf pr h (cse-app hd (cf a))
    (λ tl → list-append "hy_app(" (hd_pr (list-append ", " (pr a (list-append ")" tl)))))
    (λ tl → cong (list-append "hy_app(")
              (hhd (list-append ", " (cs-print (cf a) (list-append ")" tl)))
               ∙ cong (λ z → hd_pr (list-append ", " z)) (h a (list-append ")" tl))))
    r acc
