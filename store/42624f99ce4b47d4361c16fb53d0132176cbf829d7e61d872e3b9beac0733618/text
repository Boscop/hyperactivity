  h-concat
    (cons "{"
    (cons (bn-jkv "source_asset_denom" "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913" ",")
    (cons (bn-jkv "source_asset_chain_id" "8453" ",")
    (cons (bn-jkv "dest_asset_denom" bn-akash-usdc-denom ",")
    (cons (bn-jkv "dest_asset_chain_id" "akashnet-2" ",")
    (cons (bn-jkv "amount_in" (h-decimal amountUsdc6) ",")
