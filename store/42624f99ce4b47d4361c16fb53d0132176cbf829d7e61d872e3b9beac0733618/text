            (h-concat
              (cons "{"
              (cons (bn-jkv "8453" baseEip55 ",")
              (cons (bn-jkv "noble-1" nobleAddr ",")
              (cons (bn-jkv "akashnet-2" akashAddr "}") nil))))) ",")
    (cons (bn-jraw "smart_relay" "true" "}") nil))))))))
