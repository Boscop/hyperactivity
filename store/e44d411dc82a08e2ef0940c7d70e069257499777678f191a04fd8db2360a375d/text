-- how many rows have a bond-graph count above the configured count: the graph can only identify atoms the
-- configuration separates, never the reverse, so this is the direction of the refinement and a row
-- breaking it would break the construction
tally-graph-above : List Compd → Nat
tally-graph-above cs = case cs of
  nil → 0
  cons c r → (case leb (suc (compd-conf-count c)) (compd-graph-count c) of true → suc (tally-graph-above r); false → tally-graph-above r)
