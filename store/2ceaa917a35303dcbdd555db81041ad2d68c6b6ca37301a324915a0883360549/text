s-json-nl-esc : List Word → List Word
s-json-nl-esc nil = nil
s-json-nl-esc (cons x r) =
  if orB (weq x #34) (weq x #92) then cons #92 (cons x (s-json-nl-esc r)) else
  if weq x #10 then cons #92 (cons #110 (s-json-nl-esc r)) else
  if weq x #13 then s-json-nl-esc r else
  if wlt x #32 then cons #32 (s-json-nl-esc r) else
  cons x (s-json-nl-esc r)
