intern-dec-enc-all : (vs ts : List (List Word)) → AllInVocab vs ts →
                     list-map (λ idx → cm-from-some nil (nth-tok idx vs)) (list-map (λ t → cm-from-some #0 (find-tok t vs)) ts) ≡ ts
intern-dec-enc-all vs ts =
  case ts return (λ u → AllInVocab vs u →
                        list-map (λ idx → cm-from-some nil (nth-tok idx vs)) (list-map (λ t → cm-from-some #0 (find-tok t vs)) u) ≡ u) of
    nil → λ _ i → nil
    cons t r → λ h →
      let ht = fst h
          e1 : cm-from-some #0 (find-tok t vs) ≡ fst ht
          e1 = cong {lzero} {lzero} {Opt Word} {Word} (cm-from-some #0) (snd ht)
          e2 : cm-from-some nil (nth-tok (fst ht) vs) ≡ t
          e2 = cong {lzero} {lzero} {Opt (List Word)} {List Word} (cm-from-some nil) (find-tok-ok t vs (fst ht) (snd ht))
      in λ i → cons (concat {lzero} {List Word} {cm-from-some nil (nth-tok (cm-from-some #0 (find-tok t vs)) vs)}
                       {cm-from-some nil (nth-tok (fst ht) vs)} {t}
                       (cong {lzero} {lzero} {Word} {List Word} (λ w → cm-from-some nil (nth-tok w vs)) e1) e2 i)
                    (rec r (snd h) i)
