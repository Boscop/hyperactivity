rlp-bytes : List Word → List Word
rlp-bytes nil = cons #128 nil
rlp-bytes (cons b nil) =
  if %wlt b #128 then cons b nil else cons #129 (cons b nil)
rlp-bytes (cons b1 (cons b2 rs)) =
  let bs  = cons b1 (cons b2 rs)
      len = fromNat (list-length bs)
  in if eth-le len #55
     then cons (%wadd #128 len) bs
     else let lb = eth-word-be-min len
              ll = fromNat (list-length lb)
          in cons (%wadd #183 ll) (list-append lb bs)
