-- Universal single-symbol context-fiber bijection theorem (zero preconditions on st, excl, x, st0!)
cf-sym-ok-cons : (k : Nat) → (excl : List Word) → (st : CtxState) → (e : Word × Word) → (r : FTbl) →
                 (x : Word) → (st0 : Word × List Word) →
                 ((excl' : List Word) → (st' : CtxState) → (x' : Word) → (st0' : Word × List Word) →
                  cf-dec-sym k excl' st' (cf-enc-sym k excl' st' x' st0') ≡ (x' , st0')) →
                 cf-dec-cons k excl st e r (cf-enc-cons k excl st e r x st0) ≡ (x , st0)
cf-sym-ok-cons k excl st e r x st0 ih =
  let ft = fiber-with-esc e r
  in (case ftbl-find #0 (wadd #1 x) ft return
        (λ fo → ftbl-find #0 (wadd #1 x) ft ≡ fo →
                Path (Word × (Word × List Word))
                  (cf-dec-cons k excl st e r
                     (case fo of
                        some _ → (rans-enc-step ft (fst st0) (wadd #1 x) , snd st0)
                        none → let st1 = cf-enc-sym k (ftbl-add-syms (cons e r) excl) st x st0
                               in (rans-enc-step ft (fst st1) #0 , snd st1)))
                  (x , st0)) of
        some cf → λ hfind →
          let hpos : wlt #0 (snd cf) ≡ true
              hpos = fiber-with-esc-pos e r (wadd #1 x) (fst cf) (snd cf) hfind
              hr : rans-dec-step ft (rans-enc-step ft (fst st0) (wadd #1 x)) ≡ (wadd #1 x , fst st0)
              hr = rans-step-ok ft (fst st0) (wadd #1 x) (fst cf) (snd cf) hfind hpos
              eneq : weq (wadd #1 x) #0 ≡ false
              eneq = cm-eq-add1-zero x
          in concat {lzero} {Word × (Word × List Word)}
               {let p = rans-dec-step ft (rans-enc-step ft (fst st0) (wadd #1 x))
                in if weq (fst p) #0 then cf-dec-sym k (ftbl-add-syms (cons e r) excl) st (snd p , snd st0)
                   else (wsub (fst p) #1 , (snd p , snd st0))}
               {if weq (wadd #1 x) #0 then cf-dec-sym k (ftbl-add-syms (cons e r) excl) st st0
                else (wsub (wadd #1 x) #1 , st0)}
               {(x , st0)}
               (λ i → let p = hr i
                      in if weq (fst p) #0 then cf-dec-sym k (ftbl-add-syms (cons e r) excl) st (snd p , snd st0)
                         else (wsub (fst p) #1 , (snd p , snd st0)))
               (concat {lzero} {Word × (Word × List Word)}
                  {if weq (wadd #1 x) #0 then cf-dec-sym k (ftbl-add-syms (cons e r) excl) st st0
                   else (wsub (wadd #1 x) #1 , st0)}
                  {(wsub (wadd #1 x) #1 , st0)} {(x , st0)}
                  (λ i → if eneq i then cf-dec-sym k (ftbl-add-syms (cons e r) excl) st st0
                         else (wsub (wadd #1 x) #1 , st0))
                  (λ i → (cm-wsub-add #1 x i , st0)))
        none → λ _ →
          let st1 = cf-enc-sym k (ftbl-add-syms (cons e r) excl) st x st0
              hesc : ftbl-find #0 #0 ft ≡ some (#0 , fromNat (suc (list-length r)))
              hesc = refl
              hr : rans-dec-step ft (rans-enc-step ft (fst st1) #0) ≡ (#0 , fst st1)
              hr = rans-step-ok ft (fst st1) #0 #0 (fromNat (suc (list-length r))) hesc (cm-lt-zero-suc (list-length r))
          in concat {lzero} {Word × (Word × List Word)}
               {let p = rans-dec-step ft (rans-enc-step ft (fst st1) #0)
                in if weq (fst p) #0 then cf-dec-sym k (ftbl-add-syms (cons e r) excl) st (snd p , snd st1)
                   else (wsub (fst p) #1 , (snd p , snd st1))}
               {cf-dec-sym k (ftbl-add-syms (cons e r) excl) st st1}
               {(x , st0)}
               (λ i → let p = hr i
                      in if weq (fst p) #0 then cf-dec-sym k (ftbl-add-syms (cons e r) excl) st (snd p , snd st1)
                         else (wsub (fst p) #1 , (snd p , snd st1)))
               (ih (ftbl-add-syms (cons e r) excl) st x st0))
     (λ i → ftbl-find #0 (wadd #1 x) ft)
