kir-pref : List (List Word) → List Word
kir-pref nil = "/tmp/hy_out/hx_kir"
kir-pref (cons a _) = a

kir-main : List (List Word) → Step W Word
kir-main args =
  let p  = kir-pref args
      cf = list-append p ".c"
      mf = list-append p ".metal"
      uf = list-append p ".cu"
      sf = list-append p ".sv"
  in scmd w-now (λ t0 →
     scmd (w-file-write-named cf kir-emit-c) (λ bc →
     scmd (w-file-write-named mf kir-emit-metal) (λ bm →
     scmd (w-file-write-named uf kir-emit-cuda) (λ bu →
     scmd (w-file-write-named sf kir-emit-sv) (λ bs →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-KIR ONE-AST-4-TARGETS kopt-sound=1 C11=" (list-append (ce-dec bc)
       (list-append "B Metal=" (list-append (ce-dec bm)
       (list-append "B CUDA=" (list-append (ce-dec bu)
       (list-append "B SV=" (list-append (ce-dec bs)
       (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))))))
       (sdone #0)))))))

kir-c : List Word
kir-c = emit-c-cli-opt (code kir-main)
