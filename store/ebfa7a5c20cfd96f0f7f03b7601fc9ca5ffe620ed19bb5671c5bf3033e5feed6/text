-- Superoptimized XOR/AND smart constructors with self-cancellation (`a ^ a -> 0`, `a & a -> a`)!
kir-xor-c : Bool → WExpr → WExpr → WExpr
kir-xor-c true  _ _ = we-k false
kir-xor-c false a b = ha-mk-xor a b

kir-and-c : Bool → WExpr → WExpr → WExpr
kir-and-c true  a _ = a
kir-and-c false a b = ha-mk-and a b

kir-mk-xor : WExpr → WExpr → WExpr
kir-mk-xor a b = kir-xor-c (kir-eq a b) a b

kir-mk-and : WExpr → WExpr → WExpr
kir-mk-and a b = kir-and-c (kir-eq a b) a b

kir-lem-xor-c : (env : Word → Bool) → (a b : WExpr) → (eq : Bool) → (kir-eq a b ≡ eq) →
  web-xorB (weval env a) (weval env b) ≡ weval env (kir-xor-c eq a b)
kir-lem-xor-c env a b true  h =
  web-trans-b (λ k → web-xorB (weval env a) (kir-eq-sound env a b h (~ k))) (web-lem-xor-self (weval env a))
kir-lem-xor-c env a b false _ = ha-lem-mk-xor env a b

kir-lem-and-c : (env : Word → Bool) → (a b : WExpr) → (eq : Bool) → (kir-eq a b ≡ eq) →
  web-andB (weval env a) (weval env b) ≡ weval env (kir-and-c eq a b)
kir-lem-and-c env a b true  h =
  web-trans-b (λ k → web-andB (weval env a) (kir-eq-sound env a b h (~ k))) (web-lem-and-self (weval env a))
kir-lem-and-c env a b false _ = ha-lem-mk-and env a b

-- THE SUPEROPTIMIZER `kir-opt`: runs MC=1 Ch/Maj + ANF + constant-fold + self-XOR/AND cancellation!
kir-opt : WExpr → WExpr
kir-opt (we-k b)       = we-k b
kir-opt (we-v i)       = we-v i
kir-opt (we-not a)     = kir-mk-xor (kir-opt a) (we-k true)
kir-opt (we-xor a b)   = kir-mk-xor (kir-opt a) (kir-opt b)
kir-opt (we-and a b)   = kir-mk-and (kir-opt a) (kir-opt b)
kir-opt (we-or  a b)   = let a' = kir-opt a in let b' = kir-opt b in we-xor (we-xor a' b') (we-and a' b')
kir-opt (we-ch  e f g) = let e' = kir-opt e in let f' = kir-opt f in let g' = kir-opt g in we-xor g' (we-and e' (we-xor f' g'))
kir-opt (we-maj a b c) = let a' = kir-opt a in let b' = kir-opt b in let c' = kir-opt c in we-xor a' (we-and (we-xor a' b') (we-xor a' c'))

-- UNIVERSAL SUPEROPTIMIZER SOUNDNESS OVER ALL WExpr & ALL ENVIRONMENTS!
kir-opt-sound : (e : WExpr) → WEdge e (kir-opt e)
kir-opt-sound (we-k _) env = refl
kir-opt-sound (we-v _) env = refl
kir-opt-sound (we-not a) env =
  web-trans-b
    (web-trans-b (λ k → web-notB (kir-opt-sound a env k)) (web-lem-not-xor (weval env (kir-opt a))))
    (kir-lem-xor-c env (kir-opt a) (we-k true) (kir-eq (kir-opt a) (we-k true)) refl)
kir-opt-sound (we-xor a b) env =
  web-trans-b
    (λ k → web-xorB (kir-opt-sound a env k) (kir-opt-sound b env k))
    (kir-lem-xor-c env (kir-opt a) (kir-opt b) (kir-eq (kir-opt a) (kir-opt b)) refl)
kir-opt-sound (we-and a b) env =
  web-trans-b
    (λ k → web-andB (kir-opt-sound a env k) (kir-opt-sound b env k))
    (kir-lem-and-c env (kir-opt a) (kir-opt b) (kir-eq (kir-opt a) (kir-opt b)) refl)
kir-opt-sound (we-or a b) env =
  web-trans-b (λ k → web-orB (kir-opt-sound a env k) (kir-opt-sound b env k)) (web-lem-or-anf (weval env (kir-opt a)) (weval env (kir-opt b)))
kir-opt-sound (we-ch e f g) env =
  web-trans-b (λ k → web-chB (kir-opt-sound e env k) (kir-opt-sound f env k) (kir-opt-sound g env k)) (web-lem-ch-mc1 (weval env (kir-opt e)) (weval env (kir-opt f)) (weval env (kir-opt g)))
kir-opt-sound (we-maj a b c) env =
  web-trans-b (λ k → web-majB (kir-opt-sound a env k) (kir-opt-sound b env k) (kir-opt-sound c env k)) (web-lem-maj-mc1 (weval env (kir-opt a)) (weval env (kir-opt b)) (weval env (kir-opt c)))

-- Verified concrete superoptimizations (checked by refl in ./build/cubical!):
kir-ex-ch : WExpr
kir-ex-ch = we-ch (we-v #0) (we-v #1) (we-v #2)

kir-ex-maj : WExpr
kir-ex-maj = we-maj (we-v #0) (we-v #1) (we-v #2)

kir-ex-cancel : WExpr
kir-ex-cancel = we-xor (we-and (we-v #0) (we-v #0)) (we-v #0)

kir-thm-cancel-zero : kir-opt kir-ex-cancel ≡ we-k false
kir-thm-cancel-zero = refl

kir-thm-ch-mc1 : wcost-mc (kir-opt kir-ex-ch) ≡ #1
kir-thm-ch-mc1 = refl

kir-thm-maj-mc1 : wcost-mc (kir-opt kir-ex-maj) ≡ #1
kir-thm-maj-mc1 = refl

