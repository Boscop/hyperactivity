kir-beq : Bool → Bool → Bool
kir-beq true  true  = true
kir-beq false false = true
kir-beq _     _     = false

kir-beq-eq : (a b : Bool) → kir-beq a b ≡ true → a ≡ b
kir-beq-eq true  true  _ = refl
kir-beq-eq false false _ = refl
kir-beq-eq true  false h = Empty-rec (true≢false (web-sym-b h))
kir-beq-eq false true  h = Empty-rec (true≢false (web-sym-b h))

kir-eq : WExpr → WExpr → Bool
kir-eq (we-k a)       (we-k b)       = kir-beq a b
kir-eq (we-v i)       (we-v j)       = %weq i j
kir-eq (we-not a)     (we-not b)     = kir-eq a b
kir-eq (we-xor a1 b1) (we-xor a2 b2) = web-andB (kir-eq a1 a2) (kir-eq b1 b2)
kir-eq (we-and a1 b1) (we-and a2 b2) = web-andB (kir-eq a1 a2) (kir-eq b1 b2)
kir-eq (we-or  a1 b1) (we-or  a2 b2) = web-andB (kir-eq a1 a2) (kir-eq b1 b2)
kir-eq (we-ch a1 b1 c1) (we-ch a2 b2 c2) = web-andB (kir-eq a1 a2) (web-andB (kir-eq b1 b2) (kir-eq c1 c2))
kir-eq (we-maj a1 b1 c1) (we-maj a2 b2 c2) = web-andB (kir-eq a1 a2) (web-andB (kir-eq b1 b2) (kir-eq c1 c2))
kir-eq _ _ = false

-- Universal Reflexivity & Structural Soundness of `kir-eq` over ALL WExpr!
kir-andB-l : (a b : Bool) → web-andB a b ≡ true → a ≡ true
kir-andB-l true  _ _ = refl
kir-andB-l false _ h = Empty-rec (true≢false (web-sym-b h))

kir-andB-r : (a b : Bool) → web-andB a b ≡ true → b ≡ true
kir-andB-r true  _ h = h
kir-andB-r false _ h = Empty-rec (true≢false (web-sym-b h))

-- Universal Word equality soundness over ALL Words via `eqw` + `eqw≡weq`!
kir-eqw-zero : (j : Word) → eqw #0 j ≡ true → #0 ≡ j
kir-eqw-zero j =
  %welimP (λ v → eqw #0 v ≡ true → #0 ≡ v) j
    (λ h → refl)
    (λ n g h → Empty-rec (true≢false (web-sym-b h)))

kir-eqw-suc : (m : Word) → ((j : Word) → eqw m j ≡ true → m ≡ j) → (j : Word) → eqw (%wsucc m) j ≡ true → %wsucc m ≡ j
kir-eqw-suc m ih j =
  %welimP (λ v → eqw (%wsucc m) v ≡ true → %wsucc m ≡ v) j
    (λ h → Empty-rec (true≢false (web-sym-b h)))
    (λ n g h → λ k → %wsucc (ih n h k))

kir-eqw-eq : (i j : Word) → eqw i j ≡ true → i ≡ j
kir-eqw-eq i = %welimP (λ u → (j : Word) → eqw u j ≡ true → u ≡ j) i kir-eqw-zero kir-eqw-suc

kir-weq-eq : (i j : Word) → %weq i j ≡ true → i ≡ j
kir-weq-eq i j h = kir-eqw-eq i j (web-trans-b (eqw≡weq i j) h)

kir-weq-eval : (env : Word → Bool) → (i j : Word) → %weq i j ≡ true → env i ≡ env j
kir-weq-eval env i j h = λ k → env (kir-weq-eq i j h k)

kir-eq-sound : (env : Word → Bool) → (a b : WExpr) → kir-eq a b ≡ true → weval env a ≡ weval env b
kir-eq-sound env (we-k a)       (we-k b)       h = kir-beq-eq a b h
kir-eq-sound env (we-v i)       (we-v j)       h = kir-weq-eval env i j h
kir-eq-sound env (we-not a)     (we-not b)     h = λ k → web-notB (kir-eq-sound env a b h k)
kir-eq-sound env (we-xor a1 b1) (we-xor a2 b2) h =
  λ k → web-xorB (kir-eq-sound env a1 a2 (kir-andB-l (kir-eq a1 a2) (kir-eq b1 b2) h) k)
                 (kir-eq-sound env b1 b2 (kir-andB-r (kir-eq a1 a2) (kir-eq b1 b2) h) k)
kir-eq-sound env (we-and a1 b1) (we-and a2 b2) h =
  λ k → web-andB (kir-eq-sound env a1 a2 (kir-andB-l (kir-eq a1 a2) (kir-eq b1 b2) h) k)
                 (kir-eq-sound env b1 b2 (kir-andB-r (kir-eq a1 a2) (kir-eq b1 b2) h) k)
kir-eq-sound env (we-or  a1 b1) (we-or  a2 b2) h =
  λ k → web-orB (kir-eq-sound env a1 a2 (kir-andB-l (kir-eq a1 a2) (kir-eq b1 b2) h) k)
                (kir-eq-sound env b1 b2 (kir-andB-r (kir-eq a1 a2) (kir-eq b1 b2) h) k)
kir-eq-sound env (we-ch a1 b1 c1) (we-ch a2 b2 c2) h =
  let hbc = kir-andB-r (kir-eq a1 a2) (web-andB (kir-eq b1 b2) (kir-eq c1 c2)) h
  in λ k → web-chB (kir-eq-sound env a1 a2 (kir-andB-l (kir-eq a1 a2) (web-andB (kir-eq b1 b2) (kir-eq c1 c2)) h) k)
                   (kir-eq-sound env b1 b2 (kir-andB-l (kir-eq b1 b2) (kir-eq c1 c2) hbc) k)
                   (kir-eq-sound env c1 c2 (kir-andB-r (kir-eq b1 b2) (kir-eq c1 c2) hbc) k)
kir-eq-sound env (we-maj a1 b1 c1) (we-maj a2 b2 c2) h =
  let hbc = kir-andB-r (kir-eq a1 a2) (web-andB (kir-eq b1 b2) (kir-eq c1 c2)) h
  in λ k → web-majB (kir-eq-sound env a1 a2 (kir-andB-l (kir-eq a1 a2) (web-andB (kir-eq b1 b2) (kir-eq c1 c2)) h) k)
                    (kir-eq-sound env b1 b2 (kir-andB-l (kir-eq b1 b2) (kir-eq c1 c2) hbc) k)
                    (kir-eq-sound env c1 c2 (kir-andB-r (kir-eq b1 b2) (kir-eq c1 c2) hbc) k)
kir-eq-sound _ (we-k _)       (we-v _)       h = Empty-rec (true≢false (web-sym-b h))
