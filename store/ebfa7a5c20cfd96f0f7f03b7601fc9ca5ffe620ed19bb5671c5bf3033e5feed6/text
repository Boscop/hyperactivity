-- SECTION 2: SINGLE-SOURCE MECHANICAL 4-TARGET LOWERING (ZERO OPAQUE BODIES!)
--   ONE AST `e : WExpr` lowered mechanically by `kir-emit-expr` to:
--     * ISO C11         (uint32_t bitwise)
--     * Apple Metal MSL (uint bitwise)
--     * NVIDIA CUDA     (uint32_t bitwise)
--     * SystemVerilog   (logic [31:0] combinational RTL)
-- ============================================================================

kir-var-name : Word → List Word
kir-var-name i = list-append "x" (ce-dec i)

-- Single shared mechanical AST expression printer (valid across C11, Metal, CUDA, and SystemVerilog!)
kir-emit-expr : List Word → List Word → WExpr → List Word
kir-emit-expr k0 _  (we-k false)   = k0
kir-emit-expr _  k1 (we-k true)    = k1
kir-emit-expr _  _  (we-v i)       = kir-var-name i
kir-emit-expr k0 k1 (we-not a)     = list-append "(~" (list-append (kir-emit-expr k0 k1 a) ")")
kir-emit-expr k0 k1 (we-xor a b)   = list-append "(" (list-append (kir-emit-expr k0 k1 a) (list-append " ^ " (list-append (kir-emit-expr k0 k1 b) ")")))
kir-emit-expr k0 k1 (we-and a b)   = list-append "(" (list-append (kir-emit-expr k0 k1 a) (list-append " & " (list-append (kir-emit-expr k0 k1 b) ")")))
kir-emit-expr k0 k1 (we-or  a b)   = list-append "(" (list-append (kir-emit-expr k0 k1 a) (list-append " | " (list-append (kir-emit-expr k0 k1 b) ")")))
kir-emit-expr k0 k1 (we-ch  e f g) =
  let es = kir-emit-expr k0 k1 e
      fs = kir-emit-expr k0 k1 f
      gs = kir-emit-expr k0 k1 g
  in list-append "(" (list-append gs (list-append " ^ (" (list-append es (list-append " & (" (list-append fs (list-append " ^ " (list-append gs ")))")))))))
kir-emit-expr k0 k1 (we-maj a b c) =
  let as = kir-emit-expr k0 k1 a
      bs = kir-emit-expr k0 k1 b
      cs = kir-emit-expr k0 k1 c
  in list-append "(" (list-append as (list-append " ^ ((" (list-append as (list-append " ^ " (list-append bs (list-append ") & (" (list-append as (list-append " ^ " (list-append cs ")))")))))))))

-- 1. Mechanical ISO C11 Emitter (from superoptimized `kir-opt` AST!)
kir-fn-c : List Word → WExpr → List Word → List Word
kir-fn-c name e tail =
  hw-ln (list-append "static inline uint32_t " (list-append name (list-append "(uint32_t x0, uint32_t x1, uint32_t x2) { return "
        (list-append (kir-emit-expr "0u" "0xFFFFFFFFu" (kir-opt e)) "; }")))) tail

kir-emit-c : List Word
kir-emit-c =
  hw-ln "/* Generated mechanically from KernelIR (lib/ir/kernel-ir.hypercubical) — verified by kir-opt-sound */"
  (hw-ln "#include <stdint.h>"
  (hw-ln "#include <stdio.h>"
  (kir-fn-c "kir_ch"     kir-ex-ch
  (kir-fn-c "kir_maj"    kir-ex-maj
  (kir-fn-c "kir_cancel" kir-ex-cancel
