cs-bool-rel-mono-at : (hp1 hp2 : CsHeap) (addr : Nat) (b : Bool) (ov : CsOptV) →
  cs-heap-ext hp1 hp2 →
  (cs-loadv hp1 (csv-ptr addr) zero ≡ ov) →
  (cs-ov-word-eq ov (cs-bool-tag b) ≡ true) →
  cs-ov-word-eq (cs-loadv hp2 (csv-ptr addr) zero) (cs-bool-tag b) ≡ true
cs-bool-rel-mono-at hp1 hp2 addr b csov-none ext ho hv = cs-no hv
cs-bool-rel-mono-at hp1 hp2 addr b (csov-some v) ext ho hv =
  cong (λ o → cs-ov-word-eq o (cs-bool-tag b)) (cs-ext-loadv hp1 hp2 addr zero v ext ho) ∙ hv
