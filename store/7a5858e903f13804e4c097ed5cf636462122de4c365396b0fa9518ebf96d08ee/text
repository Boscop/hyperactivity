-- The capacity P(j) := (fst j ≡ true) is constructively witnessed at N = 1 by (true, false),
-- yet the population-mean reading `pop-sum = 1` does NOT warrant P (its fiber pools incompatible
-- individuals).
n1-witness : (j : Bool × Bool) × (fst j ≡ true)
n1-witness = ((true , false) , λ i → true)
