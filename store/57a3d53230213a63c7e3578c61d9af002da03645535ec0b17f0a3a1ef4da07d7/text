cf-dec-sym : Nat → List Word → CtxState → (Word × List Word) → Word × (Word × List Word)
cf-dec-sym zero excl st st0 = ground-dec excl st0
cf-dec-sym (suc k) excl st st0 =
  case ftbl-exclude excl (cstate-fiber-at k st) of
    nil → cf-dec-sym k excl st st0
    cons e r →
      let ft = fiber-with-esc e r
          p = rans-dec-step ft (fst st0)
          tag = fst p
          s1 = snd p
      in if weq tag #0 then cf-dec-sym k (ftbl-add-syms (cons e r) excl) st (s1 , snd st0)
         else (wsub tag #1 , (s1 , snd st0))
