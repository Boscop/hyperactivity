aa-is-gly : AA → Bool
aa-is-gly a = case a of
  aa-G → true; aa-A → false; aa-V → false; aa-L → false; aa-I → false
  aa-P → false; aa-F → false; aa-Y → false; aa-W → false; aa-M → false
  aa-S → false; aa-T → false; aa-C → false; aa-N → false; aa-Q → false
  aa-D → false; aa-E → false; aa-K → false; aa-R → false; aa-H → false
