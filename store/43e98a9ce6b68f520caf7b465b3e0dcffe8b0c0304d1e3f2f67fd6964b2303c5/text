-- nk-conv-emit: the C for the conversion check, the machine with quotation inside it
-- (part of machine-in-hyperactive)
nk-conv-emit : List Word
nk-conv-emit =
  let m = nk-gix (code nk-conv-demo)
  in emit-c-program m (x-erase m (x-forms-all (snd (program-of-at def-source m (opt-or (def-source m) cword) #4096))))
