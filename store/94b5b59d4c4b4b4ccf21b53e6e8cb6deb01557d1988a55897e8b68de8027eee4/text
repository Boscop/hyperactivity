s-public-treatises : List Word → List Word → Proc W (List Word) → Proc W (List Word)
s-public-treatises st p next =
  if h-eq p "/paper.pdf" then s-kept-mod-public st "bin" "docs/hyperactivity.pdf.hex" else
  if h-eq p "/pdf" then s-kept-mod-public st "doc" "docs/pdf-viewer.html" else
  if h-eq p "/monograph" then s-kept-mod-public st "doc" "docs/pdf-viewer.html" else
  if h-eq p "/kg" then s-kept-mod-public st "doc" "docs/kg.html" else
  if h-eq p "/nets" then s-kept-mod-public st "doc" "docs/nets.html" else
  if h-eq p "/neuro" then s-kept-mod-public st "doc" "docs/neuro.html" else
  if h-eq p "/physics" then s-kept-mod-public st "doc" "docs/physics.html" else
  if h-eq p "/ai" then s-kept-mod-public st "doc" "docs/ai.html" else
  if h-eq p "/silicon" then s-kept-mod-public st "doc" "docs/silicon.html" else
  if h-eq p "/hyperfactor" then s-kept-mod-public st "doc" "docs/hyperfactor.html" else
  if h-eq p "/learn" then s-kept-mod-public st "doc" "docs/learn.html" else
  next
