cs-code10 : Code → CsCode10
cs-code10 (cvar n) = cc10-var n
cs-code10 (cwlit w) = cc10-wlit w
cs-code10 (cwsucc a) = cc10-wsucc a
cs-code10 (cwop j a b) = cc10-wop j a b
cs-code10 (clet t b) = cc10-let t b
cs-code10 (cpair a b) = cc10-pair a b
cs-code10 (cfst p) = cc10-fst p
cs-code10 (csnd p) = cc10-snd p
cs-code10 (ccase dd B cond) = cc10-case dd B cond
cs-code10 other = cc10-other
