r2g-step : {S : Sig} {A : Type}
         → ▸ κ ((u : Unit) → RProc κ (const-ds S) A u → GProc κ S A)
         → (u : Unit) → RProc κ (const-ds S) A u → GProc κ S A
r2g-step rec u (rret j a) = gret a
r2g-step rec u (rcmd j c k) = gcmd c (λ r → λ α → rec α unit (k r α))
r2g-step rec u (rtau j t) = gtau (λ α → rec α j (t α))
