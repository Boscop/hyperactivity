zip-fmap-r : (n : Nat) (X : Type 1) (F G G' F2 : X → Type 1) (H : (x : X) → F x → G' x → F2 x) (k : (x : X) → G x → G' x) (c : Cube n X) (d : DCube n X F c) (e : DCube n X G c) →
  PathP (λ i → DCube n X F2 c) (dcube-zip n X F G' F2 H c d (dcube-fmap n X G G' k c e)) (dcube-zip n X F G F2 (λ x y z → H x y (k x z)) c d e)
zip-fmap-r zero X F G G' F2 H k c d e = λ i → H c d (k c e)
zip-fmap-r (suc n) X F G G' F2 H k c d e =
  zip-fmap-r n (Line X) (LineO X F) (LineO X G) (LineO X G') (LineO X F2) (lineo-zip X F G' F2 H) (lineo-fmap X G G' k) c d e
