-- one row of Bareiss's step (1968): entry j becomes (a·y_j − c·x_j)/p, with a the pivot, x the pivot row,
-- c the row's own first entry and p the previous pivot; Sylvester's identity makes every division exact
row-elim : ZP → ZP → Nat → List ZP → List ZP → List ZP
row-elim a c p xs ys = case xs of
  nil → nil
  cons x xr → cons (zp-div (zp-sub (zp-mul a (zp-head ys)) (zp-mul c x)) p) (row-elim a c p xr (zp-tail ys))
