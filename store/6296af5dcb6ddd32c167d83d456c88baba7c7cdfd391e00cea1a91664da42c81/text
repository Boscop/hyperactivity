-- the line recorded in the reader's document in the source, and logged as every change is
hi-record : List Word → List Word → List Word → List Word → List Word → List Word → Proc W (List Word)
hi-record st m rd f kind t = bind (h-document (hi-doc rd)) (λ d → bind (h-pointer (hi-doc rd)) (λ p →
  bind (h-record-raw m (hi-doc rd) (hi-text-of d rd kind f t)) (λ u →
  bind (h-pointer (hi-doc rd)) (s-changed st (h-hex (hi-doc rd)) p))))
