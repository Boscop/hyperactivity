dm-neighbors : Word → List Word
dm-neighbors v =
  let x = dm-gx v
      y = dm-gy v
  in cons (dm-pack-xy (%wand (%wadd x #1) #3) y)
     (cons (dm-pack-xy (%wand (%wadd x #3) #3) y)
     (cons (dm-pack-xy x (%wand (%wadd y #1) #3))
     (cons (dm-pack-xy x (%wand (%wadd y #3) #3))
     (cons (dm-chord v) nil))))
