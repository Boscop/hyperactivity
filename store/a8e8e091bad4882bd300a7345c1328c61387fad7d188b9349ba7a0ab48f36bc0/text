nk-clauses-of : NkTm → NkTm
nk-clauses-of (nk-con c as) = if %weq c #10 then nk-nil else nk-cons nk-nil nk-nil
nk-clauses-of (nk-op h c (nk-cons r z)) = if %weq h #7 then nk-cons (nk-clause-of c) (nk-clauses-of r) else nk-cons (nk-clause-of (nk-op h c (nk-cons r z))) nk-nil
nk-clauses-of t = nk-cons (nk-clause-of t) nk-nil
