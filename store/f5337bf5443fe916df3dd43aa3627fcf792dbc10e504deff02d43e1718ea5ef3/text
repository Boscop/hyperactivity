-- every natural is a low bit plus twice a half
bsplit-step : (j : Nat) → (b : Bool) × ((h : Nat) × (j ≡ plus (bitn b) (times 2 h))) → (b : Bool) × ((h : Nat) × (suc j ≡ plus (bitn b) (times 2 h)))
bsplit-step j s = (case fst s return λ u → ((h : Nat) × (j ≡ plus (bitn u) (times 2 h))) → (b : Bool) × ((h : Nat) × (suc j ≡ plus (bitn b) (times 2 h))) of
  false → λ r → (true , (fst r , congN suc (snd r)))
  true → λ r → (false , (suc (fst r) , transN (congN suc (snd r)) (symN (times2-suc (fst r)))))) (snd s)
