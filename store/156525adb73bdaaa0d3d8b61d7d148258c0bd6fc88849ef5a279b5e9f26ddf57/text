-- Convert HPt to screen-space RPt (tenths) with depth + radial optical taper
hopf-fit-pt : SInt → SInt → SInt → SInt → HPt → RPt
hopf-fit-pt cx cy maxSpan baseW (hpt x y z) =
  let px = si-add (sp #1280) (si-div (si-mul (si-sub x cx) (sp #2000)) maxSpan)
      py = si-add (sp #1280) (si-div (si-mul (si-sub y cy) (sp #2000)) maxSpan)
      dx = si-abs (si-sub px (sp #1280))
      dy = si-abs (si-sub py (sp #1280))
      rCenter = wmul (isqrt (wadd (wmul dx dx) (wmul dy dy))) #10
      zMod = si-clamp (sp #3600) (sp #13200) (si-add (sp #7600) (fx-mul (sp #4400) z))
      rClamp = if wlt #11000 rCenter then #11000 else rCenter
      radMod = si-max (sp #4600) (si-sub (sp #12400) (fx-mul (sp #4800) (sp rClamp)))
      w = fx-mul (fx-mul baseW zMod) radMod
  in rpt px py z w
