ddv-deg : (sk : Lst Entry) (k : Word) (X : Type 1) (F : X → Type 1) (G : Cube (dims sk) X) (d : DCube (dims sk) X F G) →
  DDDeg (dims sk) (λ Z H G' q → diag-dd sk k Z H G' q) X F G d
ddv-deg lnil k X F G d = λ i → d
ddv-deg (lcons (e-ty s) sk) k X F G d =
  bool-elim1 (λ b → DDDeg (dims sk) (dd-ty-op sk k b) X F G d)
    (fmap-sw2i (dims sk) X F (DL X F) (degen-o X F) (λ x q → fst q) (λ i x y → y) G d)
    (ddv-deg sk (%wsub k #1) X F G d) (weq k #0)
ddv-deg (lcons e-dim sk) k X F G d =
  bool-elim1 (λ b → DDDeg (suc (dims sk)) (dd-dim-op sk k b) X F G d)
    (fmap-sw2i (dims sk) (Line X) (LineO X F) (LineO X (DL X F)) (lineo-fmap X F (DL X F) (degen-o X F)) (dgo X F) (λ i L y → y) G d)
    (pcat (DCube (dims sk) (Line X) (LineO X F) G)
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F) G
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F) G
             (dcube-fmap (dims sk) (Line X) (LineO X F) (LineO X (DL X F)) (lineo-fmap X F (DL X F) (degen-o X F)) G d)))
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F) G (dcube-fmap (dims sk) (Line X) (LineO X F) (DL (Line X) (LineO X F)) (degen-o (Line X) (LineO X F)) G d))
       d
       (cong1 (DCube (dims sk) (Line X) (DL (Line X) (LineO X F)) G) (DCube (dims sk) (Line X) (LineO X F) G) (λ w → diag-dd sk (%wsub k #1) (Line X) (LineO X F) G w)
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F) G
             (dcube-fmap (dims sk) (Line X) (LineO X F) (LineO X (DL X F)) (lineo-fmap X F (DL X F) (degen-o X F)) G d))
          (dcube-fmap (dims sk) (Line X) (LineO X F) (DL (Line X) (LineO X F)) (degen-o (Line X) (LineO X F)) G d)
          (fmap-sw21 (dims sk) (Line X) (LineO X F) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (lineo-fmap X F (DL X F) (degen-o X F)) (dxo X F)
             (degen-o (Line X) (LineO X F)) (λ i L y → degen-o (Line X) (LineO X F) L y) G d))
       (ddv-deg sk (%wsub k #1) (Line X) (LineO X F) G d))
    (weq k #0)
