codec-list : {A B : Type} → Codec A B → Codec (List A) (List B)
codec-list {A} {B} c =
  ( list-map (codec-enc c)
  , ( list-map (codec-dec c)
    , (λ xs → concat {lzero} {List A} {list-map (codec-dec c) (list-map (codec-enc c) xs)} {list-map (λ x → codec-dec c (codec-enc c x)) xs} {xs}
                (cm-map-comp (codec-dec c) (codec-enc c) xs)
                (cm-map-id (λ x → codec-dec c (codec-enc c x)) (codec-ok c) xs)) ) )
