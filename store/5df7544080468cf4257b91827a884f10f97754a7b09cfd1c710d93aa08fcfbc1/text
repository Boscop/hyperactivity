-- Constructive Levinthal Resolution Theorem:
-- On ANY funneled landscape (regardless of how exponentially large C is),
-- starting from ANY conformation c with defect(c) ≤ k, k local steps reach defect ≡ 0.
fold-funnel-descent-terminates :
  (C : Type 0) → (defect : C → Nat) → (step : C → C) →
  FoldFunnel C defect step →
  (k : Nat) → (c : C) → leb (defect c) k ≡ true →
  defect (fold-descent k step c) ≡ zero
fold-funnel-descent-terminates C defect step fun zero c le =
  fold-leb-zero (defect c) le
fold-funnel-descent-terminates C defect step fun (suc k) c le =
  fold-nat-dichotomy (defect c)
    (λ z → fold-descent-keeps-zero C defect step (λ x → fst (fun x)) k (step c) (fst (fun c) z))
    (λ pos → fold-funnel-descent-terminates C defect step fun k (step c)
      (fold-leb-trans (suc (defect (step c))) (defect c) (suc k) (snd (fun c) pos) le))
