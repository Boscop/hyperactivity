-- Scrutinee tag into x1: values < 4096 are immediate constructor indices; >= 4096 are arena cell pointers [tag][f0...]
a64-tag : Lst Word
a64-tag =
  let imm = a64-mov-r #1 #0
      heap = a64-ldr-idx #1 #0 #0
      imm-jump = l-app imm (a64-b-skip (l-count heap))
  in xcat4 (a64-movz #9 #4096 #0) (a64-cmp #0 #9) (a64-bcond-skip a64-cc-hs (l-count imm-jump)) (l-app imm-jump heap)
