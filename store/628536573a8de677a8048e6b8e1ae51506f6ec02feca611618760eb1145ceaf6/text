-- /corpus: every text the site serves (the writing, the papers in the source, the records, the paper), as one
-- JSON list of {h: where it is read, t: its title, x: its text}, so a reader's browser searches all of it at
-- once, as they type; a line break becomes a space, so no two words run together
s-cj-esc : List Word → List Word
s-cj-esc nil = nil
s-cj-esc (cons x r) = if orB (weq x #34) (weq x #92) then cons #92 (cons x (s-cj-esc r)) else if wlt x #32 then cons #32 (s-cj-esc r) else cons x (s-cj-esc r)
