-- Simultaneous Row & Column Zero-Bank-Conflict Theorems:
-- 1. Row-Tile Access (fixed row r, parallel lanes c1, c2): equal physical banks implies c1 ≡ c2!
row-bank-conflict-free : (w : Nat) → (r c1 c2 : Vec Bool w) →
  swz-bank w r c1 ≡ swz-bank w r c2 → c1 ≡ c2
row-bank-conflict-free w r c1 c2 h =
  catV w c1 (bv-xor w r (bv-xor w r c1)) c2
    (sym (bv-xor-inv w r c1))
    (catV w (bv-xor w r (bv-xor w r c1)) (bv-xor w r (bv-xor w r c2)) c2
      (λ i → bv-xor w r (h i))
      (bv-xor-inv w r c2))
