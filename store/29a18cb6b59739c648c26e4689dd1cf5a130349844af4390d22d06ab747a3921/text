-- a module of the source (bound at PATH by an entry of the view staged, store/entries/ID): its text, as
-- the source holds it, is the prose of PATH
os-module : List Word × (List Word × (Word × Word)) → List Word → Proc W (Sum (List Word) (List (List Word × List Word)))
os-module e path = if h-not (os-prose path) then ret {lzero} {W} (inr nil) else os-staged e (bind (h-source-text path) (os-keyed path))
