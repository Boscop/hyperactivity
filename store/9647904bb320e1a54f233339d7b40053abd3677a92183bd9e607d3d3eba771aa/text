nk-sig-for : Lst Code → NkRawSig
nk-sig-for roots =
  let d0 = lcons bool-d (nk-fold-codes (nk-code-datas (toNat #200)) roots lnil)
      g0 = nk-fold-codes (λ c a → nk-add-words (code-globals c) a) roots lnil
      fin = %welimP (λ _ → NkSigSt) #2048 (d0 , (g0 , (lnil , (lnil , (lnil , lnil))))) (λ _ s → nk-sig-step s)
  in snd (snd (snd (snd fin)))
