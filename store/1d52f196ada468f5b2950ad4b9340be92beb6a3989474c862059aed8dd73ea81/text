-- the first n paragraphs of lines (a paragraph ends at an empty line), and the lines after them
lead-paragraphs : Nat → List (List Word) → List (List Word)
lead-paragraphs zero ls = nil
lead-paragraphs (suc n) nil = nil
lead-paragraphs (suc zero) (cons nil ls) = nil
lead-paragraphs (suc (suc m)) (cons nil ls) = cons nil (lead-paragraphs (suc m) ls)
lead-paragraphs (suc n) (cons (cons x l) ls) = cons (cons x l) (lead-paragraphs (suc n) ls)
