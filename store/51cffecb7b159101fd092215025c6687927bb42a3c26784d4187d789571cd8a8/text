hcm-match-pick : Word → Word → Word → Word → Word → Word × Word
hcm-match-pick mlen mpos h32 p6 p4 =
  if %wlt #0 mlen then (mpos , mlen)
  else if %wlt #0 p6 then
    if %weq (%wshr p6 #32) h32 then (%wsub (%wand p6 #4294967295) #1 , #6)
    else if %wlt #0 p4 then
      if %weq (%wshr p4 #32) h32 then (%wsub (%wand p4 #4294967295) #1 , #4) else (#0 , #0)
    else (#0 , #0)
  else if %wlt #0 p4 then
    if %weq (%wshr p4 #32) h32 then (%wsub (%wand p4 #4294967295) #1 , #4) else (#0 , #0)
  else (#0 , #0)
