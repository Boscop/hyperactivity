-- a document's HTML from its lines (h-split, which makes each line when it is read): the block open
-- (b) and the lines left; each line is read once and dropped, so what is held is the open block
md-go : MdB → List (List Word) → List Word
md-go b nil = md-close b
md-go b (cons l ls) = let s = md-next b l in list-append (md-out s) (md-go (md-left s) ls)
