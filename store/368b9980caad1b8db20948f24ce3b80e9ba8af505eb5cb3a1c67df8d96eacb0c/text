hhf-main : List (List Word) → Step W Word
hhf-main _ =
  scmd w-now (λ t0 →
  hhf-run-audit (λ rh st →
  scmd (w-load st) (λ entries →
  scmd (w-load (%wadd st #8)) (λ dmods →
  scmd (w-load (%wadd st #16)) (λ chunks →
  scmd (w-load (%wadd st #24)) (λ mbytes →
  scmd (w-load (%wadd st #32)) (λ up →
  scmd (w-load (%wadd st #40)) (λ rp →
  scmd (w-load (%wadd st #48)) (λ fl →
  scmd (w-free st) (λ _ →
  scmd w-now (λ t1 →
  cli-say (list-append "HX-Hyperfactor store/ ROOT=" (list-append rh
    (list-append " entries=" (list-append (ce-dec entries)
    (list-append " domain_mods=" (list-append (ce-dec dmods)
    (list-append " chunk_refs=" (list-append (ce-dec chunks)
    (list-append " manifest_B=" (list-append (ce-dec mbytes)
    (list-append " univ_proofs=" (list-append (ce-dec up)
    (list-append " refl_proofs=" (list-append (ce-dec rp)
    (list-append " foreign_inc=" (list-append (ce-dec fl)
    (list-append " (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)")))))))))))))))))) (sdone #0))))))))))))
