-- Spectral Convolution Theorem: inverse butterfly of pointwise spectral product equals 2 · (h ⊛ x)!
conv2-spectral-sound : (h0 h1 x0 x1 : Nat) →
  let dc = times (plus h0 h1) (plus x0 x1)
      y0 = conv2-y0 h0 h1 x0 x1
      y1 = conv2-y1 h0 h1 x0 x1
  in (plus dc y0 ≡ plus (doubleN y0) y1) × (plus dc y1 ≡ plus (doubleN y1) y0)
conv2-spectral-sound h0 h1 x0 x1 =
  let y0 = conv2-y0 h0 h1 x0 x1
      y1 = conv2-y1 h0 h1 x0 x1
      dc = conv2-dc-law h0 h1 x0 x1
      p0 = transN (congN (λ u → plus u y0) dc)
             (transN (plus-assoc y0 y1 y0)
               (transN (congN (plus y0) (plus-comm y1 y0))
                 (sym (plus-assoc y0 y0 y1))))
      p1 = transN (congN (λ u → plus u y1) dc)
             (transN (plus-assoc y0 y1 y1)
               (plus-comm y0 (doubleN y1)))
  in (p0 , p1)
