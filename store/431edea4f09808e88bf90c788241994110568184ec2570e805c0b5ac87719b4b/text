-- −b_i between states that differ exactly at i and i + 1
lc-tfoff : List Nat → List Nat → BZ
lc-tfoff b ps = case ps of
  nil → bz-zero
  cons i rest → (case rest of
    nil → bz-zero
    cons j r2 → (case r2 of
      nil → if eqb j (suc i) then in-negint (lc-natnth b i) else bz-zero
      cons x r3 → bz-zero))
