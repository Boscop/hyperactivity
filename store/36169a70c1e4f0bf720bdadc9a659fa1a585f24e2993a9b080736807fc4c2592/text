-- the branches of a case on data type dd at depth d: branch k binds its fields and gives r<d>
ce-brs : Lst Code → (Word → Code → List Word) → Word → Word → Word → List Word
ce-brs lnil f dd d k = nil
ce-brs (lcons br r) f dd d k = list-append "case " (list-append ((λ z → ce-q (toNat #20) z nil) k) (list-append ": { " (list-append (ce-binds (toNat (x-nf dd k)) d #0) (list-append "r" (list-append ((λ z → ce-q (toNat #20) z nil) d) (list-append " = " (list-append (f (%wadd d (x-nf dd k)) (x-strip (x-nf dd k) br)) (list-append "; break; } " (ce-brs r f dd d (%wsucc k))))))))))
