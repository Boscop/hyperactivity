-- SafeAt / Warranted: intervention u drives every model in the compatible fiber to target
Warranted : (M O I R : Type 0) → (obs : M → O) → (y : O)
          → (run : M → I → R) → (target : R) → (u : I) → Type 0
Warranted M O I R obs y run target u =
  (mp : ModelFib M O obs y) → run (fst mp) u ≡ target
