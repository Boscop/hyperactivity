-- la_to_pa: from paging.sail (it calls what is defined after it there)
-- (part of language-support)
la_to_pa : (lin_addr : Bits #48) → (r_w_x : Text) → MS (Bits #52)
la_to_pa lin_addr r_w_x =
  onS {Bool} {Bits #52} (canonical_address_p (bv-signed #48 lin_addr)) (λ t'1 →
    let k'6 : Bool → MS (Bits #52)
        k'6 =
          λ t'3 →
            onS {Unit} {Bits #52} (fl-assert {exception} t'3 #583512835017589007664157297346884145) (λ _ →
              ia32e_la_to_pa lin_addr r_w_x)
    in λ σ →
         if t'1 then
           the (MS (Bits #52))
             (bindS {Bool} {Bits #52} (getS {Bool} x86-app_view) (λ app_view'2 →
                k'6 (b-not app_view'2))) σ
         else
           the (MS (Bits #52))
             (k'6 false) σ)
