-- composition in a pair type: the first parts composed; the second parts composed along the
-- second type at the first composition's filler
nk-hcomp-sig : NkTm → NkTm → NkTm → NkTm → NkTm
nk-hcomp-sig a f bs u0 =
  nk-mkpair (nk-hcomp a (nk-sys (nk-sys-p1 bs)) (nk-p1 u0))
    (nk-comp (nk-lam (nk-app (nk-up f) (nk-hcomp (nk-up a) (nk-sys (nk-cons (nk-br (nk-neg (nk-var #0)) (nk-lam (nk-up2 (nk-p1 u0)))) (nk-sys-p1m bs))) (nk-up (nk-p1 u0)))))
             (nk-sys-p2 bs) (nk-p2 u0))
