cs-for-loop-step-no-ub : (r : CsRes) (ev : CsHeap → CsEnv → CsExp → CsRes) (rem : Nat) (idx d : Word) (env : CsEnv) (step : CsExp) →
  (cs-no-ub r ≡ true) →
  ((hp1 : CsHeap) (acc1 : CsVal) → cs-no-ub (cs-for-loop ev rem (%wsucc idx) d hp1 acc1 env step) ≡ true) →
  cs-no-ub (cs-bind-res r (λ hp1 acc1 → cs-for-loop ev rem (%wsucc idx) d hp1 acc1 env step)) ≡ true
cs-for-loop-step-no-ub (cs-ok hp1 acc1) ev rem idx d env step hr ih = ih hp1 acc1
cs-for-loop-step-no-ub cs-abort ev rem idx d env step hr ih = refl
cs-for-loop-step-no-ub cs-ub ev rem idx d env step hr ih = cs-no hr
