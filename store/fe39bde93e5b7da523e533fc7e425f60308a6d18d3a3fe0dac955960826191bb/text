-- ---------------------------------------------------------------- static storage
-- rust-init: the statics and then the vtables allocated and written; its value is the image,
-- their addresses in that order, which every frame carries.
rm-init-bytes : List Word → Target → MPtr → Word → REv Unit
rm-init-bytes nil t p off = rm-ret unit
rm-init-bytes (cons b bs) t p off =
  rm-then (rm-bind (rm-off p off) (λ q → rm-store t (sk-int false iw8) #1 q (sv-i (uq-of-word b))))
          (rm-init-bytes bs t p (wadd off #1))
