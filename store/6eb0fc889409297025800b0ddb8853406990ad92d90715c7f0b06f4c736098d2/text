count-lt-app : {o : Ord} → (k : El o) → (a b : List (El o)) → count-lt k (list-append a b) ≡ plus (count-lt k a) (count-lt k b)
count-lt-app k a b =
  case a return λ w → count-lt k (list-append w b) ≡ plus (count-lt k w) (count-lt k b) of
    nil → λ i → count-lt k b
    cons x r → tr (plus (one-if (not (leq k x))) (plus (count-lt k r) (count-lt k b))) (λ i → plus (one-if (not (leq k x))) (rec r i)) (sym (plus-assoc (one-if (not (leq k x))) (count-lt k r) (count-lt k b)))
