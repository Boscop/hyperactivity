-- every pair of the configuration once
config-terms : Nat → List FaradayLine → List Placed → Nat × Nat
config-terms n ls ps = case ps of
  nil → (zero , zero)
  cons x rest → (plus (fst (pair-terms n ls x rest)) (fst (config-terms n ls rest)) , plus (snd (pair-terms n ls x rest)) (snd (config-terms n ls rest)))
