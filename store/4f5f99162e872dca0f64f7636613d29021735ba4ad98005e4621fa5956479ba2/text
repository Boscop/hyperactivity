-- the sx-search reads one shard and finds exactly every point q begins
sx-ok : (q : List (List Word)) (i : Nat) (ts : List (List Word)) → sx-search q i ts ≡ hits q i ts
sx-ok q =
  case q return λ w → (i : Nat) (ts : List (List Word)) → sx-search w i ts ≡ hits w i ts of
    nil → λ i ts j → hits nil i ts
    cons x r → λ i ts → sx-ok-cons x r ts i
