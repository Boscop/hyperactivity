s-request : Bool → List Word → List Word → Sum Unit (List Word) → List Word → Proc W (List Word)
s-request pub st m tok req =
  if h-prefix "PUT " req then (
    let p = h-before " " (h-drop "PUT " (h-before (cons #13 nil) req)) in
    if s-allowed pub tok req then (
      if h-prefix "/roots/" p then s-put-root st m (h-drop "/roots/" (h-before "?" p)) (h-after (list-append h-crlf h-crlf) req)
      else ret {lzero} {W} (s-respond "404 Not Found" "text/plain" "not found"))
    else ret {lzero} {W} (s-respond "403 Forbidden" "text/plain" "this server is read-only"))
  else if h-prefix "POST " req then (if um-send-path (h-before " " (h-drop "POST " req)) then um-send req
    else if s-allowed pub tok req then s-post st m (h-before " " (h-drop "POST " req)) req
    else ret {lzero} {W} (s-respond "403 Forbidden" "text/plain" "this server is read-only"))
  else if s-redirect-onrender pub req then ret {lzero} {W} (s-to-canonical req)
  else if andB pub (andB (s-views-path (s-request-path req)) (h-not (s-allowed pub tok req))) then ret {lzero} {W} s-to-front
  else if andB pub (andB (s-withheld (s-request-path req)) (h-not (s-allowed pub tok req))) then ret {lzero} {W} (s-respond "404 Not Found" s-html s-not-found)
  else if andB pub (h-not (s-allowed pub tok req)) then s-public-answer st m (s-request-path req)
  else s-answer st m (s-request-path req)

-- the socket: port, listening on 127.0.0.1, or on every address when HYPERACTIVE_PUBLIC is set
s-addr-bytes : Bool → Word → List Word
s-addr-bytes pub port = cons #2 (cons #0 (cons (wshr port #8) (cons (wand port #255) (if pub then cons #0 (cons #0 (cons #0 (cons #0 nil))) else cons #127 (cons #0 (cons #0 (cons #1 nil)))))))
s-addr : Bool → Word → Proc W Word
s-addr pub port = bind (alloc-bytes #16) (λ a → bind (h-poke a (s-addr-bytes pub port)) (λ u → ret a))
s-listen : Bool → Word → Proc W Word
s-listen pub port = bind (sys-call #41 #2 #1 #0 #0 #0 #0) (λ fd → bind (alloc-bytes #4) (λ one → bind (store8-at one #1) (λ u →
  bind (sys-call #54 fd #1 #2 one #4 #0) (λ o → bind (s-addr pub port) (λ a → bind (sys-call #49 fd a #16 #0 #0 #0) (λ b →
  bind (sys-call #50 fd #16 #0 #0 #0 #0) (λ l → ret {lzero} {W} (if orB (wlt #9223372036854775807 b) (wlt #9223372036854775807 l) then #18446744073709551615 else fd))))))))

-- exact HTTP header boundary finder (MSG_PEEK = 2 on recvfrom sys-call #45) so PUT /packs/<SHA256> leaves 100% of binary body in socket for 64 KiB streaming
s-hdr-end : Word → List Word → Word
s-hdr-end k nil = #0
s-hdr-end k (cons x r) =
  if h-prefix (list-append h-crlf h-crlf) (cons x r)
  then wadd k #4
  else s-hdr-end (wadd k #1) r

-- HTTP header boundary ends right after CRLFCRLF leaving binary body intact (part of product-implementation)
s-hdr-end-example : Path Word (s-hdr-end #0 (list-append "PUT /x" (list-append h-crlf (list-append h-crlf "BODY")))) #10
s-hdr-end-example = refl

s-read-head : Nat → Word → List Word → Proc W (List Word)
s-read-head zero c acc = ret acc
s-read-head (suc k) c acc =
  if wlt #16384 (fromNat (list-length acc)) then ret {lzero} {W} acc
  else bind (with-bytes {Sum Unit (Word × List Word)} #8192 (λ buf →
    bind (sys-call #45 c buf #8192 #2 #0 #0) (λ n →
    if orB (weq n #0) (wlt #9223372036854775807 n) then ret {lzero} {W} (inl unit)
    else bind (h-peek buf (toNat n)) (λ pk →
      let comb = list-append acc pk in
      let he = s-hdr-end #0 comb in
      let eat = if weq he #0 then n else wsub he (fromNat (list-length acc)) in
      bind (sys-call #0 c buf eat #0 #0 #0) (λ r →
      ret {lzero} {W} (inr (he , (if weq he #0 then comb else h-take (toNat he) comb)))))))) (λ res →
    case res of
      inl u → ret {lzero} {W} acc
      inr hw → if weq (fst hw) #0 then s-read-head k c (snd hw) else ret {lzero} {W} (snd hw))

s-read-body : Nat → Word → Word → List Word → Proc W (List Word)
s-read-body zero c want acc = ret acc
s-read-body (suc k) c want acc =
  if h-not (wlt (fromNat (list-length acc)) want) then ret {lzero} {W} acc
  else let rem = wsub want (fromNat (list-length acc)) in
  let ask = if wlt rem #65536 then rem else #65536 in
  bind (with-bytes {Sum Unit (List Word)} #65536 (λ buf →
    bind (sys-call #0 c buf ask #0 #0 #0) (λ n →
    if orB (weq n #0) (wlt #9223372036854775807 n) then ret {lzero} {W} (inl unit)
    else bind (h-peek buf (toNat n)) (λ b → ret {lzero} {W} (inr b))))) (λ r →
    case r of
      inl u → ret {lzero} {W} acc
      inr b → s-read-body k c want (list-append acc b))

-- one connection answered: binary /packs and /bootstrap.tgz stream in a 64 KiB buffer; text requests read bounded body
s-handle : Bool → List Word → List Word → Sum Unit (List Word) → Word → Proc W Unit
s-handle pub st m tok c =
  bind (s-read-head (toNat #32) c nil) (λ hdr →
  let line1 = h-before (cons #13 nil) hdr in
  if h-prefix "PUT /packs/" line1
  then let ph = h-before "?" (h-before " " (h-drop "PUT /packs/" line1)) in
    bind (s-put-pack pub tok c ph hdr) (λ u → bind (sys-call #3 c #0 #0 #0 #0 #0) (λ cl → ret unit))
  else if andB (h-prefix "GET /packs/" line1) (h-not (s-redirect-onrender pub hdr))
  then let ph = h-before "?" (h-before " " (h-drop "GET /packs/" line1)) in
    bind (if s-hex64 ph then s-stream-file c (list-append "packs/" ph) "application/gzip" nil
          else bind (fd-write c (s-respond "404 Not Found" "text/plain" "not found")) (λ w → ret {lzero} {W} unit)) (λ u →
    bind (sys-call #3 c #0 #0 #0 #0 #0) (λ cl → ret unit))
  else if andB (orB (h-eq (h-before "?" (s-request-path hdr)) "/bootstrap.tgz") (h-eq (h-before "?" (s-request-path hdr)) "/bootstrap")) (h-not (s-redirect-onrender pub hdr))
  then bind (s-stream-file c "bootstrap.tgz" "application/gzip" "attachment; filename=hyperactivity-bootstrap.tgz") (λ u →
    bind (sys-call #3 c #0 #0 #0 #0 #0) (λ cl → ret unit))
  else let clen = h-number (um-header "content-length" hdr) in
    let cap = if s-allowed pub tok hdr then #16777216 else #65536 in
    if wlt cap clen
    then bind (fd-write c (s-respond "413 Payload Too Large" "text/plain" "payload too large")) (λ w → bind (sys-call #3 c #0 #0 #0 #0 #0) (λ cl → ret unit))
    else bind (if andB (wlt #0 clen) (h-infix "100-continue" (sx-lower (um-header "expect" hdr)))
               then fd-write c (list-append "HTTP/1.1 100 Continue" (list-append h-crlf h-crlf))
               else ret {lzero} {W} #0) (λ cont →
      bind (s-read-body (toNat #4096) c clen nil) (λ body →
      bind (s-request pub st m tok (list-append hdr body)) (λ resp →
      bind (fd-write c resp) (λ w → bind (sys-call #3 c #0 #0 #0 #0 #0) (λ cl → ret unit))))))

s-room : Word → Proc W Word
s-room n = if wlt n #16 then ret {lzero} {W} n else bind (sys-call #61 #18446744073709551615 #0 #0 #0 #0 #0) (λ r → ret {lzero} {W} (if wlt r #9223372036854775808 then wsub n #1 else #0))

s-reap : Nat → Word → Proc W Word
s-reap zero n = ret n
s-reap (suc k) n = bind (sys-call #61 #18446744073709551615 #0 #1 #0 #0 #0) (λ r → if andB (wlt #0 r) (wlt r #9223372036854775808) then s-reap k (wsub n #1) else ret {lzero} {W} n)

s-serve : Nat → Word → Bool → List Word → List Word → Sum Unit (List Word) → Word → Proc W Unit
s-serve zero n pub st m tok fd = ret unit
s-serve (suc k) n pub st m tok fd = bind (s-room n) (λ n1 → bind (sys-call #43 fd #0 #0 #0 #0 #0) (λ c →
  bind (sys-call #57 #0 #0 #0 #0 #0 #0) (λ pid →
  if weq pid #0 then bind (s-handle pub st m tok c) (λ u → bind (sys-call #231 #0 #0 #0 #0 #0 #0) (λ x → ret {lzero} {W} unit))
  else if wlt pid #9223372036854775808 then bind (sys-call #3 c #0 #0 #0 #0 #0) (λ cl → bind (s-reap (toNat #64) (wadd n1 #1)) (λ n2 → s-serve k n2 pub st m tok fd))
  else bind (s-handle pub st m tok c) (λ u → s-serve k n1 pub st m tok fd))))

s-port : List (List Word) → Word
s-port nil = #8080
s-port (cons p r) = if h-null p then #8080 else h-number p
s-set : Sum Unit (List Word) → Bool
s-set (inl u) = false
s-set (inr v) = h-not (h-null v)

-- build bootstrap.tgz (~95 KB: Makefile, src/*, hyperactive, README.md) so any bare peer machine can bootstrap without git
s-make-bootstrap : List Word → Proc W Unit
s-make-bootstrap dst =
  bind (h-file-time dst) (λ bt →
  bind (h-file-time "Makefile") (λ mt →
  if andB (weq bt #0) (wlt #0 mt)
  then bind (h-run (cons "/usr/bin/env" (cons "tar" (cons "-czf" (cons dst (cons "Makefile" (cons "src" (cons "hyperactive" (cons "README.md" nil))))))))) (λ r → ret {lzero} {W} unit)
  else ret {lzero} {W} unit))

-- seed initial pack + roots/latest + root when absent so `hyperactive take latest` works out of the box immediately on deploy
s-seed-place : List Word → Proc W Unit
s-seed-place m =
  bind (h-mkdir "packs") (λ u0 →
  bind (h-mkdir "roots") (λ u1 →
  bind (h-mkdir ".cubical-store") (λ u2 →
  bind (h-file-time "roots/latest") (λ lt →
  if wlt #0 lt then ret {lzero} {W} unit
  else bind (h-capture (cons m (cons "--root" nil))) (λ rr →
    let rt = s-head nil (h-nonempty (h-lines (snd rr))) in
    if h-null rt then ret {lzero} {W} unit
    else let tmp = the (List Word) "packs/.seed.tgz" in
      bind (h-run (cons "/usr/bin/env" (cons "tar" (cons "-czf" (cons tmp (cons "store" nil)))))) (λ tc →
      if h-not (weq tc #0) then bind (h-unlink tmp) (λ u → ret {lzero} {W} unit)
      else bind (h-capture (cons "/usr/bin/env" (cons "sha256sum" (cons tmp nil)))) (λ sh →
        let ph = s-head nil (h-split #32 (snd sh)) in
        bind (s-rename tmp (list-append "packs/" ph)) (λ rn →
        bind (h-write ".cubical-store/packs" (h-line ph)) (λ w0 →
        bind (h-write ".cubical-store/sent-marker" nil) (λ w1 →
        bind (h-write (list-append "roots/" rt) (h-line ph)) (λ w2 →
        bind (h-write "roots/latest" (h-line ph)) (λ w3 →
        bind (h-write "root" (h-line rt)) (λ w4 → ret {lzero} {W} unit)))))))))))))

-- optional HYPERACTIVE_DATA persistent directory (e.g. /var/data on Render Persistent Disk): union-merges boot store/ + .cubical-store/ and chdirs into it
s-boot-data : List Word → Proc W (List Word)
s-boot-data m =
  bind h-cwd (λ cwd →
  let abs-m = if h-prefix "/" m then m else list-append cwd (cons #47 m) in
  bind (h-env "HYPERACTIVE_DATA") (λ ed →
  case ed of
    inl u → bind (s-make-bootstrap "bootstrap.tgz") (λ mb → bind (s-seed-place abs-m) (λ sp → ret {lzero} {W} abs-m))
    inr ddir →
      if h-null ddir then bind (s-make-bootstrap "bootstrap.tgz") (λ mb → bind (s-seed-place abs-m) (λ sp → ret {lzero} {W} abs-m))
      else bind (h-mkdir ddir) (λ d0 →
        bind (h-mkdir (list-append ddir "/store")) (λ d1 →
        bind (h-mkdir (list-append ddir "/.cubical-store")) (λ d2 →
        bind (s-make-bootstrap (list-append ddir "/bootstrap.tgz")) (λ mb →
        bind (h-file-time "store") (λ st0 →
        bind (if wlt #0 st0 then h-run (cons "/usr/bin/env" (cons "cp" (cons "-rn" (cons "store/." (cons (list-append ddir "/store/") nil))))) else ret {lzero} {W} #0) (λ cp1 →
        bind (h-file-time ".cubical-store") (λ cs0 →
        bind (if wlt #0 cs0 then h-run (cons "/usr/bin/env" (cons "cp" (cons "-rn" (cons ".cubical-store/." (cons (list-append ddir "/.cubical-store/") nil))))) else ret {lzero} {W} #0) (λ cp2 →
        bind (s-chdir ddir) (λ cd →
        bind (h-read "root") (λ lr →
        bind (case lr of
          inr rtxt → h-run (cons abs-m (cons "--take" (cons (h-trim (h-before (cons #10 nil) rtxt)) nil)))
          inl u2 → h-run (cons abs-m (cons "--index" nil))) (λ ix →
        bind (s-seed-place abs-m) (λ sp →
        ret {lzero} {W} abs-m))))))))))))))

s-start : List Word → List Word → Word → Proc W Unit
s-start st m0 port =
  bind (s-boot-data m0) (λ m →
  bind (h-env "HYPERACTIVE_PUBLIC") (λ pub →
  bind (h-env "HYPERACTIVE_TOKEN") (λ tok →
  bind (s-site-kept st "front" s-front) (λ f0 →
  bind (s-listen (s-set pub) port) (λ fd →
  if wlt fd #9223372036854775807 then bind (h-out (h-line (list-append "http://localhost:" (list-append (h-decimal port) "/")))) (λ u →
    bind (sys-call #57 #0 #0 #0 #0 #0 #0) (λ pid →
    if weq pid #0 then bind (s-paper st m) (λ r → bind (sys-call #231 #0 #0 #0 #0 #0 #0) (λ x → ret {lzero} {W} unit))
    else s-serve (toNat #18446744073709551615) (if wlt pid #9223372036854775808 then #1 else #0) (s-set pub) st m tok fd))
  else h-fail (list-append "server: the port cannot be listened on: " (h-decimal port)))))))

s-make-site : List Word → List Word → Proc W Unit
s-make-site st m =
  bind (s-make-bootstrap "bootstrap.tgz") (λ mb →
  bind (s-refresh-site st m) (λ w → if w then exit #0 else exit #1))
s-main : Proc W Unit
s-main = bind (h-env "CUBICAL_STORE") (λ e → bind h-args (λ a →
  let cmd = s-head nil (h-drop-n (suc (suc zero)) a) in
  if orB (h-eq cmd "site") (h-eq cmd "refresh") then s-make-site (h-store-of e) (s-head "build/cubical" a)
  else if h-eq cmd "search" then bind (sx-make-all (h-store-of e) s-published) (λ u → exit #0)
  else s-start (h-store-of e) (s-head "build/cubical" a) (s-port (h-drop-n (suc (suc zero)) a))))

-- s-run: serves the workflow, its history, the WASM kernel, and the content-addressed pool place over HTTP (part of product-implementation)
s-run : Step W Unit
s-run = to-step s-main
#run s-run
