s-req-path-any : List Word → List Word
s-req-path-any req =
  if h-prefix "GET " req then s-request-path req else
  if h-prefix "HEAD " req then h-before " " (h-drop "HEAD " (h-before (cons #13 nil) req)) else "/"

s-canon-path : List Word → List Word
s-canon-path p = if h-null p then "/" else if h-prefix "/" p then um-hdr-clean p else cons #47 (um-hdr-clean p)

s-redirect-onrender : Bool → List Word → Bool
s-redirect-onrender pub req =
  andB pub (
  andB (h-not (h-null s-canonical-host)) (
  andB (orB (h-prefix "GET " req) (h-prefix "HEAD " req)) (
  andB (h-not (h-eq (h-before "?" (s-req-path-any req)) "/graph"))
       (h-eq (sx-lower (h-before ":" (um-header "host" req))) "hyperactivity.onrender.com"))))

s-to-canonical : List Word → List Word
