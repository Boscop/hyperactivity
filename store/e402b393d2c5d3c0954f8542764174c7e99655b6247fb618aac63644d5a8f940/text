-- HTTP header lookup (case-insensitive for HTTP/2 and reverse proxies such as Cloudflare and Render)
um-header-in : List Word → List (List Word) → List Word
um-header-in name nil = nil
um-header-in name (cons line r) =
  if h-null (h-before (cons #13 nil) line) then nil
  else if h-eq (sx-lower (h-before ":" (h-before (cons #13 nil) line))) name
  then h-trim (h-after ":" (h-before (cons #13 nil) line))
  else um-header-in name r

um-header : List Word → List Word → List Word
um-header name req = um-header-in name (h-tail-lists (h-split #10 (h-before (list-append h-crlf h-crlf) req)))

s-bearer-tok : List Word → List Word
s-bearer-tok auth =
  if h-eq (sx-lower (h-take (toNat #7) auth)) "bearer "
  then h-trim (h-drop-n (toNat #7) auth)
  else nil

-- may this request change the source: with a token, only a request carrying it via X-Token or
-- Authorization: Bearer (case-insensitive header names); with none, only when the server is not public
s-allowed : Bool → Sum Unit (List Word) → List Word → Bool
s-allowed pub (inl u) req = h-not pub
s-allowed pub (inr tok) req =
  andB (h-not (h-null tok))
    (orB (h-eq (um-header "x-token" req) tok)
         (h-eq (s-bearer-tok (um-header "authorization" req)) tok))

-- a public server with no token is read-only: no request changes the source (part of product-implementation)
s-public-read-only : (req : List Word) → Path Bool (s-allowed true (inl unit) req) false
s-public-read-only req = refl

-- lowercase x-token (as rewritten by HTTP/2 proxies) is accepted (part of product-implementation)
s-allowed-lower-xtoken : Path Bool (s-allowed true (inr "sec") (list-append "POST / HTTP/1.1" (list-append h-crlf (list-append "x-token: sec" (list-append h-crlf h-crlf))))) true
s-allowed-lower-xtoken = refl

-- Authorization: Bearer is accepted (part of product-implementation)
s-allowed-bearer : Path Bool (s-allowed true (inr "sec") (list-append "PUT /roots/x HTTP/1.1" (list-append h-crlf (list-append "Authorization: bearer sec" (list-append h-crlf h-crlf))))) true
s-allowed-bearer = refl

-- wrong tokens are rejected (part of product-implementation)
s-allowed-wrong : Path Bool (s-allowed true (inr "sec") (list-append "POST / HTTP/1.1" (list-append h-crlf (list-append "x-token: wrong" (list-append h-crlf h-crlf))))) false
s-allowed-wrong = refl

-- 64-character lowercase hex SHA-256 validator: prevents path traversal on /packs/<H> and /roots/<R>
s-is-hex : Word → Bool
s-is-hex c = orB (andB (wlt #47 c) (wlt c #58)) (andB (wlt #96 c) (wlt c #103))

s-all-hex : List Word → Bool
s-all-hex nil = true
s-all-hex (cons c r) = andB (s-is-hex c) (s-all-hex r)

s-hex64 : List Word → Bool
s-hex64 s = andB (weq (fromNat (list-length s)) #64) (s-all-hex s)

-- path traversal strings are rejected by s-hex64 (part of product-implementation)
s-hex64-traversal-rejected : Path Bool (s-hex64 "../etc/passwd") false
s-hex64-traversal-rejected = refl

-- valid 64-hex SHA-256 digest is accepted by s-hex64 (part of product-implementation)
s-hex64-valid : Path Bool (s-hex64 "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef") true
s-hex64-valid = refl

s-post : List Word → List Word → List Word → List Word → Proc W (List Word)
s-post st m path req =
  if h-prefix "/source/record?" path then s-change st m true (s-query path) (h-after (list-append h-crlf h-crlf) req) else
  if h-eq path "/hi/write" then hi-write st m (h-after (list-append h-crlf h-crlf) req) else
  if h-prefix "/source/unrecord?" path then s-change st m false (s-query path) nil else
  if h-prefix "/source/object" path then s-take m (s-query path) (h-after (list-append h-crlf h-crlf) req) else
  ret (s-respond "404 Not Found" "text/plain" "")

-- First-party ad-blocker-proof Umami Cloud proxy (2026-11-22)
um-hdr-clean-go : Nat → List Word → List Word
um-hdr-clean-go zero xs = nil
um-hdr-clean-go (suc k) nil = nil
um-hdr-clean-go (suc k) (cons b r) = if andB (wlt #31 b) (wlt b #127) then cons b (um-hdr-clean-go k r) else um-hdr-clean-go k r

um-hdr-clean : List Word → List Word
um-hdr-clean s = um-hdr-clean-go (toNat #512) s

um-ip-of : List Word → List Word → List Word
um-ip-of xff xri =
  if h-not (h-null xff) then h-trim (h-before "," xff) else
  if h-not (h-null xri) then h-trim xri else nil

um-ip : List Word → List Word
um-ip req = um-ip-of (um-header "x-forwarded-for" req) (um-header "x-real-ip" req)

um-replace-go : Nat → List Word → List Word → List Word → List Word
um-replace-go zero pat rep s = s
um-replace-go (suc k) pat rep nil = nil
um-replace-go (suc k) pat rep (cons x r) =
  if h-prefix pat (cons x r)
  then list-append rep (um-replace-go k pat rep (h-drop pat (cons x r)))
  else cons x (um-replace-go k pat rep r)

um-replace : List Word → List Word → List Word → List Word
um-replace pat rep s = um-replace-go (toNat #65536) pat rep s

um-js-resp : List Word → List Word
um-js-resp body = list-append (h-concat (cons "HTTP/1.1 200 OK" (cons h-crlf (cons "Content-Type: application/javascript; charset=utf-8" (cons h-crlf (cons "Content-Length: " (cons (h-decimal (fromNat (list-length body))) (cons h-crlf (cons "Cache-Control: public, max-age=86400" (cons h-crlf (cons s-sec-headers (cons "Connection: close" (cons h-crlf (cons h-crlf nil)))))))))))))) body

um-script-fetch : Proc W (List Word)
um-script-fetch =
  bind (h-capture (cons "/usr/bin/env" (cons "curl" (cons "-fs" (cons "--max-time" (cons "8" (cons "https://cloud.umami.is/script.js" nil))))))) (λ r →
  if andB (weq (fst r) #0) (h-not (h-null (snd r)))
  then bind (h-write "/tmp/hx-umami.js" (um-replace "/api/send" "/ev" (snd r))) (λ w → ret {lzero} {W} (um-js-resp (um-replace "/api/send" "/ev" (snd r))))
  else ret {lzero} {W} (s-respond "200 OK" "application/javascript; charset=utf-8" "/* umami unavailable */"))

um-script-or : Sum Unit (List Word) → Proc W (List Word)
um-script-or (inl u) = um-script-fetch
um-script-or (inr js) = if h-null js then um-script-fetch else ret {lzero} {W} (um-js-resp js)

um-script : Proc W (List Word)
um-script = bind (h-read "/tmp/hx-umami.js") um-script-or

um-send-path : List Word → Bool
um-send-path p =
  orB (h-eq (h-before "?" p) "/hx/ev") (
  orB (h-eq (h-before "?" p) "/hx/api/send")
      (h-eq (h-before "?" p) "/api/send"))

um-body-clean-go : Nat → List Word → List Word
um-body-clean-go zero xs = nil
um-body-clean-go (suc k) nil = nil
um-body-clean-go (suc k) (cons b r) = if weq b #0 then um-body-clean-go k r else cons b (um-body-clean-go k r)

um-body-clean : List Word → List Word
um-body-clean s = um-body-clean-go (toNat #16384) s

um-opt-hdr : List Word → List Word → List (List Word) → List (List Word)
um-opt-hdr name val rest = if h-null val then rest else cons "-H" (cons (list-append name (list-append ": " val)) rest)

um-send-args : List Word → List Word → List Word → List Word → List (List Word)
um-send-args ua ip cache body =
  cons "/usr/bin/env" (cons "curl" (cons "-s" (cons "--max-time" (cons "5" (cons "-X" (cons "POST" (cons "-H" (cons "Content-Type: application/json"
    (um-opt-hdr "User-Agent" ua (um-opt-hdr "X-Forwarded-For" ip (um-opt-hdr "x-umami-cache" cache
      (cons "--data-raw" (cons body (cons "https://gateway.umami.is/api/send" nil))))))))))))))

um-send-go : List Word → List Word → Proc W (List Word)
um-send-go req body =
  if orB (h-prefix "{" body) (h-prefix "[" body)
  then bind (h-capture (um-send-args (um-hdr-clean (um-header "user-agent" req)) (um-hdr-clean (um-ip req)) (um-hdr-clean (um-header "x-umami-cache" req)) body)) (λ r →
    if andB (weq (fst r) #0) (h-not (h-null (snd r)))
    then ret {lzero} {W} (s-response "application/json" (snd r))
    else ret {lzero} {W} (s-response "application/json" "{}"))
  else ret {lzero} {W} (s-respond "400 Bad Request" "application/json" "{}")

um-send : List Word → Proc W (List Word)
um-send req = um-send-go req (um-body-clean (h-after (list-append h-crlf h-crlf) req))

-- canonical public domain (e.g. "hyperactivity.ai")
s-canonical-host : List Word
