-- ---------------------------------------------------------------- decentralized pool place (/packs, /roots, /root, /bootstrap.tgz)
s-open-ro : List Word → Proc W Word
s-open-ro path =
  with-bytes {Word} (wadd (fromNat (list-length path)) #1) (λ p → bind (h-poke p path) (λ u →
  sys-call #257 #18446744073709551516 p #0 #0 #0 #0))

s-open-wr : List Word → Proc W Word
s-open-wr path =
  with-bytes {Word} (wadd (fromNat (list-length path)) #1) (λ p → bind (h-poke p path) (λ u →
  sys-call #257 #18446744073709551516 p #577 #420 #0 #0))

s-rename : List Word → List Word → Proc W Bool
s-rename old nw =
  with-bytes {Bool} (wadd (fromNat (list-length old)) #1) (λ p1 → bind (h-poke p1 old) (λ u1 →
  with-bytes {Bool} (wadd (fromNat (list-length nw)) #1) (λ p2 → bind (h-poke p2 nw) (λ u2 →
  bind (sys-call #82 p1 p2 #0 #0 #0 #0) (λ r → ret (weq r #0))))))

s-chdir : List Word → Proc W Bool
s-chdir dir =
  with-bytes {Bool} (wadd (fromNat (list-length dir)) #1) (λ p → bind (h-poke p dir) (λ u →
  bind (sys-call #80 p #0 #0 #0 #0 #0) (λ r → ret (weq r #0))))

s-load64 : Word → Proc W Word
s-load64 a =
  bind (load8-at a) (λ b0 → bind (load8-at (wadd a #1)) (λ b1 →
  bind (load8-at (wadd a #2)) (λ b2 → bind (load8-at (wadd a #3)) (λ b3 →
  bind (load8-at (wadd a #4)) (λ b4 → bind (load8-at (wadd a #5)) (λ b5 →
  bind (load8-at (wadd a #6)) (λ b6 → bind (load8-at (wadd a #7)) (λ b7 →
  ret (wadd b0 (wadd (wshl b1 #8) (wadd (wshl b2 #16) (wadd (wshl b3 #24)
    (wadd (wshl b4 #32) (wadd (wshl b5 #40) (wadd (wshl b6 #48) (wshl b7 #56))))))))))))))))

s-fd-size : Word → Proc W Word
s-fd-size fd = with-bytes {Word} #160 (λ stbuf →
  bind (sys-call #5 fd stbuf #0 #0 #0 #0) (λ r →
  if weq r #0 then s-load64 (wadd stbuf #48) else ret {lzero} {W} #0))

s-write-all-buf : Nat → Word → Word → Word → Proc W Bool
s-write-all-buf zero fd ptr rem = ret (weq rem #0)
s-write-all-buf (suc k) fd ptr rem =
  if weq rem #0 then ret {lzero} {W} true
  else bind (sys-call #1 fd ptr rem #0 #0 #0) (λ w →
    if orB (weq w #0) (wlt #9223372036854775807 w) then ret {lzero} {W} false
    else s-write-all-buf k fd (wadd ptr w) (wsub rem w))

s-pump-all : Nat → Word → Word → Word → Proc W Bool
s-pump-all zero src dst buf = ret true
s-pump-all (suc k) src dst buf =
  bind (sys-call #0 src buf #65536 #0 #0 #0) (λ n →
  if weq n #0 then ret {lzero} {W} true
  else if wlt #9223372036854775807 n then ret {lzero} {W} false
  else bind (s-write-all-buf (toNat #64) dst buf n) (λ ok →
    if ok then s-pump-all k src dst buf else ret {lzero} {W} false))

s-pump-exact : Nat → Word → Word → Word → Word → Proc W Bool
s-pump-exact zero src dst buf rem = ret (weq rem #0)
s-pump-exact (suc k) src dst buf rem =
  if weq rem #0 then ret {lzero} {W} true
  else let want = if wlt rem #65536 then rem else #65536 in
  bind (sys-call #0 src buf want #0 #0 #0) (λ n →
  if orB (weq n #0) (wlt #9223372036854775807 n) then ret {lzero} {W} false
  else bind (s-write-all-buf (toNat #64) dst buf n) (λ ok →
    if ok then s-pump-exact k src dst buf (wsub rem n) else ret {lzero} {W} false))

s-head : List Word → List (List Word) → List Word
s-head d nil = d
s-head d (cons x r) = x

s-disp-hdr : List Word → List Word
s-disp-hdr disp = if h-null disp then nil else list-append "Content-Disposition: " (list-append disp h-crlf)

-- stream a binary file on disk to socket c using one 64 KiB buffer (zero cons cells)
s-stream-file : Word → List Word → List Word → List Word → Proc W Unit
s-stream-file c path ctype disp =
  bind (s-open-ro path) (λ ffd →
  if wlt #9223372036854775807 ffd
  then bind (fd-write c (s-respond "404 Not Found" "text/plain" "not found")) (λ w → ret {lzero} {W} unit)
  else bind (s-fd-size ffd) (λ sz →
    let dhdr = s-disp-hdr disp in
    let hdr = h-concat (cons "HTTP/1.1 200 OK" (cons h-crlf (cons "Content-Type: " (cons ctype (cons h-crlf (cons dhdr (cons "Content-Length: " (cons (h-decimal sz) (cons h-crlf (cons "Cache-Control: public, max-age=3600" (cons h-crlf (cons "Connection: close" (cons h-crlf (cons h-crlf nil)))))))))))))) in
    bind (fd-write c hdr) (λ w0 →
    bind (with-bytes {Bool} #65536 (λ buf → s-pump-all (toNat #1048576) ffd c buf)) (λ ok →
    bind (sys-call #3 ffd #0 #0 #0 #0 #0) (λ cl → ret {lzero} {W} unit)))))

-- stream PUT /packs/<SHA256> directly to disk in a 64 KiB buffer, verify SHA-256 == <SHA256> (ca-check), then atomic rename
s-put-pack : Bool → Sum Unit (List Word) → Word → List Word → List Word → Proc W Unit
s-put-pack pub tok c h hdr =
  if h-not (s-allowed pub tok hdr)
  then bind (fd-write c (s-respond "403 Forbidden" "text/plain" "this server is read-only")) (λ w → ret {lzero} {W} unit)
  else if h-not (s-hex64 h)
  then bind (fd-write c (s-respond "400 Bad Request" "text/plain" "invalid pack sha256")) (λ w → ret {lzero} {W} unit)
  else bind (h-mkdir "packs") (λ md →
    bind (if h-infix "100-continue" (sx-lower (um-header "expect" hdr))
          then fd-write c (list-append "HTTP/1.1 100 Continue" (list-append h-crlf h-crlf))
          else ret {lzero} {W} #0) (λ cont →
    bind (sys-call #39 #0 #0 #0 #0 #0 #0) (λ pid →
    let tmp = list-append "packs/.tmp-" (list-append (h-decimal pid) (cons #45 h)) in
    let dst = list-append "packs/" h in
    let clen = h-number (um-header "content-length" hdr) in
    bind (s-open-wr tmp) (λ ffd →
    if wlt #9223372036854775807 ffd
    then bind (fd-write c (s-respond "500 Internal Server Error" "text/plain" "cannot write pack")) (λ w → ret {lzero} {W} unit)
    else bind (with-bytes {Bool} #65536 (λ buf → s-pump-exact (toNat #1048576) c ffd buf clen)) (λ pumped →
      bind (sys-call #3 ffd #0 #0 #0 #0 #0) (λ cl →
      if h-not pumped
      then bind (h-unlink tmp) (λ u → bind (fd-write c (s-respond "400 Bad Request" "text/plain" "incomplete pack body")) (λ w → ret {lzero} {W} unit))
      else bind (h-capture (cons "/usr/bin/env" (cons "sha256sum" (cons tmp nil)))) (λ sh →
        let got = s-head nil (h-split #32 (snd sh)) in
        if andB (weq (fst sh) #0) (h-eq got h)
        then bind (s-rename tmp dst) (λ rn →
          bind (fd-write c (if rn then s-response "text/plain" (h-line h) else s-respond "500 Internal Server Error" "text/plain" "rename failed")) (λ w → ret {lzero} {W} unit))
        else bind (h-unlink tmp) (λ u →
          bind (fd-write c (s-respond "400 Bad Request" "text/plain" "pack sha256 mismatch")) (λ w → ret {lzero} {W} unit)))))))))

s-root-get : List Word → Proc W (List Word)
s-root-get m = bind (h-read "root") (λ r → case r of
  inr t → ret {lzero} {W} (s-response "text/plain" (h-line (h-trim (h-before (cons #10 nil) t))))
