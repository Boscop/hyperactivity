hi-page : List Word → List Word → Bool → List (List Word) → List (List Word) → List Word → List Word → List Word
hi-page rd f far path os ab sc = s-chrome-html (list-append f " · Workflow") (h-concat (cons "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>" (cons (s-esc f) (cons "</title>" (cons hi-style (cons "</head><body><!--HX:NAV--><main><div class='bar'>" (cons (s-esc rd) (cons ": " (cons (h-concat (list-map (λ p → list-append (hi-a rd p p) " → ") (hi-recent path))) (cons "<span id='hi-present'>" (cons (hi-present os) (cons "</span> · <a href='/graph'>DAG (/graph)</a> · <a href='" (cons (s-esc (list-append (hi-href rd f) (if far then nil else "&radius=2"))) (cons (if far then "'>radius 1</a>" else "'>radius 2</a>") (cons "</div><form method='get' action='/hi'><input type='hidden' name='reader' value='" (cons (s-esc rd) (cons "'><input name='focus' placeholder='any name, node or document path' size='34'> <button>go</button></form>" (cons sc (cons "<div id='hi-written'>" (cons (hi-written ab) (cons "</div>" (cons "<form method='post' action='/hi/write'><input type='hidden' name='reader' value='" (cons (s-esc rd) (cons "'><input type='hidden' name='focus' value='" (cons (s-esc f) (cons "'><select name='kind'>" (cons hi-options (cons "</select><textarea name='text' rows='3' placeholder='a question, an asserted equivalence, a warrant or a witness, at this focus'></textarea><button>write</button></form></main>" (cons hi-script (cons "</body></html>" nil)))))))))))))))))))))))))))))))
-- GET /hi/events: the focus's presence and what is written there, as server-sent events; the server
-- holds no connection, so it tells the page to ask again in two seconds (retry), and each answer is
-- the state at that moment
hi-events : List Word → List Word → Proc W (List Word)
hi-events st q = bind (hi-others st (hi-reader q) (hi-focus q)) (λ os → bind (hi-about (hi-focus q)) (λ ab →
  ret (s-respond "200 OK" "text/event-stream" (h-concat (cons "retry: 30000" (cons (cons #10 (cons #10 nil)) (cons (hi-event "presence" (hi-present os)) (cons (hi-event "written" (hi-written ab)) nil))))))))
-- read up to n active entries from dir/<id> into JSON [id,val] pairs
s-live-read : Nat → List Word → List (List Word) → Proc W (List (List Word))
s-live-read zero dir xs = ret {lzero} {W} nil
s-live-read (suc n) dir nil = ret {lzero} {W} nil
s-live-read (suc n) dir (cons id rest) =
  bind (h-read (list-append dir (list-append "/" id))) (λ v →
  bind (s-live-read n dir rest) (λ more →
    if h-null (s-or nil v) then ret {lzero} {W} more
    else ret {lzero} {W} (cons (h-concat (cons "[" (cons (s-cj-str id) (cons "," (cons (s-cj-str (s-or nil v)) (cons "]" nil)))))) more)))
-- GET /api/live/pulse?id=<anon>&node=<path> : stateless O(1) presence beacon (zero open sockets)
s-live-pulse : List Word → List Word → Proc W (List Word)
s-live-pulse st q =
  bind (h-mkdir (list-append st "/live")) (λ mk →
  bind (if h-null (hi-clean (s-param "id" q)) then ret {lzero} {W} false
        else h-write (list-append st (list-append "/live/" (hi-clean (s-param "id" q)))) (s-unescape (s-param "node" q))) (λ wr →
  bind (h-list (list-append st "/live")) (λ ids →
  bind (s-live-read 48 (list-append st "/live") ids) (λ items →
    ret {lzero} {W} (s-response "application/json" (h-concat (cons "{" (cons (s-cj-str "live") (cons ":[" (cons (s-commas items) (cons "]}" nil)))))))))))
-- GET /api/p2p/signal?id=<peer>&msg=<sdp> : stateless WebRTC rendezvous mailbox (zero media/compute on server)
s-p2p-signal : List Word → List Word → Proc W (List Word)
s-p2p-signal st q =
  bind (h-mkdir (list-append st "/p2p")) (λ mk →
  bind (if h-null (hi-clean (s-param "id" q)) then ret {lzero} {W} false
        else if h-null (s-param "msg" q) then ret {lzero} {W} false
        else h-write (list-append st (list-append "/p2p/" (hi-clean (s-param "id" q)))) (s-unescape (s-param "msg" q))) (λ wr →
  bind (h-list (list-append st "/p2p")) (λ ids →
  bind (s-live-read 24 (list-append st "/p2p") ids) (λ items →
    ret {lzero} {W} (s-response "application/json" (h-concat (cons "{" (cons (s-cj-str "peers") (cons ":[" (cons (s-commas items) (cons "]}" nil)))))))))))
-- the text of one version: a piece's text, or a module's (a document's) pieces joined
hi-or-module : List Word → Sum Unit (List Word) → Proc W (Sum Unit (List Word))
hi-or-module h (inr t) = ret (inr t)
hi-or-module h (inl u) = h-source-module (inr h)
hi-version-text : List Word → Proc W (Sum Unit (List Word))
hi-version-text h = bind (h-read (list-append h-source (cons #47 (list-append h "/text")))) (hi-or-module h)
-- a line of the versions record names the version's object, then its time
hi-ver-hash : h-before " " "a4852f 1794951994" ≡ "a4852f"
hi-ver-hash = refl
hi-ver : List Word → Proc W (List Word)
hi-ver l = bind (hi-version-text (h-before " " l)) (λ t → ret (h-concat (cons "<pre class='ver' data-t='" (cons (s-esc (h-after " " l)) (cons "'>" (cons (s-esc (s-or nil t)) (cons "</pre>" nil)))))))
hi-scrub : List Word
hi-scrub = "<script>(function(){var vs=[].slice.call(document.querySelectorAll('#hi-versions .ver')),r=document.getElementById('hi-t'),w=document.getElementById('hi-when');if(!vs.length)return;r.max=vs.length-1;r.value=vs.length-1;function show(i){vs.forEach(function(v,j){v.style.display=(j==i)?'':'none'});w.textContent='version '+(+i+1)+' of '+vs.length+', '+new Date(vs[i].dataset.t*1000).toISOString().replace('T',' ').slice(0,19)+' UTC'}r.oninput=function(){if(document.startViewTransition)document.startViewTransition(function(){show(r.value)});else show(r.value)};show(r.value)})()</script>"
-- the focus through time: its last eight versions from the store's versions record, scrubbed by a slider
hi-history : List Word → Proc W (List Word)
hi-history f = bind (h-read (list-append h-source (list-append "/versions/" (h-hex f)))) (λ v →
  bind (hi-each (hi-recent (h-lines (s-or nil v))) hi-ver) (λ vs →
  ret (if h-null vs then nil else hi-sect "through time" (h-concat (cons "<div style='width:100%'><input type='range' id='hi-t' min='0' value='0' style='width:100%'><div class='who' id='hi-when'></div><div id='hi-versions'>" (cons vs (cons "</div></div>" (cons hi-scrub nil))))))))
hi-hd : List Nat → Nat
hi-hd nil = zero
hi-hd (cons x r) = x
hi-tl : List Nat → List Nat
hi-tl nil = nil
hi-tl (cons x r) = r
hi-hd-row : List (List Nat) → List Nat
hi-hd-row nil = nil
hi-hd-row (cons x r) = x
hi-tl-rows : List (List Nat) → List (List Nat)
hi-tl-rows nil = nil
hi-tl-rows (cons x r) = r
hi-max : Nat → Nat → Nat
hi-max a b = if wlt (fromNat a) (fromNat b) then b else a
hi-zeros : List (List Word) → List Nat
hi-zeros nil = cons zero nil
hi-zeros (cons x r) = cons zero (hi-zeros r)
hi-cell : List Word → List Word → List Nat → List Nat → List Nat
hi-cell ai bj next rest = cons (if h-eq ai bj then suc (hi-hd (hi-tl next)) else hi-max (hi-hd next) (hi-hd rest)) rest
-- one row of the longest-common-subsequence table: the lengths for word ai's suffix against each suffix of b
hi-row : List Word → List (List Word) → List Nat → List Nat
hi-row ai nil next = cons zero nil
hi-row ai (cons bj bs) next = hi-cell ai bj next (hi-row ai bs (hi-tl next))
hi-table-on : List Word → List (List Word) → List (List Nat) → List (List Nat)
hi-table-on ai b rows = cons (hi-row ai b (hi-hd-row rows)) rows
-- the table: for every suffix of a and of b, the length of their longest common subsequence
hi-table : List (List Word) → List (List Word) → List (List Nat)
hi-table nil b = cons (hi-zeros b) nil
hi-table (cons ai as) b = hi-table-on ai b (hi-table as b)
-- the alignment of two texts along their longest common subsequence: each word kept (=), only in the
-- first (-) or only in the second (+); each step uses up one word, so the steps are counted by the two
-- lengths together
hi-align : Nat → List (List Word) → List (List Word) → List (List Nat) → List (List Word × List Word)
hi-align zero a b t = nil
hi-align (suc n) nil b t = list-map (λ w → ("+" , w)) b
hi-align (suc n) (cons x as) nil t = list-map (λ w → ("-" , w)) (cons x as)
hi-align (suc n) (cons x as) (cons y bs) t = if h-eq x y then cons ("=" , x) (hi-align n as bs (list-map hi-tl (hi-tl-rows t)))
  else if wlt (fromNat (hi-hd (hi-hd-row (hi-tl-rows t)))) (fromNat (hi-hd (hi-tl (hi-hd-row t)))) then cons ("+" , y) (hi-align n (cons x as) bs (list-map hi-tl t))
  else cons ("-" , x) (hi-align n as (cons y bs) (hi-tl-rows t))
hi-aligned : List Word → List Word → List (List Word × List Word)
hi-aligned a b = hi-align (suc (list-length (list-append (h-split #32 a) (h-split #32 b)))) (h-split #32 a) (h-split #32 b) (hi-table (h-split #32 a) (h-split #32 b))
hi-align-example : hi-aligned "a b c" "a x c" ≡ cons ("=" , "a") (cons ("-" , "b") (cons ("+" , "x") (cons ("=" , "c") nil)))
hi-align-example = refl
-- a side of the alignment: the words the first text (not +) or the second (not -) keeps
hi-side : List Word → List (List Word × List Word) → List (List Word)
hi-side x nil = nil
hi-side x (cons e r) = if h-eq (fst e) x then hi-side x r else cons (snd e) (hi-side x r)
-- the alignment loses neither text: each side, read off it, is that text's words
hi-align-whole : hi-side "+" (hi-aligned "the many sided doctrine" "the doctrine of many sides") ≡ h-split #32 "the many sided doctrine"
hi-align-whole = refl
hi-align-whole-b : hi-side "-" (hi-aligned "the many sided doctrine" "the doctrine of many sides") ≡ h-split #32 "the doctrine of many sides"
hi-align-whole-b = refl
-- one side drawn: each kept word carries the name it shares with its place in the other side, so the
-- change between them is one interpolation in which the kept words move and the others fade
hi-mside : List Word → List Word → Nat → List (List Word × List Word) → List Word
hi-mside x p k nil = nil
hi-mside x p k (cons e r) = list-append (if h-eq (fst e) x then nil else h-concat (cons "<span class='w" (cons (if h-eq (fst e) "=" then "' style='view-transition-name:" else "' style='opacity:.75;color:#ffd479'>") (cons (if h-eq (fst e) "=" then list-append p (list-append (h-decimal (fromNat k)) "'>") else nil) (cons (s-esc (snd e)) (cons "</span> " nil)))))) (hi-mside x p (suc k) r)
hi-morph-js : List Word
hi-morph-js = "<script>[].forEach.call(document.querySelectorAll('.morph'),function(m){var a=m.querySelector('.ma'),c=m.querySelector('.mb');m.querySelector('.mt').onclick=function(){var f=function(){var s=a.style.display=='none';a.style.display=s?'':'none';c.style.display=s?'none':''};if(document.startViewTransition)document.startViewTransition(f);else f()}})</script>"
-- what each statement says: a node's sentence, else the text itself
hi-says : List Word → List Word → Proc W (List Word)
hi-says st x = bind (hi-show st x) (λ s → ret (if h-null (hi-sentence s) then x else hi-sentence s))
hi-morph : List Word → List Word → List Word → List Word → Proc W (List Word)
hi-morph st rd f o = bind (hi-says st f) (λ a → bind (hi-says st o) (λ b → bind (hi-link rd o) (λ ol →
  ret (h-concat (cons "<div class='morph card' style='max-width:none;width:100%'><div class='who'>asserted equivalent: " (cons ol (cons "</div><div class='ma'>" (cons (hi-mside "+" (list-append "m" (h-hex o)) zero (hi-aligned a b)) (cons "</div><div class='mb' style='display:none'>" (cons (hi-mside "-" (list-append "m" (h-hex o)) zero (hi-aligned a b)) (cons "</div><button class='mt'>morph</button></div>" nil)))))))))))
-- the statements asserted equivalent to the focus: every equivalence any reader has written at it
hi-eq-texts : List Word → List (List Word) → List (List Word)
hi-eq-texts f nil = nil
hi-eq-texts f (cons l r) = if h-prefix (h-concat (cons "- equivalence at " (cons f (cons ": " nil)))) l then cons (h-drop (h-concat (cons "- equivalence at " (cons f (cons ": " nil)))) l) (hi-eq-texts f r) else hi-eq-texts f r
hi-gather : List (List Word) → List Word → Proc W (List (List Word))
hi-gather nil f = ret nil
hi-gather (cons p r) f = bind (h-document p) (λ d → bind (hi-gather r f) (λ rest → ret (list-append (hi-eq-texts f (h-lines (s-or nil d))) rest)))
hi-equivalents : List Word → Proc W (List (List Word))
hi-equivalents f = bind hi-reader-paths (λ ps → hi-gather ps f)
-- the focus beside each statement asserted equivalent to it, each one morph away
hi-morphs : List Word → List Word → List Word → Proc W (List Word)
hi-morphs st rd f = bind (hi-equivalents f) (λ es → bind (hi-each (h-dedupe es) (hi-morph st rd f)) (λ ms →
  ret (if h-null ms then nil else list-append (hi-sect "equivalent" ms) hi-morph-js)))
-- the same focus as the field and as the room
hi-lens : List Word → List Word → List Word
hi-lens rd f = h-concat (cons "<p class='lens'><a href='/hi/field?reader=" (cons (hi-url rd) (cons "&amp;focus=" (cons (hi-url f) (cons "'>the field</a> · <a href='/hi/room?reader=" (cons (hi-url rd) (cons "&amp;focus=" (cons (hi-url f) (cons "'>the room</a></p>" nil)))))))))
-- GET /hi: the focus added to the reader's path walked when writable (or read without writing on public GET), then the page
hi-view-as : Bool → List Word → List Word → Proc W (List Word)
hi-view-as wr st q = bind (h-read (list-append st "/views/nodes")) (λ nv →
  bind (hi-walk-as wr st (hi-reader q) (hi-focus q)) (λ path →
  bind (hi-others st (hi-reader q) (hi-focus q)) (λ os →
  bind (hi-about (hi-focus q)) (λ ab →
  bind (hi-scene st (hi-reader q) (hi-focus q) (h-eq (s-param "radius" q) "2") (hi-rows (s-or nil nv))) (λ sc →
  bind (hi-history (hi-focus q)) (λ hs → bind (hi-morphs st (hi-reader q) (hi-focus q)) (λ ms →
  ret (s-response s-html (hi-page (hi-reader q) (hi-focus q) (h-eq (s-param "radius" q) "2") path os ab (h-concat (cons (hi-lens (hi-reader q) (hi-focus q)) (cons sc (cons ms (cons hs nil))))))))))))))
hi-view : List Word → List Word → Proc W (List Word)
hi-view st q = hi-view-as true st q
-- the field (human-interface, item 4): the scene as data, computed in hyperactive on the server ("neighbourhood,
-- layout, field and interpolation targets computed in hyperactive on the server; the browser a thin WebGPU renderer
-- that draws and sends gestures"). 32 points of the circle, each coordinate scaled by 1000 and shifted by 1000 (so
-- in [0, 2000]), from the top, clockwise on the screen
hi-circle : List (Word × Word)
hi-circle = (cons (#1000 , #0) (cons (#1195 , #19) (cons (#1383 , #76) (cons (#1556 , #169) (cons (#1707 , #293) (cons (#1831 , #444) (cons (#1924 , #617) (cons (#1981 , #805) (cons (#2000 , #1000) (cons (#1981 , #1195) (cons (#1924 , #1383) (cons (#1831 , #1556) (cons (#1707 , #1707) (cons (#1556 , #1831) (cons (#1383 , #1924) (cons (#1195 , #1981) (cons (#1000 , #2000) (cons (#805 , #1981) (cons (#617 , #1924) (cons (#444 , #1831) (cons (#293 , #1707) (cons (#169 , #1556) (cons (#76 , #1383) (cons (#19 , #1195) (cons (#0 , #1000) (cons (#19 , #805) (cons (#76 , #617) (cons (#169 , #444) (cons (#293 , #293) (cons (#444 , #169) (cons (#617 , #76) (cons (#805 , #19) nil))))))))))))))))))))))))))))))))
hi-at-slot : List (Word × Word) → Word → Word × Word
hi-at-slot nil k = (#1000 , #1000)
hi-at-slot (cons p r) k = if weq k #0 then p else hi-at-slot r (wsub k #1)
-- a coordinate of the circle drawn at radius R (R at most 1000) about the centre 1000: no step goes below zero
hi-scale : Word → Word → Word
hi-scale rr c = wquot (wsub (wadd #1000000 (wmul rr c)) (wmul rr #1000)) #1000
hi-place : Word → Word → Word × Word
hi-place rr k = (hi-scale rr (fst (hi-at-slot hi-circle k)) , hi-scale rr (snd (hi-at-slot hi-circle k)))
hi-count : List (List Word) → Word
hi-count nil = #0
hi-count (cons x r) = wadd #1 (hi-count r)
-- the slot of the i-th of n nodes on a ring (i below n, so the slot below 32), the n spread evenly over the 32 points
hi-slot : Word → Word → Word
hi-slot n i = wquot (wmul i #32) (if weq n #0 then #1 else n)
-- every point of the circle lies in the square [0, 2000]
hi-in-box : List (Word × Word) → Bool
hi-in-box nil = true
hi-in-box (cons p r) = andB (wlt (fst p) #2001) (andB (wlt (snd p) #2001) (hi-in-box r))
hi-circle-in-box : hi-in-box hi-circle ≡ true
hi-circle-in-box = refl
-- a ring of radius R stays within [1000 - R, 1000 + R] on both axes, for every slot
hi-within : Word → Word → Word → Bool
hi-within rr c i = andB (h-not (wlt (fst (hi-place rr i)) (wsub #1000 rr))) (andB (wlt (fst (hi-place rr i)) (wadd #1001 rr))
  (andB (h-not (wlt (snd (hi-place rr i)) (wsub #1000 rr))) (wlt (snd (hi-place rr i)) (wadd #1001 rr))))
-- the words 0 to 32
hi-upto-32 : List Word
hi-upto-32 = (cons #0 (cons #1 (cons #2 (cons #3 (cons #4 (cons #5 (cons #6 (cons #7 (cons #8 (cons #9 (cons #10 (cons #11 (cons #12 (cons #13 (cons #14 (cons #15 (cons #16 (cons #17 (cons #18 (cons #19 (cons #20 (cons #21 (cons #22 (cons #23 (cons #24 (cons #25 (cons #26 (cons #27 (cons #28 (cons #29 (cons #30 (cons #31 (cons #32 nil)))))))))))))))))))))))))))))))))
hi-ring-within : Word → List Word → Bool
hi-ring-within rr nil = true
hi-ring-within rr (cons i r) = andB (orB (weq i #32) (hi-within rr #0 i)) (hi-ring-within rr r)
hi-near-ring-within : hi-ring-within #380 hi-upto-32 ≡ true
hi-near-ring-within = refl
hi-far-ring-within : hi-ring-within #760 hi-upto-32 ≡ true
hi-far-ring-within = refl
-- n nodes (n at most 32) take n distinct slots: no two nodes of a ring are drawn at one point
hi-slots : Word → List Word → List Word
hi-slots n nil = nil
hi-slots n (cons i r) = if wlt i n then cons (hi-slot n i) (hi-slots n r) else hi-slots n r
hi-has-w : Word → List Word → Bool
hi-has-w x nil = false
hi-has-w x (cons y r) = orB (weq x y) (hi-has-w x r)
hi-distinct : List Word → Bool
hi-distinct nil = true
hi-distinct (cons x r) = andB (h-not (hi-has-w x r)) (hi-distinct r)
hi-all-distinct : List Word → Bool
hi-all-distinct nil = true
hi-all-distinct (cons n r) = andB (hi-distinct (hi-slots n hi-upto-32)) (hi-all-distinct r)
hi-slots-distinct : hi-all-distinct hi-upto-32 ≡ true
hi-slots-distinct = refl
-- which side of the focus a node of the first ring stands on: what the focus is part of above, what serves it below
hi-h : List (List (List Word)) → List Word → List Word → List Word
hi-h rows f m = if h-has m (hi-parents rows f) then "1" else "-1"
-- a node of the second ring stands on the side of the first node of the first ring it neighbours
hi-h2 : List (List (List Word)) → List Word → List (List Word) → List Word → List Word
hi-h2 rows f nil n = "0"
hi-h2 rows f (cons m r) n = if h-has n (hi-around rows m) then hi-h rows f m else hi-h2 rows f r n
hi-ring1 : List (List (List Word)) → List Word → List (List Word)
hi-ring1 rows f = hi-outside (cons f nil) (h-dedupe (hi-around rows f))
hi-ring2 : List (List (List Word)) → List Word → List (List Word) → List (List Word)
hi-ring2 rows f r1 = hi-outside (cons f r1) (h-dedupe (h-concat-lists (list-map (hi-around rows) r1)))
-- how many of the list are n
hi-occ : List (List Word) → List Word → Word
hi-occ nil n = #0
hi-occ (cons x r) n = if h-eq x n then wadd #1 (hi-occ r n) else hi-occ r n
hi-q : List Word
hi-q = cons #34 nil
hi-key : List Word → List Word
hi-key k = h-concat (cons hi-q (cons k (cons hi-q (cons ":" nil))))
hi-commas : List (List Word) → List Word
hi-commas nil = nil
hi-commas (cons x nil) = x
hi-commas (cons x (cons y r)) = list-append x (list-append "," (hi-commas (cons y r)))
-- one node of the scene: its place, its side (h), its ring, and the field over it (readers here, open or resolved)
hi-jnode : List Word → Word × Word → List Word → Word → Word → Bool → List Word
hi-jnode n p h ring rd op = h-concat (cons "{" (cons (hi-key "id") (cons (s-json-str n) (cons "," (cons (hi-key "x") (cons (h-decimal (fst p))
  (cons "," (cons (hi-key "y") (cons (h-decimal (snd p)) (cons "," (cons (hi-key "h") (cons h (cons "," (cons (hi-key "ring") (cons (h-decimal ring)
  (cons "," (cons (hi-key "readers") (cons (h-decimal rd) (cons "," (cons (hi-key "open") (cons (if op then "1" else "0") (cons "}" nil))))))))))))))))))))))
hi-jring : List (List (List Word)) → List Word → List (List Word) → List (List Word) → List (List Word) → Word → Word → Word → Word → List (List Word) → List (List Word)
hi-jring rows f r1 la op rr ring n i nil = nil
hi-jring rows f r1 la op rr ring n i (cons x r) = cons (hi-jnode x (hi-place rr (hi-slot n i)) (if weq ring #1 then hi-h rows f x else hi-h2 rows f r1 x) ring (hi-occ la x) (h-has x op))
  (hi-jring rows f r1 la op rr ring n (wadd i #1) r)
hi-jedges-of : List (List Word) → List Word → List (List Word) → List (List Word)
hi-jedges-of sc n nil = nil
hi-jedges-of sc n (cons p r) = if h-has p sc then cons (h-concat (cons "[" (cons (s-json-str n) (cons "," (cons (s-json-str p) (cons "]" nil)))))) (hi-jedges-of sc n r) else hi-jedges-of sc n r
-- the edges among the scene's nodes: each node to what it is part of
hi-jedges : List (List Word) → List (List (List Word)) → List (List Word)
hi-jedges sc nil = nil
hi-jedges sc (cons row r) = if h-has (hi-first row) sc then list-append (hi-jedges-of sc (hi-first row) (h-tail-lists row)) (hi-jedges sc r) else hi-jedges sc r
-- the scene's nodes: the focus, the first ring and the second
hi-names : List Word → List (List Word) → List (List Word) → List (List Word)
hi-names f r1 r2 = cons f (list-append r1 r2)
