-- ---------------------------------------------------------------- soundness of the normal form
-- an insertion adds c·x to the value: by induction on the list; the three branches are lemmas
ins-lt : (e : Env) (v c : Word) (ds : Coefs) → csem e (ccons v c ds) ≡ plusw (mulw c (e v)) (csem e ds)
ins-lt e v c ds = λ i → plusw (mulw c (e v)) (csem e ds)
