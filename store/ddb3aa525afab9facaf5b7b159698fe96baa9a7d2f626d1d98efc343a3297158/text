wl-m3 : List Word → List Word
wl-m3 tail =
  hw-ln "// Exp 3: ATP-Driven Bioenergetic Peptide Synthesis (65,536 physiological/wet-lab flasks)"
  (hw-ln "// ATP + Gly + Ala <-> ADP + Pi + Gly-Ala  [dG0_pep=+12.6, dG0_ATP=-30.5 -> dG0_net=-17.9 kJ/mol]"
  (hw-ln "kernel void wl_atp_peptide_flasks("
  (hw-ln "  device float* out_pep_yield [[buffer(0)]],"
  (hw-ln "  device float* out_5elem_err [[buffer(1)]],"
  (hw-ln "  uint tid [[thread_position_in_grid]]) {"
  (hw-ln "  // 64 temps (285..348K) x 32 ATP:ADP ratios x 32 pH (5.5..8.6)"
  (hw-ln "  float T   = 285.0f + (float)(tid & 63u);"
  (hw-ln "  float atp = 0.5f + 0.5f * (float)((tid >> 6u) & 31u);"
  (hw-ln "  float pH  = 5.5f + 0.1f * (float)(tid >> 11u);"
  (hw-ln "  float RT  = 8.3144626e-3f * T;"
  (hw-ln "  // pH-dependent ATP hydrolysis shift (H+ release favors higher pH: -RT*ln(10)*(pH-7))"
  (hw-ln "  float dG0 = -17.9f - 2.302585f * RT * (pH - 7.0f);"
  (hw-ln "  float Keq = exp(-dG0 / RT);"
  (hw-ln "  float gly = 1.0f, ala = 1.0f, adp = 0.1f, pi = 0.1f, pep = 0.0f;"
  (hw-ln "  float C0 = 10.0f*atp + 2.0f*gly + 3.0f*ala + 10.0f*adp + 5.0f*pep;"
  (hw-ln "  float H0 = 16.0f*atp + 5.0f*gly + 7.0f*ala + 15.0f*adp + 3.0f*pi + 10.0f*pep;"
  (hw-ln "  float N0 = 5.0f*atp + 1.0f*gly + 1.0f*ala + 5.0f*adp + 2.0f*pep;"
  (hw-ln "  float O0 = 13.0f*atp + 2.0f*gly + 2.0f*ala + 10.0f*adp + 4.0f*pi + 3.0f*pep;"
  (hw-ln "  float P0 = 3.0f*atp + 2.0f*adp + 1.0f*pi;"
  (hw-ln "  // Exact bisection on stoichiometric extent xi in [0, min(atp,gly,ala)] for exact Gibbs equilibrium!"
  (hw-ln "  float lo = 0.0f, hi = min(atp, min(gly, ala));"
  (hw-ln "  for (int it = 0; it < 28; it++) {"
  (hw-ln "    float xi = 0.5f * (lo + hi);"
  (hw-ln "    float num = (adp + xi) * (pi + xi) * (pep + xi);"
  (hw-ln "    float den = (atp - xi) * (gly - xi) * (ala - xi);"
  (hw-ln "    if (num < Keq * den) lo = xi; else hi = xi;"
  (hw-ln "  }"
  (hw-ln "  float xi = 0.5f * (lo + hi);"
  (hw-ln "  atp -= xi; gly -= xi; ala -= xi; adp += xi; pi += xi; pep += xi;"
  (hw-ln "  float C1 = 10.0f*atp + 2.0f*gly + 3.0f*ala + 10.0f*adp + 5.0f*pep;"
  (hw-ln "  float H1 = 16.0f*atp + 5.0f*gly + 7.0f*ala + 15.0f*adp + 3.0f*pi + 10.0f*pep;"
  (hw-ln "  float N1 = 5.0f*atp + 1.0f*gly + 1.0f*ala + 5.0f*adp + 2.0f*pep;"
  (hw-ln "  float O1 = 13.0f*atp + 2.0f*gly + 2.0f*ala + 10.0f*adp + 4.0f*pi + 3.0f*pep;"
  (hw-ln "  float P1 = 3.0f*atp + 2.0f*adp + 1.0f*pi;"
  (hw-ln "  out_pep_yield[tid] = pep;"
  (hw-ln "  out_5elem_err[tid] = fabs(C1-C0)+fabs(H1-H0)+fabs(N1-N0)+fabs(O1-O0)+fabs(P1-P0);"
  (hw-ln "}"
  (hw-ln nil tail))))))))))))))))))))))))))))))))))))))
