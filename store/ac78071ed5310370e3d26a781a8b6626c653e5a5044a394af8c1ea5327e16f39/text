-- the molecule as a tree: each atom's neighbour towards the carboxyl carbon, which is its own
vln-par : Vln → Vln
vln-par x = case x of
  vl-c1 → vl-c1
  vl-o1 → vl-c1
  vl-o2 → vl-c1
  vl-ho → vl-o2
  vl-ca → vl-c1
  vl-ha → vl-ca
  vl-n → vl-ca
  vl-hn1 → vl-n
  vl-hn2 → vl-n
  vl-cb → vl-ca
  vl-hb → vl-cb
  vl-cg1 → vl-cb
  vl-g11 → vl-cg1
  vl-g12 → vl-cg1
  vl-g13 → vl-cg1
  vl-cg2 → vl-cb
  vl-g21 → vl-cg2
  vl-g22 → vl-cg2
  vl-g23 → vl-cg2
