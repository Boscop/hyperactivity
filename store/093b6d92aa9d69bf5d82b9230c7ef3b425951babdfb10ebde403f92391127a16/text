-- the entries of page w in lang (a word form taken to its lemma), those with an etymology first, the
-- exact capitalisation first; found by the page's key
e-entries-here : List Word → List Word → Sum Unit (List Word) → Proc W (List ERow)
e-entries-here l w ex = bind (e-make-index l) (λ u → bind (e-key-of w) (λ k → bind (e-lines-of (e-index l) k) (λ ls →
  if h-not (h-null (h-concat ls)) then bind (e-rows-of l ls) (λ rows → ret {lzero} {W} (e-sort-rows w (e-exact ex rows)))
  else bind (e-lemma l k) (λ lk → if h-null lk then ret {lzero} {W} nil else
    bind (e-lines-of (e-index l) lk) (λ ls2 → bind (e-rows-of l ls2) (λ rows → ret {lzero} {W} (e-sort-rows w (e-exact ex rows))))))))
