                   the (MS (Bool × ZI))
                     (let err_no : ZI
                          err_no = (page_fault_err_no page_present_var r_w_x cpl (bits_of_int rsvd (zpos #1)) smep #1 nxe)
                      in page_fault_exception lin_addr err_no) σ
