cs-for-t1-dl : (d : Word) (tl : List Word) → cs-for-t1 d tl ≡ list-append (cs-for-t1 d nil) tl
cs-for-t1-dl d tl =
  cs-dl-comp (list-append "; uint64_t v") (λ x → list-append (ce-dec (%wsucc d)) (list-append " = " x))
    (cs-dl-lit "; uint64_t v")
    (cs-dl-comp (list-append (ce-dec (%wsucc d))) (list-append " = ")
      (cs-dl-lit (ce-dec (%wsucc d))) (cs-dl-lit " = ")) tl
