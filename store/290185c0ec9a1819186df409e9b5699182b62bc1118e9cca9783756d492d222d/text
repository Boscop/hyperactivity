-- ---------------------------------------------------------------- the calculus, as a table
-- what an eliminator does with a value: a body to build with the eliminator's wires innermost
-- (act-ap), or with the value's parts innermost, the last part first (act-rp), a value outright,
-- or nothing
data NkAct = act-ap (t : NkTm) | act-rp (t : NkTm) | act-hd (h : NkHd) | act-none
