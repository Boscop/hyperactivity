-- ---------------------------------------------------------------- the certificate
zr-eqb : (m n : Nat) → eqb m n ≡ true → m ≡ n
zr-eqb m = case m return λ y → (n : Nat) → eqb y n ≡ true → y ≡ n of
  zero → λ n → (case n return λ w → eqb zero w ≡ true → zero ≡ w of
    zero → λ h → λ i → zero
    suc k → λ h → absurd-ft (zero ≡ suc k) h)
  suc m1 → λ n → (case n return λ w → eqb (suc m1) w ≡ true → suc m1 ≡ w of
    zero → λ h → absurd-ft (suc m1 ≡ zero) h
    suc n1 → λ h → λ i → suc (rec m1 n1 h i))
