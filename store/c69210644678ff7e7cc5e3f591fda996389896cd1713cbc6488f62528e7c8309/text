-- signed division truncating toward zero, and its remainder (the dividend's sign)
dq-sdiv : DQ → DQ → DQ
dq-sdiv a b =
  let q = fst (dq-udivmod (dq-abs a) (dq-abs b))
  in case dq-isneg a of
       true → (case dq-isneg b of
         true → q
         false → dq-neg q)
       false → (case dq-isneg b of
         true → dq-neg q
         false → q)
