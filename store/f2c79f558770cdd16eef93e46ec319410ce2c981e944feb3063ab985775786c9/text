-- Sample one helical catenoid geodesic for u ∈ [-1, +1] (scale 10000):
--   r0 = 0.28 -> r0*1000 = 280 tenths, k = acosh(0.84/0.28) = acosh(3) = 1.7627 -> #17627
--   L = 820 tenths (82.0px), twist = 2.10 -> #21000
cat-sample-strand : Nat → Word → Word → SInt → List RPt
cat-sample-strand zero n idx th0 = nil
cat-sample-strand (suc rem) n idx th0 =
  let u = si-sub (si-div-w (si-mul (sp #20000) (sp idx)) n) (sp #10000)
      x = fx-mul (sp #820) u
      rad = fx-mul (sp #280) (fx-cosh (fx-mul (sp #17627) u))
      th = si-add th0 (fx-mul (sp #21000) u)
      y = fx-mul rad (fx-sin th)
      z = fx-mul rad (fx-cos th)
  in cons (cat-proj x y z rad) (cat-sample-strand rem n (%wsucc idx) th0)
