-- a section of the front page: the works published of one kind, under its heading (none, no section)
s-section : List Word → List Word → List Work → Proc W (List Word)
s-section id title nil = ret {lzero} {W} nil
s-section id title (cons w r) = bind (s-work-lis (cons w r)) (λ ls → ret {lzero} {W} (h-concat (cons "<div class='section' id='" (cons id (cons "'>" (cons title (cons "</div><ul class='list'>" (cons ls (cons "</ul>" nil)))))))))
