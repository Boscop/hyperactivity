-- (part of language-support)
rotate_right_int : (x' : ZI) → (width : ZI) → (places : ZI) → MF ZI
rotate_right_int x' width places =
  bindF {Unit} {ZI} (fl-assert {exception} (z-le (zpos #0) places) #149467514486126185021078021591788761910) (λ _ →
    let placesMod : ZI
        placesMod = (mod places width)
        xl : Bits (z-nat placesMod)
        xl = (bv-of-int (z-nat placesMod) x' #0)
        xh : Bits (z-nat (z-sub width placesMod))
        xh = (bv-of-int (z-nat (z-sub width placesMod)) x' (z-nat placesMod))
    in retF {ZI} (bv-unsigned (wadd (z-nat placesMod) (z-nat (z-sub width placesMod))) (bv-append (z-nat placesMod) (z-nat (z-sub width placesMod)) xl xh)))
