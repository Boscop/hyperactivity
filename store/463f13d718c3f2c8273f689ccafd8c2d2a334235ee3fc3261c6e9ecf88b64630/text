-- the candidates that are roots of m, zero excluded where the exponent a > 0 (0^{a/8} = 0)
roots-in : List SQ → Nat → List Cand → List Cand
roots-in m a cs = case cs of
  nil → nil
  cons c rest → (if sq-nz (poly-eval m (fst c)) then roots-in m a rest else (if sq-nz (fst c) then cons c (roots-in m a rest) else (if eqb a zero then cons c (roots-in m a rest) else roots-in m a rest)))
