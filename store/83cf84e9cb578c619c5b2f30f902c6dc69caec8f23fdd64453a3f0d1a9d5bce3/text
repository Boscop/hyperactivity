-- the state after byte c from state i < m: a next byte that matches, or state 0 that does not, is
-- decided at once; otherwise the fallback from the border of i
m-from : (n : Nat) → Bytes n → (k : Nat) → Bytes k → Word → Word → Word
m-from n p k f i c = if weq (cstr-get n p i) c then wadd i #1 else if weq i #0 then #0 else m-step n p k f (m-fail k f (wsub i #1)) c
