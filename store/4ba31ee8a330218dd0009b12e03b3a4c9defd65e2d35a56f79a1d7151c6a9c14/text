-- Dirichlet (alpha=0.25) probability p in [1, 4095] from packed (n1<<16)|n0
hcm-prob : Word → Word
hcm-prob v =
  if %weq v #0 then #2048
  else
    let n0 = %wand v #65535
        n1 = %wand (%wshr v #16) #65535
        p  = %wdiv (%wmul (%wadd (%wmul n1 #4) #1) #4096) (%wadd (%wmul (%wadd n0 n1) #4) #2)
    in if %wlt p #1 then #1 else if %wlt #4095 p then #4095 else p
