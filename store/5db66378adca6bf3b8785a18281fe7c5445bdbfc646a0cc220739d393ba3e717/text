-- pushforward of a reshaping process along a dynamic interface morphism
rmap-sig : {D1 D2 : DynSig} {A : Type} → (h : DynHom D1 D2)
         → (i : ds-idx D1) → RProc κ D1 A i → RProc κ D2 A (fst h i)
rmap-sig {κ} {D1} {D2} {A} h i (rret j a) = rret (fst h j) a
rmap-sig {κ} {D1} {D2} {A} h i (rcmd j c k) =
  rcmd (fst h j) (fst (snd h) j c)
       (λ r2 → λ α →
         transport (λ q → RProc κ D2 A (snd (snd (snd h)) j c r2 q))
                   (rmap-sig h (ds-next D1 j c (fst (snd (snd h)) j c r2)) (k (fst (snd (snd h)) j c r2) α)))
rmap-sig {κ} {D1} {D2} {A} h i (rtau j t) =
  rtau (fst h j) (λ α → rmap-sig h j (t α))
