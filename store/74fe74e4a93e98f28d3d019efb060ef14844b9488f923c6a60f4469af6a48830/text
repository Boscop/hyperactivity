sa-counts-b : (t : List (List Word)) → (f : List (List Word) → Word) → (a : El PO) →
              isTrue (eqb (count {PO} a (msort-list {PO} (list-map (phi f) (entries t #0)))) (count {PO} a (list-map (phi f) (suffix-array t))))
sa-counts-b t f a = eqb-complete {count {PO} a (msort-list {PO} (list-map (phi f) (entries t #0)))} {count {PO} a (list-map (phi f) (suffix-array t))} (sa-counts t f a)
