-- the kinds of a constructor's fields, for deriving (lib/derive.cub, through data-shape in lib/std.cub):
-- the telescope walked with fresh variables, each field (kind , d2): kind 0 a word, 1 recursive, 2 a
-- data type d2 without parameters, 3 a primitive type k; none for any other field or a dimension
der-field-kind d A =
  if is-rec-ty d A then some (#1 , d)
  else (case A of
          tword → some (#0 , d)
          tdata d2 ps V → (case ps of lnil → some (#2 , d2); _ → none)
          tg g nm → (case %view (%gval g) of wpty k n → (if %weq k #4 then none else some (#3 , k)); _ → none)
          _ → none)
