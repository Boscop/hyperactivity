mask-select-paint-true : (l : List Word) → (r : List Bool) → (s : List Word) →
                         mask-select (list-append l s) (paint-onto true l r) ≡ list-append l (mask-select s r)
mask-select-paint-true nil r s = λ i → mask-select s r
mask-select-paint-true (cons x l) r s = λ i → cons x (mask-select-paint-true l r s i)
