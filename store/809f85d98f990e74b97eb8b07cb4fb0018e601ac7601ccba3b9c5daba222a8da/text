-- negation reverses the order
leZ-neg : (a b : Int) → leZ a b → leZ (negZ b) (negZ a)
leZ-neg a b h =
  le-transport (plusw (fst (toZ2 (negZ b))) (snd (toZ2 (negZ a)))) (plusw (fst (toZ2 (negZ a))) (snd (toZ2 (negZ b))))
    (plusw (snd (toZ2 b)) (fst (toZ2 a))) (plusw (snd (toZ2 a)) (fst (toZ2 b)))
    (symw (cong2w (λ x y → plusw x y) (toZ2-neg-fst2 b) (toZ2-neg-snd2 a))) (symw (cong2w (λ x y → plusw x y) (toZ2-neg-fst2 a) (toZ2-neg-snd2 b)))
    (le-transport (plusw (snd (toZ2 b)) (fst (toZ2 a))) (plusw (snd (toZ2 a)) (fst (toZ2 b))) (plusw (fst (toZ2 a)) (snd (toZ2 b))) (plusw (fst (toZ2 b)) (snd (toZ2 a)))
      (plusw-comm (fst (toZ2 a)) (snd (toZ2 b))) (plusw-comm (fst (toZ2 b)) (snd (toZ2 a))) h)
