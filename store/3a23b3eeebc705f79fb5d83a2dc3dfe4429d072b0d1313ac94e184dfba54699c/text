bq-add : BQ → BQ → BQ
bq-add a b = if bit-eq (fst a) (fst b)
  then bq-make (fst a) (bin-add (bin-mul (fst (snd a)) (snd (snd b))) (bin-mul (fst (snd b)) (snd (snd a)))) (bin-mul (snd (snd a)) (snd (snd b)))
  else (if bq-mag-leb a b
    then bq-make (fst b) (bin-sub (bin-mul (fst (snd b)) (snd (snd a))) (bin-mul (fst (snd a)) (snd (snd b)))) (bin-mul (snd (snd a)) (snd (snd b)))
    else bq-make (fst a) (bin-sub (bin-mul (fst (snd a)) (snd (snd b))) (bin-mul (fst (snd b)) (snd (snd a)))) (bin-mul (snd (snd a)) (snd (snd b))))
