-- Biophysical class for exact integer contact energy:
--   0 = polar/Gly, 1 = aliphatic hydrophobic, 2 = aromatic (F,Y,W), 3 = acidic (D,E), 4 = basic (K,R,H), 5 = Proline (turn-former).
aa-class : AA → Nat
aa-class a = case a of
  aa-G → 0; aa-S → 0; aa-T → 0; aa-N → 0; aa-Q → 0; aa-C → 1
  aa-A → 1; aa-V → 1; aa-L → 1; aa-I → 1; aa-M → 1
  aa-F → 2; aa-Y → 2; aa-W → 2
  aa-D → 3; aa-E → 3
  aa-K → 4; aa-R → 4; aa-H → 4
  aa-P → 5
