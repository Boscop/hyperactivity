-- one alternative of a path, whole: its entry's id, its module, then the module's text (an index line of
-- alternatives/PATH is "ENTRY MODULE"); then k, the rest
hy-alternative-out : List Word → List (List Word) → Proc W Unit → Proc W Unit
hy-alternative-out name (cons e (cons mh rest)) k = bind (h-source-module (inr mh)) (λ t →
  bind (h-out (list-append (h-line (list-append name (list-append "   (alternative: entry " (list-append e (list-append ", module " (list-append mh ")")))))) (cons #10 (h-line (hy-or nil t))))) (λ u → k))
hy-alternative-out name l k = k
