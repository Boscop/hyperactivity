mterm-enc-sym : MTerm → List Word
mterm-enc-sym mempty = cons #6 nil
mterm-enc-sym (mlit w) = cons (wadd #8 w) nil
mterm-enc-sym (mref k) = if wlt k #4 then cons k nil else cons #4 (cons k nil)
mterm-enc-sym (mapp tid arg) = cons #5 (cons tid (mterm-enc-sym arg))
mterm-enc-sym (mcat l r) = cons #7 (list-append (mterm-enc-sym l) (mterm-enc-sym r))
