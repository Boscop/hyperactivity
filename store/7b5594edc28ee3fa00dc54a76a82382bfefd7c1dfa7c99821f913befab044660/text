bn-eip3009-digest : List Word → List Word → Word → Word → Word → List Word → List Word
bn-eip3009-digest from20 to20 val6 vAfter vBefore nonce32 =
  let structH = keccak256
                  (h-concat
                    (cons bn-eip3009-th
                    (cons (bn-abi-addr20 from20)
                    (cons (bn-abi-addr20 to20)
                    (cons (eth-word-be32 val6)
                    (cons (eth-word-be32 vAfter)
                    (cons (eth-word-be32 vBefore)
                    (cons (h-take (toNat #32) nonce32) nil))))))))
  in keccak256 (h-concat (cons (cons #25 (cons #1 nil)) (cons bn-usdc-domain-sep (cons structH nil))))
