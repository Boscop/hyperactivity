sg-read-forms-at : Nat → Nat → NkTm → List Word → Opt (Code × Code)
sg-read-forms-at pf cf ksig txt =
  case nk-parse-sexp pf false txt return (λ _ → Opt (Code × Code)) of
    none → none
    some p1 →
      (case nk-parse-sexp pf false (snd p1) return (λ _ → Opt (Code × Code)) of
         none → none
         some p2 →
           let dT = snd (sg-decanon cf #0 lnil (fst (fst p1)))
               dt = snd (sg-decanon cf #0 lnil (fst (fst p2)))
           in some (nk-clean-code (sg-to-code cf ksig lnil dt) , nk-clean-code (sg-to-code cf ksig lnil dT)))
