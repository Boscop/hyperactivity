-- 3. Pure Coulomb Derivation of the N-H···O=C Hydrogen Bond (Zero Fitted Constants):
--    Collinear 4-charge electrostatic sum with covalent lengths a = r_NH, b = r_CO, gap d = r_HO:
--      1/d - 1/(d+b) - 1/(d+a) + 1/(d+a+b)
--    Clearing positive denominator D = d(d+a)(d+b)(d+a+b):
--      (d+a)(d+b)(d+a+b) - d(d+a)(d+a+b) - d(d+b)(d+a+b) + d(d+a)(d+b) = a b (2d + a + b) > 0!
--    Variables (0..2): a, b, d.
chem-hbond-coulomb-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-hbond-coulomb-poly A ad mu q vs =
  (λ g sub →
    let a = g 0; b = g 1; d = g 2
        q2 = q (fn-q 2 1)
        da = ad d a
        db = ad d b
        dab = ad da b
        t1 = mu da (mu db dab)
        t2 = mu d (mu da dab)
        t3 = mu d (mu db dab)
        t4 = mu d (mu da db)
        lhs = ad (sub (sub t1 t2) t3) t4
        rhs = mu a (mu b (ad (mu q2 d) (ad a b)))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
