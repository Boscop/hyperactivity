text-struct-enc-body : List Word → TextPacket
text-struct-enc-body bs =
  let vi = intern-enc (tok-exact bs)
      ids = snd vi
      qmap = induce-ctx-classes ids
      qr = quotient-split qmap ids
      p1 = text-pass1-enc (fst qr)
  in mk-tpkt (mk-thdr (fst vi) qmap (fst p1) (fst (snd p1))) (mk-tbody (snd (snd p1)) (snd qr))
