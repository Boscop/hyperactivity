subst-tm : (Γ Δ : CCtx) → TCtx Δ → (σ : Sub Δ Γ) → DSubst Γ Δ σ → (s : TyShape) → TCode Γ s → TCode Δ s
subst-tm Γ Δ tΔ σ ds s t =
  (fst (fst (snd (rr s)) Δ (subM Δ Γ (TV s) σ (teval Γ s t)) (fund (snd (snd t)) Δ σ (dsub-env Γ Δ tΔ σ ds))) ,
   subM Δ Γ (TV s) σ (teval Γ s t) ,
   embed {(k-nf , (j-tm , Δ , s , fst (fst (snd (rr s)) Δ (subM Δ Γ (TV s) σ (teval Γ s t)) (fund (snd (snd t)) Δ σ (dsub-env Γ Δ tΔ σ ds))) , subM Δ Γ (TV s) σ (teval Γ s t)))}
     (snd (fst (snd (rr s)) Δ (subM Δ Γ (TV s) σ (teval Γ s t)) (fund (snd (snd t)) Δ σ (dsub-env Γ Δ tΔ σ ds)))))
