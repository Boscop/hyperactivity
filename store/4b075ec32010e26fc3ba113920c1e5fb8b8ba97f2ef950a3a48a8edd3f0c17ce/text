geo-path-svg : Cx → Cx → Word → Word → Word → List Word
geo-path-svg p1 p2 samples swTenths opPct =
  let w = mob-inv p1 p2
      d = geo-sample-go (toNat (%wsucc samples)) samples #0 p1 w nil
  in lg-concat (cons "<path d='" (cons d (cons "' fill='none' stroke='#fff' stroke-width='" (cons (lg-tenths swTenths) (cons "' stroke-linecap='round' stroke-linejoin='round' opacity='" (cons (lg-op opPct) (cons "'/>" nil)))))))
