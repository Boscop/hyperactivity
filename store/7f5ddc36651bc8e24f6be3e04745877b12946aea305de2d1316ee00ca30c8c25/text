hh-loop : Nat → Word → Word → List (List Word × List Word) → Step W Word
hh-loop zero fd buf rmap = scmd (w-sys #3 fd #0 #0 #0 #0 #0) (λ _ → sdone #0)
hh-loop (suc m) fd buf rmap =
  scmd (w-sys #43 fd #0 #0 #0 #0 #0) (λ cfd →
  if %wlt #9223372036854775807 cfd then hh-loop m fd buf rmap
  else hh-handle cfd buf rmap (λ _ → hh-loop m fd buf rmap))
