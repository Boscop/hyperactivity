dm-seed-hxsv-if-missing : List Word → Word → Word → Proc W Unit
dm-seed-hxsv-if-missing path seq tag =
  bind (h-read path) (λ mr →
    case mr of
      inr bs →
        if fst (dm-verify-hxsv32 bs)
        then ret {lzero} {W} unit
        else bind (h-write path (dm-pack-hxsv32 seq tag #40 #2025)) (λ w → ret {lzero} {W} unit)
      inl u →
        bind (h-write path (dm-pack-hxsv32 seq tag #40 #2025)) (λ w → ret {lzero} {W} unit))
