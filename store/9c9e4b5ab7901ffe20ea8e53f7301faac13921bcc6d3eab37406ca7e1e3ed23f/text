count-phi-t : (f : List (List Word) → Word) → (a : El PO) → (l : List (El entry-ord)) → eqo {PO} a (phi f (snd a)) ≡ true →
              count {PO} a (list-map (phi f) l) ≡ count {entry-ord} (snd a) l
count-phi-t f a l c =
  case l return λ w → count {PO} a (list-map (phi f) w) ≡ count {entry-ord} (snd a) w of
    nil → λ i → zero
    cons e q → λ i → plus (one-if (eqo-phi-c f a e c i)) (rec q i)
