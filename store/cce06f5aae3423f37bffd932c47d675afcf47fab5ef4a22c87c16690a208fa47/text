-- the 6j symbol {j1 j2 j3; j4 j5 j6} from doubled spins, as (sign, square); zero where a triangle fails
sixj : Nat → Nat → Nat → Nat → Nat → Nat → CG
sixj J1 J2 J3 J4 J5 J6 =
  if tri-ok J1 J2 J3 then (if tri-ok J1 J5 J6 then (if tri-ok J4 J2 J6 then (if tri-ok J4 J5 J3 then
    sixj-from (nat-half (plus (plus J1 J2) J3)) (nat-half (plus (plus J1 J5) J6)) (nat-half (plus (plus J4 J2) J6)) (nat-half (plus (plus J4 J5) J3))
      (nat-half (plus (plus J1 J2) (plus J4 J5))) (nat-half (plus (plus J2 J3) (plus J5 J6))) (nat-half (plus (plus J3 J1) (plus J6 J4)))
      (qp-mul (qp-mul (delta-sq J1 J2 J3) (delta-sq J1 J5 J6)) (qp-mul (delta-sq J4 J2 J6) (delta-sq J4 J5 J3)))
    else (true , (zero , suc zero))) else (true , (zero , suc zero))) else (true , (zero , suc zero))) else (true , (zero , suc zero))
