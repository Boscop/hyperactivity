adder-bit : (x y c : Bool) → plus (bitn (bit-eq (bit-eq x y) c)) (times 2 (bitn (carry3 x y c))) ≡ plus (bitn c) (plus (bitn x) (bitn y))
adder-bit x y c = case x return λ u → plus (bitn (bit-eq (bit-eq u y) c)) (times 2 (bitn (carry3 u y c))) ≡ plus (bitn c) (plus (bitn u) (bitn y)) of
  true → fa-t y c
  false → fa-f y c
