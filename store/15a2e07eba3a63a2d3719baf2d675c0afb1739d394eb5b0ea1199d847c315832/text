-- an operation reads a held wire: it waits if nothing is there
nk-read : NkSlot → Word → NkOp → NkState → NkState
nk-read nks-none w o (nk-state sl rd n) = nk-state (nksl-cons w (nks-readers (nkos-cons o nkos-nil)) sl) rd n
nk-read (nks-readers os) w o (nk-state sl rd n) = nk-state (nk-set sl w (nks-readers (nkos-cons o os))) rd n
nk-read (nks-val (nkv-num m)) w o (nk-state sl rd n) = nk-state sl (nkp-cons o (nkv-num m) rd) n
nk-read (nks-val (nkv-ref y)) w o (nk-state sl rd n) = nk-state sl (nkp-cons o (nkv-ref y) rd) n
nk-read (nks-val (nkv-lam t e)) w o (nk-state sl rd n) = nk-read-copy t o rd (nk-copy e sl n)
nk-read (nks-op p) w o st = st
