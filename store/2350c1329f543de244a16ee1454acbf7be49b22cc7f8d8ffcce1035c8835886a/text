-- the family read from the first n lines that hold s, and how many lines hold it
c-family-in : List Word → List Word → Proc W (Word × List (List Word))
c-family-in n s = bind (c-out (cons "grep" (cons "-c" (cons "-F" (cons "-e" (cons s (cons c-record nil))))))) (λ cnt →
  bind (c-out (cons "grep" (cons "-F" (cons "-m" (cons n (cons "-e" (cons s (cons c-record nil)))))))) (λ o →
  ret (h-number (c-strip-nl cnt) , h-dedupe (h-concat-lists (list-map (λ l → c-after s l) (h-lines o))))))
