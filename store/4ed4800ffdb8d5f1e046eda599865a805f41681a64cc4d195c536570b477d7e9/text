navigate-by cost n goal view t =
  if %weq n #0 then navr t #0
  else if reaches goal t then navr t #0
  else (case choose-by cost goal (available view t) of
          none → navr t #0
          some s → (case s of stepv r t2 → (case navigate-by cost (%wsub n #1) goal view t2 of navr t3 k → navr t3 (%wsucc k))))
