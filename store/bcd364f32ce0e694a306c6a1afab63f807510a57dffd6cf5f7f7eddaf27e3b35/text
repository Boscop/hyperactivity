-- a working action performed; the actions that change the source hold the write lock (hy-locked)
hy-act : List Word → List Word → List (List Word) → Proc W Unit
hy-act st m nil = ret unit
hy-act st m (cons c rest) =
  if h-eq c "def" then hy-def st rest else
  if h-eq c "write" then hy-locked (bind h-stdin (hy-write st m rest)) else
  if h-eq c "remove" then hy-locked (hy-remove st m rest) else
  if h-eq c "dead" then hy-locked (hy-dead m rest) else
  if h-eq c "history" then hy-history st rest else
  if h-eq c "paper" then hy-paper st m rest else
  if h-eq c "check" then hy-check st m rest else
  if h-eq c "done" then bind (h-write (list-append st "/session/log") nil) (λ b → h-out (h-line "The work is declared done; the session is over. The next session begins with the walk."))
  else if h-has c hy-bridge-words then hy-bridge st m c rest
  else hy-views st m (cons c rest)
