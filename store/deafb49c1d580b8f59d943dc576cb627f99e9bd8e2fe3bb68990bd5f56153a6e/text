pcm-bytes-to-s16-go : List Word → List Word → List Word
pcm-bytes-to-s16-go nil acc = cli-rev acc nil
pcm-bytes-to-s16-go (cons lo (cons hi r)) acc =
  let v = %wor lo (%wshl hi #8)
      s32 = if %wlt v #32768 then v else %wor v #4294901760
  in pcm-bytes-to-s16-go r (cons s32 acc)
pcm-bytes-to-s16-go (cons _ nil) acc = cli-rev acc nil
