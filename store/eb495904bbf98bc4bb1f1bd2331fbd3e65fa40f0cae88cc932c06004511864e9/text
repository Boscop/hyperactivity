m-best : (n : Nat) → Bytes n → (k : Nat) → Bytes k → Word → (s : Nat) → Bytes s → Word
m-best n p k f m s b = m-best-end n p (%welimP (λ _ → Word) (bytes-length s b) #0
  (λ i a → m-with (if m-at-word n p (m-lo a) then wmax (wshr a #32) (m-lo a) else wshr a #32)
                  (m-next n p k f m (m-lo a) (cstr-get s b i))))
