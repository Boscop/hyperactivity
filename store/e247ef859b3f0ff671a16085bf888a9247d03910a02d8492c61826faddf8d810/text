-- Theorem 6: Sample-Chain Transitive Credit Conservation (arbitrary sequence of upstream payouts)
-- Tipping any downstream remix or chop propagates credit along the entire sample chain
-- while strictly conserving total credit across every peer and channel (zero decay, zero inflation).
sample-chain-credit-conserved : (mvs : List CrMove) → (s : CrState) → cr-allowed-run mvs s →
  cr-total (cr-run mvs s) ≡ cr-total s
sample-chain-credit-conserved = cr-conserved
