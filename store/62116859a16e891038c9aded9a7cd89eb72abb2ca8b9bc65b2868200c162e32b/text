-- a variable: its wire forwarded to out, every other wire of the environment erased
nk-pick : NkEnv → Word → Word → NkFx → NkFx
nk-pick nke-nil i out fx = fx
nk-pick (nke-cons w r) i out fx = if %weq i #0 then nkf-op w (nko-fwd out) (nk-era-env r fx) else nkf-op w nko-era (nk-pick r (%wsub i #1) out fx)
