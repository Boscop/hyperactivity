-- the identity as an equivalence: over y the centre is y with the constant path, and a point x
-- with a path p from y is joined to it by p up to k (part of machine-in-hyperactive)
nk-idequiv : NkTm
nk-idequiv = nk-mkpair (nk-lam (nk-var #0)) (nk-lam (nk-mkpair (nk-mkpair (nk-var #0) (nk-lam (nk-var #1))) (nk-lam (nk-lam (nk-mkpair (nk-app (nk-p2 (nk-var #1)) (nk-var #0)) (nk-lam (nk-app (nk-p2 (nk-var #2)) (nk-and-i (nk-var #1) (nk-var #0)))))))))
