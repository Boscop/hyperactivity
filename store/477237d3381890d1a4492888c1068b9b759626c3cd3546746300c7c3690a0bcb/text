-- ADR X23, #-back_bytes (exact blob base pointer inside a64-stub)
a64-adr-back-x23 : Word → Lst Word
a64-adr-back-x23 back =
  let disp = a64-and (a64-sub64 #2097152 back) #2097151
      immlo = a64-and disp #3
      immhi = a64-and (a64-shr disp #2) #524287
  in a64-insn (a64-or #268435456 (a64-or (a64-shl immlo #29) (a64-or (a64-shl immhi #5) #23)))
