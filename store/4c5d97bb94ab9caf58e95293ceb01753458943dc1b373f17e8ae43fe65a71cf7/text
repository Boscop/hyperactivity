-- ε(m,n,p)(Φ(m,n) − Φ(n,m)) for one unordered pair, the spaces of both orders in tbl
eig-pair : List SpaceData → VM → Nat → Nat → SQ → List Nat → Rows → List (List (List PRad)) → List (List (List PRad))
eig-pair tbl aP m n s dsP xs0 acc = eig-kinds (sq-neg s) tbl aP 5 m n dsP xs0 (eig-kinds s tbl aP 5 n m dsP xs0 acc)
