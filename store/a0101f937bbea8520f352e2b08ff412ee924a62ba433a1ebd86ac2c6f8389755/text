bw-fn-len : (A V W : Type) → (neg : A → Bool) → (f : V → V → A) → (t : W → V) → (ws : List W) → sy-len V (it-fn A V neg f (bw-map V W t ws)) ≡ sy-len W (it-fn A W neg (λ x y → f (t x) (t y)) ws)
bw-fn-len A V W neg f t ws = case ws return λ l → sy-len V (it-fn A V neg f (bw-map V W t l)) ≡ sy-len W (it-fn A W neg (λ x y → f (t x) (t y)) l) of
  nil → λ i → zero
  cons u ur → bw-iflen V W (neg (f (t u) (t u))) (t u) u (it-fn A V neg f (bw-map V W t ur)) (it-fn A W neg (λ x y → f (t x) (t y)) ur) (bw-fn-len A V W neg f t ur)
