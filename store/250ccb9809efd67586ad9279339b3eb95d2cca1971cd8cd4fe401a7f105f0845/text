ke-emit : KTarget → KExpr → List Word
ke-emit t (ke-k c)       = ke-emit-const t c
ke-emit _ (ke-v i)       = list-append "x" (ce-dec i)
ke-emit t (ke-not a)     = list-append "(~" (list-append (ke-emit t a) ")")
ke-emit t (ke-xor a b)   = list-append "(" (list-append (ke-emit t a) (list-append " ^ " (list-append (ke-emit t b) ")")))
ke-emit t (ke-and a b)   = list-append "(" (list-append (ke-emit t a) (list-append " & " (list-append (ke-emit t b) ")")))
ke-emit t (ke-or  a b)   = list-append "(" (list-append (ke-emit t a) (list-append " | " (list-append (ke-emit t b) ")")))
ke-emit t (ke-add a b)   = list-append "(" (list-append (ke-emit t a) (list-append " + " (list-append (ke-emit t b) ")")))
ke-emit t (ke-sub a b)   = list-append "(" (list-append (ke-emit t a) (list-append " - " (list-append (ke-emit t b) ")")))
ke-emit t (ke-mul a b)   = list-append "(" (list-append (ke-emit t a) (list-append " * " (list-append (ke-emit t b) ")")))
ke-emit t (ke-rotr a n)  = ke-emit-rotr t (ke-emit t a) n
ke-emit t (ke-ch e f g)  =
  let es = ke-emit t e
      fs = ke-emit t f
      gs = ke-emit t g
  in list-append "(" (list-append gs (list-append " ^ (" (list-append es (list-append " & (" (list-append fs (list-append " ^ " (list-append gs ")))")))))))
ke-emit t (ke-maj a b c) =
  let as = ke-emit t a
      bs = ke-emit t b
      cs = ke-emit t c
  in list-append "(" (list-append as (list-append " ^ ((" (list-append as (list-append " ^ " (list-append bs (list-append ") & (" (list-append as (list-append " ^ " (list-append cs ")))")))))))))
