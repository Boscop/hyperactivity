-- wr16: from register_readers_and_writers.sail (it calls what is defined after it there)
-- (part of language-support)
wr16 : (reg' : Bits #4) → (sailval : Bits #16) → MS Unit
wr16 reg' sailval =
  bindS {Bits #64} {Unit} (rgfi (bv-unsigned #4 reg')) (λ qword →
    write_rgfi (bv-unsigned #4 reg') (changeSlice_bits #64 (bv-slice #64 qword #63 #0) (zpos #0) (zpos #16) sailval))
