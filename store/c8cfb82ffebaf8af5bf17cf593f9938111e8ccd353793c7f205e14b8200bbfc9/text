-- Monotonicity: inserting additional published keys never invalidates prior Bloom memberships
bloom-monotone : {K : Type} → (h1 h2 : K → Nat) → (k1 k2 : K) → (bl : Bloom) →
  bloom-mem h1 h2 k1 bl ≡ true → bloom-mem h1 h2 k1 (bloom-add h1 h2 k2 bl) ≡ true
bloom-monotone h1 h2 k1 k2 bl mem =
  let m1 = po-and-left (bl (h1 k1)) (bl (h2 k1)) mem in
  let m2 = po-and-right (bl (h1 k1)) (bl (h2 k1)) mem in
  let s1 = bloom-set-mono (h1 k2) (h1 k1) (bloom-set (h2 k2) bl) (bloom-set-mono (h2 k2) (h1 k1) bl m1) in
  let s2 = bloom-set-mono (h1 k2) (h2 k1) (bloom-set (h2 k2) bl) (bloom-set-mono (h2 k2) (h2 k1) bl m2) in
  λ i → po-and (s1 i) (s2 i)
