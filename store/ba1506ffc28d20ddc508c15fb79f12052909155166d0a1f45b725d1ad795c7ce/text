-- order respects equality of integers, on the left and on the right
zle-zeq-l : (x x2 y : Nat × Nat) → zeq x x2 → zle x y → zle x2 y
zle-zeq-l x x2 y e h = nle-cancel (plus (fst x2) (snd y)) (plus (fst y) (snd x2)) (snd x)
  (le-cong-r (plus (plus (fst x2) (snd y)) (snd x)) (plus (plus (fst y) (snd x)) (snd x2)) (plus (plus (fst y) (snd x2)) (snd x))
    (le-cong-l (plus (plus (fst x) (snd y)) (snd x2)) (plus (plus (fst x2) (snd y)) (snd x)) (plus (plus (fst y) (snd x)) (snd x2))
      (nle-add (plus (fst x) (snd y)) (plus (fst y) (snd x)) (snd x2) (snd x2) h (le-refl (snd x2)))
      (transN (plus-assoc (fst x) (snd y) (snd x2)) (transN (congN (plus (fst x)) (plus-comm (snd y) (snd x2)))
        (transN (symN (plus-assoc (fst x) (snd x2) (snd y))) (transN (congN (λ z → plus z (snd y)) e)
          (transN (plus-assoc (fst x2) (snd x) (snd y)) (transN (congN (plus (fst x2)) (plus-comm (snd x) (snd y))) (symN (plus-assoc (fst x2) (snd y) (snd x))))))))))
    (transN (plus-assoc (fst y) (snd x) (snd x2)) (transN (congN (plus (fst y)) (plus-comm (snd x) (snd x2))) (symN (plus-assoc (fst y) (snd x2) (snd x))))))
