g-smuggles-foreign : List Word → Bool
g-smuggles-foreign nil = false
g-smuggles-foreign (cons x xs) =
  if weq x #34 then
    if orB (h-prefix "__global__" xs)
       (orB (h-prefix "kernel void " xs)
       (orB (h-prefix "#include <" xs)
            (h-prefix "OPENQASM " xs)))
    then true
    else g-smuggles-foreign xs
  else g-smuggles-foreign xs
