-- (part of language-support)
x86_step_print_halt : (haltAddr : Bits #48) → (printEachStep : Bool) → (printCount : Bool) → (count' : ZI) → MS Bool
x86_step_print_halt haltAddr printEachStep printCount count' =
  bindS {Bits #48} {Bool} read_rip (λ t'1 →
    λ σ →
      if (weq t'1 haltAddr) then
        the (MS Bool)
          (retS {Bool} true) σ
      else
        the (MS Bool)
          (bindS {Unit} {Bool} x86_fetch_decode_execute (λ t'2 →
             let k'6 : Unit → MS Bool
                 k'6 =
                   λ t'4 →
                     retS {Bool} false
             in λ σ →
                  if printEachStep then
                    the (MS Bool)
                      (bindS {Unit} {Bool} printState (λ t'3 →
                         k'6 t'3)) σ
                  else
                    the (MS Bool)
                      (k'6 unit) σ)) σ)
