-- the elimination on the augmented rows, keeping each pivot row's last n entries: w_1 … w_n. f is a list of the
-- matrix's length, which the recursion descends; q the previous pivot
wt-go : Nat → List (List BZ) → BZ → List (List BZ) → List (List BZ)
wt-go n f q m = case f of
  nil → nil
  cons g frest → (case m of
    nil → nil
    cons r rest → cons (wt-drop (monus (wt-len r) n) r) (wt-go n frest (in-hd r) (in-rows (in-hd r) q (in-tl r) rest)))
