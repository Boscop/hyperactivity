s-object-get : List Word → Proc W (List Word)
s-object-get q = if s-object-name (s-param "h" q) (s-param "k" q)
  then bind (h-read (h-object-path (s-param "h" q) (s-param "k" q))) (λ t → ret (s-object-of t))
  else ret {lzero} {W} (s-respond "400 Bad Request" "text/plain" "an object is named by its hash and kind (text, module, entry)")
