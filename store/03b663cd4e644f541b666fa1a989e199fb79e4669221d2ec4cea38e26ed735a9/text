tabulate-indexV32 : (A : Type) → (to : A → UInt32) → (from : UInt32 → A) → ((w : UInt32) → to (from w) ≡ w) → (n : Nat) → (a : Array32 n) → atabV32 A to n (aindexV32 A from n a) ≡ a
tabulate-indexV32 A to from tf n a = array32-ext n (atab32 n (λ q → to (from (aindex32 n a q)))) a
  (λ i h → concat {lzero} {UInt32} {index32 n (atab32 n (λ q → to (from (aindex32 n a q)))) i h} {to (from (index32 n a i h))} {index32 n a i h}
             (index-tabulate32 n (λ q → to (from (aindex32 n a q))) (i , h)) (tf (index32 n a i h)))
