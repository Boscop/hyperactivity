-- a variable: its wire forwarded to out, every other wire of the environment erased
sm-pick : SmEnv → Word → Word → SmFx → SmFx
sm-pick sme-nil i out fx = fx
sm-pick (sme-cons w r) i out fx = if %weq i #0 then smf-op w (smo-fwd out) (sm-era-env r fx) else smf-op w smo-era (sm-pick r (%wsub i #1) out fx)
