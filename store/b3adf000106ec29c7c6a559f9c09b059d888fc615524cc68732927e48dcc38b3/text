-- UNIVERSAL INVOLUTION OVER ARBITRARY-WIDTH BIT-VECTORS!
ha-thm-xor-zip-inv : (a b : List Bool) → ha-xor-zip a (ha-xor-zip a b) ≡ b
ha-thm-xor-zip-inv nil         b           = refl
ha-thm-xor-zip-inv (cons _ _)  nil         = refl
ha-thm-xor-zip-inv (cons a ra) (cons b rb) = λ i → cons (ha-lem-xor-cancel-l a b i) (ha-thm-xor-zip-inv ra rb i)
