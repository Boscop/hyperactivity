-- Coupling two domains (e.g. ligand binding or electric-field / allosteric coupling `link`)
-- merges previously separate conformational basins in `Basins (S1 × S2) (coupled-step ...)`
-- into a single collective folding basin via `basin-couple-merges`.
fold-allosteric-couple-merges :
  {S1 S2 : Type 0} →
  (eq1 : S1 → S1 → Bool) → (eq2 : S2 → S2 → Bool) →
  (s1 : S1 → S1 → Bool) → (s2 : S2 → S2 → Bool) →
  (link : (S1 × S2) → (S1 × S2) → Bool) →
  (p q : S1 × S2) → isTrue (link p q) →
  basin-of (S1 × S2) (coupled-step eq1 eq2 s1 s2 link) p
    ≡ basin-of (S1 × S2) (coupled-step eq1 eq2 s1 s2 link) q
fold-allosteric-couple-merges {S1} {S2} eq1 eq2 s1 s2 link p q lk =
  basin-couple-merges {S1} {S2} eq1 eq2 s1 s2 link p q lk
