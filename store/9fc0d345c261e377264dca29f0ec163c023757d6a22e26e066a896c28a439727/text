-- rounded quotients keep canonical magnitudes
fdiv-qr-canon : (pos : Bool) → (qr : List Bool × List Bool) → bcanon (fst qr) ≡ true → bcanon (snd (bz-fdiv-qr pos qr)) ≡ true
fdiv-qr-canon pos qr h = case pos return λ p → bcanon (snd (bz-fdiv-qr p qr)) ≡ true of
  true → h
  false → if-canon (bin-null (snd qr)) (bz-neg (true , fst qr)) (false , bin-succ (fst qr)) (bz-neg-canon (true , fst qr) h) (bin-succ-canon (fst qr) h)
