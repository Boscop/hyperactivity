-- L1/q1 ≤ X1/q2·… : the sum of two lower bounds against the sum of two values, over the common denominator
add-low : (L1 L2 X1 X2 : Nat × Nat) → (q1 q2 S : Nat) → zle (zsc L1 q1) (zsc X1 S) → zle (zsc L2 q2) (zsc X2 S) → zle (zsc (zplus L1 L2) (times q1 q2)) (zsc (zplus (zsc X1 q2) (zsc X2 q1)) S)
add-low L1 L2 X1 X2 q1 q2 S h1 h2 = zle-path
  (zplus (zsc (zsc L1 q1) q2) (zsc (zsc L2 q2) q1)) (zsc (zplus L1 L2) (times q1 q2))
  (zplus (zsc (zsc X1 S) q2) (zsc (zsc X2 S) q1)) (zsc (zplus (zsc X1 q2) (zsc X2 q1)) S)
  (symNN (transNN (zsc-plus L1 L2 (times q1 q2)) (λ i → zplus (zsc-assoc L1 q1 q2 i) (zsc-comm-q L2 q1 q2 i))))
  (transNN (λ i → zplus (zsc-swap X1 S q2 i) (zsc-swap X2 S q1 i)) (symNN (zsc-plus (zsc X1 q2) (zsc X2 q1) S)))
  (zle-add (zsc (zsc L1 q1) q2) (zsc (zsc X1 S) q2) (zsc (zsc L2 q2) q1) (zsc (zsc X2 S) q1)
    (zle-scale (zsc L1 q1) (zsc X1 S) q2 h1) (zle-scale (zsc L2 q2) (zsc X2 S) q1 h2))
