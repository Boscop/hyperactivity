ks-sum-loop : Nat → Word → List Word
ks-sum-loop zero _ = nil
ks-sum-loop (suc k) i =
  let fi = epfl-indexed "f" i
      p0 = ks-pn #0 i
  in if %weq i #0 then
       list-append (epfl-buf1 p0 fi) (ks-sum-loop k (%wsucc i))
     else
       let ci = ks-gn #7 (%wsub i #1)
           px = list-append "s_" (epfl-dec i)
       in list-append (epfl-xor-blif p0 ci fi px) (ks-sum-loop k (%wsucc i))
