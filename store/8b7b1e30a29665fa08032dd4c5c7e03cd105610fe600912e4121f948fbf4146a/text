-- a path at which the source holds no one module: its alternatives named (src/syntax.c, the view), or nothing
h-not-held-of : List Word → Sum Unit (List Word) → Proc W Unit
h-not-held-of path (inl u) = h-fail (list-append "the source holds nothing at " path)
h-not-held-of path (inr a) = h-fail (h-concat (cons path (cons " holds alternatives (entry, module), none read until all but one are stated dead (hyperactive dead ENTRY REASON) or a write follows them:" (cons (cons #10 nil) (cons a nil)))))
