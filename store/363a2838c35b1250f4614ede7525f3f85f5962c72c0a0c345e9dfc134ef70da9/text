-- the theta network: two vertices joined by four edges, every edge leaving the first, both with the form w
btheta-net : List (List (List BRad)) → List BNetVertex
btheta-net w = cons (w , cons (0 , true) (cons (1 , true) (cons (2 , true) (cons (3 , true) nil)))) (cons (w , cons (0 , false) (cons (1 , false) (cons (2 , false) (cons (3 , false) nil)))) nil)
