-- a pair of the two projections of one code is that code (Σ's η): normalization η-expands a neutral
-- of a pair type into (fst x , snd x), which compiled code would compute twice, so it is contracted
-- back; k continues into x
eta-at : (Word → Code → Code) → Code → Word → Opt Code
eta-at k (cpair a b) e =
  case a return (λ _ → Opt Code) of
    cfst x → (case b return (λ _ → Opt Code) of
                csnd y → (if c-same c-fuel x y then some (k e x) else none)
                _ → none)
    _ → none
eta-at k p e = none
