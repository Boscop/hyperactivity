exch-l : (X : Type 1) → Line (Line X) → Line (Line X)
exch-l X Q =
  ((fst (fst Q) , fst (fst (snd Q)) , λ i → fst (snd (snd Q) i)) ,
   (fst (snd (fst Q)) , fst (snd (fst (snd Q))) , λ i → fst (snd (snd (snd Q) i))) ,
   λ j → (snd (snd (fst Q)) j , snd (snd (fst (snd Q))) j , λ i → snd (snd (snd (snd Q) i)) j))
