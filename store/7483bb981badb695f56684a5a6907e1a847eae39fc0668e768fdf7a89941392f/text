-- a definition whose value is its own stuck call is a copattern definition (observed field by
-- field, its quote is the call itself): its program is its checked code as written, the record of
-- its clauses under its parameters
is-rec-body : Code → Bool
is-rec-body (clam b) = is-rec-body b
is-rec-body (cann t T) = is-rec-body t
is-rec-body (crec dd fs) = true
is-rec-body c = false
