dm-parse-micro-usd : List Word → Word
dm-parse-micro-usd s =
  let intPart  = dm-parse-dec-go #0 s
      afterDot = h-after "." s
      fracPad  = list-append (h-take (toNat #6) afterDot) "000000"
      frac6    = dm-parse-dec-go #0 (h-take (toNat #6) fracPad)
  in if h-prefix (h-decimal intPart) s
     then if h-infix "." (h-take (toNat #16) s)
          then %wadd (%wmul intPart #1000000) frac6
          else %wmul intPart #1000000
     else #0
