-- a negative difference −D, or zero, against (B, A + 0) with D + B = A
zsub-neg2 : (l : List Bool) → (A B : Nat) → plus (bin-to-nat l) B ≡ A → zeq (zv (if bin-zero l then bz-zero else (false , l))) (B , plus A zero)
zsub-neg2 l A B = case l return λ m → plus (bin-to-nat m) B ≡ A → zeq (zv (if bin-zero m then bz-zero else (false , m))) (B , plus A zero) of
  nil → λ p → congN (λ z → plus z zero) (symN p)
  cons x r → λ p → transN (plus-zero A) (transN (symN p) (plus-comm (bin-to-nat (cons x r)) B))
