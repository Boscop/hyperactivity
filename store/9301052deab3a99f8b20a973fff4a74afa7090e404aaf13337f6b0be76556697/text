-- a body built in an environment, its result to arrive on out
sm-build : SmTm → SmEnv → Word → SmOut → SmOut
sm-build (sm-var i) e out (sm-out fx n) = sm-out (sm-pick e i out fx) n
sm-build (sm-num m) e out (sm-out fx n) = sm-out (smf-val out (smv-num m) (sm-era-env e fx)) n
sm-build (sm-lam b) e out (sm-out fx n) = sm-out (smf-val out (smv-lam b e) fx) n
sm-build (sm-inc a) e out (sm-out fx n) = sm-build a e n (sm-out (smf-op n (smo-inc out) fx) (%wsucc n))
sm-build (sm-app f a) e out o =
  let s = sm-split e o
      n = sm-n (sm-so s)
  in sm-build f (sm-sa s) n (sm-build a (sm-sb s) (%wsucc n) (sm-out (smf-op n (smo-app (%wsucc n) out) (sm-fx (sm-so s))) (%wadd n #2)))
