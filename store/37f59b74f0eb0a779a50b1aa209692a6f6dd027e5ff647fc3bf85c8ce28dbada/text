-- division: the divisor's enclosure holds no zero, so its value has a sign; 1/Xb is Y/(k+1) for the
-- positive k its magnitude gives, and the quotient's enclosure carries over to v = va/vb
div-core : (S S2 : List Bool) → (A B : IV) → (v va vb : (Nat × Nat) × Nat) → (Y : Nat × Nat) → (k : Nat) →
  bcanon S ≡ true → le (suc zero) (bin-to-nat S) → bin-to-nat S2 ≡ times (bin-to-nat S) (bin-to-nat S) →
  ivc A × encl S A (fst va) (snd va) → ivc B × encl S B (fst vb) (snd vb) → le (suc zero) (snd va) → le (suc zero) (snd vb) → iv-has-zero B ≡ false →
  zeq (zmul Y (fst vb)) (the (Nat × Nat) (times (snd vb) (suc k) , zero)) →
  zeq (zsc (fst v) (times (snd va) (suc k))) (zsc (zmul (fst va) Y) (snd v)) → encl S (iv-div S S2 A B) (fst v) (snd v)
div-core S S2 A B v va vb Y k cS hS hS2 RA RB la lb hz hY Qe = encl-qeq S (iv-div S S2 A B) (zmul (fst va) Y) (times (snd va) (suc k)) (fst v) (snd v)
  (iv-div-sound S S2 A B (fst va) (fst vb) Y (snd va) (snd vb) (suc k) cS hS hS2 (fst RA) (fst RB) lb hY hz (snd RA) (snd RB))
  Qe (le1-times (snd va) (suc k) la (le-one-suc k))
