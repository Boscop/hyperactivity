slh-branch : (idx bound : Nat) → (s1 s2 : Nat → Nat) →
  ((i : Nat) → fd-ltb i bound ≡ true → s1 i ≡ s2 i) →
  (ok : Bool) → fd-ltb idx bound ≡ ok →
  spec-slh-at ok idx s1 ≡ spec-slh-at ok idx s2
slh-branch idx bound s1 s2 pub true = λ h → let eq = pub idx h in λ i → (eq i , inl (eq i))
slh-branch idx bound s1 s2 pub false = λ h → refl
