rm-copy-elems : Word → Word → (MPtr → MPtr → REv Unit) → MPtr → MPtr → REv Unit
rm-copy-elems n es ce =
  %welimP (λ x → MPtr → MPtr → REv Unit) n (λ dst src → rm-ret unit)
    (λ j acc dst src → rm-then (acc dst src)
       (rm-bind (rm-off dst (wmul j es)) (λ d →
        rm-bind (rm-off src (wmul j es)) (λ s → ce d s))))
