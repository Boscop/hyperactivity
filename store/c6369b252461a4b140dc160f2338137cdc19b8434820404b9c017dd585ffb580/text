-- a zero sum of two nonpositives: the negative parts sum to zero
zr-ns : (x y : ZrC) → zr-np x ≡ true → zr-np y ≡ true → zr-ad x y ≡ zrz → plus (snd (zr-val x)) (snd (zr-val y)) ≡ zero
zr-ns x y hx hy e = cl-tr Nat (plus (snd (zr-val x)) (snd (zr-val y))) (plus (plus (fst (zr-val x)) (fst (zr-val y))) zero) zero (zr-sumz x y e)
  (λ i → plus (plus (zr-npv x hx i) (zr-npv y hy i)) zero)
