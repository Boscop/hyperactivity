xp-sound-snd : (g : List XpTy) → (p : XpExpr) → (A : XpTy) → ((T : XpTy) → xp-infer g p ≡ inl T → XpDer (g , p , T)) →
  (x : Sum XpTy Unit) → xp-infer g p ≡ x → xp-snd-ty x ≡ inl A → XpDer (g , xp-snd p , A)
xp-sound-snd g p A sp (inl t) ep h = xp-sound-snd-t g p A sp t ep h
xp-sound-snd g p A sp (inr u) ep h = Empty-rec (xp-inr-inl A h)
