-- Allocating a fresh block in hy_alloc returns a valid pointer whose slots read back in-bounds
cs-alloc-load-self : (hp : CsHeap) (blk : CsBlk) (idx : Nat) →
  cs-load (fst (cs-alloc hp blk)) (snd (cs-alloc hp blk)) idx ≡ cs-nth CsVal blk idx
cs-alloc-load-self hp blk idx =
  cong (λ o → case o return (λ _ → Opt CsVal) of none → none; some b → cs-nth CsVal b idx)
    (cs-nth-snoc-end CsBlk hp blk)
