bn-lut3-w64 : Word → Word → Word → Word → Word
bn-lut3-w64 imm a0 b0 c0 =
  let m = the Word (%wand imm #255)
      a = the Word (bn-w64 a0)
      b = the Word (bn-w64 b0)
      c = the Word (bn-w64 c0)
  in %wor (bn-lut3-minterm m #0 a b c)
     (%wor (bn-lut3-minterm m #1 a b c)
     (%wor (bn-lut3-minterm m #2 a b c)
     (%wor (bn-lut3-minterm m #3 a b c)
     (%wor (bn-lut3-minterm m #4 a b c)
     (%wor (bn-lut3-minterm m #5 a b c)
     (%wor (bn-lut3-minterm m #6 a b c)
           (bn-lut3-minterm m #7 a b c)))))))
