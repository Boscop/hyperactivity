cs-hy-app-partial-no-ub : (ev : CsHeap → CsEnv → CsExp → CsRes) (fns : CsFns) (hp0 : CsHeap) (fn ar n : Word) (fs : Lst CsVal) (vx : CsVal) →
  (toNat n ≡ cs-hlen CsVal fs) → (%weq (%wadd n #1) ar ≡ false) →
  let blk = lcons (csv-word fn) (lcons (csv-word ar) (lcons (csv-word n) fs))
  in cs-no-ub (cs-hy-app ev fns (fst (cs-alloc hp0 blk)) (snd (cs-alloc hp0 blk)) vx) ≡ true
cs-hy-app-partial-no-ub ev fns hp0 fn ar n fs vx hlen hlt =
  let blk = lcons (csv-word fn) (lcons (csv-word ar) (lcons (csv-word n) fs))
      hp1 = fst (cs-alloc hp0 blk)
      all = cs-snoc CsVal fs vx
  in cong cs-no-ub (cs-hy-app-clo-sound ev fns hp0 fn ar n fs vx hlen)
     ∙ cong (λ z → cs-no-ub (if z then cs-call-fn ev fns hp1 fn all else cs-hy-clo hp1 fn ar (%wadd n #1) all)) hlt
