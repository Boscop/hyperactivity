-- the rows of L from the steps: row i is the i-th entries of the earlier steps' multipliers, then t, then zeros
dy-rows : BZ → Nat → List (BZ × List BZ) → List (List BZ) → List (List BZ)
dy-rows t n steps act = case steps of
  nil → nil
  cons s ss → cons (dy-pad n (dy-app BZ (dy-heads act) (cons t nil))) (dy-rows t n ss (dy-app (List BZ) (dy-tails act) (cons (snd s) nil)))
