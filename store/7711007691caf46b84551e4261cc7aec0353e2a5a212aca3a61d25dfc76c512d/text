place-row-top-le : (y0 cellH xGap : Nat) → (ws : List Nat) → (xCur : Nat) →
  AllTopLe (plus cellH y0) (place-row xCur y0 cellH xGap ws)
place-row-top-le y0 cellH xGap nil = λ xCur → unit
place-row-top-le y0 cellH xGap (cons w ws) = λ xCur →
  ( leB-refl (plus cellH y0)
  , place-row-top-le y0 cellH xGap ws (plus xGap (plus w xCur)) )
