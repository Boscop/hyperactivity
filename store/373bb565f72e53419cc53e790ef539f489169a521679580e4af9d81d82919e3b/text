dsp-mem-mesh4-wasm : List Word
dsp-mem-mesh4-wasm =
  let hdr     = the (List Word) (cons #0 (cons #97 (cons #115 (cons #109 (cons #1 (cons #0 (cons #0 (cons #0 nil))))))))
      secType = the (List Word) (cons #1 (cons #11 (cons #1 (cons #96 (cons #6
                  (cons #125 (cons #125 (cons #125 (cons #125 (cons #125 (cons #125 (cons #1 (cons #125 nil)))))))))))))
      secFunc = the (List Word) (cons #3 (cons #2 (cons #1 (cons #0 nil))))
      secMem  = the (List Word) (cons #5 (cons #3 (cons #1 (cons #0 (cons #1 nil)))))
      secExp  = the (List Word) (cons #7 (cons #14 (cons #2
                  (cons #4 (cons #115 (cons #116 (cons #101 (cons #112 (cons #0 (cons #0
                  (cons #3 (cons #109 (cons #101 (cons #109 (cons #2 (cons #0 nil))))))))))))))))
      cZero   = the (List Word) (cons #67 (cons #0 (cons #0 (cons #0 (cons #0 nil)))))
      cHalf   = the (List Word) (cons #67 (cons #0 (cons #0 (cons #0 (cons #63 nil)))))
      bLoc    = the (List Word) (cons #1 (cons #8 (cons #125 nil)))
      -- Load q0..q3 -> locals 6..9, p0..p3 -> locals 10..13
      bLoad   = wa-concat (cons (dw-app (wa-ld #0) (wa-set #6))
                          (cons (dw-app (wa-ld #4) (wa-set #7))
                          (cons (dw-app (wa-ld #8) (wa-set #8))
                          (cons (dw-app (wa-ld #12) (wa-set #9))
                          (cons (dw-app (wa-ld #16) (wa-set #10))
                          (cons (dw-app (wa-ld #20) (wa-set #11))
                          (cons (dw-app (wa-ld #24) (wa-set #12))
                          (cons (dw-app (wa-ld #28) (wa-set #13)) nil))))))))
      -- Coupled 4-node ring Laplacian + cubic Duffing Verlet momentum updates
      bMom    = wa-concat (cons (wa-mesh4-mom #6 #7 #9 (wa-get #0))
                          (cons (wa-mesh4-mom #7 #8 #6 (wa-get #1))
                          (cons (wa-mesh4-mom #8 #9 #7 cZero)
                          (cons (wa-mesh4-mom #9 #6 #8 cZero) nil))))
      -- Position updates + store back q0..q3, p0..p3
      bPos    = wa-concat (cons (wa-mesh4-pos #6) (cons (wa-mesh4-pos #7)
                          (cons (wa-mesh4-pos #8) (cons (wa-mesh4-pos #9) nil))))
      bStore  = wa-concat (cons (wa-st #0 #6) (cons (wa-st #4 #7) (cons (wa-st #8 #8) (cons (wa-st #12 #9)
                          (cons (wa-st #16 #10) (cons (wa-st #20 #11) (cons (wa-st #24 #12) (cons (wa-st #28 #13) nil))))))))
      -- Orthogonal Hadamard 4x4 stereo diffusion stored at mem[32] (outL) & mem[36] (outR)
      s01     = wa-bin #146 (wa-get #6) (wa-get #7)
      d01     = wa-bin #147 (wa-get #6) (wa-get #7)
      s23     = wa-bin #146 (wa-get #8) (wa-get #9)
      d23     = wa-bin #147 (wa-get #8) (wa-get #9)
      h0      = wa-bin #148 cHalf (wa-bin #146 s01 s23)
      h1      = wa-bin #148 cHalf (wa-bin #146 d01 d23)
      h2      = wa-bin #148 cHalf (wa-bin #147 s01 s23)
      h3      = wa-bin #148 cHalf (wa-bin #147 d01 d23)
      outL    = wa-bin #148 cHalf (wa-bin #146 h0 h3)
      outR    = wa-bin #148 cHalf (wa-bin #146 h1 h2)
      bOut    = wa-concat (cons (cons #65 (cons #32 (dw-app outL (cons #56 (cons #2 (cons #0 nil))))))
                          (cons (cons #65 (cons #36 (dw-app outR (cons #56 (cons #2 (cons #0 nil))))))
                          (cons (wa-bin #148 cHalf (wa-bin #146 (wa-ld #32) (wa-ld #36)))
                          (cons (cons #11 nil) nil))))
      body    = wa-concat (cons bLoc (cons bLoad (cons bMom (cons bPos (cons bStore (cons bOut nil))))))
      cPay    = cons #1 (dw-app (dw-uleb (dw-len body)) body)
      secCode = cons #10 (dw-app (dw-uleb (dw-len cPay)) cPay)
  in wa-concat (cons hdr (cons secType (cons secFunc (cons secMem (cons secExp (cons secCode nil))))))
