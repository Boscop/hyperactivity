-- 3D perspective projection at yaw=14° (cos=9703, sin=2419), pitch=9° (cos=9877, sin=1564), dist=36000
-- Returns ((px_x*10, px_y*10), depth_z_scaled)
proj-3d : SInt → SInt → SInt → (Word × Word) × SInt
proj-3d x y z =
  let x1 = si-add (fx-mul x (sp #9703)) (fx-mul z (sp #2419))
      z1 = si-sub (fx-mul z (sp #9703)) (fx-mul x (sp #2419))
      y2 = si-sub (fx-mul y (sp #9877)) (fx-mul z1 (sp #1564))
      z2 = si-add (fx-mul y (sp #1564)) (fx-mul z1 (sp #9877))
      den = si-sub (sp #36000) z2
      sx = si-div (si-mul x1 (sp #36000)) den
      sy = si-div (si-mul y2 (sp #36000)) den
      px = si-abs (si-add (sp #1280) (si-div-w (si-mul sx (sp #1380)) fx-S))
      py = si-abs (si-sub (sp #1280) (si-div-w (si-mul sy (sp #1380)) fx-S))
  in ((px , py) , z2)
