chem-rdm2-hubbard-sos-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-rdm2-hubbard-sos-poly A ad mu q vs =
  (λ g sub sq →
    let u = g 0; t = g 1; e0 = g 2; c0 = g 3; c1 = g 4
        q2 = q (fn-q 2 1); q4 = q (fn-q 4 1)
        ume = sub u e0
        ener = sub (sub (mu u (sq c1)) (mu q4 (mu t (mu c0 c1)))) (mu e0 (ad (sq c0) (sq c1)))
        sos  = sq (sub (mu ume c1) (mu q2 (mu t c0)))
        lhs  = sub (mu ume ener) sos
        char = sub (sub (sq e0) (mu u e0)) (mu q4 (sq t))
        rhs  = mu (sq c0) char
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
