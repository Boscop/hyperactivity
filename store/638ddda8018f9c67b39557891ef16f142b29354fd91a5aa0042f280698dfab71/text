ev-field : {l : Level} {S : Sig} {V : Type} → LayEnv → Word → Word → MPtr → Ev {l} S V (MPtr × MTy)
ev-field {l} {S} {V} env id name p =
  ev-bind {l} {S} {V} {Word × MTy} {MPtr × MTy} (ev-res {l} {S} {V} {Word × MTy} (fld-off env id name)) (λ ot →
  ev-bind {l} {S} {V} {MPtr} {MPtr × MTy} (ev-off {l} {S} {V} p (fst ot)) (λ q → ev-ret {l} {S} {V} {MPtr × MTy} (q , snd ot)))
