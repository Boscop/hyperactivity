-- a module dropped from the source: its path no longer names it, nor do its names their pieces
h-unrecord-names : List (List Word) → Proc W Unit
h-unrecord-names nil = ret unit
h-unrecord-names (cons n r) = bind (h-unlink (list-append h-source (list-append "/written/" (h-hex n)))) (λ u →
  bind (h-unlink (list-append h-source (list-append "/module-of/" (h-hex n)))) (λ u2 → h-unrecord-names r))
