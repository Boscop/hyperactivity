-- bit 0 after an update of bit j ≥ 1 (j literal where it is used: the hypotheses compute)
bu-bit0-other : (x v j : Word) → wbit (wshl #1 j) #0 ≡ false → wlt #0 j ≡ true → wbit (bv-update #32 x j j v) #0 ≡ wbit x #0
bu-bit0-other x v j h1 h2 =
  cong (λ m → wbit (wor (wxor x (wand x m)) (wshl v j)) #0) (upd-mask1 j)
  ∙ wbit-or (wxor x (wand x (wshl #1 j))) (wshl v j) #0
  ∙ cong2 (λ p q → bit-or p q) (wbit-xor x (wand x (wshl #1 j)) #0 ∙ cong (λ q → bit-xor (wbit x #0) q) (wbit-and x (wshl #1 j) #0 ∙ cong (λ q → bit-and (wbit x #0) q) h1))
                               (wbit-shl v j #0 ∙ cong (λ c → if c then false else wbit v (wsub #0 j)) h2)
  ∙ bit-keep (wbit x #0)
