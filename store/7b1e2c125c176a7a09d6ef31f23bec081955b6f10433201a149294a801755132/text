-- wml32: from linear_memory.sail (it calls what is defined after it there)
-- (part of language-support)
wml32 : (lin_addr : Bits #48) → (sailval : Bits #32) → MS Unit
wml32 lin_addr sailval =
  onS {Bool} {Unit} (canonical_address_p (bv-signed #48 lin_addr)) (λ t'1 →
    onS {Unit} {Unit} (fl-assert {exception} t'1 #158444082776146152862243554262028736828230367590706) (λ _ →
      let three__plus_lin_addr : Bits #49
          three__plus_lin_addr = (bits_of_int (z-add (zpos #3) (bv-signed #48 lin_addr)) (zpos #49))
      in onS {Bool} {Unit} (canonical_address_p (bv-signed #49 three__plus_lin_addr)) (λ t'3 →
           λ σ →
             if t'3 then
               the (MS Unit)
                 (wb #48 (zpos #4) lin_addr #14935 sailval) σ
             else
               the (MS Unit)
                 (liftS {Unit} (x86_model_error {Unit} #512936915762)) σ)))
