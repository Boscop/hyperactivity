pm-xor-assoc : (a b c : Bool) → pm-xor (pm-xor a b) c ≡ pm-xor a (pm-xor b c)
pm-xor-assoc true b c =
  case b return (λ y → pm-xor (not y) c ≡ not (pm-xor y c)) of
    true → (case c return (λ z → z ≡ not (not z)) of true → (λ i → true); false → (λ i → false))
    false → (λ i → not c)
pm-xor-assoc false b c = λ i → pm-xor b c
