-- 3. Exact Algebraic Boltzmann Gap Dominance (Zero Reals / Zero Exponentials)
-- ============================================================================
-- Universal polynomial margin identity: x·W - M·W = (x - M)·W.
-- Variables (0..2): x (fugacity), M (misfold count), W (base weight x^{E*-1}).
fold-boltzmann-margin-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
fold-boltzmann-margin-poly A ad mu q vs =
  (λ g sub →
    let x = g 0; M = g 1; W = g 2
    in (sub (mu x W) (mu M W) , mu (sub x M) W))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
