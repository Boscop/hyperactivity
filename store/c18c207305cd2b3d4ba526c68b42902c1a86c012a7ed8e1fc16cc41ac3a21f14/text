-- ---------------------------------------------------------------- 2. Disagreement blocks activation
-- If two models in the observation fiber disagree on intervention u (`Disagreement` from
-- chem/basin-compose.cub), no Warranted witness exists for any target, so `sg-activate` for
-- `W = Warranted M O I R obs y run target u` cannot be constructed.
disagreement-blocks-activation : (M O I R : Type 0)
  → (obs : M → O) → (y : O) → (run : M → I → R) → (target : R) → (u : I)
  → Disagreement M O I R obs y run u
  → Neg (Warranted M O I R obs y run target u)
disagreement-blocks-activation M O I R obs y run target u d =
  disagreement-refutes-warrant M O I R obs y run u d target
