syn3-pos-id-raw : (a b c : Bool) → syn3 (unit-err (pos-of-syn3 (a , (b , c)))) ≡ (a , (b , c))
syn3-pos-id-raw false false false = λ _ → (false , (false , false))
syn3-pos-id-raw true  false false = λ _ → (true  , (false , false))
syn3-pos-id-raw false true  false = λ _ → (false , (true  , false))
syn3-pos-id-raw true  true  false = λ _ → (true  , (true  , false))
syn3-pos-id-raw false false true  = λ _ → (false , (false , true))
syn3-pos-id-raw true  false true  = λ _ → (true  , (false , true))
syn3-pos-id-raw false true  true  = λ _ → (false , (true  , true))
syn3-pos-id-raw true  true  true  = λ _ → (true  , (true  , true))
