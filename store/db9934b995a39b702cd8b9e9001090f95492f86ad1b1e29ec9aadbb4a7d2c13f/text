-- ============================================================================
-- 1. Soundness of Deterministic Dual-Bracket Pruning (Zero Randomness)
-- ============================================================================
-- If `lb` is a certified lower bound on subtree `InB : C → Type 0` (every x in B has lb ≤ E x)
-- and incumbent `cstar` satisfies E cstar ≤ lb, then E cstar ≤ E x for ALL x in B!
bb-prune-sound :
  (C : Type 0) → (E : C → Nat) → (InB : C → Type 0) →
  (lb : Nat) → ((x : C) → InB x → leb lb (E x) ≡ true) →
  (cstar : C) → leb (E cstar) lb ≡ true →
  (x : C) → InB x → leb (E cstar) (E x) ≡ true
bb-prune-sound C E InB lb valid-lb cstar beats-lb x inb =
  bb2-leb-trans (E cstar) lb (E x) beats-lb (valid-lb x inb)
