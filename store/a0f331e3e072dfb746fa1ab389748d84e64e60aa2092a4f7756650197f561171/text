-- Classify exact Lafont/HVM rewrite rule for any active pair (k1, lab1) <-> (k2, lab2):
classify-cut : CellKind → Word → CellKind → Word → CutRule
classify-cut ck-era _  _      _  = cr-era
classify-cut _      _  ck-era _  = cr-era
classify-cut ck-ref _  _      _  = cr-unf
classify-cut _      _  ck-ref _  = cr-unf
classify-cut ck-con _  ck-con _  = cr-ann
classify-cut ck-dup l1 ck-dup l2 = if %weq l1 l2 then cr-ann else cr-com
classify-cut ck-dup _  ck-con _  = cr-com
classify-cut ck-con _  ck-dup _  = cr-com
classify-cut ck-dup _  ck-sup _  = cr-com
classify-cut ck-sup _  ck-dup _  = cr-com
classify-cut ck-op  _  ck-num _  = cr-op
classify-cut ck-num _  ck-op  _  = cr-op
classify-cut _      _  _      _  = cr-inert
