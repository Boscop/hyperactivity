-- ---------------------------------------------------------------- 2. disjoint peer cuts commute without coordination
-- Partitioned state of two peers holding local active pairs and local CAS pools:
record TwoPeerNet (K : Type) (V : Type) =
  { pn-cut-a : ICAgent K × ICAgent K
  ; pn-cut-b : ICAgent K × ICAgent K
  ; pn-out-a : Sum Unit (CutOutcome K)
  ; pn-out-b : Sum Unit (CutOutcome K)
  ; pn-pool-a : CAStore K V
  ; pn-pool-b : CAStore K V
  }
