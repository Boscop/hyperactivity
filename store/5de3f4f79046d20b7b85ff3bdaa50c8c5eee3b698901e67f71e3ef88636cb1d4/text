-- the least-energy assignment among ns that obey Gauss's law, with its energy, from the best so far
ground-from : List NetVertex → List SQ → List (List SQ) → List SQ × List Rad → List SQ × List Rad
ground-from vs qs ns best = case ns of
  nil → best
  cons n rest → ground-from vs qs rest (if net-gauss vs n qs then ground-pick n (net-energy vs n) best else best)
