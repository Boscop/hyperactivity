-- ---------------------------------------------------------------- pointers as addresses
-- null is 0; a function's address is its id + 1 (below the Target's first base); mp-obj a o,
-- which no handler produces, is a + o
mp-address : MPtr → Word
mp-address p = case p of
  mp-null → #0
  mp-obj a o → wadd a o
  mp-fn f → wadd f #1
  mp-addr x → x
