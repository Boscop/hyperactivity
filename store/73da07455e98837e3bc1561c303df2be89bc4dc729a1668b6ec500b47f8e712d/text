-- Binary constant propagation & dead-cone elimination (0 & y → 0, 1 & y → y, 0 | y → y, 1 | y → 1, 0 ^ y → y, 1 ^ y → ~y)
opt-2-l0 : {V : Type} → B2 → B0 → Circ B0 B1 B2 V → Circ B0 B1 B2 V
opt-2-l0 b2-and b0-false y = cop0 b0-false
opt-2-l0 b2-and b0-true  y = y
opt-2-l0 b2-or  b0-false y = y
opt-2-l0 b2-or  b0-true  y = cop0 b0-true
opt-2-l0 b2-xor b0-false y = y
opt-2-l0 b2-xor b0-true  y = opt-not y
