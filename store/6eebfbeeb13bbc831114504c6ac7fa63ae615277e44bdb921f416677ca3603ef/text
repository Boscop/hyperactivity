mw-fn-body : List (Word × Word) → List Word
mw-fn-body gs =
  let ng     = ms-count-gates gs
      locHdr = the (List Word) (cons #1 (cons ng (cons #127 nil)))
      ops    = mw-gate-ops #4 gs
      retOut = the (List Word) (cons #32 (cons (%wadd #3 ng) (cons #11 nil)))
      body   = ms-cat (cons locHdr (cons ops (cons retOut nil)))
  in list-append (mw-uleb (mw-len body)) body
