-- a body with every variable of the context replaced by its form
nk-sub-forms : NkTm → Word → NkTm → NkTm
nk-sub-forms ctx n (nk-free x) = if %wlt x n then nk-cform ctx n x else nk-free x
nk-sub-forms ctx n (nk-lam b) = nk-lam (nk-sub-forms ctx n b)
nk-sub-forms ctx n (nk-con c as) = nk-con c (nk-sub-forms ctx n as)
nk-sub-forms ctx n (nk-op h p as) = nk-op h (nk-sub-forms ctx n p) (nk-sub-forms ctx n as)
nk-sub-forms ctx n (nk-match h p cs) = nk-match h (nk-sub-forms ctx n p) (nk-sub-forms ctx n cs)
nk-sub-forms ctx n (nk-cons t r) = nk-cons (nk-sub-forms ctx n t) (nk-sub-forms ctx n r)
nk-sub-forms ctx n t = t
