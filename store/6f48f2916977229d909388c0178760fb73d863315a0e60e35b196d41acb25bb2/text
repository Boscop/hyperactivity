-- Unmatched tags hit default: abort() (cs-abort), never falling off switch into uninitialized r<d> UB
cs-switch-default-no-ub : (ev : CsHeap → CsEnv → CsExp → CsRes) (hp : CsHeap) (env : CsEnv) (ptr : CsVal) (tag : Word) →
  cs-no-ub (cs-eval-switch ev hp env ptr tag cs-br-nil) ≡ true
cs-switch-default-no-ub ev hp env ptr tag = refl
