-- from b < a (strictly), b ≤ a
zle-of-false : (x y : BZ) → bcanon (snd x) ≡ true → bcanon (snd y) ≡ true → bz-le x y ≡ false → zle (zv y) (zv x)
zle-of-false x y cx cy h = le-cong-l (plus (snd (zv x)) (fst (zv y))) (plus (fst (zv y)) (snd (zv x))) (plus (fst (zv x)) (snd (zv y)))
  (le-of-lt (plus (snd (zv x)) (fst (zv y))) (plus (fst (zv x)) (snd (zv y))) (bz-le-false (fst x) (snd x) (fst y) (snd y) cx cy h))
  (plus-comm (snd (zv x)) (fst (zv y)))
