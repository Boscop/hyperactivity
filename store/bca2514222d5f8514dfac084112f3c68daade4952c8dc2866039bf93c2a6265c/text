prim-ty k =
  if %wlt k #512
    then (let sb = %wsub k #256
          in if %weq sb #35 then %pty #0 else if %weq sb #36 then Word else if %weq sb #37 then %pty #1
             else if %weq sb #38 then Word else if %weq sb #39 then %pty #2 else if %weq sb #40 then %pty #2
             else if %weq sb #41 then %pty #0 else if %weq sb #42 then %pty #0 else if %weq sb #43 then %pty #2
             else if %weq sb #44 then %pty #1 else if %weq sb #45 then %pty #3 else if %weq sb #46 then %pty #5 else Word)
    else if %wlt k #768
      then (let sb = %wsub k #512
            in if %wlt sb #3 then %pty #0 else if %wlt sb #5 then Bool else if %wlt sb #8 then %pty #1
               else if %wlt sb #10 then Bool else if %wlt sb #14 then %pty #2 else if %wlt sb #16 then Bool
               else if %wlt sb #19 then %pty #5 else if %wlt sb #21 then Bool else if %wlt sb #28 then %pty #5 else %pty #0)
      else if %wlt k #1024 then (if %weq (%wsub k #768) #8 then %pty #0 else %pty #1)
      else if %wlt k #1280 then opq else if %wlt k #1536 then Word else opq
