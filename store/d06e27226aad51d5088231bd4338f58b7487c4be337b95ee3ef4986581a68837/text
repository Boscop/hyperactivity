omega-cert hs a b =
  let n = %wsucc (lst-len hs)
  in obind (linearize a) (λ la → obind (linearize b) (λ lb → obind (hyp-cons hs #0 n) (λ cs0 →
       let cs = lcons (unit-vec (lst-len hs) n , (lin-add lb (lin-const #1) , la)) cs0
           out = fm-all (all-vars cs) cs
       in obind (contra out) (λ ms →
            let p = split-last ms
            in if %weq (snd p) #0 then none
               else obind (divide-by (snd p) (fst p)) (λ cert →
                      if check-cert hs cert a b then some cert else none)))))