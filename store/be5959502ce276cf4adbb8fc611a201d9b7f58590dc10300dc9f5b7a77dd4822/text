-- Carryless 32-bit range decoder renormalization (at most 4 bytes)
hcm-renorm-dec : Nat → Word → Word → Word → Word → Word → Word → (Word → Word → Word → Word → Step W Word) → Step W Word
hcm-renorm-dec zero lo hi code inb ipos ilen k = k lo hi code ipos
hcm-renorm-dec (suc fuel) lo hi code inb ipos ilen k =
  if %wlt (%wxor lo hi) #16777216 then
    if %wlt ipos ilen then
      scmd (w-load8 (%wadd inb ipos)) (λ nb →
        hcm-renorm-dec fuel (%wand (%wshl lo #8) #4294967295) (%wand (%wor (%wshl hi #8) #255) #4294967295)
          (%wand (%wor (%wshl code #8) nb) #4294967295) inb (%wsucc ipos) ilen k)
    else
      hcm-renorm-dec fuel (%wand (%wshl lo #8) #4294967295) (%wand (%wor (%wshl hi #8) #255) #4294967295)
        (%wand (%wshl code #8) #4294967295) inb ipos ilen k
  else k lo hi code ipos
