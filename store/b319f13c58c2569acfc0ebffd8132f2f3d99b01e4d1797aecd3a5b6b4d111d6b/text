fd-ends n x rs h = case n of
  zero → true
  suc m → if bit-eq (eqb (fd-zk m 4 x rs) (fd-zk m 5 x rs)) (not (if sl-bit m 0 then sl-bit m 5 else false))
    then (if fd-des m h then (if sl-bit m 0 then (if sl-bit m 5 then fd-ends m x rs h else false) else false) else fd-ends m x rs h)
    else false
