-- every comment of the store (its statements, its documentation) and every document, a comment block
-- or a paragraph at a time, cut into sentences, one a line (a line longer than 600 characters is no
-- sentence and is left out)
c-record-cmd : List Word
c-record-cmd = c-dq "{ cat store/[0-9a-f]*/text | sed 's/^-- \{0,1\}//; t; s/.*//'; xargs -a build/chat/docs cat; } | sed 's/^ *$/\x1e/' | tr '\n\t' '  ' | tr '\036' '\n' | sed 's/\([.!?]\)  */\1\n/g' | sed 's/   */ /g; s/^ //' | grep -E '^.{30,600}$' | grep '[a-z]' > build/chat/record.tmp && mv build/chat/record.tmp build/chat/record"
