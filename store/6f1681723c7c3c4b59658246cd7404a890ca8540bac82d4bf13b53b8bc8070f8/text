max-cmp-stage : Nat → List Word → Word → Word → List Word
max-cmp-stage zero _ _ _ = nil
max-cmp-stage (suc rem) pfx st k =
  let prev = %wsub st #1
      lo   = %wmul k #2
      hi   = %wsucc lo
      glo  = max-gname pfx prev lo
      plo  = max-pname pfx prev lo
      ghi  = max-gname pfx prev hi
      phi  = max-pname pfx prev hi
      go   = max-gname pfx st k
      po   = max-pname pfx st k
      pg   = sv-concat (cons pfx (cons "_pg" (cons (epfl-dec st) (cons "_" (cons (epfl-dec k) nil)))))
  in sv-concat
       (cons (epfl-gate2 phi glo pg "11")
       (cons (epfl-or2-blif ghi pg go)
       (cons (epfl-gate2 phi plo po "11")
       (cons (max-cmp-stage rem pfx st (%wsucc k)) nil))))
