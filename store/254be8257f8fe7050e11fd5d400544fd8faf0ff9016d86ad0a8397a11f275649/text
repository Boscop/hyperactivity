tir-thm-conj-iter :
  {X : Type} → (enc dec : X → X) → (inv : (x : X) → dec (enc x) ≡ x) →
  (f : X → X) → (n : Nat) → (x : X) →
  tir-iter n (λ y → enc (f (dec y))) (enc x) ≡ enc (tir-iter n f x)
tir-thm-conj-iter enc dec inv f zero    x = refl
tir-thm-conj-iter enc dec inv f (suc n) x =
  tir-trans
    (cong (λ y → enc (f (dec y))) (tir-thm-conj-iter enc dec inv f n x))
    (cong (λ z → enc (f z)) (inv (tir-iter n f x)))

tir-conj-op : TirCube4 → (TirCube4 → TirCube4) → TirCube4 → TirCube4
tir-conj-op k f y = tir-mask4 k (f (tir-mask4 k y))

tir-thm-homeomorphic-iter :
  (k : TirCube4) → (f : TirCube4 → TirCube4) → (n : Nat) → (x : TirCube4) →
  tir-iter n (tir-conj-op k f) (tir-mask4 k x) ≡ tir-mask4 k (tir-iter n f x)
tir-thm-homeomorphic-iter k f n x =
  tir-thm-conj-iter (tir-mask4 k) (tir-mask4 k) (tir-thm-mask4-invol k) f n x

tir-thm-homeomorphic-decode :
  (k : TirCube4) → (f : TirCube4 → TirCube4) → (n : Nat) → (x : TirCube4) →
  tir-mask4 k (tir-iter n (tir-conj-op k f) (tir-mask4 k x)) ≡ tir-iter n f x
tir-thm-homeomorphic-decode k f n x =
  tir-trans
    (cong (tir-mask4 k) (tir-thm-homeomorphic-iter k f n x))
    (tir-thm-mask4-invol k (tir-iter n f x))

