-- Technology Mapping Soundness Theorem: every synthesized NAND2 standard-cell netlist matches behavioral RTL!
tech-map-sound : {V : Type} → (env : V → Bool) → (c : Circ B0 B1 B2 V) →
  fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env (tech-map c) ≡
  fold {B0} {B1} {B2} {V} {Bool} bool-alg env c
tech-map-sound {V} env c =
  case c return (λ w →
    Path Bool
      (fold {B0} {Empty} {Unit} {V} {Bool} nand-alg env (tech-map {V} w))
      (fold {B0} {B1} {B2} {V} {Bool} bool-alg env w)) of
    cwire v → refl
    cop0 k → refl
    cop1 u a →
      tech-map-1-sound env u (tech-map {V} a) (fold {B0} {B1} {B2} {V} {Bool} bool-alg env a) (rec a)
    cop2 b x y →
      tech-map-2-sound env b (tech-map {V} x) (tech-map {V} y)
        (fold {B0} {B1} {B2} {V} {Bool} bool-alg env x)
        (fold {B0} {B1} {B2} {V} {Bool} bool-alg env y)
        (rec x) (rec y)
