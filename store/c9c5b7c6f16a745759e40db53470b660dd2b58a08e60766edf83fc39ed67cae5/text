-- hy-lock (part of language-implementation-remainder): the write lock taken. The lock file is opened (created if absent) and locked whole for
-- this process (open, then flock exclusive: system calls 2 and 73); a second writer waits here until
-- the first process ends, when the system releases it, also if that process dies. The result is the
-- file's number, or a number of 2^63 or more if either call failed
hy-lock : Proc W Word
hy-lock = with-bytes {Word} #32 (λ p → bind (h-poke p (list-append "build/write-lock" (cons #0 nil))) (λ u →
  bind (sys-call #2 p #66 #420 #0 #0 #0) (λ fd →
  if wlt fd #9223372036854775808 then bind (sys-call #73 fd #2 #0 #0 #0 #0) (λ r → ret (if wlt r #9223372036854775808 then fd else r)) else ret fd)))
