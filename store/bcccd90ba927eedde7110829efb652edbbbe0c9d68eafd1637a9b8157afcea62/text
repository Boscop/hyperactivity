-- from the machine's comparison
ltw-lt-step : (n : Word) → ((b : Word) → ltw n b ≡ true → Ltw n b) → (b : Word) → ltw (%wsucc n) b ≡ true → Ltw (%wsucc n) b
ltw-lt-step n ih b =
  %welimP (λ v → ltw (%wsucc n) v ≡ true → Ltw (%wsucc n) v) b
    (λ h → ft-absurd (Ltw (%wsucc n) #0) h)
    (λ m g h → (fst (ih m h) , catw (wadd-suc-l (%wsucc n) (fst (ih m h))) (congw (λ z → %wsucc z) (snd (ih m h)))))
