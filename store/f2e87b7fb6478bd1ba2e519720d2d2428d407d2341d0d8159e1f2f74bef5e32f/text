lc-run : Step W Unit
lc-run =
  to-step
    (bind (h-env "HX_LIGHTNING_CMD") (λ eCmd →
      case eCmd of
        inr c → bind (lc-cmd-execute (h-eq c "strike")) (λ u → exit #0)
        inl u →
          bind h-args (λ argv →
            if lc-is-direct argv
            then bind (lc-cmd-execute (lc-is-strike-arg (h-tail-lists argv))) (λ u2 → exit #0)
            else ret {lzero} {W} unit)))
