hy-unexplained-file : List (List Word) → List Word × List (List Word) → List Word
hy-unexplained-file have e = if h-null (h-concat (hy-not-in have (snd e))) then nil
  else list-append (h-line (list-append (fst e) (list-append "  (" (list-append (h-decimal (fromNat (list-length (hy-not-in have (snd e))))) ")")))) (h-indented "  " (hy-not-in have (snd e)))
