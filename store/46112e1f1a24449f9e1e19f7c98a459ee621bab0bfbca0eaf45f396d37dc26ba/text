hy-write : List Word → List Word → List (List Word) → List Word → Proc W Unit
hy-write st m nil t = h-fail "hyperactive write NAME [after OTHER], the declaration on standard input"
hy-write st m (cons name rest) t = if h-ends ".cub" name then bind (hy-head-of st name) (hy-write-head st m name (hy-nl t))
  else if hy-document name then bind (h-record m name t) (λ u → bind (hy-version "modules" (h-hex name)) (λ vu → h-out (h-line (list-append name "   (a document, written whole)"))))
  else if andB (h-not (h-null (h-concat rest))) (h-not (h-eq (hy-head rest) "after"))
  then hy-write-many st m (cons name rest) (hy-cut rest nil nil (h-split #10 (hy-nl t)))
  else bind (hy-get st (list-append "written/" (h-hex name))) (λ w → hy-write-to st m name rest (hy-nl t) w)
