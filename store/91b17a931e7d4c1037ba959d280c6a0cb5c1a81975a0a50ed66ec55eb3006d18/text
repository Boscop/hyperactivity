-- ---------------------------------------------------------------- 2. Byte-Level Calma GDSII v6.0 Codec & Lossless Round-Trip Proof
-- Every GDSII record is big-endian bytes: [len_hi, len_lo, rec_type, data_type, ...payload...].
-- Mandatory v6.0 header (114 bytes):
--   HEADER  (6B):  00 06 00 02 02 58                   (version 600)
--   BGNLIB  (28B): 00 1C 01 02 [2026-11-23 00:00 x 2]  (12 int16 timestamps)
--   LIBNAME (14B): 00 0E 02 06 "HYPERCHIP\0"           (even-padded ASCII)
--   UNITS   (20B): 00 14 03 05 [1e-3 um] [1e-9 m]      (two 8B IBM System/360 excess-64 floats)
--   BGNSTR  (28B): 00 1C 05 02 [2026-11-23 00:00 x 2]
--   STRNAME (18B): 00 12 06 06 "HYPERCORE_SOC\0"
gds6-header-bytes : List Word
gds6-header-bytes =
  sv-concat
    (cons (gds-u16s (cons #6 (cons gds-rec-header (cons #600 nil))))
    (cons (gds-u16s (cons #28 (cons gds-rec-bgnlib nil)))
    (cons gds-timestamp-bytes
    (cons (gds-u16s (cons #14 (cons #518 nil)))
    (cons (list-append "HYPERCHIP" (cons #0 nil))
    (cons (gds-u16s (cons #20 (cons #773 nil)))
    (cons (cons #62 (cons #65 (cons #137 (cons #55 (cons #75 (cons #198 (cons #167 (cons #240 nil))))))))
    (cons (cons #57 (cons #68 (cons #184 (cons #47 (cons #160 (cons #155 (cons #90 (cons #83 nil))))))))
    (cons (gds-u16s (cons #28 (cons gds-rec-bgnstr nil)))
    (cons gds-timestamp-bytes
    (cons (gds-u16s (cons #18 (cons #1542 nil)))
    (cons (list-append "HYPERCORE_SOC" (cons #0 nil)) nil))))))))))))
