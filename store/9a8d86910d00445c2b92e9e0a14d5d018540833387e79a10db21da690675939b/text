dm-solana-slot : Proc W Word
dm-solana-slot =
  let req = h-concat
              (cons "{" (cons (h-quote "jsonrpc") (cons ":" (cons (h-quote "2.0")
              (cons "," (cons (h-quote "id") (cons ":1,"
              (cons (h-quote "method") (cons ":" (cons (h-quote "getSlot")
              (cons "," (cons (h-quote "params") (cons ":[]}" nil)))))))))))))
  in bind (dm-http-post-json "https://api.mainnet-beta.solana.com" req) (λ resp →
     let afterRes = h-after (list-append (h-quote "result") ":") resp
     in ret {lzero} {W} (dm-parse-dec-go #0 afterRes))
