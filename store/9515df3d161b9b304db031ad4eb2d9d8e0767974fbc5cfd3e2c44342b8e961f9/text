-- the later of two stores to one address
st-same : (m : ByteMap) → (a : Word) → (v : Word) → (u : Word) → mem-store (mem-store m a u) a v ≡ mem-store m a v
st-same m a v u = funExt (λ t →
  case weq t a return (λ c → weq t a ≡ c → (if c then v else mem-store m a u t) ≡ (if c then v else m t)) of
    true → λ e → refl
    false → λ e → cong (λ d → if d then u else m t) e
  refl)
