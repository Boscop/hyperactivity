-- Universal AREF polygon scaling law: repeating any sub-hierarchy `c × r` times with `extra` boxes
gds-rep-poly-law : (c r : Word) → (h : GdsHier) → (extra : List Gds6Box) →
  Path Word (gds-hier-polys (gh-rep c r h extra)) (%wadd (%wmul (%wmul c r) (gds-hier-polys h)) (fromNat (list-length extra)))
gds-rep-poly-law c r h extra = refl
