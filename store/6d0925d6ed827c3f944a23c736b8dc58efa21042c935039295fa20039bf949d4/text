kc-theta : List UInt64 → List UInt64
kc-theta st =
  let c0 = kc-col-xor st #0
      c1 = kc-col-xor st #1
      c2 = kc-col-xor st #2
      c3 = kc-col-xor st #3
      c4 = kc-col-xor st #4
      d0 = u64xor c4 (kc-rotl64 c1 #1)
      d1 = u64xor c0 (kc-rotl64 c2 #1)
      d2 = u64xor c1 (kc-rotl64 c3 #1)
      d3 = u64xor c2 (kc-rotl64 c4 #1)
      d4 = u64xor c3 (kc-rotl64 c0 #1)
      ds = cons d0 (cons d1 (cons d2 (cons d3 (cons d4 nil))))
  in kc-theta-loop (toNat #25) #0 st ds
