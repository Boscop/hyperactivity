mem-drop : (t : List (List Word)) → (h : Nat) → (s : List (List Word)) → MemOrNil t s → MemOrNil t (drop-n h s)
mem-drop t h =
  case h return λ w → (s : List (List Word)) → MemOrNil t s → MemOrNil t (drop-n w s) of
    zero → λ s m → m
    suc h1 → λ s → (case s return λ v → MemOrNil t v → MemOrNil t (drop-n (suc h1) v) of
                      nil → λ m → m
                      cons x r → λ m → rec h1 r (mem-tail t x r m))
