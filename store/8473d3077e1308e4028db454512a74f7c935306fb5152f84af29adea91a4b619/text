-- (part of language-support)
div_spec_16 : (dst' : Bits #32) → (src : Bits #16) → (Bool × (Bits #32) × (Bits #16))
div_spec_16 dst' src =
  let quotient : Bits #32
      quotient = (bits_of_int (floor2 (bv-unsigned #32 dst') (bv-unsigned #16 src)) (zpos #32))
      remainder : Bits #16
      remainder = (bits_of_int (mod (bv-unsigned #32 dst') (bv-unsigned #16 src)) (zpos #16))
      overflow? : Bool
      overflow? = (z-lt (zpos #65535) (bv-unsigned #32 quotient))
  in (if overflow? then (true , #0 , #0) else (overflow? , quotient , remainder))
