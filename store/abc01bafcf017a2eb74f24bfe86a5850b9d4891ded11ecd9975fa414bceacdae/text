-- ============================================================================
-- 2. Enzyme Transition-State Catalysis & Michaelis–Menten Conservation (Open Problem #7)
-- ============================================================================
-- Exact Pauling / Eyring transition-state stabilization identity:
--   Uncatalyzed barrier: ΔG‡_uncat = G_TS - G_S
--   Catalyzed barrier:   ΔG‡_cat   = (G_TS - B_TS) - (G_S - B_ES)
--   Exact barrier reduction: ΔG‡_uncat - ΔG‡_cat = B_TS - B_ES.
-- Proves catalysis depends strictly on DIFFERENTIAL stabilization of the transition state
-- over the ground-state enzyme–substrate complex (B_TS > B_ES), not uniform binding.
-- Variables (0..3): G_TS, G_S, B_TS, B_ES.
enzyme-ts-barrier-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
enzyme-ts-barrier-poly A ad mu q vs =
  (λ g sub →
    let gts = g 0; gs = g 1; bts = g 2; bes = g 3
        dg-uncat = sub gts gs
        dg-cat   = sub (sub gts bts) (sub gs bes)
        lhs = sub dg-uncat dg-cat
        rhs = sub bts bes
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
