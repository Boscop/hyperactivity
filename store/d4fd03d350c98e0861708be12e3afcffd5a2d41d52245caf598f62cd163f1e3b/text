-- a section of the front page: the works published of one kind, under its heading (none, no section)
s-section : List Word → List Word → WorkKind → Proc W (List Word)
s-section id title k = if h-null (s-of-kind k s-published) then ret {lzero} {W} nil else
  bind (s-work-lis (s-of-kind k s-published)) (λ ls → ret {lzero} {W} (h-concat (cons "<div class='section' id='" (cons id (cons "'>" (cons title (cons "</div><ul class='list'>" (cons ls (cons "</ul>" nil)))))))))
