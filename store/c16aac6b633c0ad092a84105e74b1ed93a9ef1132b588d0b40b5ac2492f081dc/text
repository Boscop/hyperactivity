nonpos-fv : (m : List Bool) → (v : Bool) → cmpN true (bin-to-nat m) zero ≡ v → (if v then true else not true) ≡ false → le (suc zero) (plus (bin-to-nat m) zero)
nonpos-fv m v = case v return λ u → cmpN true (bin-to-nat m) zero ≡ u → (if u then true else not true) ≡ false → le (suc zero) (plus (bin-to-nat m) zero) of
  true → λ e h → absurd-tf (le (suc zero) (plus (bin-to-nat m) zero)) h
  false → λ e h → (fst (cmp-false-lt (bin-to-nat m) zero e) , transN (snd (cmp-false-lt (bin-to-nat m) zero e)) (symN (plus-zero (bin-to-nat m))))
