-- 2F. Target 6: `Sky130 / GAA-3nm` Superchip Wire-Fabric `SystemVerilog` (`0`-gate `DUP` + `0`-gate `ERA`!):
bn-sv-expr : INetExpr → List Word
bn-sv-expr (in-lit w)        = list-append "64'd" (h-decimal (bn-w64 w))
bn-sv-expr in-var0           = "x0"
bn-sv-expr (in-dup-add x)    = h-concat (cons "((" (cons (bn-sv-expr x) (cons ") << 1)" nil)))
bn-sv-expr (in-add a b)      = h-concat (cons "(" (cons (bn-sv-expr a) (cons " + " (cons (bn-sv-expr b) (cons ")" nil)))))
bn-sv-expr (in-xor a b)      = h-concat (cons "(" (cons (bn-sv-expr a) (cons " ^ " (cons (bn-sv-expr b) (cons ")" nil)))))
bn-sv-expr (in-era-l _ live) = bn-sv-expr live
bn-sv-expr (in-lut3 m a b c) = list-append "64'd" (h-decimal (bn-lut3-w64 m (inet-eval #0 a) (inet-eval #0 b) (inet-eval #0 c)))
