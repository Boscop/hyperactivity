-- a retraction is not an annotation: refuting a report's warrant refutes the report. A report whose
-- warrant has fallen is not a report with a flag on it, it is an absurdity, and a store that keeps it
-- is inconsistent rather than out of date.
report-retracted : (V : Type 0) → (r : Report V) → ((rep-warrant V r → Empty) → Empty)
report-retracted V r = λ no → no (rep-witness V r)
