mmul-step : (e : Val) (v : Word) (r b ir : Mono) → mev e ir ≡ times (mev e r) (mev e b) →
            mev e (minsert v ir) ≡ times (times (e v) (mev e r)) (mev e b)
mmul-step e v r b ir h = transN (minsert-sound e v ir) (transN (congN (λ z → times (e v) z) h) (symN (times-assoc (e v) (mev e r) (mev e b))))
