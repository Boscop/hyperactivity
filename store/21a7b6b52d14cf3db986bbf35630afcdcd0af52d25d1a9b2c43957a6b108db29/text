q-run : (stp : X86Step) → (stop k : Word) → (Q : Opt X86 → Type) → Q none → (s : X86) → run-ok stp stop k s ≡ true →
        QAll stp stop Q (snd (run-of stp k s)) → QAll stp stop Q s
q-run stp stop k Q q0 =
  %welimP (λ v → (s : X86) → run-ok stp stop v s ≡ true → QAll stp stop Q (snd (run-of stp v s)) → QAll stp stop Q s) k
    (λ s h qa → qa)
    (λ j ih s h qa → q-run-at stp stop j Q q0 ih s (weq (x86-rip s) stop) refl h qa)
