-- 4 KiB pages, 64-byte lines, CLOCK_REALTIME (0); the cores are the machine's, given
x86-64-linux : Word → Platform
x86-64-linux cores = Platform { pf-page = #4096 ; pf-cache-line = #64 ; pf-cores = cores ; pf-clock = #0
                              ; pf-little-endian = true ; pf-sysnr = x86-64-sysnr
                              ; pf-epoll-event-size = #12 ; pf-epoll-data-off = #4 }
