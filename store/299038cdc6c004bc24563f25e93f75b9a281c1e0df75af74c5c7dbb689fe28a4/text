hq-mixed m c1 = n3-add (n3-q (hq-ip c1 0 (u-add (hq-div (fn-nq 1 1) (u-add (hq-pw hq-onem m) (cons (fn-neg (hq-2p m)) nil))) (u-scale (fn-nq 1 1) (hq-div (fn-q 1 1) (u-add (hq-pw hq-onep m) (cons (fn-neg (hq-2p m)) nil)))))))
