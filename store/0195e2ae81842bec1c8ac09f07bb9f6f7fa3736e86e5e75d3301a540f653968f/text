-- negation swaps the parts
bz-neg-sound : (s : Bool) → (m : List Bool) → zv (bz-neg (s , m)) ≡ (snd (zv (s , m)) , fst (zv (s , m)))
bz-neg-sound s m = case m return λ l → zv (bz-neg (s , l)) ≡ (snd (zv (s , l)) , fst (zv (s , l))) of
  nil → (case s return λ u → zv (bz-neg (u , nil)) ≡ (snd (zv (u , nil)) , fst (zv (u , nil))) of
    true → λ i → (zero , zero)
    false → λ i → (zero , zero))
  cons x r → (case s return λ u → zv (bz-neg (u , cons x r)) ≡ (snd (zv (u , cons x r)) , fst (zv (u , cons x r))) of
    true → λ i → (zero , bin-to-nat (cons x r))
    false → λ i → (bin-to-nat (cons x r) , zero))
