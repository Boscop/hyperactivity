-- Single-source GDSII hierarchy AST: one strictly-positive algebra unifies standard-cell
-- masters (`gh-leaf`), SREF composition (`gh-join`), and AREF grids (`gh-rep cols rows`),
-- so emitted AREF dimensions, flattened polygon counts, and placed cell counts are all
-- computed projections of the exact same hierarchy value.
data GdsHier : Type where
  gh-leaf : List Gds6Box → GdsHier
  gh-join : GdsHier → GdsHier → GdsHier
  gh-rep  : Word → Word → GdsHier → List Gds6Box → GdsHier
