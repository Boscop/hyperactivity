fmap-sw : (n : Nat) (X : Type 1) (F1 G1 F2 G2 : X → Type 1) (k1 : (x : X) → F1 x → G1 x) (h : (x : X) → G1 x → G2 x)
  (h' : (x : X) → F1 x → F2 x) (k2 : (x : X) → F2 x → G2 x)
  (q : PathP (λ i → (xq : X) → F1 xq → G2 xq) (λ xq zq → h xq (k1 xq zq)) (λ xq zq → k2 xq (h' xq zq))) (c : Cube n X) (d : DCube n X F1 c) →
  PathP (λ i → DCube n X G2 c) (dcube-fmap n X G1 G2 h c (dcube-fmap n X F1 G1 k1 c d)) (dcube-fmap n X F2 G2 k2 c (dcube-fmap n X F1 F2 h' c d))
fmap-sw n X F1 G1 F2 G2 k1 h h' k2 q c d =
  pcat (DCube n X G2 c) (dcube-fmap n X G1 G2 h c (dcube-fmap n X F1 G1 k1 c d)) (dcube-fmap n X F1 G2 (λ x z → h x (k1 x z)) c d)
    (dcube-fmap n X F2 G2 k2 c (dcube-fmap n X F1 F2 h' c d))
    (fmap-fmap n X F1 G1 G2 k1 h c d)
    (pcat (DCube n X G2 c) (dcube-fmap n X F1 G2 (λ x z → h x (k1 x z)) c d) (dcube-fmap n X F1 G2 (λ x z → k2 x (h' x z)) c d)
       (dcube-fmap n X F2 G2 k2 c (dcube-fmap n X F1 F2 h' c d))
       (λ i → dcube-fmap n X F1 G2 (q i) c d)
       (psym (DCube n X G2 c) (dcube-fmap n X F2 G2 k2 c (dcube-fmap n X F1 F2 h' c d)) (dcube-fmap n X F1 G2 (λ x z → k2 x (h' x z)) c d) (fmap-fmap n X F1 F2 G2 h' k2 c d)))
