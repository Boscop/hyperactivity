sv-hex8 : Word → List Word
sv-hex8 w =
  cons (sv-hex-digit (%wand (%wshr w #28) #15))
  (cons (sv-hex-digit (%wand (%wshr w #24) #15))
  (cons (sv-hex-digit (%wand (%wshr w #20) #15))
  (cons (sv-hex-digit (%wand (%wshr w #16) #15))
  (cons (sv-hex-digit (%wand (%wshr w #12) #15))
  (cons (sv-hex-digit (%wand (%wshr w #8) #15))
  (cons (sv-hex-digit (%wand (%wshr w #4) #15))
  (cons (sv-hex-digit (%wand w #15)) nil)))))))
