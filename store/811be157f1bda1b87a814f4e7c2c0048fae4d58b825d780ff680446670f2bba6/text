-- THEOREM 8 (RFC 4648 §10 BASE64 TEST VECTORS EXACT BY `refl`):
bn-thm-rfc4648-base64 :
  andB (h-eq (bn-base64-enc "f") "Zg==")
  (andB (h-eq (bn-base64-enc "fo") "Zm8=")
  (andB (h-eq (bn-base64-enc "foo") "Zm9v")
        (h-eq (bn-base64-enc "foobar") "Zm9vYmFy"))) ≡ true
bn-thm-rfc4648-base64 = refl
