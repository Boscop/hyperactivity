-- b + (c + (d + e)) = (d + c) + (b + e)
shuffle5 : (b c d e : Nat) → plus b (plus c (plus d e)) ≡ plus (plus d c) (plus b e)
shuffle5 b c d e = transN (plus-comm-mid b c (plus d e)) (transN (congN (plus c) (plus-comm-mid b d e)) (transN (symN (plus-assoc c d (plus b e))) (congN (λ z → plus z (plus b e)) (plus-comm c d))))
