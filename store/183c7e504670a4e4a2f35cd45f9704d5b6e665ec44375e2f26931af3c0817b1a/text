vec-fin : {A : Type} → (n : Nat) → Equiv (Vec A n) (SumFin n → A)
vec-fin {A} n = isoToEquiv {lzero} {Vec A n} {SumFin n → A} (vec-index {A} n) (vec-tabulate {A} n)
  (λ g → funExt {lzero} {lzero} {SumFin n} {A} {λ i → vec-index {A} n (vec-tabulate {A} n g) i} {g} (vec-index-tabulate {A} n g))
  (vec-tabulate-index {A} n)
