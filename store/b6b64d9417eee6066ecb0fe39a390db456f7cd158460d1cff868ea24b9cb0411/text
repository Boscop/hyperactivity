hs-main : List (List Word) → Step W Word
hs-main nil =
  hs-bench-one "XOR2" #102 #6
    (hs-bench-one "MUX2" #216 #6
      (hs-bench-one "EQ2" #153 #6
        (hs-bench-one "MAJ3_CARRY" #232 #6
          (sdone #0))))
hs-main (cons a _) =
  let tgt = cli-word a
  in hs-bench-one "CUSTOM" tgt #6 (sdone #0)
