sv-tensor-module : List Word
sv-tensor-module =
  sv-lines
    (cons "module systolic_mac_2x2 ("
    (cons "  input  logic        clk, rst, kick,"
    (cons "  input  logic [15:0] a0, a1, b0, b1,"
    (cons "  output logic [31:0] c00, c01, c10, c11"
    (cons ");"
    (cons "  always_ff @(posedge clk) begin"
    (cons "    if (rst) begin"
    (cons "      c00 <= 32'd0; c01 <= 32'd0; c10 <= 32'd0; c11 <= 32'd0;"
    (cons "    end else if (kick) begin"
    (cons "      c00 <= c00 + (a0 * b0);"
    (cons "      c01 <= c01 + (a0 * b1);"
    (cons "      c10 <= c10 + (a1 * b0);"
    (cons "      c11 <= c11 + (a1 * b1);"
    (cons "    end"
    (cons "  end"
    (cons "endmodule"
    (cons "" nil)))))))))))))))))
