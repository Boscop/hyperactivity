-- functoriality: identity map preserves basins
basin-map-id : {S : Type 0} {s : S → S → Bool} → (u : Basins S s)
             → basin-map {S} {S} {s} {s} (λ x → x) (λ a b p → p) u ≡ u
basin-map-id {S} {s} (basin-pt x) = λ j → basin-of S s x
basin-map-id {S} {s} (basin-step a b p i) = λ j → basin-step a b p i
