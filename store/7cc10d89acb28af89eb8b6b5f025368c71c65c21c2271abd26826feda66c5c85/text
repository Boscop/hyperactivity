opt-1-le : {V : Type} → (u : B1) → (a : Circ B0 B1 B2 V) →
  Path Bool (leB (circ-gates {B0} {B1} {B2} {V} (opt-1 {V} u a)) (suc (circ-gates {B0} {B1} {B2} {V} a))) true
opt-1-le {V} b1-not a = opt-not-le {V} a
opt-1-le {V} b1-buf a = leB-suc-r (circ-gates a) (circ-gates a) (leB-refl (circ-gates a))
