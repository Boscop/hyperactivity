ground-dec-rem : List Word → (Word × List Word) → Word × (Word × List Word)
ground-dec-rem rem st =
  let len = fromNat (list-length rem)
      base = %wsucc len
      s = fst st
      ov = snd st
      q = wquot s base
      r = wrem s base
  in if wlt r len then (wnth-nat rem (toNat r) , (q , ov))
     else (cm-head-or #0 ov , (q , cm-tail ov))
