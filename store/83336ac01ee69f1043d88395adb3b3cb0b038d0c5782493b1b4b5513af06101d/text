bar-stage-loop : Nat → Word → Word → Word → List Word
bar-stage-loop zero _ _ _ = nil
bar-stage-loop (suc k) st stride i =
  let sel = epfl-indexed "shift" st
      a0  = bar-wire st i
      idx = %wmod (%wsub (%wadd i #128) stride) #128
      a1  = bar-wire st idx
      out = bar-wire (%wsucc st) i
  in list-append (epfl-mux2-blif sel a0 a1 out) (bar-stage-loop k st stride (%wsucc i))
