glu-counts-differ : count-of glu-anomers (30 , nmr-fine) ≡ count-of glu-catalysed (30 , nmr-fine) → Empty
glu-counts-differ q = transport (λ i → isTrue (eqb 2 ((concat (sym glu-count-300) (concat q glu-count-catalysed)) i))) unit
