inet-nodes : INetExpr → Nat
inet-nodes (in-lit _)        = suc zero
inet-nodes in-var0           = suc zero
inet-nodes (in-dup-add x)    = suc (inet-nodes x)
inet-nodes (in-add a b)      = suc (plus (inet-nodes a) (inet-nodes b))
inet-nodes (in-xor a b)      = suc (plus (inet-nodes a) (inet-nodes b))
inet-nodes (in-era-l d l)    = suc (plus (inet-nodes d) (inet-nodes l))
inet-nodes (in-lut3 _ a b c) = suc (plus (inet-nodes a) (plus (inet-nodes b) (inet-nodes c)))
