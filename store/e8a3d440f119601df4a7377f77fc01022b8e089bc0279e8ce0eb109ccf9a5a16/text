-- univalence's path: from an equivalence e from A to B, the line of types that is B glued with A
-- along e at the start and with B along the identity at the end (part of machine-in-hyperactive)
nk-ua : NkTm → NkTm → NkTm → NkTm
nk-ua a b e = nk-lam (nk-glue-ty (nk-up b) (nk-sys (nk-cons (nk-br (nk-neg (nk-var #0)) (nk-mkpair (nk-up a) (nk-up e))) (nk-cons (nk-br (nk-var #0) (nk-mkpair (nk-up b) nk-idequiv)) nk-nil))))
