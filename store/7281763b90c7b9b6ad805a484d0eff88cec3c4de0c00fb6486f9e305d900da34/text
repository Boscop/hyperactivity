kv-applied-logged : (cb : KvSt → NView KvMsg KvSt) → (c : KvCli) → (chs : List Adv) → (w : KvWrite) →
                    InL {KvWrite} w (r-app (fst (fst (fleet-run {KvMsg} {KvSt} (kv-beh cb) chs (kv-init c)) 0))) →
                    InL {KvWrite} w (r-log (fst (fst (fleet-run {KvMsg} {KvSt} (kv-beh cb) chs (kv-init c)) 0)))
kv-applied-logged cb c chs w m = fst (kv-safe cb c chs 0) w m
