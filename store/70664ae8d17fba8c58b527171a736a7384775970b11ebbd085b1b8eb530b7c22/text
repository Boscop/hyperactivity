k-build-at : {o : Ord} → (b : List (El o) → RTree (El o)) →
             ((l : List (El o)) → Sorted l → (k : El o) → k-pq k (b l) ≡ k-last k l) →
             (kk : Nat) → (l : List (El o)) → Sorted l → (k : El o) → k-pq k (build-at b kk l) ≡ k-last k l
k-build-at b ih kk l s k =
  (case drop-n kk l return λ d → list-append (take-n kk l) d ≡ l →
                                 k-pq k (case d of nil → spine l; cons x r → rnode (b (take-n kk l)) (fromNat (list-length (take-n kk l))) x (b r)) ≡ k-last k l of
     nil → λ ea → k-spine k l
     cons x r → λ ea → k-node b ih k l (take-n kk l) x r s ea)
    (take-drop kk l)
