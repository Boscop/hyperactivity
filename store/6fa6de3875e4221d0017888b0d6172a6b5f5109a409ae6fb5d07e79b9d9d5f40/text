-- ============================================================================
-- SECTION 3: EXACT RATIONAL SLATER EFFECTIVE NUCLEAR CHARGE Z_eff (x100, ZERO FLOATS!)
-- ============================================================================
-- Slater's exact screening rules for valence (ns, np) electrons in scaled x100 integers:
--   * Same (n, s/p) group: 35 per other electron (30 for 1s)
--   * (n-1) shell: 85 per electron
--   * (n-2) or deeper: 100 per electron
-- Returns exact Z_eff * 100 for ANY main-group element Z!

pt-slater-sigma-go : Word → List ShellFill → Word
pt-slater-sigma-go _ nil = #0
pt-slater-sigma-go nval (cons f rest) =
  let sn = sf-n f
      se = sf-e f
      contrib =
        if %weq sn nval then
          if %weq nval #1 then %wmul #30 (%wsub se #1)
          else %wmul #35 (%wsub se #1)
        else if %weq (%wadd sn #1) nval then %wmul #85 se
        else %wmul #100 se
  in %wadd contrib (pt-slater-sigma-go nval rest)

-- Collect total electrons in same (ns, np) valence group
pt-same-sp-e : Word → List ShellFill → Word
pt-same-sp-e _ nil = #0
pt-same-sp-e nval (cons f rest) =
  let hit = andB (%weq (sf-n f) nval) (pt-le (sf-l f) #1)
  in %wadd (if hit then sf-e f else #0) (pt-same-sp-e nval rest)

pt-slater-sigma-other : Word → List ShellFill → Word
pt-slater-sigma-other _ nil = #0
pt-slater-sigma-other nval (cons f rest) =
  let sn = sf-n f
      se = sf-e f
      c = if andB (%weq sn nval) (pt-le (sf-l f) #1) then #0
          else if %weq (%wadd sn #1) nval then %wmul #85 se
          else if %wlt sn nval then %wmul #100 se
          else #0
  in %wadd c (pt-slater-sigma-other nval rest)

pt-zeff-x100 : Word → Word
pt-zeff-x100 z =
  let cfg  = pt-config z
      last = pt-last-shell cfg
      nval = sf-n last
      ve   = pt-same-sp-e nval cfg
      same = if %weq nval #1 then %wmul #30 (%wsub ve #1) else %wmul #35 (%wsub ve #1)
      sig  = %wadd same (pt-slater-sigma-other nval cfg)
  in %wsub (%wmul #100 z) sig

