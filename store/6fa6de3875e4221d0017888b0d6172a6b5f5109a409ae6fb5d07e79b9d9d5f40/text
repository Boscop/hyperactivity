-- Exact covalent valence needed to reach next noble gas (for H=1, C=4, N=3, O=2, F=1, P=3, S=2, Cl=1)

pt-covalent-valence : Word → Word
pt-covalent-valence z =
  let cfg  = pt-config z
      last = pt-last-shell cfg
      nval = sf-n last
      ve   = pt-same-sp-e nval cfg
  in if %weq nval #1 then %wsub #2 ve
     else if pt-le ve #4 then ve
     else %wsub #8 ve

