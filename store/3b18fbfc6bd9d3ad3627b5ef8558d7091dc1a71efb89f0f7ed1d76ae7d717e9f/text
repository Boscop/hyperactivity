-- text cut at every byte b: the pieces, in order (the last piece after the last b)
h-split-onto : Word → List Word → List Word → List (List Word)
h-split-onto b cur nil = cons (h-rev cur nil) nil
h-split-onto b cur (cons x r) = if weq x b then cons (h-rev cur nil) (h-split-onto b nil r) else h-split-onto b (cons x cur) r
