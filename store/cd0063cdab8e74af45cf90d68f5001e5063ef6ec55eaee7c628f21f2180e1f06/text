echain-pos : (Et : Nat → ZQ → Nat → ZQ) → (st : IE) → (n : Nat) → (tv rv : ZQ) → echain Et st n tv rv → le (suc zero) (snd rv)
echain-pos Et st n = case n return λ w → (tv rv : ZQ) → echain Et st w tv rv → le (suc zero) (snd rv) of
  zero → λ tv rv ch → fst ch
  suc g → λ tv rv ch → rec g (fst ch) rv (snd (snd ch))
