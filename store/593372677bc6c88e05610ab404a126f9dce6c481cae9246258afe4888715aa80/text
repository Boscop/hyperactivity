-- THEOREM 5: COUPLED TWO-AGENT DISTURBANCE-ROBUST SAFETY RESERVE
-- If biological/environmental disturbance d <= D_max and controller holds reserve D_max + eps <= margin,
-- then actual perturbation d + eps never breaches the physical trust-region boundary!
cos-thm-two-agent-safe : (d dmax eps margin : Nat) →
  hm-le d dmax ≡ true →
  hm-le (hm-add dmax eps) margin ≡ true →
  hm-le (hm-add d eps) margin ≡ true
cos-thm-two-agent-safe d dmax eps margin hd hres =
  hm-le-trans (hm-add d eps) (hm-add dmax eps) margin
    (sc-le-add-mono d dmax eps eps hd (hm-le-refl eps))
    hres
