it-ifd : (V : Type) → (b : Bool) → (u : V) → (r : List V) → (T : List V → Type) → (b ≡ false → T (cons u r)) → T r → T (if b then r else cons u r)
it-ifd V b u r T = case b return λ w → (w ≡ false → T (cons u r)) → T r → T (if w then r else cons u r) of
  true → λ h t → t
  false → λ h t → h (λ i → false)
