-- ============================================================================
-- SECTION 1: EXACT INTEGER CONSTANT-PRODUCT AMM (x * y >= k) & ATOMIC ARBITRAGE
-- ============================================================================

record AmmPool =
  { ap-rx : Word -- token X reserve
  ; ap-ry : Word -- token Y reserve
  }

-- Exact 0.3% fee (997 / 1000) Uniswap-V2-style integer output:
--   dy = (ry * dx * 997) / (rx * 1000 + dx * 997)
ec-amm-out : Word → Word → Word → Word
ec-amm-out rx ry dx =
  let dxFee = %wmul dx #997
      num   = %wmul ry dxFee
      den   = %wadd (%wmul rx #1000) dxFee
  in if %weq den #0 then #0 else %wdiv num den

-- Check exact constant-product non-decrease `(rx + dx) * (ry - dy) >= rx * ry`:
ec-amm-k-safe : AmmPool → Word → Bool
ec-amm-k-safe p dx =
  let dy = ec-amm-out (ap-rx p) (ap-ry p) dx
  in if %wlt (ap-ry p) dy then false
     else
       let k0 = %wmul (ap-rx p) (ap-ry p)
           k1 = %wmul (%wadd (ap-rx p) dx) (%wsub (ap-ry p) dy)
       in if %wlt k1 k0 then false else true

-- Two-pool cyclic swap: X -> Y on Pool A, then Y -> X on Pool B, with atomic profit-or-revert gate!
ec-two-pool-out : AmmPool → AmmPool → Word → Word
ec-two-pool-out poolA poolB dx =
  let dy = ec-amm-out (ap-rx poolA) (ap-ry poolA) dx
  in ec-amm-out (ap-ry poolB) (ap-rx poolB) dy

ec-atomic-profit : AmmPool → AmmPool → Word → Word → Word
ec-atomic-profit poolA poolB dx gas =
  let out  = ec-two-pool-out poolA poolB dx
      cost = %wadd dx gas
  in if %wlt cost out then %wsub out cost else #0

-- Concrete imbalanced market:
--   Pool A: rx = 1,000,000, ry = 2,000,000 (Y is cheap on A: 1 X -> ~2 Y)
--   Pool B: rx = 2,000,000, ry = 1,000,000 (Y is dear on B:  1 Y -> ~2 X)
