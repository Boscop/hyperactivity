  andB (ec-sweep-depths (toNat #8) #1000003) -- prime wei surplus: 0 dust across depths 1..8!
  (andB (ec-sweep-depths (toNat #8) #1)       -- 1 single wei: 0 underflow, executor keeps 1 wei!
