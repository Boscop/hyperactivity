ce-wraps-a : Defs → List Word → List Word
ce-wraps-a lnil acc = acc
ce-wraps-a (lcons e r) acc = list-append "static uint64_t w" (list-append (ce-dec (fst e)) (list-append "(const uint64_t *a) { return g" (list-append (ce-dec (fst e)) (list-append "(" (list-append (ce-wargs (toNat (fst (snd e))) #0) (list-append "); }" (list-append ce-nl (ce-wraps-a r acc))))))))
