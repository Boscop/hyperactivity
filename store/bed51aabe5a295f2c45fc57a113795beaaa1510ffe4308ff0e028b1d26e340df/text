cm-ltw-shift-inv : (c a b : Word) → ltw (wadd c a) (wadd c b) ≡ true → ltw a b ≡ true
cm-ltw-shift-inv c a b =
  %welimP (λ v → ltw (wadd v a) (wadd v b) ≡ true → ltw a b ≡ true) c
    (λ h → cm-catb (cm-congb (λ z → ltw a z) (symw (cm-wadd-zero-l b)))
             (cm-catb (cm-congb (λ z → ltw z (wadd #0 b)) (symw (cm-wadd-zero-l a))) h))
    (λ k ih → cm-ltw-shift-inv-step k a b ih)
