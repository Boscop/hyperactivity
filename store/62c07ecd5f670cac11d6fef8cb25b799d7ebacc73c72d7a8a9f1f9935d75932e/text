-- the minimum is below both, the maximum above both
min-v : (x y : BZ) → bcanon (snd x) ≡ true → bcanon (snd y) ≡ true → (v : Bool) → bz-le x y ≡ v → zle (zv (if v then x else y)) (zv x) × zle (zv (if v then x else y)) (zv y)
min-v x y cx cy v = case v return λ u → bz-le x y ≡ u → zle (zv (if u then x else y)) (zv x) × zle (zv (if u then x else y)) (zv y) of
  true → λ e → (zle-refl (zv x) , zle-of-true x y cx cy e)
  false → λ e → (zle-of-false x y cx cy e , zle-refl (zv y))
