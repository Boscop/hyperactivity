index-tabulateV : (A : Type) → (to : A → Int64) → (from : Int64 → A) → ((v : A) → from (to v) ≡ v) → (n : Nat) → (f : Fin n → A) → (p : Fin n) → aindexV A from n (atabV A to n f) p ≡ f p
index-tabulateV A to from ft n f p =
  concat {lzero} {A} {from (aindex n (atab n (λ q → to (f q))) p)} {from (to (f p))} {f p}
    (cong {lzero} {lzero} {Int64} {A} from {aindex n (atab n (λ q → to (f q))) p} {to (f p)} (index-tabulate n (λ q → to (f q)) p)) (ft (f p))
