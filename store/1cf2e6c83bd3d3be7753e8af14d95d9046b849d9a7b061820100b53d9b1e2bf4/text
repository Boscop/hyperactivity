-- floor, positive: QD ≤ A
fdiv-pos : (Q D R A : Nat) → A ≡ plus (times Q D) R → le (plus (plus (times Q D) zero) zero) (plus A (plus (times Q zero) zero))
fdiv-pos Q D R A hA = (R ,
  transN (congN (plus R) (transN (plus-zero (plus (times Q D) zero)) (plus-zero (times Q D))))
  (transN (plus-comm R (times Q D))
  (transN (symN hA)
  (transN (symN (plus-zero A))
  (congN (plus A) (zero-pz Q))))))
