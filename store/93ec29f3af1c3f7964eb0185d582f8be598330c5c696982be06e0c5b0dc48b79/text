hyperinet-v2-scan : List Word
hyperinet-v2-scan =
  sv-concat
    (cons "  // Combinational dual-lane disjoint active-pair scanner & free-slot allocator" (cons sv-nl
    (cons "  reg       fnd0, fnd1;" (cons sv-nl
    (cons "  reg [2:0] u0, v0, u1, v1, f0_idx, f1_idx;" (cons sv-nl
    (cons "  reg [1:0] free_cnt;" (cons sv-nl
    (cons "  reg [2:0] live_c;" (cons sv-nl
    (cons "  // Lane 1 fires in parallel iff it is disjoint from Lane 0 and does not need free-slot allocation" (cons sv-nl
    (cons "  wire l0_is_comm = fnd0 && ((kind[u0]==K_CON && kind[v0]==K_DUP) || (kind[u0]==K_DUP && kind[v0]==K_CON));" (cons sv-nl
    (cons "  always @(*) begin" (cons sv-nl
    (cons "    fnd0 = 1'b0; fnd1 = 1'b0; u0 = 3'd0; v0 = 3'd0; u1 = 3'd0; v1 = 3'd0;" (cons sv-nl
    (cons "    f0_idx = 3'd0; f1_idx = 3'd0; free_cnt = 2'd0; live_c = 3'd0;" (cons sv-nl
    (cons "    for (i = 0; i < 8; i = i + 1) begin" (cons sv-nl
    (cons "      if (kind[i] == K_FREE) begin" (cons sv-nl
    (cons "        if (free_cnt == 2'd0) f0_idx = i[2:0];" (cons sv-nl
    (cons "        if (free_cnt == 2'd1) f1_idx = i[2:0];" (cons sv-nl
    (cons "        if (free_cnt < 2'd2)  free_cnt = free_cnt + 2'd1;" (cons sv-nl
    (cons "      end else live_c = live_c + 3'd1;" (cons sv-nl
    (cons "    end" (cons sv-nl
    (cons "    for (i = 0; i < 8; i = i + 1) begin" (cons sv-nl
    (cons "      for (j = i + 1; j < 8; j = j + 1) begin" (cons sv-nl
    (cons "        if (kind[i] != K_FREE && kind[j] != K_FREE &&" (cons sv-nl
    (cons "            p0[i] == {j[2:0], 2'd0} && p0[j] == {i[2:0], 2'd0}) begin" (cons sv-nl
    (cons "          if (!fnd0) begin" (cons sv-nl
    (cons "            fnd0 = 1'b1; u0 = i[2:0]; v0 = j[2:0];" (cons sv-nl
    (cons "          end else if (!fnd1 && i[2:0] != u0 && i[2:0] != v0 && j[2:0] != u0 && j[2:0] != v0 &&" (cons sv-nl
    (cons "                       !((kind[i]==K_CON && kind[j]==K_DUP) || (kind[i]==K_DUP && kind[j]==K_CON))) begin" (cons sv-nl
    (cons "            fnd1 = 1'b1; u1 = i[2:0]; v1 = j[2:0];" (cons sv-nl
    (cons "          end" (cons sv-nl
    (cons "        end" (cons sv-nl
    (cons "      end" (cons sv-nl
    (cons "    end" (cons sv-nl
    (cons "  end" (cons sv-nl
    (cons "  assign dual_fire   = fnd0 && fnd1 && !l0_is_comm;" (cons sv-nl
    (cons "  assign done        = !fnd0;" (cons sv-nl
    (cons "  assign redex_count = rcnt;" (cons sv-nl
    (cons "  assign live_nodes  = live_c;" (cons sv-nl
    (cons "  assign read_val    = val[slot_sel];" (cons sv-nl nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
