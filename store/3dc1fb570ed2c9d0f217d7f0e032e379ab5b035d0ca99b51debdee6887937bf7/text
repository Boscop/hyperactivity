conv-data-ww d ps u wu wv =
  case wv of
    wsys bs → sys-vs (mkdata d ps) bs u
    wrec d2 fs → conv-recv d (cofields-at d ps) fs u #0
    _ → 
      case wu of
        wcon d1 c fs ds → 
          case wv of
            wcon d2 c2 fs2 ds2 → 
              if %weq c c2
                then if lall2 (λ r s → %ieq r s) ds ds2
                       then conv-fields (centry d c ps) fs fs2
                       else false
                else false
            _ → false
        whcomp w a → 
          case wv of
            whcomp w2 a2 → 
              let T = mkdata d ps
              in if conv T a a2 then let i = %dim in conv T (w @ i) (w2 @ i) else false
            _ → false
        _ → (case convneu wu wv of some X → true; none → false)
