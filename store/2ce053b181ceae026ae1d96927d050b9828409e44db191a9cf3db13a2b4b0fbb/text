count-lt-mono : {o : Ord} {k k' : El o} → isTrue (leq k k') → (l : List (El o)) → ltn (count-lt k' l) (count-lt k l) ≡ false
count-lt-mono h l =
  case l return λ w → ltn (count-lt k' w) (count-lt k w) ≡ false of
    nil → λ i → false
    cons x r → one-if-mono {not (leq k x)} {not (leq k' x)} (lt-mono {o} {k} {k'} {x} h) (count-lt k r) (count-lt k' r) (rec r)
