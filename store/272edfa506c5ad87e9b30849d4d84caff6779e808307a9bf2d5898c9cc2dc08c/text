-- ---------------------------------------------------------------- processes as nodes
-- a process over NetSig M is a node: its state is its tree of steps
proc-view : {M A : Type} → Step (NetSig M) A → NView M (Step (NetSig M) A)
proc-view {M} {A} t = case t of
  sdone a → v-halt
  scmd c k → (case c return (λ x → (net-resp {M} x → Step (NetSig M) A) → NView M (Step (NetSig M) A)) of
                n-send to m → λ k2 → v-send to m (k2 unit)
                n-recv → λ k2 → v-recv k2
                n-now → λ k2 → v-now k2) k
