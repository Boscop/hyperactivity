-- M(u, 0) = 0 (M(0, w) = 0 is by computation: the zero vector is nil)
cl-mform-nil-r : (A : Type) → (z : A) → (ad mu : A → A → A) → ((x : A) → mu x z ≡ z) → ad z z ≡ z → (m : List (List A)) → (u : List A) →
  cl-mform A z ad mu m u nil ≡ z
cl-mform-nil-r A z ad mu m0 a0 m u = cl-tr A (cl-dot A z ad mu u (ln-map (List A) A (λ r → cl-dot A z ad mu r nil) m)) (cl-dot A z ad mu u (ln-map (List A) A (λ r → z) m)) z
  (λ i → cl-dot A z ad mu u (cl-map-ext A (List A) (λ r → cl-dot A z ad mu r nil) (λ r → z) (cl-dot-nil-r A z ad mu m0 a0) m i))
  (cl-dot-const A z ad mu m0 a0 (List A) u m)
