-- in the branch: hyps 0.. (latest), then the fields, then x; field j is cvar (r + n - 1 - j), hyp t
-- is cvar (r - 1 - t); showf the derived writing of another data type
show-fields : (Word → Code) → Lst (Word × Word) → Word → Word → Word → Word → Code
show-fields showf lnil n r j t = c-nil
show-fields showf (lcons k kr) n r j t =
  let f = cvar (%wadd r (%wsub (%wsub n #1) j))
      h = cvar (%wsub (%wsub r #1) t)
      this = (if %weq (fst k) #0 then c-cons f c-nil
              else (if %weq (fst k) #1 then cforce h
              else (if %weq (fst k) #3 then c-cons (prim-to-word (snd k) f) c-nil
              else capp (showf (snd k)) f)))
  in c-app this (show-fields showf kr n r (%wsucc j) (if %weq (fst k) #1 then %wsucc t else t))
