tom-write-proj-r : (ep : Nat) → (rat : RAT) → (prf : PRF) → (rd : Word) → (val : Nat) →
  RatBounded ep rat → (r : Word) →
  proj-arf (rat-write rd (suc ep , rd) rat) (prf-write (suc ep , rd) val prf) r ≡
  reg-write rd val (proj-arf rat prf) r
tom-write-proj-r ep rat prf rd val hb r =
  let pNew = (suc ep , rd)
  in case (weq r rd) return (λ b →
       Path Nat
         (prf-write pNew val prf (if b then pNew else rat r))
         (if b then val else prf (rat r))) of
       true →
         let hRefl = ptag-eq-refl pNew
         in λ i → if hRefl i then val else prf pNew
       false →
         let hNeq = leB-suc-neq (fst (rat r)) ep (hb r)
         in λ i → if andB (hNeq i) (weq (snd (rat r)) rd) then val else prf (rat r)
