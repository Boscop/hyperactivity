-- the record's lines holding any of a word's forms, ascending
c-lines-forms : List (List Word) → Proc W (List Word)
c-lines-forms fs = bind (c-out (cons "grep" (cons "-n" (cons "-i" (cons "-w" (cons "-F" (list-append (c-e-args fs) (cons c-record nil)))))))) (λ o →
  ret (list-map (λ l → h-number (c-upto-colon l)) (h-lines o)))
