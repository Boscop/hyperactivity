-- the usages of a line of types a composition runs along: what the composition's computation reads
lusage xs c =
  case c of
    tplam nm b V → lusage xs (b (%dim nm))
    tlam nm b V → lusage xs (b (%var nm Uw) Uw)
    tpi A nm b V → v+ (lusage xs A) (lusage xs (b (%var nm Uw) Uw))
    tsigma A nm b V → v+ (lusage xs A) (lusage xs (b (%var nm Uw) Uw))
    tpathp A a b V → v+ (lusage xs A) (v* #2 (v+ (usage xs a) (usage xs b)))
    tuniv l V → v0 xs
    tdata d ps V → lusage-ps xs ps
    tgluet A S V → v+ (lusage xs A) (v* #2 (usage xs S))
    thcompu A S V → v* #2 (usage xs S)
    tann t T V → lusage xs t
    tguess k g t V → lusage xs t
    tspine t V → lusage xs t
    tv y T → v0 xs
    tg n V → v0 xs
    tlit V → v0 xs
    _ → v* #2 (usage xs c)
