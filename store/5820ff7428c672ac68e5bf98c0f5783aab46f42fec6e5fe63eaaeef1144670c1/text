-- one state (n, l, j = l ± ½): Dirac's series to order 3 has constant 1, f₁ = −1/(2n²) and f₂ = −(1/(2n⁴))(n/κ − 3/4),
-- and the Foldy–Wouthuysen sum equals f₂
fn-state-ok2 : Nat → Nat → Bool → List BQ → Bool
fn-state-ok2 nn l up s = if fn-eq (ps-at s 0) (fn-q 1 1) then (if fn-eq (ps-at s 1) (fn-schr nn) then (if fn-eq (ps-at s 2) (fn-fine nn (fn-kappa l up)) then fn-eq (fw-total nn l up) (ps-at s 2) else false) else false) else false
