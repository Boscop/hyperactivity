ins-sorted : (l : Lit) (c : Conj) → conj-sorted c ≡ true → conj-sorted (conj-ins l c) ≡ true
ins-sorted l lnil h = λ i → true
ins-sorted l (lcons m ms) h =
  bool-case0 (λ b → lit-eq l m ≡ b → conj-sorted (if b then lcons m ms else (if lit-lt l m then lcons l (lcons m ms) else lcons m (conj-ins l ms))) ≡ true) (lit-eq l m)
    (λ e x → h)
    (λ ne x → bool-case0 (λ b → lit-lt l m ≡ b → conj-sorted (if b then lcons l (lcons m ms) else lcons m (conj-ins l ms)) ≡ true) (lit-lt l m)
       (λ lt y → andB-intro (lit-lb l (lcons m ms)) (conj-sorted (lcons m ms))
          (andB-intro (lit-lt l m) (lit-lb l ms) lt (lb-trans l m ms lt (andB-l (lit-lb m ms) (conj-sorted ms) h))) h)
       (λ nlt y → andB-intro (lit-lb m (conj-ins l ms)) (conj-sorted (conj-ins l ms))
          (lb-ins m l ms (lit-tri l m ne nlt) (andB-l (lit-lb m ms) (conj-sorted ms) h))
          (ins-sorted l ms (andB-r (lit-lb m ms) (conj-sorted ms) h)))
       (λ i → lit-lt l m))
    (λ i → lit-eq l m)
