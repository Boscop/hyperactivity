-- the same focus as the field and as the room
hi-lens : List Word → List Word → List Word
hi-lens rd f = h-concat (cons "<p class='lens'><a href='/hi/field?reader=" (cons (hi-url rd) (cons "&amp;focus=" (cons (hi-url f) (cons "'>the field</a> · <a href='/hi/room?reader=" (cons (hi-url rd) (cons "&amp;focus=" (cons (hi-url f) (cons "'>the room</a></p>" nil)))))))))
