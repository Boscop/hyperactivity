-- Synthesizable SystemVerilog expression printer algebra
sv-alg : Alg B0 B1 B2 (List Word)
sv-alg =
  ( (λ c → case c of b0-false → "1'b0"; b0-true → "1'b1")
  , (λ u x → case u of b1-not → list-append "(~" (list-append x ")"); b1-buf → x)
  , (λ b x y → case b of
      b2-and → list-append "(" (list-append x (list-append " & " (list-append y ")")))
      b2-or  → list-append "(" (list-append x (list-append " | " (list-append y ")")))
      b2-xor → list-append "(" (list-append x (list-append " ^ " (list-append y ")")))) )
