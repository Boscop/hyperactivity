lit-lt-cases : (P : Type) (l m : Lit) → (wlt (fst l) (fst m) ≡ true → P) → (fst l ≡ fst m → snd l ≡ false → snd m ≡ true → P) → lit-lt l m ≡ true → P
lit-lt-cases P l m kw ke =
  bool-case0 (λ b → (if b then true else (if weq (fst l) (fst m) then andB (not (snd l)) (snd m) else false)) ≡ true → P) (wlt (fst l) (fst m))
    (λ e h → kw e)
    (λ e → bool-case0 (λ b → (if b then andB (not (snd l)) (snd m) else false) ≡ true → P) (weq (fst l) (fst m))
       (λ e2 h → ke (weq-sound (fst l) (fst m) e2) (not-true (snd l) (andB-l (not (snd l)) (snd m) h)) (andB-r (not (snd l)) (snd m) h))
       (λ e2 h → false-true P h))
