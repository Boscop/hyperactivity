-- the standard representation inside the general one: the bonds are the pairs of atoms that have one, a
-- bond is incident on exactly the two atoms of its pair, and its electron count is read off the bond
-- order. Nothing of the two-centre model is lost by working in the general carrier.
hmol-of-moleq : MolEq → HMol
hmol-of-moleq Q =
  ( mol-atoms (meq-mol Q)
  , mol-el (meq-mol Q)
  , ((x : mol-atoms (meq-mol Q)) × (y : mol-atoms (meq-mol Q)) × isTrue (notb (bond-is-none (mol-bd (meq-mol Q) x y))))
  , (λ i → λ a → case meq-eq Q a (fst i) of true → true; false → meq-eq Q a (fst (snd i)))
  , (λ i → bond-electrons (mol-bd (meq-mol Q) (fst i) (fst (snd i)))) )
