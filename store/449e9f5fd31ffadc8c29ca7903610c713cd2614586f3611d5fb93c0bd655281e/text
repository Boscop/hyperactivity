v-open-of : VEnv → List Word → List Word
v-open-of env ip-txt =
  let ip = ve-ip env in
  let top = v-first-layer (ve-layers env) in
  list-append (if v-empty ip then nil else list-append (h-line (h-line "In progress:")) ip-txt) (list-append (h-line "Can start now and unblocks the most:") (h-concat (list-map (λ x → list-append (v-line env x) (v-gain-line env x)) top)))
