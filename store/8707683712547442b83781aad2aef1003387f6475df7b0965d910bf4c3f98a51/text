-- codata: two stuck calls or neutrals by their spines (no η: a value of a codata type is observed
-- by its fields, and two calls are equal when their definitions and arguments are); a record (only
-- at a copattern definition's own boundary) by its fields fs against the other value's, each at
-- its type
conv-recv d tel fs w j =
  case tel of
    tx A nm r → 
      case fs of
        lcons f fr → 
          let Av = tval A
          in if conv Av f (cproj-v d j w) then conv-recv d (r f Av) fr w (%wsucc j) else false
        lnil → true
    _ → true
