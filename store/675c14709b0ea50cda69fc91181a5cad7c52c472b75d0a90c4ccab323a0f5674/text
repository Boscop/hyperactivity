-- 2) `ms-evm-call4`: writes 4-byte `sel4` at `mem[284..288]` and `STATICCALL`s `target20` -> `mem[outOff..outOff+retSz]`
ms-evm-call4 : List Word → List Word → Word → Word → List EvmInst
ms-evm-call4 target20 sel4 outOff retSz =
  cons (ev-push sel4)
  (cons (ev-push (eth-word-be-min #256))
  (cons (ev-op #82)
  (cons (ev-push (eth-word-be-min retSz))
  (cons (ev-push (eth-word-be-min outOff))
  (cons (ev-push (eth-word-be-min #4))
  (cons (ev-push (eth-word-be-min #284))
  (cons (ev-push target20)
  (cons (ev-push (eth-word-be-min #80000))
  (cons (ev-op #250)
  (cons (ev-op #80) nil))))))))))
