kvl-all-later : (u : List (NodeId × KvWrite)) → (chs : AdvSeq) → (g0 : KvG) → (k t : Nat) → KvAllApp u (fleet-at {KvMsg} {KvSt} kv-bc-beh chs g0 t) → KvAllApp u (fleet-at {KvMsg} {KvSt} kv-bc-beh chs g0 (nt-later k t))
kvl-all-later nil chs g0 k t h = unit
kvl-all-later (cons e r) chs g0 k t h = (kv-app-later (fst e) (snd e) chs g0 k t (fst h) , kvl-all-later r chs g0 k t (snd h))
