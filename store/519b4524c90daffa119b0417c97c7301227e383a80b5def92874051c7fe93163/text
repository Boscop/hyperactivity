-- the subtractor: x + 2·borrow = difference bit + y + c
sub-bit : (x y c : Bool) → plus (bitn x) (times 2 (bitn (borrow3 x y c))) ≡ plus (bitn (bit-eq (bit-eq x y) c)) (plus (bitn y) (bitn c))
sub-bit x y c = case x return λ u → plus (bitn u) (times 2 (bitn (borrow3 u y c))) ≡ plus (bitn (bit-eq (bit-eq u y) c)) (plus (bitn y) (bitn c)) of
  true → fs-t y c
  false → fs-f y c
