hxtp-main : List (List Word) → Step W Word
hxtp-main args =
  let p = hxtp-arg1 args
  in scmd w-now (λ t0 →
     scmd (w-file-write-named (list-append p "_xor4_gaa3nm.gds") hypercore-gds-bytes) (λ n1 →
     scmd (w-file-write-named (list-append p "_hypercore_soc_5layer.gds") hypercore-soc-gds6-bytes) (λ n2 →
     scmd (w-file-write-named (list-append p "_rtl.sv") hypercore-full-rtl-sv) (λ n3 →
     scmd (w-file-write-named (list-append p "_tb.sv") hypercore-sv-testbench) (λ n4 →
     scmd (w-file-write-named (list-append p "_synth_fa.sv") hxtp-synth-fa-sv) (λ n5 →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-Tapeout gds_cell=" (list-append (ce-dec n1) (list-append "B gds_soc=" (list-append (ce-dec n2) (list-append "B rtl=" (list-append (ce-dec n3) (list-append "B tb=" (list-append (ce-dec n4) (list-append "B synth_fa=" (list-append (ce-dec n5) (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)")))))))))))) (sdone #0))))))))
