-- a step of first-line-clean, with the byte's test remembered (e)
first-line-clean-step : (c : Bool) → (b : Word) → (y : List Word) → Path Bool (weq b #10) c → isTrue (no-newline y) → isTrue (no-newline (if c then nil else cons b y))
first-line-clean-step c b y = case c return (λ d → Path Bool (weq b #10) d → isTrue (no-newline y) → isTrue (no-newline (if d then nil else cons b y))) of true → λ e h → unit; false → λ e h → subst {lzero} {lzero} {Bool} {λ d → isTrue (if d then false else no-newline y)} {false} {weq b #10} (sym e) h
