-- (8.19)
fd-short : (b : Nat → Nat) → (n bp : Nat) → (out : FdFrame) → fd-ltb n fd-four ≡ true → fd-decode b n bp out ≡ (false , out)
fd-short b n bp out h = λ k →
  if h k then (false , out)
  else (if fd-ltb (fd-monus n fd-four) (fd-len b) then (false , out) else (true , (fd-tag b , fd-len b , plus bp fd-four)))
