-- Left child mediant preserves unimodular determinant: p2*q1 = 1 + p1*q2 => (p1+p2)*q1 = 1 + p1*(q1+q2)
mediant-unimodular-l : (p1 q1 p2 q2 : Nat) → times p2 q1 ≡ suc (times p1 q2) → times (plus p1 p2) q1 ≡ suc (times p1 (plus q1 q2))
mediant-unimodular-l p1 q1 p2 q2 h =
  transN (times-distr p1 p2 q1)
    (transN (congN (plus (times p1 q1)) h)
      (transN (plus-suc (times p1 q1) (times p1 q2))
        (congN suc (symN (times-distl p1 q1 q2)))))
