ms-main : List (List Word) → Step W Word
ms-main args =
  let p = ms-pref args
  in scmd w-now (λ t0 →
     let ok_all = ms-verify-all ms-all-circuits
         ng_opt = ms-total-opt ms-all-circuits
         ng_tb  = ms-total-textbook ms-all-circuits
     in scmd (w-file-write-named (list-append p "_meta.sv") ms-all-sv) (λ n_sv →
        scmd (w-file-write-named (list-append p "_meta.gds") ms-gds6-bytes) (λ n_gds →
        scmd (w-file-write-named (list-append p "_meta.wasm") ms-wasm-bytes) (λ n_wasm →
        scmd (w-file-write-named (list-append p "_meta.metal") ms-metal-src) (λ n_mtl →
        scmd w-now (λ t1 →
        cli-say
          (list-append "HYPERINET-META 4-INPUT GPU-SUPEROPT SILICON | 7/7 112-case exact="
          (list-append (if ok_all then "1" else "0")
          (list-append " | " (list-append (ce-dec ng_opt)
          (list-append " vs " (list-append (ce-dec ng_tb)
          (list-append " NAND2 | sv=" (list-append (ce-dec n_sv)
          (list-append "B gds=" (list-append (ce-dec n_gds)
          (list-append "B wasm=" (list-append (ce-dec n_wasm)
          (list-append "B metal=" (list-append (ce-dec n_mtl)
          (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))))))))))))
          (sdone (if ok_all then #0 else #1))))))))
