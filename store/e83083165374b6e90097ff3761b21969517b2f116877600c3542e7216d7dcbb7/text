-- (part of language-support)
vex_get_vvvv : (vex_prefixes' : vex_prefixes) → Bits #5
vex_get_vvvv vex_prefixes' =
  let m'1 : Bits #8
      m'1 = (vex_prefixes-byte0 vex_prefixes')
      t'2 : Bits #5
      t'2 =
        if (weq m'1 #197) then
          (bv-zext #4 #5 (vex2_byte1-vvvv (vex_prefixes-byte1 vex_prefixes')))
        else if (weq m'1 #196) then
          (bv-zext #4 #5 (vex3_byte2-vvvv (vex_prefixes-byte2 vex_prefixes')))
        else
          #31
  in t'2
