-- a value's head as an interval term, and an interval term as a head: the two ends stay the
-- constructors they are
nk-is-pt : NkHd → Bool
nk-is-pt (hd-con c) = if %weq c #10 then true else %weq c #11
nk-is-pt (hd-var x) = true
nk-is-pt (hd-lvl l) = true
nk-is-pt (hd-dnf d) = true
nk-is-pt h = false
