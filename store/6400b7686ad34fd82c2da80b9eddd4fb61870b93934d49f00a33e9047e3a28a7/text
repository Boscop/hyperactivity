-- A session's change to a module is noted (STORE/unpublished, its path in hex) while a served source
-- is named, and published when its command is done (h-sync)
h-noted : List Word → Sum Unit (List Word) → Proc W Unit
h-noted path (inl u) = ret unit
h-noted path (inr s) = bind (h-env "CUBICAL_STORE") (λ e → bind (h-read (list-append (h-store-of e) "/unpublished")) (λ l →
  bind (h-write (list-append (h-store-of e) "/unpublished") (list-append (h-source-or l) (h-line (h-hex path)))) (λ w → ret unit)))
