-- Verify that `ecrecover` on the signed EIP-1559 transaction recovers the exact signer address!
eth-tx1559-selfcheck : Word → Eip1559Tx → Bool
eth-tx1559-selfcheck priv tx =
  let shash = keccak256 (eth-tx1559-unsigned tx)
      sr    = eth-tx1559-sign-raw priv tx
      sig   = snd sr
      rec20 = secp-ecrecover-addr20 (fst sig) (fst (snd sig)) (snd (snd sig)) shash
  in h-eq rec20 (eth-priv-to-addr20 priv)
