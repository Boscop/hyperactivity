hyperboloid-ruling-ok : (a b u : Word) →
  plusw (wsq (plusw a (mulw u b))) (plusw (wsq b) (wsq (mulw u a)))
  ≡ plusw (mulw (plusw (wsq a) (wsq b)) (plusw #1 (wsq u))) (plusw (mulw a (mulw u b)) (mulw a (mulw u b)))
hyperboloid-ruling-ok a b u =
  let ub = mulw u b
      ua = mulw u a
      cross = plusw (mulw a ub) (mulw a ub)
      sq-ux : (x : Word) → wsq (mulw u x) ≡ mulw (wsq x) (wsq u)
      sq-ux x =
        catw (lg-mulw-assoc u x (mulw u x))
          (catw (congw (λ z → mulw u z) (catw (symw (lg-mulw-assoc x u x)) (catw (congw (λ z → mulw z x) (lg-mulw-comm x u)) (lg-mulw-assoc u x x))))
            (catw (symw (lg-mulw-assoc u u (wsq x))) (lg-mulw-comm (wsq u) (wsq x))))
      s1 : plusw (wsq (plusw a ub)) (plusw (wsq b) (wsq ua))
           ≡ plusw (plusw (plusw (wsq a) (wsq ub)) cross) (plusw (wsq b) (wsq ua))
      s1 = congw (λ z → plusw z (plusw (wsq b) (wsq ua))) (lg-sq-add a ub)
      s2 : plusw (plusw (plusw (wsq a) (wsq ub)) cross) (plusw (wsq b) (wsq ua))
           ≡ plusw (plusw (plusw (wsq a) (wsq ub)) (plusw (wsq b) (wsq ua))) cross
      s2 = catw (plusw-assoc (plusw (wsq a) (wsq ub)) cross (plusw (wsq b) (wsq ua)))
             (catw (congw (λ z → plusw (plusw (wsq a) (wsq ub)) z) (plusw-comm cross (plusw (wsq b) (wsq ua))))
               (symw (plusw-assoc (plusw (wsq a) (wsq ub)) (plusw (wsq b) (wsq ua)) cross)))
      s3 : plusw (plusw (wsq a) (wsq ub)) (plusw (wsq b) (wsq ua))
           ≡ plusw (plusw (wsq a) (wsq b)) (plusw (wsq ua) (wsq ub))
      s3 = catw (lg-interchange (wsq a) (wsq ub) (wsq b) (wsq ua))
             (congw (λ z → plusw (plusw (wsq a) (wsq b)) z) (plusw-comm (wsq ub) (wsq ua)))
      s4 : plusw (wsq ua) (wsq ub) ≡ mulw (plusw (wsq a) (wsq b)) (wsq u)
      s4 = catw (congw (λ z → plusw z (wsq ub)) (sq-ux a))
             (catw (congw (λ z → plusw (mulw (wsq a) (wsq u)) z) (sq-ux b))
               (symw (mulw-dist (wsq a) (wsq b) (wsq u))))
      s5 : plusw (plusw (wsq a) (wsq b)) (mulw (plusw (wsq a) (wsq b)) (wsq u))
           ≡ mulw (plusw (wsq a) (wsq b)) (plusw #1 (wsq u))
      s5 = catw (congw (λ z → plusw z (mulw (plusw (wsq a) (wsq b)) (wsq u)))
                   (catw (symw (plusw-zero-l (plusw (wsq a) (wsq b)))) (lg-mulw-comm #1 (plusw (wsq a) (wsq b)))))
             (symw (lg-mulw-dist-l (plusw (wsq a) (wsq b)) #1 (wsq u)))
  in catw s1 (catw s2 (congw (λ z → plusw z cross) (catw s3 (catw (congw (λ z → plusw (plusw (wsq a) (wsq b)) z) s4) s5))))
