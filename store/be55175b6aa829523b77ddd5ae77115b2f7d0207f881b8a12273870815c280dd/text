-- the count read through a congruence is the count on the mapped witness
ln-cong-count : (f : List BQ → List BQ → BQ) → (l : List BQ → List BQ) → (ws : List (List BQ)) →
  ln-count (ln-gram (ln-cong f l) ws) ≡ ln-count (ln-gram f (ln-map (List BQ) (List BQ) l ws))
ln-cong-count f l ws = λ i → ln-count (ln-cong-gram f l ws i)
