sg-dc-lams : (Word → Lst (List Word) → NkSexp → Word × NkSexp) → Word → Lst (List Word) → List Word → Lst NkSexp → Word × NkSexp
sg-dc-lams _ fr _ _ lnil = (fr , nks-sym nil)
sg-dc-lams go fr ds tg (lcons b rest) =
  let nm = sg-dc-bname fr b
  in case rest return (λ _ → Word × NkSexp) of
       lnil → (fr , nks-sym nil)
       lcons body r2 →
         case r2 return (λ _ → Word × NkSexp) of
           lnil →
             let p = go (%wsucc fr) (lcons nm ds) body
             in (fst p , nks-lst (lcons (nks-sym tg) (lcons (nks-sym nm) (lcons (snd p) lnil))))
           lcons _ _ →
             let p = sg-dc-lams go (%wsucc fr) (lcons nm ds) tg rest
             in (fst p , nks-lst (lcons (nks-sym tg) (lcons (nks-sym nm) (lcons (snd p) lnil))))
