-- the distinct elements of a list, by a given test: this is the count a spectrum reports, once the
-- classes are right
nub-by : (A : Type 0) → (A → A → Bool) → List A → List A
nub-by A eq xs = case xs of
  nil → nil
  cons y r → (case mem-by A eq y r of true → nub-by A eq r; false → cons y (nub-by A eq r))
