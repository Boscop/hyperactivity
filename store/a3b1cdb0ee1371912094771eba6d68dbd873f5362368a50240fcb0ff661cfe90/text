build-at-cnt : {o : Ord} → (b : List (El o) → RTree (El o)) →
               ((l : List (El o)) → Sorted l → (k : El o) → cnt-tree k (b l) ≡ fromNat (count-lt k l)) →
               (kk : Nat) → (l : List (El o)) → Sorted l → (k : El o) → cnt-tree k (build-at b kk l) ≡ fromNat (count-lt k l)
build-at-cnt b ih kk l s k =
  (case drop-n kk l return λ d → list-append (take-n kk l) d ≡ l →
                                 cnt-tree k (case d of nil → spine l; cons x r → rnode (b (take-n kk l)) (fromNat (list-length (take-n kk l))) x (b r)) ≡ fromNat (count-lt k l) of
     nil → λ ea → spine-cnt l s k
     cons x r → λ ea → bac-node b ih k l (take-n kk l) x r s ea)
    (take-drop kk l)
