-- Zero false negatives: every published key inserted into a peer's Bloom filter tests positive
bloom-no-false-neg : {K : Type} → (h1 h2 : K → Nat) → (k : K) → (bl : Bloom) →
  bloom-mem h1 h2 k (bloom-add h1 h2 k bl) ≡ true
bloom-no-false-neg h1 h2 k bl =
  (λ i → po-and (bloom-set-hit (h1 k) (bloom-set (h2 k) bl) i)
                (bloom-set-mono (h1 k) (h2 k) (bloom-set (h2 k) bl) (bloom-set-hit (h2 k) bl) i))
