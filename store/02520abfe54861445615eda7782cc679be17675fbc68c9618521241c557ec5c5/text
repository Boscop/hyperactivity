synth-pcm : Word → Word → List Word
synth-pcm mode n =
  let kbase = if %weq mode #1 then #110 else if %weq mode #2 then #310 else #220
      w     = if %weq mode #1 then #160 else if %weq mode #3 then #380 else #240
      damp  = if %weq mode #3 then #65528 else if %weq mode #1 then #65450 else #65516
      alpha = if %weq mode #2 then #120 else #8
      init  = synth-st (mesh4 #0 #0 #0 #0 #0 #0 #0 #0) nil
      fin   = %welimP (λ _ → SynthSt) n init (λ i st → synth-step mode kbase w damp alpha i st)
  in case fin of synth-st _ acc → cli-rev acc nil
