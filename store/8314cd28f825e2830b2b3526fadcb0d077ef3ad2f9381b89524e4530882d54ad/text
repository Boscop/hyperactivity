cs-args-tail-mono : (hp hp1 : CsHeap) (ar2 : CsArgsRes) (v : CsVal) →
  cs-heap-ext hp hp1 → cs-args-mono hp1 ar2 →
  cs-args-mono hp (case ar2 return (λ _ → CsArgsRes) of
                     csa-abort → csa-abort
                     csa-ub → csa-ub
                     csa-ok hp2 vs2 → csa-ok hp2 (lcons v vs2))
cs-args-tail-mono hp hp1 csa-abort v e1 m2 = unit
cs-args-tail-mono hp hp1 csa-ub v e1 m2 = unit
cs-args-tail-mono hp hp1 (csa-ok hp2 vs2) v e1 m2 = cs-heap-ext-trans hp hp1 hp2 e1 m2
