hg-metal-src : List Word
hg-metal-src =
  hg-line "#include <metal_stdlib>"
  (hg-line "#include <metal_simdgroup_matrix>"
  (hg-line "using namespace metal;"
  (hg-line ""
  (hg-line "struct GemmDims { uint M; uint N; uint K; };"
  (hg-line "struct AttnDims { uint N; uint D; float scale; };"
  (hg-line ""
  (hg-line "// Hardware Apple Silicon simdgroup_half8x8 matrix-unit GEMM (32x32 tile per threadgroup, 4 simdgroups)"
  (hg-line "kernel void hx_gemm_simd16("
  (hg-line "    device const half* A [[buffer(0)]],"
  (hg-line "    device const half* B [[buffer(1)]],"
  (hg-line "    device float* C [[buffer(2)]],"
  (hg-line "    constant GemmDims& dm [[buffer(3)]],"
  (hg-line "    uint2 tgid [[threadgroup_position_in_grid]],"
  (hg-line "    uint sgid [[simdgroup_index_in_threadgroup]],"
  (hg-line "    uint tid [[thread_index_in_threadgroup]]) {"
  (hg-line "  threadgroup half As[32][32];"
  (hg-line "  threadgroup half Bs[32][32];"
  (hg-line "  uint bm = tgid.y * 32;"
  (hg-line "  uint bn = tgid.x * 32;"
  (hg-line "  uint sgr = (sgid >> 1) * 16;"
  (hg-line "  uint sgc = (sgid & 1) * 16;"
  (hg-line "  simdgroup_float8x8 acc00 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);"
  (hg-line "  simdgroup_float8x8 acc01 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);"
  (hg-line "  simdgroup_float8x8 acc10 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);"
  (hg-line "  simdgroup_float8x8 acc11 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);"
  (hg-line "  for (uint bk = 0; bk < dm.K; bk += 32) {"
  (hg-line "    for (uint e = tid; e < 1024; e += 128) {"
  (hg-line "      uint r = e >> 5, c = e & 31;"
  (hg-line "      As[r][c] = A[(bm + r) * dm.K + (bk + c)];"
  (hg-line "      Bs[r][c] = B[(bk + r) * dm.N + (bn + c)];"
  (hg-line "    }"
  (hg-line "    threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hg-line "    for (uint k = 0; k < 32; k += 8) {"
  (hg-line "      simdgroup_half8x8 a0, a1, b0, b1;"
  (hg-line "      simdgroup_load(a0, &As[sgr][k], 32);"
  (hg-line "      simdgroup_load(a1, &As[sgr + 8][k], 32);"
  (hg-line "      simdgroup_load(b0, &Bs[k][sgc], 32);"
  (hg-line "      simdgroup_load(b1, &Bs[k][sgc + 8], 32);"
  (hg-line "      simdgroup_multiply_accumulate(acc00, a0, b0, acc00);"
  (hg-line "      simdgroup_multiply_accumulate(acc01, a0, b1, acc01);"
  (hg-line "      simdgroup_multiply_accumulate(acc10, a1, b0, acc10);"
  (hg-line "      simdgroup_multiply_accumulate(acc11, a1, b1, acc11);"
  (hg-line "    }"
  (hg-line "    threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hg-line "  }"
  (hg-line "  simdgroup_store(acc00, &C[(bm + sgr) * dm.N + (bn + sgc)], dm.N);"
  (hg-line "  simdgroup_store(acc01, &C[(bm + sgr) * dm.N + (bn + sgc + 8)], dm.N);"
  (hg-line "  simdgroup_store(acc10, &C[(bm + sgr + 8) * dm.N + (bn + sgc)], dm.N);"
  (hg-line "  simdgroup_store(acc11, &C[(bm + sgr + 8) * dm.N + (bn + sgc + 8)], dm.N);"
  (hg-line "}"
  (hg-line ""
  (hg-line "// Threadgroup-tiled Online 1-Pass FlashAttention (shared SRAM K/V tiles, 64 threads/group)"
  (hg-line "kernel void hx_flash_attn_tiled("
  (hg-line "    device const float4* Q [[buffer(0)]],"
  (hg-line "    device const float4* K [[buffer(1)]],"
  (hg-line "    device const float4* V [[buffer(2)]],"
  (hg-line "    device float4* O [[buffer(3)]],"
  (hg-line "    constant AttnDims& ad [[buffer(4)]],"
  (hg-line "    uint qidx [[thread_position_in_grid]],"
  (hg-line "    uint tid [[thread_index_in_threadgroup]]) {"
  (hg-line "  threadgroup float4 Ks[32][16];"
  (hg-line "  threadgroup float4 Vs[32][16];"
  (hg-line "  float4 qv[16];"
  (hg-line "  float4 acc[16];"
  (hg-line "  for (uint d = 0; d < 16; d++) { qv[d] = Q[qidx * 16 + d]; acc[d] = float4(0.0f); }"
  (hg-line "  float m = -1e30f, l = 0.0f;"
  (hg-line "  for (uint blk = 0; blk < ad.N; blk += 32) {"
  (hg-line "    uint row = tid >> 1, half_d = (tid & 1) * 8;"
  (hg-line "    for (uint k = 0; k < 8; k++) {"
  (hg-line "      Ks[row][half_d + k] = K[(blk + row) * 16 + half_d + k];"
  (hg-line "      Vs[row][half_d + k] = V[(blk + row) * 16 + half_d + k];"
  (hg-line "    }"
  (hg-line "    threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hg-line "    for (uint j = 0; j < 32; j++) {"
  (hg-line "      float dot = 0.0f;"
  (hg-line "      for (uint d = 0; d < 16; d++) dot += metal::dot(qv[d], Ks[j][d]);"
  (hg-line "      float s = dot * ad.scale, mn = fmax(m, s), a = exp(m - mn), b = exp(s - mn);"
  (hg-line "      l = l * a + b;"
  (hg-line "      for (uint d = 0; d < 16; d++) acc[d] = acc[d] * a + b * Vs[j][d];"
  (hg-line "      m = mn;"
  (hg-line "    }"
  (hg-line "    threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hg-line "  }"
  (hg-line "  float inv = 1.0f / l;"
  (hg-line "  for (uint d = 0; d < 16; d++) O[qidx * 16 + d] = acc[d] * inv;"
  (hg-line "}" nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
