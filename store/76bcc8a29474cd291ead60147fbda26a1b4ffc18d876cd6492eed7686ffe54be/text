c-meaning : List Word → List (List Word) → List Word
c-meaning s nil = h-line "(the record holds nothing of this)"
c-meaning s (cons x nil) = h-line x
c-meaning s fam = list-append (h-line (c-agreed fam))
  (h-concat (list-map (λ x → h-line (list-append "  " (h-drop-n (list-length (c-agreed fam)) x))) fam))
