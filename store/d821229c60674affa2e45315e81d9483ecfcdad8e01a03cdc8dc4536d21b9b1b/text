-- one step of lexle, for a pair of bounds at once
sq-step-and : (a : Bool) → (b : Bool) → (r : Bool) → (r2 : Bool) → andB (andB a b) (andB r (not r2)) ≡ andB (lex-step a b r) (not (lex-step a b r2))
sq-step-and a b r r2 =
  (case a return λ y → andB (andB y b) (andB r (not r2)) ≡ andB (lex-step y b r) (not (lex-step y b r2)) of
     true → (case b return λ z → andB (andB true z) (andB r (not r2)) ≡ andB (lex-step true z r) (not (lex-step true z r2)) of
               true → λ i → andB r (not r2)
               false → λ i → false)
     false → λ i → false)
