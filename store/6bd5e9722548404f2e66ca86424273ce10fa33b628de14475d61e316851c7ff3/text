-- the full adder: sum bit plus twice the carry is x + y + c
full-adder : (x y c : Bool) → plus (bitn (bit-eq (bit-eq x y) c)) (times 2 (bitn (if x then (if y then true else c) else (if y then c else false)))) ≡ plus (bitn c) (plus (bitn x) (bitn y))
full-adder x y c =
  case x return λ u → plus (bitn (bit-eq (bit-eq u y) c)) (times 2 (bitn (if u then (if y then true else c) else (if y then c else false)))) ≡ plus (bitn c) (plus (bitn u) (bitn y)) of
    true → (case y return λ v → plus (bitn (bit-eq (bit-eq true v) c)) (times 2 (bitn (if v then true else c))) ≡ plus (bitn c) (plus (suc zero) (bitn v)) of
      true → (case c return λ w → plus (bitn (bit-eq true w)) (times 2 (bitn true)) ≡ plus (bitn w) (suc (suc zero)) of
        true → λ i → suc (suc (suc zero))
        false → λ i → suc (suc zero))
      false → (case c return λ w → plus (bitn (bit-eq false w)) (times 2 (bitn w)) ≡ plus (bitn w) (suc zero) of
        true → λ i → suc (suc zero)
        false → λ i → suc zero))
    false → (case y return λ v → plus (bitn (bit-eq (bit-eq false v) c)) (times 2 (bitn (if v then c else false))) ≡ plus (bitn c) (plus zero (bitn v)) of
      true → (case c return λ w → plus (bitn (bit-eq false w)) (times 2 (bitn w)) ≡ plus (bitn w) (suc zero) of
        true → λ i → suc (suc zero)
        false → λ i → suc zero)
      false → (case c return λ w → plus (bitn (bit-eq true w)) (times 2 (bitn false)) ≡ plus (bitn w) zero of
        true → λ i → suc zero
        false → λ i → zero))
