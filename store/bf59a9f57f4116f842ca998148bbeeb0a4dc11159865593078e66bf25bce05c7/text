tom-step-bounded : (ts : TomState) → (inst : IsaInst) →
  (case ts of tstate ep rat _ → RatBounded ep rat) →
  (case (tom-step ts inst) of tstate ep2 rat2 _ → RatBounded ep2 rat2)
tom-step-bounded (tstate ep rat prf) i-nop hb = hb
tom-step-bounded (tstate ep rat prf) (i-imm rd imm) hb = rat-write-bounded ep rat hb rd
tom-step-bounded (tstate ep rat prf) (i-addi rd rs1 imm) hb = rat-write-bounded ep rat hb rd
tom-step-bounded (tstate ep rat prf) (i-alu op rd rs1 rs2) hb = rat-write-bounded ep rat hb rd
