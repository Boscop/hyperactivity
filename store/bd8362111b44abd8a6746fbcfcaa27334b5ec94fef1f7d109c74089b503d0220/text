nk-fire-none-wf : (blk : Bool) (h : Word) (cs : NkTm) (aux : NkEnv) (out : NkW) (hd : NkHd) (parts : NkEnv) (n : NkW) →
  nk-out-ok (nk-eapp aux parts) (nke-cons out nke-nil) n n
    (if blk then nk-stuck-el h cs aux out (nkv hd parts) n else nk-plan-of (nk-era-env aux (nk-era-env parts nkf-nil)) n) ≡ true
nk-fire-none-wf true h cs aux out hd parts n =
  nk-stuck-el-wf (nk-eapp aux parts) h cs aux out (nkv hd parts) n
    (nk-emem-sub aux (nk-eapp aux parts) n (nk-s n) (λ w m → nk-emem-eapp-l w aux parts m))
nk-fire-none-wf false h cs aux out hd parts n =
  let ins = nk-eapp aux parts
      outs = nke-cons out nke-nil
      haux = nk-emem-sub aux ins n n (λ w m → nk-emem-eapp-l w aux parts m)
      hparts = nk-emem-sub parts ins n n (λ w m → nk-emem-eapp-r w aux parts m)
  in nk-out-ok-intro ins outs n n (nk-era-env aux (nk-era-env parts nkf-nil)) n nke-nil
       (nk-wire-le-refl n)
       (nk-era-env-wf ins outs n n aux (nk-era-env parts nkf-nil) haux (nk-era-env-wf ins outs n n parts nkf-nil hparts refl))
       refl
