  (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X F c) →
  PathP (λ i → Cube (dims sk) Z) (papp-cube sk Z f (dcube-map (suc (dims sk)) X F Z g c d)) (dcube-map (dims sk) X F Z g (papp-cube sk X f c) (papp-cube-d sk X F f c d))
