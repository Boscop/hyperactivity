-- at one sequence: Z ≤ Z_2 and Z_3 = Z
sp-ok : Nat → Nat → List (Nat × (Nat × (Nat × Nat))) → List (Nat × (Nat × (Nat × Nat))) → List Nat → Bool
sp-ok s x r2 r3 h = if bin-leb (bin-of-nat (fd-ref s x 0 h)) (sp-z s x r2) then (if bin-leb (bin-of-nat (fd-ref s x 0 h)) (sp-z s x r3) then bin-leb (sp-z s x r3) (bin-of-nat (fd-ref s x 0 h)) else false) else false
