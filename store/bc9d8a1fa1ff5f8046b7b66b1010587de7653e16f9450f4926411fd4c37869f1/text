-- the first n events of the array at base, in order: the event k from the last down, consed
lx-events : Platform → Word → Word → Proc {lzero} W (List EpollEvent)
lx-events pf base n =
  %welimP (λ v → List EpollEvent → Proc {lzero} W (List EpollEvent)) n (λ acc → lx-rw {List EpollEvent} acc)
    (λ k go → λ acc →
      lx-bw {Word} {List EpollEvent} (load-at (%wadd base (%wmul k (pf-epoll-event-size pf)))) (λ e →
      lx-bw {Word} {List EpollEvent} (load-at (%wadd (%wadd base (%wmul k (pf-epoll-event-size pf))) (pf-epoll-data-off pf))) (λ d →
        go (cons (EpollEvent { ev-events = %wmod e #4294967296 ; ev-data = d }) acc))))
    nil
