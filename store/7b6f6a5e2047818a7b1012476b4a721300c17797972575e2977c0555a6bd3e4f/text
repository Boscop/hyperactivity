-- UNIVERSAL THEOREM 3D (ALL-STREAM COMPRESSED LLM GEMV HOMOMORPHISM: IDENTICAL OUTPUTS, 0 POSTULATES):
dm-thm-llm-gemv-hom :
  (xs : List DmLlmTerm) → plus (dm-dot-dense xs) (dm-dot-sparse xs) ≡ dm-dot-exact xs
dm-thm-llm-gemv-hom nil = refl
dm-thm-llm-gemv-hom (cons (dt-term true p) rs) =
  let ih   = dm-thm-llm-gemv-hom rs
      step = dm-plus-assoc p (dm-dot-dense rs) (dm-dot-sparse rs)
  in λ i → comp (λ j → Nat)
       (λ j → [ i = 0 ↦ step (~ j) , i = 1 ↦ plus p (ih j) ])
       (plus p (plus (dm-dot-dense rs) (dm-dot-sparse rs)))
dm-thm-llm-gemv-hom (cons (dt-term false p) rs) =
  let ih = dm-thm-llm-gemv-hom rs
      sw = dm-swap-mid p (dm-dot-dense rs) (dm-dot-sparse rs)
  in λ i → comp (λ j → Nat)
       (λ j → [ i = 0 ↦ plus (dm-dot-dense rs) (plus p (dm-dot-sparse rs))
              , i = 1 ↦ plus p (ih j) ])
       (sw i)
