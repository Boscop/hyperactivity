-- Sample one B3 Eternal Golden Braid helical strand across throat [-L, +L]
b3-sample-strand : Nat → Word → Word → SInt → SInt → SInt → SInt → SInt → SInt → List RPt
b3-sample-strand zero n idx L r0 k twist ribBase th0 = nil
b3-sample-strand (suc rem) n idx L r0 k twist ribBase th0 =
  let u = si-sub (si-div-w (si-mul (sp #20000) (sp idx)) n) (sp #10000)
      x = fx-mul L u
      rad = fx-mul r0 (fx-cosh (fx-mul k u))
      th = si-add th0 (fx-mul twist u)
      y = fx-mul rad (fx-sin th)
      z = fx-mul rad (fx-cos th)
  in cons (cat-proj-w ribBase x y z rad) (b3-sample-strand rem n (%wsucc idx) L r0 k twist ribBase th0)
