-- (a·b)·c = a·(b·c)
wmul-assoc-step : (a b n : Word) → wmul (wmul a b) n ≡ wmul a (wmul b n) →
                  wmul (wmul a b) (%wsucc n) ≡ wmul a (wmul b (%wsucc n))
wmul-assoc-step a b n h =
  catw (wmul-suc (wmul a b) n)
    (catw (congw (λ z → wadd z (wmul a b)) h)
      (catw (symw (wmul-distl a (wmul b n) b)) (congw (λ z → wmul a z) (symw (wmul-suc b n)))))
