codec-comp : {A B C : Type} → Codec A B → Codec B C → Codec A C
codec-comp {A} {B} {C} c1 c2 =
  ( (λ a → codec-enc c2 (codec-enc c1 a))
  , ( (λ z → codec-dec c1 (codec-dec c2 z))
    , (λ a → concat {lzero} {A} {codec-dec c1 (codec-dec c2 (codec-enc c2 (codec-enc c1 a)))} {codec-dec c1 (codec-enc c1 a)} {a}
               (cong {lzero} {lzero} {B} {A} (codec-dec c1) (codec-ok c2 (codec-enc c1 a)))
               (codec-ok c1 a)) ) )
