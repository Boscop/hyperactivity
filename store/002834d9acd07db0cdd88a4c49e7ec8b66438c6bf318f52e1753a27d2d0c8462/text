eqo-phi : (f : List (List Word) → Word) → (a : El PO) → (e : El entry-ord) →
          eqo {PO} a (phi f e) ≡ andB (eqo {PO} a (phi f (snd a))) (eqo {entry-ord} (snd a) e)
eqo-phi f a e =
  bool-iff {eqo {PO} a (phi f e)} {andB (eqo {PO} a (phi f (snd a))) (eqo {entry-ord} (snd a) e)}
    (λ h →
       let p = eqo-sound {PO} {a} {phi f e} h
           q = λ i → snd (p i)
       in and-intro {eqo {PO} a (phi f (snd a))} {eqo {entry-ord} (snd a) e}
            (subst {_} {_} {El PO} {λ z → isTrue (eqo {PO} a z)} (tr (phi f e) p (λ i → phi f (q (~ i)))) (eqo-refl {PO} a))
            (subst {_} {_} {El entry-ord} {λ z → isTrue (eqo {entry-ord} (snd a) z)} q (eqo-refl {entry-ord} (snd a))))
    (λ h →
       let p = eqo-sound {PO} {a} {phi f (snd a)} (and-fst {eqo {PO} a (phi f (snd a))} {eqo {entry-ord} (snd a) e} h)
           q = eqo-sound {entry-ord} {snd a} {e} (and-snd {eqo {PO} a (phi f (snd a))} {eqo {entry-ord} (snd a) e} h)
       in subst {_} {_} {El PO} {λ z → isTrue (eqo {PO} a z)} (tr (phi f (snd a)) p (λ i → phi f (q i))) (eqo-refl {PO} a))
