-- a definition of the compiled program: a kept function is specialized as its caller is (its own
-- calls kept the same way); any other definition is its code as checked
unfold-jit : Word → Opt Code
unfold-jit g =
  case def-code g return (λ _ → Opt Code) of
    none → none
    some c → (case def-type-code g return (λ _ → Opt Code) of
                none → some c
                some T → (if andB (fo-fun T) (if self-head g c then false else true)
                            then some (fst (specialize T (jit-sched g c) lnil c))
                            else some c))
