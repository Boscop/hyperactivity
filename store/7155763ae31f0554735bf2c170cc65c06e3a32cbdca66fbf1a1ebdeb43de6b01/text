-- whether a triple is one of the three rotations of (h1, h2, stereocentre): the positive arrangement
is-pos : Nb → Nb → Nb → Bool
is-pos a b c = case a of
  nb-h1 → (case b of nb-h2 → nb-eq c nb-cs; nb-h1 → false; nb-cs → false)
  nb-h2 → (case b of nb-cs → nb-eq c nb-h1; nb-h1 → false; nb-h2 → false)
  nb-cs → (case b of nb-h1 → nb-eq c nb-h2; nb-h2 → false; nb-cs → false)
