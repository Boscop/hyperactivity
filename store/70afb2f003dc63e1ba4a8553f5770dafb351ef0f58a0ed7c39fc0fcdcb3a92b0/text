-- sums respect equality of integers
in-zplus-zeq : (x x2 y y2 : Nat × Nat) → zeq x x2 → zeq y y2 → zeq (zplus x y) (zplus x2 y2)
in-zplus-zeq x x2 y y2 hx hy = transN (plus-mid4 (fst x) (fst y) (snd x2) (snd y2)) (transN (cong2plus (plus (fst x) (snd x2)) (plus (fst x2) (snd x)) (plus (fst y) (snd y2)) (plus (fst y2) (snd y)) hx hy) (plus-mid4 (fst x2) (snd x) (fst y2) (snd y)))
