s-corpus-make : List Word → Proc W (List Word)
s-corpus-make st = bind (h-read (list-append st "/paper/text")) (λ pt → bind (s-corpus-docs s-writing) (λ w → bind (s-corpus-essays s-sources) (λ e → bind (s-corpus-docs s-records) (λ r →
  ret {lzero} {W} (h-concat (cons "[" (cons (s-commas (list-append (cons (s-corpus-item "/paper" "hyperactivity: the paper" (s-paper-text (s-or nil pt))) nil) (list-append w (list-append e r)))) (cons "]" nil))))))))
