-- a module changed from the pointer the session had: recorded (the body its text) or dropped
s-changed : List Word → List Word → Bool → List Word → List Word → Proc W (List Word)
s-changed st hx rec p now = if andB rec (h-eq now p) then ret {lzero} {W} (s-respond "422 Unprocessable Content" "text/plain" "the module was not recorded")
  else s-logged st hx now
