-- a definition of arity ar applied to n arguments: with exactly ar a call; with fewer a function
-- value holding them; with more a call applied to the rest
ce-gcall : (Code → List Word) → Word → Word → Word → Lst Code → List Word
ce-gcall pr g ar n as =
  if %wlt n ar
  then list-append "hy_clo((uint64_t)w" (list-append (ce-dec g) (list-append ", " (list-append (ce-dec ar) (list-append ", " (list-append (ce-dec n) (list-append ", (uint64_t[]){0" (list-append (ce-args-n pr as false) "})")))))))
  else ce-apps pr (list-append "g" (list-append (ce-dec g) (list-append "(" (list-append (ce-args-n pr (ce-take (toNat ar) as) true) ")")))) (ce-drop (toNat ar) as)
