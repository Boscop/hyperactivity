-- Exact fixed-point complex division a / b at scale S
cx-div : Cx → Cx → Cx
cx-div a b =
  let bx = si-abs (fst b)
      bIm = si-abs (snd b)
      den = wadd (wmul bx bx) (wmul bIm bIm)
  in if weq den #0 then (si-zero , si-zero)
     else let numRe = si-mul (sp fx-S) (si-add (si-mul (fst a) (fst b)) (si-mul (snd a) (snd b)))
              numIm = si-mul (sp fx-S) (si-sub (si-mul (snd a) (fst b)) (si-mul (fst a) (snd b)))
          in (si-div-w numRe den , si-div-w numIm den)
