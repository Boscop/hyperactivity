mterm-eq-sound : (x y : MTerm) → mterm-eq x y ≡ true → x ≡ y
mterm-eq-sound x =
  case x return (λ u → (y : MTerm) → mterm-eq u y ≡ true → u ≡ y) of
    mempty → λ y → (case y return (λ v → mterm-eq mempty v ≡ true → mempty ≡ v) of
      mempty → λ h i → mempty
      mlit b → λ h → cm-ft-absurd h
      mref j → λ h → cm-ft-absurd h
      mapp t2 a2 → λ h → cm-ft-absurd h
      mcat l2 r2 → λ h → cm-ft-absurd h)
    mlit a → λ y → (case y return (λ v → mterm-eq (mlit a) v ≡ true → mlit a ≡ v) of
      mempty → λ h → cm-ft-absurd h
      mlit b → λ h → cong {lzero} {lzero} {Word} {MTerm} mlit (cm-weq-sound a b h)
      mref j → λ h → cm-ft-absurd h
      mapp t2 a2 → λ h → cm-ft-absurd h
      mcat l2 r2 → λ h → cm-ft-absurd h)
    mref k → λ y → (case y return (λ v → mterm-eq (mref k) v ≡ true → mref k ≡ v) of
      mempty → λ h → cm-ft-absurd h
      mlit b → λ h → cm-ft-absurd h
      mref j → λ h → cong {lzero} {lzero} {Word} {MTerm} mref (cm-weq-sound k j h)
      mapp t2 a2 → λ h → cm-ft-absurd h
      mcat l2 r2 → λ h → cm-ft-absurd h)
    mapp t1 a1 → λ y → (case y return (λ v → mterm-eq (mapp t1 a1) v ≡ true → mapp t1 a1 ≡ v) of
      mempty → λ h → cm-ft-absurd h
      mlit b → λ h → cm-ft-absurd h
      mref j → λ h → cm-ft-absurd h
      mapp t2 a2 → λ h i → mapp (cm-weq-sound t1 t2 (isTrue→eq (and-fst {weq t1 t2} {mterm-eq a1 a2} (eq→isTrue h))) i)
                                (rec a1 a2 (isTrue→eq (and-snd {weq t1 t2} {mterm-eq a1 a2} (eq→isTrue h))) i)
      mcat l2 r2 → λ h → cm-ft-absurd h)
    mcat l1 r1 → λ y → (case y return (λ v → mterm-eq (mcat l1 r1) v ≡ true → mcat l1 r1 ≡ v) of
      mempty → λ h → cm-ft-absurd h
      mlit b → λ h → cm-ft-absurd h
      mref j → λ h → cm-ft-absurd h
      mapp t2 a2 → λ h → cm-ft-absurd h
      mcat l2 r2 → λ h i → mcat (rec l1 l2 (isTrue→eq (and-fst {mterm-eq l1 l2} {mterm-eq r1 r2} (eq→isTrue h))) i)
                                (rec r1 r2 (isTrue→eq (and-snd {mterm-eq l1 l2} {mterm-eq r1 r2} (eq→isTrue h))) i))
