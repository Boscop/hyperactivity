-- R₊ from the space whose edge has degree m = d + 1 (ds here are its degrees, w last): z^k ↦ k z^(k−1),
-- w z^k ↦ (k − m) z^k, all over m + 1
rplus-entry : Nat → List Nat → List Nat → List Nat → SQ
rplus-entry e ds t s = sq-mul (if eqb (exp-last s) zero
    then (if eqb (exp-at e s) zero then sq-zero else (if exp-eq t (exp-down e (exp-init s)) then sq-nat (exp-at e s) else sq-zero))
    else (if exp-eq t (exp-init s) then sq-norm ((exp-at e s , suc zero) , (exp-at e ds , suc zero)) else sq-zero))
  ((suc zero , suc (exp-at e ds)) , (zero , suc zero))
