-- the repulsion of two s-densities, and ⟨ab|1/r₁₂|cd⟩ (a, c on one electron; b, d on the other)
oc-j : OcF → OcF → BQ
oc-j d e = bq-add (fn-sub (bq-mul (oc-i1 d) (oc-i2 e)) (oc-i1 (oc-pp d (oc-tail (snd e) (oc-x (oc-x (fst e))) , snd e)))) (oc-i2 (oc-pp d (oc-tail (snd e) (oc-x (fst e)) , snd e)))
