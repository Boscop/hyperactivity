-- THEOREM 9 (UNISWAP V3 SELECTOR `0x04e45aaf` + 228B CALLDATA + EIP-3009 ECRECOVER ROUNDTRIP BY `refl`):
bn-thm-uni3-and-eip3009-ecrecover :
  let cd      = bn-encode-eth-to-usdc eth-founder-coinbase-addr20 #10000000000000000 #16000000
      from20  = eth-priv-to-addr20 #3
      nonce32 = keccak256 "hx-x402-test-0"
      dig32   = bn-eip3009-digest from20 eth-founder-coinbase-addr20 #2500000 #0 #1800000000 nonce32
      sig     = secp-ecdsa-sign #3 dig32
      rec20   = secp-ecrecover-addr20 (fst sig) (fst (snd sig)) (snd (snd sig)) dig32
  in andB (h-eq (h-hex bn-uni3-sel4) "04e45aaf")
     (andB (%weq (fromNat (list-length cd)) #228)
           (h-eq rec20 from20)) ≡ true
bn-thm-uni3-and-eip3009-ecrecover = refl
