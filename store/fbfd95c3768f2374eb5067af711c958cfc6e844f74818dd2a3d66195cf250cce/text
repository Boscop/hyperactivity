xp-sound-pair : (g : List XpTy) → (a b : XpExpr) → (A : XpTy) →
  ((T : XpTy) → xp-infer g a ≡ inl T → XpDer (g , a , T)) → ((T : XpTy) → xp-infer g b ≡ inl T → XpDer (g , b , T)) →
  (x y : Sum XpTy Unit) → xp-infer g a ≡ x → xp-infer g b ≡ y → xp-pair-ty x y ≡ inl A → XpDer (g , xp-pair a b , A)
xp-sound-pair g a b A sa sb (inl t1) (inl t2) ea eb h =
  xp-retype g (xp-pair a b) (xt-prod t1 t2) A (xp-inl-inj (xt-prod t1 t2) A h) (xd-pair g a b t1 t2 (sa t1 ea) (sb t2 eb))
xp-sound-pair g a b A sa sb (inl t1) (inr u) ea eb h = Empty-rec (xp-inr-inl A h)
xp-sound-pair g a b A sa sb (inr u) y ea eb h = Empty-rec (xp-inr-inl A h)
