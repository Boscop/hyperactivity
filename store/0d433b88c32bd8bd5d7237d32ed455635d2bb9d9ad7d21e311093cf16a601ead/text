fs-t : (y c : Bool) → plus (bitn true) (times 2 (bitn (borrow3 true y c))) ≡ plus (bitn (bit-eq (bit-eq true y) c)) (plus (bitn y) (bitn c))
fs-t y c = case y return λ v → plus (bitn true) (times 2 (bitn (borrow3 true v c))) ≡ plus (bitn (bit-eq (bit-eq true v) c)) (plus (bitn v) (bitn c)) of
  true → fs-tt c
  false → fs-tf c
