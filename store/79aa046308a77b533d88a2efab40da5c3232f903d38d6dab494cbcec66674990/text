-- ---------------------------------------------------------------- intervals
-- the interval I (ends m/2^s, S = 2^s) holds the rational X/q: lo·q ≤ X·S ≤ hi·q
encl : List Bool → IV → Nat × Nat → Nat → Type
encl S I X q = zle (zsc (zv (fst I)) q) (zsc X (bin-to-nat S)) × zle (zsc X (bin-to-nat S)) (zsc (zv (snd I)) q)
