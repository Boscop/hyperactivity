hcm-blend : Word → Word → Word → Word → Word → Word
hcm-blend p1 p3 p6 mlen mbit =
  let pm = if %wlt #0 mlen then
             let conf = if %wlt #7 mlen then #4072 else if %wlt #3 mlen then #3980 else #3650
             in if %weq mbit #1 then conf else %wsub #4096 conf
           else #2048
      w1 = %wadd #1 (hcm-abs p1)
      w3 = %wmul (hcm-abs p3) #3
      w6 = %wmul (hcm-abs p6) #6
      wm = if %wlt #0 mlen then %wmul (hcm-abs pm) #16 else #0
      num = %wadd (%wadd (%wmul p1 w1) (%wmul p3 w3)) (%wadd (%wmul p6 w6) (%wmul pm wm))
      den = %wadd (%wadd w1 w3) (%wadd w6 wm)
      p   = %wdiv num den
  in if %wlt p #1 then #1 else if %wlt #4095 p then #4095 else p
