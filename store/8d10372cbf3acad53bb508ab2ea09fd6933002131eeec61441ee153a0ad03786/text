-- a positive difference D = A − B, or zero when the list is empty
zsub-pos : (l : List Bool) → (A B : Nat) → plus (bin-to-nat l) B ≡ A → zeq (zv (if bin-zero l then bz-zero else (true , l))) (A , B)
zsub-pos l A B = case l return λ m → plus (bin-to-nat m) B ≡ A → zeq (zv (if bin-zero m then bz-zero else (true , m))) (A , B) of
  nil → λ p → transN p (symN (plus-zero A))
  cons x r → λ p → transN p (symN (plus-zero A))
