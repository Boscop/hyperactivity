bn-query-usdc6 : List Word → Proc W Word
bn-query-usdc6 owner20 =
  let cdHex  = list-append "0x" (h-hex (bn-encode-balance-of owner20))
      usdc55 = eth-eip55-from-bytes20 bn-usdc-base20
      pJson  = h-concat
                 (cons "[{" (cons (h-quote "to") (cons ":" (cons (h-quote usdc55)
                 (cons "," (cons (h-quote "data") (cons ":" (cons (h-quote cdHex)
                 (cons "}," (cons (h-quote "latest") (cons "]" nil)))))))))))
  in bind (bl-rpc-call "eth_call" pJson) (λ resp →
     ret {lzero} {W} (bl-hex-to-word (bl-extract-json-hex resp)))
