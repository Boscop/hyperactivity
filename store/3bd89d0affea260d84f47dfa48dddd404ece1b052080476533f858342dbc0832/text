all-fiber-mono : {C S : Type} → (sem : C → S) → (spec : S) → (cost : C → Nat) →
  (m1 m2 : Nat) → leB m1 m2 ≡ true →
  (cs : List (fiber sem spec)) →
  ((c : fiber sem spec) → Unit) →
  AllFiberLe sem spec cost m2 cs → AllFiberLe sem spec cost m1 cs
all-fiber-mono sem spec cost m1 m2 hm nil _ _ = unit
all-fiber-mono sem spec cost m1 m2 hm (cons c cs) dummy hall =
  let d12 = leB-sound m1 m2 hm
      d2c = fst hall
      p : plus (plus (fst d2c) (fst d12)) m1 ≡ cost (fst c)
      p = transN (plus-assoc (fst d2c) (fst d12) m1)
            (transN (congN (plus (fst d2c)) (snd d12)) (snd d2c))
  in ((plus (fst d2c) (fst d12) , p) , all-fiber-mono sem spec cost m1 m2 hm cs dummy (snd hall))
