ce2-prog : Word → Defs → List Word
ce2-prog m defs =
  list-append ce-prelude
    (list-append ce-prelude2
      (list-append ce-prelude3
        (list-append (ce-protos defs)
          (list-append (ce-wraps defs)
            (list-append (ce2-fns defs defs)
              (ce-main m (opt-or (x-arity defs m) #0)))))))
