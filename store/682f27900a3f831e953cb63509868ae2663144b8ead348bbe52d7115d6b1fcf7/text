-- Soundness under arbitrary Byzantine routing: any value admitted by multi-hop dht-lookup is valid
dht-routing-sound : {b : Nat} {N K V : Type} → (chk : K → V → Bool) → (fuel : Nat) →
  (nid : N → BKey b) → (kid : K → BKey b) → (rt : N → List N) → (stores : N → CAStore K V) →
  (start : N) → (k : K) → (v : V) →
  dht-lookup {b} chk fuel nid kid rt stores start k ≡ inr v → chk k v ≡ true
dht-routing-sound {b} chk fuel nid kid rt stores start k v eq =
  dht-check-sound-res chk k (dht-walk {b} fuel nid kid rt stores start k) v eq
