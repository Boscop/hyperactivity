iv-mul-canon : (S : List Bool) → (I1 I2 : IV) → ivc (iv-mul S I1 I2)
iv-mul-canon S I1 I2 = (bz-fdiv-canon (bz-min (bz-min (bz-mul (fst I1) (fst I2)) (bz-mul (fst I1) (snd I2))) (bz-min (bz-mul (snd I1) (fst I2)) (bz-mul (snd I1) (snd I2)))) S ,
  bz-cdiv-canon (bz-max (bz-max (bz-mul (fst I1) (fst I2)) (bz-mul (fst I1) (snd I2))) (bz-max (bz-mul (snd I1) (fst I2)) (bz-mul (snd I1) (snd I2)))) S)
