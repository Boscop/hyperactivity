nk-chg-clear : (u k n0 n1 : NkW) (ins outs : NkEnv) (c : NkCh) → (nk-wire-lt u n0 ≡ true) → (nk-emem u ins ≡ false) → (nk-emem u outs ≡ false) → (nk-chg-wf ins outs n0 n1 k c ≡ true) → nk-weq u k ≡ false
nk-chg-clear u k n0 n1 ins outs (nkc-val v) lt hi ho hc = nk-not-in-set-neq-at (nk-emem k outs) u k n0 n1 outs lt ho refl hc
nk-chg-clear u k n0 n1 ins outs (nkc-op o) lt hi ho hc = nk-not-in-set-neq-at (nk-emem k ins) u k n0 n1 ins lt hi refl hc
nk-chg-clear u k n0 n1 ins outs (nkc-put s) lt hi ho hc = nk-no hc
