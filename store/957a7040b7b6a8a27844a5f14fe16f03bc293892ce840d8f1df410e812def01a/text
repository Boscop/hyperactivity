-- a definition of arity ar applied to n arguments: with exactly ar a call; with fewer a function
-- value holding them; with more a call applied to the rest
ce-gcall : (Code → List Word → List Word) → Word → Word → Word → Lst Code → List Word → List Word
ce-gcall pr g ar n as acc =
  if %wlt n ar
    then list-append "hy_clo((uint64_t)w" (list-append (ce-dec g) (list-append ", " (list-append (ce-dec ar) (list-append ", " (list-append (ce-dec n) (list-append ", (uint64_t[]){0" (ce-args pr as false (list-append "})" acc))))))))
    else ce-apps pr (λ tl → list-append "g" (list-append (ce-dec g) (list-append "(" (ce-args pr (ce-take (toNat ar) as) true (list-append ")" tl))))) (ce-drop (toNat ar) as) acc
