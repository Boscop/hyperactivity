-- ---------------------------------------------------------------- 2. Self-Hosting `HyperNet` Graph Evaluator & Workloads
data HNode =
    hn-lit        (v : Nat)
  | hn-add        (l : HNode) (r : HNode)
  | hn-mul        (l : HNode) (r : HNode)
  | hn-dup2       (shared : HNode) (isMul : Bool)
  | hn-face-guard (cA : ClauseVec (toNat #4)) (cB : ClauseVec (toNat #4)) (body : HNode) (fallback : Nat)
