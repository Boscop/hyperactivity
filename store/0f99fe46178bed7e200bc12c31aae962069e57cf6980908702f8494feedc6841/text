-- R σ_z E on a vector over the weight-zero monomials of ds, on either side
sigma-re-plus : Nat → List Nat → List SQ → List SQ
sigma-re-plus e ds v = map-apply (sigma-entry (rplus-entry e (ds-plus e ds))) (mons0 ds) (mons0 (ds-plus e ds)) (map-apply (eplus-entry e ds) (mons0 (ds-plus e ds)) (mons0 ds) v)
