-- Theorem 3: Virtual Joint Agent composition is symmetric (k1 /\ k2 == k2 /\ k1)
wp-joint-agent-comm : (ver : Word → Word → Bool) → (claim : Word) →
  (a b : WarrantPolicy) →
  wp-satisfies ver claim (wp-and a b) ≡ wp-satisfies ver claim (wp-and b a)
wp-joint-agent-comm ver claim a b =
  andB-comm-s (wp-satisfies ver claim a) (wp-satisfies ver claim b)
