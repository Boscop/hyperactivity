-- S²ToSetElim: a family of sets over S² is determined by its value at base2 (the square over surf
-- is a path in a line of propositions: paths over a line of sets)
S2SetElimG : (A : S2 → Type) → ((x : S2) → isSet (A x)) → A base2 → (a : S2) → A a
S2SetElimG A setA b a = case a return (λ y → A y) of
    base2 → b
    surf k l → isPropToPathP (λ i → PathP (λ j → A (surf i j)) b b)
                 (isPropPathP (λ j → A base2) (setA base2) b b) (isPropPathP (λ j → A base2) (setA base2) b b)
                 (λ i → isPropPathP (λ j → A (surf i j)) (setA base2) b b) (λ j → b) (λ j → b) k l
