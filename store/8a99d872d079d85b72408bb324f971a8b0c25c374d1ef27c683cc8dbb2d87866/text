-- Official IETF RFC 8439 §2.1 ChaCha20 Quarter-Round:
chacha20-qr : QR4 → QR4
chacha20-qr (qr4 a0 b0 c0 d0) =
  let a1 = ho-u32-add a0 b0
      d1 = ho-u32-rotl (ho-u32-xor d0 a1) #16
      c1 = ho-u32-add c0 d1
      b1 = ho-u32-rotl (ho-u32-xor b0 c1) #12
      a2 = ho-u32-add a1 b1
      d2 = ho-u32-rotl (ho-u32-xor d1 a2) #8
      c2 = ho-u32-add c1 d2
      b2 = ho-u32-rotl (ho-u32-xor b1 c2) #7
  in qr4 a2 b2 c2 d2
