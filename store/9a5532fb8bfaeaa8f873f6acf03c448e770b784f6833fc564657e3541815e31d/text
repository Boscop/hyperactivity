chem-gb-far-screen-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-gb-far-screen-poly A ad mu q vs =
  (λ g sub →
    let epsW = g 0; q1 = g 1; q2 = g 2
        one = q (fn-q 1 1)
        q12 = mu q1 q2
        lhs = sub (mu epsW q12) (mu (sub epsW one) q12)
    in (lhs , q12))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
