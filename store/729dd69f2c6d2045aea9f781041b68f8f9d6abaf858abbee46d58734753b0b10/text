-- G at A: the angular chain started at [0, 1] at l = 2M + 2, down to s_2
g-val : List Bool → List Bool → IV → IV → Nat → IV × Bool
g-val S S2 p2 a M = istep (irun S S2 (ang-env S p2 a) ang-step (suc M) (iv-unit S , true))
  (ieval S S2 (env3 (fst (irun S S2 (ang-env S p2 a) ang-step (suc M) (iv-unit S , true))) p2 a) g-ie)
