-- shifts: the count (of any integer kind) modulo the width of the shifted kind
rm-shift : Bool → SK → SV → SV → MRes SV
rm-shift left k a b = case k of
  sk-int sg w → mr-bind (sv-as-i b) (λ c →
    (case left of
       true → sv-shl k (sk-int false iw64) a (sv-i (u64and c (u64sub (iw-bits w) uq1)))
       false → sv-shr k (sk-int false iw64) a (sv-i (u64and c (u64sub (iw-bits w) uq1)))))
  _ → mstop st-ill-typed
