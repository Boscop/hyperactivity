io-sv-gates : Nat → Word → Word → List Word → List Word
io-sv-gates zero _ _ tl = tl
io-sv-gates (suc k) nw prog tl =
  let g = %wand prog #63
      i = %wshr g #3
      j = %wand g #7
  in io-cat (cons "  wire w" (cons (ce-dec nw) (cons " = ~(w" (cons (ce-dec i)
            (cons " & w" (cons (ce-dec j) (cons ");" (cons ce-nl
            (cons (io-sv-gates k (%wsucc nw) (%wshr prog #6) tl) nil)))))))))
