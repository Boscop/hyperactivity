-- ---------------------------------------------------------------- the trace on the vertex's states
-- ½ tr: the expectation in the state ½ times the identity on the vertex's two states, which by Schur's lemma is the
-- expectation in either state covariant under the rotations of a tetrahedral vertex
rows-trace : Nat → Rows → SQ
rows-trace i rs = case rs of
  nil → sq-zero
  cons r rest → sq-plus (sq-nth i r) (rows-trace (suc i) rest)
