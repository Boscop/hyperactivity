-- (part of language-support)
gpr_and_spec_4 : (dst' : Bits #32) → (src : Bits #32) → (input_rflags : rflagsbits) → MF ((Bits #32) × rflagsbits × rflagsbits)
gpr_and_spec_4 dst' src input_rflags =
  let result' : Bits #32
      result' = (bv-slice #32 (bv-and #32 dst' src) #31 #0)
      cf' : ZI
      cf' = (zpos #0)
  in bindF {Bits #1} {((Bits #32) × rflagsbits × rflagsbits)} (pf_spec32 result') (λ pf' →
       let zf : Bits #1
           zf = (zf_spec (bv-unsigned #32 result'))
           sf : Bits #1
           sf = (sf_spec32 result')
           of' : ZI
           of' = (zpos #0)
           output_rflags : rflagsbits
           output_rflags =
             (rflagsbits-set-of (rflagsbits-set-sf (rflagsbits-set-zf (rflagsbits-set-pf (rflagsbits-set-cf input_rflags (bits_of_int cf' (zpos #1))) pf') zf) sf) (bits_of_int of' (zpos #1)))
           undefined_flags : rflagsbits
           undefined_flags = (rflagsbits-set-af #0 #1)
       in retF {((Bits #32) × rflagsbits × rflagsbits)} (result' , output_rflags , undefined_flags))
