dtw-path-cost-go : List Word → List Word → List WarpStep → Word → Word → Word → Word
dtw-path-cost-go _ _ nil _ _ acc = acc
dtw-path-cost-go xs ys (cons st r) i j acc =
  let d = w-abs-diff (w-nth i xs) (w-nth j ys)
  in case st of
       ws-diag  → dtw-path-cost-go xs ys r (%wsucc i) (%wsucc j) (%wadd acc d)
       ws-right → dtw-path-cost-go xs ys r (%wsucc i) j (%wadd acc d)
       ws-up    → dtw-path-cost-go xs ys r i (%wsucc j) (%wadd acc d)
