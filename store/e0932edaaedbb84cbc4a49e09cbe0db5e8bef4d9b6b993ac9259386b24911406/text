<script>
(function(){
  document.getElementById('hxtheme').addEventListener('click',function(){
    var d=!document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('dark',d);
    try{localStorage.setItem('hxTheme',d?'dark':'light')}catch(e){}
    drawFS(); drawBio();
  });
  function col(n){return getComputedStyle(document.documentElement).getPropertyValue(n).trim()}
  function setup(cv){var dpr=Math.min(window.devicePixelRatio||1,2),w=cv.clientWidth,h=cv.clientHeight;cv.width=Math.round(w*dpr);cv.height=Math.round(h*dpr);var ctx=cv.getContext('2d');ctx.setTransform(dpr,0,0,dpr,0,0);return{ctx:ctx,w:w,h:h}}

  fsN.oninput=drawFS; fsZa.oninput=drawFS;
  function drawFS(){
    var s=setup(fsCanvas), ctx=s.ctx, w=s.w, h=s.h;
    var n=+fsN.value, za=fsZa.value/100;
    fsNVal.textContent='n = '+n; fsZaVal.textContent=za.toFixed(2);
    fsInfo.textContent='n = '+n+' · κ = 1..'+n+' · (Zα)² = '+(za*za).toFixed(3);
    ctx.clearRect(0,0,w,h);
    var e0=-1/(2*n*n), x=za*za;
    // Draw unperturbed Schrödinger line on left, split Dirac levels on right
    var y0=h*0.24;
    ctx.strokeStyle=col('--blue'); ctx.lineWidth=2.5;
    ctx.beginPath(); ctx.moveTo(28,y0); ctx.lineTo(w*0.36,y0); ctx.stroke();
    ctx.fillStyle=col('--blue'); ctx.font='600 12px monospace';
    ctx.fillText('Schrödinger E₀ = -1/(2·'+n+'²) = '+e0.toFixed(4)+' Ha',28,y0-10);
    var maxShift=(1/(2*Math.pow(n,4)))*(n-0.75)*x;
    var scale=maxShift>0?(h*0.58)/maxShift:1;
    for(var k=1;k<=n;k++){
      var shift=(1/(2*Math.pow(n,4)))*(n/k-0.75)*x;
      var y=y0+shift*scale;
      ctx.strokeStyle=col('--line2'); ctx.lineWidth=1; ctx.setLineDash([4,4]);
      ctx.beginPath(); ctx.moveTo(w*0.36,y0); ctx.lineTo(w*0.52,y); ctx.stroke(); ctx.setLineDash([]);
      ctx.strokeStyle=col('--pink'); ctx.lineWidth=2.5;
      ctx.beginPath(); ctx.moveTo(w*0.52,y); ctx.lineTo(w*0.82,y); ctx.stroke();
      ctx.fillStyle=col('--ink'); ctx.font='600 11px monospace';
      ctx.fillText('j='+(k-0.5).toFixed(1)+' (κ='+k+')',w*0.84,y+4);
    }
  }

  bioGc.oninput=drawBio; bioG.oninput=drawBio;
  function drawBio(){
    var s=setup(bioCanvas), ctx=s.ctx, w=s.w, h=s.h;
    var gc=bioGc.value/10, g=bioG.value/10;
    bioGcVal.textContent=gc.toFixed(1); bioGVal.textContent=g.toFixed(1);
    bioInfo.textContent='g_c = '+gc.toFixed(1)+' · diff damp = '+(g+2*gc).toFixed(1);
    ctx.clearRect(0,0,w,h);
    ctx.strokeStyle=col('--line'); ctx.beginPath(); ctx.moveTo(30,h/2); ctx.lineTo(w-14,h/2); ctx.moveTo(30,16); ctx.lineTo(30,h-16); ctx.stroke();
    var v1=1.0, v2=-0.8, dt=0.02, T=220;
    function plot(color, vals){
      ctx.strokeStyle=color; ctx.lineWidth=2.2; ctx.beginPath();
      vals.forEach(function(v,idx){
        var x=30+(idx/T)*(w-44), y=h/2-v*(h*0.36);
        if(idx===0)ctx.moveTo(x,y); else ctx.lineTo(x,y);
      });
      ctx.stroke();
    }
    var a1=[], a2=[];
    for(var k=0;k<=T;k++){
      a1.push(v1); a2.push(v2);
      var dv1=-g*v1 - gc*(v1-v2), dv2=-g*v2 - gc*(v2-v1);
      v1+=dv1*dt; v2+=dv2*dt;
    }
    plot(col('--pink'),a1); plot(col('--blue'),a2);
    ctx.fillStyle=col('--muted'); ctx.font='600 11px monospace';
    ctx.fillText('Pink: V₁(t) · Blue: V₂(t) · Higher g_c collapses V₁ − V₂ → 0',36,20);
  }
  drawFS(); drawBio();
  window.addEventListener('resize',function(){ drawFS(); drawBio(); });
})();
</script>
