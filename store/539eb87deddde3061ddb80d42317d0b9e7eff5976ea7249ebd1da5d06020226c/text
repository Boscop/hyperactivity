bl-align-tick-band : (Bool × Word) → Word → Word → ((Bool × Word) × (Bool × Word))
bl-align-tick-band tk ts halfW =
  let ctr = %wmul (%wdiv (%wadd (snd tk) (%wdiv ts #2)) ts) ts
  in if fst tk
     then ((true , %wadd ctr halfW) , (true , %wsub ctr halfW))
     else ((false , %wsub ctr halfW) , (false , %wadd ctr halfW))
