-- Full Framed Binary GDSII v6.0 Library Serializer (`HEADER #600` + `BGNLIB` + `BGNSTR` + body + `ENDSTR` + `ENDLIB`)
gds-encode-body : Word → Word → List Rect → List Word
gds-encode-body layer dtype nil =
  cons #4 (cons gds-rec-endstr (cons #4 (cons gds-rec-endlib nil)))
gds-encode-body layer dtype (cons r rs) =
  list-append (gds-encode-one layer dtype r) (gds-encode-body layer dtype rs)
