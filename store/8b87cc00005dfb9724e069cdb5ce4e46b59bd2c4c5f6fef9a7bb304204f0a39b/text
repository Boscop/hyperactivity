-- ---------------------------------------------------------------- transport and composition
-- a body moved under one more binder: its variables that point outside it point one further
nk-shift : Word → NkTm → NkTm
nk-shift d (nk-var i) = if %wlt i d then nk-var i else nk-var (%wsucc i)
nk-shift d (nk-lam b) = nk-lam (nk-shift (%wsucc d) b)
nk-shift d (nk-con c as) = nk-con c (nk-shift d as)
nk-shift d (nk-op h p as) = nk-op h (nk-shift d p) (nk-shift d as)
nk-shift d (nk-match h p cs) = nk-match h (nk-shift d p) (nk-shift d cs)
nk-shift d (nk-cons t r) = nk-cons (nk-shift d t) (nk-shift d r)
nk-shift d t = t
