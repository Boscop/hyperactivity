xp-sp-y : (g : List XpTy) → (a b : XpExpr) → (A : XpTy) → XpDer (g , a , xt-nat) →
  ((T : XpTy) → xp-infer g b ≡ inl T → XpDer (g , b , T)) → (y : Sum XpTy Unit) → xp-infer g b ≡ y → xp-plus-ty-r y ≡ inl A → XpDer (g , xp-plus a b , A)
xp-sp-y g a b A da sb (inl t2) eb h = xp-sp-y2 g a b A da sb t2 eb h
xp-sp-y g a b A da sb (inr u) eb h = Empty-rec (xp-inr-inl A h)
