vocab-add-all : (t : List Word) → (vs ys : List (List Word)) → AllInVocab vs ys → AllInVocab (vocab-add t vs) ys
vocab-add-all t vs ys =
  case ys return (λ u → AllInVocab vs u → AllInVocab (vocab-add t vs) u) of
    nil → λ _ → unit
    cons y r → λ h → (vocab-add-keep t y vs (fst h) , rec r (snd h))
