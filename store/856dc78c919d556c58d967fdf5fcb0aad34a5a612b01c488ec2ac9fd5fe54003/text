s-unpack-missing : List (List Word) → List (List Word) → Proc W Bool
s-unpack-missing have nil = ret true
s-unpack-missing have (cons ph r) =
  if orB (h-null ph) (h-has ph have) then s-unpack-missing have r
  else bind (s-unpack-one (list-append "packs/" ph)) (λ rc →
    if weq rc #0 then bind (s-record-pack ph) (λ u → s-unpack-missing (cons ph have) r)
    else ret {lzero} {W} false)
