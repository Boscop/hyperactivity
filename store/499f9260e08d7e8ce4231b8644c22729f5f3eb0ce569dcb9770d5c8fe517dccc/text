-- ---------------------------------------------------------------- 3. Native 7nm NLDM CMOS Liberty `.lib` PDK Emitter
-- Emits valid IEEE Liberty `.lib` with 2×2 `(slew, C_load)` NLDM lookup tables matching `pnr.cub`,
-- consumed directly by `yosys` (`dfflibmap -liberty` + `abc -liberty`) for gate-level synthesis & STA.
lib-nldm-pin : List Word → List Word → List Word → List Word
lib-nldm-pin rpin dly trn =
  sv-lines
    (cons (list-append "      timing() { related_pin : " (list-append (sv-q rpin) ";"))
    (cons (list-append "        cell_rise(nldm2x2) { values(" (list-append dly "); }"))
    (cons (list-append "        cell_fall(nldm2x2) { values(" (list-append dly "); }"))
    (cons (list-append "        rise_transition(nldm2x2) { values(" (list-append trn "); }"))
    (cons (list-append "        fall_transition(nldm2x2) { values(" (list-append trn "); }"))
    (cons "      }" nil))))))
