bytes-dec-enc : (n : Nat) → (w : BitVec (bytes-bits n)) → bytes-dec n (bytes-enc n w) ≡ w
bytes-dec-enc zero w = sf-unit w
bytes-dec-enc (suc n) w = concat {lzero} {BitVec (bytes-bits (suc n))}
  {bv-cat (bytes-bits n) 8 (bytes-dec n (bytes-enc n (fst (bv-split (bytes-bits n) 8 w)))) (snd (bv-split (bytes-bits n) 8 w))}
  {bv-cat (bytes-bits n) 8 (fst (bv-split (bytes-bits n) 8 w)) (snd (bv-split (bytes-bits n) 8 w))} {w}
  (λ k → bv-cat (bytes-bits n) 8 (bytes-dec-enc n (fst (bv-split (bytes-bits n) 8 w)) k) (snd (bv-split (bytes-bits n) 8 w)))
  (bv-cat-split (bytes-bits n) 8 w)
