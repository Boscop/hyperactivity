-- the normal form's coordinates stand for the same difference: toZ2 (fromZ2 (p , q)) = (p' , q') with
-- p + q' = p' + q, by induction on q then p
toZ2-fromZ2-step : (q2 : Word) → ((p : Word) → plusw (fst (toZ2 (fromZ2 (p , q2)))) q2 ≡ plusw p (snd (toZ2 (fromZ2 (p , q2))))) →
                   (p : Word) → plusw (fst (toZ2 (fromZ2 (p , %wsucc q2)))) (%wsucc q2) ≡ plusw p (snd (toZ2 (fromZ2 (p , %wsucc q2))))
toZ2-fromZ2-step q2 h p =
  %welimP (λ u → plusw (fst (toZ2 (fromZ2 (u , %wsucc q2)))) (%wsucc q2) ≡ plusw u (snd (toZ2 (fromZ2 (u , %wsucc q2))))) p
    (congw (λ z → plusw #0 (%wsucc z)) (sym (fromNat-toNat q2)))
    (λ p2 h2 → congw (λ z → %wsucc z) (h p2) ∙ sym (plusw-suc-l p2 (snd (toZ2 (fromZ2 (p2 , q2))))))
