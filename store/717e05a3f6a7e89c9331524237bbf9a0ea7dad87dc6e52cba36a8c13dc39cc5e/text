bn-rmd-rounds : Nat → Word → List Word → List Word → List Word
bn-rmd-rounds zero    j x16 st = st
bn-rmd-rounds (suc k) j x16 st =
  let al   = bn-nth-w #0 st
      bl   = bn-nth-w #1 st
      cl   = bn-nth-w #2 st
      dl   = bn-nth-w #3 st
      el   = bn-nth-w #4 st
      ar   = bn-nth-w #5 st
      br   = bn-nth-w #6 st
      cr   = bn-nth-w #7 st
      dr   = bn-nth-w #8 st
      er   = bn-nth-w #9 st
      rndL = %wdiv j #16
      rndR = %wsub #4 rndL
      rl   = bn-nth-w j bn-rmd-rl
      sl   = bn-nth-w j bn-rmd-sl
      rr   = bn-nth-w j bn-rmd-rr
      sr   = bn-nth-w j bn-rmd-sr
      sumL = bn-add32 al (bn-add32 (bn-rmd-f rndL bl cl dl) (bn-add32 (bn-nth-w rl x16) (bn-rmd-kl rndL)))
      tl   = bn-add32 (bn-rotl32 sumL sl) el
      sumR = bn-add32 ar (bn-add32 (bn-rmd-f rndR br cr dr) (bn-add32 (bn-nth-w rr x16) (bn-rmd-kr rndL)))
      tr   = bn-add32 (bn-rotl32 sumR sr) er
      nx   = cons el (cons tl (cons bl (cons (bn-rotl32 cl #10) (cons dl
             (cons er (cons tr (cons br (cons (bn-rotl32 cr #10) (cons dr nil)))))))))
  in bn-rmd-rounds k (%wadd j #1) x16 nx
