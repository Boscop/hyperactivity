-- ── 4. Pure JSON Emitter for BeingSpec (/hx/being-spec.json) ─────────────────
b-qstr : List Word → List Word
b-qstr s = cons #34 (list-append s (cons #34 nil))

b-kv : List Word → List Word → List Word
b-kv k v = h-concat (cons (b-qstr k) (cons ":" (cons v nil)))

b-kvs : List Word → List Word → List Word
b-kvs k v = b-kv k (b-qstr v)

b-join-comma : List (List Word) → List Word
b-join-comma nil = nil
b-join-comma (cons x nil) = x
b-join-comma (cons x xs) = h-concat (cons x (cons "," (cons (b-join-comma xs) nil)))

b-obj : List (List Word) → List Word
b-obj fs = h-concat (cons "{" (cons (b-join-comma fs) (cons "}" nil)))

b-arr : List (List Word) → List Word
b-arr xs = h-concat (cons "[" (cons (b-join-comma xs) (cons "]" nil)))

emit-dipole-json : DipolePair → List Word
emit-dipole-json (dipole-pair rA sA rB sB g) =
  b-obj (cons (b-kv "radA" (h-decimal rA))
        (cons (b-kv "spdA" (h-decimal sA))
        (cons (b-kv "radB" (h-decimal rB))
        (cons (b-kv "spdB" (h-decimal sB))
        (cons (b-kv "gamma" (h-decimal g)) nil)))))

emit-lens-json : LensSpec → List Word
emit-lens-json (lens-spec id lbl) =
  b-obj (cons (b-kvs "id" id) (cons (b-kvs "label" lbl) nil))

emit-hop-json : RouteHop → List Word
emit-hop-json (route-hop f t h) =
  b-obj (cons (b-kvs "from" f) (cons (b-kvs "to" t) (cons (b-kvs "hint" h) nil)))

being-spec-json : BeingSpec → List Word
being-spec-json (being-spec ds sc nn kr ls hs) =
  b-obj (cons (b-kvs "source" "lib/being.hypercubical")
        (cons (b-kvs "wasm" "/hx/being-field.wasm")
        (cons (b-kvs "css" "/hx/being.css")
        (cons (b-kv "streamCount" (h-decimal sc))
        (cons (b-kv "netNodes" (h-decimal nn))
        (cons (b-kv "kanRadius" (h-decimal kr))
        (cons (b-kv "dipoles" (b-arr (list-map emit-dipole-json ds)))
        (cons (b-kv "lenses" (b-arr (list-map emit-lens-json ls)))
        (cons (b-kv "hops" (b-arr (list-map emit-hop-json hs))) nil)))))))))

being-default-json : List Word
being-default-json = being-spec-json being-default
