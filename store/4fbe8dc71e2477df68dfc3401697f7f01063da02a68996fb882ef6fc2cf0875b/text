-- ── 1. Exact Modular 32-bit Signed Ring for Dipole & Stokes Conservation ─────
b-w32 : Word → Word
b-w32 x = %wand x #4294967295

b-add32 : Word → Word → Word
b-add32 a b = b-w32 (%wadd a b)

b-neg32 : Word → Word
b-neg32 x = b-w32 (%wsub #4294967296 (b-w32 x))

-- Balanced Lamb-Oseen vortex dipole pair: (+gamma, -gamma) cancels far-field circulation
data DipolePair = dipole-pair (radA : Word) (spdA : Word) (radB : Word) (spdB : Word) (gamma : Word)

dipole-net-circ : DipolePair → Word
dipole-net-circ (dipole-pair _ _ _ _ g) = b-add32 g (b-neg32 g)

dipoles-net-circ : List DipolePair → Word
dipoles-net-circ nil = #0
dipoles-net-circ (cons dp rest) = b-add32 (dipole-net-circ dp) (dipoles-net-circ rest)

-- Generalized Stokes Theorem on two adjacent 2-simplices Δ₁ ∪ Δ₂ sharing interior edge e:
--   ∂(Δ₁ + Δ₂) = (a + b + e) + (c + d - e) = a + b + c + d  (interior flux cancels identically!)
stokes-two-simplex : Word → Word → Word → Word → Word → Word
stokes-two-simplex a b c d e =
  b-add32 (b-add32 (b-add32 a b) e) (b-add32 (b-add32 c d) (b-neg32 e))

stokes-boundary-only : Word → Word → Word → Word → Word
stokes-boundary-only a b c d = b-add32 (b-add32 a b) (b-add32 c d)

stokes-interior-cancel-cert :
  stokes-two-simplex #17 #29 #43 #61 #99991 ≡ stokes-boundary-only #17 #29 #43 #61
stokes-interior-cancel-cert = refl

