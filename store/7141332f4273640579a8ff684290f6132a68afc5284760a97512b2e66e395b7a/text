-- one bit of a: the bit's copy of b plus twice the rest's product
bin-mul-step : (x : Bool) → (xs b : List Bool) → bin-to-nat (bin-mul xs b) ≡ times (bin-to-nat xs) (bin-to-nat b) → bin-to-nat (bin-mul (cons x xs) b) ≡ times (bin-to-nat (cons x xs)) (bin-to-nat b)
bin-mul-step x xs b h =
  case x return λ u → bin-to-nat (bin-mul (cons u xs) b) ≡ times (bin-to-nat (cons u xs)) (bin-to-nat b) of
    true → transN (bin-add-sound b (bin-cons false (bin-mul xs b)))
      (congN (plus (bin-to-nat b)) (transN (bin-cons-sound false (bin-mul xs b)) (transN (congN (times 2) h) (symN (times-assoc 2 (bin-to-nat xs) (bin-to-nat b))))))
    false → transN (bin-cons-sound false (bin-mul xs b)) (transN (congN (times 2) h) (symN (times-assoc 2 (bin-to-nat xs) (bin-to-nat b))))
