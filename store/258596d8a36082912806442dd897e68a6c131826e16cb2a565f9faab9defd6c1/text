z-trans : (x y w : ZWord) → z-eq x y → z-eq y w → z-eq x w
z-trans x y w h1 h2 =
  let env = z6-env (fst x) (snd x) (fst y) (snd y) (fst w) (snd w)
      s1 = same-norm-eq env
             (lc-add (lc-add (lc-var #0) (lc-var #5)) (lc-add (lc-var #2) (lc-var #3)))
             (lc-add (lc-add (lc-var #0) (lc-var #3)) (lc-add (lc-var #2) (lc-var #5))) refl
      s2 = cong2w plusw h1 h2
      s3 = same-norm-eq env
             (lc-add (lc-add (lc-var #2) (lc-var #1)) (lc-add (lc-var #4) (lc-var #3)))
             (lc-add (lc-add (lc-var #4) (lc-var #1)) (lc-add (lc-var #2) (lc-var #3))) refl
  in plusw-cancel-r (plusw (fst y) (snd y)) (plusw (fst x) (snd w)) (plusw (fst w) (snd x))
       (catw s1 (catw s2 s3))
