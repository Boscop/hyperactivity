-- ---------------------------------------------------------------- instantiation
-- inst k b s p: the pattern p with its metavariables replaced from s, each bound code shifted by
-- the binders b it is placed under
inst k b s p =
  cmap (λ q e → case q of
                  cvar n → (if %wlt n (%wadd k e) then some q
                            else (case mlookup s (%wsub n (%wadd k e)) of some c → some (shift-code #0 e c); none → some q))
                  _ → none) b p
