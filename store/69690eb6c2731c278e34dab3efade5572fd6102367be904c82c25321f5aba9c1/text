cir-emit-gates-sv : Word → List (Word × Word) → List Word → List Word
cir-emit-gates-sv _ nil acc = acc
cir-emit-gates-sv idx (cons g rest) acc =
  cir-ln (list-append "  wire w" (list-append (ce-dec idx) (list-append " = ~(w" (list-append (ce-dec (fst g))
    (list-append " & w" (list-append (ce-dec (snd g)) ");"))))))
    (cir-emit-gates-sv (%wsucc idx) rest acc)
