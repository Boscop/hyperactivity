prof-cost-after : FactorStats → OptAction → Word
prof-cost-after (fstats fid0 a c e u o tw0) opt-hyperfactor = %wadd a (%wadd (%wdiv c #4) (%wadd e (%wadd u o)))
prof-cost-after (fstats fid0 a c e u o tw0) opt-erase-dead  = %wadd a (%wadd c (%wadd #1 (%wadd u o)))
prof-cost-after (fstats fid0 a c e u o tw0) opt-inline-ann  = %wadd a (%wadd c (%wadd e o))
prof-cost-after (fstats fid0 a c e u o tw0) opt-poly-tile   = %wadd a (%wadd c (%wadd e (%wadd u (%wdiv o #4))))
prof-cost-after (fstats fid0 a c e u o tw0) opt-optimal     = %wadd a (%wadd c (%wadd e (%wadd u o)))
