-- not (b < a) and not (c < b): not (c < a)
ltn-nlt-trans : (a b c : Nat) → ltn b a ≡ false → ltn c b ≡ false → ltn c a ≡ false
ltn-nlt-trans a =
  case a return λ y → (b c : Nat) → ltn b y ≡ false → ltn c b ≡ false → ltn c y ≡ false of
    zero →
      λ b c →
        case c return λ z → ltn b zero ≡ false → ltn z b ≡ false → ltn z zero ≡ false of
          zero → λ e f i → false
          suc c1 → λ e f i → false
    suc a1 →
      λ b →
        case b return λ w → (c : Nat) → ltn w (suc a1) ≡ false → ltn c w ≡ false → ltn c (suc a1) ≡ false of
          zero → λ c e f → Empty-rec (true≢false e)
          suc b1 →
            λ c →
              case c return λ z → ltn (suc b1) (suc a1) ≡ false → ltn z (suc b1) ≡ false → ltn z (suc a1) ≡ false of
                zero → λ e f → Empty-rec (true≢false f)
                suc c1 → λ e f → rec a1 b1 c1 e f
