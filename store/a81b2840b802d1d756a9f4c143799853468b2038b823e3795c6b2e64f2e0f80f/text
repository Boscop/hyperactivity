-- the kept list when it was made at this time of the source's modules directory (a reader's document added or
-- taken out changes that time), else the list made again and kept
hi-readers-or : List Word → List Word → Sum Unit (List Word) → Proc W (List (List Word))
hi-readers-or st t (inr c) = if h-eq (hi-first (h-lines c)) t then ret {lzero} {W} (h-tail-lists (h-lines c)) else
  bind (h-list (list-append h-index "/modules")) (λ hs → hi-readers-made st t (list-map h-unhex (hi-hex-readers hs)))
hi-readers-or st t (inl u) = bind (h-list (list-append h-index "/modules")) (λ hs → hi-readers-made st t (list-map h-unhex (hi-hex-readers hs)))
