net-eval : {O0 O1 O2 Out R : Type} → (k n : Nat) → Alg O0 O1 O2 R → (SumFin n → R) → Net O0 O1 O2 Out n k → Out → R
net-eval {O0} {O1} {O2} {Out} {R} k =
  case k return (λ m → (n : Nat) → Alg O0 O1 O2 R → (SumFin n → R) → Net O0 O1 O2 Out n m → Out → R) of
    zero → λ n alg env f o → fold alg env (f o)
    suc j → λ n alg env lk o → rec j (suc n) alg (ext-env (fold alg env (fst lk)) env) (snd lk) o
