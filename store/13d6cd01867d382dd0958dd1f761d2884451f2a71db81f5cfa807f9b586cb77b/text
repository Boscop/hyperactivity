-- every helper of nk-build, nk-rule, and nk-plan satisfies the two-ended wire discipline and advances n monotonically
nk-era-env-wf : (ins outs : NkEnv) (n0 n1 : NkW) (e : NkEnv) (fx : NkFx) →
  (nk-env-in-set ins n0 n1 e ≡ true) → (nk-fx-wf ins outs n0 n1 fx ≡ true) →
  nk-fx-wf ins outs n0 n1 (nk-era-env e fx) ≡ true
nk-era-env-wf ins outs n0 n1 nke-nil fx he hf = hf
nk-era-env-wf ins outs n0 n1 (nke-cons w r) fx he hf =
  nk-and-intro (nk-in-set ins n0 n1 w) (nk-fx-wf ins outs n0 n1 (nk-era-env r fx))
    (nk-and-l (nk-in-set ins n0 n1 w) (nk-env-in-set ins n0 n1 r) he)
    (nk-era-env-wf ins outs n0 n1 r fx (nk-and-r (nk-in-set ins n0 n1 w) (nk-env-in-set ins n0 n1 r) he) hf)
