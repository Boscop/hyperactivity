        (psym (Mean Γ (TV (s-fam f-pi a b))) (fmapM Γ (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) (app-mean Γ a b F A pA)) F
          (pcat (Mean Γ (TV (s-fam f-pi a b))) (fmapM Γ (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) (app-mean Γ a b F A pA)) (fmapM Γ (TV (s-fam f-pi a b)) (TV (s-fam f-pi a b)) (λ q → q) F) F
            (retype-fst Γ a (TV (s-fam f-pi a b)) (AppV a b) (λ q → fam-dom a b (fst q)) (λ q v → (fst q , snd q , v)) F A pA (TV (s-fam f-pi a b)) (app-f a b) (λ q → q) (λ i u v → u))
            (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (TV (s-fam f-pi a b))) (snd Γ) F)))
        df)
      (d-tr t-any j-tm Γ a c A (fmapM Γ (AppV a b) (TV a) (app-a a b) (app-mean Γ a b F A pA))
        (psym (Mean Γ (TV a)) (fmapM Γ (AppV a b) (TV a) (app-a a b) (app-mean Γ a b F A pA)) A
          (retype-val Γ a (TV (s-fam f-pi a b)) (AppV a b) (λ q → fam-dom a b (fst q)) (λ q v → (fst q , snd q , v)) F A pA (app-a a b) (λ i u v → (fam-dom a b (fst u) , v))))
        dA))
