-- Exact 1-bit 3:2 full-adder conservation: sum + 2*cout = a + b + c
fa-law : (a b c : Bool) →
  plus (bitNat (fa-sum a b c)) (doubleN (bitNat (fa-cout a b c))) ≡ plus (plus (bitNat a) (bitNat b)) (bitNat c)
fa-law false false false = refl
fa-law false false true  = refl
fa-law false true  false = refl
fa-law false true  true  = refl
fa-law true  false false = refl
fa-law true  false true  = refl
fa-law true  true  false = refl
fa-law true  true  true  = refl
