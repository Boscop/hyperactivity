-- the recursion: each thing computed with one less of the count for whatever it needs
nk-ev-go : Nat → NkEvJ → NkEv
nk-ev-go zero j = nkev-nil
nk-ev-go (suc k) (nkevj-tm t e) = nk-ev-tm (nk-ev-go k) t e
nk-ev-go (suc k) (nkevj-el h cs aux v) = nk-ev-fire (nk-ev-go k) (nk-act h cs (nk-ev-hd v) (nk-ev-shape (nk-ev-parts v))) h cs aux v
nk-ev-go (suc k) (nkevj-q d v) = nk-ev-quote (nk-ev-go k) d (nk-ev-hd v) (nk-ev-parts v)
nk-ev-go (suc k) (nkevj-qs d vs) = nk-ev-quotes (nk-ev-go k) d vs
