-- the Farkas step: from L ≤ R and a + R ≤ b + L, a ≤ b
le-cancel-path : (a b L R d1 d2 : Word) → plusw L d1 ≡ R → plusw (plusw a R) d2 ≡ plusw b L →
                 plusw L (plusw a (plusw d1 d2)) ≡ plusw L b
le-cancel-path a b L R d1 d2 h1 h2 =
  catw (plusw-mid L a (plusw d1 d2))
    (catw (congw (λ z → plusw a z) (symw (plusw-assoc L d1 d2)))
      (catw (congw (λ z → plusw a (plusw z d2)) h1)
        (catw (symw (plusw-assoc a R d2)) (catw h2 (plusw-comm b L)))))
