-- Store-Buffer Forwarding Theorem: CAM store-to-load forwarding agrees bit-for-bit with drained
-- architectural memory across ALL aliased store sequences and ALL load addresses!
sbuf-forward-sound : (mem : Word → Nat) → (buf : SBuf) → (addr : Word) →
  sbuf-read mem buf addr ≡ sbuf-drain mem buf addr
sbuf-forward-sound mem buf addr =
  case buf return (λ b → Path Nat (sbuf-read mem b addr) (sbuf-drain mem b addr)) of
    nil → refl
    cons sv rest →
      λ i → if weq addr (fst sv) then snd sv else rec rest i
