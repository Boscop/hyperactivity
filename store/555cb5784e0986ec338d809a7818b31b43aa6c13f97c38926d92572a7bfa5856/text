-- the unit's record layouts (Clang's for the target: the implementation parameters of
-- archive/2026-11-11/PLAN-rev9.md, revision 9, 9 Nov 2026, sha256 4d012c3a10fd…, §5 “The distinctions everything above x86 rests on”, item 1 “The abstract machine is written; implementations are lifted”) as lib/mem/layout.cub's table. A bit-field is not a Field there (a Field is whole
-- bytes): the reader takes a bit-field's position from the unit's cfield directly.
cx-lay-fields : List CField → Target → List CDecl → MRes (List Field)
cx-lay-fields nil t ds = mok nil
cx-lay-fields (cons f fs) t ds = case cx-fld-width f of
  cbw-bits n → cx-lay-fields fs t ds
  cbw-none → mr-bind (cx-mty t ds (cx-fld-type f)) (λ ty → mr-map (λ r →
    cons (Field { fd-name = cx-fld-id f ; fd-off = wquot (cx-fld-bits f) #8 ; fd-ty = ty }) r) (cx-lay-fields fs t ds))
