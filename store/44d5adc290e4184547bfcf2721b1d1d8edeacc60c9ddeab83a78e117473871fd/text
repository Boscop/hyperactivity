rf-adv-get : (app0 : List KvWrite) → (pd0 : KvPend) → (hist : Hist KvS) → (conf : List KvWrite) → (idx : Word) → (fl rest : List (Pkt KvMsg)) → (k v : Word) → (ph2 : KvPhase) →
             RfCore app0 pd0 hist conf idx (ph-get-wait k) fl → Path Word v (kv-store conf k) → SubL {Pkt KvMsg} rest fl →
             RfCore app0 pd0 (cons (kc-get k , v) hist) conf (%wsucc idx) ph2 rest
rf-adv-get app0 pd0 hist conf idx fl rest k v ph2 h hv s =
  ((λ x m → rf-issued-sup conf ph2 x (fst h x m)) ,
   (fst (snd h) ,
    (rf-pend-adv conf conf (ph-get-wait k) ph2 idx (rf-issued-sup conf ph2) pd0 (fst (snd (snd h))) ,
     ((λ p m → rf-msg-adv conf conf (ph-get-wait k) ph2 idx app0 (rf-issued-sup conf ph2) (p-from p) (p-msg p) (fst (snd (snd (snd h))) p (s p m))) ,
      (kv-store conf , (snd (snd (snd (snd h))) , (hv , (λ i → kv-store conf))))))))
