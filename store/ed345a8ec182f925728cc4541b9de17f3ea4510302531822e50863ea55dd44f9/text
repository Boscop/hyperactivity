-- Collect all nonzero exact terms of {15j} for auxiliary doubled spin x ≤ bound.
fifteenj-terms-le :
  Nat →
  Nat → Nat → Nat → Nat → Nat →
  Nat → Nat → Nat → Nat → Nat →
  Nat → Nat → Nat → Nat → Nat →
  List (Nat × CG)
fifteenj-terms-le bound j1 j2 j3 j4 j5 j6 j7 j8 j9 j10 i1 i2 i3 i4 i5 =
  let t = fifteenj-term j1 j2 j3 j4 j5 j6 j7 j8 j9 j10 i1 i2 i3 i4 i5 bound
      keep = not (eqb (fst (snd t)) zero)
  in case bound of
    zero → if keep then cons (zero , t) nil else nil
    suc k →
      let rest = fifteenj-terms-le k j1 j2 j3 j4 j5 j6 j7 j8 j9 j10 i1 i2 i3 i4 i5
      in if keep then cons (suc k , t) rest else rest
