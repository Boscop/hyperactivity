-- Clean memory-staged ERC-20 `transfer(founder20, amount)`:
-- Entry stack: [amount, token, ...] -> transfers `amount` of `token` ONLY to `eth-founder-coinbase-addr20`!
evm-transfer-to-founder : List Word → Word → List EvmInst
evm-transfer-to-founder founder20 revLbl =
  -- Entry stack: [amount, token, ...]
  cons (ev-push (cons #36 nil))
  (cons (ev-op #82)                     -- MSTORE(36, amount); stack: [token, ...]
  (cons (ev-push (cons #96 nil))
  (cons (ev-op #82)                     -- MSTORE(96, token); stack: [...]
  (cons (ev-push (cons #169 (cons #5 (cons #156 (cons #187 nil)))))
  (cons (ev-push (cons #224 nil))
  (cons (ev-op #27)                     -- 0xa9059cbb << 224
  (cons (ev-push nil)
  (cons (ev-op #82)                     -- MSTORE(0, transfer selector)
  (cons (ev-push founder20)
  (cons (ev-push (cons #4 nil))
  (cons (ev-op #82)                     -- MSTORE(4, founder20)
  (cons (ev-push (cons #1 nil))
  (cons (ev-push (cons #128 nil))
  (cons (ev-op #82)                     -- MSTORE(128, 1) default return for non-standard tokens
  (cons (ev-push (cons #32 nil))        -- retLen = 32
  (cons (ev-push (cons #128 nil))       -- retOff = 128
  (cons (ev-push (cons #68 nil))        -- argsLen = 68
  (cons (ev-push nil)                   -- argsOff = 0
  (cons (ev-push nil)                   -- value = 0
  (cons (ev-push (cons #96 nil))
  (cons (ev-op #81)                     -- MLOAD(96) = token
  (cons (ev-op #90)                     -- GAS
  (cons (ev-op #241)                    -- CALL
  (cons (ev-op #21)                     -- ISZERO
  (cons (ev-jmpi revLbl)
  (cons (ev-push (cons #128 nil))
  (cons (ev-op #81)                     -- MLOAD(128)
  (cons (ev-op #21)                     -- ISZERO
  (cons (ev-jmpi revLbl)
  nil)))))))))))))))))))))))))))))
