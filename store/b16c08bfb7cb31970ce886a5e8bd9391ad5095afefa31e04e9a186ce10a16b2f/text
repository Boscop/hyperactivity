-- the tree built from a list holds only its elements
si-all-build : {A : Type} → (P : A → Type) → (f : Nat) → (l : List A) → si-all P l → si-allt P (build f l)
si-all-build P f = case f return λ w → (l : List A) → si-all P l → si-allt P (build w l) of
  zero → λ l h → si-all-spine P l h
  suc g → λ l h →
    (case drop-n (half (list-length l)) l return λ d → si-all P d →
        si-allt P (case d of nil → spine l; cons x r → rnode (build g (take-n (half (list-length l)) l)) (fromNat (list-length (take-n (half (list-length l)) l))) x (build g r)) of
       nil → λ hd → si-all-spine P l h
       cons x r → λ hd → (rec g (take-n (half (list-length l)) l) (si-all-take P (half (list-length l)) l h) , (fst hd , rec g r (snd hd))))
      (si-all-drop P (half (list-length l)) l h)
