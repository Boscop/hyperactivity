-- Exact N× Dataflow Reuse Theorem: an N×N systolic array reduces SRAM operand reads by an EXACT
-- factor of N across ALL tile dimensions N and ALL contraction depths K!
systolic-bw-amplification : (n k : Nat) →
  times n (systolic-tile-reads n k) ≡ naive-tile-reads n k
systolic-bw-amplification n k =
  transN (sym (times-assoc-n n k (plus n n)))
    (transN (congN (λ u → times u (plus n n)) (times-comm-n n k))
      (transN (times-assoc-n k n (plus n n))
        (congN (times k) (times-distr-r n n n))))
