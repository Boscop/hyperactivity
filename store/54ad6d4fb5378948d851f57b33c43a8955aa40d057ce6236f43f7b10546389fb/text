-- ---------------------------------------------------------------- 2. Liberty NLDM Slew & Fanout-Capacitance STA
-- Linearized Liberty `.lib` NLDM 2D cell model:
--   cell_delay(inSlew, cLoad) = d0 + alpha * inSlew + beta * cLoad
--   out_slew(inSlew, cLoad)   = s0 + gamma * cLoad
nldm-delay : Nat → Nat → Nat → Nat → Nat → Nat
nldm-delay d0 alpha beta inSlew cLoad =
  plus d0 (plus (times alpha inSlew) (times beta cLoad))
