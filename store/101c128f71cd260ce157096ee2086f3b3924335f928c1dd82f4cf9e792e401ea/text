toZ2-neg-snd2 : (a : Int) → snd (toZ2 (negZ a)) ≡ fst (toZ2 a)
toZ2-neg-snd2 a =
  case a return (λ w → snd (toZ2 (negZ w)) ≡ fst (toZ2 w)) of
    pos n → (case n return (λ m → snd (toZ2 (negZ (pos m))) ≡ fst (toZ2 (pos m))) of zero → λ i → #0; suc k → λ i → %wsucc (fromNat k))
    negsuc n → λ i → #0
