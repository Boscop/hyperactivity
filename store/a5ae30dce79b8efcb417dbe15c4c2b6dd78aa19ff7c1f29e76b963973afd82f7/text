-- A guessed λ or application: the type tells which it is; the wrong kind is redone.
guess-check k g t T =
  if %weq g #0 then (case %view T of wpath L a b → redo k; _ → check t T)
  else if %weq g #1 then (case %view T of wpi A B → redo k; _ → check t T)
  else check-by-infer (tguess k g t (tval t)) T
