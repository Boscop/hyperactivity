tok-eq-sound : (xs ys : List Word) → isTrue (tok-eq xs ys) → xs ≡ ys
tok-eq-sound xs =
  case xs return λ w → (ys : List Word) → isTrue (tok-eq w ys) → w ≡ ys of
    nil → λ ys → case ys return λ v → isTrue (tok-eq nil v) → nil ≡ v of nil → λ h i → nil; cons y s → λ h → Empty-rec h
    cons x r →
      λ ys →
        case ys return λ v → isTrue (tok-eq (cons x r) v) → cons x r ≡ v of
          nil → λ h → Empty-rec h
          cons y s →
            λ h →
              let p = word-eq-sound x y (and-fst {weq x y} {tok-eq r s} h)
                  q = rec r s (and-snd {weq x y} {tok-eq r s} h)
              in λ i → cons (p i) (q i)
