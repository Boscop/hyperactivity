-- ---------------------------------------------------------------- decided before the frame
-- a static result continued into something that waits for run-time values (R is a function
-- type: the failure is the function that throws)
sr-on : {A : Type} {R : Type (lsuc lzero)} → RSt A → (RExc → R) → (A → R) → R
sr-on r g f = case r of
  sr-ok a → f a
  sr-no e → g e
