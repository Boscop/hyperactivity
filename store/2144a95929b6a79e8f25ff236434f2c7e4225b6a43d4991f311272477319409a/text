nk-check-brs : (NkTm → Word → NkTm → NkTm → NkTm) → NkTm → NkTm → Word → Word → NkTm → NkTm → Word → NkTm → NkTm → NkTm → Bool
nk-check-brs chk kdefs ctx n di ps P j (nk-cons cty cr) (nk-cons h hr) (nk-cons b br) =
  let recs = nk-args h
  in if nk-check-br-fields chk kdefs ctx n di j P recs recs (nk-app-list cty ps) nk-nil (nk-unwrap-susp b)
       then nk-check-brs chk kdefs ctx n di ps P (%wsucc j) cr hr br
       else false
nk-check-brs chk kdefs ctx n di ps P j nk-nil nk-nil nk-nil = true
nk-check-brs chk kdefs ctx n di ps P j ctys hs bs = false
