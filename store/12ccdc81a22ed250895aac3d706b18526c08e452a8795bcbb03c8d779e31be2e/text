ms-law4 : Bool → Bool → Bool → Bool → Bool
ms-law4 a b c d =
  let wa = ms-b2w a; wb = ms-b2w b; wc = ms-b2w c; wd = ms-b2w d
      fc1 = ms-eval1 ms-g-fc4 wa wb wc wd
      fc2 = ms-eval1 ms-g-fc4 wb wa wd wc
      er1 = ms-eval1 ms-g-era4 wa wb wc wd
      er2 = ms-eval1 ms-g-era4 wc wd wa wb
      cm  = ms-eval1 ms-g-comm4 wa wb wc wd
      an  = ms-eval1 ms-g-ann4  wa wb wc wd
      act = %wand wa (%wxor wb #1)
  in if %weq fc1 fc2 then
     if %weq er1 er2 then
     if %weq (%wand cm an) #0 then
       %weq (%wor cm an) act
     else false else false else false
