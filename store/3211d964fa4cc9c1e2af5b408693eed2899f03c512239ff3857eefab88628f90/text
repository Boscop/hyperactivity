-- shared reference dereference (nk-plan-read) preservation: copying parts to fresh reference wires
-- n, nk-s n, ... preserves the exact NkEv meaning of the held value and every wire below n
nk-rho-copy : (NkW → NkEv) → NkEnv → NkW → NkW → NkEv
nk-rho-copy rho nke-nil n = rho
nk-rho-copy rho (nke-cons w r) n = nk-rho-copy (nk-rho-set rho n (rho w)) r (nk-s n)
