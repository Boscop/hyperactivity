-- find-trace n hs s t: a trace of at most n steps from s to t, or none
find-trace : Word → Eqs → ETm → ETm → OTrace
find-trace n hs s t =
  %welimP (λ v → ETm → OTrace) n
    (λ s → (case tm-same s t return (λ w → OTrace) of true → atrace tnil; false → notr))
    (λ k deeper s →
       (case tm-same s t return (λ w → OTrace) of
          true → atrace tnil
          false → try-pos deeper hs (positions s) s))
  s
