-- ---------------------------------------------------------------- (10.19) producer transitions
-- a lookup appends its actual result to D; a request suspends with a fresh token; a response is
-- accepted only for the outstanding token and resumes; return and fault complete the producer
data PrMove (Res : Type) (Rd : Type) (Q : Type) (Tok : Type) (Ans : Type) (A : Type) (Err : Type) =
  prm-lookup (rd : Rd) (r2 : Res) | prm-request (q : Q) (tok : Tok) (r2 : Res) | prm-response (q : Q) (tok : Tok) (a : Ans) | prm-return (v : A) | prm-fault (e : Err)
