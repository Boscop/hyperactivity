-- over replica 0's applied writes and owed reply, the client's history, acknowledged writes,
-- index and phase, and the packets in flight: applied ⊆ issued; acknowledged ⊆ applied; the
-- owed reply and every packet as above; the history is the map's, ending in the store of the
-- acknowledged writes
RfCore : List KvWrite → KvPend → Hist KvS → List KvWrite → Word → KvPhase → List (Pkt KvMsg) → Type
RfCore app0 pd0 hist conf idx ph fl =
  SubL {KvWrite} app0 (rf-issued conf ph) × (SubL {KvWrite} conf app0 × (RfPend conf ph idx pd0 ×
  (((p : Pkt KvMsg) → InL {Pkt KvMsg} p fl → RfMsg conf ph idx app0 (p-from p) (p-msg p)) × HistTo {KvS} {Word → Word} kv-map-world (λ k → #0) hist (kv-store conf))))
