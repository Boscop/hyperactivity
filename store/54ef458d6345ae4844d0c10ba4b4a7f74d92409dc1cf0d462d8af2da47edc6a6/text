-- every exact value an interval surely positive encloses is positive
pos-of-iv : (S S2 : List Bool) → (envI : Nat → IV) → (E : Nat → ZQ) → (e : IE) →
  bcanon S ≡ true → le (suc zero) (bin-to-nat S) → bin-to-nat S2 ≡ times (bin-to-nat S) (bin-to-nat S) → ((j : Nat) → inp S (envI j) (E j)) →
  snd (ieval S S2 envI e) ≡ true → iv-pos-sure (fst (ieval S S2 envI e)) ≡ true → (x : ZQ) → isval E e x → posn x
pos-of-iv S S2 envI E e cS hS hS2 H hf hp x hx = zpos-unscale (fst x) (bin-to-nat S)
  (iv-pos-sure-sound S (fst (ieval S S2 envI e)) (fst x) (snd x) (fst (ie-inp S S2 envI E e x cS hS hS2 H hx hf)) (snd (snd (ie-inp S S2 envI E e x cS hS hS2 H hx hf))) hp
     (fst (snd (ie-inp S S2 envI E e x cS hS hS2 H hx hf))))
