-- a definition whose calls decrease a measure (decreasing by m): recursion on a bound of the measure
wf-go : {A : Type} {P : A → Type} → (m : A → Nat) → ((x : A) → ((y : A) → m y < m x → P y) → P x) →
        (n : Nat) → (x : A) → m x < n → P x
wf-go m s zero x h = Empty-rec h
wf-go m s (suc n) x h = s x (λ y hy → wf-go m s n y (<-step (m y) (m x) n hy h))
