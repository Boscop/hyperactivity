or3-false-elim : (a b c : Bool) → orB a (orB b c) ≡ false →
  (a ≡ false) × (b ≡ false) × (c ≡ false)
or3-false-elim false false false _ = ((λ _ → false) , ((λ _ → false) , (λ _ → false)))
or3-false-elim false false true  h = Empty-rec {lzero} {(false ≡ false) × (false ≡ false) × (true ≡ false)} (false≢true (sym h))
or3-false-elim false true  c     h = Empty-rec {lzero} {(false ≡ false) × (true ≡ false) × (c ≡ false)} (false≢true (sym h))
or3-false-elim true  b     c     h = Empty-rec {lzero} {(true ≡ false) × (b ≡ false) × (c ≡ false)} (false≢true (sym h))
