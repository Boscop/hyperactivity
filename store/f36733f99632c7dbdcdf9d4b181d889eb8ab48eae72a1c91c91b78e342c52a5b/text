s-src-open : (Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)) → Sum Unit (Nat × Sum Unit (List Word)) → List Word → List (List Word)
s-src-open k (inl u) r = if h-prefix "quoted" r then k (inr (suc zero , inl unit)) r else k (inl u) r
s-src-open k (inr g) r = k (inr (suc (fst g) , snd g)) r
