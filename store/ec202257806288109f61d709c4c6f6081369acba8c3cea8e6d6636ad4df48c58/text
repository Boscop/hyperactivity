-- Theorem 2 (De Morgan duality): Given automaticity and consistency, denying SyntheticSynesthesia
-- constructively forces denying CrossModal or denying Learned (when CrossModal is decidable).
reject-synthetic-de-morgan : {CM A C L : Type} → A → C →
  Sum CM (Neg CM) → Neg (SyntheticSynesthesia CM A C L) → Sum (Neg CM) (Neg L)
reject-synthetic-de-morgan a c dec negSyn = case dec of
  inl cm → inr (λ l → negSyn ((cm , (a , c)) , l))
  inr ncm → inl ncm
