-- (line, path) pairs in the order of their lines, stably
os-merge : Nat → List (List Word × List Word) → List (List Word × List Word) → List (List Word × List Word)
os-merge zero a b = list-append a b
os-merge (suc f) nil b = b
os-merge (suc f) (cons x xs) nil = cons x xs
os-merge (suc f) (cons x xs) (cons y ys) = if h-lt (fst y) (fst x) then cons y (os-merge f (cons x xs) ys) else cons x (os-merge f xs (cons y ys))
