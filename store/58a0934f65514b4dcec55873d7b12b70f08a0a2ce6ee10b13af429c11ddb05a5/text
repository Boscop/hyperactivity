-- may this request change the source: with a token, only a request carrying it via X-Token or
-- Authorization: Bearer (case-insensitive header names); with none, only when the server is not public
s-tok-diff : List Word → List Word → Word
s-tok-diff nil nil = #0
s-tok-diff (cons a as) (cons b bs) = wor (wxor a b) (s-tok-diff as bs)
s-tok-diff xs ys = #1
