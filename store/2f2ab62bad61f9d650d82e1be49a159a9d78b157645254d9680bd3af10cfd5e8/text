-- ---------------------------------------------------------------- data and word evaluation agreement
nk-dbl-two : NkTm
nk-dbl-two =
  let z0 = nk-mk-dcon #1 #0 nk-nil
      hyps = nk-con #42 (nk-cons (nk-con #42 nk-nil) (nk-cons (nk-con #42 (nk-cons (nk-num #1) nk-nil)) nk-nil))
      b1 = nk-lam (nk-lam (nk-mk-dcon #1 #1 (nk-cons (nk-mk-dcon #1 #1 (nk-cons (nk-force (nk-var #0)) nk-nil)) nk-nil)))
      cs = nk-cons hyps (nk-cons (nk-con #43 nk-nil) (nk-cons (nk-susp z0) (nk-cons (nk-susp b1) nk-nil)))
  in nk-match #3 (nk-mk-dcon #1 #1 (nk-cons (nk-mk-dcon #1 #1 (nk-cons z0 nk-nil)) nk-nil)) cs
