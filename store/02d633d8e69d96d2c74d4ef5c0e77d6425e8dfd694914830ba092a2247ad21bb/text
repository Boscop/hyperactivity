s-seg-add : Bool → List Word → List MdSeg → List MdSeg
s-seg-add t l nil = cons (if t then seg-table (cons l nil) else seg-text (cons l nil)) nil
s-seg-add true l (cons (seg-table ls) r) = cons (seg-table (cons l ls)) r
s-seg-add false l (cons (seg-text ls) r) = cons (seg-text (cons l ls)) r
s-seg-add t l (cons s r) = cons (if t then seg-table (cons l nil) else seg-text (cons l nil)) (cons s r)
