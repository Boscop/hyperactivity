-- their contacts: the strands pair, the helix packs on both
bab-contact : Sse → Sse → Bool
bab-contact x y = case x of
  sse-b1 → (case y of sse-b1 → false; sse-a → true; sse-b2 → true)
  sse-a → (case y of sse-b1 → true; sse-a → false; sse-b2 → true)
  sse-b2 → (case y of sse-b1 → true; sse-a → true; sse-b2 → false)
