-- (part of language-support)
sal_shl_spec_64 : (dst' : Bits #64) → (src : Bits #6) → (input_rflags : rflagsbits) → MF ((Bits #64) × rflagsbits × rflagsbits)
sal_shl_spec_64 dst' src input_rflags =
  let raw_result : ZI
      raw_result = (ash_int (bv-unsigned #64 dst') (bv-unsigned #6 src))
      result' : Bits #64
      result' = (bits_of_int raw_result (zpos #64))
  in let k'8 : (rflagsbits × rflagsbits) → MF ((Bits #64) × rflagsbits × rflagsbits)
         k'8 =
           λ t'7 →
             let output_rflags : rflagsbits
                 output_rflags = (fst t'7)
                 undefined_flags : rflagsbits
                 undefined_flags = (snd t'7)
             in retF {((Bits #64) × rflagsbits × rflagsbits)} (result' , output_rflags , undefined_flags)
     in if (weq src #0) then
          (k'8 (input_rflags , #0))
        else if (weq src #1) then
          (let cf' : Bits #1
               cf' = (bv-slice #64 dst' #63 #63)
           in bindF {Bits #1} {((Bits #64) × rflagsbits × rflagsbits)} (pf_spec64 result') (λ pf' →
                let zf : Bits #1
                    zf = (zf_spec (bv-unsigned #64 result'))
                    sf : Bits #1
                    sf = (sf_spec64 result')
                in bindF {ZI} {((Bits #64) × rflagsbits × rflagsbits)} (b_xor (bv-unsigned #1 cf') (bv-unsigned #1 (logbit_bits #64 (zpos #63) result'))) (λ of' →
                     let output_rflags : rflagsbits
                         output_rflags = (rflagsbits-set-of (rflagsbits-set-sf (rflagsbits-set-zf (rflagsbits-set-pf (rflagsbits-set-cf input_rflags cf') pf') zf) sf) (bits_of_int of' (zpos #1)))
                         undefined_flags : rflagsbits
                         undefined_flags = (rflagsbits-set-af #0 #1)
                     in k'8 (output_rflags , undefined_flags))))
        else if (z-le (zpos #64) (bv-unsigned #6 src)) then
          (bindF {Bits #1} {((Bits #64) × rflagsbits × rflagsbits)} (pf_spec64 result') (λ pf' →
             let zf : Bits #1
                 zf = (zf_spec (bv-unsigned #64 result'))
                 sf : Bits #1
                 sf = (sf_spec64 result')
                 output_rflags : rflagsbits
                 output_rflags = (rflagsbits-set-sf (rflagsbits-set-zf (rflagsbits-set-pf input_rflags pf') zf) sf)
                 undefined_flags : rflagsbits
                 undefined_flags = (rflagsbits-set-of (rflagsbits-set-af (rflagsbits-set-cf #0 #1) #1) #1)
             in k'8 (output_rflags , undefined_flags)))
        else
          (bindF {Bits #1} {((Bits #64) × rflagsbits × rflagsbits)} (bitslice #64 dst' (z-sub (zpos #64) (bv-unsigned #6 src)) (zpos #1)) (λ cf' →
             bindF {Bits #1} {((Bits #64) × rflagsbits × rflagsbits)} (pf_spec64 result') (λ pf' →
               let zf : Bits #1
                   zf = (zf_spec (bv-unsigned #64 result'))
                   sf : Bits #1
                   sf = (sf_spec64 result')
                   output_rflags : rflagsbits
                   output_rflags = (rflagsbits-set-sf (rflagsbits-set-zf (rflagsbits-set-pf (rflagsbits-set-cf input_rflags cf') pf') zf) sf)
                   undefined_flags : rflagsbits
                   undefined_flags = (rflagsbits-set-of (rflagsbits-set-af #0 #1) #1)
               in k'8 (output_rflags , undefined_flags))))
