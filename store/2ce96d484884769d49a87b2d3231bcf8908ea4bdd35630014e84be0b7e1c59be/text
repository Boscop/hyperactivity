rm-bytes-wr : Word → Target → MPtr → UInt64 → REv Unit
rm-bytes-wr n t p v =
  %welimP (λ x → REv Unit) n (rm-ret unit)
    (λ j acc → rm-then acc
       (rm-bind (rm-off p (case tg-endian t of
                             en-little → j
                             en-big → wsub (wsub n #1) j)) (λ q →
        ev-store {lzero} {NoS} {RExc} t (sk-int false iw8) q
          (sv-i (u64and (u64shr v (u64 (wmul j #8))) (u64 #255))))))
