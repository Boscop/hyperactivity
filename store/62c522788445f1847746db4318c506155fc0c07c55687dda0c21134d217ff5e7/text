sub-pull : (Δ Γ : CCtx) (Z : Type 1) (S : DCube (dims (fst Δ)) (CtxV (fst Δ)) (SubF (fst Δ) (fst Γ)) (snd Δ)) →
  DCube (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (sub-base Δ Γ S) → Mean Δ Z
sub-pull Δ Γ Z S E =
  dcube-pull (dims (fst Δ)) (CtxV (fst Δ)) (CtxV (fst Γ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z) (FbE (fst Γ) Z)
    (λ γ' p → fst p) (λ γ' p e ρ → e (snd p ρ)) (snd Δ) S E
