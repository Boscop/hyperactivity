-- One 8-op ILP-pipelined `lop3.b32` round over registers `%r4 .. %r11` (zero read-after-write stall!):
ht-unroll-round8 : List Word
ht-unroll-round8 =
  h-concat
    (cons (ht-lop3-ln #4  #4  #5  #6  ht-imm-xor3)
    (cons (ht-lop3-ln #5  #5  #6  #7  ht-imm-maj3)
    (cons (ht-lop3-ln #6  #6  #7  #8  ht-imm-mux3)
    (cons (ht-lop3-ln #7  #7  #8  #9  ht-imm-rel3)
    (cons (ht-lop3-ln #8  #8  #9  #10 ht-imm-xor3)
    (cons (ht-lop3-ln #9  #9  #10 #11 ht-imm-maj3)
    (cons (ht-lop3-ln #10 #10 #11 #4  ht-imm-mux3)
    (cons (ht-lop3-ln #11 #11 #4  #5  ht-imm-xor3) nil))))))))
