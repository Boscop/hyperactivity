ml-if-le-r : (a b : Nat) → ml-le (if ml-le a b then a else b) b ≡ true
ml-if-le-r zero    b       = refl
ml-if-le-r (suc a) zero    = refl
ml-if-le-r (suc a) (suc b) =
  let p = ml-if-suc (ml-le a b) a b
      q = ml-if-le-r a b
  in λ i → comp (λ j → Bool) (λ j → [ i = 0 ↦ ml-le (p (~ j)) (suc b) , i = 1 ↦ true ]) (q i)
