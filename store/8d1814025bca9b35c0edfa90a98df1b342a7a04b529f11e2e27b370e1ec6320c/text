drop-nsup : (c : Conj) (f : DNF) → every-c (λ e → not (conj-sub c e)) (dnf-drop-sup c f) ≡ true
drop-nsup c lnil = λ i → true
drop-nsup c (lcons d ds) =
  bool-case0 (λ b → conj-sub c d ≡ b → every-c (λ e → not (conj-sub c e)) (if b then dnf-drop-sup c ds else lcons d (dnf-drop-sup c ds)) ≡ true) (conj-sub c d)
    (λ e x → drop-nsup c ds)
    (λ e x → andB-intro (not (conj-sub c d)) (every-c (λ e → not (conj-sub c e)) (dnf-drop-sup c ds)) (λ i → not (e i)) (drop-nsup c ds))
    (λ i → conj-sub c d)
