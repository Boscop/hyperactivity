-- 32-Byte `HXSV` (`0x48585356`) Confluent Swarm Bus Capsule for `HX-VIDEO-SUPEROPT`:
vso-mask32 : Word → Word
vso-mask32 x = %wand x #4294967295

vso-mix32 : Word → Word → Word
vso-mix32 h x = vso-mask32 (%wxor (%wmul (%wadd h #2654435761) #2246822519) x)

vso-put32 : Word → List Word → List Word
vso-put32 w rest =
  let x = vso-mask32 w
  in cons (%wand (%wshr x #24) #255)
     (cons (%wand (%wshr x #16) #255)
     (cons (%wand (%wshr x #8) #255)
     (cons (%wand x #255) rest)))

vso-pack-hxsv : Word → Word → Word → Word → Word → List Word
vso-pack-hxsv secret seq bpwX1000 speedupX1000 vramMb =
  let m1 = vso-mix32 (vso-mix32 (vso-mix32 (vso-mix32 (vso-mask32 secret) seq) bpwX1000) speedupX1000) vramMb
      m2 = vso-mix32 m1 #402
  in vso-put32 #1213748054 -- "HXSV"
     (vso-put32 seq
     (vso-put32 bpwX1000
     (vso-put32 speedupX1000
     (vso-put32 vramMb
     (vso-put32 #8453
     (vso-put32 m1
     (vso-put32 m2 nil)))))))

