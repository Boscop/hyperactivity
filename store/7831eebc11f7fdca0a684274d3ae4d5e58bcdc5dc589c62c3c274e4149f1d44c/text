vso-sub-pos : Word → Word → Word
vso-sub-pos a b = if %wlt b a then %wsub a b else #0

-- Physical marginal GPU memory-traffic cost in micro-USDC (`paramsM * steps * bpw * cfgPasses / 4000`):
--   * Naive raw BF16 Dual-CFG (`bpw=16, cfgPasses=2` -> 32 bits/weight/step): `14288 * 50 * 32 / 4000 = 5,715 uUSDC`
--   * Lossless `HX-VIDEO-ZIP` Fused Dual-CFG (`bpw=12, cfgPasses=1` -> 12 bits/weight/step): `14288 * 50 * 12 / 4000 = 2,143 uUSDC`
vso-gpu-cost-uusdc : Word → Word → Word → Word → Word
vso-gpu-cost-uusdc paramsM steps bpw cfgPasses =
  %wdiv (%wmul (%wmul paramsM steps) (%wmul bpw cfgPasses)) #4000

vso-settle-x402-kkt : Word → Word → Word → Word → X402VideoSplit
vso-settle-x402-kkt grossUusdc gpuCostUusdc cSat curCap =
  let gpuPart = vso-min-w grossUusdc gpuCostUusdc
      surplus = vso-sub-pos grossUusdc gpuPart
      capGap  = vso-sub-pos cSat curCap
      resPart = vso-min-w surplus capGap
      fndPart = %wsub surplus resPart
  in mk-vsplit fndPart gpuPart resPart

vso-split-sum : X402VideoSplit → Word
vso-split-sum (mk-vsplit f g r) = %wadd f (%wadd g r)

