skip-d : (e : Entry) (sk' : Lst Entry) (X : Type 1) (F : X → Type 1) (c : Cube (dims sk') X) →
  DCube (dims sk') X F c → DCube (dims (lcons e sk')) X F (skip-cube e sk' X c)
skip-d (e-ty s) sk' X F c d = d
skip-d e-dim sk' X F c d = dcube-reidx (dims sk') X (Line X) F (LineO X F) (degen-l X) (degen-o X F) c d
