encl-within : (S : List Bool) → (W O : IV) → (X : Nat × Nat) → (q : Nat) → ivc W → ivc O → iv-within S W O ≡ true → encl S W X q → encl S O X q
encl-within S W O X q cW cO h e =
  (zle-trans (zsc (zv (fst O)) q) (zsc (zv (fst W)) q) (zsc X (bin-to-nat S))
     (zle-scale (zv (fst O)) (zv (fst W)) q (bz-le-true (fst (fst O)) (snd (fst O)) (fst (fst W)) (snd (fst W)) (fst cO) (fst cW) (both-true-l (bz-le (fst O) (fst W)) (bz-le (snd W) (snd O)) h)))
     (fst e) ,
   zle-trans (zsc X (bin-to-nat S)) (zsc (zv (snd W)) q) (zsc (zv (snd O)) q) (snd e)
     (zle-scale (zv (snd W)) (zv (snd O)) q (bz-le-true (fst (snd W)) (snd (snd W)) (fst (snd O)) (snd (snd O)) (snd cW) (snd cO) (both-true-r (bz-le (fst O) (fst W)) (bz-le (snd W) (snd O)) h))))
