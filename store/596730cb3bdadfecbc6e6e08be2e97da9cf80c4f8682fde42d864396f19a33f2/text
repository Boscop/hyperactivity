pfl-ok : {A : Type} → (e : A → List Word) → (d : List Word → A × List Word) →
         ((a : A) → (t : List Word) → d (list-append (e a) t) ≡ (a , t)) →
         (xs : List A) → (tail : List Word) →
         pfl-dec d (list-append (pfl-enc e xs) tail) ≡ (xs , tail)
pfl-ok {A} e d pf xs tail =
  let s1 = cm-append-assoc (pf-enc pf-nat (list-length xs)) (pfl-enc-body e xs) tail
      d1 = pf-ok pf-nat (list-length xs) (list-append (pfl-enc-body e xs) tail)
  in concat {lzero} {List A × List Word}
       {pfl-dec d (list-append (list-append (pf-enc pf-nat (list-length xs)) (pfl-enc-body e xs)) tail)}
       {pfl-dec d (list-append (pf-enc pf-nat (list-length xs)) (list-append (pfl-enc-body e xs) tail))}
       {(xs , tail)}
       (cong {lzero} {lzero} {List Word} {List A × List Word} (pfl-dec d) s1)
       (concat {lzero} {List A × List Word}
          {pfl-dec d (list-append (pf-enc pf-nat (list-length xs)) (list-append (pfl-enc-body e xs) tail))}
          {pfl-dec-body d (list-length xs) (list-append (pfl-enc-body e xs) tail)}
          {(xs , tail)}
          (λ i → pfl-dec-body d (fst (d1 i)) (snd (d1 i)))
          (pfl-body-ok e d pf xs tail))
