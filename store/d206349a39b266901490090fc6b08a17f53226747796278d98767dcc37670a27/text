-- ---------------------------------------------------------------- kinds in memory, by Target
-- the size of a kind's representation, and the alignment its accesses need when the type
-- naming it says nothing else (a C type's alignment is ct-align below: two types of one kind
-- may differ, as long long and double do from their sizes on i386)
sk-size : Target → SK → Word
sk-size t k = case k of
  sk-int sg w → iw-bytes w
  sk-bool → tg-size t ck-bool
  sk-f32 → #4
  sk-f64 → #8
  sk-ptr → tg-size t ck-ptr
