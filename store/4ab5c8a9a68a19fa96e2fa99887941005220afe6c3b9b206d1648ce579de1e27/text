-- ---------------------------------------------------------------- the loop, and the ranks it ends with
loop : List (List Word) → Nat → Nat → List Word → List Word
loop t fuel =
  case fuel return λ w → Nat → List Word → List Word of
    zero → λ h0 r → ranks-of {suffix-ord} (sufs t)
    suc g → λ h0 r → if ltn (suc h0) (list-length t) then rec g (plus h0 (suc h0)) (round (suc h0) r) else r
