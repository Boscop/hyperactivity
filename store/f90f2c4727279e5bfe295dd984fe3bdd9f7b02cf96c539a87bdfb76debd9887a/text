-- Area Monotonicity Theorem: circ-opt NEVER increases gate count (circ-gates (circ-opt c) ≤ circ-gates c)!
opt-not-0-le : (V : Type) → (c : B0) →
  Path Bool (leB (circ-gates {B0} {B1} {B2} {V} (opt-not-0 {V} c)) (suc zero)) true
opt-not-0-le V c =
  case c return (λ k → Path Bool (leB (circ-gates {B0} {B1} {B2} {V} (opt-not-0 {V} k)) (suc zero)) true) of
    b0-false → λ _ → true
    b0-true  → λ _ → true
