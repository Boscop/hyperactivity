h-take-change : List Word → List Word → List Word → Proc W Unit
h-take-change srv m line = bind (h-pointer (h-head-or (h-tail-lists (h-split #32 line)))) (λ p →
  if h-eq p (h-head-or (h-tail-lists (h-tail-lists (h-split #32 line)))) then ret {lzero} {W} unit
  else if h-eq "-" (h-head-or (h-tail-lists (h-tail-lists (h-split #32 line)))) then h-unrecord-raw (h-head-or (h-tail-lists (h-split #32 line)))
  else bind (h-get srv (list-append "/source/text?path=" (h-head-or (h-tail-lists (h-split #32 line))))) (h-take-text m (h-head-or (h-tail-lists (h-split #32 line)))))
