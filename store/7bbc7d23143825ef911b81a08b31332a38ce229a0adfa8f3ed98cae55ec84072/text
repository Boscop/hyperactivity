-- the check of bytes L against the tokens T, decided once when they are made
si-made-ok : List (List Word) → List Word → Bool
si-made-ok T L = andB (si-chk-chain (list-length L) (text-bytes L) #8 (si-o0 T) T)
  (andB (si-chk-tree (list-length L) (text-bytes L) (si-tree T) (si-rd4 (list-length L) (text-bytes L) #0))
    (andB (si-fuel (si-tree T) (toNat (si-rd4 (list-length L) (text-bytes L) #4))) (si-tokens-ok T)))
