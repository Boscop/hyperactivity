-- Backward direction: given a section r : O → S (o (r y) = y), fiber preservation constructs
-- the exact macro-law g y = o (T (r y)) and proves it descends through o.
fiber-preserved-descends : {S O : Type} → (o : S → O) → (T : S → S) →
  (r : O → S) → ((y : O) → o (r y) ≡ y) →
  PreservesFibers o T → (g : O → O) × Descends o T g
fiber-preserved-descends o T r sec pf =
  ((λ y → o (T (r y))) , λ s → pf (r (o s)) s (sec (o s)))
