-- the theta network: two vertices joined by four edges, every edge leaving the first and entering the second, both
-- vertices carrying the quadratic form w
theta-net : List (List (List Rad)) → List NetVertex
theta-net w = cons (w , cons (0 , true) (cons (1 , true) (cons (2 , true) (cons (3 , true) nil)))) (cons (w , cons (0 , false) (cons (1 , false) (cons (2 , false) (cons (3 , false) nil)))) nil)
