-- ── 6. Pure Mechanical CSS Emitter ───────────────────────────────────────────
emit-decl : CssDecl → List Word
emit-decl (css-decl p v) =
  h-concat (cons p (cons ":" (cons v (cons ";" nil))))

emit-decls : List CssDecl → List Word
emit-decls nil = nil
emit-decls (cons d ds) = list-append (emit-decl d) (emit-decls ds)

css-nl : List Word
css-nl = cons #10 nil

emit-rule : CssRule → List Word
emit-rule (css-rule sel ds) =
  h-concat (cons sel (cons "{" (cons (emit-decls ds) (cons "}" (cons css-nl nil)))))

emit-sheet : CssSheet → List Word
emit-sheet nil = nil
emit-sheet (cons r rs) = list-append (emit-rule r) (emit-sheet rs)

being-compiled-css : List Word
being-compiled-css =
  h-concat (cons "/* Compiled from checked lib/ui-algebra.hypercubical (nav-zero-radius + yellow-being = refl) */" (cons css-nl
           (cons (emit-sheet (tx-zero-radius raw-nav-sheet))
           (cons (emit-sheet organic-being-sheet) nil))))

has-backslash : List Word → Bool
has-backslash nil = false
has-backslash (cons c r) = if %weq c #92 then true else has-backslash r

being-css-no-escaped-nl-cert : has-backslash being-compiled-css ≡ false
being-css-no-escaped-nl-cert = refl
