-- ── 1. First-Class Stylesheet Algebra ────────────────────────────────────────
data CssDecl = css-decl (prop : List Word) (val : List Word)
data CssRule = css-rule (sel : List Word) (decls : List CssDecl)

CssSheet : Type
CssSheet = List CssRule

StyleTx : Type
StyleTx = CssSheet → CssSheet

-- ── 2. Higher-Order Style Endofunctors ───────────────────────────────────────
tx-compose : StyleTx → StyleTx → StyleTx
tx-compose f g s = f (g s)

map-decls : (CssDecl → CssDecl) → CssSheet → CssSheet
map-decls f nil = nil
map-decls f (cons (css-rule sel ds) rest) =
  cons (css-rule sel (list-map f ds)) (map-decls f rest)

decl-zero-radius : CssDecl → CssDecl
decl-zero-radius (css-decl p v) =
  if h-eq p "border-radius" then css-decl p "0" else css-decl p v

tx-zero-radius : StyleTx
tx-zero-radius = map-decls decl-zero-radius

decl-recolor : List Word → List Word → CssDecl → CssDecl
decl-recolor oldCol newCol (css-decl p v) =
  if h-eq v oldCol then css-decl p newCol else css-decl p v

tx-recolor : List Word → List Word → StyleTx
tx-recolor oldCol newCol = map-decls (decl-recolor oldCol newCol)

-- ── 3. Decidable Invariant Predicates & Kernel Proofs (refl) ─────────────────
decl-has-nonzero-radius : CssDecl → Bool
decl-has-nonzero-radius (css-decl p v) =
  andB (h-eq p "border-radius") (h-not (h-eq v "0"))

decls-have-nonzero-radius : List CssDecl → Bool
decls-have-nonzero-radius nil = false
decls-have-nonzero-radius (cons d ds) =
  if decl-has-nonzero-radius d then true else decls-have-nonzero-radius ds

sheet-has-nonzero-radius : CssSheet → Bool
sheet-has-nonzero-radius nil = false
sheet-has-nonzero-radius (cons (css-rule _ ds) rs) =
  if decls-have-nonzero-radius ds then true else sheet-has-nonzero-radius rs

decl-has-val : List Word → CssDecl → Bool
decl-has-val target (css-decl _ v) = h-eq v target

decls-have-val : List Word → List CssDecl → Bool
decls-have-val _ nil = false
decls-have-val t (cons d ds) = if decl-has-val t d then true else decls-have-val t ds

sheet-has-val : List Word → CssSheet → Bool
sheet-has-val _ nil = false
sheet-has-val t (cons (css-rule _ ds) rs) = if decls-have-val t ds then true else sheet-has-val t rs

-- Helper constructors
d1 : List Word → List Word → List CssDecl
d1 p v = cons (css-decl p v) nil

d2 : List Word → List Word → List Word → List Word → List CssDecl
d2 p1 v1 p2 v2 = cons (css-decl p1 v1) (d1 p2 v2)

d3 : List Word → List Word → List Word → List Word → List Word → List Word → List CssDecl
d3 p1 v1 p2 v2 p3 v3 = cons (css-decl p1 v1) (d2 p2 v2 p3 v3)

d4 : List Word → List Word → List Word → List Word → List Word → List Word → List Word → List Word → List CssDecl
d4 p1 v1 p2 v2 p3 v3 p4 v4 = cons (css-decl p1 v1) (d3 p2 v2 p3 v3 p4 v4)

d5 : List Word → List Word → List Word → List Word → List Word → List Word → List Word → List Word → List Word → List Word → List CssDecl
d5 p1 v1 p2 v2 p3 v3 p4 v4 p5 v5 = cons (css-decl p1 v1) (d4 p2 v2 p3 v3 p4 v4 p5 v5)

d6 : List Word → List Word → List Word → List Word → List Word → List Word → List Word → List Word → List Word → List Word → List Word → List Word → List CssDecl
d6 p1 v1 p2 v2 p3 v3 p4 v4 p5 v5 p6 v6 = cons (css-decl p1 v1) (d5 p2 v2 p3 v3 p4 v4 p5 v5 p6 v6)

