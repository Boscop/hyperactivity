adj-from-drc : (minS : Nat) → (rs : List Rect) → (r : Rect) →
  check-adj-from minS r rs ≡ true → PairwiseDrc minS (cons r rs)
adj-from-drc minS nil = λ r _ → (unit , unit)
adj-from-drc minS (cons nxt tail) = λ r hAdj →
  let hSep  = andB-fst (drc-sep-x minS r nxt) (check-adj-from minS nxt tail) hAdj
      hTail = andB-snd (drc-sep-x minS r nxt) (check-adj-from minS nxt tail) hAdj
  in (adj-implies-after minS tail (plus minS (rx1 r)) nxt hSep hTail , adj-from-drc minS tail nxt hTail)
