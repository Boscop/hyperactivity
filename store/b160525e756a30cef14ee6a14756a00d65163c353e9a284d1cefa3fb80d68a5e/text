hvec-eq-trans : (k : Nat) → (x y w : HVec k) → hvec-eq k x y → hvec-eq k y w → hvec-eq k x w
hvec-eq-trans zero x y w h1 h2 = z-trans x y w h1 h2
hvec-eq-trans (suc k) x y w h1 h2 =
  (hvec-eq-trans k (fst x) (fst y) (fst w) (fst h1) (fst h2) ,
   hvec-eq-trans k (snd x) (snd y) (snd w) (snd h1) (snd h2))
