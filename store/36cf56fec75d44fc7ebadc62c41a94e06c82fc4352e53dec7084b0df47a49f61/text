ic-graph : HExpr → List INetSlot
ic-graph (hx-lit v) =
  cons (islot #0 ik-num #3 #3 (%wmod v #256)) nil
ic-graph (hx-add x y) =
  cons (islot #0 ik-num #4 #3 x)
  (cons (islot #1 ik-add #0 #8 #0)
  (cons (islot #2 ik-num #5 #3 y) nil))
ic-graph (hx-dup-add v) =
  cons (islot #0 ik-num #4 #3 v)
  (cons (islot #1 ik-dup #0 #3 #0) nil)
ic-graph (hx-par-add a b c d) =
  cons (islot #0 ik-num #4 #3 a)
  (cons (islot #1 ik-add #0 #8 #0)
  (cons (islot #2 ik-num #5 #3 b)
  (cons (islot #3 ik-num #16 #3 c)
  (cons (islot #4 ik-add #12 #20 #0)
  (cons (islot #5 ik-num #17 #3 d) nil)))))
