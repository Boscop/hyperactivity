-- ---------------------------------------------------------------- compact balanced binary tree packing for NkTm
data NkPack =
    nkp-0
  | nkp-1 (a : Word)
  | nkp-3 (p : Word)
  | nkp-24 (w0 : Word) (w1 : Word) (w2 : Word) (w3 : Word) (w4 : Word) (w5 : Word) (w6 : Word) (w7 : Word)
  | nkp-2 (l : NkPack) (r : NkPack)
