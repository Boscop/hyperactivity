bn-lem-plan-go-safe : (cap : Nat) → (ps acc : List NodePool) →
  bn-le-nat (bn-pools-burn acc) cap ≡ true →
  bn-le-nat (bn-pools-burn (bn-plan-go cap ps acc)) cap ≡ true
bn-lem-plan-go-safe _   nil         _   h = h
bn-lem-plan-go-safe cap (cons p ps) acc h =
  bn-plan-step-lem2 cap p ps acc
    (bn-le-nat (bn-pools-burn (cons p acc)) cap)
    refl
    h
    (λ acc2 h2 → bn-lem-plan-go-safe cap ps acc2 h2)
