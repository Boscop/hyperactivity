chem-sasa-cap-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-sasa-cap-poly A ad mu q vs =
  (λ g sub →
    let rA = g 0; rB = g 1; d = g 2
        lhs = mu (sub (ad rA rB) d) (sub (ad d rB) rA)
        dA = sub d rA
        rhs = sub (mu rB rB) (mu dA dA)
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
