cs-clo-read-held : (hp0 : CsHeap) (fn ar n : Word) (fs : Lst CsVal) →
  let blk = lcons (csv-word fn) (lcons (csv-word ar) (lcons (csv-word n) fs))
  in cs-read-range (fst (cs-alloc hp0 blk)) (snd (cs-alloc hp0 blk)) (suc (suc (suc zero))) (cs-hlen CsVal fs)
     ≡ some fs
cs-clo-read-held hp0 fn ar n fs =
  let blk = lcons (csv-word fn) (lcons (csv-word ar) (lcons (csv-word n) fs))
  in cs-read-range-from-loads (fst (cs-alloc hp0 blk)) (snd (cs-alloc hp0 blk)) fs (suc (suc (suc zero)))
       (λ i → cs-alloc-load-self hp0 blk (suc (suc (suc i))))
