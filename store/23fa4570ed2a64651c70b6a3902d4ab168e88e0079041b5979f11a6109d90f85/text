-- a top-level step plan at wire u is either empty (waiting) or sets u first and then runs a well-formed sub-plan
nk-step-fx-wf : NkW → NkEnv → NkEnv → NkW → NkW → NkFx → Bool
nk-step-fx-wf u ins outs n0 n1 nkf-nil = true
nk-step-fx-wf u ins outs n0 n1 (nkf-at w (nkc-put s) r) = nk-and (nk-weq w u) (nk-fx-wf ins outs n0 n1 r)
nk-step-fx-wf u ins outs n0 n1 fx = false
