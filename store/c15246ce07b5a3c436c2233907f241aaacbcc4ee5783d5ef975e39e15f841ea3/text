-- Exhaustive 4,096-case verifier for BACKWARD AND propagation `hs-fiber-and-bwd` (ALL y, z in 0..15, p, q in 0..3):
hs-ok-bwd : Word → Word → Word → Word → Word
hs-ok-bwd y z p q =
  if hs-in-m q y then
    if hs-in-m (%wand p q) z then
      if hs-in-m p (hs-fiber-and-bwd y z) then #0 else #1
    else #0
  else #0
