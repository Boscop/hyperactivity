-- a binary arithmetic operation of C on operands of two types: both converted to the common
-- type, the operation at its kind; the result with its type
ct-arith : Target → BinOp → CTy → CTy → SV → SV → MRes (CTy × SV)
ct-arith t o ta tb a b =
  mr-bind (ct-uac t ta tb) (λ tc →
  mr-bind (ct-sk t ta) (λ ka →
  mr-bind (ct-sk t tb) (λ kb →
  mr-bind (ct-sk t tc) (λ kc →
  mr-bind (sv-conv ka kc a) (λ x →
  mr-bind (sv-conv kb kc b) (λ y →
  mr-map (λ r → (tc , r)) (sv-arith o kc x y)))))))
