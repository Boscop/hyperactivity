cs-for-t4-dl : (d : Word) (tl : List Word) → cs-for-t4 d tl ≡ list-append (cs-for-t4 d nil) tl
cs-for-t4-dl d tl =
  cs-dl-comp (list-append "; } v") (λ x → list-append (ce-dec (%wsucc d)) (list-append "; })" x))
    (cs-dl-lit "; } v")
    (cs-dl-comp (list-append (ce-dec (%wsucc d))) (list-append "; })")
      (cs-dl-lit (ce-dec (%wsucc d))) (cs-dl-lit "; })")) tl
