-- eliminator firing preservation (nk-fire vs nk-ev-fire and nk-ev-go): every computational NkAct
-- branch in the net machine builds the exact body and NkEv environment evaluated by nk-ev-go
nk-el-step-ev-agree : (k : Nat) (rho : NkW → NkEv) (h : Word) (cs : NkTm) (aux parts : NkEnv) (hd : NkHd) →
  nk-ev-go (suc k) (nkevj-el h cs (nk-env-ev rho aux) (nkev hd (nk-env-ev rho parts)))
  ≡ nk-ev-fire (nk-ev-go k) (nk-act h cs hd parts) h cs (nk-env-ev rho aux) (nkev hd (nk-env-ev rho parts))
nk-el-step-ev-agree k rho h cs aux parts hd =
  cong (λ a → nk-ev-fire (nk-ev-go k) a h cs (nk-env-ev rho aux) (nkev hd (nk-env-ev rho parts)))
    (nk-act-shape h cs hd rho parts)
