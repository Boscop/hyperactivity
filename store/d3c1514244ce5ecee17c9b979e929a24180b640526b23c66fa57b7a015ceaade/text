s-essay-lines-of : List Word → Sum Unit (List Word) → Proc W (List (List Word))
s-essay-lines-of base (inl u) = ret nil
s-essay-lines-of base (inr t) = if s-no-runs (s-run-names base (h-split #32 (s-nl-sp t))) then ret {lzero} {W} (s-piece-lines (inr t)) else s-runs-lines (s-run-names base (h-split #32 (s-nl-sp t)))
