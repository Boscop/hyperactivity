nk-build-wf (nk-susp b) ins outs n0 e out o p0 he hout ho =
  let o2 = nk-trim-susp b #0 e o
      ht = nk-trim-susp-wf b #0 ins outs n0 e o p0 he ho
      ple = nk-and-l (nk-wire-le (nk-n o) (nk-n o2)) (nk-fx-wf ins outs n0 (nk-n o2) (nk-fx o2)) ht
      pfx = nk-and-r (nk-wire-le (nk-n o) (nk-n o2)) (nk-fx-wf ins outs n0 (nk-n o2) (nk-fx o2)) ht
  in nk-out-ok-intro ins outs n0 (nk-n o) (nkf-val out (nkv (hd-susp b) (nk-ws o2)) (nk-fx o2)) (nk-n o2) (nk-ws o)
       ple
       (nk-and-intro (nk-in-set outs n0 (nk-n o2) out) (nk-fx-wf ins outs n0 (nk-n o2) (nk-fx o2))
         (nk-in-set-up outs n0 (nk-n o) (nk-n o2) out ple hout) pfx)
       (nk-env-in-range-up n0 (nk-n o) (nk-n o2) (nk-ws o) ple (nk-out-ok-ws ins outs n0 (nk-n o) o ho))
nk-build-wf (nk-con c as) ins outs n0 e out o p0 he hout ho =
