nk-build-wf (nk-op h p as) ins outs n0 e out o p0 he hout ho =
  let s = nk-split e o
      hs = nk-split-wf ins outs n0 e o p0 he ho
      hso = nk-split-ok-o ins outs n0 (nk-n o) s hs
      n = nk-n (nk-so s)
      sn = nk-s n
      ono = nk-out-ok-le ins outs n0 (nk-n o) (nk-so s) hso
      onn1 = nk-wire-le-trans (nk-n o) n sn ono (nk-wire-le-s n)
      n0n = nk-wire-le-trans n0 (nk-n o) n p0 ono
      n0sn = nk-wire-le-trans n0 n sn n0n (nk-wire-le-s n)
      sb_in = nk-env-range-to-set ins n0 sn (nk-sb s) (nk-env-in-range-up n0 n sn (nk-sb s) (nk-wire-le-s n) (nk-split-ok-b ins outs n0 (nk-n o) s hs))
      out_sn = nk-in-set-up outs n0 (nk-n o) sn out onn1 hout
      o_in1 = nk-plan-of (nk-fx (nk-so s)) sn
      ho_in1 = nk-out-ok-intro ins outs n0 sn (nk-fx (nk-so s)) sn nke-nil (nk-wire-le-refl sn) (nk-fx-wf-up ins outs n0 n sn (nk-fx (nk-so s)) (nk-wire-le-s n) (nk-out-ok-fx ins outs n0 (nk-n o) (nk-so s) hso)) refl
      oa = nk-build as (nk-sb s) out o_in1
      hoa = nk-build-wf as ins outs n0 (nk-sb s) out o_in1 n0sn sb_in out_sn ho_in1
      noa = nk-n oa
      sn_noa = nk-out-ok-le ins outs n0 sn oa hoa
      n_noa = nk-wire-le-trans n sn noa (nk-wire-le-s n) sn_noa
      n0noa = nk-wire-le-trans n0 sn noa n0sn sn_noa
      rn_noa = nk-in-range-up n0 sn noa n sn_noa (nk-in-range-self n0 n n0n)
      sa_in = nk-env-range-to-set ins n0 noa (nk-sa s) (nk-env-in-range-up n0 n noa (nk-sa s) n_noa (nk-split-ok-a ins outs n0 (nk-n o) s hs))
      fx_op = nkf-op n (nko-el h nk-nil (nk-ws oa) out) (nk-fx oa)
      hfx_op = nk-and-intro (nk-in-set ins n0 noa n) (nk-fx-wf ins outs n0 noa (nk-fx oa)) (nk-in-set-range ins n0 noa n rn_noa) (nk-out-ok-fx ins outs n0 sn oa hoa)
      o_in2 = nk-plan-of fx_op noa
      ho_in2 = nk-out-ok-intro ins outs n0 noa fx_op noa nke-nil (nk-wire-le-refl noa) hfx_op refl
      hp = nk-build-wf p ins outs n0 (nk-sa s) n o_in2 n0noa sa_in (nk-in-set-range outs n0 noa n rn_noa) ho_in2
  in nk-out-ok-step ins outs n0 (nk-n o) noa (nk-build p (nk-sa s) n o_in2) (nk-wire-le-trans (nk-n o) sn noa onn1 sn_noa) hp
