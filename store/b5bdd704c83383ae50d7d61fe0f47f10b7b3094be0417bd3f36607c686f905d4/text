-- Exact 64-byte BOUNDARY element for one Manhattan rectangle:
--   BOUNDARY (0x0800,  4 bytes)
--   LAYER    (0x0D02,  6 bytes)
--   DATATYPE (0x0E02,  6 bytes)
--   XY       (0x1003, 44 bytes: 5 closed vertices = 10 x int32be)
--   ENDEL    (0x1100,  4 bytes)
gds-v6-rect : Word → Word → Rect → List Word
gds-v6-rect layer dtype r =
  let wx0 = w-of-nat (rx0 r)
      wy0 = w-of-nat (ry0 r)
      wx1 = w-of-nat (rx1 r)
      wy1 = w-of-nat (ry1 r)
  in sv-concat
       (cons (gds-u16s (cons #4 (cons gds-rec-boundary nil)))
       (cons (gds-u16s (cons #6 (cons gds-rec-layer (cons layer nil))))
       (cons (gds-u16s (cons #6 (cons gds-rec-datatype (cons dtype nil))))
       (cons (gds-u16s (cons #44 (cons gds-rec-xy nil)))
       (cons (gds-u32s
                (cons wx0 (cons wy0
                (cons wx1 (cons wy0
                (cons wx1 (cons wy1
                (cons wx0 (cons wy1
                (cons wx0 (cons wy0 nil)))))))))))
       (cons (gds-u16s (cons #4 (cons gds-rec-endel nil))) nil))))))
