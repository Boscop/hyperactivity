hopf-render-arcs : List Word → List Word → SInt → SInt → SInt → SInt → SInt → List HArc → List Word
hopf-render-arcs bgCol fgCol cx cy maxSpan baseW ko2 nil = nil
hopf-render-arcs bgCol fgCol cx cy maxSpan baseW ko2 (cons (harc zAvg hpts) r) =
  let rpts = hopf-fit-pts cx cy maxSpan baseW hpts
      dFg = ribbon-poly-d rpts si-zero
      seg = if si-lt (sn #4000) zAvg
            then let dKo = ribbon-poly-d (hopf-trim1 rpts) ko2
                 in lg-concat (cons "<path d='" (cons dKo (cons "' fill='" (cons bgCol (cons "'/><path d='" (cons dFg (cons "' fill='" (cons fgCol (cons "'/>" nil)))))))))
            else lg-concat (cons "<path d='" (cons dFg (cons "' fill='" (cons fgCol (cons "'/>" nil)))))
  in list-append seg (hopf-render-arcs bgCol fgCol cx cy maxSpan baseW ko2 r)
