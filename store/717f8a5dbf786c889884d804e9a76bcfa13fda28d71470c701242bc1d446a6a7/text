-- a term with its first two offset coordinates exchanged when sw (the second electron)
he-o : Nat → Nat → Bool → BQ → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → BQ
he-o ap aq sw cf ei ej ek ua da ub db uc dc = if sw then he-t ap aq cf ei ej ek ub db ua da uc dc else he-t ap aq cf ei ej ek ua da ub db uc dc
