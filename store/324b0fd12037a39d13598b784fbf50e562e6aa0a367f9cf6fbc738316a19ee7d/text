nk-triples : Lst Word → Lst NkPack
nk-triples lnil = lnil
nk-triples (lcons a r) =
  if %wlt a #2097152
    then (case r return (λ _ → Lst NkPack) of
            lcons b r2 →
              if %wlt b #2097152
                then (case r2 return (λ _ → Lst NkPack) of
                        lcons c r3 →
                          if %wlt c #2097152
                            then lcons (nkp-3 (%wadd a (%wadd (%wmul b #2097152) (%wmul c #4398046511104)))) (nk-triples r3)
                            else lcons (nkp-1 a) (lcons (nkp-1 b) (lcons (nkp-1 c) (nk-triples r3)))
                        lnil → lcons (nkp-1 a) (lcons (nkp-1 b) lnil))
                else lcons (nkp-1 a) (lcons (nkp-1 b) (nk-triples r2))
            lnil → lcons (nkp-1 a) lnil)
    else lcons (nkp-1 a) (nk-triples r)
