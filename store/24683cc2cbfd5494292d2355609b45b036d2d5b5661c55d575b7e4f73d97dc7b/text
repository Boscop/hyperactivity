-- Interpolate zero-crossing offset along a 32-tenth edge, strictly in [1, 31] so every
-- crossing is interior to its edge and every contour vertex has exact degree 2!
lv-interp : SInt → SInt → SInt
lv-interp v0 v1 =
  let d = si-sub v1 v0
      t = if si-eq d si-zero then sp #16 else si-div (si-mul (si-neg v0) (sp #32)) d
  in si-clamp (sp #1) (sp #31) t
