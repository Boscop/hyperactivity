-- coupling merges previously separate product states into one collective basin path
basin-couple-merges : {S1 S2 : Type 0}
                    → (eq1 : S1 → S1 → Bool) → (eq2 : S2 → S2 → Bool)
                    → (s1 : S1 → S1 → Bool) → (s2 : S2 → S2 → Bool)
                    → (c : (S1 × S2) → (S1 × S2) → Bool)
                    → (p q : S1 × S2) → isTrue (c p q)
                    → basin-of (S1 × S2) (coupled-step eq1 eq2 s1 s2 c) p
                      ≡ basin-of (S1 × S2) (coupled-step eq1 eq2 s1 s2 c) q
basin-couple-merges {S1} {S2} eq1 eq2 s1 s2 c p q hc =
  basin-refine-new {S1 × S2} {prod-step eq1 eq2 s1 s2} {c} p q hc
