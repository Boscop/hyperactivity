-- a nonzero coefficient on us followed by ps is one on us or one on ps past them
sy-nzc-app-or : (A V : Type) → (z : A) → (isz : A → Bool) → (us ps : List V) → (cs : List A) →
  sy-nzc A V z isz cs (sy-app V us ps) ≡ (if sy-nzc A V z isz cs us then true else sy-nzc A V z isz (sy-skip A V us cs) ps)
sy-nzc-app-or A V z isz us ps cs = (case us return λ w → (cs2 : List A) → sy-nzc A V z isz cs2 (sy-app V w ps) ≡ (if sy-nzc A V z isz cs2 w then true else sy-nzc A V z isz (sy-skip A V w cs2) ps) of
  nil → λ cs2 → λ i → sy-nzc A V z isz cs2 ps
  cons u ur → λ cs2 → (case isz (cl-hd A z cs2) return λ bb → (if bb then sy-nzc A V z isz (cl-tl A cs2) (sy-app V ur ps) else true) ≡ (if (if bb then sy-nzc A V z isz (cl-tl A cs2) ur else true) then true else sy-nzc A V z isz (sy-skip A V ur (cl-tl A cs2)) ps) of
    true → sy-nzc-app-or A V z isz ur ps (cl-tl A cs2)
    false → λ i → true)) cs
