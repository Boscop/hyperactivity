concl : (r : DRule) → RData r → Jdg
concl r-var (x-var Γ v) = (j-tm , Γ , var-shape (fst Γ) v , cvar (var-word (fst Γ) v) , varCube Γ v)
concl r-app (x-app Γ a b R f c) = (j-tm , Γ , b , capp f c , fmapM Γ (AppV a b) (TV b) (app-r a b) R)
concl r-fst (x-proj Γ a b R p) = (j-tm , Γ , a , cfst p , fmapM Γ (TV (s-fam f-sig a b)) (TV a) (sig-1 a b) R)
concl r-snd (x-proj Γ a b R p) = (j-tm , Γ , b , csnd p , fmapM Γ (TV (s-fam f-sig a b)) (TV b) (sig-2 a b) R)
concl r-case (x-case Γ s R cP x t f) = (j-tm , Γ , s , c-case cP t f x , fmapM Γ (CaseV s) (TV s) (case-r s) R)
concl r-ne (x-ne Γ R c) = (j-tm , Γ , s-bool , c , R)
concl (r-con b) (x-unit Γ B) = (j-tm , Γ , s-bool , c-con b , fmapM Γ One1 (TV s-bool) (bool-v b) B)
concl r-lam (x-lam Γ a b X cA c) = (j-tm , Γ , s-fam f-pi a b , clam c , X)
concl r-pair (x-pair Γ a b R cB c1 c2) = (j-tm , Γ , s-fam f-sig a b , cpair c1 c2 , R)
concl r-plam (x-pc Γ a X c) = (j-tm , Γ , s-path a , cplam c , X)
concl r-papp (x-papp Γ a P p f cf nc Y y) = (j-tm , Γ , a , cpapp p (dnf-code f) , Y)
concl (r-pend b) (x-pc Γ a P c) = (j-tm , Γ , a , cpapp c (c-end b) , fmapM Γ (TV (s-path a)) (TV a) (pend b a) P)
concl r-ty-bool (x-unit Γ B) = (j-ty , Γ , s-bool , c-bool , B)
concl (r-ty-fam fm) (x-fam Γ a b T cA cB) = (j-ty , Γ , s-fam fm a b , fam-code fm cA cB , T)
concl r-ty-path (x-tp Γ a T cL c0 c1) = (j-ty , Γ , s-path a , cpathp (cplam cL) c0 c1 , T)
