-- Emit a single BLIF gate: `.names <in1> <in2> <out>\n<pat> 1\n`
epfl-gate2 : List Word → List Word → List Word → List Word → List Word
epfl-gate2 x y out pat =
  sv-concat
    (cons ".names " (cons x (cons " " (cons y (cons " " (cons out (cons sv-nl
    (cons pat (cons " 1" (cons sv-nl nil))))))))))
