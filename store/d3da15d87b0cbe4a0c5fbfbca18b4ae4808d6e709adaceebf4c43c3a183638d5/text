push-keeps : (es : Ends) → (i : Nat) → (s : SQ) → beyonds (push-at i s es) ≡ beyonds es
push-keeps nil zero s = λ k → nil
push-keeps nil (suc i2) s = λ k → nil
push-keeps (cons e rest) zero s = λ k → cons (beyond e) (beyonds rest)
push-keeps (cons e rest) (suc i2) s = λ k → cons (beyond e) (push-keeps rest i2 s k)
