cs-sim-div-at : (zb : Bool) (hp : CsHeap) (a b : Word) → (%weq b #0 ≡ zb) →
  cs-res-rel (cmv-word (if zb then #0 else %wdiv a b))
    (if zb then cso-ok hp (csv-word #0) else cs-prim-res hp (cs-c11-div a b)) ≡ true
cs-sim-div-at true hp a b hzb = refl
cs-sim-div-at false hp a b hzb =
  cong (λ z → cs-res-rel (cmv-word (%wdiv a b)) (cs-prim-res hp (if z then csp-ub else csp-ok (%wdiv a b)))) hzb
  ∙ cs-weq-self (%wdiv a b)
