-- nk-rule-wf: every rule of the machine obeys the two-ended wire discipline and advances n monotonically
nk-rule-wf : (o : NkOp) (v : NkVal) (n : NkW) →
  nk-out-ok (nk-op-ins o v) (nk-op-outs o) n n (nk-rule o v n) ≡ true
nk-rule-wf (nko-el h cs aux out) (nkv hd parts) n = nk-fire-wf (nk-act h cs hd parts) h cs aux out hd parts n
nk-rule-wf (nko-el h cs aux out) (nkv-ref w) n = nk-out-ok-intro nke-nil (nke-cons out nke-nil) n n nkf-nil n nke-nil (nk-wire-le-refl n) refl refl
nk-rule-wf (nko-dup a b) v n = nk-rule-dup-wf a b v (nk-parts v) n
nk-rule-wf nko-era v n =
  nk-out-ok-intro (nk-parts v) nke-nil n n (nk-era-env (nk-parts v) nkf-nil) n nke-nil
    (nk-wire-le-refl n) (nk-era-env-wf (nk-parts v) nke-nil n n (nk-parts v) nkf-nil (nk-emem-refl (nk-parts v) n n) refl) refl
nk-rule-wf (nko-fwd out) v n =
  nk-out-ok-intro nke-nil (nke-cons out nke-nil) n n (nkf-val out v nkf-nil) n nke-nil
    (nk-wire-le-refl n) (nk-and-intro (nk-in-set (nke-cons out nke-nil) n n out) true (nk-in-set-hd out nke-nil n n) refl) refl
nk-rule-wf (nko-quote d out) (nkv hd parts) n = nk-rule-quote-wf d out hd parts n
nk-rule-wf (nko-quote d out) (nkv-ref w) n = nk-out-ok-intro nke-nil (nke-cons out nke-nil) n n nkf-nil n nke-nil (nk-wire-le-refl n) refl refl
nk-rule-wf (nko-gather d k done todo out) (nkv hd e) n = nk-gather-rule-wf d k done todo out hd e n
nk-rule-wf (nko-gather d k done todo out) (nkv-ref w) n = nk-out-ok-intro nke-nil (nke-cons out nke-nil) n n nkf-nil n nke-nil (nk-wire-le-refl n) refl refl
