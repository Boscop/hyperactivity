wire-partition-transparent : {K V : Type} → (unpack : V → WireId → ICAgent K) → (chk : K → V → Bool) →
  (loc rem : CAStore K V) → ValidCAStore chk rem → (left right : ICAgent K) →
  eval-cut-wire unpack chk loc (wf-verify chk (wf-ship rem left)) right
  ≡ eval-cut-local unpack (ca-union loc rem) left right
wire-partition-transparent unpack chk loc rem vrem ic-era right = refl
wire-partition-transparent unpack chk loc rem vrem (ic-con t a1 a2) right = refl
wire-partition-transparent unpack chk loc rem vrem (ic-ref k arg) right =
  λ i → ic-interact (resolve-agent unpack (ca-or (loc k) (dn-ca-check-idem chk k (rem k) (vrem k) i)) k arg) right
