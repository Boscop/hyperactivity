-- Exact integer stabilization gain (in units of -0.5 kcal/mol, positive = more stable):
--   Aromatic–Aromatic (Y–W, F–Y, W–W): 6  (π-stacking / hydrophobic core anchor)
--   Hydrophobic–Hydrophobic / Aromatic–Hydrophobic: 4
--   Salt bridge (Acidic–Basic): 5
--   Polar / H-bond compatible: 1
aa-pair-gain : AA → AA → Nat
aa-pair-gain a b =
  let ca = aa-class a; cb = aa-class b
  in if eqb ca 2 then (if eqb cb 2 then 6 else (if eqb cb 1 then 4 else 1))
     else if eqb ca 1 then (if eqb cb 2 then 4 else (if eqb cb 1 then 4 else 0))
     else if eqb ca 3 then (if eqb cb 4 then 5 else 1)
     else if eqb ca 4 then (if eqb cb 3 then 5 else 1)
     else 1
