-- Exact branchless 4-bit AND forward propagator (Q edge z = x & y!)
hs-fiber-and : Word → Word → Word
hs-fiber-and x y =
  let x0 = hs-bit x #0
      x1 = hs-bit x #1
      x2 = hs-bit x #2
      x3 = hs-bit x #3
      y0 = hs-bit y #0
      y1 = hs-bit y #1
      y2 = hs-bit y #2
      y3 = hs-bit y #3
      xany = if %weq x #0 then #0 else #1
      yany = if %weq y #0 then #0 else #1
      z0 = %wor (%wor (%wand x0 yany) (%wand y0 xany)) (%wor (%wand x1 y2) (%wand x2 y1))
      z1 = %wor (%wand x1 (%wor y1 y3)) (%wand x3 y1)
      z2 = %wor (%wand x2 (%wor y2 y3)) (%wand x3 y2)
      z3 = %wand x3 y3
  in %wor z0 (%wor (%wshl z1 #1) (%wor (%wshl z2 #2) (%wshl z3 #3)))
