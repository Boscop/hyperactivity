-- bin-cons keeps the value: it only drops a false bit in front of nothing
bin-cons-sound : (b : Bool) → (n : List Bool) → bin-to-nat (bin-cons b n) ≡ bin-to-nat (cons b n)
bin-cons-sound b n =
  case b return λ y → bin-to-nat (bin-cons y n) ≡ bin-to-nat (cons y n) of
    true → λ i → suc (times 2 (bin-to-nat n))
    false → (case n return λ m → bin-to-nat (bin-cons false m) ≡ bin-to-nat (cons false m) of
      nil → λ i → zero
      cons x rest → λ i → times 2 (bin-to-nat (cons x rest)))
