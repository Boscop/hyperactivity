nk-eq-tm : NkTm → NkTm → Bool
nk-eq-tm (nk-var i) (nk-var j) = %weq i j
nk-eq-tm (nk-free x) (nk-free y) = %weq x y
nk-eq-tm (nk-num m) (nk-num k) = %weq m k
nk-eq-tm (nk-lam b) (nk-lam c) = nk-eq-tm b c
nk-eq-tm (nk-susp b) (nk-susp c) = nk-eq-tm b c
nk-eq-tm (nk-con c as) (nk-con d bs) =
  if (if %weq c #2 then %weq d #2 else false)
    then nk-lvl-eq (nk-lvl-of (toNat #64) (nk-u-lvl-tm (nk-con c as))) (nk-lvl-of (toNat #64) (nk-u-lvl-tm (nk-con d bs)))
    else nk-and (%weq c d) (nk-eq-tm as bs)
nk-eq-tm (nk-op h p as) (nk-op g q bs) = nk-and (%weq h g) (nk-and (nk-eq-tm p q) (nk-eq-tm as bs))
nk-eq-tm (nk-match h p as) (nk-match g q bs) = nk-and (%weq h g) (nk-and (nk-eq-tm p q) (nk-eq-tm as bs))
nk-eq-tm nk-nil nk-nil = true
nk-eq-tm (nk-cons t r) (nk-cons u s) = nk-and (nk-eq-tm t u) (nk-eq-tm r s)
nk-eq-tm a c = false
