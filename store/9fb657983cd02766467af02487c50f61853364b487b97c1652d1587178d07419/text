c-ready : Proc W Unit
c-ready = bind (c-exists c-record) (λ have → if have then ret {lzero} {W} unit else
  bind (h-mkdir "build") (λ u → bind (h-mkdir "build/chat") (λ v →
  bind (h-list (list-append h-index "/modules")) (λ ms → bind (c-docs (λ p → h-ends ".md" p) ms) (λ md →
  bind (c-docs (λ p → andB (h-ends ".cub" p) (orB (h-prefix "docs/" p) (h-prefix "workflow/" p))) ms) (λ cub →
  bind (h-write "build/chat/docs-md" (h-concat (list-map h-line md))) (λ w1 →
  bind (h-write "build/chat/docs-cub" (h-concat (list-map h-line cub))) (λ w2 →
  bind (c-sh c-record-cmd) (λ r → if weq r #0 then ret {lzero} {W} unit else h-fail "chat: the record could not be made")))))))))
