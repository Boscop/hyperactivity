-- the subsets of the candidates whose members are pairwise not close
sp-subs : Nat → List (Nat × Nat) → List (Nat × Nat) → List (List (Nat × Nat))
sp-subs r cs sel = case cs of
  nil → cons sel nil
  cons c rest → sp-appl (if sp-free r c sel then sp-subs r rest (cons c sel) else nil) (sp-subs r rest sel)
