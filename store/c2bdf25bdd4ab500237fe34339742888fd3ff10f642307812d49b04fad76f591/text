-- an operation: an eliminator with its arguments' wires, duplicate, erase, forward, quote at a
-- depth, and the gathering of quoted parts
data NkOp = nko-el (h : Word) (aux : NkEnv) (out : Word) | nko-dup (a : Word) (b : Word) | nko-era | nko-fwd (out : Word) | nko-quote (d : Word) (out : Word) | nko-gather (d : Word) (k : NkK) (done : NkTm) (todo : NkEnv) (out : Word)
