hcm-mix-upd : Word → Word → Word → Word → Word → Word → Word → Word → Word
hcm-mix-upd wp u1 u2 u4 u6 um bit p =
  let err = if %weq bit #1 then %wsub #4096 p else p
      n1 = hcm-upd-w (%wand wp #4095) u1 bit err
      n2 = hcm-upd-w (%wand (%wshr wp #12) #4095) u2 bit err
      n4 = hcm-upd-w (%wand (%wshr wp #24) #4095) u4 bit err
      n6 = hcm-upd-w (%wand (%wshr wp #36) #4095) u6 bit err
      nm = hcm-upd-w (%wand (%wshr wp #48) #4095) um bit err
  in %wor n1 (%wor (%wshl n2 #12) (%wor (%wshl n4 #24) (%wor (%wshl n6 #36) (%wshl nm #48))))
