-- fold-modules: every fold-safe module is removed from the view (remove; its text stays in the source
-- under its hash, and another module still holds every piece of it).
hy-fold-each : List (List Word) → List Word → List Word → Proc W Unit
hy-fold-each nil st m = ret unit
hy-fold-each (cons p r) st m = bind (hy-remove st m (cons p nil)) (λ u → hy-fold-each r st m)
