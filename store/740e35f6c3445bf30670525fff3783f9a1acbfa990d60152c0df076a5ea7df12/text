-- a chain of any depth past the computed one ends in the computed interval
deep-encl : (S S2 : List Bool) → (envt : Nat → IV → Nat → IV) → (Et : Nat → ZQ → Nat → ZQ) → (st : IE) → (N : Nat) →
  bcanon S ≡ true → le (suc zero) (bin-to-nat S) → bin-to-nat S2 ≡ times (bin-to-nat S) (bin-to-nat S) → env-ok S envt Et →
  ((k : Nat) → (tv w : ZQ) → uni S tv → le (suc zero) (snd tv) → isval (Et (suc (plus k N)) tv) st w → uni S w) →
  snd (irun S S2 envt st N (iv-unit S , true)) ≡ true →
  (k : Nat) → (tv rv : ZQ) → uni S tv → le (suc zero) (snd tv) → echain Et st (plus k N) tv rv →
  inp S (fst (irun S S2 envt st N (iv-unit S , true))) rv
deep-encl S S2 envt Et st N cS hS hS2 H inv hf k tv rv hu hl ch =
  deep-encl-at S S2 envt Et st N cS hS hS2 H hf rv (descend Et st (uni S) N inv k tv rv hu hl ch)
