-- (part of language-support)
gpr_adc_spec_4 : (dst' : Bits #32) → (src : Bits #32) → (input_rflags : rflagsbits) → MF ((Bits #32) × rflagsbits × rflagsbits)
gpr_adc_spec_4 dst' src input_rflags =
  let input_cf : Bits #1
      input_cf = (rflagsbits-cf input_rflags)
      raw_result : Bits #33
      raw_result = (bits_of_int (z-add (bv-unsigned #32 dst') (z-add (bv-unsigned #32 src) (bv-unsigned #1 input_cf))) (zpos #33))
      signed_raw_result : Bits #33
      signed_raw_result = (bits_of_int (z-add (bv-signed #32 dst') (z-add (bv-signed #32 src) (bv-unsigned #1 input_cf))) (zpos #33))
      result' : Bits #32
      result' = (bv-trunc #33 #32 raw_result)
  in bindF {Bits #1} {((Bits #32) × rflagsbits × rflagsbits)} (cf_spec32 raw_result) (λ cf' →
       bindF {Bits #1} {((Bits #32) × rflagsbits × rflagsbits)} (pf_spec32 result') (λ pf' →
         let af : Bits #1
             af = (adc_af_spec32 dst' src input_cf)
             zf : Bits #1
             zf = (zf_spec (bv-unsigned #32 result'))
             sf : Bits #1
             sf = (sf_spec32 result')
         in bindF {Bits #1} {((Bits #32) × rflagsbits × rflagsbits)} (of_spec32 signed_raw_result) (λ of' →
              let output_rflags : rflagsbits
                  output_rflags = (rflagsbits-set-of (rflagsbits-set-sf (rflagsbits-set-zf (rflagsbits-set-af (rflagsbits-set-pf (rflagsbits-set-cf input_rflags cf') pf') af) zf) sf) of')
                  undefined_flags : rflagsbits
                  undefined_flags = #0
              in retF {((Bits #32) × rflagsbits × rflagsbits)} (result' , output_rflags , undefined_flags))))
