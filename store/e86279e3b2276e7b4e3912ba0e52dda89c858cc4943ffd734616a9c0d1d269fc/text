-- the theorem: a certificate that checks proves the goal wherever the hypotheses hold
cert-sound : (e : Env) (hs : Hyps) (ms : Mults) (a b : LinCode) → Holds e hs →
             cert-check hs ms a b ≡ true → Lew (wev e a) (wev e b)
cert-sound e hs ms a b hh p =
  le-cancel (wev e a) (wev e b) (wev e (sum-l hs ms)) (wev e (sum-r hs ms)) (sum-le e hs ms hh) (code-le-sound e (lc-add a (sum-r hs ms)) (lc-add b (sum-l hs ms)) p)
