bound-m : (o n : Nat) → le (plus 16 o) n → le (plus o 8) n
bound-m o n h =
  lew-to-le (plus o 8) n
    (le-transport (fromNat (plus o 8)) (fromNat n) (plusw (fromNat o) #8) (fromNat n)
       (symw (fromNat-plus o 8)) (λ j → fromNat n)
       (cert-sound (env2 o n) hyp-m cert1 goal-m goal-r (holds-m o n h) (λ j → true)))
