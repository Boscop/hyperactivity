-- /feed.xml : RSS 2.0 feed of published works
s-feed-item : Work → Proc W (List Word)
s-feed-item (work n k p) = bind (s-work-text (work n k p)) (λ t → ret {lzero} {W} (h-concat (cons "<item><title>" (cons (s-esc (s-title-or n t)) (cons "</title><link>https://hyperactivity.ai/" (cons n (cons "</link><guid>https://hyperactivity.ai/" (cons n (cons "</guid><description>" (cons (s-esc (s-excerpt t)) (cons "</description></item>" (cons (cons #10 nil) nil))))))))))))
