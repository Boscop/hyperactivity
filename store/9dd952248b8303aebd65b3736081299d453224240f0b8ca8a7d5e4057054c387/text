-- Helper for Bool-split soundness on tag Word dispatch (exact #0/#1/#2/#3 match with in-opB!)
tw-lem-mk-con-go : (env : Word → Bool) → (t : Word) → (a b : INet) →
  (b0 b1 b2 b3 : Bool) → %weq t #0 ≡ b0 → %weq t #1 ≡ b1 → %weq t #2 ≡ b2 → %weq t #3 ≡ b3 →
  in-eval env (if b0 then in-mk-xor-c (in-eq a b) a b else if b1 then in-mk-and-c (in-eq a b) a b else if b2 then in-con #2 a b else if b3 then in-mk-not a else in-con t a b)
  ≡ (if b0 then web-xorB (in-eval env a) (in-eval env b) else if b1 then web-andB (in-eval env a) (in-eval env b) else if b2 then web-notB (web-andB (in-eval env a) (in-eval env b)) else if b3 then web-notB (in-eval env a) else in-opB t (in-eval env a) (in-eval env b))
tw-lem-mk-con-go env t a b true  _     _     _     _ _ _ _ = tw-lem-mk-xor env a b (in-eq a b) refl
tw-lem-mk-con-go env t a b false true  _     _     _ _ _ _ = tw-lem-mk-and env a b (in-eq a b) refl
tw-lem-mk-con-go env t a b false false true  _     _ _ _ _ = refl
tw-lem-mk-con-go env t a b false false false true  _ _ _ _ = tw-lem-mk-not env a
tw-lem-mk-con-go env t a b false false false false _ _ _ _ = refl
