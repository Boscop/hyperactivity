-- 3. FitzHugh–Nagumo excitable-membrane global trapping-region SOS identity:
--    dv/dt = v - (1/3) v³ - w,   dw/dt = ε (v - b w),   V = (1/2) v² + (1/(2ε)) w².
--    -dV/dt = (1/3) v⁴ - v² + b w².
--    Identity: 3 · (-dV/dt + 3/4) = (v² - 3/2)² + 3 b w²  (≥ 0 for all v, w whenever b ≥ 0).
--    Variables (0..2): v, w, b.
fhn-trapping-sos : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
fhn-trapping-sos A ad mu q vs =
  (λ g sub sq →
    let v  = g 0
        w  = g 1
        b  = g 2
        v2 = sq v
        v4 = sq v2
        lhs = ad (sub v4 (mu (q (fn-q 3 1)) v2)) (ad (mu (q (fn-q 3 1)) (mu b (sq w))) (q (fn-q 9 4)))
        rhs = ad (sq (sub v2 (q (fn-q 3 2)))) (mu (q (fn-q 3 1)) (mu b (sq w)))
    in (lhs , rhs))
  (λ i → al-nth A (q (fn-q 0 1)) i vs) (al-gsub A ad mu q) (al-gsq A mu)
