-- Behavioral RTL module emitted directly from `alu-sum-rtl` via `sv-alg`
sv-alu-sum-rtl : List Word
sv-alu-sum-rtl =
  sv-concat
    (cons "module alu_sum_rtl (input logic a, input logic b, output logic y);"
    (cons sv-nl
    (cons "  assign y = "
    (cons (fold sv-alg sv-bool-env alu-sum-rtl)
    (cons ";"
    (cons sv-nl
    (cons "endmodule" (cons sv-nl nil))))))))
