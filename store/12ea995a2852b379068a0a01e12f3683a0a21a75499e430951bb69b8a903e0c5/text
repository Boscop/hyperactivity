canon-csubst : (sk' sk : Lst Entry) (σ : CMap sk' sk) → CanonCM sk' sk σ → (cj : Conj) → isTrue (dnf-canon (conj-subst sk' sk σ cj))
canon-csubst sk' sk σ cc lnil = unit
canon-csubst sk' sk σ cc (lcons l ls) =
  canon-meet (lit-subst sk' sk σ l) (conj-subst sk' sk σ ls) (canon-lsubst sk' sk σ cc l) (canon-csubst sk' sk σ cc ls)
