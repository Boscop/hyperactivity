run-sound : (m : Model) (hs : Eqs) (tr : Trace) → EqHolds m hs → (t : ETm) → tev m t ≡ tev m (run hs tr t)
run-sound m hs tr hh t =
  case tr return (λ w → (t : ETm) → tev m t ≡ tev m (run hs w t)) of
    tnil → λ t i → tev m t
    tstep p i d σ rest → λ t → catw (step-sound m hs p i d σ hh t) (rec rest (step hs p i d σ t))
  t
