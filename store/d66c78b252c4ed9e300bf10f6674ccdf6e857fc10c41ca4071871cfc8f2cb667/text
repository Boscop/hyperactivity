-- a byte masked twice after the shift (the model's push of a memory operand): the digit
byte-dig2 : (V lo : Word) → wand (wand (wshr V lo) #255) #255 ≡ wrem (wquot V (wshl #1 lo)) #256
byte-dig2 V lo =
  catw (wand-mask (wand (wshr V lo) #255) #8)
    (catw (congw (λ z → wrem z #256) (wand-mask (wshr V lo) #8))
      (catw (wrem-small (wrem (wshr V lo) #256) #256 (wrem-lt (wshr V lo) #256 refl))
        (congw (λ z → wrem z #256) (wshr-div V lo))))
