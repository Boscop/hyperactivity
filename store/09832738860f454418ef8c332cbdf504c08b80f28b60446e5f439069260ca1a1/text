export-hyperos-baremetal :
  List Word → List Word → List Word → List Word → Step W (Word × (Word × (Word × Word)))
export-hyperos-baremetal bootPath ldPath kernPath benchPath =
  to-step {W} {Word × (Word × (Word × Word))}
    (bind (file-write-named bootPath  hyperos-boot-asm)    (λ nB →
     bind (file-write-named ldPath    hyperos-ld-script)   (λ nL →
     bind (file-write-named kernPath  hyperos-kernel-c)    (λ nK →
     bind (file-write-named benchPath hyperfactor-bench-c) (λ nC →
       ret {lzero} {W} (nB , (nL , (nK , nC))))))))
