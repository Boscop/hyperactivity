-- Postulate 2 (Erasure Theorem):
-- If B is complementary to A at outcome yA, then B CANNOT be stable for A:
-- knowing A = yA structurally erases B (no map f : Bool → Bool can predict B from A).
rqm-postulate2-erasure :
  (H : Type 0) → (oA oB : H → Bool) → (yA : Bool) →
  ComplementaryAt H oA oB yA →
  StableFor H (Bool , oB) (Bool , oA) →
  Empty
rqm-postulate2-erasure H oA oB yA comp stab =
  let f   = fst stab
      hT  = fst (fst comp)
      pAT = fst (snd (fst comp))
      pBT = snd (snd (fst comp))
      hF  = fst (snd comp)
      pAF = fst (snd (snd comp))
      pBF = snd (snd (snd comp))
      -- stable-fiber gives oB hT ≡ f yA and oB hF ≡ f yA
      eqT = stable-fiber H (Bool , oB) (Bool , oA) stab yA hT pAT
      eqF = stable-fiber H (Bool , oB) (Bool , oA) stab yA hF pAF
      t-eq-f = concat (sym pBT) (concat eqT (concat (sym eqF) pBF))
  in rqm-true-ne-false t-eq-f
