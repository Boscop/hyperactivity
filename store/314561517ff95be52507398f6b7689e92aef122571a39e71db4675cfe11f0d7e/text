nk-out-ok-step : (ins outs : NkEnv) (n0 n1 n2 : NkW) (o : NkOut) →
  (nk-wire-le n1 n2 ≡ true) → (nk-out-ok ins outs n0 n2 o ≡ true) → nk-out-ok ins outs n0 n1 o ≡ true
nk-out-ok-step ins outs n0 n1 n2 (nk-out fx n ws) p12 h =
  nk-out-ok-intro ins outs n0 n1 fx n ws
    (nk-wire-le-trans n1 n2 n p12 (nk-out-ok-le ins outs n0 n2 (nk-out fx n ws) h))
    (nk-out-ok-fx ins outs n0 n2 (nk-out fx n ws) h)
    (nk-out-ok-ws ins outs n0 n2 (nk-out fx n ws) h)
