nk-split-cons-wf-o : (ins outs : NkEnv) (n0 nst w : NkW) (a b : NkEnv) (o : NkOut) →
  (nk-wire-le n0 nst ≡ true) → (nk-in-set ins n0 nst w ≡ true) →
  (nk-out-ok ins outs n0 nst o ≡ true) →
  (nk-env-in-range n0 (nk-n o) a ≡ true) → (nk-env-in-range n0 (nk-n o) b ≡ true) →
  nk-split-ok ins outs n0 nst (nk-split-cons w (nk-split-r a b o)) ≡ true
nk-split-cons-wf-o ins outs n0 nst w a b (nk-out fx n ws) p0 hw ho ha hb =
  let n1 = nk-s n
      n2 = nk-s n1
      ple0 = nk-out-ok-le ins outs n0 nst (nk-out fx n ws) ho
      pfx0 = nk-out-ok-fx ins outs n0 nst (nk-out fx n ws) ho
      pws0 = nk-out-ok-ws ins outs n0 nst (nk-out fx n ws) ho
      nn2 = nk-wire-le-trans n n1 n2 (nk-wire-le-s n) (nk-wire-le-s n1)
      nst2 = nk-wire-le-trans nst n n2 ple0 nn2
      n0n = nk-wire-le-trans n0 nst n p0 ple0
      n0n1 = nk-wire-le-trans n0 n n1 n0n (nk-wire-le-s n)
      hw2 = nk-in-set-up ins n0 nst n2 w nst2 hw
      pfx2 = nk-and-intro (nk-in-set ins n0 n2 w) (nk-fx-wf ins outs n0 n2 fx) hw2 (nk-fx-wf-up ins outs n0 n n2 fx nn2 pfx0)
      pws2 = nk-env-in-range-up n0 n n2 ws nn2 pws0
      ho2 = nk-out-ok-intro ins outs n0 nst (nkf-op w (nko-dup n n1) fx) n2 ws nst2 pfx2 pws2
      rn = nk-in-range-up n0 n1 n2 n (nk-wire-le-s n1) (nk-in-range-self n0 n n0n)
      rn1 = nk-in-range-self n0 n1 n0n1
      pa2 = nk-and-intro (nk-in-range n0 n2 n) (nk-env-in-range n0 n2 a) rn (nk-env-in-range-up n0 n n2 a nn2 ha)
      pb2 = nk-and-intro (nk-in-range n0 n2 n1) (nk-env-in-range n0 n2 b) rn1 (nk-env-in-range-up n0 n n2 b nn2 hb)
  in nk-and-intro (nk-out-ok ins outs n0 nst (nk-out (nkf-op w (nko-dup n n1) fx) n2 ws))
       (nk-and (nk-env-in-range n0 n2 (nke-cons n a)) (nk-env-in-range n0 n2 (nke-cons n1 b)))
       ho2 (nk-and-intro (nk-env-in-range n0 n2 (nke-cons n a)) (nk-env-in-range n0 n2 (nke-cons n1 b)) pa2 pb2)
