-- the fibre of transport along L over b that extends the fibres (a , refl) given on the face of
-- pa (b is the transport of a there): the transport fillers along L and one composition back
-- along L, never an equivalence's contractibility
%tproof L pa b =
  let tf = sysmap (λ a (i : I) → fill L [] a i) pa
      gl = λ (k : I) → fill (λ (i : I) → L @ ~ i) (sysmap (λ t (i : I) → t @ ~ i) tf) b k
      x = gl @ 1
  in (x
     , λ (j : I) →
         comp L (sys+ (j = 0) (λ (i : I) → fill L [] x i) (sys+ (j = 1) (λ (i : I) → gl @ ~ i) tf)) x)
