-- ============================================================================
-- 2. Exact Disjoint Commutativity (Interaction-Net Confluence of H_E)
-- ============================================================================
-- Applying Thiemann's local rewrite f1 at vertex m and f2 at vertex n (m ≠ n)
-- commutes identically on EVERY multi-vertex spin network Γ : List V!
lqg-disjoint-rewrites-commute :
  {V : Type 0} → (m n : Nat) → lqg-nat-ne m n →
  (f1 f2 : V → V) → (g : List V) →
  lqg-act-at m f1 (lqg-act-at n f2 g) ≡ lqg-act-at n f2 (lqg-act-at m f1 g)
lqg-disjoint-rewrites-commute zero zero ne f1 f2 g = Empty-rec ne
lqg-disjoint-rewrites-commute zero (suc n) ne f1 f2 nil = λ i → nil
lqg-disjoint-rewrites-commute zero (suc n) ne f1 f2 (cons v rest) =
  λ i → cons (f1 v) (lqg-act-at n f2 rest)
lqg-disjoint-rewrites-commute (suc m) zero ne f1 f2 nil = λ i → nil
lqg-disjoint-rewrites-commute (suc m) zero ne f1 f2 (cons v rest) =
  λ i → cons (f2 v) (lqg-act-at m f1 rest)
lqg-disjoint-rewrites-commute (suc m) (suc n) ne f1 f2 nil = λ i → nil
lqg-disjoint-rewrites-commute (suc m) (suc n) ne f1 f2 (cons v rest) =
  λ i → cons v (lqg-disjoint-rewrites-commute m n ne f1 f2 rest i)
