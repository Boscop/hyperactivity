papp-r : (Γ : CCtx) (a : TyShape) (P : Mean Γ (TV (s-path a))) (p : Code) → Der (j-tm , Γ , s-path a , p , P) → (r : Code) →
  Opt (r ≡ ci0) → Opt (r ≡ ci1) → Dec1 (Out Γ (cpapp p r) m-inf)
papp-r Γ a P p dp r (some q) o1 =
  c-derived (a , fmapM Γ (TV (s-path a)) (TV a) (pend-0 a) P ,
    der-code j-tm Γ a (cpapp p ci0) (cpapp p r) (fmapM Γ (TV (s-path a)) (TV a) (pend-0 a) P) (λ i → cpapp p (q (~ i))) (dpapp0 Γ a P p dp))
papp-r Γ a P p dp r none (some q) =
  c-derived (a , fmapM Γ (TV (s-path a)) (TV a) (pend-1 a) P ,
    der-code j-tm Γ a (cpapp p ci1) (cpapp p r) (fmapM Γ (TV (s-path a)) (TV a) (pend-1 a) P) (λ i → cpapp p (q (~ i))) (dpapp1 Γ a P p dp))
papp-r Γ a P p dp r none none =
  o-bind DNF (Out Γ (cpapp p r) m-inf) (dnf-of r)
    (λ f0 → papp-f Γ a P p dp r (dnf-norm f0) (is-true (dnf-canon (dnf-norm f0))) (is-true (dnf-nonconst (dnf-norm f0))) (code-dec elab-fuel (dnf-code (dnf-norm f0)) r))
