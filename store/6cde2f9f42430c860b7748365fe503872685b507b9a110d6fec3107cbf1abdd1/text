-- 2. Forgery & Hallucination Zero-Gain: failing verification pays strictly 0 and leaves state untouched.
pouw-reject-unchanged : {E : Type} → (chk : E → Bool) → (art : E) → (ext : Pool E) → (st : PouwState E) →
  chk art ≡ false → pouw-settle chk art ext st ≡ st
pouw-reject-unchanged chk art ext st h = λ i → pouw-step (h i) ext st
