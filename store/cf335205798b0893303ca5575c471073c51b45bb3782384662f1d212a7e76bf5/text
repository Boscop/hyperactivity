-- an instance: M = [[1, 2], [2, 1]] (levels 3 and −1) is diagonalized by (1, 0) and (−2, 1), with Gram diag(1, −3):
-- one negative level
ln-ex : (if eqb (fst (ln-count (ln-gram (ln-mform (cons (cons (fn-q 1 1) (cons (fn-q 2 1) nil)) (cons (cons (fn-q 2 1) (cons (fn-q 1 1) nil)) nil)))
    (cons (cons (fn-q 1 1) (cons (fn-q 0 1) nil)) (cons (cons (fn-nq 2 1) (cons (fn-q 1 1) nil)) nil))))) 1
  then snd (ln-count (ln-gram (ln-mform (cons (cons (fn-q 1 1) (cons (fn-q 2 1) nil)) (cons (cons (fn-q 2 1) (cons (fn-q 1 1) nil)) nil)))
    (cons (cons (fn-q 1 1) (cons (fn-q 0 1) nil)) (cons (cons (fn-nq 2 1) (cons (fn-q 1 1) nil)) nil)))) else false) ≡ true
ln-ex = λ i → true
