rlp-list : List (List Word) → List Word
rlp-list items =
  let pay = h-concat items
      len = fromNat (list-length pay)
  in if eth-le len #55
     then cons (%wadd #192 len) pay
     else let lb = eth-word-be-min len
              ll = fromNat (list-length lb)
          in cons (%wadd #247 ll) (list-append lb pay)
