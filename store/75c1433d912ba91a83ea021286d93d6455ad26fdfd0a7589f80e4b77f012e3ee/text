-- the laws of a form on a module: F(0, x) = 0, additive and homogeneous in the first argument, symmetric
sy-BL : (A V : Type) → (z : A) → (ad mu : A → A → A) → (vz : V) → (va : V → V → V) → (vs : A → V → V) → (f : V → V → A) → Type
sy-BL A V z ad mu vz va vs f = ((x : V) → f vz x ≡ z) × (((a b x : V) → f (va a b) x ≡ ad (f a x) (f b x)) × (((c : A) → (a x : V) → f (vs c a) x ≡ mu c (f a x)) × ((x y : V) → f x y ≡ f y x)))
