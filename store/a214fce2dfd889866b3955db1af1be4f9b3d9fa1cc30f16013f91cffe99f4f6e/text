-- a step of the name's round trip, the byte's test (weq b #10) taken as c: false is the only case the
-- condition allows, and there the byte is kept
first-line-step : (c : Bool) → (b : Word) → (x r : List Word) → (isTrue (no-newline r) → Path (List Word) x r) → isTrue (if c then false else no-newline r) → Path (List Word) (if c then nil else cons b x) (cons b r)
first-line-step c b x r rec = case c return (λ d → isTrue (if d then false else no-newline r) → Path (List Word) (if d then nil else cons b x) (cons b r)) of true → λ h → Empty-rec h; false → λ h → λ i → cons b (rec h i)
