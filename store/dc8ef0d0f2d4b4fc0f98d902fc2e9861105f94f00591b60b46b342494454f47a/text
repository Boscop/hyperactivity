-- ½ tr (O_ee − O_ee′): the cost a − b per unit of flux per end of an edge
line-half-trace : Nat → Nat → List Nat → List Triple → VW → List (List Side) → List STerm
line-half-trace e e1 ds ts w ss = terms-half-trace (terms-append (o-terms-vw e e ds ts w (sides-nth e ss) (sides-nth e ss)) (terms-scale (sq-neg sq-one) (o-terms-vw e e1 ds ts w (sides-nth e ss) (sides-nth e1 ss))))
