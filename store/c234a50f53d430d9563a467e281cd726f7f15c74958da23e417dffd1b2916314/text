s-para-ok : List Word → Bool
s-para-ok l =
  andB (h-not (h-null l)) (
  andB (h-not (h-prefix "#" l)) (
  andB (h-not (h-prefix "```" l)) (
  andB (h-not (h-prefix "---" l)) (
  andB (h-not (h-prefix "|" l)) (
  andB (h-not (h-prefix "<" l)) (
  andB (h-not (h-prefix "![" l)) (
  andB (h-not (h-prefix ">" l)) (
       (h-not (h-prefix "--" l))))))))))
