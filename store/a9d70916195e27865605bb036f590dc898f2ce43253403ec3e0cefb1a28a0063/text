-- Theorem: Partner-Induced Folding (IDP fiber collapse).
-- Even when a protein is disordered in solvent alone, coupling to a binding partner P
-- whose joint observation (obs_solv, obs_partner) determines the bound state yields a
-- well-folded (contractible) complex fiber.
fold-idp-partner-collapses :
  (C P Os Op : Type 0) →
  (obsS : C → Os) → (obsP : C → P → Op) →
  (ys : Os) → (yp : Op) →
  (bound : (C × P)) →
  (pS : obsS (fst bound) ≡ ys) →
  (pP : obsP (fst bound) (snd bound) ≡ yp) →
  ((x : (C × P)) → obsS (fst x) ≡ ys → obsP (fst x) (snd x) ≡ yp → bound ≡ x) →
  (x : (C × P)) → obsS (fst x) ≡ ys → obsP (fst x) (snd x) ≡ yp → fst bound ≡ fst x
fold-idp-partner-collapses C P Os Op obsS obsP ys yp bound pS pP uniq x qS qP =
  λ i → fst (uniq x qS qP i)
