s-answer : List Word → List Word → List Word → Proc W (List Word)
s-answer st m path =
  let p = h-before "?" path in
  s-answer-site st m path p (
  s-answer-treatises st p (
  s-answer-assets p (
  s-answer-logos p (
  s-answer-p2p st m path p (
  s-answer-views st m path p (
  s-answer-hi st m path p (
  s-public st (s-at-name p s-published))))))))
