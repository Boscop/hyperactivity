hyperinet-v2-seq : List Word
hyperinet-v2-seq =
  sv-concat
    (cons "  always @(posedge clk or negedge rst_n) begin" (cons sv-nl
    (cons "    if (!rst_n) begin" (cons sv-nl
    (cons "      rcnt <= 3'd0;" (cons sv-nl
    (cons "      for (i = 0; i < 8; i = i + 1) begin" (cons sv-nl
    (cons "        kind[i] <= K_FREE; p0[i] <= 5'd3; p1[i] <= 5'd3; p2[i] <= 5'd3; val[i] <= 8'd0;" (cons sv-nl
    (cons "      end" (cons sv-nl
    (cons "      // Built-in dual-lane parallel showcase: (17 + 25 = 42) || DUP(10)" (cons sv-nl
    (cons "      kind[0] <= K_NUM; val[0] <= 8'd17; p0[0] <= {3'd1, 2'd0};" (cons sv-nl
    (cons "      kind[1] <= K_ADD; p0[1] <= {3'd0, 2'd0}; p1[1] <= {3'd2, 2'd0}; p2[1] <= {3'd0, 2'd3};" (cons sv-nl
    (cons "      kind[2] <= K_NUM; val[2] <= 8'd25; p0[2] <= {3'd1, 2'd1};" (cons sv-nl
    (cons "      kind[3] <= K_NUM; val[3] <= 8'd10; p0[3] <= {3'd4, 2'd0};" (cons sv-nl
    (cons "      kind[4] <= K_DUP; p0[4] <= {3'd3, 2'd0}; p1[4] <= {3'd1, 2'd3}; p2[4] <= {3'd2, 2'd3};" (cons sv-nl
    (cons "    end else if (load_en) begin" (cons sv-nl
    (cons "      // Runtime external graph loader (field_sel: 0=kind/clear, 1=p0, 2=p1, 3=val; p2=EXT)" (cons sv-nl
    (cons "      if (field_sel == 2'd0) begin" (cons sv-nl
    (cons "        kind[slot_sel] <= load_data[2:0]; p2[slot_sel] <= 5'd3;" (cons sv-nl
    (cons "        if (load_data[7]) rcnt <= 3'd0;" (cons sv-nl
    (cons "      end else if (field_sel == 2'd1) p0[slot_sel]  <= load_data[4:0];" (cons sv-nl
    (cons "      else if (field_sel == 2'd2)     p1[slot_sel]  <= load_data[4:0];" (cons sv-nl
    (cons "      else                            val[slot_sel] <= load_data;" (cons sv-nl
    (cons "    end else if (ena && fnd0) begin" (cons sv-nl
    (cons "      fire_pair(u0, v0, 1'b1);" (cons sv-nl
    (cons "      if (dual_fire) begin" (cons sv-nl
    (cons "        fire_pair(u1, v1, 1'b0);" (cons sv-nl
    (cons "        rcnt <= rcnt + 3'd2;" (cons sv-nl
    (cons "      end else begin" (cons sv-nl
    (cons "        rcnt <= rcnt + 3'd1;" (cons sv-nl
    (cons "      end" (cons sv-nl
    (cons "    end" (cons sv-nl
    (cons "  end" (cons sv-nl
    (cons "endmodule" (cons sv-nl nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
