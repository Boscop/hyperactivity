-- Closure partial-application & saturation template soundness (`hy_clo` + `hy_app`)
ce-app-step : (Word → List CVal → CVal) → CVal → CVal → CVal
ce-app-step call (cv-clo fn ar held) x =
  let next = list-append held (cons x nil)
  in if %weq (fromNat (list-length next)) ar
     then call fn next
     else cv-clo fn ar next
ce-app-step _ _ _ = cv-word #0
