-- Exact 1-to-1 Gate-to-Cell Conservation: physical cell count equals logical NAND2 gate count!
nand-cell-count-eq : {V : Type} → (cellW : Nat) → (g : NandCirc V) →
  list-length (nand-cell-widths {V} cellW g) ≡ circ-gates {B0} {Empty} {Unit} {V} g
nand-cell-count-eq {V} cellW g =
  case g return (λ w →
    Path Nat (list-length (nand-cell-widths {V} cellW w)) (circ-gates {B0} {Empty} {Unit} {V} w)) of
    cwire v → λ _ → zero
    cop0 c → λ _ → zero
    cop1 u a →
      Empty-rec {lzero}
        {Path Nat (list-length (nand-cell-widths {V} cellW (cop1 u a)))
                  (circ-gates {B0} {Empty} {Unit} {V} (cop1 u a))}
        u
    cop2 b x y →
      transN
        (congN suc (list-append-len (nand-cell-widths {V} cellW x) (nand-cell-widths {V} cellW y)))
        (congN suc (cong2N plus (rec x) (rec y)))
