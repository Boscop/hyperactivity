-- Standard 44-byte RIFF/WAVE header (48000 Hz, 16-bit signed PCM, mono)
wav-header : Word → List Word → List Word
wav-header nSamples body =
  let dataBytes = %wmul nSamples #2
      riffSize  = %wadd #36 dataBytes
  in list-append "RIFF" (le32 riffSize
     (list-append "WAVEfmt " (le32 #16
     (le16 #1 (le16 #1 (le32 #48000 (le32 #96000 (le16 #2 (le16 #16
     (list-append "data" (le32 dataBytes body)))))))))))
