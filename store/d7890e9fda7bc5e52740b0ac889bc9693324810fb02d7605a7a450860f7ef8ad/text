-- the pairs of x with each of ys, as (attracting, repelling) sums of tree counts
pair-terms : Nat → List FaradayLine → Placed → List Placed → Nat × Nat
pair-terms n ls x ys = case ys of
  nil → (zero , zero)
  cons y rest → (if sp-charged (fst x)
    then (if sp-charged (fst y)
      then (if sp-like (fst x) (fst y)
        then (fst (pair-terms n ls x rest) , plus (pair-trees n ls (snd x) (snd y)) (snd (pair-terms n ls x rest)))
        else (plus (pair-trees n ls (snd x) (snd y)) (fst (pair-terms n ls x rest)) , snd (pair-terms n ls x rest)))
      else pair-terms n ls x rest)
    else pair-terms n ls x rest)
