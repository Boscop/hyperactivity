cl-mid-top : (A : Type) → (z a : A) → (c : List A → List A → A) → (ws : List (List A)) → cl-mid A z a c ws ≡ cl-top A (List A) z a ws (cl-gram A c ws)
cl-mid-top A z a c ws = λ i → cons (cons a (ln-map (List A) A (λ w → z) ws))
  (cl-map-fuse (List A) (List A) (List A) (λ x → ln-map (List A) A (λ y → c x y) ws) (λ r → cons z r) ws (~ i))
