-- write_rgfi_size: from register_readers_and_writers.sail (it calls what is defined after it there)
-- (part of language-support)
write_rgfi_size : (nbytes : Bits #4) → (index' : Bits #4) → (sailval : Bits #64) → (rex : Bits #8) → MS Unit
write_rgfi_size nbytes index' sailval rex =
  λ σ →
    if (weq nbytes #1) then
      the (MS Unit)
        (wr08 index' rex (bv-trunc #64 #8 sailval)) σ
    else if (weq nbytes #2) then
      the (MS Unit)
        (wr16 index' (bv-trunc #64 #16 sailval)) σ
    else if (weq nbytes #4) then
      the (MS Unit)
        (wr32 index' (bv-trunc #64 #32 sailval)) σ
    else if (weq nbytes #8) then
      the (MS Unit)
        (wr64 index' sailval) σ
    else
      the (MS Unit)
        (retS {Unit} unit) σ
