TyE : TyShape → TyU
TyE s-bool = (One1 , λ D̂ → Bool)
TyE (s-pi a b) =
  ((Â : fst (TyE a)) × (snd (TyE a) Â → fst (TyE b)) ,
   λ D̂ → (x̂ : snd (TyE a) (fst D̂)) → snd (TyE b) (snd D̂ x̂))
TyE (s-sig a b) =
  ((Â : fst (TyE a)) × (snd (TyE a) Â → fst (TyE b)) ,
   λ D̂ → (x̂ : snd (TyE a) (fst D̂)) × snd (TyE b) (snd D̂ x̂))
TyE (s-path a) =
  ((pL̂ : (Â0 : fst (TyE a)) × (Â1 : fst (TyE a)) × PathP (λ i → fst (TyE a)) Â0 Â1) × snd (TyE a) (fst pL̂) × snd (TyE a) (fst (snd pL̂)) ,
   λ D̂ → PathP (λ i → snd (TyE a) (snd (snd (fst D̂)) i)) (fst (snd D̂)) (snd (snd D̂)))
