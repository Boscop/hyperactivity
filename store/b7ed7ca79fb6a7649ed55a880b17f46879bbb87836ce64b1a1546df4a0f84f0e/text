-- Exact constant-product swap with configurable `feeKeep / 10000` (`#9970` = 30 bps, `#9999` = 1 bps):
-- Works on arbitrary-precision `Word` (`WN` bignum in kernel -> ZERO 64-bit overflow on >18.44 ETH pools!)
tr-amm-out-bps : Word → Word → Word → Word → Word
tr-amm-out-bps rx ry dx feeKeep =
  let dxf = %wmul dx feeKeep
      num = %wmul ry dxf
      den = %wadd (%wmul rx #10000) dxf
  in if %weq den #0 then #0 else %wdiv num den

tr-not : Bool → Bool
tr-not true  = false
tr-not false = true

tr-amm-k-ok : Word → Word → Word → Word → Bool
tr-amm-k-ok rx ry dx feeKeep =
  let dy = tr-amm-out-bps rx ry dx feeKeep
  in if %wlt ry dy then false
     else tr-not (%wlt (%wmul (%wadd rx dx) (%wsub ry dy)) (%wmul rx ry))

-- Zero-capital atomic flash-swap profit (`#0` principal required; atomic revert yields `#0` loss!):
tr-flash-net-profit : Word → Word → Word → Word → Word → Word → Word → Word → Word
