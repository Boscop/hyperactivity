tr-half : Nat → Nat
tr-half zero          = zero
tr-half (suc zero)    = zero
tr-half (suc (suc n)) = suc (tr-half n)

tr-rem-half : Nat → Nat
tr-rem-half zero          = zero
tr-rem-half (suc zero)    = suc zero
tr-rem-half (suc (suc n)) = suc (tr-rem-half n)

tr-plus-suc-r : (a b : Nat) → plus a (suc b) ≡ suc (plus a b)
tr-plus-suc-r zero    b = refl
tr-plus-suc-r (suc a) b = fio-cong suc (tr-plus-suc-r a b)

tr-plus-zero-r : (a : Nat) → plus a zero ≡ a
tr-plus-zero-r zero    = refl
tr-plus-zero-r (suc a) = fio-cong suc (tr-plus-zero-r a)

tr-thm-half-exact : (p : Nat) → plus (tr-half p) (tr-rem-half p) ≡ p
tr-thm-half-exact zero          = refl
tr-thm-half-exact (suc zero)    = refl
tr-thm-half-exact (suc (suc n)) =
  fio-trans (fio-cong suc (tr-plus-suc-r (tr-half n) (tr-rem-half n)))
            (fio-cong (λ x → suc (suc x)) (tr-thm-half-exact n))

tr-waterfall : Nat → List Word → List Nat
tr-waterfall p nil                  = nil
tr-waterfall p (cons u nil)         = cons p nil
tr-waterfall p (cons u (cons v rs)) = cons (tr-half p) (tr-waterfall (tr-rem-half p) (cons v rs))

tr-nat-sum : List Nat → Nat
tr-nat-sum nil         = zero
tr-nat-sum (cons x xs) = plus x (tr-nat-sum xs)

-- THEOREM 5: ZERO-WEI-DUST WATERFALL CONSERVATION FOR ALL SURPLUSES `p : Nat` & CHAINS!
tr-thm-waterfall-zero-dust : (p : Nat) → (founder : Word) → (chain : List Word) →
  tr-nat-sum (tr-waterfall p (cons founder chain)) ≡ p
tr-thm-waterfall-zero-dust p founder nil = tr-plus-zero-r p
tr-thm-waterfall-zero-dust p founder (cons v rs) =
  fio-trans (fio-cong (plus (tr-half p)) (tr-thm-waterfall-zero-dust (tr-rem-half p) v rs))
            (tr-thm-half-exact p)

-- THEOREM 6: PoUW CLEARINGHOUSE + SOVEREIGN WATERFALL EXACT GLOBAL CONSERVATION!
tr-thm-pouw-treasury-conserved : {E : Type} → (chk : E → Bool) → (art : E) → (ext : Pool E) →
  (st : PouwState E) → (founder : Word) → (chain : List Word) →
  plus (tr-nat-sum (tr-waterfall (fst st) (cons founder chain))) (fst (snd st))
    ≡ pouw-total (pouw-settle chk art ext st)
tr-thm-pouw-treasury-conserved chk art ext st founder chain =
  fio-trans (fio-cong (λ x → plus x (fst (snd st))) (tr-thm-waterfall-zero-dust (fst st) founder chain))
            (fio-sym (pouw-conserved chk art ext st))

