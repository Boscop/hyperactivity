step-not-r : {a b r : Bool} → isTrue a → isTrue b → isTrue (not (lex-step a b r)) → isTrue (not r)
step-not-r ha hb n =
  (case a return λ y → isTrue y → isTrue (not (lex-step y b r)) → isTrue (not r) of
     true → λ ha → (case b return λ z → isTrue z → isTrue (not (if z then r else true)) → isTrue (not r) of true → λ hb n → n; false → λ hb n → Empty-rec hb) hb
     false → λ ha n → Empty-rec ha) ha n
