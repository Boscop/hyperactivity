hn-min-w : Word → Word → Word
hn-min-w a b = if %wlt a b then a else b

hn-mem-w : Word → List Word → Bool
hn-mem-w x nil         = false
hn-mem-w x (cons y ys) = if %weq x y then true else hn-mem-w x ys

hn-disjoint : List Word → List Word → Bool
hn-disjoint nil         ys = true
hn-disjoint (cons x xs) ys = if hn-mem-w x ys then false else hn-disjoint xs ys

-- Semiring Sequential Multiplication (⊗): composes `(u -> m)` with `(m -> v)` on disjoint liquidity/proof
-- lineages (`hn-disjoint l1 l2`: zero liquidity double-counting, zero Sybil loop inflation, exact fixed point!),
-- compounding verified rate, bottlenecking capacity, and concatenating viral P2P lineage!
hn-compose : HyperEdge → HyperEdge → HyperEdge
hn-compose (mk-hedge s1 d1 r1 c1 v1 l1) (mk-hedge s2 d2 r2 c2 v2 l2) =
  let ok = andB v1 (andB v2 (andB (%weq d1 s2) (hn-disjoint l1 l2)))
      r  = if ok then %wdiv (%wmul r1 r2) #10000 else #0
      c  = if ok then hn-min-w c1 c2 else #0
      ln = if ok then list-append l1 l2 else nil
  in mk-hedge s1 d2 r c ok ln

-- Semiring Parallel Dominance (⊕): selects strictly higher verified rate (tie-breaking on capacity)
hn-better-edge : HyperEdge → HyperEdge → Bool
hn-better-edge cand cur =
  let rc = hn-eff-rate cand
      rr = hn-eff-rate cur
  in if %wlt rr rc then true
     else if %weq rc rr then %wlt (hn-eff-cap cur) (hn-eff-cap cand)
     else false

hn-upsert-edge : HyperEdge → HyperNet → HyperNet
hn-upsert-edge cand nil = cons cand nil
hn-upsert-edge cand (cons cur rest) =
  if andB (%weq (hn-src cand) (hn-src cur)) (%weq (hn-dst cand) (hn-dst cur))
  then cons (if hn-better-edge cand cur then cand else cur) rest
  else cons cur (hn-upsert-edge cand rest)

hn-insert-edge : HyperEdge → HyperNet → HyperNet
hn-insert-edge cand net =
  if %weq (hn-eff-rate cand) #0 then net else hn-upsert-edge cand net

hn-merge-net : HyperNet → HyperNet → HyperNet
hn-merge-net base nil         = base
hn-merge-net base (cons e es) = hn-merge-net (hn-insert-edge e base) es

hn-compose-row : HyperEdge → HyperNet → HyperNet → HyperNet
hn-compose-row e1 nil         acc = acc
hn-compose-row e1 (cons e2 r) acc =
  hn-compose-row e1 r (hn-insert-edge (hn-compose e1 e2) acc)

hn-compose-all : HyperNet → HyperNet → HyperNet → HyperNet
hn-compose-all nil         all2 acc = acc
hn-compose-all (cons e1 r) all2 acc =
  hn-compose-all r all2 (hn-compose-row e1 all2 acc)

-- One tropical/max-product semiring squaring step: H' = H ⊕ (H ⊗ H)
hn-step : HyperNet → HyperNet
hn-step net =
  let base = hn-merge-net nil net
  in hn-compose-all base base base

-- Logarithmic Whole-Hypernet Contraction (`rounds = ceil(log2 |V|)` contracts all paths up to `2^rounds` hops!)
hn-contract : Nat → HyperNet → HyperNet
hn-contract zero    net = hn-merge-net nil net
hn-contract (suc k) net = hn-contract k (hn-step net)

-- Extract the optimal self-financing cycle `anchor -> ... -> anchor` from a contracted HyperNet:
hn-self-loop : Word → HyperNet → HyperEdge
hn-self-loop anchor nil = mk-hedge anchor anchor #10000 #0 true nil
hn-self-loop anchor (cons e es) =
  let tailBest = hn-self-loop anchor es
  in if andB (%weq (hn-src e) anchor) (%weq (hn-dst e) anchor)
     then if hn-better-edge e tailBest then e else tailBest
     else tailBest

hn-gross-out : HyperEdge → Word
hn-gross-out e = %wdiv (%wmul (hn-eff-cap e) (hn-eff-rate e)) #10000

hn-net-surplus : HyperEdge → Word
hn-net-surplus e =
  let cap = hn-eff-cap e
      out = hn-gross-out e
  in if %wlt cap out then %wsub out cap else #0

