  let rhs = the Nat (hn-mul-nat (suc k) (suc (suc (suc s))))
      ih  = hn-lem-hyper-tail s k
  in hn-le-plus-l s (suc k) rhs
       (hn-le-down (suc k) rhs
         (hn-le-down (suc (suc k)) rhs ih))

