hn-plus-suc-r : (a b : Nat) → plus a (suc b) ≡ suc (plus a b)
hn-plus-suc-r zero    b = refl
hn-plus-suc-r (suc a) b = cong suc (hn-plus-suc-r a b)

hn-plus-zero-r : (a : Nat) → plus a zero ≡ a
hn-plus-zero-r zero    = refl
hn-plus-zero-r (suc a) = cong suc (hn-plus-zero-r a)

hn-thm-half-sum : (p : Nat) → plus (hn-half p) (hn-rem-half p) ≡ p
hn-thm-half-sum zero          = refl
hn-thm-half-sum (suc zero)    = refl
hn-thm-half-sum (suc (suc n)) =
  hn-trans (cong suc (hn-plus-suc-r (hn-half n) (hn-rem-half n)))
           (cong (λ x → suc (suc x)) (hn-thm-half-sum n))

hn-waterfall : Nat → List Word → List Nat
