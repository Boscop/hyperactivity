hn-half : Nat → Nat
hn-half zero          = zero
hn-half (suc zero)    = zero
hn-half (suc (suc n)) = suc (hn-half n)

hn-rem-half : Nat → Nat
hn-rem-half zero          = zero
hn-rem-half (suc zero)    = suc zero
