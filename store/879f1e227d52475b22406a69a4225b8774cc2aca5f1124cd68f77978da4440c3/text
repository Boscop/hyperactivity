hn-trans : {A : Type} → {x y z : A} → x ≡ y → y ≡ z → x ≡ z
hn-trans {A} {x} p q = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

hn-sym : {A : Type} → {x y : A} → x ≡ y → y ≡ x
hn-sym {A} {x} p = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ p j , i = 1 ↦ x ]) x

hn-cong2 : {A B C : Type} → (f : A → B → C) → {a1 a2 : A} → {b1 b2 : B} →
  a1 ≡ a2 → b1 ≡ b2 → f a1 b1 ≡ f a2 b2
hn-cong2 f p q = λ i → f (p i) (q i)

hn-le-nat : Nat → Nat → Bool
hn-le-nat zero    y       = true
hn-le-nat (suc x) zero    = false
hn-le-nat (suc x) (suc y) = hn-le-nat x y

hn-mul-nat : Nat → Nat → Nat
hn-mul-nat zero    y = zero
hn-mul-nat (suc x) y = plus y (hn-mul-nat x y)

hn-nl : List Word
hn-nl = cons #10 nil

hn-ln : List Word → List Word
hn-ln s = list-append s hn-nl

hn-zeros : Nat → List Word
hn-zeros zero    = nil
hn-zeros (suc k) = cons #0 (hn-zeros k)

hn-drop-n : Nat → List Word → List Word
hn-drop-n zero    xs          = xs
hn-drop-n (suc k) nil         = nil
hn-drop-n (suc k) (cons x xs) = hn-drop-n k xs

