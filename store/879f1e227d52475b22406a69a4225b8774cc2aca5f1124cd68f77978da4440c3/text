                  l4 = hn-ln (list-append "  3. Hypernet Contraction : active_morphisms=" (list-append (h-decimal (fromNat (list-length contracted))) (list-append " | best_cycle_rate_bps=" (list-append (h-decimal (hn-eff-rate bestCycle)) (list-append " | cap_uUSDC=" (list-append (h-decimal (hn-eff-cap bestCycle)) (list-append " | net_surplus_uUSDC=" (h-decimal surplus6))))))))
                  l5 = hn-ln (list-append "  4. Viral Waterfall (0d) : founder_and_lineage_uUSDC=[" (list-append (hn-fmt-words payouts6) (list-append "] | sum_uUSDC=" (list-append (h-decimal (hn-sum-w payouts6)) " (0 wei leak)"))))
                  l6 = hn-ln (list-append "  5. Viral Edge Capsules  : wasm=" (list-append (h-decimal (fromNat (list-length wasmCap))) (list-append "B | sm90a_ptx=" (list-append (h-decimal (fromNat (list-length ptxCap))) (list-append "B | evm_sieve=" (list-append (h-decimal (fromNat (list-length hn-sieve-bytecode))) (list-append "B | hxsv_beacon=32B (0x" (list-append (h-hex (h-take (toNat #8) beacon32)) "...)"))))))))
                  gateMsg = the (List Word)
                              (if dexArbLive
                               then "ATOMIC_FLASH_ARB_ADMITTED (net DEX spread > 9bps fee; calldata emitted)"
                               else "X402_AND_PORTAL_ACTIVE | DEX_FLASH_HOLD ($0 gas spent while on-chain spread <= 9bps fee)")
                  l7 = hn-ln (list-append "  6. Profit-or-Hold Gate  : " gateMsg)
              in h-out (h-concat (cons l1 (cons l2 (cons l3 (cons l4 (cons l5 (cons l6 (cons l7 nil))))))))))))))))))

hn-has-strike : List (List Word) → Bool
hn-has-strike nil         = false
hn-has-strike (cons a rs) = if h-eq a "strike" then true else hn-has-strike rs

hn-is-direct : List (List Word) → Bool
hn-is-direct nil         = false
hn-is-direct (cons a rs) = if h-infix "hx-hypernet" a then true else hn-is-direct rs

hn-run : Step W Unit
hn-run =
  to-step
    (bind h-args (λ av →
      if hn-is-direct av
      then bind (hn-execute (hn-has-strike (h-tail-lists av))) (λ u → exit #0)
      else ret {lzero} {W} unit))

#run hn-run
