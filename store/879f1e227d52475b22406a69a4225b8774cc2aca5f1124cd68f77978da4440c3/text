hn-src : HyperEdge → Word
hn-src (mk-hedge s d r c v l) = s

hn-dst : HyperEdge → Word
hn-dst (mk-hedge s d r c v l) = d

hn-eff-rate : HyperEdge → Word
hn-eff-rate (mk-hedge s d r c v l) = if v then r else #0

hn-eff-cap : HyperEdge → Word
