hn-lut3-minterm : Word → Word → Word → Word → Word → Word
hn-lut3-minterm imm m a b c =
  if %weq (%wand (%wshr imm m) #1) #0
  then #0
  else
    let ma = if %weq (%wand (%wshr m #2) #1) #1 then a else hn-not64 a
