cert-sep3d-one : (minS : Nat) → (s : Shape3D) → (ss : List Shape3D) →
  check-sep3d-one minS s ss ≡ true → AllSep3D minS s ss
cert-sep3d-one minS s nil _ = unit
cert-sep3d-one minS s (cons s2 ss) h =
  ( andB-fst (sep-3d minS s s2) (check-sep3d-one minS s ss) h
  , cert-sep3d-one minS s ss (andB-snd (sep-3d minS s s2) (check-sep3d-one minS s ss) h) )
