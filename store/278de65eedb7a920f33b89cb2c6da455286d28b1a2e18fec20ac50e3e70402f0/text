-- the code positions within Xor u v's code
sm-at-u : (u v : Expr) → (B : List Byte) → (a : Nat) → (rest : List Byte) →
  sm-drop a B ≡ list-append (sm-code (Xor u v)) rest →
  sm-drop a B ≡ list-append (sm-code u) (list-append (sm-code v) (cons op03 rest))
sm-at-u u v B a rest p = concat p (concat (sm-append-assoc (list-append (sm-code u) (sm-code v)) (cons op03 nil) rest)
  (sm-append-assoc (sm-code u) (sm-code v) (cons op03 rest)))
