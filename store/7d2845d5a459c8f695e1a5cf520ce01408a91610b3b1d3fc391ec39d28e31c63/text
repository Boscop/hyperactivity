-- the branch (sp at e′, spp at e) of tr(M_e M_e′) against the branch (spp at e, sp at e′) of tr(M_e′ M_e); the
-- degrees bound the indices
pair-branch-adj : Nat → Nat → Bool → Bool → List Nat → List Triple → Bool
pair-branch-adj e e1 sp spp ds ts = pair-adj (w-dim ds) (gram ds) (term-d (pair-branch e e1 sp spp ds ts)) (term-d (pair-branch e1 e spp sp ds ts)) zero (m-deg (fst (fst (snd (pair-branch e e1 sp spp ds ts))))) (m-deg (fst (fst (snd (snd (pair-branch e e1 sp spp ds ts))))))
