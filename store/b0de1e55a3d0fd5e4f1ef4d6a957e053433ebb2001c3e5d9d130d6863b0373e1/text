-- Theorem 4: Attenuated delegation soundness (issuer signed delegation AND delegate signed claim)
wp-deleg-sound : (ver : Word → Word → Bool) → (claim issuer delegate scope : Word) →
  ver issuer (%wxor delegate scope) ≡ true →
  ver delegate claim ≡ true →
  wp-satisfies ver claim (wp-deleg issuer delegate scope) ≡ true
wp-deleg-sound ver claim issuer delegate scope hi hd =
  andB-tt-s (ver issuer (%wxor delegate scope)) (ver delegate claim) hi hd
