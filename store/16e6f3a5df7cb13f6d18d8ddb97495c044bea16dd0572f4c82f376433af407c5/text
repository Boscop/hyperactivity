zpos-factor : (x d : Nat × Nat) → zpos (zmul x d) → zpos d → zpos x
zpos-factor x d h hd = zpos-or-np x (zpos x) (λ p → p)
  (λ np → le-sz-absurd (zpos x) zero (zle-trans (the (Nat × Nat) (suc zero , zero)) (zmul x d) (the (Nat × Nat) (zero , zero)) h
     (zle-mul-nonneg x (the (Nat × Nat) (zero , zero)) d (nn-of-pos d hd) np)))
