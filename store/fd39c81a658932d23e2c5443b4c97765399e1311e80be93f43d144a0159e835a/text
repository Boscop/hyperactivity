-- (x a)(y b) = (x y)(a b)
times4 : (x a y b : Nat) → times (times x a) (times y b) ≡ times (times x y) (times a b)
times4 x a y b = transN (times-assoc x a (times y b))
  (transN (congN (times x) (transN (symN (times-assoc a y b)) (transN (congN (λ z → times z b) (times-comm a y)) (times-assoc y a b))))
  (symN (times-assoc x y (times a b))))
