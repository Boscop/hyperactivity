-- ---------------------------------------------------------------- what followed, compiled
-- from place a of the forms, to the end of its line as written (a separation that held a line break), at
-- most z bytes, consed as read (reversed): x above holds whether the line has ended
m-cont-at : (s : Nat) → Bytes s → Word → Word × List Word → Word × List Word
m-cont-at s b x a = if orB (h-not (weq (fst a) #0)) (h-not (wlt x (bytes-length s b))) then (#1 , snd a)
  else (if weq (cstr-get s b x) #10 then (#1 , snd a) else (#0 , cons (cstr-get s b x) (snd a)))
