-- CSEL Xd, Xn, Xm, cc : 0x9a800000 | (Rm<<16) | (cc<<12) | (Rn<<5) | Rd
a64-csel : Word → Word → Word → Word → Lst Word
a64-csel rd rn rm cc =
  a64-insn (a64-or #2592079872 (a64-or (a64-shl (a64-and rm #31) #16)
           (a64-or (a64-shl (a64-and cc #15) #12) (a64-or (a64-shl (a64-and rn #31) #5) (a64-and rd #31)))))
