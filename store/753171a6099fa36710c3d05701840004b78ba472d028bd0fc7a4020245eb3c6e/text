div-pos-k : (S : List Bool) → (B : IV) → (vb : (Nat × Nat) × Nat) → ivc B × encl S B (fst vb) (snd vb) → le (suc zero) (snd vb) → bz-nonpos (fst B) ≡ false → zpos (zsc (fst vb) (bin-to-nat S))
div-pos-k S B vb RB lb h = zle-trans (the (Nat × Nat) (suc zero , zero)) (zsc (zv (fst B)) (snd vb)) (zsc (fst vb) (bin-to-nat S))
  (zpos-scale (zv (fst B)) (snd vb) (bz-nonpos-false (fst (fst B)) (snd (fst B)) (fst (fst RB)) h) lb) (fst (snd RB))
