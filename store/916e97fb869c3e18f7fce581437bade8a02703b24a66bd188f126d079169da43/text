ul : (Γ : CCtx) (Z : Type 1) → Mean (dext Γ) Z → Mean Γ (Line Z)
ul Γ Z L =
  dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (λ xq → LineO (CtxV (fst Γ)) (FbE (fst Γ) Z) (degen-l (CtxV (fst Γ)) xq)) (FbE (fst Γ) (Line Z))
    (λ γq Dq ρq → (fst Dq ρq , fst (snd Dq) ρq , λ iq → snd (snd Dq) iq ρq)) (snd Γ)
    (dcube-unreidx (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z)) (degen-l (CtxV (fst Γ))) (snd Γ) L)
