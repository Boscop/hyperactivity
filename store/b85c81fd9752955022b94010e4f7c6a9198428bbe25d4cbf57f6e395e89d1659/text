dp-tail : (e : Entry) (sk' sk : Lst Entry) (r : Word → Word) → DimPres sk' (lcons e sk) r → DimPres sk' sk (λ k → r (%wsucc k))
dp-tail (e-ty s) sk' sk r dp k =
  pcat0 Bool (isdim sk' (r (%wsucc k))) (isdim (lcons (e-ty s) sk) (%wsucc k)) (isdim sk k) (dp (%wsucc k)) (λ i → if weq-s0 k i then false else isdim sk (wsub-s1 k i))
dp-tail e-dim sk' sk r dp k =
  pcat0 Bool (isdim sk' (r (%wsucc k))) (isdim (lcons e-dim sk) (%wsucc k)) (isdim sk k) (dp (%wsucc k)) (λ i → if weq-s0 k i then true else isdim sk (wsub-s1 k i))
