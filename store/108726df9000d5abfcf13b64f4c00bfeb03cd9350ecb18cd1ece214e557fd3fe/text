llin-same-sound : (f g : LinT) → llin-same f g ≡ true → f ≡ g
llin-same-sound f g =
  case f return (λ w → llin-same w g ≡ true → w ≡ g) of
    lint k cs →
      (case g return (λ w → llin-same (lint k cs) w ≡ true → lint k cs ≡ w) of
         lint m ds → λ p →
           cong2l (weq-sound k m (andbt-l (weq k m) (lcoef-same cs ds) p))
                  (lcoef-same-sound cs ds (andbt-r (weq k m) (lcoef-same cs ds) p)))
