sx-each : List Word → List (List Word) → List Work → Proc W (List (List Word))
sx-each st q nil = ret {lzero} {W} nil
sx-each st q (cons (work n k p) r) = bind (h-pointer p) (λ mh → bind (h-read (sx-file mh)) (λ e → bind (sx-each st q r) (λ rest →
  ret {lzero} {W} (if h-null (sx-item n q e) then rest else cons (sx-item n q e) rest))))
