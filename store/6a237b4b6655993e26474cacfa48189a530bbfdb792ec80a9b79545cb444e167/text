-- UnicodeData.txt in build/ once: the system's copy, else fetched from unicode.org
e-ucd-ready : Proc W Bool
e-ucd-ready = bind (e-exists e-ucd-path) (λ have → if have then ret {lzero} {W} true else
  bind (e-exists e-ucd-system) (λ sys →
  bind (if sys then e-cmd (cons "cp" (cons e-ucd-system (cons e-ucd-path nil)))
        else e-cmd (cons "curl" (cons "-fsSL" (cons "-o" (cons e-ucd-path (cons "https://www.unicode.org/Public/UCD/latest/ucd/UnicodeData.txt" nil)))))) (λ c →
  ret (weq c #0))))
