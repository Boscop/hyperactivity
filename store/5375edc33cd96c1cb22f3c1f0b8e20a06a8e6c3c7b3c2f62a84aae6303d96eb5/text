sum-le : (e : Env) (hs : Hyps) (ms : Mults) → Holds e hs → Lew (wev e (sum-l hs ms)) (wev e (sum-r hs ms))
sum-le e hs ms hh =
  case hs return (λ w → (ms : Mults) → Holds e w → Lew (wev e (sum-l w ms)) (wev e (sum-r w ms))) of
    hnil → λ ms hh → lew-refl #0
    hcons l r rest → λ ms hh →
      (case ms return (λ w → Lew (wev e (sum-l (hcons l r rest) w)) (wev e (sum-r (hcons l r rest) w))) of
         munil → lew-refl #0
         mucons c cr → le-add (wev e (scale c l)) (wev e (scale c r)) (wev e (sum-l rest cr)) (wev e (sum-r rest cr)) (scale-le e c l r (fst hh)) (rec rest cr (snd hh)))
  ms hh
