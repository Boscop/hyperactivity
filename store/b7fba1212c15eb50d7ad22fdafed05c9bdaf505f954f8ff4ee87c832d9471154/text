-- the readers' documents (readers/READER.md): their paths picked from the source's module names while still in
-- hex (the hex of "readers/" begins every one), so only those are decoded
hi-reader-paths : Proc W (List (List Word))
hi-reader-paths = bind (h-list (list-append h-source "/modules")) (λ hs → ret (list-map h-unhex (hi-hex-readers hs)))
