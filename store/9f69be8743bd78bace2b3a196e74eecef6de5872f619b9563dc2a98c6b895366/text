-- step-level nk-oks? and nk-clear? when both active pairs satisfy nk-step-fx-wf under linear wire ownership
nk-step-fx-clear-at : (eq : Bool) (x w : NkW) (s : NkSlot) (r : NkFx) (n0 n1 : NkW) (ins outs : NkEnv) →
  (nk-weq x w ≡ false) → (nk-wire-lt x n0 ≡ true) → (nk-emem x ins ≡ false) → (nk-emem x outs ≡ false) →
  (nk-fx-wf ins outs n0 n1 r ≡ true) → nk-clear? x (nkf-at w (nkc-put s) r) ≡ true
nk-step-fx-clear-at eq x w s r n0 n1 ins outs neq lt hi ho hf =
  cong (λ z → if z then false else nk-clear? x r) neq ∙ nk-fx-clear x n0 n1 ins outs r lt hi ho hf
