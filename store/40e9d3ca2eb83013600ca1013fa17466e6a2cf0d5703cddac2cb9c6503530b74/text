encode-decode-at : (b : Bytes4) → (j : SumFin 4) → encodeLE (decodeLE b) j ≡ b j
encode-decode-at b j = case j return (λ x → encodeLE (decodeLE b) x ≡ b x) of
  inl u → concat {lzero} {Byte} {snd (le-s3 (decodeLE b))} {b fin4-0} {b (inl u)} (λ k → snd (enc-dec-s3 b k)) (λ k → b (inl (sf-unit u k)))
  inr j1 → (case j1 return (λ x → encodeLE (decodeLE b) (inr x) ≡ b (inr x)) of
    inl u → concat {lzero} {Byte} {fst (le-s3 (decodeLE b))} {b fin4-1} {b (inr (inl u))} (λ k → fst (enc-dec-s3 b k)) (λ k → b (inr (inl (sf-unit u k))))
    inr j2 → (case j2 return (λ x → encodeLE (decodeLE b) (inr (inr x)) ≡ b (inr (inr x))) of
      inl u → concat {lzero} {Byte} {fst (le-s2 (decodeLE b))} {b fin4-2} {b (inr (inr (inl u)))} (λ k → fst (enc-dec-s2 b k)) (λ k → b (inr (inr (inl (sf-unit u k)))))
      inr j3 → (case j3 return (λ x → encodeLE (decodeLE b) (inr (inr (inr x))) ≡ b (inr (inr (inr x)))) of
        inl u → concat {lzero} {Byte} {fst (le-s1 (decodeLE b))} {b fin4-3} {b (inr (inr (inr (inl u))))} (enc-dec-3 b) (λ k → b (inr (inr (inr (inl (sf-unit u k))))))
        inr e → Empty-rec e)))
