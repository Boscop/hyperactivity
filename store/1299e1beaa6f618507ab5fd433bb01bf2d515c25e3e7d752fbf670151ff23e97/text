rxui : (n : Nat) (X X' : Type 1) (F' : X' → Type 1) (f : X → X') (c : Cube n X) (d : DCube n X' F' (cube-map n X X' f c)) →
  PathP (λ i → DCube n X' F' (cube-map n X X' f c)) (dcube-reidx n X X' (λ x → F' (f x)) F' f (λ x q → q) c (dcube-unreidx n X X' F' f c d)) d
rxui zero X X' F' f c d = λ i → d
rxui (suc n) X X' F' f c d = rxui n (Line X) (Line X') (LineO X' F') (line-map X X' f) c d
