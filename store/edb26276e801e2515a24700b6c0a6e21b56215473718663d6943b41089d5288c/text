-- ---------------------------------------------------------------- the digit step
-- D·P + R < 256·P when D < 256 and R < P
lt-digit-path : (D R P d1 d2 : Word) → wadd (%wsucc D) d1 ≡ #256 → wadd (%wsucc R) d2 ≡ P →
                wadd (%wsucc (wadd (wmul D P) R)) (wadd d2 (wmul d1 P)) ≡ wmul #256 P
lt-digit-path D R P d1 d2 eD eR =
  catw (wadd-assoc (wmul D P) (%wsucc R) (wadd d2 (wmul d1 P)))
    (catw (congw (λ z → wadd (wmul D P) z) (symw (wadd-assoc (%wsucc R) d2 (wmul d1 P))))
      (catw (symw (wadd-assoc (wmul D P) (wadd (%wsucc R) d2) (wmul d1 P)))
        (catw (congw (λ z → wadd (wadd (wmul D P) z) (wmul d1 P)) eR)
          (catw (congw (λ z → wadd z (wmul d1 P)) (symw (wmul-suc-l D P)))
            (catw (symw (wmul-distr (%wsucc D) d1 P))
              (congw (λ z → wmul z P) eD))))))
