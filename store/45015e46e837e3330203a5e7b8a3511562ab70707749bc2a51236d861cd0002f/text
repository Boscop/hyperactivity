-- the specification: every point of ts, numbered from i, at which q begins
hits : List (List Word) → Nat → List (List Word) → List Nat
hits q i ts =
  (case ts return λ w → Nat → List Nat of
     nil → λ i → nil
     cons t r → λ i → if pre q (cons t r) then cons i (rec r (suc i)) else rec r (suc i)) i
