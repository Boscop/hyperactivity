-- Multi-Outcome NegRisk Dutch-Book Surplus (`payout10000 = #10000` bps = `$1.00`, minus `sumAskBps + feeBps`):
ms-negrisk-surplus-bps : Word → List Word → Word
ms-negrisk-surplus-bps feeBps outcomeAskBps =
  let cost = %wadd feeBps (ms-sum-words outcomeAskBps)
  in if %wlt cost #10000 then %wsub #10000 cost else #0
