kvl-apply : (r : Nat) → r < 3 → (w : KvWrite) → (g : KvG) → KvOwes r w g → InL {KvWrite} w (kv-app r (node-step {KvMsg} {KvSt} kv-bc-beh r ev-run g))
kvl-apply zero h w g e = subst {lzero} {lzero} {KvPend} {λ pd → InL {KvWrite} w (r-app (fst (fst (ns-go {KvMsg} {KvSt} zero ev-run g (nview-map {KvMsg} {KvRep} {KvSt} (λ x → (x , snd (fst g zero))) (kv-rep-go (fst (fst g zero)) pd))) zero)))} (sym e) (inl (λ i → w))
kvl-apply (suc zero) h w g e = subst {lzero} {lzero} {KvPend} {λ pd → InL {KvWrite} w (r-app (fst (fst (ns-go {KvMsg} {KvSt} (suc zero) ev-run g (nview-map {KvMsg} {KvRep} {KvSt} (λ x → (x , snd (fst g (suc zero)))) (kv-rep-go (fst (fst g (suc zero))) pd))) (suc zero))))} (sym e) (inl (λ i → w))
kvl-apply (suc (suc zero)) h w g e = subst {lzero} {lzero} {KvPend} {λ pd → InL {KvWrite} w (r-app (fst (fst (ns-go {KvMsg} {KvSt} (suc (suc zero)) ev-run g (nview-map {KvMsg} {KvRep} {KvSt} (λ x → (x , snd (fst g (suc (suc zero))))) (kv-rep-go (fst (fst g (suc (suc zero)))) pd))) (suc (suc zero)))))} (sym e) (inl (λ i → w))
kvl-apply (suc (suc (suc zero))) h w g e = Empty-rec h
kvl-apply (suc (suc (suc (suc j)))) h w g e = Empty-rec h
