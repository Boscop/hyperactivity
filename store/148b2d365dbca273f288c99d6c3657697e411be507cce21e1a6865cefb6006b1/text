-- CDecl: a declaration of the unit. One constructor per Clang Decl kind met at the top level (members are listed flat, with the id of their class). cd-var-dynamic is a variable of static storage that the unit's start-up code initializes (Clang did not make its initializer a constant), in the order of the unit's `statics`
data CDecl =
    cd-function (f : CFunction)
  | cd-method (parent : Word) (virtual : Bool) (f : CFunction)
  | cd-constructor (parent : Word) (inits : List CCtorInit) (f : CFunction)
  | cd-destructor (parent : Word) (virtual : Bool) (f : CFunction)
  | cd-conversion (parent : Word) (virtual : Bool) (f : CFunction)
  | cd-record (r : CRecord)
  | cd-class-template-specialization (args : List CTArg) (r : CRecord)
  | cd-enum (id : Word) (name : CStr) (underlying : CType) (scoped : Bool) (enumerators : List CEnumerator)
  | cd-var (mangled : CStr) (v : CVar)
  | cd-var-dynamic (mangled : CStr) (v : CVar)
  | cd-var-template-specialization (args : List CTArg) (mangled : CStr) (v : CVar)
