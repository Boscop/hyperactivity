hy-keep-many : List Word → List Word → List (List Word) → List (List Word × (List Word × List Word)) → List (List Word) → List (List Word) → Proc W Unit
hy-keep-many st m names cs roots nil = hy-keys st names
hy-keep-many st m names cs roots (cons p ps) =
  bind (hy-write-files m cs false) (λ u → bind (hy-verdicts st m roots) (λ v →
  bind (h-say (list-append (h-line "nothing written: it does not check") (h-indented "  " (cons p ps)))) (λ u2 → exit #1)))
