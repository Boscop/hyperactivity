-- UNIVERSAL THEOREM 1 (SUPERCHIP INTERACTION-NET SOUNDNESS ACROSS ALL `env` & `e`, 0 POSTULATES):
bn-thm-opt-sound : (env : Word) → (e : INetExpr) → inet-eval env (superchip-opt e) ≡ inet-eval env e
bn-thm-opt-sound _   (in-lit _) = refl
bn-thm-opt-sound _   in-var0    = refl
bn-thm-opt-sound env (in-dup-add x) =
  bn-trans (bn-lem-dup-add env (superchip-opt x))
           (cong (λ v → bn-add64 v v) (bn-thm-opt-sound env x))
bn-thm-opt-sound env (in-add a b) =
  bn-trans (bn-lem-add env (superchip-opt a) (superchip-opt b))
           (bn-cong2 bn-add64 (bn-thm-opt-sound env a) (bn-thm-opt-sound env b))
bn-thm-opt-sound env (in-xor a b) =
  bn-trans (bn-lem-xor env (superchip-opt a) (superchip-opt b))
           (bn-cong2 bn-xor64 (bn-thm-opt-sound env a) (bn-thm-opt-sound env b))
bn-thm-opt-sound env (in-era-l _ live) = bn-thm-opt-sound env live
bn-thm-opt-sound env (in-lut3 m a b c) =
  bn-trans (bn-lem-lut3 env m (superchip-opt a) (superchip-opt b) (superchip-opt c))
           (bn-cong3 (bn-lut3-w64 m) (bn-thm-opt-sound env a) (bn-thm-opt-sound env b) (bn-thm-opt-sound env c))
