nk-act-i : Word → NkTm → NkTm → NkAct
nk-act-i h cs d =
  if %weq h #5 then act-hd (nk-pt (nk-not-d d))
  else (if %weq h #6 then act-ap (nk-match #16 (nk-var #0) (nk-cons d nk-nil))
  else (if %weq h #7 then act-ap (nk-match #17 (nk-var #0) (nk-cons d nk-nil))
  else (if %weq h #16 then act-hd (nk-pt (nk-and-d (nk-branch cs #0) d))
  else act-hd (nk-pt (nk-or (nk-branch cs #0) d)))))
