-- (part of language-support)
mul_spec_16 : (dst' : Bits #16) → (src : Bits #16) → ((Bits #16) × (Bits #16) × (Bits #32))
mul_spec_16 dst' src =
  let product : Bits #32
      product = (bits_of_int (z-mul (bv-unsigned #16 dst') (bv-unsigned #16 src)) (zpos #32))
      product_high : Bits #16
      product_high = (bv-slice #32 product #31 #16)
      product_low : Bits #16
      product_low = (bv-slice #32 product #15 #0)
  in (product_high , product_low , product)
