hcm-get32 : Word → Word → (Word → Step W Word) → Step W Word
hcm-get32 buf off k =
  scmd (w-load8 (%wadd buf off)) (λ b0 →
  scmd (w-load8 (%wadd buf (%wadd off #1))) (λ b1 →
  scmd (w-load8 (%wadd buf (%wadd off #2))) (λ b2 →
  scmd (w-load8 (%wadd buf (%wadd off #3))) (λ b3 →
  k (%wor (%wshl b0 #24) (%wor (%wshl b1 #16) (%wor (%wshl b2 #8) b3)))))))
