sq-starts-c-range : {A : Type} → (le : A → A → Bool) → (top : A) → (r : List (List A)) → (x : List A) → (s : List (List A)) → sq-below-all le top s →
  sq-starts-c le r x s ≡ andB (lexle (lexle le) (cons x r) s) (not (lexle (lexle le) (sq-up-c top r x) s))
sq-starts-c-range le top r = case r return λ w → (x : List A) → (s : List (List A)) → sq-below-all le top s → sq-starts-c le w x s ≡ andB (lexle (lexle le) (cons x w) s) (not (lexle (lexle le) (sq-up-c top w x) s)) of
  nil → λ x s → case s return λ v → sq-below-all le top v → sq-starts-c le nil x v ≡ andB (lexle (lexle le) (cons x nil) v) (not (lexle (lexle le) (sq-up-c top nil x) v)) of
    nil → λ h i → false
    cons y t → λ h → concat (sq-pre-range le top x y (fst h))
      (λ i → andB (sym (sq-step-true (lexle le x y) (lexle le y x)) i)
                  (not (sym (sq-step-true (lexle le (list-append x (cons top nil)) y) (lexle le y (list-append x (cons top nil)))) i)))
  cons z r2 → λ x s → case s return λ v → sq-below-all le top v → sq-starts-c le (cons z r2) x v ≡ andB (lexle (lexle le) (cons x (cons z r2)) v) (not (lexle (lexle le) (sq-up-c top (cons z r2) x) v)) of
    nil → λ h i → false
    cons y t → λ h → concat (cong (andB (andB (lexle le x y) (lexle le y x))) (rec r2 z t (snd h)))
      (sq-step-and (lexle le x y) (lexle le y x) (lexle (lexle le) (cons z r2) t) (lexle (lexle le) (sq-up-c top r2 z) t))
