hy-stated : List Word → List Word → Proc W (Sum Unit (List Word × List Word))
hy-stated st name = bind (hy-get st (list-append "written/" (h-hex name))) (λ w →
  if h-null (hy-or nil w) then ret {lzero} {W} (inl unit)
  else bind (hy-get st (list-append "bound/" (h-hex "hy-stated-of"))) (hy-stated-keyed st (hy-or nil w)))
