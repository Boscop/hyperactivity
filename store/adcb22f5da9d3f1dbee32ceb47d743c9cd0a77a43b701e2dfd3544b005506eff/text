-- Generate all valid (i, i+4) α-helix H-bond contacts, automatically breaking any contact
-- whose donor (i+4) is Proline (Pro lacks a backbone amide proton!).
sf-helix-from : Nat → Nat → List AA → List (Nat × Nat)
sf-helix-from zero idx seq = nil
sf-helix-from (suc f) idx seq =
  let n = sf-len seq
      j = plus idx 4
  in if leb n (suc j) then nil
     else if aa-is-pro (aa-nth j seq)
          then sf-helix-from f (suc idx) seq
          else cons (idx , j) (sf-helix-from f (suc idx) seq)
