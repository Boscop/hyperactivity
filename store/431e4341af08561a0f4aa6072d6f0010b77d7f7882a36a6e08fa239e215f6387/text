d-fold : (P : Tag → Jdg → Type 1) →
  ((r : DRule) (t : Tag) (x : RData r) → isTrue (kallows (rkind r) t) → AllP P (tagged t (premJ r x)) → P t (concl r x)) →
  {G : Goal} → D G → GoalP P G
d-fold P alg {G} dnil = one
d-fold P alg {G} (dcons t J ps d e) = (d-fold P alg d , d-fold P alg e)
d-fold P alg {G} (drule r t x w e) = alg r t x w (d-fold P alg e)
