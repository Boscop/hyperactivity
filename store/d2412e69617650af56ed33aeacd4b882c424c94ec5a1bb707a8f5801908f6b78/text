-- Two pin drops on distinct vertical M2 columns NEVER short-circuit at any Y coordinate!
channel-no-m2-short : (xCol1 xCol2 y1 y2 : Nat) →
  (xCol1 ≡ xCol2 → Empty) →
  Path Point3D (m2-vert , (xCol1 , y1)) (m2-vert , (xCol2 , y2)) → Empty
channel-no-m2-short xCol1 xCol2 y1 y2 neq h =
  neq (λ i → fst (snd (h i)))
