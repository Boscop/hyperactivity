-- (part of language-support)
wme80 : (proc_mode' : proc_mode) → (addr_size : ZI) → (eff_addr : Bits #64) → (base_reg : Option ZI) → (seg_reg : ZI) → (data' : Bits #80) → (check_alignment? : Bool) → MS Unit
wme80 proc_mode' addr_size eff_addr base_reg seg_reg data' check_alignment? =
  store_bytes_to_ea proc_mode' addr_size (zpos #10) eff_addr base_reg seg_reg data' check_alignment? false
