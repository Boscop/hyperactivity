-- THEOREM 2: DISCRETE MAXWELL / STOKES 2-CELL PLAQUETTE CONSERVATION (d1 o d2 == 0)
-- Around any 4-corner elementary plaquette (v0, v1, v2, v3), oriented edge circulation vanishes identically:
lux-plaq-coboundary : Bool → Bool → Bool → Bool → Bool
lux-plaq-coboundary v0 v1 v2 v3 =
  lux-bxor (lux-bxor v0 v1)
  (lux-bxor (lux-bxor v1 v2)
  (lux-bxor (lux-bxor v2 v3)
            (lux-bxor v3 v0)))
