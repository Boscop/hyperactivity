nk-const-on-s : NkTm → NkTm → Word → NkTm → NkTm → Bool
nk-const-on-s kdefs ctx n line (nk-cons sg r) =
  let csub = nk-ext-s kdefs (nk-sub-clause sg ctx) n nk-I
  in if nk-eq-s kdefs csub (%wsucc n)
          (nk-norm-in-s kdefs csub (%wsucc n) (nk-sub-clause sg (nk-app line (nk-free n))))
          (nk-norm-in-s kdefs csub (%wsucc n) (nk-sub-clause sg (nk-app line nk-i0)))
       then nk-const-on-s kdefs ctx n line r else false
nk-const-on-s kdefs ctx n line t = true
