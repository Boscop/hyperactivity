-- (part of language-support)
shrd_spec : (size : ZI) → (dst' : Bits #64) → (src : Bits #64) → (cnt : Bits #6) → (input_rflags : rflagsbits) → MF ((Bits #64) × Bool × rflagsbits × rflagsbits)
shrd_spec size dst' src cnt input_rflags =
  if (z-eq size (zpos #2)) then
    (bindF {((Bits #16) × Bool × rflagsbits × rflagsbits)} {((Bits #64) × Bool × rflagsbits × rflagsbits)} (shrd_spec_16 (bv-trunc #64 #16 dst') (bv-trunc #64 #16 src) cnt input_rflags) (λ t'1 →
       let elem0 : Bits #16
           elem0 = (fst t'1)
           elem1 : Bool
           elem1 = (fst (snd t'1))
           elem2 : rflagsbits
           elem2 = (fst (snd (snd t'1)))
           elem3 : rflagsbits
           elem3 = (snd (snd (snd t'1)))
       in retF {((Bits #64) × Bool × rflagsbits × rflagsbits)} ((bv-zext #16 #64 elem0) , elem1 , elem2 , elem3)))
  else if (z-eq size (zpos #4)) then
    (bindF {((Bits #32) × Bool × rflagsbits × rflagsbits)} {((Bits #64) × Bool × rflagsbits × rflagsbits)} (shrd_spec_32 (bv-trunc #64 #32 dst') (bv-trunc #64 #32 src) cnt input_rflags) (λ t'2 →
       let elem0 : Bits #32
           elem0 = (fst t'2)
           elem1 : Bool
           elem1 = (fst (snd t'2))
           elem2 : rflagsbits
           elem2 = (fst (snd (snd t'2)))
           elem3 : rflagsbits
           elem3 = (snd (snd (snd t'2)))
       in retF {((Bits #64) × Bool × rflagsbits × rflagsbits)} ((bv-zext #32 #64 elem0) , elem1 , elem2 , elem3)))
  else if (z-eq size (zpos #8)) then
    (shrd_spec_64 dst' src cnt input_rflags)
  else
    (retF {((Bits #64) × Bool × rflagsbits × rflagsbits)} (#0 , false , #0 , #0))
