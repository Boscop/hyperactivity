-- a line of types is constant on a face: on each case of the face, the line at a new point of
-- the interval is the line at the start (a transport's face says where its line does not move)
nk-const-on : NkTm → Word → NkTm → NkTm → Bool
nk-const-on ctx n line (nk-cons sg r) =
  if nk-tm-eq (nk-norm-in (nk-ext (nk-sub-clause sg ctx) n nk-I) (%wsucc n) (nk-sub-clause sg (nk-app line (nk-free n))))
              (nk-norm-in (nk-ext (nk-sub-clause sg ctx) n nk-I) (%wsucc n) (nk-sub-clause sg (nk-app line nk-i0)))
  then nk-const-on ctx n line r else false
nk-const-on ctx n line t = true
