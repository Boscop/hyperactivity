gsession-guard : {S : Sig} {St : Type} → World S St → World S (GSession S × St)
gsession-guard {S} {St} w c st =
  case sess-ok {κ0} {S} (fst st κ0) c of
    true → (case w c (snd st) of
              inl r → inl (fst r , (gs-advance {S} (fst st) c (fst r) , snd r))
              inr s2 → inr (fst st , s2))
    false → inr st
