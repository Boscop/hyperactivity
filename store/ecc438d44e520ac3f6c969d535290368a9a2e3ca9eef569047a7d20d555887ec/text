kc-rc-bits : Nat → Word → Word → UInt64 → UInt64
kc-rc-bits zero    j lfsr acc = acc
kc-rc-bits (suc n) j lfsr acc =
  let bitOn = %wand lfsr #1
      nextL = kc-lfsr-step (toNat #1) lfsr
      pos   = %wsub (%wshl #1 j) #1
      acc2  = if %weq bitOn #1 then u64or acc (u64shl (u64 #1) (u64 pos)) else acc
  in kc-rc-bits n (%wadd j #1) nextL acc2
