-- navigate-best m p n view t: best-first under the model m toward the purpose p, at most n
-- expansions. For minimize, the least-cost term reached; for a goal, the first goal term in cost
-- order (none reached: the least-cost term, reached = false)
navigate-best m p n view t = (let s = node-of m t #0 in search m p view n (lcons s lnil) lnil s)
