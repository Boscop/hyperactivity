ribbon-build-go : RPt → List RPt → SInt → List Pt2 → List Pt2 → List Pt2 × List Pt2
ribbon-build-go prev nil extraW accL accR = (lg-rev accL , accR)
ribbon-build-go prev (cons cur nil) extraW accL accR =
  let lr = ribbon-offset-pt prev cur cur extraW
  in (lg-rev (cons (fst lr) accL) , cons (snd lr) accR)
ribbon-build-go prev (cons cur (cons nxt r)) extraW accL accR =
  let lr = ribbon-offset-pt prev cur nxt extraW
  in ribbon-build-go cur (cons nxt r) extraW (cons (fst lr) accL) (cons (snd lr) accR)
