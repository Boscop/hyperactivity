-- paper [SECTION]: the paper as it reads, whole or one section (4.4, A.1, Part II), from the store,
-- where lib/paper-view.cub keeps it, made again when anything under the repository has changed
hy-hashes : List Word → Nat
hy-hashes nil = zero
hy-hashes (cons x r) = if weq x #35 then suc (hy-hashes r) else zero
