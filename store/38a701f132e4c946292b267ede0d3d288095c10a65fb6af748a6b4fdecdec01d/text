-- 3. Self-Continuation Attractor Basin (Addictus Fixed-Point Stability SOS):
--    Deviation (x, y) = (c - c*, a - a*) around the addicted equilibrium satisfies
--      4 η_c · (η_c x² - (γ_1 + γ_2) x y + η_a y²)
--        = (2 η_c x - (γ_1 + γ_2) y)² + (4 η_c η_a - (γ_1 + γ_2)²) y² ≥ 0.
--    Variables (0..5): η_c, η_a, γ_1, γ_2, x, y.
oxy-attractor-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
oxy-attractor-poly A ad mu q vs =
  (λ g sub sq →
    let ec = g 0; ea = g 1; g1 = g 2; g2 = g 3; x = g 4; y = g 5
        q2 = q (fn-q 2 1)
        q4 = q (fn-q 4 1)
        gm = ad g1 g2
        diss = ad (sub (mu ec (sq x)) (mu gm (mu x y))) (mu ea (sq y))
        lhs = mu q4 (mu ec diss)
        rhs = ad (sq (sub (mu q2 (mu ec x)) (mu gm y)))
                 (mu (sub (mu q4 (mu ec ea)) (sq gm)) (sq y))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
