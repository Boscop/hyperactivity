ms-cmd-run : Bool → Proc W Unit
ms-cmd-run isStrike =
  bind (bn-dispatch (if isStrike then cons "up" nil else cons "plan" nil)) (λ uBn →
  bind (bn-load-funded-key isStrike) (λ priv →
  bind (h-mkdir ms-out-dir) (λ m0 →
    let rel20      = eth-priv-to-addr20 priv
        rel55      = eth-eip55-from-bytes20 rel20
        vlt55      = eth-eip55-from-bytes20 (eth-create-addr20 rel20 #0)
        fnd55      = eth-eip55-from-bytes20 eth-founder-coinbase-addr20
        immLut     = ms-cone-imm8 ms-demo-13gate-cone
        lutNet     = in-lut3 immLut in-var0 (in-lit #15) (in-lit #99)
        ptxUlop3   = emit-ptx-sm90a false lutNet
        elfX86     = emit-elf64-x86 #11 bn-demo-inet
        morphoCd   = ms-encode-morpho-flash bn-usdc-base20 #1000000000000 "HX-MORPHO-0BPS-STRIKE"
        x402Chal   = ms-x402-challenge-json #250000 "/x402/superchip-ulop3"
        alloc5k    = ms-split-budget ms-target-5k-usdc6
    in bind (h-write (list-append ms-out-dir "/masterstroke_ulop3_sm90a.ptx") ptxUlop3) (λ w1 →
       bind (h-write (list-append ms-out-dir "/masterstroke_worker_x86_64") elfX86) (λ w2 →
       bind (h-write (list-append ms-out-dir "/deployless_base8453_sieve.hex") (bn-ln (list-append "0x" (h-hex ms-sieve-bytecode)))) (λ w3 →
       bind (h-write (list-append ms-out-dir "/morpho_0bps_flash_1M_usdc.hex") (bn-ln (list-append "0x" (h-hex morphoCd)))) (λ w4 →
       bind (h-write (list-append ms-out-dir "/inbound_x402_402_challenge.json") (bn-ln x402Chal)) (λ w5 →
       bind (bl-rpc-call "eth_getBalance" (h-concat (cons "[" (cons (h-quote rel55) (cons "," (cons (h-quote "latest") (cons "]" nil))))))) (λ rBal →
       bind (bn-query-usdc6 rel20) (λ liveUsdc6 →
       bind ms-run-live-sieve (λ sieveHex →
       bind (if isStrike then ms-strike-h200-mesh else ret {lzero} {W} #0) (λ h200Ok →
         let balWei      = bl-hex-to-word (bl-extract-json-hex rBal)
             morphoUsdc6 = ms-word-at-hex zero sieveHex
             morphoWethW = ms-word-at-hex (suc zero) sieveHex
             spUniV3     = ms-word-at-hex (toNat #2) sieveHex
             spSlip      = ms-word-at-hex (toNat #3) sieveHex
             aeroR0      = ms-word-at-hex (toNat #4) sieveHex
             aeroR1      = ms-word-at-hex (toNat #5) sieveHex
             pxUniUsdc6  = ms-sqrtpx96-to-usdc6 spUniV3
             pxSlipUsdc6 = ms-sqrtpx96-to-usdc6 spSlip
             pxAeroUsdc6 = if %weq aeroR0 #0 then #0 else %wdiv (%wmul aeroR1 #1000000000000000000) aeroR0
             refPxUsdc6  = if %weq pxUniUsdc6 #0 then #1683000000 else pxUniUsdc6
             ethValUsdc6 = %wdiv (%wmul balWei refPxUsdc6) #1000000000000000000
             totLive6    = %wadd liveUsdc6 ethValUsdc6
             topUpNeed6  = if %wlt totLive6 ms-target-5k-usdc6 then %wsub ms-target-5k-usdc6 totLive6 else #0
             spreadU_S   = if %weq pxUniUsdc6 #0 then #0 else %wdiv (%wmul (ms-abs-diff pxUniUsdc6 pxSlipUsdc6) #10000) pxUniUsdc6
             morphoUsdM  = %wdiv morphoUsdc6 #1000000000000
             morphoEthWh = %wdiv morphoWethW #1000000000000000000
             l1 = bn-ln "[HX-MASTERSTROKE | SINGLE HYPERFACTORED S+K<K*S HIGH-CONVEXITY ENGINE]"
             l2 = bn-ln (list-append "  1. Funded Base 8453 Key : relayer=" (list-append rel55 (list-append " | vault=" (list-append vlt55 (list-append " | founder=" fnd55)))))
             l3 = bn-ln (list-append "  2. $5K Strike Capital   : settled_uUSDC=" (list-append (h-decimal totLive6) (list-append " / 5000000000 | topup_to_5k_uUSDC=" (list-append (h-decimal topUpNeed6) " (send Base USDC/ETH to relayer)"))))
             l4 = bn-ln "  3. $5K Convexity Split  : $500 Morpho-0bps-Flash-Gas | $2500 64x-GPU-TIG+Immunefi-Burst | $1500 NegRisk+Intent-Arb | $500 Inbound-x402"
             l5 = bn-ln (list-append "  4. 1-Call EVM Sieve     : Morpho_0bps_USDC=$" (list-append (h-decimal morphoUsdM) (list-append "M | Morpho_0bps_WETH=" (list-append (h-decimal morphoEthWh) (list-append " ETH | UniV3_uUSDC=" (list-append (h-decimal pxUniUsdc6) (list-append " | Slipstream_uUSDC=" (list-append (h-decimal pxSlipUsdc6) (list-append " | vAMM_uUSDC=" (list-append (h-decimal pxAeroUsdc6) (list-append " | spread_bps=" (h-decimal spreadU_S))))))))))))
             l6 = bn-ln (list-append "  5. Superchip ULOP3 v2   : 13-gate Boolean cone -> 1-insn lop3.b32 (imm8=#" (list-append (h-decimal immLut) (list-append ", -92.3% gates) | sieve_bytes=" (list-append (h-decimal (fromNat (list-length ms-sieve-bytecode))) "B | inbound_x402=ACTIVE"))))
             modeTxt = if isStrike
                       then list-append "LIVE_STRIKE (base_sieve_1call=OK | idle_h200_0_1_3_ulop3_and_hyperfactor=" (list-append (h-decimal h200Ok) ")")
                       else "PLAN_READY (run with 'strike' to execute live across Base 8453 + idle H200s)"
             l7 = bn-ln (list-append "  6. Execution Status     : " modeTxt)
         in h-out (h-concat (cons l1 (cons l2 (cons l3 (cons l4 (cons l5 (cons l6 (cons l7 nil))))))))))))))))))))
