os-bound : List Word × (List Word × (Word × Word)) → Sum Unit (List Word) → Proc W (Sum (List Word) (List (List Word × List Word)))
os-bound e (inl u) = ret (inr nil)
os-bound e (inr t) = if h-eq (h-entry-module (h-entry-words t)) "-" then ret {lzero} {W} (inr nil) else os-module e (h-unhex (h-word (suc zero) (h-entry-words t)))
