he-hm2 : Nat → Nat → Nat × (Nat × Nat) → Nat × (Nat × Nat) → BQ → Nat → Nat → Nat → BQ
he-hm2 ap aq x y al ei ej ek = he-sumq
  (cons (he-half (he-grad ap aq false (he-i x) (he-i y) (he-k x) (he-k y) al ei ej ek))
  (cons (he-half (he-grad ap aq true (he-j x) (he-j y) (he-k x) (he-k y) al ei ej ek))
  (cons (he-t ap aq (he-neg (he-nat 2)) ei ej ek 0 1 0 0 0 0)
  (cons (he-t ap aq (he-neg (he-nat 2)) ei ej ek 0 0 0 1 0 0)
  (cons (he-t ap aq (he-nat 1) ei ej ek 0 0 0 0 0 1) nil)))))
