-- & | ^ at an integer kind or at bool
rm-bit : BinOp → SK → SV → SV → MRes SV
rm-bit o k a b = case k of
  sk-bool → mr-bind (sv-as-b a) (λ x → mr-bind (sv-as-b b) (λ y → case o of
    ao-and → mok (sv-b (m-and x y))
    ao-or → mok (sv-b (m-or x y))
    ao-xor → mok (sv-b (not (u64eq (uq-b x) (uq-b y))))
    _ → mstop st-ill-typed))
  _ → sv-arith o k a b
