-- an interval term read back as a body, at a depth
nk-lit-tm : Word → Word → NkTm
nk-lit-tm d c =
  let id = %wdiv c #4
      lv = %weq (%wsub (%wdiv c #2) (%wmul (%wdiv c #4) #2)) #1
      ng = %weq (%wsub c (%wmul (%wdiv c #2) #2)) #1
      base = if lv then nk-var (%wsub (%wsub d #1) id) else nk-free id
  in if ng then nk-op #5 base nk-nil else base
