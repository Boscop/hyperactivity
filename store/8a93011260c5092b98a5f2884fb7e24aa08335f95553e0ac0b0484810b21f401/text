-- /llms.txt : plain-text index of Hyperactive Labs, Inc. for AI assistants and crawlers
s-llms-item : Work → Proc W (List Word)
s-llms-item (work n k p) = bind (s-work-text (work n k p)) (λ t → ret {lzero} {W} (h-concat (cons "- [" (cons (s-title-or n t) (cons "](https://hyperactivity.ai/" (cons n (cons "): " (cons (s-excerpt t) (cons (cons #10 nil) nil)))))))))
