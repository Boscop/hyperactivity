-- a path holding alternatives (two or more live entries; the index's alternatives/PATH, a line per entry)
-- read whole, each under its entry, so that which entries to state dead is decided by reading them; a
-- path holding neither a module nor alternatives fails as before
hy-def-alternatives : List Word → List (List Word) → Proc W Unit
hy-def-alternatives name nil = h-fail (list-append "hyperactive: the source holds no module " name)
hy-def-alternatives name ls = hy-def-alternatives-rest name ls
