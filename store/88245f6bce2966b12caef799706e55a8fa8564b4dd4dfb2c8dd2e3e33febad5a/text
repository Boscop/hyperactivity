-- then a round of peeling shortens a nonempty list: a member of least stamp has no predecessor
tso-peel-shrinks : {A : Type} → (rel : A → A → Bool) → (st : A → Nat) → (y : A) → (r : List A) → TsoMono rel st (cons y r) →
                   tso-len (tso-peel rel (cons y r)) < suc (tso-len r)
tso-peel-shrinks rel st y r mono =
  tso-keep-lt (λ x → tso-any (λ z → rel z x) (cons y r)) (cons y r) (fst (tso-least st r y)) (fst (snd (tso-least st r y)))
    (λ h → tso-lt-le-absurd
             (st (fst (tso-any-elim (λ z → rel z (fst (tso-least st r y))) (cons y r) h)))
             (st (fst (tso-least st r y)))
             (mono (fst (tso-any-elim (λ z → rel z (fst (tso-least st r y))) (cons y r) h)) (fst (tso-least st r y))
                   (fst (snd (tso-any-elim (λ z → rel z (fst (tso-least st r y))) (cons y r) h)))
                   (fst (snd (tso-least st r y)))
                   (snd (snd (tso-any-elim (λ z → rel z (fst (tso-least st r y))) (cons y r) h))))
             (snd (snd (tso-least st r y))
                  (fst (tso-any-elim (λ z → rel z (fst (tso-least st r y))) (cons y r) h))
                  (fst (snd (tso-any-elim (λ z → rel z (fst (tso-least st r y))) (cons y r) h)))))
