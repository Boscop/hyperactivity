-- order laws on wlt / ltw
cm-ltw-shift-step : (k r f : Word) → ltw (wadd k r) (wadd k f) ≡ true →
                    ltw (wadd (%wsucc k) r) (wadd (%wsucc k) f) ≡ true
cm-ltw-shift-step k r f h =
  cm-catb (cm-congb (λ z → ltw z (wadd (%wsucc k) f)) (cm-wadd-suc-l k r))
    (cm-catb (cm-congb (λ z → ltw (%wsucc (wadd k r)) z) (cm-wadd-suc-l k f)) h)
