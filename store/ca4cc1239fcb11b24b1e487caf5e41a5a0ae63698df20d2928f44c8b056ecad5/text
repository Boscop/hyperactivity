int-to-f64 : Bool → IW → SV → MRes Float64
int-to-f64 sg w v = case w of
  iw128 → mr-map (λ a → f64-of-bits (fp-pack ff64 (m-and sg (dq-isneg a)) (dq-mag sg a) uq0)) (sv-as-w v)
  _ → mr-map (λ x → case sg of
                 true → f64ofi64 (i64 (u64toWord x))
                 false → f64 (u64toWord x)) (sv-as-i v)
