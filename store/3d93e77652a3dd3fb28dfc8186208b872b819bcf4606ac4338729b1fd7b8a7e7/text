one-hot : (n : Nat) → SumFin n → Nat → SumFin n → Nat
one-hot n =
  case n return (λ m → SumFin m → Nat → SumFin m → Nat) of
    zero → λ v dy w → Empty-rec v
    suc m → λ v dy w →
      case v of
        inl u → (case w of inl u2 → dy; inr w2 → zero)
        inr v2 → (case w of inl u2 → zero; inr w2 → rec m v2 dy w2)
