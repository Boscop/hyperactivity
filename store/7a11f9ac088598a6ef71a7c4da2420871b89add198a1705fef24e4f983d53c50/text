-- Apply unnormalized H_tilde = [[1, 1], [1, -1]] on qubit q in {0,1,2}
q-apply-h : Word → QState3 → QState3
q-apply-h q (qs3 s0 s1 s2 s3 s4 s5 s6 s7) =
  if %weq q #0 then
    qs3 (z8-add s0 s1) (z8-sub s0 s1) (z8-add s2 s3) (z8-sub s2 s3)
        (z8-add s4 s5) (z8-sub s4 s5) (z8-add s6 s7) (z8-sub s6 s7)
  else if %weq q #1 then
    qs3 (z8-add s0 s2) (z8-add s1 s3) (z8-sub s0 s2) (z8-sub s1 s3)
        (z8-add s4 s6) (z8-add s5 s7) (z8-sub s4 s6) (z8-sub s5 s7)
  else
    qs3 (z8-add s0 s4) (z8-add s1 s5) (z8-add s2 s6) (z8-add s3 s7)
        (z8-sub s0 s4) (z8-sub s1 s5) (z8-sub s2 s6) (z8-sub s3 s7)
