-- ============================================================================
-- 1. Thiemann's Master Constraint: Universal SOS Positivity & Exact Kernel
-- ============================================================================
-- For a coupled 2-vertex Master Constraint M = g1 H1² + 2 c H1 H2 + g2 H2²
-- with positive-definite metric G (g1 > 0, det G = g1 g2 - c² > 0):
--   g1 · M = (g1 H1 + c H2)² + (g1 g2 - c²) H2².
-- Therefore M ≥ 0 universally, and M = 0 iff H1 = 0 and H2 = 0.
-- Variables (0..4): g1, g2, c, H1, H2.
lqg-master-sos-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
lqg-master-sos-poly A ad mu q vs =
  (λ g sub sq →
    let g1 = g 0; g2 = g 1; c = g 2; h1 = g 3; h2 = g 4
        q2 = q (fn-q 2 1)
        m  = ad (ad (mu g1 (sq h1)) (mu q2 (mu c (mu h1 h2)))) (mu g2 (sq h2))
        lhs = mu g1 m
        rhs = ad (sq (ad (mu g1 h1) (mu c h2)))
                 (mu (sub (mu g1 g2) (sq c)) (sq h2))
    in (lhs , rhs))
  (λ i → al-nth A (q (fn-q 0 1)) i vs) (al-gsub A ad mu q) (al-gsq A mu)
