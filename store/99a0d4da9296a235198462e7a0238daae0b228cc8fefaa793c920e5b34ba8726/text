-- EIP-55 mixed-case checksum formatting from 20-byte raw address:
eth-eip55-zip : List Word → List Word → List Word
eth-eip55-zip nil         hbs          = nil
eth-eip55-zip (cons c cs) nil          = cons c (eth-eip55-zip cs nil)
eth-eip55-zip (cons c cs) (cons h hbs) =
  let up = if andB (eth-le #97 c) (eth-le c #102)
           then (if eth-le #8 (eth-nib-val h) then %wsub c #32 else c)
           else c
  in cons up (eth-eip55-zip cs hbs)
