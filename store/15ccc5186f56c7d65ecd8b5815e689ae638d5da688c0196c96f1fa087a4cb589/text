bn-lem-lut3 _   _ (in-add _ _)      _ _ = refl
bn-lem-lut3 _   _ (in-xor _ _)      _ _ = refl
bn-lem-lut3 _   _ (in-era-l _ _)    _ _ = refl
bn-lem-lut3 _   _ (in-lut3 _ _ _ _) _ _ = refl
