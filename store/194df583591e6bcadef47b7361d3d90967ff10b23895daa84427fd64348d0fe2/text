-- lengths under a filter
tso-keep-le : {A : Type} → (p : A → Bool) → (ns : List A) → tso-len (tso-keep p ns) < suc (tso-len ns)
tso-keep-le p nil = unit
tso-keep-le p (cons y r) =
  (case p y return (λ b → tso-len (if b then cons y (tso-keep p r) else tso-keep p r) < suc (suc (tso-len r))) of
     true → tso-keep-le p r
     false → tso-lt-le (tso-len (tso-keep p r)) (suc (tso-len r)) (tso-keep-le p r))
