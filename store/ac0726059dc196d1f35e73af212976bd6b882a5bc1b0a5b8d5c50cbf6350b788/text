hcm-rc-init-code : List Word → Word × List Word
hcm-rc-init-code bs =
  let b0 = hcm-rc-head bs
      r1 = hcm-rc-tail bs
      b1 = hcm-rc-head r1
      r2 = hcm-rc-tail r1
      b2 = hcm-rc-head r2
      r3 = hcm-rc-tail r2
      b3 = hcm-rc-head r3
      r4 = hcm-rc-tail r3
  in (%wor (%wshl b0 #24) (%wor (%wshl b1 #16) (%wor (%wshl b2 #8) b3)) , r4)
