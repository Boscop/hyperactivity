cs-comp-brs-by : (Word → Word → Word) → Lst Code → (Word → Code → CsExp) → Word → Word → Word → CsExp
cs-comp-brs-by nf_of lnil cf dd d k = cs-br-nil
cs-comp-brs-by nf_of (lcons br r) cf dd d k =
  let nf = nf_of dd k
  in cs-br-cons k d nf (cf (%wadd d nf) (x-strip nf br)) (cs-comp-brs-by nf_of r cf dd d (%wsucc k))
