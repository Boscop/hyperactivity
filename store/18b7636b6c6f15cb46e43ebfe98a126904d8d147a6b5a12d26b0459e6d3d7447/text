cs-for-t2-dl : (d : Word) (tl : List Word) → cs-for-t2 d tl ≡ list-append (cs-for-t2 d nil) tl
cs-for-t2-dl d tl =
  let d0 = ce-dec d
      d1 = ce-dec (%wsucc d)
  in cs-dl-comp (list-append "; for (uint64_t v") (λ x → list-append d0 (list-append " = 0; v" (list-append d0 (list-append " < w" (list-append d0 (list-append "; v" (list-append d0 (list-append "++) { v" (list-append d1 (list-append " = " x))))))))))
       (cs-dl-lit "; for (uint64_t v")
       (cs-dl-comp (list-append d0) (λ x → list-append " = 0; v" (list-append d0 (list-append " < w" (list-append d0 (list-append "; v" (list-append d0 (list-append "++) { v" (list-append d1 (list-append " = " x)))))))))
         (cs-dl-lit d0)
         (cs-dl-comp (list-append " = 0; v") (λ x → list-append d0 (list-append " < w" (list-append d0 (list-append "; v" (list-append d0 (list-append "++) { v" (list-append d1 (list-append " = " x))))))))
           (cs-dl-lit " = 0; v")
           (cs-dl-comp (list-append d0) (λ x → list-append " < w" (list-append d0 (list-append "; v" (list-append d0 (list-append "++) { v" (list-append d1 (list-append " = " x)))))))
             (cs-dl-lit d0)
             (cs-dl-comp (list-append " < w") (λ x → list-append d0 (list-append "; v" (list-append d0 (list-append "++) { v" (list-append d1 (list-append " = " x))))))
               (cs-dl-lit " < w")
               (cs-dl-comp (list-append d0) (λ x → list-append "; v" (list-append d0 (list-append "++) { v" (list-append d1 (list-append " = " x)))))
                 (cs-dl-lit d0)
                 (cs-dl-comp (list-append "; v") (λ x → list-append d0 (list-append "++) { v" (list-append d1 (list-append " = " x))))
                   (cs-dl-lit "; v")
                   (cs-dl-comp (list-append d0) (λ x → list-append "++) { v" (list-append d1 (list-append " = " x)))
                     (cs-dl-lit d0)
                     (cs-dl-comp (list-append "++) { v") (λ x → list-append d1 (list-append " = " x))
                       (cs-dl-lit "++) { v")
                       (cs-dl-comp (list-append d1) (list-append " = ")
                         (cs-dl-lit d1) (cs-dl-lit " = ")))))))))) tl
