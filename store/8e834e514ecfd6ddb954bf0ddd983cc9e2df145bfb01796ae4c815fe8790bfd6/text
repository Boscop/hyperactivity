-- max(c, ts) ≤ max(d, us) for every value of the variables iff c ≤ d or c ≤ some offset of us,
-- and each a+o of ts has a+o' in us with o ≤ o'
lvl-le l m =
  case l of
    lvw → (case m of lvw → true; _ → false)
    lvl c ts → 
      case m of
        lvw → true
        lvl d us → 
          if orb (wle c d) (lany (λ q → wle c (snd q)) us)
            then lall (λ p → lany (λ q → andb (uconv (fst p) (fst q)) (wle (snd p) (snd q))) us) ts
            else false
