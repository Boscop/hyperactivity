sum-msgs : (n : Nat) → Bytes n → (count : Nat) → le (times count 16) n → Word
sum-msgs n b count h =
  (case count return (λ c → le (times c 16) n → Word) of
     zero → λ h → #0
     suc k → λ h → %wadd (i64toWord (load64 n b (times k 16) (bound-m (times k 16) n h))) (rec k (weaken-m (times k 16) n h)))
  h
