fa-t : (y c : Bool) → plus (bitn (bit-eq (bit-eq true y) c)) (times 2 (bitn (if y then true else c))) ≡ plus (bitn c) (plus (suc zero) (bitn y))
fa-t y c = case y return λ v → plus (bitn (bit-eq (bit-eq true v) c)) (times 2 (bitn (if v then true else c))) ≡ plus (bitn c) (plus (suc zero) (bitn v)) of
  true → fa-tt c
  false → fa-tf c
