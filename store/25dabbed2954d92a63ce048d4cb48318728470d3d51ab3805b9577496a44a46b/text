-- An Intrinsically Disordered Protein (IDP) has a non-unique solvent fiber:
-- two conformations c1, c2 in the same solvent fiber that are separated by an observable f.
IDPWitness : (C O V : Type 0) → (C → O) → O → (C → V) → Type 0
IDPWitness C O V obs y f =
  (c1 : FoldFib C O obs y) × (c2 : FoldFib C O obs y) × ((f (fst c1) ≡ f (fst c2)) → Empty)
