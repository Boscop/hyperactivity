-- integer promotion: a type of rank below int becomes int when int holds all its values, else
-- unsigned int; every other type is unchanged
ct-promote : Target → CTy → CTy
ct-promote t c = case wlt (ct-rank c) #3 of
  false → c
  true → (case c of
    ct-bool → ct-int
    _ → (case ct-fits-signed t c ct-int of
      true → ct-int
      false → ct-uint))
