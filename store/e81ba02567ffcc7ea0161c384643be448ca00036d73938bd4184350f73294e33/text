cl-map-fuse : (X Y W : Type) → (f : X → Y) → (g : Y → W) → (xs : List X) → ln-map Y W g (ln-map X Y f xs) ≡ ln-map X W (λ x → g (f x)) xs
cl-map-fuse X Y W f g xs = case xs return λ ys → ln-map Y W g (ln-map X Y f ys) ≡ ln-map X W (λ x → g (f x)) ys of
  nil → λ i → nil
  cons x rest → λ i → cons (g (f x)) (cl-map-fuse X Y W f g rest i)
