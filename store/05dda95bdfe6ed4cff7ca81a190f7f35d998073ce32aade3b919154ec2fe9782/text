-- the symbol from the halved a's and b's and the product D of the four Δ²: t runs from the largest a to the
-- smallest b; the value is (even part − odd part)·√D
sixj-from : Nat → Nat → Nat → Nat → Nat → Nat → Nat → QP → CG
sixj-from a1 a2 a3 a4 b1 b2 b3 D = sixj-close (sixj-sum (if leb (nat-max (nat-max a1 a2) (nat-max a3 a4)) (nat-min b1 (nat-min b2 b3)) then suc (monus (nat-min b1 (nat-min b2 b3)) (nat-max (nat-max a1 a2) (nat-max a3 a4))) else zero) a1 a2 a3 a4 b1 b2 b3 (nat-max (nat-max a1 a2) (nat-max a3 a4)) ((0 , 1) , (0 , 1))) D
