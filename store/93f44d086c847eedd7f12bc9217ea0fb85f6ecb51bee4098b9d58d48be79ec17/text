-- ---------------------------------------------------------------- 3. Full 3nm Shared-4-NAND2 → 2D-PnR → Binary-GDSII Signoff
-- Connects `alu-sum-rtl` (`~(~((0 | a) ^ b))`, 59 unoptimized NAND2 tree gates!) all the way to the
-- information-theoretic minimum 4-NAND2 shared netlist `xor4-shared-net` (14.75× physical gate cut!):
alu-to-xor4-sound : (a b : Bool) →
  net-eval (toNat #3) (toNat #2) nand-alg (env2-bool a b) xor4-shared-net unit ≡
  fold {B0} {B1} {B2} {Bool} {Bool} bool-alg (nand2-env a b) alu-sum-rtl
alu-to-xor4-sound false false = λ _ → false
alu-to-xor4-sound false true  = λ _ → true
alu-to-xor4-sound true  false = λ _ → true
alu-to-xor4-sound true  true  = λ _ → false
