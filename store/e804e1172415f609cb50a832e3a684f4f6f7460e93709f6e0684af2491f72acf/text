-- Semantic Preservation Theorem: chosen PPA-optimal design is guaranteed equal to `spec`!
best-in-fiber-sem : {C S : Type} → (sem : C → S) → (spec : S) → (cost : C → Nat) →
  (c0 : fiber sem spec) → (cs : List (fiber sem spec)) →
  sem (fst (best-in-fiber sem spec cost c0 cs)) ≡ spec
best-in-fiber-sem sem spec cost c0 cs = snd (best-in-fiber sem spec cost c0 cs)
