-- Template: clet
cs-let-template-sound : (k j : Nat) (fns : CsFns) (ars : Lst (Word × Word)) (hp hp1 : CsHeap) (env : CsEnv) (d : Word) (t b : Code) (vt : CsVal) →
  (cs-eval k fns hp env (cs-compile j ars d t) ≡ cs-ok hp1 vt) →
  cs-eval (suc k) fns hp env (cs-compile (suc j) ars d (clet t b))
  ≡ cs-eval k fns hp1 (cs-env-push d vt env) (cs-compile j ars (%wsucc d) b)
cs-let-template-sound k j fns ars hp hp1 env d t b vt ht =
  cong (λ r → cs-bind-res r (λ h2 v2 → cs-eval k fns h2 (cs-env-push d v2 env) (cs-compile j ars (%wsucc d) b))) ht
