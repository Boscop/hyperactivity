cm-append-assoc : {A : Type} → (xs ys zs : List A) → list-append (list-append xs ys) zs ≡ list-append xs (list-append ys zs)
cm-append-assoc {A} xs ys zs =
  case xs return (λ w → list-append (list-append w ys) zs ≡ list-append w (list-append ys zs)) of
    nil → λ i → list-append ys zs
    cons x r → λ i → cons x (rec r i)
