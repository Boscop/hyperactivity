bl-enc-neg-i24 : Word → List Word
bl-enc-neg-i24 mag =
  let u32 = %wsub #4294967296 mag
      b0  = %wand (%wshr u32 #24) #255
      b1  = %wand (%wshr u32 #16) #255
      b2  = %wand (%wshr u32 #8)  #255
      b3  = %wand u32 #255
  in list-append (bl-ff28 (toNat #28)) (cons b0 (cons b1 (cons b2 (cons b3 nil))))
