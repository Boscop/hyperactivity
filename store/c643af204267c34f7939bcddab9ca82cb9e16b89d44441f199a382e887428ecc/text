-- read right to left it is a rule of the specializer (#jit … using toNat-wadd): plus becomes wadd,
-- the machine's addition, along the path
toNat-wadd : (a b : Nat) → toNat (wadd (fromNat a) (fromNat b)) ≡ plus a b
toNat-wadd a b = concat (λ i → toNat (plusw≡wadd (fromNat a) (fromNat b) (~ i))) (toNat-plusw a b)
