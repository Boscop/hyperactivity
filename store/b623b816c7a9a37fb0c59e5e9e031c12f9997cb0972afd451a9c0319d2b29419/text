-- Exact Michaelis–Menten algebraic steady-state & enzyme conservation identity:
-- With total enzyme E0 = E + ES, Michaelis constant Km·k1 = km1 + kcat:
--   k1·E·S - (km1 + kcat)·ES = k1·E0·S - (k1·S + km1 + kcat)·ES.
-- At steady state (LHS = 0), this locks ES = k1·E0·S / (k1·S + km1 + kcat) = E0·S / (Km + S).
-- Variables (0..5): k1, km1, kcat, E0, ES, S.
enzyme-mm-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
enzyme-mm-poly A ad mu q vs =
  (λ g sub →
    let k1 = g 0; km1 = g 1; kcat = g 2; E0 = g 3; ES = g 4; S = g 5
        E = sub E0 ES
        lhs = sub (mu k1 (mu E S)) (mu (ad km1 kcat) ES)
        rhs = sub (mu k1 (mu E0 S)) (mu (ad (mu k1 S) (ad km1 kcat)) ES)
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
