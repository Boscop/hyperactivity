bw-ok-map : (A V W : Type) → (isz : A → Bool) → (f : V → V → A) → (t : W → V) → (ws : List W) → it-ok A V isz f (bw-map V W t ws) ≡ it-ok A W isz (λ x y → f (t x) (t y)) ws
bw-ok-map A V W isz f t ws = case ws return λ l → it-ok A V isz f (bw-map V W t l) ≡ it-ok A W isz (λ x y → f (t x) (t y)) l of
  nil → λ i → true
  cons u ur → λ i → if bw-allz-map A V W isz f t u ur i then (if isz (f (t u) (t u)) then false else bw-ok-map A V W isz f t ur i) else false
