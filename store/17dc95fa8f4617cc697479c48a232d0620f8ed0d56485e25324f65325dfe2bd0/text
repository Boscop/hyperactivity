-- Ishai–Sahai–Wagner (ISW) Masked Multiplication Gadget: computes `c0 ⊕ c1 = (a0 ⊕ a1) ∧ (b0 ⊕ b1)`
-- using fresh randomness `r` without EVER combining `a0` with `a1` or `b0` with `b1` on any wire!
isw-and : Bool → Bool → Bool → Bool → Bool → Bool × Bool
isw-and a0 a1 b0 b1 r =
  let c0 = r
      t1 = b-xor2 r (andB a0 b0)
      t2 = b-xor2 t1 (andB a0 b1)
      t3 = b-xor2 t2 (andB a1 b0)
      c1 = b-xor2 t3 (andB a1 b1)
  in (c0 , c1)
