-- the witness for q·M − p: the unit vectors made orthogonal over the rationals, then scaled to integers
zr-wit : (m : List (List BZ)) → BZ → BZ → List (sy-vn ZrC (cq-len m))
zr-wit m p q = ln-map (List BQ) (sy-vn ZrC (cq-len m)) (λ v → zr-tup (cq-len m) (zr-scl v)) (cq-gs (ln-mform (cq-n m p q)) (cq-up (cq-len m) zero (cq-len m)) nil)
