nk-trim-ev-nth : (b : NkTm) (e : NkEv) (j i : Word) →
  (nk-uses-var #0 (%wadd j i) b ≡ true) →
  nk-ev-nth (nk-trim-ev b j e) i ≡ nk-ev-nth e i
nk-trim-ev-nth b (nkev hd parts) j i hu = refl
nk-trim-ev-nth b nkev-nil j i hu = refl
nk-trim-ev-nth b (nkev-cons v r) j i hu =
  %welimP
    (λ x → (j0 : Word) → (nk-uses-var #0 (%wadd j0 x) b ≡ true) →
            nk-ev-nth (nk-trim-ev b j0 (nkev-cons v r)) x ≡ nk-ev-nth (nkev-cons v r) x)
    i
    (λ j0 hu0 →
       let uj = cong (λ z → nk-uses-var #0 z b) (plusw≡wadd j0 #0) ∙ hu0
       in cong (λ z → if z then v else nkev (hd-num #0) nkev-nil) uj)
    (λ m g j0 hum →
       let hum2 = cong (λ z → nk-uses-var #0 z b) (nk-wadd-suc-l j0 m) ∙ hum
       in nk-ev-nth-succ (if nk-uses-var #0 j0 b then v else nkev (hd-num #0) nkev-nil) (nk-trim-ev b (%wsucc j0) r) m
          ∙ (nk-trim-ev-nth b r (%wsucc j0) m hum2 ∙ sym (nk-ev-nth-succ v r m)))
    j hu
