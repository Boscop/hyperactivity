-- −h between states that differ exactly at two adjacent positions of one half
hb-off : Nat → Nat → List Nat → BZ
hb-off h k ps = case ps of
  nil → bz-zero
  cons i rest → (case rest of
    nil → bz-zero
    cons j r2 → (case r2 of
      nil → if eqb j (suc i) then (if eqb (suc i) k then bz-zero else in-negint h) else bz-zero
      cons x r3 → bz-zero))
