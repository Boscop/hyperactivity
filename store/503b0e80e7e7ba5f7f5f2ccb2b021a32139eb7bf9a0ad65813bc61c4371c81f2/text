-- a = 0: the hypotheses let-bound in order (an unused one bound to 0, not computed), then the body
-- with each outer variable o made its parameter. Inside the branch, before the lets: field j at
-- nf−1−j, the scrutinee at nf, parameter k of fv at nf+1+(m−1−k)
x-br-lets-from : Word → Lst Word → Word → Word → Word → Lst Bool → Code → Word → Code
x-br-lets-from g fv m nf nr recs inner r0 =
  %welimP (λ _ → Word → Code) (%wsub nr r0) (λ r → x-remap-val fv m nf nr inner)
    (λ j h r → clet (if %weq (x-count (%wsub (%wsub nr #1) r) inner) #0 then cwlit #0 else x-hyp-call g fv m nf r (x-recfield recs r #0) #0)
                    (h (%wsucc r))) r0
