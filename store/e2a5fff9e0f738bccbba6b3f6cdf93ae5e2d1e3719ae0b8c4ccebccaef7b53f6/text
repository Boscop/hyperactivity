fa-f : (y c : Bool) → plus (bitn (bit-eq (bit-eq false y) c)) (times 2 (bitn (if y then c else false))) ≡ plus (bitn c) (plus zero (bitn y))
fa-f y c = case y return λ v → plus (bitn (bit-eq (bit-eq false v) c)) (times 2 (bitn (if v then c else false))) ≡ plus (bitn c) (plus zero (bitn v)) of
  true → fa-tf c
  false → fa-ff c
