-- so one molecule, one list of motions, one instrument, two temperatures, two counts
cyh-temperature-decides : signals-at 18 cyh-motions cyh-h 30 nmr-achiral ≡ signals-at 18 cyh-motions cyh-h 19 nmr-achiral → Empty
cyh-temperature-decides q = transport (λ i → isTrue (eqb 1 ((concat (sym cyh-at-300) (concat q cyh-at-190)) i))) unit
