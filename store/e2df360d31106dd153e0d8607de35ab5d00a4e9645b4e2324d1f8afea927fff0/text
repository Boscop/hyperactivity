-- Hardware Face-Meet Soundness Theorem: O(1)-depth bitwise OR meet matches logical conjunction!
clause-meet-sound : (w : Nat) → (c1 c2 : ClauseVec w) → (rho : Vec Bool w) →
  clause-sat w (clause-meet w c1 c2) rho ≡ andB (clause-sat w c1 rho) (clause-sat w c2 rho)
clause-meet-sound zero c1 c2 rho = refl
clause-meet-sound (suc w) c1 c2 rho =
  let p1 = fst (fst c1); n1 = fst (snd c1)
      p2 = fst (fst c2); n2 = fst (snd c2)
      r0 = fst rho
      t1 : ClauseVec w
      t1 = (snd (fst c1) , snd (snd c1))
      t2 : ClauseVec w
      t2 = (snd (fst c2) , snd (snd c2))
      L1 = lit-sat p1 n1 r0; L2 = lit-sat p2 n2 r0
      R1 = clause-sat w t1 (snd rho); R2 = clause-sat w t2 (snd rho)
      ih = clause-meet-sound w t1 t2 (snd rho)
  in catB
       (andB (lit-sat (b-or2 p1 p2) (b-or2 n1 n2) r0) (clause-sat w (clause-meet w t1 t2) (snd rho)))
       (andB (andB L1 L2) (andB R1 R2))
       (andB (andB L1 R1) (andB L2 R2))
       (λ i → andB (lit-meet-law p1 n1 p2 n2 r0 i) (ih i))
       (andB-swap4 L1 L2 R1 R2)
