sc-4x3-step : (x : Nat) → hm-mul sc-n4 (hm-mul sc-n3 x) ≡ hm-mul sc-n3 (hm-mul sc-n4 x)
sc-4x3-step x =
  web-trans-n {hm-mul sc-n4 (hm-mul sc-n3 x)}
              {hm-add (hm-mul sc-n4 x) (hm-mul sc-n4 (hm-add x (hm-add x zero)))}
              {hm-mul sc-n3 (hm-mul sc-n4 x)}
              (sc-mul-add-r sc-n4 x (hm-add x (hm-add x zero)))
              (λ i → hm-add (hm-mul sc-n4 x) (sc-4x3-s2 x i))
