dnf-insert-r : (r : Word → Word) (h : MonoW r) (c : Conj) (f : DNF) → dnf-insert (conj-r r c) (dnf-r r f) ≡ dnf-r r (dnf-insert c f)
dnf-insert-r r h c lnil = λ i → lcons (conj-r r c) lnil
dnf-insert-r r h c (lcons d ds) =
  (λ i → if conj-lt-r r h c d i then lcons (conj-r r c) (lcons (conj-r r d) (dnf-r r ds)) else lcons (conj-r r d) (dnf-insert-r r h c ds i)) ∙
  sym (if-map DNF DNF (dnf-r r) (conj-lt c d) (lcons c (lcons d ds)) (lcons d (dnf-insert c ds)))
