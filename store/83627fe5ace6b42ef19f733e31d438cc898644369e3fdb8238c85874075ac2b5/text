-- If a local vertex rewrite f preserves the boundary-flux observation b : V → B
-- (i.e. ∀ v, b (f v) ≡ b v), then applying f at ANY vertex n of ANY multi-vertex
-- spin network Γ preserves the global boundary observation (lqg-map b Γ).
lqg-graph-rewrite-keeps-boundary :
  {V B : Type 0} → (b : V → B) → (f : V → V) →
  ((v : V) → b (f v) ≡ b v) →
  (n : Nat) → (g : List V) →
  lqg-map b (lqg-act-at n f g) ≡ lqg-map b g
lqg-graph-rewrite-keeps-boundary b f keeps zero nil = λ i → nil
lqg-graph-rewrite-keeps-boundary b f keeps (suc n) nil = λ i → nil
lqg-graph-rewrite-keeps-boundary b f keeps zero (cons v rest) =
  λ i → cons (keeps v i) (lqg-map b rest)
lqg-graph-rewrite-keeps-boundary b f keeps (suc n) (cons v rest) =
  λ i → cons (b v) (lqg-graph-rewrite-keeps-boundary b f keeps n rest i)
