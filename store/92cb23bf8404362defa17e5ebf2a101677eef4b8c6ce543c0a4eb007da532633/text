-- (part of language-support)
jcc_cmovcc_setcc_spec-case8 : MS Bool
jcc_cmovcc_setcc_spec-case8 =
  bindS {rflagsbits} {Bool} (getS {rflagsbits} x86-rflags) (λ rflags_var →
    λ σ →
      if (weq #0 (rflagsbits-cf rflags_var)) then
        the (MS Bool)
          (bindS {rflagsbits} {Bool} (getS {rflagsbits} x86-rflags) (λ rflags_var →
             retS {Bool} (weq #0 (rflagsbits-zf rflags_var)))) σ
      else
        the (MS Bool)
          (retS {Bool} false) σ)
