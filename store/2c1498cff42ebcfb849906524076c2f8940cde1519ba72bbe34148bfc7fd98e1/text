k-last-p : {o : Ord} → (k : El o) → (l : List (El o)) → k-LastP k l (k-last k l)
k-last-p k l =
  case l return λ w → k-LastP k w (k-last k w) of
    nil → unit
    cons x r → ifP {λ bb → k-LastP k (cons x r) (if bb then inl unit else k-comb x (k-last k r))} {leq k x}
                 (λ e → unit)
                 (λ e → k-comb-p k x r (k-last k r) (isTrue-not e) (rec r))
