npapp : (Γ₀ : CCtx) (a₀ : TyShape) (P₀ : Mean Γ₀ (TV (s-path a₀))) (p₀ : Code) (f₀ : DNF) →
    isTrue (dnf-canon f₀) → isTrue (dnf-nonconst f₀) →
    (Y₀ : Mean Γ₀ (TV a₀)) → PathM Γ₀ (TV a₀) (papp-mean Γ₀ a₀ f₀ P₀) Y₀ →
    NN (k-ne , (j-tm , Γ₀ , s-path a₀ , p₀ , P₀)) → NN (k-ne , (j-tm , Γ₀ , a₀ , cpapp p₀ (dnf-code f₀) , Y₀))
npapp Γ a P p f cf nc Y q np = by-rule r-papp t-ne (x-papp Γ a P p f cf nc Y q) unit (np , one)
