dm-cone-nodes : DmCone3 → Nat
dm-cone-nodes dc-var0        = zero
dm-cone-nodes dc-var1        = zero
dm-cone-nodes dc-var2        = zero
dm-cone-nodes (dc-not x)     = suc (dm-cone-nodes x)
dm-cone-nodes (dc-and x y)   = suc (plus (dm-cone-nodes x) (dm-cone-nodes y))
dm-cone-nodes (dc-or x y)    = suc (plus (dm-cone-nodes x) (dm-cone-nodes y))
dm-cone-nodes (dc-xor x y)   = suc (plus (dm-cone-nodes x) (dm-cone-nodes y))
dm-cone-nodes (dc-mux s x y) = suc (plus (dm-cone-nodes s) (plus (dm-cone-nodes x) (dm-cone-nodes y)))
dm-cone-nodes (dc-ulop3 _)   = suc zero
