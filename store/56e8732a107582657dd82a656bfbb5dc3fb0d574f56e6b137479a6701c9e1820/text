addZ-assoc-r : (a b c : Int) → addZ a (addZ b c) ≡ fromZ2 (plusw (fst (toZ2 a)) (zp b c) , plusw (snd (toZ2 a)) (zn b c))
addZ-assoc-r a b c =
  fromZ2-rel (plusw (fst (toZ2 a)) (fst (toZ2 (addZ b c)))) (plusw (snd (toZ2 a)) (snd (toZ2 (addZ b c))))
             (plusw (fst (toZ2 a)) (zp b c)) (plusw (snd (toZ2 a)) (zn b c))
    (plusw-interchange (fst (toZ2 a)) (fst (toZ2 (addZ b c))) (snd (toZ2 a)) (zn b c)
     ∙ (congw (λ z → plusw (plusw (fst (toZ2 a)) (snd (toZ2 a))) z) (toZ2-fromZ2-rel (zn b c) (zp b c))
        ∙ sym (plusw-interchange (fst (toZ2 a)) (zp b c) (snd (toZ2 a)) (snd (toZ2 (addZ b c))))))
