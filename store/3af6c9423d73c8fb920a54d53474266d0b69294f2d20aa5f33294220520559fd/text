-- 5-Layer Foundry Geometry (1 dbu = 1 nm; 400nm × 800nm cells, 200nm DRC spacing, 0..1000 × 0..1800nm die):
--   Layer 10/0: 4 placed 2D standard-cell active/gate bounding boxes (`xor4-placed-2d` × 100nm)
--   Layer 11/0: 3 horizontal 50nm M1 power rails spanning x = [0..1000nm] at y = 0..50, 950..1000, 1750..1800nm
--   Layer 12/0: Horizontal 50nm M1 signal trunk at y = 850..900nm (50nm DRC clearance from M1 rails & cells)
--   Layer 13/0: 2 Via12 square cuts (50nm × 50nm) at (200..250nm, 850..900nm) and (750..800nm, 850..900nm)
--   Layer 14/0: 2 vertical 50nm M2 pin drops connecting Cell(0,0) (200..250nm, 400..900nm) & Cell(1,1) (750..800nm, 850..1400nm)
hypercore-soc-gds6-boxes : List Gds6Box
hypercore-soc-gds6-boxes =
  list-append (map-rects-gbox6 #10 #0 #100 xor4-placed-2d)
  (list-append
    (cons (rect-to-gbox6 #11 #0 #50 (rect zero zero (toNat #20) (toNat #1)))
    (cons (rect-to-gbox6 #11 #0 #50 (rect zero (toNat #19) (toNat #20) (toNat #1)))
    (cons (rect-to-gbox6 #11 #0 #50 (rect zero (toNat #35) (toNat #20) (toNat #1))) nil)))
  (list-append
    (cons (rect-to-gbox6 #12 #0 #50 (rect (toNat #4) (toNat #17) (toNat #12) (toNat #1))) nil)
  (list-append
    (cons (rect-to-gbox6 #13 #0 #50 (rect (toNat #4) (toNat #17) (toNat #1) (toNat #1)))
    (cons (rect-to-gbox6 #13 #0 #50 (rect (toNat #15) (toNat #17) (toNat #1) (toNat #1))) nil))
    (cons (rect-to-gbox6 #14 #0 #50 (rect (toNat #4) (toNat #8) (toNat #1) (toNat #10)))
    (cons (rect-to-gbox6 #14 #0 #50 (rect (toNat #15) (toNat #17) (toNat #1) (toNat #11))) nil)))))
