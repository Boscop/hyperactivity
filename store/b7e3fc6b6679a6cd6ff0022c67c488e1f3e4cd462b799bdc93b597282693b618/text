index-update-neV : (A : Type) → (to : A → Int64) → (from : Int64 → A) → (n : Nat) → (a : Array n) → (i j : Nat) → (hi : le (suc i) n) → (hj : le (suc j) n) → (v : A) → Sum (le (suc i) j) (le (suc j) i) → indexV A from n (updateV A to n a i hi v) j hj ≡ indexV A from n a j hj
index-update-neV A to from n a i j hi hj v d =
  cong {lzero} {lzero} {Int64} {A} from {index n (update n a i hi (to v)) j hj} {index n a j hj} (index-update-ne n a i j hi hj (to v) d)
