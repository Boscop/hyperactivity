pull-move : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (c0 c1 : Cube n X) (p : PathP (λ i → Cube n X) c0 c1) (K0 : DCube n X Y c0) (K1 : DCube n X Y c1) (Kp : PathP (λ i → DCube n X Y (p i)) K0 K1)
  (E : DCube n X' F' (dcube-map n X Y X' f c0 K0)) →
  PathP (λ i → DCube n X F c1) (carry n X F c0 c1 p (dcube-pull n X X' Y F F' f g c0 K0 E))
    (dcube-pull n X X' Y F F' f g c1 K1 (carry n X' F' (dcube-map n X Y X' f c0 K0) (dcube-map n X Y X' f c1 K1) (λ i → dcube-map n X Y X' f (p i) (Kp i)) E))
pull-move n X X' Y F F' f g c0 c1 p K0 K1 Kp E =
  carry-uniq n X F c0 c1 p (dcube-pull n X X' Y F F' f g c0 K0 E)
    (dcube-pull n X X' Y F F' f g c1 K1 (carry n X' F' (dcube-map n X Y X' f c0 K0) (dcube-map n X Y X' f c1 K1) (λ i → dcube-map n X Y X' f (p i) (Kp i)) E))
    (λ i → dcube-pull n X X' Y F F' f g (p i) (Kp i)
       (carry-fill n X' F' (dcube-map n X Y X' f c0 K0) (dcube-map n X Y X' f c1 K1) (λ i → dcube-map n X Y X' f (p i) (Kp i)) E i))
