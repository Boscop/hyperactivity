sfin-eq-sound : (n : Nat) → (x y : SumFin n) → sfin-eq n x y ≡ true → x ≡ y
sfin-eq-sound n =
  case n return (λ k → (x y : SumFin k) → sfin-eq k x y ≡ true → x ≡ y) of
    zero → λ e y _ → Empty-rec e
    suc m → λ x →
      case x return (λ u → (v : SumFin (suc m)) → sfin-eq (suc m) u v ≡ true → u ≡ v) of
        inl u → λ v →
          case v return (λ w → sfin-eq (suc m) (inl u) w ≡ true → Path (SumFin (suc m)) (inl u) w) of
            inl u2 → λ _ → cong inl (opt-unit-eq u u2)
            inr y' → λ h → Empty-rec {lzero} {Path (SumFin (suc m)) (inl u) (inr y')} (opt-true-neq-false (sym h))
        inr x' → λ v →
          case v return (λ w → sfin-eq (suc m) (inr x') w ≡ true → Path (SumFin (suc m)) (inr x') w) of
            inl u2 → λ h → Empty-rec {lzero} {Path (SumFin (suc m)) (inr x') (inl u2)} (opt-true-neq-false (sym h))
            inr y' → λ h → cong inr (rec m x' y' h)
