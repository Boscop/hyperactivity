-- what followed each occurrence (at the positions), to its line's end, at most z bytes (240), read from a
-- forward and consed as read, so each comes reversed (it is turned round where it is shown): x above
-- holds whether the line has ended
m-rline-at : (s : Nat) → Bytes s → Word → Word × List Word → Word × List Word
m-rline-at s b x a = if orB (h-not (weq (fst a) #0)) (orB (h-not (wlt x (bytes-length s b))) (weq (cstr-get s b x) #10)) then (#1 , snd a)
  else (#0 , cons (cstr-get s b x) (snd a))
