-- ---------------------------------------------------------------- the order of integers
nle-add : (a b c d : Nat) → le a b → le c d → le (plus a c) (plus b d)
nle-add a b c d h k = (plus (fst h) (fst k) , transN (plus-mid4 (fst h) (fst k) a c) (cong2plus (plus (fst h) a) b (plus (fst k) c) d (snd h) (snd k)))
