-- the present's form of a word identified with a word of the context (keys and forms of the context's
-- words, in order), or the word as it is
c-carry : List (List Word) → List (List Word) → List Word → List Word
c-carry nil fs w = w
c-carry (cons k ks) nil w = w
c-carry (cons k ks) (cons f fs) w = if h-eq k (c-low w) then f else c-carry ks fs w
