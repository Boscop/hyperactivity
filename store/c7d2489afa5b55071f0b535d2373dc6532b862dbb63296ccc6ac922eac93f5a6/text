wcost-mc : WExpr → Word
wcost-mc (we-k _)       = #0
wcost-mc (we-v _)       = #0
wcost-mc (we-not a)     = wcost-mc a
wcost-mc (we-xor a b)   = %wadd (wcost-mc a) (wcost-mc b)
wcost-mc (we-and a b)   = %wadd #1 (%wadd (wcost-mc a) (wcost-mc b))
wcost-mc (we-or  a b)   = %wadd #1 (%wadd (wcost-mc a) (wcost-mc b))
wcost-mc (we-ch  e f g) = %wadd #2 (%wadd (wcost-mc e) (%wadd (wcost-mc f) (wcost-mc g)))
wcost-mc (we-maj a b c) = %wadd #3 (%wadd (wcost-mc a) (%wadd (wcost-mc b) (wcost-mc c)))
