-- the public server's answer: what the build made and kept is read and served as it is (s-kept-public): the
-- front page, every published work and its search item, the paper's page and search item; every other
-- address is answered as before, in full (s-answer)
s-public-answer : List Word → List Word → List Word → Proc W (List Word)
s-public-answer st m path =
  if orB (h-eq (h-before "?" path) "/") (h-null path) then s-kept-public st "front" else
  if h-eq (h-before "?" path) "/paper" then s-paper st m else
  if andB (h-prefix "/corpus/" path) (orB (h-eq (h-before "?" path) "/corpus/paper") (s-known (s-at-name (h-drop "/corpus" (h-before "?" path)) s-published))) then s-kept-public st (list-append "corpus-" (h-drop "/corpus/" (h-before "?" path))) else
  if s-known (s-at-name (h-before "?" path) s-published) then s-kept-public st (h-drop "/" (h-before "?" path)) else
  s-answer st m path
