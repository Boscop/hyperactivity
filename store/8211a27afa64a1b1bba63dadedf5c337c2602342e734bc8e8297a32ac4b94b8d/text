-- one bit of long division, whichever way the comparison went
div-step-v : (x : Bool) → (rest d q r : List Bool) → ((q2 r2 : List Bool) → bcanon r2 ≡ true → le (suc (bin-to-nat r2)) (bin-to-nat d) → div-post (msval rest (plus (times (bin-to-nat q2) (bin-to-nat d)) (bin-to-nat r2))) (bin-to-nat d) (bin-div-loop rest d q2 r2)) → bcanon r ≡ true → le (suc (bin-to-nat r)) (bin-to-nat d) → (v : Bool) → cmpN true (bin-to-nat d) (bin-to-nat (bin-cons x r)) ≡ v → div-post (msval (cons x rest) (plus (times (bin-to-nat q) (bin-to-nat d)) (bin-to-nat r))) (bin-to-nat d) (if v then bin-div-loop rest d (bin-cons true q) (bin-sub (bin-cons x r) d) else bin-div-loop rest d (bin-cons false q) (bin-cons x r))
div-step-v x rest d q r ih cr hr v = case v return λ u → cmpN true (bin-to-nat d) (bin-to-nat (bin-cons x r)) ≡ u → div-post (msval (cons x rest) (plus (times (bin-to-nat q) (bin-to-nat d)) (bin-to-nat r))) (bin-to-nat d) (if u then bin-div-loop rest d (bin-cons true q) (bin-sub (bin-cons x r) d) else bin-div-loop rest d (bin-cons false q) (bin-cons x r)) of
  true → λ e → div-step-t x rest d q r ih hr (cmp-true-le (bin-to-nat d) (bin-to-nat (bin-cons x r)) e)
  false → λ e → div-step-f x rest d q r ih cr (cmp-false-lt (bin-to-nat d) (bin-to-nat (bin-cons x r)) e)
