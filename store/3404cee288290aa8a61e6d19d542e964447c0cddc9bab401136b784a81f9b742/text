-- a body has a type: the type is a type (it is in some universe), and the checker run on the
-- body against it, normalized
nk-has : NkTm → NkTm → Bool
nk-has t ty = if nk-con-is (nk-ty (toNat #80) nk-nil #0 ty nk-nil) #2 then (if nk-failed (nk-ty (toNat #80) nk-nil #0 t (nk-norm ty)) then false else true) else false
