ct-ck : CTy → CK
ct-ck c = case c of
  ct-bool → ck-bool
  ct-char → ck-char
  ct-schar → ck-char
  ct-uchar → ck-char
  ct-short → ck-short
  ct-ushort → ck-short
  ct-int → ck-int
  ct-uint → ck-int
  ct-long → ck-long
  ct-ulong → ck-long
  ct-llong → ck-llong
  ct-ullong → ck-llong
  ct-int128 → ck-int128
  ct-uint128 → ck-int128
  ct-float → ck-float
  ct-double → ck-double
  ct-ptr → ck-ptr
