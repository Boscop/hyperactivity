ctx-key-at : Nat → List Word → Opt Word
ctx-key-at zero _ = some #0
ctx-key-at (suc zero) nil = none
ctx-key-at (suc zero) (cons a _) = some a
ctx-key-at (suc (suc zero)) nil = none
ctx-key-at (suc (suc zero)) (cons _ nil) = none
ctx-key-at (suc (suc zero)) (cons a (cons b _)) = some (ctx-pack2 a b)
ctx-key-at (suc (suc (suc zero))) nil = none
ctx-key-at (suc (suc (suc zero))) (cons _ nil) = none
ctx-key-at (suc (suc (suc zero))) (cons _ (cons _ nil)) = none
ctx-key-at (suc (suc (suc zero))) (cons a (cons b (cons c _))) = some (ctx-pack2 (ctx-pack2 a b) c)
ctx-key-at (suc (suc (suc (suc _)))) nil = none
ctx-key-at (suc (suc (suc (suc _)))) (cons _ nil) = none
ctx-key-at (suc (suc (suc (suc _)))) (cons _ (cons _ nil)) = none
ctx-key-at (suc (suc (suc (suc _)))) (cons _ (cons _ (cons _ nil))) = none
ctx-key-at (suc (suc (suc (suc _)))) (cons a (cons b (cons c (cons d _)))) = some (ctx-pack2 (ctx-pack2 (ctx-pack2 a b) c) d)
