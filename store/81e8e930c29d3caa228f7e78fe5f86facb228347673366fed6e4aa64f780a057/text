sub-form : (Δ Γ : CCtx) → Sub Δ Γ → DNF → Sub Δ (dext Γ)
sub-form Δ Γ σ g =
  ((fst σ , g) , fst (snd σ) ,
   pcat (Cube (dims (fst Δ)) (CtxV (fst Γ)))
     (cmap-cube (fst Δ) (lcons e-dim (fst Γ)) (fst σ , g) (CtxV (fst Γ)) (snd (dext Γ)))
     (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ)) (sub-base Δ Γ (fst (snd σ)))
     (pcat (Cube (dims (fst Δ)) (CtxV (fst Γ)))
        (cmap-cube (fst Δ) (lcons e-dim (fst Γ)) (fst σ , g) (CtxV (fst Γ)) (snd (dext Γ)))
        (papp-cube (fst Δ) (CtxV (fst Γ)) g (cube-map (dims (fst Δ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ)))
           (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ))))
        (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ))
        (λ i → papp-cube (fst Δ) (CtxV (fst Γ)) g (cmap-nat (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (snd Γ) i))
        (papp-deg (fst Δ) (CtxV (fst Γ)) g (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ))))
     (snd (snd σ)))
