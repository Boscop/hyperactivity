-- a definition's code as written (its globals kept as cglob), when it does not name itself: a
-- definition that does is its checked value (def-code), whose recursion the value already holds
src-of : Word → Opt Code
src-of g =
  case def-source g return (λ _ → Opt Code) of
    none → none
    some s → (if is-rec-body s then none else (if w-mem g (code-globals s) then none else some s))
