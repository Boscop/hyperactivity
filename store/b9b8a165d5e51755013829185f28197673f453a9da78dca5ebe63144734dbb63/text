app-eta : (Γ : CCtx) (a b : TyShape) (R : Mean Γ (AppV a b)) →
  PathM Γ (TV b) (retype Γ a (TV (s-fam f-pi a b)) (TV b) (app-ty a b) (app-w a b) (fmapM Γ (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) R)
                    (fmapM Γ (AppV a b) (TV a) (app-a a b) R) (app-coh Γ a b R))
    (fmapM Γ (AppV a b) (TV b) (app-r a b) R)
app-eta Γ a b R = retype-eta Γ a (TV (s-fam f-pi a b)) (TV b) (AppV a b) (app-ty a b) (app-w a b) (app-f a b) (λ q → snd (snd q)) R (app-coh Γ a b R)
