nk-upd-twice-at : (b : Bool) (sl : NkSlots) (w x : Word) (f1 f2 : NkSlot → NkSlot) → ((s : NkSlot) → f2 (f1 s) ≡ f1 (f2 s)) → (%weq w x ≡ b) → nk-get (nk-upd (nk-upd sl w f1) w f2) x ≡ nk-get (nk-upd (nk-upd sl w f2) w f1) x
nk-upd-twice-at true sl w x f1 f2 c p =
  cong (λ z → nk-get (nk-upd (nk-upd sl w f1) w f2) z) (sym (weq-sound w x p))
  ∙ (nk-get-set (nk-upd sl w f1) w (f2 (nk-get (nk-upd sl w f1) w))
  ∙ (cong f2 (nk-get-set sl w (f1 (nk-get sl w)))
  ∙ (c (nk-get sl w)
  ∙ (sym (cong f1 (nk-get-set sl w (f2 (nk-get sl w))))
  ∙ (sym (nk-get-set (nk-upd sl w f2) w (f1 (nk-get (nk-upd sl w f2) w)))
  ∙ cong (λ z → nk-get (nk-upd (nk-upd sl w f2) w f1) z) (weq-sound w x p))))))
nk-upd-twice-at false sl w x f1 f2 c p =
  nk-get-set-other (nk-upd sl w f1) w x (f2 (nk-get (nk-upd sl w f1) w)) p
  ∙ (nk-get-set-other sl w x (f1 (nk-get sl w)) p
  ∙ (sym (nk-get-set-other sl w x (f2 (nk-get sl w)) p)
  ∙ sym (nk-get-set-other (nk-upd sl w f2) w x (f1 (nk-get (nk-upd sl w f2) w)) p)))
