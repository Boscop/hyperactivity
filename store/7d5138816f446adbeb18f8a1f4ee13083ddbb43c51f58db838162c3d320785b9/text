s-public-passthrough : List Word → List Word → Bool
s-public-passthrough path p =
  orB (h-eq p "/robots.txt") (orB (h-eq p "/sitemap.xml") (
  orB (h-eq p "/privacy") (orB (h-eq p "/og.png") (
  orB (h-prefix "/favicon" path) (orB (h-eq p "/apple-touch-icon.png") (
  orB (h-prefix "/logo" path) (orB (h-prefix "/readme-" path) (
  orB (h-eq p "/supercomputer") (orB (h-eq p "/os") (orB (orB (h-eq p "/api/this/status") (h-eq p "/api/oracle/status")) (orB (h-prefix "/hx/" path) (
  orB (h-eq p "/synesthesia") (orB (h-eq p "/root") (h-prefix "/roots/" path))))))))))))))
