-- the two families' sizes add to the witness's
it-len2 : (V : Type) → (b : Bool) → (u : V) → (r1 r2 : List V) → (n : Nat) → plus (sy-len V r1) (sy-len V r2) ≡ n → plus (sy-len V (if b then cons u r1 else r1)) (sy-len V (if b then r2 else cons u r2)) ≡ suc n
it-len2 V b u r1 r2 n = case b return λ w → plus (sy-len V r1) (sy-len V r2) ≡ n → plus (sy-len V (if w then cons u r1 else r1)) (sy-len V (if w then r2 else cons u r2)) ≡ suc n of
  true → λ h → λ i → suc (h i)
  false → λ h → cl-tr Nat (plus (sy-len V r1) (suc (sy-len V r2))) (suc (plus (sy-len V r1) (sy-len V r2))) (suc n) (plus-suc (sy-len V r1) (sy-len V r2)) (λ i → suc (h i))
