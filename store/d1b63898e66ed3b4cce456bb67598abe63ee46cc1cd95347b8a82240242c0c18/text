-- an operation at wire u reads a held wire: by what is held; nothing held yet, nothing asked
nk-plan-read : NkSlot → NkOp → NkW → NkW → NkOut
nk-plan-read (nks-val v) o u n = nk-plan-of (nkf-put u (nks-pair o (nk-with v (nk-copy-env (nk-parts v) n))) (nk-copy-fx (nk-parts v) n)) (nk-adv n (nk-parts v))
nk-plan-read s o u n = nk-plan-of nkf-nil n
