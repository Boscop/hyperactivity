hcm-mix-pred : Word → Word → Word → Word → Word → Word → Word
hcm-mix-pred wp u1 u2 u4 u6 um =
  let w1 = %wand wp #4095
      w2 = %wand (%wshr wp #12) #4095
      w4 = %wand (%wshr wp #24) #4095
      w6 = %wand (%wshr wp #36) #4095
      wm = %wand (%wshr wp #48) #4095
      ps = %wadd (%wadd (hcm-pos-term w1 u1) (hcm-pos-term w2 u2)) (%wadd (hcm-pos-term w4 u4) (%wadd (hcm-pos-term w6 u6) (hcm-pos-term wm um)))
      ns = %wadd (%wadd (hcm-neg-term w1 u1) (hcm-neg-term w2 u2)) (%wadd (hcm-neg-term w4 u4) (%wadd (hcm-neg-term w6 u6) (hcm-neg-term wm um)))
  in hcm-squash ps ns
