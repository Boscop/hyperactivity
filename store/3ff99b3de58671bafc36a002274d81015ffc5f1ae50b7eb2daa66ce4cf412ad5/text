cs-hy-app : (CsHeap → CsEnv → CsExp → CsRes) → CsFns → CsHeap → CsVal → CsVal → CsRes
cs-hy-app ev fns hp clo vx =
  cs-bind-opt (cs-load hp clo zero) (λ vfn →
  cs-bind-word vfn (λ fn →
  cs-bind-opt (cs-load hp clo (suc zero)) (λ var →
  cs-bind-word var (λ ar →
  cs-bind-opt (cs-load hp clo (suc (suc zero))) (λ vn →
  cs-bind-word vn (λ n →
  cs-bind-opt (cs-read-range hp clo (suc (suc (suc zero))) (toNat n)) (λ held →
    let all = cs-snoc CsVal held vx
    in if %weq (%wadd n #1) ar
         then cs-call-fn ev fns hp fn all
         else cs-hy-clo hp fn ar (%wadd n #1) all)))))))
