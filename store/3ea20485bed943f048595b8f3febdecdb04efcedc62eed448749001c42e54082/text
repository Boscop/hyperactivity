wl-h2 : List Word → List Word
wl-h2 tail =
  hw-ln "    // [1] Quantum Proton Tunneling (4,096 barriers x 10,000 exact double-double Cayley SU(2) steps)"
  (hw-ln "    const uint32_t N1 = 4096u, NF = 65536u;"
  (hw-ln "    id<MTLBuffer> b1a = [dev newBufferWithLength:N1*4 options:MTLResourceStorageModeShared];"
  (hw-ln "    id<MTLBuffer> b1b = [dev newBufferWithLength:N1*4 options:MTLResourceStorageModeShared];"
  (hw-ln "    double t0 = now_ms();"
  (hw-ln "    id<MTLCommandBuffer> cb1 = [q commandBuffer]; id<MTLComputeCommandEncoder> e1 = [cb1 computeCommandEncoder];"
  (hw-ln "    [e1 setComputePipelineState:p1]; [e1 setBuffer:b1a offset:0 atIndex:0]; [e1 setBuffer:b1b offset:0 atIndex:1];"
  (hw-ln "    [e1 dispatchThreads:MTLSizeMake(N1,1,1) threadsPerThreadgroup:MTLSizeMake(64,1,1)]; [e1 endEncoding]; [cb1 commit]; [cb1 waitUntilCompleted];"
  (hw-ln "    double dt1 = now_ms() - t0;"
  (hw-ln "    float* p1a = (float*)b1a.contents; float* p1b = (float*)b1b.contents;"
  (hw-ln "    float max_p = 0.0f, max_dr = 0.0f;"
  (hw-ln "    for (uint32_t i = 0; i < N1; i++) { if (p1a[i]>max_p) max_p=p1a[i]; if (p1b[i]>max_dr) max_dr=p1b[i]; }"
  (hw-ln (list-append "    printf(" (list-append hw-q (list-append "[1] DNA Proton Tunneling (4096 x 10K Cayley SU(2) = 40.96M steps) | P_max=%.6f max_norm_drift=%.2e | %.2f ms (%.2f G-steps/s)" (list-append hw-esc-n (list-append hw-q ", max_p, max_dr, dt1, 40.96 / dt1);")))))
  (hw-ln "    // [2] Aspirin Esterification Wet-Lab Optimizer (65,536 flasks)"
  (hw-ln "    id<MTLBuffer> b2a = [dev newBufferWithLength:NF*4 options:MTLResourceStorageModeShared];"
  (hw-ln "    id<MTLBuffer> b2b = [dev newBufferWithLength:NF*4 options:MTLResourceStorageModeShared];"
  (hw-ln "    double t1 = now_ms();"
  (hw-ln "    id<MTLCommandBuffer> cb2 = [q commandBuffer]; id<MTLComputeCommandEncoder> e2 = [cb2 computeCommandEncoder];"
  (hw-ln "    [e2 setComputePipelineState:p2]; [e2 setBuffer:b2a offset:0 atIndex:0]; [e2 setBuffer:b2b offset:0 atIndex:1];"
  (hw-ln "    [e2 dispatchThreads:MTLSizeMake(NF,1,1) threadsPerThreadgroup:MTLSizeMake(256,1,1)]; [e2 endEncoding]; [cb2 commit]; [cb2 waitUntilCompleted];"
  (hw-ln "    double dt2 = now_ms() - t1;"
  (hw-ln "    float* p2a = (float*)b2a.contents; float* p2b = (float*)b2b.contents;"
  (hw-ln "    float best_asa = 0.0f, max_me2 = 0.0f; uint32_t best2 = 0;"
  (hw-ln "    for (uint32_t i = 0; i < NF; i++) { if (p2a[i]>best_asa){best_asa=p2a[i]; best2=i;} if (p2b[i]>max_me2) max_me2=p2b[i]; }"
  (hw-ln (list-append "    printf(" (list-append hw-q (list-append "[2] Aspirin Esterification (65,536 flasks) | best_yield=%.2f%% at T=%uK Ac2O=%.1feq | max_CHO_err=%.2e | %.2f ms (%.2f M-flasks/s)" (list-append hw-esc-n (list-append hw-q ", best_asa*100.0f, 300u+(best2&63u), 1.0f+0.1f*((best2>>6u)&31u), max_me2, dt2, (double)NF/(dt2*1e3));")))))
  tail))))))))))))))))))))))))
