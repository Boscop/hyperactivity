-- ── 3. Bidirectional Data <-> UX Transition (Data Responds to UX & Peers) ────
sw-step : SwarmEvent → SwarmState → SwarmState
sw-step (ev-mode m) (swarm-state ps cs _ st) =
  swarm-state ps cs (if sw-le m #3 then m else #3) st
sw-step (ev-peer p) (swarm-state ps cs m st) =
  swarm-state (cons p ps) cs m st
sw-step (ev-cert c) (swarm-state ps cs m st) =
  swarm-state ps (sw-merge-cert c cs) m st
sw-step (ev-steer msg) (swarm-state ps cs m _) =
  swarm-state ps cs m msg
