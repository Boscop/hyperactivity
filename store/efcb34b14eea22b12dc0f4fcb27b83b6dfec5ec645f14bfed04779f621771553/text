-- ---------------------------------------------------------------- 5. Hierarchical `AREF 2×2` 4-Tile Calma GDSII v6.0 Chip
-- Spatial Hyperfactoring in Calma GDSII v6.0:
--   • `HYPERNET_TILE`: 2000nm × 2000nm autonomous GALS tile containing:
--       Layer 10/0: 2 standard-cell logic rows (DNF Clause unit + ALU + Deque control)
--       Layer 15/0: Dual local SRAM macros (`CELL_HEAP_SRAM` + `VAR_VXCHG_SRAM`)
--       Layer 11/0: Local M1 VDD/VSS rails
--       Layer 12/0 & 14/0 + 13/0: Intra-tile M1/Via12/M2 crossbar trunks
--   • `HYPERNET_4TILE_SOC`: 5200nm × 5200nm top die instantiating all 4 tiles in ONE 58-byte
--       Calma GDSII `AREF` (`0x0B00`, `COLROW 2 × 2` at 2400nm × 2400nm pitch) + Layer 16/0 M3
--       horizontal Credit-NoC rings + Layer 17/0 M4 vertical Credit-NoC rings + die power ring!
gds6-str-begin : Word → List Word → List Word
gds6-str-begin strRecLen paddedName =
  sv-concat
    (cons (gds-u16s (cons #28 (cons gds-rec-bgnstr nil)))
    (cons gds-timestamp-bytes
    (cons (gds-u16s (cons strRecLen (cons #1542 nil)))
    (cons paddedName nil))))
