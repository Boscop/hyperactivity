po-emit-fprog-cfam : KTarget → List Word → F2Prog → List Word → List Word
po-emit-fprog-cfam t fname (f2prog nin lets outs) tail =
  hw-ln (list-append (po-fn-qual t) (list-append fname (list-append "("
        (list-append (po-params-go t (toNat nin) #0) (list-append (po-out-ptr t) ") {")))))
        (po-emit-flets t lets (po-emit-fouts t #0 outs (hw-ln "}" tail)))
