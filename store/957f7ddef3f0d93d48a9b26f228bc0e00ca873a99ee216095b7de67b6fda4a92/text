nk-emem-rp-step : (mr : Bool) (w : NkW) (aux parts : NkEnv) →
  (nk-emem w (nk-erev parts nke-nil) ≡ mr) → ((if mr then true else nk-emem w aux) ≡ true) →
  nk-emem w (nk-eapp aux parts) ≡ true
nk-emem-rp-step true w aux parts er hb =
  let hp = sym (nk-if-id (nk-emem w parts)) ∙ nk-emem-erev w parts nke-nil er
  in nk-emem-eapp-r w aux parts hp
nk-emem-rp-step false w aux parts er hb = nk-emem-eapp-l w aux parts hb
