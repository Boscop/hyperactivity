dnf-add-sound : (sk : Lst Entry) (c : Conj) (f : DNF) → IEq sk (dnf-ix (dnf-add c f)) (ixjoin (conj-ix c) (dnf-ix f))
dnf-add-sound sk c f =
  bool-case2 (λ b → IEq sk (dnf-ix (if b then f else dnf-insert c (dnf-drop-sup c f))) (ixjoin (conj-ix c) (dnf-ix f))) (dnf-any-sub c f)
    (λ e → dnf-any-sub-sound sk c f e)
    (λ e → ieq-trans sk (dnf-ix (dnf-insert c (dnf-drop-sup c f))) (ixjoin (conj-ix c) (dnf-ix (dnf-drop-sup c f))) (ixjoin (conj-ix c) (dnf-ix f))
      (dnf-insert-sound sk c (dnf-drop-sup c f)) (dnf-drop-sup-sound sk c f))
