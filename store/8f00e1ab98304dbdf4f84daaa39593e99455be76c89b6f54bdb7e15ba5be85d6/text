-- the floor: q·D ≤ n
fdiv-qr-sound : (pos : Bool) → (A D : Nat) → (qr : List Bool × List Bool) → div-post A D qr → bcanon (snd qr) ≡ true → zle (zmul (zv (bz-fdiv-qr pos qr)) (D , zero)) (if pos then (A , zero) else (zero , A))
fdiv-qr-sound pos A D qr post cr = case pos return λ u → zle (zmul (zv (bz-fdiv-qr u qr)) (D , zero)) (if u then (A , zero) else (zero , A)) of
  true → fdiv-pos (bin-to-nat (fst qr)) D (bin-to-nat (snd qr)) A (fst post)
  false → fneg-v A D qr post (bin-null (snd qr)) (symB (bin-null-sound (snd qr) cr))
