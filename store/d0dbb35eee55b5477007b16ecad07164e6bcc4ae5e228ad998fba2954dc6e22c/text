hs-main : List (List Word) → Step W Word
hs-main nil =
  hs-bench-one "XOR2" #102 #5
    (hs-bench-one "MUX2" #216 #5
      (hs-bench-one "EQ2" #153 #5
        (hs-bench-one "MAJ3_CARRY" #232 #5
          (sdone #0))))
hs-main (cons a _) =
  let tgt = cli-word a
  in hs-bench-one "CUSTOM" tgt #5 (sdone #0)
