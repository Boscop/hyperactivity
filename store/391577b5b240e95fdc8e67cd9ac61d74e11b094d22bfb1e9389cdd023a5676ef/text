-- popping deque (`src/net.c:3414`), with zero shared mutable state between lanes. Partitioning any
-- batch across arbitrary Metal SIMD groups / threadgroups preserves exact bit-level reduction order.
data GpuOp = gop-add | gop-sub | gop-mul | gop-and | gop-or | gop-xor | gop-shl | gop-shr | gop-eq | gop-lt
