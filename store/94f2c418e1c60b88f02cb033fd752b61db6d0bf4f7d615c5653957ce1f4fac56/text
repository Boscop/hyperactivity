ho-sieve-bytes : List Word
ho-sieve-bytes =
  let selSlot0 = h-take (toNat #4) (keccak256 "slot0()")
  in evm-assemble
       (ho-sieve-inst-concat
         (cons (ho-evm-erc20-bal bn-usdc-base20 ho-morpho20 #0)
         (cons (ho-evm-erc20-bal bn-weth-base20 ho-morpho20 #32)
         (cons (ho-evm-call4 ho-univ3-base20 selSlot0 #64 #32)
         (cons (ho-evm-call4 ho-slip-base20 selSlot0 #96 #32)
         (cons (cons (ev-push (eth-word-be-min #128))
               (cons (ev-push bn-empty-bytes)
               (cons (ev-op #243) nil))) nil))))))
