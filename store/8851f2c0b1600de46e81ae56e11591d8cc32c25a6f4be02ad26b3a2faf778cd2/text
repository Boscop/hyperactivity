-- where a side holds at the end, the result is that side's point alone, and nothing else is built
nk-tg-out : NkTm → NkTm → NkTm → NkTm → NkTm → NkTm → NkTm
nk-tg-out nk-nil aline sysb psi u0 a1 = nk-glue (nk-sys (nk-tg-ts aline sysb psi u0 a1 sysb)) (nk-hcomp (nk-app aline nk-i1) (nk-sys (nk-side psi (nk-lam (nk-up a1)) (nk-tg-alphas aline sysb psi u0 a1 sysb))) a1)
nk-tg-out b aline sysb psi u0 a1 = nk-p1 (nk-tg-pf aline sysb psi u0 a1 b)
