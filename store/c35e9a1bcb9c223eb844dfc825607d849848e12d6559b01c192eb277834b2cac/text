sg-push-ihs : Lst NkSexp → NkTm → Lst (List Word) → Word × Lst (List Word)
sg-push-ihs lnil _ env = (#0 , env)
sg-push-ihs (lcons f fr) (nk-cons (nk-num rflag) rr) env =
  if %weq rflag #1
    then (let p = sg-push-ihs fr rr (lcons (cons #114 (cons #58 (sg-sym-str f))) env) in (%wsucc (fst p) , snd p))
    else sg-push-ihs fr rr env
sg-push-ihs _ _ env = (#0 , env)
