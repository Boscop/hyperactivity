-- n halvings for level j with the count c, from the state (bracket, whether every point was read)
iq-bisect : (BZ → BZ → Nat × Bool) → Nat → Nat → ((BZ × BZ) × BZ) × Bool → ((BZ × BZ) × BZ) × Bool
iq-bisect c j n st = case n of
  zero → st
  suc n1 → iq-bisect c j n1 (iq-merge (iq-half c j (fst st)) (snd st))
