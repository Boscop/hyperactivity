cmap-in f d c =
  case c of
    clam b → clam (cmap f (%wsucc d) b)
    capp a b → capp (cmap f d a) (cmap f d b)
    cpair a b → cpair (cmap f d a) (cmap f d b)
    cfst p → cfst (cmap f d p)
    csnd p → csnd (cmap f d p)
    cpi m A B → cpi m (cmap f d A) (cmap f (%wsucc d) B)
    csigma A B → csigma (cmap f d A) (cmap f (%wsucc d) B)
    cuniv l → cuniv (cmap f d l)
    cpathp A a b → cpathp (cmap f d A) (cmap f d a) (cmap f d b)
    cplam b → cplam (cmap f (%wsucc d) b)
    cpapp p r → cpapp (cmap f d p) (cmap f d r)
    cneg r → cneg (cmap f d r)
    cmeet r s → cmeet (cmap f d r) (cmap f d s)
    cjoin r s → cjoin (cmap f d r) (cmap f d s)
    ceq0 r → ceq0 (cmap f d r)
    ceq1 r → ceq1 (cmap f d r)
    cfand a b → cfand (cmap f d a) (cmap f d b)
    cfor a b → cfor (cmap f d a) (cmap f d b)
    cforall b → cforall (cmap f (%wsucc d) b)
    csysc a t r → csysc (cmap f d a) (cmap f d t) (cmap f d r)
    ccomp A u a → ccomp (cmap f d A) (cmap f d u) (cmap f d a)
    cgluet A S → cgluet (cmap f d A) (cmap f d S)
    cglue S a → cglue (cmap f d S) (cmap f d a)
    cunglue S b → cunglue (cmap f d S) (cmap f d b)
    chcompu A S → chcompu (cmap f d A) (cmap f d S)
    cunglueu S b → cunglueu (cmap f d S) (cmap f d b)
    clet t b → clet (cmap f d t) (cmap f (%wsucc d) b)
    cann t T → cann (cmap f d t) (cmap f d T)
    cdata dd ps → cdata dd (cmap-l f d ps)
    ccon dd k fs ds → ccon dd k (cmap-l f d fs) (cmap-l f d ds)
    celim dd P B x → celim dd (cmap f d P) (cmap-l f d B) (cmap f d x)
    ccase dd B x → ccase dd (cmap-l f d B) (cmap f d x)
    chcomp u a → chcomp (cmap f d u) (cmap f d a)
    cdlam b → cdlam (cmap f (%wsucc d) b)
    cforce t → cforce (cmap f d t)
    cthunk t → cthunk (cmap f d t)
    clsuc l → clsuc (cmap f d l)
    clmax a b → clmax (cmap f d a) (cmap f d b)
    cpty k n → cpty k (cmap f d n)
    cwsucc a → cwsucc (cmap f d a)
    cwop k a b → cwop k (cmap f d a) (cmap f d b)
    cwelim w z s mo → cwelim (cmap f d w) (cmap f d z) (cmap f d s) (omap (cmap f d) mo)
    ctrans dd psi ls x → ctrans dd (cmap f d psi) (cmap-l f d ls) (cmap f d x)
    cproj dd k x → cproj dd k (cmap f d x)
    crec dd fs → crec dd (cmap-l f d fs)
    ctick k → ctick (cmap f d k)
    cprim k as → cprim k (cmap-l f d as)
    _ → c
