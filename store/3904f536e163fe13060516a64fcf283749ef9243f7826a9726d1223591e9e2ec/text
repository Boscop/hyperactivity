-- one kind of Φ(m,n), its four branches, scaled by s
hop-kind-one : SQ → List Triple → VM → Nat → Nat → Nat → List Nat → Rows → List Term
hop-kind-one s ts aP k n m dsP xs0 = terms-scale s (cons (hop-term ts aP k true n true m dsP xs0) (cons (hop-term ts aP k true n false m dsP xs0) (cons (hop-term ts aP k false n true m dsP xs0) (cons (hop-term ts aP k false n false m dsP xs0) nil))))
