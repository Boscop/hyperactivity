-- every rule: the operation and the value that met, and the first wire name the rule may use
nk-rule : NkOp → NkVal → Word → NkOut
nk-rule (nko-app arg out) v n = nk-rule-app arg out v n
nk-rule (nko-inc out) v n = nk-rule-inc out v n
nk-rule (nko-dup a b) v n = nk-rule-dup a b v (nk-parts v) n
nk-rule nko-era v n = nk-out (nk-era-env (nk-parts v) nkf-nil) n
nk-rule (nko-fwd out) v n = nk-out (nkf-val out v nkf-nil) n
nk-rule (nko-quote d out) v n = nk-rule-quote d out v n
nk-rule (nko-wrap k out) (nkv-q t) n = nk-out (nkf-val out (nkv-q (nk-wrap k t)) nkf-nil) n
nk-rule (nko-qapp qa out) (nkv-q t) n = nk-out (nkf-op qa (nko-wrap (nkr-app t) out) nkf-nil) n
nk-rule o v n = nk-out nkf-nil n
