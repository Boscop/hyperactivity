m-lines-go : Word → Word → List Word → List Word → List (List Word)
m-lines-go e i qs nil = nil
m-lines-go e i qs (cons c r) = case qs return (λ _ → List (List Word)) of
  nil → nil
  cons q rest → if weq i q then cons (m-upto #240 (m-skip e (cons c r))) (m-lines-go e (wadd i #1) rest r)
    else m-lines-go e (wadd i #1) (cons q rest) r
