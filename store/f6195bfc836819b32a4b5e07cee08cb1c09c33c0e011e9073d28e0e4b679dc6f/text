mterm-eq : MTerm → MTerm → Bool
mterm-eq mempty mempty = true
mterm-eq mempty (mlit _) = false
mterm-eq mempty (mref _) = false
mterm-eq mempty (mapp _ _) = false
mterm-eq mempty (mcat _ _) = false
mterm-eq (mlit _) mempty = false
mterm-eq (mlit a) (mlit b) = weq a b
mterm-eq (mlit _) (mref _) = false
mterm-eq (mlit _) (mapp _ _) = false
mterm-eq (mlit _) (mcat _ _) = false
mterm-eq (mref _) mempty = false
mterm-eq (mref _) (mlit _) = false
mterm-eq (mref k) (mref j) = weq k j
mterm-eq (mref _) (mapp _ _) = false
mterm-eq (mref _) (mcat _ _) = false
mterm-eq (mapp _ _) mempty = false
mterm-eq (mapp _ _) (mlit _) = false
mterm-eq (mapp _ _) (mref _) = false
mterm-eq (mapp t1 a1) (mapp t2 a2) = andB (weq t1 t2) (mterm-eq a1 a2)
mterm-eq (mapp _ _) (mcat _ _) = false
mterm-eq (mcat _ _) mempty = false
mterm-eq (mcat _ _) (mlit _) = false
mterm-eq (mcat _ _) (mref _) = false
mterm-eq (mcat _ _) (mapp _ _) = false
mterm-eq (mcat l1 r1) (mcat l2 r2) = andB (mterm-eq l1 l2) (mterm-eq r1 r2)
