-- resolve the pre-built cache file for a public GET route (empty when dynamic/uncached)
s-site-file : List Word → List Word → Proc W (List Word)
s-site-file st key = bind (h-read (list-append h-index "/meta/root")) (λ s →
  ret {lzero} {W} (list-append st (list-append "/site-" (list-append (h-hex (h-before " " (s-or nil s))) (list-append "-" key)))))
