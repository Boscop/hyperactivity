-- the lines joining i and j, and the lines leaving i (a line from i to itself joins nothing)
line-mult : Nat → Nat → List FaradayLine → Nat
line-mult i j ls = case ls of
  nil → zero
  cons l rest → (if eqb (fst l) i then (if eqb (snd l) j then suc (line-mult i j rest) else line-mult i j rest)
    else (if eqb (fst l) j then (if eqb (snd l) i then suc (line-mult i j rest) else line-mult i j rest) else line-mult i j rest))
