-- at doubled a b c, each of the four (e, f) = (c ± 1, b ± 1) that are spins
bsixj-agrees-at : Nat → Nat → Nat → Bool
bsixj-agrees-at a b c = both (both (amp-is (bsixj-half (bin-of-nat a) (bin-of-nat b) (bin-of-nat c) (bin-of-nat (suc c)) (bin-of-nat (suc b))) (sixj a b c 1 (suc c) (suc b)))
    (case b of
      zero → true
      suc b1 → amp-is (bsixj-half (bin-of-nat a) (bin-of-nat b) (bin-of-nat c) (bin-of-nat (suc c)) (bin-of-nat b1)) (sixj a b c 1 (suc c) b1)))
  (case c of
    zero → true
    suc c1 → both (amp-is (bsixj-half (bin-of-nat a) (bin-of-nat b) (bin-of-nat c) (bin-of-nat c1) (bin-of-nat (suc b))) (sixj a b c 1 c1 (suc b)))
      (case b of
        zero → true
        suc b1 → amp-is (bsixj-half (bin-of-nat a) (bin-of-nat b) (bin-of-nat c) (bin-of-nat c1) (bin-of-nat b1)) (sixj a b c 1 c1 b1)))
