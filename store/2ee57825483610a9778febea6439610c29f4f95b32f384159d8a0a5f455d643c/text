k-app-lt : {o : Ord} → (k x : El o) → (a r : List (El o)) → leq k x ≡ false → Sorted (list-append a (cons x r)) →
           k-last k (list-append a (cons x r)) ≡ k-comb x (k-last k r)
k-app-lt k x a r e =
  case a return λ w → Sorted (list-append w (cons x r)) → k-last k (list-append w (cons x r)) ≡ k-comb x (k-last k r) of
    nil → λ s i → if e i then inl unit else k-comb x (k-last k r)
    cons y q →
      λ s →
        let ey = k-lt-of-le k y x (allle-app-x y x q r (fst s)) e
        in tr (k-comb y (k-last k (list-append q (cons x r)))) (λ i → if ey i then inl unit else k-comb y (k-last k (list-append q (cons x r))))
             (tr (k-comb y (k-comb x (k-last k r))) (λ i → k-comb y (rec q (snd s) i)) (k-comb-comb y x (k-last k r)))
