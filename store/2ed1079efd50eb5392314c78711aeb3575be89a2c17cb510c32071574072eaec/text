s-item-at : List Word → Sum Unit (List Word)
s-item-at nil = inl unit
s-item-at (cons x r) = if andB (orB (weq x #45) (weq x #42)) (s-space-start r) then inr (h-trim r)
  else if andB (andB (wlt #47 x) (wlt x #58)) (h-prefix "." (s-digits r)) then (if s-space-start (h-drop "." (s-digits r)) then inr (h-trim (h-drop "." (s-digits r))) else inl unit) else inl unit
