-- Bump allocation never invalidates or mutates any previously allocated block (arena monotonicity)
cs-alloc-preserves-blk : (hp : CsHeap) (newblk blk : CsBlk) (addr idx : Nat) →
  (cs-nth CsBlk hp addr ≡ some blk) →
  cs-load (fst (cs-alloc hp newblk)) (csv-ptr addr) idx ≡ cs-nth CsVal blk idx
cs-alloc-preserves-blk hp newblk blk addr idx h =
  cong (λ o → case o return (λ _ → Opt CsVal) of none → none; some b → cs-nth CsVal b idx)
    (cs-nth-snoc-old CsBlk hp newblk addr blk h)
