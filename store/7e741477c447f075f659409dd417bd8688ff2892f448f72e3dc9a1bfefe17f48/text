-- UNIVERSAL THEOREM 1D (NEURAL-BIOELECTRIC-PHOTONIC ABIOGENESIS TRANSDUCTION CONSERVATION, 0 POSTULATES):
dm-thm-abiogenesis-ouroboros-conserved :
  (t : DmOuroTree) → dm-ouro-energy (dm-ouro-transduce t) ≡ dm-ouro-energy t
dm-thm-abiogenesis-ouroboros-conserved (ot-cell ph bio chem cell) =
  λ i → plus (dm-plus-comm bio ph i) (dm-plus-comm cell chem i)
dm-thm-abiogenesis-ouroboros-conserved (ot-branch l r) =
  λ i → plus (dm-thm-abiogenesis-ouroboros-conserved l i)
             (dm-thm-abiogenesis-ouroboros-conserved r i)
