a64-clo : Enc → Tbl → XEnv → Word → Word → Word → Lst Code → Lst Word
a64-clo ce tbl env d g a args =
  let n = l-count args
  in xcat6 (a64-push-all ce env d args)
           (a64-alloc-imm (xmul8 (%wadd n #3)))
           (l-app (a64-imm32 #9 (x-tbl tbl g)) (a64-str-idx #9 #0 #0))
           (l-app (a64-imm32 #9 a) (a64-str-idx #9 #0 #1))
           (l-app (a64-imm32 #9 n) (a64-str-idx #9 #0 #2))
           (a64-pop-clo-args n)
