-- (part of language-support)
rgfi_size : (nbytes : Bits #4) → (index' : Bits #4) → (rex : Bits #8) → MS (Bits #64)
rgfi_size nbytes index' rex =
  λ σ →
    if (weq nbytes #1) then
      the (MS (Bits #64))
        (bindS {Bits #8} {Bits #64} (rr08 index' rex) (λ t'1 →
           retS {Bits #64} (bv-zext #8 #64 t'1))) σ
    else if (weq nbytes #2) then
      the (MS (Bits #64))
        (bindS {Bits #16} {Bits #64} (rr16 index') (λ t'2 →
           retS {Bits #64} (bv-zext #16 #64 t'2))) σ
    else if (weq nbytes #4) then
      the (MS (Bits #64))
        (bindS {Bits #32} {Bits #64} (rr32 index') (λ t'3 →
           retS {Bits #64} (bv-zext #32 #64 t'3))) σ
    else if (weq nbytes #8) then
      the (MS (Bits #64))
        (rr64 index') σ
    else
      the (MS (Bits #64))
        (retS {Bits #64} #0) σ
