haar-unlift-list : List Word → List Word → List Word
haar-unlift-list nil _ = nil
haar-unlift-list (cons s nil) nil = cons (w32 s) nil
haar-unlift-list (cons s sr) (cons d dr) =
  let p = haar-unlift-pair (s , d)
  in cons (fst p) (cons (snd p) (haar-unlift-list sr dr))
haar-unlift-list (cons s sr) nil = cons (w32 s) (haar-unlift-list sr nil)
