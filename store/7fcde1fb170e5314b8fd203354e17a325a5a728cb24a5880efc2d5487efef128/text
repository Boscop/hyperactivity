k-node : {o : Ord} → (b : List (El o) → RTree (El o)) →
         ((l : List (El o)) → Sorted l → (k : El o) → k-pq k (b l) ≡ k-last k l) →
         (k : El o) → (l a : List (El o)) → (x : El o) → (r : List (El o)) → Sorted l → list-append a (cons x r) ≡ l →
         k-pq k (rnode (b a) (fromNat (list-length a)) x (b r)) ≡ k-last k l
k-node b ih k l a x r s ea =
  let s2 = subst {_} {_} {List (El o)} {λ w → Sorted {o} w} (sym ea) s
      sa = sorted-app-l {o} a (cons x r) s2
      sr = sorted-app-r {o} a (cons x r) s2
  in tr (k-last k (list-append a (cons x r)))
       (ifP {λ bb → (if bb then k-pq k (b a) else k-comb x (k-pq k (b r))) ≡ k-last k (list-append a (cons x r))} {leq k x}
          (λ e → tr (k-last k a) (ih a sa k) (sym (k-app-ge k x a r e)))
          (λ e → tr (k-comb x (k-last k r)) (λ i → k-comb x (ih r (snd sr) k i)) (sym (k-app-lt k x a r e s2))))
       (λ i → k-last k (ea i))
