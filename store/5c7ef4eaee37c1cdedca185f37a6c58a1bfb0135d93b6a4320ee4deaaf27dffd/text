-- Transition from probing (false) into active coupled co-processing (true), carrying the proof w : W
safe-activate : {Sp Sa : Sig} {W A : Type}
              → (w : W)
              → ▸ κ (RProc κ (SafeGateDS Sp Sa W) A true)
              → RProc κ (SafeGateDS Sp Sa W) A false
safe-activate w nextp = rcmd false (sg-activate w) (λ u → nextp)
