-- THE STATEMENT of compilation correctness, in general: for every program over the atomics,
-- each handler, a bound within which every schedule ends, and a domain holding every value
-- read on the machine: every outcome of the handled program on the TSO machine is an outcome
-- RC11 allows. No term of it is given here; its instances are in experiments/tso/rc11.cub
-- (as in lib/isa/tso.cub: AtomsX86Correct is stated and has no inhabitant;
-- experiments/tso/rc11.cub checks the inclusion only for four litmus programs at bounded
-- schedules, by computation.)
AtomsX86Correct : Handler AtomS TsoIS → Type
AtomsX86Correct hd =
  (ths : List AtomThread) → (dom : List Word) → (n : Nat) →
  isTrue (tso-every n (rc-x86 hd ths) (λ out s → rc-reads-in dom (ts-log s))) →
  isTrue (rc-subset (tso-sum-outs (tso-outcomes n (rc-x86 hd ths))) (tso-ax-outs (rc11-outcomes (λ a → #0) dom ths)))
