-- 2-cell cubical curvature Δ_xy on List (List (Bounded B)): row Δ_x composed with column Δ_y (two-sided Equiv!)
zip-mdiff : (B : Word) → List (Bounded B) → List (Bounded B) → List (Bounded B)
zip-mdiff B nil xs = xs
zip-mdiff B (cons p ps) nil = nil
zip-mdiff B (cons p ps) (cons x xs) =
  cons (mdiff-val B (fst p) (fst x) , mdiff-lt B (fst p) (fst x) (snd p) (snd x)) (zip-mdiff B ps xs)
