-- ---------------------------------------------------------------- 1. Standard-Cell Netlist-to-Row Extraction
list-append-len : {A : Type} → (xs ys : List A) →
  list-length (list-append xs ys) ≡ plus (list-length xs) (list-length ys)
list-append-len nil ys = λ _ → list-length ys
list-append-len (cons x xs) ys = λ i → suc (list-append-len xs ys i)
