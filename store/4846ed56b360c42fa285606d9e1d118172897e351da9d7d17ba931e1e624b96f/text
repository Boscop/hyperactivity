s-mod-file : List Word → List Word → List Word → Proc W (List Word)
s-mod-file st kind path =
  bind (h-pointer "lib/server.hypercubical") (λ sp →
  bind (h-pointer path) (λ mp →
  ret {lzero} {W} (list-append st (list-append "/mod-" (list-append kind (list-append "-" (list-append (h-take (toNat #16) sp) (list-append "-" (list-append (h-take (toNat #16) mp) (list-append "-" (h-hex path)))))))))))
