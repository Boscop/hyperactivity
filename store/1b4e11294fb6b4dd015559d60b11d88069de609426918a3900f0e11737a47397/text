-- (part of language-support)
jcc_cmovcc_setcc_spec-case7 : MS Bool
jcc_cmovcc_setcc_spec-case7 =
  bindS {rflagsbits} {Bool} (getS {rflagsbits} x86-rflags) (λ rflags_var →
    λ σ →
      if (weq #1 (rflagsbits-cf rflags_var)) then
        the (MS Bool)
          (retS {Bool} true) σ
      else
        the (MS Bool)
          (bindS {rflagsbits} {Bool} (getS {rflagsbits} x86-rflags) (λ rflags_var →
             retS {Bool} (weq #1 (rflagsbits-zf rflags_var)))) σ)
