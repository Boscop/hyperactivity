hy-hw-pieces : List Word → Proc W (List (List Word))
hy-hw-pieces path = bind (h-read (list-append h-index (list-append "/modules/" (h-hex path)))) (λ k →
  bind (h-read (list-append h-source (cons #47 (list-append (hy-st-first (h-lines (hy-or nil k))) "/module")))) (λ ps →
  ret (h-msort (hy-hw-tail (h-lines (hy-or nil ps))))))
