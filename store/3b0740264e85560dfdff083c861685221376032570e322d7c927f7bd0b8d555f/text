hs-solve-main : List (List Word) → Step W Word
hs-solve-main args =
  let p  = hs-pref args
      mf = list-append p ".metal"
      hf = list-append p "_host.m"
      uf = list-append p "_h100.cu"
  in scmd w-now (λ t0 →
     scmd (w-file-write-named mf hs-metal-src) (λ bm →
     scmd (w-file-write-named hf (hs-host-src mf)) (λ bh →
     scmd (w-file-write-named uf hs-cuda-src) (λ bu →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-SOLVE (V,D:uint4,L:XOR,Q:AND) Fiber4096=1 FA-LQ=1 DiagSAT=1 Metal="
       (list-append (ce-dec bm)
       (list-append "B Host=" (list-append (ce-dec bh)
       (list-append "B H100-CUDA=" (list-append (ce-dec bu)
       (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))))
       (sdone #0))))))
