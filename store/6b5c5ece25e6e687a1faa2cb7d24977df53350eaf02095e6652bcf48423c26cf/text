lit-lt-irr : (l : Lit) → lit-lt l l ≡ false
lit-lt-irr l =
  bool-case0 (λ b → lit-lt l l ≡ b → lit-lt l l ≡ false) (lit-lt l l)
    (λ e h → lit-lt-cases (lit-lt l l ≡ false) l l
       (λ w → bool-absurd (lit-lt l l ≡ false) (wlt (fst l) (fst l)) w (wlt-irr (fst l)))
       (λ p s t → bool-absurd (lit-lt l l ≡ false) (snd l) t s) h)
    (λ e h → h) (λ i → lit-lt l l)
