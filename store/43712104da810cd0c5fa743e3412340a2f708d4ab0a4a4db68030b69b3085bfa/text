-- Corollary (`poly-unobserved-min-unreachable`):
-- Any thermodynamic minimum c_therm lying outside B_kin (InBasin c_therm → Empty)
-- is provably unreachable from any seed in B_kin along ANY k-step trapped history.
poly-unobserved-min-unreachable :
  (C : Type 0) → (step : C → C → Bool) → (InBasin : C → Type 0) →
  KineticTrap C step InBasin →
  (k : Nat) → (seed c-therm : C) → InBasin seed → (InBasin c-therm → Empty) →
  HistN C step k seed c-therm → Empty
poly-unobserved-min-unreachable C step InBasin trap k seed c-therm hseed hout hist =
  hout (poly-kinetic-trapping C step InBasin trap k seed c-therm hist hseed)
