-- Zero-Python `FROM scratch` Dockerfile (packages bare-metal ELF64 + SM_90a PTX + static cubical):
bn-dockerfile-scratch : List Word
bn-dockerfile-scratch =
  bn-lines
    (cons "# Emitted by lib/hx-brainnet-iac.hypercubical — ZERO Runtime Bloat (FROM scratch + Bare ELF64/PTX)"
    (cons "FROM alpine:3.20 AS hx-forge"
    (cons "RUN apk add --no-cache clang musl-dev make"
    (cons "WORKDIR /hx"
    (cons "COPY . ."
    (cons "RUN make CC=clang LDFLAGS='-static' build/cubical"
    (cons ""
    (cons "FROM scratch"
    (cons "COPY --from=hx-forge /hx/build/cubical /cubical"
    (cons "COPY --from=hx-forge /hx/store /store"
    (cons "COPY brainnet_worker_x86_64 /brainnet_worker_x86_64"
    (cons "COPY brainnet_hopper_sm90a_lop3.ptx /brainnet_hopper_sm90a_lop3.ptx"
    (cons "EXPOSE 10000"
    (cons (list-append "ENTRYPOINT ["
          (list-append bn-q (list-append "/cubical" (list-append bn-q (list-append ", "
          (list-append bn-q (list-append "lib/hx-brainnet-iac.hypercubical"
          (list-append bn-q "]")))))))) nil))))))))))))))
