-- the same for integers scaled by S ≥ 1
zle-cancel-scale : (x y : Nat × Nat) → (S : Nat) → zle (zsc x S) (zsc y S) → le (suc zero) S → zle x y
zle-cancel-scale x y S h hs = le-cancel-mul (plus (fst x) (snd y)) (plus (fst y) (snd x)) S
  (le-cong-r (times (plus (fst x) (snd y)) S) (plus (times (fst y) S) (times (snd x) S)) (times (plus (fst y) (snd x)) S)
    (le-cong-l (plus (times (fst x) S) (times (snd y) S)) (times (plus (fst x) (snd y)) S) (plus (times (fst y) S) (times (snd x) S))
      h (symN (times-distr (fst x) (snd y) S)))
    (symN (times-distr (fst y) (snd x) S)))
  hs
