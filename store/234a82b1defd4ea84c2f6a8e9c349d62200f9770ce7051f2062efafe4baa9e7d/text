-- ---------------------------------------------------------------- 2. reshaping guarded processes
-- a clocked guarded process indexed by its current interface state i : ds-idx D
data RProc (κ : Clock) (D : DynSig) (A : Type) : (i : ds-idx D) → Type where
  rret : (i : ds-idx D) → A → RProc κ D A i
  rcmd : (i : ds-idx D) → (c : Cmd (ds-sig D i))
       → ((r : Resp (ds-sig D i) c) → ▸ κ (RProc κ D A (ds-next D i c r)))
       → RProc κ D A i
  rtau : (i : ds-idx D) → ▸ κ (RProc κ D A i) → RProc κ D A i
