-- x + 2(QD + R) = (2Q + 1)D + R1 when T = x + 2R and R1 + D = T
div-alg-t : (x Q D R T R1 : Nat) → T ≡ plus x (times 2 R) → plus R1 D ≡ T → plus x (times 2 (plus (times Q D) R)) ≡ plus (times (suc (times 2 Q)) D) R1
div-alg-t x Q D R T R1 h hs =
  transN (div-alg-f x Q D R T h)
  (transN (congN (plus (times (times 2 Q) D)) (symN hs))
  (transN (congN (plus (times (times 2 Q) D)) (plus-comm R1 D))
  (transN (plus-comm-mid (times (times 2 Q) D) D R1)
  (symN (plus-assoc D (times (times 2 Q) D) R1)))))
