-- THEOREM 5: HYPERCUBE ALLREDUCE HOPS (d) <= RING/NODE COUNT (2^d) FOR ALL d : Nat
sc-thm-hc-beats-ring : (d : Nat) → hm-le d (sc-pow2 d) ≡ true
sc-thm-hc-beats-ring zero    = refl
sc-thm-hc-beats-ring (suc d) =
  sc-le-add-mono (suc zero) (sc-pow2 d) d (sc-pow2 d) (sc-pow2-pos d) (sc-thm-hc-beats-ring d)
