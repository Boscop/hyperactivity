-- π² = 18 Σ_{k≥1} w_k, w_1 = 1/2, w_{k+1} = w_k·k²/(2(k+1)(2k+1)); after n terms: (18·sum, 18·(sum + 4/3·w_{n+1}))
hq-pis : Nat → Nat → BQ → BQ → BQ × BQ
hq-pis n k w acc = case n of
  zero → (bq-mul (fn-q 18 1) acc , bq-mul (fn-q 18 1) (bq-add acc (bq-mul (fn-q 4 3) w)))
  suc m → hq-pis m (suc k) (bq-mul w (fn-q (times k k) (times 2 (times (suc k) (suc (times 2 k)))))) (bq-add acc w)
