pair-unit-with : List Nat → List Nat → List Nat → List Nat → List Nat → SQ → (List Nat → List Nat → SQ) → (List Nat → List Nat → SQ) → (List Nat → List Nat → SQ) → (List Nat → List Nat → SQ) → Rows
pair-unit-with ds ds3 ds4 ds5 ds6 w eent3 fent eent rent = mat-scale w (lm-head (lr-head (b2 (suc zero) (suc zero) ds ds3 ds4 ds5 ds6 nil nil fent eent rent (coords-all (inv-free ds3) (vmap eent3 ds3 ds (inv-basis ds))))))
