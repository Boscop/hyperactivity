-- ============================================================================
-- 3. Two-Site Hubbard Singlet–Triplet Antiferromagnetic Superexchange
-- ============================================================================
-- In the 2-site half-filled Hubbard model, the singlet subspace Hamiltonian is
--   H_S = [[0, -2t], [-2t, U]],  det(λ I - H_S) = λ(λ - U) - 4 t².
-- Exact completing-the-square identity:
--   4 · det(λ I - H_S) = (2λ - U)² - (U² + 16 t²).
-- Since U² + 16 t² > U² for t ≠ 0, the lower root λ_S = (U - √(U²+16t²))/2 < 0 = E_triplet,
-- proving exact antiferromagnetic singlet stabilization (superexchange J ≈ 4t²/U).
-- Variables (0..2): λ, U, t.
phys-hubbard-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
phys-hubbard-poly A ad mu q vs =
  (λ g sub sq →
    let ev = g 0; uh = g 1; t = g 2
        q2 = q (fn-q 2 1)
        q4 = q (fn-q 4 1)
        q16 = q (fn-q 16 1)
        detH = sub (mu ev (sub ev uh)) (mu q4 (sq t))
        lhs = mu q4 detH
        rhs = sub (sq (sub (mu q2 ev) uh)) (ad (sq uh) (mu q16 (sq t)))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
