-- Step-indexed mutual-recursion / global-table call simulation (0-arg and 1-arg saturated calls)
cs-sim-call0 : (k : Nat) (fns : CsFns) (hp : CsHeap) (cenv : CsEnv) (fn : Word) (om : CsOptM) →
  (cs-sim-ok om (cs-call-fn (cs-eval k fns) fns hp fn lnil) ≡ true) →
  cs-sim-ok om (cs-eval (suc k) fns hp cenv (cse-call fn cse-args-nil)) ≡ true
cs-sim-call0 k fns hp cenv fn om hfn = hfn
