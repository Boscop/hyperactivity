-- Framing-susceptible decision maker (chooses `true` in gain frame, `false` in loss frame)
-- cannot factor through content alone.
framing-susceptible-no-factor : {C : Type} → (c0 : C) →
  Neg ((g : C → Bool) × ((s : Bool × C) → fst s ≡ g (snd s)))
framing-susceptible-no-factor c0 fac =
  true≢false (concat (snd fac (true , c0)) (sym (snd fac (false , c0))))
