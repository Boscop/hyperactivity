-- nk-do-swap-ok: two plans commute when each two of their changes are on different wires, or on
-- one wire and commute (part of machine-in-hyperactive)
nk-do-swap-ok : (fx1 fx2 : NkFx) (sl : NkSlots) → nk-oks fx1 fx2 → nk-same (nk-do fx2 (nk-do fx1 sl)) (nk-do fx1 (nk-do fx2 sl))
nk-do-swap-ok nkf-nil fx2 sl ap x = refl
nk-do-swap-ok (nkf-at w c r) fx2 sl ap x =
  nk-do-swap-ok r fx2 (nk-upd sl w (nk-ch c)) (snd ap) x
  ∙ nk-do-same r (nk-do fx2 (nk-upd sl w (nk-ch c))) (nk-upd (nk-do fx2 sl) w (nk-ch c)) (nk-do-upd-ok fx2 sl w (nk-ch c) (fst ap)) x
