dm-query-hl-mids : Proc W (Word × (Word × Word))
dm-query-hl-mids =
  let req = h-concat (cons "{" (cons (h-quote "type") (cons ":" (cons (h-quote "allMids") (cons "}" nil)))))
  in bind (dm-http-post-json "https://api.hyperliquid.xyz/info" req) (λ resp →
     ret {lzero} {W}
       ( dm-hl-extract-mid "BTC" resp
       , (dm-hl-extract-mid "ETH" resp , dm-hl-extract-mid "SOL" resp)))
