DDgOps : (I : Lst Entry → Type 2) (Ln : (sq : Lst Entry) → I sq → I sq) (K : (sq : Lst Entry) → I sq → Type 1)
  (pd : (sq : Lst Entry) → I (lcons e-dim sq) → I sq) (pt : (s : TyShape) (sq : Lst Entry) → I (lcons (e-ty s) sq) → I sq) (O : DgOps I Ln K pd pt)
  (J : (sq : Lst Entry) → I sq → Type 2) (LnJ : (sq : Lst Entry) (iq : I sq) → J sq iq → J sq (Ln sq iq))
  (pdJ : (sq : Lst Entry) (iq : I (lcons e-dim sq)) → J (lcons e-dim sq) iq → J sq (pd sq iq))
  (ptJ : (s : TyShape) (sq : Lst Entry) (iq : I (lcons (e-ty s) sq)) → J (lcons (e-ty s) sq) iq → J sq (pt s sq iq))
  (D : (sq : Lst Entry) (iq : I sq) → J sq iq → K sq iq → Type 1) → Type 2
DDgOps I Ln K pd pt O J LnJ pdJ ptJ D =
  (dnil0 : (iq : I lnil) (jq : J lnil iq) (xq : K lnil (Ln lnil iq)) → D lnil (Ln lnil iq) (LnJ lnil iq jq) xq → D lnil iq jq (fst O iq xq)) ×
  (dty0 : (s : TyShape) (sq : Lst Entry) (iq : I (lcons (e-ty s) sq)) (jq : J (lcons (e-ty s) sq) iq) (xq : K (lcons (e-ty s) sq) (Ln (lcons (e-ty s) sq) iq)) →
     D (lcons (e-ty s) sq) (Ln (lcons (e-ty s) sq) iq) (LnJ (lcons (e-ty s) sq) iq jq) xq → D (lcons (e-ty s) sq) iq jq (fst (snd O) s sq iq xq)) ×
  (dtyd : (s : TyShape) (sq : Lst Entry) (iq : I (lcons (e-ty s) sq)) (jq : J (lcons (e-ty s) sq) iq) (xq : K (lcons (e-ty s) sq) (Ln (lcons (e-ty s) sq) iq)) →
     D (lcons (e-ty s) sq) (Ln (lcons (e-ty s) sq) iq) (LnJ (lcons (e-ty s) sq) iq jq) xq → D sq (Ln sq (pt s sq iq)) (LnJ sq (pt s sq iq) (ptJ s sq iq jq)) (fst (snd (snd O)) s sq iq xq)) ×
  (dtyu : (s : TyShape) (sq : Lst Entry) (iq : I (lcons (e-ty s) sq)) (jq : J (lcons (e-ty s) sq) iq) (yq : K sq (pt s sq iq)) →
     D sq (pt s sq iq) (ptJ s sq iq jq) yq → D (lcons (e-ty s) sq) iq jq (fst (snd (snd (snd O))) s sq iq yq)) ×
  (ddm0 : (sq : Lst Entry) (iq : I (lcons e-dim sq)) (jq : J (lcons e-dim sq) iq) (xq : K (lcons e-dim sq) (Ln (lcons e-dim sq) iq)) →
     D (lcons e-dim sq) (Ln (lcons e-dim sq) iq) (LnJ (lcons e-dim sq) iq jq) xq → D (lcons e-dim sq) iq jq (fst (snd (snd (snd (snd O)))) sq iq xq)) ×
  (ddmd : (sq : Lst Entry) (iq : I (lcons e-dim sq)) (jq : J (lcons e-dim sq) iq) (xq : K (lcons e-dim sq) (Ln (lcons e-dim sq) iq)) →
     D (lcons e-dim sq) (Ln (lcons e-dim sq) iq) (LnJ (lcons e-dim sq) iq jq) xq → D sq (Ln sq (pd sq iq)) (LnJ sq (pd sq iq) (pdJ sq iq jq)) (fst (snd (snd (snd (snd (snd O))))) sq iq xq)) ×
  ((sq : Lst Entry) (iq : I (lcons e-dim sq)) (jq : J (lcons e-dim sq) iq) (yq : K sq (pd sq iq)) →
     D sq (pd sq iq) (pdJ sq iq jq) yq → D (lcons e-dim sq) iq jq (snd (snd (snd (snd (snd (snd O))))) sq iq yq))
