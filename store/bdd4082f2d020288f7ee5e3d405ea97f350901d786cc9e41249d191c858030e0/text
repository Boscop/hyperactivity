-- floor, negative with a remainder: −(Q+1)·D ≤ −A
fdiv-neg-rem : (k Q D R A : Nat) → plus k (suc R) ≡ D → A ≡ plus (times Q D) R → le (plus (times (suc Q) zero) A) (times (suc Q) D)
fdiv-neg-rem k Q D R A h hA = (suc k , transN (congN (λ z → plus (suc k) (plus z A)) (times-zero (suc Q))) (div-up-alg k R Q D A h hA))
