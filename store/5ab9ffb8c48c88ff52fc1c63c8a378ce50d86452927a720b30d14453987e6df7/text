-- a work's index made, written to a scratch file, read back and checked (si-made-ok-t); only checked bytes
-- are kept, so whatever is kept checked
sx-make-one : List Word → Work → Proc W Unit
sx-make-one st (work n k p) = bind (h-pointer p) (λ mh → bind (h-read (sx-file mh)) (sx-absent (bind (s-work-text (work n k p)) (λ t →
  bind (ret {lzero} {W} (tokenize (sx-lower t))) (λ T → bind (ret {lzero} {W} (suffix-array-fast T)) (λ sa → bind (ret {lzero} {W} (si-tree-of sa)) (λ tr →
  bind (ret {lzero} {W} (si-make-t T tr (wadd (si-o0 T) (si-recs-size T)))) (λ L →
  bind (h-write (list-append st (list-append "/search-scratch-" n)) L) (λ w → bind (h-read (list-append st (list-append "/search-scratch-" n))) (λ rb →
  bind (h-unlink (list-append st (list-append "/search-scratch-" n))) (λ u →
  if si-made-ok-t T tr (list-length (s-or nil rb)) (text-bytes (s-or nil rb)) then bind (h-write (sx-file mh) (s-or nil rb)) (λ w2 → h-out (h-line (list-append "search: indexed " n)))
  else h-out (h-line (list-append "search: the index does not check, not kept: " n)))))))))))))
