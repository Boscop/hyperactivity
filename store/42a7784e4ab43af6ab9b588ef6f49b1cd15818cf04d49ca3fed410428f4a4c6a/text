-- a budget: a world transformer refusing every command once n have been answered (a timeout as
-- a world, which is how a process that runs forever is observed to a bound)
budget : {S : Sig} {St : Type} → World S St → World S (Nat × St)
budget {S} {St} w c st =
  case fst st of
    zero → inr st
    suc n → (case w c (snd st) of inl r → inl (fst r , (n , snd r)); inr s2 → inr (fst st , s2))
