rk-report : Word → List (List Word) → Proc W Unit
rk-report t0 ts =
  bind (h-out (h-line (list-append "tokens: " (h-decimal (fromNat (list-length ts)))))) (λ u →
  bind time-now (λ t1 →
  bind (h-out (h-line (list-append "read and tokenized: " (rk-ms t0 t1)))) (λ u1 →
  bind (ret (ranks-of {suffix-ord} (sufs ts))) (λ rr →
  bind (h-out (h-line (list-append "rank checksum: " (h-decimal (rk-sum rr))))) (λ u2 →
  bind time-now (λ t2 →
  bind (h-out (h-line (list-append "ranks (merge-sorted key tree): " (rk-ms t1 t2)))) (λ u3 →
  bind (ret (kasai-by ts rr)) (λ ks →
  bind (h-out (h-line (list-append "positions in a repeat (a common prefix with the predecessor): " (h-decimal (rk-nonzero ks))))) (λ u4 →
  bind (h-out (h-line (list-append "sum of Kasai's common prefixes: " (h-decimal (rk-lsum ks))))) (λ u5 →
  bind time-now (λ t3 →
  bind (h-out (h-line (list-append "Kasai's LCP (predecessor by rank, carried bound): " (rk-ms t2 t3)))) (λ u6 →
  bind (h-out (h-line (list-append "sum of the same pairs' common prefixes compared from the start: " (h-decimal (rk-psum ks))))) (λ u7 →
  bind time-now (λ t4 →
  bind (h-out (h-line (list-append "pairwise LCP of the same pairs: " (rk-ms t3 t4)))) (λ u8 → exit #0)))))))))))))))
