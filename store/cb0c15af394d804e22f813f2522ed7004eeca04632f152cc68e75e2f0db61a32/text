(function () {
  var USD_RE = /\\\$(?=\S)|\$(?=\d{1,3}(?:,\d{3})+(?:\.\d+)?(?![\w+=*^\\<>$])|\d+(?:\.\d+)?(?:\s*[\u2013\u2014-]\s*\$?\d+(?:\.\d+)?)?(?:(?:[kmbt]|[bm]n)(?![\w+=*^\\<>\/])|[\u2013\u2014-]\s*\$|\.(?=\s|$|[)\]",;])|[;)\]]|\/[a-z]{2,}\b|\s+(?:a\b|[a-z]{2,}\b)))/gi;
  var SKIP = 'script,style,code,pre,textarea,noscript,svg';
  function run() {
    if (typeof renderMathInElement !== 'function') return;
    var w = document.createTreeWalker(document.body, 4);
    var nodes = [], n;
    while ((n = w.nextNode())) {
      var p = n.parentElement;
      if (p && !p.closest(SKIP) && n.nodeValue.indexOf('$') >= 0 && USD_RE.test(n.nodeValue)) {
        USD_RE.lastIndex = 0;
        nodes.push(n);
      }
    }
    for (var k = 0; k < nodes.length; k++) {
      var t = nodes[k], s = t.nodeValue, frag = document.createDocumentFragment(), i = 0, m;
      USD_RE.lastIndex = 0;
      while ((m = USD_RE.exec(s))) {
        if (m.index > i) frag.appendChild(document.createTextNode(s.slice(i, m.index)));
        var u = document.createElement('span');
        u.className = 'hx-usd';
        u.textContent = '$';
        frag.appendChild(u);
        i = m.index + m[0].length;
      }
      if (i < s.length) frag.appendChild(document.createTextNode(s.slice(i)));
      t.parentNode.replaceChild(frag, t);
    }
    renderMathInElement(document.body, {
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '\\[', right: '\\]', display: true },
        { left: '\\(', right: '\\)', display: false },
        { left: '$', right: '$', display: false }
      ],
      ignoredClasses: ['hx-usd'],
      throwOnError: false
    });
  }
  if (typeof renderMathInElement === 'function') run();
  else window.addEventListener('load', run);
})();
