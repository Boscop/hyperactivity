mundiff-lt : (B p d : Word) → wlt p B ≡ true → wlt d B ≡ true → wlt (mundiff-val B p d) B ≡ true
mundiff-lt B p d hp hd =
  ifP {λ b → wlt (if b then wadd p d else wsub (wadd p d) B) B ≡ true} {wlt (wadd p d) B}
    (λ e → e)
    (λ e → cm-lt-le-trans (wsub (wadd p d) B) p B (mundiff-sub-lt-p B p d hd e) (cm-lt-asym p B hp))
