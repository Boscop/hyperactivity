-- UNIVERSAL THEOREM 3A (NO ALGORITHMICALLY-OBSERVABLE INFORMATION BEYOND BEHAVIOR, 0 POSTULATES):
--   By cubical function extensionality, any algorithm `adv` observing the extensional projection
--   of two implementations `p0, p1` on the same semantic fiber (`∀ x, p0 x ≡ p1 x`) produces
--   identically equal observations `adv p0 ≡ adv p1`!
dm-thm-blackbox-no-extra-info :
  {A B Obs : Type} → (adv : (A → B) → Obs) → (p0 p1 : A → B) →
  ((x : A) → p0 x ≡ p1 x) → adv p0 ≡ adv p1
dm-thm-blackbox-no-extra-info adv p0 p1 eq = λ i → adv (λ x → eq x i)
