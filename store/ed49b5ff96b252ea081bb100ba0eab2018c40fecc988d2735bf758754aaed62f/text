sbb_af_spec8 dst' src cf' =
  let dst_3_0 : Bits #4
      dst_3_0 = (bv-slice #8 dst' #3 #0)
      src_3_0 : Bits #4
      src_3_0 = (bv-slice #8 src #3 #0)
