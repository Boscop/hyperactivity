-- 1. Mechanical ISO C11 Emitter (from superoptimized `kir-opt` AST!)
kir-fn-c : List Word → WExpr → List Word → List Word
kir-fn-c name e tail =
  hw-ln (list-append "static inline uint32_t " (list-append name (list-append "(uint32_t x0, uint32_t x1, uint32_t x2) { return "
        (list-append (kir-emit-expr "0u" "0xFFFFFFFFu" (kir-opt e)) "; }")))) tail
