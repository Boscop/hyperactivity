hxt-main : List (List Word) → Step W Word
hxt-main args =
  let n = hxt-arg1 args
      b = hxt-arg2 args
  in scmd w-now (λ t0 →
     let fout = hxt-flash-n n
     in scmd w-now (λ t1 →
        let rev = hxt-rev-bwd b (rpair #11 #17)
            ok  = case fst (snd rev) of
                    rpair u v → %weq u v
        in scmd w-now (λ t2 →
           cli-say (list-append "Flash1Pass N=" (list-append (ce-dec n) (list-append " out=" (list-append (ce-dec fout)
             (list-append " (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000000))
             (list-append " ms) | ZeroTape layers=" (list-append (ce-dec (%wmul b #12))
             (list-append (if ok then " EXACT grad=" else " FAIL grad=") (list-append (ce-dec (fst rev))
             (list-append " (" (list-append (ce-dec (%wdiv (%wsub t2 t1) #1000000)) " ms)"))))))))))))
             (sdone (if ok then #0 else #1)))))
