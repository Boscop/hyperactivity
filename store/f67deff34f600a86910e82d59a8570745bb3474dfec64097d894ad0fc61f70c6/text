trace-thm-assoc (cons x xs) b c = λ i → cons x (trace-thm-assoc xs b c i)

-- THEOREM 6 (RIGHT IDENTITY OF ETERNAL TRACE):
trace-thm-nil-r : (a : Trace) → trace-append a nil ≡ a
trace-thm-nil-r nil = refl
trace-thm-nil-r (cons x xs) = λ i → cons x (trace-thm-nil-r xs i)

