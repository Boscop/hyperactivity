record SynModalityKnot (A : Type) (B : Type) =
  { sm-fwd : A → B
  ; sm-bwd : B → A
  ; sm-ret : (a : A) → sm-bwd (sm-fwd a) ≡ a
  ; sm-sec : (b : B) → sm-fwd (sm-bwd b) ≡ b
  }

sm-id : (A : Type) → SynModalityKnot A A
sm-id A = SynModalityKnot
  { sm-fwd = λ a → a
  ; sm-bwd = λ a → a
  ; sm-ret = λ a → refl
  ; sm-sec = λ a → refl
  }

sm-dual : {A B : Type} → SynModalityKnot A B → SynModalityKnot B A
sm-dual k = SynModalityKnot
  { sm-fwd = sm-bwd k
  ; sm-bwd = sm-fwd k
  ; sm-ret = sm-sec k
  ; sm-sec = sm-ret k
  }

sm-path-trans : {A : Type} → {x y z : A} → x ≡ y → y ≡ z → x ≡ z
sm-path-trans {A} {x} {y} {z} p q =
  λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)

sm-path-cong : {A B : Type} → (f : A → B) → {x y : A} → x ≡ y → f x ≡ f y
sm-path-cong f p = λ i → f (p i)

-- THEOREM 1 (CONSTRUCTIVE CLOSURE OF SYNTHETIC SYNESTHESIA):
-- Composing 1D visual symbols <-> 1D acoustic wave <-> KV/memory concept state preserves
-- exact unitary invertibility across arbitrary sensory-motor loops!
sm-compose : {A B C : Type} → SynModalityKnot A B → SynModalityKnot B C → SynModalityKnot A C
sm-compose k1 k2 = SynModalityKnot
  { sm-fwd = λ a → sm-fwd k2 (sm-fwd k1 a)
  ; sm-bwd = λ c → sm-bwd k1 (sm-bwd k2 c)
  ; sm-ret = λ a → sm-path-trans (sm-path-cong (sm-bwd k1) (sm-ret k2 (sm-fwd k1 a))) (sm-ret k1 a)
  ; sm-sec = λ c → sm-path-trans (sm-path-cong (sm-fwd k2) (sm-sec k1 (sm-bwd k2 c))) (sm-sec k2 c)
  }

-- THEOREM 2 (MEMORY <-> PERCEPTION DUALITY IS AN EXACT INVOLUTION):
sm-thm-dual-involutive : {A B : Type} → (k : SynModalityKnot A B) → sm-dual (sm-dual k) ≡ k
sm-thm-dual-involutive k = refl

-- THEOREM 3 (REWRITING LOOP ASSOCIATIVITY — RECURSIVE RECOMPACTION INVARIANCE):
sm-thm-loop-assoc : {A B C D : Type} →
  (k1 : SynModalityKnot A B) → (k2 : SynModalityKnot B C) → (k3 : SynModalityKnot C D) → (a : A) →
