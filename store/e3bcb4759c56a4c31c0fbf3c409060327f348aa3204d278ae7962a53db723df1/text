-- a path type's meaning from its line and its ends: two retypes
tp-W : (Γ : CCtx) (a : TyShape) (Lm : Mean Γ (Line (Sem a))) (M0 : Mean Γ (TV a)) →
  PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) M0) (fmapM Γ (Line (Sem a)) (Sem a) (λ l → fst l) Lm) → Mean Γ (LnE a)
tp-W Γ a Lm M0 q0 = retype Γ a (Line (Sem a)) (LnE a) (λ l → fst l) (λ l v → (l , v)) Lm M0 q0
