-- 3D Isotropic Harmonic Oscillator shell N (N = 0, 1, 2, ...):
--   Orbital degeneracy = (N + 1)(N + 2) / 2
--   Spin-1/2 nucleon degeneracy = (N + 1)(N + 2)   (exact, no division needed!)
-- Mayer-Jensen Spin-Orbit Coupling (1949 Nobel Prize):
--   For N >= 3, the highest-j subshell j = N + 1/2 (capacity 2j + 1 = 2N + 2)
--   drops down in energy into shell (N - 1), creating the EXACT magic closures:
--     N=0:  2
--     N=1:  2  +  6           =   8
--     N=2:  8  + 12           =  20
--     N=3: 20  +  8 (1f_7/2)  =  28
--     N=4: 28  + (20-8) + 10  =  50  (rest of N=3 + 1g_9/2 intruder)
--     N=5: 50  + (30-10)+ 12  =  82  (rest of N=4 + 1h_11/2 intruder)
--     N=6: 82  + (42-12)+ 14  = 126  (rest of N=5 + 1i_13/2 intruder)
--     N=7: 126 + (56-14)+ 16  = 184  (rest of N=6 + 1j_15/2 intruder -> Island of Stability!)

npn-ho-deg : Word → Word
npn-ho-deg n = %wmul (%wadd n #1) (%wadd n #2)

npn-intruder : Word → Word
npn-intruder n = %wadd (%wmul #2 n) #2

-- Exact shell capacity of nuclear major shell k (k = 0..7) derived purely from HO + Spin-Orbit:
npn-shell-cap : Word → Word
npn-shell-cap k =
  if %wlt k #3 then npn-ho-deg k
  else if %weq k #3 then npn-intruder #3
  else
    -- k >= 4: remaining states of HO shell (k-1) + spin-orbit intruder from HO shell k!
    let prev = %wsub k #1
    in %wadd (%wsub (npn-ho-deg prev) (npn-intruder prev)) (npn-intruder k)

npn-magic-sum : Nat → Word → Word
npn-magic-sum zero _ = #0
npn-magic-sum (suc rem) k = %wadd (npn-shell-cap k) (npn-magic-sum rem (%wadd k #1))

npn-magic : Word → Word
npn-magic idx = npn-magic-sum (toNat (%wadd idx #1)) #0

