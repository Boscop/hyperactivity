-- Exact Magic Number Membership Predicate (for doubly-magic nucleus certification!)
npn-is-magic : Word → Bool
npn-is-magic m =
  orB (%weq m (npn-magic #0))
  (orB (%weq m (npn-magic #1))
  (orB (%weq m (npn-magic #2))
  (orB (%weq m (npn-magic #3))
  (orB (%weq m (npn-magic #4))
  (orB (%weq m (npn-magic #5))
  (orB (%weq m (npn-magic #6))
       (%weq m (npn-magic #7))))))))

npn-is-doubly-magic : Word → Word → Bool
npn-is-doubly-magic z n = andB (npn-is-magic z) (npn-is-magic n)

