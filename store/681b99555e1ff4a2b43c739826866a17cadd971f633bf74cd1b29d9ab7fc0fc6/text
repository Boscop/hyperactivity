-- ============================================================================
-- SECTION 2: SYMMETRIC MONOIDAL NUCLEAR REACTION CATEGORY (`NucCat`)
-- ============================================================================
-- Every nuclear/particle state carries exact conserved quantum numbers:
--   (A = Baryon number, Q_shift = Electric charge + 100, Le = Electron lepton + 100, Lmu = Muon lepton + 100)
-- Every nuclear/exotic-atom reaction morphism carries a dependent conservation proof by `refl`!

record NucVec =
  { nv-a   : Word -- Baryon number A (exact non-negative integer)
  ; nv-q   : Word -- Electric charge Q (exact integer offset? No: pure additive when balanced!)
  ; nv-pos : Word -- Positron / anti-electron count (net Q = Z - e- + e+ via separate positive/negative!)
  ; nv-neg : Word -- Electron / muon negative charge count
  ; nv-le  : Word -- Net electron-flavor (e- + nu_e)
  ; nv-ale : Word -- Anti-electron-flavor (e+ + anti-nu_e)
  ; nv-mu  : Word -- Muon count (catalyst conservation!)
  }

nv-add : NucVec → NucVec → NucVec
nv-add x y = NucVec
  { nv-a   = %wadd (nv-a x) (nv-a y)
  ; nv-q   = %wadd (nv-q x) (nv-q y)
  ; nv-pos = %wadd (nv-pos x) (nv-pos y)
  ; nv-neg = %wadd (nv-neg x) (nv-neg y)
  ; nv-le  = %wadd (nv-le x) (nv-le y)
  ; nv-ale = %wadd (nv-ale x) (nv-ale y)
  ; nv-mu  = %wadd (nv-mu x) (nv-mu y)
  }

nv-scale : Word → NucVec → NucVec
nv-scale k x = NucVec
  { nv-a   = %wmul k (nv-a x)
  ; nv-q   = %wmul k (nv-q x)
  ; nv-pos = %wmul k (nv-pos x)
  ; nv-neg = %wmul k (nv-neg x)
  ; nv-le  = %wmul k (nv-le x)
  ; nv-ale = %wmul k (nv-ale x)
  ; nv-mu  = %wmul k (nv-mu x)
  }

-- Exact conservation of ALL 4 Standard Model low-energy symmetries:
--   1. Baryon number A1 == A2
--   2. Electric charge (Z1 + pos1 + neg2 == Z2 + pos2 + neg1)  [zero signed overflow!]
--   3. Electron lepton number (le1 + ale2 == le2 + ale1)
--   4. Muon lepton number (mu1 == mu2)
nv-conserves : NucVec → NucVec → Bool
nv-conserves x y =
  andB (%weq (nv-a x) (nv-a y))
  (andB (%weq (%wadd (%wadd (nv-q x) (nv-pos x)) (nv-neg y))
              (%wadd (%wadd (nv-q y) (nv-pos y)) (nv-neg x)))
  (andB (%weq (%wadd (nv-le x) (nv-ale y))
              (%wadd (nv-le y) (nv-ale x)))
        (%weq (nv-mu x) (nv-mu y))))

record NucMorph =
  { nm-name : List Word
  ; nm-in   : NucVec
  ; nm-out  : NucVec
  ; nm-cons : PathP (λ i → Bool) (nv-conserves nm-in nm-out) true
  }

