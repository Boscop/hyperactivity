-- definition g at its arguments: a call when they are as many as its arity; a closure cell when
-- fewer; the call on the first ones, then the rest applied, when more
x-gref : Enc → Tbl → XEnv → Word → Word → Lst Code → Lst Word
x-gref ce tbl env d g args =
  let a = x-ar tbl g
      n = l-count args
  in if %weq n a then x-call ce tbl env d g args
     else if %wlt n a then x-clo ce tbl env d g a args
     else x-applies ce tbl env d (x-call ce tbl env d g (x-take a args)) (x-drop a args)
