-- ── 4. Minimal Consistent 0px Visual Language (Pure CssSheet + Proof) ────────
sw-sheet : CssSheet
sw-sheet = tx-zero-radius
  (cons (css-rule ":root"
    (d5 "--bg" "#070709" "--ink" "#eaeaf0" "--dim" "#8a8a9e" "--pink" "#ff0a94" "--ok" "#18e68c"))
  (cons (css-rule "body"
    (d4 "margin" "0" "background" "var(--bg)" "color" "var(--ink)" "font" "12px/1.5 ui-monospace,Menlo,monospace"))
  (cons (css-rule ".sw-card"
    (d4 "border" "1px solid #22222b" "padding" "12px" "background" "#0e0e13" "border-radius" "0"))
  (cons (css-rule ".sw-btn"
    (d4 "border" "1px solid #22222b" "padding" "6px 10px" "background" "transparent" "color" "var(--ink)"))
  nil))))
