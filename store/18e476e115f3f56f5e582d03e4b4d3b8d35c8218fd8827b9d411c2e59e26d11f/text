kc-pad136 : List Word → List Word
kc-pad136 msg =
  let len = fromNat (list-length msg)
      rem = %wmod len #136
  in if %weq rem #135
     then list-append msg (cons #129 nil)
     else let zc = %wsub #134 rem
          in list-append msg (cons #1 (list-append (kc-rep-zero (toNat zc)) (cons #128 nil)))
