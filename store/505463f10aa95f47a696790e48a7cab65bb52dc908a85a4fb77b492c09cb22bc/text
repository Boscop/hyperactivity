      const ns = notes.filter(n => n.step === st);
      const hz = ns.length ? state.rootHz * 2 * sc[ns[0].row % sc.length].r : state.rootHz * 2;
      const om = 2*Math.PI*hz/48000, kE = Math.min(0.8, om*om*(1+state.k*2)), wE = Math.min(0.4, state.w*(0.2+om));
      const f0 = (inS < 20 && ns.length) ? 0.14 : 0;
      p0 = damp*(p0-(kE*q0 + wE*((q0-q1)+(q0-q3)) - f0)); p1 = damp*(p1-(kE*q1 + wE*((q1-q0)+(q1-q2))));
      p2 = damp*(p2-(kE*q2 + wE*((q2-q1)+(q2-q3)))); p3 = damp*(p3-(kE*q3 + wE*((q3-q2)+(q3-q0))));
      q0+=p0; q1+=p1; q2+=p2; q3+=p3;
      pcm[i*2] = Math.max(-32767, Math.min(32767, Math.round(Math.tanh((q0+q2)*0.45)*31000)));
      pcm[i*2+1] = Math.max(-32767, Math.min(32767, Math.round(Math.tanh((q1+q3)*0.45)*31000)));
    }
    const buf = new ArrayBuffer(44 + pcm.byteLength), dv = new DataView(buf);
    const ws = (o,s) => { for(let i=0;i<s.length;i++) dv.setUint8(o+i, s.charCodeAt(i)); };
    ws(0,'RIFF'); dv.setUint32(4,36+pcm.byteLength,true); ws(8,'WAVEfmt '); dv.setUint32(16,16,true);
    dv.setUint16(20,1,true); dv.setUint16(22,2,true); dv.setUint32(24,48000,true); dv.setUint32(28,192000,true);
    dv.setUint16(32,4,true); dv.setUint16(34,16,true); ws(36,'data'); dv.setUint32(40,pcm.byteLength,true);
    new Int16Array(buf, 44).set(pcm); return buf;
  }
  const dlBlob = (buf, name, type) => { const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([buf],{type})); a.download = name; a.click(); };
  $('exWav').onclick = () => { dlBlob(renderOfflineWav(curNotes(), 4), 'hyperactivity-mix.wav', 'audio/wav'); toast('Exported stereo WAV'); };
  $('exStems').onclick = () => { ['bass','chords','drums','space'].forEach((nm,i)=>dlBlob(renderOfflineWav(curNotes().filter(n=>i===3||n.trk===i), 2), `stem-${nm}.wav`, 'audio/wav')); toast('Exported 4 stems'); };
  $('exMid').onclick = () => {
    const trk = []; curNotes().forEach(n => trk.push(0, 0x90, (48+n.row)&127, Math.round(n.vel*120), 60, 0x80, (48+n.row)&127, 0)); trk.push(0,0xff,0x2f,0);
    const hdr = [0x4d,0x54,0x68,0x64,0,0,0,6,0,0,0,1,1,0xe0, 0x4d,0x54,0x72,0x6b,(trk.length>>24)&255,(trk.length>>16)&255,(trk.length>>8)&255,trk.length&255,...trk];
    dlBlob(new Uint8Array(hdr), 'hyperactivity-pattern.mid', 'audio/midi'); toast('Exported MIDI');
  };
  $('exWasm').onclick = () => { dlBlob(lastWasmBytes || compileDspExprToWasm(curDspExpr), 'hyperactivity-plugin.wasm', 'application/wasm'); toast('Exported .wasm'); };

  // ── Keyboard Shortcuts (Space, Cmd+Z, A-L Piano, 1-8 Chops) ──
  const KEY_ROW = { a:0, w:1, s:2, e:3, d:4, f:5, t:6, g:7, y:8, h:9, u:10, j:11, k:12, o:13, l:14, p:15 };
  window.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'z') { e.preventDefault(); e.shiftKey ? redoCas() : undoCas(); return; }
    if (e.code === 'Space') { e.preventDefault(); playing ? stopSeq(false) : startSeq(); return; }
    const k = e.key.toLowerCase();
    if (KEY_ROW[k] !== undefined) fireNote(KEY_ROW[k], 0.85, state.selTrk);
    if (k >= '1' && k <= '8') { const b = $('chopPads').children[parseInt(k)-1]; if (b) b.onmousedown(); }
  });

  // ── Animation Loop ──
  function anim() {
    if ($('dp-dev').classList.contains('on')) drawEq();
    if ($('dr-phys').classList.contains('on')) drawWebGL();
    if (pitchTrackOn) trackMicPitch();
    requestAnimationFrame(anim);
  }
  window.addEventListener('resize', () => { drawPiano(); });

  // Boot
  renderLibrary(); renderArrangement(); renderPianoKeys(); renderMixer(); renderStemDeck(); renderChops();
  initWebGL(); syncCode(); drawMorph(); drawNet(); drawChain(); drawGravity();
  if (location.hash.startsWith('#hx=')) {
    try { hydrateSong(decodeURIComponent(escape(atob(location.hash.slice(4).replace(/-/g,'+').replace(/_/g,'/'))))); } catch (_) {}
  }
  drawPiano(); snapCas('init'); joinRoom('studio-01'); anim();
})();
</script>
