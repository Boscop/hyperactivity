<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hyperactivity DAW</title>
<meta name="description" content="First-principles digital audio workstation on the hyperactivity kernel.">
<script>
(function(){
  try {
    var t = localStorage.getItem('hxTheme');
    if (t !== 'light') document.documentElement.classList.add('dark');
  } catch (e) { document.documentElement.classList.add('dark'); }
})();
</script>
<style>
:root {
  --bg: #f6f6f7;
  --bg2: #ffffff;
  --bg3: #ececef;
  --bg4: #e2e2e7;
  --ink: #0a0a0c;
  --muted: #666670;
  --dim: #92929c;
  --line: rgba(0, 0, 0, 0.09);
  --line-s: rgba(0, 0, 0, 0.18);
  --pink: #ff0a94;
  --blue: #1a73e8;
  --green: #0a8a43;
  --amber: #d97706;
  --red: #e11d48;
  --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  --sans: -apple-system, BlinkMacSystemFont, 'Inter', 'Helvetica Neue', sans-serif;
}
html.dark {
  --bg: #0c0c0f;
  --bg2: #121216;
  --bg3: #18181e;
  --bg4: #22222b;
  --ink: #f3f3f6;
  --muted: #8a8a98;
  --dim: #555562;
  --line: rgba(255, 255, 255, 0.075);
  --line-s: rgba(255, 255, 255, 0.16);
  --pink: #ff0a94;
  --blue: #4da3ff;
  --green: #26d07c;
  --amber: #f59e0b;
  --red: #ff4d6d;
}
* { box-sizing: border-box; user-select: none; -webkit-user-select: none; }
input, textarea, select { user-select: text; -webkit-user-select: text; }
html, body {
  margin: 0; height: 100%; overflow: hidden;
  background: var(--bg); color: var(--ink);
  font-family: var(--sans); font-size: 12px;
  -webkit-font-smoothing: antialiased;
}
::selection { background: var(--pink); color: #fff; }

/* ── APP SHELL (FULL-VIEWPORT PRO DAW) ── */
.daw {
  display: grid;
  grid-template-rows: 44px minmax(0, 1fr);
  height: calc(100vh - 48px);
  width: 100vw;
  overflow: hidden;
}

/* ── TOP TRANSPORT BAR ── */
.transport {
  display: flex; align-items: center; justify-content: space-between;
  gap: 10px; padding: 0 12px;
  background: var(--bg2);
  border-bottom: 1px solid var(--line-s);
  min-width: 0;
}
.t-grp { display: flex; align-items: center; gap: 6px; min-width: 0; }
.t-sep { width: 1px; height: 20px; background: var(--line-s); margin: 0 2px; flex-shrink: 0; }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 5px;
  height: 28px; padding: 0 10px;
  background: var(--bg3); color: var(--ink);
  border: 1px solid var(--line-s); border-radius: 3px;
  font: 600 11px/1 var(--sans); letter-spacing: 0.01em;
  cursor: pointer; white-space: nowrap; transition: background 0.1s, border-color 0.1s, color 0.1s;
}
.btn:hover { background: var(--bg4); border-color: var(--ink); }
.btn.ico { width: 28px; padding: 0; font-size: 12px; }
.btn.on { background: var(--pink); color: #fff; border-color: var(--pink); }
.btn.ok { border-color: var(--green); color: var(--green); }
.btn.ok.on { background: var(--green); color: #000; }
.btn.rec.on { background: var(--red); border-color: var(--red); color: #fff; }
.btn.ghost { background: transparent; border-color: transparent; color: var(--muted); }
.btn.ghost:hover { color: var(--ink); background: var(--bg3); }
.btn.ghost.on { background: var(--bg4); color: var(--pink); border-color: var(--pink); }

.lcd {
  display: inline-flex; align-items: center; gap: 10px;
  height: 28px; padding: 0 10px;
  background: var(--bg); border: 1px solid var(--line-s); border-radius: 3px;
  font: 600 11.5px/1 var(--mono); color: var(--ink);
}
.lcd input.bpm-in {
  width: 44px; background: transparent; border: 0; color: var(--ink);
  font: 700 12px/1 var(--mono); text-align: right; outline: none; padding: 0;
}
.lcd .sub { font-size: 9.5px; color: var(--muted); font-weight: 500; }
.lcd .pos { min-width: 54px; text-align: center; letter-spacing: 0.04em; color: var(--pink); }

.sel {
  height: 28px; padding: 0 7px;
  background: var(--bg3); color: var(--ink);
  border: 1px solid var(--line-s); border-radius: 3px;
  font: 600 11px/1 var(--sans); outline: none; cursor: pointer;
}
.sel:focus { border-color: var(--pink); }

.master-mini {
  display: flex; align-items: center; gap: 7px;
  height: 28px; padding: 0 8px;
  background: var(--bg); border: 1px solid var(--line-s); border-radius: 3px;
}
.meter-v-mini {
  width: 68px; height: 8px; background: var(--bg3); border-radius: 2px; overflow: hidden;
  display: flex; flex-direction: column; gap: 1px;
}
.meter-bar-h { height: 3.5px; width: 0%; background: linear-gradient(90deg, var(--green) 0%, var(--amber) 78%, var(--red) 98%); transition: width 0.04s linear; }
.lufs-txt { font: 600 10px/1 var(--mono); color: var(--muted); min-width: 60px; text-align: right; }

/* ── MAIN WORKSPACE GRID ── */
.main-area {
  display: grid;
  grid-template-columns: 214px minmax(0, 1fr) 0px;
  min-height: 0; overflow: hidden;
  transition: grid-template-columns 0.16s ease;
}
.main-area.no-lib { grid-template-columns: 0px minmax(0, 1fr) 0px; }
.main-area.drawer-open { grid-template-columns: 214px minmax(0, 1fr) 410px; }
.main-area.no-lib.drawer-open { grid-template-columns: 0px minmax(0, 1fr) 410px; }

/* ── LEFT LIBRARY BROWSER ── */
.library {
  background: var(--bg2); border-right: 1px solid var(--line-s);
  display: flex; flex-direction: column; min-height: 0; overflow: hidden;
}
.main-area.no-lib .library { border-right: 0; opacity: 0; pointer-events: none; }
.lib-head {
  padding: 8px 10px; border-bottom: 1px solid var(--line);
  display: flex; align-items: center; justify-content: space-between;
  font: 700 10px/1 var(--mono); text-transform: uppercase; letter-spacing: 0.09em; color: var(--muted);
}
.lib-scroll { flex: 1; overflow-y: auto; padding: 6px 8px 14px; display: flex; flex-direction: column; gap: 10px; }
.lib-sec-t {
  font: 700 9.5px/1 var(--mono); text-transform: uppercase; letter-spacing: 0.08em;
  color: var(--dim); padding: 4px 4px 3px;
}
.lib-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 5px 8px; border-radius: 3px; cursor: pointer;
  font: 500 11.5px/1.2 var(--sans); color: var(--ink);
  border: 1px solid transparent;
}
.lib-item:hover { background: var(--bg3); border-color: var(--line); }
.lib-item.active { background: var(--bg4); border-color: var(--pink); color: var(--ink); }
.lib-item .tag { font: 600 9.5px/1 var(--mono); color: var(--muted); }
.lib-drop {
  margin-top: 2px; padding: 9px 8px; text-align: center;
  border: 1px dashed var(--line-s); border-radius: 3px;
  font: 600 10.5px/1.3 var(--sans); color: var(--muted); cursor: pointer;
}
.lib-drop:hover { border-color: var(--pink); color: var(--pink); }

/* ── CENTER STAGE: ARRANGEMENT + BOTTOM DOCK ── */
.center-stage {
  display: grid;
  grid-template-rows: minmax(180px, 48%) minmax(220px, 52%);
  min-width: 0; min-height: 0; overflow: hidden;
  background: var(--bg);
}

/* ── ARRANGEMENT TIMELINE ── */
.arr-wrap {
  display: flex; flex-direction: column;
  min-height: 0; border-bottom: 1.5px solid var(--line-s);
  background: var(--bg);
}
.arr-ruler-row {
  display: grid; grid-template-columns: 204px minmax(0, 1fr);
  height: 24px; background: var(--bg2); border-bottom: 1px solid var(--line-s);
  flex-shrink: 0;
}
.arr-corner {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 8px; border-right: 1px solid var(--line-s);
  font: 700 9.5px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted);
}
.arr-ruler {
  position: relative; display: grid; grid-template-columns: repeat(16, 1fr);
  cursor: pointer;
}
.arr-bar-num {
  border-left: 1px solid var(--line); padding: 5px 4px 0;
  font: 600 9.5px/1 var(--mono); color: var(--muted);
}
.arr-bar-num.looped { background: rgba(255, 10, 148, 0.09); color: var(--ink); }
.arr-body {
  flex: 1; overflow-y: auto; position: relative;
}
.trk-row {
  display: grid; grid-template-columns: 204px minmax(0, 1fr);
  height: 54px; border-bottom: 1px solid var(--line);
}
.trk-row.sel-trk .trk-head { background: var(--bg3); }
.trk-head {
  display: flex; flex-direction: column; justify-content: space-between;
  padding: 5px 8px 5px 10px;
  background: var(--bg2); border-right: 1px solid var(--line-s);
  border-left: 3px solid var(--pink); cursor: pointer;
}
.trk-top { display: flex; align-items: center; justify-content: space-between; gap: 4px; }
.trk-name { font: 600 11.5px/1 var(--sans); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.trk-btns { display: flex; gap: 3px; }
.t-mini {
  width: 18px; height: 18px; border-radius: 2px; border: 1px solid var(--line-s);
  background: var(--bg); color: var(--muted); font: 700 9px/1 var(--mono);
  cursor: pointer; padding: 0; display: inline-flex; align-items: center; justify-content: center;
}
.t-mini.m.on { background: var(--amber); color: #000; border-color: var(--amber); }
.t-mini.s.on { background: var(--blue); color: #fff; border-color: var(--blue); }
.t-mini.r.on { background: var(--red); color: #fff; border-color: var(--red); }
.trk-bot { display: flex; align-items: center; gap: 6px; }
.trk-vol {
  flex: 1; height: 4px; -webkit-appearance: none; appearance: none;
  background: var(--bg4); border-radius: 2px; outline: none; cursor: pointer;
}
.trk-vol::-webkit-slider-thumb {
  -webkit-appearance: none; width: 10px; height: 10px; border-radius: 50%;
  background: var(--ink); border: 1px solid var(--bg); cursor: pointer;
}
.trk-meter { width: 34px; height: 5px; background: var(--bg); border-radius: 1px; overflow: hidden; }
.trk-meter > i { display: block; height: 100%; width: 0%; background: var(--green); transition: width 0.05s linear; }

.trk-lane {
  position: relative; display: grid; grid-template-columns: repeat(16, 1fr);
  background: repeating-linear-gradient(90deg, transparent, transparent calc(25% - 1px), var(--line) calc(25% - 1px), var(--line) 25%);
}
.clip-cell {
  border-right: 1px solid var(--line); padding: 4px 2px; cursor: pointer; position: relative;
}
.clip-cell:hover { background: rgba(255, 255, 255, 0.03); }
.clip-blk {
  height: 100%; border-radius: 3px; overflow: hidden;
  border: 1px solid rgba(255,255,255,0.18);
  display: flex; flex-direction: column;
}
.clip-hdr {
  height: 13px; padding: 2px 4px;
  font: 700 8.5px/1 var(--mono); color: #fff;
  background: rgba(0,0,0,0.28); white-space: nowrap; overflow: hidden;
}
.clip-mini-notes {
  flex: 1; position: relative; background: rgba(0,0,0,0.16);
}
.clip-mini-notes i {
  position: absolute; height: 2px; border-radius: 1px; background: rgba(255,255,255,0.85);
}
.playhead {
  position: absolute; top: 0; bottom: 0; width: 1.5px;
  background: var(--pink); pointer-events: none; z-index: 10;
  box-shadow: 0 0 8px rgba(255, 10, 148, 0.7);
}

/* ── BOTTOM DETAIL DOCK (PIANO ROLL / DEVICES / MIXER / STEMS) ── */
.dock {
  display: flex; flex-direction: column; min-height: 0; background: var(--bg2);
}
.dock-bar {
  display: flex; align-items: center; justify-content: space-between;
  height: 34px; padding: 0 10px;
  border-bottom: 1px solid var(--line-s); background: var(--bg2); flex-shrink: 0;
}
.dock-tabs { display: flex; gap: 2px; }
.d-tab {
  height: 24px; padding: 0 12px; border-radius: 3px;
  border: 1px solid transparent; background: transparent; color: var(--muted);
  font: 600 11px/1 var(--sans); cursor: pointer;
}
.d-tab:hover { color: var(--ink); background: var(--bg3); }
.d-tab.on { background: var(--bg4); color: var(--ink); border-color: var(--line-s); }
.dock-pane { display: none; flex: 1; min-height: 0; overflow: hidden; }
.dock-pane.on { display: flex; }

/* ── PIANO ROLL ── */
.pr-wrap { display: grid; grid-template-columns: 56px minmax(0, 1fr); flex: 1; min-height: 0; }
.pr-keys {
  background: var(--bg2); border-right: 1px solid var(--line-s);
  display: flex; flex-direction: column; overflow: hidden;
}
.pr-key {
  flex: 1; display: flex; align-items: center; justify-content: flex-end;
  padding-right: 5px; border-bottom: 1px solid var(--line);
  font: 600 8.5px/1 var(--mono); color: var(--muted); cursor: pointer;
}
.pr-key.blk { background: var(--bg); color: var(--dim); }
.pr-key.root { color: var(--pink); font-weight: 800; }
.pr-key:hover, .pr-key.lit { background: var(--pink); color: #fff; }
.pr-grid-col { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; }
#pianoCanvas { width: 100%; flex: 1; min-height: 0; display: block; cursor: crosshair; }
#velCanvas { width: 100%; height: 42px; display: block; border-top: 1px solid var(--line-s); background: var(--bg); cursor: ns-resize; }

/* ── ABLETON-STYLE HORIZONTAL DEVICE RACK ── */
.rack {
  flex: 1; display: flex; gap: 8px; padding: 10px;
  overflow-x: auto; align-items: stretch; background: var(--bg);
}
.dev {
  flex: 0 0 auto; min-width: 215px;
  background: var(--bg2); border: 1px solid var(--line-s); border-radius: 4px;
  display: flex; flex-direction: column; overflow: hidden;
}
.dev-hdr {
  display: flex; align-items: center; justify-content: space-between;
  padding: 6px 9px; background: var(--bg3); border-bottom: 1px solid var(--line);
  font: 700 10.5px/1 var(--sans);
}
.dev-led { width: 7px; height: 7px; border-radius: 50%; background: var(--green); display: inline-block; margin-right: 5px; }
.dev-body { flex: 1; padding: 8px 10px; display: flex; flex-direction: column; gap: 8px; justify-content: center; }
.knob-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px 6px; }
.knob-wrap { display: flex; flex-direction: column; align-items: center; gap: 3px; cursor: ns-resize; }
.knob-wrap svg { width: 38px; height: 38px; overflow: visible; }
.knob-lbl { font: 600 9.5px/1 var(--sans); color: var(--muted); }
.knob-val { font: 600 9px/1 var(--mono); color: var(--ink); }
.xy-mini {
  width: 110px; height: 96px; border: 1px solid var(--line-s); border-radius: 3px;
  background: var(--bg); cursor: crosshair; display: block;
}
#eqCanvas { width: 280px; height: 112px; background: var(--bg); border: 1px solid var(--line); border-radius: 3px; display: block; }

/* ── STUDIO MIXER CONSOLE ── */
.mixer {
  flex: 1; display: flex; gap: 6px; padding: 10px;
  overflow-x: auto; background: var(--bg); align-items: stretch;
}
.strip {
  width: 112px; flex-shrink: 0;
  background: var(--bg2); border: 1px solid var(--line-s); border-radius: 4px;
  display: flex; flex-direction: column; align-items: center; padding: 8px 6px; gap: 7px;
}
.strip.master { margin-left: auto; border-color: var(--pink); width: 132px; }
.strip-name { font: 700 11px/1 var(--sans); width: 100%; text-align: center; padding-bottom: 5px; border-bottom: 2px solid var(--pink); }
.fader-box { flex: 1; display: flex; align-items: center; gap: 8px; width: 100%; justify-content: center; min-height: 100px; }
.v-fader {
  writing-mode: vertical-lr; direction: rtl;
  height: 100%; width: 18px; accent-color: var(--pink); cursor: pointer;
}
.v-meter { width: 8px; height: 100%; background: var(--bg); border: 1px solid var(--line); border-radius: 2px; display: flex; flex-direction: column-reverse; overflow: hidden; }
.v-meter > i { display: block; width: 100%; height: 0%; background: linear-gradient(0deg, var(--green), var(--amber) 75%, var(--red) 95%); transition: height 0.05s; }
.strip-db { font: 600 10px/1 var(--mono); color: var(--muted); }

/* ── CLEAN 4-STEM PERFORMANCE DECK ── */
.stem-view {
  flex: 1; display: grid; grid-template-columns: 360px minmax(0, 1fr); gap: 14px;
  padding: 12px 16px; background: var(--bg); min-height: 0; overflow-y: auto;
}
.stem-sliders { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; align-items: stretch; }
.s-col {
  background: var(--bg2); border: 1px solid var(--line-s); border-radius: 4px;
  padding: 8px 6px; display: flex; flex-direction: column; align-items: center; gap: 6px;
}
.s-track {
  position: relative; width: 22px; flex: 1; min-height: 110px;
  background: var(--bg); border: 1px solid var(--line-s); border-radius: 11px;
  overflow: hidden; cursor: ns-resize;
}
.s-fill { position: absolute; bottom: 0; left: 0; right: 0; transition: height 0.03s; }
.s-lbl { font: 700 9.5px/1 var(--mono); letter-spacing: 0.06em; color: var(--muted); }
.chop-pads { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 8px; }
.pad-btn {
  height: 46px; background: var(--bg2); border: 1px solid var(--line-s); border-radius: 3px;
  color: var(--ink); font: 600 10.5px/1.2 var(--mono); cursor: pointer;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.pad-btn:hover { border-color: var(--pink); }
.pad-btn.lit { background: var(--pink); color: #fff; border-color: var(--pink); }

/* ── RIGHT PROGRESSIVE HYPERACTIVE INSPECTOR DRAWER ── */
.drawer {
  background: var(--bg2); border-left: 1.5px solid var(--line-s);
  display: flex; flex-direction: column; min-height: 0; overflow: hidden;
}
.main-area:not(.drawer-open) .drawer { border-left: 0; opacity: 0; pointer-events: none; }
.dr-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8px 10px; border-bottom: 1px solid var(--line-s); background: var(--bg3);
}
.dr-tabs { display: flex; gap: 2px; }
.dr-tab {
  padding: 4px 8px; border-radius: 3px; border: 1px solid transparent;
  background: transparent; color: var(--muted); font: 700 10px/1 var(--mono); cursor: pointer;
}
.dr-tab.on { background: var(--ink); color: var(--bg); }
.dr-body { display: none; flex: 1; overflow-y: auto; padding: 12px; flex-direction: column; gap: 10px; }
.dr-body.on { display: flex; }
.dr-sec {
  background: var(--bg); border: 1px solid var(--line-s); border-radius: 4px; padding: 10px;
  display: flex; flex-direction: column; gap: 7px;
}
.dr-sec h3 {
  margin: 0; font: 700 10px/1 var(--mono); text-transform: uppercase;
  letter-spacing: 0.08em; color: var(--muted); display: flex; justify-content: space-between;
}
textarea.code-ed {
  width: 100%; height: 140px; padding: 8px; border-radius: 3px;
  background: var(--bg2); color: var(--ink); border: 1px solid var(--line-s);
  font: 500 11px/1.45 var(--mono); resize: vertical; outline: none;
}
textarea.code-ed:focus { border-color: var(--pink); }
.log-out {
  font: 500 10.5px/1.45 var(--mono); color: var(--muted);
  background: var(--bg2); border: 1px solid var(--line); border-radius: 3px;
  padding: 7px 8px; white-space: pre-wrap; max-height: 92px; overflow-y: auto;
}
.row-f { display: flex; flex-wrap: wrap; gap: 5px; align-items: center; }

/* ── POPOVER MENU ── */
.pop-wrap { position: relative; }
.pop-menu {
  display: none; position: absolute; right: 0; top: 34px; z-index: 40;
  min-width: 185px; background: var(--bg2); border: 1px solid var(--line-s);
  border-radius: 4px; padding: 4px; box-shadow: 0 12px 32px rgba(0,0,0,0.45);
  flex-direction: column; gap: 2px;
}
.pop-menu.open { display: flex; }
.pop-item {
  text-align: left; padding: 7px 9px; background: transparent; border: 0;
  color: var(--ink); font: 500 11.5px/1 var(--sans); border-radius: 3px; cursor: pointer;
}
.pop-item:hover { background: var(--bg4); color: var(--pink); }
.toast {
  position: fixed; bottom: 14px; right: 16px; z-index: 60;
  padding: 8px 13px; border-radius: 4px; background: var(--ink); color: var(--bg);
  font: 600 11px/1.2 var(--mono); opacity: 0; pointer-events: none; transition: opacity 0.18s;
}
.toast.show { opacity: 1; }
</style>
</head>
<body>
<!--HX:NAV-->

<div class="daw">
  <!-- TOP TRANSPORT BAR -->
  <header class="transport">
    <div class="t-grp">
      <button id="btnLib" class="btn ghost on" title="Toggle Library Browser">Library</button>
      <div class="t-sep"></div>
      <button id="btnPlay" class="btn ico" title="Play / Pause (Space)">▶</button>
      <button id="btnStop" class="btn ico" title="Stop">■</button>
      <button id="btnRec" class="btn ico rec" title="Record Mic / MIDI">●</button>
      <button id="btnLoop" class="btn ico on" title="Loop">⟳</button>
      <div class="lcd">
        <span class="pos" id="lcdPos">001.1.1</span>
        <span class="sub">BPM</span>
        <input id="bpmIn" class="bpm-in" type="number" value="116" min="40" max="240">
      </div>
      <select id="scaleSel" class="sel" title="Scale & Tuning">
        <option value="12tet">12-TET · C Minor</option>
        <option value="just">Just Intonation</option>
        <option value="19edo">19-EDO</option>
