DLTy : (sk : Lst Entry) (k : Word) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y)) (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X Y c) → Bool → Type 1
DLTy sk k X Y Z H f g c d b =
  PathP (λ i → DCube (dims sk) Z H (ddm-ty sk k X Y Z f c d b i))
    (dsd-ty sk k Z H (dcube-map (suc (dims sk)) X Y Z f c d) (dcube-lift (suc (dims sk)) X Z Y H f g c d) b)
    (dcube-lift (dims sk) X Z Y H f g (dsk-ty sk k X c b) (dsd-ty sk k X Y c d b))
