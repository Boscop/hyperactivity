-- Antisymmetry of Nat ordering `rg-leb`: a ≤ b and b ≤ a implies a ≡ b.
rg-leb-antisym : (a b : Nat) → rg-leb a b ≡ true → rg-leb b a ≡ true → a ≡ b
rg-leb-antisym zero zero p q = λ i → zero
rg-leb-antisym zero (suc b) p q = Empty-rec (rg-false-ne-true q)
rg-leb-antisym (suc a) zero p q = Empty-rec (rg-false-ne-true p)
rg-leb-antisym (suc a) (suc b) p q = λ i → suc (rg-leb-antisym a b p q i)
