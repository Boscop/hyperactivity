  andB (uc-behrend-no-3ap-3pts #5 #0 #4 #3 #3 #4)
  (andB (uc-behrend-no-3ap-3pts #5 #0 #3 #4 #0 #5)
        (uc-behrend-no-3ap-3pts #4 #3 #3 #4 #0 #5)) ≡ true
