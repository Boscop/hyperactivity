-- Exact Heap Cell Conservation Theorem 2 (Retire / Annihilation / §4.5 Prune):
-- Returning a retired cell ID to the consumer tile's local LIFO freelist strictly preserves `live + |freeStack|`.
pool-retire-conserves : (l : Nat) → (freedId : Word) → (rest : List Word) →
  pool-capacity (pool-retire l freedId rest) ≡ pool-capacity (hpool (suc l) rest)
pool-retire-conserves l freedId rest =
  plus-suc-r-nat l (list-length {Word} rest)
