si-tab-zero : (n : Nat) → (B : Bytes n) → (y : List Word) → (r : List (List Word)) → (p : Word) → (o : Word) → si-rep n B o (cons y r) → si-rd4 n B p ≡ o →
  si-rep n B (si-rd4 n B (si-slot p #0)) (cons y r)
si-tab-zero n B y r p o hr e = subst {_} {_} {Word} {λ z → si-rep n B z (cons y r)} (sym (concat (λ i → si-rd4 n B (si-slot0 p i)) e)) hr
