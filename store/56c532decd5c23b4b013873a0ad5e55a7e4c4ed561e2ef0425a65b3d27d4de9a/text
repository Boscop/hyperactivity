-- Block-scaled MXFP64 Systolic PE Equivalence: accumulating a 64-wide log-depth MXFP block inside a
-- systolic PE matches sequential elementwise scaled accumulation!
systolic-mxfp64-pe-sound : (acc s : Nat) → (prods : Nat → Nat) →
  plus acc (times s (atree-eval plus (tree-bal-from (toNat #6) zero prods))) ≡
  plus acc (atree-eval plus (atree-map (times s) (tree-chain-from (toNat #63) zero prods)))
systolic-mxfp64-pe-sound acc s prods =
  congN (plus acc) (mxfp64-mac-sound s prods)
