nk-lvl-max : NkTm → NkTm → NkTm
nk-lvl-max (nk-con c1 (nk-cons (nk-num m1) a1)) (nk-con c2 (nk-cons (nk-num m2) a2)) =
  if (if %weq c1 #49 then %weq c2 #49 else false)
    then nk-con #49 (nk-cons (nk-num (%wmax m1 m2)) (nk-tapp a1 a2))
    else nk-con #48 nk-nil
nk-lvl-max a b = nk-con #48 nk-nil
