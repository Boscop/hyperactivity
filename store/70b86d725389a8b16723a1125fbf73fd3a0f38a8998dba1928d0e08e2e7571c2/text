omni-ccz-poly : Bool → Bool → Bool → Word
omni-ccz-poly x1 x2 x3 =
  let a   = omni-b1 x1
      b   = omni-b1 x2
      c   = omni-b1 x3
      ab  = omni-b1 (web-xorB x1 x2)
      ac  = omni-b1 (web-xorB x1 x3)
      bc  = omni-b1 (web-xorB x2 x3)
      abc = omni-b1 (web-xorB (web-xorB x1 x2) x3)
      pos = %wadd (%wadd a b) (%wadd c abc)
      neg = %wmul #7 (%wadd (%wadd ab ac) bc)
  in %wand (%wadd pos neg) #7
