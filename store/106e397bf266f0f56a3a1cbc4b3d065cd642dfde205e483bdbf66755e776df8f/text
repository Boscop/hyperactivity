-- two points one lattice step apart
sl-adj : Nat × Nat → Nat × Nat → Bool
sl-adj a b = if eqb (fst a) (fst b) then (if eqb (snd a) (suc (snd b)) then true else eqb (snd b) (suc (snd a)))
  else (if eqb (snd a) (snd b) then (if eqb (fst a) (suc (fst b)) then true else eqb (fst b) (suc (fst a))) else false)
