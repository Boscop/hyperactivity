-- (s u) · v = s (u · v)
cl-dot-scale : (A : Type) → (z : A) → (ad mu : A → A → A) → ((s x y : A) → mu (mu s x) y ≡ mu s (mu x y)) → ((s p q : A) → mu s (ad p q) ≡ ad (mu s p) (mu s q)) →
  ((x : A) → mu x z ≡ z) → (s : A) → (u v : List A) → cl-dot A z ad mu (ln-map A A (λ x → mu s x) u) v ≡ mu s (cl-dot A z ad mu u v)
cl-dot-scale A z ad mu asc dl m0 s u v = (case u return λ w → (v2 : List A) → cl-dot A z ad mu (ln-map A A (λ x → mu s x) w) v2 ≡ mu s (cl-dot A z ad mu w v2) of
  nil → λ v2 → λ i → m0 s (~ i)
  cons x xs → λ v2 → cl-tr A (ad (mu (mu s x) (cl-hd A z v2)) (cl-dot A z ad mu (ln-map A A (λ y → mu s y) xs) (cl-tl A v2)))
    (ad (mu s (mu x (cl-hd A z v2))) (mu s (cl-dot A z ad mu xs (cl-tl A v2))))
    (mu s (ad (mu x (cl-hd A z v2)) (cl-dot A z ad mu xs (cl-tl A v2))))
    (λ i → ad (asc s x (cl-hd A z v2) i) (cl-dot-scale A z ad mu asc dl m0 s xs (cl-tl A v2) i))
    (λ i → dl s (mu x (cl-hd A z v2)) (cl-dot A z ad mu xs (cl-tl A v2)) (~ i))) v
