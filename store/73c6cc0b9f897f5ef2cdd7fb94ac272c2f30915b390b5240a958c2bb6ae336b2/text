nk-rho-trim-below : (rho : NkW → NkEv) (b : NkTm) (j : Word) (e : NkEnv) (o : NkOut) (x : NkW) →
  (nk-ebound e (nk-n o) ≡ true) → (nk-wire-lt x (nk-n o) ≡ true) →
  nk-rho-trim rho b j e o x ≡ rho x
nk-rho-trim-below rho b j nke-nil o x hb lt = refl
nk-rho-trim-below rho b j (nke-cons w r) o x hb lt =
  let hr = nk-and-r (nk-wire-lt w (nk-n o)) (nk-ebound r (nk-n o)) hb
      ple = fst (nk-trim-susp-bounds b (%wsucc j) r o hr)
      lt2 = nk-wire-lt-wle-trans x (nk-n o) (nk-n (nk-trim-susp b (%wsucc j) r o)) lt ple
  in nk-rho-trim-step-below (nk-uses-var #0 j b) (nk-rho-trim rho b (%wsucc j) r o) (nk-trim-susp b (%wsucc j) r o) x lt2
     ∙ nk-rho-trim-below rho b (%wsucc j) r o x hr lt
