-- a step of the text's round trip, as first-line-step
after-line-step : (c : Bool) → (x y s r : List Word) → (isTrue (no-newline r) → Path (List Word) y s) → isTrue (if c then false else no-newline r) → Path (List Word) (if c then x else y) s
after-line-step c x y s r rec = case c return (λ d → isTrue (if d then false else no-newline r) → Path (List Word) (if d then x else y) s) of true → λ h → Empty-rec h; false → λ h → rec h
