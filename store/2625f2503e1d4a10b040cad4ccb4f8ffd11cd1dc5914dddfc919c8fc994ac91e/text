-- a split witness (discriminating experiment): two compatible models in the fiber that
-- predict provably distinct outcomes under intervention u
Disagreement : (M O I R : Type 0) → (obs : M → O) → (y : O)
             → (run : M → I → R) → (u : I) → Type 0
Disagreement M O I R obs y run u =
  (m1 : ModelFib M O obs y) × (m2 : ModelFib M O obs y)
    × Neg (run (fst m1) u ≡ run (fst m2) u)
