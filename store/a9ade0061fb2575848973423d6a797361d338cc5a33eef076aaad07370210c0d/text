cs-eval-args : (CsHeap → CsEnv → CsExp → CsRes) → CsHeap → CsEnv → CsExp → CsArgsRes
cs-eval-args ev hp env cs-args-nil = csa-ok hp lnil
cs-eval-args ev hp env (cs-fargs hd tl) =
  case ev hp env hd return (λ _ → CsArgsRes) of
    cs-abort → csa-abort
    cs-ub → csa-ub
    cs-ok hp1 v →
      (case cs-eval-args ev hp1 env tl return (λ _ → CsArgsRes) of
         csa-abort → csa-abort
         csa-ub → csa-ub
         csa-ok hp2 vs → csa-ok hp2 (lcons v vs))
cs-eval-args ev hp env (cs-cargs hd tl) =
  case ev hp env hd return (λ _ → CsArgsRes) of
    cs-abort → csa-abort
    cs-ub → csa-ub
    cs-ok hp1 v →
      (case cs-eval-args ev hp1 env tl return (λ _ → CsArgsRes) of
         csa-abort → csa-abort
         csa-ub → csa-ub
         csa-ok hp2 vs → csa-ok hp2 (lcons v vs))
cs-eval-args ev hp env other = csa-ub
