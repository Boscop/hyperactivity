    }
    // Structural & Atomic: REAL unfolded element-by-element merge (O_LMERGE on V_CONS/V_NIL lists!)
    const merge = net.add('O_LMERGE', 'merge', 'O_LMERGE', 3);
    if (isCert) {
      const sigma = net.add('V_PAIR', 'Σ', 'Value × Proof', 3);
