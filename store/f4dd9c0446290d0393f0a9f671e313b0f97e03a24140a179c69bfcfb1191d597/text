      const mL = net.add('O_LMERGE', 'merge', 'leaf L', 3);
      const c0 = net.add('V_CONS', `${nums[0]} ::`, 'Cons', 2, 0, 0, { n: nums[0] }), nil0 = net.add('V_NIL', '[]', 'Nil', 1);
      const c1 = net.add('V_CONS', `${nums[1]} ::`, 'Cons', 2, 0, 0, { n: nums[1] }), nil1 = net.add('V_NIL', '[]', 'Nil', 1);
      net.wire(c0, 1, nil0, 0); net.wire(c1, 1, nil1, 0);
      net.wire(merge, 0, mL, 2); net.wire(mL, 0, c0, 0); net.wire(mL, 1, c1, 0);

      const mR = net.add('O_LMERGE', 'merge', 'leaf R', 3);
      const c2 = net.add('V_CONS', `${nums[2]} ::`, 'Cons', 2, 0, 0, { n: nums[2] }), nil2 = net.add('V_NIL', '[]', 'Nil', 1);
