// 6. POINCARÉ DISK (ℍ²) COMPLEX MATH: MÖBIUS TRANSFORMS & EXACT GEODESICS
// ============================================================================
// Möbius transform T_a(z) = (z - a) / (1 - conj(a) * z)
function mobius(zx, zy, ax, ay) {
  const nx = zx - ax, ny = zy - ay;
  // 1 - (ax - i ay)(zx + i zy) = (1 - (ax*zx + ay*zy)) - i(ax*zy - ay*zx)
  const dx = 1 - (ax * zx + ay * zy);
  const dy = -(ax * zy - ay * zx);
  const denom = dx * dx + dy * dy + 1e-9;
  return { x: (nx * dx + ny * dy) / denom, y: (ny * dx - nx * dy) / denom };
}

// Draw exact hyperbolic geodesic in Poincaré disk between unit-disk points z1, z2
function strokeHyperbolicGeodesic(ctx, cx, cy, R, x1, y1, x2, y2, isActive, animT) {
  const sx1 = cx + x1 * R, sy1 = cy + y1 * R;
  const sx2 = cx + x2 * R, sy2 = cy + y2 * R;
  const det = 2 * (x1 * y2 - y1 * x2);

  if (Math.abs(det) < 1e-3 || isActive) {
    // Nearly radial or active standing wave along the geodesic chord
    const steps = isActive ? 22 : 16;
    ctx.beginPath();
    // Compute arc center if curved, else straight
    let useArc = Math.abs(det) >= 1e-3;
    let ux = 0, uy = 0, rad = 0, a1 = 0, a2 = 0, ccw = false;
    if (useArc) {
      const r1sq = x1*x1 + y1*y1 + 1, r2sq = x2*x2 + y2*y2 + 1;
      ux = (r1sq * y2 - r2sq * y1) / det;
      uy = (x1 * r2sq - x2 * r1sq) / det;
      rad = Math.sqrt(Math.max(1e-6, ux*ux + uy*uy - 1));
      a1 = Math.atan2(y1 - uy, x1 - ux);
      a2 = Math.atan2(y2 - uy, x2 - ux);
      let da = a2 - a1;
      while (da > Math.PI) da -= Math.PI * 2;
      while (da < -Math.PI) da += Math.PI * 2;
      a2 = a1 + da;
    }
    for (let s = 0; s <= steps; s++) {
      const t = s / steps;
      let px, py, nx = 0, ny = 0;
      if (useArc) {
        const ang = a1 + (a2 - a1) * t;
        px = cx + (ux + rad * Math.cos(ang)) * R;
        py = cy + (uy + rad * Math.sin(ang)) * R;
        nx = Math.cos(ang); ny = Math.sin(ang);
      } else {
        px = sx1 + (sx2 - sx1) * t; py = sy1 + (sy2 - sy1) * t;
        const l = Math.hypot(sx2 - sx1, sy2 - sy1) || 1;
        nx = -(sy2 - sy1) / l; ny = (sx2 - sx1) / l;
      }
      if (isActive) {
        const w = Math.sin(t * Math.PI * 3 + animT * 5) * 4.5 * Math.sin(t * Math.PI);
        px += nx * w; py += ny * w;
      }
      if (s === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.stroke();
    return;
  }

  const r1sq = x1*x1 + y1*y1 + 1, r2sq = x2*x2 + y2*y2 + 1;
  const ux = (r1sq * y2 - r2sq * y1) / det;
  const uy = (x1 * r2sq - x2 * r1sq) / det;
  const rad = Math.sqrt(Math.max(1e-6, ux*ux + uy*uy - 1));
  const a1 = Math.atan2(y1 - uy, x1 - ux);
  const a2 = Math.atan2(y2 - uy, x2 - ux);
  let da = a2 - a1;
  while (da > Math.PI) da -= Math.PI * 2;
  while (da < -Math.PI) da += Math.PI * 2;
  ctx.beginPath();
  ctx.arc(cx + ux * R, cy + uy * R, rad * R, a1, a1 + da, da < 0);
  ctx.stroke();
}

