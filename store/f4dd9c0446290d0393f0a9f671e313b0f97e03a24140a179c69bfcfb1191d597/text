<style>
:root {
  --bg: #ffffff;
  --ink: #000000;
  --muted: #555555;
  --line: rgba(0, 0, 0, 0.14);
  --line-strong: rgba(0, 0, 0, 0.28);
  --border-hi: #000000;
  --pink: #ff0a94;
  --blue: #1a73e8;
  --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  --sans: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
}
html.dark {
  --bg: #000000;
  --ink: #ffffff;
  --muted: #8e8e8e;
  --line: rgba(255, 255, 255, 0.15);
  --line-strong: rgba(255, 255, 255, 0.30);
  --border-hi: #ffffff;
  --pink: #ff0a94;
  --blue: #4da3ff;
}
* { box-sizing: border-box; }
html, body {
  margin: 0; height: 100%; overflow: hidden;
  background: var(--bg); color: var(--ink);
  font-family: var(--sans);
  -webkit-font-smoothing: antialiased;
}
::selection { background: var(--pink); color: #fff; }

nav {
  height: 48px; display: flex; justify-content: space-between; align-items: center;
  padding: 0 26px; background: var(--bg); border-bottom: 2px solid var(--border-hi);
  font: 600 13px/1.2 var(--mono); letter-spacing: .04em; z-index: 10; position: relative;
}
nav a { color: var(--ink); text-decoration: none; }
nav a:hover, nav a.active { color: var(--pink); }
nav .mark { font-weight: 700; white-space: nowrap; }
nav .links { display: flex; align-items: center; gap: 22px; }
nav .nav-theme {
  font: inherit; background: none; border: 1px solid var(--line-strong); color: inherit;
  padding: 3px 8px; cursor: pointer; line-height: 1.2;
}
nav .nav-theme:hover { border-color: var(--pink); color: var(--pink); }

.workspace {
  display: grid;
  grid-template-columns: 268px 1fr;
  grid-template-rows: minmax(0, 1fr) 54px;
  height: calc(100vh - 48px);
}

.sidebar {
  grid-row: 1 / 3;
  background: var(--bg);
  border-right: 1px solid var(--line-strong);
  display: flex; flex-direction: column;
  overflow: hidden; min-height: 0;
}
.sec-head {
  padding: 10px 16px;
  font: 700 10px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase;
  color: var(--muted); border-bottom: 1px solid var(--line);
  display: flex; justify-content: space-between; align-items: center;
}
.presets {
  overflow-y: auto; border-bottom: 1px solid var(--line-strong);
  flex: 1 1 auto; min-height: 0;
}
.preset-btn {
  display: block; width: 100%; text-align: left;
  background: transparent; color: var(--ink); border: 0;
  border-left: 3px solid transparent;
  border-bottom: 1px solid var(--line);
  padding: 9px 14px 9px 13px; cursor: pointer;
}
.preset-btn:hover { color: var(--pink); }
.preset-btn.active { border-left-color: var(--pink); color: var(--pink); }
.preset-btn .pt { font: 700 12px/1.2 var(--mono); display: flex; justify-content: space-between; align-items: center; }
.preset-btn .pt .tag { font-size: 9px; padding: 1px 5px; border: 1px solid var(--line-strong); color: var(--muted); }
.preset-btn.active .pt .tag { border-color: var(--pink); color: var(--pink); }
.preset-btn .pe {
  font: 400 10.5px/1.3 var(--mono); color: var(--muted); margin-top: 2px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

.trace-wrap { flex: 0 0 32%; display: flex; flex-direction: column; min-height: 0; }
.trace { flex: 1; overflow-y: auto; padding: 6px 16px; font: 500 10.5px/1.5 var(--mono); }
.trace-row {
  padding: 4px 0; border-bottom: 1px solid var(--line);
  display: flex; justify-content: space-between; gap: 8px;
}
.trace-row .rule { color: var(--ink); }
.trace-row .ratio { color: var(--blue); font-weight: 700; white-space: nowrap; }

.stage { position: relative; overflow: hidden; min-height: 0; background: var(--bg); cursor: grab; }
.stage:active { cursor: grabbing; }
#netCanvas { display: block; width: 100%; height: 100%; }

.stage-hud {
  position: absolute; top: 14px; left: 16px; right: 16px;
  pointer-events: none;
  display: flex; justify-content: space-between; align-items: flex-start; gap: 16px;
}
.compiler-card {
  pointer-events: auto;
  background: var(--bg); border: 1px solid var(--line-strong);
  padding: 8px 10px; width: min(500px, 52vw);
}
.compiler-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.compiler-card .kicker {
  font: 700 10px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted);
}
.compiler-row { display: flex; gap: 8px; align-items: stretch; }
.expr-input {
  flex: 1; background: var(--bg); color: var(--ink);
  border: 1px solid var(--line-strong); padding: 6px 10px;
  font: 600 13px/1.25 var(--mono); outline: none;
}
.expr-input:focus { border-color: var(--blue); }
.compile-btn {
  font: 700 11px/1 var(--mono); text-transform: uppercase; letter-spacing: .06em;
  background: transparent; color: var(--ink); border: 1px solid var(--line-strong); padding: 0 12px; cursor: pointer;
}
.compile-btn:hover { border-color: var(--pink); color: var(--pink); }
.compiler-card .desc { font: 400 11.5px/1.4 var(--sans); color: var(--muted); margin-top: 6px; }
.compiler-err { font: 600 11px/1.3 var(--mono); color: var(--pink); margin-top: 4px; display: none; }

.metrics-card {
  pointer-events: auto;
  background: var(--bg); border: 1px solid var(--line);
  padding: 8px 12px; display: flex; gap: 16px; align-items: center;
  font: 600 11px/1.2 var(--mono);
}
.metric { display: flex; flex-direction: column; gap: 2px; }
.metric .ml { font-size: 9px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
.metric .mv { font-size: 13.5px; font-weight: 700; color: var(--ink); }
.metric .mv.pink { color: var(--pink); }
.metric .mv.ok { color: var(--blue); }

.hover-tip {
  position: absolute; bottom: 12px; left: 16px;
  pointer-events: none;
  background: var(--bg); border: 1px solid var(--pink);
  padding: 7px 11px; font: 600 11.5px/1.4 var(--mono);
  display: none; max-width: 460px;
}
.hover-tip .ht-sub { color: var(--muted); font-weight: 400; font-size: 10.5px; margin-top: 2px; }

.step-toast {
  position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%);
  pointer-events: none;
  background: var(--bg); border: 1px solid var(--line-strong);
  border-left: 3px solid var(--pink);
  padding: 8px 14px; max-width: min(640px, calc(100% - 32px));
  opacity: 0; transition: opacity .18s ease;
  z-index: 6;
}
.step-toast.show { opacity: 1; }
.step-toast.done { border-left-color: var(--blue); }
.step-toast .st-head {
  font: 700 10px/1.2 var(--mono); letter-spacing: .1em; text-transform: uppercase;
  color: var(--pink); margin-bottom: 3px;
}
.step-toast.done .st-head { color: var(--blue); }
.step-toast .st-body { font: 500 12.5px/1.4 var(--sans); color: var(--ink); }

.right-dock {
  position: absolute; bottom: 12px; right: 16px;
  display: flex; flex-direction: column; gap: 10px; align-items: flex-end;
  pointer-events: none;
}
.dock-card {
  pointer-events: auto;
  background: var(--bg); border: 1px solid var(--line-strong);
  padding: 8px 10px; width: 206px;
}
.dock-head {
  font: 700 9.5px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase;
  color: var(--blue); margin-bottom: 6px; display: flex; justify-content: space-between;
}
#kanCanvas { display: block; width: 182px; height: 126px; }
.kan-box { display: none; }
.kan-box.show { display: block; }

.controls {
  grid-column: 2;
  background: var(--bg);
  border-top: 1px solid var(--line-strong);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 16px; gap: 10px; overflow-x: auto;
}
.ctrl-group { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.btn {
  font: 600 11px/1 var(--mono); letter-spacing: .04em; text-transform: uppercase;
  background: transparent; color: var(--ink);
  border: 1px solid var(--line-strong); padding: 7px 10px; cursor: pointer;
  white-space: nowrap;
}
.btn:hover { border-color: var(--pink); color: var(--pink); }
.btn.primary { background: var(--pink); color: #fff; border-color: var(--pink); }
.btn.primary:hover { background: var(--blue); border-color: var(--blue); color: #fff; }
.btn.on { border-color: var(--blue); color: var(--blue); }
.btn.hyp.on { border-color: var(--blue); color: var(--blue); }

.speed-wrap {
  display: flex; align-items: center; gap: 6px;
  font: 600 10px var(--mono); color: var(--muted);
  margin-left: 4px;
}
.speed-wrap input[type=range] { width: 58px; accent-color: var(--blue); cursor: pointer; }

.scope-wrap {
  display: flex; align-items: center; gap: 8px;
  border-left: 1px solid var(--line); padding: 2px 0 2px 10px; background: transparent;
}
#scopeCanvas { width: 68px; height: 22px; display: block; }
.ratio-readout { font: 600 10.5px/1.2 var(--mono); color: var(--blue); min-width: 100px; }
.ratio-readout span { display: block; font-size: 9px; color: var(--muted); font-weight: 500; }

select.tuning {
  font: 600 10.5px var(--mono); background: var(--bg); color: var(--ink);
  border: 1px solid var(--line-strong); padding: 6px 6px; cursor: pointer;
}

@media (max-width: 880px) {
  .workspace { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr) 54px; }
  .sidebar { grid-row: 1; max-height: 160px; border-right: 0; border-bottom: 1px solid var(--line-strong); }
  .trace-wrap, .right-dock, .metrics-card { display: none; }
  .controls { grid-column: 1; }
  .compiler-card { width: calc(100vw - 28px); }
  nav .mark span { display: none; }
}
html.embed nav, html.embed .sidebar, html.embed .compiler-top, html.embed .desc, html.embed .metrics-card, html.embed .right-dock, html.embed #tuningSel, html.embed .scope-wrap, html.embed #btnTheme { display: none !important; }
html.embed .workspace { grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) 48px; height: 100vh; }
html.embed .compiler-card { width: min(270px, calc(100vw - 24px)); padding: 5px 7px; }
html.embed .expr-input { padding: 4px 8px; font-size: 12px; }
html.embed .controls { grid-column: 1; padding: 0 12px; gap: 6px; }
html.hero .compiler-card, html.hero #granSel, html.hero #btnHyp, html.hero #btnFit, html.hero .speed-wrap, html.hero #btnSyn { display: none !important; }
html.hero .step-toast { bottom: 10px; padding: 6px 10px; max-width: calc(100% - 20px); }
html.hero .step-toast .st-body { font-size: 11.5px; }
</style>
