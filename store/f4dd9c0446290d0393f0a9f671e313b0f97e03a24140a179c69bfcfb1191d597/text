  }
  if ((m = s.match(/^prove\s+(\d+)\s*\+\s*(\d+)\s*=\s*(\d+)$/i))) {
    const a = Math.min(8, parseInt(m[1], 10)), b = Math.min(8, parseInt(m[2], 10)), c = Math.min(16, parseInt(m[3], 10));
    const root = net.add('ROOT', 'OUT', `${a}+${b}≡${c}`, 1);
    const eq = net.add('O_EQ', '≡', 'O_EQ', 3);
    const add = net.add('O_ADD', '+', 'O_ADD', 3);
    const va = buildPeano(net, a), vb = buildPeano(net, b), vc = buildPeano(net, c);
    net.wire(root, 0, eq, 2); net.wire(eq, 0, add, 2); net.wire(eq, 1, vc, 0);
    net.wire(add, 0, va, 0); net.wire(add, 1, vb, 0);
