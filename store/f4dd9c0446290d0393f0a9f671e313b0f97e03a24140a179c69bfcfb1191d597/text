    const nums = [parseInt(m[2],10), parseInt(m[3],10), parseInt(m[4],10), parseInt(m[5],10)];
    const root = net.add('ROOT', 'OUT', isCert ? 'Σ(Sorted,≡)' : 'Sorted', 1);
    if (gran === 'macro') {
      const topCmp = net.add('O_CMP', isCert ? 'cert-merge' : 'merge', 'O_CMP', 2, 0, 0, { stage: 'merge', cert: isCert });
      const topPair = net.add('V_PAIR', 'pair', '2×2', 3);
      const cL = net.add('O_CMP', 'cmp', 'O_CMP', 2), pL = net.add('V_PAIR', 'pair', 'L', 3);
      const cR = net.add('O_CMP', 'cmp', 'O_CMP', 2), pR = net.add('V_PAIR', 'pair', 'R', 3);
      const n0 = net.add('V_WORD', String(nums[0]), 'Nat', 1, 0, 0, { n: nums[0] });
      const n1 = net.add('V_WORD', String(nums[1]), 'Nat', 1, 0, 0, { n: nums[1] });
      const n2 = net.add('V_WORD', String(nums[2]), 'Nat', 1, 0, 0, { n: nums[2] });
      const n3 = net.add('V_WORD', String(nums[3]), 'Nat', 1, 0, 0, { n: nums[3] });
      net.wire(root, 0, topCmp, 1); net.wire(topCmp, 0, topPair, 0);
      net.wire(topPair, 1, cL, 1); net.wire(cL, 0, pL, 0); net.wire(pL, 1, n0, 0); net.wire(pL, 2, n1, 0);
      net.wire(topPair, 2, cR, 1); net.wire(cR, 0, pR, 0); net.wire(pR, 1, n2, 0); net.wire(pR, 2, n3, 0);
