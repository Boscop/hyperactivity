  }
  if ((m = s.match(/^mul\s+(\d+)\s+(\d+)$/i))) {
    const a = Math.min(6, parseInt(m[1], 10)), b = Math.min(6, parseInt(m[2], 10));
    const root = net.add('ROOT', 'OUT', `${a}×${b}`, 1);
    const op = net.add('O_MUL', '×', 'O_MUL', 3);
