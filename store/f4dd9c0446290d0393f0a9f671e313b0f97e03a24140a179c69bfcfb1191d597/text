        const nx = -dy/len, ny = dx/len;
        for (let s = 0; s <= steps; s++) {
          const t = s/steps, w = Math.sin(t*Math.PI*3 + animTime*5) * 4 * Math.sin(t*Math.PI);
          const px = sp1.x + dx*t + nx*w, py = sp1.y + dy*t + ny*w;
          if (s === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        }
        ctx.stroke();
      } else {
        const midY = (sp1.y + sp2.y) / 2;
        ctx.beginPath();
        ctx.moveTo(sp1.x, sp1.y);
        ctx.bezierCurveTo(sp1.x, midY, sp2.x, midY, sp2.x, sp2.y);
        ctx.stroke();
      }
      ctx.restore();
    }
  }

  // Shockwaves
  for (let i = net.sparks.length - 1; i >= 0; i--) {
    const sp = net.sparks[i]; sp.r += 4.2; sp.alpha -= 0.05;
    if (sp.alpha <= 0) { net.sparks.splice(i, 1); continue; }
    let sx, sy;
    if (hypMode) {
      const m = mobius(sp.hx, sp.hy, hypPan.x, hypPan.y);
      sx = disk.cx + m.x * disk.R; sy = disk.cy + m.y * disk.R;
    } else {
      sx = W/2 + (sp.x + cam.x) * cam.zoom; sy = H/2 + (sp.y + cam.y) * cam.zoom;
    }
    ctx.save(); ctx.strokeStyle = '#ff0a94'; ctx.globalAlpha = sp.alpha; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(sx, sy, sp.r, 0, Math.PI*2); ctx.stroke(); ctx.restore();
  }

  // Cells: strictly 2 accents — Electric Pink (Values V_*) + Gemini Blue (Ops O_*)
  for (const c of net.cells.values()) {
    const sp = cellScreenPos(c);
    const opBlue = isLight ? '#1a73e8' : '#4da3ff';
    const accent = synMode ? synColorFor(c.label) : (c.polarity === 'val' ? '#ff0a94' : opBlue);
    drawSpaciousCell(ctx, c, sp.x, sp.y, sp.scale, isLight, ink, accent, hoveredCell === c);
  }

  if (net.horizonHit) {
    ctx.save();
    ctx.fillStyle = '#ff0a94';
    ctx.font = '700 11px ui-monospace, Menlo, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('LAZY HORIZON REACHED (96 CELLS) · CLICK ANY PINK PAIR TO EXPAND ON DEMAND', W / 2, H - 14);
    ctx.restore();
  }

  drawKanBox();
  drawScope();
  requestAnimationFrame(draw);
}

// ============================================================================
// 8. SUB-CANVASES (MUSIC OF THE SPHERES, CAUSAL DAG, KAN BOX, OSCILLOSCOPE)
// ============================================================================
function drawSphere() {
  const W = sphereCanvas.width, H = sphereCanvas.height, cx = W/2, cy = H/2, R = 100;
  const isLight = !document.documentElement.classList.contains('dark');
  spctx.clearRect(0, 0, W, H);
  spctx.strokeStyle = isLight ? 'rgba(0,0,0,0.2)' : 'rgba(255,255,255,0.2)'; spctx.lineWidth = 2;
  spctx.beginPath(); spctx.arc(cx, cy, R, 0, Math.PI*2); spctx.stroke();
  spctx.beginPath(); spctx.arc(cx, cy, R*0.42, 0, Math.PI*2); spctx.stroke();
  for (let i = activeChords.length - 1; i >= 0; i--) {
    const ch = activeChords[i]; ch.alpha -= 0.014;
    if (ch.alpha <= 0) { activeChords.splice(i, 1); continue; }
    const n1 = SPHERE_NODES.find(n => n.key === ch.key) || SPHERE_NODES[0], n0 = SPHERE_NODES[0];
    const x1 = cx + Math.cos(n1.ang)*R, y1 = cy + Math.sin(n1.ang)*R;
    const x0 = cx + Math.cos(n0.ang)*R, y0 = cy + Math.sin(n0.ang)*R;
    spctx.save(); spctx.strokeStyle = ch.color; spctx.globalAlpha = ch.alpha; spctx.lineWidth = 3.5;
    spctx.beginPath(); spctx.moveTo(cx, cy); spctx.lineTo(x1, y1); spctx.lineTo(x0, y0); spctx.stroke();
    spctx.fillStyle = ch.color; spctx.beginPath(); spctx.arc(x1, y1, 8, 0, Math.PI*2); spctx.fill(); spctx.restore();
  }
  spctx.fillStyle = '#ff0a94'; spctx.beginPath(); spctx.arc(cx, cy, 5, 0, Math.PI*2); spctx.fill();
  spctx.font = '700 16px ui-monospace, Menlo, monospace'; spctx.textAlign = 'center'; spctx.textBaseline = 'middle';
  SPHERE_NODES.forEach(n => {
    const x = cx + Math.cos(n.ang)*R, y = cy + Math.sin(n.ang)*R;
    const lx = cx + Math.cos(n.ang)*(R + 25), ly = cy + Math.sin(n.ang)*(R + 21);
    spctx.fillStyle = isLight ? '#000' : '#fff'; spctx.beginPath(); spctx.arc(x, y, 4, 0, Math.PI*2); spctx.fill();
    spctx.fillStyle = n.key === 'normal' ? '#ff0a94' : (isLight ? '#444' : '#aaa'); spctx.fillText(n.label, lx, ly);
  });
}

function drawCausalDag() {
  const W = causalCanvas.width, H = causalCanvas.height, isLight = !document.documentElement.classList.contains('dark');
  cctx.clearRect(0, 0, W, H);
  if (!net.events.length) {
    cctx.fillStyle = isLight ? '#999' : '#444'; cctx.font = '600 18px ui-monospace, Menlo, monospace';
    cctx.textAlign = 'center'; cctx.fillText('AWAITING INTERACTION EVENTS', W/2, H/2 + 6); return;
  }
  const byDepth = new Map();
  net.events.forEach(ev => { if (!byDepth.has(ev.depth)) byDepth.set(ev.depth, []); byDepth.get(ev.depth).push(ev); });
  const depths = [...byDepth.keys()].sort((a,b) => a - b), pos = new Map();
  depths.forEach((d, di) => {
    const row = byDepth.get(d);
    const x = 36 + (depths.length === 1 ? (W - 72)/2 : (di / (depths.length - 1)) * (W - 72));
    row.forEach((ev, ri) => {
      const y = 28 + (row.length === 1 ? (H - 56)/2 : (ri / (row.length - 1)) * (H - 56));
      pos.set(ev.id, { x, y });
    });
  });
  cctx.strokeStyle = isLight ? 'rgba(0,0,0,0.35)' : 'rgba(255,255,255,0.35)'; cctx.lineWidth = 2;
  net.events.forEach(ev => {
    const p2 = pos.get(ev.id);
    ev.parents.forEach(pid => { const p1 = pos.get(pid); if (p1 && p2) { cctx.beginPath(); cctx.moveTo(p1.x, p1.y); cctx.lineTo(p2.x, p2.y); cctx.stroke(); } });
  });
  net.events.forEach(ev => {
    const p = pos.get(ev.id);
    cctx.fillStyle = (ev.key === 'comp' || ev.key === 'papp' || ev.key === 'unglue') ? '#ffd400' : '#ff0a94';
    cctx.beginPath(); cctx.arc(p.x, p.y, 7, 0, Math.PI*2); cctx.fill();
  });
}

function drawKanBox() {
  if (!net.kanMode) return;
  const W = kanCanvas.width, H = kanCanvas.height, isLight = !document.documentElement.classList.contains('dark');
  kctx.clearRect(0, 0, W, H);
  const p = net.kanProgress;
  document.getElementById('kanPhase').textContent = `j = ${p.toFixed(2)}`;
  document.getElementById('kanTitle').textContent = net.kanMode === 'univalence' ? 'GLUE / UA FIBER' : net.kanMode === 'path' ? 'INTERVAL I = [0,1]' : 'KAN OPEN BOX';
  const x0 = 60, x1 = W - 60, y0 = H - 40, y1 = 40;
  if (p > 0) { const curY = y0 - (y0 - y1)*p; kctx.fillStyle = 'rgba(255,10,148,0.16)'; kctx.fillRect(x0, curY, x1 - x0, y0 - curY); }
  kctx.strokeStyle = '#00e5ff'; kctx.lineWidth = 4; kctx.beginPath(); kctx.moveTo(x0, y0); kctx.lineTo(x0, y1); kctx.stroke();
  kctx.strokeStyle = '#ffd400'; kctx.lineWidth = 4; kctx.beginPath(); kctx.moveTo(x1, y0); kctx.lineTo(x1, y1); kctx.stroke();
  kctx.strokeStyle = isLight ? '#000' : '#fff'; kctx.lineWidth = 4; kctx.beginPath(); kctx.moveTo(x0, y0); kctx.lineTo(x1, y0); kctx.stroke();
  const lidY = y0 - (y0 - y1)*p;
  kctx.strokeStyle = '#ff0a94'; kctx.lineWidth = p >= 1 ? 5 : 3; kctx.setLineDash(p >= 1 ? [] : [8,6]);
  kctx.beginPath(); kctx.moveTo(x0, lidY); kctx.lineTo(x1, lidY); kctx.stroke(); kctx.setLineDash([]);
  kctx.font = '700 18px ui-monospace, Menlo, monospace'; kctx.textAlign = 'center';
  kctx.fillStyle = isLight ? '#000' : '#fff'; kctx.fillText(net.kanMode === 'univalence' ? 'true : Bool' : 'p(i)', W/2, y0 + 22);
  kctx.fillStyle = '#00e5ff'; kctx.fillText('i=0', x0 - 28, (y0 + y1)/2);
  kctx.fillStyle = '#ffd400'; kctx.fillText('i=1', x1 + 28, (y0 + y1)/2);
  if (p >= 1) { kctx.fillStyle = '#ff0a94'; kctx.fillText(net.kanMode === 'univalence' ? 'false : Bool' : 'p ∙ q', W/2, y1 - 12); }
}

function drawScope() {
  const W = scopeCanvas.width, H = scopeCanvas.height;
  sctx.clearRect(0, 0, W, H); sctx.strokeStyle = '#ff0a94'; sctx.lineWidth = 2.5; sctx.beginPath();
  if (audio.analyser && (audio.enabled || audio.droneOn)) {
    const buf = new Uint8Array(audio.analyser.frequencyBinCount);
    audio.analyser.getByteTimeDomainData(buf);
    for (let i = 0; i < buf.length; i++) {
      const x = (i / (buf.length - 1)) * W, y = (buf[i] / 255) * H;
      if (i === 0) sctx.moveTo(x, y); else sctx.lineTo(x, y);
    }
  } else { sctx.moveTo(0, H/2); sctx.lineTo(W, H/2); }
  sctx.stroke();
}

// ============================================================================
// 9. POINTER & MÖBIUS INTERACTION
// ============================================================================
function findHitScreen(sx, sy) {
  for (const pair of net.activePairs()) {
    const a = cellScreenPos(pair.op), b = cellScreenPos(pair.val);
    const dx = b.x - a.x, dy = b.y - a.y, len2 = dx*dx + dy*dy + 0.01;
    const t = Math.max(0, Math.min(1, ((sx - a.x)*dx + (sy - a.y)*dy) / len2));
    if (Math.hypot(sx - (a.x + t*dx), sy - (a.y + t*dy)) < 18) return { type:'pair', pair };
  }
  for (const c of net.cells.values()) {
    const sp = cellScreenPos(c);
    if (Math.hypot(sx - sp.x, sy - sp.y) < 32 * sp.scale) return { type:'cell', cell:c };
  }
  return null;
}

canvas.addEventListener('pointermove', e => {
  const rect = canvas.getBoundingClientRect(), sx = e.clientX - rect.left, sy = e.clientY - rect.top;
  if (dragCell && !hypMode) {
    dragCell.x = (sx - rect.width/2)/cam.zoom - cam.x; dragCell.tx = dragCell.x;
    dragCell.y = (sy - rect.height/2)/cam.zoom - cam.y; dragCell.ty = dragCell.y;
    return;
  }
  if (panStart) {
    if (hypMode) {
      const { R } = getDiskParams();
      const nx = panStart.hx - (e.clientX - panStart.x) / (R * 1.15);
      const ny = panStart.hy - (e.clientY - panStart.y) / (R * 1.15);
      const mag = Math.hypot(nx, ny);
      const clamp = mag > 0.88 ? 0.88 / mag : 1;
      hypPan.x = nx * clamp; hypPan.y = ny * clamp;
    } else {
      cam.x = panStart.cx + (e.clientX - panStart.x) / cam.zoom;
      cam.y = panStart.cy + (e.clientY - panStart.y) / cam.zoom;
    }
    return;
  }
  const hit = findHitScreen(sx, sy), tip = document.getElementById('hoverTip');
  hoveredPair = hit && hit.type === 'pair' ? hit.pair : null;
  hoveredCell = hit && hit.type === 'cell' ? hit.cell : null;
  if (hoveredPair) {
    const info = net.describeRule(hoveredPair.op, hoveredPair.val), pyth = PYTH[info.key] || PYTH.beta;
    canvas.style.cursor = 'pointer'; tip.style.display = 'block';
    tip.innerHTML = `<div>ACTIVE PAIR: ${info.text}</div><div class="ht-sub">Click to fire local step · ${pyth.name}</div>`;
  } else if (hoveredCell) {
    canvas.style.cursor = hypMode ? 'grab' : 'move'; tip.style.display = 'block';
    tip.innerHTML = `<div>${hoveredCell.kind} (${hoveredCell.label})</div><div class="ht-sub">polarity: ${hoveredCell.polarity} · ports: ${hoveredCell.ports.length}</div>`;
  } else { canvas.style.cursor = 'grab'; tip.style.display = 'none'; }
});

canvas.addEventListener('pointerdown', e => {
  const rect = canvas.getBoundingClientRect(), sx = e.clientX - rect.left, sy = e.clientY - rect.top;
  const hit = findHitScreen(sx, sy);
  if (hit && hit.type === 'pair') {
    net.depth++;
    const narr = net.narrate(hit.pair.op, hit.pair.val);
    const info = net.firePair(hit.pair.op.id, hit.pair.val.id);
    if (info) audio.playRule(info.key, 0, 1);
    const done = net.activePairs().length === 0;
    if (done) setTimeout(() => audio.playNormalForm(), 160);
    showStepToast(done ? `NORMAL FORM ≡ · W=${net.work}` : `LOCAL CLICK · W=${net.work}`, done ? `${narr} Computation complete.` : narr, done);
    updateHUD(); return;
  }
  if (hit && hit.type === 'cell' && !hypMode) { dragCell = hit.cell; canvas.setPointerCapture(e.pointerId); return; }
  panStart = { x: e.clientX, y: e.clientY, cx: cam.x, cy: cam.y, hx: hypPan.x, hy: hypPan.y };
  canvas.setPointerCapture(e.pointerId);
});
canvas.addEventListener('pointerup', () => { dragCell = null; panStart = null; });
canvas.addEventListener('wheel', e => {
  e.preventDefault();
  cam.zoom = Math.max(0.4, Math.min(2.5, cam.zoom * (e.deltaY < 0 ? 1.09 : 0.92)));
}, { passive: false });

// ============================================================================
// 10. UI CONTROLS
// ============================================================================
const presetList = document.getElementById('presetList');
PRESETS.forEach(p => {
  const btn = document.createElement('button');
  btn.className = 'preset-btn'; btn.dataset.id = p.id;
  btn.innerHTML = `<div class="pt"><span>${p.title}</span>${p.tag ? `<span class="tag">${p.tag}</span>` : ''}</div><div class="pe">${p.expr}</div>`;
  btn.onclick = () => loadPreset(p);
  presetList.appendChild(btn);
});

document.getElementById('btnCompile').onclick = () => compileExpression(document.getElementById('exprInput').value);
document.getElementById('exprInput').addEventListener('keydown', e => { if (e.key === 'Enter') compileExpression(e.target.value); });

let toastTimer = null, seqMode = false;
function showStepToast(head, body, isDone) {
  const el = document.getElementById('stepToast');
  if (!el) return;
  document.getElementById('stHead').textContent = head;
  document.getElementById('stBody').textContent = body;
  el.classList.toggle('done', !!isDone);
  el.classList.add('show');
  if (toastTimer) clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), isDone ? 5500 : 4200);
}
function hideStepToast() {
  const el = document.getElementById('stepToast');
  if (el) el.classList.remove('show');
}

function stopPlay() {
  playing = false; if (playTimer) clearInterval(playTimer); playTimer = null;
  document.getElementById('btnPlay').textContent = '▶ Play'; updateHUD();
}
function startPlayLoop() {
  const ms = 1320 - parseInt(document.getElementById('speedSlider').value, 10);
  if (playTimer) clearInterval(playTimer);
  playTimer = setInterval(() => {
    const fired = net.stepParallel(seqMode); updateHUD();
    if (!fired || net.activePairs().length === 0) stopPlay();
  }, Math.max(110, ms));
}
document.getElementById('btnPlay').onclick = () => {
  if (playing) { stopPlay(); return; }
  if (net.activePairs().length === 0) compileExpression(document.getElementById('exprInput').value, currentPreset);
  playing = true; document.getElementById('btnPlay').textContent = '❚❚ Pause'; updateHUD();
  const fired = net.stepParallel(seqMode); updateHUD();
  if (!fired || net.activePairs().length === 0) { stopPlay(); return; }
  startPlayLoop();
};
document.getElementById('speedSlider').oninput = () => { if (playing) startPlayLoop(); };
document.getElementById('btnStep').onclick = () => { stopPlay(); net.stepParallel(seqMode); updateHUD(); };
document.getElementById('btnSeq').onclick = function() {
  seqMode = !seqMode;
  this.textContent = seqMode ? '→ Sequential' : '∥ Parallel';
  this.classList.toggle('on', seqMode);
  showStepToast(seqMode ? 'SEQUENTIAL MODE' : 'PARALLEL MODE',
    seqMode ? 'Step & Play now fire 1 local rewrite at a time so you can trace every wire.' : 'Step & Play now fire all disjoint active pairs simultaneously.', false);
};
const granSelEl = document.getElementById('granSel');
if (granSelEl) granSelEl.onchange = function() {
  compileExpression(document.getElementById('exprInput').value, currentPreset);
  const g = this.value;
  const msg = g === 'atomic' ? 'Unfolded comparisons down to atomic Peano S/Z peeling.' :
              g === 'structural' ? 'Unfolded merge into element-by-element Cons (::) list recursion.' :
              'Collapsed to Macro architectural stages to highlight O(log n) parallel depth.';
  showStepToast(`GRANULARITY · ${g.toUpperCase()}`, msg, false);
};
document.getElementById('btnReset').onclick = () => { hideStepToast(); compileExpression(document.getElementById('exprInput').value, currentPreset); };
document.getElementById('btnHyp').onclick = () => setHypMode(!hypMode);
document.getElementById('btnFit').onclick = () => { cam = { x: 0, y: 40, zoom: 1 }; hypPan = { x: 0, y: 0 }; };

document.getElementById('btnSound').onclick = function() {
  audio.enabled = !audio.enabled; this.textContent = audio.enabled ? '♫ Sound' : '♫ Muted'; this.classList.toggle('on', audio.enabled);
};
const btnDroneEl = document.getElementById('btnDrone');
if (btnDroneEl) btnDroneEl.onclick = function() { this.classList.toggle('on', audio.toggleDrone()); };
const tuningSelEl = document.getElementById('tuningSel');
if (tuningSelEl) tuningSelEl.onchange = function() { audio.setBase(parseFloat(this.value)); };
document.getElementById('btnSyn').onclick = function() { synMode = !synMode; this.classList.toggle('on', synMode); };
function toggleHxTheme() {
  const isDark = document.documentElement.classList.toggle('dark');
  try { localStorage.setItem('hxTheme', isDark ? 'dark' : 'light'); } catch (e) {}
}
document.getElementById('btnTheme').onclick = toggleHxTheme;
const navThemeBtn = document.getElementById('navTheme');
if (navThemeBtn) navThemeBtn.onclick = toggleHxTheme;
window.addEventListener('storage', e => {
  if (e.key === 'hxTheme') document.documentElement.classList.toggle('dark', e.newValue === 'dark');
});
window.addEventListener('message', e => {
  if (e.data && typeof e.data.hxTheme === 'string') {
    document.documentElement.classList.toggle('dark', e.data.hxTheme === 'dark');
  }
});
document.addEventListener('keydown', e => {
  if (document.activeElement && document.activeElement.tagName === 'INPUT') return;
  if (e.key === 's' || e.key === 'S') { synMode = !synMode; document.getElementById('btnSyn').classList.toggle('on', synMode); }
  else if (e.key === 'h' || e.key === 'H') setHypMode(!hypMode);
  else if (e.key === ' ') { e.preventDefault(); document.getElementById('btnStep').click(); }
});

const qParams = new URLSearchParams(location.search);
const qPreset = qParams.get('preset');
loadPreset(PRESETS.find(p => p.id === qPreset) || PRESETS.find(p => p.id === 'add') || PRESETS[0]);
if (qParams.get('autoplay') === '1') {
  audio.enabled = false;
  const bs = document.getElementById('btnSound');
  if (bs) { bs.textContent = '♫ Muted'; bs.classList.remove('on'); }
  document.getElementById('speedSlider').value = '360';
  setTimeout(() => { if (!playing) document.getElementById('btnPlay').click(); }, 450);
}
requestAnimationFrame(draw);
</script>
