      net.wire(root, 0, sigma, 0); net.wire(sigma, 1, merge, 2); net.wire(sigma, 2, wit, 0);
    } else {
      net.wire(root, 0, merge, 2);
    }
    if (gran === 'atomic') {
      // Atomic: even the leaf comparisons unfold into Peano S/Z peeling (O_LEQ)!
      const a0 = Math.min(6, nums[0]), a1 = Math.min(6, nums[1]), a2 = Math.min(6, nums[2]), a3 = Math.min(6, nums[3]);
      const leqL = net.add('O_LEQ', '≤', 'Peano', 3, 0, 0, { a: a0, b: a1 });
      const leqR = net.add('O_LEQ', '≤', 'Peano', 3, 0, 0, { a: a2, b: a3 });
      net.wire(merge, 0, leqL, 2); net.wire(leqL, 0, buildPeano(net, a0), 0); net.wire(leqL, 1, buildPeano(net, a1), 0);
