ltw-fromNat : (a b : Nat) → ltw (fromNat a) (fromNat b) ≡ ltn a b
ltw-fromNat a =
  case a return λ y → (b : Nat) → ltw (fromNat y) (fromNat b) ≡ ltn y b of
    zero → λ b → (case b return λ z → ltw #0 (fromNat z) ≡ ltn zero z of zero → λ i → false; suc k → λ i → true)
    suc a1 → λ b → (case b return λ z → ltw (fromNat (suc a1)) (fromNat z) ≡ ltn (suc a1) z of zero → λ i → false; suc b1 → rec a1 b1)
