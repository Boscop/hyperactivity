-- three things each equal to one of two things: two of the three are equal. The pigeonhole, written out,
-- because it is what two-centredness comes down to and it needs no finiteness to state or to prove.
two-of-three : (A : Type 0) → (u : A) → (v : A) → (x : A) → (y : A) → (z : A) → Sum (x ≡ u) (x ≡ v) → Sum (y ≡ u) (y ≡ v) → Sum (z ≡ u) (z ≡ v) → Sum (x ≡ y) (Sum (y ≡ z) (x ≡ z))
two-of-three A u v x y z sx sy sz =
  case sx of
    inl px → (case sy of
      inl py → inl (concat px (sym py))
      inr py → (case sz of
        inl pz → inr (inr (concat px (sym pz)))
        inr pz → inr (inl (concat py (sym pz)))))
    inr px → (case sy of
      inr py → inl (concat px (sym py))
      inl py → (case sz of
        inr pz → inr (inr (concat px (sym pz)))
        inl pz → inr (inl (concat py (sym pz)))))
