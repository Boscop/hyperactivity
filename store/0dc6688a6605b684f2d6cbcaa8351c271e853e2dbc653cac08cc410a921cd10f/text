-- a sed substitution of a character's bytes by others (none whose replacement sed would read as syntax)
e-ucd-rule : Word → List Word → List Word
e-ucd-rule cp repl = if h-null (e-filter-w (λ c → orB (weq c #47) (orB (weq c #38) (orB (weq c #92) (weq c #10)))) repl)
  then list-append "s/" (list-append (e-utf8 cp) (list-append "/" (list-append repl "/g"))) else nil
