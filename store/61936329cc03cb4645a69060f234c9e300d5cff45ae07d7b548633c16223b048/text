-- from Pd + Y = X + Nd and Pd ≤ Nd, X ≤ Y
le-transfer : (Pd Nd X Y : Nat) → plus Pd Y ≡ plus X Nd → le (plus Pd zero) Nd → le X Y
le-transfer Pd Nd X Y zq h = (fst h , plus-cancel-l Pd (plus (fst h) X) Y
  (transN (symN (plus-assoc Pd (fst h) X))
  (transN (plus-comm (plus Pd (fst h)) X)
  (transN (congN (plus X) (plus-comm Pd (fst h)))
  (transN (congN (plus X) (transN (congN (plus (fst h)) (symN (plus-zero Pd))) (snd h)))
  (symN zq))))))
