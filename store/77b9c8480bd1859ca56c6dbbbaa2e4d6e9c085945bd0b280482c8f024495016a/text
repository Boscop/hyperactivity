pfold-sec : (I : Type 2) (Ln : I → I) (K : I → Type 1) (A : PAlg I Ln K) (σs : (iq : I) → K iq → K (Ln iq)) →
  (c0 : (iq : I) (x : K iq) → PathP (λ t → K iq) (fst A iq (σs iq x)) x) →
  (c1 : (iq : I) (x : K iq) → PathP (λ t → K iq) (fst (snd A) iq (σs iq x)) x) →
  (cr : (iq : I) (x : K iq) → PathP (λ t → K (Ln iq)) (fst (snd (snd A)) iq (σs iq x)) (σs iq x)) →
  (cm : (iq : I) (x : K iq) → PathP (λ t → K (Ln (Ln iq))) (fst (snd (snd (snd A))) iq (σs iq x)) (σs (Ln iq) (σs iq x))) →
  (cj : (iq : I) (x : K iq) → PathP (λ t → K (Ln (Ln iq))) (fst (snd (snd (snd (snd A)))) iq (σs iq x)) (σs (Ln iq) (σs iq x))) →
  (cv : (kq : Word) (iq : I) (x : K iq) → PathP (λ t → K iq) (snd (snd (snd (snd (snd A)))) kq iq (σs iq x)) x) →
  (r : IEx) (i : I) (x : K i) → PathP (λ t → K i) (pfold I Ln K A r i (σs i x)) x
pfold-sec I Ln K A σs c0 c1 cr cm cj cv ix0 i x = c0 i x
pfold-sec I Ln K A σs c0 c1 cr cm cj cv ix1 i x = c1 i x
pfold-sec I Ln K A σs c0 c1 cr cm cj cv (ixv k) i x = cv k i x
pfold-sec I Ln K A σs c0 c1 cr cm cj cv (ixneg r) i x =
  pcat (K i) (pfold I Ln K A r i (fst (snd (snd A)) i (σs i x))) (pfold I Ln K A r i (σs i x)) x
    (λ t → pfold I Ln K A r i (cr i x t)) (pfold-sec I Ln K A σs c0 c1 cr cm cj cv r i x)
pfold-sec I Ln K A σs c0 c1 cr cm cj cv (ixmeet r s) i x =
  pcat (K i) (pfold I Ln K A r i (pfold I Ln K A s (Ln i) (fst (snd (snd (snd A))) i (σs i x)))) (pfold I Ln K A r i (σs i x)) x
    (λ t → pfold I Ln K A r i
       (pcat (K (Ln i)) (pfold I Ln K A s (Ln i) (fst (snd (snd (snd A))) i (σs i x))) (pfold I Ln K A s (Ln i) (σs (Ln i) (σs i x))) (σs i x)
          (λ u → pfold I Ln K A s (Ln i) (cm i x u)) (pfold-sec I Ln K A σs c0 c1 cr cm cj cv s (Ln i) (σs i x)) t))
    (pfold-sec I Ln K A σs c0 c1 cr cm cj cv r i x)
pfold-sec I Ln K A σs c0 c1 cr cm cj cv (ixjoin r s) i x =
  pcat (K i) (pfold I Ln K A r i (pfold I Ln K A s (Ln i) (fst (snd (snd (snd (snd A)))) i (σs i x)))) (pfold I Ln K A r i (σs i x)) x
    (λ t → pfold I Ln K A r i
       (pcat (K (Ln i)) (pfold I Ln K A s (Ln i) (fst (snd (snd (snd (snd A)))) i (σs i x))) (pfold I Ln K A s (Ln i) (σs (Ln i) (σs i x))) (σs i x)
          (λ u → pfold I Ln K A s (Ln i) (cj i x u)) (pfold-sec I Ln K A σs c0 c1 cr cm cj cv s (Ln i) (σs i x)) t))
    (pfold-sec I Ln K A σs c0 c1 cr cm cj cv r i x)
