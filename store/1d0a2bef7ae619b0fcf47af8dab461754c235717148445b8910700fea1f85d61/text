-- the driver's branch table as a statement (2026-11-18): true of a command exactly when src/drivers.c
-- holds a branch that performs it. The driver's remaining "not a command of W" is unreachable because
-- w-driver-performs-all proves this true of every command of W; and a command added to WCmd without a
-- branch in the driver has to be written false here, which w-driver-performs-all then refuses to check,
-- so the core and this statement cannot drift apart silently
w-performed : WCmd → Bool
w-performed c = case c return (λ _ → Bool) of
  w-now → true
  w-write fd n b → true
  w-read fd n → true
  w-sleep ns → true
  w-exit ec → true
  w-open n p f m → true
  w-close fd → true
  w-load a → true
  w-store a v → true
  w-cas a o nw → true
  w-fence → true
  w-sys nr a1 a2 a3 a4 a5 a6 → true
  w-alloc n → true
  w-load8 a → true
  w-store8 a v → true
  w-spawn a e o → true
  w-fd-write fd t → true
  w-file-read-named p → true
  w-file-write-named p t → true
  w-free a → true
  w-snapshot n a → true
