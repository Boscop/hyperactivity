-- 1. Exact 4-Electron Hall–Post Partition (N = 4, 6 pairs, weight 1/(N-1) = 1/3):
--    Σ_{i=1}^4 (t_i - Z u_i) + Σ_{i<j} v_{ij}
--      = Σ_{1≤i<j≤4} ((1/3)(t_i + t_j) - (Z/3)(u_i + u_j) + v_{ij}).
--    Variables (0..14): Z, t1..t4 (1..4), u1..u4 (5..8), v12..v34 (9..14).
chem-hall-post-4e-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-hall-post-4e-poly A ad mu q vs =
  (λ g sub →
    let Z = g 0
        t1 = g 1; t2 = g 2; t3 = g 3; t4 = g 4
        u1 = g 5; u2 = g 6; u3 = g 7; u4 = g 8
        v12 = g 9; v13 = g 10; v14 = g 11; v23 = g 12; v24 = g 13; v34 = g 14
        q3 = q (fn-q 1 3)
        Z3 = mu q3 Z
        H4 = ad (ad (ad (sub t1 (mu Z u1)) (sub t2 (mu Z u2)))
                    (ad (sub t3 (mu Z u3)) (sub t4 (mu Z u4))))
                (ad (ad v12 (ad v13 v14)) (ad v23 (ad v24 v34)))
        p12 = ad (sub (mu q3 (ad t1 t2)) (mu Z3 (ad u1 u2))) v12
        p13 = ad (sub (mu q3 (ad t1 t3)) (mu Z3 (ad u1 u3))) v13
        p14 = ad (sub (mu q3 (ad t1 t4)) (mu Z3 (ad u1 u4))) v14
        p23 = ad (sub (mu q3 (ad t2 t3)) (mu Z3 (ad u2 u3))) v23
        p24 = ad (sub (mu q3 (ad t2 t4)) (mu Z3 (ad u2 u4))) v24
        p34 = ad (sub (mu q3 (ad t3 t4)) (mu Z3 (ad u3 u4))) v34
    in (H4 , ad (ad p12 (ad p13 p14)) (ad p23 (ad p24 p34))))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
