-- UNIVERSAL PROOF 3: BOGOLIUBOV-DE GENNES SUPERCONDUCTING GAP LOWER BOUND OVER ALL (xi delta : Nat)!
-- For ALL a b : Nat, b <= a + b; hence delta^2 <= xi^2 + delta^2 universally!
hm-le-refl : (a : Nat) → hm-le a a ≡ true
hm-le-refl zero    = refl
hm-le-refl (suc a) = hm-le-refl a

hm-le-suc-r : (a b : Nat) → hm-le a b ≡ true → hm-le a (suc b) ≡ true
hm-le-suc-r zero    _       _ = refl
hm-le-suc-r (suc _) zero    h = Empty-rec (true≢false (web-sym-b h))
hm-le-suc-r (suc a) (suc b) h = hm-le-suc-r a b h

hm-le-add-l : (a b : Nat) → hm-le b (hm-add a b) ≡ true
hm-le-add-l zero    b = hm-le-refl b
hm-le-add-l (suc a) b = hm-le-suc-r b (hm-add a b) (hm-le-add-l a b)

hm-thm-bcs-gap-bound : (xi delta : Nat) → hm-le (hm-sq delta) (hm-add (hm-sq xi) (hm-sq delta)) ≡ true
hm-thm-bcs-gap-bound xi delta = hm-le-add-l (hm-sq xi) (hm-sq delta)

-- UNIVERSAL PROOF 4: 3D EUCLIDEAN SQUARED-DISTANCE SYMMETRY OVER ALL Nat^6!
hm-absdiff-sym : (a b : Nat) → hm-absdiff a b ≡ hm-absdiff b a
hm-absdiff-sym zero    zero    = refl
hm-absdiff-sym zero    (suc _) = refl
hm-absdiff-sym (suc _) zero    = refl
hm-absdiff-sym (suc a) (suc b) = hm-absdiff-sym a b

hm-dist2-3d : Nat → Nat → Nat → Nat → Nat → Nat → Nat
hm-dist2-3d x1 y1 z1 x2 y2 z2 =
  hm-add (hm-sq (hm-absdiff x1 x2)) (hm-add (hm-sq (hm-absdiff y1 y2)) (hm-sq (hm-absdiff z1 z2)))

hm-thm-dist2-sym : (x1 y1 z1 x2 y2 z2 : Nat) →
  hm-dist2-3d x1 y1 z1 x2 y2 z2 ≡ hm-dist2-3d x2 y2 z2 x1 y1 z1
hm-thm-dist2-sym x1 y1 z1 x2 y2 z2 =
  λ i → hm-add (hm-sq (hm-absdiff-sym x1 x2 i))
               (hm-add (hm-sq (hm-absdiff-sym y1 y2 i))
                       (hm-sq (hm-absdiff-sym z1 z2 i)))

