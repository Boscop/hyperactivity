hm-add : Nat → Nat → Nat
hm-add zero    b = b
hm-add (suc a) b = suc (hm-add a b)

hm-mul : Nat → Nat → Nat
hm-mul zero    _ = zero
hm-mul (suc a) b = hm-add b (hm-mul a b)

hm-sq : Nat → Nat
hm-sq a = hm-mul a a

hm-le : Nat → Nat → Bool
hm-le zero    _       = true
hm-le (suc _) zero    = false
hm-le (suc a) (suc b) = hm-le a b

hm-lt : Nat → Nat → Bool
hm-lt a b = hm-le (suc a) b

hm-absdiff : Nat → Nat → Nat
hm-absdiff zero    b       = b
hm-absdiff (suc a) zero    = suc a
hm-absdiff (suc a) (suc b) = hm-absdiff a b

-- Universal Nat helpers
hm-add-zero-r : (a : Nat) → hm-add a zero ≡ a
hm-add-zero-r zero    = refl
hm-add-zero-r (suc a) = λ i → suc (hm-add-zero-r a i)

hm-add-suc-r : (a b : Nat) → hm-add a (suc b) ≡ suc (hm-add a b)
hm-add-suc-r zero    b = refl
hm-add-suc-r (suc a) b = λ i → suc (hm-add-suc-r a b i)

-- UNIVERSAL PROOF 1: TRANSITIVITY OF <= OVER ALL Nat^3
hm-le-trans : (a b c : Nat) → hm-le a b ≡ true → hm-le b c ≡ true → hm-le a c ≡ true
hm-le-trans zero    _       _       _   _   = refl
hm-le-trans (suc _) zero    _       hab _   = Empty-rec (true≢false (web-sym-b hab))
hm-le-trans (suc _) (suc _) zero    _   hbc = Empty-rec (true≢false (web-sym-b hbc))
hm-le-trans (suc a) (suc b) (suc c) hab hbc = hm-le-trans a b c hab hbc

-- UNIVERSAL PROOF 2: ZERO-HALLUCINATION BRANCH-AND-BOUND PRUNING SOUNDNESS OVER ALL (lb e best : Nat)!
-- If lb <= e and best < lb (i.e. suc best <= lb), then best < e (pruning NEVER drops a global minimum!)
hm-thm-bnb-prune-sound : (lb e best : Nat) → hm-le lb e ≡ true → hm-lt best lb ≡ true → hm-lt best e ≡ true
