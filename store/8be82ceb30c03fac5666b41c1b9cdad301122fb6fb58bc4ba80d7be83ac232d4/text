fromNat-plusw : (a b : Nat) → fromNat (plus a b) ≡ plusw (fromNat a) (fromNat b)
fromNat-plusw a b =
  case b return λ y → fromNat (plus a y) ≡ plusw (fromNat a) (fromNat y) of
    zero → λ i → fromNat (plus-zero a i)
    suc k → tr (fromNat (suc (plus a k))) (λ i → fromNat (plus-suc a k i)) (λ i → %wsucc (rec k i))
