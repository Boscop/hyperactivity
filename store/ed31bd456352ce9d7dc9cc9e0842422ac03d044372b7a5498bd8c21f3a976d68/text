lg-mulw-suc-r : (a b : Word) → mulw a (%wsucc b) ≡ plusw (mulw a b) a
lg-mulw-suc-r a b =
  %welimP (λ v → mulw v (%wsucc b) ≡ plusw (mulw v b) v) a (λ i → #0)
    (λ n h →
       catw (congw (λ z → plusw z (%wsucc b)) h)
         (catw (congw (λ z → %wsucc z) (plusw-assoc (mulw n b) n b))
           (catw (congw (λ z → %wsucc (plusw (mulw n b) z)) (plusw-comm n b))
             (symw (congw (λ z → %wsucc z) (plusw-assoc (mulw n b) b n))))))
