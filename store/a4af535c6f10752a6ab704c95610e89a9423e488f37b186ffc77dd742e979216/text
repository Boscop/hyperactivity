-- the Drop impl of a closed type, as an instance's index
rm-drop-find : List RDropImpl → List RInstance → RTy → RSt ROptW
rm-drop-find nil is ty = sr-ok ro-none
rm-drop-find (cons d ds) is ty = case d of
  rdrop-impl t b a → (case rm-ty-eq t ty of
    true → sr-map ro-some (rm-inst-index is b a #0)
    false → rm-drop-find ds is ty)
