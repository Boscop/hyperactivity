hart-isa-step : HartState → HartInst → HartState
hart-isa-step (hstate pc rf dmem) h-nop =
  hstate (%wsucc pc) rf dmem
hart-isa-step (hstate pc rf dmem) (h-alu op rd rs1 rs2) =
  hstate (%wsucc pc) (reg-write rd (alu-eval op (rf rs1) (rf rs2)) rf) dmem
hart-isa-step (hstate pc rf dmem) (h-load rd rsAddr) =
  hstate (%wsucc pc) (reg-write rd (dmem (rf rsAddr)) rf) dmem
hart-isa-step (hstate pc rf dmem) (h-store rsAddr rsVal) =
  hstate (%wsucc pc) rf (ram-write (rf rsAddr) (rf rsVal) dmem)
hart-isa-step (hstate pc rf dmem) (h-bnez rsCond targetPc) =
  hstate (if nat-eq (rf rsCond) zero then %wsucc pc else targetPc) rf dmem
