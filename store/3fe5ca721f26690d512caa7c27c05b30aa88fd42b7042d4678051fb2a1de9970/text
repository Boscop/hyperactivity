-- the paths refused, each on its line
g-refused : List (List Word × (List Word × (Word × Word))) → List Word
g-refused nil = nil
g-refused (cons e r) = if g-allowed (fst e) (fst (snd e)) then g-refused r else
  list-append "refused: " (list-append (fst e) (list-append " is not of the source (store/: write it with hyperactive write), and is not a file the repository held, byte for byte, when code in any other language was banned (lib/guard.cub)" (cons #10 (g-refused r))))
