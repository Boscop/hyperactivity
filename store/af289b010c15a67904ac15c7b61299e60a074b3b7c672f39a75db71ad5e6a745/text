-- one move: D' + |u'| + N = D + |u| + N' in the form recv + |u'| = send + |u|
par-step-count : {CP CQ M N E : Type} → (stepP : CP → ParLab M N E → CP → Type) → (stepQ : CQ → ParLab N M E → CQ → Type) →
  (mv : ParMove CP CQ M N E) → (s : ParState CP CQ M N) → par-allowed stepP stepQ mv s →
  plus (par-is-recv mv) (list-length (fst (snd (snd (par-move mv s))))) ≡ plus (par-is-send mv) (list-length (fst (snd (snd s))))
par-step-count stepP stepQ (pm-local-p p2) s h = λ k → list-length (fst (snd (snd s)))
par-step-count stepP stepQ (pm-local-q q2) s h = λ k → list-length (fst (snd (snd s)))
par-step-count stepP stepQ (pm-send-p m p2) s h = par-len-snoc (fst (snd (snd s))) m
par-step-count stepP stepQ (pm-send-q n q2) s h = λ k → list-length (fst (snd (snd s)))
par-step-count stepP stepQ (pm-recv-q q2) s h = par-recv-count stepQ (fst (snd s)) (fst (snd (snd s))) q2 h
par-step-count stepP stepQ (pm-recv-p p2) s h = λ k → list-length (fst (snd (snd s)))
par-step-count stepP stepQ (pm-ext-p e p2) s h = λ k → list-length (fst (snd (snd s)))
par-step-count stepP stepQ (pm-ext-q e q2) s h = λ k → list-length (fst (snd (snd s)))
