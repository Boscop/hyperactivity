-- Streaming ground encoder/decoder (depth 0): flushes before ground-enc-rem,
-- refills after ground-dec-rem on the same LIFO byte stream.
cfs-ground-enc : Word → Nat → List Word → Word → SRState → SRState
cfs-ground-enc L fuel excl x st =
  let rem  = unseen-bytes excl
      base = %wsucc (fromNat (list-length rem))
      hi   = wquot (wmul sr-base L) base
      fl   = sr-flush-loop fuel hi (fst st) (snd st)
  in ground-enc-rem rem x fl
