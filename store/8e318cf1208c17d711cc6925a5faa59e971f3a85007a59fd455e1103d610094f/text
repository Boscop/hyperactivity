-- a bare http(s) address, not after a word character, = or ', becomes a link to itself
md-bare : (Bool → Word → List Word → List Word) → Bool → MdTo → List Word → List Word
md-bare k lk (to-at a d) c = list-append "<a href='" (list-append (s-esc a) (list-append "'>" (list-append (s-esc a) (list-append "</a>" (k lk #32 (list-append d c))))))
md-bare k lk (to-none a) c = k lk #32 (list-append a c)
