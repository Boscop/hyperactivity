hyperinet-sv-scan : List Word
hyperinet-sv-scan =
  sv-concat
    (cons "  // Combinational parallel active-pair matcher & hardware free-slot allocator" (cons sv-nl
    (cons "  reg       found_pair;" (cons sv-nl
    (cons "  reg [2:0] u_idx, v_idx, f0_idx, f1_idx;" (cons sv-nl
    (cons "  reg [1:0] free_cnt;" (cons sv-nl
    (cons "  reg [2:0] live_c;" (cons sv-nl
    (cons "  always @(*) begin" (cons sv-nl
    (cons "    found_pair = 1'b0; u_idx = 3'd0; v_idx = 3'd0;" (cons sv-nl
    (cons "    f0_idx = 3'd0; f1_idx = 3'd0; free_cnt = 2'd0; live_c = 3'd0;" (cons sv-nl
    (cons "    for (i = 0; i < 8; i = i + 1) begin" (cons sv-nl
    (cons "      if (kind[i] == K_FREE) begin" (cons sv-nl
    (cons "        if (free_cnt == 2'd0) f0_idx = i[2:0];" (cons sv-nl
    (cons "        if (free_cnt == 2'd1) f1_idx = i[2:0];" (cons sv-nl
    (cons "        if (free_cnt < 2'd2)  free_cnt = free_cnt + 2'd1;" (cons sv-nl
    (cons "      end else begin" (cons sv-nl
    (cons "        live_c = live_c + 3'd1;" (cons sv-nl
    (cons "      end" (cons sv-nl
    (cons "    end" (cons sv-nl
    (cons "    for (i = 0; i < 8; i = i + 1) begin" (cons sv-nl
    (cons "      for (j = i + 1; j < 8; j = j + 1) begin" (cons sv-nl
    (cons "        if (!found_pair && kind[i] != K_FREE && kind[j] != K_FREE &&" (cons sv-nl
    (cons "            p0[i] == {j[2:0], 2'd0} && p0[j] == {i[2:0], 2'd0}) begin" (cons sv-nl
    (cons "          found_pair = 1'b1; u_idx = i[2:0]; v_idx = j[2:0];" (cons sv-nl
    (cons "        end" (cons sv-nl
    (cons "      end" (cons sv-nl
    (cons "    end" (cons sv-nl
    (cons "  end" (cons sv-nl
    (cons "  assign active_found = found_pair;" (cons sv-nl
    (cons "  assign done         = !found_pair;" (cons sv-nl
    (cons "  assign redex_count  = rcnt;" (cons sv-nl
    (cons "  assign live_nodes   = live_c;" (cons sv-nl nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
