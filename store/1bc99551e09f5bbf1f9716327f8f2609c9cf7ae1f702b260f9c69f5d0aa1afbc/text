add-high : (H1 H2 X1 X2 : Nat × Nat) → (q1 q2 S : Nat) → zle (zsc X1 S) (zsc H1 q1) → zle (zsc X2 S) (zsc H2 q2) → zle (zsc (zplus (zsc X1 q2) (zsc X2 q1)) S) (zsc (zplus H1 H2) (times q1 q2))
add-high H1 H2 X1 X2 q1 q2 S h1 h2 = zle-path
  (zplus (zsc (zsc X1 S) q2) (zsc (zsc X2 S) q1)) (zsc (zplus (zsc X1 q2) (zsc X2 q1)) S)
  (zplus (zsc (zsc H1 q1) q2) (zsc (zsc H2 q2) q1)) (zsc (zplus H1 H2) (times q1 q2))
  (transNN (λ i → zplus (zsc-swap X1 S q2 i) (zsc-swap X2 S q1 i)) (symNN (zsc-plus (zsc X1 q2) (zsc X2 q1) S)))
  (symNN (transNN (zsc-plus H1 H2 (times q1 q2)) (λ i → zplus (zsc-assoc H1 q1 q2 i) (zsc-comm-q H2 q1 q2 i))))
  (zle-add (zsc (zsc X1 S) q2) (zsc (zsc H1 q1) q2) (zsc (zsc X2 S) q1) (zsc (zsc H2 q2) q1)
    (zle-scale (zsc X1 S) (zsc H1 q1) q2 h1) (zle-scale (zsc X2 S) (zsc H2 q2) q1 h2))
