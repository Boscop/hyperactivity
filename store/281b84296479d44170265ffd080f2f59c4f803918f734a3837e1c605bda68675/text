q-check-rel-state : Word → QState3 → Bool
q-check-rel-state tgt (qs3 s0 s1 s2 s3 s4 s5 s6 s7) =
  web-andB (q-ck-rel tgt #0 s0) (web-andB (q-ck-rel tgt #1 s1)
  (web-andB (q-ck-rel tgt #2 s2) (web-andB (q-ck-rel tgt #3 s3)
  (web-andB (q-ck-rel tgt #4 s4) (web-andB (q-ck-rel tgt #5 s5)
  (web-andB (q-ck-rel tgt #6 s6) (q-ck-rel tgt #7 s7)))))))
