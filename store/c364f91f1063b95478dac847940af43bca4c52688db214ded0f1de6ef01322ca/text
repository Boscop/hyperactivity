-- the packs, made again where the source's modules changed
c-ready : Proc W Unit
c-ready = bind (h-mkdir "build") (λ u → bind (h-mkdir "build/chat") (λ v → bind (h-mkdir "build/chat/p") (λ w →
  bind (h-file-time (list-append h-index "/modules")) (λ now → bind (h-read c-stamp) (λ s →
  if h-eq (h-trim (h-source-or s)) (h-decimal now) then ret {lzero} {W} unit else
  bind (h-list (list-append h-index "/modules")) (λ hs → bind (c-module-names hs) (λ mhs →
  bind (c-packs-make mhs c-digits) (λ x → bind (c-derive-all c-digits) (λ z → bind (h-write c-stamp (h-decimal now)) (λ y → ret unit))))))))))
