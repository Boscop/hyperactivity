-- an isomorphism is an equivalence (the fibre's contraction, lemIso)
lemIso : {l : Level} {A B : Type l} (f : A → B) (g : B → A) →
                                                ((b : B) → f (g b) ≡ b) →
                                                ((a : A) → g (f a) ≡ a) →
                                                {y : B} {x0 x1 : A} →
                                                        (p0 : f x0 ≡ y) →
                                                        (p1 : f x1 ≡ y) →
                                                        Path (fiber f y) (x0 , p0) (x1 , p1)
lemIso f g s t p0 p1 =
  let fill0 = λ i j →
                comp (λ k → A)
                  (λ k → [ j = 0 ↦ g (p0 (~ i)) , i = 1 ↦ t x0 (j /\ k) , i = 0 ↦ g y ])
                  (g (p0 (~ i)))
      fill1 = λ i j →
                comp (λ k → A)
                  (λ k → [ j = 0 ↦ g (p1 (~ i)) , i = 1 ↦ t x1 (j /\ k) , i = 0 ↦ g y ])
                  (g (p1 (~ i)))
      fill2 = λ i j →
                comp (λ k → A)
                  (λ k → [ j = 0 ↦ g y , i = 1 ↦ fill1 (j /\ k) i1 , i = 0 ↦ fill0 (j /\ k) i1 ])
                  (g y)
      p = λ i → fill2 i i1
      sq = λ i j →
             comp (λ k → A)
               (λ k →
                  [ i = 1 ↦ fill1 j (~ k)
                  , i = 0 ↦ fill0 j (~ k)
                  , j = 1 ↦ t (p i) (~ k)
                  , j = 0 ↦ g y ]) (fill2 i j)
      sq1 = λ i j →
              comp (λ k → B)
                (λ k →
                   [ i = 1 ↦ s (p1 (~ j)) k
                   , i = 0 ↦ s (p0 (~ j)) k
                   , j = 1 ↦ s (f (p i)) k
                   , j = 0 ↦ s y k ]) (f (sq i j))
  in λ i → (p i , λ j → sq1 i (~ j))
