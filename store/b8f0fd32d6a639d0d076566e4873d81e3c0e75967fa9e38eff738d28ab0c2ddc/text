-- a chunk of a file's records, in a process of its own (the machine keeps what a process builds
-- until it ends, so each chunk is its own process): the record the last chunk ended inside
-- (DIR/carry) and this chunk read, their lines appended to the index, what is left kept
e-chunk-main : List (List Word) → Proc W Unit
e-chunk-main args = bind (h-read (list-append (e-nth (toNat #3) args) "/carry")) (λ c → bind (h-read (e-nth (toNat #2) args)) (λ t →
  bind (e-open-app (e-nth (toNat #1) args)) (λ fd → bind (e-chunk fd (h-eq (e-nth zero args) "1") (list-append (e-or c) (e-or t))) (λ left →
  bind (h-write (list-append (e-nth (toNat #3) args) "/carry") left) (λ w → bind (sys-call #3 fd #0 #0 #0 #0 #0) (λ x → exit (if w then #0 else #1)))))))
