-- (part of language-support)
idiv_spec : (size : ZI) → (dst' : Bits #128) → (src : Bits #64) → (Bool × (Bits #64) × (Bits #64))
idiv_spec size dst' src =
  let t'4 : (Bool × (Bits #64) × (Bits #64))
      t'4 =
        if (z-eq size (zpos #1)) then
          (let t'1 : (Bool × (Bits #8) × (Bits #8))
               t'1 = (idiv_spec_8 (bv-trunc #128 #16 dst') (bv-trunc #64 #8 src))
               elem0 : Bool
               elem0 = (fst t'1)
               elem1 : Bits #8
               elem1 = (fst (snd t'1))
               elem2 : Bits #8
               elem2 = (snd (snd t'1))
           in (elem0 , (bv-zext #8 #64 elem1) , (bv-zext #8 #64 elem2)))
        else if (z-eq size (zpos #2)) then
          (let t'2 : (Bool × (Bits #16) × (Bits #16))
               t'2 = (idiv_spec_16 (bv-trunc #128 #32 dst') (bv-trunc #64 #16 src))
               elem0 : Bool
               elem0 = (fst t'2)
               elem1 : Bits #16
               elem1 = (fst (snd t'2))
               elem2 : Bits #16
               elem2 = (snd (snd t'2))
           in (elem0 , (bv-zext #16 #64 elem1) , (bv-zext #16 #64 elem2)))
        else if (z-eq size (zpos #4)) then
          (let t'3 : (Bool × (Bits #32) × (Bits #32))
               t'3 = (idiv_spec_32 (bv-trunc #128 #64 dst') (bv-trunc #64 #32 src))
               elem0 : Bool
               elem0 = (fst t'3)
               elem1 : Bits #32
               elem1 = (fst (snd t'3))
               elem2 : Bits #32
               elem2 = (snd (snd t'3))
           in (elem0 , (bv-zext #32 #64 elem1) , (bv-zext #32 #64 elem2)))
        else if (z-eq size (zpos #8)) then
          (idiv_spec_64 dst' src)
        else
          (false , #0 , #0)
  in t'4
