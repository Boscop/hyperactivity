cs-code10-comp : (Word → Word → Word) → Nat → Lst (Word × Word) → Word → CsCode10 → CsExp
cs-code10-comp nf_of k ars d (cc10-var n) = cse-var (%wsub (%wsub d #1) n)
cs-code10-comp nf_of k ars d (cc10-wlit w) = cse-ull w
cs-code10-comp nf_of k ars d (cc10-wsucc a) = cse-add1 (cs-compile-by nf_of k ars d a)
cs-code10-comp nf_of k ars d (cc10-wop j a b) = cse-bop j (cs-compile-by nf_of k ars d a) (cs-compile-by nf_of k ars d b)
cs-code10-comp nf_of k ars d (cc10-let t b) = cse-let d (cs-compile-by nf_of k ars d t) (cs-compile-by nf_of k ars (%wsucc d) b)
cs-code10-comp nf_of k ars d (cc10-pair a b) = cse-pair (cs-compile-by nf_of k ars d a) (cs-compile-by nf_of k ars d b)
cs-code10-comp nf_of k ars d (cc10-fst p) = cse-fst (cs-compile-by nf_of k ars d p)
cs-code10-comp nf_of k ars d (cc10-snd p) = cse-snd (cs-compile-by nf_of k ars d p)
cs-code10-comp nf_of k ars d (cc10-case dd B cond) =
  cse-switch d (cs-compile-by nf_of k ars d cond)
    (cs-comp-brs-by nf_of B (cs-compile-by nf_of k ars) dd d #0)
cs-code10-comp nf_of k ars d cc10-other = cse-bad
