sg-sym-code : Lst (List Word) → List Word → Code
sg-sym-code env s =
  let c = sg-whd s
      r = sg-wtl s
      sp = nk-split-dot r
  in if nk-wlist-eq s "0" then ci0
     else if nk-wlist-eq s "1" then ci1
     else if nk-wlist-eq s "tt" then cftt
     else if nk-wlist-eq s "ff" then cfff
     else if nk-wlist-eq s "U" then cuniv clzero
     else if nk-wlist-eq s "Word" then cword
     else if nk-wlist-eq s "Level" then clevel
     else if nk-wlist-eq s "lzero" then clzero
     else if %weq (nk-wlist-len s) #0 then cclock
     else if %weq c #35 then cwlit (nk-dec-val #0 r)
     else
       (case nk-env-find s env #0 return (λ _ → Code) of
          some i → cvar i
          none →
            if andB (%weq c #71) (%weq (nk-wlist-len r) #64) then cglob (nk-key60 r)
            else if andB (%weq c #68) (%weq (nk-wlist-len r) #64) then cdata (nk-key60 r) lnil
            else if andB (%weq c #67) (%weq (nk-wlist-len (fst sp)) #64)
              then ccon (nk-key60 (fst sp)) (nk-dec-val #0 (snd sp)) lnil lnil
              else cclock)
