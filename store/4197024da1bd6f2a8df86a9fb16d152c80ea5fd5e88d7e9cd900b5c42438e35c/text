lift-fmap : (n : Nat) (X : Type 1) (F F' : X → Type 1) (Z : Type 1) (H : Z → Type 1) (h : (x : X) → F x → F' x) (k : (x : X) → F' x → Z)
  (l : (x : X) (y : F' x) → H (k x y)) (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → DCube n Z H (dmap-fmap n X F F' Z h k c d i)) (dcube-lift n X Z F' H k l c (dcube-fmap n X F F' h c d))
    (dcube-lift n X Z F H (λ x y → k x (h x y)) (λ x y → l x (h x y)) c d)
lift-fmap zero X F F' Z H h k l c d = λ i → l c (h c d)
lift-fmap (suc n) X F F' Z H h k l c d =
  lift-fmap n (Line X) (LineO X F) (LineO X F') (Line Z) (LineO Z H) (lineo-fmap X F F' h) (lineo-map X F' Z k) (lineo-lift X Z F' H k l) c d
