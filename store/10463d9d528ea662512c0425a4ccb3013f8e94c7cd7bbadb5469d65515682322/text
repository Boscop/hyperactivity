nk-ok-put : (fx : NkFx) (w : Word) (s : NkSlot) → nk-off w (nk-puts fx) → nk-off w (nk-vals fx) → nk-off w (nk-ops fx) → nk-ok w (λ s0 → s) fx
nk-ok-put nkf-nil w s hp hv ho = unit
nk-ok-put (nkf-val k v r) w s hp hv ho = (inl (fst hv) , nk-ok-put r w s hp (snd hv) ho)
nk-ok-put (nkf-op k o r) w s hp hv ho = (inl (fst ho) , nk-ok-put r w s hp hv (snd ho))
nk-ok-put (nkf-put k s2 r) w s hp hv ho = (inl (fst hp) , nk-ok-put r w s (snd hp) hv ho)
