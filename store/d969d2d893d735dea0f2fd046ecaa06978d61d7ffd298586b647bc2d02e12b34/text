-- Lossless Causal Context-Fiber Event Coalescer (`0` Dropped Events Proof):
cfu-add-nat : Nat → Nat → Nat
cfu-add-nat zero    b = b
cfu-add-nat (suc a) b = suc (cfu-add-nat a b)

cfu-bundle-ticks : List (Word × Nat) → Nat
cfu-bundle-ticks nil         = zero
cfu-bundle-ticks (cons b bs) = cfu-add-nat (snd b) (cfu-bundle-ticks bs)

cfu-push-at : Bool → Word → Word → Nat → List (Word × Nat) → List (Word × Nat)
cfu-push-at true  e k n rest = cons (k , suc n) rest
cfu-push-at false e k n rest = cons (e , suc zero) (cons (k , n) rest)

cfu-push-ev : Word → List (Word × Nat) → List (Word × Nat)
cfu-push-ev e nil         = cons (e , suc zero) nil
cfu-push-ev e (cons b rs) = cfu-push-at (%weq e (fst b)) e (fst b) (snd b) rs

cfu-coalesce : List Word → List (Word × Nat)
cfu-coalesce nil         = nil
cfu-coalesce (cons e es) = cfu-push-ev e (cfu-coalesce es)

cfu-lem-push-at-conserves :
  (fl : Bool) → (e k : Word) → (n : Nat) → (rs : List (Word × Nat)) →
  cfu-bundle-ticks (cfu-push-at fl e k n rs) ≡ suc (cfu-bundle-ticks (cons (k , n) rs))
cfu-lem-push-at-conserves true  e k n rs = refl
cfu-lem-push-at-conserves false e k n rs = refl

cfu-lem-push-conserves :
  (e : Word) → (bs : List (Word × Nat)) →
  cfu-bundle-ticks (cfu-push-ev e bs) ≡ suc (cfu-bundle-ticks bs)
cfu-lem-push-conserves e nil         = refl
cfu-lem-push-conserves e (cons b rs) = cfu-lem-push-at-conserves (%weq e (fst b)) e (fst b) (snd b) rs

-- UNIVERSAL THEOREM 3 (100% ZERO-DROP EVENT CONSERVATION ACROSS ALL ARBITRARY STREAMS `evs : List Word`!):
-- Coalescing an unbounded market firehose into contextual hyper-events preserves EVERY SINGLE RAW TICK!
cfu-thm-coalesce-conserves-all-events :
  (evs : List Word) →
  cfu-bundle-ticks (cfu-coalesce evs) ≡ list-length evs
cfu-thm-coalesce-conserves-all-events nil = refl
cfu-thm-coalesce-conserves-all-events (cons e es) =
  tmc-trans
    (cfu-lem-push-conserves e (cfu-coalesce es))
    (tmc-cong suc (cfu-thm-coalesce-conserves-all-events es))

