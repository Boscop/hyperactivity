cfu-w-cat : List (List Word) → List Word
cfu-w-cat nil           = nil
cfu-w-cat (cons xs xss) = list-append xs (cfu-w-cat xss)

cfu-w-len : List Word → Word
cfu-w-len nil         = #0
cfu-w-len (cons x xs) = %wsucc (cfu-w-len xs)

cfu-w-uleb : Word → List Word
cfu-w-uleb n =
  if %wlt n #128 then cons n nil
  else cons (%wor (%wand n #127) #128)
            (if %wlt (%wshr n #7) #128 then cons (%wshr n #7) nil
             else cons (%wor (%wand (%wshr n #7) #127) #128) (cons (%wshr n #14) nil))

cfu-w-sleb-go : Nat → Word → List Word
cfu-w-sleb-go zero    n = cons (%wand n #127) nil
cfu-w-sleb-go (suc k) n =
  let b = %wand n #127
      r = %wshr n #7
  in if (if %weq r #0 then %wlt b #64 else false)
     then cons b nil
     else cons (%wor b #128) (cfu-w-sleb-go k r)

cfu-w-sleb : Word → List Word
cfu-w-sleb n = cfu-w-sleb-go (toNat #5) n

cfu-w-sec : Word → List Word → List Word
cfu-w-sec sid body = cons sid (list-append (cfu-w-uleb (cfu-w-len body)) body)

cfu-w-get : Word → List Word
cfu-w-get i = cons #32 (cons i nil)

cfu-w-set : Word → List Word
cfu-w-set i = cons #33 (cons i nil)

cfu-w-c : Word → List Word
cfu-w-c n = cons #65 (cfu-w-sleb n)

cfu-w-op : Word → List Word
cfu-w-op o = cons o nil

cfu-w-bin : Word → List Word → List Word → List Word
cfu-w-bin op a b = list-append a (list-append b (cons op nil))

cfu-w-exp : List Word → Word → List Word
cfu-w-exp nm idx = cons (cfu-w-len nm) (list-append nm (cons #0 (cons idx nil)))

cfu-all-byte-lt256 : List Word → Bool
cfu-all-byte-lt256 nil         = true
cfu-all-byte-lt256 (cons b bs) = andB (%wlt b #256) (cfu-all-byte-lt256 bs)

cfu-wasm-sel : List Word → List Word → List Word → List Word
cfu-wasm-sel vT vF cond =
  cfu-w-cat (cons vT (cons vF (cons cond (cons (cfu-w-op #27) nil))))

-- Export 0: hx_surprise(d=0, t=1, v=2) -> abs(d - t) * v
cfu-wf-surprise : List Word
cfu-wf-surprise =
  let loc  = the (List Word) (cons #1 (cons #1 (cons #127 nil)))
      diff = list-append (cfu-w-bin #107 (cfu-w-get #0) (cfu-w-get #1)) (cfu-w-set #3)
      neg  = cfu-w-bin #107 (cfu-w-c #0) (cfu-w-get #3)
      isNg = cfu-w-bin #72 (cfu-w-get #3) (cfu-w-c #0)
      absv = cfu-wasm-sel neg (cfu-w-get #3) isNg
      res  = cfu-w-bin #108 absv (cfu-w-get #2)
  in cfu-w-cat (cons loc (cons diff (cons res (cons (cfu-w-op #11) nil))))

-- Export 1: hx_cell(h=0, sec=1) -> ((sec & 7) * 384) + ((h & 65535) % 384)
cfu-wf-cell : List Word
cfu-wf-cell =
  let loc  = the (List Word) (cons #0 nil)
      secB = cfu-w-bin #108 (cfu-w-bin #113 (cfu-w-get #1) (cfu-w-c #7)) (cfu-w-c #384)
      off  = cfu-w-bin #110 (cfu-w-bin #113 (cfu-w-get #0) (cfu-w-c #65535)) (cfu-w-c #384)
      rem  = cfu-w-bin #107 (cfu-w-bin #113 (cfu-w-get #0) (cfu-w-c #65535)) (cfu-w-bin #108 off (cfu-w-c #384))
      res  = cfu-w-bin #106 secB rem
  in cfu-w-cat (cons loc (cons res (cons (cfu-w-op #11) nil)))

-- Export 2: hx_kkt_prio(bps=0, fee=1, rk=2) -> (bps > fee ? (bps - fee) * rk : 0)
cfu-wf-kkt : List Word
cfu-wf-kkt =
  let loc = the (List Word) (cons #0 nil)
      pos = cfu-w-bin #74 (cfu-w-get #0) (cfu-w-get #1)
      net = cfu-w-bin #108 (cfu-w-bin #107 (cfu-w-get #0) (cfu-w-get #1)) (cfu-w-get #2)
      res = cfu-wasm-sel net (cfu-w-c #0) pos
  in cfu-w-cat (cons loc (cons res (cons (cfu-w-op #11) nil)))

cfu-wfn : List Word → List Word
cfu-wfn b = list-append (cfu-w-uleb (cfu-w-len b)) b

cfu-wasm-ty0 : List Word
cfu-wasm-ty0 =
  cons #96 (cons #3 (cons #127 (cons #127 (cons #127 (cons #1 (cons #127 nil))))))

cfu-wasm-ty1 : List Word
cfu-wasm-ty1 =
  cons #96 (cons #2 (cons #127 (cons #127 (cons #1 (cons #127 nil)))))

cfu-wasm-bytes : List Word
cfu-wasm-bytes =
  let hdr  = the (List Word) (cons #0 (cons #97 (cons #115 (cons #109 (cons #1 (cons #0 (cons #0 (cons #0 nil))))))))
      tSec = cfu-w-sec #1 (cons #2 (list-append cfu-wasm-ty0 cfu-wasm-ty1))
      fSec = cfu-w-sec #3 (the (List Word) (cons #3 (cons #0 (cons #1 (cons #0 nil)))))
      eSec = cfu-w-sec #7
               (cfu-w-cat
                 (cons (cons #3 nil)
                 (cons (cfu-w-exp "hx_surprise" #0)
                 (cons (cfu-w-exp "hx_cell" #1)
                 (cons (cfu-w-exp "hx_kkt_prio" #2) nil)))))
      cSec = cfu-w-sec #10
               (cfu-w-cat
                 (cons (cons #3 nil)
                 (cons (cfu-wfn cfu-wf-surprise)
                 (cons (cfu-wfn cfu-wf-cell)
                 (cons (cfu-wfn cfu-wf-kkt) nil)))))
  in cfu-w-cat (cons hdr (cons tSec (cons fSec (cons eSec (cons cSec nil)))))

-- THEOREM 5 (EXACT WASM 1.0 `\0asm` MAGIC & ALL BYTES `< 256` BY `refl`):
