--   Exports 3 zero-GC i32 functions called inside the WebWorker on EVERY event:
--     0: hx_surprise(deltaPips, trunkPips, velBoost) -> i32  (|delta - trunk| * velBoost)
--     1: hx_cell(symHash, sectorId) -> i32                   ((sectorId & 7)*384 + (symHash % 384))
