cfu-is-direct : List (List Word) → Bool
cfu-is-direct nil         = false
cfu-is-direct (cons a rs) =
  if h-eq a "--with" then
    (case rs of
      nil → false
      cons v rs2 →
        (case rs2 of
          nil → false
          cons r rs3 → cfu-is-direct rs3))
  else if h-infix "hx-contextual-flux-ux" a then true
  else cfu-is-direct rs

cfu-run : Step W Unit
cfu-run =
  tmc-step-bind-vm (to-step h-args) (λ av →
    if cfu-is-direct av
    then tmc-step-bind-vm (cfu-main nil) (λ rc → scmd (w-exit rc) (λ u → sdone unit))
    else sdone unit)

