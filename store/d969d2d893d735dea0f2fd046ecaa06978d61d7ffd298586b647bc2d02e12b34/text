-- Clean Last-End-Tag Splice (strictly structural O(N) scan): replaces from FIRST `HX-ALL-CRYPTO-START` through LAST `HX-ALL-CRYPTO-END`!
cfu-last-after-go : List Word → List Word → List Word → List Word
cfu-last-after-go tag nil         best = best
cfu-last-after-go tag (cons x xs) best =
  if h-prefix tag (cons x xs)
  then cfu-last-after-go tag xs (h-drop tag (cons x xs))
  else cfu-last-after-go tag xs best

cfu-last-after : List Word → List Word → List Word
cfu-last-after tag s = cfu-last-after-go tag s nil

cfu-start-full : List Word
cfu-start-full = "<!-- HX-STREAM-FRAGMENT --><!-- HX-ALL-CRYPTO-START -->"

cfu-start-alt : List Word
cfu-start-alt = "<!-- HX-ALL-CRYPTO-START -->"

cfu-end-tag : List Word
cfu-end-tag = "</div><!-- HX-ALL-CRYPTO-END -->"

cfu-v3-anchor : List Word
cfu-v3-anchor = "  <div class='g2'>"

cfu-splice-clean : List Word → List Word → List Word
cfu-splice-clean newFrag existing =
  if andB (h-infix cfu-start-full existing) (h-infix cfu-end-tag existing)
  then list-append (h-before cfu-start-full existing) (list-append newFrag (cfu-last-after cfu-end-tag existing))
  else if andB (h-infix cfu-start-alt existing) (h-infix cfu-end-tag existing)
       then list-append (h-before cfu-start-alt existing) (list-append newFrag (cfu-last-after cfu-end-tag existing))
       else if h-infix cfu-v3-anchor existing
            then list-append (h-before cfu-v3-anchor existing)
                   (list-append newFrag (list-append cfu-nl (list-append cfu-v3-anchor (h-after cfu-v3-anchor existing))))
            else list-append existing (list-append cfu-nl newFrag)

