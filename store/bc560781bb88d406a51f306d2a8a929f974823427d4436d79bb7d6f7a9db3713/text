-- false means b < a
bz-le-false : (s1 : Bool) → (m1 : List Bool) → (s2 : Bool) → (m2 : List Bool) → bcanon m1 ≡ true → bcanon m2 ≡ true → bz-le (s1 , m1) (s2 , m2) ≡ false → le (suc (plus (snd (zv (s1 , m1))) (fst (zv (s2 , m2))))) (plus (fst (zv (s1 , m1))) (snd (zv (s2 , m2))))
bz-le-false s1 m1 s2 m2 c1 c2 h =
  lt-transfer (fst (zv (bz-add (s1 , m1) (bz-neg (s2 , m2))))) (snd (zv (bz-add (s1 , m1) (bz-neg (s2 , m2)))))
     (plus (fst (zv (s1 , m1))) (snd (zv (s2 , m2)))) (plus (snd (zv (s1 , m1))) (fst (zv (s2 , m2))))
     (bz-sub-eq s1 m1 s2 m2 c1 c2)
     (bz-nonpos-false (fst (bz-add (s1 , m1) (bz-neg (s2 , m2)))) (snd (bz-add (s1 , m1) (bz-neg (s2 , m2))))
        (bz-add-canon (s1 , m1) (bz-neg (s2 , m2)) c1 (bz-neg-canon (s2 , m2) c2)) h)
