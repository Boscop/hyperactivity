fq-l3 : Nat → List (Nat × Nat) → List (Nat × Nat) → List (List (Nat × Nat)) → List (Nat × (Nat × (Nat × Nat))) → List (Nat × (Nat × (Nat × Nat)))
fq-l3 r l2 occ cs acc = case cs of
  nil → acc
  cons l3 rest → fq-l3 r l2 occ rest (fq-l4 r l2 (fq-app l3 occ) (fq-adjn l3 (cons fq-o nil)) (fq-next r l3 (fq-app l3 occ)) acc)
