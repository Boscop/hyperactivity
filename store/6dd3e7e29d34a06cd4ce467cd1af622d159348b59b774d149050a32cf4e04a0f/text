nsub-anysub : (c : Conj) (f : DNF) → every-c (λ e → not (conj-sub e c)) f ≡ true → dnf-any-sub c f ≡ false
nsub-anysub c lnil h = λ i → false
nsub-anysub c (lcons d ds) h =
  pcat0 Bool (dnf-any-sub c (lcons d ds)) (dnf-any-sub c ds) false
    (λ i → if not-true (conj-sub d c) (andB-l (not (conj-sub d c)) (every-c (λ e → not (conj-sub e c)) ds) h) i then true else dnf-any-sub c ds)
    (nsub-anysub c ds (andB-r (not (conj-sub d c)) (every-c (λ e → not (conj-sub e c)) ds) h))
