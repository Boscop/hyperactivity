cs-dl-comp : (f g : List Word → List Word) →
  ((tl : List Word) → f tl ≡ list-append (f nil) tl) →
  ((tl : List Word) → g tl ≡ list-append (g nil) tl) →
  (acc : List Word) → f (g acc) ≡ list-append (f (g nil)) acc
cs-dl-comp f g hf hg acc =
  hf (g acc)
  ∙ (cong (list-append (f nil)) (hg acc)
     ∙ (sym (cs-list-app-assoc (f nil) (g nil) acc)
        ∙ cong (λ z → list-append z acc) (sym (hf (g nil)))))
