-- A Certified Dual Bracket for a fine observable `val : Fine → Nat` relative to a
-- coarse observation `obs : Fine → Coarse`:
--   For every fine state x, local lower/upper certificates satisfy lb(obs x) ≤ val(x) ≤ ub(obs x).
DualBracket : (Fine Coarse : Type 0) → (Fine → Coarse) → (Fine → Nat) → Type 0
DualBracket Fine Coarse obs val =
  (lb : Coarse → Nat) × (ub : Coarse → Nat) ×
  ((x : Fine) → (rg-leb (lb (obs x)) (val x) ≡ true) × (rg-leb (val x) (ub (obs x)) ≡ true))
