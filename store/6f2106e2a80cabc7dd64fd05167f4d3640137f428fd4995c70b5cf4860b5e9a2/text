bn-lem-xor : (env : Word) → (a b : INetExpr) →
  inet-eval env (bn-mk-xor a b) ≡ bn-xor64 (inet-eval env a) (inet-eval env b)
bn-lem-xor env (in-lit a)        b = bn-lem-xor2 env a b
bn-lem-xor _   in-var0           _ = refl
bn-lem-xor _   (in-dup-add _)    _ = refl
bn-lem-xor _   (in-add _ _)      _ = refl
bn-lem-xor _   (in-xor _ _)      _ = refl
bn-lem-xor _   (in-era-l _ _)    _ = refl
bn-lem-xor _   (in-lut3 _ _ _ _) _ = refl
