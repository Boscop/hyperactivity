sg-read-forms : NkTm → List Word → Opt (Code × Code)
sg-read-forms ksig txt =
  case nk-parse-sexp (toNat #4096) false txt return (λ _ → Opt (Code × Code)) of
    none → none
    some p1 →
      (case nk-parse-sexp (toNat #4096) false (snd p1) return (λ _ → Opt (Code × Code)) of
         none → none
         some p2 →
           let dT = snd (sg-decanon (toNat #1024) #0 lnil (fst (fst p1)))
               dt = snd (sg-decanon (toNat #1024) #0 lnil (fst (fst p2)))
           in some (nk-clean-code (sg-to-code (toNat #1024) ksig lnil dt) , nk-clean-code (sg-to-code (toNat #1024) ksig lnil dT)))
