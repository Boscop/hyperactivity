-- Any harmonic multiple k of a balanced schedule preserves exact O(1) balance
balance-scale : (k p q a b : Nat) → times a p ≡ times b q → times (times k a) p ≡ times (times k b) q
balance-scale k p q a b h =
  transN (times-assoc k a p)
    (transN (congN (times k) h)
      (symN (times-assoc k b q)))
