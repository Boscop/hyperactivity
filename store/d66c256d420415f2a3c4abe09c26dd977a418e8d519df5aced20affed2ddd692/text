nk-emem-eapp-both-at : (eq : Bool) (w x : NkW) (r b : NkEnv) →
  ((if eq then true else nk-emem w (nk-eapp r b)) ≡ true) →
  ((nk-emem w (nk-eapp r b) ≡ true) → (if nk-emem w r then true else nk-emem w b) ≡ true) →
  (if (if eq then true else nk-emem w r) then true else nk-emem w b) ≡ true
nk-emem-eapp-both-at true w x r b hm ih = refl
nk-emem-eapp-both-at false w x r b hm ih = ih hm
