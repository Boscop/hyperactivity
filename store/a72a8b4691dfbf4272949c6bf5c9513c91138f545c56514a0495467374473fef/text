-- the truncated magnitude t with the sign: in range of the 128-bit kind or undefined
dq-signed-in : Bool → Bool → DQ → MRes DQ
dq-signed-in sg neg t = case neg of
  true → (case sg of
    true → (case dq-ult dq-min t of
      true → mub ub-float-int-range
      false → mok (dq-neg t))
    false → (case dq-iszero t of
      true → mok dq0
      false → mub ub-float-int-range))
  false → (case m-and sg (not (dq-ult t dq-min)) of
    true → mub ub-float-int-range
    false → mok t)
