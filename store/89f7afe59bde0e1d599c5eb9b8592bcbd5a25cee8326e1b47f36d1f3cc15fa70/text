sg-dc-let2 : (Word → Lst (List Word) → NkSexp → Word × NkSexp) → Word → Lst (List Word) → List Word → NkSexp → NkSexp → Word × NkSexp
sg-dc-let2 go fr ds nm v b =
  let pv = go fr ds v
      pb = go (fst pv) (lcons nm ds) b
  in (fst pb , nks-lst (lcons (nks-sym "let") (lcons (nks-sym nm) (lcons (snd pv) (lcons (snd pb) lnil)))))
