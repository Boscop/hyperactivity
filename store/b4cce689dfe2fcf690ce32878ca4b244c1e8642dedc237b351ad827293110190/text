hy-fold-safe : List Word → List Word → List (List Word) → Proc W Unit
hy-fold-safe st m args = bind (hy-fold-safe-list st m args) (λ ks →
  h-out (list-append (h-concat (list-map h-line ks))
    (h-line (list-append (h-decimal (fromNat (list-length ks))) " modules are held whole by another, imported by none, and named by no module's text or the Makefile"))))
