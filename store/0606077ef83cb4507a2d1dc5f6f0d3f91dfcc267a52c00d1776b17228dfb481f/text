-- a letter times a normal word, in normal form
fa-put : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → FaL → FaW → List (FaW × A)
fa-put A ad mu iq l w = case w of
  nil → cons (cons l nil , iq (fn-q 1 1)) nil
  cons y s → if fa-llt l y then cons (cons l (cons y s) , iq (fn-q 1 1)) nil else (if fa-leq l y then nil else (if (if fst l then false else fst y) then (if al-neq (snd l) (snd y) then fa-add A ad (cons (s , iq (fn-q 1 1)) nil) (fa-scal A mu (iq (fn-nq 1 1)) (fa-pre A y (fa-put A ad mu iq l s))) else fa-scal A mu (iq (fn-nq 1 1)) (fa-pre A y (fa-put A ad mu iq l s))) else fa-scal A mu (iq (fn-nq 1 1)) (fa-pre A y (fa-put A ad mu iq l s))))
