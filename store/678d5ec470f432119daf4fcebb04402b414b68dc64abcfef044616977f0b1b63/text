-- functions with sharing: inc ((λg. (λf. f (f 5)) (λy. g y)) (λz. inc z)) is 8; f is a closure
-- with a part, held once and read twice (part of machine-in-hyperactive)
nk-nf-share : nk-nf (toNat #3000) (nk-inc (nk-app (nk-lam (nk-app (nk-lam (nk-app (nk-var #0) (nk-app (nk-var #0) (nk-num #5)))) (nk-lam (nk-app (nk-var #1) (nk-var #0))))) (nk-lam (nk-inc (nk-var #0))))) ≡ nk-num #8
nk-nf-share = refl
