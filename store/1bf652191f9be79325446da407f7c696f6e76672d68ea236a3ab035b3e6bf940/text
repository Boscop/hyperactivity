-- one term's rational map, source states × target coordinates
proj-map : VM → VM → VM → Nat → Bool → Nat → Bool → Nat → List Nat → Rows → Rows
proj-map a1 a2 aP k sn n sm m dsP xs0 = hop-fin a2 aP k sn n sm m dsP (proj-apply a2 (hop-mid a1 a2 k sn n sm m dsP (proj-apply a1 (to-coords a1 (first-maps k sn n dsP xs0)))))
