-- its contribution, entry by entry: weight · map_ij · (μ₁μ₂)^{1/8}
proj-row : SQ → List Nat → List SQ → List PRad → List (List PRad) → List (List PRad)
proj-row w ex r acc0 acc = case acc of
  nil → nil
  cons a rest → (case r of nil → acc; cons x rrest → cons (p-add a (if sq-nz x then cons (p-rad-of (sq-mul w x) ex) nil else nil)) (proj-row w ex rrest acc0 rest))
