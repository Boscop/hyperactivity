emit-c-definition : Code → List Word
emit-c-definition (cglob g) =
  (case unfold g return (λ _ → List Word) of
     none → "/* no code */"
     some c → emit-c-program g (x-erase g (x-forms-all (snd (program-of-at unfold g (fst (specialize (opt-or (def-type-code g) cword) sched-default lnil c)) #256)))))
emit-c-definition c = "/* not a definition */"
