-- a product of scaled integers is the scaled product
zmul-zsc2 : (x y : Nat × Nat) → (a b : Nat) → zmul (zsc x a) (zsc y b) ≡ zsc (zmul x y) (times a b)
zmul-zsc2 x y a b = pairNN
  (plus (times (times (fst x) a) (times (fst y) b)) (times (times (snd x) a) (times (snd y) b)))
  (plus (times (times (fst x) a) (times (snd y) b)) (times (times (snd x) a) (times (fst y) b)))
  (times (plus (times (fst x) (fst y)) (times (snd x) (snd y))) (times a b))
  (times (plus (times (fst x) (snd y)) (times (snd x) (fst y))) (times a b))
  (transN (cong2plus (times (times (fst x) a) (times (fst y) b)) (times (times (fst x) (fst y)) (times a b)) (times (times (snd x) a) (times (snd y) b)) (times (times (snd x) (snd y)) (times a b))
     (times4 (fst x) a (fst y) b) (times4 (snd x) a (snd y) b))
     (symN (times-distr (times (fst x) (fst y)) (times (snd x) (snd y)) (times a b))))
  (transN (cong2plus (times (times (fst x) a) (times (snd y) b)) (times (times (fst x) (snd y)) (times a b)) (times (times (snd x) a) (times (fst y) b)) (times (times (snd x) (fst y)) (times a b))
     (times4 (fst x) a (snd y) b) (times4 (snd x) a (fst y) b))
     (symN (times-distr (times (fst x) (snd y)) (times (snd x) (fst y)) (times a b))))
