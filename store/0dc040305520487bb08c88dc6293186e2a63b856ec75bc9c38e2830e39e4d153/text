sg-tc-op : Word → Lst Code → Code
sg-tc-op op ac =
  let a0 = sg-lc0 ac
      a1 = sg-lc1 ac
      a2 = sg-lc2 ac
      a3 = sg-lc3 ac
  in if %weq op #10 then ccase sg-bool-d (lcons a1 (lcons a2 lnil)) a0
     else if %weq op #11 then cwelim a1 a2 a3 (some a0)
     else if %weq op #12 then (case ac return (λ _ → Code) of lnil → cuniv clzero; lcons x _ → cuniv x)
     else if %weq op #13 then clsuc a0
     else if %weq op #14 then sg-clmax a0 a1
     else if %weq op #15 then cpathp a0 a1 a2
     else if %weq op #16 then cpapp a0 a1
     else if %weq op #17 then cneg a0
     else if %weq op #18 then cmeet a0 a1
     else if %weq op #19 then cjoin a0 a1
     else if %weq op #20 then cpair a0 a1
     else if %weq op #21 then cfst a0
     else if %weq op #22 then csnd a0
     else if %weq op #23 then cann a1 a0
     else if %weq op #24 then cwsucc a0
     else cwop (%wsub op #25) a0 a1
