s-find = "<style>#find{display:none;position:fixed;inset:0;z-index:10;background:#fff;color:#000;overflow:auto;padding:22px clamp(16px,6vw,80px) 80px} #findq{width:100%;font:700 clamp(28px,5.5vw,60px)/1.1 ui-monospace,'SF Mono',Menlo,monospace;border:0;border-bottom:4px solid #000;outline:0;padding:10px 0;background:transparent;color:#000;letter-spacing:-.02em} #findq::placeholder{color:#ff0a94} #findx{position:fixed;top:14px;right:18px;font:700 14px ui-monospace,Menlo,monospace;background:#000;color:#fff;border:0;padding:6px 10px;cursor:pointer} #findn{font:600 12px ui-monospace,Menlo,monospace;color:#ff0a94;margin:14px 0 4px;letter-spacing:.06em} .fh{display:block;text-decoration:none;color:#000;padding:18px 0;border-bottom:1px solid #000} .fh:hover .ft{color:#ff0a94} .ft{font-size:22px;font-weight:800;letter-spacing:-.01em} .fp{font:500 12px ui-monospace,Menlo,monospace;opacity:.55;margin-top:2px} .fs{font-size:16px;margin-top:8px;line-height:1.5} .fs mark{background:#ff0a94;color:#fff;padding:0 2px} #sfind{font:inherit;background:none;border:2px solid currentColor;color:inherit;padding:3px 9px;margin-left:22px;cursor:pointer;text-transform:lowercase} html.syn #find{background:#000;color:#fff} html.syn #findq,html.syn .fh{color:#fff;border-color:#fff} html.syn #findx{background:#fff;color:#000}</style><script>(function(){var D=null,box,q,out,n;e.c++;function el(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e}function load(){if(load.p)return load.p;var acc=[];D=acc;load.p=fetch('/corpus').then(function(r){return r.json()}).then(function(hs){return Promise.all(hs.map(function(h){return fetch('/corpus'+h).then(function(r){return r.ok?r.json():null}).then(function(d){if(d){d.lx=d.x.toLowerCase();d.lt=d.t.toLowerCase();acc.push(d)}})}))}).then(function(){if(box&&box.style.display==='block')run()});return load.p}function snip(x,i,len){var s=Math.max(0,i-80),e=Math.min(x.length,i+len+110),p=el('div','fs');p.appendChild(document.createTextNode((s>0?'… ':'')+x.slice(s,i)));p.appendChild(el('mark','',x.slice(i,i+len)));p.appendChild(document.createTextNode(x.slice(i+len,e)+(e<x.length?' …':'')));return p}function run(){var w=q.value.trim(),lw=w.toLowerCase();out.textContent='';if(!D){n.textContent='reading the whole site…';return}if(lw.length<2){n.textContent=D.length+' texts, '+Math.round(D.reduce(function(a,d){return a+d.x.length},0)/1000)+'k characters: type to search all of it';return}var res=[];D.forEach(function(d){var lx=d.lx,hits=[],c=0,i=lx.indexOf(lw);while(i>=0){if(hits.length<3)hits.push(i);c++;i=lx.indexOf(lw,i+lw.length)}var tm=d.lt.indexOf(lw)>=0;if(c||tm)res.push({d:d,h:hits,c:c+(tm?1000:0)})});res.sort(function(a,b){return b.c-a.c});var total=res.reduce(function(a,r){return a+r.c%1000},0);n.textContent=total+' places in '+res.length+' texts';res.slice(0,60).forEach(function(r){var d=r.d,a=el('a','fh');a.href=d.h+(r.h.length?'#:~:text='+encodeURIComponent(d.x.substr(r.h[0],lw.length)):'');a.appendChild(el('div','ft',d.t));a.appendChild(el('div','fp',d.h));r.h.forEach(function(i){a.appendChild(snip(d.x,i,lw.length))});out.appendChild(a)})}function open(){if(!box){box=el('div');box.id='find';q=el('input');q.id='findq';q.placeholder='search everything';q.autocomplete='off';q.spellcheck=false;var x=el('button','','esc');x.id='findx';x.addEventListener('click',close);n=el('div');n.id='findn';out=el('div');box.appendChild(x);box.appendChild(q);box.appendChild(n);box.appendChild(out);document.body.appendChild(box);q.addEventListener('input',function(){if(run.t)cancelAnimationFrame(run.t);run.t=requestAnimationFrame(run)})}box.style.display='block';document.body.style.overflow='hidden';q.focus();q.select();run();load().then(run)}function close(){if(box){box.style.display='none';document.body.style.overflow=''}}document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('nav>span:last-child,.splash .top>span:last-child').forEach(function(p){var b=el('button','','search');b.id='sfind';b.title='search everything (/)';b.addEventListener('click',open);p.appendChild(b)})});document.addEventListener('keydown',function(e){var t=e.target.tagName;if(e.key==='Escape')close();else if(e.key==='/'&&!/INPUT|TEXTAREA/.test(t)){e.preventDefault();open()}})})()</script>"
