hcm-read-raw : List Word → (Word → Word → Step W Word) → Step W Word
hcm-read-raw path k =
  hcm-cstr path (λ pb →
  scmd (w-sys #904 pb #0 #0 #0 #0 #0) (λ fsz →
  let n = if %wlt #1073741824 fsz then #0 else fsz
  in scmd (w-alloc (%wadd n #16)) (λ buf →
     scmd (w-sys #902 pb buf n #0 #0 #0) (λ got →
     scmd (w-free pb) (λ _ → k buf got)))))
