-- Count admissible intermediate spins k ≤ bound coupling (d1, d2) to (d3, d4).
lqg-inv4-count : Nat → Nat → Nat → Nat → Nat → Nat
lqg-inv4-count bound d1 d2 d3 d4 = case bound of
  zero → if lqg-and (lqg-tri-ok d1 d2 zero) (lqg-tri-ok d3 d4 zero) then 1 else 0
  suc k → plus (if lqg-and (lqg-tri-ok d1 d2 (suc k)) (lqg-tri-ok d3 d4 (suc k)) then 1 else 0)
               (lqg-inv4-count k d1 d2 d3 d4)
