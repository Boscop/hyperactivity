kv-local : (cb : KvSt → NView KvMsg KvSt) → (i : Nat) → (s : KvSt) → KvNodeInv i s → VOk {KvMsg} {KvSt} (KvNodeInv i) (kv-beh cb i s)
kv-local cb zero st h = kv-rep-view-inv st h
kv-local cb (suc zero) st h = kv-rep-view-inv st h
kv-local cb (suc (suc zero)) st h = kv-rep-view-inv st h
kv-local cb (suc (suc (suc zero))) st h = kv-vok-unit (cb st)
kv-local cb (suc (suc (suc (suc j)))) st h = unit
