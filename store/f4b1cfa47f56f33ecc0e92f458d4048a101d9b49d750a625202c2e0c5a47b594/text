v-build-env : List (List Word × Node) → List Node → List (Node × List Word) → List (Node × List Node) → List (Node × List Document) → VEnv
v-build-env all ip-raw res-raw aft-raw ctx-raw =
  let names = list-map {List Word × Node} {List Word} (λ e → fst e) all in
  let ptab = v-mk-ptab all in
  v-build-s0 all names (list-length names) ptab (v-mk-ktab ptab) (v-mk-res all res-raw) ip-raw aft-raw ctx-raw
