-- ---------------------------------------------------------------- 1. Universal Fan-In-2 Light-Cone Lower Bound
circ-depth : {O0 O1 O2 V : Type} → Circ O0 O1 O2 V → Nat
circ-depth (cwire _) = zero
circ-depth (cop0 _) = zero
circ-depth (cop1 _ a) = suc (circ-depth a)
circ-depth (cop2 _ x y) = suc (maxN (circ-depth x) (circ-depth y))
