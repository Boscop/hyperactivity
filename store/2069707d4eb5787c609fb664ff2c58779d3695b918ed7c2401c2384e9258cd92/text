-- THEOREM 2 (SUPEROPTIMIZER SHRINKS `bn-demo-inet` 13 -> 6 NODES AND REDUCES `#11 -> #37` BY `refl`):
bn-thm-demo-superopt :
  andB (%weq (fromNat (inet-nodes bn-demo-inet)) #13)
  (andB (%weq (fromNat (inet-nodes (superchip-opt bn-demo-inet))) #6)
  (andB (%weq (inet-eval #11 bn-demo-inet) #37)
        (%weq (inet-eval #11 (superchip-opt bn-demo-inet)) #37))) ≡ true
bn-thm-demo-superopt = refl
