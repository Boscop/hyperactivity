-- CStmt: a statement. One constructor per Clang Stmt kind met; cs-expr is an expression in statement position; cs-none an absent child; cs-nil/cs-cons the children of cs-compound and the handlers of cs-try (each a cs-catch, whose var is empty for catch (...))
data CStmt =
    cs-compound (ss : CStmt)
  | cs-decl (vars : List CVar)
  | cs-expr (e : CExpr)
  | cs-if (init : CStmt) (cond-var : CStmt) (cond : CExpr) (then-s : CStmt) (else-s : CStmt)
  | cs-if-constexpr (init : CStmt) (cond-var : CStmt) (cond : CExpr) (then-s : CStmt) (else-s : CStmt)
  | cs-while (cond-var : CStmt) (cond : CExpr) (body : CStmt)
  | cs-do (body : CStmt) (cond : CExpr)
  | cs-for (init : CStmt) (cond-var : CStmt) (cond : CExpr) (inc : CExpr) (body : CStmt)
  | cs-for-range (init : CStmt) (range : CStmt) (begin : CStmt) (end : CStmt) (cond : CExpr) (inc : CExpr) (loop-var : CStmt) (body : CStmt)
  | cs-return (e : CExpr)
  | cs-break
  | cs-continue
  | cs-switch (init : CStmt) (cond-var : CStmt) (cond : CExpr) (body : CStmt)
  | cs-case (value : CExpr) (s : CStmt)
  | cs-default (s : CStmt)
  | cs-coroutine-body (body : CStmt) (promise : CStmt) (init-suspend : CStmt) (final-suspend : CStmt) (on-exception : CStmt) (on-fallthrough : CStmt) (allocate : CStmt) (deallocate : CStmt) (result-decl : CStmt) (return-value : CStmt) (return-stmt : CStmt) (return-on-alloc-failure : CStmt) (param-moves : CStmt)
  | cs-coreturn (operand : CExpr) (promise-call : CExpr)
  | cs-try (body : CStmt) (handlers : CStmt)
  | cs-catch (var : List CVar) (body : CStmt)
  | cs-goto (label : Word)
  | cs-label (id : Word) (name : CStr) (s : CStmt)
  | cs-null
  | cs-none
  | cs-nil
  | cs-cons (x : CStmt) (xs : CStmt)
