shift-q : (f : List (List Word) → Word) → (h : Nat) → (x : List Word) → (r : List (List Word)) →
          tail-of (list-map f (sufs (drop-n h (cons x r)))) ≡ list-map f (sufs (drop-n h r))
shift-q f h x r = tr (list-map f (sufs (tail-of (drop-n h (cons x r))))) (tail-sufs f (drop-n h (cons x r))) (λ j → list-map f (sufs (tail-drop h (cons x r) j)))
