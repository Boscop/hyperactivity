-- Σ_e′ n_e n_e′ O_ee′ over the edges from e1, for one e
energy-row : Nat → SQ → Nat → List SQ → List Nat → List Triple → List Term
energy-row e ne e1 ns ds ts = case ns of
  nil → nil
  cons n rest → terms-append (if sq-nz (sq-mul ne n) then terms-scale (sq-mul ne n) (o-terms e e1 ds ts) else nil) (energy-row e ne (suc e1) rest ds ts)
