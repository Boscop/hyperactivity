-- fill^i A [φ ↦ u] a0 (r) = comp^j A(r∧j) [φ ↦ u(r∧j), (r=0) ↦ a0] a0
-- (2026-11-12) matches CCHM §4.4 “Kan filling operation”: fill^i A [φ ↦ u] a0 = comp^j A(i∧j) [φ ↦ u(i∧j), (i=0) ↦ a0] a0,
-- r for i.
fill A u a0 r =
  comp (λ (j : I) → A @ (r /\ j))
    (sys+ (r = 0) (λ (j : I) → a0) (sysmap (λ w (j : I) → w @ (r /\ j)) u)) a0
