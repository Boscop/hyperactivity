-- a face in normal form under one binder, at an end of that binder (true: the end 1), read in
-- the scope outside it; joins, meets and reversals of ends are worked out as they are built
nk-face-op : Word → NkTm → NkTm → NkTm
nk-face-op h p as =
  if %weq h #5 then (if nk-con-is p #10 then nk-i1 else (if nk-con-is p #11 then nk-i0 else nk-op h p as))
  else (if %weq h #6 then (if nk-con-is p #10 then nk-i0 else (if nk-con-is (nk-nth as #0) #10 then nk-i0 else (if nk-con-is p #11 then nk-nth as #0 else (if nk-con-is (nk-nth as #0) #11 then p else nk-op h p as))))
  else (if %weq h #7 then (if nk-con-is p #11 then nk-i1 else (if nk-con-is (nk-nth as #0) #11 then nk-i1 else (if nk-con-is p #10 then nk-nth as #0 else (if nk-con-is (nk-nth as #0) #10 then p else nk-op h p as))))
  else nk-op h p as))
