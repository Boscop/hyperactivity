w-resp : WCmd → Type
w-resp c = case c return (λ _ → Type) of
  w-now → Word
  w-write fd n b → Word
  w-read fd n → Word × Bytes n
  w-sleep ns → Unit
  w-exit ec → Unit
  w-open n p f m → Word
  w-close fd → Word
  w-load a → Word
  w-store a v → Unit
  w-cas a o nw → Word
  w-fence → Unit
  w-sys nr a1 a2 a3 a4 a5 a6 → Word
  w-alloc n → Word
  w-load8 a → Word
  w-store8 a v → Unit
  w-spawn a e o → Word
  w-file-read p → Word × List Word
  w-file-write p t → Word
  w-fd-write fd t → Word
  w-file-read-named p → Word × List Word
  w-file-write-named p t → Word
