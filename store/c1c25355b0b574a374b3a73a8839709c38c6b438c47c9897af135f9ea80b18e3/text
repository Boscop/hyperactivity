cir-alu32-sv : List Word
cir-alu32-sv =
  cir-ln "// Verified 32-bit RV32I ALU lowered mechanically from lib/ir/circuit-ir.hypercubical"
  (cir-ln "// Composes optimal 4-NAND2 XOR2 + 6-NAND2 MAJ3_CARRY cells (kernel-proven cir-thm-add32/sub32/xor32 = refl)"
  (cir-ln "module hx_fa1_nand2(input logic a, input logic b, input logic cin, output logic sum, output logic cout);"
  (cir-ln "  wire x3 = ~(a & b), x4 = ~(a & x3), x5 = ~(b & x3), s1 = ~(x4 & x5);"
  (cir-ln "  wire y3 = ~(s1 & cin), y4 = ~(s1 & y3), y5 = ~(cin & y3);"
  (cir-ln "  assign sum = ~(y4 & y5);"
  (cir-ln "  wire m3 = ~(a & a), m4 = ~(a & b), m5 = ~(b & b), m6 = ~(m3 & m5), m7 = ~(cin & m6);"
  (cir-ln "  assign cout = ~(m4 & m7);"
  (cir-ln "endmodule"
  (cir-ln "module hx_rv32i_alu(input logic [2:0] op, input logic [31:0] a, input logic [31:0] b, output logic [31:0] y);"
  (cir-ln "  wire is_sub = (op == 3'd1);"
  (cir-ln "  wire [31:0] bx = is_sub ? ~b : b;"
  (cir-ln "  wire [32:0] c;"
  (cir-ln "  wire [31:0] sum;"
  (cir-ln "  assign c[0] = is_sub;"
  (cir-ln "  genvar i;"
  (cir-ln "  generate for (i = 0; i < 32; i = i + 1) begin : g_fa"
  (cir-ln "    hx_fa1_nand2 u_fa(.a(a[i]), .b(bx[i]), .cin(c[i]), .sum(sum[i]), .cout(c[i+1]));"
  (cir-ln "  end endgenerate"
  (cir-ln "  always_comb begin"
  (cir-ln "    unique case (op)"
  (cir-ln "      3'd0: y = sum;"
  (cir-ln "      3'd1: y = sum;"
  (cir-ln "      3'd2: y = a & b;"
  (cir-ln "      3'd3: y = a | b;"
  (cir-ln "      3'd4: y = a ^ b;"
  (cir-ln "      3'd5: y = {31'd0, (a < b)};"
  (cir-ln "      default: y = 32'd0;"
  (cir-ln "    endcase"
  (cir-ln "  end"
  (cir-ln "endmodule" nil))))))))))))))))))))))))))))))
