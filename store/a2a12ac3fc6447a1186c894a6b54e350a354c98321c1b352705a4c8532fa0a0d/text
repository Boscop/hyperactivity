-- the state after byte c from state j < m: fall back along the failures until p's next byte is c. Each
-- fallback lowers the state, so j + 1 steps bound it (the elimination's count)
m-step : (n : Nat) → Bytes n → (k : Nat) → Bytes k → Word → Word → Word
m-step n p k f j c = %welimP (λ _ → Word → Word) (wadd j #1) (λ i → #0)
  (λ u go i → if weq (cstr-get n p i) c then wadd i #1 else if weq i #0 then #0 else go (m-fail k f (wsub i #1))) j
