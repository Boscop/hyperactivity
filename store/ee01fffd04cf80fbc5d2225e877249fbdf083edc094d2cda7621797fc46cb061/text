hxb-step : HxbBook → Word → Word → Word → HxbBook
hxb-step (hxb-bk b a e ad cn) tag side qty =
  if %weq tag #0 then
    if %weq side #0 then hxb-bk (%wadd b qty) a e (%wsucc ad) cn else hxb-bk b (%wadd a qty) e (%wsucc ad) cn
  else if %weq tag #1 then
    if %weq side #0 then hxb-bk (%wsub b qty) a e ad (%wsucc cn) else hxb-bk b (%wsub a qty) e ad (%wsucc cn)
  else if %weq tag #2 then
    if %weq side #0 then
      let fill = if %wlt b qty then b else qty in hxb-bk (%wsub b fill) a (%wadd e fill) ad cn
    else
      let fill = if %wlt a qty then a else qty in hxb-bk b (%wsub a fill) (%wadd e fill) ad cn
  else hxb-bk #0 #0 e ad cn
