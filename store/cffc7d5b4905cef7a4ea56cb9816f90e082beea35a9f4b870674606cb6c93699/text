it-mlc : (A : Type) → (mu : A → A → A) → ((s x y : A) → mu (mu s x) y ≡ mu s (mu x y)) → ((a b : A) → mu a b ≡ mu b a) → (a c p : A) → mu a (mu c p) ≡ mu c (mu a p)
it-mlc A mu mas mc a c p = cl-tr3 A (mu a (mu c p)) (mu (mu a c) p) (mu (mu c a) p) (mu c (mu a p)) (λ i → mas a c p (~ i)) (λ i → mu (mc a c i) p) (mas c a p)
