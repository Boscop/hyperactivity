nk-env-ev-ext : (rho1 rho2 : NkW → NkEv) (e : NkEnv) →
  ((w : NkW) → (nk-emem w e ≡ true) → rho1 w ≡ rho2 w) →
  nk-env-ev rho1 e ≡ nk-env-ev rho2 e
nk-env-ev-ext rho1 rho2 nke-nil eq = refl
nk-env-ev-ext rho1 rho2 (nke-cons w r) eq =
  cong (λ z → nkev-cons z (nk-env-ev rho1 r)) (eq w (nk-emem-hd w r))
  ∙ cong (λ z → nkev-cons (rho2 w) z)
      (nk-env-ev-ext rho1 rho2 r (λ x hm → eq x (nk-emem-tl (nk-weq x w) x r hm)))
