-- Semantics algebra (Bool) via ONE fold:
--   tag #0 = XOR, tag #1 = AND, tag #2 = NAND2, tag #3 = NOT(a), other = XOR(a,b)
--   in-dup l a b shares/combines both ports (a XOR b when l=0, a AND b when l=1, else a)
in-opB : Word → Bool → Bool → Bool
in-opB t a b =
  if %weq t #0 then web-xorB a b
  else if %weq t #1 then web-andB a b
  else if %weq t #2 then web-notB (web-andB a b)
  else if %weq t #3 then web-notB a
  else web-xorB a b
