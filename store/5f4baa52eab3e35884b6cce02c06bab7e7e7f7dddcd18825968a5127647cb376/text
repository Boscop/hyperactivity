bu-step : (acc lo x : Word) → wlt acc (wshl #1 lo) ≡ true → bu acc lo x ≡ wadd acc (wmul x (wshl #1 lo))
bu-step acc lo x h =
  catw (congw (λ z → wor (wxor acc (wand acc z)) (wshl x lo)) (wshl-mul #255 lo))
    (catw (congw (λ z → wor (wxor acc z) (wshl x lo)) (wand-disj acc #255 lo h))
      (catw (congw (λ z → wor z (wshl x lo)) (wxor-zero acc))
        (catw (congw (λ z → wor acc z) (wshl-mul x lo)) (wor-disj acc x lo h))))
