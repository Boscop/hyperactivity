-- Schema-Specialized Hardware Filter: pruning unsubscribed tags in the parser state machine
-- agrees with decoding in C++ and filtering downstream!
fd-filter-post : (Nat → Bool) → (Bool × FdFrame) → FdFrame → Bool × FdFrame
fd-filter-post keep res fallback =
  if fst res then (if keep (fst (snd res)) then res else (false , fallback))
  else (false , fallback)
