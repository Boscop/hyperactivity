comm-branch : {Val Op : Type} → (w1 w2 q : Word) → (c1 c2 : WCh Val Op) → (s : WSlot Val Op) →
  weq w1 w2 ≡ false → (b1 b2 : Bool) → weq w1 q ≡ b1 → weq w2 q ≡ b2 →
  (if b1 then wslot-ch c1 (if b2 then wslot-ch c2 s else s) else (if b2 then wslot-ch c2 s else s)) ≡
  (if b2 then wslot-ch c2 (if b1 then wslot-ch c1 s else s) else (if b1 then wslot-ch c1 s else s))
comm-branch w1 w2 q c1 c2 s hdisj false false = λ e1 e2 → refl
comm-branch w1 w2 q c1 c2 s hdisj false true = λ e1 e2 → refl
comm-branch w1 w2 q c1 c2 s hdisj true false = λ e1 e2 → refl
comm-branch w1 w2 q c1 c2 s hdisj true true = λ e1 e2 →
  let eq2 : w2 ≡ q
      eq2 = weq-sound w2 q e2
      w12-true : weq w1 w2 ≡ true
      w12-true = catB (weq w1 w2) (weq w1 q) true (λ i → weq w1 (eq2 i)) e1
  in Empty-rec (false≢true (catB false (weq w1 w2) true (sym hdisj) w12-true))
