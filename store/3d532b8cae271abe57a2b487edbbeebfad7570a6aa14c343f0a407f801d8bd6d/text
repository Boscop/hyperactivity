ev-stepc-assoc : {l : Level} {S : Sig} {V A B C : Type} → (f : A → Ev {l} S V B) → (g : B → Ev {l} S V C) → (c : Ctl V A) →
  ev-bind {l} {S} {V} {B} {C} (ev-stepc {l} {S} {V} {A} {B} f c) g
  ≡ ev-stepc {l} {S} {V} {A} {C} (λ a → ev-bind {l} {S} {V} {B} {C} (f a) g) c
ev-stepc-assoc {l} {S} {V} {A} {B} {C} f g c =
  case c return (λ x → ev-bind {l} {S} {V} {B} {C} (ev-stepc {l} {S} {V} {A} {B} f x) g
                       ≡ ev-stepc {l} {S} {V} {A} {C} (λ a → ev-bind {l} {S} {V} {B} {C} (f a) g) x) of
    c-val a → λ i → ev-bind {l} {S} {V} {B} {C} (f a) g
    c-ret v → λ i → ev-out {l} {S} {V} {C} (mok (c-ret v))
    c-break → λ i → ev-out {l} {S} {V} {C} (mok c-break)
    c-continue → λ i → ev-out {l} {S} {V} {C} (mok c-continue)
    c-throw v → λ i → ev-out {l} {S} {V} {C} (mok (c-throw v))
