bl-rpc-call : List Word → List Word → Proc W (List Word)
bl-rpc-call method paramsJson =
  let req = h-concat
              (cons "{" (cons (h-quote "jsonrpc") (cons ":" (cons (h-quote "2.0")
              (cons "," (cons (h-quote "id") (cons ":1,"
              (cons (h-quote "method") (cons ":" (cons (h-quote method)
              (cons "," (cons (h-quote "params") (cons ":" (cons paramsJson (cons "}" nil)))))))))))))))
  in bl-rpc-post req
