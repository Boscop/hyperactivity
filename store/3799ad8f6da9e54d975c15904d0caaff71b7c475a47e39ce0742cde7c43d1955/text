-- Zero-UB semantics of the 13 emitted `hy_*` C helper functions:
--   - Unsigned uint64_t arithmetic / bitwise operations have NO signed-overflow UB.
--   - `hy_div` and `hy_mod` guard `b == 0` -> return `0` (zero division-by-zero UB).
--   - `hy_shl` and `hy_shr` guard `b < 64` -> else return `0` (zero shift-width UB).
--   - `hy_eq` / `hy_lt` return Bool constructor blocks (tag 0 = true, tag 1 = false).
c-bool : Bool → CVal
c-bool true  = cv-blk #0 nil
c-bool false = cv-blk #1 nil
