-- the first exponent from k, f choices, each followed by every tail rec gives for the rest of the sum
mons-from : Nat → Nat → Nat → (Nat → Mons) → Mons
mons-from k f s rec = case f of
  zero → nil
  suc g → (if leb k s then mons-append (mons-prefix k (rec (monus s k))) (mons-from (suc k) g s rec) else nil)
