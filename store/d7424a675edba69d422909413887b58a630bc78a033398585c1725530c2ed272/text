-- ---------------------------------------------------------------- the fleet
-- nodes 0, 1, 2 run the replica on their replica half; node 3 runs the client behaviour given;
-- there are no other nodes
kv-beh : (KvSt → NView KvMsg KvSt) → Nat → KvSt → NView KvMsg KvSt
kv-beh cb zero st = nview-map {KvMsg} {KvRep} {KvSt} (λ r → (r , snd st)) (kv-rep-view (fst st))
kv-beh cb (suc zero) st = nview-map {KvMsg} {KvRep} {KvSt} (λ r → (r , snd st)) (kv-rep-view (fst st))
kv-beh cb (suc (suc zero)) st = nview-map {KvMsg} {KvRep} {KvSt} (λ r → (r , snd st)) (kv-rep-view (fst st))
kv-beh cb (suc (suc (suc zero))) st = cb st
kv-beh cb (suc (suc (suc (suc j)))) st = v-halt
