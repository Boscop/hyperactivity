-- ============================================================================
-- SECTION 1: SELF-PROFILING HARDWARE COST MODEL & SELF-SUPEROPTIMIZING AST REWRITER
-- ============================================================================

data SelfExpr : Type where
  se-var  : (ix : Word) → SelfExpr
  se-lit  : (val : Word) → SelfExpr
  se-add  : (a b : SelfExpr) → SelfExpr
  se-mul  : (a b : SelfExpr) → SelfExpr
  se-div2 : (a : SelfExpr) → SelfExpr     -- unoptimized `/ 2` (40-cycle div stall!)
  se-shl1 : (a : SelfExpr) → SelfExpr     -- optimized `<< 1`  (1-cycle ALU!)
  se-shr1 : (a : SelfExpr) → SelfExpr     -- optimized `>> 1`  (1-cycle ALU!)
  se-xor  : (a b : SelfExpr) → SelfExpr

so-eval : (Word → Word) → SelfExpr → Word
so-eval env (se-var i)    = env i
so-eval _   (se-lit v)    = v
so-eval env (se-add a b)  = %wadd (so-eval env a) (so-eval env b)
so-eval env (se-mul a b)  = %wmul (so-eval env a) (so-eval env b)
so-eval env (se-div2 a)   = %wdiv (so-eval env a) #2
so-eval env (se-shl1 a)   = %wshl (so-eval env a) #1
so-eval env (se-shr1 a)   = %wshr (so-eval env a) #1
so-eval env (se-xor a b)  = %wxor (so-eval env a) (so-eval env b)

-- Exact structural equality on SelfExpr (enables CSE, involution cancellation & distributive factoring!)
so-eq : SelfExpr → SelfExpr → Bool
so-eq (se-var i)   (se-var j)   = %weq i j
so-eq (se-lit u)   (se-lit v)   = %weq u v
so-eq (se-add a b) (se-add c d) = andB (so-eq a c) (so-eq b d)
so-eq (se-mul a b) (se-mul c d) = andB (so-eq a c) (so-eq b d)
so-eq (se-div2 a)  (se-div2 b)  = so-eq a b
so-eq (se-shl1 a)  (se-shl1 b)  = so-eq a b
so-eq (se-shr1 a)  (se-shr1 b)  = so-eq a b
so-eq (se-xor a b) (se-xor c d) = andB (so-eq a c) (so-eq b d)
so-eq _            _            = false

-- Hardware cycle cost profiler (models real Apple Silicon / Hopper ALU vs divider latency!)
so-cost : SelfExpr → Word
so-cost (se-var _)   = #0
so-cost (se-lit _)   = #0
so-cost (se-add a b) = %wadd #1 (%wadd (so-cost a) (so-cost b))
so-cost (se-mul a b) = %wadd #4 (%wadd (so-cost a) (so-cost b))
so-cost (se-div2 a)  = %wadd #40 (so-cost a)
so-cost (se-shl1 a)  = %wadd #1 (so-cost a)
so-cost (se-shr1 a)  = %wadd #1 (so-cost a)
so-cost (se-xor a b) = %wadd #1 (%wadd (so-cost a) (so-cost b))

-- Smart constructors performing algebraic superoptimization, strength reduction & factoring:
so-mk-add : SelfExpr → SelfExpr → SelfExpr
so-mk-add (se-lit u) (se-lit v) = se-lit (%wadd u v)
so-mk-add (se-lit u) b          = if %weq u #0 then b else se-add (se-lit u) b
so-mk-add a          (se-lit v) = if %weq v #0 then a else se-add a (se-lit v)
so-mk-add (se-mul a x) (se-mul b y) =
  if so-eq x y then
    let s = so-mk-add a b
    in case s of
         se-lit k → if %weq k #2 then se-shl1 x else se-mul (se-lit k) x
         _        → se-mul s x
  else if so-eq (se-mul a x) (se-mul b y) then se-shl1 (se-mul a x)
  else se-add (se-mul a x) (se-mul b y)
so-mk-add a b = if so-eq a b then se-shl1 a else se-add a b

so-mk-mul : SelfExpr → SelfExpr → SelfExpr
so-mk-mul (se-lit u) (se-lit v) = se-lit (%wmul u v)
so-mk-mul (se-lit u) b =
  if %weq u #0 then se-lit #0
  else if %weq u #1 then b
  else if %weq u #2 then se-shl1 b
  else se-mul (se-lit u) b
so-mk-mul a (se-lit v) =
  if %weq v #0 then se-lit #0
  else if %weq v #1 then a
  else if %weq v #2 then se-shl1 a
  else se-mul a (se-lit v)
so-mk-mul a b = se-mul a b

so-mk-shr1 : SelfExpr → SelfExpr
so-mk-shr1 (se-lit u)  = se-lit (%wshr u #1)
so-mk-shr1 (se-shl1 a) = a -- exact cancellation `(a << 1) >> 1` on non-overflowing kernel magnitudes? Keep safe `se-shr1 (se-shl1 a)`!
so-mk-shr1 a           = se-shr1 a

-- Safe 64-bit exact strength reduction (`x / 2 === x >> 1` holds universally for ALL 64-bit unsigned Words!):
so-mk-div2 : SelfExpr → SelfExpr
so-mk-div2 (se-lit u) = se-lit (%wshr u #1)
so-mk-div2 a          = se-shr1 a

so-mk-xor : SelfExpr → SelfExpr → SelfExpr
so-mk-xor (se-lit u) (se-lit v) = se-lit (%wxor u v)
so-mk-xor (se-xor a k1) k2 =
  if so-eq k1 k2 then a
  else if so-eq (se-xor a k1) k2 then se-lit #0
  else se-xor (se-xor a k1) k2
so-mk-xor a b = if so-eq a b then se-lit #0 else se-xor a b

-- Bottom-up self-superoptimizing pass:
so-opt : SelfExpr → SelfExpr
so-opt (se-var i)    = se-var i
so-opt (se-lit v)    = se-lit v
so-opt (se-add a b)  = so-mk-add (so-opt a) (so-opt b)
so-opt (se-mul a b)  = so-mk-mul (so-opt a) (so-opt b)
so-opt (se-div2 a)   = so-mk-div2 (so-opt a)
so-opt (se-shl1 a)   = se-shl1 (so-opt a)
so-opt (se-shr1 a)   = se-shr1 (so-opt a)
so-opt (se-xor a b)  = so-mk-xor (so-opt a) (so-opt b)

-- Unoptimized kernel telemetry/cost expression from our own pipeline:
--   ((((x ^ key) ^ key) / 2) + ((((y * 1) + (y * 1)) / 2) + (z + 0)))
--   Cost before `so-opt`: xor(1)+xor(1)+div2(40) + mul(4)+mul(4)+add(1)+div2(40) + add(1)+add(1)+add(1) = 94 cycles!
so-self-ast : SelfExpr
so-self-ast =
  se-add
    (se-div2 (se-xor (se-xor (se-var #0) (se-lit #31337)) (se-lit #31337)))
    (se-add
      (se-div2 (se-add (se-mul (se-lit #1) (se-var #1)) (se-mul (se-lit #1) (se-var #1))))
      (se-add (se-var #2) (se-lit #0)))

so-test-env : Word → Word → Word
so-test-env i idx =
  if %weq idx #0 then %wmul i #7919
  else if %weq idx #1 then %wadd (%wmul i #104729) #13
  else %wxor i #99991

so-check-equiv-64 : Nat → Word → Bool
so-check-equiv-64 zero _ = true
so-check-equiv-64 (suc k) i =
  let opt = so-opt so-self-ast
  in andB (%weq (so-eval (so-test-env i) opt) (so-eval (so-test-env i) so-self-ast))
          (so-check-equiv-64 k (%wadd i #1))

-- THEOREM 1 (SELF-SUPEROPTIMIZATION):
-- `so-opt` cuts `so-self-ast` hardware cycle cost from 94 -> 5 cycles (18.8x reduction!),
-- preserves exact evaluation across all 64 test environments, AND hits exact idempotent fixed point!
so-thm-self-superopt-fixpoint :
  let opt1 = so-opt so-self-ast
      opt2 = so-opt opt1
  in andB (%weq (so-cost so-self-ast) #94)
     (andB (%weq (so-cost opt1) #5)
     (andB (so-eq opt2 opt1)
           (so-check-equiv-64 (toNat #64) #0))) ≡ true
so-thm-self-superopt-fixpoint = refl

-- ============================================================================
-- SECTION 2: ALGORITHMIC SELF-OPTIMIZATION — O(log2 N) CONCAVE BINARY SLOPE SEARCH
-- ============================================================================
-- Proves that finding the optimal AMM arbitrage trade size `dx*` over [1..512] via
-- 9-step O(log2 N) Concave Binary Slope Search (`profit(mid+1) > profit(mid)`) produces
-- the EXACT SAME optimal trade size `dx* = 333,000` and `net_profit = 330,497` as scanning
-- all 512 trade sizes linearly (`56.9x` fewer AMM evaluations)!

so-amm-out : Word → Word → Word → Word
so-amm-out rx ry dx =
  let dxf = %wmul dx #997
      den = %wadd (%wmul rx #1000) dxf
  in if %weq den #0 then #0 else %wdiv (%wmul ry dxf) den

so-arb-out : Word → Word
so-arb-out s =
  let dx = %wmul s #1000
      dy = so-amm-out #1000000 #2000000 dx
  in so-amm-out #1000000 #2000000 dy

so-arb-profit-gas : Word → Word → Word
so-arb-profit-gas gas s =
  let dx   = %wmul s #1000
      out  = so-arb-out s
      cost = %wadd dx gas
  in if %wlt cost out then %wsub out cost else #0

so-arb-profit : Word → Word
so-arb-profit s = so-arb-profit-gas #500 s

-- Exhaustive O(N) linear scan parameterized by fixed gas fee:
so-lin-best-gas : Word → Nat → Word → Word → Word
so-lin-best-gas _   zero _ best = best
so-lin-best-gas gas (suc k) s best =
  let p  = so-arb-profit-gas gas s
      b2 = if %wlt best p then p else best
  in so-lin-best-gas gas k (%wadd s #1) b2

so-lin-best : Nat → Word → Word → Word
so-lin-best k s best = so-lin-best-gas #500 k s best

-- Self-optimized O(log2 N) UNCLAMPED concave binary slope search:
-- Uses unsigned `out(mid+1) + dx(mid) > out(mid) + dx(mid+1)` (`g(mid+1) > g(mid)` over Z!),
-- eliminating the clamped-zero plateau when small `dx` has `out <= dx + gas`!
so-bin-best-gas : Word → Nat → Word → Word → Word
so-bin-best-gas gas zero lo _ = so-arb-profit-gas gas lo
so-bin-best-gas gas (suc k) lo hi =
  if %weq lo hi then so-arb-profit-gas gas lo
  else
    let mid  = %wshr (%wadd lo hi) #1
        s1   = %wadd mid #1
        dx0  = %wmul mid #1000
        dx1  = %wmul s1 #1000
        out0 = so-arb-out mid
        out1 = so-arb-out s1
    in if %wlt (%wadd out0 dx1) (%wadd out1 dx0) then so-bin-best-gas gas k s1 hi
       else so-bin-best-gas gas k lo mid

so-bin-best : Nat → Word → Word → Word
so-bin-best k lo hi = so-bin-best-gas #500 k lo hi

-- Naive clamped-plateau binary search (documented counterexample at high gas = 325,000):
so-bin-clamped-naive : Word → Nat → Word → Word → Word
so-bin-clamped-naive gas zero lo _ = so-arb-profit-gas gas lo
so-bin-clamped-naive gas (suc k) lo hi =
  if %weq lo hi then so-arb-profit-gas gas lo
  else
    let mid = %wshr (%wadd lo hi) #1
        p0  = so-arb-profit-gas gas mid
        p1  = so-arb-profit-gas gas (%wadd mid #1)
    in if %wlt p0 p1 then so-bin-clamped-naive gas k (%wadd mid #1) hi
       else so-bin-clamped-naive gas k lo mid

-- Exact Barrett magic-multiply modulo-3 replacement (`b % 3 == b - 3 * ((b * 171) >> 9)` for ALL b in 0..255!):
so-barrett-mod3 : Word → Word
so-barrett-mod3 b = %wsub b (%wmul #3 (%wshr (%wmul b #171) #9))

so-real-mod3 : Word → Word
so-real-mod3 b = %wsub b (%wmul #3 (%wdiv b #3))

so-check-mod3-256 : Nat → Word → Bool
so-check-mod3-256 zero _ = true
so-check-mod3-256 (suc k) b =
  andB (%weq (so-barrett-mod3 b) (so-real-mod3 b))
       (so-check-mod3-256 k (%wadd b #1))

-- Exact Barrett division-by-5 (`(x * 52429) >> 18 == x / 5` exact up to x = 65,535!):
so-barrett-div5 : Word → Word
so-barrett-div5 x = %wshr (%wmul x #52429) #18

so-check-div5-4096 : Nat → Word → Bool
so-check-div5-4096 zero _ = true
so-check-div5-4096 (suc k) x =
  andB (%weq (so-barrett-div5 x) (%wdiv x #5))
       (so-check-div5-4096 k (%wadd x #1))

-- THEOREM 2: 9-STEP UNCLAMPED CONCAVE BINARY SLOPE SEARCH EQUALS 512-STEP LINEAR SCAN
-- BOTH AT LOW GAS (`330,497`) AND HIGH GAS = 325,000 (`5,997`, WHERE NAIVE CLAMPED SEARCH FAILS WITH `0`!),
-- PLUS BARRETT MOD-3 (ALL 256 BYTES) AND BARRETT DIV-5 (ALL 0..4095) BY `refl`!
so-thm-concave-binary-eq-linear :
  andB (%weq (so-bin-best (toNat #9) #1 #512) (so-lin-best (toNat #512) #1 #0))
  (andB (%weq (so-bin-best (toNat #9) #1 #512) #330497)
  (andB (%weq (so-bin-clamped-naive #325000 (toNat #9) #1 #512) #0)
  (andB (%weq (so-bin-best-gas #325000 (toNat #9) #1 #512) (so-lin-best-gas #325000 (toNat #512) #1 #0))
  (andB (%weq (so-bin-best-gas #325000 (toNat #9) #1 #512) #5997)
  (andB (so-check-mod3-256 (toNat #256) #0)
        (so-check-div5-4096 (toNat #4096) #0)))))) ≡ true
so-thm-concave-binary-eq-linear = refl

