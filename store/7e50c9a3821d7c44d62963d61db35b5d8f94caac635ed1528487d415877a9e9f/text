-- every entry of Kasai's LCP over ranks that order the suffixes is exact, and its predecessor is the one before it in the suffix array
kasai-by-ok : (t : List (List Word)) → (rr : List Word) → FinalP t rr → k-All t (kasai-by t rr)
kasai-by-ok t rr fp =
  subst {_} {_} {List KOut} {λ w → k-All t w} (sym (k-run-path t rr (fst fp) (fst (snd fp))))
    (k-scan-good t (fst fp) (snd (snd fp)) t zero (mon-self t) (k-hint-zero t (fst fp) t))
