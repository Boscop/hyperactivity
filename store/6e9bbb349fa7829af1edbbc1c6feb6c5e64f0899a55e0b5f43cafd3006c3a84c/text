-- Forward direction: if any macro-law g descends through o, then T necessarily preserves fibers.
descent-preserves-fiber : {S O : Type} → (o : S → O) → (T : S → S) → (g : O → O) →
  Descends o T g → PreservesFibers o T
descent-preserves-fiber o T g d s1 s2 eq =
  concat (sym (d s1)) (concat (cong g eq) (d s2))
