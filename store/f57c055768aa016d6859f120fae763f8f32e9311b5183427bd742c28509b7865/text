-- ---------------------------------------------------------------- 2. `[8,4,4]` SECDED Encoder & Parity Syndrome
secded-encode : Msg4 → Code8
secded-encode m =
  let d0 = fst m
      d1 = fst (snd m)
      d2 = fst (snd (snd m))
      d3 = snd (snd (snd m))
      c1 = b-xor2 d0 (b-xor2 d1 d3)
      c2 = b-xor2 d0 (b-xor2 d2 d3)
      c3 = d0
      c4 = b-xor2 d1 (b-xor2 d2 d3)
      c5 = d1
      c6 = d2
      c7 = d3
      c0 = b-xor2 (b-xor2 c1 (b-xor2 c2 c3)) (xor4 c4 c5 c6 c7)
  in mk-code8 c0 c1 c2 c3 c4 c5 c6 c7
