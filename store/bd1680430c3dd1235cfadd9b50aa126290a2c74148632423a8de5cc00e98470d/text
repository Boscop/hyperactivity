-- ---------------------------------------------------------------- 1. Proof-gated reshaping co-processor
-- Unlike a lexical password (proved insufficient in neuro/coproc.cub `lexical-gate-fails`),
-- a SafeGateCmd requires an explicit proof term `w : W` (e.g. SafeAt o y P or Warranted ...)
-- to flip from decoupled/probing mode (false) into active coupled co-processing mode (true).
data SafeGateCmd (S-probe S-active : Sig) (W : Type) (m : Bool) =
    sg-act (c : Cmd (if m then S-active else S-probe))
  | sg-activate (w : W)
  | sg-decouple
