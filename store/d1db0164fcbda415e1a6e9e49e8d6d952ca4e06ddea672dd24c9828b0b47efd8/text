-- Replay a packed 6-bit-per-gate NAND2 netlist (g = (i << 3) | j), supporting up to 6 gates (last gate returned directly).
hs-exec-go : Word → Word → Word → Word → Nat → Word
hs-exec-go last _ _ _ zero = last
hs-exec-go _ bank nw prog (suc k) =
  let g = %wand prog #63
      i = %wshr g #3
      j = %wand g #7
      t = hs-nand (hs-get bank i) (hs-get bank j)
      b2 = if %wlt nw #8 then hs-set bank nw t else bank
  in hs-exec-go t b2 (%wsucc nw) (%wshr prog #6) k
