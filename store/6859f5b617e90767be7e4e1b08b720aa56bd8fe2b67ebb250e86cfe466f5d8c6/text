-- an accumulated summand can be added last
se-shift : {G : Type} → (ops : SeOps G) → SeLaws ops → (acc y : G) → (r : List G) →
  se-foldl (se-add ops) (se-add ops acc y) r ≡ se-add ops (se-foldl (se-add ops) acc r) y
se-shift {G} ops laws acc y nil = λ k → se-add ops acc y
se-shift {G} ops laws acc y (cons z r) =
  concat {lzero} {G} {se-foldl (se-add ops) (se-add ops (se-add ops acc y) z) r} {se-foldl (se-add ops) (se-add ops (se-add ops acc z) y) r} {se-add ops (se-foldl (se-add ops) (se-add ops acc z) r) y}
    (λ k → se-foldl (se-add ops) (concat {lzero} {G} {se-add ops (se-add ops acc y) z} {se-add ops acc (se-add ops y z)} {se-add ops (se-add ops acc z) y}
      (fst laws acc y z)
      (concat {lzero} {G} {se-add ops acc (se-add ops y z)} {se-add ops acc (se-add ops z y)} {se-add ops (se-add ops acc z) y}
        (λ k2 → se-add ops acc (fst (snd laws) y z k2)) (λ k2 → fst laws acc z y (~ k2))) k) r)
    (se-shift ops laws (se-add ops acc z) y r)
