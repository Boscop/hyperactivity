ftbl-find-shift-pos : (fib : FTbl) → (acc y C f : Word) →
                      ftbl-find acc y (ftbl-shift-pos fib) ≡ some (C , f) → wlt #0 f ≡ true
ftbl-find-shift-pos fib =
  case fib return (λ u → (acc y C f : Word) → ftbl-find acc y (ftbl-shift-pos u) ≡ some (C , f) → wlt #0 f ≡ true) of
    nil → λ acc y C f h → Empty-rec (cm-none-some-absurd h)
    cons e r → λ acc y C f →
      let c = cm-pos-w (snd e)
      in ifP {λ b → (if b then some (acc , wadd c c)
                     else ftbl-find (wadd acc (wadd c c)) y (ftbl-shift-pos r)) ≡ some (C , f) →
                    wlt #0 f ≡ true} {weq y (wadd #1 (fst e))}
           (λ _ h →
              let pf : wadd c c ≡ f
                  pf = λ i → snd (cm-some-inj h i)
              in cm-catb (cm-congb (λ z → wlt #0 z) (symw pf)) (cm-mul2-gt0 c (cm-pos-w-gt0 (snd e))))
           (λ _ h → rec r (wadd acc (wadd c c)) y C f h)
