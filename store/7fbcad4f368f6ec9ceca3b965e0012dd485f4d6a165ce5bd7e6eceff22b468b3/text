-- Helper: step preserves defect ≡ 0 along any number of steps.
fold-descent-keeps-zero :
  (C : Type 0) → (defect : C → Nat) → (step : C → C) →
  ((c : C) → defect c ≡ zero → defect (step c) ≡ zero) →
  (k : Nat) → (c : C) → defect c ≡ zero → defect (fold-descent k step c) ≡ zero
fold-descent-keeps-zero C defect step keep zero c z = z
fold-descent-keeps-zero C defect step keep (suc k) c z =
  fold-descent-keeps-zero C defect step keep k (step c) (keep c z)
