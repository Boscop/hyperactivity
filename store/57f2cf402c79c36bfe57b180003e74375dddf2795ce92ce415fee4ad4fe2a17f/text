-- a too-large factor forces S = 0
lcm-zero : (a b S m k : Nat) → plus m (times a S) ≡ times b S → plus k (suc b) ≡ a → S ≡ zero
lcm-zero a b S m k hm ka = plus-zero-r (plus m (times k S)) S
  (plus-cancel-l (times b S) (plus (plus m (times k S)) S) zero
    (transN (plus-comm (times b S) (plus (plus m (times k S)) S))
    (transN (plus-assoc (plus m (times k S)) S (times b S))
    (transN (plus-assoc m (times k S) (plus S (times b S)))
    (transN (congN (plus m) (transN (symN (times-distr k (suc b) S)) (congN (λ z → times z S) ka)))
    (transN hm (symN (plus-zero (times b S)))))))))
