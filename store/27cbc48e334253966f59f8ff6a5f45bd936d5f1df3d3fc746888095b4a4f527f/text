cs-for-t2 : Word → List Word → List Word
cs-for-t2 d t3 =
  let d0 = ce-dec d
      d1 = ce-dec (%wsucc d)
  in list-append "; for (uint64_t v" (list-append d0 (list-append " = 0; v" (list-append d0 (list-append " < w" (list-append d0 (list-append "; v" (list-append d0 (list-append "++) { v" (list-append d1 (list-append " = " t3))))))))))
