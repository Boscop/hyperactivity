-- the nodes a document is essential context of
hi-context-of : List Word → List Word → List Word → List (List Word) → Proc W (List Word)
hi-context-of st rd f nil = ret nil
hi-context-of st rd f (cons n r) = bind (hi-show st n) (λ s → bind (hi-context-of st rd f r) (λ rest →
  if h-infix (list-append "essential context: " f) (s-or nil s) then bind (hi-card st rd n) (λ c → ret (list-append c rest)) else ret {lzero} {W} rest))
