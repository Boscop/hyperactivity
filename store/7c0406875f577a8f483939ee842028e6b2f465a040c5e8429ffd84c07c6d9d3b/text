-- Endpoint Connectivity & 3D Zero-Short-Circuit Disjointness Theorems:
route-connects-pins : (xs ys yt xd yd : Nat) →
  (route-start (troute xs ys yt xd yd) ≡ (m2-vert , (xs , ys))) ×
  (route-end   (troute xs ys yt xd yd) ≡ (m2-vert , (xd , yd)))
route-connects-pins xs ys yt xd yd = ( (λ _ → (m2-vert , (xs , ys))) , (λ _ → (m2-vert , (xd , yd))) )
