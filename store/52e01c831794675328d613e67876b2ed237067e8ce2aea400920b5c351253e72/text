w-pack : List Word → List (List Word) → List (List Word)
w-pack cur nil = if h-null cur then nil else cons cur nil
w-pack cur (cons u r) =
  if h-null cur then w-pack u r else
  if wlt w-chunk (wadd (w-len cur) (wadd #2 (w-len u))) then cons cur (w-pack u r) else
  if andB (w-heading u) (wlt (wquot w-chunk #2) (w-len cur)) then cons cur (w-pack u r)
  else w-pack (list-append cur (cons #10 (cons #10 u))) r
