-- Refill base-256 bytes while s < L (i.e. wlt s L ≡ true)
sr-refill-loop : Nat → Word → Word → List Word → SRState
sr-refill-loop zero L s out = (s , out)
sr-refill-loop (suc fuel) L s out =
  if wlt s L then
    (case out of
      nil → (s , nil)
      cons b rest → sr-refill-loop fuel L (wadd (wmul s sr-base) b) rest)
  else (s , out)
