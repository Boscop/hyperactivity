-- a user still uses the name when it is still written (written/) and its definition still depends on the name (deps/)
hy-still-uses : List Word → List Word → List (List Word) → Proc W (List (List Word))
hy-still-uses st name nil = ret nil
hy-still-uses st name (cons u r) =
  bind (hy-get st (list-append "deps/" (h-hex u))) (λ d → bind (hy-get st (list-append "written/" (h-hex u))) (λ w →
  bind (hy-still-uses st name r) (λ rest →
  ret (hy-cons-if (andB (hy-held w) (h-has name (h-lines (hy-or nil d)))) u rest))))
