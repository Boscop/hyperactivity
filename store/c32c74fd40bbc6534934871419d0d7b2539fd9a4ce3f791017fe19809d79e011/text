-- Generate antiparallel β-hairpin ladder contacts centered at turn position (t, t+1):
-- pairs (t - k, t + 1 + k) outward while both indices remain in bounds.
sf-hairpin-out : Nat → Nat → Nat → Nat → List (Nat × Nat)
sf-hairpin-out fuel lo hi n = case fuel of
  zero → nil
  suc f →
    if leb n hi then nil
    else cons (lo , hi) (case lo of
      zero → nil
      suc lo' → sf-hairpin-out f lo' (suc hi) n)
