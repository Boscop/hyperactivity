emit-elf64-x86 : Word → INetExpr → List Word
emit-elf64-x86 env e =
  let optE   = the INetExpr (superchip-opt e)
      prolog = the (List Word) (list-append (cons #73 (cons #184 nil)) (bn-u64-le (bn-w64 env)))
      body   = the (List Word) (bn-x86-emit-expr optE)
  in bn-elf64-image #62 (list-append prolog (list-append body bn-x86-epilog))
