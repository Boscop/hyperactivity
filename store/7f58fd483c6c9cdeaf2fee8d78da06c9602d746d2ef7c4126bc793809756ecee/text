-- uncurated / private keys (allow k ≡ false) are unconditionally withheld on the peer's port
curated-private-withheld : {K V : Type} → (allow : K → Bool) → (priv : CAStore K V) → (k : K) →
  allow k ≡ false → curate-store allow priv k ≡ inl unit
curated-private-withheld allow priv k hpriv = λ i → if hpriv i then priv k else inl unit
