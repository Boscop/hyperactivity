-- a judgement recorded: the piece's re-expression kept, and the pull added to the pulls made
hy-judged : List Word → List (List Word) → List Word → Proc W Unit
hy-judged st a xy = bind (h-read (hy-pulls-path st)) (λ pt →
  bind (if h-eq (hy-head a) "re-expressed"
    then bind h-stdin (λ e → bind (h-write (hy-self-path st (list-length (hy-pulls pt)) "piece") e) (λ b → ret unit))
    else h-unlink (hy-self-path st (list-length (hy-pulls pt)) "piece")) (λ u →
  bind (h-write (hy-pulls-path st) (list-append (hy-or nil pt) (h-line (list-append (hy-sep " " (list-map h-decimal xy))
    (list-append " " (if h-eq (hy-head a) "re-expressed" then "r" else "w")))))) (λ b → ret unit)))
