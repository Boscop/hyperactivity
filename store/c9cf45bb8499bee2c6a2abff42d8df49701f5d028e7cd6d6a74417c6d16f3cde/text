-- the check, done once when the bytes are made: the table from p and the records from o are the tokens L
si-chk-chain : (n : Nat) → Bytes n → Word → Word → List (List Word) → Bool
si-chk-chain n B p o L = (case L return λ w → Word → Word → Bool of
  nil → λ p o → weq (cstr-get n B o) #0
  cons y r → λ p o → andB (weq (si-rd4 n B p) o) (andB (weq (cstr-get n B o) #1) (andB (tok-eq (si-tok n B o) y) (rec r (wadd p #4) (si-next n B o))))) p o
