  (hw-ln "for n in ${NODES[@]}; do ssh $n 'cd ~/hyperactivity && make -j && ./build/cubical --read lib/hx.hypercubical' & done; wait"
  (hw-ln "echo '[4/4] Ready: launch 671B/405B bit-exact lossless serving + 256-site DMRG + hx-strike GPU superopt!'"
  (hw-ln "# mlx.launch --backend jaccl --hostfile hx_k4_hosts.json -- python3 serve_hx_llmzip.py --model DeepSeek-671B-BF16" nil)))))))))))))))
