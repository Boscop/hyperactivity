-- Parameter-free global argmin over exact discrete post-rewrite cut counts:
prof-prescribe-geodesic : FactorStats → OptAction
prof-prescribe-geodesic fs =
  let b1 = prof-pick-better fs opt-optimal opt-hyperfactor
      b2 = prof-pick-better fs b1 opt-erase-dead
      b3 = prof-pick-better fs b2 opt-inline-ann
  in prof-pick-better fs b3 opt-poly-tile
