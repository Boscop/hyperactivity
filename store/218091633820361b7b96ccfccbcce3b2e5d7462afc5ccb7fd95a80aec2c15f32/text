-- ---------------------------------------------------------------- the broadcasting client
-- it sends each write of c-out to its addressee, in order, and stops (it awaits nothing)
kv-bc-go : KvSt → List (NodeId × KvWrite) → NView KvMsg KvSt
kv-bc-go st out = case out of
  nil → v-halt
  cons e r → v-send (fst e) (m-put (snd e)) (fst st , KvCli { c-hist = c-hist (snd st) ; c-conf = c-conf (snd st) ; c-idx = c-idx (snd st) ; c-todo = c-todo (snd st) ; c-ph = c-ph (snd st) ; c-out = r })
