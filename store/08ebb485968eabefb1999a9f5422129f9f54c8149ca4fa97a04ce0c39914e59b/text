-- nk-spec-h: the specializer alone under that schedule (part of machine-in-hyperactive)
nk-spec-h : Code → Code
nk-spec-h (cglob g) =
  (case unfold g return (λ _ → Code) of
     none → cword
     some c → fst (specialize (opt-or (def-type-code g) cword) (sched #64 lnil nk-holds) lnil c))
nk-spec-h c = c
