-- one term: the loops over μ₂ and μ₁
eig-map : VM → VM → VM → SQ → List SQ → SQ → List SQ → Nat → Bool → Nat → Bool → Nat → List Nat → Rows → Rows
eig-map a1 a2 aP mu1 es1 mu2 es2 k sn n sm m dsP xs0 = hop-fin a2 aP k sn n sm m dsP (eig-proj a2 mu2 es2 (hop-mid a1 a2 k sn n sm m dsP (eig-proj a1 mu1 es1 (to-coords a1 (first-maps k sn n dsP xs0)))))
