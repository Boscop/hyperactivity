skip-const-d : (e : Entry) (sk' : Lst Entry) (X : Type 1) (F : X → Type 1) (x : X) (y : F x) →
  PathP (λ i → DCube (dims (lcons e sk')) X F (skip-const e sk' X x i))
    (dcube-const (dims (lcons e sk')) X F x y) (skip-d e sk' X F (cube-const (dims sk') X x) (dcube-const (dims sk') X F x y))
skip-const-d (e-ty s) sk' X F x y = λ i → dcube-const (dims sk') X F x y
skip-const-d e-dim sk' X F x y =
  psym-d (Cube (dims sk') (Line X)) (DCube (dims sk') (Line X) (LineO X F))
    (cube-map (dims sk') X (Line X) (degen-l X) (cube-const (dims sk') X x)) (cube-const (dims sk') (Line X) (degen-l X x))
    (const-map (dims sk') X (Line X) (degen-l X) x)
    (dcube-reidx (dims sk') X (Line X) F (LineO X F) (degen-l X) (degen-o X F) (cube-const (dims sk') X x) (dcube-const (dims sk') X F x y))
    (dcube-const (dims sk') (Line X) (LineO X F) (degen-l X x) (degen-o X F x y))
    (const-map-d (dims sk') X (Line X) F (LineO X F) (degen-l X) (degen-o X F) x y)
