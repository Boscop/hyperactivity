-- a ring of radius R stays within [1000 - R, 1000 + R] on both axes, for every slot
hi-within : Word → Word → Word → Bool
hi-within rr c i = andB (h-not (wlt (fst (hi-place rr i)) (wsub #1000 rr))) (andB (wlt (fst (hi-place rr i)) (wadd #1001 rr))
  (andB (h-not (wlt (snd (hi-place rr i)) (wsub #1000 rr))) (wlt (snd (hi-place rr i)) (wadd #1001 rr))))
