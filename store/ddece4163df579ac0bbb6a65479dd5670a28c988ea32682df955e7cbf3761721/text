app-coh : (Γ : CCtx) (a b : TyShape) (R : Mean Γ (AppV a b)) →
  PathM Γ (Sem a) (fmapM Γ (TV a) (Sem a) (λ q → fst q) (fmapM Γ (AppV a b) (TV a) (app-a a b) R))
    (fmapM Γ (TV (s-fam f-pi a b)) (Sem a) (app-ty a b) (fmapM Γ (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) R))
app-coh Γ a b R =
  pcat (Mean Γ (Sem a)) (fmapM Γ (TV a) (Sem a) (λ q → fst q) (fmapM Γ (AppV a b) (TV a) (app-a a b) R)) (fmapM Γ (AppV a b) (Sem a) (λ z → fst (fst z)) R)
    (fmapM Γ (TV (s-fam f-pi a b)) (Sem a) (app-ty a b) (fmapM Γ (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) R))
    (fmapM-fmapM Γ (AppV a b) (TV a) (Sem a) (app-a a b) (λ q → fst q) R)
    (psym (Mean Γ (Sem a)) (fmapM Γ (TV (s-fam f-pi a b)) (Sem a) (app-ty a b) (fmapM Γ (AppV a b) (TV (s-fam f-pi a b)) (app-f a b) R)) (fmapM Γ (AppV a b) (Sem a) (λ z → fst (fst z)) R)
       (fmapM-fmapM Γ (AppV a b) (TV (s-fam f-pi a b)) (Sem a) (app-f a b) (app-ty a b) R))
