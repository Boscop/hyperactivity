-- two nanoforms of one molecule with different size distributions: no function of the molecule gives both
-- fractions, so the molecule does not determine the nanoform. This is polymorph-not-determined again, one
-- level further out -- the molecule does not determine the solid, and the solid does not determine the
-- nanoform.
nanoform-not-determined : (M : Mol) → (n1 : Nanoform) → (n2 : Nanoform) → nf-mol n1 ≡ M → nf-mol n2 ≡ M → (nf-frac n1 ≡ nf-frac n2 → Empty) → ((h : Mol → Nat) → ((n : Nanoform) → h (nf-mol n) ≡ nf-frac n) → Empty)
nanoform-not-determined M n1 n2 q1 q2 no =
  λ h → λ agrees → no (concat (sym (agrees n1)) (concat (cong h q1) (concat (cong h (sym q2)) (agrees n2))))
