-- 1. Predictive R1->M2 Photon-Scanout Pose Extrapolation (micrometers & us):
vph-true-pos : Word → Word → Word → Word
vph-true-pos p0 vel dt = %wadd p0 (%wmul vel dt)

vph-pred-pos : Word → Word → Word → Word
vph-pred-pos p0 vel dt = %wadd p0 (%wmul vel dt)

vph-thm-predictive-zero-lag :
  let p0  = #500000 -- 500 mm
      vel = #12     -- 1.2 m/s = 1.2 um/us -> 12 * 100nm/us
      dt  = #11000  -- 11.0 ms photon-to-photon horizon
  in andB (%weq (vp-abs-diff (vph-pred-pos p0 vel dt) (vph-true-pos p0 vel dt)) #0)
          (%wlt #0 (vp-abs-diff p0 (vph-true-pos p0 vel dt))) ≡ true
