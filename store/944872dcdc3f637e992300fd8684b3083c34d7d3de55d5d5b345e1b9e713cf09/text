-- the laws of a module W over them: 0·x = 0, 0 + x = x, c·(u + v) = c·u + c·v, (p + q)·x = p·x + q·x, c·(a·y) = (c·a)·y,
-- the interchange, x + 0 = x
sy-WL : (A W : Type) → A → (A → A → A) → (A → A → A) → W → (W → W → W) → (A → W → W) → Type
sy-WL A W z ad mu wz wa ws = ((x : W) → ws z x ≡ wz) × (((x : W) → wa wz x ≡ x) × (((c : A) → (u v : W) → ws c (wa u v) ≡ wa (ws c u) (ws c v)) × (((p q : A) → (x : W) → ws (ad p q) x ≡ wa (ws p x) (ws q x)) × (((c a : A) → (y : W) → ws c (ws a y) ≡ ws (mu c a) y) × (((p q r s : W) → wa (wa p q) (wa r s) ≡ wa (wa p r) (wa q s)) × ((x : W) → wa x wz ≡ x))))))
