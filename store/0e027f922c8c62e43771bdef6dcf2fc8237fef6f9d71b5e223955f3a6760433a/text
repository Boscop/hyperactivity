-- one term of Racah's sum: the reciprocal of k!(a−k)!(y1−k)!(x2−k)!(b−y1+k)!(c−x2+k)!, and zero where
-- any of those factorials would have a negative argument
racah-term : Nat → Nat → Nat → Nat → Nat → Nat → QP
racah-term a b c y1 x2 k =
  if leb k a then (if leb k y1 then (if leb k x2 then (if leb y1 (plus b k) then (if leb x2 (plus c k)
    then (suc zero , times (fact k) (times (fact (monus a k)) (times (fact (monus y1 k)) (times (fact (monus x2 k)) (times (fact (monus (plus b k) y1)) (fact (monus (plus c k) x2)))))))
    else (zero , suc zero)) else (zero , suc zero)) else (zero , suc zero)) else (zero , suc zero)) else (zero , suc zero)
