nk-plan-stable : (sl : NkSlots) (u n : Word) (fx : NkFx) → nk-apart u fx → nk-apart (nk-rw (nk-get sl u) u) fx → nk-plan (nk-get (nk-do fx sl) u) u n (nk-do fx sl) ≡ nk-plan (nk-get sl u) u n sl
nk-plan-stable sl u n fx a1 a2 =
  cong (λ s → nk-plan s u n (nk-do fx sl)) (nk-get-do-apart fx sl u a1)
  ∙ nk-plan-at (nk-get sl u) u n (nk-do fx sl) sl (nk-get-do-apart fx sl (nk-rw (nk-get sl u) u) a2)
