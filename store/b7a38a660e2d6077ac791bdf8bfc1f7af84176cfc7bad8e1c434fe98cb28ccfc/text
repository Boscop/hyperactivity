-- a - b ≤ a
cm-subw-le : (a b : Word) → ltw a (subw a b) ≡ false
cm-subw-le a =
  %welimP (λ v → (b : Word) → ltw v (subw v b) ≡ false) a
    (λ b i → false)
    (λ n ih b → %welimP (λ v → ltw (%wsucc n) (subw (%wsucc n) v) ≡ false) b
                  (cm-ltw-add-l-false (%wsucc n) #0)
                  (λ m g → cm-ltw-le-chain (subw n m) n (%wsucc n) (ih m) (cm-ltw-asym n (%wsucc n) (cm-ltw-suc n))))
