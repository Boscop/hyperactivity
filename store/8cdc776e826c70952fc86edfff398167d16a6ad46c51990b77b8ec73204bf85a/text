bl-cd-increase-liq : Word → Word → Word → List Word
bl-cd-increase-liq tokId amt0 amt1 =
  h-concat
    (cons (bl-sel4-bytes "increaseLiquidity((uint256,uint256,uint256,uint256,uint256,uint256))")
    (cons (eth-word-be32 tokId)
    (cons (eth-word-be32 amt0)
    (cons (eth-word-be32 amt1)
    (cons (eth-word-be32 #0)
    (cons (eth-word-be32 #0)
    (cons (eth-word-be32 #1999999999) nil)))))))
