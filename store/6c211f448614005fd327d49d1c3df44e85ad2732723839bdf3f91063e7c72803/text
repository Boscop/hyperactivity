-- ============================================================================

sf-q : List Word
sf-q = cons #34 nil

sf-nl : List Word
sf-nl = cons #10 nil

sf-bs : List Word
sf-bs = cons #92 nil

sf-sq : List Word → List Word
sf-sq s = h-concat (cons sf-q (cons s (cons sf-q nil)))

sf-att : List Word → List Word → List Word
sf-att k v = h-concat (cons " " (cons k (cons "=" (cons (sf-sq v) nil))))

sf-tag : List Word → List Word → List Word → List Word
sf-tag t attrs body =
  h-concat (cons "<" (cons t (cons attrs (cons ">" (cons body (cons "</" (cons t (cons ">" nil))))))))

sf-code : List Word → List Word
sf-code s = sf-tag "code" nil s

sf-strong : List Word → List Word
sf-strong s = sf-tag "strong" nil s

sf-a : List Word → List Word → List Word
sf-a href body = sf-tag "a" (sf-att "href" href) body

sf-td : List Word → List Word
sf-td body = sf-tag "td" nil body

sf-tr : List Word → List Word
sf-tr cells = sf-tag "tr" nil cells

sf-row3 : List Word → List Word → List Word → List Word
sf-row3 c1 c2 c3 =
  list-append "            " (list-append (sf-tr (h-concat (cons (sf-td c1) (cons (sf-td c2) (cons (sf-td c3) nil))))) sf-nl)

sf-row4 : List Word → List Word → List Word → List Word → List Word
sf-row4 c1 c2 c3 c4 =
  list-append "          " (list-append (sf-tr (h-concat (cons (sf-td c1) (cons (sf-td c2) (cons (sf-td c3) (cons (sf-td c4) nil)))))) sf-nl)

sf-row6 : List Word → List Word → List Word → List Word → List Word → List Word → List Word
sf-row6 c1 c2 c3 c4 c5 c6 =
  list-append "          " (list-append (sf-tr (h-concat (cons (sf-td c1) (cons (sf-td c2) (cons (sf-td c3) (cons (sf-td c4) (cons (sf-td c5) (cons (sf-td c6) nil)))))))) sf-nl)

-- Exact single-occurrence substring replacement (total, deterministic, returns (found, newText))
sf-starts-with : List Word → List Word → Bool
sf-starts-with nil _ = true
sf-starts-with (cons _ _) nil = false
sf-starts-with (cons a as) (cons b bs) =
  if %weq a b then sf-starts-with as bs else false

sf-drop-n : List Word → List Word → List Word
sf-drop-n nil s = s
sf-drop-n (cons _ _) nil = nil
sf-drop-n (cons _ ps) (cons _ ss) = sf-drop-n ps ss

sf-replace-first : List Word → List Word → List Word → Bool × List Word
sf-replace-first pat rep nil = (false , nil)
sf-replace-first pat rep (cons c cs) =
  if sf-starts-with pat (cons c cs) then
    (true , list-append rep (sf-drop-n pat (cons c cs)))
  else
    let r = sf-replace-first pat rep cs
    in (fst r , cons c (snd r))

-- THEOREM 4: EXACT REPLACEMENT SOUNDNESS BY REFL
sf-thm-replace-exact :
  fst (sf-replace-first "32" "38+" "Stack: 32 engines") ≡ true
sf-thm-replace-exact = refl

sf-apply-patches : List (List Word × List Word) → List Word → Word × List Word
sf-apply-patches nil txt = (#0 , txt)
sf-apply-patches (cons pr rest) txt =
  let r1 = sf-replace-first (fst pr) (snd pr) txt
      r2 = sf-apply-patches rest (snd r1)
  in (if fst r1 then %wadd #1 (fst r2) else fst r2 , snd r2)

