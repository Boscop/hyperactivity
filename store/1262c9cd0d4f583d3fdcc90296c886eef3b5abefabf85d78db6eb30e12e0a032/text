-- the steps of Glue on a normal form: a Glue type or an element with a face at the end 1 is that
-- side; back to the base from an element is its base part, and where a face is the end 1 the
-- equivalence's function applied
nk-gty-step : NkTm → NkTm → NkTm
nk-gty-step nk-nil as = nk-glue-ty (nk-nth as #0) (nk-sys (nk-sys-clean (nk-args (nk-nth as #1))))
nk-gty-step v as = nk-p1 v
