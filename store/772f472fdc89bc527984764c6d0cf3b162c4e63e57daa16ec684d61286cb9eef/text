hxz-dec-step : List Word × List Word → List Word × List Word
hxz-dec-step st =
  case snd st of
    nil → st
    cons _ _ →
      let g1 = hxz-get24 (snd st)
          g2 = hxz-get24 (snd g1)
          g3 = hxz-get24 (snd g2)
          sp = hxz-split (fst g3) (snd g3) nil
      in (hxz-rev (hxz-blk-dec (toNat (fst g1)) cfs-sample-init-ctx (fst g2 , fst sp)) (fst st) , snd sp)
