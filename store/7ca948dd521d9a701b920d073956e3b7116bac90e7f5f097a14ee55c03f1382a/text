div-loop-canon : (ms d q r : List Bool) → bcanon q ≡ true → bcanon r ≡ true → bcanon (fst (bin-div-loop ms d q r)) ≡ true × bcanon (snd (bin-div-loop ms d q r)) ≡ true
div-loop-canon ms = case ms return λ m → (d q r : List Bool) → bcanon q ≡ true → bcanon r ≡ true → bcanon (fst (bin-div-loop m d q r)) ≡ true × bcanon (snd (bin-div-loop m d q r)) ≡ true of
  nil → λ d q r cq cr → (cq , cr)
  cons x rest → λ d q r cq cr → div-canon-v rest d q r (rec rest d) x cq cr (bin-leb d (bin-cons x r))
