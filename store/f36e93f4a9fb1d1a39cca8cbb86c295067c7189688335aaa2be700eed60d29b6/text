-- B_kl for k from 0: xs are coordinates in ds3; F̃ closes e′ with leg b′, E attaches to e, ε contracts b′
b2 : Nat → Nat → List Nat → List Nat → List Nat → List Nat → List Nat → Rows → Rows → (List Nat → List Nat → SQ) → (List Nat → List Nat → SQ) → (List Nat → List Nat → SQ) → Rows → List (List Rows)
b2 n3 n6 ds ds3 ds4 ds5 ds6 m3 m6 fent eent rent xs = case n3 of
  zero → nil
  suc g → cons (b2-row n6 ds ds6 m6 rent (coords-all (inv-free ds6) (vmap contr-entry ds6 ds5 (vmap eent ds5 ds4 (vmap fent ds4 ds3 (lift-in ds3 xs)))))) (b2 g n6 ds ds3 ds4 ds5 ds6 m3 m6 fent eent rent (rows-apply-all m3 xs))
