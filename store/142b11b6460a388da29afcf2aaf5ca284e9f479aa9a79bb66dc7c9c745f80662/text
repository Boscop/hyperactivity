-- ── 5. Strict 0px Monochrome + #ff0a94 Architectural Renderer (ZERO Circles!) ─
-- Exact palette: #060608 void, #0c0c11 cell, #22222b hairline/passive wire, #f2f2f7 ink, #ff0a94 active cut ONLY!
inet-sheet : CssSheet
inet-sheet = tx-zero-radius
  (cons (css-rule ".inet-stage"
    (d4 "background" "#060608" "color" "#f2f2f7" "border" "1px solid #22222b" "border-radius" "0"))
  (cons (css-rule ".inet-cut"
    (d4 "border" "1px solid #ff0a94" "color" "#ff0a94" "background" "#0c0c11" "border-radius" "0"))
  (cons (css-rule ".inet-factor"
    (d4 "border" "1px solid #f2f2f7" "background" "#0c0c11" "padding" "6px 10px" "border-radius" "0"))
  nil)))
