-- parameters against their telescope
check-tele c tel ps =
  case tel of
    tx A nm r → 
      case ps of
        lnil → err c E-params opq opq
        lcons p pr → let Av = tval A in and-then (check p Av) (check-tele c (r (tval p) Av) pr)
    tz e → chk (isnil ps) (err c E-params opq opq)
    _ → err c E-params opq opq
