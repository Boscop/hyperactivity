-- a change the server has had (`SEQ PATH POINTER`, "-" when the module was dropped), taken: the
-- module's text recorded as the server holds it, unless the session holds that pointer already
h-take-text : List Word → List Word → Sum Unit (List Word) → Proc W Unit
h-take-text m path r = if weq (h-status r) #200 then h-record-raw m path (h-body r) else ret unit
