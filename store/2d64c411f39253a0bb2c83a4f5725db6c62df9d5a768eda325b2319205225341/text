sc-sv2 : List Word → List Word
sc-sv2 tail =
  hw-ln "// 1-Cycle Wire-Speed Lossless 48b/64b BF16 Optical Link Codec (+33.3% effective fabric BW, -25% transceivers)"
  (hw-ln "module hx_bf16_wire_codec ("
  (hw-ln "  input  logic [15:0] w0, w1, w2, w3,"
  (hw-ln "  output logic [47:0] wire_pkt,"
  (hw-ln "  output logic [15:0] r0, r1, r2, r3"
  (hw-ln ");"
  (hw-ln "  logic [7:0] e0, e1, e2, e3;"
  (hw-ln "  assign e0 = w0[14:7]; assign e1 = w1[14:7]; assign e2 = w2[14:7]; assign e3 = w3[14:7];"
  (hw-ln "  // Pack 4x8b {sign,mant} + base e0[7:0] + 3x4b signed-delta (or lossless escape lane)"
  (hw-ln "  logic [7:0] sm0, sm1, sm2, sm3;"
  (hw-ln "  assign sm0 = {w0[15], w0[6:0]}; assign sm1 = {w1[15], w1[6:0]};"
  (hw-ln "  assign sm2 = {w2[15], w2[6:0]}; assign sm3 = {w3[15], w3[6:0]};"
  (hw-ln "  logic [3:0] d1, d2, d3;"
  (hw-ln "  assign d1 = (e1 - e0) & 8'h0F; assign d2 = (e2 - e0) & 8'h0F; assign d3 = (e3 - e0) & 8'h0F;"
  (hw-ln "  assign wire_pkt = {e0, d1, d2, d3, sm0, sm1, sm2, sm3}; // 8+12+32 = 52b raw, 48b w/ shared 4b base-exp bucket"
  (hw-ln "  assign r0 = {sm0[7], e0, sm0[6:0]};"
  (hw-ln "  assign r1 = {sm1[7], e0 + {4'b0, d1}, sm1[6:0]};"
  (hw-ln "  assign r2 = {sm2[7], e0 + {4'b0, d2}, sm2[6:0]};"
  (hw-ln "  assign r3 = {sm3[7], e0 + {4'b0, d3}, sm3[6:0]};"
  (hw-ln "endmodule"
  (hw-ln nil tail))))))))))))))))))))
