ms-encode-morpho-flash : List Word → Word → List Word → List Word
ms-encode-morpho-flash token20 assetsWei callbackData =
  let cbLen = fromNat (list-length callbackData)
      padN  = %wmod (%wsub #32 (%wmod cbLen #32)) #32
  in h-concat
       (cons ms-morpho-flash-sel4
       (cons (bn-abi-addr20 token20)
       (cons (eth-word-be32 assetsWei)
       (cons (eth-word-be32 #96)
       (cons (eth-word-be32 cbLen)
       (cons callbackData
       (cons (bn-zeros (toNat padN)) nil)))))))
