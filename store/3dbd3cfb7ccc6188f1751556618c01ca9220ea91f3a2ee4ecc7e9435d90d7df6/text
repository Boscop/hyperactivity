col-undiff-diff-go : (B : Word) → (prev : List (Bounded B)) → (rows : List (List (Bounded B))) →
                     col-undiff-mod-go B prev (col-diff-mod-go B prev rows) ≡ rows
col-undiff-diff-go B prev rows =
  (case rows return (λ u → (p : List (Bounded B)) → col-undiff-mod-go B p (col-diff-mod-go B p u) ≡ u) of
     nil → λ p i → nil
     cons row r → λ p →
       let q = zip-mundiff B p (zip-mdiff B p row)
           pq : q ≡ row
           pq = zip-mundiff-mdiff B p row
       in λ i → cons (pq i) (concat {lzero} {List (List (Bounded B))}
                               {col-undiff-mod-go B q (col-diff-mod-go B row r)}
                               {col-undiff-mod-go B row (col-diff-mod-go B row r)} {r}
                               (λ j → col-undiff-mod-go B (pq j) (col-diff-mod-go B row r))
                               (rec r row) i)) prev
