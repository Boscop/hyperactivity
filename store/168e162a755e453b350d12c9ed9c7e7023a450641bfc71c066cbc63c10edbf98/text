<script>
// Lab 1: SU(2) Spin-Network Interaction Graph
(function() {
  const stage = document.getElementById('lqgStage');
  const canvas = document.getElementById('lqgCanvas');
  const ctx = canvas.getContext('2d');
  const st = document.getElementById('lqgStatus');

  const spins = [1, 1, 2, 1, 2, 1]; // stored as 2j (half-integers: 1->1/2, 2->1, 3->3/2, 4->2)
  const edges = [[0,1],[1,2],[2,3],[3,0],[0,2],[1,3]];
  let t = 0;

  function resize() {
    const r = stage.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.floor(r.width * dpr));
    canvas.height = Math.max(1, Math.floor(r.height * dpr));
  }
  new ResizeObserver(resize).observe(stage); resize();
  document.getElementById('lqgReset').onclick = () => { [1,1,2,1,2,1].forEach((v,i)=>spins[i]=v); };

  function getVerts(W, H) {
    const cx = W * 0.5, cy = H * 0.52, rx = Math.min(200, W * 0.28), ry = Math.min(95, H * 0.30);
    return [
      { x: cx - rx, y: cy - ry, name: 'v₁' },
      { x: cx + rx, y: cy - ry, name: 'v₂' },
      { x: cx + rx, y: cy + ry, name: 'v₃' },
      { x: cx - rx, y: cy + ry, name: 'v₄' },
    ];
  }

  function gaussOk(vIdx) {
    // 3 incident edges at each vertex of K4: check triangle inequality & even sum of 2j
    const inc = [];
    edges.forEach((e, i) => { if (e[0] === vIdx || e[1] === vIdx) inc.push(spins[i]); });
    const [a, b, c] = inc;
    return ((a + b + c) % 2 === 0) && (a + b >= c) && (a + c >= b) && (b + c >= a);
  }

  canvas.addEventListener('click', e => {
    const r = canvas.getBoundingClientRect();
    const mx = e.clientX - r.left, my = e.clientY - r.top;
    const verts = getVerts(r.width, r.height);
    let best = -1, bestD = 26;
    edges.forEach((ed, i) => {
      const a = verts[ed[0]], b = verts[ed[1]];
      const px = (a.x + b.x)/2, py = (a.y + b.y)/2;
      const d = Math.hypot(mx - px, my - py);
      if (d < bestD) { best = i; bestD = d; }
    });
    if (best >= 0) spins[best] = (spins[best] % 4) + 1;
  });

  function draw() {
    t += 0.03;
    const dark = document.documentElement.classList.contains('dark');
    const bg = dark ? '#000' : '#fff', ink = dark ? '#fff' : '#000';
    const pink = '#ff0a94', blue = dark ? '#4da3ff' : '#1a73e8';
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const W = canvas.width / dpr, H = canvas.height / dpr;

    ctx.setTransform(1,0,0,1,0,0); ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.fillStyle = bg; ctx.fillRect(0,0,canvas.width,canvas.height);
    ctx.scale(dpr, dpr);

    const verts = getVerts(W, H);
    let totalArea = 0;
    edges.forEach((ed, i) => {
      const a = verts[ed[0]], b = verts[ed[1]];
      const j = spins[i] / 2;
      totalArea += Math.sqrt(j * (j + 1));
      ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y);
      ctx.strokeStyle = blue; ctx.lineWidth = 1.2 + j * 1.2; ctx.stroke();

      const u = (t * 0.4 + i * 0.19) % 1;
      ctx.beginPath(); ctx.arc(a.x + (b.x - a.x)*u, a.y + (b.y - a.y)*u, 3, 0, Math.PI*2);
      ctx.fillStyle = pink; ctx.fill();

      const mx = (a.x + b.x)/2 + (i===4 ? -18 : i===5 ? 18 : 0);
      const my = (a.y + b.y)/2 + (i===4 ? -12 : i===5 ? -12 : 0);
      ctx.fillStyle = bg; ctx.fillRect(mx - 18, my - 10, 36, 20);
      ctx.strokeStyle = blue; ctx.lineWidth = 1; ctx.strokeRect(mx - 18, my - 10, 36, 20);
      ctx.font = '700 11px ui-monospace, Menlo, monospace'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillStyle = ink;
      const jStr = spins[i] % 2 === 0 ? String(spins[i]/2) : `${spins[i]}/2`;
      ctx.fillText(`j=${jStr}`, mx, my);
    });

    let allOk = true;
    verts.forEach((v, i) => {
      const ok = gaussOk(i);
      if (!ok) allOk = false;
      ctx.beginPath(); ctx.arc(v.x, v.y, 20, 0, Math.PI * 2);
      ctx.fillStyle = ok ? pink : bg; ctx.fill();
      ctx.strokeStyle = ok ? ink : pink; ctx.lineWidth = 2.5; ctx.stroke();
      ctx.fillStyle = ok ? '#fff' : pink; ctx.font = '700 12px ui-monospace, Menlo, monospace';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(ok ? v.name : '⊥', v.x, v.y);
    });

    st.textContent = `SU(2) Gauss Closure: ${allOk ? 'ALL 4 VERTICES VALID' : 'TRIANGLE/PARITY VIOLATION'} · Σ√j(j+1) = ${totalArea.toFixed(3)}`;
    st.style.color = allOk ? blue : pink;
    requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);
})();

// Lab 2: Bioelectric Morphogenesis Gap-Junction Interaction Network
(function() {
  const stage = document.getElementById('bioStage');
  const canvas = document.getElementById('bioCanvas');
  const ctx = canvas.getContext('2d');
  const slG = document.getElementById('bioG'), valG = document.getElementById('bioGV');
  const st = document.getElementById('bioStatus');

  const COLS = 12, ROWS = 5;
  let V = new Float32Array(COLS * ROWS);
  function initSplit() {
    for (let r = 0; r < ROWS; r++)
      for (let c = 0; c < COLS; c++)
        V[r*COLS + c] = c < COLS/2 ? 0.9 : -0.9;
  }
  function initRand() {
    for (let i = 0; i < V.length; i++) V[i] = (Math.random() - 0.5) * 1.8;
  }
  initSplit();

  function resize() {
    const r = stage.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.floor(r.width * dpr));
    canvas.height = Math.max(1, Math.floor(r.height * dpr));
  }
  new ResizeObserver(resize).observe(stage); resize();
  document.getElementById('bioSplit').onclick = initSplit;
  document.getElementById('bioRand').onclick = initRand;

  canvas.addEventListener('click', e => {
    const r = canvas.getBoundingClientRect();
    const padX = 48, padY = 34;
    const dx = (r.width - padX * 2) / (COLS - 1), dy = (r.height - padY * 2) / (ROWS - 1);
    const c = Math.round((e.clientX - r.left - padX) / dx);
    const row = Math.round((e.clientY - r.top - padY) / dy);
    if (c >= 0 && c < COLS && row >= 0 && row < ROWS) {
      V[row*COLS + c] = V[row*COLS + c] > 0 ? -1.0 : 1.0;
    }
  });

  function step() {
    const g = parseFloat(slG.value);
    valG.textContent = g.toFixed(2);
    const next = new Float32Array(V.length);
    let diss = 0;
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        const i = r*COLS + c, v = V[i];
        let lap = 0;
        const nb = [[r-1,c],[r+1,c],[r,c-1],[r,c+1]];
        nb.forEach(([nr, nc]) => {
          if (nr >= 0 && nr < ROWS && nc >= 0 && nc < COLS) {
            const diff = V[nr*COLS + nc] - v;
            lap += diff;
            diss += 0.25 * g * diff * diff;
          }
        });
        // Bistable local ion-channel dynamics dv/dt = v - v^3 + g * laplacian
        next[i] = Math.max(-1.2, Math.min(1.2, v + 0.04 * (v - v*v*v + g * lap)));
      }
    }
    V = next;

    const dark = document.documentElement.classList.contains('dark');
    const bg = dark ? '#000' : '#fff', ink = dark ? '#fff' : '#000';
    const pink = '#ff0a94', blue = dark ? '#4da3ff' : '#1a73e8';
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const W = canvas.width / dpr, H = canvas.height / dpr;

    ctx.setTransform(1,0,0,1,0,0); ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.fillStyle = bg; ctx.fillRect(0,0,canvas.width,canvas.height);
    ctx.scale(dpr, dpr);

    const padX = 48, padY = 34;
    const dx = (W - padX * 2) / (COLS - 1), dy = (H - padY * 2) / (ROWS - 1);

    // Draw gap-junction edges
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        const x = padX + c * dx, y = padY + r * dy;
        const v = V[r*COLS + c];
        if (c + 1 < COLS) {
          const diff = Math.abs(v - V[r*COLS + c + 1]);
          ctx.strokeStyle = diff > 0.4 ? pink : (dark ? 'rgba(255,255,255,0.22)' : 'rgba(0,0,0,0.22)');
          ctx.lineWidth = 1 + g * 3;
          ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x + dx, y); ctx.stroke();
        }
        if (r + 1 < ROWS) {
          const diff = Math.abs(v - V[(r+1)*COLS + c]);
          ctx.strokeStyle = diff > 0.4 ? pink : (dark ? 'rgba(255,255,255,0.22)' : 'rgba(0,0,0,0.22)');
          ctx.lineWidth = 1 + g * 3;
          ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x, y + dy); ctx.stroke();
        }
      }
    }

    // Draw cellular nodes
    let dep = 0;
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        const x = padX + c * dx, y = padY + r * dy, v = V[r*COLS + c];
        if (v > 0) dep++;
        ctx.beginPath(); ctx.arc(x, y, 13, 0, Math.PI * 2);
        ctx.fillStyle = v >= 0 ? pink : blue;
        ctx.globalAlpha = Math.max(0.28, Math.min(1, Math.abs(v)));
        ctx.fill();
        ctx.globalAlpha = 1;
        ctx.strokeStyle = ink; ctx.lineWidth = 1; ctx.stroke();
      }
    }
    st.textContent = `Depolarized (pink): ${dep} · Hyperpolarized (blue): ${V.length - dep} · Gap-Junction Dissipation = ${diss.toFixed(2)}`;
    requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
})();
</script>
