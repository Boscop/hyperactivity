-- ============================================================================

pow2 : Nat → Nat
pow2 zero = suc zero
pow2 (suc n) = plus (pow2 n) (pow2 n)

euclid-area : Nat → Nat
euclid-area r = times r r

darwin-hyperbolic-dominates-r5 : nat-lt (euclid-area (toNat #5)) (pow2 (toNat #5)) ≡ true
darwin-hyperbolic-dominates-r5 = refl

darwin-hyperbolic-dominates-r8 : nat-lt (euclid-area (toNat #8)) (pow2 (toNat #8)) ≡ true
darwin-hyperbolic-dominates-r8 = refl

darwin-hyperbolic-dominates-r10 : nat-lt (euclid-area (toNat #10)) (pow2 (toNat #10)) ≡ true
darwin-hyperbolic-dominates-r10 = refl

-- Exact discrete Poincare unit disk membership: x^2 + y^2 < R^2
in-poincare-disk : RZ → RZ → Word → Bool
in-poincare-disk x y rad =
  let x2 = rz-sq x
      y2 = rz-sq y
      r2 = rz-sq (rz true rad)
  in rz-nonneg (rz-sub (rz-sub r2 (rz-add x2 y2)) rz-one)

darwin-origin-in-disk : in-poincare-disk rz-zero rz-zero #100 ≡ true
darwin-origin-in-disk = refl

darwin-clade-in-disk : in-poincare-disk (rz true #60) (rz false #70) #100 ≡ true
darwin-clade-in-disk = refl

-- Exact Poincare boundary conservation: |z|^2 = 60^2 + 70^2 = 8500 < 10000 = 100^2
darwin-outside-rejected : in-poincare-disk (rz true #80) (rz true #80) #100 ≡ false
darwin-outside-rejected = refl
