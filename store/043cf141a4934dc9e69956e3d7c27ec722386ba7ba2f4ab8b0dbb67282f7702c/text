import "riemann-zeta.hypercubical"

-- ============================================================================
-- SECTION 1: EXACT INTEGER ARITHMETIC & SUM-OF-SQUARES NON-NEGATIVITY
-- ============================================================================

rz-nonneg : RZ → Bool
rz-nonneg (rz s _) = s

rz-sq : RZ → RZ
rz-sq z = rz-mul z z

-- Helper: rz-eqb s s == true for all Bool s
rz-eqb-self : (s : Bool) → rz-eqb s s ≡ true
rz-eqb-self true = refl
rz-eqb-self false = refl

-- Helper: rz-norm true m always has sign true!
rz-norm-true-b : (b : Bool) → (m : Word) → rz-nonneg (if b then rz true #0 else rz true m) ≡ true
rz-norm-true-b true m = refl
rz-norm-true-b false m = refl

rz-norm-true-sgn : (m : Word) → rz-nonneg (rz-norm true m) ≡ true
rz-norm-true-sgn m = rz-norm-true-b (%weq m #0) m

-- UNIVERSAL THEOREM: the square of ANY exact integer z : RZ is non-negative!
rz-sq-nonneg-bool : (s : Bool) → (m : Word) → rz-nonneg (rz-norm (rz-eqb s s) (%wmul m m)) ≡ true
rz-sq-nonneg-bool true m = rz-norm-true-sgn (%wmul m m)
rz-sq-nonneg-bool false m = rz-norm-true-sgn (%wmul m m)

rz-sq-nonneg : (z : RZ) → rz-nonneg (rz-sq z) ≡ true
rz-sq-nonneg (rz s m) = rz-sq-nonneg-bool s m

-- ============================================================================
-- SECTION 2: EXACT DISCRETE PRICE EQUATION OVER Z (ZERO FLOATS)
--   2 * (w1*(z1+dz1) + w2*(z2+dz2)) - (w1+w2)*(z1+z2)
--   == (w1 - w2)*(z1 - z2) + 2*(w1*dz1 + w2*dz2)
-- ============================================================================

price-lhs-2 : RZ → RZ → RZ → RZ → RZ → RZ → RZ
price-lhs-2 w1 w2 z1 z2 dz1 dz2 =
  let two = rz true #2
      w1p = rz-mul w1 (rz-add z1 dz1)
      w2p = rz-mul w2 (rz-add z2 dz2)
      wt  = rz-add w1 w2
      zt  = rz-add z1 z2
  in rz-sub (rz-mul two (rz-add w1p w2p)) (rz-mul wt zt)

price-cov-2 : RZ → RZ → RZ → RZ → RZ
price-cov-2 w1 w2 z1 z2 = rz-mul (rz-sub w1 w2) (rz-sub z1 z2)

price-trans-2 : RZ → RZ → RZ → RZ → RZ
price-trans-2 w1 w2 dz1 dz2 =
  let two = rz true #2
  in rz-mul two (rz-add (rz-mul w1 dz1) (rz-mul w2 dz2))

price-rhs-2 : RZ → RZ → RZ → RZ → RZ → RZ → RZ
price-rhs-2 w1 w2 z1 z2 dz1 dz2 =
  rz-add (price-cov-2 w1 w2 z1 z2) (price-trans-2 w1 w2 dz1 dz2)

darwin-price-directional :
  price-lhs-2 (rz true #5) (rz true #2) (rz true #4) (rz true #1) rz-zero rz-zero
  ≡ price-rhs-2 (rz true #5) (rz true #2) (rz true #4) (rz true #1) rz-zero rz-zero
darwin-price-directional = refl

darwin-price-hyperfactor-mutation :
  price-lhs-2 (rz true #7) (rz true #3) (rz true #2) (rz true #6) (rz true #2) (rz false #1)
  ≡ price-rhs-2 (rz true #7) (rz true #3) (rz true #2) (rz true #6) (rz true #2) (rz false #1)
darwin-price-hyperfactor-mutation = refl

darwin-price-purifying :
  price-lhs-2 (rz true #12) (rz true #1) (rz true #17) (rz true #24) (rz false #2) (rz true #1)
  ≡ price-rhs-2 (rz true #12) (rz true #1) (rz true #17) (rz true #24) (rz false #2) (rz true #1)
darwin-price-purifying = refl

-- ============================================================================
-- SECTION 3: FISHER'S FUNDAMENTAL THEOREM OF NATURAL SELECTION (UNIVERSAL!)
--   Setting z = w and dz = 0 yields Cov_scaled(w, w) = (w1 - w2)^2 >= 0.
--   Therefore pure replicator selection universally NEVER decreases mean fitness!
-- ============================================================================

fisher-delta-2 : RZ → RZ → RZ
fisher-delta-2 w1 w2 = price-cov-2 w1 w2 w1 w2

darwin-fisher-fundamental : (w1 w2 : RZ) → rz-nonneg (fisher-delta-2 w1 w2) ≡ true
darwin-fisher-fundamental w1 w2 = rz-sq-nonneg (rz-sub w1 w2)

-- ============================================================================
-- SECTION 4: GENOME, METABOLIC HYPERFACTORING & DARWINIAN FITNESS DOMINANCE
-- ============================================================================

record Genome =
  { gn-gates  : Nat
  ; gn-dim    : Nat
  ; gn-energy : Nat
  ; gn-gen    : Nat
  }

gn-hyperfactor : Nat → Genome → Genome
gn-hyperfactor k g =
  Genome
    { gn-gates  = gn-gates g
    ; gn-dim    = gn-dim g
    ; gn-energy = plus (gn-energy g) k
    ; gn-gen    = suc (gn-gen g)
    }

nat-lt : Nat → Nat → Bool
nat-lt zero zero = false
nat-lt zero (suc _) = true
nat-lt (suc _) zero = false
nat-lt (suc a) (suc b) = nat-lt a b

nat-lt-suc-self : (n : Nat) → nat-lt n (suc n) ≡ true
nat-lt-suc-self zero = refl
nat-lt-suc-self (suc n) = nat-lt-suc-self n

darwin-gen-advances : (k : Nat) → (g : Genome) → nat-lt (gn-gen g) (gn-gen (gn-hyperfactor k g)) ≡ true
darwin-gen-advances k g = nat-lt-suc-self (gn-gen g)

-- Metabolic survival fitness E / (1 + gates): g1 beats g2 iff E2*(1+c1) < E1*(1+c2)
darwin-fitness-beats : Genome → Genome → Bool
darwin-fitness-beats g1 g2 =
  nat-lt (times (gn-energy g2) (suc (gn-gates g1)))
         (times (gn-energy g1) (suc (gn-gates g2)))

-- Verified witness: hyperfactored 17-gate silicon cone strictly outcompetes 24-gate cone at equal energy!
darwin-silicon-cone-dominates :
  darwin-fitness-beats
    (Genome { gn-gates = toNat #17 ; gn-dim = toNat #4 ; gn-energy = toNat #100 ; gn-gen = toNat #12 })
    (Genome { gn-gates = toNat #24 ; gn-dim = toNat #4 ; gn-energy = toNat #100 ; gn-gen = toNat #12 })
  ≡ true
darwin-silicon-cone-dominates = refl

-- ============================================================================
-- SECTION 5: UNIVALENT SYMBIOGENESIS (HORIZONTAL GENE TRANSFER = TRANSPORT)
--   Across any equivalence e : A == B, a verified adaptation a : Adapt B
--   transports losslessly into Adapt A via cubical transport!
-- ============================================================================

darwin-symbiogenesis :
  {A B : Type 0} → (Adapt : Type 0 → Type 0) → (e : A ≡ B) → Adapt B → Adapt A
darwin-symbiogenesis Adapt e a = transport (λ i → Adapt (e (~ i))) a

darwin-symbiogenesis-refl :
  {A : Type 0} → (Adapt : Type 0 → Type 0) → (a : Adapt A) →
  darwin-symbiogenesis Adapt refl a ≡ a
darwin-symbiogenesis-refl Adapt a = transportRefl

darwin-symbiogenesis-chain :
  {A B C : Type 0} → (Adapt : Type 0 → Type 0) →
  (A ≡ B) → (B ≡ C) → Adapt C → Adapt A
darwin-symbiogenesis-chain Adapt e1 e2 c =
  darwin-symbiogenesis Adapt e1 (darwin-symbiogenesis Adapt e2 c)

-- ============================================================================
-- SECTION 6: NON-EUCLIDEAN HYPERBOLIC NICHE GEOMETRY (H^2 POINCARE DISK)
--   Hyperbolic area grows exponentially (~ 2^r) vs Euclidean quadratic (~ r^2),
