-- the witness, whether every pivot met is nonzero, and the number of negative pivots
bw-wit : (A : Type) → (z one : A) → (ad mu : A → A → A) → (ng : A → A) → (n : Nat) → (sy-vn A n → sy-vn A n → A) → List (sy-vn A n)
bw-wit A z one ad mu ng n = case n return λ k → (sy-vn A k → sy-vn A k → A) → List (sy-vn A k) of
  zero → λ f → nil
  suc m → λ f → cons (bw-e A z one m) (bw-map (sy-vn A (suc m)) (sy-vn A m) (bw-tt A z one ad mu ng m f) (bw-wit A z one ad mu ng m (bw-g A z one ad mu ng m f)))
