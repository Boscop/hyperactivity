wk-R : (Γ : CCtx) (a : TyShape) (Y : Type 1) (f : (γ : CtxV (fst Γ)) → (EnvV (fst Γ) γ → Y) → EnvV (fst Γ) γ → Sem a) (M : Mean Γ Y) (Z : Type 1) →
  Mean Γ Z → DCube (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (λ x' → FbE (fst Γ) Z (fst x')) (snd (extM Γ a Y f M))
wk-R Γ a Y f M Z N =
  dcube-push (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y) (FbE (fst Γ) Z) (λ x' → FbE (fst Γ) Z (fst x'))
    (λ γ e → (γ , f γ e)) (λ γ e q → q) (snd Γ) M N
