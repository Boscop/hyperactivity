  (s256-ln "kernel void hx_mc_discover("
  (s256-ln "    device atomic_uint* best_ands [[buffer(0)]],"
  (s256-ln "    device atomic_uint* taken [[buffer(1)]],"
  (s256-ln "    device uchar* out_circ [[buffer(2)]],"
  (s256-ln "    constant SpaceParams& sp [[buffer(3)]],"
  (s256-ln "    uint tid [[thread_position_in_grid]]) {"
  (s256-ln "  uint mode = tid % 3u;"
  (s256-ln "  uint rng = ((tid + 1u) * 0x9E3779B9u) ^ (sp.seed * 0x85EBCA6Bu);"
  (s256-ln "  // Basis wires: w0..w4 = inputs (or w0..w3 + const1 for PRESENT), w5 = 0xFFFFFFFF (const 1 for NOT via XOR)"
  (s256-ln "  uint w[24];"
  (s256-ln "  w[0] = 0xAAAAAAAAu; w[1] = 0xCCCCCCCCu; w[2] = 0xF0F0F0F0u; w[3] = 0xFF00FF00u;"
  (s256-ln "  w[4] = (mode == 2u) ? 0xFFFFFFFFu : 0xFFFF0000u;"
  (s256-ln "  w[5] = 0xFFFFFFFFu;"
  (s256-ln "  uint nin = (mode == 2u) ? 5u : 6u;"
  (s256-ln "  uint ng = (mode == 2u) ? 14u : 9u;"
  (s256-ln "  uchar ga[16], gb[16], gop[16], bga[16], bgb[16], bgop[16];"
  (s256-ln "  for (uint g = 0; g < ng; g++) {"
  (s256-ln "    uint nw = nin + g;"
  (s256-ln "    ga[g] = uchar(mulhi(xs32(rng), nw));"
  (s256-ln "    gb[g] = uchar(mulhi(xs32(rng), nw));"
  (s256-ln "    gop[g] = uchar((xs32(rng) & 3u) == 0u ? 1u : 0u); // 0=XOR (free), 1=AND (cost 1)"
  (s256-ln "  }"
  (s256-ln "  uint cur_score = 9999u, best_and = 99u, best_ng = 0u;"
  (s256-ln "  for (uint it = 0; it < sp.iters; it++) {"
  (s256-ln "    uint pos = mulhi(xs32(rng), ng);"
  (s256-ln "    uint nw = nin + pos;"
  (s256-ln "    uchar oa = ga[pos], ob = gb[pos], oo = gop[pos];"
  (s256-ln "    uint m = xs32(rng);"
  (s256-ln "    if ((m & 3u) == 0u) gop[pos] ^= 1u;"
  (s256-ln "    else if ((m & 3u) == 1u) ga[pos] = uchar(mulhi(xs32(rng), nw));"
  (s256-ln "    else if ((m & 3u) == 2u) gb[pos] = uchar(mulhi(xs32(rng), nw));"
  (s256-ln "    else { ga[pos] = uchar(mulhi(xs32(rng), nw)); gb[pos] = uchar(mulhi(xs32(rng), nw)); }"
  (s256-ln "    uint ands = 0u;"
  (s256-ln "    for (uint g = 0; g < ng; g++) {"
  (s256-ln "      uint a = w[ga[g]], b = w[gb[g]];"
  (s256-ln "      w[nin + g] = gop[g] ? (a & b) : (a ^ b);"
  (s256-ln "      ands += uint(gop[g]);"
  (s256-ln "    }"
  (s256-ln "    uint dist = 0u;"
  (s256-ln "    if (mode == 0u) {"
  (s256-ln "      uint d0 = 32u, d1 = 32u;"
  (s256-ln "      for (uint g = 0; g < ng; g++) {"
  (s256-ln "        d0 = min(d0, uint(popcount(w[nin+g] ^ 0xD82727D8u)));"
  (s256-ln "        d1 = min(d1, uint(popcount(w[nin+g] ^ 0xFFD8D800u)));"
  (s256-ln "      }"
  (s256-ln "      dist = d0 + d1;"
  (s256-ln "    } else if (mode == 1u) {"
  (s256-ln "      uint d0 = 32u, d1 = 32u;"
  (s256-ln "      for (uint g = 0; g < ng; g++) {"
  (s256-ln "        d0 = min(d0, uint(popcount(w[nin+g] ^ 0xE81717E8u)));"
  (s256-ln "        d1 = min(d1, uint(popcount(w[nin+g] ^ 0xFFE8E800u)));"
  (s256-ln "      }"
  (s256-ln "      dist = d0 + d1;"
  (s256-ln "    } else {"
  (s256-ln "      uint d0=16u, d1=16u, d2=16u, d3=16u;"
  (s256-ln "      for (uint g = 0; g < ng; g++) {"
  (s256-ln "        ushort v = ushort(w[nin+g] & 0xFFFFu);"
