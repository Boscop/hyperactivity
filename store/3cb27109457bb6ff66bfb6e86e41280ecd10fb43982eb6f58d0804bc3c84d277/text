  (s256-ln "      // Condition weight = bits where difference is active (m01 | m10) & constrained"
  (s256-ln "      wt += uint(popcount(t1.y | t1.z));"
  (s256-ln "      g = f; f = e; e = t1;"
  (s256-ln "    }"
  (s256-ln "    if (wt < best_w) best_w = wt;"
  (s256-ln "  }"
