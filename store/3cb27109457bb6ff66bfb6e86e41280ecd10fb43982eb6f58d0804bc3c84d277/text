  (s256-ln "  res.y = (e0 & g1) | (e3 & f1) | (e1 & g_a0 & f_b1) | (e2 & f_a0 & g_b1);"
  (s256-ln "  res.z = (e0 & g2) | (e3 & f2) | (e1 & g_a1 & f_b0) | (e2 & f_a1 & g_b0);"
  (s256-ln "  res.w = (e0 & g3) | (e3 & f3) | (e1 & g_a1 & f_b1) | (e2 & f_a1 & g_b1);"
  (s256-ln "  return res;"
  (s256-ln "}"
  (s256-ln "kernel void hx_gc_lattice_bench("
  (s256-ln "    device atomic_uint* total_props [[buffer(0)]],"
  (s256-ln "    device atomic_uint* min_weight [[buffer(1)]],"
  (s256-ln "    constant SpaceParams& sp [[buffer(2)]],"
