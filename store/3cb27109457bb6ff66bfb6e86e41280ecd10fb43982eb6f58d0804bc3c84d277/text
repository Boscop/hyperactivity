  (s256-ln "        d2 = min(d2, uint(popcount(ushort(v ^ 0x3687))));"
  (s256-ln "        d3 = min(d3, uint(popcount(ushort(v ^ 0x0ED9))));"
  (s256-ln "      }"
  (s256-ln "      dist = d0 + d1 + d2 + d3;"
  (s256-ln "    }"
  (s256-ln "    uint score = dist * 32u + ands;"
  (s256-ln "    if (dist == 0u && ands < best_and) {"
  (s256-ln "      best_and = ands; best_ng = ng;"
  (s256-ln "      for (uint g = 0; g < ng; g++) { bga[g] = ga[g]; bgb[g] = gb[g]; bgop[g] = gop[g]; }"
  (s256-ln "    }"
  (s256-ln "    if (score <= cur_score) cur_score = score;"
  (s256-ln "    else { ga[pos] = oa; gb[pos] = ob; gop[pos] = oo; }"
  (s256-ln "  }"
  (s256-ln "  if (best_and < 16u) {"
  (s256-ln "    uint slot = mode * 16u + best_and;"
  (s256-ln "    if (atomic_load_explicit(&taken[slot], memory_order_relaxed) == 0u) {"
  (s256-ln "      if (atomic_exchange_explicit(&taken[slot], 1u, memory_order_relaxed) == 0u) {"
  (s256-ln "        uint base = slot * 48u;"
  (s256-ln "        for (uint g = 0; g < best_ng; g++) { out_circ[base + g*3u] = bga[g]; out_circ[base + g*3u + 1u] = bgb[g]; out_circ[base + g*3u + 2u] = bgop[g]; }"
