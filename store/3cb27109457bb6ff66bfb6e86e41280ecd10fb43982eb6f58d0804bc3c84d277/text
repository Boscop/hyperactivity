  (s256-ln "    // Inject 1-bit signed difference u (m10=m) into W0, propagate bit-parallel uint4 conditions across 8 rounds"
  (s256-ln "    uint4 dw = uint4(eq.x & ~m, 0u, m, eq.w & ~m);"
  (s256-ln "    uint4 e = dw, f = eq, g = eq;"
  (s256-ln "    uint wt = 0u;"
  (s256-ln "    for (uint r = 0; r < sp.rounds; r++) {"
  (s256-ln "      uint4 s1 = gc_xor(gc_xor(gc_rotr(e, 6), gc_rotr(e, 11)), gc_rotr(e, 25));"
