  (s256-ln ""
  (s256-ln "// FUNCTOR 2: Bit-Parallel 128-bit uint4 Signed-Bit Generalized-Condition Lattice Propagator!"
  (s256-ln "// One 32-bit state word = uint4(m00, m01, m10, m11). All 32 bits propagate in parallel in ~8 ALU ops!"
  (s256-ln "inline uint4 gc_xor(uint4 x, uint4 y) {"
  (s256-ln "  return uint4("
  (s256-ln "    (x.x & y.x) | (x.y & y.y) | (x.z & y.z) | (x.w & y.w),"
  (s256-ln "    (x.x & y.y) | (x.y & y.x) | (x.z & y.w) | (x.w & y.z),"
  (s256-ln "    (x.x & y.z) | (x.z & y.x) | (x.y & y.w) | (x.w & y.y),"
  (s256-ln "    (x.x & y.w) | (x.w & y.x) | (x.y & y.z) | (x.z & y.y));"
  (s256-ln "}"
  (s256-ln "inline uint4 gc_rotr(uint4 x, uint n) {"
  (s256-ln "  return uint4(rotr32(x.x, n), rotr32(x.y, n), rotr32(x.z, n), rotr32(x.w, n));"
  (s256-ln "}"
  (s256-ln "inline uint4 gc_ch(uint4 e, uint4 f, uint4 g) {"
  (s256-ln "  uint4 res = uint4(0u);"
  (s256-ln "  // Exact 4-bit truth table projection across all 32 lanes simultaneously!"
  (s256-ln "  uint e0 = e.x, e1 = e.y, e2 = e.z, e3 = e.w;"
  (s256-ln "  uint f0 = f.x, f1 = f.y, f2 = f.z, f3 = f.w;"
  (s256-ln "  uint g0 = g.x, g1 = g.y, g2 = g.z, g3 = g.w;"
  (s256-ln "  // When e=00 -> g; e=11 -> f; e=01 -> (g_first, f_second); e=10 -> (f_first, g_second)"
  (s256-ln "  uint f_a0 = f0 | f1, f_a1 = f2 | f3, f_b0 = f0 | f2, f_b1 = f1 | f3;"
  (s256-ln "  uint g_a0 = g0 | g1, g_a1 = g2 | g3, g_b0 = g0 | g2, g_b1 = g1 | g3;"
