  (s256-ln "// FUNCTOR 3: Exact Round-by-Round Avalanche, Walsh Bias, Rotational (ROTR), and 2-Adic Carry Horizon (R=1..16)!"
  (s256-ln "kernel void hx_horizon_probe("
