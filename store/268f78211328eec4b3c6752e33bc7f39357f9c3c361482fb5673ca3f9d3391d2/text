-- one entry (source state g, monomial j) of a list of sides as single-root terms: Σ_x x^{1/8} Σ_p x^p C_p[g][j] / m′(x)
-- (the 1/√2 of √V = M^{1/8}/√2 left out)
wrap-entries : Nat → Nat → List Rows → List (List SQ)
wrap-entries g j cs = case cs of
  nil → nil
  cons c rest → cons (cons (sq-nth j (rows-nth g c)) nil) (wrap-entries g j rest)
