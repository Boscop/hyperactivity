-- ── 1. Universal 4-Node Coupled Graph Laplacian Positivity (al-id over Q) ────
-- Covers 1D chains (strings/bores), 2D 2x2 membranes/plates, complete K4 rooms,
-- and arbitrary coupled physical instruments in ONE universal ring identity:
--   x^T L x = sum_{0 <= i < j <= 3} w_{ij} (x_i - x_j)^2 >= 0  (for all w_{ij} >= 0).
-- Variables (0..9): w01, w02, w03, w12, w13, w23, x0, x1, x2, x3.
wave-lap4-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wave-lap4-poly A ad mu q vs =
  (λ g sub sq →
    let w01 = g 0; w02 = g 1; w03 = g 2; w12 = g 3; w13 = g 4; w23 = g 5
        x0  = g 6; x1  = g 7; x2  = g 8; x3  = g 9
        lx0 = ad (ad (mu w01 (sub x0 x1)) (mu w02 (sub x0 x2))) (mu w03 (sub x0 x3))
        lx1 = ad (ad (mu w01 (sub x1 x0)) (mu w12 (sub x1 x2))) (mu w13 (sub x1 x3))
        lx2 = ad (ad (mu w02 (sub x2 x0)) (mu w12 (sub x2 x1))) (mu w23 (sub x2 x3))
        lx3 = ad (ad (mu w03 (sub x3 x0)) (mu w13 (sub x3 x1))) (mu w23 (sub x3 x2))
        lhs = ad (ad (mu x0 lx0) (mu x1 lx1)) (ad (mu x2 lx2) (mu x3 lx3))
        rhs = ad (ad (ad (mu w01 (sq (sub x0 x1))) (mu w02 (sq (sub x0 x2))))
                     (ad (mu w03 (sq (sub x0 x3))) (mu w12 (sq (sub x1 x2)))))
                 (ad (mu w13 (sq (sub x1 x3))) (mu w23 (sq (sub x2 x3))))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
