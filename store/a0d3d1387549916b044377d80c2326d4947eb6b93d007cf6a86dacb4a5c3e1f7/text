-- the largest x < 2^(b+1) with x^8 ≤ target, deciding the bits from b down
root8-bits : Nat → Nat → List Bool → List Bool → List Bool
root8-bits f b target x = case f of
  zero → x
  suc g → root8-bits g (monus b (suc zero)) target (if bin-leb (bin-pow (bin-add x (bin-pow2 b)) 8) target then bin-add x (bin-pow2 b) else x)
