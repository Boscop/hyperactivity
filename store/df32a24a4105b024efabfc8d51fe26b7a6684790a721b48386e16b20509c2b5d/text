-- + - * / % & | ^ at a kind (both operands of it: the reader has applied its language's
-- conversions). Pointer arithmetic is the memory's
sv-arith : BinOp → SK → SV → SV → MRes SV
sv-arith o k a b = case k of
  sk-int sg w → int-op o sg w a b
  sk-f32 → mr-bind (sv-as-f a) (λ x → mr-bind (sv-as-f b) (λ y → mr-map sv-f (f32-op o x y)))
  sk-f64 → mr-bind (sv-as-d a) (λ x → mr-bind (sv-as-d b) (λ y → mr-map sv-d (f64-op o x y)))
  _ → mstop st-ill-typed
