hlz-metal-src : List Word
hlz-metal-src =
  hlz-line "#include <metal_stdlib>"
  (hlz-line "using namespace metal;"
  (hlz-line ""
  (hlz-line "struct LlmDims { uint rows; uint cols; };"
  (hlz-line ""
  (hlz-line "inline float bf16_to_f32(ushort b) { return as_type<float>(uint(b) << 16); }"
  (hlz-line ""
  (hlz-line "// Baseline: Uncompressed BF16 GEMV (reads 2.00 bytes/weight from unified RAM)"
  (hlz-line "kernel void hx_gemv_bf16_raw("
  (hlz-line "    device const ushort* W [[buffer(0)]],"
  (hlz-line "    device const float* x [[buffer(1)]],"
  (hlz-line "    device float* y [[buffer(2)]],"
  (hlz-line "    constant LlmDims& dm [[buffer(3)]],"
  (hlz-line "    uint row [[threadgroup_position_in_grid]],"
  (hlz-line "    uint tid [[thread_index_in_threadgroup]]) {"
  (hlz-line "  float acc = 0.0f;"
  (hlz-line "  device const ushort* wr = W + row * dm.cols;"
  (hlz-line "  for (uint c = tid; c < dm.cols; c += 128) acc = fma(bf16_to_f32(wr[c]), x[c], acc);"
  (hlz-line "  acc = simd_sum(acc);"
  (hlz-line "  threadgroup float sh[4];"
  (hlz-line "  if ((tid & 31) == 0) sh[tid >> 5] = acc;"
  (hlz-line "  threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hlz-line "  if (tid == 0) y[row] = sh[0] + sh[1] + sh[2] + sh[3];"
  (hlz-line "}"
  (hlz-line ""
  (hlz-line "// Fused Bit-Exact Lossless Compressed BF16 GEMV (reads 1.25 bytes/weight + sparse exceptions!)"
  (hlz-line "// Layout: sm[rows*cols] (1B: sign|mant7), eidx[rows*cols/4] (2-bit code per weight), pal[rows*4] (top-3 exp), esc_off/val/pos"
  (hlz-line "kernel void hx_gemv_bf16_zip("
  (hlz-line "    device const uchar* sm [[buffer(0)]],"
  (hlz-line "    device const uchar* eidx [[buffer(1)]],"
  (hlz-line "    device const uchar* pal [[buffer(2)]],"
  (hlz-line "    device const uint* esc_off [[buffer(3)]],"
  (hlz-line "    device const ushort* esc_col [[buffer(4)]],"
  (hlz-line "    device const uchar* esc_exp [[buffer(5)]],"
  (hlz-line "    device const float* x [[buffer(6)]],"
  (hlz-line "    device float* y [[buffer(7)]],"
  (hlz-line "    constant LlmDims& dm [[buffer(8)]],"
  (hlz-line "    uint row [[threadgroup_position_in_grid]],"
  (hlz-line "    uint tid [[thread_index_in_threadgroup]]) {"
  (hlz-line "  uchar p0 = pal[row * 4 + 0], p1 = pal[row * 4 + 1], p2 = pal[row * 4 + 2];"
  (hlz-line "  device const uchar4* sm4 = (device const uchar4*)(sm + row * dm.cols);"
  (hlz-line "  device const uchar* ei = eidx + row * (dm.cols >> 2);"
  (hlz-line "  device const float4* x4 = (device const float4*)x;"
  (hlz-line "  uint cols4 = dm.cols >> 2;"
  (hlz-line "  float acc = 0.0f;"
  (hlz-line "  for (uint g = tid; g < cols4; g += 128) {"
  (hlz-line "    uchar4 s = sm4[g];"
  (hlz-line "    uchar code = ei[g];"
  (hlz-line "    float4 xv = x4[g];"
  (hlz-line "    uchar c0 = code & 3, c1 = (code >> 2) & 3, c2 = (code >> 4) & 3, c3 = (code >> 6) & 3;"
  (hlz-line "    ushort e0 = (c0 == 0) ? p0 : ((c0 == 1) ? p1 : ((c0 == 2) ? p2 : 0));"
  (hlz-line "    ushort e1 = (c1 == 0) ? p0 : ((c1 == 1) ? p1 : ((c1 == 2) ? p2 : 0));"
  (hlz-line "    ushort e2 = (c2 == 0) ? p0 : ((c2 == 1) ? p1 : ((c2 == 2) ? p2 : 0));"
  (hlz-line "    ushort e3 = (c3 == 0) ? p0 : ((c3 == 1) ? p1 : ((c3 == 2) ? p2 : 0));"
  (hlz-line "    ushort w0 = (c0 < 3) ? ((ushort(s.x & 128) << 8) | (e0 << 7) | ushort(s.x & 127)) : 0;"
  (hlz-line "    ushort w1 = (c1 < 3) ? ((ushort(s.y & 128) << 8) | (e1 << 7) | ushort(s.y & 127)) : 0;"
  (hlz-line "    ushort w2 = (c2 < 3) ? ((ushort(s.z & 128) << 8) | (e2 << 7) | ushort(s.z & 127)) : 0;"
  (hlz-line "    ushort w3 = (c3 < 3) ? ((ushort(s.w & 128) << 8) | (e3 << 7) | ushort(s.w & 127)) : 0;"
  (hlz-line "    acc = fma(bf16_to_f32(w0), xv.x, acc);"
  (hlz-line "    acc = fma(bf16_to_f32(w1), xv.y, acc);"
  (hlz-line "    acc = fma(bf16_to_f32(w2), xv.z, acc);"
  (hlz-line "    acc = fma(bf16_to_f32(w3), xv.w, acc);"
  (hlz-line "  }"
  (hlz-line "  uint eb = esc_off[row], ee = esc_off[row + 1];"
  (hlz-line "  for (uint k = eb + tid; k < ee; k += 128) {"
  (hlz-line "    uint c = esc_col[k];"
  (hlz-line "    uchar s = sm[row * dm.cols + c];"
  (hlz-line "    ushort w = (ushort(s & 128) << 8) | (ushort(esc_exp[k]) << 7) | ushort(s & 127);"
  (hlz-line "    acc = fma(bf16_to_f32(w), x[c], acc);"
  (hlz-line "  }"
  (hlz-line "  acc = simd_sum(acc);"
  (hlz-line "  threadgroup float sh[4];"
  (hlz-line "  if ((tid & 31) == 0) sh[tid >> 5] = acc;"
  (hlz-line "  threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hlz-line "  if (tid == 0) y[row] = sh[0] + sh[1] + sh[2] + sh[3];"
  (hlz-line "}" nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
