-- Public Hyperactivity-computed SVG: exact 3D doubly-ruled hyperboloid wormhole
logo-hyperboloid-svg : List Word
logo-hyperboloid-svg =
  let f1 = hyp-family-segs (sp #10000) unit-circle-16 nil
      f2 = hyp-family-segs (sn #10000) unit-circle-16 f1
      -- Mouth radius R = r₀ * sqrt(1 + U²) = 0.18 * sqrt(1 + 3.15²) = 0.5949 -> #5949
      c0 = (sp #10000 , sp #0)
      rL = hyp-ring-segs (sn #5000) (sp #5949) #44 c0 unit-circle-16 f2
      rR = hyp-ring-segs (sp #5000) (sp #5949) #44 c0 unit-circle-16 rL
      rM = hyp-ring-segs (sp #0) (sp #1800) #36 c0 unit-circle-16 rR
      sorted = seg3-sort rM
  in lg-concat (cons "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 256 256' width='256' height='256'><rect width='256' height='256' fill='#ff0a94'/>"
       (cons (seg3-render sorted) (cons "</svg>" nil)))
