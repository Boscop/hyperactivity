chem-rdm2-pqg-partition-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
chem-rdm2-pqg-partition-poly A ad mu q vs =
  (λ g sub →
    let gp = g 0; gq = g 1; dpq = g 2
        q1 = q (fn-q 1 1)
        qpq = ad (sub (sub q1 gp) gq) dpq
        gpq = sub gp dpq
        gqp = sub gq dpq
        lhs = ad (ad (ad dpq qpq) gpq) gqp
    in (lhs , q1))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)
