hg-metal-src : List Word
hg-metal-src =
  hg-line "#include <metal_stdlib>"
  (hg-line "using namespace metal;"
  (hg-line ""
  (hg-line "struct GemmDims { uint M; uint N; uint K; };"
  (hg-line "struct AttnDims { uint N; uint D; float scale; };"
  (hg-line ""
  (hg-line "kernel void hx_gemm_tiled("
  (hg-line "    device const float* A [[buffer(0)]],"
  (hg-line "    device const float* B [[buffer(1)]],"
  (hg-line "    device float* C [[buffer(2)]],"
  (hg-line "    constant GemmDims& dm [[buffer(3)]],"
  (hg-line "    uint2 gid [[thread_position_in_grid]],"
  (hg-line "    uint2 tid [[thread_position_in_threadgroup]],"
  (hg-line "    uint2 tgid [[threadgroup_position_in_grid]]) {"
  (hg-line "  threadgroup float As[16][16];"
  (hg-line "  threadgroup float Bs[16][16];"
  (hg-line "  uint row = tgid.y * 16 + tid.y;"
  (hg-line "  uint col = tgid.x * 16 + tid.x;"
  (hg-line "  float acc = 0.0f;"
  (hg-line "  uint tiles = (dm.K + 15) / 16;"
  (hg-line "  for (uint t = 0; t < tiles; t++) {"
  (hg-line "    uint ak = t * 16 + tid.x;"
  (hg-line "    uint bk = t * 16 + tid.y;"
  (hg-line "    As[tid.y][tid.x] = (row < dm.M && ak < dm.K) ? A[row * dm.K + ak] : 0.0f;"
  (hg-line "    Bs[tid.y][tid.x] = (bk < dm.K && col < dm.N) ? B[bk * dm.N + col] : 0.0f;"
  (hg-line "    threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hg-line "    for (uint k = 0; k < 16; k++) acc = fma(As[tid.y][k], Bs[k][tid.x], acc);"
  (hg-line "    threadgroup_barrier(mem_flags::mem_threadgroup);"
  (hg-line "  }"
  (hg-line "  if (row < dm.M && col < dm.N) C[row * dm.N + col] = acc;"
  (hg-line "}"
  (hg-line ""
  (hg-line "// Exact online 1-pass FlashAttention lowered from lib/silicon/hypertensor.hypercubical"
  (hg-line "kernel void hx_flash_attn_1pass("
  (hg-line "    device const float* Q [[buffer(0)]],"
  (hg-line "    device const float* K [[buffer(1)]],"
  (hg-line "    device const float* V [[buffer(2)]],"
  (hg-line "    device float* O [[buffer(3)]],"
  (hg-line "    constant AttnDims& ad [[buffer(4)]],"
  (hg-line "    uint qidx [[thread_position_in_grid]]) {"
  (hg-line "  if (qidx >= ad.N) return;"
  (hg-line "  float qv[64];"
  (hg-line "  float acc[64];"
  (hg-line "  for (uint d = 0; d < ad.D; d++) { qv[d] = Q[qidx * ad.D + d]; acc[d] = 0.0f; }"
  (hg-line "  float m = -1e30f;"
  (hg-line "  float l = 0.0f;"
  (hg-line "  for (uint j = 0; j < ad.N; j++) {"
  (hg-line "    float dot = 0.0f;"
  (hg-line "    for (uint d = 0; d < ad.D; d++) dot = fma(qv[d], K[j * ad.D + d], dot);"
  (hg-line "    float s = dot * ad.scale;"
  (hg-line "    float mn = fmax(m, s);"
  (hg-line "    float a = exp(m - mn);"
  (hg-line "    float b = exp(s - mn);"
  (hg-line "    l = l * a + b;"
  (hg-line "    for (uint d = 0; d < ad.D; d++) acc[d] = acc[d] * a + b * V[j * ad.D + d];"
  (hg-line "    m = mn;"
  (hg-line "  }"
  (hg-line "  float inv = 1.0f / l;"
  (hg-line "  for (uint d = 0; d < ad.D; d++) O[qidx * ad.D + d] = acc[d] * inv;"
  (hg-line "}" nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
