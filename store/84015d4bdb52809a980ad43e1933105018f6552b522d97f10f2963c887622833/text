s-public-answer : List Word → List Word → List Word → Proc W (List Word)
s-public-answer st m path =
  if orB (h-eq (h-before "?" path) "/") (h-null path) then s-kept-public st "front" else
  if h-eq (h-before "?" path) "/llms.txt" then s-kept-public st "llms-txt" else
  if h-eq (h-before "?" path) "/feed.xml" then s-kept-public st "feed-xml" else
  if h-eq (h-before "?" path) "/peer/manifest" then s-peer-manifest m else
  if h-eq (h-before "?" path) "/dht/peers" then s-dht-peers st else
  if h-prefix "/dht/find/" path then s-dht-find st (h-drop "/dht/find/" (h-before "?" path)) else
  if h-eq (h-before "?" path) "/paper" then s-paper st m else
  if h-eq (h-before "?" path) "/paper.pdf" then s-kept-mod-public st "bin" "docs/hyperactivity.pdf.hex" else
  if h-eq (h-before "?" path) "/pdf" then s-kept-mod-public st "doc" "docs/pdf-viewer.html" else
  if h-eq (h-before "?" path) "/kg" then s-kept-mod-public st "doc" "docs/kg.html" else
  if h-eq (h-before "?" path) "/api/kg/index" then s-kept-mod-public st "json" "docs/kg-index.json" else
  if h-prefix "/api/kg/module" path then s-kg-module (s-query path) else
  if h-prefix "/api/live/pulse" path then s-live-pulse st (s-query path) else
  if h-prefix "/api/p2p/signal" path then s-p2p-signal st (s-query path) else
  if h-eq (h-before "?" path) "/nets" then s-kept-mod-public st "doc" "docs/nets.html" else
  if h-eq (h-before "?" path) "/neuro" then s-kept-mod-public st "doc" "docs/neuro.html" else
  if h-eq (h-before "?" path) "/physics" then s-kept-mod-public st "doc" "docs/physics.html" else
  if h-eq (h-before "?" path) "/ai" then s-kept-mod-public st "doc" "docs/ai.html" else
  if h-eq (h-before "?" path) "/kernel" then s-kept-mod-public st "doc" "docs/kernel.html" else
  if h-eq (h-before "?" path) "/cubical.wasm" then s-kept-mod-public st "bin" "docs/cubical.wasm.hex" else
  if h-eq (h-before "?" path) "/music" then s-kept-mod-public st "music" "lib/server.cub" else
  if h-eq (h-before "?" path) "/corpus/paper" then s-kept-public st "corpus-paper" else
  if andB (h-prefix "/corpus/" path) (s-known (s-at-name (h-drop "/corpus" (h-before "?" path)) s-published))
  then s-kept-mod-public st "corpus" (s-corpus-work-path (s-at-name (h-drop "/corpus" (h-before "?" path)) s-published)) else
  if s-known (s-at-name (h-before "?" path) s-published)
  then s-kept-mod-public st "page" (s-corpus-work-path (s-at-name (h-before "?" path) s-published)) else
  s-answer st m path
