-- more than n vectors among the padded ys followed by wr, when ys and one more than wr are more than n + 1
sy-pads-over : (A W : Type) → (z : A) → (n : Nat) → (ys : List W) → (wr : List (A × W)) → le (suc (suc n)) (plus (sy-len W ys) (suc (sy-len (A × W) wr))) →
  le (suc n) (sy-len (A × W) (sy-app (A × W) (ln-map W (A × W) (λ y → (z , y)) ys) wr))
sy-pads-over A W z n ys wr hl = le-cong-r (suc n) (plus (sy-len W ys) (sy-len (A × W) wr)) (sy-len (A × W) (sy-app (A × W) (ln-map W (A × W) (λ y → (z , y)) ys) wr)) (sy-gl n (sy-len W ys) (sy-len (A × W) wr) hl)
  (symN (transN (sy-len-app (A × W) (ln-map W (A × W) (λ y → (z , y)) ys) wr) (congN (λ q → plus q (sy-len (A × W) wr)) (sy-len-map W (A × W) (λ y → (z , y)) ys))))
