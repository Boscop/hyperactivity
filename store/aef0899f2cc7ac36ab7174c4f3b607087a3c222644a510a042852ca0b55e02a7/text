-- a branch's fields read out of the block: field i of the value p<d> is variable v<d+i>
ce-binds : Nat → Word → Word → List Word
ce-binds zero d i = nil
ce-binds (suc k) d i = list-append "uint64_t v" (list-append ((λ z → ce-q (toNat #20) z nil) (%wadd d i)) (list-append " = p" (list-append ((λ z → ce-q (toNat #20) z nil) d) (list-append "[" (list-append ((λ z → ce-q (toNat #20) z nil) (%wsucc i)) (list-append "]; " (ce-binds k d (%wsucc i))))))))
