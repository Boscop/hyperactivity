lit-lt-trans : (a b c : Lit) → lit-lt a b ≡ true → lit-lt b c ≡ true → lit-lt a c ≡ true
lit-lt-trans a b c p q =
  lit-lt-cases (lit-lt a c ≡ true) a b
    (λ w1 → lit-lt-cases (lit-lt a c ≡ true) b c
       (λ w2 → lit-lt-of-wlt a c (wlt-trans (fst a) (fst b) (fst c) w1 w2))
       (λ p2 s2 t2 → lit-lt-of-wlt a c (pcat0 Bool (wlt (fst a) (fst c)) (wlt (fst a) (fst b)) true (λ i → wlt (fst a) (p2 (~ i))) w1)) q)
    (λ p1 s1 t1 → lit-lt-cases (lit-lt a c ≡ true) b c
       (λ w2 → lit-lt-of-wlt a c (pcat0 Bool (wlt (fst a) (fst c)) (wlt (fst b) (fst c)) true (λ i → wlt (p1 i) (fst c)) w2))
       (λ p2 s2 t2 → bool-absurd (lit-lt a c ≡ true) (snd b) t1 s2) q) p
