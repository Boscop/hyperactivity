-- zipping two fibre maps of one cube is the fibre map of the pair (by dimension; each step judgmental)
zip-fmap : (n : Nat) (X : Type 1) (F0 F F' F2 : X → Type 1) (f : (x : X) → F0 x → F x) (g : (x : X) → F0 x → F' x)
  (h : (x : X) → F x → F' x → F2 x) (c : Cube n X) (d : DCube n X F0 c) →
  PathP (λ i → DCube n X F2 c) (dcube-zip n X F F' F2 h c (dcube-fmap n X F0 F f c d) (dcube-fmap n X F0 F' g c d)) (dcube-fmap n X F0 F2 (λ x y → h x (f x y) (g x y)) c d)
zip-fmap zero X F0 F F' F2 f g h c d = λ i → h c (f c d) (g c d)
zip-fmap (suc n) X F0 F F' F2 f g h c d =
  zip-fmap n (Line X) (LineO X F0) (LineO X F) (LineO X F') (LineO X F2) (lineo-fmap X F0 F f) (lineo-fmap X F0 F' g) (lineo-zip X F F' F2 h) c d
