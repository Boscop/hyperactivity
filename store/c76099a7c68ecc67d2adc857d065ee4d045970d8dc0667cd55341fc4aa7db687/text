hy-ranges-term : List (Nat × Nat) → List Word
hy-ranges-term nil = "nil"
hy-ranges-term (cons r rs) = list-append "(cons (toNat #" (list-append (h-decimal (fromNat (fst r))) (list-append " , toNat #"
  (list-append (h-decimal (fromNat (snd r))) (list-append ") " (list-append (hy-ranges-term rs) ")")))))
