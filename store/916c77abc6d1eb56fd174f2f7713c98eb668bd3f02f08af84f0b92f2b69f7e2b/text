-- the difference g − f (unverified): subtract f's coefficient from g's entry, dropping zeros
dec-at : Word → Word → Coefs → Coefs
dec-at v c ds =
  case ds return (λ w → Coefs) of
    cnil → cnil
    ccons v2 c2 s →
      (case weq v v2 return (λ w → Coefs) of
         true → (case weq (subw c2 c) #0 return (λ w → Coefs) of true → s; false → ccons v2 (subw c2 c) s)
         false → ccons v2 c2 (rec s))
