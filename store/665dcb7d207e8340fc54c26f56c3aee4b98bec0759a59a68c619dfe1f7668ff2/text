-- the expression substituted by its own names is itself
isub-id : (r : IEx) → PathP (λ i → IEx) (isub (λ k → ixv k) r) r
isub-id ix0 = λ i → ix0
isub-id ix1 = λ i → ix1
isub-id (ixv k) = λ i → ixv k
isub-id (ixneg r) = λ i → ixneg (isub-id r i)
isub-id (ixmeet r s) = λ i → ixmeet (isub-id r i) (isub-id s i)
isub-id (ixjoin r s) = λ i → ixjoin (isub-id r i) (isub-id s i)
