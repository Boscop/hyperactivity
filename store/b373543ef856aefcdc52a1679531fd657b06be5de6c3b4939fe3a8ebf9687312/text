-- Calma GDSII `SREF` (`0x0A00` = #2560, `SNAME` `0x1206` = #4614, 1-point `XY` `0x1003` = #4099 [12 bytes], `ENDEL` = #4352)
gds6-sref : Word → List Word → Word → Word → List Word
gds6-sref snameRecLen paddedName x0 y0 =
  sv-concat
    (cons (gds-u16s (cons #4 (cons #2560 nil)))
    (cons (gds-u16s (cons snameRecLen (cons #4614 nil)))
    (cons paddedName
    (cons (gds-u16s (cons #12 (cons gds-rec-xy nil)))
    (cons (gds-u32s (cons x0 (cons y0 nil)))
    (cons (gds-u16s (cons #4 (cons gds-rec-endel nil))) nil))))))
