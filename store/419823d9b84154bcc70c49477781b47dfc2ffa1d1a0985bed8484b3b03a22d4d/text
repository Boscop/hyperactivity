cs-val-rel : CsHeap → CsMVal → CsVal → Bool
cs-val-rel hp (cmv-word w) (csv-word w') = %weq w w'
cs-val-rel hp (cmv-word w) (csv-ptr addr) = false
cs-val-rel hp (cmv-bool b) (csv-word w) = false
cs-val-rel hp (cmv-bool b) (csv-ptr addr) =
  cs-ov-word-eq (cs-loadv hp (csv-ptr addr) zero) (cs-bool-tag b)
cs-val-rel hp (cmv-pair a b) (csv-word w) = false
cs-val-rel hp (cmv-pair a b) (csv-ptr addr) =
  cs-pair-rel-ov (cs-val-rel hp a) (cs-val-rel hp b)
    (cs-loadv hp (csv-ptr addr) (suc zero))
    (cs-loadv hp (csv-ptr addr) (suc (suc zero)))
