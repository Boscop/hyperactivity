-- 2D Systolic GEMM Equivalence Theorem: neighbor-forwarded systolic tile execution equals exact
-- C + A * B inner-product matrix multiplication for ALL initial accumulators and ALL depths K!
systolic-2x2-sound : (ws : List SysWave) → (c : Mat2x2) →
  systolic-run c ws ≡ ref-gemm-2x2 c ws
systolic-2x2-sound nil = λ c _ → c
systolic-2x2-sound (cons w ws) = λ c → systolic-2x2-sound ws (systolic-step c w)
