-- Burch-Dill Commuting Square Theorem: flushing after one pipelined hardware step equals one
-- single-cycle architectural ISA step from the flushed state — for ALL RAW/WAW hazard patterns!
burch-dill-raw : (rf : RegFile) → (wbV : Bool) → (wbRd : Word) → (wbVal : Nat) → (inst : IsaInst) →
  pipe-flush (pipe-step-raw rf wbV wbRd wbVal inst) ≡ isa-step (pipe-flush-raw rf wbV wbRd wbVal) inst
burch-dill-raw rf true  wbRd wbVal i-nop = refl
burch-dill-raw rf false wbRd wbVal i-nop = refl
burch-dill-raw rf true  wbRd wbVal (i-imm rd imm) = refl
burch-dill-raw rf false wbRd wbVal (i-imm rd imm) = refl
burch-dill-raw rf true  wbRd wbVal (i-addi rd rs1 imm) = refl
burch-dill-raw rf false wbRd wbVal (i-addi rd rs1 imm) = refl
burch-dill-raw rf true  wbRd wbVal (i-alu op rd rs1 rs2) = refl
burch-dill-raw rf false wbRd wbVal (i-alu op rd rs1 rs2) = refl
