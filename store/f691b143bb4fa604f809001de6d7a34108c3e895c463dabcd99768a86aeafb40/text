sg-elim-code : (Lst (List Word) → NkSexp → Code) → NkTm → Lst (List Word) → Lst NkSexp → Code
sg-elim-code _ _ _ lnil = cclock
sg-elim-code go2 ksig env (lcons mot r1) =
  case r1 return (λ _ → Code) of
    lnil → cclock
    lcons scrut brs →
      let d = sg-elim-d brs
          nc = sg-ctor-count ksig d
      in celim d (go2 env mot) (sg-build-brs go2 ksig env d #0 (toNat nc) brs) (go2 env scrut)
