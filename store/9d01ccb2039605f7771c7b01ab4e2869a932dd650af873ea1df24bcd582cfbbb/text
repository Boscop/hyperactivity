hy-finished : List Word → List Word → Bool → Proc W Unit
hy-finished f out true = bind (h-unrecord f) (λ u → h-out (h-line (list-append f (list-append " is now " (list-append (h-before ".md" f) ".cub: its source, checked equal to the document, which the source no longer holds by its old path, and the pulls made. Point what referred to the document at the source.")))))
hy-finished f out false = h-out (list-append (h-line (list-append (h-before ".md" f) ".cub was written, but its source is not the document exactly; the document is kept:")) out)
