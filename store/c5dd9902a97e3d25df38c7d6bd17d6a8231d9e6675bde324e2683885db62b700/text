mterm-list-codec : Codec (List MTerm) (Nat × (Nat × List Word))
mterm-list-codec =
  iso→codec
    (λ ts → (list-length ts , (mterm-list-nodes ts , mterm-list-enc-sym ts)))
    (λ p → fst (mterm-list-dec-sym (fst p) (fst (snd p)) (snd (snd p))))
    (λ ts →
       let p0 : mterm-list-dec-sym (list-length ts) (mterm-list-nodes ts) (list-append (mterm-list-enc-sym ts) nil) ≡ (ts , nil)
           p0 = mterm-list-dec-enc ts (mterm-list-nodes ts) (le-refl (mterm-list-nodes ts)) nil
       in concat {lzero} {List MTerm}
            {fst (mterm-list-dec-sym (list-length ts) (mterm-list-nodes ts) (mterm-list-enc-sym ts))}
            {fst (mterm-list-dec-sym (list-length ts) (mterm-list-nodes ts) (list-append (mterm-list-enc-sym ts) nil))}
            {ts}
            (λ i → fst (mterm-list-dec-sym (list-length ts) (mterm-list-nodes ts) (sym (cm-append-nil (mterm-list-enc-sym ts)) i)))
            (cong {lzero} {lzero} {List MTerm × List Word} {List MTerm} (λ q → fst q) p0))
