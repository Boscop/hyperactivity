-- 2-CELL: Both ways of parenthesizing 3-stage Futamura specialization are homotopic!
w2-thm-fut3-coherence : (s1 s2 s3 : Word → Opt Bool) → (d : Word → Bool) → (e : FExpr) →
  web-trans-b (web-trans-b (fut-thm-mix-sound s3 d (f-mix s2 (f-mix s1 e)))
                           (fut-thm-mix-sound s2 (f-merge s3 d) (f-mix s1 e)))
              (fut-thm-mix-sound s1 (f-merge s2 (f-merge s3 d)) e)
  ≡ fut-thm-fut3-sound s1 s2 s3 d e
w2-thm-fut3-coherence s1 s2 s3 d e =
  w2-assoc
    (fut-thm-mix-sound s3 d (f-mix s2 (f-mix s1 e)))
    (fut-thm-mix-sound s2 (f-merge s3 d) (f-mix s1 e))
    (fut-thm-mix-sound s1 (f-merge s2 (f-merge s3 d)) e)
