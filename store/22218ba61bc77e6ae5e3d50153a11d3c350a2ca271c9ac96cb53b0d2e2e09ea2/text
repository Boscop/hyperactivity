-- the result in decimal, k digits: soundness, the energy's interval, p's interval
h2p-report : List Bool → Nat → Bool × IV → Bool × (((Bool × List Nat) × (Bool × List Nat)) × ((Bool × List Nat) × (Bool × List Nat)))
h2p-report S k r = (fst r , (iv-dec S k (h2p-energy S (snd r)) , iv-dec S k (snd r)))
