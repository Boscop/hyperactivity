-- k computed steps: a step that is a value, then the rest
q-run-val : (stp : X86Step) → (stop j : Word) → (Q : Opt X86 → Type) → Q none →
            ((s1 : X86) → run-ok stp stop j s1 ≡ true → QAll stp stop Q (snd (run-of stp j s1)) → QAll stp stop Q s1) →
            (s : X86) → weq (x86-rip s) stop ≡ false → (o : Outc exception Unit) → fst (stp s) ≡ o →
            (case o return (λ _ → Bool) of
               out-val u → run-ok stp stop j (snd (stp s))
               out-throw e → false
               out-abort w → false) ≡ true →
            QAll stp stop Q (snd (run-of stp (%wsucc j) s)) → QAll stp stop Q s
q-run-val stp stop j Q q0 ih s ne o eo =
  case o return (λ o2 → fst (stp s) ≡ o2 → (case o2 return (λ _ → Bool) of
                                              out-val u → run-ok stp stop j (snd (stp s))
                                              out-throw e → false
                                              out-abort w → false) ≡ true →
                        QAll stp stop Q (snd (run-of stp (%wsucc j) s)) → QAll stp stop Q s) of
    out-val u → λ q h qa →
      (case u return (λ u2 → fst (stp s) ≡ out-val u2 → QAll stp stop Q s) of
         unit → λ q2 →
           q-step stp stop Q s (snd (stp s)) ne (λ i → the (Outc exception Unit × X86) (q2 i , snd (stp s))) q0
             (ih (snd (stp s)) h
                (subst {lzero} {lzero} {X86} {QAll stp stop Q}
                   (cong (λ o3 → snd (st-on {X86} {exception} {Unit} {Unit} o3 (λ _ → run-of stp j) (snd (stp s)))) q2) qa)))
      q
    out-throw e → λ q h qa → bool-ft (QAll stp stop Q s) h
    out-abort w → λ q h qa → bool-ft (QAll stp stop Q s) h
  eo
