-- an expression evaluated on known inputs: its interval knows each exact value
ie-inp : (S S2 : List Bool) → (envI : Nat → IV) → (E : Nat → ZQ) → (e : IE) → (v : ZQ) →
  bcanon S ≡ true → le (suc zero) (bin-to-nat S) → bin-to-nat S2 ≡ times (bin-to-nat S) (bin-to-nat S) →
  ((j : Nat) → inp S (envI j) (E j)) → isval E e v → snd (ieval S S2 envI e) ≡ true → inp S (fst (ieval S S2 envI e)) v
ie-inp S S2 envI E e v cS hS hS2 H hv hf = (fst (ie-sound S S2 envI E cS hS hS2 (λ j → fst (H j)) (λ j → fst (snd (H j))) (λ j → snd (snd (H j))) e v hv hf) ,
  (snd (ie-sound S S2 envI E cS hS hS2 (λ j → fst (H j)) (λ j → fst (snd (H j))) (λ j → snd (snd (H j))) e v hv hf) , isval-pos E e v hv))
