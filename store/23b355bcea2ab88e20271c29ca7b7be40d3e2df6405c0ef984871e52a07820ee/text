-- ---------------------------------------------------------------- lists: maps, drops, takes
map-map : {A B C : Type} → (f : B → C) → (g : A → B) → (l : List A) → list-map f (list-map g l) ≡ list-map (λ x → f (g x)) l
map-map f g l = case l return λ w → list-map f (list-map g w) ≡ list-map (λ x → f (g x)) w of nil → λ i → nil; cons x r → λ i → cons (f (g x)) (rec r i)
