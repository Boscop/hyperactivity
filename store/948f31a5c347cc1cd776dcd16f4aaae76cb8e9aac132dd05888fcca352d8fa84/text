edge-trace-vw : Nat → List Nat → List Triple → VW → List Side
edge-trace-vw e ds ts w = cons (side-vw e ds (ds-plus e ds) (eplus-entry e ds) (rplus-entry e (ds-plus e ds)) w (vm-of (ds-plus e ds) ts))
  (if eqb (exp-at e ds) zero then nil else cons (side-vw e ds (ds-minus e ds) (eminus-entry e ds) (rminus-entry e (ds-minus e ds)) w (vm-of (ds-minus e ds) ts)) nil)
