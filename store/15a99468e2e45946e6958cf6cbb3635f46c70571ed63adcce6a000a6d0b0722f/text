-- ---------------------------------------------------------------- terminators
rm-arms : List RSwitchArm → SK → Word → SV → REv Word
rm-arms nil k other = λ v → rm-ret other
rm-arms (cons a rs) k other = case a of
  rarm val bb → sr-on (rm-int-sv k val) (λ e v → rm-throw e) (λ c →
    let rest = rm-arms rs k other
    in λ v → rm-bind (rm-res (sv-cmp co-eq k v c)) (λ b → case b of
         true → rm-ret bb
         false → rest v))
