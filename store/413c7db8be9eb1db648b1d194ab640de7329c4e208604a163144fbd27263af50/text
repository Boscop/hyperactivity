p-build : List Word → Proc W Unit
p-build st =
  bind (h-dir-time (toNat #12) ".") (λ stamp →
  bind (h-mkdir st) (λ u → bind (h-mkdir (list-append st "/paper")) (λ u2 →
  bind (h-write (list-append st "/paper/text") (human hyperactivity)) (λ b →
  bind (p-unresolved st (p-names-of hyperactivity)) (λ un →
  bind (h-write (list-append st "/paper/unresolved") (h-concat (list-map h-line un))) (λ b1 →
  bind (h-write (list-append st "/paper/stamp") (h-decimal stamp)) (λ b2 → exit #0)))))))
