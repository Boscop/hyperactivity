-- what the certificate means. At p = m/S exactly (p² = m²/S²): (1) at A = A₋ (lh's lower end) and every
-- angular chain from [0, 1] at any depth past the start, G of its end is negative; (2) at A = A₊, positive;
-- (3) for every A in [A₋, A₊], the exact σ and c, and every radial chain from [0, 1] at any depth past the
-- start, F = c − r_1 lies in the certified interval
cert-means : List Bool → List Bool → IE → IE → IE → IE → IE → IV → BZ → IV → Nat → Nat → ZQ → Type
cert-means S S2 sta gt str ce se R m lh M N rq =
  ((k : Nat) → (tv rv gv : ZQ) → uni S tv → le (suc zero) (snd tv) →
     echain (ang-envq (zmul (zv m) (zv m) , times (bin-to-nat S) (bin-to-nat S)) (zv (fst lh) , bin-to-nat S)) sta (plus k (suc M)) tv rv →
     isval (env3q rv (zmul (zv m) (zv m) , times (bin-to-nat S) (bin-to-nat S)) (zv (fst lh) , bin-to-nat S)) gt gv → zpos (zsw (zsc (fst gv) (bin-to-nat S)))) ×
  (((k : Nat) → (tv rv gv : ZQ) → uni S tv → le (suc zero) (snd tv) →
     echain (ang-envq (zmul (zv m) (zv m) , times (bin-to-nat S) (bin-to-nat S)) (zv (snd lh) , bin-to-nat S)) sta (plus k (suc M)) tv rv →
     isval (env3q rv (zmul (zv m) (zv m) , times (bin-to-nat S) (bin-to-nat S)) (zv (snd lh) , bin-to-nat S)) gt gv → zpos (zsc (fst gv) (bin-to-nat S))) ×
   ((aq sq cq : ZQ) → inp S lh aq → isval (env3q rq (zv m , bin-to-nat S) aq) se sq → isval (env3q rq (zv m , bin-to-nat S) aq) ce cq →
     (k : Nat) → (tv rv : ZQ) → uni S tv → le (suc zero) (snd tv) → echain (rad-envq (zv m , bin-to-nat S) sq cq) str (plus k N) tv rv →
     inp S (fst (f-val-of S S2 str ce se R (m , m) lh N)) (zplus (zsc (fst cq) (snd rv)) (zsc (zsw (fst rv)) (snd cq)) , times (snd cq) (snd rv))))
