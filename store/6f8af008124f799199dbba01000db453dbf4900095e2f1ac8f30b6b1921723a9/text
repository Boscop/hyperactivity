-- the neighbours of p (directions d, …, 3) that are neither occupied nor already candidates, onto acc
sp-nb : Nat × Nat → Nat → Nat → List (Nat × Nat) → List (Nat × Nat) → List (Nat × Nat)
sp-nb p k d occ acc = case k of
  zero → acc
  suc k1 → sp-nb p k1 (suc d) occ (if sp-mem (sl-step p d) occ then acc else (if sp-mem (sl-step p d) acc then acc else cons (sl-step p d) acc))
