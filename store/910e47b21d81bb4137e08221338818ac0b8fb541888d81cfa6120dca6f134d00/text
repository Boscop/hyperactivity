hy-state-of : List (List Word) → Sum Unit HyState
hy-state-of nil = inl unit
hy-state-of (cons w r) =
  if h-eq w "walking" then inr (hy-walking (toNat (h-number (hy-head r)))) else
  if h-eq w "working" then inr hy-working else
  if h-eq w "reading" then inr (hy-reading (hy-head r)) else
  if h-eq w "decomposing" then inr (hy-decomposing (hy-head r) (list-map h-number (hy-rest r))) else inl unit
