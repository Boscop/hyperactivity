nk-agree-in : NkTm → NkTm → Word → NkTm → NkTm → NkTm
nk-agree-in kdefs ctx n ty nk-nil = ty
nk-agree-in kdefs ctx n ty ex =
  if nk-eq-s kdefs ctx n ty ex
    then ex
    else (if nk-con-is ty #2
            then (if nk-con-is ex #2
                    then (if nk-lvl-le (nk-lvl-of (toNat #64) (nk-u-lvl-tm ty)) (nk-lvl-of (toNat #64) (nk-u-lvl-tm ex)) then ex else nk-fail)
                    else nk-fail)
            else nk-fail)
