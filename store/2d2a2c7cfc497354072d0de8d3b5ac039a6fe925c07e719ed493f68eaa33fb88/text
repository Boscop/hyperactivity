-- the width of a size in bytes; a size no kind has (0: the type is not offered) stops
iw-of-size : Word → MRes IW
iw-of-size n = case weq n #1 of
  true → mok iw8
  false → (case weq n #2 of
    true → mok iw16
    false → (case weq n #4 of
      true → mok iw32
      false → (case weq n #8 of
        true → mok iw64
        false → (case weq n #16 of
          true → mok iw128
          false → mstop st-unsupported))))
