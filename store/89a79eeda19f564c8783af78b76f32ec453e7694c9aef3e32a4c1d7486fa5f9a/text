-- Theorem 2: Signed warrants compose into a Virtual Joint Agent (k1 /\ k2)
wp-joint-agent-compose : (ver : Word → Word → Bool) → (claim : Word) →
  (a b : WarrantPolicy) →
  wp-satisfies ver claim a ≡ true →
  wp-satisfies ver claim b ≡ true →
  wp-satisfies ver claim (wp-and a b) ≡ true
wp-joint-agent-compose ver claim a b ha hb =
  andB-tt-s (wp-satisfies ver claim a) (wp-satisfies ver claim b) ha hb
