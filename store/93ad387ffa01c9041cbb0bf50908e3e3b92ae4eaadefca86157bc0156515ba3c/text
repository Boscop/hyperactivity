pick-min-r-br : {C S : Type} → (sem : C → S) → (spec : S) → (cost : C → Nat) →
  (a b : fiber sem spec) → (cmp : Bool) → leB (cost (fst a)) (cost (fst b)) ≡ cmp →
  leB (cost (fst (if cmp then a else b))) (cost (fst b)) ≡ true
pick-min-r-br sem spec cost a b true = λ h → h
pick-min-r-br sem spec cost a b false = λ _ → leB-refl (cost (fst b))
