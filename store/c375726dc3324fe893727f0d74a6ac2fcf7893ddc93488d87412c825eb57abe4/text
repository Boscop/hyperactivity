xor-swap4 : (a1 b1 a2 b2 : Bool) →
  b-xor2 (b-xor2 a1 b1) (b-xor2 a2 b2) ≡ b-xor2 (b-xor2 a1 a2) (b-xor2 b1 b2)
xor-swap4 false false false false = λ _ → false
xor-swap4 false false false true  = λ _ → true
xor-swap4 false false true  false = λ _ → true
xor-swap4 false false true  true  = λ _ → false
xor-swap4 false true  false false = λ _ → true
xor-swap4 false true  false true  = λ _ → false
xor-swap4 false true  true  false = λ _ → false
xor-swap4 false true  true  true  = λ _ → true
xor-swap4 true  false false false = λ _ → true
xor-swap4 true  false false true  = λ _ → false
xor-swap4 true  false true  false = λ _ → false
xor-swap4 true  false true  true  = λ _ → true
xor-swap4 true  true  false false = λ _ → false
xor-swap4 true  true  false true  = λ _ → true
xor-swap4 true  true  true  false = λ _ → true
xor-swap4 true  true  true  true  = λ _ → false
