cs-eval-switch-mono : (ev : CsHeap → CsEnv → CsExp → CsRes) →
  ((hp1 : CsHeap) (env1 : CsEnv) (e : CsExp) → cs-res-mono hp1 (ev hp1 env1 e)) →
  (brs : CsExp) (hp : CsHeap) (env : CsEnv) (ptr : CsVal) (tag : Word) →
  cs-res-mono hp (cs-eval-switch ev hp env ptr tag brs)
cs-eval-switch-mono ev hev cse-br-nil hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-br-cons k d nf body rest) hp env ptr tag =
  cs-ite-res-mono (%weq tag k) hp
    (cs-bind-opt (cs-bind-fields hp ptr d zero (toNat nf) env) (λ env1 → ev hp env1 body))
    (cs-eval-switch ev hp env ptr tag rest)
    (cs-opt-res-mono hp (cs-bind-fields hp ptr d zero (toNat nf) env) (λ env1 → ev hp env1 body)
      (λ env1 → hev hp env1 body))
    (cs-eval-switch-mono ev hev rest hp env ptr tag)
cs-eval-switch-mono ev hev cse-bad hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-var vid) hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-ull n) hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-add1 a) hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-bop j a b) hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-let d t b) hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-call fn args) hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-clo fn ar n args) hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-app f a) hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-pair a b) hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-fst p) hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-snd p) hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-con t0 nf args) hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-switch d scrut b0) hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-for d bound init step) hp env ptr tag = unit
cs-eval-switch-mono ev hev cse-args-nil hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-fargs hd tl) hp env ptr tag = unit
cs-eval-switch-mono ev hev (cse-cargs hd tl) hp env ptr tag = unit
