cs-eqw-sound : (a b : Word) → (eqw a b ≡ true) → a ≡ b
cs-eqw-sound a b =
  %welimP (λ u → (v : Word) → (eqw u v ≡ true) → u ≡ v) a
    (λ v → %welimP (λ w → (eqw #0 w ≡ true) → #0 ≡ w) v (λ _ → refl) (λ m _ h → cs-no h))
    (λ n hn v → %welimP (λ w → (eqw (%wsucc n) w ≡ true) → %wsucc n ≡ w) v
      (λ h → cs-no h)
      (λ m _ h → cong (λ z → %wsucc z) (hn m h)))
    b
