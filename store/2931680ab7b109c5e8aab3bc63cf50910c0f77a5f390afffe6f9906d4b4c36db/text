data XpDer : (J : List XpTy × XpExpr × XpTy) → Type where
  xd-var : (g : List XpTy) (n : Nat) (a : XpTy) → PathP (λ i → Sum XpTy Unit) (xp-lookup g n) (inl a) → XpDer (g , xp-var n , a)
  xd-num : (g : List XpTy) (n : Nat) → XpDer (g , xp-num n , xt-nat)
  xd-plus : (g : List XpTy) (a b : XpExpr) → XpDer (g , a , xt-nat) → XpDer (g , b , xt-nat) → XpDer (g , xp-plus a b , xt-nat)
  xd-pair : (g : List XpTy) (a b : XpExpr) (A B : XpTy) → XpDer (g , a , A) → XpDer (g , b , B) → XpDer (g , xp-pair a b , xt-prod A B)
  xd-fst : (g : List XpTy) (p : XpExpr) (A B : XpTy) → XpDer (g , p , xt-prod A B) → XpDer (g , xp-fst p , A)
  xd-snd : (g : List XpTy) (p : XpExpr) (A B : XpTy) → XpDer (g , p , xt-prod A B) → XpDer (g , xp-snd p , B)
