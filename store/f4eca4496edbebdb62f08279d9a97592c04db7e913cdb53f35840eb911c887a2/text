sg-compile-sig : NkRawSig → NkTm
sg-compile-sig rsig =
  let kd = sg-compile-datas rsig (fst rsig)
      kf0 = sg-compile-defs0 rsig (snd rsig)
      dm = sg-words-d (fst rsig)
      gm = sg-words-g (snd rsig)
  in nk-con #56 (nk-cons kd (nk-cons (sg-norm-defs kf0 kf0) (nk-cons dm (nk-cons gm nk-nil))))
