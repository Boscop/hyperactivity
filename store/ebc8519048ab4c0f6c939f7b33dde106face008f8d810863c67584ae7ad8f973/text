-- Theorem: the first line of a printed text is its name, when the name holds no newline
first-line-print : (n s : List Word) → isTrue (no-newline n) → Path (List Word) (raw-first-line (text-written-raw-print n s)) n
first-line-print nil s h = refl
first-line-print (cons b r) s h = first-line-step (weq b #10) b (raw-first-line (text-written-raw-print r s)) r (first-line-print r s) h
