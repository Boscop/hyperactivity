-- the long-division loop
div-loop-sound : (ms d q r : List Bool) → bcanon d ≡ true → bcanon r ≡ true → le (suc (bin-to-nat r)) (bin-to-nat d) → div-post (msval ms (plus (times (bin-to-nat q) (bin-to-nat d)) (bin-to-nat r))) (bin-to-nat d) (bin-div-loop ms d q r)
div-loop-sound ms = case ms return λ m → (d q r : List Bool) → bcanon d ≡ true → bcanon r ≡ true → le (suc (bin-to-nat r)) (bin-to-nat d) → div-post (msval m (plus (times (bin-to-nat q) (bin-to-nat d)) (bin-to-nat r))) (bin-to-nat d) (bin-div-loop m d q r) of
  nil → λ d q r cd cr hr → (λ i → plus (times (bin-to-nat q) (bin-to-nat d)) (bin-to-nat r) , hr)
  cons x rest → λ d q r cd cr hr → div-step-v x rest d q r (λ q2 r2 → rec rest d q2 r2 cd) cr hr (bin-leb d (bin-cons x r)) (symB (bin-leb-sound d (bin-cons x r) cd (bin-cons-canon x r cr)))
