net-step-commute : {Val Op : Type} → (w1 w2 : Word) → (c1 c2 : WCh Val Op) →
  (net : Word → WSlot Val Op) → weq w1 w2 ≡ false →
  net-upd w1 c1 (net-upd w2 c2 net) ≡ net-upd w2 c2 (net-upd w1 c1 net)
net-step-commute w1 w2 c1 c2 net hdisj =
  λ i q → comm-branch w1 w2 q c1 c2 (net q) hdisj (weq w1 q) (weq w2 q) refl refl i
