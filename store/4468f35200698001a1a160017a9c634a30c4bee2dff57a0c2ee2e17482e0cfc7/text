hxt-rev-bwd : Word → RevPair → Word × (RevPair × RevPair)
hxt-rev-bwd b _ =
  let res = %welimP (λ _ → Word × Word) b (#0 , #0) (λ _ acc →
              let s0   = rpair #11 #17
                  yfin = %welimP (λ _ → RevPair) #12 s0 (λ k s → rev-fwd-1 (hxt-rev-w k) s)
                  bwd  = %welimP (λ _ → Word × (RevPair × RevPair)) #12 (#0 , (yfin , rpair #1 #1)) (λ i st →
                           let k  = %wsub #11 i
                               w  = hxt-rev-w k
                               rp = rev-bwd-1 w (fst (snd st))
                               g  = snd (snd st)
                           in case rp of
                                rpair u v →
                                  case g of
                                    rpair gy1 gy2 →
                                      (%wadd (fst st) (%wmod (%wmul v gy2) #1000003) , (rpair u v , rpair gy2 (%wmod (%wadd gy1 (%wmul w gy2)) #1000003))))
                  ok   = case fst (snd bwd) of
                           rpair u v → if %weq u #11 then (if %weq v #17 then #1 else #0) else #0
              in (%wadd (fst acc) ok , %wadd (snd acc) (fst bwd)))
  in (snd res , (rpair (fst res) b , rpair #1 #1))
