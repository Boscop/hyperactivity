nk-emem-bound-at : (eq : Bool) (w x : NkW) (r : NkEnv) (n : NkW) → (nk-weq w x ≡ eq) → ((if eq then true else nk-emem w r) ≡ true) → (nk-ebound (nke-cons x r) n ≡ true) → ((nk-emem w r ≡ true) → (nk-ebound r n ≡ true) → nk-wire-lt w n ≡ true) → nk-wire-lt w n ≡ true
nk-emem-bound-at true w x r n p hm hb ih =
  cong (λ z → nk-wire-lt z n) (nk-weq-sound w x p) ∙ nk-and-l (nk-wire-lt x n) (nk-ebound r n) hb
nk-emem-bound-at false w x r n p hm hb ih =
  ih hm (nk-and-r (nk-wire-lt x n) (nk-ebound r n) hb)
