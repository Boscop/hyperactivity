v-node-problems : VEnv → List Word → List (List Word)
v-node-problems env i =
  let sent = v-look-word i (ve-sents env) in
  let ks = v-look-list i (ve-ktab env) in
  let leaf = v-empty ks in
  let done = h-has i (ve-comp env) in
  let ip = ve-ip env in
  let res-ids = ve-res-ids env in
  let und = v-look-list i (ve-und env) in
  list-append (v-rule (orB (h-not (h-infix " " sent)) (h-eq sent i)) i "its name must be an English sentence saying what it is, not an identifier")
  (list-append (v-rule (andB (h-has i ip) (h-not leaf)) i "in progress but has children (work in progress is a leaf; a node is expanded when a child begins)")
  (list-append (v-rule (andB (h-has i ip) (h-has i res-ids)) i "both in progress and resolved")
  (v-rule (andB (andB (andB (h-not leaf) (h-not (h-has i (ve-roots env)))) (h-not done))
    (v-empty (v-filter (λ x → orB (h-has x ip) (h-has x res-ids)) und))) i
    "expanded, but nothing under it is in progress or resolved (a node is expanded exactly when a child begins)")))
