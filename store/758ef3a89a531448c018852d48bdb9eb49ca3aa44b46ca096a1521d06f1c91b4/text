-- a page the build made and kept, read as the public server serves it: under the state of the source the
-- build recorded (STORE/site-stamp, written by s-make-site), so the server reads exactly the names the
-- build wrote and never makes a page; a page not made is answered as such
s-kept-public : List Word → List Word → Proc W (List Word)
s-kept-public st key = bind (h-read (list-append st "/site-stamp")) (λ s → bind (h-read (list-append st (list-append "/site-" (list-append (h-hex (h-before " " (s-or nil s))) (list-append "-" key))))) (λ r → ret {lzero} {W} (s-or (s-respond "503 Service Unavailable" "text/plain" "this page is not made") r)))
