cliff-H-invol-raw : (s : Bool) → (p : Pauli1) → cliff-H (cliff-H (s , p)) ≡ (s , p)
cliff-H-invol-raw false p-I = λ _ → (false , p-I)
cliff-H-invol-raw false p-X = λ _ → (false , p-X)
cliff-H-invol-raw false p-Y = λ _ → (false , p-Y)
cliff-H-invol-raw false p-Z = λ _ → (false , p-Z)
cliff-H-invol-raw true  p-I = λ _ → (true  , p-I)
cliff-H-invol-raw true  p-X = λ _ → (true  , p-X)
cliff-H-invol-raw true  p-Y = λ _ → (true  , p-Y)
cliff-H-invol-raw true  p-Z = λ _ → (true  , p-Z)
