-- scaling keeps order
zle-scale : (x y : Nat × Nat) → (c : Nat) → zle x y → zle (zsc x c) (zsc y c)
zle-scale x y c h = (times (fst h) c ,
  transN (congN (plus (times (fst h) c)) (symN (times-distr (fst x) (snd y) c)))
  (transN (symN (times-distr (fst h) (plus (fst x) (snd y)) c))
  (transN (congN (λ z → times z c) (snd h)) (times-distr (fst y) (snd x) c))))
