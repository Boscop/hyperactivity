sg-dc-let : (Word → Lst (List Word) → NkSexp → Word × NkSexp) → Word → Lst (List Word) → Lst NkSexp → Word × NkSexp
sg-dc-let go fr ds (lcons (nks-sym (cons #61 nm)) (lcons v (lcons b lnil))) =
  let pv = go fr ds v
      pb = go (fst pv) (lcons nm ds) b
  in (fst pb , nks-lst (lcons (nks-sym "let") (lcons (nks-sym nm) (lcons (snd pv) (lcons (snd pb) lnil)))))
sg-dc-let go fr ds (lcons v (lcons b lnil)) =
  let nm = sg-fresh-nm fr
      pv = go (%wsucc fr) ds v
      pb = go (fst pv) (lcons nm ds) b
  in (fst pb , nks-lst (lcons (nks-sym "let") (lcons (nks-sym nm) (lcons (snd pv) (lcons (snd pb) lnil)))))
sg-dc-let _ fr _ _ = (fr , nks-sym nil)
