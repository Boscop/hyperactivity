sg-pat-head : NkSexp → Opt ((Word × Word) × Lst NkSexp)
sg-pat-head (nks-sym _) = none
sg-pat-head (nks-lst xs) =
  case xs return (λ _ → Opt ((Word × Word) × Lst NkSexp)) of
    lnil → none
    lcons h flds →
      case h return (λ _ → Opt ((Word × Word) × Lst NkSexp)) of
        nks-sym s → sg-pat-sym s flds
        nks-lst _ → none
