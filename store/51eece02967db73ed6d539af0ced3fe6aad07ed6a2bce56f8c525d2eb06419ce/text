-- Exact algebraic inverse (zero tape memory — recovers (q0, p0) BIT-EXACTLY!)
verlet-inv : Word → Word → Word × Word → Word × Word
verlet-inv k alpha qp =
  let q1 = fst qp
      p1 = snd qp
      q0 = w32-sub q1 p1
      q2 = s32-mul16 q0 q0
      q3 = s32-mul16 q2 q0
      f  = w32-add (s32-mul16 k q0) (s32-mul16 alpha q3)
      p0 = w32-add p1 f
  in (q0 , p0)
