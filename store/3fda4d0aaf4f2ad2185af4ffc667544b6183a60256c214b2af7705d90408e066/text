sr-enc-step : FTbl → Word → Nat → SRState → Word → SRState
sr-enc-step tbl L fuel st x =
  let M = ftbl-total tbl
  in case ftbl-find #0 x tbl of
       none → st
       some cf →
         let f = snd cf
             hi = sr-hi L M f
             fl = sr-flush-loop fuel hi (fst st) (snd st)
         in (rans-enc-step tbl (fst fl) x , snd fl)
