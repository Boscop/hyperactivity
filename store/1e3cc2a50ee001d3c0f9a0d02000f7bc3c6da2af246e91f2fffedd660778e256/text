-- CBinOp: binary operators met (a compound assignment names the operator applied)
data CBinOp =
    cbo-mul
  | cbo-div
  | cbo-rem
  | cbo-add
  | cbo-sub
  | cbo-shl
  | cbo-shr
  | cbo-lt
  | cbo-gt
  | cbo-le
  | cbo-ge
  | cbo-eq
  | cbo-ne
  | cbo-and
  | cbo-xor
  | cbo-or
  | cbo-land
  | cbo-lor
  | cbo-assign
  | cbo-comma
  | cbo-ptr-mem-d
  | cbo-ptr-mem-i
