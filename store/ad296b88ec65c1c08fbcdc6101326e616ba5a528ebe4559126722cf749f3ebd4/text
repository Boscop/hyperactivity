-- (part of language-support)
select_address_size : (proc_mode' : proc_mode) → (prefixes' : Option prefixes) → MS ZI
select_address_size proc_mode' prefixes' =
  let p4? : Bool
      p4? =
        case prefixes' of
          Some v'1 →
            (let prefixes' : prefixes
                 prefixes' = v'1
             in (weq #103 (prefixes-adr prefixes')))
          None → false
  in λ σ →
       if (in_64bit_mode proc_mode') then
         the (MS ZI)
           (retS {ZI} (if p4? then (zpos #4) else (zpos #8))) σ
       else
         the (MS ZI)
           (bindS {List (Bits #16)} {ZI} (getS {List (Bits #16)} x86-seg_hidden_attrs) (λ seg_hidden_attrs'3 →
              let cs_attr : Bits #16
                  cs_attr = (vec-get {Bits #16} #0 seg_hidden_attrs'3 #1)
                  cs_d : Bits #1
                  cs_d = (code_segment_descriptor_attributesbits-d cs_attr)
              in retS {ZI} (if (weq cs_d #1) then (if p4? then (zpos #2) else (zpos #4)) else (if p4? then (zpos #4) else (zpos #2))))) σ
