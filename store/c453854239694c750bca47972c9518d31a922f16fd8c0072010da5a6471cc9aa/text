-- the machine's normal form, a pass of these steps, and again until nothing changes; each normal
-- form computed once
nk-norm-it : Nat → NkTm → NkTm
nk-norm-it zero t = nk-nf (toNat #30000) t
nk-norm-it (suc k) t =
  let nf = nk-nf (toNat #30000) t
      kn = nk-kan nf
  in if nk-tm-eq kn nf then nf else nk-norm-it k kn
