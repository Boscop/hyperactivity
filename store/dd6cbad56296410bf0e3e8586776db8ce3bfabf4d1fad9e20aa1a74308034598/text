-- Right child mediant preserves unimodular determinant: p2*q1 = 1 + p1*q2 => p2*(q1+q2) = 1 + (p1+p2)*q2
mediant-unimodular-r : (p1 q1 p2 q2 : Nat) → times p2 q1 ≡ suc (times p1 q2) → times p2 (plus q1 q2) ≡ suc (times (plus p1 p2) q2)
mediant-unimodular-r p1 q1 p2 q2 h =
  transN (times-distl p2 q1 q2)
    (transN (congN (λ z → plus z (times p2 q2)) h)
      (congN suc (symN (times-distr p1 p2 q2))))
