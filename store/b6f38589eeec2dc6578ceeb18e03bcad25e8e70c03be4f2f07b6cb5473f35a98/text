-- the statements asserted equivalent to the focus: every equivalence any reader has written at it
hi-eq-texts : List Word → List (List Word) → List (List Word)
hi-eq-texts f nil = nil
hi-eq-texts f (cons l r) = if h-prefix (h-concat (cons "- equivalence at " (cons f (cons ": " nil)))) l then cons (h-drop (h-concat (cons "- equivalence at " (cons f (cons ": " nil)))) l) (hi-eq-texts f r) else hi-eq-texts f r
