nk-uses-bcar : (i : Word) (as : NkTm) → (nk-uses-var #0 i (nk-bcar as) ≡ true) → nk-uses-var #0 i as ≡ true
nk-uses-bcar i (nk-cons a d) hu = nk-or-l (nk-uses-var #0 i a) (nk-uses-var #0 i d) hu
nk-uses-bcar i (nk-var x) hu = nk-no hu
nk-uses-bcar i (nk-free x) hu = nk-no hu
nk-uses-bcar i (nk-num m) hu = nk-no hu
nk-uses-bcar i (nk-lam b) hu = nk-no hu
nk-uses-bcar i (nk-susp b) hu = nk-no hu
nk-uses-bcar i (nk-con c as) hu = nk-no hu
nk-uses-bcar i (nk-op op p as) hu = nk-no hu
nk-uses-bcar i (nk-match op p cs) hu = nk-no hu
nk-uses-bcar i nk-nil hu = nk-no hu
