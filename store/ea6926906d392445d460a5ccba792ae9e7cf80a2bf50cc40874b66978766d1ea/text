-- Universal Theorem: NO 3-gate NAND2 DAG over {a, b} computes XOR!
xor-no-3-nand2 :
  (u1 v1 : Fin2) → (u2 v2 : Fin3) → (u3 v3 : Fin4) →
  dag3-eval u1 v1 u2 v2 u3 v3 ≡ tt-xor → Empty
xor-no-3-nand2 u1 v1 u2 v2 u3 v3 heq =
  let h1 = all-f2-sound (λ a1 → all-f2 (λ b1 → all-f3 (λ a2 → all-f3 (λ b2 →
             all-f4 (λ a3 → all-f4 (λ b3 → notB-eq-xor (dag3-eval a1 b1 a2 b2 a3 b3)))))))
             dag3-all-not-xor-check u1
      h2 = all-f2-sound (λ b1 → all-f3 (λ a2 → all-f3 (λ b2 →
             all-f4 (λ a3 → all-f4 (λ b3 → notB-eq-xor (dag3-eval u1 b1 a2 b2 a3 b3))))))
             h1 v1
      h3 = all-f3-sound (λ a2 → all-f3 (λ b2 →
             all-f4 (λ a3 → all-f4 (λ b3 → notB-eq-xor (dag3-eval u1 v1 a2 b2 a3 b3)))))
             h2 u2
      h4 = all-f3-sound (λ b2 →
             all-f4 (λ a3 → all-f4 (λ b3 → notB-eq-xor (dag3-eval u1 v1 u2 b2 a3 b3))))
             h3 v2
      h5 = all-f4-sound (λ a3 → all-f4 (λ b3 → notB-eq-xor (dag3-eval u1 v1 u2 v2 a3 b3)))
             h4 u3
      h6 = all-f4-sound (λ b3 → notB-eq-xor (dag3-eval u1 v1 u2 v2 u3 b3))
             h5 v3
  in notB-eq-xor-sound (dag3-eval u1 v1 u2 v2 u3 v3) h6 heq
