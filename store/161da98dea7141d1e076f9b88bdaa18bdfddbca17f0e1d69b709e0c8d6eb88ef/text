-- each module's change (path, text before, text after), from the source
hy-file-changes : List Word → List ((List Word × List (List Word)) × (List Word × List Word)) → List (List Word) → List (List Word × (List Word × List Word)) → (List (List Word × (List Word × List Word)) → Proc W Unit) → Proc W Unit
hy-file-changes st es nil acc k = k acc
hy-file-changes st es (cons f r) acc k =
  bind (hy-render-swapped st (hy-pieces-of f es) nil) (λ was →
  bind (hy-render-swapped st (hy-pieces-of f es) (hy-file-edits f es)) (λ new →
    hy-file-changes st es r (list-append acc (cons (h-unhex f , (was , new)) nil)) k))
