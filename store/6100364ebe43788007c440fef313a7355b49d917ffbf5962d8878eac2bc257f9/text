-- the substitution theorem: eval(subst(θ, t), ρ) = eval(t, evalEnv(θ, ρ)), stated
tl-substitution-theorem : Type
tl-substitution-theorem = (g d : TlCtx) → (a : TlTy) → (t : TlTm (g , a)) → (th : TlSub g d) → (rho : TlEnv d) → tl-eval {the (TlCtx × TlTy) (d , a)} (tl-subst {the (TlCtx × TlTy) (g , a)} t d th) rho ≡ tl-eval {the (TlCtx × TlTy) (g , a)} t (tl-evalEnv g d th rho)
