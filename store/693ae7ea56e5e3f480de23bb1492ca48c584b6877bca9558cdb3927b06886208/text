-- GET /api/live/pulse?id=<anon>&node=<path> : stateless O(1) presence beacon (zero open sockets)
s-live-pulse : List Word → List Word → Proc W (List Word)
s-live-pulse st q =
  let cid = h-take (toNat #32) (hi-clean (s-param "id" q)) in
  bind (h-mkdir (list-append st "/live")) (λ mk →
  bind (h-list (list-append st "/live")) (λ ids0 →
  bind (if orB (h-null cid) (andB (wlt #63 (fromNat (list-length ids0))) (h-not (h-has cid ids0))) then ret {lzero} {W} false
        else h-write (list-append st (list-append "/live/" cid)) (h-take (toNat #128) (s-unescape (s-param "node" q)))) (λ wr →
  bind (h-list (list-append st "/live")) (λ ids →
  bind (s-live-read 48 (list-append st "/live") ids) (λ items →
    ret {lzero} {W} (s-response "application/json" (h-concat (cons "{" (cons (s-cj-str "live") (cons ":[" (cons (s-commas items) (cons "]}" nil))))))))))))
