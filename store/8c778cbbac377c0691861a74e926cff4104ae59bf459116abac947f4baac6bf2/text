-- Bytes B whose records from o0 and table from p check against the text's tokens T, whose tree from r
-- checks against the search tree of T's suffix array, with f steps enough for it, and T's bytes below
-- 256: for every query q, the count read from B (two descents of at most f nodes, each one comparison
-- of q's bytes) is the number of T's suffixes that start with q.
si-index-ok : (T : List (List Word)) → (n : Nat) → (B : Bytes n) → (p : Word) → (o0 : Word) → (r : Word) → (g : Nat) → (f : Nat) →
  isTrue (si-chk-chain n B p o0 T) → isTrue (si-chk-tree n B (build g (suffix-array-fast T)) r) →
  isTrue (si-fuel (build g (suffix-array-fast T)) f) → isTrue (si-tokens-ok T) → (q : List (List Word)) →
  wsub (si-cnt n B p (sq-up #256 q) f r) (si-cnt n B p q f r) ≡ fromNat (si-nstarts q (suffix-array T))
si-index-ok T n B p o0 r g f hc ht hf hb q =
  concat (si-cong-sub (si-cnt n B p (sq-up #256 q) f r) (si-cnt n B p q f r)
            (fromNat (plus (count-lt {entry-ord} (q , #0) (suffix-array T)) (si-nstarts q (suffix-array T))))
            (fromNat (count-lt {entry-ord} (q , #0) (suffix-array T)))
            (concat (si-cnt-sa T n B p o0 r g f hc ht hf (sq-up #256 q)) (cong fromNat (si-count-split q (suffix-array T) (si-sa-below T hb))))
            (si-cnt-sa T n B p o0 r g f hc ht hf q))
    (si-sub (count-lt {entry-ord} (q , #0) (suffix-array T)) (si-nstarts q (suffix-array T)))
