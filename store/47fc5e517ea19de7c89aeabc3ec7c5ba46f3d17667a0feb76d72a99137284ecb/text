-- Retiming Theorem: pushing a flip-flop across any combinational stage f preserves the exact
-- cycle-by-cycle pin trace for EVERY input stream while splitting the critical path!
retime-trace-eq : {A B C : Type} → (f : A → B) → (g : B → C) → (s0 : A) → (xs : List A) →
  pipe-after f g (f s0) xs ≡ pipe-before f g s0 xs
retime-trace-eq f g s0 nil = refl
retime-trace-eq f g s0 (cons x xs) = λ i → cons (g (f s0)) (retime-trace-eq f g x xs i)
