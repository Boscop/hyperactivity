lc-sieve-bytecode : List Word
lc-sieve-bytecode =
  let selSlot0 = h-take (toNat #4) (keccak256 "slot0()")
      selRes   = h-take (toNat #4) (keccak256 "getReserves()")
  in evm-assemble
       (lc-inst-concat
         (cons (lc-evm-erc20-bal lc-usdc-base20 lc-morpho-blue20 #0)
         (cons (lc-evm-erc20-bal lc-weth-base20 lc-morpho-blue20 #32)
         (cons (lc-evm-call4 lc-univ3-weth-usdc20 selSlot0 #64 #32)
         (cons (lc-evm-call4 lc-slipstream-weth-usdc20 selSlot0 #96 #32)
         (cons (lc-evm-call4 lc-aerodrome-vamm20 selRes #128 #64)
         (cons (cons (lc-evm-push-w #192)
               (cons (lc-evm-push-w #0)
               (cons (ev-op #243) nil))) nil)))))))
