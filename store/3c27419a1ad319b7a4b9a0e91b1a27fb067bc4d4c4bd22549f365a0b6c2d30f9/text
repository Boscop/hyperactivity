-- Exhaustive 65,536/65,536 structural checker (same binary tree pattern as psc-check-bf16-bits)
omni-check-bf16-bits : Nat → Word → Bool
omni-check-bf16-bits zero    w = omni-bf16-rt-ok w
omni-check-bf16-bits (suc n) w =
  if omni-check-bf16-bits n (%wshl w #1)
  then omni-check-bf16-bits n (%wor (%wshl w #1) #1)
  else false
