-- apply: a closure's body is built with the argument first in its environment
nk-rule-app : Word → Word → NkVal → Word → NkOut
nk-rule-app arg out (nkv-lam b e) n = nk-build b (nke-cons arg e) out (nk-out nkf-nil n)
nk-rule-app arg out v n = if nk-blocked v then nk-stuck v (λ h → nkv-napp h arg) out n else nk-out (nkf-op arg nko-era nkf-nil) n
