hxl-alu-check : Word
hxl-alu-check =
  let o1 = %weq (cir-alu32 #0 #123456789 #987654321) #1111111110
      o2 = %weq (cir-alu32 #1 #1000000 #345678) #654322
      o3 = %weq (cir-alu32 #6 #4294967295 #1) #1
      o4 = %weq (cir-alu32 #9 #2147483648 #4) #4160749568
  in if o1 then (if o2 then (if o3 then (if o4 then #1 else #0) else #0) else #0) else #0
