-- elimination in fixed point: each step gives its pivot and the multipliers below it (at scale t)
dy-elim : BZ → List (List BZ) → List (BZ × List BZ)
dy-elim t a = case a of
  nil → nil
  cons r0 rs → (λ p r0t ms → cons (p , ms) (dy-elim t (dy-sub t ms rs r0t))) (dy-hd r0) (dy-tl r0) (ln-map (List BZ) BZ (λ row → dy-div (bz-mul t (dy-hd row)) (dy-hd r0)) rs)
