-- ============================================================================
-- 1. Zero-Frustration Global Optimality (Zero-Search Certificate)
-- ============================================================================
-- Any conformation c* with local frustration defect 0 is a global minimum over ALL c : C.
fold-zero-frustration-is-global-min :
  (C : Type 0) →
  (defect : C → Nat) →
  (cstar : C) →
  defect cstar ≡ zero →
  (c : C) → leb (defect cstar) (defect c) ≡ true
fold-zero-frustration-is-global-min C defect cstar z c =
  transport (λ i → leb (z (~ i)) (defect c) ≡ true) (λ j → true)
