-- Searches candidate designs strictly inside the semantic fiber of `spec` (zero post-hoc LEC!)
best-in-fiber : {C S : Type} → (sem : C → S) → (spec : S) → (C → Nat) →
  fiber sem spec → List (fiber sem spec) → fiber sem spec
best-in-fiber sem spec cost c0 nil = c0
best-in-fiber sem spec cost c0 (cons c cs) =
  pick-min sem spec cost c0 (best-in-fiber sem spec cost c cs)
