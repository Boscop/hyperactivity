-- the statement on a finite instance of n sequences, with z and p tabulated: stationarity by detailed balance,
-- enrichment of z ≥ θ over neutral drift, the information bound g on z ≥ θ
sl-holds : List BQ → List BQ → Nat → BQ → BQ → Bool
sl-holds zt pt n th g = if sl-all-db zt n then (if sl-le (bq-mul (fn-q (sl-cnt zt n th) n) (sl-wsum zt n th false)) (sl-wsum zt n th true) then sl-info zt pt n th g else false) else false
