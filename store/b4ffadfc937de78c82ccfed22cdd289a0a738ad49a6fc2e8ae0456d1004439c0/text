-- a process as a tree of steps: done with its answer, or a command with its continuation (a
-- function field into the type, strictly positive by 18.18); the loop reads the head, performs
-- the command, applies the continuation to the response, and reads again
data Step (S : Sig) (A : Type) = sdone (a : A) | scmd (c : Cmd S) (k : Resp S c → Step S A)
