conv2-dc-law : (h0 h1 x0 x1 : Nat) →
  times (plus h0 h1) (plus x0 x1) ≡ plus (conv2-y0 h0 h1 x0 x1) (conv2-y1 h0 h1 x0 x1)
conv2-dc-law h0 h1 x0 x1 =
  transN (times-distr-l h0 h1 (plus x0 x1))
    (transN (cong2N plus (times-distr-r h0 x0 x1)
              (transN (times-distr-r h1 x0 x1) (plus-comm (times h1 x0) (times h1 x1))))
      (swap4 (times h0 x0) (times h0 x1) (times h1 x1) (times h1 x0)))
