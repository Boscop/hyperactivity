-- the type of the points x of T with a path in A from y to f x; a type with a centre every point
-- is joined to; an equivalence from T to A: a function with such a centre over every y
nk-fiber : NkTm → NkTm → NkTm → NkTm → NkTm
nk-fiber t a f y = nk-sig t (nk-lam (nk-con #4 (nk-cons (nk-lam (nk-up2 a)) (nk-cons (nk-up y) (nk-cons (nk-app (nk-up f) (nk-var #0)) nk-nil)))))
