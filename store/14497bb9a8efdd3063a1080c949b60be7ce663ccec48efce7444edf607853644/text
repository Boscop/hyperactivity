-- the rotation of the first methyl group: its three hydrogens cycled, everything else fixed. A rotation
-- preserves the bond graph and the arrangement at the carbon, so it is a symmetry under either reading.
vln-r1 : Vln → Vln
vln-r1 x = case x of
  vl-c1 → vl-c1
  vl-o1 → vl-o1
  vl-o2 → vl-o2
  vl-ho → vl-ho
  vl-ca → vl-ca
  vl-ha → vl-ha
  vl-n → vl-n
  vl-hn1 → vl-hn1
  vl-hn2 → vl-hn2
  vl-cb → vl-cb
  vl-hb → vl-hb
  vl-cg1 → vl-cg1
  vl-g11 → vl-g12
  vl-g12 → vl-g13
  vl-g13 → vl-g11
  vl-cg2 → vl-cg2
  vl-g21 → vl-g21
  vl-g22 → vl-g22
  vl-g23 → vl-g23
