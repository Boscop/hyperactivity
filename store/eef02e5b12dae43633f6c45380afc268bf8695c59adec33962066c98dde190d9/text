cs-sim-word : (hp1 : CsHeap) (mv1 : CsMVal) (cv1 : CsVal) (kw : Word → CsOptM) (kr : CsVal → CsRes) →
  (cs-val-rel hp1 mv1 cv1 ≡ true) →
  ((w : Word) → cs-sim-ok (kw w) (kr (csv-word w)) ≡ true) →
  cs-sim-ok (cs-bind-mword mv1 kw) (kr cv1) ≡ true
cs-sim-word hp1 (cmv-bool b) cv1 kw kr hrel hkw = refl
cs-sim-word hp1 (cmv-pair a b) cv1 kw kr hrel hkw = refl
cs-sim-word hp1 (cmv-word w) (csv-ptr addr) kw kr hrel hkw = cs-no hrel
cs-sim-word hp1 (cmv-word w) (csv-word w') kw kr hrel hkw =
  cong (λ z → cs-sim-ok (kw w) (kr (csv-word z))) (sym (cs-weq-sound w w' hrel)) ∙ hkw w
