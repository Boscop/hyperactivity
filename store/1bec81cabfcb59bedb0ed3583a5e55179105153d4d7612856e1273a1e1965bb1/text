fin-set-by32 : (n : Nat) → (f : Fin n → UInt32) → (i : Nat) → (h : le (suc i) n) → (v : UInt32) →
  atab32 n (fin-set32 n f (i , h) v) ≡ update32 n (atab32 n f) i h v
fin-set-by32 n f i h v = array32-ext n (atab32 n (fin-set32 n f (i , h) v)) (update32 n (atab32 n f) i h v)
  (λ j hj → concat {lzero} {UInt32} {index32 n (atab32 n (fin-set32 n f (i , h) v)) j hj} {if eqb i j then v else f (j , hj)} {index32 n (update32 n (atab32 n f) i h v) j hj}
     (index-tabulate32 n (fin-set32 n f (i , h) v) (j , hj))
     (sym {lzero} {UInt32} {index32 n (update32 n (atab32 n f) i h v) j hj} {if eqb i j then v else f (j , hj)}
        (concat {lzero} {UInt32} {index32 n (update32 n (atab32 n f) i h v) j hj} {if eqb i j then v else index32 n (atab32 n f) j hj} {if eqb i j then v else f (j , hj)}
           (index-update-if32 n (atab32 n f) i j h hj v)
           (λ k → if eqb i j then v else index-tabulate32 n f (j , hj) k))))
