-- the hypothesis holds at it (from the Nat hypothesis), so the goal holds: the proof of the
-- access bound, with the certificate's check evaluated by the checker
holds-i8 : (i n : Nat) → le (plus i 8) n → Holds (env2 i n) hyp-i8
holds-i8 i n h =
  (le-transport (plusw (fromNat i) #8) (fromNat n) (fromNat (plus i 8)) (fromNat n)
     (fromNat-plus i 8) (λ j → fromNat n) (le-to-lew (plus i 8) n h) , unit)
