hy-read-backs : List Word → List (List Word) → List (List Word) → Proc W (List (List Word))
hy-read-backs st nil ts = ret nil
hy-read-backs st (cons n ns) nil = ret nil
hy-read-backs st (cons n ns) (cons t ts) = bind (hy-piece-of st n) (λ p →
  bind (hy-read-backs st ns ts) (λ rest → ret (list-append (hy-read-back false n p t) rest)))
