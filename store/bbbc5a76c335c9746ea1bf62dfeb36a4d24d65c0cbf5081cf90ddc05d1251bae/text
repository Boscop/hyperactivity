-- Encode `Multicall3.tryAggregate(bool requireSuccess, (address,bytes)[] calls)` for 36-byte calldatas:
bl-encode-mc3-36 : Word → List (List Word × List Word) → List Word
bl-encode-mc3-36 reqSucc pairs =
  let sel  = h-take (toNat #4) (keccak256 "tryAggregate(bool,(address,bytes)[])")
      n    = fromNat (list-length pairs)
      offs = bl-mc3-offsets (list-length pairs) (%wmul n #32) #160
      body = h-concat (list-map bl-mc3-tuple36 pairs)
  in h-concat
       (cons sel
       (cons (eth-word-be32 reqSucc)
       (cons (eth-word-be32 #64)
       (cons (eth-word-be32 n)
       (cons offs
       (cons body nil))))))
