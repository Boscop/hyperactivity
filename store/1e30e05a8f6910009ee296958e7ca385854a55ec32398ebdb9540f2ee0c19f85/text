tom-run-sound-gen : (prog : List IsaInst) → (ts : TomState) →
  (case ts of tstate ep rat _ → RatBounded ep rat) →
  tom-proj (tom-run ts prog) ≡ isa-run (tom-proj ts) prog
tom-run-sound-gen nil = λ ts _ _ → tom-proj ts
tom-run-sound-gen (cons inst rest) = λ ts hb →
  concat {lzero} {RegFile}
    {tom-proj (tom-run (tom-step ts inst) rest)}
    {isa-run (tom-proj (tom-step ts inst)) rest}
    {isa-run (isa-step (tom-proj ts) inst) rest}
    (tom-run-sound-gen rest (tom-step ts inst) (tom-step-bounded ts inst hb))
    (λ i → isa-run (tom-step-commute ts inst hb i) rest)
