<script>
(function(){
  document.getElementById('hxtheme').addEventListener('click',function(){
    var d=!document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('dark',d);
    try{localStorage.setItem('hxTheme',d?'dark':'light')}catch(e){}
  });
  var WORLDS=[
    {id:'w1',label:'(lex=true, intent=aligned)',safe:true,lex:true,q:true},
    {id:'w2',label:'(lex=true, intent=adversarial)',safe:false,lex:true,q:false},
    {id:'w3',label:'(lex=false, intent=aligned)',safe:true,lex:false,q:false},
    {id:'w4',label:'(lex=false, intent=adversarial)',safe:false,lex:false,q:false}
  ];
  var mode='all';
  function render(){
    var g=document.getElementById('worldGrid'); g.innerHTML='';
    var active=WORLDS.filter(function(w){ return mode==='all' || (mode==='lex'&&w.lex) || (mode==='query'&&w.q); });
    WORLDS.forEach(function(w){
      var inF=active.indexOf(w)>=0;
      var d=document.createElement('div');
      d.className='wbox '+(w.safe?'safe':'unsafe')+(inF?'':' dim');
      d.textContent=w.id+': '+w.label+' · '+(w.safe?'P=TRUE':'P=FALSE');
      g.appendChild(d);
    });
    var allSafe=active.every(function(w){return w.safe});
    var b=document.getElementById('aiBadge');
    b.textContent=allSafe?'SafeAt(y) INHABITED · SAFE TO ACT':'SafeAt(y) UNINHABITED · BLOCKED';
    b.className='badge '+(allSafe?'ok':'bad');
    var n=document.getElementById('aiNote');
    if(mode==='all') n.textContent='Initial fiber: 4 compatible worlds (2 unsafe). SafeAt(y) is empty.';
    else if(mode==='lex') n.textContent='Surface lexical filter leaves (lex=true, intent=adversarial) in the fiber → lexical-gate-fails!';
    else n.textContent='Clarifying query response collapses fiber to {w1} where P holds universally → after-query-safe!';
  }
  btnQuery.onclick=function(){mode='query';render()};
  btnLex.onclick=function(){mode='lex';render()};
  btnReset.onclick=function(){mode='all';render()};
  render();
})();
</script>
