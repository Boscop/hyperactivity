-- the per-rule clause: both derivations at rule r, the first's premises decided, the second's at hand
DetRule : (r : DRule) (t : Tag) (x2 : RData r) → Type 1
DetRule r t x2 = (x1 : RData r) → AllP Pdet (tagged t (premJ r x1)) → (pΓ : PathP (λ i → CCtx) (fst (snd (concl r x1))) (fst (snd (concl r x2)))) →
  Dec1 (DetR (concl r x1) (concl r x2) pΓ)
