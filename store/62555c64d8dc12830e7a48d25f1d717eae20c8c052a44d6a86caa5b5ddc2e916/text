-- ---------------------------------------------------------------- the order of words, the machine's
ltw-toNat : (a b : Word) → ltw a b ≡ ltn (toNat a) (toNat b)
ltw-toNat a b =
  %welimP (λ v → (b : Word) → ltw v b ≡ ltn (toNat v) (toNat b)) a
    (λ b → %welimP (λ v → ltw #0 v ≡ ltn (toNat #0) (toNat v)) b (λ i → false) (λ m g i → true))
    (λ n h b →
       %welimP (λ v → ltw (%wsucc n) v ≡ ltn (toNat (%wsucc n)) (toNat v)) b (λ i → false)
         (λ m g → h m)) b
