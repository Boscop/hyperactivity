rect-to-gbox6 : Word → Word → Word → Rect → Gds6Box
rect-to-gbox6 layer dtype scaleNm r =
  gbox6
    (u16-to-b2 layer)
    (u16-to-b2 dtype)
    (u32-to-b4 (%wmul scaleNm (w-of-nat (rx0 r))))
    (u32-to-b4 (%wmul scaleNm (w-of-nat (ry0 r))))
    (u32-to-b4 (%wmul scaleNm (w-of-nat (rx1 r))))
    (u32-to-b4 (%wmul scaleNm (w-of-nat (ry1 r))))
