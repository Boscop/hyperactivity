-- a value's head as data (%view, src/net.c): its parts are the value's own parts, values;
-- data types, constructors and variables by words
data View
  = wlam f
  | wpair a b
  | wpi A B
  | wsigma A B
  | wu l
  | wpath A a b
  | wplam p
  | wiv r
  | wface a
  | wsys bs
  | wglue A S
  | wgluev S a
  | wdata d ps
  | wcon d c fs ds
  | whcomp u a
  | wvar l T
  | wapp f a T
  | wfst p T
  | wsnd p T
  | wpapp p r T
  | wcomp A u a0 T
  | wunglue S b T
  | whcompu A S
  | wunglueu S b T
  | welim d x f T
  | wtrans d psi ls x T
  | wlevel
  | wother
  | wword
  | wwlit n
  | wpty k n
  | wplit k b
  | wbytes n
  | wwplus k x
  | wwop k a b
  | wwelim x z s mo                         -- mo: some P, the motive, when written with one (%welimP)
  | wcofix n T
  | wproj d k x T
  | wrec d fs
  -- clocks, the ticks of a clock, the closed clock κ0, the tick constant ⋄
  | wclock
  | wtick k
  | wclock0
  | wtick0
