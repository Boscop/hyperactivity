ic-cut-sym-con : {K : Type} → (t1 : Nat) → (a1 a2 : WireId) → (t2 : Nat) → (b1 b2 : WireId) →
  co-flip (ic-interact {K} (ic-con t2 b1 b2) (ic-con t1 a1 a2)) ≡ ic-interact {K} (ic-con t1 a1 a2) (ic-con t2 b1 b2)
ic-cut-sym-con {K} t1 a1 a2 t2 b1 b2 =
  (λ i → co-flip (ic-con-con {K} (dn-weq-sym t2 t1 i) t2 b1 b2 t1 a1 a2))
  ∙ ic-con-con-sym {K} (eqb t1 t2) t1 a1 a2 t2 b1 b2
