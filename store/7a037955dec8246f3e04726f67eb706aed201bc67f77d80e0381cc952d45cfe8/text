-- exchanging twice is the identity, for every species and every sign
exchange-twice : (s : Species) → (b : Bool) → exchange-sign s (exchange-sign s b) ≡ b
exchange-twice s b = case s return (λ w → exchange-sign w (exchange-sign w b) ≡ b) of
  electron → (case b return (λ v → exchange-sign electron (exchange-sign electron v) ≡ v) of
    true → (λ i → true)
    false → (λ i → false))
  proton → (case b return (λ v → exchange-sign proton (exchange-sign proton v) ≡ v) of
    true → (λ i → true)
    false → (λ i → false))
  neutron → (case b return (λ v → exchange-sign neutron (exchange-sign neutron v) ≡ v) of
    true → (λ i → true)
    false → (λ i → false))
