-- Emit XOR2 in BLIF (3 AIG nodes): t0 = a&b, t1 = ~a&~b, out = ~t0&~t1
epfl-xor-blif : List Word → List Word → List Word → List Word → List Word
epfl-xor-blif a b out pfx =
  let t0 = list-append pfx "_0"
      t1 = list-append pfx "_1"
  in sv-concat
       (cons (epfl-gate2 a b t0 "11")
       (cons (epfl-gate2 a b t1 "00")
       (cons (epfl-gate2 t0 t1 out "00") nil)))
