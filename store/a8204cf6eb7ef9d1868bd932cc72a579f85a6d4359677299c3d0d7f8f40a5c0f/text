zpos-scale x q hx hq = zle-trans (the (Nat × Nat) (suc zero , zero)) (zsc (the (Nat × Nat) (suc zero , zero)) q) (zsc x q)
  (le-cong-r (suc zero) q (plus (plus q zero) zero) hq (symN (transN (plus-zero (plus q zero)) (plus-zero q))))
