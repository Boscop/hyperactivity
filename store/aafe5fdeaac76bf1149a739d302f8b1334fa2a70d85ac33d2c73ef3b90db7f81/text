isGroupoidRetract : {l m : Level} {A : Type l} {B : Type m} (f : A → B) (g : B → A) (h : (x : A) → g (f x) ≡ x) → isGroupoid B → isGroupoid A
isGroupoidRetract f g h grp x y p q P Q = λ i j k →
  comp (λ l → A) (λ l → [ i = 0 ↦ h (P j k) l , i = 1 ↦ h (Q j k) l , j = 0 ↦ h (p k) l , j = 1 ↦ h (q k) l , k = 0 ↦ h x l , k = 1 ↦ h y l ])
    (g (grp (f x) (f y) (λ m → f (p m)) (λ m → f (q m)) (λ m n → f (P m n)) (λ m n → f (Q m n)) i j k))
