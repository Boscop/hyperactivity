-- two naturals: equal, or one below the other
sy-tri : (a b : Nat) → Sum (a ≡ b) (Sum (le (suc a) b) (le (suc b) a))
sy-tri a b = (case a return λ x → (y : Nat) → Sum (x ≡ y) (Sum (le (suc x) y) (le (suc y) x)) of
  zero → λ y → (case y return λ w → Sum (zero ≡ w) (Sum (le (suc zero) w) (le (suc w) zero)) of
    zero → inl (λ i → zero)
    suc y1 → inr (inl (le-suc2 zero y1 (the (le zero y1) (y1 , plus-zero y1)))))
  suc a1 → λ y → (case y return λ w → Sum (suc a1 ≡ w) (Sum (le (suc (suc a1)) w) (le (suc w) (suc a1))) of
    zero → inr (inr (le-suc2 zero a1 (the (le zero a1) (a1 , plus-zero a1))))
    suc y1 → (case sy-tri a1 y1 of
      inl p → inl (λ i → suc (p i))
      inr s → (case s of
        inl h → inr (inl (le-suc2 (suc a1) y1 h))
        inr h → inr (inr (le-suc2 (suc y1) a1 h)))))) b
