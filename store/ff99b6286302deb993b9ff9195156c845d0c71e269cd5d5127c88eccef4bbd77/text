-- a written gesture: its line added to the reader's document in the source, logged as every change is
hi-write : List Word → List Word → List Word → Proc W (List Word)
hi-write st m q = if orB (h-not (h-has (s-param "kind" q) hi-kinds)) (h-null (h-trim (s-param "text" q))) then ret {lzero} {W} (hi-see (hi-href (hi-reader q) (hi-focus q)))
  else bind (h-document (hi-doc (hi-reader q))) (λ d → bind (h-pointer (hi-doc (hi-reader q))) (λ p →
  bind (h-record-raw m (hi-doc (hi-reader q)) (list-append (s-or (h-line (h-line (list-append "# Written in the human interface by " (hi-reader q)))) d) (hi-entry (s-param "kind" q) (hi-focus q) (s-param "text" q))) (λ u →
  bind (h-pointer (hi-doc (hi-reader q))) (λ now → bind (s-changed st (h-hex (hi-doc (hi-reader q))) p now) (λ r →
  ret (hi-see (hi-href (hi-reader q) (hi-focus q)))))))))
