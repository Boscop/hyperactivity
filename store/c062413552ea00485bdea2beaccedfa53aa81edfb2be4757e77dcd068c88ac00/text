-- how many positions of the reversed text are in state e: the occurrences of the end of length e (e is
-- the most any position matches, so no state passes it and state e is exactly an occurrence; e ≥ 1)
m-count : (n : Nat) → Bytes n → (k : Nat) → Bytes k → Word → Word → (s : Nat) → Bytes s → Word
m-count n p k f m e s b = m-count-end e (%welimP (λ _ → Word) (bytes-length s b) #0
  (λ i a → m-with (if weq (m-lo a) e then wadd (wshr a #32) #1 else wshr a #32) (m-next n p k f m (m-lo a) (m-back s b i))))
