sfin-punch : (n : Nat) → (y z : SumFin (suc n)) → (z ≡ y → Empty) → SumFin n
sfin-punch n =
  case n return (λ k → (y z : SumFin (suc k)) → (z ≡ y → Empty) → SumFin k) of
    zero → λ y z →
      case y return (λ a → (z ≡ a → Empty) → Empty) of
        inl u1 →
          case z return (λ b → (Path (SumFin (suc zero)) b (inl u1) → Empty) → Empty) of
            inl u2 → λ h' → h' (cong inl (opt-unit-eq u2 u1))
            inr e → λ _ → e
        inr e → λ _ → e
    suc m → λ y →
      case y return (λ a → (b : SumFin (suc (suc m))) → (b ≡ a → Empty) → SumFin (suc m)) of
        inl u1 → λ b →
          case b return (λ c → (Path (SumFin (suc (suc m))) c (inl u1) → Empty) → SumFin (suc m)) of
            inl u2 → λ h' → Empty-rec (h' (cong inl (opt-unit-eq u2 u1)))
            inr z' → λ _ → z'
        inr y' → λ b →
          case b return (λ c → (Path (SumFin (suc (suc m))) c (inr y') → Empty) → SumFin (suc m)) of
            inl u → λ _ → inl u
            inr z' → λ h' → inr (rec m y' z' (λ eq → h' (cong inr eq)))
