adc-arith : (S CO A0 B0 C1 P R VA VB CI : Nat) → plus S (plus CO CO) ≡ plus (plus A0 B0) C1 → plus R (times C1 P) ≡ plus (plus VA VB) CI →
  plus (plus (times S P) R) (times CO (plus P P)) ≡ plus (plus (plus (times A0 P) VA) (plus (times B0 P) VB)) CI
adc-arith S CO A0 B0 C1 P R VA VB CI fa ih =
  transN (congN (plus (plus (times S P) R)) (wb-distr-r CO P P))
  (transN (wb-swap-last (times S P) R (plus (times CO P) (times CO P)))
  (transN (congN (λ z → plus z R) (sym (transN (times-distr S (plus CO CO) P) (congN (plus (times S P)) (times-distr CO CO P)))))
  (transN (congN (λ z → plus (times z P) R) fa)
  (transN (congN (λ z → plus z R) (transN (times-distr (plus A0 B0) C1 P) (congN (λ z → plus z (times C1 P)) (times-distr A0 B0 P))))
  (transN (plus-assoc (plus (times A0 P) (times B0 P)) (times C1 P) R)
  (transN (congN (plus (plus (times A0 P) (times B0 P))) (transN (plus-comm (times C1 P) R) ih))
  (transN (sym (plus-assoc (plus (times A0 P) (times B0 P)) (plus VA VB) CI))
  (congN (λ z → plus z CI) (stree-swap4 (times A0 P) (times B0 P) VA VB)))))))))
