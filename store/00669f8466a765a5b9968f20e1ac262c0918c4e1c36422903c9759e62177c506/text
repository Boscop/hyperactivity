-- nk-step-commute: steps at two wires commute, from apartness alone. If the two plans write
-- different wires, and each writes neither the other's wire nor the wire the other reads, then
-- stepping in either order leaves memories that read the same at every wire. No hypothesis is left
-- about plans; what remains unproven is that an executor's wire names and the net's linearity give
-- this apartness (part of machine-in-hyperactive)
nk-step-commute : (sl : NkSlots) (u1 n1 u2 n2 : Word) →
  nk-aparts (nk-fx (nk-plan (nk-get sl u1) u1 n1 sl)) (nk-fx (nk-plan (nk-get sl u2) u2 n2 sl)) →
  nk-apart u1 (nk-fx (nk-plan (nk-get sl u2) u2 n2 sl)) → nk-apart (nk-rw (nk-get sl u1) u1) (nk-fx (nk-plan (nk-get sl u2) u2 n2 sl)) →
  nk-apart u2 (nk-fx (nk-plan (nk-get sl u1) u1 n1 sl)) → nk-apart (nk-rw (nk-get sl u2) u2) (nk-fx (nk-plan (nk-get sl u1) u1 n1 sl)) →
  nk-same (nk-step-at u2 n2 (nk-step-at u1 n1 sl)) (nk-step-at u1 n1 (nk-step-at u2 n2 sl))
nk-step-commute sl u1 n1 u2 n2 ap a1 a2 b1 b2 =
  nk-step-swap sl u1 n1 u2 n2 ap
    (nk-plan-stable sl u1 n1 (nk-fx (nk-plan (nk-get sl u2) u2 n2 sl)) a1 a2)
    (nk-plan-stable sl u2 n2 (nk-fx (nk-plan (nk-get sl u1) u1 n1 sl)) b1 b2)
