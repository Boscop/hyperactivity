-- Σ over pairs at distance d of ±1 (equal +, unequal −), from position i, on n sites (k the steps left)
lc-diag : Nat → Nat → Nat → Nat → List Bool → BZ
lc-diag d n k i s = case k of
  zero → bz-zero
  suc k1 → if leb (plus i (suc d)) n then bz-add (if bit-eq (lc-nth s i) (lc-nth s (plus i d)) then bz-one else in-negint 1) (lc-diag d n k1 (suc i) s) else bz-zero
