tw-lem-mk-con : (env : Word → Bool) → (t : Word) → (a b : INet) →
  in-eval env (in-mk-con t a b) ≡ in-opB t (in-eval env a) (in-eval env b)
tw-lem-mk-con env t a b =
  web-trans-b (tw-lem-mk-con-go env t a b (%weq t #0) (%weq t #1) (%weq t #3) refl refl refl)
              (tw-lem-opB-dispatch t (in-eval env a) (in-eval env b))
