-- what is to be computed: a body's value in an environment (a list of bodies' values as a list);
-- an eliminator, with its branches and its arguments, applied to a value; a value read back as a
-- body at a depth; a list of values read back
data NkEvJ = nkevj-tm (t : NkTm) (e : NkEv) | nkevj-el (h : Word) (cs : NkTm) (aux : NkEv) (v : NkEv) | nkevj-q (d : Word) (v : NkEv) | nkevj-qs (d : Word) (vs : NkEv)
