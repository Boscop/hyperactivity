-- the law at J, u ≥ 1: (P(u+1) + P(u−1) − 2P(u)) · J(J+1) = u · (2P(0) − 2P(1)) for u ≤ J, and the left side 0 beyond
ring-law-at : Nat → Nat → Bool
ring-law-at J u = if leb u J
  then bin-eq (bin-mul (bin-sub (bin-add (ring-p J (suc u)) (ring-p J (monus u 1))) (bin-mul bin-two (ring-p J u))) (bin-of-nat (times J (suc J))))
              (bin-mul (bin-of-nat u) (bin-mul bin-two (bin-sub (ring-p J zero) (ring-p J 1))))
  else bin-eq (bin-add (ring-p J (suc u)) (ring-p J (monus u 1))) (bin-mul bin-two (ring-p J u))
