find-nat-ok-suc : (x y : Word) → (r : List Word) → (j k : Nat) →
                  (wlt (fromNat j) (fromNat (list-length r)) ≡ true) × (wnth-nat r j ≡ x) →
                  Path (Opt Nat) (some (suc j)) (some k) →
                  (wlt (fromNat k) (fromNat (suc (list-length r))) ≡ true) × (wnth-nat (cons y r) k ≡ x)
find-nat-ok-suc x y r j k ih h =
  let keq : Path Nat (suc j) k
      keq = cm-some-inj {Nat} {suc j} {k} h
      keq' : Path Nat k (suc j)
      keq' = λ i → keq (~ i)
      pfk : fromNat k ≡ %wsucc (fromNat j)
      pfk = λ i → fromNat (keq' i)
      hlt : wlt (%wsucc (fromNat j)) (%wsucc (fromNat (list-length r))) ≡ true
      hlt = cm-catb (cm-congb (λ z → wlt z (wadd (fromNat (list-length r)) #1)) (cm-wadd-comm (fromNat j) #1))
              (cm-catb (cm-congb (λ z → wlt (wadd #1 (fromNat j)) z) (cm-wadd-comm (fromNat (list-length r)) #1))
                (cm-lt-shift #1 (fromNat j) (fromNat (list-length r)) (fst ih)))
  in ( cm-catb (cm-congb (λ z → wlt z (fromNat (suc (list-length r)))) pfk) hlt
     , catw (λ i → wnth-nat (cons y r) (keq' i)) (snd ih) )
