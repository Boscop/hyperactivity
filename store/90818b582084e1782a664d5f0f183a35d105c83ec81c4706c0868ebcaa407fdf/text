-- nk-wait-inc: the same for an increment facing a reference to a held wire that holds nothing yet
-- (part of machine-in-hyperactive)
nk-wait-inc : (sl : NkSlots) (u n out w : Word) → (nk-get sl u ≡ nks-pair (nko-inc out) (nkv-ref w)) → (nk-get sl w ≡ nks-none) → nk-step-at u n sl ≡ sl
nk-wait-inc sl u n out w p q =
  cong (λ s → nk-do (nk-fx (nk-plan s u n sl)) sl) p
  ∙ cong (λ z → nk-do (nk-fx (nk-plan-read z (nko-inc out) u n)) sl) q
