-- Multi-hop greedy walk over n-bit flat key space (nodes and keys share BKey b)
dht-walk : {b : Nat} {N K V : Type} → Nat → (N → BKey b) → (K → BKey b) → (N → List N) → (N → CAStore K V) → N → K → Sum Unit V
dht-walk {b} zero nid kid rt stores curr k = stores curr k
dht-walk {b} (suc fuel) nid kid rt stores curr k =
  ca-or (stores curr k)
    (dht-or-hop (λ next → dht-walk {b} fuel nid kid rt stores next k)
      (dht-closer-hop (λ nb → bk-lt b (xor-key b (nid nb) (kid k)) (xor-key b (nid curr) (kid k))) (rt curr)))
