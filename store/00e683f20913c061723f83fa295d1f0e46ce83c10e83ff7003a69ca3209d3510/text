-- a body with every free variable of a path type replaced by its endpoint-carrying form, for
-- normalizing; typing uses the plain variables
nk-rfl : NkTm → Word → NkTm → NkTm
nk-rfl ctx n (nk-free x) = nk-reflect (nk-nth ctx (%wsub (%wsub n #1) x)) x
nk-rfl ctx n (nk-lam b) = nk-lam (nk-rfl ctx n b)
nk-rfl ctx n (nk-con c as) = nk-con c (nk-rfl ctx n as)
nk-rfl ctx n (nk-op h p as) = nk-op h (nk-rfl ctx n p) (nk-rfl ctx n as)
nk-rfl ctx n (nk-match h p cs) = nk-match h (nk-rfl ctx n p) (nk-rfl ctx n cs)
nk-rfl ctx n (nk-cons t r) = nk-cons (nk-rfl ctx n t) (nk-rfl ctx n r)
nk-rfl ctx n t = t
