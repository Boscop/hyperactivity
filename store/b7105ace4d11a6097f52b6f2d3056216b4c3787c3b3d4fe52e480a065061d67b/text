-- a linear map given by its entries, applied: the image over the monomials ts of a vector over ss
map-dot : (List Nat → List Nat → SQ) → List Nat → Mons → List SQ → SQ
map-dot ent t ss v = case ss of
  nil → sq-zero
  cons s rest → sq-plus (sq-mul (ent t s) (poly-head v)) (map-dot ent t rest (poly-tail v))
