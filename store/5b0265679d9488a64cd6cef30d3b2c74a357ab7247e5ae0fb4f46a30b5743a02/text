-- try every position, hypothesis and direction; deeper : ETm → OTrace searches from the result
try-pos : (ETm → OTrace) → Eqs → Poss → ETm → OTrace
try-pos deeper hs ps s =
  case ps return (λ w → OTrace) of
    pnil → notr
    pcons p rest → (case try-hyp deeper hs p (eqs-len hs) #0 s return (λ w → OTrace) of atrace tr → atrace tr; notr → rec rest)
