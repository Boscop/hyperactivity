-- Gates:  w3=NAND(0,1), w4=NAND(0,3), w5=NAND(1,3), w6=NAND(4,5)[=a^b],
--         w7=NAND(6,2), w8=NAND(6,7), w9=NAND(2,7), w10=NAND(8,9)[=sum], w11=NAND(3,7)[=cout]
cir-fa1-net : List (Word × Word)
cir-fa1-net =
  cons (#0 , #1) (cons (#0 , #3) (cons (#1 , #3) (cons (#4 , #5)
  (cons (#6 , #2) (cons (#6 , #7) (cons (#2 , #7) (cons (#8 , #9)
  (cons (#3 , #7) nil))))))))
