cdiv-qr-canon : (pos : Bool) → (qr : List Bool × List Bool) → bcanon (fst qr) ≡ true → bcanon (snd (bz-cdiv-qr pos qr)) ≡ true
cdiv-qr-canon pos qr h = case pos return λ p → bcanon (snd (bz-cdiv-qr p qr)) ≡ true of
  true → if-canon (bin-null (snd qr)) (true , fst qr) (true , bin-succ (fst qr)) h (bin-succ-canon (fst qr) h)
  false → bz-neg-canon (true , fst qr) h
