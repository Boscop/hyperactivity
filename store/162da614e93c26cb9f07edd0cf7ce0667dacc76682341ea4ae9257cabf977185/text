-- Theorem (`poly-kinetic-trapping`):
-- If a crystallization history begins inside a kinetically trapped polymorph basin B_kin,
-- EVERY state reached along ANY finite history of k allowed transitions remains in B_kin,
-- proving why lower-energy thermodynamic polymorphs separated by high barriers never appear
-- without a seeding or annealing history that raises the kinetic budget.
poly-kinetic-trapping :
  (C : Type 0) → (step : C → C → Bool) → (InBasin : C → Type 0) →
  KineticTrap C step InBasin →
  (k : Nat) → (a b : C) → HistN C step k a b → InBasin a → InBasin b
poly-kinetic-trapping C step InBasin trap zero a b eq ha =
  transport (λ i → InBasin (eq i)) ha
poly-kinetic-trapping C step InBasin trap (suc k) a b h ha =
  poly-kinetic-trapping C step InBasin trap k (fst h) b (snd (snd h)) (trap a (fst h) ha (fst (snd h)))
