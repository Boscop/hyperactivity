motif-score : List MTerm → List MTerm → Word
motif-score pat xs =
  let len = fromNat (list-length pat)
      cnt = count-motif-go (list-length xs) pat xs
  in if wlt cnt #2 then #0
     else if wlt len #2 then #0
     else let saved = wmul (wsub cnt #1) (wsub len #1)
              cost = wadd len #1
          in if wlt cost saved then wsub saved cost else #0
