tail-drop : {A : Type} → (h : Nat) → (l : List A) → tail-of (drop-n h l) ≡ drop-n h (tail-of l)
tail-drop h =
  case h return λ w → (l : List A) → tail-of (drop-n w l) ≡ drop-n w (tail-of l) of
    zero → λ l i → tail-of l
    suc h1 → λ l → (case l return λ v → tail-of (drop-n (suc h1) v) ≡ drop-n (suc h1) (tail-of v) of
                      nil → λ i → nil
                      cons x r → tr (drop-n h1 (tail-of r)) (rec h1 r)
                                   ((case r return λ u → drop-n h1 (tail-of u) ≡ drop-n (suc h1) u of nil → drop-nil {A} h1; cons y q → λ i → drop-n h1 q)))
