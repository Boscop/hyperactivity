-- a property of a list chosen by a Boolean
it-ifc : (V : Type) → (b : Bool) → (u : V) → (r : List V) → (T : List V → Type) → (b ≡ true → T (cons u r)) → T r → T (if b then cons u r else r)
it-ifc V b u r T = case b return λ w → (w ≡ true → T (cons u r)) → T r → T (if w then cons u r else r) of
  true → λ h t → h (λ i → true)
  false → λ h t → t
