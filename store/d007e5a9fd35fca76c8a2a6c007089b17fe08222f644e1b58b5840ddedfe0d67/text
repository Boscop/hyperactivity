-- ============================================================================
-- 1. Multi-Vertex Spin-Network State & Local Graph-Changing Rewrite
-- ============================================================================
-- A finite spin network indexed by vertex positions (List V) where each vertex holds
-- its local intertwiner + attached-arc state V.
lqg-act-at : {V : Type 0} → Nat → (V → V) → List V → List V
lqg-act-at zero f nil = nil
lqg-act-at (suc n) f nil = nil
lqg-act-at zero f (cons v rest) = cons (f v) rest
lqg-act-at (suc n) f (cons v rest) = cons v (lqg-act-at n f rest)
