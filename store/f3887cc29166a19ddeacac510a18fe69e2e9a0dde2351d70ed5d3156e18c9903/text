nk-norm-in-it-s : Nat → NkTm → NkTm → Word → NkTm → NkTm
nk-norm-in-it-s zero kdefs ctx n t = nk-nf-s (toNat #30000) kdefs (nk-sub-forms ctx n t)
nk-norm-in-it-s (suc k) kdefs ctx n t =
  let nf = nk-nf-s (toNat #30000) kdefs (nk-sub-forms ctx n t)
      kn = nk-pass nf
  in if nk-tm-eq kn nf then nf else nk-norm-in-it-s k kdefs ctx n kn
