-- ---------------------------------------------------------------- 3. Receptive lens vs. covert optimizer
-- A bidirectional receptive view (§10.2, eq. 10.5) between underlying state S and sensory carrier V
ReceptiveLens : Type → Type → Type
ReceptiveLens S V =
  (get : S → V) × (put : S → V → S) ×
  ((s : S) → (v : V) → get (put s v) ≡ v) ×
  ((s : S) → put s (get s) ≡ s)
