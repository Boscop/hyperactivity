-- a word inequality between numerals is the Nat inequality, and back
lew-to-le-path : (a b : Nat) (d : Word) → plusw (fromNat a) d ≡ fromNat b → plus (toNat d) a ≡ b
lew-to-le-path a b d p =
  transN (plus-comm (toNat d) a)
    (transN (symN (toNat-plusw a (toNat d)))
      (transN (congn2 toNat (congw (λ z → plusw (fromNat a) z) (fromNat-toNat d)))
        (transN (congn2 toNat p) (toNat-fromNat b))))
