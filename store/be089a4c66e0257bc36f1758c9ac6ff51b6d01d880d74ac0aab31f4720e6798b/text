-- automorphisms compose: the relabellings composed, the inverses composed the other way, and each
-- preservation carried along the first then the second
auto-comp : (M : Mol) → Auto M → Auto M → Auto M
auto-comp M a b =
  ( (λ x → auto-fun M a (auto-fun M b x))
  , (λ x → auto-inv-fun M b (auto-inv-fun M a x))
  , (λ x → concat (cong (auto-inv-fun M b) (auto-gf M a (auto-fun M b x))) (auto-gf M b x))
  , (λ x → concat (cong (auto-fun M a) (auto-fg M b (auto-inv-fun M a x))) (auto-fg M a x))
  , (λ x → concat (auto-el M a (auto-fun M b x)) (auto-el M b x))
  , (λ x → λ y → concat (auto-bd M a (auto-fun M b x) (auto-fun M b y)) (auto-bd M b x y)) )
