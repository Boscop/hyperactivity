comp-ren-e : (s : TyShape) → CRenT s
comp-ren-e s-bool = ((λ Δ T ct Δ' w → one) , bool-ren)
comp-ren-e (s-fam fm a b) = (fam-ren fm a b (comp-ren-e a) , fam-tm-ren fm a b (comp-ren-e a) (comp-ren-e b))
comp-ren-e (s-path a) =
  (path-ty-ren a (comp-ren-e a) ,
   λ Δ X cx Δ' w Δ2 w2 f cf nc →
     jc-tr j-tm a Δ2 (papp-mean Δ2 a f (wact Δ2 Δ (world-comp Δ2 Δ' Δ w2 w) (TV (s-path a)) X)) (papp-mean Δ2 a f (wact Δ2 Δ' w2 (TV (s-path a)) (wact Δ' Δ w (TV (s-path a)) X)))
       (λ i → papp-mean Δ2 a f (subM-comp Δ2 Δ' Δ w2 w (TV (s-path a)) X i))
       (cx Δ2 (world-comp Δ2 Δ' Δ w2 w) f cf nc))
