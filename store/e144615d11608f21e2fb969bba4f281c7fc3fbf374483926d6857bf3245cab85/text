-- Replay a packed 6-bit-per-gate NAND2 netlist (g = (i << 3) | j) in one bit-parallel pass.
hs-exec : Word → Word → Word → Nat → Word
hs-exec bank nw prog zero = hs-get bank (%wsub nw #1)
hs-exec bank nw prog (suc k) =
  let g = %wand prog #63
      i = %wshr g #3
      j = %wand g #7
      t = hs-nand (hs-get bank i) (hs-get bank j)
  in hs-exec (hs-set bank nw t) (%wsucc nw) (%wshr prog #6) k
