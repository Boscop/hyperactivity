wl-substrate-pool-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wl-substrate-pool-poly A ad mu q vs =
  (λ g sub →
    let s = g 0; es = g 1; p = g 2; x1 = g 3; x2 = g 4
        s'  = sub s x1
        es' = sub (ad es x1) x2
        p'  = ad p x2
    in (ad (ad s' es') p' , ad (ad s es) p))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)

