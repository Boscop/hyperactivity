-- THEOREM 8: COUPLED ENZYME CATALYSIS + PROTEIN THERMAL FOLDING MASS CONSERVATION
wl-enzyme-pool-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wl-enzyme-pool-poly A ad mu q vs =
  (λ g sub →
    let e = g 0; es = g 1; eu = g 2; x1 = g 3; x2 = g 4; xf = g 5
        e'  = sub (ad (sub e x1) x2) xf
        es' = sub (ad es x1) x2
        eu' = ad eu xf
    in (ad (ad e' es') eu' , ad (ad e es) eu))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)

