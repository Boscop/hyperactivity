-- THEOREM 5: BIOENERGETIC 5-ELEMENT HOMOLOGY (C, H, N, O, P) IN ATP-DRIVEN PEPTIDE SYNTHESIS!
wl-sc : (A : Type) → (A → A → A) → (BQ → A) → Nat → A → A
wl-sc A mu q k w = mu (q (fn-q k 1)) w

wl-atp-peptide-5elem-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wl-atp-peptide-5elem-poly A ad mu q vs =
  (λ g →
    let wC = g 0; wH = g 1; wN = g 2; wO = g 3; wP = g 4; xi = g 5
        atp = ad (ad (wl-sc A mu q 10 wC) (wl-sc A mu q 16 wH)) (ad (ad (wl-sc A mu q 5 wN) (wl-sc A mu q 13 wO)) (wl-sc A mu q 3 wP))
        gly = ad (ad (wl-sc A mu q 2 wC)  (wl-sc A mu q 5 wH))  (ad (wl-sc A mu q 1 wN) (wl-sc A mu q 2 wO))
        ala = ad (ad (wl-sc A mu q 3 wC)  (wl-sc A mu q 7 wH))  (ad (wl-sc A mu q 1 wN) (wl-sc A mu q 2 wO))
        adp = ad (ad (wl-sc A mu q 10 wC) (wl-sc A mu q 15 wH)) (ad (ad (wl-sc A mu q 5 wN) (wl-sc A mu q 10 wO)) (wl-sc A mu q 2 wP))
        pi  = ad (ad (wl-sc A mu q 3 wH)  (wl-sc A mu q 4 wO))  (wl-sc A mu q 1 wP)
        pep = ad (ad (wl-sc A mu q 5 wC)  (wl-sc A mu q 10 wH)) (ad (wl-sc A mu q 2 wN) (wl-sc A mu q 3 wO))
        reacts = mu xi (ad (ad atp gly) ala)
        prods  = mu xi (ad (ad adp pi)  pep)
    in (reacts , prods))
  (λ n → al-nth A (q (fn-q 0 1)) n vs)

wl-thm-atp-peptide-5elem : al-id 6 wl-atp-peptide-5elem-poly ≡ true
wl-thm-atp-peptide-5elem = λ i → true

-- THEOREM 6: THERMODYNAMIC COHOMOLOGY H^1 = 0 (WEGSCHEIDER-KIRCHHOFF CYCLE CLOSURE)
wl-cohom-cycle-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wl-cohom-cycle-poly A ad mu q vs =
  (λ g sub →
    let uA = g 0; uB = g 1; uC = g 2; uD = g 3
        tot = ad (ad (sub uB uA) (sub uC uB)) (ad (sub uD uC) (sub uA uD))
    in (tot , q (fn-q 0 1)))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)

wl-thm-cohomology-h1-cycle : al-id 4 wl-cohom-cycle-poly ≡ true
wl-thm-cohomology-h1-cycle = λ i → true

-- THEOREM 7: HoTT 2-CELL PATH-INDEPENDENCE OF REACTION FREE ENERGY (HESS'S LAW)
wl-hess-2cell-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wl-hess-2cell-poly A ad mu q vs =
  (λ g sub →
    let uA = g 0; uB = g 1; uC = g 2; uD = g 3
        p1 = ad (sub uB uA) (sub uD uB)
        p2 = ad (sub uC uA) (sub uD uC)
    in (p1 , p2))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)

