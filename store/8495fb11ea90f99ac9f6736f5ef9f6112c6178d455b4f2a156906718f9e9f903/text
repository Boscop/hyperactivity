-- THEOREM 1: EXACT CAYLEY UNITARY WAVEFUNCTION NORM PRESERVATION OVER ALL (a, b, x, y)
wl-cayley-state-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wl-cayley-state-poly A ad mu q vs =
  (λ g sub sq →
    let a = g 0; b = g 1; x = g 2; y = g 3
        q2 = q (fn-q 2 1)
        c  = sub (sq a) (sq b)
        s  = mu q2 (mu a b)
        d  = ad (sq a) (sq b)
        xr = sub (mu c x) (mu s y)
        yi = ad  (mu s x) (mu c y)
        lhs = ad (sq xr) (sq yi)
        rhs = mu (sq d) (ad (sq x) (sq y))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)

wl-thm-cayley-state-unitary : al-id 4 wl-cayley-state-poly ≡ true
wl-thm-cayley-state-unitary = λ i → true

-- THEOREM 2: EXACT SU(2) UNITARITY OF 2-SITE QUANTUM PROTON-TUNNELING CAYLEY PROPAGATOR
wl-cayley-su2-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wl-cayley-su2-poly A ad mu q vs =
  (λ g sub sq →
    let d = g 0; h = g 1; t = g 2
        q1 = q (fn-q 1 1)
        q2 = q (fn-q 2 1)
        e2 = mu (sq t) (ad (sq d) (sq h))
        c0 = sub q1 e2
        sd = mu q2 (mu t d)
        sh = mu q2 (mu t h)
        lhs = ad (sq c0) (ad (sq sd) (sq sh))
        rhs = sq (ad q1 e2)
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)

wl-thm-cayley-su2-tunneling : al-id 3 wl-cayley-su2-poly ≡ true
wl-thm-cayley-su2-tunneling = λ i → true

-- THEOREM 3: EXACT LIOUVILLE SYMPLECTIC PHASE-SPACE PRESERVATION OF VELOCITY-VERLET
wl-verlet-det-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wl-verlet-det-poly A ad mu q vs =
  (λ g sub sq →
    let k = g 0; dt = g 1
        q2 = q (fn-q 2 1)
        q4 = q (fn-q 4 1)
        u  = mu k (sq dt)
        lhs = ad (sq (sub q2 u)) (mu u (sub q4 u))
    in (lhs , q4))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)

wl-thm-symplectic-verlet-det : al-id 2 wl-verlet-det-poly ≡ true
wl-thm-symplectic-verlet-det = λ i → true

-- THEOREM 4a/4b/4c: ASPIRIN ESTERIFICATION HOMOLOGY (d0 o d1 = 0 for C, H, O universally!)
wl-aspirin-C-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
wl-aspirin-C-poly A ad mu q vs =
  (λ g sub →
    let n1 = g 0; n2 = g 1; n3 = g 2; n4 = g 3; xi = g 4
        c7 = q (fn-q 7 1); c4 = q (fn-q 4 1); c9 = q (fn-q 9 1); c2 = q (fn-q 2 1)
        after  = ad (ad (mu c7 (sub n1 xi)) (mu c4 (sub n2 xi))) (ad (mu c9 (ad n3 xi)) (mu c2 (ad n4 xi)))
        before = ad (ad (mu c7 n1)          (mu c4 n2))          (ad (mu c9 n3)         (mu c2 n4))
    in (after , before))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q)

wl-thm-aspirin-C-homology : al-id 5 wl-aspirin-C-poly ≡ true
