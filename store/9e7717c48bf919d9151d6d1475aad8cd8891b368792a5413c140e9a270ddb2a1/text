s-root-get : List Word → Proc W (List Word)
s-root-get m = bind (h-read "root") (λ r → case r of
  inr t → ret {lzero} {W} (s-response "text/plain" (h-line (h-trim (h-before (cons #10 nil) t))))
  inl u → bind (h-capture (cons m (cons "--root" nil))) (λ cr →
    ret {lzero} {W} (s-response "text/plain" (h-line (s-head nil (h-lines (snd cr)))))))
