nk-do-upd-ok : (fx : NkFx) (sl : NkSlots) (w : Word) (f : NkSlot → NkSlot) → nk-ok w f fx → nk-same (nk-do fx (nk-upd sl w f)) (nk-upd (nk-do fx sl) w f)
nk-do-upd-ok nkf-nil sl w f ap x = refl
nk-do-upd-ok (nkf-val k v r) sl w f ap x =
  nk-do-same r (nk-upd (nk-upd sl w f) k (nk-arrive-val v)) (nk-upd (nk-upd sl k (nk-arrive-val v)) w f) (nk-upd-swap-ok sl w k f (nk-arrive-val v) (fst ap)) x
  ∙ nk-do-upd-ok r (nk-upd sl k (nk-arrive-val v)) w f (snd ap) x
nk-do-upd-ok (nkf-op k o r) sl w f ap x =
  nk-do-same r (nk-upd (nk-upd sl w f) k (nk-arrive-op o)) (nk-upd (nk-upd sl k (nk-arrive-op o)) w f) (nk-upd-swap-ok sl w k f (nk-arrive-op o) (fst ap)) x
  ∙ nk-do-upd-ok r (nk-upd sl k (nk-arrive-op o)) w f (snd ap) x
nk-do-upd-ok (nkf-put k s r) sl w f ap x =
  nk-do-same r (nk-upd (nk-upd sl w f) k (λ s0 → s)) (nk-upd (nk-upd sl k (λ s0 → s)) w f) (nk-upd-swap-ok sl w k f (λ s0 → s) (fst ap)) x
  ∙ nk-do-upd-ok r (nk-upd sl k (λ s0 → s)) w f (snd ap) x
