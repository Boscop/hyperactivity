pm-row-col-p2 :
  (a b c d e f g h z : Bool) →
  pm-xor (pm-xor3 a b c) (pm-xor (pm-xor d g) (pm-xor (pm-xor e h) (pm-xor f z)))
  ≡ pm-xor3 (pm-xor3 a d g) (pm-xor3 b e h) (pm-xor3 c f z)
pm-row-col-p2 a b c d e f g h z =
  concat (pm-swap4 a (pm-xor b c) (pm-xor d g) (pm-xor (pm-xor e h) (pm-xor f z)))
         (λ i → pm-xor (pm-xor3 a d g) (pm-swap4 b c (pm-xor e h) (pm-xor f z) i))
